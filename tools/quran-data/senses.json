{"2": [["для, к", "رَبِّ اشْرَحْ لِي صَدْرِي", 2, "Господи! Раскрой для меня мою грудь", "20:25"], ["чтобы", "إِلَّا لِيَعْبُدُونِ", 1, "лишь для того, чтобы поклонялись Мне", "51:56"]], "3": [["из", "أَخْرَجَ مِنْهَا مَاءَهَا", 1, "вывел из неё её воду", "79:31"], ["от", "وَمِنْ شَرِّ غَاسِقٍ", 0, "и от зла мрака", "113:3"]], "4": [["так, и вот", "فَاتَّقُوا اللَّهَ وَأَطِيعُونِ", 0, "Так бойтесь же Аллаха и повинуйтесь мне", "26:108"], ["затем", "فَكَذَّبُوهُ فَأَخَذَتْهُمُ الرَّجْفَةُ", 1, "Они сочли его лжецом, и затем их постигло землетрясение", "29:37"]], "6": [["с, при помощи", "أَرْسَلْنَا مُوسَىٰ بِآيَاتِنَا", 2, "Мы отправили Мусу с Нашими знамениями", "11:96"], ["в", "لَا يُؤْمِنُ بِاللَّهِ الْعَظِيمِ", 2, "не веровал в Аллаха Великого", "69:33"]], "7": [["нет", "ذَٰلِكَ الْكِتَابُ لَا رَيْبَ فِيهِ", 2, "Это Писание — нет сомнения в нём", "2:2"], ["не", "وَمَا لَا تُبْصِرُونَ", 1, "и тем, чего вы не видите", "69:39"]], "11": [["то, что", "يَعْلَمُونَ مَا تَفْعَلُونَ", 1, "они знают то, что вы делаете", "82:12"], ["что? (вопрос)", "مَا الْقَارِعَةُ", 0, "Что такое Великое бедствие?", "101:2"]], "13": [["на", "عَلَىٰ سُرُرٍ مُتَقَابِلِينَ", 0, "на ложах друг против друга", "37:44"], ["над", "لَسْتَ عَلَيْهِمْ بِمُصَيْطِرٍ", 1, "ты не властен над ними", "88:22"]], "15": [["этот", "وَهَٰذَا الْبَلَدِ الْأَمِينِ", 0, "и этим безопасным городом", "95:3"], ["тот", "وَالْأَرْضَ بَعْدَ ذَٰلِكَ دَحَاهَا", 2, "И землю после того Он распростёр", "79:30"]], "18": [["кто? (вопрос)", "وَقِيلَ مَنْ رَاقٍ", 1, "И будет сказано: «Кто заклинатель?»", "75:27"], ["тот, кто", "قَدْ أَفْلَحَ مَنْ تَزَكَّىٰ", 2, "Преуспел тот, кто очистился", "87:14"]], "21": [["кроме", "إِلَّا أَصْحَابَ الْيَمِينِ", 0, "кроме людей правой стороны", "74:39"], ["только", "إِنْ هُوَ إِلَّا وَحْيٌ يُوحَىٰ", 2, "Это только откровение, которое внушается", "53:4"]], "22": [["что", "أَنْ دَعَوْا لِلرَّحْمَٰنِ وَلَدًا", 0, "что они приписали Милостивому сына", "19:91"], ["чтобы", "أَلَّا تَطْغَوْا فِي الْمِيزَانِ", 0, "чтобы вы не преступали меры на весах", "55:8"]], "26": [["о, про", "عَنِ النَّبَإِ الْعَظِيمِ", 0, "о великой вести", "78:2"], ["от", "فَتَوَلَّ عَنْهُمْ حَتَّىٰ حِينٍ", 1, "Отвернись же от них до срока", "37:174"]], "28": [["уже", "وَلَقَدْ رَآهُ نَزْلَةً أُخْرَىٰ", 0, "Он уже видел его в другое нисхождение", "53:13"], ["действительно", "قَدْ أَفْلَحَ الْمُؤْمِنُونَ", 0, "Действительно, преуспели верующие", "23:1"]], "30": [["народ, люди", "كَذَّبَتْ قَوْمُ نُوحٍ الْمُرْسَلِينَ", 1, "Народ Нуха счёл лжецами посланников", "26:105"]], "32": [["знамение", "إِنَّ فِي ذَٰلِكَ لَآيَةً لِلْمُؤْمِنِينَ", 3, "Воистину, в этом — знамение для верующих", "15:77"], ["аят", "تِلْكَ آيَاتُ الْكِتَابِ الْمُبِينِ", 1, "Это — аяты ясного Писания", "26:2"]], "34": [["каждый", "وَيْلٌ لِكُلِّ هُمَزَةٍ لُمَزَةٍ", 1, "Горе каждому хулителю, обидчику", "104:1"], ["весь, все", "فَسَجَدَ الْمَلَائِكَةُ كُلُّهُمْ أَجْمَعُونَ", 2, "И пали ниц ангелы — все они вместе", "15:30"]], "36": [["сделал (чем-то)", "وَجَعَلْنَا اللَّيْلَ لِبَاسًا", 0, "и сделали ночь покровом", "78:10"], ["установил", "وَجَعَلْنَا سِرَاجًا وَهَّاجًا", 0, "и установили пылающий светильник", "78:13"]], "39": [["наказание, мучение", "إِنَّ عَذَابَ رَبِّكَ لَوَاقِعٌ", 1, "Воистину, наказание твоего Господа непременно наступит", "52:7"]], "41": [["вот (когда)", "وَإِذْ نَادَىٰ رَبُّكَ مُوسَىٰ", 0, "Вот твой Господь воззвал к Мусе", "26:10"], ["когда", "وَاللَّيْلِ إِذْ أَدْبَرَ", 1, "Клянусь ночью, когда она отступает", "74:33"]], "42": [["душа", "عَلِمَتْ نَفْسٌ مَا أَحْضَرَتْ", 1, "познает душа, что она принесла", "81:14"], ["сам (себя)", "وَفِي أَنْفُسِكُمْ أَفَلَا تُبْصِرُونَ", 1, "И в вас самих. Неужели вы не видите?", "51:21"]], "43": [["не уверовал", "بَلِ الَّذِينَ كَفَرُوا يُكَذِّبُونَ", 2, "Но те, кто не уверовал, считают это ложью", "84:22"], ["отверг", "كَلَّا سَيَكْفُرُونَ بِعِبَادَتِهِمْ", 1, "Но нет! Они отвергнут их поклонение", "19:82"]], "44": [["как, подобно", "وَتَكُونُ الْجِبَالُ كَالْعِهْنِ الْمَنْفُوشِ", 2, "и горы станут как расчёсанная шерсть", "101:5"]], "48": [["делал", "فَمَنْ يَعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْرًا يَرَهُ", 1, "Кто сделает добра весом в пылинку, тот увидит его", "99:7"], ["трудился", "لِمَسَاكِينَ يَعْمَلُونَ فِي الْبَحْرِ", 1, "беднякам, которые трудились в море", "18:79"]], "49": [["дал, даровал", "رَبَّنَا آتِنَا فِي الدُّنْيَا حَسَنَةً", 1, "Господь наш! Даруй нам в этом мире добро", "2:201"]], "52": [["пришёл, явился", "وَاعْبُدْ رَبَّكَ حَتَّىٰ يَأْتِيَكَ الْيَقِينُ", 3, "И поклоняйся своему Господу, пока не придёт к тебе убеждённость (смерть)", "15:99"]], "53": [["Писание", "ذَٰلِكَ الْكِتَابُ لَا رَيْبَ فِيهِ", 1, "Это Писание, в котором нет сомнения", "2:2"], ["книга (деяний)", "فَأَمَّا مَنْ أُوتِيَ كِتَابَهُ بِيَمِينِهِ", 3, "А тот, кому его книга будет дана в правую руку", "84:7"]], "54": [["истина", "وَتَوَاصَوْا بِالْحَقِّ وَتَوَاصَوْا بِالصَّبْرِ", 1, "и заповедовали друг другу истину, и заповедовали друг другу терпение", "103:3"], ["право, должное", "وَآتِ ذَا الْقُرْبَىٰ حَقَّهُ", 3, "И отдавай родственнику его право (должное)", "17:26"]], "55": [["до, прежде", "قَبْلَ طُلُوعِ الشَّمْسِ وَقَبْلَ الْغُرُوبِ", 3, "до восхода солнца и до заката", "50:39"]], "62": [["у, при", "قُلْ إِنَّمَا الْعِلْمُ عِنْدَ اللَّهِ", 3, "Скажи: «Знание — только у Аллаха»", "67:26"]], "65": [["благо, добро", "فَمَنْ يَعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْرًا يَرَهُ", 4, "Кто сделает благо (добро) весом в пылинку, тот увидит его", "99:7"], ["лучше", "وَالْآخِرَةُ خَيْرٌ وَأَبْقَىٰ", 1, "А последняя жизнь — лучше и долговечнее", "87:17"]], "68": [["призвал, звал к", "وَاللَّهُ يَدْعُو إِلَىٰ دَارِ السَّلَامِ", 1, "И Аллах призывает к Обители мира", "10:25"], ["взмолился", "فَدَعَا رَبَّهُ أَنِّي مَغْلُوبٌ فَانْتَصِرْ", 0, "И он взмолился к своему Господу: «Меня одолели — помоги же!»", "54:10"]], "70": [["дело", "وَيَسِّرْ لِي أَمْرِي", 2, "И облегчи мне моё дело", "20:26"], ["повеление", "فَعَتَوْا عَنْ أَمْرِ رَبِّهِمْ", 2, "Но они ослушались повеления своего Господа", "51:44"]], "71": [["с, вместе с", "فَإِنَّ مَعَ الْعُسْرِ يُسْرًا", 1, "Поистине, с тяготой — облегчение", "94:5"]], "73": [["некоторые", "وَلَوْ تَقَوَّلَ عَلَيْنَا بَعْضَ الْأَقَاوِيلِ", 3, "Если бы он приписал Нам некоторые слова", "69:44"], ["часть", "لَبِثْنَا يَوْمًا أَوْ بَعْضَ يَوْمٍ", 3, "Мы пробыли день или часть дня", "23:113"]], "75": [["обладатель, имеющий", "تَبَارَكَ اسْمُ رَبِّكَ ذِي الْجَلَالِ وَالْإِكْرَامِ", 3, "Благословенно имя Господа твоего, Обладателя величия и почёта", "55:78"]], "78": [["другой", "يَوْمَ تُبَدَّلُ الْأَرْضُ غَيْرَ الْأَرْضِ", 3, "в тот день, когда земля будет заменена другой землёй", "14:48"], ["не", "غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلَا الضَّالِّينَ", 0, "не тех, на кого пал гнев, и не заблудших", "1:7"]], "79": [["рай", "فَإِنَّ الْجَنَّةَ هِيَ الْمَأْوَىٰ", 1, "то, поистине, Рай — его пристанище", "79:41"], ["сад", "وَدَخَلَ جَنَّتَهُ وَهُوَ ظَالِمٌ لِنَفْسِهِ", 1, "И вошёл он в свой сад, поступая несправедливо к самому себе", "18:35"]], "83": [["помимо, кроме", "وَاتَّخَذُوا مِنْ دُونِ اللَّهِ آلِهَةً", 2, "И они взяли себе богов помимо Аллаха", "36:74"]], "84": [["пока не", "حَتَّىٰ زُرْتُمُ الْمَقَابِرَ", 0, "пока не посетили могилы", "102:2"], ["до (срока)", "وَتَوَلَّ عَنْهُمْ حَتَّىٰ حِينٍ", 2, "Отвернись же от них до (определённого) срока", "37:178"]], "90": [["раб, слуга", "إِنِّي عَبْدُ اللَّهِ", 1, "Воистину, я — раб Аллаха", "19:30"]], "92": [["может быть", "لَعَلَّ السَّاعَةَ قَرِيبٌ", 0, "может быть, Час близок", "42:17"], ["чтобы", "إِنَّا أَنْزَلْنَاهُ قُرْآنًا عَرَبِيًّا لَعَلَّكُمْ تَعْقِلُونَ", 4, "Мы ниспослали его Кораном на арабском, чтобы вы поняли", "12:2"]], "94": [["взял", "أَخَذَ الْأَلْوَاحَ", 0, "он взял скрижали", "7:154"], ["схватил", "فَأَخَذْنَاهُ أَخْذًا وَبِيلًا", 0, "и Мы схватили его суровой хваткой", "73:16"]], "95": [["напротив, но", "كَلَّا بَلْ تُحِبُّونَ الْعَاجِلَةَ", 1, "Так нет же! Напротив, вы любите преходящее", "75:20"]], "96": [["семья", "وَأْمُرْ أَهْلَكَ بِالصَّلَاةِ", 1, "Вели своей семье совершать намаз", "20:132"], ["люди (чего-то)", "وَجَاءَ أَهْلُ الْمَدِينَةِ يَسْتَبْشِرُونَ", 1, "И пришли люди города, ликуя", "15:67"]], "97": [["взял себе", "وَقَالُوا اتَّخَذَ الرَّحْمَٰنُ وَلَدًا", 1, "Они говорят: «Милостивый взял Себе сына»", "19:88"], ["сделал (кем-то)", "لَا إِلَٰهَ إِلَّا هُوَ فَاتَّخِذْهُ وَكِيلًا", 4, "нет божества, кроме Него, так сделай же Его своим Попечителем", "73:9"]], "108": [["спросил", "يَسْأَلُونَكَ عَنِ السَّاعَةِ", 0, "Они спрашивают тебя о Часе", "79:42"], ["попросил", "وَمَا أَسْأَلُكُمْ عَلَيْهِ مِنْ أَجْرٍ", 1, "Я не прошу у вас за это никакой награды", "26:109"]], "117": [["религия", "لَكُمْ دِينُكُمْ وَلِيَ دِينِ", 1, "У вас — ваша религия, а у меня — моя", "109:6"], ["воздаяние", "مَالِكِ يَوْمِ الدِّينِ", 2, "Властелину Дня воздаяния", "1:4"]], "118": [["слово, речь", "إِنَّهُ لَقَوْلُ رَسُولٍ كَرِيمٍ", 1, "Воистину, это — слово благородного посланца", "81:19"]], "120": [["не есть (не является)", "أَلَيْسَ اللَّهُ بِأَحْكَمِ الْحَاكِمِينَ", 0, "Разве Аллах не является Наимудрейшим из судей?", "95:8"], ["нет (у кого-то)", "فَلَيْسَ لَهُ الْيَوْمَ هَاهُنَا حَمِيمٌ", 0, "И нет у него сегодня здесь близкого друга", "69:35"]], "122": [["притча", "وَتِلْكَ الْأَمْثَالُ نَضْرِبُهَا لِلنَّاسِ", 1, "Такие притчи Мы приводим людям", "29:43"], ["пример", "وَجَعَلْنَاهُ مَثَلًا لِبَنِي إِسْرَائِيلَ", 1, "и сделали его примером для сынов Исраила", "43:59"]], "126": [["покровитель", "إِنَّ وَلِيِّيَ اللَّهُ", 1, "Воистину, мой Покровитель — Аллах", "7:196"], ["друг, союзник", "وَالَّذِينَ كَفَرُوا بَعْضُهُمْ أَوْلِيَاءُ بَعْضٍ", 3, "А неверующие — друзья друг другу", "8:73"]], "129": [["помянул", "وَذَكَرَ اسْمَ رَبِّهِ فَصَلَّىٰ", 0, "и помянул имя своего Господа и помолился", "87:15"], ["вспомнил", "فَسَتَذْكُرُونَ مَا أَقُولُ لَكُمْ", 0, "Вы вспомните то, что я вам говорю", "40:44"]], "130": [["милость, щедрость", "ذَٰلِكَ فَضْلُ اللَّهِ يُؤْتِيهِ مَنْ يَشَاءُ", 1, "Такова милость Аллаха: Он дарует её, кому пожелает", "62:4"]], "138": [["большинство", "وَلَٰكِنَّ أَكْثَرَ النَّاسِ لَا يَعْلَمُونَ", 1, "однако большинство людей не знают", "30:6"], ["больше", "أَنَا أَكْثَرُ مِنْكَ مَالًا", 1, "У меня больше имущества, чем у тебя", "18:34"]], "140": [["обитатели", "أَنَّهُمْ أَصْحَابُ النَّارِ", 1, "что они — обитатели Огня", "40:6"], ["товарищи", "ذَنُوبًا مِثْلَ ذَنُوبِ أَصْحَابِهِمْ", 3, "долю (наказания), подобную доле их товарищей", "51:59"]], "145": [["супруг(а)", "هُمْ وَأَزْوَاجُهُمْ فِي ظِلَالٍ", 1, "Они и их супруги — в тени", "36:56"], ["пара", "وَخَلَقْنَاكُمْ أَزْوَاجًا", 1, "И Мы сотворили вас парами", "78:8"]], "148": [["поминание", "أَلَا بِذِكْرِ اللَّهِ تَطْمَئِنُّ الْقُلُوبُ", 1, "Воистину, поминанием Аллаха успокаиваются сердца", "13:28"], ["напоминание", "وَمَا هُوَ إِلَّا ذِكْرٌ لِلْعَالَمِينَ", 3, "Но это — лишь напоминание для миров", "68:52"]], "149": [["подобие", "الَّتِي لَمْ يُخْلَقْ مِثْلُهَا فِي الْبِلَادِ", 3, "подобного которому не было сотворено в городах", "89:8"], ["как (подобно)", "مَا أَنْتَ إِلَّا بَشَرٌ مِثْلُنَا", 4, "Ты — всего лишь человек, как мы", "26:154"]], "151": [["если бы не", "وَلَوْلَا نِعْمَةُ رَبِّي لَكُنْتُ مِنَ الْمُحْضَرِينَ", 0, "Если бы не милость моего Господа, я оказался бы среди ввергнутых", "37:57"], ["почему бы не", "نَحْنُ خَلَقْنَاكُمْ فَلَوْلَا تُصَدِّقُونَ", 2, "Мы сотворили вас — почему же вы не признаёте истину?", "56:57"]], "156": [["один, единый", "قُلْ هُوَ اللَّهُ أَحَدٌ", 3, "Скажи: «Он — Аллах Единый»", "112:1"], ["кто-либо", "إِذَا حَضَرَ أَحَدَكُمُ الْمَوْتُ", 2, "когда смерть приближается к кому-либо из вас", "2:180"]], "160": [["лицо, лик", "وَيَبْقَىٰ وَجْهُ رَبِّكَ", 1, "И пребудет Лик твоего Господа", "55:27"]], "162": [["внушил, дал откровение", "فَأَوْحَىٰ إِلَىٰ عَبْدِهِ مَا أَوْحَىٰ", 0, "И Он внушил Своему рабу то, что внушил", "53:10"]], "166": [["дело, деяние", "يَوْمَئِذٍ يَصْدُرُ النَّاسُ أَشْتَاتًا لِيُرَوْا أَعْمَالَهُمْ", 5, "В тот день люди выйдут толпами, чтобы им показали их деяния", "99:6"]], "168": [["мало", "وَأَعْطَىٰ قَلِيلًا وَأَكْدَىٰ", 1, "дал мало и перестал давать", "53:34"], ["немногие", "وَقَلِيلٌ مِنَ الْآخِرِينَ", 0, "и немногие — из последних", "56:14"]], "179": [["правая рука", "فَأَمَّا مَنْ أُوتِيَ كِتَابَهُ بِيَمِينِهِ", 4, "Тот, кому его книга будет вручена в правую руку", "84:7"], ["клятва", "اتَّخَذُوا أَيْمَانَهُمْ جُنَّةً", 1, "Они сделали свои клятвы щитом", "58:16"]], "182": [["отцы, предки", "إِنَّهُمْ أَلْفَوْا آبَاءَهُمْ ضَالِّينَ", 2, "Воистину, они нашли своих отцов заблудшими", "37:69"]], "183": [["постиг, поразил", "إِذَا أَصَابَتْهُمْ مُصِيبَةٌ", 1, "когда их постигает беда", "2:156"]], "186": [["много", "وَنَذْكُرَكَ كَثِيرًا", 1, "и поминали Тебя много", "20:34"], ["многие", "وَكَثِيرٌ مِنْهُمْ فَاسِقُونَ", 0, "а многие из них — нечестивцы", "57:26"]], "187": [["покаялся", "وَمَنْ تَابَ وَعَمِلَ صَالِحًا", 1, "И кто покается и будет поступать праведно", "25:71"], ["принял покаяние", "ثُمَّ اجْتَبَاهُ رَبُّهُ فَتَابَ عَلَيْهِ", 3, "Потом его Господь избрал его и принял его покаяние", "20:122"]], "191": [["приобрёл, заработал", "مَا أَغْنَىٰ عَنْهُ مَالُهُ وَمَا كَسَبَ", 5, "Не помогло ему его богатство и то, что он приобрёл", "111:2"]], "197": [["решил", "وَإِذَا قَضَىٰ أَمْرًا", 1, "И когда Он решает какое-либо дело", "2:117"], ["завершил", "أَيَّمَا الْأَجَلَيْنِ قَضَيْتُ", 2, "какой бы из двух сроков я ни завершил", "28:28"]], "203": [["селение, город", "أَصْحَابَ الْقَرْيَةِ إِذْ جَاءَهَا الْمُرْسَلُونَ", 1, "жителей селения, когда к нему пришли посланники", "36:13"]], "204": [["глаз", "أَلَمْ نَجْعَلْ لَهُ عَيْنَيْنِ", 3, "Разве Мы не дали ему два глаза?", "90:8"], ["источник", "فِيهَا عَيْنٌ جَارِيَةٌ", 1, "Там — текущий источник", "88:12"]], "207": [["коснулся", "لَا يَمَسُّهُ إِلَّا الْمُطَهَّرُونَ", 1, "Касаются его только очищенные", "56:79"], ["постиг", "إِذَا مَسَّهُ الشَّرُّ", 1, "когда его постигает зло", "70:20"]], "209": [["суровый", "اعْلَمُوا أَنَّ اللَّهَ شَدِيدُ الْعِقَابِ", 3, "Знайте, что Аллах суров в наказании", "5:98"], ["сильный", "أَوْ آوِي إِلَىٰ رُكْنٍ شَدِيدٍ", 4, "или найти прибежище у сильной опоры", "11:80"]], "210": [["удел, пропитание", "وَفِي السَّمَاءِ رِزْقُكُمْ وَمَا تُوعَدُونَ", 2, "И на небе — ваш удел и то, что вам обещано", "51:22"]], "211": [["ударил", "اضْرِبْ بِعَصَاكَ الْبَحْرَ", 0, "Ударь своим посохом по морю", "26:63"], ["привёл (притчу)", "وَاضْرِبْ لَهُمْ مَثَلًا", 0, "Приведи им притчу", "36:13"]], "213": [["совершал (молитву)", "وَأَقِيمُوا الصَّلَاةَ", 0, "И совершайте намаз", "2:43"]], "219": [["воскресил", "ثُمَّ بَعَثْنَاكُمْ مِنْ بَعْدِ مَوْتِكُمْ", 1, "Затем Мы воскресили вас после вашей смерти", "2:56"], ["отправил", "أَهَٰذَا الَّذِي بَعَثَ اللَّهُ رَسُولًا", 2, "Неужели это тот, кого Аллах отправил посланником?", "25:41"]], "230": [["благо, милость", "وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ", 1, "А о милости твоего Господа возвещай", "93:11"]], "236": [["понимал, размышлял", "إِنَّا أَنْزَلْنَاهُ قُرْآنًا عَرَبِيًّا لَعَلَّكُمْ تَعْقِلُونَ", 5, "Мы ниспослали его Кораном на арабском, чтобы вы поняли", "12:2"]], "237": [["написал", "وَنَكْتُبُ مَا قَدَّمُوا", 0, "и записываем то, что они совершили", "36:12"], ["предписал", "كَتَبَ اللَّهُ لَأَغْلِبَنَّ أَنَا وَرُسُلِي", 0, "Аллах предписал: «Непременно одержу победу Я и Мои посланники»", "58:21"]], "241": [["обитель, дом", "وَلَلدَّارُ الْآخِرَةُ خَيْرٌ", 0, "а последняя обитель лучше", "6:32"]], "242": [["власть, владычество", "وَلِلَّهِ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ", 1, "Аллаху принадлежит власть над небесами и землёй", "3:189"]], "244": [["думал", "إِنَّهُ ظَنَّ أَنْ لَنْ يَحُورَ", 1, "Он думал, что не вернётся обратно", "84:14"], ["был уверен", "الَّذِينَ يَظُنُّونَ أَنَّهُمْ مُلَاقُو رَبِّهِمْ", 1, "которые уверены, что встретят своего Господа", "2:46"]], "252": [["судил, решил", "اللَّهُ يَحْكُمُ بَيْنَكُمْ يَوْمَ الْقِيَامَةِ", 1, "Аллах рассудит между вами в День воскресения", "22:69"]], "258": [["считал, полагал", "أَيَحْسَبُ أَنْ لَمْ يَرَهُ أَحَدٌ", 0, "Неужели он полагает, что никто его не видел?", "90:7"]], "272": [["мир", "ادْخُلُوهَا بِسَلَامٍ آمِنِينَ", 1, "Входите сюда с миром, в безопасности", "15:46"], ["приветствие", "سَلَامٌ عَلَيْكُمْ بِمَا صَبَرْتُمْ", 0, "«Мир вам за то, что вы терпели!» (приветствие)", "13:24"]], "273": [["над, выше", "وَبَنَيْنَا فَوْقَكُمْ سَبْعًا شِدَادًا", 1, "И Мы воздвигли над вами семь твердынь", "78:12"]], "288": [["большой", "وَكُلُّ صَغِيرٍ وَكَبِيرٍ مُسْتَطَرٌ", 2, "Всё малое и большое записано", "54:53"], ["великий", "ذَٰلِكَ الْفَوْزُ الْكَبِيرُ", 2, "Это — великое преуспеяние", "85:11"]], "294": [["мусульманин", "أَفَنَجْعَلُ الْمُسْلِمِينَ كَالْمُجْرِمِينَ", 1, "Неужели Мы уравняем мусульман с грешниками?", "68:35"], ["покорный", "رَبَّنَا وَاجْعَلْنَا مُسْلِمَيْنِ لَكَ", 2, "Господь наш! Сделай нас обоих покорными Тебе", "2:128"]], "300": [["Владыка, Властелин", "مَالِكِ يَوْمِ الدِّينِ", 0, "Властелину Дня воздаяния", "1:4"]], "305": [["тот, на кого гнев", "غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ", 1, "не тех, на кого пал гнев", "1:7"]], "324": [], "328": [["дал, даровал", "إِنَّا أَعْطَيْنَاكَ الْكَوْثَرَ", 1, "Воистину, Мы даровали тебе аль-Каусар", "108:1"]], "333": [["отрезанный (от блага, потомства)", "إِنَّ شَانِئَكَ هُوَ الْأَبْتَرُ", 3, "Воистину, твой ненавистник — он и есть отрезанный", "108:3"]], "334": [["помощь", "إِذَا جَاءَ نَصْرُ اللَّهِ", 2, "Когда придёт помощь Аллаха", "110:1"], ["победа", "وَمَا النَّصْرُ إِلَّا مِنْ عِنْدِ اللَّهِ", 1, "И победа — только от Аллаха", "8:10"]], "335": [["победа", "إِنَّا فَتَحْنَا لَكَ فَتْحًا مُبِينًا", 3, "Воистину, Мы даровали тебе явную победу", "48:1"]], "336": [["толпа, группа", "فَتَأْتُونَ أَفْوَاجًا", 1, "и вы придёте толпами", "78:18"]], "340": [["пропал, погиб", "تَبَّتْ يَدَا أَبِي لَهَبٍ", 0, "Да пропадут руки Абу Лахаба", "111:1"]], "342": [["помог, принёс пользу", "مَا أَغْنَىٰ عَنِّي مَالِيَهْ", 1, "Не помогло мне моё богатство", "69:28"]], "344": [["жена", "وَقَالَتِ امْرَأَتُ فِرْعَوْنَ", 1, "И сказала жена Фараона", "28:9"], ["женщина", "إِنِّي وَجَدْتُ امْرَأَةً تَمْلِكُهُمْ", 2, "Я нашёл женщину, которая царствует над ними", "27:23"]], "346": [["дрова, хворост", "حَمَّالَةَ الْحَطَبِ", 1, "носящая дрова", "111:4"]], "351": [["козни, хитрость", "أَلَمْ يَجْعَلْ كَيْدَهُمْ فِي تَضْلِيلٍ", 2, "Разве Он не запутал их козни?", "105:2"]], "371": [["еда, пища", "فَلْيَنْظُرِ الْإِنْسَانُ إِلَىٰ طَعَامِهِ", 3, "Пусть посмотрит человек на свою пищу", "80:24"]], "376": [["отказал (не дал)", "وَيَمْنَعُونَ الْمَاعُونَ", 0, "и отказывают даже в мелочи", "107:7"], ["удержал, помешал", "مَا مَنَعَكَ أَلَّا تَسْجُدَ", 1, "Что удержало тебя от того, чтобы пасть ниц?", "7:12"]], "384": [["бросил", "فَنَبَذْنَاهُمْ فِي الْيَمِّ", 0, "и Мы бросили их в море", "51:40"], ["отбросил (отверг)", "أَوَكُلَّمَا عَاهَدُوا عَهْدًا نَبَذَهُ فَرِيقٌ مِنْهُمْ", 3, "Неужели всякий раз, когда они заключают завет, часть из них отбрасывает его?", "2:100"]], "388": [["поднялся, взошёл", "الَّتِي تَطَّلِعُ عَلَى الْأَفْئِدَةِ", 1, "который вздымается над сердцами", "104:7"]], "391": [["столбы, колонны", "فِي عَمَدٍ مُمَدَّدَةٍ", 1, "на вытянутых столбах", "104:9"]], "398": [["позади", "وَمِنْ خَلْفِهِمْ سَدًّا", 1, "и позади них — преграду", "36:9"]], "400": [["объял, вместил", "هُوَ وَسِعَ كُلَّ شَيْءٍ عِلْمًا", 1, "Он объемлет знанием всякую вещь", "20:98"]], "402": [], "403": [["охрана, оберегание", "وَحِفْظًا مِنْ كُلِّ شَيْطَانٍ مَارِدٍ", 0, "и для охраны от всякого мятежного дьявола", "37:7"]]}