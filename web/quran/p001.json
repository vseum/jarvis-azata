{"p":1,"j":1,"a":[[1,1,["بِسۡمِ","ٱللَّهِ","ٱلرَّحۡمَٰنِ","ٱلرَّحِيمِ"],"бисмиллахир рахманир рахиим","Во имя Аллаха, Милостивого, Милосердного!",["с именем","Аллаха","Милостивого","Милосердного"]],[1,2,["ٱلۡحَمۡدُ","لِلَّهِ","رَبِّ","ٱلۡعَٰلَمِينَ"],"алхамду лиллахи раббил `аламиин","Хвала Аллаху, Господу миров,",["вся хвала","Аллаху","Господу","миров"]],[1,3,["ٱلرَّحۡمَٰنِ","ٱلرَّحِيمِ"],"аррахманир рахиим","Милостивому, Милосердному,",["Милостивому","Милосердному"]],[1,4,["مَٰلِكِ","يَوۡمِ","ٱلدِّينِ"],"малики йаумид диин","Властелину Дня воздаяния!",["Властелину","дня","воздаяния"]],[1,5,["إِيَّاكَ","نَعۡبُدُ","وَإِيَّاكَ","نَسۡتَعِينُ"],"иййака на`буду ва'иййака наста`иин","Тебе одному мы поклоняемся и Тебя одного молим о помощи.",["Тебе (одному)","мы поклоняемся","и Тебя (одного)","мы просим о помощи"]],[1,6,["ٱهۡدِنَا","ٱلصِّرَٰطَ","ٱلۡمُسۡتَقِيمَ"],"ихдинас сиратал мустаḳиим","Веди нас прямым путем,",["веди нас","путем","прямым"]],[1,7,["صِرَٰطَ","ٱلَّذِينَ","أَنۡعَمۡتَ","عَلَيۡهِمۡ","غَيۡرِ","ٱلۡمَغۡضُوبِ","عَلَيۡهِمۡ","وَلَا","ٱلضَّآلِّينَ"],"сиратал лазиина ан`амта `алайхим гайрил магдууби `алайхим валад даллиин","путем тех, кого Ты облагодетельствовал, не тех, на кого пал гнев, и не заблудших.",["путем","тех, которых","Ты облагодетельствовал","их","не (тех)","разгневались (на кого)","на них","и не","заблудших"]]]}