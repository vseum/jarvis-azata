{"p":1,"j":1,"a":[[1,1,["بِسۡمِ","ٱللَّهِ","ٱلرَّحۡمَٰنِ","ٱلرَّحِيمِ"],"бисми ллахи ррахмаани ррахиим","Во имя Аллаха, Милостивого, Милосердного!",["с именем","Аллаха","Милостивого","Милосердного"]],[1,2,["ٱلۡحَمۡدُ","لِلَّهِ","رَبِّ","ٱلۡعَٰلَمِينَ"],"алхамду лиллахи рабби л`ааламиин","Хвала Аллаху, Господу миров,",["вся хвала","Аллаху","Господу","миров"]],[1,3,["ٱلرَّحۡمَٰنِ","ٱلرَّحِيمِ"],"аррахмаани ррахиим","Милостивому, Милосердному,",["Милостивому","Милосердному"]],[1,4,["مَٰلِكِ","يَوۡمِ","ٱلدِّينِ"],"маалики йауми ддиин","Властелину Дня воздаяния!",["Властелину","дня","воздаяния"]],[1,5,["إِيَّاكَ","نَعۡبُدُ","وَإِيَّاكَ","نَسۡتَعِينُ"],"иййаака на`буду уа'иййаака наста`иин","Тебе одному мы поклоняемся и Тебя одного молим о помощи.",["Тебе (одному)","мы поклоняемся","и Тебя (одного)","мы просим о помощи"]],[1,6,["ٱهۡدِنَا","ٱلصِّرَٰطَ","ٱلۡمُسۡتَقِيمَ"],"ихдинаа ссираата лмустакиим","Веди нас прямым путем,",["веди нас","путем","прямым"]],[1,7,["صِرَٰطَ","ٱلَّذِينَ","أَنۡعَمۡتَ","عَلَيۡهِمۡ","غَيۡرِ","ٱلۡمَغۡضُوبِ","عَلَيۡهِمۡ","وَلَا","ٱلضَّآلِّينَ"],"сираата ллазиина ан`амта `алайхим гайри лмагдууби `алайхим уалаа ддааллиин","путем тех, кого Ты облагодетельствовал, не тех, на кого пал гнев, и не заблудших.",["путем","тех, которых","Ты облагодетельствовал","их","не (тех)","разгневались (на кого)","на них","и не","заблудших"]]]}