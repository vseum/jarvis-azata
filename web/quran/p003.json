{"p":3,"j":1,"a":[[2,6,["إِنَّ","ٱلَّذِينَ","كَفَرُواْ","سَوَآءٌ","عَلَيۡهِمۡ","ءَأَنذَرۡتَهُمۡ","أَمۡ","لَمۡ","تُنذِرۡهُمۡ","لَا","يُؤۡمِنُونَ"],"иннал лазиина кафаруу саваун `алайхим а'анзартахум ам лам тунзирхум ла йу'минуун","Воистину, неверующим безразлично, предостерег ты их или не предостерег. Они все равно не уверуют.",["поистине","те, которые","не уверовали","одинаково","для них","предостерёг ли ты их","или","не","предостерёг ты их","не","уверуют"]],[2,7,["خَتَمَ","ٱللَّهُ","عَلَىٰ","قُلُوبِهِمۡ","وَعَلَىٰ","سَمۡعِهِمۡۖ","وَعَلَىٰٓ","أَبۡصَٰرِهِمۡ","غِشَٰوَةٞۖ","وَلَهُمۡ","عَذَابٌ","عَظِيمٞ"],"хатамаллаху `ала ḳулуубихим ва`ала сам`ихим ва`ала абсарихим гишаватун валахум `азабун `азиим","Аллах запечатал их сердца и слух, а на глазах у них - покрывало. Им уготованы великие мучения.",["запечатал","Аллах","на","их сердцах","и на","их слухе","и на","их взорах","покрывало","и для них","наказание","великое"]],[2,8,["وَمِنَ","ٱلنَّاسِ","مَن","يَقُولُ","ءَامَنَّا","بِٱللَّهِ","وَبِٱلۡيَوۡمِ","ٱلۡأٓخِرِ","وَمَا","هُم","بِمُؤۡمِنِينَ"],"ваминан наси ман йаḳуулу аманна биллахи вабилйаумил ахири вама хум биму'миниин","Среди людей есть такие, которые говорят: «Мы уверовали в Аллаха и в Последний день». Однако они суть неверующие.",["и среди","людей","тот, кто","говорит","мы уверовали","в Аллаха","и в день","Последний","но не","они","верующие"]],[2,9,["يُخَٰدِعُونَ","ٱللَّهَ","وَٱلَّذِينَ","ءَامَنُواْ","وَمَا","يَخۡدَعُونَ","إِلَّآ","أَنفُسَهُمۡ","وَمَا","يَشۡعُرُونَ"],"йухади`ууналлаха валлазиина амануу вама йахда`ууна илла анфусахум вама йаш`уруун","Они пытаются обмануть Аллаха и верующих, но обманывают только самих себя и не осознают этого.",["пытаются обмануть","Аллаха","и тех, которые","уверовали","но не","обманывают они","кроме","самих себя","и не","осознают"]],[2,10,["فِي","قُلُوبِهِم","مَّرَضٞ","فَزَادَهُمُ","ٱللَّهُ","مَرَضٗاۖ","وَلَهُمۡ","عَذَابٌ","أَلِيمُۢ","بِمَا","كَانُواْ","يَكۡذِبُونَ"],"фии ḳулуубихим марадун фазадахумуллаху марадан валахум `азабун алииму бима кануу йакзибуун","Их сердца поражены недугом. Да усилит Аллах их недуг! Им уготованы мучительные страдания за то, что они лгали.",["в","их сердцах","болезнь","и увеличил им","Аллах","болезнь","и для них","наказание","мучительное","за то, что","они были","лгали"]],[2,11,["وَإِذَا","قِيلَ","لَهُمۡ","لَا","تُفۡسِدُواْ","فِي","ٱلۡأَرۡضِ","قَالُوٓاْ","إِنَّمَا","نَحۡنُ","مُصۡلِحُونَ"],"ва'иза ḳиила лахум ла туфсидуу фил арди ḳалуу иннама нахну муслихуун","Когда им говорят: «Не распространяйте нечестия на земле!». - они отвечают: «Только мы и устанавливаем порядок».",["и когда","сказано","им","не","распространяйте нечестие","на","земле","говорят","лишь","мы","устанавливающие порядок"]],[2,12,["أَلَآ","إِنَّهُمۡ","هُمُ","ٱلۡمُفۡسِدُونَ","وَلَٰكِن","لَّا","يَشۡعُرُونَ"],"ала иннахум хумул муфсидууна валакил ла йаш`уруун","Воистину, именно они распространяют нечестие, но они не осознают этого.",["знайте же","поистине, они","именно они","сеющие нечестие","но","не","осознают"]],[2,13,["وَإِذَا","قِيلَ","لَهُمۡ","ءَامِنُواْ","كَمَآ","ءَامَنَ","ٱلنَّاسُ","قَالُوٓاْ","أَنُؤۡمِنُ","كَمَآ","ءَامَنَ","ٱلسُّفَهَآءُۗ","أَلَآ","إِنَّهُمۡ","هُمُ","ٱلسُّفَهَآءُ","وَلَٰكِن","لَّا","يَعۡلَمُونَ"],"ва'иза ḳиила лахум аминуу кама аманан насу ḳалуу ану'мину кама аманас суфахау ала иннахум хумус суфахау валакил ла йа`ламуун","Когда им говорят: «Уверуйте так, как уверовали люди», - они отвечают: «Неужели мы уверуем так, как уверовали глупцы?». Воистину, именно они являются глупцами, но они не знают этого.",["и когда","сказано","им","уверуйте","как","уверовали","люди","говорят","неужели уверуем мы","как","уверовали","глупцы","о да","поистине, они","именно они","глупцы","но","не","знают"]],[2,14,["وَإِذَا","لَقُواْ","ٱلَّذِينَ","ءَامَنُواْ","قَالُوٓاْ","ءَامَنَّا","وَإِذَا","خَلَوۡاْ","إِلَىٰ","شَيَٰطِينِهِمۡ","قَالُوٓاْ","إِنَّا","مَعَكُمۡ","إِنَّمَا","نَحۡنُ","مُسۡتَهۡزِءُونَ"],"ва'иза лаḳул лазиина амануу ḳалуу аманна ва'иза халау ила шайатиинихим ḳалуу инна ма`акум иннама нахну мустахзиуун","Когда они встречают верующих, то говорят: «Мы уверовали». Когда же они остаются наедине со своими дьяволами, они говорят: «Воистину, мы - с вами. Мы лишь издеваемся».",["и когда","встречают","тех, которые","уверовали","говорят","мы уверовали","а когда","остаются наедине","с","своими дьяволами","говорят","поистине, мы","с вами","лишь","мы","насмехающиеся"]],[2,15,["ٱللَّهُ","يَسۡتَهۡزِئُ","بِهِمۡ","وَيَمُدُّهُمۡ","فِي","طُغۡيَٰنِهِمۡ","يَعۡمَهُونَ"],"аллаху йастахзиу бихим вайамуддухум фии тугйанихим йа`махуун","Аллах поиздевается над ними и увеличит их беззаконие, в котором они скитаются вслепую.",["Аллах","насмехается","над ними","и продлевает им","в","их беззаконии","скитаются вслепую"]],[2,16,["أُوْلَٰٓئِكَ","ٱلَّذِينَ","ٱشۡتَرَوُاْ","ٱلضَّلَٰلَةَ","بِٱلۡهُدَىٰ","فَمَا","رَبِحَت","تِّجَٰرَتُهُمۡ","وَمَا","كَانُواْ","مُهۡتَدِينَ"],"улаикал лазиинаштаравуд далалата билхуда фама рабихат тижаратухум вама кануу мухтадиин","Они - те, которые купили заблуждение за верное руководство. Но сделка не принесла им прибыли, и они не последовали прямым путем.",["те","которые","купили","заблуждение","за руководство","и не","принесла прибыль","их торговля","и не","были они","идущими прямо"]]],"m":[[["إِنَّ","поистине",2,6],["ٱلَّذِينَ","те, которые",2,6],["كَفَرُواْ","не уверовали",2,6],["سَوَآءٌ","одинаково",2,6],["عَلَيۡهِمۡ","для них",2,6],["ءَأَنذَرۡتَهُمۡ","предостерёг ли ты их",2,6],["أَمۡ","или",2,6],["لَمۡ","не",2,6],["تُنذِرۡهُمۡ","предостерёг ты их",2,6]],[["لَا","не",2,6],["يُؤۡمِنُونَ","уверуют",2,6],[6],["خَتَمَ","запечатал",2,7],["ٱللَّهُ","Аллах",2,7],["عَلَىٰ","на",2,7],["قُلُوبِهِمۡ","их сердцах",2,7],["وَعَلَىٰ","и на",2,7],["سَمۡعِهِمۡۖ","их слухе",2,7],["وَعَلَىٰٓ","и на",2,7]],[["أَبۡصَٰرِهِمۡ","их взорах",2,7],["غِشَٰوَةٞۖ","покрывало",2,7],["وَلَهُمۡ","и для них",2,7],["عَذَابٌ","наказание",2,7],["عَظِيمٞ","великое",2,7],[7],["وَمِنَ","и среди",2,8],["ٱلنَّاسِ","людей",2,8]],[["مَن","тот, кто",2,8],["يَقُولُ","говорит",2,8],["ءَامَنَّا","мы у