{"p":4,"j":1,"a":[[2,17,["مَثَلُهُمۡ","كَمَثَلِ","ٱلَّذِي","ٱسۡتَوۡقَدَ","نَارٗا","فَلَمَّآ","أَضَآءَتۡ","مَا","حَوۡلَهُۥ","ذَهَبَ","ٱللَّهُ","بِنُورِهِمۡ","وَتَرَكَهُمۡ","فِي","ظُلُمَٰتٖ","لَّا","يُبۡصِرُونَ"],"масалухум камасалил лазистауḳада наран фаламма адаат ма хаулахуу захабаллаху бинуурихим ватаракахум фии зулуматил ла йубсируун","Они подобны тому, кто разжег огонь. Когда же огонь озарил все вокруг него, Аллах лишил их света и оставил их в темноте, где они ничего не видят.",["их пример","как пример","того, кто","разжёг","огонь","и когда","осветил","то, что","вокруг него","унёс","Аллах","их свет","и оставил их","во","мраках","не","видят"]],[2,18,["صُمُّۢ","بُكۡمٌ","عُمۡيٞ","فَهُمۡ","لَا","يَرۡجِعُونَ"],"сумму букмун `умйун фахум ла йаржи`уун","Глухие, немые, слепые! Они не вернутся на прямой путь.",["глухие","немые","слепые","и они","не","вернутся"]],[2,19,["أَوۡ","كَصَيِّبٖ","مِّنَ","ٱلسَّمَآءِ","فِيهِ","ظُلُمَٰتٞ","وَرَعۡدٞ","وَبَرۡقٞ","يَجۡعَلُونَ","أَصَٰبِعَهُمۡ","فِيٓ","ءَاذَانِهِم","مِّنَ","ٱلصَّوَٰعِقِ","حَذَرَ","ٱلۡمَوۡتِۚ","وَٱللَّهُ","مُحِيطُۢ","بِٱلۡكَٰفِرِينَ"],"ау касаййибим минас самаи фиихи зулуматун вара`дун вабарḳун йаж`алууна асаби`ахум фии азанихим минас сава`иḳи хазарал маути валлаху мухииту билкафириин","Или же они подобны тем, кто оказался под ливнем с неба. Он несет мрак, гром и молнию. Они же в смертельном страхе затыкают уши пальцами от грохота молний. Воистину, Аллах объемлет неверующих.",["или","как ливень","с","неба","в нём","мраки","и гром","и молния","вкладывают","свои пальцы","в","свои уши","от","раскатов молний","в страхе","смерти","а Аллах","объемлющий","неверующих"]],[2,20,["يَكَادُ","ٱلۡبَرۡقُ","يَخۡطَفُ","أَبۡصَٰرَهُمۡۖ","كُلَّمَآ","أَضَآءَ","لَهُم","مَّشَوۡاْ","فِيهِ","وَإِذَآ","أَظۡلَمَ","عَلَيۡهِمۡ","قَامُواْۚ","وَلَوۡ","شَآءَ","ٱللَّهُ","لَذَهَبَ","بِسَمۡعِهِمۡ","وَأَبۡصَٰرِهِمۡۚ","إِنَّ","ٱللَّهَ","عَلَىٰ","كُلِّ","شَيۡءٖ","قَدِيرٞ"],"йакадул барḳу йахтафу абсарахум куллама адаа лахум машау фиихи ва'иза азлама `алайхим ḳамуу валау шааллаху лазахаба бисам`ихим ва'абсарихим инналлаха `ала кулли шай'ин ḳадиир","Молния готова отнять у них зрение. Когда она вспыхивает, они отправляются в путь, когда же опускается мрак, они останавливаются. Если бы Аллах пожелал, Он лишил бы их слуха и зрения. Воистину, Аллах способен на всякую вещь.",["почти","молния","похищает","их зрение","всякий раз, как","озаряет","им","идут","в нём","и когда","темнеет","над ними","останавливаются","и если бы","пожелал","Аллах","непременно отнял бы","их слух","и их зрение","поистине","Аллах","над","всякой","вещью","Всемогущ"]],[2,21,["يَٰٓأَيُّهَا","ٱلنَّاسُ","ٱعۡبُدُواْ","رَبَّكُمُ","ٱلَّذِي","خَلَقَكُمۡ","وَٱلَّذِينَ","مِن","قَبۡلِكُمۡ","لَعَلَّكُمۡ","تَتَّقُونَ"],"йа'аййухан насу`будуу раббакумул лазии халаḳакум валлазиина мин ḳабликум ла`аллакум таттаḳуун","О люди! Поклоняйтесь вашему Господу, Который сотворил вас и тех, кто был до вас, - быть может, вы устрашитесь.",["о","люди","поклоняйтесь","вашему Господу","Который","сотворил вас","и тех, которые","из","прежде вас","быть может, вы","устрашитесь"]],[2,22,["ٱلَّذِي","جَعَلَ","لَكُمُ","ٱلۡأَرۡضَ","فِرَٰشٗا","وَٱلسَّمَآءَ","بِنَآءٗ","وَأَنزَلَ","مِنَ","ٱلسَّمَآءِ","مَآءٗ","فَأَخۡرَجَ","بِهِۦ","مِنَ","ٱلثَّمَرَٰتِ","رِزۡقٗا","لَّكُمۡۖ","فَلَا","تَجۡعَلُواْ","لِلَّهِ","أَندَادٗا","وَأَنتُمۡ","تَعۡلَمُونَ"],"аллазии жа`ала лакумул арда фирашан вассамаа бинаан ва'анзала минас самаи маан фа'ахража бихии минас самарати ризḳал лакум фала таж`алуу лиллахи андадан ва'антум та`ламуун","Он сделал для вас землю ложем, а небо - кровлей, низвел с неба воду и взрастил ею плоды для вашего пропитания. Посему никого не равняйте с Аллахом сознательно.",["Который","сделал","для вас","землю","ложем","и небо","кровлей","и низвёл","с","неба","воду","и вывел","ею","из","плодов","пропитание","для вас","так не","делайте","Аллаху","равных","тогда как вы","знаете"]],[2,23,["وَإِن","كُنتُمۡ","فِي","رَيۡبٖ","مِّمَّا","نَزَّلۡنَا","عَلَىٰ","عَبۡدِنَا","فَأۡتُواْ","بِسُورَةٖ","مِّن","مِّثۡلِهِۦ","وَٱدۡعُواْ","شُهَدَآءَكُم","مِّن","دُونِ","ٱللَّهِ","إِن","كُنتُمۡ","صَٰدِقِينَ"],"ва'ин кунтум фии райбим мимма наззална `ала `абдина фа'туу бисууратим мим мислихии вад`уу шухадаакум мин дууниллахи ин кунтум садиḳиин","Если же вы сомневаетесь в том, что Мы ниспослали Нашему рабу, то сочините одну подобную суру и призовите своих свидетелей, помимо Аллаха, если вы говорите правду.",["и если","вы","в","сомнении","в том, что","Мы ниспослали","на","Нашего раба","то приведите","суру","из","подобного ему","и призовите","своих свидетелей","из","помимо","Аллаха","если","вы","правдивы"]],[2,24,["فَإِن","لَّمۡ","تَفۡعَلُواْ","وَلَن","تَفۡعَلُواْ","فَٱتَّقُواْ","ٱلنَّارَ","ٱلَّتِي","وَقُودُهَا","ٱلنَّاسُ","وَٱلۡحِجَارَةُۖ","أُعِدَّتۡ","لِلۡكَٰفِرِينَ"],"фа'ил лам таф`алуу валан таф`алуу фаттаḳун нарал латии ваḳуудухан насу валхижарату у`иддат лилкафириин","Если же вы этого не сделаете - а ведь вы никогда этого не сделаете, - то побойтесь Огня, растопкой которого являются люди и камни. Он уготован для неверующих.",["а если","не","сделаете","и никогда не","сделаете","то бойтесь","Огня","который","его топливо","люди","и камни","уготован","для неверующих"]]],"m":[[["مَثَلُهُمۡ","их пример",2,17],["كَمَثَلِ","как пример",2,17],["ٱلَّذِي","того, кто",2,17],["ٱسۡتَوۡقَدَ","разжёг",2,17],["نَارٗا","огонь",2,17],["فَلَمَّآ","и когда",2,17],["أَضَآءَتۡ","осветил",2,17],["مَا","то, что",2,17],["حَوۡلَهُۥ","вокруг него",2,17]],[["ذَهَبَ","унёс",2,17],["ٱللَّهُ","Аллах",2,17],["بِنُورِهِمۡ","их свет",2,17],["وَتَرَكَهُمۡ","и оставил их",2,17],["فِي","во",2,17],["ظُلُمَٰتٖ","мраках",2,17],["لَّا","не",2,17],["يُبۡصِرُونَ","видят",2,17],[17],["صُمُّۢ","глухие",2,18]],[["بُكۡمٌ","немые",2,18],["عُمۡيٞ","слепые",2,18],["فَهُمۡ","и они",2,18],["لَا","не",2,18],["يَرۡجِعُونَ","вернутся",2,18],[18],["أَوۡ","или",2,19],["كَصَيِّبٖ","как ливень",2,19],["مِّنَ","с",2,19],["ٱلسَّمَآءِ","неба",2,19],["فِيهِ","в нём",2,19]],[["ظُلُمَٰتٞ","мраки",2,19],["وَرَعۡدٞ","и гром",2,19],["و