{"p":5,"j":1,"a":[[2,25,["وَبَشِّرِ","ٱلَّذِينَ","ءَامَنُواْ","وَعَمِلُواْ","ٱلصَّٰلِحَٰتِ","أَنَّ","لَهُمۡ","جَنَّٰتٖ","تَجۡرِي","مِن","تَحۡتِهَا","ٱلۡأَنۡهَٰرُۖ","كُلَّمَا","رُزِقُواْ","مِنۡهَا","مِن","ثَمَرَةٖ","رِّزۡقٗا","قَالُواْ","هَٰذَا","ٱلَّذِي","رُزِقۡنَا","مِن","قَبۡلُۖ","وَأُتُواْ","بِهِۦ","مُتَشَٰبِهٗاۖ","وَلَهُمۡ","فِيهَآ","أَزۡوَٰجٞ","مُّطَهَّرَةٞۖ","وَهُمۡ","فِيهَا","خَٰلِدُونَ"],"вабашширил лазиина амануу ва`амилус салихати анна лахум жаннатин тажрии мин тахтихал анхару куллама рузиḳуу минха мин самаратир ризḳан ḳалуу хазал лазии рузиḳна мин ḳаблу ва'утуу бихии муташабихан валахум фииха азважум мутаххаратун вахум фииха халидуун","Обрадуй тех, которые уверовали и совершали праведные деяния, тем, что им уготованы Райские сады, в которых текут реки. Всякий раз, когда им будут подавать плоды для пропитания, они будут говорить: «Это уже было даровано нам прежде». Но им будут давать нечто похожее. У них там будут очищенные супруги, и они пребудут там вечно.",["и обрадуй","тех, которые","уверовали","и совершали","праведные деяния","что","для них","сады","текут","из","под ними","реки","всякий раз, когда","наделены они","из них","из","плода","пропитанием","говорят","это","то, чем","мы были наделены","из","прежде","и дано им","его","схожим","и для них","в них","супруги","очищенные","и они","в них","вечно пребывающие"]],[2,26,["إِنَّ","ٱللَّهَ","لَا","يَسۡتَحۡيِۦٓ","أَن","يَضۡرِبَ","مَثَلٗا","مَّا","بَعُوضَةٗ","فَمَا","فَوۡقَهَاۚ","فَأَمَّا","ٱلَّذِينَ","ءَامَنُواْ","فَيَعۡلَمُونَ","أَنَّهُ","ٱلۡحَقُّ","مِن","رَّبِّهِمۡۖ","وَأَمَّا","ٱلَّذِينَ","كَفَرُواْ","فَيَقُولُونَ","مَاذَآ","أَرَادَ","ٱللَّهُ","بِهَٰذَا","مَثَلٗاۘ","يُضِلُّ","بِهِۦ","كَثِيرٗا","وَيَهۡدِي","بِهِۦ","كَثِيرٗاۚ","وَمَا","يُضِلُّ","بِهِۦٓ","إِلَّا","ٱلۡفَٰسِقِينَ"],"инналлаха ла йастахйии ан йадриба масалам ма ба`уудатан фама фауḳаха фа'аммал лазиина амануу файа`ламууна аннахул хаḳḳу мир раббихим ва'аммал лазиина кафаруу файаḳуулууна маза арадаллаху бихаза масалан йудиллу бихии касииран вайахдии бихии касииран вама йудиллу бихии иллал фасиḳиин","Воистину, Аллах не смущается приводить притчи о комаре или том, что больше него. Те, которые уверовали, знают, что это - истина от их Господа. Те же, которые не уверовали, говорят: «Чего хотел Аллах, когда приводил эту притчу?». Посредством нее Он многих вводит в заблуждение, а многих наставляет на прямой путь. Однако вводит Он в заблуждение посредством нее только нечестивцев,",["поистине","Аллах","не","стесняется","чтобы","привести","притчу","какую-либо","о комаре","и о том, что","выше него","и что касается","тех, которые","уверовали","то знают они","что она","истина","от","их Господа","а что касается","тех, которые","не уверовали","то говорят","что","пожелал","Аллах","этой","притчей","вводит в заблуждение Он","ею","многих","и наставляет Он","ею","многих","и не","вводит в заблуждение Он","ею","кроме","нечестивцев"]],[2,27,["ٱلَّذِينَ","يَنقُضُونَ","عَهۡدَ","ٱللَّهِ","مِنۢ","بَعۡدِ","مِيثَٰقِهِۦ","وَيَقۡطَعُونَ","مَآ","أَمَرَ","ٱللَّهُ","بِهِۦٓ","أَن","يُوصَلَ","وَيُفۡسِدُونَ","فِي","ٱلۡأَرۡضِۚ","أُوْلَٰٓئِكَ","هُمُ","ٱلۡخَٰسِرُونَ"],"аллазиина йанḳудууна `ахдаллахи мим ба`ди миисаḳихии вайаḳта`ууна ма амараллаху бихии ан йуусала вайуфсидууна фил арди улаика хумул хасируун","которые нарушают завет с Аллахом после того, как они заключили его, разрывают то, что Аллах велел поддерживать, и распространяют нечестие на земле. Именно они окажутся в убытке.",["те, которые","нарушают","завет","Аллаха","из","после","его заключения","и разрывают","то, что","повелел","Аллах","о нём","чтобы","было соединено","и распространяют нечестие","на","земле","те","они","потерпевшие убыток"]],[2,28,["كَيۡفَ","تَكۡفُرُونَ","بِٱللَّهِ","وَكُنتُمۡ","أَمۡوَٰتٗا","فَأَحۡيَٰكُمۡۖ","ثُمَّ","يُمِيتُكُمۡ","ثُمَّ","يُحۡيِيكُمۡ","ثُمَّ","إِلَيۡهِ","تُرۡجَعُونَ"],"кайфа такфурууна биллахи вакунтум амватан фа'ахйакум сумма йумиитукум сумма йухйиикум сумма илайхи туржа`уун","Как вы можете не веровать в Аллаха, тогда как вы были мертвы, и Он оживил вас? Потом Он умертвит вас, потом оживит, а потом вы будете возвращены к Нему.",["как","не веруете вы","в Аллаха","а были вы","мёртвыми","и Он оживил вас","затем","Он умертвит вас","затем","Он оживит вас","затем","к Нему","будете возвращены"]],[2,29,["هُوَ","ٱلَّذِي","خَلَقَ","لَكُم","مَّا","فِي","ٱلۡأَرۡضِ","جَمِيعٗا","ثُمَّ","ٱسۡتَوَىٰٓ","إِلَى","ٱلسَّمَآءِ","فَسَوَّىٰهُنَّ","سَبۡعَ","سَمَٰوَٰتٖۚ","وَهُوَ","بِكُلِّ","شَيۡءٍ","عَلِيمٞ"],"хуал лазии халаḳа лакум ма фил арди жамии`ан суммастава илас самаи фасаввахунна саб`а самаватин вахуа бикулли шай'ин `алиим","Он - Тот, Кто сотворил для вас все, что на земле, а затем обратился к небу и сделал его семью небесами. Ему известно о всякой вещи.",["Он","Тот, Кто","сотворил","для вас","то, что","на","земле","всё","затем","обратился","к","небу","и выровнял их","семь","небес","и Он","о всякой","вещи","Знающий"]]],"m":[[["وَبَشِّرِ","и обрадуй",2,25],["ٱلَّذِينَ","тех, которые",2,25],["ءَامَنُواْ","уверовали",2,25],["وَعَمِلُواْ","и совершали",2,25],["ٱلصَّٰلِحَٰتِ","праведные деяния",2,25],["أَنَّ","что",2,25],["لَهُمۡ","для них",2,25],["جَنَّٰتٖ","сады",2,25]],[["تَجۡرِي","текут",2,25],["مِن","из",2,25],["تَحۡتِهَا","под ними",2,25],["ٱلۡأَنۡهَٰرُۖ","реки",2,25],["كُلَّمَا","всякий раз, когда",2,25],["رُزِقُواْ","наделены они",2,25],["مِنۡهَا","из них",2,25],["مِن","из",2,25],["ثَمَرَةٖ","плода",2,25]],[["رِّزۡقٗا","пропитанием",2,25],["قَالُواْ","говорят",2,25],["هَٰذَا","это",2,25],["ٱلَّذِي","то, чем",2,25],["رُزِقۡنَا","мы были наделены",2,25],["مِن","из",2,25],["قَبۡلُۖ","прежде",2,25],["وَأُتُواْ","и дано им",2,25],["بِهِۦ","его",2,25],["مُتَشَٰبِهٗاۖ","схожим",2,25]],[["وَلَهُمۡ","и для них",2,25],["فِيهَآ","в них",2,25],["أَزۡوَٰجٞ","супруги",2,25],["مُّطَهَّرَةٞۖ","очищенные",2,25],["وَهُمۡ","и они",2,25],["فِيهَا","в них",2,25],["خَٰلِدُونَ","вечно пребывающие",2,25],[25]],[["۞ إِنَّ","поистине",2,26],["ٱللَّهَ","Аллах",2,26],["لَا","не",2,26],["يَسۡتَحۡيِۦٓ","стесняется",2,26],["أَن","чтобы",2,26],["يَضۡرِب