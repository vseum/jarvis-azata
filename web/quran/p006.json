{"p":6,"j":1,"a":[[2,30,["وَإِذۡ","قَالَ","رَبُّكَ","لِلۡمَلَٰٓئِكَةِ","إِنِّي","جَاعِلٞ","فِي","ٱلۡأَرۡضِ","خَلِيفَةٗۖ","قَالُوٓاْ","أَتَجۡعَلُ","فِيهَا","مَن","يُفۡسِدُ","فِيهَا","وَيَسۡفِكُ","ٱلدِّمَآءَ","وَنَحۡنُ","نُسَبِّحُ","بِحَمۡدِكَ","وَنُقَدِّسُ","لَكَۖ","قَالَ","إِنِّيٓ","أَعۡلَمُ","مَا","لَا","تَعۡلَمُونَ"],"ва'из ḳала раббука лилмалаикати иннии жа`илун фил арди халиифатан ḳалуу атаж`алу фииха ман йуфсиду фииха вайасфикуд димаа ванахну нусаббиху бихамдика вануḳаддису лака ḳала иннии а`ламу ма ла та`ламуун","Вот твой Господь сказал ангелам: «Я установлю на земле наместника». Они сказали: «Неужели Ты поселишь там того, кто будет распространять нечестие и проливать кровь, тогда как мы прославляем Тебя хвалой и освящаем Тебя?». Он сказал: «Воистину, Я знаю то, чего вы не знаете».",["и вот","сказал","твой Господь","ангелам","поистине, Я","поставлю","на","земле","наместника","сказали они","неужели Ты поставишь","на ней","того, кто","будет распространять нечестие","на ней","и проливать","кровь","тогда как мы","прославляем","хвалой Тебе","и освящаем","Тебя","сказал Он","поистине, Я","знаю","то, что","не","знаете"]],[2,31,["وَعَلَّمَ","ءَادَمَ","ٱلۡأَسۡمَآءَ","كُلَّهَا","ثُمَّ","عَرَضَهُمۡ","عَلَى","ٱلۡمَلَٰٓئِكَةِ","فَقَالَ","أَنۢبِـُٔونِي","بِأَسۡمَآءِ","هَٰٓؤُلَآءِ","إِن","كُنتُمۡ","صَٰدِقِينَ"],"ва`аллама адамал асмаа куллаха сумма `арадахум `алал малаикати фаḳала амбиуунии би'асмаи ха'улаи ин кунтум садиḳиин","Он научил Адама всевозможным именам, а затем показал их (творения, нареченные именами) ангелам и сказал: «Назовите мне их имена, если вы говорите правду».",["и научил Он","Адама","именам","всем","затем","показал их","перед","ангелами","и сказал","сообщите Мне","имена","этих","если","вы","правдивы"]],[2,32,["قَالُواْ","سُبۡحَٰنَكَ","لَا","عِلۡمَ","لَنَآ","إِلَّا","مَا","عَلَّمۡتَنَآۖ","إِنَّكَ","أَنتَ","ٱلۡعَلِيمُ","ٱلۡحَكِيمُ"],"ḳалуу субханака ла `илма лана илла ма `алламтана иннака антал `алиимул хакиим","Они ответили: «Пречист Ты! Мы знаем только то, чему Ты научил нас. Воистину, Ты - Знающий, Мудрый».",["сказали они","пречист Ты","нет","знания","у нас","кроме","того, чему","Ты научил нас","поистине, Ты","Ты","Знающий","Мудрый"]],[2,33,["قَالَ","يَٰٓـَٔادَمُ","أَنۢبِئۡهُم","بِأَسۡمَآئِهِمۡۖ","فَلَمَّآ","أَنۢبَأَهُم","بِأَسۡمَآئِهِمۡ","قَالَ","أَلَمۡ","أَقُل","لَّكُمۡ","إِنِّيٓ","أَعۡلَمُ","غَيۡبَ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِ","وَأَعۡلَمُ","مَا","تُبۡدُونَ","وَمَا","كُنتُمۡ","تَكۡتُمُونَ"],"ḳала йа'адаму амби'хум би'асмаихим фаламма амбаахум би'асмаихим ḳала алам аḳул лакум иннии а`ламу гайбас самавати вал'арди ва'а`ламу ма тубдууна вама кунтум тактумуун","Он сказал: «О Адам! Поведай им об их именах». Когда Адам поведал им об их именах, Он сказал: «Разве Я не говорил вам, что знаю сокровенное на небесах и земле, и знаю, что вы совершаете открыто и что утаиваете?».",["сказал Он","о Адам","сообщи им","их имена","и когда","он сообщил им","их имена","сказал Он","разве не","говорил Я","вам","поистине, Я","знаю","сокровенное","небес","и земли","и знаю","то, что","обнаруживаете","и то, что","вы","скрывали"]],[2,34,["وَإِذۡ","قُلۡنَا","لِلۡمَلَٰٓئِكَةِ","ٱسۡجُدُواْ","لِأٓدَمَ","فَسَجَدُوٓاْ","إِلَّآ","إِبۡلِيسَ","أَبَىٰ","وَٱسۡتَكۡبَرَ","وَكَانَ","مِنَ","ٱلۡكَٰفِرِينَ"],"ва'из ḳулна лилмалаикатисжудуу ли'адама фасажадуу илла иблииса аба вастакбара вакана минал кафириин","Вот Мы сказали ангелам: «Падите ниц перед Адамом». Они пали ниц, и только Иблис отказался, возгордился и стал одним из неверующих.",["и вот","Мы сказали","ангелам","падите ниц","перед Адамом","и пали они ниц","кроме","Иблиса","отказался он","и возгордился","и стал","из","неверующих"]],[2,35,["وَقُلۡنَا","يَٰٓـَٔادَمُ","ٱسۡكُنۡ","أَنتَ","وَزَوۡجُكَ","ٱلۡجَنَّةَ","وَكُلَا","مِنۡهَا","رَغَدًا","حَيۡثُ","شِئۡتُمَا","وَلَا","تَقۡرَبَا","هَٰذِهِ","ٱلشَّجَرَةَ","فَتَكُونَا","مِنَ","ٱلظَّٰلِمِينَ"],"ваḳулна йа'адамускун анта вазаужукал жанната вакула минха рагадан хайсу ши'тума вала таḳраба хазихиш шажарата фатакууна миназ залимиин","Мы сказали: «О Адам! Поселись в Раю вместе со своей супругой. Ешьте там вволю, где пожелаете, но не приближайтесь к этому дереву, а не то окажетесь одними из беззаконников».",["и Мы сказали","о Адам","поселись","ты","и твоя супруга","в Раю","и ешьте (оба)","из него","вволю","где","пожелаете (оба)","и не","приближайтесь (оба)","к этому","дереву","иначе окажетесь (оба)","из","беззаконников"]],[2,36,["فَأَزَلَّهُمَا","ٱلشَّيۡطَٰنُ","عَنۡهَا","فَأَخۡرَجَهُمَا","مِمَّا","كَانَا","فِيهِۖ","وَقُلۡنَا","ٱهۡبِطُواْ","بَعۡضُكُمۡ","لِبَعۡضٍ","عَدُوّٞۖ","وَلَكُمۡ","فِي","ٱلۡأَرۡضِ","مُسۡتَقَرّٞ","وَمَتَٰعٌ","إِلَىٰ","حِينٖ"],"фа'азаллахумаш шайтану `анха фа'ахражахума мимма кана фиихи ваḳулнахбитуу ба`дукум либа`дин `адуввун валакум фил арди мустаḳаррун вамата`ун ила хиин","Дьявол же побудил их споткнуться о него и вывел их оттуда, где они находились. И тогда Мы сказали: «Низвергнитесь и будьте врагами друг другу! Земля будет для вас обителью и предметом пользования до определенного срока».",["и заставил их оступиться","дьявол","из-за него","и вывел их обоих","из того, где","они оба были","в нём","и Мы сказали","низвергнитесь","одни из вас","другим","враги","и для вас","на","земле","пристанище","и пользование","до","срока"]],[2,37,["فَتَلَقَّىٰٓ","ءَادَمُ","مِن","رَّبِّهِۦ","كَلِمَٰتٖ","فَتَابَ","عَلَيۡهِۚ","إِنَّهُۥ","هُوَ","ٱلتَّوَّابُ","ٱلرَّحِيمُ"],"фаталаḳḳа адаму мир раббихии калиматин фатаба `алайхи иннахуу хуат таввабур рахиим","Адам принял слова от своего Господа, и Он принял его покаяние. Воистину, Он - Принимающий покаяние, Милосердный.",["и принял","Адам","от","своего Господа","слова","и Он принял покаяние","его","поистине, Он","Он","Принимающий покаяние","Милосердный"]]],"m":[[["وَإِذۡ","и вот",2,30],["قَالَ","сказал",2,30],["رَبُّكَ","твой Господь",2,30],["لِلۡمَلَٰٓئِكَةِ","ангелам",2,30],["إِنِّي","поистине, Я",2,30],["جَاعِلٞ","поставлю",2,30],["فِي","на",2,30],["ٱلۡأَرۡضِ","земле",2,30],["خَلِيفَةٗۖ","наместника",2,30]],[["قَالُوٓاْ","сказали они",2,30],["أَتَجۡعَلُ","неужел