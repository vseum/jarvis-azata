{"p":7,"j":1,"a":[[2,38,["قُلۡنَا","ٱهۡبِطُواْ","مِنۡهَا","جَمِيعٗاۖ","فَإِمَّا","يَأۡتِيَنَّكُم","مِّنِّي","هُدٗى","فَمَن","تَبِعَ","هُدَايَ","فَلَا","خَوۡفٌ","عَلَيۡهِمۡ","وَلَا","هُمۡ","يَحۡزَنُونَ"],"ḳулнахбитуу минха жамии`ан фа'имма йа'тийаннакум миннии худан фаман таби`а худайа фала хауфун `алайхим вала хум йахзануун","Мы сказали: «Низвергнитесь отсюда все!». Если к вам явится руководство от Меня, то те, которые последуют за Моим руководством, не познают страха и не будут опечалены.",["Мы сказали","низвергнитесь","из него","все","и если","придёт к вам","от Меня","руководство","то кто","последует","Моему руководству","то нет","страха","над ними","и не","они","опечалятся"]],[2,39,["وَٱلَّذِينَ","كَفَرُواْ","وَكَذَّبُواْ","بِـَٔايَٰتِنَآ","أُوْلَٰٓئِكَ","أَصۡحَٰبُ","ٱلنَّارِۖ","هُمۡ","فِيهَا","خَٰلِدُونَ"],"валлазиина кафаруу ваказзабуу би'айатина улаика асхабун нари хум фииха халидуун","А те, которые не уверуют и сочтут ложью Наши знамения, будут обитателями Огня. Они пребудут там вечно.",["а те, которые","не уверовали","и сочли ложью","Наши знамения","те","обитатели","Огня","они","в нём","вечно пребывающие"]],[2,40,["يَٰبَنِيٓ","إِسۡرَٰٓءِيلَ","ٱذۡكُرُواْ","نِعۡمَتِيَ","ٱلَّتِيٓ","أَنۡعَمۡتُ","عَلَيۡكُمۡ","وَأَوۡفُواْ","بِعَهۡدِيٓ","أُوفِ","بِعَهۡدِكُمۡ","وَإِيَّٰيَ","فَٱرۡهَبُونِ"],"йабании исраиилазкуруу ни`матийал латии ан`амту `алайкум ва'ауфуу би`ахдии ууфи би`ахдикум ва'иййайа фархабуун","О сыны Исраила (Израиля)! Помните милость, которую Я оказал вам. Будьте верны завету со Мной, и Я буду верен завету с вами. Меня одного страшитесь.",["о сыны","Исраила","помните","Мою милость","которую","Я оказал","вам","и будьте верны","Моему завету","Я буду верен","вашему завету","и Меня одного","бойтесь"]],[2,41,["وَءَامِنُواْ","بِمَآ","أَنزَلۡتُ","مُصَدِّقٗا","لِّمَا","مَعَكُمۡ","وَلَا","تَكُونُوٓاْ","أَوَّلَ","كَافِرِۭ","بِهِۦۖ","وَلَا","تَشۡتَرُواْ","بِـَٔايَٰتِي","ثَمَنٗا","قَلِيلٗا","وَإِيَّٰيَ","فَٱتَّقُونِ"],"ва'аминуу бима анзалту мусаддиḳал лима ма`акум вала такуунуу аввала кафири бихии вала таштаруу би'айатии саманан ḳалиилан ва'иййайа фаттаḳуун","Уверуйте в то, что Я ниспослал в подтверждение того, что есть у вас, и не становитесь первыми, кто отказался уверовать в это. Не продавайте Мои знамения за ничтожную цену и Меня одного бойтесь.",["и уверуйте","в то, что","Я ниспослал","подтверждающим","то, что","с вами","и не","будьте","первым","неверующим","в него","и не","выменивайте","Мои знамения","на цену","малую","и Меня одного","бойтесь"]],[2,42,["وَلَا","تَلۡبِسُواْ","ٱلۡحَقَّ","بِٱلۡبَٰطِلِ","وَتَكۡتُمُواْ","ٱلۡحَقَّ","وَأَنتُمۡ","تَعۡلَمُونَ"],"вала талбисул хаḳḳа билбатили ватактумул хаḳḳа ва'антум та`ламуун","Не облекайте истину в ложь и не скрывайте истину, тогда как вы знаете ее.",["и не","облекайте","истину","ложью","и скрывайте","истину","тогда как вы","знаете"]],[2,43,["وَأَقِيمُواْ","ٱلصَّلَوٰةَ","وَءَاتُواْ","ٱلزَّكَوٰةَ","وَٱرۡكَعُواْ","مَعَ","ٱلرَّٰكِعِينَ"],"ва'аḳиимус салавата ва'атуз закавата варка`уу ма`ар раки`иин","Совершайте намаз, выплачивайте закят и кланяйтесь вместе с кланяющимися.",["и совершайте","намаз","и давайте","закят","и кланяйтесь","с","кланяющимися"]],[2,44,["أَتَأۡمُرُونَ","ٱلنَّاسَ","بِٱلۡبِرِّ","وَتَنسَوۡنَ","أَنفُسَكُمۡ","وَأَنتُمۡ","تَتۡلُونَ","ٱلۡكِتَٰبَۚ","أَفَلَا","تَعۡقِلُونَ"],"ата'муруунан наса билбирри ватансауна анфусакум ва'антум татлуунал китаба афала та`ḳилуун","Неужели вы станете призывать людей к добродетели, предав забвению самих себя, ведь вы же читаете Писание? Неужели вы не образумитесь?",["неужели повелеваете вы","людям","благочестие","и забываете","самих себя","тогда как вы","читаете","Писание","неужели не","образумитесь"]],[2,45,["وَٱسۡتَعِينُواْ","بِٱلصَّبۡرِ","وَٱلصَّلَوٰةِۚ","وَإِنَّهَا","لَكَبِيرَةٌ","إِلَّا","عَلَى","ٱلۡخَٰشِعِينَ"],"васта`иинуу биссабри вассалавати ва'иннаха лакабииратун илла `алал хаши`иин","Обратитесь за помощью к терпению и намазу. Воистину, намаз является тяжким бременем для всех, кроме смиренных,",["и просите помощи","терпением","и намазом","и поистине, он","непременно тяжёл","кроме как","для","смиренных"]],[2,46,["ٱلَّذِينَ","يَظُنُّونَ","أَنَّهُم","مُّلَٰقُواْ","رَبِّهِمۡ","وَأَنَّهُمۡ","إِلَيۡهِ","رَٰجِعُونَ"],"аллазиина йазуннууна аннахум мулаḳуу раббихим ва'аннахум илайхи ражи`уун","которые убеждены в том, что они встретятся со своим Господом и что они возвратятся к Нему.",["те, которые","уверены","что они","встретят","своего Господа","и что они","к Нему","возвратятся"]],[2,47,["يَٰبَنِيٓ","إِسۡرَٰٓءِيلَ","ٱذۡكُرُواْ","نِعۡمَتِيَ","ٱلَّتِيٓ","أَنۡعَمۡتُ","عَلَيۡكُمۡ","وَأَنِّي","فَضَّلۡتُكُمۡ","عَلَى","ٱلۡعَٰلَمِينَ"],"йабании исраиилазкуруу ни`матийал латии ан`амту `алайкум ва'аннии фаддалтукум `алал `аламиин","О сыны Исраила (Израиля)! Помните о милости, которую Я оказал вам, а также о том, что Я возвысил вас над мирами.",["о сыны","Исраила","помните","Мою милость","которую","Я оказал","вам","и что Я","возвысил вас","над","мирами"]],[2,48,["وَٱتَّقُواْ","يَوۡمٗا","لَّا","تَجۡزِي","نَفۡسٌ","عَن","نَّفۡسٖ","شَيۡـٔٗا","وَلَا","يُقۡبَلُ","مِنۡهَا","شَفَٰعَةٞ","وَلَا","يُؤۡخَذُ","مِنۡهَا","عَدۡلٞ","وَلَا","هُمۡ","يُنصَرُونَ"],"ваттаḳуу йаумал ла тажзии нафсун `ан нафсин шай'ан вала йуḳбалу минха шафа`атун вала йу'хазу минха `адлун вала хум йунсаруун","Страшитесь того дня, когда ни один человек не принесет пользы другому и когда не будет принято заступничество, когда нельзя будет откупиться и когда им не будет оказана поддержка.",["и бойтесь","дня","не","возместит","душа","за","душу","ничего","и не","будет принято","от неё","заступничество","и не","будет взят","от неё","выкуп","и не","они","получат помощь"]]],"m":[[["قُلۡنَا","Мы сказали",2,38],["ٱهۡبِطُواْ","низвергнитесь",2,38],["مِنۡهَا","из него",2,38],["جَمِيعٗاۖ","все",2,38],["فَإِمَّا","и если",2,38],["يَأۡتِيَنَّكُم","придёт к вам",2,38],["مِّنِّي","от Меня",2,38],["هُدٗى","руководство",2,38],["فَمَن","то кто",2,38],["تَبِعَ","последует",2,38]],[["هُدَايَ","Моему руководству",2,38],["فَلَا","то нет",2,38],["خَوۡفٌ","страха",2,38],[