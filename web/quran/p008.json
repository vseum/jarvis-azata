{"p":8,"j":1,"a":[[2,49,["وَإِذۡ","نَجَّيۡنَٰكُم","مِّنۡ","ءَالِ","فِرۡعَوۡنَ","يَسُومُونَكُمۡ","سُوٓءَ","ٱلۡعَذَابِ","يُذَبِّحُونَ","أَبۡنَآءَكُمۡ","وَيَسۡتَحۡيُونَ","نِسَآءَكُمۡۚ","وَفِي","ذَٰلِكُم","بَلَآءٞ","مِّن","رَّبِّكُمۡ","عَظِيمٞ"],"ва'из нажжайнакум мин али фир`ауна йасуумуунакум сууал `азаби йузаббихууна абнаакум вайастахйууна нисаакум вафии заликум балаум мир раббикум `азиим","Вот Мы спасли вас от рода Фараона. Они подвергали вас ужасным мучениям, убивали ваших сыновей и оставляли в живых ваших женщин. Это было для вас великим испытанием (или великой милостью) от вашего Господа.",["и вот","Мы спасли вас","от","рода","Фараона","подвергали они вас","худшему","наказанию","закалывали","ваших сыновей","и оставляли в живых","ваших женщин","и в","этом","испытание","от","вашего Господа","великое"]],[2,50,["وَإِذۡ","فَرَقۡنَا","بِكُمُ","ٱلۡبَحۡرَ","فَأَنجَيۡنَٰكُمۡ","وَأَغۡرَقۡنَآ","ءَالَ","فِرۡعَوۡنَ","وَأَنتُمۡ","تَنظُرُونَ"],"ва'из фараḳна бикумул бахра фа'анжайнакум ва'аграḳна ала фир`ауна ва'антум танзуруун","Вот Мы разверзли для вас море, спасли вас и потопили род Фараона, тогда как вы наблюдали за этим.",["и вот","Мы разделили","для вас","море","и спасли вас","и потопили","род","Фараона","тогда как вы","смотрели"]],[2,51,["وَإِذۡ","وَٰعَدۡنَا","مُوسَىٰٓ","أَرۡبَعِينَ","لَيۡلَةٗ","ثُمَّ","ٱتَّخَذۡتُمُ","ٱلۡعِجۡلَ","مِنۢ","بَعۡدِهِۦ","وَأَنتُمۡ","ظَٰلِمُونَ"],"ва'из ва`адна мууса арба`иина лайлатан сумматтахазтумул `ижла мим ба`дихии ва'антум залимуун","Вот Мы определили Мусе (Моисею) сорок дней, а после его ухода вы стали поклоняться тельцу, будучи беззаконниками.",["и вот","Мы назначили","Мусе","сорок","ночей","затем","вы взяли (богом)","тельца","из","после него","тогда как вы","беззаконники"]],[2,52,["ثُمَّ","عَفَوۡنَا","عَنكُم","مِّنۢ","بَعۡدِ","ذَٰلِكَ","لَعَلَّكُمۡ","تَشۡكُرُونَ"],"сумма `афауна `анкум мим ба`ди залика ла`аллакум ташкуруун","После этого Мы простили вас, - быть может, вы будете благодарны.",["затем","Мы простили","вас","от","после","этого","может, вы","будете благодарны"]],[2,53,["وَإِذۡ","ءَاتَيۡنَا","مُوسَى","ٱلۡكِتَٰبَ","وَٱلۡفُرۡقَانَ","لَعَلَّكُمۡ","تَهۡتَدُونَ"],"ва'из атайна муусал китаба валфурḳана ла`аллакум тахтадуун","Вот Мы даровали Мусе (Моисею) Писание и различение, - быть может, вы последуете прямым путем.",["и вот","Мы даровали","Мусе","Писание","и различение","может, вы","пойдете прямым путем"]],[2,54,["وَإِذۡ","قَالَ","مُوسَىٰ","لِقَوۡمِهِۦ","يَٰقَوۡمِ","إِنَّكُمۡ","ظَلَمۡتُمۡ","أَنفُسَكُم","بِٱتِّخَاذِكُمُ","ٱلۡعِجۡلَ","فَتُوبُوٓاْ","إِلَىٰ","بَارِئِكُمۡ","فَٱقۡتُلُوٓاْ","أَنفُسَكُمۡ","ذَٰلِكُمۡ","خَيۡرٞ","لَّكُمۡ","عِندَ","بَارِئِكُمۡ","فَتَابَ","عَلَيۡكُمۡۚ","إِنَّهُۥ","هُوَ","ٱلتَّوَّابُ","ٱلرَّحِيمُ"],"ва'из ḳала мууса лиḳаумихии йаḳауми иннакум заламтум анфусакум биттихазикумул `ижла фатуубуу ила бариикум фаḳтулуу анфусакум заликум хайрул лакум `инда бариикум фатаба `алайкум иннахуу хуат таввабур рахиим","Вот сказал Муса (Моисей) своему народу: «О мой народ! Вы были несправедливы к себе, когда стали поклоняться тельцу. Покайтесь перед своим Создателем и убейте сами себя (пусть невинные убьют беззаконников). Так будет лучше для вас перед вашим Создателем». Затем Он принял ваши покаяния. Воистину, Он - Принимающий покаяния, Милосердный.",["и вот","сказал","Муса","своему народу","о мой народ","поистине, вы","обидели","самих себя","тем, что взяли вы","тельца","покайтесь же","перед","вашим Создателем","и убейте","самих себя","это","лучше","для вас","перед","вашим Создателем","и Он принял покаяние","ваше","поистине, Он","Он","Принимающий покаяние","Милосердный"]],[2,55,["وَإِذۡ","قُلۡتُمۡ","يَٰمُوسَىٰ","لَن","نُّؤۡمِنَ","لَكَ","حَتَّىٰ","نَرَى","ٱللَّهَ","جَهۡرَةٗ","فَأَخَذَتۡكُمُ","ٱلصَّٰعِقَةُ","وَأَنتُمۡ","تَنظُرُونَ"],"ва'из ḳултум йамууса лан ну'мина лака хатта нараллаха жахратан фа'ахазаткумус са`иḳату ва'антум танзуруун","Вот вы сказали: «О Муса (Моисей)! Мы не поверим тебе, пока не увидим Аллаха открыто». Вас поразила молния (или постигла гибель), тогда как вы наблюдали за этим.",["и вот","вы сказали","о Муса","никогда не","поверим мы","тебе","пока не","увидим","Аллаха","открыто","и постигла вас","молния","тогда как вы","смотрели"]],[2,56,["ثُمَّ","بَعَثۡنَٰكُم","مِّنۢ","بَعۡدِ","مَوۡتِكُمۡ","لَعَلَّكُمۡ","تَشۡكُرُونَ"],"сумма ба`аснакум мим ба`ди маутикум ла`аллакум ташкуруун","Затем Мы воскресили вас после смерти, - быть может, вы будете благодарны.",["затем","Мы воскресили вас","от","после","вашей смерти","может, вы","будете благодарны"]],[2,57,["وَظَلَّلۡنَا","عَلَيۡكُمُ","ٱلۡغَمَامَ","وَأَنزَلۡنَا","عَلَيۡكُمُ","ٱلۡمَنَّ","وَٱلسَّلۡوَىٰۖ","كُلُواْ","مِن","طَيِّبَٰتِ","مَا","رَزَقۡنَٰكُمۡۚ","وَمَا","ظَلَمُونَا","وَلَٰكِن","كَانُوٓاْ","أَنفُسَهُمۡ","يَظۡلِمُونَ"],"вазаллална `алайкумул гамама ва'анзална `алайкумул манна вассалва кулуу мин таййибати ма разаḳнакум вама заламууна валакин кануу анфусахум йазлимуун","Мы осенили вас облаками и ниспослали манну и перепелов: «Вкушайте блага, которыми Мы наделили вас». Они не были несправедливы по отношению к Нам - они поступали несправедливо лишь по отношению к себе.",["и Мы осенили","над вами","облаками","и Мы ниспослали","вам","манну","и перепелов","ешьте","из","благ","того, чем","Мы наделили вас","и не","обидели они Нас","но","были они","самим себе","несправедливы"]]],"m":[[["وَإِذۡ","и вот",2,49],["نَجَّيۡنَٰكُم","Мы спасли вас",2,49],["مِّنۡ","от",2,49],["ءَالِ","рода",2,49],["فِرۡعَوۡنَ","Фараона",2,49],["يَسُومُونَكُمۡ","подвергали они вас",2,49],["سُوٓءَ","худшему",2,49],["ٱلۡعَذَابِ","наказанию",2,49]],[["يُذَبِّحُونَ","закалывали",2,49],["أَبۡنَآءَكُمۡ","ваших сыновей",2,49],["وَيَسۡتَحۡيُونَ","и оставляли в живых",2,49],["نِسَآءَكُمۡۚ","ваших женщин",2,49],["وَفِي","и в",2,49],["ذَٰلِكُم","этом",2,49],["بَلَآءٞ","испытание",2,49]],[["مِّن","от",2,49],["رَّبِّكُمۡ","вашего Господа",2,49],["عَظِيمٞ","великое",2,49],[49],["وَإِذۡ","и вот",2,50],["فَرَقۡنَا","Мы разделили",2,50],["بِكُمُ","для вас",2,50],["ٱلۡبَحۡرَ","море",2,50],["فَأَنجَيۡنَٰكُمۡ","и спасли вас",2,50]],[["وَأَغۡرَقۡنَآ","и потопили",2,50],["ءَالَ","род",2,50],["فِرۡعَوۡنَ","Фараона",2,50],["وَأَنتُمۡ","тогда как вы",2,50],["تَنظُرُونَ","смотрели",2,50],[50],["وَإِذۡ","и вот",2,51],["وَٰعَدۡنَا","Мы назначили",2,51],["مُوسَىٰٓ","Мусе",2,51]],[["أَرۡبَعِينَ","сорок",2,51],["لَيۡلَةٗ","ночей",2,51],["ثُمَّ","затем",2,51],["ٱتَّخَذۡتُمُ","вы взяли (богом)",2,51],["ٱلۡعِجۡلَ","тельца",2,51],["مِنۢ","из",2,51],["بَعۡدِهِۦ","после него",2,51],["وَأَنتُمۡ","тогда как вы",2,51],["ظَٰلِمُونَ","беззаконники",2,51]],[[51],["ثُمَّ","затем",2,52],["عَفَوۡنَا","Мы простили",2,52],["عَنكُم","вас",2,52],["مِّنۢ","от",2,52],["بَعۡدِ","после",2,52],["ذَٰلِكَ","этого",2,52],["لَعَلَّكُمۡ","может, вы",2,52],["تَشۡكُرُونَ","будете благодарны",2,52],[52]],[["وَإِذۡ","и вот",2,53],["ءَاتَيۡنَا","Мы даровали",2,53],["مُوسَى","Мусе",2,53],["ٱلۡكِتَٰبَ","Писание",2,53],["وَٱلۡفُرۡقَانَ","и различение",2,53],["لَعَلَّكُمۡ","может, вы",2,53],["تَهۡتَدُونَ","пойдете прямым путем",2,53],[53]],[["وَإِذۡ","и вот",2,54],["قَالَ","сказал",2,54],["مُوسَىٰ","Муса",2,54],["لِقَوۡمِهِۦ","своему народу",2,54],["يَٰقَوۡمِ","о мой народ",2,54],["إِنَّكُمۡ","поистине, вы",2,54],["ظَلَمۡتُمۡ","обидели",2,54],["أَنفُسَكُم","самих себя",2,54]],[["بِٱتِّخَاذِكُمُ","тем, что взяли вы",2,54],["ٱلۡعِجۡلَ","тельца",2,54],["فَتُوبُوٓاْ","покайтесь же",2,54],["إِلَىٰ","перед",2,54],["بَارِئِكُمۡ","вашим Создателем",2,54],["فَٱقۡتُلُوٓاْ","и убейте",2,54],["أَنفُسَكُمۡ","самих себя",2,54],["ذَٰلِكُمۡ","это",2,54]],[["خَيۡرٞ","лучше",2,54],["لَّكُمۡ","для вас",2,54],["عِندَ","перед",2,54],["بَارِئِكُمۡ","вашим Создателем",2,54],["فَتَابَ","и Он принял покаяние",2,54],["عَلَيۡكُمۡۚ","ваше",2,54],["إِنَّهُۥ","поистине, Он",2,54],["هُوَ","Он",2,54],["ٱلتَّوَّابُ","Принимающий покаяние",2,54],["ٱلرَّحِيمُ","Милосердный",2,54]],[[54],["وَإِذۡ","и вот",2,55],["قُلۡتُمۡ","вы сказали",2,55],["يَٰمُوسَىٰ","о Муса",2,55],["لَن","никогда не",2,55],["نُّؤۡمِنَ","поверим мы",2,55],["لَكَ","тебе",2,55],["حَتَّىٰ","пока не",2,55],["نَرَى","увидим",2,55],["ٱللَّهَ","Аллаха",2,55],["جَهۡرَةٗ","открыто",2,55]],[["فَأَخَذَتۡكُمُ","и постигла вас",2,55],["ٱلصَّٰعِقَةُ","молния",2,55],["وَأَنتُمۡ","тогда как вы",2,55],["تَنظُرُونَ","смотрели",2,55],[55],["ثُمَّ","затем",2,56],["بَعَثۡنَٰكُم","Мы воскресили вас",2,56],["مِّنۢ","от",2,56]],[["بَعۡدِ","после",2,56],["مَوۡتِكُمۡ","вашей смерти",2,56],["لَعَلَّكُمۡ","может, вы",2,56],["تَشۡكُرُونَ","будете благодарны",2,56],[56],["وَظَلَّلۡنَا","и Мы осенили",2,57],["عَلَيۡكُمُ","над вами",2,57]],[["ٱلۡغَمَامَ","облаками",2,57],["وَأَنزَلۡنَا","и Мы ниспослали",2,57],["عَلَيۡكُمُ","вам",2,57],["ٱلۡمَنَّ","манну",2,57],["وَٱلسَّلۡوَىٰۖ","и перепелов",2,57],["كُلُواْ","ешьте",2,57],["مِن","из",2,57],["طَيِّبَٰتِ","благ",2,57],["مَا","того, чем",2,57]],[["رَزَقۡنَٰكُمۡۚ","Мы наделили вас",2,57],["وَمَا","и не",2,57],["ظَلَمُونَا","обидели они Нас",2,57],["وَلَٰكِن","но",2,57],["كَانُوٓاْ","были они",2,57],["أَنفُسَهُمۡ","самим себе",2,57],["يَظۡلِمُونَ","несправедливы",2,57],[57]]]}