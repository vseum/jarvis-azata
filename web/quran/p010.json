{"p":10,"j":1,"a":[[2,62,["إِنَّ","ٱلَّذِينَ","ءَامَنُواْ","وَٱلَّذِينَ","هَادُواْ","وَٱلنَّصَٰرَىٰ","وَٱلصَّٰبِـِٔينَ","مَنۡ","ءَامَنَ","بِٱللَّهِ","وَٱلۡيَوۡمِ","ٱلۡأٓخِرِ","وَعَمِلَ","صَٰلِحٗا","فَلَهُمۡ","أَجۡرُهُمۡ","عِندَ","رَبِّهِمۡ","وَلَا","خَوۡفٌ","عَلَيۡهِمۡ","وَلَا","هُمۡ","يَحۡزَنُونَ"],"иннал лазиина амануу валлазиина хадуу ваннасара вассаби'иина ман амана биллахи валйаумил ахири ва`амила салихан фалахум ажрухум `инда раббихим вала хауфун `алайхим вала хум йахзануун","Воистину, верующим, а также иудеям, христианам и сабиям, которые уверовали в Аллаха и в Последний день и поступали праведно, уготована награда у их Господа. Они не познают страха и не будут опечалены.",["Поистине","те, которые","уверовали","и те, которые","исповедовали иудаизм","и христиане","и сабии","кто","уверовал","в Аллаха","и в день","Последний","и совершал","праведное","то им","награда их","у","Господа их","и нет","страха","на них","и не","они","будут опечалены"]],[2,63,["وَإِذۡ","أَخَذۡنَا","مِيثَٰقَكُمۡ","وَرَفَعۡنَا","فَوۡقَكُمُ","ٱلطُّورَ","خُذُواْ","مَآ","ءَاتَيۡنَٰكُم","بِقُوَّةٖ","وَٱذۡكُرُواْ","مَا","فِيهِ","لَعَلَّكُمۡ","تَتَّقُونَ"],"ва'из ахазна миисаḳакум варафа`на фауḳакумут туура хузуу ма атайнакум биḳувватин вазкуруу ма фиихи ла`аллакум таттаḳуун","Вот Мы взяли с вас обещание и воздвигли над вами гору: «Крепко придерживайтесь того, что Мы даровали вам, и поминайте то, что содержится там, - быть может, вы устрашитесь».",["И вот","Мы взяли","завет ваш","и Мы подняли","над вами","гору","Держите","то, что","Мы дали вам","с силой","и помните","то, что","в нём","чтобы вы","были богобоязненны"]],[2,64,["ثُمَّ","تَوَلَّيۡتُم","مِّنۢ","بَعۡدِ","ذَٰلِكَۖ","فَلَوۡلَا","فَضۡلُ","ٱللَّهِ","عَلَيۡكُمۡ","وَرَحۡمَتُهُۥ","لَكُنتُم","مِّنَ","ٱلۡخَٰسِرِينَ"],"сумма таваллайтум мим ба`ди залика фалаула фадлуллахи `алайкум варахматухуу лакунтум минал хасириин","После этого вы отвернулись, и если бы не милость и милосердие Аллаха к вам, вы непременно оказались бы в числе потерпевших убыток.",["Затем","отвернулись вы","(от)","после","этого","И если бы не","милость","Аллаха","над вами","и милосердие Его","непременно были бы вы","из","потерпевших убыток"]],[2,65,["وَلَقَدۡ","عَلِمۡتُمُ","ٱلَّذِينَ","ٱعۡتَدَوۡاْ","مِنكُمۡ","فِي","ٱلسَّبۡتِ","فَقُلۡنَا","لَهُمۡ","كُونُواْ","قِرَدَةً","خَٰسِـِٔينَ"],"валаḳад `алимтумул лазиина`тадау минкум фис сабти фаḳулна лахум куунуу ḳирадатан хаси'иин","Вы знали тех из вас, которые нарушили субботу. Мы сказали им: «Будьте обезьянами презренными!».",["И уже","вы знали","тех, которые","преступили","из вас","в","субботу","и Мы сказали","им","Станьте","обезьянами","презренными"]],[2,66,["فَجَعَلۡنَٰهَا","نَكَٰلٗا","لِّمَا","بَيۡنَ","يَدَيۡهَا","وَمَا","خَلۡفَهَا","وَمَوۡعِظَةٗ","لِّلۡمُتَّقِينَ"],"фажа`алнаха накалал лима байна йадайха вама халфаха вамау`изатал лилмуттаḳиин","Мы сделали это примерным наказанием для них самих и для будущих поколений, а также увещеванием для богобоязненных.",["И сделали Мы это","назидательным наказанием","для тех, что","перед","ними","и тех, что","после них","и увещеванием","для богобоязненных"]],[2,67,["وَإِذۡ","قَالَ","مُوسَىٰ","لِقَوۡمِهِۦٓ","إِنَّ","ٱللَّهَ","يَأۡمُرُكُمۡ","أَن","تَذۡبَحُواْ","بَقَرَةٗۖ","قَالُوٓاْ","أَتَتَّخِذُنَا","هُزُوٗاۖ","قَالَ","أَعُوذُ","بِٱللَّهِ","أَنۡ","أَكُونَ","مِنَ","ٱلۡجَٰهِلِينَ"],"ва'из ḳала мууса лиḳаумихии инналлаха йа'мурукум ан тазбахуу баḳаратан ḳалуу ататтахизуна хузуан ḳала а`уузу биллахи ан акууна минал жахилиин","Вот Муса (Моисей) сказал своему народу: «Аллах приказывает вам зарезать корову». Они сказали: «Неужели ты насмехаешься над нами?». Он сказал: «Упаси меня Аллах оказаться одним из невежд».",["И вот","сказал","Муса","народу своему","Поистине","Аллах","велит вам","чтобы","вы зарезали","корову","Они сказали","Неужели ты берёшь нас","на посмешище","Он сказал","Прибегаю к защите","Аллаха","от того, чтобы","мне быть","среди","невежд"]],[2,68,["قَالُواْ","ٱدۡعُ","لَنَا","رَبَّكَ","يُبَيِّن","لَّنَا","مَا","هِيَۚ","قَالَ","إِنَّهُۥ","يَقُولُ","إِنَّهَا","بَقَرَةٞ","لَّا","فَارِضٞ","وَلَا","بِكۡرٌ","عَوَانُۢ","بَيۡنَ","ذَٰلِكَۖ","فَٱفۡعَلُواْ","مَا","تُؤۡمَرُونَ"],"ḳалуд`у лана раббака йубаййил лана ма хийа ḳала иннахуу йаḳуулу иннаха баḳаратул ла фаридун вала бикрун `авану байна залика фаф`алуу ма ту'маруун","Они сказали: «Помолись за нас своему Господу, чтобы Он разъяснил нам, какая она». Он сказал: «Он говорит, что она не старая и не телка, средняя по возрасту между ними. Выполните же то, что вам велено!».",["Они сказали","Помолись","за нас","Господу твоему","пусть разъяснит","нам","какова","она","Он сказал","Поистине, Он","говорит","поистине, она","корова","не","старая","и не","молодая","средняя","между","этим","так делайте","то, что","вам велят"]],[2,69,["قَالُواْ","ٱدۡعُ","لَنَا","رَبَّكَ","يُبَيِّن","لَّنَا","مَا","لَوۡنُهَاۚ","قَالَ","إِنَّهُۥ","يَقُولُ","إِنَّهَا","بَقَرَةٞ","صَفۡرَآءُ","فَاقِعٞ","لَّوۡنُهَا","تَسُرُّ","ٱلنَّٰظِرِينَ"],"ḳалуд`у лана раббака йубаййил лана ма лаунуха ḳала иннахуу йаḳуулу иннаха баḳаратун сафрау фаḳи`ул лаунуха тасуррун назириин","Они сказали: «Помолись за нас своему Господу, чтобы Он разъяснил нам, какой она масти». Он сказал: «Он говорит, что эта корова светло-желтого цвета. Она радует смотрящих на нее».",["Они сказали","Помолись","за нас","Господу твоему","пусть разъяснит","нам","каков","цвет её","Он сказал","Поистине, Он","говорит","поистине, она","корова","жёлтая","яркий","цвет её","радующая","смотрящих"]]],"m":[[["إِنَّ","Поистине",2,62],["ٱلَّذِينَ","те, которые",2,62],["ءَامَنُواْ","уверовали",2,62],["وَٱلَّذِينَ","и те, которые",2,62],["هَادُواْ","исповедовали иудаизм",2,62],["وَٱلنَّصَٰرَىٰ","и христиане",2,62],["وَٱلصَّٰبِـِٔينَ","и сабии",2,62]],[["مَنۡ","кто",2,62],["ءَامَنَ","уверовал",2,62],["بِٱللَّهِ","в Аллаха",2,62],["وَٱلۡيَوۡمِ","и в день",2,62],["ٱلۡأٓخِرِ","Последний",2,62],["وَعَمِلَ","и совершал",2,62],["صَٰلِحٗا","праведное",2,62],["فَلَهُمۡ","то им",2,62],["أَجۡرُهُمۡ","награда их",2,62]],[["عِندَ","у",2,62],["رَبِّهِمۡ","Господа их",2,62],["وَلَا","и нет",2,62],["خَوۡفٌ","страха",2,62],["عَلَيۡهِمۡ","на них",2,62],["وَلَا","и не",2,62],["هُمۡ","они",2,62],["يَحۡزَنُونَ","будут опечалены",2,62],[62],["وَإِذۡ","И вот",2,63]],[["أَخَذۡنَا","Мы взяли",2,63],["مِيثَٰقَكُمۡ","завет ваш",2,63],["وَرَفَعۡنَا","и Мы подняли",2,63],["فَوۡقَكُمُ","над вами",2,63],["ٱلطُّورَ","гору",2,63],["خُذُواْ","Держите",2,63],["مَآ","то, что",2,63],["ءَاتَيۡنَٰكُم","Мы дали вам",2,63]],[["بِقُوَّةٖ","с силой",2,63],["وَٱذۡكُرُواْ","и помните",2,63],["مَا","то, что",2,63],["فِيهِ","в нём",2,63],["لَعَلَّكُمۡ","чтобы вы",2,63],["تَتَّقُونَ","были богобоязненны",2,63],[63],["ثُمَّ","Затем",2,64],["تَوَلَّيۡتُم","отвернулись вы",2,64],["مِّنۢ","(от)",2,64]],[["بَعۡدِ","после",2,64],["ذَٰلِكَۖ","этого",2,64],["فَلَوۡلَا","И если бы не",2,64],["فَضۡلُ","милость",2,64],["ٱللَّهِ","Аллаха",2,64],["عَلَيۡكُمۡ","над вами",2,64],["وَرَحۡمَتُهُۥ","и милосердие Его",2,64],["لَكُنتُم","непременно были бы вы",2,64],["مِّنَ","из",2,64]],[["ٱلۡخَٰسِرِينَ","потерпевших убыток",2,64],[64],["وَلَقَدۡ","И уже",2,65],["عَلِمۡتُمُ","вы знали",2,65],["ٱلَّذِينَ","тех, которые",2,65],["ٱعۡتَدَوۡاْ","преступили",2,65],["مِنكُمۡ","из вас",2,65],["فِي","в",2,65],["ٱلسَّبۡتِ","субботу",2,65]],[["فَقُلۡنَا","и Мы сказали",2,65],["لَهُمۡ","им",2,65],["كُونُواْ","Станьте",2,65],["قِرَدَةً","обезьянами",2,65],["خَٰسِـِٔينَ","презренными",2,65],[65],["فَجَعَلۡنَٰهَا","И сделали Мы это",2,66],["نَكَٰلٗا","назидательным наказанием",2,66],["لِّمَا","для тех, что",2,66]],[["بَيۡنَ","перед",2,66],["يَدَيۡهَا","ними",2,66],["وَمَا","и тех, что",2,66],["خَلۡفَهَا","после них",2,66],["وَمَوۡعِظَةٗ","и увещеванием",2,66],["لِّلۡمُتَّقِينَ","для богобоязненных",2,66],[66],["وَإِذۡ","И вот",2,67],["قَالَ","сказал",2,67]],[["مُوسَىٰ","Муса",2,67],["لِقَوۡمِهِۦٓ","народу своему",2,67],["إِنَّ","Поистине",2,67],["ٱللَّهَ","Аллах",2,67],["يَأۡمُرُكُمۡ","велит вам",2,67],["أَن","чтобы",2,67],["تَذۡبَحُواْ","вы зарезали",2,67],["بَقَرَةٗۖ","корову",2,67],["قَالُوٓاْ","О