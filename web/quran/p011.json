{"p":11,"j":1,"a":[[2,70,["قَالُواْ","ٱدۡعُ","لَنَا","رَبَّكَ","يُبَيِّن","لَّنَا","مَا","هِيَ","إِنَّ","ٱلۡبَقَرَ","تَشَٰبَهَ","عَلَيۡنَا","وَإِنَّآ","إِن","شَآءَ","ٱللَّهُ","لَمُهۡتَدُونَ"],"ḳалуд`у лана раббака йубаййил лана ма хийа иннал баḳара ташабаха `алайна ва'инна ин шааллаху ламухтадуун","Они сказали: «Помолись за нас своему Господу, чтобы Он разъяснил нам, какова же она, ведь коровы кажутся нам похожими одна на другую. И если Аллах пожелает, то мы последуем прямым путем».",["Они сказали","Помолись","за нас","Господу твоему","пусть разъяснит","нам","какая","она","Поистине","коровы","похожи друг на друга","для нас","И поистине, мы","если","пожелает","Аллах","непременно найдём путь"]],[2,71,["قَالَ","إِنَّهُۥ","يَقُولُ","إِنَّهَا","بَقَرَةٞ","لَّا","ذَلُولٞ","تُثِيرُ","ٱلۡأَرۡضَ","وَلَا","تَسۡقِي","ٱلۡحَرۡثَ","مُسَلَّمَةٞ","لَّا","شِيَةَ","فِيهَاۚ","قَالُواْ","ٱلۡـَٰٔنَ","جِئۡتَ","بِٱلۡحَقِّۚ","فَذَبَحُوهَا","وَمَا","كَادُواْ","يَفۡعَلُونَ"],"ḳала иннахуу йаḳуулу иннаха баḳаратул ла залуулун тусиирул арда вала тасḳил харса мусалламатул ла шийата фииха ḳалул ана жи'та билхаḳḳи фазабахууха вама кадуу йаф`алуун","Он сказал: «Он говорит, что эта корова не приучена пахать землю или орошать ниву. Она здорова и не имеет отметин». Они сказали: «Теперь ты принес истину». Затем они зарезали ее, хотя были близки к тому, чтобы не сделать этого.",["Он сказал","Поистине, Он","говорит","поистине, она","корова","не","приученная","вспахивать","землю","и не","орошать","пашню","без изъяна","нет","пятна","на ней","Они сказали","Теперь","ты пришёл","с истиной","И зарезали они её","и не","были близки к тому","чтобы сделать"]],[2,72,["وَإِذۡ","قَتَلۡتُمۡ","نَفۡسٗا","فَٱدَّٰرَٰءۡتُمۡ","فِيهَاۖ","وَٱللَّهُ","مُخۡرِجٞ","مَّا","كُنتُمۡ","تَكۡتُمُونَ"],"ва'из ḳаталтум нафсан фаддара'тум фииха валлаху мухрижум ма кунтум тактумуун","Вот вы убили человека и стали препираться по этому поводу. Но Аллах выявляет то, что вы скрываете.",["И вот","убили вы","человека","и стали препираться","о нём","но Аллах","выводящий наружу","то, что","вы","скрывали"]],[2,73,["فَقُلۡنَا","ٱضۡرِبُوهُ","بِبَعۡضِهَاۚ","كَذَٰلِكَ","يُحۡيِ","ٱللَّهُ","ٱلۡمَوۡتَىٰ","وَيُرِيكُمۡ","ءَايَٰتِهِۦ","لَعَلَّكُمۡ","تَعۡقِلُونَ"],"фаḳулнадрибууху биба`диха казалика йухйиллахул маута вайуриикум айатихии ла`аллакум та`ḳилуун","Мы сказали: «Ударьте его (убитого) частью ее (коровы)». Так Аллах воскрешает мертвых и показывает вам Свои знамения, - быть может, вы уразумеете.",["И Мы сказали","Ударьте его","частью её","Так","оживляет","Аллах","мёртвых","и показывает вам","знамения Его","чтобы вы","уразумели"]],[2,74,["ثُمَّ","قَسَتۡ","قُلُوبُكُم","مِّنۢ","بَعۡدِ","ذَٰلِكَ","فَهِيَ","كَٱلۡحِجَارَةِ","أَوۡ","أَشَدُّ","قَسۡوَةٗۚ","وَإِنَّ","مِنَ","ٱلۡحِجَارَةِ","لَمَا","يَتَفَجَّرُ","مِنۡهُ","ٱلۡأَنۡهَٰرُۚ","وَإِنَّ","مِنۡهَا","لَمَا","يَشَّقَّقُ","فَيَخۡرُجُ","مِنۡهُ","ٱلۡمَآءُۚ","وَإِنَّ","مِنۡهَا","لَمَا","يَهۡبِطُ","مِنۡ","خَشۡيَةِ","ٱللَّهِۗ","وَمَا","ٱللَّهُ","بِغَٰفِلٍ","عَمَّا","تَعۡمَلُونَ"],"сумма ḳасат ḳулуубукум мим ба`ди залика фахийа калхижарати ау ашадду ḳасватан ва'инна минал хижарати лама йатафажжару минхул анхару ва'инна минха лама йашшаḳḳаḳу файахружу минхул мау ва'инна минха лама йахбиту мин хашйатиллахи вамаллаху бигафилин `амма та`малуун","После этого ваши сердца ожесточились и стали, как камни, или даже еще жестче. Воистину, среди камней есть такие, из которых бьют родники. Среди них есть такие, которые раскалываются и изливают воду. Среди них есть такие, которые падают от страха перед Аллахом. Аллах не находится в неведении о том, что вы совершаете.",["Затем","ожесточились","сердца ваши","(от)","после","этого","и они","как камни","или","сильнее","жёсткостью","И поистине","из","камней","непременно то, что","изливаются","из него","реки","и поистине","из них","непременно то, что","раскалывается","и выходит","из него","вода","и поистине","из них","непременно то, что","низвергается","от","страха","перед Аллахом","И не","Аллах","в неведении","о том, что","вы делаете"]],[2,75,["أَفَتَطۡمَعُونَ","أَن","يُؤۡمِنُواْ","لَكُمۡ","وَقَدۡ","كَانَ","فَرِيقٞ","مِّنۡهُمۡ","يَسۡمَعُونَ","كَلَٰمَ","ٱللَّهِ","ثُمَّ","يُحَرِّفُونَهُۥ","مِنۢ","بَعۡدِ","مَا","عَقَلُوهُ","وَهُمۡ","يَعۡلَمُونَ"],"афататма`ууна ан йу'минуу лакум ваḳад кана фарииḳум минхум йасма`ууна каламаллахи сумма йухаррифуунахуу мим ба`ди ма `аḳалууху вахум йа`ламуун","Неужели вы надеетесь, что они поверят вам, если некоторые из них слышали Слово Аллаха и сознательно исказили его после того, как поняли его смысл?",["Неужели вы надеетесь","что","уверуют они","вам","в то время как уже","была","группа","из них","слушали","слово","Аллаха","затем","искажали его","(от)","после","того как","уразумели его","и они","знают"]],[2,76,["وَإِذَا","لَقُواْ","ٱلَّذِينَ","ءَامَنُواْ","قَالُوٓاْ","ءَامَنَّا","وَإِذَا","خَلَا","بَعۡضُهُمۡ","إِلَىٰ","بَعۡضٖ","قَالُوٓاْ","أَتُحَدِّثُونَهُم","بِمَا","فَتَحَ","ٱللَّهُ","عَلَيۡكُمۡ","لِيُحَآجُّوكُم","بِهِۦ","عِندَ","رَبِّكُمۡۚ","أَفَلَا","تَعۡقِلُونَ"],"ва'иза лаḳул лазиина амануу ḳалуу аманна ва'иза хала ба`духум ила ба`дин ḳалуу атухаддисуунахум бима фатахаллаху `алайкум лийухажжуукум бихии `инда раббикум афала та`ḳилуун","Когда они встречали верующих, то говорили: «Мы уверовали». Когда же они оставались наедине друг с другом, то говорили: «Неужели вы расскажете им о том, что открыл вам Аллах, чтобы они могли препираться с вами посредством этого перед вашим Господом? Неужели вы не уразумеете этого?».",["И когда","встречают они","тех, которые","уверовали","говорят они","Мы уверовали","А когда","уединяются","одни из них","с","другими","говорят они","Неужели вы рассказываете им","о том, что","открыл","Аллах","вам","чтобы они спорили с вами","этим","перед","Господом вашим","Разве не","уразумеете вы"]]],"m":[[["قَالُواْ","Они сказали",2,70],["ٱدۡعُ","Помолись",2,70],["لَنَا","за нас",2,70],["رَبَّكَ","Господу твоему",2,70],["يُبَيِّن","пусть разъяснит",2,70],["لَّنَا","нам",2,70],["مَا","какая",2,70],["هِيَ","она",2,70],["إِنَّ","Поистине",2,70],["ٱلۡبَقَرَ","коровы",2,70],["تَشَٰبَهَ","похожи друг на друга",2,70],["عَلَيۡنَا","для нас",2,70],["وَإِنَّآ","И поистине, мы",2,70]],[["إِن","если",2,70],["شَآءَ","пожелает",2,70],["ٱللَّهُ","Аллах",2,70],["لَمُهۡتَدُونَ","непременно найдём путь",2,70],[70],["قَالَ","Он сказал",2,71],["إِنَّهُۥ","Поистине, Он",2,71],["يَقُولُ","говорит",2,71],["إِنَّهَا","поистине, она",2,71],["بَقَرَةٞ","корова",2,71],["لَّا","не",2,71],["ذَلُولٞ","приученная",2,71]],[["تُثِيرُ","вспахивать",2,71],["ٱلۡأَرۡضَ","землю",2,71],["وَلَا","и не",2,71],["تَسۡقِي","орошать",2,71],["ٱلۡحَرۡثَ","пашню",2,71],["مُسَلَّمَةٞ","без изъяна",2,71],["لَّا","нет",2,71],["شِيَةَ","пятна",2,71],["فِيهَاۚ","на ней",2,71],["قَالُواْ","Они сказали",2,71]],[["ٱلۡـَٰٔنَ","Теперь",2,71],["جِئۡتَ","ты пришёл",2,71],["بِٱلۡحَقِّۚ","с истиной",2,71],["فَذَبَحُوهَا","И зарезали они её",2,71],["وَمَا","и не",2,71],["كَادُواْ","были близки к тому",2,71],["يَفۡعَلُونَ","чтобы сделать",2,71],[71],["وَإِذۡ","И вот",2,72]],[["قَتَلۡتُمۡ","убили вы",2,72],["نَفۡسٗا","человека",2,72],["فَٱدَّٰرَٰءۡتُمۡ","и стали препираться",2,72],["فِيهَاۖ","о нём",2,72],["وَٱللَّهُ","но Аллах",2,72],["مُخۡرِجٞ","выводящий наружу",2,72],["مَّا","то, что",2,72],["كُنتُمۡ","вы",2,72],["تَكۡتُمُونَ","скрывали",2,72],[72]],[["فَقُلۡنَا","И Мы сказали",2,73],["ٱضۡرِبُوهُ","Ударьте его",2,73],["بِبَعۡضِهَاۚ","частью её",2,73],["كَذَٰلِكَ","Так",2,73],["يُحۡيِ","оживляет",2,73],["ٱللَّهُ","Аллах",2,73],["ٱلۡمَوۡتَىٰ","мёртвых",2,73],["وَيُرِيكُمۡ","и показывает вам",2,73]],[["ءَايَٰتِهِۦ","знамения Его",2,73],["لَعَلَّكُمۡ","чтобы вы",2,73],["تَعۡقِلُونَ","уразумели",2,73],[73],["ثُمَّ","Затем",2,74],["قَسَتۡ","ожесточились",2,74],["قُلُوبُكُم","сердца ваши",2,74],["مِّنۢ","(от)",2,74],["بَعۡدِ","после",2,74],["ذَٰلِكَ","этого",2,74]],[["فَهِيَ","и они",2,74],["كَٱلۡحِجَارَةِ","как камни",2,74],["أَوۡ","или",2,74],["أَشَدُّ","сильнее",2,74],["قَسۡوَةٗۚ","жёсткостью",2,74],["وَإِنَّ","И поистине",2,74],["مِنَ","из",2,74],["ٱلۡحِجَارَةِ","камней",2,74],["لَمَا","непременно то, что",2,74],["يَتَفَجَّرُ","изливаются",2,74]],[["مِنۡهُ","из него",2,74],["ٱلۡأَنۡهَٰرُۚ","реки",2,74],["وَإِنَّ","и поистине",2,74],["مِنۡهَا","из них",2,74],["لَمَا","непременно то, что",2,74],["يَشَّقَّقُ","раскалывается",2,74],["فَيَخۡرُجُ","и выходит",2,74],["مِنۡهُ","из него",2,74],["ٱلۡمَآءُۚ","вода",2,74],["وَإِنَّ","и поистине",2,74]],[["مِنۡهَا","из них",2,74],["لَمَا","непременно то, что",2,74],["يَهۡبِطُ","низвергается",2,74],["مِنۡ","от",2,74],["خَشۡيَةِ","страха",2,74],["ٱللَّهِۗ","перед Аллахом",2,74],["وَمَا","И не",2,74],["ٱللَّهُ","Аллах",2,74],["بِغَٰفِلٍ","в неведении",2,74],["عَمَّا","о том, что",2,74],["تَعۡمَلُونَ","вы делаете",2,74]],[[74],["۞ أَفَتَطۡمَعُونَ","Неужели вы надеетесь",2,75],["أَن","что",2,75],["يُؤۡمِنُواْ","уверуют они",2,75],["لَكُمۡ","вам",2,75],["وَقَدۡ","в то время как уже",2,75],["كَانَ","была",2,75],["فَرِيقٞ","группа",2,75],["مِّنۡهُمۡ","из них",2,75]],[["يَسۡمَعُونَ","слушали",2,75],["كَلَٰمَ","слово",2,75],["ٱللَّهِ","Аллаха",2,75],["ثُمَّ","затем",2,75],["يُحَرِّفُونَهُۥ","искажали его",2,75],["مِنۢ","(от)",2,75],["بَعۡدِ","после",2,75],["مَا","того как",2,75],["عَقَلُوهُ","уразумели его",2,75]],[["وَهُمۡ","и они",2,75],["يَعۡلَمُونَ","знают",2,75],[75],["وَإِذَا","И когда",2,76],["لَقُواْ","встречают они",2,76],["ٱلَّذِينَ","тех, которые",2,76],["ءَامَنُواْ","уверовали",2,76],["قَالُوٓاْ","говорят они",2,76],["ءَامَنَّا","Мы уверовали",2,76]],[["وَإِذَا","А когда",2,76],["خَلَا","уединяются",2,76],["بَعۡضُهُمۡ","одни из них",2,76],["إِلَىٰ","с",2,76],["بَعۡضٖ","другими",2,76],["قَالُوٓاْ","говорят они",2,76],["أَتُحَدِّثُونَهُم","Неужели вы рассказываете им",2,76],["بِمَا","о том, что",2,76],["فَتَحَ","открыл",2,76]],[["ٱللَّهُ","Аллах",2,76],["عَلَيۡكُمۡ","вам",2,76],["لِيُحَآجُّوكُم","чтобы они спорили с вами",2,76],["بِهِۦ","этим",2,76],["عِندَ","перед",2,76],["رَبِّكُمۡۚ","Господом вашим",2,76],["أَفَلَا","Разве не",2,76],["تَعۡقِلُونَ","уразумеете вы",2,76],[76]]]}