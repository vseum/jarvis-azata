{"p":12,"j":1,"a":[[2,77,["أَوَلَا","يَعۡلَمُونَ","أَنَّ","ٱللَّهَ","يَعۡلَمُ","مَا","يُسِرُّونَ","وَمَا","يُعۡلِنُونَ"],"авала йа`ламууна анналлаха йа`ламу ма йусиррууна вама йу`линуун","Неужели они не знают, что Аллаху ведомо все, что они скрывают и обнародуют?",["Разве не","знают они","что","Аллах","знает","то, что","они скрывают","и то, что","они обнаруживают"]],[2,78,["وَمِنۡهُمۡ","أُمِّيُّونَ","لَا","يَعۡلَمُونَ","ٱلۡكِتَٰبَ","إِلَّآ","أَمَانِيَّ","وَإِنۡ","هُمۡ","إِلَّا","يَظُنُّونَ"],"ваминхум уммиййууна ла йа`ламуунал китаба илла аманиййа ва'ин хум илла йазуннуун","Среди них есть неграмотные люди, которые не знают Писания, а лишь верят пустым мечтам и делают предположения.",["И среди них","неграмотные","не","знают","Писание","кроме","мечтаний","и не","они","лишь","предполагают"]],[2,79,["فَوَيۡلٞ","لِّلَّذِينَ","يَكۡتُبُونَ","ٱلۡكِتَٰبَ","بِأَيۡدِيهِمۡ","ثُمَّ","يَقُولُونَ","هَٰذَا","مِنۡ","عِندِ","ٱللَّهِ","لِيَشۡتَرُواْ","بِهِۦ","ثَمَنٗا","قَلِيلٗاۖ","فَوَيۡلٞ","لَّهُم","مِّمَّا","كَتَبَتۡ","أَيۡدِيهِمۡ","وَوَيۡلٞ","لَّهُم","مِّمَّا","يَكۡسِبُونَ"],"фавайлул лиллазиина йактубуунал китаба би'айдиихим сумма йаḳуулууна хаза мин `индиллахи лийаштаруу бихии саманан ḳалиилан фавайлул лахум мимма катабат айдиихим вавайлул лахум мимма йаксибуун","Горе тем, которые пишут Писание собственными руками, а затем говорят: «Это - от Аллаха», - чтобы купить за это ничтожную цену. Горе им за то, что написали их руки! Горе им за то, что они приобретают!",["Горе же","тем, которые","пишут","Писание","руками своими","затем","говорят","Это","от","(у)","Аллаха","чтобы купить","за него","цену","малую","Горе же","им","за то, что","написали","руки их","и горе","им","за то, что","приобретают они"]],[2,80,["وَقَالُواْ","لَن","تَمَسَّنَا","ٱلنَّارُ","إِلَّآ","أَيَّامٗا","مَّعۡدُودَةٗۚ","قُلۡ","أَتَّخَذۡتُمۡ","عِندَ","ٱللَّهِ","عَهۡدٗا","فَلَن","يُخۡلِفَ","ٱللَّهُ","عَهۡدَهُۥٓۖ","أَمۡ","تَقُولُونَ","عَلَى","ٱللَّهِ","مَا","لَا","تَعۡلَمُونَ"],"ваḳалуу лан тамассанан нару илла аййамам ма`дуудатан ḳул аттахазтум `индаллахи `ахдан фалан йухлифаллаху `ахдахуу ам таḳуулууна `алаллахи ма ла та`ламуун","Они говорят: «Огонь коснется нас лишь на считанные дни». Скажи: «Неужели вы заключили завет с Аллахом? А ведь Аллах никогда не изменит Своему обещанию! Или же вы наговариваете на Аллаха то, чего не знаете?».",["И сказали они","Никогда не","коснётся нас","Огонь","кроме","дней","считанных","Скажи","Разве вы взяли","у","Аллаха","завет","и никогда не","нарушит","Аллах","завет Свой","Или","вы говорите","об","Аллахе","то, что","не","знаете"]],[2,81,["بَلَىٰۚ","مَن","كَسَبَ","سَيِّئَةٗ","وَأَحَٰطَتۡ","بِهِۦ","خَطِيٓـَٔتُهُۥ","فَأُوْلَٰٓئِكَ","أَصۡحَٰبُ","ٱلنَّارِۖ","هُمۡ","فِيهَا","خَٰلِدُونَ"],"бала ман касаба саййиатан ва'ахатат бихии хатииатухуу фа'улаика асхабун нари хум фииха халидуун","О нет! Те, которые приобрели зло и оказались окружены своим грехом, окажутся обитателями Огня. Они пребудут там вечно.",["Напротив","кто","приобрёл","зло","и окружил","его","грех его","то те","обитатели","Огня","они","в нём","вечно пребывают"]],[2,82,["وَٱلَّذِينَ","ءَامَنُواْ","وَعَمِلُواْ","ٱلصَّٰلِحَٰتِ","أُوْلَٰٓئِكَ","أَصۡحَٰبُ","ٱلۡجَنَّةِۖ","هُمۡ","فِيهَا","خَٰلِدُونَ"],"валлазиина амануу ва`амилус салихати улаика асхабул жаннати хум фииха халидуун","А те, которые уверовали и совершали праведные деяния, окажутся обитателями Рая. Они пребудут там вечно.",["А те, которые","уверовали","и совершали","праведные дела","те","обитатели","Рая","они","в нём","вечно пребывают"]],[2,83,["وَإِذۡ","أَخَذۡنَا","مِيثَٰقَ","بَنِيٓ","إِسۡرَٰٓءِيلَ","لَا","تَعۡبُدُونَ","إِلَّا","ٱللَّهَ","وَبِٱلۡوَٰلِدَيۡنِ","إِحۡسَانٗا","وَذِي","ٱلۡقُرۡبَىٰ","وَٱلۡيَتَٰمَىٰ","وَٱلۡمَسَٰكِينِ","وَقُولُواْ","لِلنَّاسِ","حُسۡنٗا","وَأَقِيمُواْ","ٱلصَّلَوٰةَ","وَءَاتُواْ","ٱلزَّكَوٰةَ","ثُمَّ","تَوَلَّيۡتُمۡ","إِلَّا","قَلِيلٗا","مِّنكُمۡ","وَأَنتُم","مُّعۡرِضُونَ"],"ва'из ахазна миисаḳа бании исраиила ла та`будууна иллаллаха вабилвалидайни ихсанан вазил ḳурба валйатама валмасакиини ваḳуулуу линнаси хуснан ва'аḳиимус салавата ва'атуз закавата сумма таваллайтум илла ḳалиилам минкум ва'антум му`ридуун","Вот Мы заключили с сынами Исраила (Израиля) завет о том, что вы не будете поклоняться никому, кроме Аллаха; будете делать добро родителям, а также родственникам, сиротам и беднякам; будете говорить людям прекрасное, совершать намаз и выплачивать закят. Но впоследствии вы отвернулись с отвращением, за исключением немногих.",["И вот","Мы взяли","завет","сынов","Исраила","не","будете поклоняться","кроме","Аллаха","и к родителям","добро","и к обладателям","родства","и сиротам","и бедным","и говорите","людям","хорошее","и выстаивайте","молитву","и давайте","закят","Затем","отвернулись вы","кроме","немногих","из вас","и вы","уклоняющиеся"]]],"m":[[["أَوَلَا","Разве не",2,77],["يَعۡلَمُونَ","знают они",2,77],["أَنَّ","что",2,77],["ٱللَّهَ","Аллах",2,77],["يَعۡلَمُ","знает",2,77],["مَا","то, что",2,77],["يُسِرُّونَ","они скрывают",2,77],["وَمَا","и то, что",2,77],["يُعۡلِنُونَ","они обнаруживают",2,77],[77]],[["وَمِنۡهُمۡ","И среди них",2,78],["أُمِّيُّونَ","неграмотные",2,78],["لَا","не",2,78],["يَعۡلَمُونَ","знают",2,78],["ٱلۡكِتَٰبَ","Писание",2,78],["إِلَّآ","кроме",2,78],["أَمَانِيَّ","мечтаний",2,78],["وَإِنۡ","и не",2,78],["هُمۡ","они",2,78]],[["إِلَّا","лишь",2,78],["يَظُنُّونَ","предполагают",2,78],[78],["فَوَيۡلٞ","Горе же",2,79],["لِّلَّذِينَ","тем, которые",2,79],["يَكۡتُبُونَ","пишут",2,79],["ٱلۡكِتَٰبَ","Писание",2,79],["بِأَيۡدِيهِمۡ","руками своими",2,79]],[["ثُمَّ","затем",2,79],["يَقُولُونَ","говорят",2,79],["هَٰذَا","Это",2,79],["مِنۡ","от",2,79],["عِندِ","(у)",2,79],["ٱللَّهِ","Аллаха",2,79],["لِيَشۡتَرُواْ","чтобы купить",2,79],["بِهِۦ","за него",2,79],["ثَمَنٗا","цену",2,79],["قَلِيلٗاۖ","малую",2,79]],[["فَوَيۡلٞ","Горе же",2,79],["لَّهُم","им",2,79],["مِّمَّا","за то, что",2,79],["كَتَبَتۡ","написали",2,79],["أَيۡدِيهِمۡ","руки их",2,79],["وَوَيۡلٞ","и горе",2,79],["لَّهُم","им",2,79],["مِّمَّا","за то, что",2,79],["يَكۡسِبُونَ","приобретают они",2,7