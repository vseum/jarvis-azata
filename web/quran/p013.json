{"p":13,"j":1,"a":[[2,84,["وَإِذۡ","أَخَذۡنَا","مِيثَٰقَكُمۡ","لَا","تَسۡفِكُونَ","دِمَآءَكُمۡ","وَلَا","تُخۡرِجُونَ","أَنفُسَكُم","مِّن","دِيَٰرِكُمۡ","ثُمَّ","أَقۡرَرۡتُمۡ","وَأَنتُمۡ","تَشۡهَدُونَ"],"ва'из ахазна миисаḳакум ла тасфикууна димаакум вала тухрижууна анфусакум мин дийарикум сумма аḳрартум ва'антум ташхадуун","Вот Я заключил с вами завет о том, что вы не будете проливать вашей крови и изгонять друг друга из ваших жилищ. Потом вы признали это, свидетельствуя об этом.",["И вот","Мы взяли","завет ваш","не","будете проливать","кровь вашу","и не","будете изгонять","самих себя","из","жилищ ваших","затем","подтвердили вы","и вы","свидетельствуете"]],[2,85,["ثُمَّ","أَنتُمۡ","هَٰٓؤُلَآءِ","تَقۡتُلُونَ","أَنفُسَكُمۡ","وَتُخۡرِجُونَ","فَرِيقٗا","مِّنكُم","مِّن","دِيَٰرِهِمۡ","تَظَٰهَرُونَ","عَلَيۡهِم","بِٱلۡإِثۡمِ","وَٱلۡعُدۡوَٰنِ","وَإِن","يَأۡتُوكُمۡ","أُسَٰرَىٰ","تُفَٰدُوهُمۡ","وَهُوَ","مُحَرَّمٌ","عَلَيۡكُمۡ","إِخۡرَاجُهُمۡۚ","أَفَتُؤۡمِنُونَ","بِبَعۡضِ","ٱلۡكِتَٰبِ","وَتَكۡفُرُونَ","بِبَعۡضٖۚ","فَمَا","جَزَآءُ","مَن","يَفۡعَلُ","ذَٰلِكَ","مِنكُمۡ","إِلَّا","خِزۡيٞ","فِي","ٱلۡحَيَوٰةِ","ٱلدُّنۡيَاۖ","وَيَوۡمَ","ٱلۡقِيَٰمَةِ","يُرَدُّونَ","إِلَىٰٓ","أَشَدِّ","ٱلۡعَذَابِۗ","وَمَا","ٱللَّهُ","بِغَٰفِلٍ","عَمَّا","تَعۡمَلُونَ"],"сумма антум ха'улаи таḳтулууна анфусакум ватухрижууна фарииḳам минкум мин дийарихим тазахарууна `алайхим бил'исми вал`удвани ва'ин йа'туукум усара туфадуухум вахуа мухаррамун `алайкум ихражухум афату'минууна биба`дил китаби ватакфурууна биба`дин фама жазау ман йаф`алу залика минкум илла хизйун фил хайаватид дунйа вайаумал ḳийамати йураддууна ила ашаддил `азаби вамаллаху бигафилин `амма та`малуун","Но впоследствии именно вы стали убивать друг друга и изгонять некоторых из вас из жилищ, помогая одним против других в грехе и посягательстве. А если они приходят к вам пленными, то вы выкупаете их. А ведь вам было запрещено изгонять их. Неужели вы станете веровать в одну часть Писания и отвергать другую часть? Воздаянием тому, кто совершает подобное, будет позор в мирской жизни, а в День воскресения они будут подвергнуты еще более ужасным мучениям. Аллах не находится в неведении о том, что вы совершаете.",["Затем","вы","эти","убиваете","самих себя","и изгоняете","группу","из вас","из","жилищ их","помогая друг другу","против них","в грехе","и вражде","А если","придут они к вам","пленными","выкупаете вы их","а ведь оно","запретно","для вас","изгнание их","Неужели вы веруете","в часть","Писания","и не веруете","в часть","И каково","воздаяние","того, кто","делает","это","из вас","кроме","позора","в","жизни","ближней","а в день","Воскресения","будут возвращены они","к","самому тяжкому","наказанию","И не","Аллах","в неведении","о том, что","вы делаете"]],[2,86,["أُوْلَٰٓئِكَ","ٱلَّذِينَ","ٱشۡتَرَوُاْ","ٱلۡحَيَوٰةَ","ٱلدُّنۡيَا","بِٱلۡأٓخِرَةِۖ","فَلَا","يُخَفَّفُ","عَنۡهُمُ","ٱلۡعَذَابُ","وَلَا","هُمۡ","يُنصَرُونَ"],"улаикал лазиинаштаравул хайаватад дунйа бил'ахирати фала йухаффафу `анхумул `азабу вала хум йунсаруун","Они купили мирскую жизнь за Последнюю жизнь. Их мучения не будут облегчены, и им не будет оказана помощь.",["Они","те, которые","купили","жизнь","ближнюю","за Последнюю","и не","будет облегчено","с них","наказание","и не","они","получат помощь"]],[2,87,["وَلَقَدۡ","ءَاتَيۡنَا","مُوسَى","ٱلۡكِتَٰبَ","وَقَفَّيۡنَا","مِنۢ","بَعۡدِهِۦ","بِٱلرُّسُلِۖ","وَءَاتَيۡنَا","عِيسَى","ٱبۡنَ","مَرۡيَمَ","ٱلۡبَيِّنَٰتِ","وَأَيَّدۡنَٰهُ","بِرُوحِ","ٱلۡقُدُسِۗ","أَفَكُلَّمَا","جَآءَكُمۡ","رَسُولُۢ","بِمَا","لَا","تَهۡوَىٰٓ","أَنفُسُكُمُ","ٱسۡتَكۡبَرۡتُمۡ","فَفَرِيقٗا","كَذَّبۡتُمۡ","وَفَرِيقٗا","تَقۡتُلُونَ"],"валаḳад атайна муусал китаба ваḳаффайна мим ба`дихии биррусули ва'атайна `иисабна марйамал баййинати ва'аййаднаху бируухил ḳудуси афакуллама жаакум расуулу бима ла тахва анфусукумустакбартум фафарииḳан каззабтум вафарииḳан таḳтулуун","Мы даровали Мусе (Моисею) Писание и отправили вслед за ним череду посланников. Мы даровали Исе (Иисусу), сыну Марьям (Марии), ясные знамения и укрепили его Святым Духом (Джибрилем). Неужели каждый раз, когда посланник приносил вам то, что было вам не по душе, вы проявляли высокомерие, нарекали лжецами одних и убивали других?",["И уже","Мы дали","Мусе","Писание","и Мы отправили вслед","(от)","после него","посланников","И Мы дали","Исе","сыну","Марьям","ясные знамения","и Мы подкрепили его","Духом","Святым","Неужели всякий раз, когда","приходил к вам","посланник","с тем, что","не","желают","души ваши","возгордились вы","и одних","сочли лжецами вы","а других","убиваете"]],[2,88,["وَقَالُواْ","قُلُوبُنَا","غُلۡفُۢۚ","بَل","لَّعَنَهُمُ","ٱللَّهُ","بِكُفۡرِهِمۡ","فَقَلِيلٗا","مَّا","يُؤۡمِنُونَ"],"ваḳалуу ḳулуубуна гулфу бал ла`анахумуллаху бикуфрихим фаḳалиилам ма йу'минуун","Они сказали: «Сердца наши покрыты завесой (или переполнены знаниями)». О нет, это Аллах проклял их за их неверие. Как же мала их вера!",["И сказали они","Сердца наши","покрыты оболочкой","Нет же","проклял их","Аллах","за неверие их","и мало","что","веруют они"]]],"m":[[["وَإِذۡ","И вот",2,84],["أَخَذۡنَا","Мы взяли",2,84],["مِيثَٰقَكُمۡ","завет ваш",2,84],["لَا","не",2,84],["تَسۡفِكُونَ","будете проливать",2,84],["دِمَآءَكُمۡ","кровь вашу",2,84],["وَلَا","и не",2,84],["تُخۡرِجُونَ","будете изгонять",2,84]],[["أَنفُسَكُم","самих себя",2,84],["مِّن","из",2,84],["دِيَٰرِكُمۡ","жилищ ваших",2,84],["ثُمَّ","затем",2,84],["أَقۡرَرۡتُمۡ","подтвердили вы",2,84],["وَأَنتُمۡ","и вы",2,84],["تَشۡهَدُونَ","свидетельствуете",2,84],[84]],[["ثُمَّ","Затем",2,85],["أَنتُمۡ","вы",2,85],["هَٰٓؤُلَآءِ","эти",2,85],["تَقۡتُلُونَ","убиваете",2,85],["أَنفُسَكُمۡ","самих себя",2,85],["وَتُخۡرِجُونَ","и изгоняете",2,85],["فَرِيقٗا","группу",2,85]],[["مِّنكُم","из вас",2,85],["مِّن","из",2,85],["دِيَٰرِهِمۡ","жилищ их",2,85],["تَظَٰهَرُونَ","помогая друг другу",2,85],["عَلَيۡهِم","против них",2,85],["بِٱلۡإِثۡمِ","в грехе",2,85],["وَٱلۡعُدۡوَٰنِ","и вражде",2,85]],[["وَإِن","А если",2,85],["يَأۡتُوكُمۡ","придут они к вам",2,85],["أُسَٰرَىٰ","пленными",2,85],["تُفَٰدُوهُمۡ","выкупаете вы их",2,85],["وَهُوَ","а ведь оно",2,85],["مُحَرَّمٌ","запретно",2,85],["عَلَيۡكُمۡ","для вас",2,85]],[["إِخۡرَاجُهُمۡۚ","изгнание их",2,85],["أَفَتُؤۡمِنُونَ","Неужели вы веруете",2,85],["بِبَعۡضِ","в часть",2,85],["ٱلۡكِتَٰبِ","Писания",2,85],["وَتَكۡفُرُونَ","и не веруете",2,85]],[["بِبَعۡضٖۚ","в часть",2,85],["فَمَا","И каково",2,85],["جَزَآءُ","воздаяние",2,85],["مَن","того, кто",2,85],["يَفۡعَلُ","делает",2,85],["ذَٰلِكَ","это",2,85],["مِنكُمۡ","из вас",2,85],["إِلَّا","кроме",2,85],["خِزۡيٞ","позора",2,85]],[["فِي","в",2,85],["ٱلۡحَيَوٰةِ","жизни",2,85],["ٱلدُّنۡيَاۖ","ближней",2,85],["وَيَوۡمَ","а в день",2,85],["ٱلۡقِيَٰمَةِ","Воскресения",2,85],["يُرَدُّونَ","будут возвращены они",2,85],["إِلَىٰٓ","к",2,85],["أَشَدِّ","самому тяжкому",2,85],["ٱلۡعَذَابِۗ","наказанию",2,85]],[["وَمَا","И не",2,85],["ٱللَّهُ","Аллах",2,85],["بِغَٰفِلٍ","в неведении",2,85],["عَمَّا","о том, что",2,85],["تَعۡمَلُونَ","вы делаете",2,85],[85],["أُوْلَٰٓئِكَ","Они",2,86],["ٱلَّذِينَ","те, которые",2,86],["ٱشۡتَرَوُاْ","купили",2,86]],[["ٱلۡحَيَوٰةَ","жизнь",2,86],["ٱلدُّنۡيَا","ближнюю",2,86],["بِٱلۡأٓخِرَةِۖ","за Последнюю",2,86],["فَلَا","и не",2,86],["يُخَفَّفُ","будет облегчено",2,86],["عَنۡهُمُ","с них",2,86],["ٱلۡعَذَابُ","наказание",2,86],["وَلَا","и не",2,86],["هُمۡ","они",2,86]],[["يُنصَرُونَ","получат помощь",2,86],[86],["وَلَقَدۡ","И уже",2,87],["ءَاتَيۡنَا","Мы дали",2,87],["مُوسَى","Мусе",2,87],["ٱلۡكِتَٰبَ","Писание",2,87],["وَقَفَّيۡنَا","и Мы отправили вслед",2,87],["مِنۢ","(от)",2,87]],[["بَعۡدِهِۦ","после него",2,87],["بِٱلرُّسُلِۖ","посланников",2,87],["وَءَاتَيۡنَا","И Мы дали",2,87],["عِيسَى","Исе",2,87],["ٱبۡنَ","сыну",2,87],["مَرۡيَمَ","Марьям",2,87],["ٱلۡبَيِّنَٰتِ","ясные знамения",2,87],["وَأَيَّدۡنَٰهُ","и Мы подкрепили его",2,87]],[["بِرُوحِ","Духом",2,87],["ٱلۡقُدُسِۗ","Святым",2,87],["أَفَكُلَّمَا","Неужели всякий раз, когда",2,87],["جَآءَكُمۡ","приходил к вам",2,87],["رَسُولُۢ","посланник",2,87],["بِمَا","с тем, что",2,87],["لَا","не",2,87],["تَهۡوَىٰٓ","желают",2,87],["أَنفُسُكُمُ","души ваши",2,87]],[["ٱسۡتَكۡبَرۡتُمۡ","возгордились вы",2,87],["فَفَرِيقٗا","и одних",2,87],["كَذَّبۡتُمۡ","сочли лжецами вы",2,87],["وَفَرِيقٗا","а других",2,87],["تَقۡتُلُونَ","убиваете",2,87],[87],["وَقَالُواْ","И сказали они",2,88]],[["قُلُوبُنَا","Сердца наши",2,88],["غُلۡفُۢۚ","покрыты оболочкой",2,88],["بَل","Нет же",2,88],["لَّعَنَهُمُ","проклял их",2,88],["ٱللَّهُ","Аллах",2,88],["بِكُفۡرِهِمۡ","за неверие их",2,88],["فَقَلِيلٗا","и мало",2,88],["مَّا","что",2,88],["يُؤۡمِنُونَ","веруют они",2,88],[88]]]}