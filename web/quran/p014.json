{"p":14,"j":1,"a":[[2,89,["وَلَمَّا","جَآءَهُمۡ","كِتَٰبٞ","مِّنۡ","عِندِ","ٱللَّهِ","مُصَدِّقٞ","لِّمَا","مَعَهُمۡ","وَكَانُواْ","مِن","قَبۡلُ","يَسۡتَفۡتِحُونَ","عَلَى","ٱلَّذِينَ","كَفَرُواْ","فَلَمَّا","جَآءَهُم","مَّا","عَرَفُواْ","كَفَرُواْ","بِهِۦۚ","فَلَعۡنَةُ","ٱللَّهِ","عَلَى","ٱلۡكَٰفِرِينَ"],"валамма жаахум китабум мин `индиллахи мусаддиḳул лима ма`ахум вакануу мин ḳаблу йастафтихууна `алал лазиина кафаруу фаламма жаахум ма `арафуу кафаруу бихии фала`натуллахи `алал кафириин","К ним явилось от Аллаха Писание, подтверждающее правдивость того, что было у них. Прежде они молили о победе над неверующими. Когда же к ним явилось то, что они узнали, они отказались уверовать в него. Да пребудет проклятие Аллаха над неверующими!",["И когда","пришло к ним","Писание","от","(у)","Аллаха","подтверждающее","то, что","с ними","а были они","(от)","прежде","просили победы","над","теми, которые","не уверовали","и когда","пришло к ним","то, что","они узнали","не уверовали они","в него","И проклятие","Аллаха","на","неверующих"]],[2,90,["بِئۡسَمَا","ٱشۡتَرَوۡاْ","بِهِۦٓ","أَنفُسَهُمۡ","أَن","يَكۡفُرُواْ","بِمَآ","أَنزَلَ","ٱللَّهُ","بَغۡيًا","أَن","يُنَزِّلَ","ٱللَّهُ","مِن","فَضۡلِهِۦ","عَلَىٰ","مَن","يَشَآءُ","مِنۡ","عِبَادِهِۦۖ","فَبَآءُو","بِغَضَبٍ","عَلَىٰ","غَضَبٖۚ","وَلِلۡكَٰفِرِينَ","عَذَابٞ","مُّهِينٞ"],"би'самаштарау бихии анфусахум ан йакфуруу бима анзалаллаху багйан ан йуназзилаллаху мин фадлихии `ала ман йашау мин `ибадихии фабауу бигадабин `ала гадабин валилкафириина `азабум мухиин","Скверно то, что они купили за свои души, не уверовав в ниспосланное Аллахом и завидуя тому, что Аллах ниспосылает Свою милость тому из Своих рабов, кому пожелает. Они навлекли на себя гнев, один поверх другого. Неверующим уготованы унизительные мучения.",["Скверно то","продали они","за что","души свои","что","не веруют они","в то, что","ниспослал","Аллах","из зависти","что","ниспосылает","Аллах","из","милости Своей","на","кого","пожелает Он","из","рабов Своих","И навлекли они","гнев","на","гнев","А для неверующих","наказание","унизительное"]],[2,91,["وَإِذَا","قِيلَ","لَهُمۡ","ءَامِنُواْ","بِمَآ","أَنزَلَ","ٱللَّهُ","قَالُواْ","نُؤۡمِنُ","بِمَآ","أُنزِلَ","عَلَيۡنَا","وَيَكۡفُرُونَ","بِمَا","وَرَآءَهُۥ","وَهُوَ","ٱلۡحَقُّ","مُصَدِّقٗا","لِّمَا","مَعَهُمۡۗ","قُلۡ","فَلِمَ","تَقۡتُلُونَ","أَنۢبِيَآءَ","ٱللَّهِ","مِن","قَبۡلُ","إِن","كُنتُم","مُّؤۡمِنِينَ"],"ва'иза ḳиила лахум аминуу бима анзалаллаху ḳалуу ну'мину бима унзила `алайна вайакфурууна бима вараахуу вахуал хаḳḳу мусаддиḳал лима ма`ахум ḳул фалима таḳтулууна амбийааллахи мин ḳаблу ин кунтум му'миниин","Когда им говорят: «Уверуйте в то, что ниспослал Аллах», - они отвечают: «Мы веруем в то, что было ниспослано нам». Они не веруют в то, что явилось впоследствии, хотя это является истиной, подтверждающей правдивость того, что есть у них. Скажи: «Почему же раньше вы убивали пророков Аллаха, если вы являетесь верующими?».",["И когда","говорят","им","Уверуйте","в то, что","ниспослал","Аллах","говорят они","Мы веруем","в то, что","ниспослано","нам","и не веруют они","в то, что","помимо него","а ведь оно","истина","подтверждающая","то, что","с ними","Скажи","Почему же","убивали вы","пророков","Аллаха","(от)","прежде","если","были вы","верующими"]],[2,92,["وَلَقَدۡ","جَآءَكُم","مُّوسَىٰ","بِٱلۡبَيِّنَٰتِ","ثُمَّ","ٱتَّخَذۡتُمُ","ٱلۡعِجۡلَ","مِنۢ","بَعۡدِهِۦ","وَأَنتُمۡ","ظَٰلِمُونَ"],"валаḳад жаакум мууса билбаййинати сумматтахазтумул `ижла мим ба`дихии ва'антум залимуун","Муса (Моисей) явился к вам с ясными знамениями, но в его отсутствие вы стали поклоняться тельцу, будучи беззаконниками.",["И уже","пришёл к вам","Муса","с ясными знамениями","затем","взяли вы","тельца","(от)","после него","и вы","беззаконники"]],[2,93,["وَإِذۡ","أَخَذۡنَا","مِيثَٰقَكُمۡ","وَرَفَعۡنَا","فَوۡقَكُمُ","ٱلطُّورَ","خُذُواْ","مَآ","ءَاتَيۡنَٰكُم","بِقُوَّةٖ","وَٱسۡمَعُواْۖ","قَالُواْ","سَمِعۡنَا","وَعَصَيۡنَا","وَأُشۡرِبُواْ","فِي","قُلُوبِهِمُ","ٱلۡعِجۡلَ","بِكُفۡرِهِمۡۚ","قُلۡ","بِئۡسَمَا","يَأۡمُرُكُم","بِهِۦٓ","إِيمَٰنُكُمۡ","إِن","كُنتُم","مُّؤۡمِنِينَ"],"ва'из ахазна миисаḳакум варафа`на фауḳакумут туура хузуу ма атайнакум биḳувватин васма`уу ḳалуу сами`на ва`асайна ва'ушрибуу фии ḳулуубихимул `ижла бикуфрихим ḳул би'сама йа'мурукум бихии ииманукум ин кунтум му'миниин","Вот Мы заключили с вами завет и воздвигли над вами гору: «Крепко придерживайтесь того, что Мы даровали вам, и слушайте». Они сказали: «Слышали и ослушаемся». Их сердца впитали любовь к тельцу по причине их неверия. Скажи: «Скверно то, что велит вам ваша вера, если вы вообще являетесь верующими».",["И вот","Мы взяли","завет ваш","и Мы подняли","над вами","гору","Держите","то, что","Мы дали вам","с силой","и слушайте","Они сказали","Мы услышали","и ослушались","И были напоены","в","сердца их","тельцом","за неверие их","Скажи","Скверно то","что велит вам","это","вера ваша","если","вы","верующие"]]],"m":[[["وَلَمَّا","И когда",2,89],["جَآءَهُمۡ","пришло к ним",2,89],["كِتَٰبٞ","Писание",2,89],["مِّنۡ","от",2,89],["عِندِ","(у)",2,89],["ٱللَّهِ","Аллаха",2,89],["مُصَدِّقٞ","подтверждающее",2,89],["لِّمَا","то, что",2,89],["مَعَهُمۡ","с ними",2,89],["وَكَانُواْ","а были они",2,89]],[["مِن","(от)",2,89],["قَبۡلُ","прежде",2,89],["يَسۡتَفۡتِحُونَ","просили победы",2,89],["عَلَى","над",2,89],["ٱلَّذِينَ","теми, которые",2,89],["كَفَرُواْ","не уверовали",2,89],["فَلَمَّا","и когда",2,89],["جَآءَهُم","пришло к ним",2,89]],[["مَّا","то, что",2,89],["عَرَفُواْ","они узнали",2,89],["كَفَرُواْ","не уверовали они",2,89],["بِهِۦۚ","в него",2,89],["فَلَعۡنَةُ","И проклятие",2,89],["ٱللَّهِ","Аллаха",2,89],["عَلَى","на",2,89],["ٱلۡكَٰفِرِينَ","неверующих",2,89],[89]],[["بِئۡسَمَا","Скверно то",2,90],["ٱشۡتَرَوۡاْ","продали они",2,90],["بِهِۦٓ","за что",2,90],["أَنفُسَهُمۡ","души свои",2,90],["أَن","что",2,90],["يَكۡفُرُواْ","не веруют они",2,90],["بِمَآ","в то, что",2,90],["أَنزَلَ","ниспослал",2,90]],[["ٱللَّهُ","Аллах",2,90],["بَغۡيًا","из зависти",2,90],["أَن","что",2,90],["يُنَزِّلَ","ниспосылает",2,90],["ٱ