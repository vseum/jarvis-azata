{"p":15,"j":1,"a":[[2,94,["قُلۡ","إِن","كَانَتۡ","لَكُمُ","ٱلدَّارُ","ٱلۡأٓخِرَةُ","عِندَ","ٱللَّهِ","خَالِصَةٗ","مِّن","دُونِ","ٱلنَّاسِ","فَتَمَنَّوُاْ","ٱلۡمَوۡتَ","إِن","كُنتُمۡ","صَٰدِقِينَ"],"ḳул ин канат лакумуд дарул ахирату `индаллахи халисатам мин дуунин наси фатаманнавул маута ин кунтум садиḳиин","Скажи: «Если Последняя обитель у Аллаха предназначена только для вас, а не для других людей, то пожелайте себе смерти, если вы говорите правду».",["Скажи","Если","является","для вас","обитель","Последняя","у","Аллаха","исключительно","(от)","помимо","людей","то пожелайте","смерти","если","вы","правдивы"]],[2,95,["وَلَن","يَتَمَنَّوۡهُ","أَبَدَۢا","بِمَا","قَدَّمَتۡ","أَيۡدِيهِمۡۚ","وَٱللَّهُ","عَلِيمُۢ","بِٱلظَّٰلِمِينَ"],"валан йатаманнауху абада бима ḳаддамат айдиихим валлаху `алииму биззалимиин","Однако они никогда не пожелают себе этого из-за того, что приготовили их руки. Аллах ведает о беззаконниках.",["И никогда не","пожелают они её","никогда","из-за того, что","уготовили","руки их","А Аллах","Знающий","о беззаконниках"]],[2,96,["وَلَتَجِدَنَّهُمۡ","أَحۡرَصَ","ٱلنَّاسِ","عَلَىٰ","حَيَوٰةٖ","وَمِنَ","ٱلَّذِينَ","أَشۡرَكُواْۚ","يَوَدُّ","أَحَدُهُمۡ","لَوۡ","يُعَمَّرُ","أَلۡفَ","سَنَةٖ","وَمَا","هُوَ","بِمُزَحۡزِحِهِۦ","مِنَ","ٱلۡعَذَابِ","أَن","يُعَمَّرَۗ","وَٱللَّهُ","بَصِيرُۢ","بِمَا","يَعۡمَلُونَ"],"валатажиданнахум ахрасан наси `ала хайаватин ваминал лазиина ашракуу йавадду ахадухум лау йу`аммару алфа санатин вама хуа бимузахзихихии минал `азаби ан йу`аммара валлаху басииру бима йа`малуун","Ты непременно убедишься, что они жаждут жизни больше всех людей, даже больше многобожников. Каждый из них желал бы прожить тысячу лет. Но даже долгая жизнь ничуть не отдалит их от мучений. Аллах видит то, что они совершают.",["И непременно найдёшь ты их","самыми жадными","из людей","к","жизни","и даже из","тех, которые","приобщали сотоварищей","Желает","каждый из них","если бы","был наделён жизнью","тысячу","лет","Но не","это","отдалит его","от","наказания","что","будет наделён он жизнью","А Аллах","Видящий","то, что","делают они"]],[2,97,["قُلۡ","مَن","كَانَ","عَدُوّٗا","لِّـجِبۡرِيلَ","فَإِنَّهُۥ","نَزَّلَهُۥ","عَلَىٰ","قَلۡبِكَ","بِإِذۡنِ","ٱللَّهِ","مُصَدِّقٗا","لِّمَا","بَيۡنَ","يَدَيۡهِ","وَهُدٗى","وَبُشۡرَىٰ","لِلۡمُؤۡمِنِينَ"],"ḳул ман кана `адуввал лижибриила фа'иннахуу наззалахуу `ала ḳалбика би'изниллахи мусаддиḳал лима байна йадайхи вахудан вабушра лилму'миниин","Скажи: «Кто является врагом Джибрилу (Гавриилу)?». Он низвел его (Коран) на твое сердце с соизволения Аллаха в подтверждение правдивости того, что было прежде, в качестве верного руководства и благой вести для верующих.",["Скажи","Кто","является","врагом","Джибрилю","то ведь он","низвёл его","на","сердце твоё","с позволения","Аллаха","подтверждающим","то, что","перед","ним","и руководством","и благой вестью","для верующих"]],[2,98,["مَن","كَانَ","عَدُوّٗا","لِّلَّهِ","وَمَلَٰٓئِكَتِهِۦ","وَرُسُلِهِۦ","وَجِبۡرِيلَ","وَمِيكَىٰلَ","فَإِنَّ","ٱللَّهَ","عَدُوّٞ","لِّلۡكَٰفِرِينَ"],"ман кана `адуввал лиллахи вамалаикатихии варусулихии важибриила вамиикала фа'инналлаха `адуввул лилкафириин","Если кто враждует с Аллахом и Его ангелами, посланниками, Джибрилом (Гавриилом) и Микаилом (Михаилом), то ведь Аллах является врагом неверующих.",["Кто","является","врагом","Аллаху","и ангелам Его","и посланникам Его","и Джибрилю","и Микаилю","то поистине","Аллах","враг","неверующим"]],[2,99,["وَلَقَدۡ","أَنزَلۡنَآ","إِلَيۡكَ","ءَايَٰتِۭ","بَيِّنَٰتٖۖ","وَمَا","يَكۡفُرُ","بِهَآ","إِلَّا","ٱلۡفَٰسِقُونَ"],"валаḳад анзална илайка айати баййинатин вама йакфуру биха иллал фасиḳуун","Мы ниспосылали тебе ясные знамения, и не веруют в них только нечестивцы.",["И уже","Мы ниспослали","тебе","знамения","ясные","и не","отвергает","их","кроме","нечестивцев"]],[2,100,["أَوَكُلَّمَا","عَٰهَدُواْ","عَهۡدٗا","نَّبَذَهُۥ","فَرِيقٞ","مِّنۡهُمۚ","بَلۡ","أَكۡثَرُهُمۡ","لَا","يُؤۡمِنُونَ"],"авакуллама `ахадуу `ахдан набазахуу фарииḳум минхум бал аксарухум ла йу'минуун","Неужели всякий раз, когда они заключают завет, часть из них отбрасывает его? Более того, большинство из них не веруют.",["И неужели всякий раз","заключали они","завет","отбрасывала его","часть","из них","Нет же","большинство из них","не","веруют"]],[2,101,["وَلَمَّا","جَآءَهُمۡ","رَسُولٞ","مِّنۡ","عِندِ","ٱللَّهِ","مُصَدِّقٞ","لِّمَا","مَعَهُمۡ","نَبَذَ","فَرِيقٞ","مِّنَ","ٱلَّذِينَ","أُوتُواْ","ٱلۡكِتَٰبَ","كِتَٰبَ","ٱللَّهِ","وَرَآءَ","ظُهُورِهِمۡ","كَأَنَّهُمۡ","لَا","يَعۡلَمُونَ"],"валамма жаахум расуулум мин `индиллахи мусаддиḳул лима ма`ахум набаза фарииḳум минал лазиина уутул китаба китабаллахи вараа зухуурихим ка'аннахум ла йа`ламуун","Когда к ним пришел Посланник от Аллаха (Мухаммад), подтвердивший правдивость того, что было у них, некоторые из тех, кому было даровано Писание, отбросили Писание Аллаха за спины, словно они не знают истины.",["И когда","пришёл к ним","посланник","от","(стороны)","Аллаха","подтверждающий","то, что","у них","отбросила","часть","из","тех, которым","было даровано","Писание","Писание","Аллаха","за","спины свои","словно они","не","знают"]]],"m":[[["قُلۡ","Скажи",2,94],["إِن","Если",2,94],["كَانَتۡ","является",2,94],["لَكُمُ","для вас",2,94],["ٱلدَّارُ","обитель",2,94],["ٱلۡأٓخِرَةُ","Последняя",2,94],["عِندَ","у",2,94],["ٱللَّهِ","Аллаха",2,94],["خَالِصَةٗ","исключительно",2,94],["مِّن","(от)",2,94]],[["دُونِ","помимо",2,94],["ٱلنَّاسِ","людей",2,94],["فَتَمَنَّوُاْ","то пожелайте",2,94],["ٱلۡمَوۡتَ","смерти",2,94],["إِن","если",2,94],["كُنتُمۡ","вы",2,94],["صَٰدِقِينَ","правдивы",2,94],[94]],[["وَلَن","И никогда не",2,95],["يَتَمَنَّوۡهُ","пожелают они её",2,95],["أَبَدَۢا","никогда",2,95],["بِمَا","из-за того, что",2,95],["قَدَّمَتۡ","уготовили",2,95],["أَيۡدِيهِمۡۚ","руки их",2,95],["وَٱللَّهُ","А Аллах",2,95],["عَلِيمُۢ","Знающий",2,95],["بِٱلظَّٰلِمِينَ","о беззаконниках",2,95]],[[95],["وَلَتَجِدَنَّهُمۡ","И непременно найдёшь ты их",2,96],["أَحۡرَصَ","самыми жадными",2,96],["ٱلنَّاسِ","из людей",2,96],["عَلَىٰ","к",2,96],["حَيَوٰةٖ","жизни",2,96],