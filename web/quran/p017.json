{"p":17,"j":1,"a":[[2,106,["مَا","نَنسَخۡ","مِنۡ","ءَايَةٍ","أَوۡ","نُنسِهَا","نَأۡتِ","بِخَيۡرٖ","مِّنۡهَآ","أَوۡ","مِثۡلِهَآۗ","أَلَمۡ","تَعۡلَمۡ","أَنَّ","ٱللَّهَ","عَلَىٰ","كُلِّ","شَيۡءٖ","قَدِيرٌ"],"ма нансах мин айатин ау нунсиха на'ти бихайрим минха ау мислиха алам та`лам анналлаха `ала кулли шай'ин ḳадиир","Когда Мы отменяем или заставляем забыть один аят, то приводим тот, который лучше его, или равный ему. Разве ты не знаешь, что Аллах способен на всякую вещь?",["Что бы","Мы ни отменили","из","аята","или","ни заставили забыть его","приводим Мы","лучший","чем он","или","подобный ему","Разве не","знаешь ты","что","Аллах","над","всякой","вещью","властен"]],[2,107,["أَلَمۡ","تَعۡلَمۡ","أَنَّ","ٱللَّهَ","لَهُۥ","مُلۡكُ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِۗ","وَمَا","لَكُم","مِّن","دُونِ","ٱللَّهِ","مِن","وَلِيّٖ","وَلَا","نَصِيرٍ"],"алам та`лам анналлаха лахуу мулкус самавати вал'арди вама лакум мин дууниллахи мин валиййин вала насиир","Разве ты не знаешь, что Аллаху принадлежит власть над небесами и землей, и что нет у вас, кроме Аллаха, ни покровителя, ни помощника?",["Разве не","знаешь ты","что","Аллах","Ему принадлежит","власть","небес","и земли","И нет","у вас","в","обход","Аллаха","никакого","покровителя","и не","помощника"]],[2,108,["أَمۡ","تُرِيدُونَ","أَن","تَسۡـَٔلُواْ","رَسُولَكُمۡ","كَمَا","سُئِلَ","مُوسَىٰ","مِن","قَبۡلُۗ","وَمَن","يَتَبَدَّلِ","ٱلۡكُفۡرَ","بِٱلۡإِيمَٰنِ","فَقَدۡ","ضَلَّ","سَوَآءَ","ٱلسَّبِيلِ"],"ам туриидууна ан тас'алуу расуулакум кама су'ила мууса мин ḳаблу ваман йатабаддалил куфра бил'иимани фаḳад далла саваас сабиил","Или же вы хотите попросить вашего Посланника, как прежде они (сыны Исраила) попросили Мусу (Моисея)? Кто сменил веру на неверие, тот уже сбился с прямого пути.",["Или","хотите вы","чтобы","просить","посланника вашего","как","просили","Мусу","ещё","прежде","И тот, кто","меняет","неверие","на веру","тот уже","сбился с","прямого","пути"]],[2,109,["وَدَّ","كَثِيرٞ","مِّنۡ","أَهۡلِ","ٱلۡكِتَٰبِ","لَوۡ","يَرُدُّونَكُم","مِّنۢ","بَعۡدِ","إِيمَٰنِكُمۡ","كُفَّارًا","حَسَدٗا","مِّنۡ","عِندِ","أَنفُسِهِم","مِّنۢ","بَعۡدِ","مَا","تَبَيَّنَ","لَهُمُ","ٱلۡحَقُّۖ","فَٱعۡفُواْ","وَٱصۡفَحُواْ","حَتَّىٰ","يَأۡتِيَ","ٱللَّهُ","بِأَمۡرِهِۦٓۗ","إِنَّ","ٱللَّهَ","عَلَىٰ","كُلِّ","شَيۡءٖ","قَدِيرٞ"],"вадда касиирум мин ахлил китаби лау йаруддуунакум мим ба`ди ииманикум куффаран хасадам мин `инди анфусихим мим ба`ди ма табаййана лахумул хаḳḳу фа`фуу васфахуу хатта йа'тийаллаху би'амрихии инналлаха `ала кулли шай'ин ḳадиир","После того как прояснилась им истина, многие из людей Писания из зависти своей хотели бы отвратить вас от веры, когда вы уже приняли ее. Простите их и будьте великодушны, пока Аллах не явится со Своим повелением. Воистину, Аллах способен на всякую вещь.",["Пожелали","многие","из","людей","Писания","чтобы","обратили они вас","уже","после","вашей веры","в неверующих","из зависти","исходящей","из","их душ","даже","после","того, как","стала ясна","им","истина","Так прощайте","и будьте снисходительны","пока не","придёт","Аллах","с повелением Своим","Поистине","Аллах","над","всякой","вещью","властен"]],[2,110,["وَأَقِيمُواْ","ٱلصَّلَوٰةَ","وَءَاتُواْ","ٱلزَّكَوٰةَۚ","وَمَا","تُقَدِّمُواْ","لِأَنفُسِكُم","مِّنۡ","خَيۡرٖ","تَجِدُوهُ","عِندَ","ٱللَّهِۗ","إِنَّ","ٱللَّهَ","بِمَا","تَعۡمَلُونَ","بَصِيرٞ"],"ва'аḳиимус салавата ва'атуз закавата вама туḳаддимуу ли'анфусикум мин хайрин тажидууху `индаллахи инналлаха бима та`малууна басиир","Совершайте намаз и выплачивайте закят. Все то доброе, что вы предварите для себя, вы найдете у Аллаха. Воистину, Аллах видит то, что вы совершаете.",["И совершайте","молитву","и давайте","закят","И что бы","вы ни приготовили","для самих себя","из","блага","найдёте вы это","у","Аллаха","Поистине","Аллах","то, что","вы делаете","видит"]],[2,111,["وَقَالُواْ","لَن","يَدۡخُلَ","ٱلۡجَنَّةَ","إِلَّا","مَن","كَانَ","هُودًا","أَوۡ","نَصَٰرَىٰۗ","تِلۡكَ","أَمَانِيُّهُمۡۗ","قُلۡ","هَاتُواْ","بُرۡهَٰنَكُمۡ","إِن","كُنتُمۡ","صَٰدِقِينَ"],"ваḳалуу лан йадхулал жанната илла ман кана хуудан ау насара тилка аманиййухум ḳул хатуу бурханакум ин кунтум садиḳиин","Они сказали: «Не войдет в Рай никто, кроме иудеев или христиан». Таковы их мечты. Скажи: «Приведите ваше доказательство, если вы говорите правду».",["И сказали они","Никогда не","войдёт","в Рай","кроме","тех, кто","является","иудеями","или","христианами","Это","их мечтания","Скажи","Приведите","ваше доказательство","если","вы","правдивы"]],[2,112,["بَلَىٰۚ","مَنۡ","أَسۡلَمَ","وَجۡهَهُۥ","لِلَّهِ","وَهُوَ","مُحۡسِنٞ","فَلَهُۥٓ","أَجۡرُهُۥ","عِندَ","رَبِّهِۦ","وَلَا","خَوۡفٌ","عَلَيۡهِمۡ","وَلَا","هُمۡ","يَحۡزَنُونَ"],"бала ман аслама важхахуу лиллахи вахуа мухсинун фалахуу ажрухуу `инда раббихии вала хауфун `алайхим вала хум йахзануун","О нет! Кто покорит свой лик Аллаху, совершая добро, тот получит награду от своего Господа. Они не познают страха и не будут опечалены.",["Да, напротив","кто","покорил","лик свой","Аллаху","и он","творит добро","то ему","его награда","у","Господа его","И не","страх","над ними","и не","они","будут опечалены"]]],"m":[[["۞ مَا","Что бы",2,106],["نَنسَخۡ","Мы ни отменили",2,106],["مِنۡ","из",2,106],["ءَايَةٍ","аята",2,106],["أَوۡ","или",2,106],["نُنسِهَا","ни заставили забыть его",2,106],["نَأۡتِ","приводим Мы",2,106],["بِخَيۡرٖ","лучший",2,106],["مِّنۡهَآ","чем он",2,106],["أَوۡ","или",2,106],["مِثۡلِهَآۗ","подобный ему",2,106]],[["أَلَمۡ","Разве не",2,106],["تَعۡلَمۡ","знаешь ты",2,106],["أَنَّ","что",2,106],["ٱللَّهَ","Аллах",2,106],["عَلَىٰ","над",2,106],["كُلِّ","всякой",2,106],["شَيۡءٖ","вещью",2,106],["قَدِيرٌ","властен",2,106],[106],["أَلَمۡ","Разве не",2,107],["تَعۡلَمۡ","знаешь ты",2,107],["أَنَّ","что",2,107],["ٱللَّهَ","Аллах",2,107],["لَهُۥ","Ему принадлежит",2,107]],[["مُلۡكُ","власть",2,107],["ٱلسَّمَٰوَٰتِ","небес",2,107],["وَٱلۡأَرۡضِۗ","и земли",2,107],["وَمَا","И нет",2,107],["لَكُم","у вас",2,107],["مِّن","в",2,107],["دُونِ","обход",2,107],["ٱللَّهِ","Аллаха",2,107],["مِن","никакого",2,107]],[["وَلِيّٖ","покровителя",2,107],["وَلَا"