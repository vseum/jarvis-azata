","вы делаете",2,110],["بَصِيرٞ","видит",2,110]],[[110],["وَقَالُواْ","И сказали они",2,111],["لَن","Никогда не",2,111],["يَدۡخُلَ","войдёт",2,111],["ٱلۡجَنَّةَ","в Рай",2,111],["إِلَّا","кроме",2,111],["مَن","тех, кто",2,111],["كَانَ","является",2,111],["هُودًا","иудеями",2,111],["أَوۡ","или",2,111],["نَصَٰرَىٰۗ","христианами",2,111]],[["تِلۡكَ","Это",2,111],["أَمَانِيُّهُمۡۗ","их мечтания",2,111],["قُلۡ","Скажи",2,111],["هَاتُواْ","Приведите",2,111],["بُرۡهَٰنَكُمۡ","ваше доказательство",2,111],["إِن","если",2,111],["كُنتُمۡ","вы",2,111]],[["صَٰدِقِينَ","правдивы",2,111],[111],["بَلَىٰۚ","Да, напротив",2,112],["مَنۡ","кто",2,112],["أَسۡلَمَ","покорил",2,112],["وَجۡهَهُۥ","лик свой",2,112],["لِلَّهِ","Аллаху",2,112],["وَهُوَ","и он",2,112],["مُحۡسِنٞ","творит добро",2,112]],[["فَلَهُۥٓ","то ему",2,112],["أَجۡرُهُۥ","его награда",2,112],["عِندَ","у",2,112],["رَبِّهِۦ","Господа его",2,112],["وَلَا","И не",2,112],["خَوۡفٌ","страх",2,112],["عَلَيۡهِمۡ","над ними",2,112],["وَلَا","и не",2,112],["هُمۡ","они",2,112],["يَحۡزَنُونَ","будут опечалены",2,112],[112]]]}