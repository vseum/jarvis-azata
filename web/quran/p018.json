{"p":18,"j":1,"a":[[2,113,["وَقَالَتِ","ٱلۡيَهُودُ","لَيۡسَتِ","ٱلنَّصَٰرَىٰ","عَلَىٰ","شَيۡءٖ","وَقَالَتِ","ٱلنَّصَٰرَىٰ","لَيۡسَتِ","ٱلۡيَهُودُ","عَلَىٰ","شَيۡءٖ","وَهُمۡ","يَتۡلُونَ","ٱلۡكِتَٰبَۗ","كَذَٰلِكَ","قَالَ","ٱلَّذِينَ","لَا","يَعۡلَمُونَ","مِثۡلَ","قَوۡلِهِمۡۚ","فَٱللَّهُ","يَحۡكُمُ","بَيۡنَهُمۡ","يَوۡمَ","ٱلۡقِيَٰمَةِ","فِيمَا","كَانُواْ","فِيهِ","يَخۡتَلِفُونَ"],"ваḳалатил йахууду лайсатин насара `ала шай'ин ваḳалатин насара лайсатил йахууду `ала шай'ин вахум йатлуунал китаба казалика ḳалал лазиина ла йа`ламууна мисла ḳаулихим фаллаху йахкуму байнахум йаумал ḳийамати фиима кануу фиихи йахталифуун","Иудеи сказали: «Христиане не следуют прямым путем». А христиане сказали: «Иудеи не следуют прямым путем». Все они читают Писание, но слова невежественных людей похожи на их слова. В День воскресения Аллах рассудит их в том, в чем они расходились во мнениях.",["И сказали","иудеи","Не","христиане","на","чём-либо","И сказали","христиане","Не","иудеи","на","чём-либо","хотя они","читают","Писание","Подобно этому","сказали","те, которые","не","знают","подобное","их словам","И Аллах","рассудит","между ними","в День","Воскресения","в том, в чём","они","о нём","расходились"]],[2,114,["وَمَنۡ","أَظۡلَمُ","مِمَّن","مَّنَعَ","مَسَٰجِدَ","ٱللَّهِ","أَن","يُذۡكَرَ","فِيهَا","ٱسۡمُهُۥ","وَسَعَىٰ","فِي","خَرَابِهَآۚ","أُوْلَٰٓئِكَ","مَا","كَانَ","لَهُمۡ","أَن","يَدۡخُلُوهَآ","إِلَّا","خَآئِفِينَۚ","لَهُمۡ","فِي","ٱلدُّنۡيَا","خِزۡيٞ","وَلَهُمۡ","فِي","ٱلۡأٓخِرَةِ","عَذَابٌ","عَظِيمٞ"],"ваман азламу миммам мана`а масажидаллахи ан йузкара фиихасмухуу васа`а фии харабиха улаика ма кана лахум ан йадхулууха илла хаифиина лахум фид дунйа хизйун валахум фил ахирати `азабун `азиим","Кто может быть несправедливее того, кто запрещает в мечетях Аллаха поминать имя Его и стремится разрушить их? Им следовало бы входить туда только с чувством страха. Позор им в мирской жизни и великие мучения в Последней жизни.",["И кто","несправедливее","того, кто","препятствует","мечетям","Аллаха","чтобы","поминалось","в них","имя Его","и стремится","к","их разрушению","Те","не","подобало","им","чтобы","входили они в них","кроме как","боящимися","Им","в","мире этом","позор","и им","в","Последней жизни","мучение","великое"]],[2,115,["وَلِلَّهِ","ٱلۡمَشۡرِقُ","وَٱلۡمَغۡرِبُۚ","فَأَيۡنَمَا","تُوَلُّواْ","فَثَمَّ","وَجۡهُ","ٱللَّهِۚ","إِنَّ","ٱللَّهَ","وَٰسِعٌ","عَلِيمٞ"],"валиллахил машриḳу валмагрибу фа'айнама туаллуу фасамма важхуллахи инналлаха васи`ун `алиим","Аллаху принадлежат восток и запад. Куда бы вы ни повернулись, там будет Лик Аллаха. Воистину, Аллах - Объемлющий, Знающий.",["И Аллаху принадлежат","восток","и запад","И куда бы","вы ни обратились","там","Лик","Аллаха","Поистине","Аллах","Объемлющий","Знающий"]],[2,116,["وَقَالُواْ","ٱتَّخَذَ","ٱللَّهُ","وَلَدٗاۗ","سُبۡحَٰنَهُۥۖ","بَل","لَّهُۥ","مَا","فِي","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِۖ","كُلّٞ","لَّهُۥ","قَٰنِتُونَ"],"ваḳалуттахазаллаху валадан субханахуу бал лахуу ма фис самавати вал'арди куллул лахуу ḳанитуун","Они сказали: «Аллах взял Себе сына». Пречист Он! Напротив, Ему принадлежит то, что на небесах и земле. Ему одному все покоряются.",["И сказали они","взял","Аллах","сына","Пречист Он","Нет же","Ему принадлежит","то, что","на","небесах","и на земле","Все","Ему","смиренно покорны"]],[2,117,["بَدِيعُ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِۖ","وَإِذَا","قَضَىٰٓ","أَمۡرٗا","فَإِنَّمَا","يَقُولُ","لَهُۥ","كُن","فَيَكُونُ"],"бадии`ус самавати вал'арди ва'иза ḳада амран фа'иннама йаḳуулу лахуу кун файакуун","Он - Первосоздатель небес и земли. Когда Он принимает решение, то стоит Ему сказать: «Будь!», как это сбывается.",["Создатель","небес","и земли","И когда","Он решает","дело","то лишь","Он говорит","ему","Будь","и оно сбывается"]],[2,118,["وَقَالَ","ٱلَّذِينَ","لَا","يَعۡلَمُونَ","لَوۡلَا","يُكَلِّمُنَا","ٱللَّهُ","أَوۡ","تَأۡتِينَآ","ءَايَةٞۗ","كَذَٰلِكَ","قَالَ","ٱلَّذِينَ","مِن","قَبۡلِهِم","مِّثۡلَ","قَوۡلِهِمۡۘ","تَشَٰبَهَتۡ","قُلُوبُهُمۡۗ","قَدۡ","بَيَّنَّا","ٱلۡأٓيَٰتِ","لِقَوۡمٖ","يُوقِنُونَ"],"ваḳалал лазиина ла йа`ламууна лаула йукаллимуналлаху ау та'тиина айатун казалика ḳалал лазиина мин ḳаблихим мисла ḳаулихим ташабахат ḳулуубухум ḳад баййаннал айати лиḳаумин йууḳинуун","Те, которые лишены знания, говорят: «Почему Аллах не говорит с нами? Почему знамение не приходит к нам?». Такие же слова произносили их предшественники. Их сердца похожи. Мы уже разъяснили знамения людям убежденным!",["И сказали","те, которые","не","знают","Почему не","говорит с нами","Аллах","или","не приходит к нам","знамение","Подобно этому","говорили","те, которые","(жили)","до них","подобное","их словам","Схожи","сердца их","Уже","разъяснили Мы","знамения","для людей","убеждённых"]],[2,119,["إِنَّآ","أَرۡسَلۡنَٰكَ","بِٱلۡحَقِّ","بَشِيرٗا","وَنَذِيرٗاۖ","وَلَا","تُسۡـَٔلُ","عَنۡ","أَصۡحَٰبِ","ٱلۡجَحِيمِ"],"инна арсалнака билхаḳḳи башииран ваназииран вала тус'алу `ан асхабил жахиим","Мы отправили тебя с истиной добрым вестником и предостерегающим увещевателем, и ты не будешь спрошен об обитателях Ада.",["Поистине, Мы","послали Мы тебя","с истиной","благовестником","и предостерегающим","И не","будешь ты спрошен","об","обитателях","Ада"]]],"m":[[["وَقَالَتِ","И сказали",2,113],["ٱلۡيَهُودُ","иудеи",2,113],["لَيۡسَتِ","Не",2,113],["ٱلنَّصَٰرَىٰ","христиане",2,113],["عَلَىٰ","на",2,113],["شَيۡءٖ","чём-либо",2,113],["وَقَالَتِ","И сказали",2,113],["ٱلنَّصَٰرَىٰ","христиане",2,113]],[["لَيۡسَتِ","Не",2,113],["ٱلۡيَهُودُ","иудеи",2,113],["عَلَىٰ","на",2,113],["شَيۡءٖ","чём-либо",2,113],["وَهُمۡ","хотя они",2,113],["يَتۡلُونَ","читают",2,113],["ٱلۡكِتَٰبَۗ","Писание",2,113],["كَذَٰلِكَ","Подобно этому",2,113],["قَالَ","сказали",2,113]],[["ٱلَّذِينَ","те, которые",2,113],["لَا","не",2,113],["يَعۡلَمُونَ","знают",2,113],["مِثۡلَ","подобное",2,113],["قَوۡلِهِمۡۚ","их словам",2,113],["فَٱللَّهُ","И Аллах",2,113],["يَحۡكُمُ","рассудит",2,113],["بَيۡنَهُمۡ","между ними",2,113],["يَوۡمَ","в День",2,113],["ٱلۡقِيَٰمَةِ","Воскресения",2,113]],[["فِيمَا","в том, в чём",2,113],["كَانُواْ","они",2,113],["