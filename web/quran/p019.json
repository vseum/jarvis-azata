{"p":19,"j":1,"a":[[2,120,["وَلَن","تَرۡضَىٰ","عَنكَ","ٱلۡيَهُودُ","وَلَا","ٱلنَّصَٰرَىٰ","حَتَّىٰ","تَتَّبِعَ","مِلَّتَهُمۡۗ","قُلۡ","إِنَّ","هُدَى","ٱللَّهِ","هُوَ","ٱلۡهُدَىٰۗ","وَلَئِنِ","ٱتَّبَعۡتَ","أَهۡوَآءَهُم","بَعۡدَ","ٱلَّذِي","جَآءَكَ","مِنَ","ٱلۡعِلۡمِ","مَا","لَكَ","مِنَ","ٱللَّهِ","مِن","وَلِيّٖ","وَلَا","نَصِيرٍ"],"валан тарда `анкал йахууду валан насара хатта таттаби`а миллатахум ḳул инна худаллахи хуал худа валаиниттаба`та ахваахум ба`дал лазии жаака минал `илми ма лака миналлахи мин валиййин вала насиир","Иудеи и христиане не будут довольны тобой, пока ты не станешь придерживаться их религии. Скажи: «Путь Аллаха - это прямой путь». Если же ты станешь потакать их желаниям после того, как к тебе явилось знание, то Аллах не будет тебе ни Покровителем, ни Помощником.",["И никогда не","будут довольны","тобой","иудеи","и не","христиане","пока не","последуешь ты","их религии","Скажи","Поистине","руководство","Аллаха","оно","руководство","И если","последуешь ты","их желаниям","после","того, что","пришло к тебе","из","знания","не","тебе","от","Аллаха","никакого","покровителя","и не","помощника"]],[2,121,["ٱلَّذِينَ","ءَاتَيۡنَٰهُمُ","ٱلۡكِتَٰبَ","يَتۡلُونَهُۥ","حَقَّ","تِلَاوَتِهِۦٓ","أُوْلَٰٓئِكَ","يُؤۡمِنُونَ","بِهِۦۗ","وَمَن","يَكۡفُرۡ","بِهِۦ","فَأُوْلَٰٓئِكَ","هُمُ","ٱلۡخَٰسِرُونَ"],"аллазиина атайнахумул китаба йатлуунахуу хаḳḳа тилаватихии улаика йу'минууна бихии ваман йакфур бихии фа'улаика хумул хасируун","Те, кому Мы даровали Писание и кто читает его надлежащим образом, действительно веруют в него. А те, которые не уверуют в него, непременно окажутся в убытке.",["Те, которым","даровали Мы им","Писание","читают его","как подобает","читать его","Те","веруют","в него","А кто","не верует","в него","то те","они","потерпевшие убыток"]],[2,122,["يَٰبَنِيٓ","إِسۡرَٰٓءِيلَ","ٱذۡكُرُواْ","نِعۡمَتِيَ","ٱلَّتِيٓ","أَنۡعَمۡتُ","عَلَيۡكُمۡ","وَأَنِّي","فَضَّلۡتُكُمۡ","عَلَى","ٱلۡعَٰلَمِينَ"],"йабании исраиилазкуруу ни`матийал латии ан`амту `алайкум ва'аннии фаддалтукум `алал `аламиин","О сыны Исраила (Израиля)! Помните о милости, которую Я оказал вам, а также о том, что Я возвысил вас над мирами.",["О сыны","Исраила","Помните","милость Мою","которую","Я оказал","вам","и что Я","предпочёл вас","над","мирами"]],[2,123,["وَٱتَّقُواْ","يَوۡمٗا","لَّا","تَجۡزِي","نَفۡسٌ","عَن","نَّفۡسٖ","شَيۡـٔٗا","وَلَا","يُقۡبَلُ","مِنۡهَا","عَدۡلٞ","وَلَا","تَنفَعُهَا","شَفَٰعَةٞ","وَلَا","هُمۡ","يُنصَرُونَ"],"ваттаḳуу йаумал ла тажзии нафсун `ан нафсин шай'ан вала йуḳбалу минха `адлун вала танфа`уха шафа`атун вала хум йунсаруун","Страшитесь дня, когда ни один человек не принесет пользы другому и когда нельзя будет откупиться, когда ничем не поможет заступничество и когда им не будет оказана поддержка.",["И бойтесь","дня","не","возместит","душа","за","душу","ничего","и не","будет принято","от неё","возмещение","и не","поможет ей","заступничество","и не","им","будет оказана помощь"]],[2,124,["وَإِذِ","ٱبۡتَلَىٰٓ","إِبۡرَٰهِـۧمَ","رَبُّهُۥ","بِكَلِمَٰتٖ","فَأَتَمَّهُنَّۖ","قَالَ","إِنِّي","جَاعِلُكَ","لِلنَّاسِ","إِمَامٗاۖ","قَالَ","وَمِن","ذُرِّيَّتِيۖ","قَالَ","لَا","يَنَالُ","عَهۡدِي","ٱلظَّٰلِمِينَ"],"ва'изибтала ибрахиима раббухуу бикалиматин фа'атаммахунна ḳала иннии жа`илука линнаси имаман ḳала вамин зурриййатии ḳала ла йаналу `ахдиз залимиин","Вот испытал Господь Ибрахима (Авраама) повелениями, и тот выполнил их. Он сказал: «Я сделаю тебя предводителем людей». Ибрахим (Авраам) сказал: «И из моего потомства». Аллах сказал: «Мой завет не коснется беззаконников».",["И вот","испытал","Ибрахима","Господь его","словами","и он исполнил их","Он сказал","Поистине, Я","сделаю тебя","для людей","имамом","Он сказал","И из","моего потомства","Он сказал","Не","распространяется","Мой завет","на беззаконников"]],[2,125,["وَإِذۡ","جَعَلۡنَا","ٱلۡبَيۡتَ","مَثَابَةٗ","لِّلنَّاسِ","وَأَمۡنٗا","وَٱتَّخِذُواْ","مِن","مَّقَامِ","إِبۡرَٰهِـۧمَ","مُصَلّٗىۖ","وَعَهِدۡنَآ","إِلَىٰٓ","إِبۡرَٰهِـۧمَ","وَإِسۡمَٰعِيلَ","أَن","طَهِّرَا","بَيۡتِيَ","لِلطَّآئِفِينَ","وَٱلۡعَٰكِفِينَ","وَٱلرُّكَّعِ","ٱلسُّجُودِ"],"ва'из жа`алнал байта масабатал линнаси ва'амнан ваттахизуу мим маḳами ибрахиима мусаллан ва`ахидна ила ибрахиима ва'исма`иила ан таххира байтийа литтаифиина вал`акифиина варрукка`ис сужууд","Вот Мы сделали Дом (Каабу) пристанищем для людей и безопасным местом. Сделайте же место Ибрахима (Авраама) местом моления. Мы повелели Ибрахиму (Аврааму) и Исмаилу (Измаилу) очистить Мой Дом (Каабу) для совершающих обход, пребывающих, кланяющихся и падающих ниц.",["И вот","сделали Мы","Дом","местом сбора","для людей","и безопасностью","И сделайте","из","места стояния","Ибрахима","местом молитвы","И заповедали Мы","(обращаясь) к","Ибрахиму","и Исмаилу","чтобы","очистите вы двое","Дом Мой","для совершающих обход","и пребывающих","и кланяющихся","падающих ниц"]],[2,126,["وَإِذۡ","قَالَ","إِبۡرَٰهِـۧمُ","رَبِّ","ٱجۡعَلۡ","هَٰذَا","بَلَدًا","ءَامِنٗا","وَٱرۡزُقۡ","أَهۡلَهُۥ","مِنَ","ٱلثَّمَرَٰتِ","مَنۡ","ءَامَنَ","مِنۡهُم","بِٱللَّهِ","وَٱلۡيَوۡمِ","ٱلۡأٓخِرِۚ","قَالَ","وَمَن","كَفَرَ","فَأُمَتِّعُهُۥ","قَلِيلٗا","ثُمَّ","أَضۡطَرُّهُۥٓ","إِلَىٰ","عَذَابِ","ٱلنَّارِۖ","وَبِئۡسَ","ٱلۡمَصِيرُ"],"ва'из ḳала ибрахииму раббиж`ал хаза баладан аминан варзуḳ ахлахуу минас самарати ман амана минхум биллахи валйаумил ахири ḳала ваман кафара фа'уматти`ухуу ḳалиилан сумма адтаррухуу ила `азабин нари ваби'сал масиир","Вот сказал Ибрахим (Авраам): «Господи! Сделай этот город безопасным и надели плодами его жителей, которые уверовали в Аллаха и в Последний день». Он сказал: «А неверующим Я позволю пользоваться благами недолгое время, а затем заставлю их страдать в Огне. Как же скверно это место прибытия!».",["И вот","сказал","Ибрахим","Господи","сделай","это","город","безопасным","и надели","жителей его","из","плодов","тех, кто","уверовал","из них","в Аллаха","и в День","Последний","Он сказал","И тому, кто","не уверовал","Я дам ему пользоваться","немного","затем","загоню его","к","мучению","Огня","И скверно","место прибытия"]]],"m":[[["وَلَن","И ни