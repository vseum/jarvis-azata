{"p":20,"j":1,"a":[[2,127,["وَإِذۡ","يَرۡفَعُ","إِبۡرَٰهِـۧمُ","ٱلۡقَوَاعِدَ","مِنَ","ٱلۡبَيۡتِ","وَإِسۡمَٰعِيلُ","رَبَّنَا","تَقَبَّلۡ","مِنَّآۖ","إِنَّكَ","أَنتَ","ٱلسَّمِيعُ","ٱلۡعَلِيمُ"],"ва'из йарфа`у ибрахиимул ḳава`ида минал байти ва'исма`иилу раббана таḳаббал минна иннака антас самии`ул `алиим","Вот Ибрахим (Авраам) и Исмаил (Измаил) подняли основание Дома (Каабы): «Господь наш! Прими от нас! Воистину, Ты - Слышащий, Знающий.",["И вот","возводил","Ибрахим","основания","у","Дома","и Исмаил","Господь наш","прими","от нас","Поистине, Ты","Ты","Слышащий","Знающий"]],[2,128,["رَبَّنَا","وَٱجۡعَلۡنَا","مُسۡلِمَيۡنِ","لَكَ","وَمِن","ذُرِّيَّتِنَآ","أُمَّةٗ","مُّسۡلِمَةٗ","لَّكَ","وَأَرِنَا","مَنَاسِكَنَا","وَتُبۡ","عَلَيۡنَآۖ","إِنَّكَ","أَنتَ","ٱلتَّوَّابُ","ٱلرَّحِيمُ"],"раббана важ`ална муслимайни лака вамин зурриййатина умматам муслиматал лака ва'арина манасикана ватуб `алайна иннака антат таввабур рахиим","Господь наш! Сделай нас покорившимися Тебе, а из нашего потомства - общину, покорившуюся Тебе. Покажи нам обряды поклонения и прими наше покаяние. Воистину, Ты - Принимающий покаяние, Милосердный.",["Господь наш","и сделай нас","покорными двоими","Тебе","и из","нашего потомства","общину","покорную","Тебе","и покажи нам","обряды наши","и прими покаяние","наше","Поистине, Ты","Ты","Принимающий покаяние","Милосердный"]],[2,129,["رَبَّنَا","وَٱبۡعَثۡ","فِيهِمۡ","رَسُولٗا","مِّنۡهُمۡ","يَتۡلُواْ","عَلَيۡهِمۡ","ءَايَٰتِكَ","وَيُعَلِّمُهُمُ","ٱلۡكِتَٰبَ","وَٱلۡحِكۡمَةَ","وَيُزَكِّيهِمۡۖ","إِنَّكَ","أَنتَ","ٱلۡعَزِيزُ","ٱلۡحَكِيمُ"],"раббана ваб`ас фиихим расуулам минхум йатлуу `алайхим айатика вайу`аллимухумул китаба валхикмата вайузаккиихим иннака антал `азиизул хакиим","Господь наш! Пошли к ним посланника из них самих, который прочтет им Твои аяты, научит их Писанию и мудрости и очистит их. Воистину, Ты - Могущественный, Мудрый».",["Господь наш","и пошли","среди них","посланника","из них","который будет читать","им","Твои аяты","и обучать их","Писанию","и мудрости","и очищать их","Поистине, Ты","Ты","Могущественный","Мудрый"]],[2,130,["وَمَن","يَرۡغَبُ","عَن","مِّلَّةِ","إِبۡرَٰهِـۧمَ","إِلَّا","مَن","سَفِهَ","نَفۡسَهُۥۚ","وَلَقَدِ","ٱصۡطَفَيۡنَٰهُ","فِي","ٱلدُّنۡيَاۖ","وَإِنَّهُۥ","فِي","ٱلۡأٓخِرَةِ","لَمِنَ","ٱلصَّٰلِحِينَ"],"ваман йаргабу `ам миллати ибрахиима илла ман сафиха нафсахуу валаḳадистафайнаху фид дунйа ва'иннахуу фил ахирати ламинас салихиин","Кто же отвернется от религии Ибрахима (Авраама), кроме глупца? Мы избрали его в мирской жизни, а в Последней жизни он будет в числе праведников.",["И кто","отвернётся","от","религии","Ибрахима","кроме","того, кто","оглупил","самого себя","И ведь уже","избрали Мы его","в","мире этом","и поистине, он","в","Последней жизни","непременно из","праведников"]],[2,131,["إِذۡ","قَالَ","لَهُۥ","رَبُّهُۥٓ","أَسۡلِمۡۖ","قَالَ","أَسۡلَمۡتُ","لِرَبِّ","ٱلۡعَٰلَمِينَ"],"из ḳала лахуу раббухуу аслим ḳала асламту лираббил `аламиин","Вот сказал Господь Ибрахиму (Аврааму): «Покорись!». Он сказал: «Я покорился Господу миров».",["Вот","сказал","ему","Господь его","Покорись","он сказал","Я покорился","Господу","миров"]],[2,132,["وَوَصَّىٰ","بِهَآ","إِبۡرَٰهِـۧمُ","بَنِيهِ","وَيَعۡقُوبُ","يَٰبَنِيَّ","إِنَّ","ٱللَّهَ","ٱصۡطَفَىٰ","لَكُمُ","ٱلدِّينَ","فَلَا","تَمُوتُنَّ","إِلَّا","وَأَنتُم","مُّسۡلِمُونَ"],"вавасса биха ибрахииму баниихи вайа`ḳуубу йабаниййа инналлахастафа лакумуд диина фала тамуутунна илла ва'антум муслимуун","Ибрахим (Авраам) и Йакуб (Иаков) заповедали это своим сыновьям. Йакуб (Иаков) сказал: «О сыновья мои! Аллах избрал для вас религию. И умирайте не иначе, как будучи мусульманами».",["И завещал","это","Ибрахим","сыновьям своим","и Якуб","О сыновья мои","Поистине","Аллах","избрал","для вас","религию","так не","умирайте","иначе как","будучи вы","покорными"]],[2,133,["أَمۡ","كُنتُمۡ","شُهَدَآءَ","إِذۡ","حَضَرَ","يَعۡقُوبَ","ٱلۡمَوۡتُ","إِذۡ","قَالَ","لِبَنِيهِ","مَا","تَعۡبُدُونَ","مِنۢ","بَعۡدِيۖ","قَالُواْ","نَعۡبُدُ","إِلَٰهَكَ","وَإِلَٰهَ","ءَابَآئِكَ","إِبۡرَٰهِـۧمَ","وَإِسۡمَٰعِيلَ","وَإِسۡحَٰقَ","إِلَٰهٗا","وَٰحِدٗا","وَنَحۡنُ","لَهُۥ","مُسۡلِمُونَ"],"ам кунтум шухадаа из хадара йа`ḳуубал мауту из ḳала либаниихи ма та`будууна мим ба`дии ḳалуу на`буду илахака ва'илаха абаика ибрахиима ва'исма`иила ва'исхаḳа илахан вахидан ванахну лахуу муслимуун","Или же вы находились рядом, когда смерть явилась к Йакубу (Иакову)? Он сказал своим сыновьям: «Кому вы будете поклоняться после меня?». Они сказали: «Мы будем поклоняться твоему Богу и Богу твоих отцов - Ибрахима (Авраама), Исмаила (Измаила) и Исхака (Исаака), Единственному Богу. Ему одному мы покоряемся».",["Или","были вы","свидетелями","когда","пришла к","Якубу","смерть","когда","сказал он","сыновьям своим","Чему","будете вы поклоняться","впредь","после меня","Они сказали","Будем поклоняться","твоему Богу","и Богу","твоих отцов","Ибрахима","и Исмаила","и Исхака","Богу","Единому","И мы","Ему","покорны"]],[2,134,["تِلۡكَ","أُمَّةٞ","قَدۡ","خَلَتۡۖ","لَهَا","مَا","كَسَبَتۡ","وَلَكُم","مَّا","كَسَبۡتُمۡۖ","وَلَا","تُسۡـَٔلُونَ","عَمَّا","كَانُواْ","يَعۡمَلُونَ"],"тилка умматун ḳад халат лаха ма касабат валакум ма касабтум вала тус'алууна `амма кануу йа`малуун","Этот народ уже миновал. Они получат то, что они заслужили, а вы получите то, что вы заслужили, и вы не будете спрошены о том, что они совершали.",["Та","община","уже","прошла","ей","то, что","приобрела она","и вам","то, что","приобрели вы","И не","будете вы спрошены","о том, что","они","делали"]]],"m":[[["وَإِذۡ","И вот",2,127],["يَرۡفَعُ","возводил",2,127],["إِبۡرَٰهِـۧمُ","Ибрахим",2,127],["ٱلۡقَوَاعِدَ","основания",2,127],["مِنَ","у",2,127],["ٱلۡبَيۡتِ","Дома",2,127],["وَإِسۡمَٰعِيلُ","и Исмаил",2,127],["رَبَّنَا","Господь наш",2,127],["تَقَبَّلۡ","прими",2,127]],[["مِنَّآۖ","от нас",2,127],["إِنَّكَ","Поистине, Ты",2,127],["أَنتَ","Ты",2,127],["ٱلسَّمِيعُ","Слышащий",2,127],["ٱلۡعَلِيمُ","Знающий",2,127],[127],["رَبَّنَا","Господь наш",2,128],["وَٱجۡعَلۡنَا","и сделай нас",2,128],["مُسۡلِمَيۡنِ","покорными двоими",2,128]]