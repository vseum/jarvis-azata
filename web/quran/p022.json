{"p":22,"j":2,"a":[[2,142,["سَيَقُولُ","ٱلسُّفَهَآءُ","مِنَ","ٱلنَّاسِ","مَا","وَلَّىٰهُمۡ","عَن","قِبۡلَتِهِمُ","ٱلَّتِي","كَانُواْ","عَلَيۡهَاۚ","قُل","لِّلَّهِ","ٱلۡمَشۡرِقُ","وَٱلۡمَغۡرِبُۚ","يَهۡدِي","مَن","يَشَآءُ","إِلَىٰ","صِرَٰطٖ","مُّسۡتَقِيمٖ"],"сайаḳуулус суфахау минан наси ма валлахум `ан ḳиблатихимул латии кануу `алайха ḳул лиллахил машриḳу валмагрибу йахдии ман йашау ила сиратим мустаḳиим","Глупые люди скажут: «Что заставило их отвернуться от киблы, к которой они поворачивались лицом прежде?». Скажи: «Восток и запад принадлежат Аллаху. Он наставляет, кого пожелает, на прямой путь».",["скажут","глупцы","из","людей","что","отвратило их","от","их киблы","которой","они были","на ней","скажи","Аллаху (принадлежат)","восток","и запад","Он ведёт","кого","пожелает","к","пути","прямому"]],[2,143,["وَكَذَٰلِكَ","جَعَلۡنَٰكُمۡ","أُمَّةٗ","وَسَطٗا","لِّتَكُونُواْ","شُهَدَآءَ","عَلَى","ٱلنَّاسِ","وَيَكُونَ","ٱلرَّسُولُ","عَلَيۡكُمۡ","شَهِيدٗاۗ","وَمَا","جَعَلۡنَا","ٱلۡقِبۡلَةَ","ٱلَّتِي","كُنتَ","عَلَيۡهَآ","إِلَّا","لِنَعۡلَمَ","مَن","يَتَّبِعُ","ٱلرَّسُولَ","مِمَّن","يَنقَلِبُ","عَلَىٰ","عَقِبَيۡهِۚ","وَإِن","كَانَتۡ","لَكَبِيرَةً","إِلَّا","عَلَى","ٱلَّذِينَ","هَدَى","ٱللَّهُۗ","وَمَا","كَانَ","ٱللَّهُ","لِيُضِيعَ","إِيمَٰنَكُمۡۚ","إِنَّ","ٱللَّهَ","بِٱلنَّاسِ","لَرَءُوفٞ","رَّحِيمٞ"],"ваказалика жа`алнакум умматан васатал литакуунуу шухадаа `алан наси вайакуунар расуулу `алайкум шахиидан вама жа`алнал ḳиблатал латии кунта `алайха илла лина`лама ман йаттаби`ур расуула мимман йанḳалибу `ала `аḳибайхи ва'ин канат лакабииратан илла `алал лазиина хадаллаху вама каналлаху лийудии`а ииманакум инналлаха биннаси лараууфур рахиим","Мы сделали вас общиной, придерживающейся середины, чтобы вы свидетельствовали обо всем человечестве, а Посланник свидетельствовал о вас самих. Мы назначили киблу, к которой ты поворачивался лицом прежде, только для того, чтобы отличить тех, кто последует за Посланником, от тех, кто повернется вспять. Это оказалось тяжело для всех, кроме тех, кого Аллах повел прямым путем. Аллах никогда не даст пропасть вашей вере. Воистину, Аллах сострадателен и милосерден к людям.",["и так","Мы сделали вас","общиной","срединной","чтобы вы были","свидетелями","о","людях","и был","Посланник","о вас","свидетелем","и не","Мы сделали","киблу","которой","ты был","на ней","кроме как","чтобы Нам знать","кто","следует","за Посланником","от того, кто","поворачивает","на","свои пятки","и поистине","было","непременно тяжким","кроме как","для","тех, которых","повёл верно","Аллах","и не","было (в обычае)","Аллаха","чтобы погубить","вашу веру","поистине","Аллах","к людям","непременно Сострадателен","Милосерден"]],[2,144,["قَدۡ","نَرَىٰ","تَقَلُّبَ","وَجۡهِكَ","فِي","ٱلسَّمَآءِۖ","فَلَنُوَلِّيَنَّكَ","قِبۡلَةٗ","تَرۡضَىٰهَاۚ","فَوَلِّ","وَجۡهَكَ","شَطۡرَ","ٱلۡمَسۡجِدِ","ٱلۡحَرَامِۚ","وَحَيۡثُ","مَا","كُنتُمۡ","فَوَلُّواْ","وُجُوهَكُمۡ","شَطۡرَهُۥۗ","وَإِنَّ","ٱلَّذِينَ","أُوتُواْ","ٱلۡكِتَٰبَ","لَيَعۡلَمُونَ","أَنَّهُ","ٱلۡحَقُّ","مِن","رَّبِّهِمۡۗ","وَمَا","ٱللَّهُ","بِغَٰفِلٍ","عَمَّا","يَعۡمَلُونَ"],"ḳад нара таḳаллуба важхика фис самаи фалануаллийаннака ḳиблатан тардаха фавалли важхака шатрал масжидил харами вахайсу ма кунтум фаваллуу вужуухакум шатрахуу ва'иннал лазиина уутул китаба лайа`ламууна аннахул хаḳḳу мир раббихим вамаллаху бигафилин `амма йа`малуун","Мы видели, как ты обращал свое лицо к небу, и Мы обратим тебя к кибле, которой ты останешься доволен. Обрати же свое лицо в сторону Заповедной мечети. Где бы вы ни были, обращайте ваши лица в ее сторону. Воистину, те, которым даровано Писание, знают, что такова истина от их Господа. Аллах не пребывает в неведении относительно того, что они совершают.",["уже","Мы видим","обращение","твоего лица","к","небу","и непременно обратим Мы тебя","к кибле","которой ты будешь доволен","так обрати","своё лицо","в сторону","мечети","Заповедной","и где","бы ни","вы были","обращайте","ваши лица","в её сторону","и поистине","те, которым","было даровано","Писание","непременно знают","что это","истина","от","их Господа","и не","Аллах","в неведении","о том, что","они делают"]],[2,145,["وَلَئِنۡ","أَتَيۡتَ","ٱلَّذِينَ","أُوتُواْ","ٱلۡكِتَٰبَ","بِكُلِّ","ءَايَةٖ","مَّا","تَبِعُواْ","قِبۡلَتَكَۚ","وَمَآ","أَنتَ","بِتَابِعٖ","قِبۡلَتَهُمۡۚ","وَمَا","بَعۡضُهُم","بِتَابِعٖ","قِبۡلَةَ","بَعۡضٖۚ","وَلَئِنِ","ٱتَّبَعۡتَ","أَهۡوَآءَهُم","مِّنۢ","بَعۡدِ","مَا","جَآءَكَ","مِنَ","ٱلۡعِلۡمِ","إِنَّكَ","إِذٗا","لَّمِنَ","ٱلظَّٰلِمِينَ"],"валаин атайтал лазиина уутул китаба бикулли айатим ма таби`уу ḳиблатака вама анта битаби`ин ḳиблатахум вама ба`духум битаби`ин ḳиблата ба`дин валаиниттаба`та ахваахум мим ба`ди ма жаака минал `илми иннака изал ламиназ залимиин","Какое бы знамение ты ни показал тем, кому было даровано Писание, они все равно не станут обращаться к твоей кибле, а ты не станешь обращаться к их кибле. Никто не станет обращаться к кибле других. А если ты станешь потакать их желаниям после того, как к тебе явилось знание, то тогда ты окажешься в числе беззаконников.",["и даже если","ты придёшь","к тем, которым","было даровано","Писание","со всяким","знамением","не","последуют они","за твоей киблой","и не","ты","последователь","их киблы","и не","одни из них","последователи","киблы","других","и если же","ты последуешь","их страстям","после","того","как","пришло к тебе","из","знания","поистине, ты","тогда","непременно из числа","беззаконников"]]],"m":[[["۞ سَيَقُولُ","скажут",2,142],["ٱلسُّفَهَآءُ","глупцы",2,142],["مِنَ","из",2,142],["ٱلنَّاسِ","людей",2,142],["مَا","что",2,142],["وَلَّىٰهُمۡ","отвратило их",2,142],["عَن","от",2,142],["قِبۡلَتِهِمُ","их киблы",2,142],["ٱلَّتِي","которой",2,142],["كَانُواْ","они были",2,142]],[["عَلَيۡهَاۚ","на ней",2,142],["قُل","скажи",2,142],["لِّلَّهِ","Аллаху (принадлежат)",2,142],["ٱلۡمَشۡرِقُ","восток",2,142],["وَٱلۡمَغۡرِبُۚ","и запад",2,142],["يَهۡدِي","Он ведёт",2,142],["مَن","кого",2,142],["يَشَآءُ","пожелает",2,142],["إِلَىٰ","к",2,142],["صِرَٰطٖ","пути",2,142]],[["مُّسۡتَقِيمٖ","прямому",2,142],[142],["وَكَ