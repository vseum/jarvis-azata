{"p":23,"j":2,"a":[[2,146,["ٱلَّذِينَ","ءَاتَيۡنَٰهُمُ","ٱلۡكِتَٰبَ","يَعۡرِفُونَهُۥ","كَمَا","يَعۡرِفُونَ","أَبۡنَآءَهُمۡۖ","وَإِنَّ","فَرِيقٗا","مِّنۡهُمۡ","لَيَكۡتُمُونَ","ٱلۡحَقَّ","وَهُمۡ","يَعۡلَمُونَ"],"аллазиина атайнахумул китаба йа`рифуунахуу кама йа`рифууна абнаахум ва'инна фарииḳам минхум лайактумуунал хаḳḳа вахум йа`ламуун","Те, кому Мы даровали Писание, знают его (Мухаммада или Каабу), как знают своих сыновей. Однако часть их сознательно скрывает истину.",["те, которым","Мы даровали","Писание","знают его","как","знают","своих сыновей","и поистине","часть","из них","непременно скрывают","истину","в то время как они","знают"]],[2,147,["ٱلۡحَقُّ","مِن","رَّبِّكَ","فَلَا","تَكُونَنَّ","مِنَ","ٱلۡمُمۡتَرِينَ"],"алхаḳḳу мир раббика фала такуунанна минал мумтариин","Истина - от твоего Господа. Посему не будь в числе тех, кто сомневается.",["истина","от","твоего Господа","так не","будь же","из","сомневающихся"]],[2,148,["وَلِكُلّٖ","وِجۡهَةٌ","هُوَ","مُوَلِّيهَاۖ","فَٱسۡتَبِقُواْ","ٱلۡخَيۡرَٰتِۚ","أَيۡنَ","مَا","تَكُونُواْ","يَأۡتِ","بِكُمُ","ٱللَّهُ","جَمِيعًاۚ","إِنَّ","ٱللَّهَ","عَلَىٰ","كُلِّ","شَيۡءٖ","قَدِيرٞ"],"валикуллин вижхатун хуа муаллииха фастабиḳул хайрати айна ма такуунуу йа'ти бикумуллаху жамии`ан инналлаха `ала кулли шай'ин ḳадиир","У каждого есть сторона, куда он обращается лицом. Стремитесь же опередить друг друга в добрых делах. Где бы вы ни были, Аллах приведет всех вас вместе. Воистину, Аллах способен на всякую вещь.",["и у каждого","направление","он","обращается к нему","так соревнуйтесь","в добрых делах","где","бы ни","вы были","приведёт","вас","Аллах","всех вместе","поистине","Аллах","над","всякой","вещью","Всемогущ"]],[2,149,["وَمِنۡ","حَيۡثُ","خَرَجۡتَ","فَوَلِّ","وَجۡهَكَ","شَطۡرَ","ٱلۡمَسۡجِدِ","ٱلۡحَرَامِۖ","وَإِنَّهُۥ","لَلۡحَقُّ","مِن","رَّبِّكَۗ","وَمَا","ٱللَّهُ","بِغَٰفِلٍ","عَمَّا","تَعۡمَلُونَ"],"вамин хайсу харажта фавалли важхака шатрал масжидил харами ва'иннахуу лалхаḳḳу мир раббика вамаллаху бигафилин `амма та`малуун","Откуда бы ты ни вышел, обращай лицо в сторону Заповедной мечети. Воистину, такова истина от твоего Господа. Аллах не пребывает в неведении относительно того, что вы совершаете.",["и откуда","бы ни","ты вышел","обрати","своё лицо","в сторону","мечети","Заповедной","и поистине, это","непременно истина","от","твоего Господа","и не","Аллах","в неведении","о том, что","вы делаете"]],[2,150,["وَمِنۡ","حَيۡثُ","خَرَجۡتَ","فَوَلِّ","وَجۡهَكَ","شَطۡرَ","ٱلۡمَسۡجِدِ","ٱلۡحَرَامِۚ","وَحَيۡثُ","مَا","كُنتُمۡ","فَوَلُّواْ","وُجُوهَكُمۡ","شَطۡرَهُۥ","لِئَلَّا","يَكُونَ","لِلنَّاسِ","عَلَيۡكُمۡ","حُجَّةٌ","إِلَّا","ٱلَّذِينَ","ظَلَمُواْ","مِنۡهُمۡ","فَلَا","تَخۡشَوۡهُمۡ","وَٱخۡشَوۡنِي","وَلِأُتِمَّ","نِعۡمَتِي","عَلَيۡكُمۡ","وَلَعَلَّكُمۡ","تَهۡتَدُونَ"],"вамин хайсу харажта фавалли важхака шатрал масжидил харами вахайсу ма кунтум фаваллуу вужуухакум шатрахуу ли'алла йакууна линнаси `алайкум хужжатун иллал лазиина заламуу минхум фала тахшаухум вахшаунии валиутимма ни`матии `алайкум вала`аллакум тахтадуун","Откуда бы ты ни вышел, обращай лицо в сторону Заповедной мечети. Где бы вы ни оказались, обращайте ваши лица в ее сторону, чтобы у людей, если только они не беззаконники, не было довода против вас. Не бойтесь их, а бойтесь Меня, чтобы Я довел до конца Мою милость к вам. Быть может, вы последуете прямым путем.",["и откуда","бы ни","ты вышел","обрати","своё лицо","в сторону","мечети","Заповедной","и где","бы ни","вы были","обращайте","ваши лица","в её сторону","чтобы не","было","у людей","против вас","довода","кроме","тех, которые","поступили несправедливо","из них","так не","бойтесь их","и бойтесь Меня","и чтобы Я завершил","Мою милость","вам","и, быть может, вы","пойдёте прямым путём"]],[2,151,["كَمَآ","أَرۡسَلۡنَا","فِيكُمۡ","رَسُولٗا","مِّنكُمۡ","يَتۡلُواْ","عَلَيۡكُمۡ","ءَايَٰتِنَا","وَيُزَكِّيكُمۡ","وَيُعَلِّمُكُمُ","ٱلۡكِتَٰبَ","وَٱلۡحِكۡمَةَ","وَيُعَلِّمُكُم","مَّا","لَمۡ","تَكُونُواْ","تَعۡلَمُونَ"],"кама арсална фиикум расуулам минкум йатлуу `алайкум айатина вайузаккиикум вайу`аллимукумул китаба валхикмата вайу`аллимукум ма лам такуунуу та`ламуун","Таким же образом Я отправил к вам Посланника из вашей среды, который читает вам Наши аяты, очищает вас, обучает вас Писанию и мудрости, обучает вас тому, чего вы не знали.",["так же как","Мы послали","к вам","посланника","из вас","он читает","вам","Наши аяты","и очищает вас","и обучает вас","Писанию","и мудрости","и обучает вас","тому, что","не","были вы","знающими"]],[2,152,["فَٱذۡكُرُونِيٓ","أَذۡكُرۡكُمۡ","وَٱشۡكُرُواْ","لِي","وَلَا","تَكۡفُرُونِ"],"фазкуруунии азкуркум вашкуруу лии вала такфуруун","Поминайте Меня, и Я буду помнить о вас. Благодарите Меня и не будьте неблагодарны Мне.",["поминайте же Меня","Я буду помнить вас","и благодарите","Меня","и не","будьте неблагодарны Мне"]],[2,153,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُواْ","ٱسۡتَعِينُواْ","بِٱلصَّبۡرِ","وَٱلصَّلَوٰةِۚ","إِنَّ","ٱللَّهَ","مَعَ","ٱلصَّٰبِرِينَ"],"йа'аййухал лазиина амануста`иинуу биссабри вассалавати инналлаха ма`ас сабириин","О те, которые уверовали! Обратитесь за помощью к терпению и намазу. Воистину, Аллах - с терпеливыми.",["о","те, которые","уверовали","просите помощи","терпением","и молитвой","поистине","Аллах","с","терпеливыми"]]],"m":[[["ٱلَّذِينَ","те, которым",2,146],["ءَاتَيۡنَٰهُمُ","Мы даровали",2,146],["ٱلۡكِتَٰبَ","Писание",2,146],["يَعۡرِفُونَهُۥ","знают его",2,146],["كَمَا","как",2,146],["يَعۡرِفُونَ","знают",2,146],["أَبۡنَآءَهُمۡۖ","своих сыновей",2,146],["وَإِنَّ","и поистине",2,146]],[["فَرِيقٗا","часть",2,146],["مِّنۡهُمۡ","из них",2,146],["لَيَكۡتُمُونَ","непременно скрывают",2,146],["ٱلۡحَقَّ","истину",2,146],["وَهُمۡ","в то время как они",2,146],["يَعۡلَمُونَ","знают",2,146],[146],["ٱلۡحَقُّ","истина",2,147],["مِن","от",2,147]],[["رَّبِّكَ","твоего Господа",2,147],["فَلَا","так не",2,147],["تَكُونَنَّ","будь же",2,147],["مِنَ","из",2,147],["ٱلۡمُمۡتَرِينَ","сомневающихся",2,147],[147],["وَلِكُلّٖ","и у каждого",2,148],["وِجۡهَةٌ","направление",2,148],["هُوَ","он",2,148],["مُوَلِّيهَاۖ","обращается к нему",2,148]],[["فَٱسۡتَبِقُواْ","так соревнуйтесь",2,148],["ٱلۡخَيۡرَٰتِۚ","в добрых делах",2,148],["أَيۡنَ","где",2,148],["مَا","бы ни",2,148],["تَكُونُواْ","вы были",2,148],["يَأۡتِ","приведёт",2,148],["بِكُمُ","вас",2,148],["ٱللَّهُ","Аллах",2,148],["جَمِيعًاۚ","всех вместе",2,148]],[["إِنَّ","поистине",2,148],["ٱللَّهَ","Аллах",2,148],["عَلَىٰ","над",2,148],["كُلِّ","всякой",2,148],["شَيۡءٖ","вещью",2,148],["قَدِيرٞ","Всемогущ",2,148],[148],["وَمِنۡ","и откуда",2,149],["حَيۡثُ","бы ни",2,149],["خَرَجۡتَ","ты вышел",2,149],["فَوَلِّ","обрати",2,149]],[["وَجۡهَكَ","своё лицо",2,149],["شَطۡرَ","в сторону",2,149],["ٱلۡمَسۡجِدِ","мечети",2,149],["ٱلۡحَرَامِۖ","Заповедной",2,149],["وَإِنَّهُۥ","и поистине, это",2,149],["لَلۡحَقُّ","непременно истина",2,149],["مِن","от",2,149],["رَّبِّكَۗ","твоего Господа",2,149],["وَمَا","и не",2,149]],[["ٱللَّهُ","Аллах",2,149],["بِغَٰفِلٍ","в неведении",2,149],["عَمَّا","о том, что",2,149],["تَعۡمَلُونَ","вы делаете",2,149],[149],["وَمِنۡ","и откуда",2,150],["حَيۡثُ","бы ни",2,150],["خَرَجۡتَ","ты вышел",2,150],["فَوَلِّ","обрати",2,150],["وَجۡهَكَ","своё лицо",2,150]],[["شَطۡرَ","в сторону",2,150],["ٱلۡمَسۡجِدِ","мечети",2,150],["ٱلۡحَرَامِۚ","Заповедной",2,150],["وَحَيۡثُ","и где",2,150],["مَا","бы ни",2,150],["كُنتُمۡ","вы были",2,150],["فَوَلُّواْ","обращайте",2,150],["وُجُوهَكُمۡ","ваши лица",2,150]],[["شَطۡرَهُۥ","в её сторону",2,150],["لِئَلَّا","чтобы не",2,150],["يَكُونَ","было",2,150],["لِلنَّاسِ","у людей",2,150],["عَلَيۡكُمۡ","против вас",2,150],["حُجَّةٌ","довода",2,150],["إِلَّا","кроме",2,150],["ٱلَّذِينَ","тех, которые",2,150],["ظَلَمُواْ","поступили несправедливо",2,150]],[["مِنۡهُمۡ","из них",2,150],["فَلَا","так не",2,150],["تَخۡشَوۡهُمۡ","бойтесь их",2,150],["وَٱخۡشَوۡنِي","и бойтесь Меня",2,150],["وَلِأُتِمَّ","и чтобы Я завершил",2,150],["نِعۡمَتِي","Мою милость",2,150],["عَلَيۡكُمۡ","вам",2,150],["وَلَعَلَّكُمۡ","и, быть может, вы",2,150]],[["تَهۡتَدُونَ","пойдёте прямым путём",2,150],[150],["ك