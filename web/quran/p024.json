{"p":24,"j":2,"a":[[2,154,["وَلَا","تَقُولُواْ","لِمَن","يُقۡتَلُ","فِي","سَبِيلِ","ٱللَّهِ","أَمۡوَٰتُۢۚ","بَلۡ","أَحۡيَآءٞ","وَلَٰكِن","لَّا","تَشۡعُرُونَ"],"вала таḳуулуу лиман йуḳталу фии сабиилиллахи амвату бал ахйаун валакил ла таш`уруун","Не говорите о тех, кто погиб на пути Аллаха: «Мертвецы!». Напротив, они живы, но вы не ощущаете этого.",["и не","говорите","о тех, кто","убит","на","пути","Аллаха","мёртвые","нет же","живые","но","не","ощущаете вы"]],[2,155,["وَلَنَبۡلُوَنَّكُم","بِشَيۡءٖ","مِّنَ","ٱلۡخَوۡفِ","وَٱلۡجُوعِ","وَنَقۡصٖ","مِّنَ","ٱلۡأَمۡوَٰلِ","وَٱلۡأَنفُسِ","وَٱلثَّمَرَٰتِۗ","وَبَشِّرِ","ٱلصَّٰبِرِينَ"],"валанаблуаннакум бишай'им минал хауфи валжуу`и ванаḳсим минал амвали вал'анфуси вассамарати вабашширис сабириин","Мы непременно испытаем вас незначительным страхом, голодом, потерей имущества, людей и плодов. Обрадуй же терпеливых,",["и непременно испытаем Мы вас","чем-либо","из","страха","и голода","и убыли","из","имущества","и душ","и плодов","и обрадуй","терпеливых"]],[2,156,["ٱلَّذِينَ","إِذَآ","أَصَٰبَتۡهُم","مُّصِيبَةٞ","قَالُوٓاْ","إِنَّا","لِلَّهِ","وَإِنَّآ","إِلَيۡهِ","رَٰجِعُونَ"],"аллазиина иза асабатхум мусиибатун ḳалуу инна лиллахи ва'инна илайхи ражи`уун","которые, когда их постигает беда, говорят: «Воистину, мы принадлежим Аллаху, и к Нему мы вернемся».",["те, которые","когда","постигает их","беда","говорят","поистине, мы","Аллаху (принадлежим)","и поистине, мы","к Нему","вернёмся"]],[2,157,["أُوْلَٰٓئِكَ","عَلَيۡهِمۡ","صَلَوَٰتٞ","مِّن","رَّبِّهِمۡ","وَرَحۡمَةٞۖ","وَأُوْلَٰٓئِكَ","هُمُ","ٱلۡمُهۡتَدُونَ"],"улаика `алайхим салаватум мир раббихим варахматун ва'улаика хумул мухтадуун","Они удостаиваются благословения своего Господа и милости. Они следуют прямым путем.",["те","на них","благословения","от","их Господа","и милость","и те","они","идущие прямым путём"]],[2,158,["إِنَّ","ٱلصَّفَا","وَٱلۡمَرۡوَةَ","مِن","شَعَآئِرِ","ٱللَّهِۖ","فَمَنۡ","حَجَّ","ٱلۡبَيۡتَ","أَوِ","ٱعۡتَمَرَ","فَلَا","جُنَاحَ","عَلَيۡهِ","أَن","يَطَّوَّفَ","بِهِمَاۚ","وَمَن","تَطَوَّعَ","خَيۡرٗا","فَإِنَّ","ٱللَّهَ","شَاكِرٌ","عَلِيمٌ"],"иннас сафа валмарвата мин ша`аириллахи фаман хажжал байта ави`тамара фала жунаха `алайхи ан йаттаввафа бихима ваман татавва`а хайран фа'инналлаха шакирун `алиим","Воистину, ас-Сафа и аль-Марва - одни из обрядовых знамений Аллаха. Кто совершает хадж к Каабе или малое паломничество, тот не совершит греха, если пройдет между ними. А если кто добровольно совершает доброе дело, то ведь Аллах - Признательный, Знающий.",["поистине","ас-Сафа","и аль-Марва","из","обрядовых знаков","Аллаха","так кто","совершил хадж","к Дому","или","совершил умру","то нет","греха","на нём","чтобы","он обходил","их обе","и кто","добровольно совершил","добро","то поистине","Аллах","Признательный","Знающий"]],[2,159,["إِنَّ","ٱلَّذِينَ","يَكۡتُمُونَ","مَآ","أَنزَلۡنَا","مِنَ","ٱلۡبَيِّنَٰتِ","وَٱلۡهُدَىٰ","مِنۢ","بَعۡدِ","مَا","بَيَّنَّٰهُ","لِلنَّاسِ","فِي","ٱلۡكِتَٰبِ","أُوْلَٰٓئِكَ","يَلۡعَنُهُمُ","ٱللَّهُ","وَيَلۡعَنُهُمُ","ٱللَّٰعِنُونَ"],"иннал лазиина йактумууна ма анзална минал баййинати валхуда мим ба`ди ма баййаннаху линнаси фил китаби улаика йал`анухумуллаху вайал`анухумул ла`инуун","Воистину, тех, которые скрывают ниспосланные Нами ясные знамения и верное руководство после того, как Мы разъяснили это людям в Писании, проклянет Аллах и проклянут проклинающие,",["поистине","те, которые","скрывают","то, что","Мы ниспослали","из","ясных знамений","и руководства","после","того","как","Мы разъяснили это","людям","в","Писании","те","проклинает их","Аллах","и проклинают их","проклинающие"]],[2,160,["إِلَّا","ٱلَّذِينَ","تَابُواْ","وَأَصۡلَحُواْ","وَبَيَّنُواْ","فَأُوْلَٰٓئِكَ","أَتُوبُ","عَلَيۡهِمۡ","وَأَنَا","ٱلتَّوَّابُ","ٱلرَّحِيمُ"],"иллал лазиина табуу ва'аслахуу вабаййануу фа'улаика атуубу `алайхим ва'анат таввабур рахиим","за исключением тех, которые раскаялись, исправили содеянное и стали разъяснять истину. Я приму их покаяния, ибо Я - Принимающий покаяния, Милосердный.",["кроме","тех, которые","покаялись","и исправили","и разъяснили","то те","Я приму покаяние","от них","и Я","Принимающий покаяние","Милосердный"]],[2,161,["إِنَّ","ٱلَّذِينَ","كَفَرُواْ","وَمَاتُواْ","وَهُمۡ","كُفَّارٌ","أُوْلَٰٓئِكَ","عَلَيۡهِمۡ","لَعۡنَةُ","ٱللَّهِ","وَٱلۡمَلَٰٓئِكَةِ","وَٱلنَّاسِ","أَجۡمَعِينَ"],"иннал лазиина кафаруу ваматуу вахум куффарун улаика `алайхим ла`натуллахи валмалаикати ваннаси ажма`иин","Воистину, на тех, которые не уверовали и умерли неверующими, лежит проклятие Аллаха, ангелов и людей - всех.",["поистине","те, которые","не уверовали","и умерли","и они","неверующие","те","на них","проклятие","Аллаха","и ангелов","и людей","всех"]],[2,162,["خَٰلِدِينَ","فِيهَا","لَا","يُخَفَّفُ","عَنۡهُمُ","ٱلۡعَذَابُ","وَلَا","هُمۡ","يُنظَرُونَ"],"халидиина фииха ла йухаффафу `анхумул `азабу вала хум йунзаруун","Это продлится вечно. Их мучения не будут облегчены, и они не получат отсрочки.",["вечно пребывая","в нём","не","будет облегчено","им","наказание","и не","они","получат отсрочку"]],[2,163,["وَإِلَٰهُكُمۡ","إِلَٰهٞ","وَٰحِدٞۖ","لَّآ","إِلَٰهَ","إِلَّا","هُوَ","ٱلرَّحۡمَٰنُ","ٱلرَّحِيمُ"],"ва'илахукум илахун вахидул ла илаха илла хуар рахманур рахиим","Ваш Бог - Бог Единственный. Нет божества, кроме Него, Милостивого, Милосердного.",["и ваш Бог","Бог","единый","нет","божества","кроме","Него","Милостивого","Милосердного"]]],"m":[[["وَلَا","и не",2,154],["تَقُولُواْ","говорите",2,154],["لِمَن","о тех, кто",2,154],["يُقۡتَلُ","убит",2,154],["فِي","на",2,154],["سَبِيلِ","пути",2,154],["ٱللَّهِ","Аллаха",2,154],["أَمۡوَٰتُۢۚ","мёртвые",2,154],["بَلۡ","нет же",2,154],["أَحۡيَآءٞ","живые",2,154],["وَلَٰكِن","но",2,154]],[["لَّا","не",2,154],["تَشۡعُرُونَ","ощущаете вы",2,154],[154],["وَلَنَبۡلُوَنَّكُم","и непременно испытаем Мы вас",2,155],["بِشَيۡءٖ","чем-либо",2,155],["مِّنَ","из",2,155],["ٱلۡخَوۡفِ","страха",2,155],["وَٱلۡجُوعِ","и голода",2,155]],[["وَنَقۡصٖ","и убыли",2,155],["مِّنَ","из",2,155],["ٱلۡأَمۡوَٰلِ","имущества",2,155],["وَٱلۡأَنفُسِ","и душ",2,155],["وَٱلثَّمَر