{"p":25,"j":2,"a":[[2,164,["إِنَّ","فِي","خَلۡقِ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِ","وَٱخۡتِلَٰفِ","ٱلَّيۡلِ","وَٱلنَّهَارِ","وَٱلۡفُلۡكِ","ٱلَّتِي","تَجۡرِي","فِي","ٱلۡبَحۡرِ","بِمَا","يَنفَعُ","ٱلنَّاسَ","وَمَآ","أَنزَلَ","ٱللَّهُ","مِنَ","ٱلسَّمَآءِ","مِن","مَّآءٖ","فَأَحۡيَا","بِهِ","ٱلۡأَرۡضَ","بَعۡدَ","مَوۡتِهَا","وَبَثَّ","فِيهَا","مِن","كُلِّ","دَآبَّةٖ","وَتَصۡرِيفِ","ٱلرِّيَٰحِ","وَٱلسَّحَابِ","ٱلۡمُسَخَّرِ","بَيۡنَ","ٱلسَّمَآءِ","وَٱلۡأَرۡضِ","لَأٓيَٰتٖ","لِّقَوۡمٖ","يَعۡقِلُونَ"],"инна фии халḳис самавати вал'арди вахтилафил лайли ваннахари валфулкил латии тажрии фил бахри бима йанфа`ун наса вама анзалаллаху минас самаи мим маин фа'ахйа бихил арда ба`да маутиха вабасса фииха мин кулли даббатин ватасриифир рийахи вассахабил мусаххари байнас самаи вал'арди ла'айатил лиḳаумин йа`ḳилуун","Воистину, в сотворении небес и земли, в смене ночи и дня, в кораблях, которые плывут по морю с тем, что приносит пользу людям, в воде, которую Аллах ниспослал с неба и посредством которой Он оживил мертвую землю и расселил на ней всевозможных животных, в смене ветров, в облаке, подчиненном между небом и землей, заключены знамения для людей разумеющих.",["поистине","в","сотворении","небес","и земли","и смене","ночи","и дня","и кораблях","которые","плывут","по","морю","с тем, что","приносит пользу","людям","и том, что","ниспослал","Аллах","с","неба","из","воды","и оживил","ею","землю","после","её смерти","и рассеял","по ней","из","всяких","животных","и смене","ветров","и облаках","подчинённых","между","небом","и землёй","непременно знамения","для людей","разумеющих"]],[2,165,["وَمِنَ","ٱلنَّاسِ","مَن","يَتَّخِذُ","مِن","دُونِ","ٱللَّهِ","أَندَادٗا","يُحِبُّونَهُمۡ","كَحُبِّ","ٱللَّهِۖ","وَٱلَّذِينَ","ءَامَنُوٓاْ","أَشَدُّ","حُبّٗا","لِّلَّهِۗ","وَلَوۡ","يَرَى","ٱلَّذِينَ","ظَلَمُوٓاْ","إِذۡ","يَرَوۡنَ","ٱلۡعَذَابَ","أَنَّ","ٱلۡقُوَّةَ","لِلَّهِ","جَمِيعٗا","وَأَنَّ","ٱللَّهَ","شَدِيدُ","ٱلۡعَذَابِ"],"ваминан наси ман йаттахизу мин дууниллахи андадан йухиббуунахум кахуббиллахи валлазиина амануу ашадду хуббал лиллахи валау йарал лазиина заламуу из йараунал `азаба аннал ḳуввата лиллахи жамии`ан ва'анналлаха шадиидул `азаб","Среди людей есть такие, которые приобщают к Аллаху равных и любят их так же, как любят Аллаха. Но те, которые уверовали, любят Аллаха сильнее. Если бы беззаконники, узрев мучения, увидели, что могущество целиком принадлежит Аллаху и что Аллах причиняет тяжкие мучения.",["и среди","людей","тот, кто","берёт","из","помимо","Аллаха","равных","любят их","как любовь","к Аллаху","а те, которые","уверовали","сильнее","любовью","к Аллаху","и если бы","увидели","те, которые","поступили несправедливо","когда","увидят","наказание","что","сила","у Аллаха","вся","и что","Аллах","суров","в наказании"]],[2,166,["إِذۡ","تَبَرَّأَ","ٱلَّذِينَ","ٱتُّبِعُواْ","مِنَ","ٱلَّذِينَ","ٱتَّبَعُواْ","وَرَأَوُاْ","ٱلۡعَذَابَ","وَتَقَطَّعَتۡ","بِهِمُ","ٱلۡأَسۡبَابُ"],"из табарраал лазиинаттуби`уу минал лазиинаттаба`уу вараавул `азаба ватаḳатта`ат бихимул асбаб","Когда те, за кем следовали, отрекутся от тех, кто следовал за ними, и увидят мучения, связи между ними оборвутся.",["когда","отрекутся","те, за которыми","следовали","от","тех, которые","следовали","и увидят","наказание","и порвутся","у них","связи"]],[2,167,["وَقَالَ","ٱلَّذِينَ","ٱتَّبَعُواْ","لَوۡ","أَنَّ","لَنَا","كَرَّةٗ","فَنَتَبَرَّأَ","مِنۡهُمۡ","كَمَا","تَبَرَّءُواْ","مِنَّاۗ","كَذَٰلِكَ","يُرِيهِمُ","ٱللَّهُ","أَعۡمَٰلَهُمۡ","حَسَرَٰتٍ","عَلَيۡهِمۡۖ","وَمَا","هُم","بِخَٰرِجِينَ","مِنَ","ٱلنَّارِ"],"ваḳалал лазиинаттаба`уу лау анна лана карратан фанатабарраа минхум кама табаррауу минна казалика йуриихимуллаху а`малахум хасаратин `алайхим вама хум бихарижиина минан нар","Те, которые следовали за другими, скажут: «Если бы у нас был еще один шанс, то мы отреклись бы от них, подобно тому, как они отреклись от нас». Таким же образом Аллах покажет им их деяния, чтобы это опечалило их. Они никогда не выйдут из Огня.",["и скажут","те, которые","следовали","если бы","что","у нас","возвращение","то мы отреклись бы","от них","как","они отреклись","от нас","так","покажет им","Аллах","их деяния","сожалениями","для них","и не","они","выходящие","из","Огня"]],[2,168,["يَٰٓأَيُّهَا","ٱلنَّاسُ","كُلُواْ","مِمَّا","فِي","ٱلۡأَرۡضِ","حَلَٰلٗا","طَيِّبٗا","وَلَا","تَتَّبِعُواْ","خُطُوَٰتِ","ٱلشَّيۡطَٰنِۚ","إِنَّهُۥ","لَكُمۡ","عَدُوّٞ","مُّبِينٌ"],"йа'аййухан насу кулуу мимма фил арди халалан таййибан вала таттаби`уу хутуатиш шайтани иннахуу лакум `адуввум мубиин","О люди! Вкушайте на земле то, что дозволено и чисто, и не следуйте по стопам дьявола. Воистину, он для вас - явный враг.",["о","люди","ешьте","из того, что","на","земле","дозволенным","благим","и не","следуйте","шагам","сатаны","поистине, он","для вас","враг","явный"]],[2,169,["إِنَّمَا","يَأۡمُرُكُم","بِٱلسُّوٓءِ","وَٱلۡفَحۡشَآءِ","وَأَن","تَقُولُواْ","عَلَى","ٱللَّهِ","مَا","لَا","تَعۡلَمُونَ"],"иннама йа'мурукум биссууи валфахшаи ва'ан таḳуулуу `алаллахи ма ла та`ламуун","Воистину, он велит вам творить зло и мерзость и наговаривать на Аллаха то, чего вы не знаете.",["лишь","он велит вам","злое","и мерзкое","и чтобы","вы говорили","на","Аллаха","то, что","не","знаете вы"]]],"m":[[["إِنَّ","поистине",2,164],["فِي","в",2,164],["خَلۡقِ","сотворении",2,164],["ٱلسَّمَٰوَٰتِ","небес",2,164],["وَٱلۡأَرۡضِ","и земли",2,164],["وَٱخۡتِلَٰفِ","и смене",2,164],["ٱلَّيۡلِ","ночи",2,164],["وَٱلنَّهَارِ","и дня",2,164]],[["وَٱلۡفُلۡكِ","и кораблях",2,164],["ٱلَّتِي","которые",2,164],["تَجۡرِي","плывут",2,164],["فِي","по",2,164],["ٱلۡبَحۡرِ","морю",2,164],["بِمَا","с тем, что",2,164],["يَنفَعُ","приносит пользу",2,164],["ٱلنَّاسَ","людям",2,164],["وَمَآ","и том, что",2,164],["أَنزَلَ","ниспослал",2,164],["ٱللَّهُ","Аллах",2,164]],[["مِنَ","с",2,164],["ٱلسَّمَآءِ","неба",2,164],["مِن","из",2,164],["مَّآءٖ","воды",2,164],["فَأَحۡيَا","и оживил",2,164],["بِهِ","ею",2,164],["ٱلۡأَرۡضَ","землю",2,164],["بَعۡدَ","после",2,164],["مَوۡتِهَا","её смерти",2,164],["وَبَثَّ","и рассеял",2,164],["فِيهَا","по ней",2,164]],[["