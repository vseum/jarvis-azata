{"p":26,"j":2,"a":[[2,170,["وَإِذَا","قِيلَ","لَهُمُ","ٱتَّبِعُواْ","مَآ","أَنزَلَ","ٱللَّهُ","قَالُواْ","بَلۡ","نَتَّبِعُ","مَآ","أَلۡفَيۡنَا","عَلَيۡهِ","ءَابَآءَنَآۚ","أَوَلَوۡ","كَانَ","ءَابَآؤُهُمۡ","لَا","يَعۡقِلُونَ","شَيۡـٔٗا","وَلَا","يَهۡتَدُونَ"],"ва'иза ḳиила лахумуттаби`уу ма анзалаллаху ḳалуу бал наттаби`у ма алфайна `алайхи абаана авалау кана абаухум ла йа`ḳилууна шай'ан вала йахтадуун","Когда им говорят: «Следуйте тому, что ниспослал Аллах», - они отвечают: «Нет! Мы будем следовать тому, на чем застали наших отцов». А если их отцы ничего не разумели и не следовали прямым путем?",["и когда","говорят","им","следуйте","тому, что","ниспослал","Аллах","говорят они","нет","мы следуем","то, что","застали мы","на нём","наших отцов","разве даже если","были","их отцы","не","разумеющими","ничего","и не","шли прямым путём"]],[2,171,["وَمَثَلُ","ٱلَّذِينَ","كَفَرُواْ","كَمَثَلِ","ٱلَّذِي","يَنۡعِقُ","بِمَا","لَا","يَسۡمَعُ","إِلَّا","دُعَآءٗ","وَنِدَآءٗۚ","صُمُّۢ","بُكۡمٌ","عُمۡيٞ","فَهُمۡ","لَا","يَعۡقِلُونَ"],"вамасалул лазиина кафаруу камасалил лазии йан`иḳу бима ла йасма`у илла ду`аан ванидаан сумму букмун `умйун фахум ла йа`ḳилуун","Неверующие подобны скотине, на которую прикрикивает пастух, тогда как она не слышит ничего, кроме зова и крика. Они глухи, немы и слепы. Они ничего не разумеют.",["и пример","тех, которые","не уверовали","как пример","того, кто","кричит","на то, что","не","слышит","кроме","зова","и крика","глухи","немы","слепы","и они","не","разумеют"]],[2,172,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُواْ","كُلُواْ","مِن","طَيِّبَٰتِ","مَا","رَزَقۡنَٰكُمۡ","وَٱشۡكُرُواْ","لِلَّهِ","إِن","كُنتُمۡ","إِيَّاهُ","تَعۡبُدُونَ"],"йа'аййухал лазиина амануу кулуу мин таййибати ма разаḳнакум вашкуруу лиллахи ин кунтум иййаху та`будуун","О те, которые уверовали! Вкушайте дозволенные блага, которыми Мы наделили вас, и будьте благодарны Аллаху, если только вы поклоняетесь Ему.",["о","те, которые","уверовали","ешьте","из","благ","того, что","Мы даровали вам","и благодарите","Аллаха","если","вы","Ему одному","поклоняетесь"]],[2,173,["إِنَّمَا","حَرَّمَ","عَلَيۡكُمُ","ٱلۡمَيۡتَةَ","وَٱلدَّمَ","وَلَحۡمَ","ٱلۡخِنزِيرِ","وَمَآ","أُهِلَّ","بِهِۦ","لِغَيۡرِ","ٱللَّهِۖ","فَمَنِ","ٱضۡطُرَّ","غَيۡرَ","بَاغٖ","وَلَا","عَادٖ","فَلَآ","إِثۡمَ","عَلَيۡهِۚ","إِنَّ","ٱللَّهَ","غَفُورٞ","رَّحِيمٌ"],"иннама харрама `алайкумул майтата ваддама валахмал хинзиири вама ухилла бихии лигайриллахи фаманидтурра гайра багин вала `адин фала исма `алайхи инналлаха гафуурур рахиим","Он запретил вам мертвечину, кровь, мясо свиньи и то, что принесено в жертву не ради Аллаха. Если же кто-либо вынужден пойти на это, не домогаясь запретного, не проявляя ослушания и не преступая пределы необходимого, то нет на нем греха. Воистину, Аллах - Прощающий, Милосердный.",["лишь","Он запретил","вам","мертвечину","и кровь","и мясо","свиньи","и то, что","провозглашено","над ним","ради иного, чем","Аллаха","а кто","вынужден","не","домогаясь","и не","преступая","то нет","греха","на нём","поистине","Аллах","Прощающий","Милосердный"]],[2,174,["إِنَّ","ٱلَّذِينَ","يَكۡتُمُونَ","مَآ","أَنزَلَ","ٱللَّهُ","مِنَ","ٱلۡكِتَٰبِ","وَيَشۡتَرُونَ","بِهِۦ","ثَمَنٗا","قَلِيلًا","أُوْلَٰٓئِكَ","مَا","يَأۡكُلُونَ","فِي","بُطُونِهِمۡ","إِلَّا","ٱلنَّارَ","وَلَا","يُكَلِّمُهُمُ","ٱللَّهُ","يَوۡمَ","ٱلۡقِيَٰمَةِ","وَلَا","يُزَكِّيهِمۡ","وَلَهُمۡ","عَذَابٌ","أَلِيمٌ"],"иннал лазиина йактумууна ма анзалаллаху минал китаби вайаштарууна бихии саманан ḳалиилан улаика ма йа'кулууна фии бутуунихим иллан нара вала йукаллимухумуллаху йаумал ḳийамати вала йузаккиихим валахум `азабун алиим","Воистину, те, которые скрывают ниспосланное Аллахом в Писании и покупают за это малую цену, наполняют свои животы огнем. Аллах не станет говорить с ними в День воскресения и не очистит их. Им уготованы мучительные страдания.",["поистине","те, которые","скрывают","то, что","ниспослал","Аллах","из","Писания","и покупают","за это","цену","малую","те","не","едят","в","своих животах","кроме","огня","и не","заговорит с ними","Аллах","в день","воскресения","и не","очистит их","и им","наказание","мучительное"]],[2,175,["أُوْلَٰٓئِكَ","ٱلَّذِينَ","ٱشۡتَرَوُاْ","ٱلضَّلَٰلَةَ","بِٱلۡهُدَىٰ","وَٱلۡعَذَابَ","بِٱلۡمَغۡفِرَةِۚ","فَمَآ","أَصۡبَرَهُمۡ","عَلَى","ٱلنَّارِ"],"улаикал лазиинаштаравуд далалата билхуда вал`азаба билмагфирати фама асбарахум `алан нар","Они купили заблуждение за верное руководство и мучения - за прощение. Насколько же они готовы терпеть Огонь!",["те","те, которые","купили","заблуждение","за руководство","и наказание","за прощение","как же","терпеливы они","к","Огню"]],[2,176,["ذَٰلِكَ","بِأَنَّ","ٱللَّهَ","نَزَّلَ","ٱلۡكِتَٰبَ","بِٱلۡحَقِّۗ","وَإِنَّ","ٱلَّذِينَ","ٱخۡتَلَفُواْ","فِي","ٱلۡكِتَٰبِ","لَفِي","شِقَاقِۭ","بَعِيدٖ"],"залика би'анналлаха наззалал китаба билхаḳḳи ва'иннал лазиинахталафуу фил китаби лафии шиḳаḳи ба`иид","Это потому, что Аллах ниспослал Писание с истиной. А те, которые спорят относительно Писания, находятся в полном разладе с истиной.",["это","потому что","Аллах","ниспослал","Писание","с истиной","и поистине","те, которые","разошлись","в","Писании","непременно в","расколе","далёком"]]],"m":[[["وَإِذَا","и когда",2,170],["قِيلَ","говорят",2,170],["لَهُمُ","им",2,170],["ٱتَّبِعُواْ","следуйте",2,170],["مَآ","тому, что",2,170],["أَنزَلَ","ниспослал",2,170],["ٱللَّهُ","Аллах",2,170],["قَالُواْ","говорят они",2,170],["بَلۡ","нет",2,170],["نَتَّبِعُ","мы следуем",2,170],["مَآ","то, что",2,170],["أَلۡفَيۡنَا","застали мы",2,170],["عَلَيۡهِ","на нём",2,170]],[["ءَابَآءَنَآۚ","наших отцов",2,170],["أَوَلَوۡ","разве даже если",2,170],["كَانَ","были",2,170],["ءَابَآؤُهُمۡ","их отцы",2,170],["لَا","не",2,170],["يَعۡقِلُونَ","разумеющими",2,170],["شَيۡـٔٗا","ничего",2,170],["وَلَا","и не",2,170]],[["يَهۡتَدُونَ","шли прямым путём",2,170],[170],["وَمَثَلُ","и пример",2,171],["ٱلَّذِينَ","тех, которые",2,171],["كَفَرُواْ","не уверовали",2,171],["كَمَثَلِ","как пример",2,171],["ٱلَّذِي","того, кто",2,171],["يَنۡعِقُ","кричит",2,171]],[["بِمَا","на 