{"p":28,"j":2,"a":[[2,182,["فَمَنۡ","خَافَ","مِن","مُّوصٖ","جَنَفًا","أَوۡ","إِثۡمٗا","فَأَصۡلَحَ","بَيۡنَهُمۡ","فَلَآ","إِثۡمَ","عَلَيۡهِۚ","إِنَّ","ٱللَّهَ","غَفُورٞ","رَّحِيمٞ"],"фаман хафа мим муусин жанафан ау исман фа'аслаха байнахум фала исма `алайхи инналлаха гафуурур рахиим","Если же кто-либо опасается, что завещатель поступит несправедливо или совершит грех, и установит мир между сторонами, то на нем не будет греха. Воистину, Аллах - Прощающий, Милосердный.",["а кто","опасался","от","завещателя","несправедливости","или","греха","и уладил","между ними","то нет","греха","на нём","поистине","Аллах","Прощающий","Милосердный"]],[2,183,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُواْ","كُتِبَ","عَلَيۡكُمُ","ٱلصِّيَامُ","كَمَا","كُتِبَ","عَلَى","ٱلَّذِينَ","مِن","قَبۡلِكُمۡ","لَعَلَّكُمۡ","تَتَّقُونَ"],"йа'аййухал лазиина амануу кутиба `алайкумус сийаму кама кутиба `алал лазиина мин ḳабликум ла`аллакум таттаḳуун","О те, которые уверовали! Вам предписан пост, подобно тому, как он был предписан вашим предшественникам, - быть может, вы устрашитесь.",["О вы","те, которые","уверовали","предписан","вам","пост","как","был предписан","на","тех, кто","из","до вас","чтобы вы","были богобоязненны"]],[2,184,["أَيَّامٗا","مَّعۡدُودَٰتٖۚ","فَمَن","كَانَ","مِنكُم","مَّرِيضًا","أَوۡ","عَلَىٰ","سَفَرٖ","فَعِدَّةٞ","مِّنۡ","أَيَّامٍ","أُخَرَۚ","وَعَلَى","ٱلَّذِينَ","يُطِيقُونَهُۥ","فِدۡيَةٞ","طَعَامُ","مِسۡكِينٖۖ","فَمَن","تَطَوَّعَ","خَيۡرٗا","فَهُوَ","خَيۡرٞ","لَّهُۥۚ","وَأَن","تَصُومُواْ","خَيۡرٞ","لَّكُمۡ","إِن","كُنتُمۡ","تَعۡلَمُونَ"],"аййамам ма`дуудатин фаман кана минкум мариидан ау `ала сафарин фа`иддатум мин аййамин ухара ва`алал лазиина йутииḳуунахуу фидйатун та`аму мискиинин фаман татавва`а хайран фахуа хайрул лахуу ва'ан тасуумуу хайрул лакум ин кунтум та`ламуун","Поститься следует считанное количество дней. А если кто из вас болен или находится в пути, то пусть постится столько же дней в другое время. А тем, которые способны поститься с трудом, следует в искупление накормить бедняка. А если кто добровольно совершает доброе дело, то тем лучше для него. Но вам лучше поститься, если бы вы только знали!",["дни","считанные","и кто","будет","из вас","больным","или","в","пути","то число","из","дней","других","и на","тех, которые","в силах (поститься)","выкуп","кормление","бедняка","и кто","добровольно сделает","добро","то это","лучше","для него","и (то, что)","вы поститесь","лучше","для вас","если","вы","знаете"]],[2,185,["شَهۡرُ","رَمَضَانَ","ٱلَّذِيٓ","أُنزِلَ","فِيهِ","ٱلۡقُرۡءَانُ","هُدٗى","لِّلنَّاسِ","وَبَيِّنَٰتٖ","مِّنَ","ٱلۡهُدَىٰ","وَٱلۡفُرۡقَانِۚ","فَمَن","شَهِدَ","مِنكُمُ","ٱلشَّهۡرَ","فَلۡيَصُمۡهُۖ","وَمَن","كَانَ","مَرِيضًا","أَوۡ","عَلَىٰ","سَفَرٖ","فَعِدَّةٞ","مِّنۡ","أَيَّامٍ","أُخَرَۗ","يُرِيدُ","ٱللَّهُ","بِكُمُ","ٱلۡيُسۡرَ","وَلَا","يُرِيدُ","بِكُمُ","ٱلۡعُسۡرَ","وَلِتُكۡمِلُواْ","ٱلۡعِدَّةَ","وَلِتُكَبِّرُواْ","ٱللَّهَ","عَلَىٰ","مَا","هَدَىٰكُمۡ","وَلَعَلَّكُمۡ","تَشۡكُرُونَ"],"шахру рамаданал лазии унзила фиихил ḳур'ану худал линнаси вабаййинатим минал худа валфурḳани фаман шахида минкумуш шахра фалйасумху ваман кана мариидан ау `ала сафарин фа`иддатум мин аййамин ухара йуриидуллаху бикумул йусра вала йурииду бикумул `усра валитукмилул `иддата валитукаббируллаха `ала ма хадакум вала`аллакум ташкуруун","В месяц рамадан был ниспослан Коран - верное руководство для людей, ясные доказательства из верного руководства и различение. Тот из вас, кого застанет этот месяц, должен поститься. А если кто болен или находится в пути, то пусть постится столько же дней в другое время. Аллах желает вам облегчения и не желает вам затруднения. Он желает, чтобы вы довели до конца определенное число дней и возвеличили Аллаха за то, что Он наставил вас на прямой путь. Быть может, вы будете благодарны.",["месяц","рамадан","в который","был ниспослан","в нём","Коран","руководство","для людей","и ясные доказательства","из","руководства","и различения","и кто","застанет","из вас","месяц","пусть постится в нём","и кто","будет","больным","или","в","пути","то число","из","дней","других","желает","Аллах","вам","облегчения","и не","желает","вам","тягости","и чтобы вы завершили","число","и чтобы возвеличили","Аллаха","за","то, что","Он наставил вас","и чтобы вы","благодарили"]],[2,186,["وَإِذَا","سَأَلَكَ","عِبَادِي","عَنِّي","فَإِنِّي","قَرِيبٌۖ","أُجِيبُ","دَعۡوَةَ","ٱلدَّاعِ","إِذَا","دَعَانِۖ","فَلۡيَسۡتَجِيبُواْ","لِي","وَلۡيُؤۡمِنُواْ","بِي","لَعَلَّهُمۡ","يَرۡشُدُونَ"],"ва'иза са'алака `ибадии `аннии фа'иннии ḳариибун ужиибу да`ватад да`и иза да`ани фалйастажиибуу лии валйу'минуу бии ла`аллахум йаршудуун","Если Мои рабы спросят тебя обо Мне, то ведь Я близок и отвечаю на зов молящегося, когда он взывает ко Мне. Пусть же они отвечают Мне и веруют в Меня, - быть может, они последуют верным путем.",["и когда","спросят тебя","рабы Мои","обо Мне","то ведь Я","близок","отвечаю","на мольбу","молящегося","когда","он взывает ко Мне","пусть же отвечают","Мне","и пусть веруют","в Меня","чтобы они","шли верным путём"]]],"m":[[["فَمَنۡ","а кто",2,182],["خَافَ","опасался",2,182],["مِن","от",2,182],["مُّوصٖ","завещателя",2,182],["جَنَفًا","несправедливости",2,182],["أَوۡ","или",2,182],["إِثۡمٗا","греха",2,182],["فَأَصۡلَحَ","и уладил",2,182],["بَيۡنَهُمۡ","между ними",2,182],["فَلَآ","то нет",2,182],["إِثۡمَ","греха",2,182]],[["عَلَيۡهِۚ","на нём",2,182],["إِنَّ","поистине",2,182],["ٱللَّهَ","Аллах",2,182],["غَفُورٞ","Прощающий",2,182],["رَّحِيمٞ","Милосердный",2,182],[182],["يَٰٓأَيُّهَا","О вы",2,183],["ٱلَّذِينَ","те, которые",2,183],["ءَامَنُواْ","уверовали",2,183],["كُتِبَ","предписан",2,183]],[["عَلَيۡكُمُ","вам",2,183],["ٱلصِّيَامُ","пост",2,183],["كَمَا","как",2,183],["كُتِبَ","был предписан",2,183],["عَلَى","на",2,183],["ٱلَّذِينَ","тех, кто",2,183],["مِن","из",2,183],["قَبۡلِكُمۡ","до вас",2,183]],[["لَعَلَّكُمۡ","чтобы вы",2,183],["تَتَّقُونَ","были богобоязненны",2,183],[183],["أَيَّامٗا","дни",2,184],["مَّعۡدُودَٰتٖۚ","считанные",2,184],["فَمَن","и кто",2,184],["كَانَ","будет",2,184],["مِنكُم","из вас",2,184