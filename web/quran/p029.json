{"p":29,"j":2,"a":[[2,187,["أُحِلَّ","لَكُمۡ","لَيۡلَةَ","ٱلصِّيَامِ","ٱلرَّفَثُ","إِلَىٰ","نِسَآئِكُمۡۚ","هُنَّ","لِبَاسٞ","لَّكُمۡ","وَأَنتُمۡ","لِبَاسٞ","لَّهُنَّۗ","عَلِمَ","ٱللَّهُ","أَنَّكُمۡ","كُنتُمۡ","تَخۡتَانُونَ","أَنفُسَكُمۡ","فَتَابَ","عَلَيۡكُمۡ","وَعَفَا","عَنكُمۡۖ","فَٱلۡـَٰٔنَ","بَٰشِرُوهُنَّ","وَٱبۡتَغُواْ","مَا","كَتَبَ","ٱللَّهُ","لَكُمۡۚ","وَكُلُواْ","وَٱشۡرَبُواْ","حَتَّىٰ","يَتَبَيَّنَ","لَكُمُ","ٱلۡخَيۡطُ","ٱلۡأَبۡيَضُ","مِنَ","ٱلۡخَيۡطِ","ٱلۡأَسۡوَدِ","مِنَ","ٱلۡفَجۡرِۖ","ثُمَّ","أَتِمُّواْ","ٱلصِّيَامَ","إِلَى","ٱلَّيۡلِۚ","وَلَا","تُبَٰشِرُوهُنَّ","وَأَنتُمۡ","عَٰكِفُونَ","فِي","ٱلۡمَسَٰجِدِۗ","تِلۡكَ","حُدُودُ","ٱللَّهِ","فَلَا","تَقۡرَبُوهَاۗ","كَذَٰلِكَ","يُبَيِّنُ","ٱللَّهُ","ءَايَٰتِهِۦ","لِلنَّاسِ","لَعَلَّهُمۡ","يَتَّقُونَ"],"ухилла лакум лайлатас сийамир рафасу ила нисаикум хунна либасул лакум ва'антум либасул лахунна `алималлаху аннакум кунтум тахтанууна анфусакум фатаба `алайкум ва`афа `анкум фал'ана башируухунна вабтагуу ма катабаллаху лакум вакулуу вашрабуу хатта йатабаййана лакумул хайтул абйаду минал хайтил асвади минал фажри сумма атиммус сийама илал лайли вала тубашируухунна ва'антум `акифууна фил масажиди тилка худуудуллахи фала таḳрабууха казалика йубаййинуллаху айатихии линнаси ла`аллахум йаттаḳуун","Вам дозволено вступать в близость с вашими женами в ночь поста. Ваши жены - одеяние для вас, а вы - одеяние для них. Аллах знает, что вы предаете самих себя (ослушаетесь Аллаха и вступаете в половую близость с женами по ночам во время поста в рамадане), и поэтому Он принял ваши покаяния и простил вас. Отныне вступайте с ними в близость и стремитесь к тому, что предписал вам Аллах. Ешьте и пейте, пока вы не сможете отличить белую нитку рассвета от черной, а затем поститесь до ночи. Не вступайте с ними в близость, когда вы пребываете в мечетях. Таковы ограничения Аллаха, не приближайтесь к ним. Так Аллах разъясняет Свои знамения людям, - быть может, они устрашатся.",["дозволена","вам","в ночь","поста","близость","с","жёнами вашими","они","одеяние","для вас","и вы","одеяние","для них","знает","Аллах","что вы","бывало","обманывали","самих себя","и Он принял покаяние","ваше","и простил","вас","и теперь","вступайте в близость с ними","и стремитесь","к тому, что","предписал","Аллах","вам","и ешьте","и пейте","пока","не станет отличима","вам","нить","белая","от","нити","чёрной","от","зари","затем","завершайте","пост","до","ночи","и не","вступайте в близость с ними","когда вы","пребываете","в","мечетях","это","границы","Аллаха","и не","приближайтесь к ним","так","разъясняет","Аллах","знамения Свои","людям","чтобы они","были богобоязненны"]],[2,188,["وَلَا","تَأۡكُلُوٓاْ","أَمۡوَٰلَكُم","بَيۡنَكُم","بِٱلۡبَٰطِلِ","وَتُدۡلُواْ","بِهَآ","إِلَى","ٱلۡحُكَّامِ","لِتَأۡكُلُواْ","فَرِيقٗا","مِّنۡ","أَمۡوَٰلِ","ٱلنَّاسِ","بِٱلۡإِثۡمِ","وَأَنتُمۡ","تَعۡلَمُونَ"],"вала та'кулуу амвалакум байнакум билбатили ватудлуу биха илал хукками лита'кулуу фарииḳам мин амвалин наси бил'исми ва'антум та`ламуун","Не пожирайте незаконно между собой своего имущества и не подкупайте судей, чтобы пожирать часть имущества людей, сознательно совершая грех.",["и не","пожирайте","имущество ваше","между собой","неправедно","и (не) подносите","его","к","судьям","чтобы пожирать","часть","из","имущества","людей","греховно","и вы","знаете"]],[2,189,["يَسۡـَٔلُونَكَ","عَنِ","ٱلۡأَهِلَّةِۖ","قُلۡ","هِيَ","مَوَٰقِيتُ","لِلنَّاسِ","وَٱلۡحَجِّۗ","وَلَيۡسَ","ٱلۡبِرُّ","بِأَن","تَأۡتُواْ","ٱلۡبُيُوتَ","مِن","ظُهُورِهَا","وَلَٰكِنَّ","ٱلۡبِرَّ","مَنِ","ٱتَّقَىٰۗ","وَأۡتُواْ","ٱلۡبُيُوتَ","مِنۡ","أَبۡوَٰبِهَاۚ","وَٱتَّقُواْ","ٱللَّهَ","لَعَلَّكُمۡ","تُفۡلِحُونَ"],"йас'алуунака `анил ахиллати ḳул хийа маваḳииту линнаси валхажжи валайсал бирру би'ан та'тул буйуута мин зухууриха валакиннал бирра маниттаḳа ва'тул буйуута мин абвабиха ваттаḳуллаха ла`аллакум туфлихуун","Они спрашивают тебя о новолуниях. Скажи: «Они определяют промежутки времени для людей и хаджа. Благочестие не в том, чтобы вы входили в дома с их задней стороны. Но благочестив тот, кто богобоязнен. Входите в дома через двери и бойтесь Аллаха, - быть может, вы окажетесь преуспевшими.",["они спрашивают тебя","о","новолуниях","скажи","они","сроки","для людей","и хаджа","и не","благочестие","в том, чтобы","вы входили","в дома","с","задней стороны их","но","благочестие","кто","был богобоязнен","и входите","в дома","через","двери их","и бойтесь","Аллаха","чтобы вы","преуспели"]],[2,190,["وَقَٰتِلُواْ","فِي","سَبِيلِ","ٱللَّهِ","ٱلَّذِينَ","يُقَٰتِلُونَكُمۡ","وَلَا","تَعۡتَدُوٓاْۚ","إِنَّ","ٱللَّهَ","لَا","يُحِبُّ","ٱلۡمُعۡتَدِينَ"],"ваḳатилуу фии сабиилиллахил лазиина йуḳатилуунакум вала та`тадуу инналлаха ла йухиббул му`тадиин","Сражайтесь на пути Аллаха с теми, кто сражается против вас, но не преступайте границы дозволенного. Воистину, Аллах не любит преступников.",["и сражайтесь","на","пути","Аллаха","с теми, которые","сражаются с вами","и не","преступайте","поистине","Аллах","не","любит","преступающих"]]],"m":[[["أُحِلَّ","дозволена",2,187],["لَكُمۡ","вам",2,187],["لَيۡلَةَ","в ночь",2,187],["ٱلصِّيَامِ","поста",2,187],["ٱلرَّفَثُ","близость",2,187],["إِلَىٰ","с",2,187],["نِسَآئِكُمۡۚ","жёнами вашими",2,187],["هُنَّ","они",2,187],["لِبَاسٞ","одеяние",2,187]],[["لَّكُمۡ","для вас",2,187],["وَأَنتُمۡ","и вы",2,187],["لِبَاسٞ","одеяние",2,187],["لَّهُنَّۗ","для них",2,187],["عَلِمَ","знает",2,187],["ٱللَّهُ","Аллах",2,187],["أَنَّكُمۡ","что вы",2,187],["كُنتُمۡ","бывало",2,187],["تَخۡتَانُونَ","обманывали",2,187]],[["أَنفُسَكُمۡ","самих себя",2,187],["فَتَابَ","и Он принял покаяние",2,187],["عَلَيۡكُمۡ","ваше",2,187],["وَعَفَا","и простил",2,187],["عَنكُمۡۖ","вас",2,187],["فَٱلۡـَٰٔنَ","и теперь",2,187],["بَٰشِرُوهُنَّ","вступайте в близость с ними",2,187]],[["وَٱبۡتَغُواْ","и стремитесь",2,187],["مَا","к тому, что",2,187],["كَتَبَ","предписал",2,187],["ٱللَّهُ","Аллах",2,187],["لَكُمۡۚ","вам",2,187],["وَكُلُواْ","и ешьте",2,187],["وَٱشۡرَبُواْ","и пейте",2,187],["حَتَّىٰ","пока",2,187],["يَتَبَيَّنَ","не станет отличима",2,187],["لَكُمُ","ва