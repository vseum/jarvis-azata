{"p":32,"j":2,"a":[[2,203,["وَٱذۡكُرُواْ","ٱللَّهَ","فِيٓ","أَيَّامٖ","مَّعۡدُودَٰتٖۚ","فَمَن","تَعَجَّلَ","فِي","يَوۡمَيۡنِ","فَلَآ","إِثۡمَ","عَلَيۡهِ","وَمَن","تَأَخَّرَ","فَلَآ","إِثۡمَ","عَلَيۡهِۖ","لِمَنِ","ٱتَّقَىٰۗ","وَٱتَّقُواْ","ٱللَّهَ","وَٱعۡلَمُوٓاْ","أَنَّكُمۡ","إِلَيۡهِ","تُحۡشَرُونَ"],"вазкуруллаха фии аййамим ма`дуудатин фаман та`ажжала фии йаумайни фала исма `алайхи ваман та'аххара фала исма `алайхи лиманиттаḳа ваттаḳуллаха ва`ламуу аннакум илайхи тухшаруун","Поминайте Аллаха в считанные дни (в течение трех дней в долине Мина). Кто торопится и завершает обряд за два дня, тот не совершает греха. И кто задерживается, тот также не совершает греха. Это касается богобоязненных. Бойтесь же Аллаха и знайте, что к Нему вы будете собраны.",["и поминайте","Аллаха","в","дни","считанные","и кто","поспешит","за","два дня","то нет","греха","на нём","и кто","задержится","то нет","греха","на нём","для того, кто","был богобоязнен","и бойтесь","Аллаха","и знайте","что вы","к Нему","будете собраны"]],[2,204,["وَمِنَ","ٱلنَّاسِ","مَن","يُعۡجِبُكَ","قَوۡلُهُۥ","فِي","ٱلۡحَيَوٰةِ","ٱلدُّنۡيَا","وَيُشۡهِدُ","ٱللَّهَ","عَلَىٰ","مَا","فِي","قَلۡبِهِۦ","وَهُوَ","أَلَدُّ","ٱلۡخِصَامِ"],"ваминан наси ман йу`жибука ḳаулухуу фил хайаватид дунйа вайушхидуллаха `ала ма фии ḳалбихии вахуа аладдул хисам","Среди людей есть такой, чьи речи восхищают тебя в мирской жизни. Он призывает Аллаха засвидетельствовать то, что у него в душе, хотя сам является непримиримым спорщиком.",["и из","людей","(есть) тот, кто","восхищает тебя","речь его","о","жизни","мирской","и призывает в свидетели","Аллаха","в","том, что","в","сердце его","а он","злейший","из спорщиков"]],[2,205,["وَإِذَا","تَوَلَّىٰ","سَعَىٰ","فِي","ٱلۡأَرۡضِ","لِيُفۡسِدَ","فِيهَا","وَيُهۡلِكَ","ٱلۡحَرۡثَ","وَٱلنَّسۡلَۚ","وَٱللَّهُ","لَا","يُحِبُّ","ٱلۡفَسَادَ"],"ва'иза тавалла са`а фил арди лийуфсида фииха вайухликал харса ваннасла валлаху ла йухиббул фасад","Когда он уходит, то начинает распространять нечестие на земле, уничтожать посевы и губить потомство. Но ведь Аллах не любит нечестия.",["и когда","он уходит","старается","на","земле","чтобы творить нечестие","на ней","и губить","посевы","и потомство","а Аллах","не","любит","нечестия"]],[2,206,["وَإِذَا","قِيلَ","لَهُ","ٱتَّقِ","ٱللَّهَ","أَخَذَتۡهُ","ٱلۡعِزَّةُ","بِٱلۡإِثۡمِۚ","فَحَسۡبُهُۥ","جَهَنَّمُۖ","وَلَبِئۡسَ","ٱلۡمِهَادُ"],"ва'иза ḳиила лахуттаḳиллаха ахазатхул `иззату бил'исми фахасбухуу жаханнаму валаби'сал михад","Когда ему говорят: «Побойся Аллаха!», гордыня подталкивает его на грех. Довольно c него Геенны! Как же скверно это ложе!",["и когда","говорят","ему","побойся","Аллаха","охватывает его","гордыня","к греху","то довольно с него","Геенны","и скверно же","ложе"]],[2,207,["وَمِنَ","ٱلنَّاسِ","مَن","يَشۡرِي","نَفۡسَهُ","ٱبۡتِغَآءَ","مَرۡضَاتِ","ٱللَّهِۚ","وَٱللَّهُ","رَءُوفُۢ","بِٱلۡعِبَادِ"],"ваминан наси ман йашрии нафсахубтигаа мардатиллахи валлаху ра'ууфу бил`ибад","Среди людей есть и такой, который продает свою душу, надеясь снискать довольство Аллаха, и Аллах сострадателен к рабам.",["и из","людей","(есть) тот, кто","продаёт","себя","ища","довольства","Аллаха","а Аллах","сострадателен","к рабам"]],[2,208,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُواْ","ٱدۡخُلُواْ","فِي","ٱلسِّلۡمِ","كَآفَّةٗ","وَلَا","تَتَّبِعُواْ","خُطُوَٰتِ","ٱلشَّيۡطَٰنِۚ","إِنَّهُۥ","لَكُمۡ","عَدُوّٞ","مُّبِينٞ"],"йа'аййухал лазиина аманудхулуу фис силми каффатан вала таттаби`уу хутуатиш шайтани иннахуу лакум `адуввум мубиин","О те, которые уверовали! Принимайте ислам целиком и не следуйте по стопам дьявола. Воистину, он для вас - явный враг.",["О вы","те, которые","уверовали","входите","в","ислам","целиком","и не","следуйте","по стопам","шайтана","поистине, он","для вас","враг","явный"]],[2,209,["فَإِن","زَلَلۡتُم","مِّنۢ","بَعۡدِ","مَا","جَآءَتۡكُمُ","ٱلۡبَيِّنَٰتُ","فَٱعۡلَمُوٓاْ","أَنَّ","ٱللَّهَ","عَزِيزٌ","حَكِيمٌ"],"фа'ин залалтум мим ба`ди ма жааткумул баййинату фа`ламуу анналлаха `азиизун хакиим","А если вы споткнетесь после того, как к вам явились ясные знамения, то знайте, что Аллах - Могущественный, Мудрый.",["а если","вы оступитесь","после","того","как","пришли к вам","ясные знамения","то знайте","что","Аллах","Могущественный","Мудрый"]],[2,210,["هَلۡ","يَنظُرُونَ","إِلَّآ","أَن","يَأۡتِيَهُمُ","ٱللَّهُ","فِي","ظُلَلٖ","مِّنَ","ٱلۡغَمَامِ","وَٱلۡمَلَٰٓئِكَةُ","وَقُضِيَ","ٱلۡأَمۡرُۚ","وَإِلَى","ٱللَّهِ","تُرۡجَعُ","ٱلۡأُمُورُ"],"хал йанзурууна илла ан йа'тийахумуллаху фии зулалим минал гамами валмалаикату ваḳудийал амру ва'илаллахи туржа`ул умуур","Неужели они ожидают чего-либо иного, кроме как того, что Аллах явится к ним вместе с ангелами, осененный облаками, и все будет решено? К Аллаху возвращаются дела.",["разве","ждут они","чего-либо, кроме","того, что","придёт к ним","Аллах","в","сени","из","облаков","и ангелы","и будет решено","дело","и к","Аллаху","возвращаются","дела"]]],"m":[[["۞ وَٱذۡكُرُواْ","и поминайте",2,203],["ٱللَّهَ","Аллаха",2,203],["فِيٓ","в",2,203],["أَيَّامٖ","дни",2,203],["مَّعۡدُودَٰتٖۚ","считанные",2,203],["فَمَن","и кто",2,203],["تَعَجَّلَ","поспешит",2,203],["فِي","за",2,203]],[["يَوۡمَيۡنِ","два дня",2,203],["فَلَآ","то нет",2,203],["إِثۡمَ","греха",2,203],["عَلَيۡهِ","на нём",2,203],["وَمَن","и кто",2,203],["تَأَخَّرَ","задержится",2,203],["فَلَآ","то нет",2,203],["إِثۡمَ","греха",2,203],["عَلَيۡهِۖ","на нём",2,203],["لِمَنِ","для того, кто",2,203],["ٱتَّقَىٰۗ","был богобоязнен",2,203]],[["وَٱتَّقُواْ","и бойтесь",2,203],["ٱللَّهَ","Аллаха",2,203],["وَٱعۡلَمُوٓاْ","и знайте",2,203],["أَنَّكُمۡ","что вы",2,203],["إِلَيۡهِ","к Нему",2,203],["تُحۡشَرُونَ","будете собраны",2,203],[203],["وَمِنَ","и из",2,204]],[["ٱلنَّاسِ","людей",2,204],["مَن","(есть) тот, кто",2,204],["يُعۡجِبُكَ","восхищает тебя",2,204],["قَوۡلُهُۥ","речь его",2,204],["فِي","о",2,204],["ٱلۡحَيَوٰةِ","жизни",2,204],["ٱلدُّنۡيَا","мирской",2,204],["وَيُشۡهِدُ","и призывает в свидетели",2,204],["ٱللَّهَ","Аллаха",2,204]],[["عَلَىٰ","в",2,204],["مَا","том, что",2,204],["فِي","в",2,204],["قَلۡبِهِۦ","сердце его",2,204],["وَهُوَ","а он",2,204],["أَلَدُّ","злейший",2,204],["ٱلۡخِصَامِ","из спорщиков",2,204],[204],["وَإِذَا","и когда",2,205],["تَوَلَّىٰ","он уходит",2,205],["سَعَىٰ","старается",2,205]],[["فِي","на",2,205],["ٱلۡأَرۡضِ","земле",2,205],["لِيُفۡسِدَ","чтобы творить нечестие",2,205],["فِيهَا","на ней",2,205],["وَيُهۡلِكَ","и губить",2,205],["ٱلۡحَرۡثَ","посевы",2,205],["وَٱلنَّسۡلَۚ","и потомство",2,205],["وَٱللَّهُ","а Аллах",2,205]],[["لَا","не",2,205],["يُحِبُّ","любит",2,205],["ٱلۡفَسَادَ","нечестия",2,205],[205],["وَإِذَا","и когда",2,206],["قِيلَ","говорят",2,206],["لَهُ","ему",2,206],["ٱتَّقِ","побойся",2,206],["ٱللَّهَ","Аллаха",2,206],["أَخَذَتۡهُ","охватывает его",2,206],["ٱلۡعِزَّةُ","гордыня",2,206]],[["بِٱلۡإِثۡمِۚ","к греху",2,206],["فَحَسۡبُهُۥ","то довольно с него",2,206],["جَهَنَّمُۖ","Геенны",2,206],["وَلَبِئۡسَ","и скверно же",2,206],["ٱلۡمِهَادُ","ложе",2,206],[206],["وَمِنَ","и из",2,207]],[["ٱلنَّاسِ","людей",2,207],["مَن","(есть) тот, кто",2,207],["يَشۡرِي","продаёт",2,207],["نَفۡسَهُ","себя",2,207],["ٱبۡتِغَآءَ","ища",2,207],["مَرۡضَاتِ","довольства",2,207],["ٱللَّهِۚ","Аллаха",2,207],["وَٱللَّهُ","а Аллах",2,207]],[["رَءُوفُۢ","сострадателен",2,207],["بِٱلۡعِبَادِ","к рабам",2,207],[207],["يَٰٓأَيُّهَا","О вы",2,208],["ٱلَّذِينَ","те, которые",2,208],["ءَامَنُواْ","уверовали",2,208],["ٱدۡخُلُواْ","входите",2,208]],[["فِي","в",2,208],["ٱلسِّلۡمِ","ислам",2,208],["كَآفَّةٗ","целиком",2,208],["وَلَا","и не",2,208],["تَتَّبِعُواْ","следуйте",2,208],["خُطُوَٰتِ","по стопам",2,208],["ٱلشَّيۡطَٰنِۚ","шайтана",2,208]],[["إِنَّهُۥ","поистине, он",2,208],["لَكُمۡ","для вас",2,208],["عَدُوّٞ","враг",2,208],["مُّبِينٞ","явный",2,208],[208],["فَإِن","а если",2,209],["زَلَلۡتُم","вы оступитесь",2,209],["مِّنۢ","после",2,209],["بَعۡدِ","того",2,209]],[["مَا","как",2,209],["جَآءَتۡكُمُ","пришли к вам",2,209],["ٱلۡبَيِّنَٰتُ","ясные знамения",2,209],["فَٱعۡلَمُوٓاْ","то знайте",2,209],["أَنَّ","что",2,209],["ٱللَّهَ","Аллах",2,209],["عَزِيزٌ","Мо