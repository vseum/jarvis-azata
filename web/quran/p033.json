{"p":33,"j":2,"a":[[2,211,["سَلۡ","بَنِيٓ","إِسۡرَٰٓءِيلَ","كَمۡ","ءَاتَيۡنَٰهُم","مِّنۡ","ءَايَةِۭ","بَيِّنَةٖۗ","وَمَن","يُبَدِّلۡ","نِعۡمَةَ","ٱللَّهِ","مِنۢ","بَعۡدِ","مَا","جَآءَتۡهُ","فَإِنَّ","ٱللَّهَ","شَدِيدُ","ٱلۡعِقَابِ"],"сал бании исраиила кам атайнахум мин айати баййинатин ваман йубаддил ни`маталлахи мим ба`ди ма жаатху фа'инналлаха шадиидул `иḳаб","Спроси сынов Исраила (Израиля), сколько ясных знамений Мы ниспослали им. Если кто променяет милость Аллаха после того, как она явилась к нему, то ведь Аллах суров в наказании.",["спроси","сынов","Исраила","сколько","Мы дали им","из","знамений","ясных","и кто","заменит","милость","Аллаха","после","того","как","пришла она к нему","то поистине","Аллах","суров","в наказании"]],[2,212,["زُيِّنَ","لِلَّذِينَ","كَفَرُواْ","ٱلۡحَيَوٰةُ","ٱلدُّنۡيَا","وَيَسۡخَرُونَ","مِنَ","ٱلَّذِينَ","ءَامَنُواْۘ","وَٱلَّذِينَ","ٱتَّقَوۡاْ","فَوۡقَهُمۡ","يَوۡمَ","ٱلۡقِيَٰمَةِۗ","وَٱللَّهُ","يَرۡزُقُ","مَن","يَشَآءُ","بِغَيۡرِ","حِسَابٖ"],"зуййина лиллазиина кафарул хайаватуд дунйа вайасхарууна минал лазиина амануу валлазиинаттаḳау фауḳахум йаумал ḳийамати валлаху йарзуḳу ман йашау бигайри хисаб","Мирская жизнь кажется неверующим прекрасной. Они глумятся над теми, кто уверовал. Но в День воскресения богобоязненные окажутся выше них. Аллах дарует удел без расчета, кому пожелает.",["разукрашена","для тех, которые","не уверовали","жизнь","мирская","и они насмехаются","над","теми, которые","уверовали","а те, которые","были богобоязненны","выше их","в день","воскресения","и Аллах","наделяет","кого","пожелает","без","счёта"]],[2,213,["كَانَ","ٱلنَّاسُ","أُمَّةٗ","وَٰحِدَةٗ","فَبَعَثَ","ٱللَّهُ","ٱلنَّبِيِّـۧنَ","مُبَشِّرِينَ","وَمُنذِرِينَ","وَأَنزَلَ","مَعَهُمُ","ٱلۡكِتَٰبَ","بِٱلۡحَقِّ","لِيَحۡكُمَ","بَيۡنَ","ٱلنَّاسِ","فِيمَا","ٱخۡتَلَفُواْ","فِيهِۚ","وَمَا","ٱخۡتَلَفَ","فِيهِ","إِلَّا","ٱلَّذِينَ","أُوتُوهُ","مِنۢ","بَعۡدِ","مَا","جَآءَتۡهُمُ","ٱلۡبَيِّنَٰتُ","بَغۡيَۢا","بَيۡنَهُمۡۖ","فَهَدَى","ٱللَّهُ","ٱلَّذِينَ","ءَامَنُواْ","لِمَا","ٱخۡتَلَفُواْ","فِيهِ","مِنَ","ٱلۡحَقِّ","بِإِذۡنِهِۦۗ","وَٱللَّهُ","يَهۡدِي","مَن","يَشَآءُ","إِلَىٰ","صِرَٰطٖ","مُّسۡتَقِيمٍ"],"канан насу умматан вахидатан фаба`асаллахун набиййиина мубашшириина вамунзириина ва'анзала ма`ахумул китаба билхаḳḳи лийахкума байнан наси фиимахталафуу фиихи вамахталафа фиихи иллал лазиина уутууху мим ба`ди ма жаатхумул баййинату багйа байнахум фахадаллахул лазиина амануу лимахталафуу фиихи минал хаḳḳи би'изнихии валлаху йахдии ман йашау ила сиратим мустаḳиим","Люди были одной общиной, и Аллах отправил пророков добрыми вестниками и предостерегающими увещевателями, ниспослал вместе с ними Писание с истиной, чтобы рассудить людей в том, в чем они разошлись во мнениях. Но разошлись во мнениях относительно этого только те, кому было даровано Писание, после того, как к ним явились ясные знамения, по причине зависти и несправедливого отношения друг к другу. Аллах по Своей воле направил тех, которые уверовали, к истине, относительно которой они разошлись во мнениях. Аллах наставляет на прямой путь, кого пожелает.",["были","люди","общиной","единой","и послал","Аллах","пророков","радующими вестью","и предостерегающими","и ниспослал","с ними","Писание","с истиной","чтобы судило","между","людьми","в том, в чём","они разошлись","о нём","и не","разошлись","в нём","кроме","тех, которым","было даровано оно","после","того","как","пришли к ним","ясные знамения","из зависти","между собой","и наставил","Аллах","тех, которые","уверовали","к тому, в чём","разошлись","о нём","из","истины","с дозволения Своего","и Аллах","наставляет","кого","пожелает","к","пути","прямому"]],[2,214,["أَمۡ","حَسِبۡتُمۡ","أَن","تَدۡخُلُواْ","ٱلۡجَنَّةَ","وَلَمَّا","يَأۡتِكُم","مَّثَلُ","ٱلَّذِينَ","خَلَوۡاْ","مِن","قَبۡلِكُمۖ","مَّسَّتۡهُمُ","ٱلۡبَأۡسَآءُ","وَٱلضَّرَّآءُ","وَزُلۡزِلُواْ","حَتَّىٰ","يَقُولَ","ٱلرَّسُولُ","وَٱلَّذِينَ","ءَامَنُواْ","مَعَهُۥ","مَتَىٰ","نَصۡرُ","ٱللَّهِۗ","أَلَآ","إِنَّ","نَصۡرَ","ٱللَّهِ","قَرِيبٞ"],"ам хасибтум ан тадхулул жанната валамма йа'тикум масалул лазиина халау мин ḳабликум массатхумул ба'сау ваддаррау вазулзилуу хатта йаḳуулар расуулу валлазиина амануу ма`ахуу мата насруллахи ала инна насраллахи ḳарииб","Или вы полагали, что войдете в Рай, не испытав того, что постигло ваших предшественников? Их поражали нищета и болезни. Они переживали такие потрясения, что Посланник и уверовавшие вместе с ним говорили: «Когда же придет помощь Аллаха?». Воистину, помощь Аллаха близка.",["или","думали вы","что","войдёте","в Рай","а ещё не","пришло к вам","подобное","тем, которые","прошли","из","до вас","постигли их","нужда","и беды","и они были потрясены","так что","говорил","Посланник","и те, которые","уверовали","с ним","когда же","помощь","Аллаха","о да","поистине","помощь","Аллаха","близка"]],[2,215,["يَسۡـَٔلُونَكَ","مَاذَا","يُنفِقُونَۖ","قُلۡ","مَآ","أَنفَقۡتُم","مِّنۡ","خَيۡرٖ","فَلِلۡوَٰلِدَيۡنِ","وَٱلۡأَقۡرَبِينَ","وَٱلۡيَتَٰمَىٰ","وَٱلۡمَسَٰكِينِ","وَٱبۡنِ","ٱلسَّبِيلِۗ","وَمَا","تَفۡعَلُواْ","مِنۡ","خَيۡرٖ","فَإِنَّ","ٱللَّهَ","بِهِۦ","عَلِيمٞ"],"йас'алуунака маза йунфиḳууна ḳул ма анфаḳтум мин хайрин фалилвалидайни вал'аḳрабиина валйатама валмасакиини вабнис сабиили вама таф`алуу мин хайрин фа'инналлаха бихии `алиим","Они спрашивают тебя, что они должны расходовать. Скажи: «Любое добро, которое вы раздаете, должно достаться родителям, близким родственникам, сиротам, беднякам, путникам. Что бы вы ни сделали доброго, Аллах знает об этом».",["они спрашивают тебя","что","им расходовать","скажи","что","вы расходуете","из","блага","то родителям","и близким","и сиротам","и беднякам","и сыну","пути","и что бы","вы ни сделали","из","добра","то поистине","Аллах","о нём","Знающий"]]],"m":[[["سَلۡ","спроси",2,211],["بَنِيٓ","сынов",2,211],["إِسۡرَٰٓءِيلَ","Исраила",2,211],["كَمۡ","сколько",2,211],["ءَاتَيۡنَٰهُم","Мы дали им",2,211],["مِّنۡ","из",2,211],["ءَايَةِۭ","знамений",2,211],["بَيِّنَةٖۗ","ясных",2,211],["وَمَن","и кто",2,211],["يُبَدِّلۡ","заменит",2,211],["نِعۡمَةَ","милость",2,211]],[["ٱللَّهِ"