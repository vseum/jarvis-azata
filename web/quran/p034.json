{"p":34,"j":2,"a":[[2,216,["كُتِبَ","عَلَيۡكُمُ","ٱلۡقِتَالُ","وَهُوَ","كُرۡهٞ","لَّكُمۡۖ","وَعَسَىٰٓ","أَن","تَكۡرَهُواْ","شَيۡـٔٗا","وَهُوَ","خَيۡرٞ","لَّكُمۡۖ","وَعَسَىٰٓ","أَن","تُحِبُّواْ","شَيۡـٔٗا","وَهُوَ","شَرّٞ","لَّكُمۡۚ","وَٱللَّهُ","يَعۡلَمُ","وَأَنتُمۡ","لَا","تَعۡلَمُونَ"],"кутиба `алайкумул ḳиталу вахуа курхул лакум ва`аса ан такрахуу шай'ан вахуа хайрул лакум ва`аса ан тухиббуу шай'ан вахуа шаррул лакум валлаху йа`ламу ва'антум ла та`ламуун","Вам предписано сражаться, хотя это вам неприятно. Быть может, вам неприятно то, что является благом для вас. И быть может, вы любите то, что является злом для вас. Аллах знает, а вы не знаете.",["предписано","вам","сражение","а оно","неприятно","вам","и может быть","что","вам неприятно","что-либо","а оно","благо","для вас","и может быть","что","вы любите","что-либо","а оно","зло","для вас","и Аллах","знает","а вы","не","знаете"]],[2,217,["يَسۡـَٔلُونَكَ","عَنِ","ٱلشَّهۡرِ","ٱلۡحَرَامِ","قِتَالٖ","فِيهِۖ","قُلۡ","قِتَالٞ","فِيهِ","كَبِيرٞۚ","وَصَدٌّ","عَن","سَبِيلِ","ٱللَّهِ","وَكُفۡرُۢ","بِهِۦ","وَٱلۡمَسۡجِدِ","ٱلۡحَرَامِ","وَإِخۡرَاجُ","أَهۡلِهِۦ","مِنۡهُ","أَكۡبَرُ","عِندَ","ٱللَّهِۚ","وَٱلۡفِتۡنَةُ","أَكۡبَرُ","مِنَ","ٱلۡقَتۡلِۗ","وَلَا","يَزَالُونَ","يُقَٰتِلُونَكُمۡ","حَتَّىٰ","يَرُدُّوكُمۡ","عَن","دِينِكُمۡ","إِنِ","ٱسۡتَطَٰعُواْۚ","وَمَن","يَرۡتَدِدۡ","مِنكُمۡ","عَن","دِينِهِۦ","فَيَمُتۡ","وَهُوَ","كَافِرٞ","فَأُوْلَٰٓئِكَ","حَبِطَتۡ","أَعۡمَٰلُهُمۡ","فِي","ٱلدُّنۡيَا","وَٱلۡأٓخِرَةِۖ","وَأُوْلَٰٓئِكَ","أَصۡحَٰبُ","ٱلنَّارِۖ","هُمۡ","فِيهَا","خَٰلِدُونَ"],"йас'алуунака `аниш шахрил харами ḳиталин фиихи ḳул ḳиталун фиихи кабиирун васаддун `ан сабиилиллахи вакуфру бихии валмасжидил харами ва'ихражу ахлихии минху акбару `индаллахи валфитнату акбару минал ḳатли вала йазалууна йуḳатилуунакум хатта йаруддуукум `ан дииникум инистата`уу ваман йартадид минкум `ан диинихии файамут вахуа кафирун фа'улаика хабитат а`малухум фид дунйа вал'ахирати ва'улаика асхабун нари хум фииха халидуун","Они спрашивают тебя о сражении в запретный месяц. Скажи: «Сражаться в этот месяц - великое преступление. Однако сбивать других с пути Аллаха, не веровать в Него, не пускать в Заповедную мечеть и выгонять оттуда ее жителей - еще большее преступление перед Аллахом. Искушение хуже, чем убийство. Они не перестанут сражаться с вами, пока не отвратят вас от вашей религии, если только смогут. А если кто из вас отступит от своей религии и умрет неверующим, то его деяния окажутся тщетными как в этом мире, так и в Последней жизни. Они являются обитателями Огня и останутся там вечно».",["они спрашивают тебя","о","месяце","запретном","о сражении","в нём","скажи","сражение","в нём","великий (грех)","но отвращение","от","пути","Аллаха","и неверие","в Него","и (от) Мечети","Заповедной","и изгнание","жителей её","из неё","больше","перед","Аллахом","и смута","больше","чем","убийство","и не","перестанут они","сражаться с вами","пока не","отвратят вас","от","религии вашей","если","смогут","и кто","отступит","из вас","от","религии своей","и умрёт","и он","неверующий","то те","тщетны","деяния их","в","этом мире","и в Последней жизни","и те","обитатели","Огня","они","в нём","вечно пребывают"]],[2,218,["إِنَّ","ٱلَّذِينَ","ءَامَنُواْ","وَٱلَّذِينَ","هَاجَرُواْ","وَجَٰهَدُواْ","فِي","سَبِيلِ","ٱللَّهِ","أُوْلَٰٓئِكَ","يَرۡجُونَ","رَحۡمَتَ","ٱللَّهِۚ","وَٱللَّهُ","غَفُورٞ","رَّحِيمٞ"],"иннал лазиина амануу валлазиина хажаруу важахадуу фии сабиилиллахи улаика йаржууна рахматаллахи валлаху гафуурур рахиим","Воистину, те, которые уверовали, совершили переселение и сражались на пути Аллаха, надеются на милость Аллаха. А ведь Аллах - Прощающий, Милосердный.",["поистине","те, которые","уверовали","и те, которые","переселились","и сражались","на","пути","Аллаха","те","надеются на","милость","Аллаха","и Аллах","Прощающий","Милосердный"]],[2,219,["يَسۡـَٔلُونَكَ","عَنِ","ٱلۡخَمۡرِ","وَٱلۡمَيۡسِرِۖ","قُلۡ","فِيهِمَآ","إِثۡمٞ","كَبِيرٞ","وَمَنَٰفِعُ","لِلنَّاسِ","وَإِثۡمُهُمَآ","أَكۡبَرُ","مِن","نَّفۡعِهِمَاۗ","وَيَسۡـَٔلُونَكَ","مَاذَا","يُنفِقُونَۖ","قُلِ","ٱلۡعَفۡوَۗ","كَذَٰلِكَ","يُبَيِّنُ","ٱللَّهُ","لَكُمُ","ٱلۡأٓيَٰتِ","لَعَلَّكُمۡ","تَتَفَكَّرُونَ"],"йас'алуунака `анил хамри валмайсири ḳул фиихима исмун кабиирун ваманафи`у линнаси ва'исмухума акбару мин наф`ихима вайас'алуунака маза йунфиḳууна ḳулил `афва казалика йубаййинуллаху лакумул айати ла`аллакум татафаккаруун","Они спрашивают тебя об опьяняющих напитках и азартных играх. Скажи: «В них есть большой грех, но есть и польза для людей, хотя греха в них больше, чем пользы». Они спрашивают тебя, что они должны расходовать. Скажи: «Излишек». Так Аллах разъясняет вам знамения, - быть может, вы поразмыслите",["они спрашивают тебя","о","опьяняющем напитке","и азартной игре","скажи","в них обоих","грех","великий","и польза","для людей","но грех их обоих","больше","чем","польза их обоих","и они спрашивают тебя","что","они расходуют","скажи","излишек","так","разъясняет","Аллах","вам","знамения","быть может, вы","поразмыслите"]]],"m":[[["كُتِبَ","предписано",2,216],["عَلَيۡكُمُ","вам",2,216],["ٱلۡقِتَالُ","сражение",2,216],["وَهُوَ","а оно",2,216],["كُرۡهٞ","неприятно",2,216],["لَّكُمۡۖ","вам",2,216],["وَعَسَىٰٓ","и может быть",2,216],["أَن","что",2,216],["تَكۡرَهُواْ","вам неприятно",2,216]],[["شَيۡـٔٗا","что-либо",2,216],["وَهُوَ","а оно",2,216],["خَيۡرٞ","благо",2,216],["لَّكُمۡۖ","для вас",2,216],["وَعَسَىٰٓ","и может быть",2,216],["أَن","что",2,216],["تُحِبُّواْ","вы любите",2,216],["شَيۡـٔٗا","что-либо",2,216],["وَهُوَ","а оно",2,216],["شَرّٞ","зло",2,216],["لَّكُمۡۚ","для вас",2,216]],[["وَٱللَّهُ","и Аллах",2,216],["يَعۡلَمُ","знает",2,216],["وَأَنتُمۡ","а вы",2,216],["لَا","не",2,216],["تَعۡلَمُونَ","знаете",2,216],[216],["يَسۡـَٔلُونَكَ","они спрашивают тебя",2,217],["عَنِ","о",2,217],["ٱلشَّهۡرِ","месяце",2,217]],[["ٱلۡحَرَامِ","запретном",2,217],["قِتَالٖ","о сражении",2,217],["فِيهِۖ","в нём",2,217],["قُلۡ","скажи",2,217],["قِتَالٞ","сражение",2,217],["فِيهِ","в нём",2,217],["كَبِيرٞۚ","великий (грех)",2,217],["وَصَدٌّ","н