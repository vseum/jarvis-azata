{"p":35,"j":2,"a":[[2,220,["فِي","ٱلدُّنۡيَا","وَٱلۡأٓخِرَةِۗ","وَيَسۡـَٔلُونَكَ","عَنِ","ٱلۡيَتَٰمَىٰۖ","قُلۡ","إِصۡلَاحٞ","لَّهُمۡ","خَيۡرٞۖ","وَإِن","تُخَالِطُوهُمۡ","فَإِخۡوَٰنُكُمۡۚ","وَٱللَّهُ","يَعۡلَمُ","ٱلۡمُفۡسِدَ","مِنَ","ٱلۡمُصۡلِحِۚ","وَلَوۡ","شَآءَ","ٱللَّهُ","لَأَعۡنَتَكُمۡۚ","إِنَّ","ٱللَّهَ","عَزِيزٌ","حَكِيمٞ"],"фид дунйа вал'ахирати вайас'алуунака `анил йатама ḳул ислахул лахум хайрун ва'ин тухалитуухум фа'ихванукум валлаху йа`ламул муфсида минал муслихи валау шааллаху ла'а`натакум инналлаха `азиизун хакиим","над этим миром и Последней жизнью. Они спрашивают тебя о сиротах. Скажи: «Делать им добро - хорошо. Если вы объедините свои дела, то ведь они - ваши братья. Аллах отличает распространяющего нечестие от творящего добро. Если бы Аллах захотел, то поставил бы вас в затруднительное положение. Воистину, Аллах - Могущественный, Мудрый».",["в","этом мире","и Последней жизни","и они спрашивают тебя","о","сиротах","скажи","улучшение (дел)","для них","благо","и если","вы объедините (дела) с ними","то они ваши братья","и Аллах","знает","портящего","от","исправляющего","и если бы","пожелал","Аллах","непременно затруднил бы вас","поистине","Аллах","Могущественный","Мудрый"]],[2,221,["وَلَا","تَنكِحُواْ","ٱلۡمُشۡرِكَٰتِ","حَتَّىٰ","يُؤۡمِنَّۚ","وَلَأَمَةٞ","مُّؤۡمِنَةٌ","خَيۡرٞ","مِّن","مُّشۡرِكَةٖ","وَلَوۡ","أَعۡجَبَتۡكُمۡۗ","وَلَا","تُنكِحُواْ","ٱلۡمُشۡرِكِينَ","حَتَّىٰ","يُؤۡمِنُواْۚ","وَلَعَبۡدٞ","مُّؤۡمِنٌ","خَيۡرٞ","مِّن","مُّشۡرِكٖ","وَلَوۡ","أَعۡجَبَكُمۡۗ","أُوْلَٰٓئِكَ","يَدۡعُونَ","إِلَى","ٱلنَّارِۖ","وَٱللَّهُ","يَدۡعُوٓاْ","إِلَى","ٱلۡجَنَّةِ","وَٱلۡمَغۡفِرَةِ","بِإِذۡنِهِۦۖ","وَيُبَيِّنُ","ءَايَٰتِهِۦ","لِلنَّاسِ","لَعَلَّهُمۡ","يَتَذَكَّرُونَ"],"вала танкихул мушрикати хатта йу'минна валааматум му'минатун хайрум мим мушрикатин валау а`жабаткум вала тункихул мушрикиина хатта йу'минуу вала`абдум му'минун хайрум мим мушрикин валау а`жабакум улаика йад`ууна илан нари валлаху йад`уу илал жаннати валмагфирати би'изнихии вайубаййину айатихии линнаси ла`аллахум йатазаккаруун","Не женитесь на язычницах, пока они не уверуют. Безусловно, верующая невольница лучше язычницы, даже если она понравилась вам. Не выдавайте мусульманок замуж за язычников, пока они не уверуют. Безусловно, верующий невольник лучше язычника, даже если он понравился вам. Они зовут к Огню, а Аллах зовет к Раю и прощению со Своего соизволения. Он разъясняет людям Свои знамения, - быть может, они помянут назидание.",["и не","женитесь на","многобожницах","пока (не)","уверуют","и непременно невольница","верующая","лучше","чем","многобожница","и даже если","она понравилась вам","и не","выдавайте замуж","за многобожников","пока (не)","уверуют","и непременно раб","верующий","лучше","чем","многобожник","и даже если","он понравился вам","те","зовут","к","Огню","а Аллах","зовёт","к","Раю","и прощению","с Его дозволения","и Он разъясняет","Его знамения","для людей","быть может, они","помянут назидание"]],[2,222,["وَيَسۡـَٔلُونَكَ","عَنِ","ٱلۡمَحِيضِۖ","قُلۡ","هُوَ","أَذٗى","فَٱعۡتَزِلُواْ","ٱلنِّسَآءَ","فِي","ٱلۡمَحِيضِ","وَلَا","تَقۡرَبُوهُنَّ","حَتَّىٰ","يَطۡهُرۡنَۖ","فَإِذَا","تَطَهَّرۡنَ","فَأۡتُوهُنَّ","مِنۡ","حَيۡثُ","أَمَرَكُمُ","ٱللَّهُۚ","إِنَّ","ٱللَّهَ","يُحِبُّ","ٱلتَّوَّٰبِينَ","وَيُحِبُّ","ٱلۡمُتَطَهِّرِينَ"],"вайас'алуунака `анил махииди ḳул хуа азан фа`тазилун нисаа фил махииди вала таḳрабуухунна хатта йатхурна фа'иза татаххарна фа'туухунна мин хайсу амаракумуллаху инналлаха йухиббут таввабиина вайухиббул мутатаххириин","Они спрашивают тебя о менструациях. Скажи: «Они причиняют страдания. Посему избегайте половой близости с женщинами во время менструаций и не приближайтесь к ним, пока они не очистятся. А когда они очистятся, то приходите к ним так, как повелел вам Аллах. Воистину, Аллах любит кающихся и любит очищающихся».",["и они спрашивают тебя","о","менструации","скажи","она","страдание","так сторонитесь","женщин","во время","менструации","и не","приближайтесь к ним","пока (не)","очистятся","а когда","они очистятся","то приходите к ним","оттуда","откуда","повелел вам","Аллах","поистине","Аллах","любит","кающихся","и любит","очищающихся"]],[2,223,["نِسَآؤُكُمۡ","حَرۡثٞ","لَّكُمۡ","فَأۡتُواْ","حَرۡثَكُمۡ","أَنَّىٰ","شِئۡتُمۡۖ","وَقَدِّمُواْ","لِأَنفُسِكُمۡۚ","وَٱتَّقُواْ","ٱللَّهَ","وَٱعۡلَمُوٓاْ","أَنَّكُم","مُّلَٰقُوهُۗ","وَبَشِّرِ","ٱلۡمُؤۡمِنِينَ"],"нисаукум харсул лакум фа'туу харсакум анна ши'тум ваḳаддимуу ли'анфусикум ваттаḳуллаха ва`ламуу аннакум мулаḳууху вабашширил му'миниин","Ваши жены являются пашней для вас. Приходите же на вашу пашню, когда и как пожелаете. Готовьте для себя добрые деяния, бойтесь Аллаха и знайте, что вы встретитесь с Ним. Обрадуй же верующих!",["ваши жёны","пашня","для вас","так приходите","на вашу пашню","как (и когда)","пожелаете","и готовьте (заранее)","для самих себя","и бойтесь","Аллаха","и знайте","что вы","встретите Его","и обрадуй","верующих"]],[2,224,["وَلَا","تَجۡعَلُواْ","ٱللَّهَ","عُرۡضَةٗ","لِّأَيۡمَٰنِكُمۡ","أَن","تَبَرُّواْ","وَتَتَّقُواْ","وَتُصۡلِحُواْ","بَيۡنَ","ٱلنَّاسِۚ","وَٱللَّهُ","سَمِيعٌ","عَلِيمٞ"],"вала таж`алуллаха `урдатал ли'айманикум ан табарруу вататтаḳуу ватуслихуу байнан наси валлаху самии`ун `алиим","Пусть клятва именем Аллаха не мешает вам творить добро, быть богобоязненным и примирять людей. Аллах - Слышащий, Знающий.",["и не","делайте","Аллаха","преградой","для ваших клятв","чтобы (не)","творить добро","и быть богобоязненными","и примирять","между","людьми","и Аллах","Слышащий","Знающий"]]],"m":[[["فِي","в",2,220],["ٱلدُّنۡيَا","этом мире",2,220],["وَٱلۡأٓخِرَةِۗ","и Последней жизни",2,220],["وَيَسۡـَٔلُونَكَ","и они спрашивают тебя",2,220],["عَنِ","о",2,220],["ٱلۡيَتَٰمَىٰۖ","сиротах",2,220],["قُلۡ","скажи",2,220],["إِصۡلَاحٞ","улучшение (дел)",2,220],["لَّهُمۡ","для них",2,220]],[["خَيۡرٞۖ","благо",2,220],["وَإِن","и если",2,220],["تُخَالِطُوهُمۡ","вы объедините (дела) с ними",2,220],["فَإِخۡوَٰنُكُمۡۚ","то они ваши братья",2,220],["وَٱللَّهُ","и Аллах",2,220],["يَعۡلَمُ","знает",2,220],["ٱلۡمُفۡسِدَ","портящего",2,220],["مِنَ","от",2,220]],[["ٱلۡمُصۡلِحِۚ","исправляющего",2,220],["وَلَوۡ","и если бы",2,220],["شَآءَ","пожелал",2,220],["ٱللَّهُ","Аллах",2,220],["لَأَعۡنَتَكُمۡۚ","непременно затруднил бы вас",2,220],["إِنَّ","поистине",2,220],["ٱللَّهَ","Аллах",2,220],["عَزِيزٌ","Могущественный",2,220],["حَكِيمٞ","Мудрый",2,220],[220]],[["وَلَا","и не",2,221],["تَنكِحُواْ","женитесь на",2,221],["ٱلۡمُشۡرِكَٰتِ","многобожницах",2,221],["حَتَّىٰ","пока (не)",2,221],["يُؤۡمِنَّۚ","уверуют",2,221],["وَلَأَمَةٞ","и непременно невольница",2,221],["مُّؤۡمِنَةٌ","верующая",2,221],["خَيۡرٞ","лучше",2,221]],[["مِّن","чем",2,221],["مُّشۡرِكَةٖ","многобожница",2,221],["وَلَوۡ","и даже если",2,221],["أَعۡجَبَتۡكُمۡۗ","она понравилась вам",2,221],["وَلَا","и не",2,221],["تُنكِحُواْ","выдавайте замуж",2,221],["ٱلۡمُشۡرِكِينَ","за многобожников",2,221],["حَتَّىٰ","пока (не)",2,221]],[["يُؤۡمِنُواْۚ","уверуют",2,221],["وَلَعَبۡدٞ","и непременно раб",2,221],["مُّؤۡمِنٌ","верующий",2,221],["خَيۡرٞ","лучше",2,221],["مِّن","чем",2,221],["مُّشۡرِكٖ","многобожник",2,221],["وَلَوۡ","и даже если",2,221],["أَعۡجَبَكُمۡۗ","он понравился вам",2,221],["أُوْلَٰٓئِكَ","те",2,221]],[["يَدۡعُونَ","зовут",2,221],["إِلَى","к",2,221],["ٱلنَّارِۖ","Огню",2,221],["وَٱللَّهُ","а Аллах",2,221],["يَدۡعُوٓاْ","зовёт",2,221],["إِلَى","к",2,221],["ٱلۡجَنَّةِ","Раю",2,221],["وَٱلۡمَغۡفِرَةِ","и прощению",2,221],["بِإِذۡنِهِۦۖ","с Его дозволения",2,221]],[["وَيُبَيِّنُ","и Он разъясняет",2,221],["ءَايَٰتِهِۦ","Его знамения",2,221],["لِلنَّاسِ","для людей",2,221],["لَعَلَّهُمۡ","быть может, они",2,221],["يَتَذَكَّرُونَ","помянут назидание",2,221],[221],["وَيَسۡـَٔلُونَكَ","и они спрашивают тебя",2,222]],[["عَنِ","о",2,222],["ٱلۡمَحِيضِۖ","менструации",2,222],["قُلۡ","скажи",2,222],["هُوَ","она",2,222],["أَذٗى","страдание",2,222],["فَٱعۡتَزِلُواْ","так сторонитесь",2,222],["ٱلنِّسَآءَ","женщин",2,222],["فِي","во время",2,222],["ٱلۡمَحِيضِ","менструации",2,222]],[["وَلَا","и не",2,222],["تَقۡرَبُوهُنَّ","приближайтесь к ним",2,222],