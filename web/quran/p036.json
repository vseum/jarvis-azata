{"p":36,"j":2,"a":[[2,225,["لَّا","يُؤَاخِذُكُمُ","ٱللَّهُ","بِٱللَّغۡوِ","فِيٓ","أَيۡمَٰنِكُمۡ","وَلَٰكِن","يُؤَاخِذُكُم","بِمَا","كَسَبَتۡ","قُلُوبُكُمۡۗ","وَٱللَّهُ","غَفُورٌ","حَلِيمٞ"],"лла йу'ахизукумуллаху биллагви фии айманикум валакин йу'ахизукум бима касабат ḳулуубукум валлаху гафуурун халиим","Аллах не призовет вас к ответу за непреднамеренные клятвы, но призовет вас к ответу за то, что приобрели ваши сердца. Аллах - Прощающий, Выдержанный.",["не","призовёт к ответу вас","Аллах","за пустое","в","ваших клятвах","но","Он призовёт к ответу вас","за то, что","приобрели","ваши сердца","и Аллах","Прощающий","Выдержанный"]],[2,226,["لِّلَّذِينَ","يُؤۡلُونَ","مِن","نِّسَآئِهِمۡ","تَرَبُّصُ","أَرۡبَعَةِ","أَشۡهُرٖۖ","فَإِن","فَآءُو","فَإِنَّ","ٱللَّهَ","غَفُورٞ","رَّحِيمٞ"],"ллиллазиина йу'лууна мин нисаихим тараббусу арба`ати ашхурин фа'ин фауу фа'инналлаха гафуурур рахиим","Те, которые поклялись не вступать в половую близость со своими женами, должны выжидать четыре месяца. И если они передумают, то ведь Аллах - Прощающий, Милосердный.",["для тех, которые","клянутся (отстраниться)","от","своих жён","выжидание","четырёх","месяцев","и если","они вернулись","то поистине","Аллах","Прощающий","Милосердный"]],[2,227,["وَإِنۡ","عَزَمُواْ","ٱلطَّلَٰقَ","فَإِنَّ","ٱللَّهَ","سَمِيعٌ","عَلِيمٞ"],"ва'ин `азамут талаḳа фа'инналлаха самии`ун `алиим","Если же они решат развестись, то ведь Аллах - Слышащий, Знающий.",["и если","они решили","развод","то поистине","Аллах","Слышащий","Знающий"]],[2,228,["وَٱلۡمُطَلَّقَٰتُ","يَتَرَبَّصۡنَ","بِأَنفُسِهِنَّ","ثَلَٰثَةَ","قُرُوٓءٖۚ","وَلَا","يَحِلُّ","لَهُنَّ","أَن","يَكۡتُمۡنَ","مَا","خَلَقَ","ٱللَّهُ","فِيٓ","أَرۡحَامِهِنَّ","إِن","كُنَّ","يُؤۡمِنَّ","بِٱللَّهِ","وَٱلۡيَوۡمِ","ٱلۡأٓخِرِۚ","وَبُعُولَتُهُنَّ","أَحَقُّ","بِرَدِّهِنَّ","فِي","ذَٰلِكَ","إِنۡ","أَرَادُوٓاْ","إِصۡلَٰحٗاۚ","وَلَهُنَّ","مِثۡلُ","ٱلَّذِي","عَلَيۡهِنَّ","بِٱلۡمَعۡرُوفِۚ","وَلِلرِّجَالِ","عَلَيۡهِنَّ","دَرَجَةٞۗ","وَٱللَّهُ","عَزِيزٌ","حَكِيمٌ"],"валмуталлаḳату йатараббасна би'анфусихинна саласата ḳурууин вала йахиллу лахунна ан йактумна ма халаḳаллаху фии архамихинна ин кунна йу'минна биллахи валйаумил ахири вабу`уулатухунна ахаḳḳу бираддихинна фии залика ин арадуу ислахан валахунна мислул лазии `алайхинна билма`рууфи валиррижали `алайхинна даражатун валлаху `азиизун хакиим","Разведенные женщины должны выжидать в течение трех менструаций. Не позволительно им скрывать то, что сотворил Аллах в их утробах, если они веруют в Аллаха и в Последний день. Мужья в течение этого периода имеют право вернуть их, если захотят примирения. Жены имеют такие же права, как и обязанности, и относиться к ним следует по-доброму, но мужья выше их по положению. Аллах - Могущественный, Мудрый.",["и разведённые","выжидают","сами по себе","три","менструации","и не","дозволено","им","чтобы","они скрывали","то, что","сотворил","Аллах","в","их утробах","если","они","веруют","в Аллаха","и в День","Последний","а их мужья","более вправе","вернуть их","в","этот (срок)","если","они захотят","примирения","и им (принадлежит)","подобное","тому, что","на них","как подобает","а мужчинам","над ними","степень","и Аллах","Могущественный","Мудрый"]],[2,229,["ٱلطَّلَٰقُ","مَرَّتَانِۖ","فَإِمۡسَاكُۢ","بِمَعۡرُوفٍ","أَوۡ","تَسۡرِيحُۢ","بِإِحۡسَٰنٖۗ","وَلَا","يَحِلُّ","لَكُمۡ","أَن","تَأۡخُذُواْ","مِمَّآ","ءَاتَيۡتُمُوهُنَّ","شَيۡـًٔا","إِلَّآ","أَن","يَخَافَآ","أَلَّا","يُقِيمَا","حُدُودَ","ٱللَّهِۖ","فَإِنۡ","خِفۡتُمۡ","أَلَّا","يُقِيمَا","حُدُودَ","ٱللَّهِ","فَلَا","جُنَاحَ","عَلَيۡهِمَا","فِيمَا","ٱفۡتَدَتۡ","بِهِۦۗ","تِلۡكَ","حُدُودُ","ٱللَّهِ","فَلَا","تَعۡتَدُوهَاۚ","وَمَن","يَتَعَدَّ","حُدُودَ","ٱللَّهِ","فَأُوْلَٰٓئِكَ","هُمُ","ٱلظَّٰلِمُونَ"],"атталаḳу марратани фа'имсаку бима`рууфин ау тасрииху би'ихсанин вала йахиллу лакум ан та'хузуу мимма атайтумуухунна шай'ан илла ан йахафа алла йуḳиима худуудаллахи фа'ин хифтум алла йуḳиима худуудаллахи фала жунаха `алайхима фиимафтадат бихии тилка худуудуллахи фала та`тадууха ваман йата`адда худуудаллахи фа'улаика хумуз залимуун","Развод допускается дважды, после чего надо либо удержать жену на разумных условиях, либо отпустить ее по-доброму. Вам не дозволено брать что-либо из дарованного им, если только у обеих сторон нет опасения, что они не смогут соблюсти ограничения Аллаха. И если вы опасаетесь, что они не смогут соблюсти ограничения Аллаха, то они оба не совершат греха, если она выкупит развод. Таковы ограничения Аллаха, не преступайте же их. А те, которые преступают ограничения Аллаха, являются беззаконниками.",["развод","дважды","затем удержание","как подобает","или","отпускание","по-доброму","и не","дозволено","вам","чтобы","вы брали","из того, что","вы дали им","что-либо","кроме","если","оба опасаются","что не","они оба соблюдут","границы","Аллаха","а если","вы опасаетесь","что не","они оба соблюдут","границы","Аллаха","то нет","греха","на них обоих","в том, что","она выкупилась","этим","это","границы","Аллаха","так не","преступайте их","а кто","преступает","границы","Аллаха","то те","они","беззаконники"]],[2,230,["فَإِن","طَلَّقَهَا","فَلَا","تَحِلُّ","لَهُۥ","مِنۢ","بَعۡدُ","حَتَّىٰ","تَنكِحَ","زَوۡجًا","غَيۡرَهُۥۗ","فَإِن","طَلَّقَهَا","فَلَا","جُنَاحَ","عَلَيۡهِمَآ","أَن","يَتَرَاجَعَآ","إِن","ظَنَّآ","أَن","يُقِيمَا","حُدُودَ","ٱللَّهِۗ","وَتِلۡكَ","حُدُودُ","ٱللَّهِ","يُبَيِّنُهَا","لِقَوۡمٖ","يَعۡلَمُونَ"],"фа'ин таллаḳаха фала тахиллу лахуу мим ба`ду хатта танкиха заужан гайрахуу фа'ин таллаḳаха фала жунаха `алайхима ан йатаража`а ин занна ан йуḳиима худуудаллахи ватилка худуудуллахи йубаййинуха лиḳаумин йа`ламуун","Если он развелся с ней в третий раз, то ему не дозволено жениться на ней, пока она не выйдет замуж за другого. И если тот разведется с ней, то они не совершат греха, если воссоединятся, полагая, что они смогут соблюсти ограничения Аллаха. Таковы ограничения Аллаха. Он разъясняет их для людей знающих.",["а если","он развёлся с ней","то не","дозволена (она)","ему","впредь","после (этого)","пока (не)","она выйдет замуж за","супруга","другого, 