{"p":38,"j":2,"a":[[2,234,["وَٱلَّذِينَ","يُتَوَفَّوۡنَ","مِنكُمۡ","وَيَذَرُونَ","أَزۡوَٰجٗا","يَتَرَبَّصۡنَ","بِأَنفُسِهِنَّ","أَرۡبَعَةَ","أَشۡهُرٖ","وَعَشۡرٗاۖ","فَإِذَا","بَلَغۡنَ","أَجَلَهُنَّ","فَلَا","جُنَاحَ","عَلَيۡكُمۡ","فِيمَا","فَعَلۡنَ","فِيٓ","أَنفُسِهِنَّ","بِٱلۡمَعۡرُوفِۗ","وَٱللَّهُ","بِمَا","تَعۡمَلُونَ","خَبِيرٞ"],"валлазиина йутаваффауна минкум вайазарууна азважан йатараббасна би'анфусихинна арба`ата ашхурин ва`ашран фа'иза балагна ажалахунна фала жунаха `алайкум фиима фа`ална фии анфусихинна билма`рууфи валлаху бима та`малууна хабиир","Если кто-либо из вас скончается и оставит после себя жен, то они должны выжидать четыре месяца и десять дней. Когда же они дождутся истечения положенного им срока, то на вас не будет греха, если они распорядятся собой разумным образом. Аллах ведает о том, что вы совершаете.",["и те, которые","умирают","из вас","и оставляют","жён","выжидают","сами по себе","четыре","месяца","и десять (дней)","а когда","они достигли","своего срока","то нет","греха","на вас","в том, что","они сделали","с","собой","как подобает","и Аллах","о том, что","вы делаете","Сведущ"]],[2,235,["وَلَا","جُنَاحَ","عَلَيۡكُمۡ","فِيمَا","عَرَّضۡتُم","بِهِۦ","مِنۡ","خِطۡبَةِ","ٱلنِّسَآءِ","أَوۡ","أَكۡنَنتُمۡ","فِيٓ","أَنفُسِكُمۡۚ","عَلِمَ","ٱللَّهُ","أَنَّكُمۡ","سَتَذۡكُرُونَهُنَّ","وَلَٰكِن","لَّا","تُوَاعِدُوهُنَّ","سِرًّا","إِلَّآ","أَن","تَقُولُواْ","قَوۡلٗا","مَّعۡرُوفٗاۚ","وَلَا","تَعۡزِمُواْ","عُقۡدَةَ","ٱلنِّكَاحِ","حَتَّىٰ","يَبۡلُغَ","ٱلۡكِتَٰبُ","أَجَلَهُۥۚ","وَٱعۡلَمُوٓاْ","أَنَّ","ٱللَّهَ","يَعۡلَمُ","مَا","فِيٓ","أَنفُسِكُمۡ","فَٱحۡذَرُوهُۚ","وَٱعۡلَمُوٓاْ","أَنَّ","ٱللَّهَ","غَفُورٌ","حَلِيمٞ"],"вала жунаха `алайкум фиима `аррадтум бихии мин хитбатин нисаи ау акнантум фии анфусикум `алималлаху аннакум сатазкуруунахунна валакил ла туа`идуухунна сирран илла ан таḳуулуу ḳаулам ма`рууфан вала та`зимуу `уḳдатан никахи хатта йаблугал китабу ажалахуу ва`ламуу анналлаха йа`ламу ма фии анфусикум фахзарууху ва`ламуу анналлаха гафуурун халиим","На вас не будет греха, если вы намекнете о сватовстве к женщинам или утаите это в душе. Аллах знает, что вы будете вспоминать о них. Не давайте им тайных обещаний и говорите только достойные слова. Не принимайте решение вступить в брак, пока не истечет предписанный срок. Знайте, что Аллаху известно о том, что в ваших душах. Остерегайтесь Его и знайте, что Аллах - Прощающий, Выдержанный.",["и нет","греха","на вас","в том, что","вы намекнули","этим","о","сватовстве","к женщинам","или","вы утаили","в","ваших душах","знает","Аллах","что вы","будете вспоминать их","но","не","давайте им обещаний","тайно","кроме","как","вы скажете","слово","достойное","и не","решайтесь на","узел","брака","пока (не)","достигнет","предписанное","своего срока","и знайте","что","Аллах","знает","то, что","в","ваших душах","так остерегайтесь Его","и знайте","что","Аллах","Прощающий","Выдержанный"]],[2,236,["لَّا","جُنَاحَ","عَلَيۡكُمۡ","إِن","طَلَّقۡتُمُ","ٱلنِّسَآءَ","مَا","لَمۡ","تَمَسُّوهُنَّ","أَوۡ","تَفۡرِضُواْ","لَهُنَّ","فَرِيضَةٗۚ","وَمَتِّعُوهُنَّ","عَلَى","ٱلۡمُوسِعِ","قَدَرُهُۥ","وَعَلَى","ٱلۡمُقۡتِرِ","قَدَرُهُۥ","مَتَٰعَۢا","بِٱلۡمَعۡرُوفِۖ","حَقًّا","عَلَى","ٱلۡمُحۡسِنِينَ"],"лла жунаха `алайкум ин таллаḳтумун нисаа ма лам тамассуухунна ау тафридуу лахунна фариидатан ваматти`уухунна `алал мууси`и ḳадарухуу ва`алал муḳтири ḳадарухуу мата`а билма`рууфи хаḳḳан `алал мухсиниин","На вас не будет греха, если вы разведетесь с женами, не коснувшись их и не установив для них обязательное вознаграждение (брачный дар). Одарите их разумным образом, и пусть богатый поступит по мере своих возможностей, а бедный - по мере своих. Такова обязанность творящих добро.",["нет","греха","на вас","если","вы развелись с","женщинами","пока","не","вы коснулись их","или (не)","установили","для них","обязательный дар","и одарите их","на","богатом","по его мере","и на","бедном","по его мере","дар","как подобает","обязанность","для","творящих добро"]],[2,237,["وَإِن","طَلَّقۡتُمُوهُنَّ","مِن","قَبۡلِ","أَن","تَمَسُّوهُنَّ","وَقَدۡ","فَرَضۡتُمۡ","لَهُنَّ","فَرِيضَةٗ","فَنِصۡفُ","مَا","فَرَضۡتُمۡ","إِلَّآ","أَن","يَعۡفُونَ","أَوۡ","يَعۡفُوَاْ","ٱلَّذِي","بِيَدِهِۦ","عُقۡدَةُ","ٱلنِّكَاحِۚ","وَأَن","تَعۡفُوٓاْ","أَقۡرَبُ","لِلتَّقۡوَىٰۚ","وَلَا","تَنسَوُاْ","ٱلۡفَضۡلَ","بَيۡنَكُمۡۚ","إِنَّ","ٱللَّهَ","بِمَا","تَعۡمَلُونَ","بَصِيرٌ"],"ва'ин таллаḳтумуухунна мин ḳабли ан тамассуухунна ваḳад фарадтум лахунна фариидатан фанисфу ма фарадтум илла ан йа`фууна ау йа`фуал лазии бийадихии `уḳдатун никахи ва'ан та`фуу аḳрабу литтаḳва вала тансавул фадла байнакум инналлаха бима та`малууна басиир","Если же вы разведетесь с ними до того, как коснулись их, но после того, как установили обязательное вознаграждение (брачный дар), то отдайте им половину его, если только они не простят или не простит тот, в чьих руках брачное соглашение. Если вы простите, то это будет ближе к богобоязненности. Не забывайте оказывать милость друг к другу. Воистину, Аллах видит то, что вы совершаете.",["а если","вы развелись с ними","до","того","как","вы коснулись их","но уже","вы установили","для них","обязательный дар","то половина","того, что","вы установили","кроме","если","они простят","или","простит","тот","в чьей руке","узел","брака","а то, что","вы простите","ближе","к богобоязненности","и не","забывайте","великодушие","между вами","поистине","Аллах","то, что","вы делаете","видит"]]],"m":[[["وَٱلَّذِينَ","и те, которые",2,234],["يُتَوَفَّوۡنَ","умирают",2,234],["مِنكُمۡ","из вас",2,234],["وَيَذَرُونَ","и оставляют",2,234],["أَزۡوَٰجٗا","жён",2,234],["يَتَرَبَّصۡنَ","выжидают",2,234],["بِأَنفُسِهِنَّ","сами по себе",2,234]],[["أَرۡبَعَةَ","четыре",2,234],["أَشۡهُرٖ","месяца",2,234],["وَعَشۡرٗاۖ","и десять (дней)",2,234],["فَإِذَا","а когда",2,234],["بَلَغۡنَ","они достигли",2,234],["أَجَلَهُنَّ","своего срока",2,234],["فَلَا","то нет",2,234],["جُنَاحَ","греха",2,234],["عَلَيۡكُمۡ","на вас",2,234]],[["فِيمَا","в том, что",2,234],["فَعَلۡنَ","они сделали",2,234],["فِيٓ","с",2,234],["أَنفُسِهِنَّ","собой",