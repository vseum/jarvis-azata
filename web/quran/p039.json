ой",2,240],["مِن","из",2,240]],[["مَّعۡرُوفٖۗ","достойного",2,240],["وَٱللَّهُ","и Аллах",2,240],["عَزِيزٌ","Могущественный",2,240],["حَكِيمٞ","Мудрый",2,240],[240],["وَلِلۡمُطَلَّقَٰتِ","и разведенным",2,241],["مَتَٰعُۢ","обеспечение",2,241]],[["بِٱلۡمَعۡرُوفِۖ","подобающим образом",2,241],["حَقًّا","обязанность",2,241],["عَلَى","на",2,241],["ٱلۡمُتَّقِينَ","богобоязненных",2,241],[241],["كَذَٰلِكَ","так",2,242],["يُبَيِّنُ","разъясняет",2,242]],[["ٱللَّهُ","Аллах",2,242],["لَكُمۡ","вам",2,242],["ءَايَٰتِهِۦ","Свои знамения",2,242],["لَعَلَّكُمۡ","может, вы",2,242],["تَعۡقِلُونَ","уразумеете",2,242],[242],["۞ أَلَمۡ","разве не",2,243],["تَرَ","ты видел",2,243]],[["إِلَى","на",2,243],["ٱلَّذِينَ","тех, которые",2,243],["خَرَجُواْ","вышли",2,243],["مِن","из",2,243],["دِيَٰرِهِمۡ","своих жилищ",2,243],["وَهُمۡ","и они",2,243],["أُلُوفٌ","тысячи",2,243],["حَذَرَ","опасаясь",2,243],["ٱلۡمَوۡتِ","смерти",2,243]],[["فَقَالَ","и сказал",2,243],["لَهُمُ","им",2,243],["ٱللَّهُ","Аллах",2,243],["مُوتُواْ","умрите",2,243],["ثُمَّ","затем",2,243],["أَحۡيَٰهُمۡۚ","Он оживил их",2,243],["إِنَّ","поистине",2,243],["ٱللَّهَ","Аллах",2,243],["لَذُو","непременно обладатель",2,243],["فَضۡلٍ","милости",2,243],["عَلَى","к",2,243]],[["ٱلنَّاسِ","людям",2,243],["وَلَٰكِنَّ","но",2,243],["أَكۡثَرَ","большинство",2,243],["ٱلنَّاسِ","людей",2,243],["لَا","не",2,243],["يَشۡكُرُونَ","благодарят",2,243],[243]],[["وَقَٰتِلُواْ","и сражайтесь",2,244],["فِي","на",2,244],["سَبِيلِ","пути",2,244],["ٱللَّهِ","Аллаха",2,244],["وَٱعۡلَمُوٓاْ","и знайте",2,244],["أَنَّ","что",2,244],["ٱللَّهَ","Аллах",2,244],["سَمِيعٌ","Слышащий",2,244],["عَلِيمٞ","Знающий",2,244],[244]],[["مَّن","кто",2,245],["ذَا","тот",2,245],["ٱلَّذِي","который",2,245],["يُقۡرِضُ","одолжит",2,245],["ٱللَّهَ","Аллаху",2,245],["قَرۡضًا","заём",2,245],["حَسَنٗا","прекрасный",2,245],["فَيُضَٰعِفَهُۥ","и Он умножит его",2,245],["لَهُۥٓ","для него",2,245],["أَضۡعَافٗا","кратно",2,245]],[["كَثِيرَةٗۚ","многократно",2,245],["وَٱللَّهُ","и А