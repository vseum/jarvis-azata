{"p":40,"j":2,"a":[[2,246,["أَلَمۡ","تَرَ","إِلَى","ٱلۡمَلَإِ","مِنۢ","بَنِيٓ","إِسۡرَٰٓءِيلَ","مِنۢ","بَعۡدِ","مُوسَىٰٓ","إِذۡ","قَالُواْ","لِنَبِيّٖ","لَّهُمُ","ٱبۡعَثۡ","لَنَا","مَلِكٗا","نُّقَٰتِلۡ","فِي","سَبِيلِ","ٱللَّهِۖ","قَالَ","هَلۡ","عَسَيۡتُمۡ","إِن","كُتِبَ","عَلَيۡكُمُ","ٱلۡقِتَالُ","أَلَّا","تُقَٰتِلُواْۖ","قَالُواْ","وَمَا","لَنَآ","أَلَّا","نُقَٰتِلَ","فِي","سَبِيلِ","ٱللَّهِ","وَقَدۡ","أُخۡرِجۡنَا","مِن","دِيَٰرِنَا","وَأَبۡنَآئِنَاۖ","فَلَمَّا","كُتِبَ","عَلَيۡهِمُ","ٱلۡقِتَالُ","تَوَلَّوۡاْ","إِلَّا","قَلِيلٗا","مِّنۡهُمۡۚ","وَٱللَّهُ","عَلِيمُۢ","بِٱلظَّٰلِمِينَ"],"алам тара илал малаи мим бании исраиила мим ба`ди мууса из ḳалуу линабиййил лахумуб`ас лана маликан нуḳатил фии сабиилиллахи ḳала хал `асайтум ин кутиба `алайкумул ḳиталу алла туḳатилуу ḳалуу вама лана алла нуḳатила фии сабиилиллахи ваḳад ухрижна мин дийарина ва'абнаина фаламма кутиба `алайхимул ḳиталу таваллау илла ḳалиилам минхум валлаху `алииму биззалимиин","Не знаешь ли ты о знати сынов Исраила (Израиля), живших после Мусы (Моисея)? Они сказали своему пророку: «Назначь для нас царя, чтобы мы сражались на пути Аллаха». Он сказал: «Может ли быть, что если вам будет предписано сражаться, вы не станете сражаться?». Они сказали: «Отчего же нам не сражаться на пути Аллаха, если мы изгнаны из наших жилищ и разлучены с нашими детьми?». Когда же им было предписано сражаться, они отвернулись, за исключением немногих. Аллах ведает о беззаконниках.",["разве не","ты видел","на","знать","из","сынов","Исраила","из","после","Мусы","когда","они сказали","пророку","их","назначь","для нас","царя","мы будем сражаться","на","пути","Аллаха","он сказал","разве","может быть, вы","если","предписано","вам","сражение","что не","станете сражаться","они сказали","и что","нам","чтобы не","мы сражались","на","пути","Аллаха","тогда как уже","мы изгнаны","из","наших жилищ","и (от) наших детей","но когда","было предписано","им","сражение","они отвернулись","кроме","немногих","из них","и Аллах","Знающий","о беззаконниках"]],[2,247,["وَقَالَ","لَهُمۡ","نَبِيُّهُمۡ","إِنَّ","ٱللَّهَ","قَدۡ","بَعَثَ","لَكُمۡ","طَالُوتَ","مَلِكٗاۚ","قَالُوٓاْ","أَنَّىٰ","يَكُونُ","لَهُ","ٱلۡمُلۡكُ","عَلَيۡنَا","وَنَحۡنُ","أَحَقُّ","بِٱلۡمُلۡكِ","مِنۡهُ","وَلَمۡ","يُؤۡتَ","سَعَةٗ","مِّنَ","ٱلۡمَالِۚ","قَالَ","إِنَّ","ٱللَّهَ","ٱصۡطَفَىٰهُ","عَلَيۡكُمۡ","وَزَادَهُۥ","بَسۡطَةٗ","فِي","ٱلۡعِلۡمِ","وَٱلۡجِسۡمِۖ","وَٱللَّهُ","يُؤۡتِي","مُلۡكَهُۥ","مَن","يَشَآءُۚ","وَٱللَّهُ","وَٰسِعٌ","عَلِيمٞ"],"ваḳала лахум набиййухум инналлаха ḳад ба`аса лакум талуута маликан ḳалуу анна йакууну лахул мулку `алайна ванахну ахаḳḳу билмулки минху валам йу'та са`атам минал мали ḳала инналлахастафаху `алайкум вазадахуу бастатан фил `илми валжисми валлаху йу'тии мулкахуу ман йашау валлаху васи`ун `алиим","Их пророк сказал им: «Аллах назначил вам царем Талута (Саула)». Они сказали: «Как он может стать нашим царем, если мы более достойны править, чем он, и он лишен достатка в имуществе?». Он сказал: «Аллах предпочел его вам и щедро одарил его знаниями и статью. Аллах дарует Свое царство, кому пожелает. Аллах - Объемлющий, Знающий».",["и сказал","им","их пророк","поистине","Аллах","уже","воздвиг","вам","Талута","царём","они сказали","как","может быть","у него","власть","над нами","тогда как мы","более достойны","власти","чем он","и не","дано ему","обилия","из","имущества","он сказал","поистине","Аллах","избрал его","над вами","и прибавил ему","обширность","в","знании","и теле","и Аллах","даёт","Свою власть","кому","Он пожелает","и Аллах","Объемлющий","Знающий"]],[2,248,["وَقَالَ","لَهُمۡ","نَبِيُّهُمۡ","إِنَّ","ءَايَةَ","مُلۡكِهِۦٓ","أَن","يَأۡتِيَكُمُ","ٱلتَّابُوتُ","فِيهِ","سَكِينَةٞ","مِّن","رَّبِّكُمۡ","وَبَقِيَّةٞ","مِّمَّا","تَرَكَ","ءَالُ","مُوسَىٰ","وَءَالُ","هَٰرُونَ","تَحۡمِلُهُ","ٱلۡمَلَٰٓئِكَةُۚ","إِنَّ","فِي","ذَٰلِكَ","لَأٓيَةٗ","لَّكُمۡ","إِن","كُنتُم","مُّؤۡمِنِينَ"],"ваḳала лахум набиййухум инна айата мулкихии ан йа'тийакумут табууту фиихи сакиинатум мир раббикум вабаḳиййатум мимма тарака алу мууса ва'алу харууна тахмилухул малаикату инна фии залика ла'айатал лакум ин кунтум му'миниин","Их пророк сказал им: «Знамением его царствия станет то, что к вам явится сундук с умиротворением от вашего Господа. В нем будет то, что осталось после семьи Мусы (Моисея) и семьи Харуна (Аарона). Его принесут ангелы. Это будет знамением для вас, если только вы являетесь верующими».",["и сказал","им","их пророк","поистине","знамение","его царствия","что","придёт к вам","ковчег","в нём","умиротворение","от","вашего Господа","и остаток","из того, что","оставила","семья","Мусы","и семья","Харуна","несут его","ангелы","поистине","в","этом","непременно знамение","для вас","если","вы","верующие"]]],"m":[[["أَلَمۡ","разве не",2,246],["تَرَ","ты видел",2,246],["إِلَى","на",2,246],["ٱلۡمَلَإِ","знать",2,246],["مِنۢ","из",2,246],["بَنِيٓ","сынов",2,246],["إِسۡرَٰٓءِيلَ","Исраила",2,246],["مِنۢ","из",2,246],["بَعۡدِ","после",2,246],["مُوسَىٰٓ","Мусы",2,246],["إِذۡ","когда",2,246],["قَالُواْ","они сказали",2,246]],[["لِنَبِيّٖ","пророку",2,246],["لَّهُمُ","их",2,246],["ٱبۡعَثۡ","назначь",2,246],["لَنَا","для нас",2,246],["مَلِكٗا","царя",2,246],["نُّقَٰتِلۡ","мы будем сражаться",2,246],["فِي","на",2,246],["سَبِيلِ","пути",2,246],["ٱللَّهِۖ","Аллаха",2,246],["قَالَ","он сказал",2,246]],[["هَلۡ","разве",2,246],["عَسَيۡتُمۡ","может быть, вы",2,246],["إِن","если",2,246],["كُتِبَ","предписано",2,246],["عَلَيۡكُمُ","вам",2,246],["ٱلۡقِتَالُ","сражение",2,246],["أَلَّا","что не",2,246],["تُقَٰتِلُواْۖ","станете сражаться",2,246]],[["قَالُواْ","они сказали",2,246],["وَمَا","и что",2,246],["لَنَآ","нам",2,246],["أَلَّا","чтобы не",2,246],["نُقَٰتِلَ","мы сражались",2,246],["فِي","на",2,246],["سَبِيلِ","пути",2,246],["ٱللَّهِ","Аллаха",2,246],["وَقَدۡ","тогда как уже",2,246],["أُخۡرِجۡنَا","мы изгнаны",2,246]],[["مِن","из",2,246],["دِيَٰرِنَا","наших жилищ",2,246],["وَأَبۡنَآئِنَاۖ","и (от) наших детей",2,246],["فَلَمَّا","но когда",2,246],["كُتِبَ","было предписано",2,246],["عَلَيۡهِمُ","им",2,246],["ٱ