{"p":41,"j":2,"a":[[2,249,["فَلَمَّا","فَصَلَ","طَالُوتُ","بِٱلۡجُنُودِ","قَالَ","إِنَّ","ٱللَّهَ","مُبۡتَلِيكُم","بِنَهَرٖ","فَمَن","شَرِبَ","مِنۡهُ","فَلَيۡسَ","مِنِّي","وَمَن","لَّمۡ","يَطۡعَمۡهُ","فَإِنَّهُۥ","مِنِّيٓ","إِلَّا","مَنِ","ٱغۡتَرَفَ","غُرۡفَةَۢ","بِيَدِهِۦۚ","فَشَرِبُواْ","مِنۡهُ","إِلَّا","قَلِيلٗا","مِّنۡهُمۡۚ","فَلَمَّا","جَاوَزَهُۥ","هُوَ","وَٱلَّذِينَ","ءَامَنُواْ","مَعَهُۥ","قَالُواْ","لَا","طَاقَةَ","لَنَا","ٱلۡيَوۡمَ","بِجَالُوتَ","وَجُنُودِهِۦۚ","قَالَ","ٱلَّذِينَ","يَظُنُّونَ","أَنَّهُم","مُّلَٰقُواْ","ٱللَّهِ","كَم","مِّن","فِئَةٖ","قَلِيلَةٍ","غَلَبَتۡ","فِئَةٗ","كَثِيرَةَۢ","بِإِذۡنِ","ٱللَّهِۗ","وَٱللَّهُ","مَعَ","ٱلصَّٰبِرِينَ"],"фаламма фасала талууту билжунууди ḳала инналлаха мубталиикум бинахарин фаман шариба минху фалайса миннии вамал лам йат`амху фа'иннахуу миннии илла манигтарафа гурфата бийадихии фашарибуу минху илла ḳалиилам минхум фаламма жавазахуу хуа валлазиина амануу ма`ахуу ḳалуу ла таḳата ланал йаума бижалуута важунуудихии ḳалал лазиина йазуннууна аннахум мулаḳуллахи кам мин фи'атин ḳалиилатин галабат фи'атан касиирата би'изниллахи валлаху ма`ас сабириин","Когда Талут (Саул) отправился в путь с войском, он сказал: «Аллах подвергнет вас испытанию рекой. Кто напьется из нее, тот не будет со мной. А кто не отведает ее, тот будет со мной. Но это не относится к тем, кто зачерпнет пригоршню воды». Напились из нее все, за исключением немногих из них. Когда же он и уверовавшие вместе с ним перебрались через реку, они сказали: «Сегодня мы не справимся с Джалутом (Голиафом) и его войском». Но те, которые были убеждены в том, что встретятся с Аллахом, сказали: «Сколько малочисленных отрядов победило многочисленные отряды по воле Аллаха!». Ведь Аллах - с терпеливыми.",["а когда","выступил","Талут","с войсками","он сказал","поистине","Аллах","испытает вас","рекой","так кто","напился","из неё","то он не","из моих","а кто","не","отведал её","то поистине, он","из моих","кроме","того, кто","зачерпнул","пригоршню","своей рукой","и они напились","из неё","кроме","немногих","из них","а когда","он перешёл её","он","и те, которые","уверовали","с ним","они сказали","нет","сил","у нас","сегодня","против Джалута","и его войск","сказали","те, которые","были уверены","что они","встретят","Аллаха","сколько","из","отрядов","малых","победили","отряд","многочисленный","с дозволения","Аллаха","и Аллах","с","терпеливыми"]],[2,250,["وَلَمَّا","بَرَزُواْ","لِجَالُوتَ","وَجُنُودِهِۦ","قَالُواْ","رَبَّنَآ","أَفۡرِغۡ","عَلَيۡنَا","صَبۡرٗا","وَثَبِّتۡ","أَقۡدَامَنَا","وَٱنصُرۡنَا","عَلَى","ٱلۡقَوۡمِ","ٱلۡكَٰفِرِينَ"],"валамма баразуу лижалуута важунуудихии ḳалуу раббана африг `алайна сабран васаббит аḳдамана вансурна `алал ḳаумил кафириин","Когда они показались перед Джалутом (Голиафом) и его войском, то сказали: «Господь наш! Пролей на нас терпение, укрепи наши стопы и помоги нам одержать победу над неверующими людьми».",["и когда","они выступили","против Джалута","и его войск","они сказали","Господь наш","излей","на нас","терпение","и укрепи","стопы наши","и помоги нам","против","людей","неверующих"]],[2,251,["فَهَزَمُوهُم","بِإِذۡنِ","ٱللَّهِ","وَقَتَلَ","دَاوُۥدُ","جَالُوتَ","وَءَاتَىٰهُ","ٱللَّهُ","ٱلۡمُلۡكَ","وَٱلۡحِكۡمَةَ","وَعَلَّمَهُۥ","مِمَّا","يَشَآءُۗ","وَلَوۡلَا","دَفۡعُ","ٱللَّهِ","ٱلنَّاسَ","بَعۡضَهُم","بِبَعۡضٖ","لَّفَسَدَتِ","ٱلۡأَرۡضُ","وَلَٰكِنَّ","ٱللَّهَ","ذُو","فَضۡلٍ","عَلَى","ٱلۡعَٰلَمِينَ"],"фахазамуухум би'изниллахи ваḳатала давууду жалуута ва'атахуллахул мулка валхикмата ва`алламахуу мимма йашау валаула даф`уллахин наса ба`дахум биба`дил лафасадатил арду валакинналлаха зуу фадлин `алал `аламиин","Они разгромили их по воле Аллаха. Давуд (Давид) убил Джалута (Голиафа), и Аллах даровал ему царство и мудрость и научил его тому, чему пожелал. Если бы Аллах не сдерживал одних людей посредством других, то земля пришла бы в расстройство. Однако Аллах милостив к мирам.",["и они разбили их","с дозволения","Аллаха","и убил","Давуд","Джалута","и даровал ему","Аллах","царство","и мудрость","и научил его","тому, чему","Он желает","и если бы не","отражение","Аллахом","людей","одних из них","другими","непременно пришла бы в расстройство","земля","но","Аллах","обладатель","милости","к","мирам"]],[2,252,["تِلۡكَ","ءَايَٰتُ","ٱللَّهِ","نَتۡلُوهَا","عَلَيۡكَ","بِٱلۡحَقِّۚ","وَإِنَّكَ","لَمِنَ","ٱلۡمُرۡسَلِينَ"],"тилка айатуллахи натлууха `алайка билхаḳḳи ва'иннака ламинал мурсалиин","Таковы аяты Аллаха. Мы читаем их тебе истинно, и ты - один из посланников.",["эти","аяты","Аллаха","Мы читаем их","тебе","с истиной","и поистине, ты","непременно из","посланников"]]],"m":[[["فَلَمَّا","а когда",2,249],["فَصَلَ","выступил",2,249],["طَالُوتُ","Талут",2,249],["بِٱلۡجُنُودِ","с войсками",2,249],["قَالَ","он сказал",2,249],["إِنَّ","поистине",2,249],["ٱللَّهَ","Аллах",2,249],["مُبۡتَلِيكُم","испытает вас",2,249]],[["بِنَهَرٖ","рекой",2,249],["فَمَن","так кто",2,249],["شَرِبَ","напился",2,249],["مِنۡهُ","из неё",2,249],["فَلَيۡسَ","то он не",2,249],["مِنِّي","из моих",2,249],["وَمَن","а кто",2,249],["لَّمۡ","не",2,249],["يَطۡعَمۡهُ","отведал её",2,249],["فَإِنَّهُۥ","то поистине, он",2,249]],[["مِنِّيٓ","из моих",2,249],["إِلَّا","кроме",2,249],["مَنِ","того, кто",2,249],["ٱغۡتَرَفَ","зачерпнул",2,249],["غُرۡفَةَۢ","пригоршню",2,249],["بِيَدِهِۦۚ","своей рукой",2,249],["فَشَرِبُواْ","и они напились",2,249],["مِنۡهُ","из неё",2,249],["إِلَّا","кроме",2,249],["قَلِيلٗا","немногих",2,249]],[["مِّنۡهُمۡۚ","из них",2,249],["فَلَمَّا","а когда",2,249],["جَاوَزَهُۥ","он перешёл её",2,249],["هُوَ","он",2,249],["وَٱلَّذِينَ","и те, которые",2,249],["ءَامَنُواْ","уверовали",2,249],["مَعَهُۥ","с ним",2,249],["قَالُواْ","они сказали",2,249]],[["لَا","нет",2,249],["طَاقَةَ","сил",2,249],["لَنَا","у нас",2,249],["ٱلۡيَوۡمَ","сегодня",2,249],["بِجَالُوتَ","против Джалута",2,249],["وَجُنُودِهِۦۚ","и его войск",2,249],["قَالَ","сказали",2,249],["ٱلَّذِينَ","те, которые",2,249]],[["يَظُنُّونَ","были уверены",2,249],["أَنَّهُم","что они",2,249],["مُّلَٰقُواْ","встретят",2,249],["ٱللَّهِ","Аллаха",2,2