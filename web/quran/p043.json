{"p":43,"j":3,"a":[[2,257,["ٱللَّهُ","وَلِيُّ","ٱلَّذِينَ","ءَامَنُواْ","يُخۡرِجُهُم","مِّنَ","ٱلظُّلُمَٰتِ","إِلَى","ٱلنُّورِۖ","وَٱلَّذِينَ","كَفَرُوٓاْ","أَوۡلِيَآؤُهُمُ","ٱلطَّٰغُوتُ","يُخۡرِجُونَهُم","مِّنَ","ٱلنُّورِ","إِلَى","ٱلظُّلُمَٰتِۗ","أُوْلَٰٓئِكَ","أَصۡحَٰبُ","ٱلنَّارِۖ","هُمۡ","فِيهَا","خَٰلِدُونَ"],"аллаху валиййул лазиина амануу йухрижухум миназ зулумати илан нуури валлазиина кафаруу аулийаухумут тагууту йухрижуунахум минан нуури илаз зулумати улаика асхабун нари хум фииха халидуун","Аллах - Покровитель тех, которые уверовали. Он выводит их из мраков к свету. А покровителями и помощниками неверующих являются тагуты, которые выводят их из света к мракам. Они являются обитателями Огня и пребудут там вечно.",["Аллах","Покровитель","тех, которые","уверовали","Он выводит их","из","мраков","к","свету","а те, которые","не уверовали","покровители их","тагут","они выводят их","из","света","к","мракам","те","обитатели","Огня","они","в нём","вечно пребывающие"]],[2,258,["أَلَمۡ","تَرَ","إِلَى","ٱلَّذِي","حَآجَّ","إِبۡرَٰهِـۧمَ","فِي","رَبِّهِۦٓ","أَنۡ","ءَاتَىٰهُ","ٱللَّهُ","ٱلۡمُلۡكَ","إِذۡ","قَالَ","إِبۡرَٰهِـۧمُ","رَبِّيَ","ٱلَّذِي","يُحۡيِۦ","وَيُمِيتُ","قَالَ","أَنَا۠","أُحۡيِۦ","وَأُمِيتُۖ","قَالَ","إِبۡرَٰهِـۧمُ","فَإِنَّ","ٱللَّهَ","يَأۡتِي","بِٱلشَّمۡسِ","مِنَ","ٱلۡمَشۡرِقِ","فَأۡتِ","بِهَا","مِنَ","ٱلۡمَغۡرِبِ","فَبُهِتَ","ٱلَّذِي","كَفَرَۗ","وَٱللَّهُ","لَا","يَهۡدِي","ٱلۡقَوۡمَ","ٱلظَّٰلِمِينَ"],"алам тара илал лазии хажжа ибрахиима фии раббихии ан атахуллахул мулка из ḳала ибрахииму раббийал лазии йухйии вайумииту ḳала ана ухйии ва'умииту ḳала ибрахииму фа'инналлаха йа'тии бишшамси минал машриḳи фа'ти биха минал магриби фабухитал лазии кафара валлаху ла йахдил ḳаумаз залимиин","Не знаешь ли ты о том, кто спорил с Ибрахимом (Авраамом) относительно его Господа, поскольку Аллах даровал ему царство? Ибрахим (Авраам) сказал ему: «Мой Господь - Тот, Кто дарует жизнь и умерщвляет». Он сказал: «Я дарую жизнь и умерщвляю». Ибрахим (Авраам) сказал: «Аллах заставляет солнце восходить на востоке. Заставь же его взойти на западе». И тогда тот, кто не уверовал, пришел в замешательство. Аллах не ведет прямым путем несправедливых людей.",["разве не","видел ты","к","тому, который","препирался","с Ибрахимом","о","Господе его","потому что","даровал ему","Аллах","царство","вот","сказал","Ибрахим","Господь мой","Тот, Который","оживляет","и умерщвляет","он сказал","я","оживляю","и умерщвляю","сказал","Ибрахим","то поистине","Аллах","приводит","солнце","с","востока","так приведи же","его","с","запада","и смутился","тот, который","не уверовал","и Аллах","не","ведёт прямым путём","людей","несправедливых"]],[2,259,["أَوۡ","كَٱلَّذِي","مَرَّ","عَلَىٰ","قَرۡيَةٖ","وَهِيَ","خَاوِيَةٌ","عَلَىٰ","عُرُوشِهَا","قَالَ","أَنَّىٰ","يُحۡيِۦ","هَٰذِهِ","ٱللَّهُ","بَعۡدَ","مَوۡتِهَاۖ","فَأَمَاتَهُ","ٱللَّهُ","مِاْئَةَ","عَامٖ","ثُمَّ","بَعَثَهُۥۖ","قَالَ","كَمۡ","لَبِثۡتَۖ","قَالَ","لَبِثۡتُ","يَوۡمًا","أَوۡ","بَعۡضَ","يَوۡمٖۖ","قَالَ","بَل","لَّبِثۡتَ","مِاْئَةَ","عَامٖ","فَٱنظُرۡ","إِلَىٰ","طَعَامِكَ","وَشَرَابِكَ","لَمۡ","يَتَسَنَّهۡۖ","وَٱنظُرۡ","إِلَىٰ","حِمَارِكَ","وَلِنَجۡعَلَكَ","ءَايَةٗ","لِّلنَّاسِۖ","وَٱنظُرۡ","إِلَى","ٱلۡعِظَامِ","كَيۡفَ","نُنشِزُهَا","ثُمَّ","نَكۡسُوهَا","لَحۡمٗاۚ","فَلَمَّا","تَبَيَّنَ","لَهُۥ","قَالَ","أَعۡلَمُ","أَنَّ","ٱللَّهَ","عَلَىٰ","كُلِّ","شَيۡءٖ","قَدِيرٞ"],"ау каллазии марра `ала ḳарйатин вахийа хавийатун `ала `уруушиха ḳала анна йухйии хазихиллаху ба`да маутиха фа'аматахуллаху миата `амин сумма ба`асахуу ḳала кам лабиста ḳала лабисту йауман ау ба`да йаумин ḳала бал лабиста миата `амин фанзур ила та`амика вашарабика лам йатасаннах ванзур ила химарика валинаж`алака айатал линнаси ванзур илал `изами кайфа нуншизуха сумма наксууха лахман фаламма табаййана лахуу ḳала а`ламу анналлаха `ала кулли шай'ин ḳадиир","Или над тем, кто проходил мимо селения, разрушенного до основания? Он сказал: «Как Аллах воскресит это после того, как все это умерло?». Аллах умертвил его на сто лет, а затем оживил и сказал: «Сколько ты пробыл здесь?». Он сказал: «Я пробыл день или часть дня». Он сказал: «Нет, ты пробыл сто лет. Посмотри на свою еду и воду: они даже не изменились. И посмотри на своего осла. Мы непременно сделаем тебя знамением для людей. Посмотри же, как Мы соберем кости, а затем покроем их мясом». Когда это было показано ему, он сказал: «Я знаю, что Аллах способен на всякую вещь».",["или","как тот, который","проходил","мимо","селения","а оно","рухнуло","на","кровли свои","он сказал","как","оживит","это","Аллах","после","смерти его","и умертвил его","Аллах","на сто","лет","затем","воскресил его","Он сказал","сколько","пробыл ты","он сказал","я пробыл","день","или","часть","дня","Он сказал","нет же","ты пробыл","сто","лет","посмотри же","на","пищу твою","и питьё твоё","не","испортились","и посмотри","на","осла твоего","и чтобы Мы сделали тебя","знамением","для людей","и посмотри","на","кости","как","Мы поднимаем их","затем","Мы облекаем их","мясом","и когда","стало ясно","ему","он сказал","я знаю","что","Аллах","над","всякой","вещью","властен"]]],"m":[[["ٱللَّهُ","Аллах",2,257],["وَلِيُّ","Покровитель",2,257],["ٱلَّذِينَ","тех, которые",2,257],["ءَامَنُواْ","уверовали",2,257],["يُخۡرِجُهُم","Он выводит их",2,257],["مِّنَ","из",2,257],["ٱلظُّلُمَٰتِ","мраков",2,257],["إِلَى","к",2,257],["ٱلنُّورِۖ","свету",2,257]],[["وَٱلَّذِينَ","а те, которые",2,257],["كَفَرُوٓاْ","не уверовали",2,257],["أَوۡلِيَآؤُهُمُ","покровители их",2,257],["ٱلطَّٰغُوتُ","тагут",2,257],["يُخۡرِجُونَهُم","они выводят их",2,257],["مِّنَ","из",2,257]],[["ٱلنُّورِ","света",2,257],["إِلَى","к",2,257],["ٱلظُّلُمَٰتِۗ","мракам",2,257],["أُوْلَٰٓئِكَ","те",2,257],["أَصۡحَٰبُ","обитатели",2,257],["ٱلنَّارِۖ","Огня",2,257],["هُمۡ","они",2,257],["فِيهَا","в нём",2,257]],[["خَٰلِدُونَ","вечно пребывающие",2,257],[257],["أَلَمۡ","разве не",2,258],["تَرَ","видел ты",2,258],["إِلَى","к",2,258],["ٱلَّذِي","тому, который",2,258],["حَآجَّ","препирался",2,258],["إِبۡرَٰهِـۧمَ","с Ибрахимом",2,258],["فِي","о",2,258],["رَب