{"p":44,"j":3,"a":[[2,260,["وَإِذۡ","قَالَ","إِبۡرَٰهِـۧمُ","رَبِّ","أَرِنِي","كَيۡفَ","تُحۡيِ","ٱلۡمَوۡتَىٰۖ","قَالَ","أَوَلَمۡ","تُؤۡمِنۖ","قَالَ","بَلَىٰ","وَلَٰكِن","لِّيَطۡمَئِنَّ","قَلۡبِيۖ","قَالَ","فَخُذۡ","أَرۡبَعَةٗ","مِّنَ","ٱلطَّيۡرِ","فَصُرۡهُنَّ","إِلَيۡكَ","ثُمَّ","ٱجۡعَلۡ","عَلَىٰ","كُلِّ","جَبَلٖ","مِّنۡهُنَّ","جُزۡءٗا","ثُمَّ","ٱدۡعُهُنَّ","يَأۡتِينَكَ","سَعۡيٗاۚ","وَٱعۡلَمۡ","أَنَّ","ٱللَّهَ","عَزِيزٌ","حَكِيمٞ"],"ва'из ḳала ибрахииму рабби аринии кайфа тухйил маута ḳала авалам ту'мин ḳала бала валакил лийатмаинна ḳалбии ḳала фахуз арба`атам минат тайри фасурхунна илайка суммаж`ал `ала кулли жабалим минхунна жуз'ан суммад`ухунна йа'тиинака са`йан ва`лам анналлаха `азиизун хакиим","Вот сказал Ибрахим (Авраам): «Господи! Покажи мне, как Ты оживляешь покойников». Он сказал: «Разве ты не веруешь?». Он сказал: «Конечно! Но я хочу, чтобы мое сердце успокоилось». Он сказал: «Возьми четырех птиц, зарежь их, прижав к себе, и положи по кусочку на каждом холме. А потом позови их, и они стремительно явятся к тебе. И знай, что Аллах - Могущественный, Мудрый».",["и вот","сказал","Ибрахим","Господи","покажи мне","как","Ты оживляешь","мёртвых","Он сказал","разве не","уверовал ты","он сказал","да","но","чтобы успокоилось","сердце моё","Он сказал","так возьми","четырёх","из","птиц","и приблизь их","к себе","затем","положи","на","каждый","холм","из них","часть","затем","позови их","они придут к тебе","стремительно","и знай","что","Аллах","Могущественный","Мудрый"]],[2,261,["مَّثَلُ","ٱلَّذِينَ","يُنفِقُونَ","أَمۡوَٰلَهُمۡ","فِي","سَبِيلِ","ٱللَّهِ","كَمَثَلِ","حَبَّةٍ","أَنۢبَتَتۡ","سَبۡعَ","سَنَابِلَ","فِي","كُلِّ","سُنۢبُلَةٖ","مِّاْئَةُ","حَبَّةٖۗ","وَٱللَّهُ","يُضَٰعِفُ","لِمَن","يَشَآءُۚ","وَٱللَّهُ","وَٰسِعٌ","عَلِيمٌ"],"ммасалул лазиина йунфиḳууна амвалахум фии сабиилиллахи камасали хаббатин амбатат саб`а санабила фии кулли сумбулатим миату хаббатин валлаху йуда`ифу лиман йашау валлаху васи`ун `алиим","Притчей о тех, кто расходует свое имущество на пути Аллаха, является притча о зерне, из которого выросло семь колосьев, и в каждом колосе - по сто зерен. Аллах увеличивает награду, кому пожелает. Аллах - Объемлющий, Знающий.",["пример","тех, которые","расходуют","имущество своё","на","пути","Аллаха","подобен примеру","зерна","взрастившего","семь","колосьев","в","каждом","колосе","сто","зёрен","и Аллах","умножает","тому, кому","Он желает","и Аллах","Объемлющий","Знающий"]],[2,262,["ٱلَّذِينَ","يُنفِقُونَ","أَمۡوَٰلَهُمۡ","فِي","سَبِيلِ","ٱللَّهِ","ثُمَّ","لَا","يُتۡبِعُونَ","مَآ","أَنفَقُواْ","مَنّٗا","وَلَآ","أَذٗى","لَّهُمۡ","أَجۡرُهُمۡ","عِندَ","رَبِّهِمۡ","وَلَا","خَوۡفٌ","عَلَيۡهِمۡ","وَلَا","هُمۡ","يَحۡزَنُونَ"],"аллазиина йунфиḳууна амвалахум фии сабиилиллахи сумма ла йутби`ууна ма анфаḳуу маннан вала азал лахум ажрухум `инда раббихим вала хауфун `алайхим вала хум йахзануун","Тем, кто расходует свое имущество на пути Аллаха и не сопровождает свои пожертвования попреками и оскорблениями, уготована награда у их Господа. Они не познают страха и не будут опечалены.",["те, которые","расходуют","имущество своё","на","пути","Аллаха","затем","не","сопровождают","то, что","они израсходовали","попрёком","и не","обидой","им","награда их","у","Господа их","и нет","страха","над ними","и не","они","будут опечалены"]],[2,263,["قَوۡلٞ","مَّعۡرُوفٞ","وَمَغۡفِرَةٌ","خَيۡرٞ","مِّن","صَدَقَةٖ","يَتۡبَعُهَآ","أَذٗىۗ","وَٱللَّهُ","غَنِيٌّ","حَلِيمٞ"],"ḳаулум ма`рууфун вамагфиратун хайрум мин садаḳатин йатба`уха азан валлаху ганиййун халиим","Доброе слово и прощение лучше милостыни, за которой следует обидный попрек. Аллах - Богатый, Выдержанный.",["слово","доброе","и прощение","лучше","чем","милостыня","за которой следует","обида","и Аллах","Богатый","Выдержанный"]],[2,264,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُواْ","لَا","تُبۡطِلُواْ","صَدَقَٰتِكُم","بِٱلۡمَنِّ","وَٱلۡأَذَىٰ","كَٱلَّذِي","يُنفِقُ","مَالَهُۥ","رِئَآءَ","ٱلنَّاسِ","وَلَا","يُؤۡمِنُ","بِٱللَّهِ","وَٱلۡيَوۡمِ","ٱلۡأٓخِرِۖ","فَمَثَلُهُۥ","كَمَثَلِ","صَفۡوَانٍ","عَلَيۡهِ","تُرَابٞ","فَأَصَابَهُۥ","وَابِلٞ","فَتَرَكَهُۥ","صَلۡدٗاۖ","لَّا","يَقۡدِرُونَ","عَلَىٰ","شَيۡءٖ","مِّمَّا","كَسَبُواْۗ","وَٱللَّهُ","لَا","يَهۡدِي","ٱلۡقَوۡمَ","ٱلۡكَٰفِرِينَ"],"йа'аййухал лазиина амануу ла тубтилуу садаḳатикум билманни вал'аза каллазии йунфиḳу малахуу ри'аан наси вала йу'мину биллахи валйаумил ахири фамасалухуу камасали сафванин `алайхи турабун фа'асабахуу вабилун фатаракахуу салдал ла йаḳдирууна `ала шай'им мимма касабуу валлаху ла йахдил ḳаумал кафириин","О те, которые уверовали! Не делайте ваши подаяния тщетными своими попреками и оскорблениями, подобно тому, кто расходует свое имущество ради показухи и не веруют при этом в Аллаха и в Последний день. Притчей о нем является притча о гладкой скале, покрытой слоем земли. Но вот выпал ливень и оставил скалу голой. Они не властны ни над чем из того, что приобрели. Аллах не ведет прямым путем неверующих людей.",["о вы","которые","уверовали","не","сводите на нет","милостыни ваши","попрёками","и обидой","подобно тому, кто","расходует","имущество своё","напоказ","людям","и не","верует","в Аллаха","и в день","последний","и пример его","подобен примеру","гладкой скалы","на ней","земля","и постиг её","ливень","и оставил её","голой","не","властны они","над","чем-либо","из того, что","они приобрели","и Аллах","не","ведёт прямым путём","людей","неверующих"]]],"m":[[["وَإِذۡ","и вот",2,260],["قَالَ","сказал",2,260],["إِبۡرَٰهِـۧمُ","Ибрахим",2,260],["رَبِّ","Господи",2,260],["أَرِنِي","покажи мне",2,260],["كَيۡفَ","как",2,260],["تُحۡيِ","Ты оживляешь",2,260],["ٱلۡمَوۡتَىٰۖ","мёртвых",2,260],["قَالَ","Он сказал",2,260],["أَوَلَمۡ","разве не",2,260]],[["تُؤۡمِنۖ","уверовал ты",2,260],["قَالَ","он сказал",2,260],["بَلَىٰ","да",2,260],["وَلَٰكِن","но",2,260],["لِّيَطۡمَئِنَّ","чтобы успокоилось",2,260],["قَلۡبِيۖ","сердце моё",2,260],["قَالَ","Он сказал",2,260],["فَخُذۡ","так возьми",2,260],["أَرۡبَعَةٗ","четырёх",2,260],["مِّنَ","из",2,260]],[["ٱلطَّيۡرِ","птиц",2,260],["فَصُرۡهُنَّ","и приблизь их",2,260],["إِلَ