{"p":45,"j":3,"a":[[2,265,["وَمَثَلُ","ٱلَّذِينَ","يُنفِقُونَ","أَمۡوَٰلَهُمُ","ٱبۡتِغَآءَ","مَرۡضَاتِ","ٱللَّهِ","وَتَثۡبِيتٗا","مِّنۡ","أَنفُسِهِمۡ","كَمَثَلِ","جَنَّةِۭ","بِرَبۡوَةٍ","أَصَابَهَا","وَابِلٞ","فَـَٔاتَتۡ","أُكُلَهَا","ضِعۡفَيۡنِ","فَإِن","لَّمۡ","يُصِبۡهَا","وَابِلٞ","فَطَلّٞۗ","وَٱللَّهُ","بِمَا","تَعۡمَلُونَ","بَصِيرٌ"],"вамасалул лазиина йунфиḳууна амвалахумубтигаа мардатиллахи ватасбиитам мин анфусихим камасали жаннати бирабватин асабаха вабилун фа'атат укулаха ди`файни фа'ил лам йусибха вабилун фаталлун валлаху бима та`малууна басиир","Притчей о тех, которые расходуют свое имущество, чтобы снискать довольство Аллаха и укрепить себя, является притча о саде на холме. Если его оросит ливень, он приносит плоды вдвойне. Если же его не оросит ливень, то ему бывает достаточно моросящего дождя. Аллах видит то, что вы совершаете.",["и пример","тех, которые","расходуют","имущество своё","стремясь к","довольству","Аллаха","и для укрепления","из","душ своих","подобен примеру","сада","на возвышенности","постиг его","ливень","и он принёс","плоды свои","вдвойне","а если","не","постигнет его","ливень","то морось","и Аллах","то, что","вы делаете","видит"]],[2,266,["أَيَوَدُّ","أَحَدُكُمۡ","أَن","تَكُونَ","لَهُۥ","جَنَّةٞ","مِّن","نَّخِيلٖ","وَأَعۡنَابٖ","تَجۡرِي","مِن","تَحۡتِهَا","ٱلۡأَنۡهَٰرُ","لَهُۥ","فِيهَا","مِن","كُلِّ","ٱلثَّمَرَٰتِ","وَأَصَابَهُ","ٱلۡكِبَرُ","وَلَهُۥ","ذُرِّيَّةٞ","ضُعَفَآءُ","فَأَصَابَهَآ","إِعۡصَارٞ","فِيهِ","نَارٞ","فَٱحۡتَرَقَتۡۗ","كَذَٰلِكَ","يُبَيِّنُ","ٱللَّهُ","لَكُمُ","ٱلۡأٓيَٰتِ","لَعَلَّكُمۡ","تَتَفَكَّرُونَ"],"айавадду ахадукум ан такууна лахуу жаннатум мин нахиилин ва'а`набин тажрии мин тахтихал анхару лахуу фииха мин куллис самарати ва'асабахул кибару валахуу зурриййатун ду`афау фа'асабаха и`сарун фиихи нарун фахтараḳат казалика йубаййинуллаху лакумул айати ла`аллакум татафаккаруун","Захочет ли кто-нибудь из вас, если у него будет сад из финиковых пальм и виноградника, в котором текут реки и растут всякие плоды, чтобы его сад был поражен огненным вихрем и сгорел, когда его постигнет старость, а его дети будут еще слабы? Так Аллах разъясняет вам знамения, - быть может, вы поразмыслите.",["разве желает","кто-либо из вас","чтобы","был","у него","сад","из","пальм","и виноградных лоз","текут","из","под ним","реки","у него","в нём","из","всех","плодов","и постигла его","старость","а у него","потомство","слабое","и постиг его (сад)","вихрь","в нём","огонь","и он сгорел","так","разъясняет","Аллах","вам","знамения","быть может, вы","поразмыслите"]],[2,267,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُوٓاْ","أَنفِقُواْ","مِن","طَيِّبَٰتِ","مَا","كَسَبۡتُمۡ","وَمِمَّآ","أَخۡرَجۡنَا","لَكُم","مِّنَ","ٱلۡأَرۡضِۖ","وَلَا","تَيَمَّمُواْ","ٱلۡخَبِيثَ","مِنۡهُ","تُنفِقُونَ","وَلَسۡتُم","بِـَٔاخِذِيهِ","إِلَّآ","أَن","تُغۡمِضُواْ","فِيهِۚ","وَٱعۡلَمُوٓاْ","أَنَّ","ٱللَّهَ","غَنِيٌّ","حَمِيدٌ"],"йа'аййухал лазиина амануу анфиḳуу мин таййибати ма касабтум вамимма ахражна лакум минал арди вала тайаммамул хабииса минху тунфиḳууна валастум би'ахизиихи илла ан тугмидуу фиихи ва`ламуу анналлаха ганиййун хамиид","О те, которые уверовали! Делайте пожертвования из приобретенных вами благ и того, что Мы взрастили для вас на земле, и не стремитесь раздать в качестве пожертвования дурное, чего бы вы сами не взяли, пока не зажмурили глаза. И знайте, что Аллах - Богатый, Достохвальный.",["о вы","которые","уверовали","расходуйте","из","благ","того, что","вы приобрели","и из того, что","Мы вывели","для вас","из","земли","и не","стремитесь","к дурному","из него","расходуя","а вы не","взяли бы его","кроме как","если","закроете глаза","на это","и знайте","что","Аллах","Богатый","Достохвальный"]],[2,268,["ٱلشَّيۡطَٰنُ","يَعِدُكُمُ","ٱلۡفَقۡرَ","وَيَأۡمُرُكُم","بِٱلۡفَحۡشَآءِۖ","وَٱللَّهُ","يَعِدُكُم","مَّغۡفِرَةٗ","مِّنۡهُ","وَفَضۡلٗاۗ","وَٱللَّهُ","وَٰسِعٌ","عَلِيمٞ"],"ашшайтану йа`идукумул фаḳра вайа'мурукум билфахшаи валлаху йа`идукум магфиратам минху вафадлан валлаху васи`ун `алиим","Дьявол угрожает вам бедностью и велит творить мерзость. Аллах же обещает вам прощение от Него и милость. Аллах - Объемлющий, Знающий.",["шайтан","обещает вам","бедность","и велит вам","мерзости","а Аллах","обещает вам","прощение","от Него","и милость","и Аллах","Объемлющий","Знающий"]],[2,269,["يُؤۡتِي","ٱلۡحِكۡمَةَ","مَن","يَشَآءُۚ","وَمَن","يُؤۡتَ","ٱلۡحِكۡمَةَ","فَقَدۡ","أُوتِيَ","خَيۡرٗا","كَثِيرٗاۗ","وَمَا","يَذَّكَّرُ","إِلَّآ","أُوْلُواْ","ٱلۡأَلۡبَٰبِ"],"йу'тил хикмата ман йашау ваман йу'тал хикмата фаḳад уутийа хайран касииран вама йаззаккару илла улул албаб","Он дарует мудрость, кому пожелает, и тот, кому дарована мудрость, награжден великим благом. Однако поминают назидание только обладающие разумом.",["Он дарует","мудрость","кому","Он желает","и кому","даруется","мудрость","то уже","даровано ему","благо","многое","и не","внемлют назиданию","кроме","обладателей","разума"]]],"m":[[["وَمَثَلُ","и пример",2,265],["ٱلَّذِينَ","тех, которые",2,265],["يُنفِقُونَ","расходуют",2,265],["أَمۡوَٰلَهُمُ","имущество своё",2,265],["ٱبۡتِغَآءَ","стремясь к",2,265],["مَرۡضَاتِ","довольству",2,265],["ٱللَّهِ","Аллаха",2,265]],[["وَتَثۡبِيتٗا","и для укрепления",2,265],["مِّنۡ","из",2,265],["أَنفُسِهِمۡ","душ своих",2,265],["كَمَثَلِ","подобен примеру",2,265],["جَنَّةِۭ","сада",2,265],["بِرَبۡوَةٍ","на возвышенности",2,265],["أَصَابَهَا","постиг его",2,265],["وَابِلٞ","ливень",2,265]],[["فَـَٔاتَتۡ","и он принёс",2,265],["أُكُلَهَا","плоды свои",2,265],["ضِعۡفَيۡنِ","вдвойне",2,265],["فَإِن","а если",2,265],["لَّمۡ","не",2,265],["يُصِبۡهَا","постигнет его",2,265],["وَابِلٞ","ливень",2,265],["فَطَلّٞۗ","то морось",2,265]],[["وَٱللَّهُ","и Аллах",2,265],["بِمَا","то, что",2,265],["تَعۡمَلُونَ","вы делаете",2,265],["بَصِيرٌ","видит",2,265],[265],["أَيَوَدُّ","разве желает",2,266],["أَحَدُكُمۡ","кто-либо из вас",2,266],["أَن","чтобы",2,266],["تَكُونَ","был",2,266]],[["لَهُۥ","у него",2,266],["جَنَّةٞ","сад",2,266],["مِّن","из",2,266],["نَّخِيلٖ","пальм",2,266],["وَأَعۡنَابٖ","и виноградных лоз",2,266],["تَجۡرِي","текут",2,266],["مِن","из",2,266],["تَحۡتِهَا","под ним",2,266],["ٱلۡأَنۡهَٰرُ","реки",2,266],["لَهُۥ","у него",2,266]],[["فِيهَا","в нём",2,266],["مِن","из",2,266],["كُلِّ","всех",2,266],["ٱلثَّمَرَٰتِ","плодов",2,266],["وَأَصَابَهُ","и постигла его",2,266],["ٱلۡكِبَرُ","старость",2,266],["وَلَهُۥ","а у него",2,266],["ذُرِّيَّةٞ","потомство",2,266],["ضُعَفَآءُ","слабое",2,266]],[["فَأَصَابَهَآ","и постиг его (сад)",2,266],["إِعۡصَارٞ","вихрь",2,266],["فِيهِ","в нём",2,266],["نَارٞ","огонь",2,266],["فَٱحۡتَرَقَتۡۗ","и он сгорел",2,266],["كَذَٰلِكَ","так",2,266],["يُبَيِّنُ","разъясняет",2,266],["ٱللَّهُ","Аллах",2,266]],[["لَكُمُ","вам",2,266],["ٱلۡأٓيَٰتِ","знамения",2,266],["لَعَلَّكُمۡ","быть может, вы",2,266],["تَتَفَكَّرُونَ","поразмыслите",2,266],[266],["يَٰٓأَيُّهَا","о вы",2,267],["ٱلَّذِينَ","которые",2,267]],[["ءَامَنُوٓاْ","уверовали",2,267],["أَنفِقُواْ","расходуйте",2,267],["مِن","из",2,267],["طَيِّبَٰتِ","благ",2,267],["مَا","того, что",2,267],["كَسَبۡتُمۡ","вы приобрели",2,267],["وَمِمَّآ","и из того, что",2,267],["أَخۡرَجۡنَا","Мы вывели",2,267]],[["لَكُم","для вас",2,267],["مِّنَ","из",2,267],["ٱلۡأَرۡضِۖ","земли",2,267],["وَلَا","и не",2,267],["تَيَمَّمُواْ","стремитесь",2,267],["ٱلۡخَبِيثَ","к дурному",2,267],["مِنۡهُ","из него",2,267],["تُنفِقُونَ","расходуя",2,267],["وَلَسۡتُم","а вы не",2,267]],[["بِـَٔاخِذِيهِ","взяли бы его",2,267],["إِلَّآ","кроме как",2,267],["أَن","если",2,267],["تُغۡمِضُواْ","закроете глаза",2,267],["فِيهِۚ","на это",2,267],["وَٱعۡلَمُوٓاْ","и знайте",2,267],["أَنَّ","что",2,267],["ٱللَّهَ","Аллах",2,267],["غَنِيٌّ","Богатый",2,267],["حَمِيدٌ","Достохвальный",2,267]],[[267],["ٱلشَّيۡطَٰنُ","шайтан",2,268],["يَعِدُكُمُ","обещает вам",2,268],["ٱلۡفَقۡرَ","бедность",2,268],["وَيَأۡمُرُكُم","и велит вам",2,268],["بِٱلۡفَحۡشَآءِۖ","мерзости",2,268]],[["وَٱللَّهُ","а Аллах",2,268],["يَعِدُكُم","обещает вам",2,268],["مَّغۡفِرَةٗ","прощение",2,268],["مِّنۡهُ","от Него",2,268],["وَفَضۡلٗاۗ","и милость",2,268],["وَٱللَّهُ","