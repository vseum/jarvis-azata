{"p":46,"j":3,"a":[[2,270,["وَمَآ","أَنفَقۡتُم","مِّن","نَّفَقَةٍ","أَوۡ","نَذَرۡتُم","مِّن","نَّذۡرٖ","فَإِنَّ","ٱللَّهَ","يَعۡلَمُهُۥۗ","وَمَا","لِلظَّٰلِمِينَ","مِنۡ","أَنصَارٍ"],"вама анфаḳтум мин нафаḳатин ау назартум мин назрин фа'инналлаха йа`ламухуу вама лиззалимиина мин ансар","Что бы вы ни потратили, какой бы обет вы ни дали, Аллах знает об этом. Но для беззаконников нет помощников.",["и что бы","вы ни израсходовали","из","расходов","или","ни дали обет","из","обетов","то поистине","Аллах","знает это","и нет","у беззаконников","никаких","помощников"]],[2,271,["إِن","تُبۡدُواْ","ٱلصَّدَقَٰتِ","فَنِعِمَّا","هِيَۖ","وَإِن","تُخۡفُوهَا","وَتُؤۡتُوهَا","ٱلۡفُقَرَآءَ","فَهُوَ","خَيۡرٞ","لَّكُمۡۚ","وَيُكَفِّرُ","عَنكُم","مِّن","سَيِّـَٔاتِكُمۡۗ","وَٱللَّهُ","بِمَا","تَعۡمَلُونَ","خَبِيرٞ"],"ин тубдус садаḳати фани`имма хийа ва'ин тухфууха вату'туухал фуḳараа фахуа хайрул лакум вайукаффиру `анкум мин саййиатикум валлаху бима та`малууна хабиир","Если вы раздаете милостыню открыто, то это прекрасно. Но если вы скрываете это и раздаете ее неимущим, то это еще лучше для вас. Он простит вам некоторые из ваших прегрешений. Аллах ведает о том, что вы совершаете.",["если","вы открываете","милостыни","то прекрасно","это","а если","вы скрываете их","и даёте их","бедным","то это","лучше","для вас","и Он простит","вам","(часть) из","дурных дел ваших","и Аллах","о том, что","вы делаете","сведущ"]],[2,272,["لَّيۡسَ","عَلَيۡكَ","هُدَىٰهُمۡ","وَلَٰكِنَّ","ٱللَّهَ","يَهۡدِي","مَن","يَشَآءُۗ","وَمَا","تُنفِقُواْ","مِنۡ","خَيۡرٖ","فَلِأَنفُسِكُمۡۚ","وَمَا","تُنفِقُونَ","إِلَّا","ٱبۡتِغَآءَ","وَجۡهِ","ٱللَّهِۚ","وَمَا","تُنفِقُواْ","مِنۡ","خَيۡرٖ","يُوَفَّ","إِلَيۡكُمۡ","وَأَنتُمۡ","لَا","تُظۡلَمُونَ"],"ллайса `алайка худахум валакинналлаха йахдии ман йашау вама тунфиḳуу мин хайрин фалианфусикум вама тунфиḳууна иллабтигаа важхиллахи вама тунфиḳуу мин хайрин йуаффа илайкум ва'антум ла тузламуун","Вести их прямым путем - не твоя обязанность, ибо Аллах ведет прямым путем, кого пожелает. Все, что вы расходуете, идет на пользу вам самим. Вы расходуете это только из стремления к Лику Аллаха. Какое бы добро вы ни израсходовали, вам воздастся сполна, и с вами не поступят несправедливо.",["не","на тебе","их руководство","но","Аллах","ведёт прямым путём","кого","Он желает","и что бы","вы ни израсходовали","из","блага","то для вас самих","и не","вы расходуете","кроме как","стремясь к","Лику","Аллаха","и что бы","вы ни израсходовали","из","блага","будет воздано сполна","вам","а вы","не","будете обижены"]],[2,273,["لِلۡفُقَرَآءِ","ٱلَّذِينَ","أُحۡصِرُواْ","فِي","سَبِيلِ","ٱللَّهِ","لَا","يَسۡتَطِيعُونَ","ضَرۡبٗا","فِي","ٱلۡأَرۡضِ","يَحۡسَبُهُمُ","ٱلۡجَاهِلُ","أَغۡنِيَآءَ","مِنَ","ٱلتَّعَفُّفِ","تَعۡرِفُهُم","بِسِيمَٰهُمۡ","لَا","يَسۡـَٔلُونَ","ٱلنَّاسَ","إِلۡحَافٗاۗ","وَمَا","تُنفِقُواْ","مِنۡ","خَيۡرٖ","فَإِنَّ","ٱللَّهَ","بِهِۦ","عَلِيمٌ"],"лилфуḳараил лазиина ухсируу фии сабиилиллахи ла йастатии`ууна дарбан фил арди йахсабухумул жахилу агнийаа минат та`аффуфи та`рифухум бисиимахум ла йас'алуунан наса илхафан вама тунфиḳуу мин хайрин фа'инналлаха бихии `алиим","Милостыня полагается неимущим, которые задержаны на пути Аллаха или не могут передвигаться по земле. Неосведомленный считает их богачами по причине их скромности. Ты узнаешь их по приметам: они не выпрашивают у людей милостыню настойчиво. Какое бы добро вы ни израсходовали, Аллах знает об этом.",["для бедных","которые","задержаны","на","пути","Аллаха","не","могут они","передвигаться","по","земле","считает их","несведущий","богатыми","из-за","скромности","ты узнаешь их","по приметам их","не","просят они","людей","настойчиво","и что бы","вы ни израсходовали","из","блага","то поистине","Аллах","о нём","знающий"]],[2,274,["ٱلَّذِينَ","يُنفِقُونَ","أَمۡوَٰلَهُم","بِٱلَّيۡلِ","وَٱلنَّهَارِ","سِرّٗا","وَعَلَانِيَةٗ","فَلَهُمۡ","أَجۡرُهُمۡ","عِندَ","رَبِّهِمۡ","وَلَا","خَوۡفٌ","عَلَيۡهِمۡ","وَلَا","هُمۡ","يَحۡزَنُونَ"],"аллазиина йунфиḳууна амвалахум биллайли ваннахари сирран ва`аланийатан фалахум ажрухум `инда раббихим вала хауфун `алайхим вала хум йахзануун","Тем, кто расходует свое имущество ночью и днем, тайно и явно, уготована награда у их Господа. Они не познают страха и не будут опечалены.",["те, которые","расходуют","имущество своё","ночью","и днём","тайно","и открыто","то им","награда их","у","Господа их","и нет","страха","над ними","и не","они","будут опечалены"]]],"m":[[["وَمَآ","и что бы",2,270],["أَنفَقۡتُم","вы ни израсходовали",2,270],["مِّن","из",2,270],["نَّفَقَةٍ","расходов",2,270],["أَوۡ","или",2,270],["نَذَرۡتُم","ни дали обет",2,270],["مِّن","из",2,270],["نَّذۡرٖ","обетов",2,270],["فَإِنَّ","то поистине",2,270],["ٱللَّهَ","Аллах",2,270]],[["يَعۡلَمُهُۥۗ","знает это",2,270],["وَمَا","и нет",2,270],["لِلظَّٰلِمِينَ","у беззаконников",2,270],["مِنۡ","никаких",2,270],["أَنصَارٍ","помощников",2,270],[270],["إِن","если",2,271],["تُبۡدُواْ","вы открываете",2,271]],[["ٱلصَّدَقَٰتِ","милостыни",2,271],["فَنِعِمَّا","то прекрасно",2,271],["هِيَۖ","это",2,271],["وَإِن","а если",2,271],["تُخۡفُوهَا","вы скрываете их",2,271],["وَتُؤۡتُوهَا","и даёте их",2,271],["ٱلۡفُقَرَآءَ","бедным",2,271]],[["فَهُوَ","то это",2,271],["خَيۡرٞ","лучше",2,271],["لَّكُمۡۚ","для вас",2,271],["وَيُكَفِّرُ","и Он простит",2,271],["عَنكُم","вам",2,271],["مِّن","(часть) из",2,271],["سَيِّـَٔاتِكُمۡۗ","дурных дел ваших",2,271]],[["وَٱللَّهُ","и Аллах",2,271],["بِمَا","о том, что",2,271],["تَعۡمَلُونَ","вы делаете",2,271],["خَبِيرٞ","сведущ",2,271],[271],["۞ لَّيۡسَ","не",2,272],["عَلَيۡكَ","на тебе",2,272],["هُدَىٰهُمۡ","их руководство",2,272]],[["وَلَٰكِنَّ","но",2,272],["ٱللَّهَ","Аллах",2,272],["يَهۡدِي","ведёт прямым путём",2,272],["مَن","кого",2,272],["يَشَآءُۗ","Он желает",2,272],["وَمَا","и что бы",2,272],["تُنفِقُواْ","вы ни израсходовали",2,272],["مِنۡ","из",2,272],["خَيۡرٖ","блага",2,272]],[["فَلِأَنفُسِكُمۡۚ","то для вас самих",2,272],["وَمَا","и не",2,272],["تُنفِقُونَ","вы расходуете",2,272],["إِلَّا","кроме как",2,272],["ٱبۡتِغَآءَ","стремясь к",2,272],["وَجۡه