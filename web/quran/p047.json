{"p":47,"j":3,"a":[[2,275,["ٱلَّذِينَ","يَأۡكُلُونَ","ٱلرِّبَوٰاْ","لَا","يَقُومُونَ","إِلَّا","كَمَا","يَقُومُ","ٱلَّذِي","يَتَخَبَّطُهُ","ٱلشَّيۡطَٰنُ","مِنَ","ٱلۡمَسِّۚ","ذَٰلِكَ","بِأَنَّهُمۡ","قَالُوٓاْ","إِنَّمَا","ٱلۡبَيۡعُ","مِثۡلُ","ٱلرِّبَوٰاْۗ","وَأَحَلَّ","ٱللَّهُ","ٱلۡبَيۡعَ","وَحَرَّمَ","ٱلرِّبَوٰاْۚ","فَمَن","جَآءَهُۥ","مَوۡعِظَةٞ","مِّن","رَّبِّهِۦ","فَٱنتَهَىٰ","فَلَهُۥ","مَا","سَلَفَ","وَأَمۡرُهُۥٓ","إِلَى","ٱللَّهِۖ","وَمَنۡ","عَادَ","فَأُوْلَٰٓئِكَ","أَصۡحَٰبُ","ٱلنَّارِۖ","هُمۡ","فِيهَا","خَٰلِدُونَ"],"аллазиина йа'кулуунар рибава ла йаḳуумууна илла кама йаḳуумул лазии йатахаббатухуш шайтану минал масси залика би'аннахум ḳалуу иннамал бай`у мислур рибава ва'ахаллаллахул бай`а вахаррамар рибава фаман жаахуу мау`изатум мир раббихии фантаха фалахуу ма салафа ва'амрухуу илаллахи ваман `ада фа'улаика асхабун нари хум фииха халидуун","Те, которые пожирают лихву, восстанут, как восстает тот, кого дьявол поверг своим прикосновением. Это потому, что они говорили: «Воистину, торговля подобна лихоимству». Но Аллах дозволил торговлю и запретил лихоимство. Если кто-нибудь из них после того, как к нему явится увещевание от его Господа, прекратит, то ему будет прощено то, что было прежде, и его дело будет в распоряжении Аллаха. А кто вернется к этому, те станут обитателями Огня, в котором они пребудут вечно.",["те, которые","пожирают","лихву","не","встанут","кроме как","подобно тому, как","встаёт","тот, кого","повергает","шайтан","от","прикосновения","это","потому, что они","сказали","лишь","торговля","подобна","лихве","но дозволил","Аллах","торговлю","и запретил","лихву","и кто","пришло к нему","увещевание","от","Господа его","и он прекратил","то ему","то, что","было прежде","и дело его","к","Аллаху","а кто","вернулся","то те","обитатели","Огня","они","в нём","вечно пребывающие"]],[2,276,["يَمۡحَقُ","ٱللَّهُ","ٱلرِّبَوٰاْ","وَيُرۡبِي","ٱلصَّدَقَٰتِۗ","وَٱللَّهُ","لَا","يُحِبُّ","كُلَّ","كَفَّارٍ","أَثِيمٍ"],"йамхаḳуллахур рибава вайурбис садаḳати валлаху ла йухиббу кулла каффарин асиим","Аллах уничтожает лихву и приумножает пожертвования. Аллах не любит всяких неблагодарных (или неверующих) грешников.",["уничтожает","Аллах","лихву","и приумножает","милостыни","и Аллах","не","любит","всякого","неблагодарного","грешника"]],[2,277,["إِنَّ","ٱلَّذِينَ","ءَامَنُواْ","وَعَمِلُواْ","ٱلصَّٰلِحَٰتِ","وَأَقَامُواْ","ٱلصَّلَوٰةَ","وَءَاتَوُاْ","ٱلزَّكَوٰةَ","لَهُمۡ","أَجۡرُهُمۡ","عِندَ","رَبِّهِمۡ","وَلَا","خَوۡفٌ","عَلَيۡهِمۡ","وَلَا","هُمۡ","يَحۡزَنُونَ"],"иннал лазиина амануу ва`амилус салихати ва'аḳамус салавата ва'атавуз закавата лахум ажрухум `инда раббихим вала хауфун `алайхим вала хум йахзануун","Воистину, тем, которые уверовали и вершили праведные деяния, совершали намаз и выплачивали закят, уготована награда у их Господа. Они не познают страха и не будут опечалены.",["поистине","те, которые","уверовали","и совершали","праведные дела","и выстаивали","намаз","и давали","закят","им","награда их","у","Господа их","и нет","страха","над ними","и не","они","будут опечалены"]],[2,278,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُواْ","ٱتَّقُواْ","ٱللَّهَ","وَذَرُواْ","مَا","بَقِيَ","مِنَ","ٱلرِّبَوٰٓاْ","إِن","كُنتُم","مُّؤۡمِنِينَ"],"йа'аййухал лазиина амануттаḳуллаха вазаруу ма баḳийа минар рибава ин кунтум му'миниин","О те, которые уверовали! Бойтесь Аллаха и не берите оставшуюся часть лихвы, если только вы являетесь верующими.",["о вы","которые","уверовали","бойтесь","Аллаха","и оставьте","то, что","осталось","из","лихвы","если","вы являетесь","верующими"]],[2,279,["فَإِن","لَّمۡ","تَفۡعَلُواْ","فَأۡذَنُواْ","بِحَرۡبٖ","مِّنَ","ٱللَّهِ","وَرَسُولِهِۦۖ","وَإِن","تُبۡتُمۡ","فَلَكُمۡ","رُءُوسُ","أَمۡوَٰلِكُمۡ","لَا","تَظۡلِمُونَ","وَلَا","تُظۡلَمُونَ"],"фа'ил лам таф`алуу фа'зануу бихарбим миналлахи варасуулихии ва'ин тубтум фалакум ру'уусу амваликум ла тазлимууна вала тузламуун","Но если вы не сделаете этого, то знайте, что Аллах и Его Посланник объявляют вам войну. А если вы раскаетесь, то вам останется ваш первоначальный капитал. Вы не поступите несправедливо, и с вами не поступят несправедливо.",["а если","не","сделаете","то знайте","о войне","от","Аллаха","и Посланника Его","а если","вы покаетесь","то вам","основной капитал","имуществ ваших","не","обидите вы","и не","будете обижены"]],[2,280,["وَإِن","كَانَ","ذُو","عُسۡرَةٖ","فَنَظِرَةٌ","إِلَىٰ","مَيۡسَرَةٖۚ","وَأَن","تَصَدَّقُواْ","خَيۡرٞ","لَّكُمۡ","إِن","كُنتُمۡ","تَعۡلَمُونَ"],"ва'ин кана зуу `усратин фаназиратун ила майсаратин ва'ан тасаддаḳуу хайрул лакум ин кунтум та`ламуун","Если должник находится в трудном положении, то дайте ему отсрочку, пока его положение не улучшится. Но дать милостыню будет лучше для вас, если бы вы только знали!",["и если","будет","обладающий","затруднением","то отсрочка","до","облегчения","а то, что","подадите милостыню","лучше","для вас","если","вы","знаете"]],[2,281,["وَٱتَّقُواْ","يَوۡمٗا","تُرۡجَعُونَ","فِيهِ","إِلَى","ٱللَّهِۖ","ثُمَّ","تُوَفَّىٰ","كُلُّ","نَفۡسٖ","مَّا","كَسَبَتۡ","وَهُمۡ","لَا","يُظۡلَمُونَ"],"ваттаḳуу йауман туржа`ууна фиихи илаллахи сумма туаффа куллу нафсим ма касабат вахум ла йузламуун","Бойтесь того дня, когда вы будете возвращены к Аллаху. Тогда каждый человек сполна получит то, что приобрел, и с ними не поступят несправедливо.",["и бойтесь","дня","вы будете возвращены","в который","к","Аллаху","затем","будет воздано сполна","каждой","душе","то, что","она приобрела","и они","не","будут обижены"]]],"m":[[["ٱلَّذِينَ","те, которые",2,275],["يَأۡكُلُونَ","пожирают",2,275],["ٱلرِّبَوٰاْ","лихву",2,275],["لَا","не",2,275],["يَقُومُونَ","встанут",2,275],["إِلَّا","кроме как",2,275],["كَمَا","подобно тому, как",2,275],["يَقُومُ","встаёт",2,275],["ٱلَّذِي","тот, кого",2,275]],[["يَتَخَبَّطُهُ","повергает",2,275],["ٱلشَّيۡطَٰنُ","шайтан",2,275],["مِنَ","от",2,275],["ٱلۡمَسِّۚ","прикосновения",2,275],["ذَٰلِكَ","это",2,275],["بِأَنَّهُمۡ","потому, что они",2,275],["قَالُوٓاْ","сказали",2,275],["إِنَّمَا","лишь",2,275],["ٱلۡبَيۡعُ","торговля",2,275]],[["مِثۡلُ","подобна",2,275],["ٱلرِّبَوٰا