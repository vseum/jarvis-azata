{"p":50,"j":3,"a":[[3,1,["الٓمٓ"],"лм","Алиф. Лам. Мим.",["Алиф Лям Мим"]],[3,2,["ٱللَّهُ","لَآ","إِلَٰهَ","إِلَّا","هُوَ","ٱلۡحَيُّ","ٱلۡقَيُّومُ"],"аллаху ла илаха илла хуал хаййул ḳаййуум","Аллах - нет божества, кроме Него, Живого, Вседержителя.",["Аллах","нет","божества","кроме","Него","Живого","Вседержителя"]],[3,3,["نَزَّلَ","عَلَيۡكَ","ٱلۡكِتَٰبَ","بِٱلۡحَقِّ","مُصَدِّقٗا","لِّمَا","بَيۡنَ","يَدَيۡهِ","وَأَنزَلَ","ٱلتَّوۡرَىٰةَ","وَٱلۡإِنجِيلَ"],"наззала `алайкал китаба билхаḳḳи мусаддиḳал лима байна йадайхи ва'анзалат таурата вал'инжиил","Он ниспослал тебе Писание с истиной в подтверждение того, что было до него. Он ниспослал Таурат (Тору) и Инджил (Евангелие),",["ниспослал Он","тебе","Писание","с истиной","подтверждающим","то, что","перед","ним","и ниспослал Он","Таурат","и Инджил"]],[3,4,["مِن","قَبۡلُ","هُدٗى","لِّلنَّاسِ","وَأَنزَلَ","ٱلۡفُرۡقَانَۗ","إِنَّ","ٱلَّذِينَ","كَفَرُواْ","بِـَٔايَٰتِ","ٱللَّهِ","لَهُمۡ","عَذَابٞ","شَدِيدٞۗ","وَٱللَّهُ","عَزِيزٞ","ذُو","ٱنتِقَامٍ"],"мин ḳаблу худал линнаси ва'анзалал фурḳана иннал лазиина кафаруу би'айатиллахи лахум `азабун шадиидун валлаху `азиизун зунтиḳам","которые прежде были руководством для людей. Он также ниспослал Различение (Коран). Воистину, тем, кто не верует в знамения Аллаха, уготованы тяжкие мучения, ведь Аллах - Могущественный, Способный на возмездие.",["до","(этого)","руководством","для людей","и ниспослал Он","Различение","поистине","те, которые","не уверовали","в знамения","Аллаха","им","наказание","суровое","и Аллах","Могущественный","обладатель","возмездия"]],[3,5,["إِنَّ","ٱللَّهَ","لَا","يَخۡفَىٰ","عَلَيۡهِ","شَيۡءٞ","فِي","ٱلۡأَرۡضِ","وَلَا","فِي","ٱلسَّمَآءِ"],"инналлаха ла йахфа `алайхи шай'ун фил арди вала фис сама","Воистину, ничто не скроется от Аллаха ни на земле, ни на небесах.",["поистине","Аллах","не","скрыто","от Него","что-либо","на","земле","и не","на","небе"]],[3,6,["هُوَ","ٱلَّذِي","يُصَوِّرُكُمۡ","فِي","ٱلۡأَرۡحَامِ","كَيۡفَ","يَشَآءُۚ","لَآ","إِلَٰهَ","إِلَّا","هُوَ","ٱلۡعَزِيزُ","ٱلۡحَكِيمُ"],"хуал лазии йусаввирукум фил архами кайфа йашау ла илаха илла хуал `азиизул хакиим","Он - Тот, Кто придает вам в утробах такой облик, какой пожелает. Нет божества, кроме Него, Могущественного, Мудрого.",["Он","Тот, Который","придаёт вам облик","в","утробах","как","пожелает Он","нет","божества","кроме","Него","Могущественного","Мудрого"]],[3,7,["هُوَ","ٱلَّذِيٓ","أَنزَلَ","عَلَيۡكَ","ٱلۡكِتَٰبَ","مِنۡهُ","ءَايَٰتٞ","مُّحۡكَمَٰتٌ","هُنَّ","أُمُّ","ٱلۡكِتَٰبِ","وَأُخَرُ","مُتَشَٰبِهَٰتٞۖ","فَأَمَّا","ٱلَّذِينَ","فِي","قُلُوبِهِمۡ","زَيۡغٞ","فَيَتَّبِعُونَ","مَا","تَشَٰبَهَ","مِنۡهُ","ٱبۡتِغَآءَ","ٱلۡفِتۡنَةِ","وَٱبۡتِغَآءَ","تَأۡوِيلِهِۦۖ","وَمَا","يَعۡلَمُ","تَأۡوِيلَهُۥٓ","إِلَّا","ٱللَّهُۗ","وَٱلرَّٰسِخُونَ","فِي","ٱلۡعِلۡمِ","يَقُولُونَ","ءَامَنَّا","بِهِۦ","كُلّٞ","مِّنۡ","عِندِ","رَبِّنَاۗ","وَمَا","يَذَّكَّرُ","إِلَّآ","أُوْلُواْ","ٱلۡأَلۡبَٰبِ"],"хуал лазии анзала `алайкал китаба минху айатум мухкаматун хунна уммул китаби ва'ухару муташабихатун фа'аммал лазиина фии ḳулуубихим зайгун файаттаби`ууна ма ташабаха минхубтигаал фитнати вабтигаа та'виилихии вама йа`ламу та'виилахуу иллаллаху варрасихууна фил `илми йаḳуулууна аманна бихии куллум мин `инди раббина вама йаззаккару илла улул албаб","Он - Тот, Кто ниспослал тебе Писание, в котором есть ясно изложенные аяты, составляющие мать Писания, а также другие аяты, являющиеся иносказательными. Те, чьи сердца уклоняются в сторону, следуют за иносказательными аятами, желая посеять смуту и добиться толкования, хотя толкования этого не знает никто, кроме Аллаха. А обладающие основательными знаниями говорят: «Мы уверовали в него (в Коран). Все это - от нашего Господа». Но поминают назидание только обладающие разумом.",["Он","Тот, Который","ниспослал","тебе","Писание","в нём","аяты","ясные","они","мать","Писания","и другие","иносказательные","что же до","тех, которые","в","сердцах их","уклонение","то следуют они","тому, что","иносказательно","из него","стремясь к","смуте","и стремясь к","толкованию его","и не","знает","толкования его","кроме","Аллаха","и утверждённые","в","знании","говорят","уверовали мы","в него","всё","от","(у)","Господа нашего","и не","внемлют назиданию","кроме","обладающих","разумом"]],[3,8,["رَبَّنَا","لَا","تُزِغۡ","قُلُوبَنَا","بَعۡدَ","إِذۡ","هَدَيۡتَنَا","وَهَبۡ","لَنَا","مِن","لَّدُنكَ","رَحۡمَةًۚ","إِنَّكَ","أَنتَ","ٱلۡوَهَّابُ"],"раббана ла тузиг ḳулуубана ба`да из хадайтана вахаб лана мил ладунка рахматан иннака антал ваххаб","Господь наш! Не уклоняй наши сердца в сторону после того, как Ты наставил нас на прямой путь, и даруй нам милость от Себя, ведь Ты - Дарующий!",["Господь наш","не","уклоняй","сердца наши","после","того как","наставил Ты нас","и даруй","нам","от","Себя","милость","поистине Ты","Ты","Дарующий"]],[3,9,["رَبَّنَآ","إِنَّكَ","جَامِعُ","ٱلنَّاسِ","لِيَوۡمٖ","لَّا","رَيۡبَ","فِيهِۚ","إِنَّ","ٱللَّهَ","لَا","يُخۡلِفُ","ٱلۡمِيعَادَ"],"раббана иннака жами`ун наси лийаумил ла райба фиихи инналлаха ла йухлифул мии`ад","Господь наш! Ты соберешь людей в день, в котором нет сомнения. Воистину, Аллах не нарушает обещания.",["Господь наш","поистине Ты","Собирающий","людей","в день","нет","сомнения","в нём","поистине","Аллах","не","нарушает","обещания"]]],"m":[["h",3],["b"],[["الٓمٓ","Алиф Лям Мим",3,1],[1],["ٱللَّهُ","Аллах",3,2],["لَآ","нет",3,2],["إِلَٰهَ","божества",3,2],["إِلَّا","кроме",3,2],["هُوَ","Него",3,2],["ٱلۡحَيُّ","Живого",3,2],["ٱلۡقَيُّومُ","Вседержителя",3,2],[2],["نَزَّلَ","ниспослал Он",3,3],["عَلَيۡكَ","тебе",3,3],["ٱلۡكِتَٰبَ","Писание",3,3]],[["بِٱلۡحَقِّ","с истиной",3,3],["مُصَدِّقٗا","подтверждающим",3,3],["لِّمَا","то, что",3,3],["بَيۡنَ","перед",3,3],["يَدَيۡهِ","ним",3,3],["وَأَنزَلَ","и ниспослал Он",3,3],["ٱلتَّوۡرَىٰةَ","Таурат",3,3],["وَٱلۡإِنجِيلَ","и Инджил",3,3],[3],["مِن","до",3,4]],[["قَبۡلُ","(этого)",3,4],["هُدٗى","руководством",3,4],["لِّلنَّاسِ","для людей",3,4],["وَأَنزَلَ","и ниспослал Он",3,4],["ٱلۡفُرۡقَانَۗ","Различение",3,4],["إِنَّ","поистине",3,4],["ٱلَّذِينَ","те, котор