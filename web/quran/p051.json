{"p":51,"j":3,"a":[[3,10,["إِنَّ","ٱلَّذِينَ","كَفَرُواْ","لَن","تُغۡنِيَ","عَنۡهُمۡ","أَمۡوَٰلُهُمۡ","وَلَآ","أَوۡلَٰدُهُم","مِّنَ","ٱللَّهِ","شَيۡـٔٗاۖ","وَأُوْلَٰٓئِكَ","هُمۡ","وَقُودُ","ٱلنَّارِ"],"иннал лазиина кафаруу лан тугнийа `анхум амвалухум вала ауладухум миналлахи шай'ан ва'улаика хум ваḳуудун нар","Ни богатство, ни дети ничем не помогут перед Аллахом тем, кто не уверовал. Они являются растопкой для Огня.",["поистине","те, которые","не уверовали","никогда не","помогут","им","богатства их","и не","дети их","перед","Аллахом","ничуть","и те","они","топливо","Огня"]],[3,11,["كَدَأۡبِ","ءَالِ","فِرۡعَوۡنَ","وَٱلَّذِينَ","مِن","قَبۡلِهِمۡۚ","كَذَّبُواْ","بِـَٔايَٰتِنَا","فَأَخَذَهُمُ","ٱللَّهُ","بِذُنُوبِهِمۡۗ","وَٱللَّهُ","شَدِيدُ","ٱلۡعِقَابِ"],"када'би али фир`ауна валлазиина мин ḳаблихим каззабуу би'айатина фа'ахазахумуллаху бизунуубихим валлаху шадиидул `иḳаб","Таким же образом вели себя сородичи Фараона и те, которые жили до них. Они сочли ложью Наши знамения, и Аллах схватил их за грехи, ведь Аллах суров в наказании.",["подобно обычаю","рода","Фараона","и тех, которые","(были)","до них","сочли ложью они","Наши знамения","и схватил их","Аллах","за грехи их","и Аллах","суров","в наказании"]],[3,12,["قُل","لِّلَّذِينَ","كَفَرُواْ","سَتُغۡلَبُونَ","وَتُحۡشَرُونَ","إِلَىٰ","جَهَنَّمَۖ","وَبِئۡسَ","ٱلۡمِهَادُ"],"ḳул лиллазиина кафаруу сатуглабууна ватухшарууна ила жаханнама ваби'сал михад","Скажи тем, которые не уверовали: «Вы будете побеждены и собраны в Геенне. Как же скверно это ложе!».",["скажи","тем, которые","не уверовали","вы будете побеждены","и будете собраны","к","Геенне","и скверно","ложе"]],[3,13,["قَدۡ","كَانَ","لَكُمۡ","ءَايَةٞ","فِي","فِئَتَيۡنِ","ٱلۡتَقَتَاۖ","فِئَةٞ","تُقَٰتِلُ","فِي","سَبِيلِ","ٱللَّهِ","وَأُخۡرَىٰ","كَافِرَةٞ","يَرَوۡنَهُم","مِّثۡلَيۡهِمۡ","رَأۡيَ","ٱلۡعَيۡنِۚ","وَٱللَّهُ","يُؤَيِّدُ","بِنَصۡرِهِۦ","مَن","يَشَآءُۚ","إِنَّ","فِي","ذَٰلِكَ","لَعِبۡرَةٗ","لِّأُوْلِي","ٱلۡأَبۡصَٰرِ"],"ḳад кана лакум айатун фии фи'атайнил таḳата фи'атун туḳатилу фии сабиилиллахи ва'ухра кафиратун йараунахум мислайхим ра'йал `айни валлаху йу'аййиду бинасрихии ман йашау инна фии залика ла`ибратал ли'улил абсар","Знамением для вас стали две армии при Бадре: одна армия сражалась на пути Аллаха, другая же состояла из неверующих. Своими глазами они увидели, что неверующие вдвое превышают их числом. Аллах оказывает поддержку тому, кому пожелает. Воистину, в этом есть назидание для обладающих зрением.",["уже","было","вам","знамение","в","двух отрядах","встретившихся","отряд","сражается","на","пути","Аллаха","и другой","неверующий","видели они их","вдвое больше их","взглядом","глаз","и Аллах","поддерживает","помощью Своей","кого","пожелает Он","поистине","в","этом","непременно назидание","для обладающих","зрением"]],[3,14,["زُيِّنَ","لِلنَّاسِ","حُبُّ","ٱلشَّهَوَٰتِ","مِنَ","ٱلنِّسَآءِ","وَٱلۡبَنِينَ","وَٱلۡقَنَٰطِيرِ","ٱلۡمُقَنطَرَةِ","مِنَ","ٱلذَّهَبِ","وَٱلۡفِضَّةِ","وَٱلۡخَيۡلِ","ٱلۡمُسَوَّمَةِ","وَٱلۡأَنۡعَٰمِ","وَٱلۡحَرۡثِۗ","ذَٰلِكَ","مَتَٰعُ","ٱلۡحَيَوٰةِ","ٱلدُّنۡيَاۖ","وَٱللَّهُ","عِندَهُۥ","حُسۡنُ","ٱلۡمَـَٔابِ"],"зуййина линнаси хуббуш шахавати минан нисаи валбаниина валḳанатиирил муḳантарати миназ захаби валфиддати валхайлил мусаввамати вал'ан`ами валхарси залика мата`ул хайаватид дунйа валлаху `индахуу хуснул мааб","Приукрашена для людей любовь к удовольствиям, доставляемым женщинами, сыновьями, накопленными кантарами золота и серебра, прекрасными конями, скотиной и нивами. Таково преходящее удовольствие мирской жизни, но у Аллаха есть лучшее место возвращения.",["приукрашена","для людей","любовь","к страстям","из","женщин","и сыновей","и кантаров","накопленных","из","золота","и серебра","и коней","меченых","и скота","и нив","это","пользование","жизни","ближней","а Аллах","у Него","прекрасное","возвращение"]],[3,15,["قُلۡ","أَؤُنَبِّئُكُم","بِخَيۡرٖ","مِّن","ذَٰلِكُمۡۖ","لِلَّذِينَ","ٱتَّقَوۡاْ","عِندَ","رَبِّهِمۡ","جَنَّٰتٞ","تَجۡرِي","مِن","تَحۡتِهَا","ٱلۡأَنۡهَٰرُ","خَٰلِدِينَ","فِيهَا","وَأَزۡوَٰجٞ","مُّطَهَّرَةٞ","وَرِضۡوَٰنٞ","مِّنَ","ٱللَّهِۗ","وَٱللَّهُ","بَصِيرُۢ","بِٱلۡعِبَادِ"],"ḳул а'унаббиукум бихайрим мин заликум лиллазиинаттаḳау `инда раббихим жаннатун тажрии мин тахтихал анхару халидиина фииха ва'азважум мутаххаратун варидванум миналлахи валлаху басииру бил`ибад","Скажи: «Рассказать ли вам о том, что лучше этого? Для тех, кто богобоязнен, у Господа есть Райские сады, в которых текут реки, и в которых они пребудут вечно, а также очищенные супруги и довольство от Аллаха». Аллах видит рабов,",["скажи","сообщить ли вам","о лучшем","чем","это","для тех, которые","были богобоязненны","у","Господа их","сады","текут","из","под ними","реки","вечно пребывающие","в них","и супруги","очищенные","и довольство","от","Аллаха","и Аллах","видит","рабов"]]],"m":[[["إِنَّ","поистине",3,10],["ٱلَّذِينَ","те, которые",3,10],["كَفَرُواْ","не уверовали",3,10],["لَن","никогда не",3,10],["تُغۡنِيَ","помогут",3,10],["عَنۡهُمۡ","им",3,10],["أَمۡوَٰلُهُمۡ","богатства их",3,10],["وَلَآ","и не",3,10],["أَوۡلَٰدُهُم","дети их",3,10]],[["مِّنَ","перед",3,10],["ٱللَّهِ","Аллахом",3,10],["شَيۡـٔٗاۖ","ничуть",3,10],["وَأُوْلَٰٓئِكَ","и те",3,10],["هُمۡ","они",3,10],["وَقُودُ","топливо",3,10],["ٱلنَّارِ","Огня",3,10],[10],["كَدَأۡبِ","подобно обычаю",3,11],["ءَالِ","рода",3,11]],[["فِرۡعَوۡنَ","Фараона",3,11],["وَٱلَّذِينَ","и тех, которые",3,11],["مِن","(были)",3,11],["قَبۡلِهِمۡۚ","до них",3,11],["كَذَّبُواْ","сочли ложью они",3,11],["بِـَٔايَٰتِنَا","Наши знамения",3,11],["فَأَخَذَهُمُ","и схватил их",3,11],["ٱللَّهُ","Аллах",3,11],["بِذُنُوبِهِمۡۗ","за грехи их",3,11]],[["وَٱللَّهُ","и Аллах",3,11],["شَدِيدُ","суров",3,11],["ٱلۡعِقَابِ","в наказании",3,11],[11],["قُل","скажи",3,12],["لِّلَّذِينَ","тем, которые",3,12],["كَفَرُواْ","не уверовали",3,12],["سَتُغۡلَبُونَ","вы будете побеждены",3,12]],[["وَتُحۡشَرُونَ","и будете собраны",3,12],["إِلَىٰ","к",3,12],["جَهَنَّمَۖ","Геенне",3,12],["وَبِئۡسَ","и скверно",3,12],["ٱلۡمِهَادُ","ложе",3,12],[12],["قَدۡ","уже",3,13],["كَان