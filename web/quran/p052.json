{"p":52,"j":3,"a":[[3,16,["ٱلَّذِينَ","يَقُولُونَ","رَبَّنَآ","إِنَّنَآ","ءَامَنَّا","فَٱغۡفِرۡ","لَنَا","ذُنُوبَنَا","وَقِنَا","عَذَابَ","ٱلنَّارِ"],"аллазиина йаḳуулууна раббана иннана аманна фагфир лана зунуубана ваḳина `азабан нар","которые говорят: «Господь наш! Воистину, мы уверовали. Прости же нам наши грехи и защити нас от мучений в Огне».",["те, которые","говорят","Господь наш","поистине мы","уверовали","прости же","нам","грехи наши","и защити нас","от наказания","Огня"]],[3,17,["ٱلصَّٰبِرِينَ","وَٱلصَّٰدِقِينَ","وَٱلۡقَٰنِتِينَ","وَٱلۡمُنفِقِينَ","وَٱلۡمُسۡتَغۡفِرِينَ","بِٱلۡأَسۡحَارِ"],"ассабириина вассадиḳиина валḳанитиина валмунфиḳиина валмустагфириина бил'асхар","Они терпеливы, правдивы, смиренны, делают пожертвования и просят прощения перед рассветом.",["терпеливые","и правдивые","и смиренные","и расходующие","и просящие прощения","перед рассветом"]],[3,18,["شَهِدَ","ٱللَّهُ","أَنَّهُۥ","لَآ","إِلَٰهَ","إِلَّا","هُوَ","وَٱلۡمَلَٰٓئِكَةُ","وَأُوْلُواْ","ٱلۡعِلۡمِ","قَآئِمَۢا","بِٱلۡقِسۡطِۚ","لَآ","إِلَٰهَ","إِلَّا","هُوَ","ٱلۡعَزِيزُ","ٱلۡحَكِيمُ"],"шахидаллаху аннахуу ла илаха илла хуа валмалаикату ва'улул `илми ḳаима билḳисти ла илаха илла хуал `азиизул хакиим","Аллах засвидетельствовал, что нет божества, кроме Него, а также ангелы и обладающие знанием. Он поддерживает справедливость. Нет божества, кроме Него, Могущественного, Мудрого.",["засвидетельствовал","Аллах","что Он","нет","божества","кроме","Него","и ангелы","и обладающие","знанием","поддерживая","справедливость","нет","божества","кроме","Него","Могущественного","Мудрого"]],[3,19,["إِنَّ","ٱلدِّينَ","عِندَ","ٱللَّهِ","ٱلۡإِسۡلَٰمُۗ","وَمَا","ٱخۡتَلَفَ","ٱلَّذِينَ","أُوتُواْ","ٱلۡكِتَٰبَ","إِلَّا","مِنۢ","بَعۡدِ","مَا","جَآءَهُمُ","ٱلۡعِلۡمُ","بَغۡيَۢا","بَيۡنَهُمۡۗ","وَمَن","يَكۡفُرۡ","بِـَٔايَٰتِ","ٱللَّهِ","فَإِنَّ","ٱللَّهَ","سَرِيعُ","ٱلۡحِسَابِ"],"иннад диина `индаллахил исламу вамахталафал лазиина уутул китаба илла мим ба`ди ма жаахумул `илму багйа байнахум ваман йакфур би'айатиллахи фа'инналлаха сарии`ул хисаб","Воистину, религией у Аллаха является ислам. Те, кому было даровано Писание, впали в разногласия только после того, как к ним явилось знание, по причине зависти и несправедливого отношения друг к другу. Если кто не уверовал в знамения Аллаха, то ведь Аллах скор на расчет.",["поистине","религия","у","Аллаха","ислам","и не","разошлись","те, которым","было даровано","Писание","кроме как","от","после","того как","пришло к ним","знание","из зависти","между собой","и кто","не уверует","в знамения","Аллаха","то поистине","Аллах","скор","в расчёте"]],[3,20,["فَإِنۡ","حَآجُّوكَ","فَقُلۡ","أَسۡلَمۡتُ","وَجۡهِيَ","لِلَّهِ","وَمَنِ","ٱتَّبَعَنِۗ","وَقُل","لِّلَّذِينَ","أُوتُواْ","ٱلۡكِتَٰبَ","وَٱلۡأُمِّيِّـۧنَ","ءَأَسۡلَمۡتُمۡۚ","فَإِنۡ","أَسۡلَمُواْ","فَقَدِ","ٱهۡتَدَواْۖ","وَّإِن","تَوَلَّوۡاْ","فَإِنَّمَا","عَلَيۡكَ","ٱلۡبَلَٰغُۗ","وَٱللَّهُ","بَصِيرُۢ","بِٱلۡعِبَادِ"],"фа'ин хажжуука фаḳул асламту важхийа лиллахи ваманиттаба`ани ваḳул лиллазиина уутул китаба вал'уммиййиина а'асламтум фа'ин асламуу фаḳадихтадав вва'ин таваллау фа'иннама `алайкал балагу валлаху басииру бил`ибад","Если они станут препираться с тобой, то скажи: «Я подчинил свой лик Аллаху вместе с теми, кто последовал за мной». Скажи тем, кому даровано Писание, а также необразованным людям: «Обратились ли вы в ислам?». Если они обратятся в ислам, то последуют прямым путем. Если же они отвернутся, то ведь на тебя возложена только передача откровения. Аллах видит рабов.",["и если","будут препираться с тобой","то скажи","подчинил я","лик мой","Аллаху","и тот, кто","последовал за мной","и скажи","тем, которым","было даровано","Писание","и неграмотным","покорились ли вы","и если","покорятся они","то уже","последовали прямым путём","а если","отвернутся","то лишь","на тебе","передача","и Аллах","видит","рабов"]],[3,21,["إِنَّ","ٱلَّذِينَ","يَكۡفُرُونَ","بِـَٔايَٰتِ","ٱللَّهِ","وَيَقۡتُلُونَ","ٱلنَّبِيِّـۧنَ","بِغَيۡرِ","حَقّٖ","وَيَقۡتُلُونَ","ٱلَّذِينَ","يَأۡمُرُونَ","بِٱلۡقِسۡطِ","مِنَ","ٱلنَّاسِ","فَبَشِّرۡهُم","بِعَذَابٍ","أَلِيمٍ"],"иннал лазиина йакфурууна би'айатиллахи вайаḳтулуунан набиййиина бигайри хаḳḳин вайаḳтулуунал лазиина йа'мурууна билḳисти минан наси фабашширхум би`азабин алиим","Тех, которые не веруют в знамения Аллаха, и убивают пророков, не имея на это никакого права, и убивают тех из людей, которые повелевают поступать справедливо, обрадуй мучительными страданиями.",["поистине","те, которые","не веруют","в знамения","Аллаха","и убивают","пророков","без","права","и убивают","тех, которые","повелевают","справедливость","из","людей","обрадуй же их","наказанием","мучительным"]],[3,22,["أُوْلَٰٓئِكَ","ٱلَّذِينَ","حَبِطَتۡ","أَعۡمَٰلُهُمۡ","فِي","ٱلدُّنۡيَا","وَٱلۡأٓخِرَةِ","وَمَا","لَهُم","مِّن","نَّٰصِرِينَ"],"улаикал лазиина хабитат а`малухум фид дунйа вал'ахирати вама лахум мин насириин","Их деяния окажутся тщетными в этом мире и в Последней жизни, и не будет у них помощников.",["они","те, которые","тщетны стали","деяния их","в","этом мире","и Последней жизни","и нет","у них","никаких","помощников"]]],"m":[[["ٱلَّذِينَ","те, которые",3,16],["يَقُولُونَ","говорят",3,16],["رَبَّنَآ","Господь наш",3,16],["إِنَّنَآ","поистине мы",3,16],["ءَامَنَّا","уверовали",3,16],["فَٱغۡفِرۡ","прости же",3,16],["لَنَا","нам",3,16],["ذُنُوبَنَا","грехи наши",3,16],["وَقِنَا","и защити нас",3,16]],[["عَذَابَ","от наказания",3,16],["ٱلنَّارِ","Огня",3,16],[16],["ٱلصَّٰبِرِينَ","терпеливые",3,17],["وَٱلصَّٰدِقِينَ","и правдивые",3,17],["وَٱلۡقَٰنِتِينَ","и смиренные",3,17]],[["وَٱلۡمُنفِقِينَ","и расходующие",3,17],["وَٱلۡمُسۡتَغۡفِرِينَ","и просящие прощения",3,17],["بِٱلۡأَسۡحَارِ","перед рассветом",3,17],[17],["شَهِدَ","засвидетельствовал",3,18]],[["ٱللَّهُ","Аллах",3,18],["أَنَّهُۥ","что Он",3,18],["لَآ","нет",3,18],["إِلَٰهَ","божества",3,18],["إِلَّا","кроме",3,18],["هُوَ","Него",3,18],["وَٱلۡمَلَٰٓئِكَةُ","и ангелы",3,18],["وَأُوْلُواْ","и обладающие",3,18],["ٱلۡعِلۡمِ","знанием",3,18],["قَآئِمَۢا","поддерживая",3,18],["بِٱلۡقِسۡطِۚ","с