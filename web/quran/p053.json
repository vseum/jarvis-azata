{"p":53,"j":3,"a":[[3,23,["أَلَمۡ","تَرَ","إِلَى","ٱلَّذِينَ","أُوتُواْ","نَصِيبٗا","مِّنَ","ٱلۡكِتَٰبِ","يُدۡعَوۡنَ","إِلَىٰ","كِتَٰبِ","ٱللَّهِ","لِيَحۡكُمَ","بَيۡنَهُمۡ","ثُمَّ","يَتَوَلَّىٰ","فَرِيقٞ","مِّنۡهُمۡ","وَهُم","مُّعۡرِضُونَ"],"алам тара илал лазиина уутуу насиибам минал китаби йуд`ауна ила китабиллахи лийахкума байнахум сумма йатавалла фарииḳум минхум вахум му`ридуун","Разве ты не видел, что тех, кому была дарована часть Писания, призывают к Писанию Аллаха, дабы оно рассудило между ними, но часть из них отворачивается с отвращением?",["разве не","видел ты","на","тех, которым","было даровано","часть","из","Писания","призываются они","к","Писанию","Аллаха","чтобы рассудило","между ними","затем","отворачивается","группа","из них","и они","отвращающиеся"]],[3,24,["ذَٰلِكَ","بِأَنَّهُمۡ","قَالُواْ","لَن","تَمَسَّنَا","ٱلنَّارُ","إِلَّآ","أَيَّامٗا","مَّعۡدُودَٰتٖۖ","وَغَرَّهُمۡ","فِي","دِينِهِم","مَّا","كَانُواْ","يَفۡتَرُونَ"],"залика би'аннахум ḳалуу лан тамассанан нару илла аййамам ма`дуудатин вагаррахум фии диинихим ма кануу йафтаруун","Это потому, что они говорят: «Огонь коснется нас лишь на считанные дни!». Их обольстило в их религии то, что они измышляли.",["это","потому что они","сказали","никогда не","коснётся нас","Огонь","кроме как","дни","считанные","и обольстило их","в","религии их","то, что","были они","измышляющими"]],[3,25,["فَكَيۡفَ","إِذَا","جَمَعۡنَٰهُمۡ","لِيَوۡمٖ","لَّا","رَيۡبَ","فِيهِ","وَوُفِّيَتۡ","كُلُّ","نَفۡسٖ","مَّا","كَسَبَتۡ","وَهُمۡ","لَا","يُظۡلَمُونَ"],"факайфа иза жама`нахум лийаумил ла райба фиихи вавуффийат куллу нафсим ма касабат вахум ла йузламуун","А что произойдет, когда Мы соберем их в тот день, в котором нет сомнения, когда каждая душа сполна получит то, что она приобрела, и когда с ними не поступят несправедливо?",["и как же (будет)","когда","соберём Мы их","в день","нет","сомнения","в нём","и сполна будет воздано","каждой","душе","то, что","приобрела она","и они","не","будут обижены"]],[3,26,["قُلِ","ٱللَّهُمَّ","مَٰلِكَ","ٱلۡمُلۡكِ","تُؤۡتِي","ٱلۡمُلۡكَ","مَن","تَشَآءُ","وَتَنزِعُ","ٱلۡمُلۡكَ","مِمَّن","تَشَآءُ","وَتُعِزُّ","مَن","تَشَآءُ","وَتُذِلُّ","مَن","تَشَآءُۖ","بِيَدِكَ","ٱلۡخَيۡرُۖ","إِنَّكَ","عَلَىٰ","كُلِّ","شَيۡءٖ","قَدِيرٞ"],"ḳулиллахумма маликал мулки ту'тил мулка ман ташау ватанзи`ул мулка мимман ташау вату`иззу ман ташау ватузиллу ман ташау бийадикал хайру иннака `ала кулли шай'ин ḳадиир","Скажи: «О Аллах, Владыка царства! Ты даруешь власть, кому пожелаешь, и отнимаешь власть, у кого пожелаешь. Ты возвеличиваешь, кого пожелаешь, и унижаешь, кого пожелаешь. Все благо - в Твоей Руке. Воистину, Ты способен на всякую вещь.",["скажи","о Аллах","Владыка","царства","даруешь Ты","власть","кому","пожелаешь Ты","и отнимаешь Ты","власть","у кого","пожелаешь Ты","и возвеличиваешь Ты","кого","пожелаешь Ты","и унижаешь Ты","кого","пожелаешь Ты","в руке Твоей","благо","поистине Ты","над","всякой","вещью","всемогущ"]],[3,27,["تُولِجُ","ٱلَّيۡلَ","فِي","ٱلنَّهَارِ","وَتُولِجُ","ٱلنَّهَارَ","فِي","ٱلَّيۡلِۖ","وَتُخۡرِجُ","ٱلۡحَيَّ","مِنَ","ٱلۡمَيِّتِ","وَتُخۡرِجُ","ٱلۡمَيِّتَ","مِنَ","ٱلۡحَيِّۖ","وَتَرۡزُقُ","مَن","تَشَآءُ","بِغَيۡرِ","حِسَابٖ"],"туулижул лайла фин нахари ватуулижун нахара фил лайли ватухрижул хаййа минал маййити ватухрижул маййита минал хаййи ватарзуḳу ман ташау бигайри хисаб","Ты удлиняешь день за счет ночи и удлиняешь ночь за счет дня. Ты выводишь живое из мертвого и выводишь мертвое из живого. Ты даруешь удел без счета, кому пожелаешь».",["вводишь Ты","ночь","в","день","и вводишь Ты","день","в","ночь","и выводишь Ты","живое","из","мёртвого","и выводишь Ты","мёртвое","из","живого","и наделяешь Ты","кого","пожелаешь Ты","без","счёта"]],[3,28,["لَّا","يَتَّخِذِ","ٱلۡمُؤۡمِنُونَ","ٱلۡكَٰفِرِينَ","أَوۡلِيَآءَ","مِن","دُونِ","ٱلۡمُؤۡمِنِينَۖ","وَمَن","يَفۡعَلۡ","ذَٰلِكَ","فَلَيۡسَ","مِنَ","ٱللَّهِ","فِي","شَيۡءٍ","إِلَّآ","أَن","تَتَّقُواْ","مِنۡهُمۡ","تُقَىٰةٗۗ","وَيُحَذِّرُكُمُ","ٱللَّهُ","نَفۡسَهُۥۗ","وَإِلَى","ٱللَّهِ","ٱلۡمَصِيرُ"],"лла йаттахизил му'минуунал кафириина аулийаа мин дуунил му'миниина ваман йаф`ал залика фалайса миналлахи фии шай'ин илла ан таттаḳуу минхум туḳатан вайухаззирукумуллаху нафсахуу ва'илаллахил масиир","Верующие не должны считать неверующих своими помощниками и друзьями вместо верующих. А кто поступает так, тот не имеет никакого отношения к Аллаху, за исключением тех случаев, когда вы действительно опасаетесь их. Аллах предостерегает вас от Самого Себя, и к Аллаху предстоит прибытие.",["пусть не","берут","верующие","неверующих","помощниками","из","помимо","верующих","и кто","сделает","это","то нет ему","от","Аллаха","в","чём-либо","кроме","как","опасаетесь вы","от них","осторожностью","и предостерегает вас","Аллах","(от) Самого Себя","и к","Аллаху","возвращение"]],[3,29,["قُلۡ","إِن","تُخۡفُواْ","مَا","فِي","صُدُورِكُمۡ","أَوۡ","تُبۡدُوهُ","يَعۡلَمۡهُ","ٱللَّهُۗ","وَيَعۡلَمُ","مَا","فِي","ٱلسَّمَٰوَٰتِ","وَمَا","فِي","ٱلۡأَرۡضِۗ","وَٱللَّهُ","عَلَىٰ","كُلِّ","شَيۡءٖ","قَدِيرٞ"],"ḳул ин тухфуу ма фии судуурикум ау тубдууху йа`ламхуллаху вайа`ламу ма фис самавати вама фил арди валлаху `ала кулли шай'ин ḳадиир","Скажи: «Скроете ли вы то, что у вас в груди, или обнародуете, Аллах все равно знает об этом. Он знает о том, что на небесах и на земле. Аллах способен на всякую вещь».",["скажи","если","скроете","то, что","в","груди вашей","или","обнаружите это","знает это","Аллах","и знает Он","то, что","на","небесах","и то, что","на","земле","и Аллах","над","всякой","вещью","всемогущ"]]],"m":[[["أَلَمۡ","разве не",3,23],["تَرَ","видел ты",3,23],["إِلَى","на",3,23],["ٱلَّذِينَ","тех, которым",3,23],["أُوتُواْ","было даровано",3,23],["نَصِيبٗا","часть",3,23],["مِّنَ","из",3,23],["ٱلۡكِتَٰبِ","Писания",3,23],["يُدۡعَوۡنَ","призываются они",3,23],["إِلَىٰ","к",3,23],["كِتَٰبِ","Писанию",3,23]],[["ٱللَّهِ","Аллаха",3,23],["لِيَحۡكُمَ","чтобы рассудило",3,23],["بَيۡنَهُمۡ","между ними",3,23],["ثُمَّ","затем",3,23],["يَتَوَلَّىٰ","отворачивается",3,23],["فَرِيقٞ","группа",3,23],["مِّنۡهُمۡ","из них",3,23],["وَهُم","и они",3,23],["مُّعۡرِضُونَ","отвращающиеся",3,23],[23]],[["ذَٰلِكَ","это",3,24],["بِأَنَّهُمۡ","потому что они",3,24],["قَالُواْ","сказали",3,24],["لَن","никогда не",3,24],["تَمَسَّنَا","коснётся нас",3,24],["ٱلنَّارُ","Огонь",3,24],["إِلَّآ","кроме как",3,24],["أَيَّامٗا","дни",3,24],["مَّعۡدُودَٰتٖۖ","считанные",3,24],["وَغَرَّهُمۡ","и обольстило их",3,24]],[["فِي","в",3,24],["دِينِهِم","религии их",3,24],["مَّا","то, что",3,24],["كَانُواْ","были они",3,24],["يَفۡتَرُونَ","измышляющими",3,24],[24],["فَكَيۡفَ","и как же (будет)",3,25],["إِذَا","когда",3,25],["جَمَعۡنَٰهُمۡ","соберём Мы их",3,25]],[["لِيَوۡمٖ","в день",3,25],["لَّا","нет",3,25],["رَيۡبَ","сомнения",3,25],["فِيهِ","в нём",3,25],["وَوُفِّيَتۡ","и сполна будет воздано",3,25],["كُلُّ","каждой",3,25],["نَفۡسٖ","душе",3,25],["مَّا","то, что",3,25],["كَسَبَتۡ","приобрела она",3,25],["وَهُمۡ","и они",3,25]],[["لَا","не",3,25],["يُظۡلَمُونَ","будут обижены",3,25],[25],["قُلِ","скажи",3,26],["ٱللَّهُمَّ","о Аллах",3,26],["مَٰلِكَ","Владыка",3,26],["ٱلۡمُلۡكِ","царства",3,26],["تُؤۡتِي","даруешь Ты",3,26],["ٱلۡمُلۡكَ","власть",3,26]],[["مَن","кому",3,26],["تَشَآءُ","пожелаешь Ты",3,26],["وَتَنزِعُ","и отнимаешь Ты",3,26],["ٱلۡمُلۡكَ","власть",3,26],["مِمَّن","у кого",3,26],["تَشَآءُ","пожелаешь Ты",3,26],["وَتُعِزُّ","и возвеличиваешь Ты",3,26],["مَن","кого",3,26],["تَشَآءُ","пожелаешь Ты",3,26],["وَتُذِلُّ","и унижаешь Ты",3,26]],[["مَن","кого",3,26],["تَشَآءُۖ","пожелаешь Ты",3,26],["بِيَدِكَ","в руке Твоей",3,26],["ٱلۡخَيۡرُۖ","благо",3,26],["إِنَّكَ","поистине Ты",3,26],["عَلَىٰ","над",3,26],["كُلِّ","всякой",3,26],["شَيۡءٖ","вещью",3,26],["قَدِيرٞ","всемогущ",3,26],[26],["تُولِجُ","вводишь Ты",3,27],["ٱلَّيۡلَ","ночь",3,27]],[["فِي","в",3,27],["ٱلنَّهَارِ","день",3,27],["وَتُولِجُ","и вводишь Ты",3,27],["ٱلنَّهَارَ","день",3,27],["فِي","в",3,27],["ٱلَّيۡلِۖ","ночь",3,27],["وَتُخۡرِجُ","и выводишь Ты",3,27],["ٱلۡحَيَّ","живое",3,27],["مِنَ","из",3,27],["ٱلۡمَيِّتِ","мёртвого",3,27]]