{"p":55,"j":3,"a":[[3,38,["هُنَالِكَ","دَعَا","زَكَرِيَّا","رَبَّهُۥۖ","قَالَ","رَبِّ","هَبۡ","لِي","مِن","لَّدُنكَ","ذُرِّيَّةٗ","طَيِّبَةًۖ","إِنَّكَ","سَمِيعُ","ٱلدُّعَآءِ"],"хуналика да`а закариййа раббахуу ḳала рабби хаб лии мил ладунка зурриййатан таййибатан иннака самии`уд ду`а","Тогда Закария (Захария) воззвал к своему Господу, сказав: «Господи! Одари меня прекрасным потомством от Себя, ведь Ты внимаешь мольбе».",["тогда","воззвал","Закария","к Господу своему","сказал он","Господи","даруй","мне","от","Себя","потомство","благое","поистине Ты","Слышащий","мольбы"]],[3,39,["فَنَادَتۡهُ","ٱلۡمَلَٰٓئِكَةُ","وَهُوَ","قَآئِمٞ","يُصَلِّي","فِي","ٱلۡمِحۡرَابِ","أَنَّ","ٱللَّهَ","يُبَشِّرُكَ","بِيَحۡيَىٰ","مُصَدِّقَۢا","بِكَلِمَةٖ","مِّنَ","ٱللَّهِ","وَسَيِّدٗا","وَحَصُورٗا","وَنَبِيّٗا","مِّنَ","ٱلصَّٰلِحِينَ"],"фанадатхул малаикату вахуа ḳаимун йусаллии фил михраби анналлаха йубашширука бийахйа мусаддиḳа бикалиматим миналлахи васаййидан вахасууран ванабиййам минас салихиин","Когда он стоял на молитве в молельне, ангелы воззвали к нему: «Аллах радует тебя вестью о Йахье (Иоанне), который подтвердит Слово от Аллаха и будет господином, воздержанным мужем и пророком из числа праведников».",["и воззвали к нему","ангелы","когда он","стоял","молясь","в","молельне","что","Аллах","радует тебя вестью","о Йахье","подтверждающим","Слово","от","Аллаха","и господином","и воздержанным","и пророком","из","праведников"]],[3,40,["قَالَ","رَبِّ","أَنَّىٰ","يَكُونُ","لِي","غُلَٰمٞ","وَقَدۡ","بَلَغَنِيَ","ٱلۡكِبَرُ","وَٱمۡرَأَتِي","عَاقِرٞۖ","قَالَ","كَذَٰلِكَ","ٱللَّهُ","يَفۡعَلُ","مَا","يَشَآءُ"],"ḳала рабби анна йакууну лии гуламун ваḳад балаганийал кибару вамраатии `аḳирун ḳала казаликаллаху йаф`алу ма йаша","Закария (Захария) сказал: «Господи! Как может у меня родиться сын, если старость уже настигла меня и жена моя бесплодна?». Аллах сказал: «Так Аллах вершит, что пожелает!».",["он сказал","Господи","как","будет","у меня","сын","и уже","настигла меня","старость","а жена моя","бесплодна","Он сказал","так","Аллах","творит","что","Он пожелает"]],[3,41,["قَالَ","رَبِّ","ٱجۡعَل","لِّيٓ","ءَايَةٗۖ","قَالَ","ءَايَتُكَ","أَلَّا","تُكَلِّمَ","ٱلنَّاسَ","ثَلَٰثَةَ","أَيَّامٍ","إِلَّا","رَمۡزٗاۗ","وَٱذۡكُر","رَّبَّكَ","كَثِيرٗا","وَسَبِّحۡ","بِٱلۡعَشِيِّ","وَٱلۡإِبۡكَٰرِ"],"ḳала раббиж`ал ллии айатан ḳала айатука алла тукаллиман наса саласата аййамин илла рамзан вазкур раббака касииран васаббих бил`ашиййи вал'ибкар","Закария (Захария) сказал: «Господи! Покажи мне знамение». Аллах сказал: «Твое знамение будет в том, что ты будешь три дня разговаривать с людьми только знаками. Много поминай своего Господа и славь Его перед закатом и утром».",["он сказал","Господи","сделай","для меня","знамение","Он сказал","знамение твоё","что не","будешь говорить","с людьми","три","дня","кроме как","знаками","и поминай","Господа твоего","много","и славь","вечером","и утром"]],[3,42,["وَإِذۡ","قَالَتِ","ٱلۡمَلَٰٓئِكَةُ","يَٰمَرۡيَمُ","إِنَّ","ٱللَّهَ","ٱصۡطَفَىٰكِ","وَطَهَّرَكِ","وَٱصۡطَفَىٰكِ","عَلَىٰ","نِسَآءِ","ٱلۡعَٰلَمِينَ"],"ва'из ḳалатил малаикату йамарйаму инналлахастафаки ватаххараки вастафаки `ала нисаил `аламиин","Вот сказали ангелы: «О Марьям (Мария)! Воистину, Аллах избрал тебя, очистил и возвысил над женщинами миров.",["и вот","сказали","ангелы","о Марьям","поистине","Аллах","избрал тебя","и очистил тебя","и избрал тебя","над","женщинами","миров"]],[3,43,["يَٰمَرۡيَمُ","ٱقۡنُتِي","لِرَبِّكِ","وَٱسۡجُدِي","وَٱرۡكَعِي","مَعَ","ٱلرَّٰكِعِينَ"],"йамарйамуḳнутии лираббики васжудии варка`ии ма`ар раки`иин","О Марьям (Мария)! Будь смиренной перед Господом твоим, падай ниц и кланяйся вместе с теми, кто кланяется».",["о Марьям","будь покорна","Господу твоему","и падай ниц","и кланяйся","с","кланяющимися"]],[3,44,["ذَٰلِكَ","مِنۡ","أَنۢبَآءِ","ٱلۡغَيۡبِ","نُوحِيهِ","إِلَيۡكَۚ","وَمَا","كُنتَ","لَدَيۡهِمۡ","إِذۡ","يُلۡقُونَ","أَقۡلَٰمَهُمۡ","أَيُّهُمۡ","يَكۡفُلُ","مَرۡيَمَ","وَمَا","كُنتَ","لَدَيۡهِمۡ","إِذۡ","يَخۡتَصِمُونَ"],"залика мин амбаил гайби нуухиихи илайка вама кунта ладайхим из йулḳууна аḳламахум аййухум йакфулу марйама вама кунта ладайхим из йахтасимуун","Это - часть рассказов о сокровенном, которое Мы сообщаем тебе в откровении. Ты не был с ними, когда они бросали свои письменные трости, чтобы решить, кто из них будет опекать Марьям (Марию). Ты не был с ними, когда они препирались.",["это","из","вестей","о сокровенном","Мы внушаем это","тебе","и не","был ты","у них","когда","они бросали","трости свои","кто из них","будет опекать","Марьям","и не","был ты","у них","когда","они препирались"]],[3,45,["إِذۡ","قَالَتِ","ٱلۡمَلَٰٓئِكَةُ","يَٰمَرۡيَمُ","إِنَّ","ٱللَّهَ","يُبَشِّرُكِ","بِكَلِمَةٖ","مِّنۡهُ","ٱسۡمُهُ","ٱلۡمَسِيحُ","عِيسَى","ٱبۡنُ","مَرۡيَمَ","وَجِيهٗا","فِي","ٱلدُّنۡيَا","وَٱلۡأٓخِرَةِ","وَمِنَ","ٱلۡمُقَرَّبِينَ"],"из ḳалатил малаикату йамарйаму инналлаха йубашшируки бикалиматим минхусмухул масииху `иисабну марйама важиихан фид дунйа вал'ахирати ваминал муḳаррабиин","Вот сказали ангелы: «О Марьям (Мария)! Воистину, Аллах радует тебя вестью о слове от Него, имя которому - Мессия Иса (Иисус), сын Марьям (Марии). Он будет почитаем в этом мире и в Последней жизни и будет одним из приближенных.",["вот","сказали","ангелы","о Марьям","поистине","Аллах","радует тебя вестью","о слове","от Него","имя его","Мессия","Иса","сын","Марьям","почитаемым","в","этом мире","и в Последней жизни","и из","приближённых"]]],"m":[[["هُنَالِكَ","тогда",3,38],["دَعَا","воззвал",3,38],["زَكَرِيَّا","Закария",3,38],["رَبَّهُۥۖ","к Господу своему",3,38],["قَالَ","сказал он",3,38],["رَبِّ","Господи",3,38],["هَبۡ","даруй",3,38],["لِي","мне",3,38],["مِن","от",3,38],["لَّدُنكَ","Себя",3,38],["ذُرِّيَّةٗ","потомство",3,38]],[["طَيِّبَةًۖ","благое",3,38],["إِنَّكَ","поистине Ты",3,38],["سَمِيعُ","Слышащий",3,38],["ٱلدُّعَآءِ","мольбы",3,38],[38],["فَنَادَتۡهُ","и воззвали к нему",3,39],["ٱلۡمَلَٰٓئِكَةُ","ангелы",3,39],["وَهُوَ","когда он",3,39],["قَآئِمٞ","стоял",3,39]],[["يُصَلِّي","молясь",3,39],["فِي","в",3,39],["ٱلۡمِحۡرَابِ","молель