{"p":56,"j":3,"a":[[3,46,["وَيُكَلِّمُ","ٱلنَّاسَ","فِي","ٱلۡمَهۡدِ","وَكَهۡلٗا","وَمِنَ","ٱلصَّٰلِحِينَ"],"вайукаллимун наса фил махди вакахлан ваминас салихиин","Он будет разговаривать с людьми в колыбели и взрослым и станет одним из праведников».",["и будет говорить","с людьми","в","колыбели","и зрелым","и из","праведников"]],[3,47,["قَالَتۡ","رَبِّ","أَنَّىٰ","يَكُونُ","لِي","وَلَدٞ","وَلَمۡ","يَمۡسَسۡنِي","بَشَرٞۖ","قَالَ","كَذَٰلِكِ","ٱللَّهُ","يَخۡلُقُ","مَا","يَشَآءُۚ","إِذَا","قَضَىٰٓ","أَمۡرٗا","فَإِنَّمَا","يَقُولُ","لَهُۥ","كُن","فَيَكُونُ"],"ḳалат рабби анна йакууну лии валадун валам йамсаснии башарун ḳала казаликиллаху йахлуḳу ма йашау иза ḳада амран фа'иннама йаḳуулу лахуу кун файакуун","Она сказала: «Господи! Как я могу иметь сына, если меня не касался ни один мужчина». Он сказал: «Так Аллах творит, что пожелает! Когда Он принимает решение, то Ему стоит лишь сказать: «Будь!» - как это сбывается.",["она сказала","Господи","как","будет","у меня","ребёнок","и не","касался меня","ни один мужчина","Он сказал","так","Аллах","творит","что","Он пожелает","когда","Он решает","дело","то лишь","Он говорит","ему","будь","и оно сбывается"]],[3,48,["وَيُعَلِّمُهُ","ٱلۡكِتَٰبَ","وَٱلۡحِكۡمَةَ","وَٱلتَّوۡرَىٰةَ","وَٱلۡإِنجِيلَ"],"вайу`аллимухул китаба валхикмата ваттаурата вал'инжиил","Он научит его Писанию и мудрости, Таурату (Торе) и Инджилу (Евангелию).",["и Он научит его","Писанию","и мудрости","и Таурату","и Инджилу"]],[3,49,["وَرَسُولًا","إِلَىٰ","بَنِيٓ","إِسۡرَٰٓءِيلَ","أَنِّي","قَدۡ","جِئۡتُكُم","بِـَٔايَةٖ","مِّن","رَّبِّكُمۡ","أَنِّيٓ","أَخۡلُقُ","لَكُم","مِّنَ","ٱلطِّينِ","كَهَيۡـَٔةِ","ٱلطَّيۡرِ","فَأَنفُخُ","فِيهِ","فَيَكُونُ","طَيۡرَۢا","بِإِذۡنِ","ٱللَّهِۖ","وَأُبۡرِئُ","ٱلۡأَكۡمَهَ","وَٱلۡأَبۡرَصَ","وَأُحۡيِ","ٱلۡمَوۡتَىٰ","بِإِذۡنِ","ٱللَّهِۖ","وَأُنَبِّئُكُم","بِمَا","تَأۡكُلُونَ","وَمَا","تَدَّخِرُونَ","فِي","بُيُوتِكُمۡۚ","إِنَّ","فِي","ذَٰلِكَ","لَأٓيَةٗ","لَّكُمۡ","إِن","كُنتُم","مُّؤۡمِنِينَ"],"варасуулан ила бании исраиила аннии ḳад жи'тукум би'айатим мир раббикум аннии ахлуḳу лакум минат тиини кахай'атит тайри фа'анфуху фиихи файакууну тайра би'изниллахи ва'убриул акмаха вал'абраса ва'ухйил маута би'изниллахи ва'унаббиукум бима та'кулууна вама таддахирууна фии буйуутикум инна фии залика ла'айатал лакум ин кунтум му'миниин","Он сделает его посланником к сынам Исраила (Израиля). Он скажет: «Я принес вам знамение от вашего Господа. Я сотворю вам из глины подобие птицы, подую на него, и оно станет птицей с позволения Аллаха. Я исцелю слепого (или лишенного зрения от рождения; или обладающего слабым зрением) и прокаженного и оживлю мертвых с позволения Аллаха. Я поведаю вам о том, что вы едите и что припасаете в своих домах. Воистину, в этом есть знамение для вас, если только вы являетесь верующими.",["и посланником","к","сынам","Исраила","что я","уже","пришёл к вам","со знамением","от","Господа вашего","что я","сотворю","для вас","из","глины","подобие","птицы","и подую","в него","и оно станет","птицей","с позволения","Аллаха","и исцелю","слепого от рождения","и прокажённого","и оживлю","мёртвых","с позволения","Аллаха","и сообщу вам","о том, что","вы едите","и что","вы припасаете","в","домах ваших","поистине","в","этом","непременно знамение","для вас","если","вы","верующие"]],[3,50,["وَمُصَدِّقٗا","لِّمَا","بَيۡنَ","يَدَيَّ","مِنَ","ٱلتَّوۡرَىٰةِ","وَلِأُحِلَّ","لَكُم","بَعۡضَ","ٱلَّذِي","حُرِّمَ","عَلَيۡكُمۡۚ","وَجِئۡتُكُم","بِـَٔايَةٖ","مِّن","رَّبِّكُمۡ","فَٱتَّقُواْ","ٱللَّهَ","وَأَطِيعُونِ"],"вамусаддиḳал лима байна йадаййа минат таурати валиухилла лакум ба`дал лазии хуррима `алайкум важи'тукум би'айатим мир раббикум фаттаḳуллаха ва'атии`уун","Я пришел, чтобы подтвердить истинность того, что было в Таурате (Торе) до меня, и чтобы разрешить вам часть того, что было вам запрещено. Я принес вам знамение от вашего Господа. Бойтесь же Аллаха и повинуйтесь мне.",["и подтверждающим","то, что","меж","руками моими (до меня)","из","Таурата","и чтобы разрешить","вам","часть","того, что","запрещено было","вам","и пришёл я к вам","со знамением","от","Господа вашего","бойтесь же","Аллаха","и повинуйтесь мне"]],[3,51,["إِنَّ","ٱللَّهَ","رَبِّي","وَرَبُّكُمۡ","فَٱعۡبُدُوهُۚ","هَٰذَا","صِرَٰطٞ","مُّسۡتَقِيمٞ"],"инналлаха раббии вараббукум фа`будууху хаза сиратум мустаḳиим","Воистину, Аллах - мой Господь и ваш Господь. Поклоняйтесь же Ему, ибо таков прямой путь!»».",["поистине","Аллах","Господь мой","и Господь ваш","поклоняйтесь же Ему","это","путь","прямой"]],[3,52,["فَلَمَّآ","أَحَسَّ","عِيسَىٰ","مِنۡهُمُ","ٱلۡكُفۡرَ","قَالَ","مَنۡ","أَنصَارِيٓ","إِلَى","ٱللَّهِۖ","قَالَ","ٱلۡحَوَارِيُّونَ","نَحۡنُ","أَنصَارُ","ٱللَّهِ","ءَامَنَّا","بِٱللَّهِ","وَٱشۡهَدۡ","بِأَنَّا","مُسۡلِمُونَ"],"фаламма ахасса `ииса минхумул куфра ḳала ман ансарии илаллахи ḳалал хавариййууна нахну ансаруллахи аманна биллахи вашхад би'анна муслимуун","Когда Иса (Иисус) почувствовал их неверие, он сказал: «Кто будет моим помощником на пути к Аллаху?». Апостолы сказали: «Мы - помощники Аллаха. Мы уверовали в Аллаха. Будь же свидетелем того, что мы являемся мусульманами!",["а когда","почувствовал","Иса","от них","неверие","он сказал","кто","помощники мои","к","Аллаху","сказали","апостолы","мы","помощники","Аллаха","мы уверовали","в Аллаха","и засвидетельствуй","что мы","мусульмане"]]],"m":[[["وَيُكَلِّمُ","и будет говорить",3,46],["ٱلنَّاسَ","с людьми",3,46],["فِي","в",3,46],["ٱلۡمَهۡدِ","колыбели",3,46],["وَكَهۡلٗا","и зрелым",3,46],["وَمِنَ","и из",3,46],["ٱلصَّٰلِحِينَ","праведников",3,46],[46]],[["قَالَتۡ","она сказала",3,47],["رَبِّ","Господи",3,47],["أَنَّىٰ","как",3,47],["يَكُونُ","будет",3,47],["لِي","у меня",3,47],["وَلَدٞ","ребёнок",3,47],["وَلَمۡ","и не",3,47],["يَمۡسَسۡنِي","касался меня",3,47],["بَشَرٞۖ","ни один мужчина",3,47],["قَالَ","Он сказал",3,47],["كَذَٰلِكِ","так",3,47]],[["ٱللَّهُ","Аллах",3,47],["يَخۡلُقُ","творит",3,47],["مَا","что",3,47],["يَشَآءُۚ","Он пожелает",3,47],["إِذَا","когда",3,47],["قَضَىٰٓ","Он решает",3,47],["أَمۡرٗا","дело",3,47],["فَإِنَّمَا","то лишь",3,47],["يَقُولُ