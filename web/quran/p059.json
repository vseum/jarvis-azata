{"p":59,"j":3,"a":[[3,71,["يَٰٓأَهۡلَ","ٱلۡكِتَٰبِ","لِمَ","تَلۡبِسُونَ","ٱلۡحَقَّ","بِٱلۡبَٰطِلِ","وَتَكۡتُمُونَ","ٱلۡحَقَّ","وَأَنتُمۡ","تَعۡلَمُونَ"],"йа'ахлал китаби лима талбисуунал хаḳḳа билбатили ватактумуунал хаḳḳа ва'антум та`ламуун","О люди Писания! Почему вы облекаете истину ложью и скрываете истину, хотя сами знаете об этом?",["о люди","Писания","почему","вы облекаете","истину","ложью","и скрываете","истину","хотя вы","знаете"]],[3,72,["وَقَالَت","طَّآئِفَةٞ","مِّنۡ","أَهۡلِ","ٱلۡكِتَٰبِ","ءَامِنُواْ","بِٱلَّذِيٓ","أُنزِلَ","عَلَى","ٱلَّذِينَ","ءَامَنُواْ","وَجۡهَ","ٱلنَّهَارِ","وَٱكۡفُرُوٓاْ","ءَاخِرَهُۥ","لَعَلَّهُمۡ","يَرۡجِعُونَ"],"ваḳалат таифатум мин ахлил китаби аминуу биллазии унзила `алал лазиина амануу важхан нахари вакфуруу ахирахуу ла`аллахум йаржи`уун","Часть людей Писания говорит: «Уверуйте в то, что ниспослано верующим, в начале дня и перестаньте верить в конце его. Быть может, они обратятся вспять.",["и сказала","часть","из","людей","Писания","уверуйте","в то, что","ниспослано","на","тех, которые","уверовали","в начале","дня","и не веруйте","в конце его","может быть, они","вернутся"]],[3,73,["وَلَا","تُؤۡمِنُوٓاْ","إِلَّا","لِمَن","تَبِعَ","دِينَكُمۡ","قُلۡ","إِنَّ","ٱلۡهُدَىٰ","هُدَى","ٱللَّهِ","أَن","يُؤۡتَىٰٓ","أَحَدٞ","مِّثۡلَ","مَآ","أُوتِيتُمۡ","أَوۡ","يُحَآجُّوكُمۡ","عِندَ","رَبِّكُمۡۗ","قُلۡ","إِنَّ","ٱلۡفَضۡلَ","بِيَدِ","ٱللَّهِ","يُؤۡتِيهِ","مَن","يَشَآءُۗ","وَٱللَّهُ","وَٰسِعٌ","عَلِيمٞ"],"вала ту'минуу илла лиман таби`а диинакум ḳул иннал худа худаллахи ан йу'та ахадум мисла ма уутиитум ау йухажжуукум `инда раббикум ḳул иннал фадла бийадиллахи йу'тиихи ман йашау валлаху васи`ун `алиим","Верьте только тем, кто последовал вашей религии, дабы никто не получил то, что получили вы, и не препирался с вами перед вашим Господом». Скажи: «Воистину, верным руководством является руководство Аллаха». Скажи: «Воистину, милость находится в Руке Аллаха. Он дарует ее, кому пожелает. Воистину, Аллах - Объемлющий, Знающий».",["и не","верьте","кроме как","тому, кто","последовал","религии вашей","скажи","поистине","руководство","руководство","Аллаха","чтобы (не)","было дано","кому-либо","подобное","тому, что","было дано вам","или","препирались бы с вами","перед","Господом вашим","скажи","поистине","милость","в Руке","Аллаха","Он дарует её","кому","Он пожелает","и Аллах","Объемлющий","Знающий"]],[3,74,["يَخۡتَصُّ","بِرَحۡمَتِهِۦ","مَن","يَشَآءُۗ","وَٱللَّهُ","ذُو","ٱلۡفَضۡلِ","ٱلۡعَظِيمِ"],"йахтассу бирахматихии ман йашау валлаху зул фадлил `азиим","Он избирает для Своей милости, кого пожелает. Аллах обладает великой милостью.",["Он избирает","для Своей милости","кого","Он пожелает","и Аллах","обладатель","милости","великой"]],[3,75,["وَمِنۡ","أَهۡلِ","ٱلۡكِتَٰبِ","مَنۡ","إِن","تَأۡمَنۡهُ","بِقِنطَارٖ","يُؤَدِّهِۦٓ","إِلَيۡكَ","وَمِنۡهُم","مَّنۡ","إِن","تَأۡمَنۡهُ","بِدِينَارٖ","لَّا","يُؤَدِّهِۦٓ","إِلَيۡكَ","إِلَّا","مَا","دُمۡتَ","عَلَيۡهِ","قَآئِمٗاۗ","ذَٰلِكَ","بِأَنَّهُمۡ","قَالُواْ","لَيۡسَ","عَلَيۡنَا","فِي","ٱلۡأُمِّيِّـۧنَ","سَبِيلٞ","وَيَقُولُونَ","عَلَى","ٱللَّهِ","ٱلۡكَذِبَ","وَهُمۡ","يَعۡلَمُونَ"],"вамин ахлил китаби ман ин та'манху биḳинтарин йу'аддихии илайка ваминхум ман ин та'манху бидиинарил ла йу'аддихии илайка илла ма думта `алайхи ḳаиман залика би'аннахум ḳалуу лайса `алайна фил уммиййиина сабиилун вайаḳуулууна `алаллахил казиба вахум йа`ламуун","Среди людей Писания есть такой, который вернет тебе целый кантар, если ты доверишь его ему; но есть и такой, который, если ты доверишь ему всего один динар, не вернет его тебе, пока ты не встанешь у него над душой. Они поступают так, потому что говорят: «На нас не будет греха из-за этих невежд». Они сознательно возводят навет на Аллаха.",["и из","людей","Писания","есть тот, кто","если","ты доверишь ему","кантар","вернёт его","тебе","а из них","есть тот, кто","если","ты доверишь ему","динар","не","вернёт его","тебе","кроме как","пока","будешь ты","над ним","стоять","это","потому что они","сказали","нет","на нас","за","невежд","пути (греха)","и говорят они","на","Аллаха","ложь","а они","знают"]],[3,76,["بَلَىٰۚ","مَنۡ","أَوۡفَىٰ","بِعَهۡدِهِۦ","وَٱتَّقَىٰ","فَإِنَّ","ٱللَّهَ","يُحِبُّ","ٱلۡمُتَّقِينَ"],"бала ман ауфа би`ахдихии ваттаḳа фа'инналлаха йухиббул муттаḳиин","О нет! Если кто выполняет обязательство и боится Аллаха, то ведь Аллах любит богобоязненных.",["о нет","кто","исполнил","свой завет","и был богобоязнен","то поистине","Аллах","любит","богобоязненных"]],[3,77,["إِنَّ","ٱلَّذِينَ","يَشۡتَرُونَ","بِعَهۡدِ","ٱللَّهِ","وَأَيۡمَٰنِهِمۡ","ثَمَنٗا","قَلِيلًا","أُوْلَٰٓئِكَ","لَا","خَلَٰقَ","لَهُمۡ","فِي","ٱلۡأٓخِرَةِ","وَلَا","يُكَلِّمُهُمُ","ٱللَّهُ","وَلَا","يَنظُرُ","إِلَيۡهِمۡ","يَوۡمَ","ٱلۡقِيَٰمَةِ","وَلَا","يُزَكِّيهِمۡ","وَلَهُمۡ","عَذَابٌ","أَلِيمٞ"],"иннал лазиина йаштарууна би`ахдиллахи ва'айманихим саманан ḳалиилан улаика ла халаḳа лахум фил ахирати вала йукаллимухумуллаху вала йанзуру илайхим йаумал ḳийамати вала йузаккиихим валахум `азабун алиим","Воистину, тем, которые продают завет с Аллахом и свои клятвы за ничтожную цену, нет доли в Последней жизни. Аллах не станет говорить с ними, не посмотрит на них в День воскресения и не очистит их. Им уготованы мучительные страдания.",["поистине","те, которые","продают","за завет","Аллаха","и клятвы свои","цену","малую","те","нет","доли","у них","в","Последней жизни","и не","заговорит с ними","Аллах","и не","посмотрит","на них","в День","воскресения","и не","очистит их","и им","мучение","мучительное"]]],"m":[[["يَٰٓأَهۡلَ","о люди",3,71],["ٱلۡكِتَٰبِ","Писания",3,71],["لِمَ","почему",3,71],["تَلۡبِسُونَ","вы облекаете",3,71],["ٱلۡحَقَّ","истину",3,71],["بِٱلۡبَٰطِلِ","ложью",3,71],["وَتَكۡتُمُونَ","и скрываете",3,71],["ٱلۡحَقَّ","истину",3,71]],[["وَأَنتُمۡ","хотя вы",3,71],["تَعۡلَمُونَ","знаете",3,71],[71],["وَقَالَت","и сказала",3,72],["طَّآئِفَةٞ","часть",3,72],["مِّنۡ","из",3,72],["أَهۡلِ","людей",3,72],["ٱلۡكِتَٰبِ","Писания",3,72],["ءَامِنُواْ","уверуйте",3,72]],[["بِٱلَّذِيٓ","в то, что",3,72],["أُنزِلَ","ниспослано",3,72],["عَلَ