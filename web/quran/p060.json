{"p":60,"j":3,"a":[[3,78,["وَإِنَّ","مِنۡهُمۡ","لَفَرِيقٗا","يَلۡوُۥنَ","أَلۡسِنَتَهُم","بِٱلۡكِتَٰبِ","لِتَحۡسَبُوهُ","مِنَ","ٱلۡكِتَٰبِ","وَمَا","هُوَ","مِنَ","ٱلۡكِتَٰبِ","وَيَقُولُونَ","هُوَ","مِنۡ","عِندِ","ٱللَّهِ","وَمَا","هُوَ","مِنۡ","عِندِ","ٱللَّهِۖ","وَيَقُولُونَ","عَلَى","ٱللَّهِ","ٱلۡكَذِبَ","وَهُمۡ","يَعۡلَمُونَ"],"ва'инна минхум лафарииḳан йалвууна алсинатахум билкитаби литахсабууху минал китаби вама хуа минал китаби вайаḳуулууна хуа мин `индиллахи вама хуа мин `индиллахи вайаḳуулууна `алаллахил казиба вахум йа`ламуун","Среди них есть такие, которые искажают Писание своими языками, чтобы вы приняли за Писание то, что не относится к нему. Они говорят: «Это - от Аллаха». А ведь это вовсе не от Аллаха! Они сознательно возводят навет на Аллаха.",["и поистине","из них","непременно группа","искривляют","языки свои","читая Писание","чтобы вы сочли это","из","Писания","а не","оно","из","Писания","и говорят они","это","от","самого","Аллаха","а не","это","от","самого","Аллаха","и говорят они","на","Аллаха","ложь","а они","знают"]],[3,79,["مَا","كَانَ","لِبَشَرٍ","أَن","يُؤۡتِيَهُ","ٱللَّهُ","ٱلۡكِتَٰبَ","وَٱلۡحُكۡمَ","وَٱلنُّبُوَّةَ","ثُمَّ","يَقُولَ","لِلنَّاسِ","كُونُواْ","عِبَادٗا","لِّي","مِن","دُونِ","ٱللَّهِ","وَلَٰكِن","كُونُواْ","رَبَّٰنِيِّـۧنَ","بِمَا","كُنتُمۡ","تُعَلِّمُونَ","ٱلۡكِتَٰبَ","وَبِمَا","كُنتُمۡ","تَدۡرُسُونَ"],"ма кана либашарин ан йу'тийахуллахул китаба валхукма ваннубуввата сумма йаḳуула линнаси куунуу `ибадал лии мин дууниллахи валакин куунуу раббаниййиина бима кунтум ту`аллимуунал китаба вабима кунтум тадрусуун","Если Аллах даровал человеку Писание, власть (знание или умение принимать решения) и пророчество, то ему не подобает говорить людям: «Будьте рабами мне, а не Аллаху». Напротив, будьте духовными наставниками, поскольку вы обучаете Писанию и изучаете его.",["не","подобает","человеку","чтобы","даровал ему","Аллах","Писание","и мудрость","и пророчество","затем","он сказал бы","людям","будьте","рабами","мне","из","помимо","Аллаха","но","будьте","наставниками Господними","потому что","вы","обучаете","Писанию","и потому что","вы","изучаете"]],[3,80,["وَلَا","يَأۡمُرَكُمۡ","أَن","تَتَّخِذُواْ","ٱلۡمَلَٰٓئِكَةَ","وَٱلنَّبِيِّـۧنَ","أَرۡبَابًاۚ","أَيَأۡمُرُكُم","بِٱلۡكُفۡرِ","بَعۡدَ","إِذۡ","أَنتُم","مُّسۡلِمُونَ"],"вала йа'муракум ан таттахизул малаиката ваннабиййиина арбабан айа'мурукум билкуфри ба`да из антум муслимуун","Ему также не подобает приказывать вам признавать ангелов и пророков своими господами. Разве он станет приказывать вам совершить неверие после того, как вы стали мусульманами?",["и не","велит он вам","чтобы","вы брали","ангелов","и пророков","господами","разве велит он вам","неверие","после","того как","вы","мусульмане"]],[3,81,["وَإِذۡ","أَخَذَ","ٱللَّهُ","مِيثَٰقَ","ٱلنَّبِيِّـۧنَ","لَمَآ","ءَاتَيۡتُكُم","مِّن","كِتَٰبٖ","وَحِكۡمَةٖ","ثُمَّ","جَآءَكُمۡ","رَسُولٞ","مُّصَدِّقٞ","لِّمَا","مَعَكُمۡ","لَتُؤۡمِنُنَّ","بِهِۦ","وَلَتَنصُرُنَّهُۥۚ","قَالَ","ءَأَقۡرَرۡتُمۡ","وَأَخَذۡتُمۡ","عَلَىٰ","ذَٰلِكُمۡ","إِصۡرِيۖ","قَالُوٓاْ","أَقۡرَرۡنَاۚ","قَالَ","فَٱشۡهَدُواْ","وَأَنَا۠","مَعَكُم","مِّنَ","ٱلشَّٰهِدِينَ"],"ва'из ахазаллаху миисаḳан набиййиина лама атайтукум мин китабин вахикматин сумма жаакум расуулум мусаддиḳул лима ма`акум лату'минунна бихии валатансуруннахуу ḳала а'аḳрартум ва'ахазтум `ала заликум исрии ḳалуу аḳрарна ḳала фашхадуу ва'ана ма`акум минаш шахидиин","Вот Аллах взял завет с пророков: «Я одарю вас из Писания и мудрости. Если же после этого к вам явится Посланник, подтверждающий истинность того, что есть у вас, то вы непременно уверуете в него и поможете ему». Он сказал: «Согласны ли вы и принимаете ли Мой завет?». Они ответили: «Мы согласны». Он сказал: «Будьте же свидетелями, и Я буду свидетельствовать вместе с вами».",["и вот","взял","Аллах","завет","с пророков","то, что","Я дал вам","из","Писания","и мудрости","затем","придёт к вам","посланник","подтверждающий","то, что","с вами","непременно уверуйте","в него","и непременно помогите ему","Он сказал","согласны ли вы","и взяли ли","на","это","Мой завет","они сказали","мы согласны","Он сказал","свидетельствуйте же","и Я","с вами","из","свидетельствующих"]],[3,82,["فَمَن","تَوَلَّىٰ","بَعۡدَ","ذَٰلِكَ","فَأُوْلَٰٓئِكَ","هُمُ","ٱلۡفَٰسِقُونَ"],"фаман тавалла ба`да залика фа'улаика хумул фасиḳуун","Те же, которые отвернутся после этого, являются нечестивцами.",["а кто","отвернётся","после","этого","то те","они","нечестивцы"]],[3,83,["أَفَغَيۡرَ","دِينِ","ٱللَّهِ","يَبۡغُونَ","وَلَهُۥٓ","أَسۡلَمَ","مَن","فِي","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِ","طَوۡعٗا","وَكَرۡهٗا","وَإِلَيۡهِ","يُرۡجَعُونَ"],"афагайра дииниллахи йабгууна валахуу аслама ман фис самавати вал'арди тау`ан вакархан ва'илайхи йуржа`уун","Неужели они ищут иной религии, помимо религии Аллаха, в то время, как Ему покорились все, кто на небесах и на земле, по своей воле или по принуждению, и к Нему они будут возвращены.",["неужели иную, чем","религия","Аллаха","они ищут","а Ему","покорились","те, кто","на","небесах","и земле","добровольно","и принуждённо","и к Нему","они будут возвращены"]]],"m":[[["وَإِنَّ","и поистине",3,78],["مِنۡهُمۡ","из них",3,78],["لَفَرِيقٗا","непременно группа",3,78],["يَلۡوُۥنَ","искривляют",3,78],["أَلۡسِنَتَهُم","языки свои",3,78],["بِٱلۡكِتَٰبِ","читая Писание",3,78],["لِتَحۡسَبُوهُ","чтобы вы сочли это",3,78]],[["مِنَ","из",3,78],["ٱلۡكِتَٰبِ","Писания",3,78],["وَمَا","а не",3,78],["هُوَ","оно",3,78],["مِنَ","из",3,78],["ٱلۡكِتَٰبِ","Писания",3,78],["وَيَقُولُونَ","и говорят они",3,78],["هُوَ","это",3,78]],[["مِنۡ","от",3,78],["عِندِ","самого",3,78],["ٱللَّهِ","Аллаха",3,78],["وَمَا","а не",3,78],["هُوَ","это",3,78],["مِنۡ","от",3,78],["عِندِ","самого",3,78],["ٱللَّهِۖ","Аллаха",3,78],["وَيَقُولُونَ","и говорят они",3,78],["عَلَى","на",3,78],["ٱللَّهِ","Аллаха",3,78],["ٱلۡكَذِبَ","ложь",3,78]],[["وَهُمۡ","а они",3,78],["يَعۡلَمُونَ","знают",3,78],[78],["مَا","не",3,79],["كَانَ","подобает",3,79],["لِبَشَرٍ","человеку",3,79],["أَن","чтобы",3,79],["يُؤۡتِيَهُ","даровал ему",3,79],["ٱللَّهُ","Алл