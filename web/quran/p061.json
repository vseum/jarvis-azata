{"p":61,"j":3,"a":[[3,84,["قُلۡ","ءَامَنَّا","بِٱللَّهِ","وَمَآ","أُنزِلَ","عَلَيۡنَا","وَمَآ","أُنزِلَ","عَلَىٰٓ","إِبۡرَٰهِيمَ","وَإِسۡمَٰعِيلَ","وَإِسۡحَٰقَ","وَيَعۡقُوبَ","وَٱلۡأَسۡبَاطِ","وَمَآ","أُوتِيَ","مُوسَىٰ","وَعِيسَىٰ","وَٱلنَّبِيُّونَ","مِن","رَّبِّهِمۡ","لَا","نُفَرِّقُ","بَيۡنَ","أَحَدٖ","مِّنۡهُمۡ","وَنَحۡنُ","لَهُۥ","مُسۡلِمُونَ"],"ḳул аманна биллахи вама унзила `алайна вама унзила `ала ибрахиима ва'исма`иила ва'исхаḳа вайа`ḳууба вал'асбати вама уутийа мууса ва`ииса ваннабиййууна мир раббихим ла нуфарриḳу байна ахадим минхум ванахну лахуу муслимуун","Скажи: «Мы уверовали в Аллаха и в ниспосланное нам, в ниспосланное Ибрахиму (Аврааму), Исмаилу (Измаилу), Исхаку (Исааку), Йакубу (Иакову) и коленам (двенадцати сыновьям Йакуба) ивдарованное Мусе (Моисею), Исе (Иисусу) и пророкам от их Господа. Мы не делаем различий между ними, и Ему одному мы покоряемся».",["скажи","мы уверовали","в Аллаха","и в то, что","ниспослано","нам","и что","ниспослано","на","Ибрахима","и Исмаила","и Исхака","и Йакуба","и колена","и что","было даровано","Мусе","и Исе","и пророкам","от","Господа их","не","различаем мы","между","кем-либо","из них","и мы","Ему","покорны"]],[3,85,["وَمَن","يَبۡتَغِ","غَيۡرَ","ٱلۡإِسۡلَٰمِ","دِينٗا","فَلَن","يُقۡبَلَ","مِنۡهُ","وَهُوَ","فِي","ٱلۡأٓخِرَةِ","مِنَ","ٱلۡخَٰسِرِينَ"],"ваман йабтаги гайрал ислами диинан фалан йуḳбала минху вахуа фил ахирати минал хасириин","От того, кто ищет иную религию помимо ислама, это никогда не будет принято, и в Последней жизни он окажется среди потерпевших урон.",["а кто","ищет","иную, чем","ислам","религию","то никогда не","будет принято","от него","и он","в","Последней жизни","из","потерпевших урон"]],[3,86,["كَيۡفَ","يَهۡدِي","ٱللَّهُ","قَوۡمٗا","كَفَرُواْ","بَعۡدَ","إِيمَٰنِهِمۡ","وَشَهِدُوٓاْ","أَنَّ","ٱلرَّسُولَ","حَقّٞ","وَجَآءَهُمُ","ٱلۡبَيِّنَٰتُۚ","وَٱللَّهُ","لَا","يَهۡدِي","ٱلۡقَوۡمَ","ٱلظَّٰلِمِينَ"],"кайфа йахдиллаху ḳауман кафаруу ба`да ииманихим вашахидуу аннар расуула хаḳḳун важаахумул баййинату валлаху ла йахдил ḳаумаз залимиин","Как же Аллах наставит на прямой путь людей, которые стали неверующими после того, как уверовали и засвидетельствовали правдивость Посланника, и после того, как к ним явились ясные знамения? Аллах не ведет прямым путем несправедливых людей.",["как","поведёт прямым путём","Аллах","людей","которые не уверовали","после","веры своей","и засвидетельствовали","что","Посланник","истина","и пришли к ним","ясные знамения","а Аллах","не","ведёт прямым путём","людей","беззаконных"]],[3,87,["أُوْلَٰٓئِكَ","جَزَآؤُهُمۡ","أَنَّ","عَلَيۡهِمۡ","لَعۡنَةَ","ٱللَّهِ","وَٱلۡمَلَٰٓئِكَةِ","وَٱلنَّاسِ","أَجۡمَعِينَ"],"улаика жазаухум анна `алайхим ла`наталлахи валмалаикати ваннаси ажма`иин","Их воздаянием является проклятие Аллаха, ангелов и всех людей.",["Эти","воздаяние им","что","на них","проклятие","Аллаха","и ангелов","и людей","всех"]],[3,88,["خَٰلِدِينَ","فِيهَا","لَا","يُخَفَّفُ","عَنۡهُمُ","ٱلۡعَذَابُ","وَلَا","هُمۡ","يُنظَرُونَ"],"халидиина фииха ла йухаффафу `анхумул `азабу вала хум йунзаруун","Они пребудут там (под проклятием или в Аду) вечно! Их мучения не будут облегчены, и они не получат отсрочки,",["вечно пребывая","в нём","не","будет облегчено","им","наказание","и не","они","получат отсрочку"]],[3,89,["إِلَّا","ٱلَّذِينَ","تَابُواْ","مِنۢ","بَعۡدِ","ذَٰلِكَ","وَأَصۡلَحُواْ","فَإِنَّ","ٱللَّهَ","غَفُورٞ","رَّحِيمٌ"],"иллал лазиина табуу мим ба`ди залика ва'аслахуу фа'инналлаха гафуурур рахиим","кроме тех, которые раскаялись после этого и исправили содеянное. Воистину, Аллах - Прощающий, Милосердный.",["кроме","тех, которые","покаялись","из","после","этого","и исправились","то поистине","Аллах","Прощающий","Милосердный"]],[3,90,["إِنَّ","ٱلَّذِينَ","كَفَرُواْ","بَعۡدَ","إِيمَٰنِهِمۡ","ثُمَّ","ٱزۡدَادُواْ","كُفۡرٗا","لَّن","تُقۡبَلَ","تَوۡبَتُهُمۡ","وَأُوْلَٰٓئِكَ","هُمُ","ٱلضَّآلُّونَ"],"иннал лазиина кафаруу ба`да ииманихим суммаздадуу куфрал лан туḳбала таубатухум ва'улаика хумуд даллуун","Воистину, от тех, которые стали неверующими после того, как уверовали, а потом приумножили свое неверие, не будет принято их покаяние. Они и есть заблудшие.",["поистине","те, которые","стали неверующими","после","их веры","затем","приумножили","неверие","никогда не","будет принято","их покаяние","и эти","они","заблудшие"]],[3,91,["إِنَّ","ٱلَّذِينَ","كَفَرُواْ","وَمَاتُواْ","وَهُمۡ","كُفَّارٞ","فَلَن","يُقۡبَلَ","مِنۡ","أَحَدِهِم","مِّلۡءُ","ٱلۡأَرۡضِ","ذَهَبٗا","وَلَوِ","ٱفۡتَدَىٰ","بِهِۦٓۗ","أُوْلَٰٓئِكَ","لَهُمۡ","عَذَابٌ","أَلِيمٞ","وَمَا","لَهُم","مِّن","نَّٰصِرِينَ"],"иннал лазиина кафаруу ваматуу вахум куффарун фалан йуḳбала мин ахадихим мил'ул арди захабан валавифтада бихии улаика лахум `азабун алиимун вама лахум мин насириин","Воистину, от тех, которые не уверовали и умерли неверующими, не будет принято даже золото размером с землю, если кто-нибудь из них попытается откупиться этим. Им уготованы мучительные страдания, и не будет у них помощников.",["поистине","те, которые","не уверовали","и умерли","и они","неверующие","то никогда не","будет принято","от","кого-либо из них","полнота","земли","золотом","и даже если","он откупится","им","эти","им","наказание","мучительное","и нет","у них","никаких","помощников"]]],"m":[[["قُلۡ","скажи",3,84],["ءَامَنَّا","мы уверовали",3,84],["بِٱللَّهِ","в Аллаха",3,84],["وَمَآ","и в то, что",3,84],["أُنزِلَ","ниспослано",3,84],["عَلَيۡنَا","нам",3,84],["وَمَآ","и что",3,84],["أُنزِلَ","ниспослано",3,84],["عَلَىٰٓ","на",3,84],["إِبۡرَٰهِيمَ","Ибрахима",3,84]],[["وَإِسۡمَٰعِيلَ","и Исмаила",3,84],["وَإِسۡحَٰقَ","и Исхака",3,84],["وَيَعۡقُوبَ","и Йакуба",3,84],["وَٱلۡأَسۡبَاطِ","и колена",3,84],["وَمَآ","и что",3,84],["أُوتِيَ","было даровано",3,84]],[["مُوسَىٰ","Мусе",3,84],["وَعِيسَىٰ","и Исе",3,84],["وَٱلنَّبِيُّونَ","и пророкам",3,84],["مِن","от",3,84],["رَّبِّهِمۡ","Господа их",3,84],["لَا","не",3,84],["نُفَرِّقُ","различаем мы",3,84],["بَيۡنَ","между",3,84],["أَحَدٖ","кем-либо",3,84]],[["مِّنۡهُمۡ","из них",3,84],["وَنَحۡنُ","и мы",3,84],["لَهُۥ","Ему",3,84],