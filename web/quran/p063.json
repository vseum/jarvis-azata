{"p":63,"j":4,"a":[[3,101,["وَكَيۡفَ","تَكۡفُرُونَ","وَأَنتُمۡ","تُتۡلَىٰ","عَلَيۡكُمۡ","ءَايَٰتُ","ٱللَّهِ","وَفِيكُمۡ","رَسُولُهُۥۗ","وَمَن","يَعۡتَصِم","بِٱللَّهِ","فَقَدۡ","هُدِيَ","إِلَىٰ","صِرَٰطٖ","مُّسۡتَقِيمٖ"],"вакайфа такфурууна ва'антум тутла `алайкум айатуллахи вафиикум расуулухуу ваман йа`тасим биллахи фаḳад худийа ила сиратим мустаḳиим","Как вы можете не веровать в то время, как вам читают знамения Аллаха, а Его Посланник находится среди вас? Кто крепко держится за Аллаха, тот действительно наставлен на прямой путь.",["и как","вы станете неверующими","в то время как вы","читаются","вам","знамения","Аллаха","и среди вас","Его Посланник","и кто","крепко держится","за Аллаха","то уже","он наставлен","на","путь","прямой"]],[3,102,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُواْ","ٱتَّقُواْ","ٱللَّهَ","حَقَّ","تُقَاتِهِۦ","وَلَا","تَمُوتُنَّ","إِلَّا","وَأَنتُم","مُّسۡلِمُونَ"],"йа'аййухал лазиина амануттаḳуллаха хаḳḳа туḳатихии вала тамуутунна илла ва'антум муслимуун","О те, которые уверовали! Бойтесь Аллаха должным образом и умирайте не иначе, как будучи мусульманами!",["о","те, которые","уверовали","бойтесь","Аллаха","должной","боязнью Его","и не","умирайте","кроме как","будучи вы","мусульманами"]],[3,103,["وَٱعۡتَصِمُواْ","بِحَبۡلِ","ٱللَّهِ","جَمِيعٗا","وَلَا","تَفَرَّقُواْۚ","وَٱذۡكُرُواْ","نِعۡمَتَ","ٱللَّهِ","عَلَيۡكُمۡ","إِذۡ","كُنتُمۡ","أَعۡدَآءٗ","فَأَلَّفَ","بَيۡنَ","قُلُوبِكُمۡ","فَأَصۡبَحۡتُم","بِنِعۡمَتِهِۦٓ","إِخۡوَٰنٗا","وَكُنتُمۡ","عَلَىٰ","شَفَا","حُفۡرَةٖ","مِّنَ","ٱلنَّارِ","فَأَنقَذَكُم","مِّنۡهَاۗ","كَذَٰلِكَ","يُبَيِّنُ","ٱللَّهُ","لَكُمۡ","ءَايَٰتِهِۦ","لَعَلَّكُمۡ","تَهۡتَدُونَ"],"ва`тасимуу бихаблиллахи жамии`ан вала тафарраḳуу вазкуруу ни`маталлахи `алайкум из кунтум а`даан фа'аллафа байна ḳулуубикум фа'асбахтум бини`матихии ихванан вакунтум `ала шафа хуфратим минан нари фа'анḳазакум минха казалика йубаййинуллаху лакум айатихии ла`аллакум тахтадуун","Крепко держитесь за вервь Аллаха все вместе и не разделяйтесь. Помните о милости, которую Аллах оказал вам, когда вы были врагами, а Он сплотил ваши сердца, и по Его милости вы стали братьями. Вы были на краю Огненной пропасти, и Он спас вас от нее. Так Аллах разъясняет вам Свои знамения, - быть может, вы последуете прямым путем.",["и держитесь крепко","за вервь","Аллаха","все вместе","и не","разделяйтесь","и помните","милость","Аллаха","вам","когда","вы были","врагами","и Он сплотил","между","вашими сердцами","и вы стали","по Его милости","братьями","и вы были","на","краю","ямы","из","Огня","и Он спас вас","от неё","так","разъясняет","Аллах","вам","Свои знамения","чтобы вы","следовали прямым путём"]],[3,104,["وَلۡتَكُن","مِّنكُمۡ","أُمَّةٞ","يَدۡعُونَ","إِلَى","ٱلۡخَيۡرِ","وَيَأۡمُرُونَ","بِٱلۡمَعۡرُوفِ","وَيَنۡهَوۡنَ","عَنِ","ٱلۡمُنكَرِۚ","وَأُوْلَٰٓئِكَ","هُمُ","ٱلۡمُفۡلِحُونَ"],"валтакум минкум умматун йад`ууна илал хайри вайа'мурууна билма`рууфи вайанхауна `анил мункари ва'улаика хумул муфлихуун","Пусть среди вас будет группа людей, которые будут призывать к добру, повелевать одобряемое и запрещать предосудительное. Именно они окажутся преуспевшими.",["и пусть будет","из вас","община","призывающие","к","добру","и повелевающие","одобряемое","и удерживающие","от","предосудительного","и эти","они","преуспевшие"]],[3,105,["وَلَا","تَكُونُواْ","كَٱلَّذِينَ","تَفَرَّقُواْ","وَٱخۡتَلَفُواْ","مِنۢ","بَعۡدِ","مَا","جَآءَهُمُ","ٱلۡبَيِّنَٰتُۚ","وَأُوْلَٰٓئِكَ","لَهُمۡ","عَذَابٌ","عَظِيمٞ"],"вала такуунуу каллазиина тафарраḳуу вахталафуу мим ба`ди ма жаахумул баййинату ва'улаика лахум `азабун `азиим","Не походите на тех, которые разделились и впали в разногласия после того, как к ним явились ясные знамения. Именно им уготованы великие мучения",["и не","будьте","как те, которые","разделились","и разошлись во мнениях","из","после","того как","пришли к ним","ясные знамения","и эти","им","наказание","великое"]],[3,106,["يَوۡمَ","تَبۡيَضُّ","وُجُوهٞ","وَتَسۡوَدُّ","وُجُوهٞۚ","فَأَمَّا","ٱلَّذِينَ","ٱسۡوَدَّتۡ","وُجُوهُهُمۡ","أَكَفَرۡتُم","بَعۡدَ","إِيمَٰنِكُمۡ","فَذُوقُواْ","ٱلۡعَذَابَ","بِمَا","كُنتُمۡ","تَكۡفُرُونَ"],"йаума табйадду вужуухун ватасвадду вужуухун фа'аммал лазиинасваддат вужуухухум акафартум ба`да ииманикум фазууḳул `азаба бима кунтум такфуруун","в тот день, когда одни лица побелеют, а другие - почернеют. Тем, чьи лица почернеют, будет сказано: «Неужели вы стали неверующими после того, как уверовали? Вкусите же мучения за то, что вы не верили!».",["в день, когда","побелеют","лица","и почернеют","лица","а что до","тех, у которых","почернели","лица их","неужели вы не уверовали","после","вашей веры","вкусите же","наказание","за то, что","вы были","неверующими"]],[3,107,["وَأَمَّا","ٱلَّذِينَ","ٱبۡيَضَّتۡ","وُجُوهُهُمۡ","فَفِي","رَحۡمَةِ","ٱللَّهِۖ","هُمۡ","فِيهَا","خَٰلِدُونَ"],"ва'аммал лазиинабйаддат вужуухухум фафии рахматиллахи хум фииха халидуун","Те же, чьи лица побелеют, окажутся в милости Аллаха. Они пребудут там вечно.",["а что до","тех, у которых","побелели","лица их","то в","милости","Аллаха","они","в ней","вечно пребывающие"]],[3,108,["تِلۡكَ","ءَايَٰتُ","ٱللَّهِ","نَتۡلُوهَا","عَلَيۡكَ","بِٱلۡحَقِّۗ","وَمَا","ٱللَّهُ","يُرِيدُ","ظُلۡمٗا","لِّلۡعَٰلَمِينَ"],"тилка айатуллахи натлууха `алайка билхаḳḳи вамаллаху йурииду зулмал лил`аламиин","Таковы аяты Аллаха, которые Мы читаем тебе истинно. Аллах не желает поступать с мирами несправедливо.",["это","аяты","Аллаха","Мы читаем их","тебе","с истиной","и не","Аллах","желает","несправедливости","мирам"]]],"m":[[["وَكَيۡفَ","и как",3,101],["تَكۡفُرُونَ","вы станете неверующими",3,101],["وَأَنتُمۡ","в то время как вы",3,101],["تُتۡلَىٰ","читаются",3,101],["عَلَيۡكُمۡ","вам",3,101],["ءَايَٰتُ","знамения",3,101],["ٱللَّهِ","Аллаха",3,101],["وَفِيكُمۡ","и среди вас",3,101]],[["رَسُولُهُۥۗ","Его Посланник",3,101],["وَمَن","и кто",3,101],["يَعۡتَصِم","крепко держится",3,101],["بِٱللَّهِ","за Аллаха",3,101],["فَقَدۡ","то уже",3,101],["هُدِيَ","он наставлен",3,101],["إِلَىٰ","на",3,101],["صِرَٰطٖ","путь",3,101],["مُّسۡتَقِيمٖ","прямой",3,101],[101]],[["يَٰٓأَيُّهَا","о",3,102],["ٱلَّذِينَ","те, которые",3,102],["ءَامَنُواْ","уверовали",3,102],["ٱتَّقُواْ","бойтесь",3,102],["ٱللَّهَ","Аллаха",3,102],["حَقَّ","должной",3,102],["تُقَاتِهِۦ","боязнью Его",3,102],["وَلَا","и не",3,102],["تَمُوتُنَّ","умирайте",3,102],["إِلَّا","кроме как",3,102],["وَأَنتُم","будучи вы",3,102]],[["مُّسۡلِمُونَ","мусульманами",3,102],[102],["وَٱعۡتَصِمُواْ","и держитесь крепко",3,103],["بِحَبۡلِ","за вервь",3,103],["ٱللَّهِ","Аллаха",3,103],["جَمِيعٗا","все вместе",3,103],["وَلَا","и не",3,103],["تَفَرَّقُواْۚ","разделяйтесь",3,103]],[["وَٱذۡكُرُواْ","и помните",3,103],["نِعۡمَتَ","милость",3,103],["ٱللَّهِ","Аллаха",3,103],["عَلَيۡكُمۡ","вам",3,103],["إِذۡ","когда",3,103],["كُنتُمۡ","вы были",3,103],["أَعۡدَآءٗ","врагами",3,103],["فَأَلَّفَ","и Он сплотил",3,103],["بَيۡنَ","между",3,103],["قُلُوبِكُمۡ","вашими сердцами",3,103]],[["فَأَصۡبَحۡتُم","и вы стали",3,103],["بِنِعۡمَتِهِۦٓ","по Его милости",3,103],["إِخۡوَٰنٗا","братьями",3,103],["وَكُنتُمۡ","и вы были",3,103],["عَلَىٰ","на",3,103],["شَفَا","краю",3,103],["حُفۡرَةٖ","ямы",3,103],["مِّنَ","из",3,103],["ٱلنَّارِ","Огня",3,103]],[["فَأَنقَذَكُم","и Он спас вас",3,103],["مِّنۡهَاۗ","от неё",3,103],["كَذَٰلِكَ","так",3,103],["يُبَيِّنُ","разъясняет",3,103],["ٱللَّهُ","Аллах",3,103],["لَكُمۡ","вам",3,103],["ءَايَٰتِهِۦ","Свои знамения",3,103],["لَعَلَّكُمۡ","чтобы вы",3,103],["تَهۡتَدُونَ","следовали прямым путём",3,103]],[[103],["وَلۡتَكُن","и пусть будет",3,104],["مِّنكُمۡ","из вас",3,104],["أُمَّةٞ","община",3,104],["يَدۡعُونَ","призывающие",3,104],["إِلَى","к",3,104],["ٱلۡخَيۡرِ","добру",3,104],["وَيَأۡمُرُونَ","и повелевающие",3,104],["بِٱلۡمَعۡرُوفِ","одобряемое",3,104]],[["وَيَنۡهَوۡنَ","и удерживающие",3,104],["عَنِ","от",3,104],["ٱلۡمُنكَرِۚ","предосудительного",3,104],["وَأُوْلَٰٓئِكَ","и эти",3,104],["هُمُ","они",3,104],["ٱلۡمُفۡلِحُونَ","преуспевшие",3,104],[104],["وَلَا","и не",3,105]],[["تَكُونُواْ","будьте",3,105],["كَٱلَّذِينَ","как те, которые",3,105],["تَفَرَّقُواْ","раздели