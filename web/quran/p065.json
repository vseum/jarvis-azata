{"p":65,"j":4,"a":[[3,116,["إِنَّ","ٱلَّذِينَ","كَفَرُواْ","لَن","تُغۡنِيَ","عَنۡهُمۡ","أَمۡوَٰلُهُمۡ","وَلَآ","أَوۡلَٰدُهُم","مِّنَ","ٱللَّهِ","شَيۡـٔٗاۖ","وَأُوْلَٰٓئِكَ","أَصۡحَٰبُ","ٱلنَّارِۖ","هُمۡ","فِيهَا","خَٰلِدُونَ"],"иннал лазиина кафаруу лан тугнийа `анхум амвалухум вала ауладухум миналлахи шай'ан ва'улаика асхабун нари хум фииха халидуун","Ни имущество, ни дети ничем не помогут перед Аллахом тем, которые не уверовали. Они будут обитателями Огня и пребудут там вечно.",["поистине","те, которые","не уверовали","никогда не","избавит","их","их имущество","и не","их дети","от","Аллаха","ничем","и эти","обитатели","Огня","они","в нём","вечно пребывающие"]],[3,117,["مَثَلُ","مَا","يُنفِقُونَ","فِي","هَٰذِهِ","ٱلۡحَيَوٰةِ","ٱلدُّنۡيَا","كَمَثَلِ","رِيحٖ","فِيهَا","صِرٌّ","أَصَابَتۡ","حَرۡثَ","قَوۡمٖ","ظَلَمُوٓاْ","أَنفُسَهُمۡ","فَأَهۡلَكَتۡهُۚ","وَمَا","ظَلَمَهُمُ","ٱللَّهُ","وَلَٰكِنۡ","أَنفُسَهُمۡ","يَظۡلِمُونَ"],"масалу ма йунфиḳууна фии хазихил хайаватид дунйа камасали риихин фииха сиррун асабат харса ḳаумин заламуу анфусахум фа'ахлакатху вама заламахумуллаху валакин анфусахум йазлимуун","То, что они расходуют в этой мирской жизни, подобно морозному (или завывающему; или огненному) ветру, который поразил ниву людей, поступивших несправедливо по отношению к себе, а затем погубил ее. Аллах не был несправедлив к ним - они сами поступали несправедливо по отношению к себе.",["пример","того, что","они расходуют","в","этой","жизни","мирской","как пример","ветра","в нём","мороз","поразил он","ниву","людей","которые обидели","самих себя","и погубил её","и не","обидел их","Аллах","но","самих себя","они обижают"]],[3,118,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُواْ","لَا","تَتَّخِذُواْ","بِطَانَةٗ","مِّن","دُونِكُمۡ","لَا","يَأۡلُونَكُمۡ","خَبَالٗا","وَدُّواْ","مَا","عَنِتُّمۡ","قَدۡ","بَدَتِ","ٱلۡبَغۡضَآءُ","مِنۡ","أَفۡوَٰهِهِمۡ","وَمَا","تُخۡفِي","صُدُورُهُمۡ","أَكۡبَرُۚ","قَدۡ","بَيَّنَّا","لَكُمُ","ٱلۡأٓيَٰتِۖ","إِن","كُنتُمۡ","تَعۡقِلُونَ"],"йа'аййухал лазиина амануу ла таттахизуу битанатам мин дууникум ла йа'луунакум хабалан ваддуу ма `аниттум ḳад бадатил багдау мин афвахихим вама тухфии судуурухум акбару ḳад баййанна лакумул айати ин кунтум та`ḳилуун","О те, которые уверовали! Не берите своими помощниками тех, кто не из вас. Они не упускают случая навредить вам и радуются вашим трудностям. Ненависть уже проявилась у них на устах, но в их сердцах кроется еще большая ненависть. Мы уже разъяснили вам знамения, если вы только разумеете!",["о","те, которые","уверовали","не","берите","приближёнными","из","помимо вас","не","упускают они вас","порчей","желают они","чтобы","вы страдали","уже","проявилась","ненависть","из","их уст","а то, что","скрывают","их груди","ещё больше","уже","Мы разъяснили","вам","знамения","если","вы","разумеете"]],[3,119,["هَٰٓأَنتُمۡ","أُوْلَآءِ","تُحِبُّونَهُمۡ","وَلَا","يُحِبُّونَكُمۡ","وَتُؤۡمِنُونَ","بِٱلۡكِتَٰبِ","كُلِّهِۦ","وَإِذَا","لَقُوكُمۡ","قَالُوٓاْ","ءَامَنَّا","وَإِذَا","خَلَوۡاْ","عَضُّواْ","عَلَيۡكُمُ","ٱلۡأَنَامِلَ","مِنَ","ٱلۡغَيۡظِۚ","قُلۡ","مُوتُواْ","بِغَيۡظِكُمۡۗ","إِنَّ","ٱللَّهَ","عَلِيمُۢ","بِذَاتِ","ٱلصُّدُورِ"],"ха'антум улаи тухиббуунахум вала йухиббуунакум вату'минууна билкитаби куллихии ва'иза лаḳуукум ḳалуу аманна ва'иза халау `аддуу `алайкумул анамила минал гайзи ḳул муутуу бигайзикум инналлаха `алииму бизатис судуур","Вот вы любите их, а они вас не любят. И вы верите во все Писания. Когда они встречаются с вами, то говорят: «Мы уверовали». Когда же остаются одни, то кусают кончики пальцев от злобы к вам. Скажи: «Умрите от своей злобы! Аллаху известно о том, что в груди».",["вот вы","эти","любите их","но не","любят они вас","и веруете","в Писание","всё его","и когда","встречают вас","говорят","мы уверовали","а когда","остаются одни","кусают","из-за вас","кончики пальцев","от","злобы","скажи","умрите","от вашей злобы","поистине","Аллах","Знающий","о сокрытом","в грудях"]],[3,120,["إِن","تَمۡسَسۡكُمۡ","حَسَنَةٞ","تَسُؤۡهُمۡ","وَإِن","تُصِبۡكُمۡ","سَيِّئَةٞ","يَفۡرَحُواْ","بِهَاۖ","وَإِن","تَصۡبِرُواْ","وَتَتَّقُواْ","لَا","يَضُرُّكُمۡ","كَيۡدُهُمۡ","شَيۡـًٔاۗ","إِنَّ","ٱللَّهَ","بِمَا","يَعۡمَلُونَ","مُحِيطٞ"],"ин тамсаскум хасанатун тасу'хум ва'ин тусибкум саййиатун йафрахуу биха ва'ин тасбируу вататтаḳуу ла йадуррукум кайдухум шай'ан инналлаха бима йа`малууна мухиит","Если с вами случается доброе, это огорчает их; если же вас постигает беда, они радуются. Но если вы будете терпеливы и богобоязненны, то их козни не причинят вам никакого вреда. Воистину, Аллах объемлет все, что они совершают.",["если","коснётся вас","добро","огорчает это их","а если","постигнет вас","зло","радуются они","ему","и если","вы будете терпеливы","и богобоязненны","не","повредит вам","их козни","ничем","поистине","Аллах","то, что","они делают","Объемлющий"]],[3,121,["وَإِذۡ","غَدَوۡتَ","مِنۡ","أَهۡلِكَ","تُبَوِّئُ","ٱلۡمُؤۡمِنِينَ","مَقَٰعِدَ","لِلۡقِتَالِۗ","وَٱللَّهُ","سَمِيعٌ","عَلِيمٌ"],"ва'из гадаута мин ахлика тубаввиул му'миниина маḳа`ида лилḳитали валлаху самии`ун `алиим","Вот ты покинул свою семью рано утром, чтобы расставить верующих по местам для сражения при Ухуде. Аллах - Слышащий, Знающий.",["и вот","ты вышел утром","от","своей семьи","расставляя","верующих","по местам","для сражения","и Аллах","Слышащий","Знающий"]]],"m":[[["إِنَّ","поистине",3,116],["ٱلَّذِينَ","те, которые",3,116],["كَفَرُواْ","не уверовали",3,116],["لَن","никогда не",3,116],["تُغۡنِيَ","избавит",3,116],["عَنۡهُمۡ","их",3,116],["أَمۡوَٰلُهُمۡ","их имущество",3,116],["وَلَآ","и не",3,116],["أَوۡلَٰدُهُم","их дети",3,116]],[["مِّنَ","от",3,116],["ٱللَّهِ","Аллаха",3,116],["شَيۡـٔٗاۖ","ничем",3,116],["وَأُوْلَٰٓئِكَ","и эти",3,116],["أَصۡحَٰبُ","обитатели",3,116],["ٱلنَّارِۖ","Огня",3,116],["هُمۡ","они",3,116],["فِيهَا","в нём",3,116],["خَٰلِدُونَ","вечно пребывающие",3,116],[116]],[["مَثَلُ","пример",3,117],["مَا","того, что",3,117],["يُنفِقُونَ","они расходуют",3,117],["فِي","в",3,117],["هَٰذِهِ","этой",3,117],["ٱلۡحَيَوٰةِ","жизни",3,117],["ٱلدُّنۡيَا","мирской",3,117],["كَمَث