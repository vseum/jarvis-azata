8],["فَإِنَّهُمۡ","ведь поистине они",3,128],["ظَٰلِمُونَ","беззаконники",3,128]],[[128],["وَلِلَّهِ","и Аллаху",3,129],["مَا","то, что",3,129],["فِي","в",3,129],["ٱلسَّمَٰوَٰتِ","небесах",3,129],["وَمَا","и то, что",3,129],["فِي","на",3,129],["ٱلۡأَرۡضِۚ","земле",3,129],["يَغۡفِرُ","Он прощает",3,129],["لِمَن","кому",3,129],["يَشَآءُ","пожелает",3,129]],[["وَيُعَذِّبُ","и наказывает",3,129],["مَن","кого",3,129],["يَشَآءُۚ","пожелает",3,129],["وَٱللَّهُ","и Аллах",3,129],["غَفُورٞ","Прощающий",3,129],["رَّحِيمٞ","Милосердный",3,129],[129],["يَٰٓأَيُّهَا","о",3,130],["ٱلَّذِينَ","те, которые",3,130]],[["ءَامَنُواْ","уверовали",3,130],["لَا","не",3,130],["تَأۡكُلُواْ","пожирайте",3,130],["ٱلرِّبَوٰٓاْ","лихву",3,130],["أَضۡعَٰفٗا","вдвойне",3,130],["مُّضَٰعَفَةٗۖ","умноженную",3,130],["وَٱتَّقُواْ","и бойтесь",3,130],["ٱللَّهَ","Аллаха",3,130]],[["لَعَلَّكُمۡ","чтобы вы",3,130],["تُفۡلِحُونَ","преуспели",3,130],[130],["وَٱتَّقُواْ","и бойтесь",3,131],["ٱلنَّارَ","Огня",3,131],["ٱلَّتِيٓ","который",3,131],["أُعِدَّتۡ","уготован",3,131],["لِلۡكَٰفِرِينَ","для неверующих",3,131]],[[131],["وَأَطِيعُواْ","и повинуйтесь",3,132],["ٱللَّهَ","Аллаху",3,132],["وَٱلرَّسُولَ","и Посланнику",3,132],["لَعَلَّكُمۡ","чтобы вы",3,132],["تُرۡحَمُونَ","были помилованы",3,132],[132]]]}