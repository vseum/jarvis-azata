{"p":66,"j":4,"a":[[3,122,["إِذۡ","هَمَّت","طَّآئِفَتَانِ","مِنكُمۡ","أَن","تَفۡشَلَا","وَٱللَّهُ","وَلِيُّهُمَاۗ","وَعَلَى","ٱللَّهِ","فَلۡيَتَوَكَّلِ","ٱلۡمُؤۡمِنُونَ"],"из хаммат таифатани минкум ан тафшала валлаху валиййухума ва`алаллахи фалйатаваккалил му'минуун","Когда два отряда среди вас готовы были пасть духом, Аллах был их Покровителем. Пусть же на Аллаха уповают верующие!",["когда","готовы были","два отряда","из вас","что","пасть духом","а Аллах","их Покровитель","и на","Аллаха","пусть уповают","верующие"]],[3,123,["وَلَقَدۡ","نَصَرَكُمُ","ٱللَّهُ","بِبَدۡرٖ","وَأَنتُمۡ","أَذِلَّةٞۖ","فَٱتَّقُواْ","ٱللَّهَ","لَعَلَّكُمۡ","تَشۡكُرُونَ"],"валаḳад насаракумуллаху бибадрин ва'антум азиллатун фаттаḳуллаха ла`аллакум ташкуруун","Аллах уже оказал вам поддержку при Бадре, когда вы были слабы. Бойтесь же Аллаха, - быть может, вы будете благодарны.",["и уже","помог вам","Аллах","при Бадре","а вы","униженные","бойтесь же","Аллаха","чтобы вы","были благодарны"]],[3,124,["إِذۡ","تَقُولُ","لِلۡمُؤۡمِنِينَ","أَلَن","يَكۡفِيَكُمۡ","أَن","يُمِدَّكُمۡ","رَبُّكُم","بِثَلَٰثَةِ","ءَالَٰفٖ","مِّنَ","ٱلۡمَلَٰٓئِكَةِ","مُنزَلِينَ"],"из таḳуулу лилму'миниина алан йакфийакум ан йумиддакум раббукум бисаласати алафим минал малаикати мунзалиин","Вот ты сказал верующим: «Разве вам не достаточно того, что ваш Господь ниспосылает вам в помощь три тысячи ангелов?».",["когда","ты говорил","верующим","разве не","достаточно вам","что","поможет вам","ваш Господь","тремя","тысячами","из","ангелов","ниспосланных"]],[3,125,["بَلَىٰٓۚ","إِن","تَصۡبِرُواْ","وَتَتَّقُواْ","وَيَأۡتُوكُم","مِّن","فَوۡرِهِمۡ","هَٰذَا","يُمۡدِدۡكُمۡ","رَبُّكُم","بِخَمۡسَةِ","ءَالَٰفٖ","مِّنَ","ٱلۡمَلَٰٓئِكَةِ","مُسَوِّمِينَ"],"бала ин тасбируу вататтаḳуу вайа'туукум мин фаурихим хаза йумдидкум раббукум бихамсати алафим минал малаикати мусаввимиин","Конечно, да! Если же вы будете терпеливы и богобоязненны, и если враги нападут на вас прямо сейчас, то ваш Господь поможет вам пятью тысячами меченых ангелов.",["да","если","вы будете терпеливы","и богобоязненны","и придут к вам","из","их натиска","этого","поможет вам","ваш Господь","пятью","тысячами","из","ангелов","отмеченных"]],[3,126,["وَمَا","جَعَلَهُ","ٱللَّهُ","إِلَّا","بُشۡرَىٰ","لَكُمۡ","وَلِتَطۡمَئِنَّ","قُلُوبُكُم","بِهِۦۗ","وَمَا","ٱلنَّصۡرُ","إِلَّا","مِنۡ","عِندِ","ٱللَّهِ","ٱلۡعَزِيزِ","ٱلۡحَكِيمِ"],"вама жа`алахуллаху илла бушра лакум валитатмаинна ḳулуубукум бихии ваман насру илла мин `индиллахил `азиизил хакиим","Аллах сделал это всего лишь благой вестью для вас и сделал это, чтобы ваши сердца утешились благодаря этому, поскольку победа приходит только от Могущественного и Мудрого Аллаха,",["и не","сделал это","Аллах","кроме как","благой вестью","для вас","и чтобы успокоились","ваши сердца","этим","и нет","победы","кроме как","от","у","Аллаха","Могущественного","Мудрого"]],[3,127,["لِيَقۡطَعَ","طَرَفٗا","مِّنَ","ٱلَّذِينَ","كَفَرُوٓاْ","أَوۡ","يَكۡبِتَهُمۡ","فَيَنقَلِبُواْ","خَآئِبِينَ"],"лийаḳта`а тарафам минал лазиина кафаруу ау йакбитахум файанḳалибуу хаибиин","и дабы отсечь от неверующих одну часть или разгромить их так, чтобы они вернулись разочарованными.",["чтобы Он отсёк","часть","из","тех, которые","не уверовали","или","разгромил их","и они вернулись","разочарованными"]],[3,128,["لَيۡسَ","لَكَ","مِنَ","ٱلۡأَمۡرِ","شَيۡءٌ","أَوۡ","يَتُوبَ","عَلَيۡهِمۡ","أَوۡ","يُعَذِّبَهُمۡ","فَإِنَّهُمۡ","ظَٰلِمُونَ"],"лайса лака минал амри шай'ун ау йатууба `алайхим ау йу`аззибахум фа'иннахум залимуун","Ты не принимаешь никакого решения. Аллах же либо примет их покаяния, либо накажет их, ведь они являются беззаконниками.",["нет","тебе","из","дела","ничего","либо","Он примет покаяние","их","или","накажет их","ведь поистине они","беззаконники"]],[3,129,["وَلِلَّهِ","مَا","فِي","ٱلسَّمَٰوَٰتِ","وَمَا","فِي","ٱلۡأَرۡضِۚ","يَغۡفِرُ","لِمَن","يَشَآءُ","وَيُعَذِّبُ","مَن","يَشَآءُۚ","وَٱللَّهُ","غَفُورٞ","رَّحِيمٞ"],"валиллахи ма фис самавати вама фил арди йагфиру лиман йашау вайу`аззибу ман йашау валлаху гафуурур рахиим","Аллаху принадлежит то, что на небесах, и то, что на земле. Он прощает, кого пожелает, и подвергает мучениям, кого пожелает. Аллах - Прощающий, Милосердный.",["и Аллаху","то, что","в","небесах","и то, что","на","земле","Он прощает","кому","пожелает","и наказывает","кого","пожелает","и Аллах","Прощающий","Милосердный"]],[3,130,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُواْ","لَا","تَأۡكُلُواْ","ٱلرِّبَوٰٓاْ","أَضۡعَٰفٗا","مُّضَٰعَفَةٗۖ","وَٱتَّقُواْ","ٱللَّهَ","لَعَلَّكُمۡ","تُفۡلِحُونَ"],"йа'аййухал лазиина амануу ла та'кулур рибава ад`афам муда`афатан ваттаḳуллаха ла`аллакум туфлихуун","О те, которые уверовали! Не пожирайте лихву в многократно умноженном размере и бойтесь Аллаха, - быть может, вы преуспеете.",["о","те, которые","уверовали","не","пожирайте","лихву","вдвойне","умноженную","и бойтесь","Аллаха","чтобы вы","преуспели"]],[3,131,["وَٱتَّقُواْ","ٱلنَّارَ","ٱلَّتِيٓ","أُعِدَّتۡ","لِلۡكَٰفِرِينَ"],"ваттаḳун нарал латии у`иддат лилкафириин","Бойтесь Огня, который уготован неверующим.",["и бойтесь","Огня","который","уготован","для неверующих"]],[3,132,["وَأَطِيعُواْ","ٱللَّهَ","وَٱلرَّسُولَ","لَعَلَّكُمۡ","تُرۡحَمُونَ"],"ва'атии`уллаха варрасуула ла`аллакум турхамуун","Повинуйтесь Аллаху и Посланнику, - быть может, вы будете помилованы.",["и повинуйтесь","Аллаху","и Посланнику","чтобы вы","были помилованы"]]],"m":[[["إِذۡ","когда",3,122],["هَمَّت","готовы были",3,122],["طَّآئِفَتَانِ","два отряда",3,122],["مِنكُمۡ","из вас",3,122],["أَن","что",3,122],["تَفۡشَلَا","пасть духом",3,122],["وَٱللَّهُ","а Аллах",3,122],["وَلِيُّهُمَاۗ","их Покровитель",3,122],["وَعَلَى","и на",3,122]],[["ٱللَّهِ","Аллаха",3,122],["فَلۡيَتَوَكَّلِ","пусть уповают",3,122],["ٱلۡمُؤۡمِنُونَ","верующие",3,122],[122],["وَلَقَدۡ","и уже",3,123],["نَصَرَكُمُ","помог вам",3,123],["ٱللَّهُ","Аллах",3,123],["بِبَدۡرٖ","при Бадре",3,123],["وَأَنتُمۡ","а вы",3,123]],[["أَذِلَّةٞۖ","униженные",3,123],["فَٱتَّقُواْ","бойтесь же",3,123],["ٱللَّهَ","Аллаха",3,123],["لَعَلَّكُمۡ","чтобы вы",3,123],["تَشۡكُرُو