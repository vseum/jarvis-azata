{"p":67,"j":4,"a":[[3,133,["وَسَارِعُوٓاْ","إِلَىٰ","مَغۡفِرَةٖ","مِّن","رَّبِّكُمۡ","وَجَنَّةٍ","عَرۡضُهَا","ٱلسَّمَٰوَٰتُ","وَٱلۡأَرۡضُ","أُعِدَّتۡ","لِلۡمُتَّقِينَ"],"васари`уу ила магфиратим мир раббикум важаннатин `ардухас самавату вал'арду у`иддат лилмуттаḳиин","Стремитесь к прощению вашего Господа и Раю, ширина которого равна небесам и земле, уготованному для богобоязненных,",["и спешите","к","прощению","от","вашего Господа","и Раю","ширина его","небеса","и земля","уготован","для богобоязненных"]],[3,134,["ٱلَّذِينَ","يُنفِقُونَ","فِي","ٱلسَّرَّآءِ","وَٱلضَّرَّآءِ","وَٱلۡكَٰظِمِينَ","ٱلۡغَيۡظَ","وَٱلۡعَافِينَ","عَنِ","ٱلنَّاسِۗ","وَٱللَّهُ","يُحِبُّ","ٱلۡمُحۡسِنِينَ"],"аллазиина йунфиḳууна фис сарраи ваддарраи валказимиинал гайза вал`афиина `анин наси валлаху йухиббул мухсиниин","которые делают пожертвования в радости и в горе, сдерживают гнев и прощают людей. Воистину, Аллах любит творящих добро.",["те, которые","расходуют","в","достатке","и в нужде","и сдерживающие","гнев","и прощающие","от","людей","и Аллах","любит","творящих добро"]],[3,135,["وَٱلَّذِينَ","إِذَا","فَعَلُواْ","فَٰحِشَةً","أَوۡ","ظَلَمُوٓاْ","أَنفُسَهُمۡ","ذَكَرُواْ","ٱللَّهَ","فَٱسۡتَغۡفَرُواْ","لِذُنُوبِهِمۡ","وَمَن","يَغۡفِرُ","ٱلذُّنُوبَ","إِلَّا","ٱللَّهُ","وَلَمۡ","يُصِرُّواْ","عَلَىٰ","مَا","فَعَلُواْ","وَهُمۡ","يَعۡلَمُونَ"],"валлазиина иза фа`алуу фахишатан ау заламуу анфусахум закаруллаха фастагфаруу лизунуубихим ваман йагфируз зунууба иллаллаху валам йусирруу `ала ма фа`алуу вахум йа`ламуун","Тем же, которые, совершив мерзкий поступок или несправедливо поступив против самих себя, помянули Аллаха и попросили прощения за свои грехи, - ведь кто прощает грехи, кроме Аллаха? - и тем, которые сознательно не упорствуют в том, что они совершили,",["и те, которые","когда","совершили","мерзость","или","обидели","самих себя","вспомнили","Аллаха","и попросили прощения","за свои грехи","а кто","прощает","грехи","кроме","Аллаха","и не","упорствуют","в","том, что","совершили","и они","знают"]],[3,136,["أُوْلَٰٓئِكَ","جَزَآؤُهُم","مَّغۡفِرَةٞ","مِّن","رَّبِّهِمۡ","وَجَنَّٰتٞ","تَجۡرِي","مِن","تَحۡتِهَا","ٱلۡأَنۡهَٰرُ","خَٰلِدِينَ","فِيهَاۚ","وَنِعۡمَ","أَجۡرُ","ٱلۡعَٰمِلِينَ"],"улаика жазаухум магфиратум мир раббихим важаннатун тажрии мин тахтихал анхару халидиина фииха вани`ма ажрул `амилиин","воздаянием будут прощение от их Господа и Райские сады, в которых текут реки и в которых они пребудут вечно. Как же прекрасно воздаяние тружеников!",["эти","воздаяние им","прощение","от","их Господа","и сады","текут","из","под ними","реки","вечно пребывая","в них","и прекрасна","награда","трудящихся"]],[3,137,["قَدۡ","خَلَتۡ","مِن","قَبۡلِكُمۡ","سُنَنٞ","فَسِيرُواْ","فِي","ٱلۡأَرۡضِ","فَٱنظُرُواْ","كَيۡفَ","كَانَ","عَٰقِبَةُ","ٱلۡمُكَذِّبِينَ"],"ḳад халат мин ḳабликум сунанун фасиируу фил арди фанзуруу кайфа кана `аḳибатул муказзибиин","До вас также случалось подобное (люди подвергались искушению, подобному тому, которому верующие подверглись во время сражения при Ухуде). Постранствуйте по земле и посмотрите, каким был конец тех, кто считал лжецами посланников.",["уже","прошли","из","до вас","обычаи","странствуйте же","по","земле","и посмотрите","каким","был","конец","считавших ложью"]],[3,138,["هَٰذَا","بَيَانٞ","لِّلنَّاسِ","وَهُدٗى","وَمَوۡعِظَةٞ","لِّلۡمُتَّقِينَ"],"хаза байанул линнаси вахудан вамау`изатул лилмуттаḳиин","Это есть разъяснение людям, верное руководство и увещевание для богобоязненных.",["это","разъяснение","для людей","и руководство","и увещевание","для богобоязненных"]],[3,139,["وَلَا","تَهِنُواْ","وَلَا","تَحۡزَنُواْ","وَأَنتُمُ","ٱلۡأَعۡلَوۡنَ","إِن","كُنتُم","مُّؤۡمِنِينَ"],"вала тахинуу вала тахзануу ва'антумул а`лауна ин кунтум му'миниин","Не слабейте и не печальтесь, в то время как вы будете на высоте, если вы действительно являетесь верующими.",["и не","слабейте","и не","печальтесь","а вы","высшие","если","вы","верующие"]],[3,140,["إِن","يَمۡسَسۡكُمۡ","قَرۡحٞ","فَقَدۡ","مَسَّ","ٱلۡقَوۡمَ","قَرۡحٞ","مِّثۡلُهُۥۚ","وَتِلۡكَ","ٱلۡأَيَّامُ","نُدَاوِلُهَا","بَيۡنَ","ٱلنَّاسِ","وَلِيَعۡلَمَ","ٱللَّهُ","ٱلَّذِينَ","ءَامَنُواْ","وَيَتَّخِذَ","مِنكُمۡ","شُهَدَآءَۗ","وَٱللَّهُ","لَا","يُحِبُّ","ٱلظَّٰلِمِينَ"],"ин йамсаскум ḳархун фаḳад массал ḳаума ḳархум мислухуу ватилкал аййаму нудавилуха байнан наси валийа`ламаллахул лазиина амануу вайаттахиза минкум шухадаа валлаху ла йухиббуз залимиин","Если вам нанесена рана, то ведь подобная рана уже была нанесена и тем людям. Мы чередуем дни (счастье и несчастье) для людей, чтобы Аллах узнал уверовавших и избрал среди вас павших мучеников, ведь Аллах не любит беззаконников,",["если","коснулась вас","рана","то уже","коснулась","тех людей","рана","подобная ей","и эти","дни","Мы чередуем их","между","людьми","и чтобы узнал","Аллах","тех, которые","уверовали","и избрал","из вас","мучеников","и Аллах","не","любит","беззаконников"]]],"m":[[["۞ وَسَارِعُوٓاْ","и спешите",3,133],["إِلَىٰ","к",3,133],["مَغۡفِرَةٖ","прощению",3,133],["مِّن","от",3,133],["رَّبِّكُمۡ","вашего Господа",3,133],["وَجَنَّةٍ","и Раю",3,133],["عَرۡضُهَا","ширина его",3,133]],[["ٱلسَّمَٰوَٰتُ","небеса",3,133],["وَٱلۡأَرۡضُ","и земля",3,133],["أُعِدَّتۡ","уготован",3,133],["لِلۡمُتَّقِينَ","для богобоязненных",3,133],[133],["ٱلَّذِينَ","те, которые",3,134],["يُنفِقُونَ","расходуют",3,134]],[["فِي","в",3,134],["ٱلسَّرَّآءِ","достатке",3,134],["وَٱلضَّرَّآءِ","и в нужде",3,134],["وَٱلۡكَٰظِمِينَ","и сдерживающие",3,134],["ٱلۡغَيۡظَ","гнев",3,134],["وَٱلۡعَافِينَ","и прощающие",3,134]],[["عَنِ","от",3,134],["ٱلنَّاسِۗ","людей",3,134],["وَٱللَّهُ","и Аллах",3,134],["يُحِبُّ","любит",3,134],["ٱلۡمُحۡسِنِينَ","творящих добро",3,134],[134],["وَٱلَّذِينَ","и те, которые",3,135],["إِذَا","когда",3,135]],[["فَعَلُواْ","совершили",3,135],["فَٰحِشَةً","мерзость",3,135],["أَوۡ","или",3,135],["ظَلَمُوٓاْ","обидели",3,135],["أَنفُسَهُمۡ","самих себя",3,135],["ذَكَرُواْ","вспомнили",3,135],["ٱللَّهَ","Аллаха",3,135],["فَٱسۡتَغۡفَرُواْ","и попросили прощения",3,135]],[["لِذُنُوبِهِمۡ","за свои грехи",3,135],["وَمَن