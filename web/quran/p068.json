{"p":68,"j":4,"a":[[3,141,["وَلِيُمَحِّصَ","ٱللَّهُ","ٱلَّذِينَ","ءَامَنُواْ","وَيَمۡحَقَ","ٱلۡكَٰفِرِينَ"],"валийумаххисаллахул лазиина амануу вайамхаḳал кафириин","и чтобы Аллах очистил тех, которые уверовали, и уничтожил неверующих.",["и чтобы очистил","Аллах","тех, которые","уверовали","и уничтожил","неверующих"]],[3,142,["أَمۡ","حَسِبۡتُمۡ","أَن","تَدۡخُلُواْ","ٱلۡجَنَّةَ","وَلَمَّا","يَعۡلَمِ","ٱللَّهُ","ٱلَّذِينَ","جَٰهَدُواْ","مِنكُمۡ","وَيَعۡلَمَ","ٱلصَّٰبِرِينَ"],"ам хасибтум ан тадхулул жанната валамма йа`ламиллахул лазиина жахадуу минкум вайа`ламас сабириин","Или вы полагали, что войдете в Рай, пока Аллах не узнал тех из вас, кто сражался и кто был терпелив?",["или","полагали вы","что","войдёте","в Рай","а ещё не","узнал","Аллах","тех, которые","сражались","из вас","и (не) узнал","терпеливых"]],[3,143,["وَلَقَدۡ","كُنتُمۡ","تَمَنَّوۡنَ","ٱلۡمَوۡتَ","مِن","قَبۡلِ","أَن","تَلۡقَوۡهُ","فَقَدۡ","رَأَيۡتُمُوهُ","وَأَنتُمۡ","تَنظُرُونَ"],"валаḳад кунтум таманнаунал маута мин ḳабли ан талḳауху фаḳад ра'айтумууху ва'антум танзуруун","Вы действительно желали смерти, пока не встретились с ней. Теперь вы увидели ее воочию.",["и действительно","вы","желали","смерти","от","прежде","чем","встретили её","и вот","вы увидели её","и вы","смотрите"]],[3,144,["وَمَا","مُحَمَّدٌ","إِلَّا","رَسُولٞ","قَدۡ","خَلَتۡ","مِن","قَبۡلِهِ","ٱلرُّسُلُۚ","أَفَإِيْن","مَّاتَ","أَوۡ","قُتِلَ","ٱنقَلَبۡتُمۡ","عَلَىٰٓ","أَعۡقَٰبِكُمۡۚ","وَمَن","يَنقَلِبۡ","عَلَىٰ","عَقِبَيۡهِ","فَلَن","يَضُرَّ","ٱللَّهَ","شَيۡـٔٗاۚ","وَسَيَجۡزِي","ٱللَّهُ","ٱلشَّٰكِرِينَ"],"вама мухаммадун илла расуулун ḳад халат мин ḳаблихир русулу афаим мата ау ḳутиланḳалабтум `ала а`ḳабикум ваман йанḳалиб `ала `аḳибайхи фалан йадурраллаха шай'ан васайажзиллахуш шакириин","Мухаммад является всего лишь Посланником. До него тоже были посланники. Неужели, если он умрет или будет убит, вы обратитесь вспять? Кто обратится вспять, тот ничуть не навредит Аллаху. Аллах же вознаградит благодарных.",["и не","Мухаммад","кроме","посланник","уже","прошли","от","до него","посланники","неужели если","он умер","или","убит","обратитесь вы","на","пятки ваши","и кто","обратится","на","пятки свои","то никогда не","навредит","Аллаху","ничем","и вознаградит","Аллах","благодарных"]],[3,145,["وَمَا","كَانَ","لِنَفۡسٍ","أَن","تَمُوتَ","إِلَّا","بِإِذۡنِ","ٱللَّهِ","كِتَٰبٗا","مُّؤَجَّلٗاۗ","وَمَن","يُرِدۡ","ثَوَابَ","ٱلدُّنۡيَا","نُؤۡتِهِۦ","مِنۡهَا","وَمَن","يُرِدۡ","ثَوَابَ","ٱلۡأٓخِرَةِ","نُؤۡتِهِۦ","مِنۡهَاۚ","وَسَنَجۡزِي","ٱلشَّٰكِرِينَ"],"вама кана линафсин ан тамуута илла би'изниллахи китабам му'ажжалан ваман йурид савабад дунйа ну'тихии минха ваман йурид савабал ахирати ну'тихии минха васанажзиш шакириин","Ни одна душа не умирает, кроме как с дозволения Аллаха, в предписанный срок. Тому, кто желает вознаграждения в этом мире, Мы дадим его, и тому, кто желает вознаграждения в Последней жизни, Мы дадим его. Мы вознаградим благодарных.",["и не","было","для души","чтобы","умерла","кроме как","с дозволения","Аллаха","(по) предписанию","определённому сроком","и кто","пожелает","награды","(этого) мира","дадим Мы ему","из него","и кто","пожелает","награды","Последней жизни","дадим Мы ему","из неё","и вознаградим Мы","благодарных"]],[3,146,["وَكَأَيِّن","مِّن","نَّبِيّٖ","قَٰتَلَ","مَعَهُۥ","رِبِّيُّونَ","كَثِيرٞ","فَمَا","وَهَنُواْ","لِمَآ","أَصَابَهُمۡ","فِي","سَبِيلِ","ٱللَّهِ","وَمَا","ضَعُفُواْ","وَمَا","ٱسۡتَكَانُواْۗ","وَٱللَّهُ","يُحِبُّ","ٱلصَّٰبِرِينَ"],"вакааййим мин набиййин ḳатала ма`ахуу риббиййууна касиирун фама вахануу лима асабахум фии сабиилиллахи вама да`уфуу вамастакануу валлаху йухиббус сабириин","Сколько было пророков, рядом с которыми сражалось много набожных верующих! Они не пали духом оттого, что постигло их на пути Аллаха, не проявили слабости и не смирились. Ведь Аллах любит терпеливых.",["и сколько","из","пророков","сражались","с ним","набожные люди","многочисленные","и не","пали духом они","из-за того, что","постигло их","на","пути","Аллаха","и не","ослабели они","и не","смирились они","и Аллах","любит","терпеливых"]],[3,147,["وَمَا","كَانَ","قَوۡلَهُمۡ","إِلَّآ","أَن","قَالُواْ","رَبَّنَا","ٱغۡفِرۡ","لَنَا","ذُنُوبَنَا","وَإِسۡرَافَنَا","فِيٓ","أَمۡرِنَا","وَثَبِّتۡ","أَقۡدَامَنَا","وَٱنصُرۡنَا","عَلَى","ٱلۡقَوۡمِ","ٱلۡكَٰفِرِينَ"],"вама кана ḳаулахум илла ан ḳалуу раббанагфир лана зунуубана ва'исрафана фии амрина васаббит аḳдамана вансурна `алал ḳаумил кафириин","Они не произносили ничего, кроме слов: «Господь наш! Прости нам наши грехи и излишества, которые мы допустили в нашем деле, утверди наши стопы и даруй нам победу над людьми неверующими».",["и не","было","словом их","кроме","как","сказали они","Господь наш","прости","нам","грехи наши","и излишества наши","в","деле нашем","и утверди","стопы наши","и помоги нам","против","людей","неверующих"]],[3,148,["فَـَٔاتَىٰهُمُ","ٱللَّهُ","ثَوَابَ","ٱلدُّنۡيَا","وَحُسۡنَ","ثَوَابِ","ٱلۡأٓخِرَةِۗ","وَٱللَّهُ","يُحِبُّ","ٱلۡمُحۡسِنِينَ"],"фа'атахумуллаху савабад дунйа вахусна савабил ахирати валлаху йухиббул мухсиниин","Аллах даровал им вознаграждение в этом мире и прекрасное вознаграждение в Последней жизни. Ведь Аллах любит творящих добро.",["и дал им","Аллах","награду","(этого) мира","и прекрасную","награду","Последней жизни","и Аллах","любит","творящих добро"]]],"m":[[["وَلِيُمَحِّصَ","и чтобы очистил",3,141],["ٱللَّهُ","Аллах",3,141],["ٱلَّذِينَ","тех, которые",3,141],["ءَامَنُواْ","уверовали",3,141],["وَيَمۡحَقَ","и уничтожил",3,141],["ٱلۡكَٰفِرِينَ","неверующих",3,141],[141],["أَمۡ","или",3,142]],[["حَسِبۡتُمۡ","полагали вы",3,142],["أَن","что",3,142],["تَدۡخُلُواْ","войдёте",3,142],["ٱلۡجَنَّةَ","в Рай",3,142],["وَلَمَّا","а ещё не",3,142],["يَعۡلَمِ","узнал",3,142],["ٱللَّهُ","Аллах",3,142],["ٱلَّذِينَ","тех, которые",3,142],["جَٰهَدُواْ","сражались",3,142]],[["مِنكُمۡ","из вас",3,142],["وَيَعۡلَمَ","и (не) узнал",3,142],["ٱلصَّٰبِرِينَ","терпеливых",3,142],[142],["وَلَقَدۡ","и действительно",3,143],["كُنتُمۡ","вы",3,143],["تَمَنَّوۡنَ","желали",3,143],["ٱلۡمَوۡتَ","смерти",3,143],["