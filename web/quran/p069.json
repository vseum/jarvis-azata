{"p":69,"j":4,"a":[[3,149,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُوٓاْ","إِن","تُطِيعُواْ","ٱلَّذِينَ","كَفَرُواْ","يَرُدُّوكُمۡ","عَلَىٰٓ","أَعۡقَٰبِكُمۡ","فَتَنقَلِبُواْ","خَٰسِرِينَ"],"йа'аййухал лазиина амануу ин тутии`ул лазиина кафаруу йаруддуукум `ала а`ḳабикум фатанḳалибуу хасириин","О те, которые уверовали! Если вы подчинитесь неверующим, то они обратят вас вспять, и вы вернетесь потерпевшими убыток.",["о","те, которые","уверовали","если","подчинитесь","тем, которые","не уверовали","обратят они вас","на","пятки ваши","и обратитесь вы","потерпевшими убыток"]],[3,150,["بَلِ","ٱللَّهُ","مَوۡلَىٰكُمۡۖ","وَهُوَ","خَيۡرُ","ٱلنَّٰصِرِينَ"],"балиллаху маулакум вахуа хайрун насириин","О нет! Аллах является вашим Покровителем. Он - Наилучший из помощников.",["нет же","Аллах","Покровитель ваш","и Он","лучший","из помощников"]],[3,151,["سَنُلۡقِي","فِي","قُلُوبِ","ٱلَّذِينَ","كَفَرُواْ","ٱلرُّعۡبَ","بِمَآ","أَشۡرَكُواْ","بِٱللَّهِ","مَا","لَمۡ","يُنَزِّلۡ","بِهِۦ","سُلۡطَٰنٗاۖ","وَمَأۡوَىٰهُمُ","ٱلنَّارُۖ","وَبِئۡسَ","مَثۡوَى","ٱلظَّٰلِمِينَ"],"санулḳии фии ḳулуубил лазиина кафарур ру`ба бима ашракуу биллахи ма лам йуназзил бихии султанан вама'вахумун нару ваби'са масваз залимиин","Мы вселим ужас в сердца неверующих за то, что они приобщали к Аллаху сотоварищей, о которых Он не ниспослал никакого доказательства. Их пристанищем будет Огонь. Как же скверна обитель беззаконников!",["Мы бросим","в","сердца","тех, которые","не уверовали","ужас","за то, что","придали сотоварищей","Аллаху","то, на что","не","ниспослал Он","на это","никакого доказательства","и пристанище их","Огонь","и скверна","обитель","беззаконников"]],[3,152,["وَلَقَدۡ","صَدَقَكُمُ","ٱللَّهُ","وَعۡدَهُۥٓ","إِذۡ","تَحُسُّونَهُم","بِإِذۡنِهِۦۖ","حَتَّىٰٓ","إِذَا","فَشِلۡتُمۡ","وَتَنَٰزَعۡتُمۡ","فِي","ٱلۡأَمۡرِ","وَعَصَيۡتُم","مِّنۢ","بَعۡدِ","مَآ","أَرَىٰكُم","مَّا","تُحِبُّونَۚ","مِنكُم","مَّن","يُرِيدُ","ٱلدُّنۡيَا","وَمِنكُم","مَّن","يُرِيدُ","ٱلۡأٓخِرَةَۚ","ثُمَّ","صَرَفَكُمۡ","عَنۡهُمۡ","لِيَبۡتَلِيَكُمۡۖ","وَلَقَدۡ","عَفَا","عَنكُمۡۗ","وَٱللَّهُ","ذُو","فَضۡلٍ","عَلَى","ٱلۡمُؤۡمِنِينَ"],"валаḳад садаḳакумуллаху ва`дахуу из тахуссуунахум би'изнихии хатта иза фашилтум ватаназа`тум фил амри ва`асайтум мим ба`ди ма аракум ма тухиббууна минкум ман йуриидуд дунйа ваминкум ман йуриидул ахирата сумма сарафакум `анхум лийабталийакум валаḳад `афа `анкум валлаху зуу фадлин `алал му'миниин","Аллах исполнил данное вам обещание, когда вы уничтожали их с Его дозволения, пока вы не пали духом, не стали спорить относительно приказа и не ослушались после того, как Он показал вам то, что вы любите. Среди вас есть такие, которые желают этот мир, и такие, которые желают Последнюю жизнь. После этого Он заставил вас бежать от них, чтобы испытать вас. Он уже простил вас, ведь Аллах оказывает милость к верующим.",["и действительно","исполнил вам","Аллах","обещание Своё","когда","вы истребляли их","с дозволения Его","пока","когда","пали духом вы","и заспорили вы","о","деле","и ослушались вы","от","после","того как","показал Он вам","то, что","вы любите","среди вас","кто","желает","мира (этого)","и среди вас","кто","желает","Последней жизни","затем","отвратил Он вас","от них","чтобы испытать вас","и действительно","простил Он","вас","и Аллах","обладатель","милости","к","верующим"]],[3,153,["إِذۡ","تُصۡعِدُونَ","وَلَا","تَلۡوُۥنَ","عَلَىٰٓ","أَحَدٖ","وَٱلرَّسُولُ","يَدۡعُوكُمۡ","فِيٓ","أُخۡرَىٰكُمۡ","فَأَثَٰبَكُمۡ","غَمَّۢا","بِغَمّٖ","لِّكَيۡلَا","تَحۡزَنُواْ","عَلَىٰ","مَا","فَاتَكُمۡ","وَلَا","مَآ","أَصَٰبَكُمۡۗ","وَٱللَّهُ","خَبِيرُۢ","بِمَا","تَعۡمَلُونَ"],"из тус`идууна вала талвууна `ала ахадин варрасуулу йад`уукум фии ухракум фа'асабакум гамма бигаммил ликайла тахзануу `ала ма фатакум вала ма асабакум валлаху хабииру бима та`малуун","Вот вы бросились бежать, не оглядываясь друг на друга, тогда как Посланник призывал вас, находясь в последних (ближайших к противнику) рядах, и Аллах воздал вам печалью за печаль, чтобы вы не скорбели о том, что было вами упущено, и о том, что поразило вас. Аллаху известно о том, что вы совершаете.",["вот","вы бежали вверх","и не","оглядывались","на","кого-либо","а Посланник","звал вас","в","задних рядах ваших","и воздал Он вам","печалью","за печаль","чтобы не","скорбели вы","о","том, что","упустили вы","и не","о том, что","постигло вас","и Аллах","сведущ","о том, что","вы делаете"]]],"m":[[["يَٰٓأَيُّهَا","о",3,149],["ٱلَّذِينَ","те, которые",3,149],["ءَامَنُوٓاْ","уверовали",3,149],["إِن","если",3,149],["تُطِيعُواْ","подчинитесь",3,149],["ٱلَّذِينَ","тем, которые",3,149],["كَفَرُواْ","не уверовали",3,149]],[["يَرُدُّوكُمۡ","обратят они вас",3,149],["عَلَىٰٓ","на",3,149],["أَعۡقَٰبِكُمۡ","пятки ваши",3,149],["فَتَنقَلِبُواْ","и обратитесь вы",3,149],["خَٰسِرِينَ","потерпевшими убыток",3,149],[149]],[["بَلِ","нет же",3,150],["ٱللَّهُ","Аллах",3,150],["مَوۡلَىٰكُمۡۖ","Покровитель ваш",3,150],["وَهُوَ","и Он",3,150],["خَيۡرُ","лучший",3,150],["ٱلنَّٰصِرِينَ","из помощников",3,150],[150],["سَنُلۡقِي","Мы бросим",3,151]],[["فِي","в",3,151],["قُلُوبِ","сердца",3,151],["ٱلَّذِينَ","тех, которые",3,151],["كَفَرُواْ","не уверовали",3,151],["ٱلرُّعۡبَ","ужас",3,151],["بِمَآ","за то, что",3,151],["أَشۡرَكُواْ","придали сотоварищей",3,151],["بِٱللَّهِ","Аллаху",3,151]],[["مَا","то, на что",3,151],["لَمۡ","не",3,151],["يُنَزِّلۡ","ниспослал Он",3,151],["بِهِۦ","на это",3,151],["سُلۡطَٰنٗاۖ","никакого доказательства",3,151],["وَمَأۡوَىٰهُمُ","и пристанище их",3,151],["ٱلنَّارُۖ","Огонь",3,151],["وَبِئۡسَ","и скверна",3,151]],[["مَثۡوَى","обитель",3,151],["ٱلظَّٰلِمِينَ","беззаконников",3,151],[151],["وَلَقَدۡ","и действительно",3,152],["صَدَقَكُمُ","исполнил вам",3,152],["ٱللَّهُ","Аллах",3,152]],[["وَعۡدَهُۥٓ","обещание Своё",3,152],["إِذۡ","когда",3,152],["تَحُسُّونَهُم","вы истребляли их",3,152],["بِإِذۡنِهِۦۖ","с дозволения Его",3,152],["حَتَّىٰٓ","пока",3,152],["إِذَا","когда",3,152],["فَشِلۡتُمۡ","пали духом вы",3,152]],[["وَتَنَٰزَعۡتُمۡ","и заспорили вы",3,152],["فِي","о",3,152],["ٱلۡأَمۡرِ","деле",3,152],["وَعَصَيۡتُم