{"p":73,"j":4,"a":[[3,174,["فَٱنقَلَبُواْ","بِنِعۡمَةٖ","مِّنَ","ٱللَّهِ","وَفَضۡلٖ","لَّمۡ","يَمۡسَسۡهُمۡ","سُوٓءٞ","وَٱتَّبَعُواْ","رِضۡوَٰنَ","ٱللَّهِۗ","وَٱللَّهُ","ذُو","فَضۡلٍ","عَظِيمٍ"],"фанḳалабуу бини`матим миналлахи вафадлил лам йамсасхум су'уун ваттаба`уу ридваналлахи валлаху зуу фадлин `азиим","Они вернулись с милостью от Аллаха и щедротами. Зло не коснулось их, и они последовали за довольством Аллаха. Воистину, Аллах обладает великой милостью.",["и вернулись они","с благодеянием","от","Аллаха","и милостью","не","коснулось их","зло","и последовали они","довольству","Аллаха","и Аллах","обладатель","милости","великой"]],[3,175,["إِنَّمَا","ذَٰلِكُمُ","ٱلشَّيۡطَٰنُ","يُخَوِّفُ","أَوۡلِيَآءَهُۥ","فَلَا","تَخَافُوهُمۡ","وَخَافُونِ","إِن","كُنتُم","مُّؤۡمِنِينَ"],"иннама заликумуш шайтану йухаввифу аулийаахуу фала тахафуухум вахафууни ин кунтум му'миниин","Это всего лишь дьявол пугает вас своими помощниками. Не бойтесь их, а бойтесь Меня, если вы являетесь верующими.",["лишь","это","дьявол","устрашает","помощниками своими","так не","бойтесь их","и бойтесь Меня","если","вы","верующие"]],[3,176,["وَلَا","يَحۡزُنكَ","ٱلَّذِينَ","يُسَٰرِعُونَ","فِي","ٱلۡكُفۡرِۚ","إِنَّهُمۡ","لَن","يَضُرُّواْ","ٱللَّهَ","شَيۡـٔٗاۚ","يُرِيدُ","ٱللَّهُ","أَلَّا","يَجۡعَلَ","لَهُمۡ","حَظّٗا","فِي","ٱلۡأٓخِرَةِۖ","وَلَهُمۡ","عَذَابٌ","عَظِيمٌ"],"вала йахзункал лазиина йусари`ууна фил куфри иннахум лан йадурруллаха шай'ан йуриидуллаху алла йаж`ала лахум хаззан фил ахирати валахум `азабун `азиим","Пусть не печалят тебя те, которые спешат к неверию. Они ничем не навредят Аллаху. Аллах желает лишить их доли в Последней жизни, и им уготованы великие мучения.",["и пусть не","печалят тебя","те, которые","спешат","в","неверие","поистине они","никогда не","навредят","Аллаху","ничем","желает","Аллах","чтобы не","дать","им","доли","в","Последней жизни","и им","мучение","великое"]],[3,177,["إِنَّ","ٱلَّذِينَ","ٱشۡتَرَوُاْ","ٱلۡكُفۡرَ","بِٱلۡإِيمَٰنِ","لَن","يَضُرُّواْ","ٱللَّهَ","شَيۡـٔٗاۖ","وَلَهُمۡ","عَذَابٌ","أَلِيمٞ"],"иннал лазиинаштаравул куфра бил'иимани лан йадурруллаха шай'ан валахум `азабун алиим","Те, которые купили неверие за веру, не причинят никакого вреда Аллаху, и им уготованы мучительные страдания.",["поистине","те, которые","купили","неверие","за веру","никогда не","навредят они","Аллаху","ничем","и им","мучение","мучительное"]],[3,178,["وَلَا","يَحۡسَبَنَّ","ٱلَّذِينَ","كَفَرُوٓاْ","أَنَّمَا","نُمۡلِي","لَهُمۡ","خَيۡرٞ","لِّأَنفُسِهِمۡۚ","إِنَّمَا","نُمۡلِي","لَهُمۡ","لِيَزۡدَادُوٓاْ","إِثۡمٗاۖ","وَلَهُمۡ","عَذَابٞ","مُّهِينٞ"],"вала йахсабаннал лазиина кафаруу аннама нумлии лахум хайрул ли'анфусихим иннама нумлии лахум лийаздадуу исман валахум `азабум мухиин","Пусть неверующие не думают, что предоставленная Нами отсрочка является благом для них. Мы предоставляем им отсрочку для того, чтобы они приумножили свои грехи. Им уготованы унизительные мучения.",["и пусть не","думают","те, которые","не уверовали","что то, что","Мы даём отсрочку","им","благо","для них самих","лишь","Мы даём отсрочку","им","чтобы приумножили они","грех","и им","мучение","унизительное"]],[3,179,["مَّا","كَانَ","ٱللَّهُ","لِيَذَرَ","ٱلۡمُؤۡمِنِينَ","عَلَىٰ","مَآ","أَنتُمۡ","عَلَيۡهِ","حَتَّىٰ","يَمِيزَ","ٱلۡخَبِيثَ","مِنَ","ٱلطَّيِّبِۗ","وَمَا","كَانَ","ٱللَّهُ","لِيُطۡلِعَكُمۡ","عَلَى","ٱلۡغَيۡبِ","وَلَٰكِنَّ","ٱللَّهَ","يَجۡتَبِي","مِن","رُّسُلِهِۦ","مَن","يَشَآءُۖ","فَـَٔامِنُواْ","بِٱللَّهِ","وَرُسُلِهِۦۚ","وَإِن","تُؤۡمِنُواْ","وَتَتَّقُواْ","فَلَكُمۡ","أَجۡرٌ","عَظِيمٞ"],"мма каналлаху лийазарал му'миниина `ала ма антум `алайхи хатта йамиизал хабииса минат таййиби вама каналлаху лийутли`акум `алал гайби валакинналлаха йажтабии мир русулихии ман йашау фа'аминуу биллахи варусулихии ва'ин ту'минуу вататтаḳуу фалакум ажрун `азиим","Аллах не оставит верующих в том положении, в котором вы находитесь, пока не отличит скверного от благого. Аллах не откроет вам сокровенное знание, однако Аллах избирает среди Своих посланников того, кого пожелает. Уверуйте же в Аллаха и Его посланников, ведь если вы уверуете и будете богобоязненны, то получите великую награду.",["не","был","Аллах","чтобы оставить","верующих","в","том, в чём","вы","пребываете","пока не","отделит Он","скверное","от","благого","и не","был","Аллах","чтобы открыть вам","о","сокровенном","но","Аллах","избирает","из","посланников Своих","кого","пожелает Он","так уверуйте","в Аллаха","и посланников Его","и если","уверуете","и будете богобоязненны","то вам","награда","великая"]],[3,180,["وَلَا","يَحۡسَبَنَّ","ٱلَّذِينَ","يَبۡخَلُونَ","بِمَآ","ءَاتَىٰهُمُ","ٱللَّهُ","مِن","فَضۡلِهِۦ","هُوَ","خَيۡرٗا","لَّهُمۖ","بَلۡ","هُوَ","شَرّٞ","لَّهُمۡۖ","سَيُطَوَّقُونَ","مَا","بَخِلُواْ","بِهِۦ","يَوۡمَ","ٱلۡقِيَٰمَةِۗ","وَلِلَّهِ","مِيرَٰثُ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِۗ","وَٱللَّهُ","بِمَا","تَعۡمَلُونَ","خَبِيرٞ"],"вала йахсабаннал лазиина йабхалууна бима атахумуллаху мин фадлихии хуа хайрал лахум бал хуа шаррул лахум сайутавваḳууна ма бахилуу бихии йаумал ḳийамати валиллахи миирасус самавати вал'арди валлаху бима та`малууна хабиир","Пусть не думают те, которые скупятся расходовать то, что Аллах даровал им по Своей милости, что поступать так лучше для них. Напротив, это хуже для них. В День воскресения их шеи будут обернуты тем, что они жалели. Аллаху принадлежит наследие небес и земли, и Аллах ведает о том, что вы совершаете.",["и пусть не","думают","те, которые","скупятся","тем, что","даровал им","Аллах","из","милости Своей","что это","благо","для них","нет же","это","зло","для них","обвиты будут их шеи","тем, что","скупились они","этим","в День","Воскресения","и Аллаху","наследие","небес","и земли","и Аллах","о том, что","вы делаете","сведущ"]]],"m":[[["فَٱنقَلَبُواْ","и вернулись они",3,174],["بِنِعۡمَةٖ","с благодеянием",3,174],["مِّنَ","от",3,174],["ٱللَّهِ","Аллаха",3,174],["وَفَضۡلٖ","и милостью",3,174],["لَّمۡ","не",3,174],["يَمۡسَسۡهُمۡ","коснулось их",3,174],["سُوٓءٞ","зло",3,174],["وَٱتَّبَعُواْ","и последовали они",3,174]],[["رِضۡوَٰنَ","довольству",3,174],["ٱللَّهِۗ