{"p":75,"j":4,"a":[[3,187,["وَإِذۡ","أَخَذَ","ٱللَّهُ","مِيثَٰقَ","ٱلَّذِينَ","أُوتُواْ","ٱلۡكِتَٰبَ","لَتُبَيِّنُنَّهُۥ","لِلنَّاسِ","وَلَا","تَكۡتُمُونَهُۥ","فَنَبَذُوهُ","وَرَآءَ","ظُهُورِهِمۡ","وَٱشۡتَرَوۡاْ","بِهِۦ","ثَمَنٗا","قَلِيلٗاۖ","فَبِئۡسَ","مَا","يَشۡتَرُونَ"],"ва'из ахазаллаху миисаḳал лазиина уутул китаба латубаййинуннахуу линнаси вала тактумуунахуу фанабазууху вараа зухуурихим ваштарау бихии саманан ḳалиилан фаби'са ма йаштаруун","Вот Аллах взял завет с тех, кому было даровано Писание: «Вы обязательно будете разъяснять его людям и не будете скрывать его». Но они бросили его за спины и продали его за ничтожную цену. Как же скверно то, что они приобретают!",["и вот","взял","Аллах","завет","с тех, которые","были даны","Писание","непременно разъясняйте его","людям","и не","скрывайте его","но бросили они его","за","спины свои","и купили","за него","цену","малую","и скверно же","то, что","покупают они"]],[3,188,["لَا","تَحۡسَبَنَّ","ٱلَّذِينَ","يَفۡرَحُونَ","بِمَآ","أَتَواْ","وَّيُحِبُّونَ","أَن","يُحۡمَدُواْ","بِمَا","لَمۡ","يَفۡعَلُواْ","فَلَا","تَحۡسَبَنَّهُم","بِمَفَازَةٖ","مِّنَ","ٱلۡعَذَابِۖ","وَلَهُمۡ","عَذَابٌ","أَلِيمٞ"],"ла тахсабаннал лазиина йафрахууна бима атав вайухиббууна ан йухмадуу бима лам йаф`алуу фала тахсабаннахум бимафазатим минал `азаби валахум `азабун алиим","Не думай же, что те, которые радуются своим поступкам и любят, чтобы их хвалили за то, чего они не совершали, спасутся от мучений. Им уготованы мучительные страдания.",["не","думай","те, которые","радуются","тому, что","совершили","и любят","чтобы","их хвалили","за то, что","не","сделали они","так не","думай, что они","в спасении","от","наказания","и им","наказание","мучительное"]],[3,189,["وَلِلَّهِ","مُلۡكُ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِۗ","وَٱللَّهُ","عَلَىٰ","كُلِّ","شَيۡءٖ","قَدِيرٌ"],"валиллахи мулкус самавати вал'арди валлаху `ала кулли шай'ин ḳадиир","Аллаху принадлежит власть над небесами и землей, и Аллах способен на всякую вещь.",["и Аллаху","власть","небес","и земли","и Аллах","над","всякой","вещью","Всемогущ"]],[3,190,["إِنَّ","فِي","خَلۡقِ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِ","وَٱخۡتِلَٰفِ","ٱلَّيۡلِ","وَٱلنَّهَارِ","لَأٓيَٰتٖ","لِّأُوْلِي","ٱلۡأَلۡبَٰبِ"],"инна фии халḳис самавати вал'арди вахтилафил лайли ваннахари ла'айатил ли'улил албаб","Воистину, в сотворении небес и земли, а также в смене ночи и дня заключены знамения для обладающих разумом,",["поистине","в","сотворении","небес","и земли","и смене","ночи","и дня","непременно знамения","для обладающих","разумом"]],[3,191,["ٱلَّذِينَ","يَذۡكُرُونَ","ٱللَّهَ","قِيَٰمٗا","وَقُعُودٗا","وَعَلَىٰ","جُنُوبِهِمۡ","وَيَتَفَكَّرُونَ","فِي","خَلۡقِ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِ","رَبَّنَا","مَا","خَلَقۡتَ","هَٰذَا","بَٰطِلٗا","سُبۡحَٰنَكَ","فَقِنَا","عَذَابَ","ٱلنَّارِ"],"аллазиина йазкурууналлаха ḳийаман ваḳу`уудан ва`ала жунуубихим вайатафаккарууна фии халḳис самавати вал'арди раббана ма халаḳта хаза батилан субханака фаḳина `азабан нар","которые поминают Аллаха стоя, сидя и на боку и размышляют о сотворении небес и земли: «Господь наш! Ты не сотворил это понапрасну. Пречист Ты! Защити же нас от мучений в Огне.",["те, которые","поминают","Аллаха","стоя","и сидя","и на","боках своих","и размышляют","о","сотворении","небес","и земли","Господь наш","не","сотворил Ты","это","напрасно","пречист Ты","защити же нас","от наказания","Огня"]],[3,192,["رَبَّنَآ","إِنَّكَ","مَن","تُدۡخِلِ","ٱلنَّارَ","فَقَدۡ","أَخۡزَيۡتَهُۥۖ","وَمَا","لِلظَّٰلِمِينَ","مِنۡ","أَنصَارٖ"],"раббана иннака ман тудхилин нара фаḳад ахзайтахуу вама лиззалимиина мин ансар","Господь наш! Тот, кого Ты ввергнешь в Огонь, будет опозорен, и не будет у беззаконников помощников.",["Господь наш","поистине, Ты","кого","введёшь Ты","в Огонь","то уже","опозорил Ты его","и нет","у несправедливых","никаких","помощников"]],[3,193,["رَّبَّنَآ","إِنَّنَا","سَمِعۡنَا","مُنَادِيٗا","يُنَادِي","لِلۡإِيمَٰنِ","أَنۡ","ءَامِنُواْ","بِرَبِّكُمۡ","فَـَٔامَنَّاۚ","رَبَّنَا","فَٱغۡفِرۡ","لَنَا","ذُنُوبَنَا","وَكَفِّرۡ","عَنَّا","سَيِّـَٔاتِنَا","وَتَوَفَّنَا","مَعَ","ٱلۡأَبۡرَارِ"],"рраббана иннана сами`на мунадийан йунадии лил'иимани ан аминуу бираббикум фа'аманна раббана фагфир лана зунуубана вакаффир `анна саййиатина ватаваффана ма`ал абрар","Господь наш! Мы услышали глашатая (Мухаммада), который призывал к вере: «Уверуйте в вашего Господа», - и мы уверовали. Господь наш! Прости нам наши грехи, отпусти нам наши прегрешения и умертви нас вместе с благочестивыми.",["Господь наш","поистине, мы","услышали","глашатая","призывающего","к вере","чтобы","уверуйте","в Господа вашего","и мы уверовали","Господь наш","так прости","нам","грехи наши","и очисти","от нас","дурные деяния наши","и упокой нас","с","праведниками"]],[3,194,["رَبَّنَا","وَءَاتِنَا","مَا","وَعَدتَّنَا","عَلَىٰ","رُسُلِكَ","وَلَا","تُخۡزِنَا","يَوۡمَ","ٱلۡقِيَٰمَةِۖ","إِنَّكَ","لَا","تُخۡلِفُ","ٱلۡمِيعَادَ"],"раббана ва'атина ма ва`адттана `ала русулика вала тухзина йаумал ḳийамати иннака ла тухлифул мии`ад","Господь наш! Даруй нам то, что Ты обещал нам через Своих посланников, и не позорь нас в День воскресения, ведь Ты не нарушаешь обещаний».",["Господь наш","и даруй нам","то, что","обещал Ты нам","через","посланников Твоих","и не","позорь нас","в День","воскресения","поистине, Ты","не","нарушаешь","обещания"]]],"m":[[["وَإِذۡ","и вот",3,187],["أَخَذَ","взял",3,187],["ٱللَّهُ","Аллах",3,187],["مِيثَٰقَ","завет",3,187],["ٱلَّذِينَ","с тех, которые",3,187],["أُوتُواْ","были даны",3,187],["ٱلۡكِتَٰبَ","Писание",3,187],["لَتُبَيِّنُنَّهُۥ","непременно разъясняйте его",3,187],["لِلنَّاسِ","людям",3,187]],[["وَلَا","и не",3,187],["تَكۡتُمُونَهُۥ","скрывайте его",3,187],["فَنَبَذُوهُ","но бросили они его",3,187],["وَرَآءَ","за",3,187],["ظُهُورِهِمۡ","спины свои",3,187],["وَٱشۡتَرَوۡاْ","и купили",3,187],["بِهِۦ","за него",3,187],["ثَمَنٗا","цену",3,187]],[["قَلِيلٗاۖ","малую",3,187],["فَبِئۡسَ","и скверно же",3,187],["مَا","то, что",3,187],["يَشۡتَرُونَ","покупают они",3,187],[187],["لَا","не",3,188],["تَحۡسَبَنَّ","думай",3,188],["ٱلَّذِينَ","т