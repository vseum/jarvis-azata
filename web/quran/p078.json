{"p":78,"j":4,"a":[[4,7,["لِّلرِّجَالِ","نَصِيبٞ","مِّمَّا","تَرَكَ","ٱلۡوَٰلِدَانِ","وَٱلۡأَقۡرَبُونَ","وَلِلنِّسَآءِ","نَصِيبٞ","مِّمَّا","تَرَكَ","ٱلۡوَٰلِدَانِ","وَٱلۡأَقۡرَبُونَ","مِمَّا","قَلَّ","مِنۡهُ","أَوۡ","كَثُرَۚ","نَصِيبٗا","مَّفۡرُوضٗا"],"ллиррижали насиибум мимма таракал валидани вал'аḳрабууна валиннисаи насиибум мимма таракал валидани вал'аḳрабууна мимма ḳалла минху ау касура насиибам мафрууда","Мужчинам принадлежит доля из того, что оставили родители и ближайшие родственники, и женщинам принадлежит доля из того, что оставили родители и ближайшие родственники, будь его мало или много. Таков предписанный удел.",["мужчинам","доля","из того, что","оставили","родители","и близкие родственники","и женщинам","доля","из того, что","оставили","родители","и близкие родственники","из того, что","мало","из него","или","много","долей","предписанной"]],[4,8,["وَإِذَا","حَضَرَ","ٱلۡقِسۡمَةَ","أُوْلُواْ","ٱلۡقُرۡبَىٰ","وَٱلۡيَتَٰمَىٰ","وَٱلۡمَسَٰكِينُ","فَٱرۡزُقُوهُم","مِّنۡهُ","وَقُولُواْ","لَهُمۡ","قَوۡلٗا","مَّعۡرُوفٗا"],"ва'иза хадарал ḳисмата улул ḳурба валйатама валмасакиину фарзуḳуухум минху ваḳуулуу лахум ḳаулам ма`рууфа","Если при разделе наследства присутствуют родственники, сироты и бедняки, то одарите их из него и скажите им слово доброе.",["и когда","присутствуют","при разделе","обладатели","родства","и сироты","и бедняки","то наделите их","из него","и говорите","им","слово","доброе"]],[4,9,["وَلۡيَخۡشَ","ٱلَّذِينَ","لَوۡ","تَرَكُواْ","مِنۡ","خَلۡفِهِمۡ","ذُرِّيَّةٗ","ضِعَٰفًا","خَافُواْ","عَلَيۡهِمۡ","فَلۡيَتَّقُواْ","ٱللَّهَ","وَلۡيَقُولُواْ","قَوۡلٗا","سَدِيدًا"],"валйахшал лазиина лау таракуу мин халфихим зурриййатан ди`афан хафуу `алайхим фалйаттаḳуллаха валйаḳуулуу ḳаулан садиида","Пусть опасаются те, которые боялись бы за своих немощных потомков, если бы им пришлось оставить их после себя. Пусть они боятся Аллаха и говорят слово правильное.",["и пусть опасаются","те, которые","если бы","оставили они","из","после себя","потомство","слабое","боялись бы","за них","пусть же боятся","Аллаха","и пусть говорят","слово","верное"]],[4,10,["إِنَّ","ٱلَّذِينَ","يَأۡكُلُونَ","أَمۡوَٰلَ","ٱلۡيَتَٰمَىٰ","ظُلۡمًا","إِنَّمَا","يَأۡكُلُونَ","فِي","بُطُونِهِمۡ","نَارٗاۖ","وَسَيَصۡلَوۡنَ","سَعِيرٗا"],"иннал лазиина йа'кулууна амвалал йатама зулман иннама йа'кулууна фии бутуунихим наран васайаслауна са`иира","Воистину, те, которые несправедливо пожирают имущество сирот, наполняют свои животы Огнем и будут гореть в Пламени.",["поистине","те, которые","пожирают","имущество","сирот","несправедливо","лишь","пожирают","в","животы свои","огонь","и будут гореть","в Пламени"]],[4,11,["يُوصِيكُمُ","ٱللَّهُ","فِيٓ","أَوۡلَٰدِكُمۡۖ","لِلذَّكَرِ","مِثۡلُ","حَظِّ","ٱلۡأُنثَيَيۡنِۚ","فَإِن","كُنَّ","نِسَآءٗ","فَوۡقَ","ٱثۡنَتَيۡنِ","فَلَهُنَّ","ثُلُثَا","مَا","تَرَكَۖ","وَإِن","كَانَتۡ","وَٰحِدَةٗ","فَلَهَا","ٱلنِّصۡفُۚ","وَلِأَبَوَيۡهِ","لِكُلِّ","وَٰحِدٖ","مِّنۡهُمَا","ٱلسُّدُسُ","مِمَّا","تَرَكَ","إِن","كَانَ","لَهُۥ","وَلَدٞۚ","فَإِن","لَّمۡ","يَكُن","لَّهُۥ","وَلَدٞ","وَوَرِثَهُۥٓ","أَبَوَاهُ","فَلِأُمِّهِ","ٱلثُّلُثُۚ","فَإِن","كَانَ","لَهُۥٓ","إِخۡوَةٞ","فَلِأُمِّهِ","ٱلسُّدُسُۚ","مِنۢ","بَعۡدِ","وَصِيَّةٖ","يُوصِي","بِهَآ","أَوۡ","دَيۡنٍۗ","ءَابَآؤُكُمۡ","وَأَبۡنَآؤُكُمۡ","لَا","تَدۡرُونَ","أَيُّهُمۡ","أَقۡرَبُ","لَكُمۡ","نَفۡعٗاۚ","فَرِيضَةٗ","مِّنَ","ٱللَّهِۗ","إِنَّ","ٱللَّهَ","كَانَ","عَلِيمًا","حَكِيمٗا"],"йуусиикумуллаху фии ауладикум лиззакари мислу хаззил унсайайни фа'ин кунна нисаан фауḳаснатайни фалахунна сулуса ма тарака ва'ин канат вахидатан фалахан нисфу валиабавайхи ликулли вахидим минхумас судусу мимма тарака ин кана лахуу валадун фа'ил лам йакул лахуу валадун ваварисахуу абаваху фалиуммихис сулусу фа'ин кана лахуу ихватун фалиуммихис судусу мим ба`ди васиййатин йуусии биха ау дайнин абаукум ва'абнаукум ла тадрууна аййухум аḳрабу лакум наф`ан фариидатам миналлахи инналлаха кана `алииман хакиима","Аллах заповедует вам относительно ваших детей: мужчине достается доля, равная доле двух женщин. Если все дети являются женщинами числом более двух, то им принадлежит две трети того, что он оставил. Если же есть всего одна дочь, то ей принадлежит половина. Каждому из родителей принадлежит одна шестая того, что он оставил, если у него есть ребенок. Если же у него нет ребенка, то ему наследуют родители, и матери достается одна треть. Если же у него есть братья, то матери достается одна шестая. Таков расчет после вычета по завещанию, которое он завещал, или выплаты долга. Ваши родители и ваши дети - вы не знаете, кто из них ближе и приносит вам больше пользы. Таково предписание Аллаха. Воистину, Аллах - Знающий, Мудрый.",["заповедует вам","Аллах","относительно","детей ваших","мужчине","подобное","доле","двух женщин","а если","будут они","женщинами","более","двух","то им","две трети","того, что","оставил он","а если","будет она","одна","то ей","половина","и родителям его","каждому","одному","из них двоих","шестая","из того, что","оставил он","если","есть","у него","ребёнок","а если","не","будет","у него","ребёнка","и наследуют ему","родители его","то матери его","треть","а если","есть","у него","братья","то матери его","шестая","из","после","завещания","завещает он","им","или","долга","отцы ваши","и сыновья ваши","не","знаете вы","кто из них","ближе","вам","пользой","предписание","от","Аллаха","поистине","Аллах","есть","Знающий","Мудрый"]]],"m":[[["لِّلرِّجَالِ","мужчинам",4,7],["نَصِيبٞ","доля",4,7],["مِّمَّا","из того, что",4,7],["تَرَكَ","оставили",4,7],["ٱلۡوَٰلِدَانِ","родители",4,7],["وَٱلۡأَقۡرَبُونَ","и близкие родственники",4,7],["وَلِلنِّسَآءِ","и женщинам",4,7],["نَصِيبٞ","доля",4,7]],[["مِّمَّا","из того, что",4,7],["تَرَكَ","оставили",4,7],["ٱلۡوَٰلِدَانِ","родители",4,7],["وَٱلۡأَقۡرَبُونَ","и близкие родственники",4,7],["مِمَّا","из того, что",4,7],["قَلَّ","мало",4,7],["مِنۡهُ","из него",4,7],["أَوۡ","или",4,7],["كَثُرَۚ","много",4,7],["نَصِيبٗا","долей",4,7]],[["مَّفۡرُوضٗا","предписанной",4,7],[7],["وَإِذَا","и когда",4,8],["حَضَرَ","присутствуют",4,8],["ٱلۡقِسۡمَةَ"