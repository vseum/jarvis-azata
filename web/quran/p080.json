{"p":80,"j":4,"a":[[4,15,["وَٱلَّٰتِي","يَأۡتِينَ","ٱلۡفَٰحِشَةَ","مِن","نِّسَآئِكُمۡ","فَٱسۡتَشۡهِدُواْ","عَلَيۡهِنَّ","أَرۡبَعَةٗ","مِّنكُمۡۖ","فَإِن","شَهِدُواْ","فَأَمۡسِكُوهُنَّ","فِي","ٱلۡبُيُوتِ","حَتَّىٰ","يَتَوَفَّىٰهُنَّ","ٱلۡمَوۡتُ","أَوۡ","يَجۡعَلَ","ٱللَّهُ","لَهُنَّ","سَبِيلٗا"],"валлатии йа'тиинал фахишата мин нисаикум фасташхидуу `алайхинна арба`атам минкум фа'ин шахидуу фа'амсикуухунна фил буйуути хатта йатаваффахуннал мауту ау йаж`алаллаху лахунна сабиила","Против тех из ваших женщин, которые совершат мерзкий поступок (прелюбодеяние), призовите в свидетели четырех из вас. Если они засвидетельствуют это, то держите их в домах, пока смерть не покончит с ними или пока Аллах не установит для них иной путь.",["а те, которые","совершают","мерзость","из","женщин ваших","то призовите в свидетели","против них","четверых","из вас","и если","засвидетельствуют они","то держите их","в","домах","пока","не упокоит их","смерть","или","не установит","Аллах","для них","путь"]],[4,16,["وَٱلَّذَانِ","يَأۡتِيَٰنِهَا","مِنكُمۡ","فَـَٔاذُوهُمَاۖ","فَإِن","تَابَا","وَأَصۡلَحَا","فَأَعۡرِضُواْ","عَنۡهُمَآۗ","إِنَّ","ٱللَّهَ","كَانَ","تَوَّابٗا","رَّحِيمًا"],"валлазани йа'тийаниха минкум фа'азуухума фа'ин таба ва'аслаха фа'а`ридуу `анхума инналлаха кана таввабар рахиима","Если двое из вас совершат такой поступок (прелюбодеяние), то подвергните обоих наказанию. Если они раскаются и станут поступать праведно, то оставьте их, ведь Аллах - Принимающий покаяния, Милосердный.",["а двое, которые","совершают её","из вас","то накажите обоих","и если","раскаются они","и исправятся","то отступитесь","от них обоих","поистине","Аллах","есть","Принимающий покаяния","Милосердный"]],[4,17,["إِنَّمَا","ٱلتَّوۡبَةُ","عَلَى","ٱللَّهِ","لِلَّذِينَ","يَعۡمَلُونَ","ٱلسُّوٓءَ","بِجَهَٰلَةٖ","ثُمَّ","يَتُوبُونَ","مِن","قَرِيبٖ","فَأُوْلَٰٓئِكَ","يَتُوبُ","ٱللَّهُ","عَلَيۡهِمۡۗ","وَكَانَ","ٱللَّهُ","عَلِيمًا","حَكِيمٗا"],"иннамат таубату `алаллахи лиллазиина йа`малуунас сууа бижахалатин сумма йатуубууна мин ḳариибин фа'улаика йатуубуллаху `алайхим ваканаллаху `алииман хакиима","Воистину, Аллах обязался принимать покаяния тех, которые совершают дурной поступок по своему невежеству и вскоре раскаиваются. Их покаяния Аллах принимает, ведь Аллах - Знающий, Мудрый.",["лишь","покаяние","на","Аллахе","для тех, которые","совершают","зло","по невежеству","затем","раскаиваются","из","вскоре","и те","примет покаяние","Аллах","от них","и есть","Аллах","Знающий","Мудрый"]],[4,18,["وَلَيۡسَتِ","ٱلتَّوۡبَةُ","لِلَّذِينَ","يَعۡمَلُونَ","ٱلسَّيِّـَٔاتِ","حَتَّىٰٓ","إِذَا","حَضَرَ","أَحَدَهُمُ","ٱلۡمَوۡتُ","قَالَ","إِنِّي","تُبۡتُ","ٱلۡـَٰٔنَ","وَلَا","ٱلَّذِينَ","يَمُوتُونَ","وَهُمۡ","كُفَّارٌۚ","أُوْلَٰٓئِكَ","أَعۡتَدۡنَا","لَهُمۡ","عَذَابًا","أَلِيمٗا"],"валайсатит таубату лиллазиина йа`малуунас саййиати хатта иза хадара ахадахумул мауту ḳала иннии тубтул ана валал лазиина йамуутууна вахум куффарун улаика а`тадна лахум `азабан алиима","Но бесполезно покаяние для тех, кто совершает злодеяния, а когда к нему приходит смерть, то говорит: «Вот теперь я раскаиваюсь», - и для тех, кто умирает неверующим. Для них Мы приготовили мучительные страдания.",["и нет","покаяния","для тех, которые","совершают","дурные деяния","пока","когда","придёт","к одному из них","смерть","скажет","поистине, я","раскаялся","теперь","и не","для тех, которые","умирают","будучи они","неверующими","те","приготовили Мы","для них","наказание","мучительное"]],[4,19,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُواْ","لَا","يَحِلُّ","لَكُمۡ","أَن","تَرِثُواْ","ٱلنِّسَآءَ","كَرۡهٗاۖ","وَلَا","تَعۡضُلُوهُنَّ","لِتَذۡهَبُواْ","بِبَعۡضِ","مَآ","ءَاتَيۡتُمُوهُنَّ","إِلَّآ","أَن","يَأۡتِينَ","بِفَٰحِشَةٖ","مُّبَيِّنَةٖۚ","وَعَاشِرُوهُنَّ","بِٱلۡمَعۡرُوفِۚ","فَإِن","كَرِهۡتُمُوهُنَّ","فَعَسَىٰٓ","أَن","تَكۡرَهُواْ","شَيۡـٔٗا","وَيَجۡعَلَ","ٱللَّهُ","فِيهِ","خَيۡرٗا","كَثِيرٗا"],"йа'аййухал лазиина амануу ла йахиллу лакум ан тарисун нисаа кархан вала та`дулуухунна литазхабуу биба`ди ма атайтумуухунна илла ан йа'тиина бифахишатим мубаййинатин ва`ашируухунна билма`рууфи фа'ин карихтумуухунна фа`аса ан такрахуу шай'ан вайаж`алаллаху фиихи хайран касиира","О те, которые уверовали! Вам не дозволено наследовать женщин против их воли. Не чините им препятствия, чтобы унести часть брачного дара, который вы им дали, если только они не совершили явной мерзости. Живите с ними достойно, и даже если они неприятны вам, то ведь вам может быть неприятно то, в чем Аллах заложил много добра.",["О вы","те, которые","уверовали","не","дозволено","вам","чтобы","вы наследовали","женщин","против воли","и не","притесняйте их","чтобы унести","часть","(из) того, что","вы дали им","кроме (случая)","если","они совершат","мерзость","явную","и живите с ними","достойно","а если","вы невзлюбили их","то, быть может","что","вам неприятно","нечто","и вложил","Аллах","в него","добра","много"]]],"m":[[["وَٱلَّٰتِي","а те, которые",4,15],["يَأۡتِينَ","совершают",4,15],["ٱلۡفَٰحِشَةَ","мерзость",4,15],["مِن","из",4,15],["نِّسَآئِكُمۡ","женщин ваших",4,15],["فَٱسۡتَشۡهِدُواْ","то призовите в свидетели",4,15]],[["عَلَيۡهِنَّ","против них",4,15],["أَرۡبَعَةٗ","четверых",4,15],["مِّنكُمۡۖ","из вас",4,15],["فَإِن","и если",4,15],["شَهِدُواْ","засвидетельствуют они",4,15],["فَأَمۡسِكُوهُنَّ","то держите их",4,15],["فِي","в",4,15]],[["ٱلۡبُيُوتِ","домах",4,15],["حَتَّىٰ","пока",4,15],["يَتَوَفَّىٰهُنَّ","не упокоит их",4,15],["ٱلۡمَوۡتُ","смерть",4,15],["أَوۡ","или",4,15],["يَجۡعَلَ","не установит",4,15],["ٱللَّهُ","Аллах",4,15],["لَهُنَّ","для них",4,15],["سَبِيلٗا","путь",4,15]],[[15],["وَٱلَّذَانِ","а двое, которые",4,16],["يَأۡتِيَٰنِهَا","совершают её",4,16],["مِنكُمۡ","из вас",4,16],["فَـَٔاذُوهُمَاۖ","то накажите обоих",4,16],["فَإِن","и если",4,16],["تَابَا","раскаются они",4,16]],[["وَأَصۡلَحَا","и исправятся",4,16],["فَأَعۡرِضُواْ","то отступитесь",4,16],["عَنۡهُمَآۗ","от них обоих",4,16],["إِنَّ","поистине",4,16],["ٱللَّهَ","Аллах",4,16],["كَانَ","есть",4,16],["تَوَّابٗا","Принимающий покаяния",4,16],["رَّحِيمًا","Мило