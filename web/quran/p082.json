{"p":82,"j":5,"a":[[4,24,["وَٱلۡمُحۡصَنَٰتُ","مِنَ","ٱلنِّسَآءِ","إِلَّا","مَا","مَلَكَتۡ","أَيۡمَٰنُكُمۡۖ","كِتَٰبَ","ٱللَّهِ","عَلَيۡكُمۡۚ","وَأُحِلَّ","لَكُم","مَّا","وَرَآءَ","ذَٰلِكُمۡ","أَن","تَبۡتَغُواْ","بِأَمۡوَٰلِكُم","مُّحۡصِنِينَ","غَيۡرَ","مُسَٰفِحِينَۚ","فَمَا","ٱسۡتَمۡتَعۡتُم","بِهِۦ","مِنۡهُنَّ","فَـَٔاتُوهُنَّ","أُجُورَهُنَّ","فَرِيضَةٗۚ","وَلَا","جُنَاحَ","عَلَيۡكُمۡ","فِيمَا","تَرَٰضَيۡتُم","بِهِۦ","مِنۢ","بَعۡدِ","ٱلۡفَرِيضَةِۚ","إِنَّ","ٱللَّهَ","كَانَ","عَلِيمًا","حَكِيمٗا"],"валмухсанату минан нисаи илла ма малакат айманукум китабаллахи `алайкум ва'ухилла лакум ма вараа заликум ан табтагуу би'амваликум мухсиниина гайра мусафихиина фамастамта`тум бихии минхунна фа'атуухунна ужуурахунна фариидатан вала жунаха `алайкум фиима тарадайтум бихии мим ба`дил фариидати инналлаха кана `алииман хакиима","И замужние женщины запретны для вас, если только ими не овладели ваши десницы (если только они не стали вашими невольницами). Таково предписание Аллаха для вас. Вам дозволены все остальные женщины, если вы добиваетесь их посредством своего имущества, соблюдая целомудрие и не распутничая. А за то удовольствие, которое вы получаете от них, давайте им установленное вознаграждение (брачный дар). На вас не будет греха, если вы придете к обоюдному согласию после того, как определите обязательное вознаграждение (брачный дар). Воистину, Аллах - Знающий, Мудрый.",["и замужние","из","женщин","кроме","тех, которыми","овладели","ваши десницы","(таково) предписание","Аллаха","вам","и дозволено","вам","то, что","за пределами","этого","чтобы","вы искали","своим имуществом","соблюдая целомудрие","не","распутничая","а за то, что","вы насладились","этим","от них","давайте им","их вознаграждение","как обязательное","и нет","греха","на вас","в том, о чём","вы взаимно согласились","(о) нём","из","после","обязательного (дара)","поистине","Аллах","есть","Знающий","Мудрый"]],[4,25,["وَمَن","لَّمۡ","يَسۡتَطِعۡ","مِنكُمۡ","طَوۡلًا","أَن","يَنكِحَ","ٱلۡمُحۡصَنَٰتِ","ٱلۡمُؤۡمِنَٰتِ","فَمِن","مَّا","مَلَكَتۡ","أَيۡمَٰنُكُم","مِّن","فَتَيَٰتِكُمُ","ٱلۡمُؤۡمِنَٰتِۚ","وَٱللَّهُ","أَعۡلَمُ","بِإِيمَٰنِكُمۚ","بَعۡضُكُم","مِّنۢ","بَعۡضٖۚ","فَٱنكِحُوهُنَّ","بِإِذۡنِ","أَهۡلِهِنَّ","وَءَاتُوهُنَّ","أُجُورَهُنَّ","بِٱلۡمَعۡرُوفِ","مُحۡصَنَٰتٍ","غَيۡرَ","مُسَٰفِحَٰتٖ","وَلَا","مُتَّخِذَٰتِ","أَخۡدَانٖۚ","فَإِذَآ","أُحۡصِنَّ","فَإِنۡ","أَتَيۡنَ","بِفَٰحِشَةٖ","فَعَلَيۡهِنَّ","نِصۡفُ","مَا","عَلَى","ٱلۡمُحۡصَنَٰتِ","مِنَ","ٱلۡعَذَابِۚ","ذَٰلِكَ","لِمَنۡ","خَشِيَ","ٱلۡعَنَتَ","مِنكُمۡۚ","وَأَن","تَصۡبِرُواْ","خَيۡرٞ","لَّكُمۡۗ","وَٱللَّهُ","غَفُورٞ","رَّحِيمٞ"],"вамал лам йастати` минкум таулан ан йанкихал мухсанатил му'минати фамим ма малакат айманукум мин фатайатикумул му'минати валлаху а`ламу би'ииманикум ба`дукум мим ба`дин фанкихуухунна би'изни ахлихинна ва'атуухунна ужуурахунна билма`рууфи мухсанатин гайра мусафихатин вала муттахизати ахданин фа'иза ухсинна фа'ин атайна бифахишатин фа`алайхинна нисфу ма `алал мухсанати минал `азаби залика лиман хашийал `аната минкум ва'ан тасбируу хайрул лакум валлаху гафуурур рахиим","Кто не обладает достатком, чтобы жениться на верующих целомудренных женщинах, пусть женится на верующих девушках из числа невольниц, которыми овладели ваши десницы. Аллаху лучше знать о вашей вере. Все вы - друг от друга. Посему женитесь на них с разрешения их семей и давайте им вознаграждение достойным образом, если они являются целомудренными, а не распутницами или имеющими приятелей. Если же после обретения покровительства (замужества) они (невольницы) совершат мерзкий поступок (прелюбодеяние), то их наказание должно быть равно половине наказания свободных женщин. Жениться на невольницах позволено тем из вас, кто опасается тягот или прелюбодеяния. Но для вас будет лучше, если вы проявите терпение, ведь Аллах - Прощающий, Милосердный.",["а кто","не","может","из вас","(по) достатку","чтобы","жениться (на)","целомудренных (свободных)","верующих","то из","тех, которыми","овладели","ваши десницы","из","ваших девушек","верующих","и Аллах","лучше знает","о вашей вере","одни из вас","от","других","так женитесь на них","с разрешения","их семей","и давайте им","их вознаграждение","достойно","целомудренным","не","распутницам","и не","заводящим","тайных любовников","а когда","они выйдут замуж","то если","они совершат","мерзость","то на них","половина","того, что","на","свободных (женщинах)","из","наказания","это","для того, кто","опасается","тягот (греха)","из вас","а то, что","вы потерпите","лучше","для вас","и Аллах","Прощающий","Милосердный"]],[4,26,["يُرِيدُ","ٱللَّهُ","لِيُبَيِّنَ","لَكُمۡ","وَيَهۡدِيَكُمۡ","سُنَنَ","ٱلَّذِينَ","مِن","قَبۡلِكُمۡ","وَيَتُوبَ","عَلَيۡكُمۡۗ","وَٱللَّهُ","عَلِيمٌ","حَكِيمٞ"],"йуриидуллаху лийубаййина лакум вайахдийакум сунанал лазиина мин ḳабликум вайатууба `алайкум валлаху `алиимун хакиим","Аллах желает дать вам разъяснения, повести вас путями ваших предшественников и принять ваши покаяния, ведь Аллах - Знающий, Мудрый.",["желает","Аллах","разъяснить","вам","и повести вас","путями","тех, которые","(были) из","прежде вас","и принять покаяние","ваше","и Аллах","Знающий","Мудрый"]]],"m":[[["۞ وَٱلۡمُحۡصَنَٰتُ","и замужние",4,24],["مِنَ","из",4,24],["ٱلنِّسَآءِ","женщин",4,24],["إِلَّا","кроме",4,24],["مَا","тех, которыми",4,24],["مَلَكَتۡ","овладели",4,24],["أَيۡمَٰنُكُمۡۖ","ваши десницы",4,24]],[["كِتَٰبَ","(таково) предписание",4,24],["ٱللَّهِ","Аллаха",4,24],["عَلَيۡكُمۡۚ","вам",4,24],["وَأُحِلَّ","и дозволено",4,24],["لَكُم","вам",4,24],["مَّا","то, что",4,24],["وَرَآءَ","за пределами",4,24],["ذَٰلِكُمۡ","этого",4,24],["أَن","чтобы",4,24],["تَبۡتَغُواْ","вы искали",4,24]],[["بِأَمۡوَٰلِكُم","своим имуществом",4,24],["مُّحۡصِنِينَ","соблюдая целомудрие",4,24],["غَيۡرَ","не",4,24],["مُسَٰفِحِينَۚ","распутничая",4,24],["فَمَا","а за то, что",4,24],["ٱسۡتَمۡتَعۡتُم","вы насладились",4,24],["بِهِۦ","этим",4,24]],[["مِنۡهُنَّ","от них",4,24],["فَـَٔاتُوهُنَّ","давайте им",4,24],["أُجُورَهُنَّ","их вознаграждение",4,24],["فَرِيضَةٗۚ","как обязательное",4,24],["وَلَا","и н