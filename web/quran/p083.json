{"p":83,"j":5,"a":[[4,27,["وَٱللَّهُ","يُرِيدُ","أَن","يَتُوبَ","عَلَيۡكُمۡ","وَيُرِيدُ","ٱلَّذِينَ","يَتَّبِعُونَ","ٱلشَّهَوَٰتِ","أَن","تَمِيلُواْ","مَيۡلًا","عَظِيمٗا"],"валлаху йурииду ан йатууба `алайкум вайуриидул лазиина йаттаби`уунаш шахавати ан тамиилуу майлан `азиима","Аллах желает принять ваши покаяния, а потакающие своим страстям желают, чтобы вы сильно уклонились в сторону.",["и Аллах","желает","чтобы","принять покаяние","ваше","а желают","те, которые","следуют","страстям","чтобы","вы уклонились","уклонением","великим"]],[4,28,["يُرِيدُ","ٱللَّهُ","أَن","يُخَفِّفَ","عَنكُمۡۚ","وَخُلِقَ","ٱلۡإِنسَٰنُ","ضَعِيفٗا"],"йуриидуллаху ан йухаффифа `анкум вахулиḳал инсану да`иифа","Аллах желает вам облегчения, ведь человек создан слабым.",["желает","Аллах","чтобы","облегчить","вам","и создан","человек","слабым"]],[4,29,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُواْ","لَا","تَأۡكُلُوٓاْ","أَمۡوَٰلَكُم","بَيۡنَكُم","بِٱلۡبَٰطِلِ","إِلَّآ","أَن","تَكُونَ","تِجَٰرَةً","عَن","تَرَاضٖ","مِّنكُمۡۚ","وَلَا","تَقۡتُلُوٓاْ","أَنفُسَكُمۡۚ","إِنَّ","ٱللَّهَ","كَانَ","بِكُمۡ","رَحِيمٗا"],"йа'аййухал лазиина амануу ла та'кулуу амвалакум байнакум билбатили илла ан такууна тижаратан `ан тарадим минкум вала таḳтулуу анфусакум инналлаха кана бикум рахиима","О те, которые уверовали! Не пожирайте своего имущества между собой незаконно, а только путем торговли по обоюдному вашему согласию. Не убивайте самих себя (друг друга), ведь Аллах милостив к вам.",["О вы","те, которые","уверовали","не","пожирайте","ваше имущество","между собой","незаконно","кроме","если","будет","торговля","по","взаимному согласию","вашему","и не","убивайте","самих себя","поистине","Аллах","есть","к вам","милостив"]],[4,30,["وَمَن","يَفۡعَلۡ","ذَٰلِكَ","عُدۡوَٰنٗا","وَظُلۡمٗا","فَسَوۡفَ","نُصۡلِيهِ","نَارٗاۚ","وَكَانَ","ذَٰلِكَ","عَلَى","ٱللَّهِ","يَسِيرًا"],"ваман йаф`ал залика `удванан вазулман фасауфа нуслиихи наран вакана залика `алаллахи йасиира","Мы сожжем в Огне того, кто совершит это, преступив границы дозволенного, по несправедливости своей. Это для Аллаха легко.",["а кто","сделает","это","посягая","и несправедливо","то вскоре","Мы сожжём его","(в) Огне","и есть","это","для","Аллаха","легко"]],[4,31,["إِن","تَجۡتَنِبُواْ","كَبَآئِرَ","مَا","تُنۡهَوۡنَ","عَنۡهُ","نُكَفِّرۡ","عَنكُمۡ","سَيِّـَٔاتِكُمۡ","وَنُدۡخِلۡكُم","مُّدۡخَلٗا","كَرِيمٗا"],"ин тажтанибуу кабаира ма тунхауна `анху нукаффир `анкум саййиатикум ванудхилкум мудхалан кариима","Если вы будете избегать больших грехов из того, что вам запрещено, то Мы простим ваши злодеяния и введем вас в почтенный вход.",["если","вы будете избегать","великих (грехов)","(из) того, что","вам запрещается","его","Мы сотрём","с вас","ваши злодеяния","и Мы введём вас","(во) вход","почётный"]],[4,32,["وَلَا","تَتَمَنَّوۡاْ","مَا","فَضَّلَ","ٱللَّهُ","بِهِۦ","بَعۡضَكُمۡ","عَلَىٰ","بَعۡضٖۚ","لِّلرِّجَالِ","نَصِيبٞ","مِّمَّا","ٱكۡتَسَبُواْۖ","وَلِلنِّسَآءِ","نَصِيبٞ","مِّمَّا","ٱكۡتَسَبۡنَۚ","وَسۡـَٔلُواْ","ٱللَّهَ","مِن","فَضۡلِهِۦٓۚ","إِنَّ","ٱللَّهَ","كَانَ","بِكُلِّ","شَيۡءٍ","عَلِيمٗا"],"вала татаманнау ма фаддалаллаху бихии ба`дакум `ала ба`дил лиррижали насиибум миммактасабуу валиннисаи насиибум миммактасабна вас'алуллаха мин фадлихии инналлаха кана бикулли шай'ин `алиима","Не желайте того, посредством чего Аллах дал одним из вас преимущество перед другими. Мужчинам полагается доля из того, что они приобрели, и женщинам полагается доля из того, что они приобрели. Просите у Аллаха из Его милости, ведь Аллаху известно о всякой вещи.",["и не","желайте","того, чем","дал преимущество","Аллах","посредством него","одним из вас","перед","другими","мужчинам","доля","из того, что","они приобрели","и женщинам","доля","из того, что","они приобрели","и просите","Аллаха","из","Его милости","поистине","Аллах","есть","о всякой","вещи","Знающий"]],[4,33,["وَلِكُلّٖ","جَعَلۡنَا","مَوَٰلِيَ","مِمَّا","تَرَكَ","ٱلۡوَٰلِدَانِ","وَٱلۡأَقۡرَبُونَۚ","وَٱلَّذِينَ","عَقَدَتۡ","أَيۡمَٰنُكُمۡ","فَـَٔاتُوهُمۡ","نَصِيبَهُمۡۚ","إِنَّ","ٱللَّهَ","كَانَ","عَلَىٰ","كُلِّ","شَيۡءٖ","شَهِيدًا"],"валикуллин жа`ална мавалийа мимма таракал валидани вал'аḳрабууна валлазиина `аḳадат айманукум фа'атуухум насиибахум инналлаха кана `ала кулли шай'ин шахиида","Каждому человеку Мы определили близких, которые наследуют из того, что оставили родители и ближайшие родственники. Отдавайте тем, с кем вы связаны клятвами, их долю. Воистину, Аллах - Свидетель всякой вещи.",["и для каждого","Мы сделали","наследников","из того, что","оставили","родители","и ближайшие родственники","а тем, с кем","заключили (союз)","ваши клятвы","давайте им","их долю","поистине","Аллах","есть","над","всякой","вещью","Свидетель"]]],"m":[[["وَٱللَّهُ","и Аллах",4,27],["يُرِيدُ","желает",4,27],["أَن","чтобы",4,27],["يَتُوبَ","принять покаяние",4,27],["عَلَيۡكُمۡ","ваше",4,27],["وَيُرِيدُ","а желают",4,27],["ٱلَّذِينَ","те, которые",4,27],["يَتَّبِعُونَ","следуют",4,27]],[["ٱلشَّهَوَٰتِ","страстям",4,27],["أَن","чтобы",4,27],["تَمِيلُواْ","вы уклонились",4,27],["مَيۡلًا","уклонением",4,27],["عَظِيمٗا","великим",4,27],[27],["يُرِيدُ","желает",4,28],["ٱللَّهُ","Аллах",4,28],["أَن","чтобы",4,28],["يُخَفِّفَ","облегчить",4,28]],[["عَنكُمۡۚ","вам",4,28],["وَخُلِقَ","и создан",4,28],["ٱلۡإِنسَٰنُ","человек",4,28],["ضَعِيفٗا","слабым",4,28],[28],["يَٰٓأَيُّهَا","О вы",4,29],["ٱلَّذِينَ","те, которые",4,29]],[["ءَامَنُواْ","уверовали",4,29],["لَا","не",4,29],["تَأۡكُلُوٓاْ","пожирайте",4,29],["أَمۡوَٰلَكُم","ваше имущество",4,29],["بَيۡنَكُم","между собой",4,29],["بِٱلۡبَٰطِلِ","незаконно",4,29],["إِلَّآ","кроме",4,29],["أَن","если",4,29]],[["تَكُونَ","будет",4,29],["تِجَٰرَةً","торговля",4,29],["عَن","по",4,29],["تَرَاضٖ","взаимному согласию",4,29],["مِّنكُمۡۚ","вашему",4,29],["وَلَا","и не",4,29],["تَقۡتُلُوٓاْ","убивайте",4,29],["أَنفُسَكُمۡۚ","самих себя",4,29]],[["إِنَّ","поистине",4,29],["ٱللَّهَ","Аллах",4,29],["كَانَ","есть",4,29],["بِكُمۡ","к вам",4,29],["رَحِيمٗا","милостив",4,29],[29],["وَمَن","а кто",4,30],["يَفۡعَلۡ","сделает",4,30],["ذَٰلِكَ","это",4,30],["