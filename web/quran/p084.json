{"p":84,"j":5,"a":[[4,34,["ٱلرِّجَالُ","قَوَّٰمُونَ","عَلَى","ٱلنِّسَآءِ","بِمَا","فَضَّلَ","ٱللَّهُ","بَعۡضَهُمۡ","عَلَىٰ","بَعۡضٖ","وَبِمَآ","أَنفَقُواْ","مِنۡ","أَمۡوَٰلِهِمۡۚ","فَٱلصَّٰلِحَٰتُ","قَٰنِتَٰتٌ","حَٰفِظَٰتٞ","لِّلۡغَيۡبِ","بِمَا","حَفِظَ","ٱللَّهُۚ","وَٱلَّٰتِي","تَخَافُونَ","نُشُوزَهُنَّ","فَعِظُوهُنَّ","وَٱهۡجُرُوهُنَّ","فِي","ٱلۡمَضَاجِعِ","وَٱضۡرِبُوهُنَّۖ","فَإِنۡ","أَطَعۡنَكُمۡ","فَلَا","تَبۡغُواْ","عَلَيۡهِنَّ","سَبِيلًاۗ","إِنَّ","ٱللَّهَ","كَانَ","عَلِيّٗا","كَبِيرٗا"],"аррижалу ḳаввамууна `алан нисаи бима фаддалаллаху ба`дахум `ала ба`дин вабима анфаḳуу мин амвалихим фассалихату ḳанитатун хафизатул лилгайби бима хафизаллаху валлатии тахафууна нушуузахунна фа`изуухунна вахжуруухунна фил мадажи`и вадрибуухунна фа'ин ата`накум фала табгуу `алайхинна сабиилан инналлаха кана `алиййан кабиира","Мужчины являются попечителями женщин, потому что Аллах дал одним из них преимущество перед другими, и потому что они расходуют из своего имущества. Праведные женщины покорны и хранят то, что положено хранить, в отсутствие мужей, благодаря заботе Аллаха. А тех женщин, непокорности которых вы опасаетесь, увещевайте, избегайте на супружеском ложе и побивайте. Если же они будут покорны вам, то не ищите пути против них. Воистину, Аллах - Возвышенный, Большой.",["мужчины","попечители","над","женщинами","потому что","дал преимущество","Аллах","одним из них","перед","другими","и потому что","они расходуют","из","своего имущества","а праведные","покорны","хранящие","в отсутствие (мужа)","тем, что","сохранил","Аллах","а тех, которых","вы опасаетесь","их непокорности","то увещевайте их","и покидайте их","на","ложах","и побивайте их","а если","они покорились вам","то не","ищите","против них","пути","поистине","Аллах","есть","Возвышенный","Великий"]],[4,35,["وَإِنۡ","خِفۡتُمۡ","شِقَاقَ","بَيۡنِهِمَا","فَٱبۡعَثُواْ","حَكَمٗا","مِّنۡ","أَهۡلِهِۦ","وَحَكَمٗا","مِّنۡ","أَهۡلِهَآ","إِن","يُرِيدَآ","إِصۡلَٰحٗا","يُوَفِّقِ","ٱللَّهُ","بَيۡنَهُمَآۗ","إِنَّ","ٱللَّهَ","كَانَ","عَلِيمًا","خَبِيرٗا"],"ва'ин хифтум шиḳаḳа байнихима фаб`асуу хакамам мин ахлихии вахакамам мин ахлиха ин йуриида ислахан йуаффиḳиллаху байнахума инналлаха кана `алииман хабиира","Если вы опасаетесь разлада между ними, то отправьте одного судью из его семьи и одного судью из ее семьи. Если они оба пожелают примирения, то Аллах поможет им. Воистину, Аллах - Знающий, Ведающий.",["и если","вы опасаетесь","разлада","между ними двумя","то пошлите","судью","из","его семьи","и судью","из","её семьи","если","они оба пожелают","примирения","установит согласие","Аллах","между ними","поистине","Аллах","есть","Знающий","Ведающий"]],[4,36,["وَٱعۡبُدُواْ","ٱللَّهَ","وَلَا","تُشۡرِكُواْ","بِهِۦ","شَيۡـٔٗاۖ","وَبِٱلۡوَٰلِدَيۡنِ","إِحۡسَٰنٗا","وَبِذِي","ٱلۡقُرۡبَىٰ","وَٱلۡيَتَٰمَىٰ","وَٱلۡمَسَٰكِينِ","وَٱلۡجَارِ","ذِي","ٱلۡقُرۡبَىٰ","وَٱلۡجَارِ","ٱلۡجُنُبِ","وَٱلصَّاحِبِ","بِٱلۡجَنۢبِ","وَٱبۡنِ","ٱلسَّبِيلِ","وَمَا","مَلَكَتۡ","أَيۡمَٰنُكُمۡۗ","إِنَّ","ٱللَّهَ","لَا","يُحِبُّ","مَن","كَانَ","مُخۡتَالٗا","فَخُورًا"],"ва`будуллаха вала тушрикуу бихии шай'ан вабилвалидайни ихсанан вабизил ḳурба валйатама валмасакиини валжари зил ḳурба валжарил жунуби вассахиби билжамби вабнис сабиили вама малакат айманукум инналлаха ла йухиббу ман кана мухталан фахуура","Поклоняйтесь Аллаху и не приобщайте к Нему сотоварищей. Делайте добро родителям, родственникам, сиротам, беднякам, соседям из числа ваших родственников и соседям, которые не являются вашими родственниками, находящимся рядом спутникам, странникам и невольникам, которыми овладели ваши десницы. Воистину, Аллах не любит гордецов и бахвалов,",["и поклоняйтесь","Аллаху","и не","приобщайте","к Нему","ничего","и к родителям","(делайте) добро","и к обладающим","родством","и сиротам","и беднякам","и соседу","обладающему","родством","и соседу","чужому","и спутнику","рядом","и сыну","пути","и тем, которыми","овладели","ваши десницы","поистине","Аллах","не","любит","того, кто","был","горделивым","хвастливым"]],[4,37,["ٱلَّذِينَ","يَبۡخَلُونَ","وَيَأۡمُرُونَ","ٱلنَّاسَ","بِٱلۡبُخۡلِ","وَيَكۡتُمُونَ","مَآ","ءَاتَىٰهُمُ","ٱللَّهُ","مِن","فَضۡلِهِۦۗ","وَأَعۡتَدۡنَا","لِلۡكَٰفِرِينَ","عَذَابٗا","مُّهِينٗا"],"аллазиина йабхалууна вайа'муруунан наса билбухли вайактумууна ма атахумуллаху мин фадлихии ва'а`тадна лилкафириина `азабам мухиина","которые скупятся, велят людям быть скупыми и утаивают то, что Аллах даровал им из Своей милости. Мы приготовили для неверующих унизительные мучения.",["которые","скупятся","и велят","людям","скупость","и скрывают","то, что","даровал им","Аллах","из","Своей милости","и Мы приготовили","для неверующих","мучение","унизительное"]]],"m":[[["ٱلرِّجَالُ","мужчины",4,34],["قَوَّٰمُونَ","попечители",4,34],["عَلَى","над",4,34],["ٱلنِّسَآءِ","женщинами",4,34],["بِمَا","потому что",4,34],["فَضَّلَ","дал преимущество",4,34],["ٱللَّهُ","Аллах",4,34],["بَعۡضَهُمۡ","одним из них",4,34]],[["عَلَىٰ","перед",4,34],["بَعۡضٖ","другими",4,34],["وَبِمَآ","и потому что",4,34],["أَنفَقُواْ","они расходуют",4,34],["مِنۡ","из",4,34],["أَمۡوَٰلِهِمۡۚ","своего имущества",4,34],["فَٱلصَّٰلِحَٰتُ","а праведные",4,34]],[["قَٰنِتَٰتٌ","покорны",4,34],["حَٰفِظَٰتٞ","хранящие",4,34],["لِّلۡغَيۡبِ","в отсутствие (мужа)",4,34],["بِمَا","тем, что",4,34],["حَفِظَ","сохранил",4,34],["ٱللَّهُۚ","Аллах",4,34],["وَٱلَّٰتِي","а тех, которых",4,34],["تَخَافُونَ","вы опасаетесь",4,34]],[["نُشُوزَهُنَّ","их непокорности",4,34],["فَعِظُوهُنَّ","то увещевайте их",4,34],["وَٱهۡجُرُوهُنَّ","и покидайте их",4,34],["فِي","на",4,34],["ٱلۡمَضَاجِعِ","ложах",4,34]],[["وَٱضۡرِبُوهُنَّۖ","и побивайте их",4,34],["فَإِنۡ","а если",4,34],["أَطَعۡنَكُمۡ","они покорились вам",4,34],["فَلَا","то не",4,34],["تَبۡغُواْ","ищите",4,34],["عَلَيۡهِنَّ","против них",4,34],["سَبِيلًاۗ","пути",4,34]],[["إِنَّ","поистине",4,34],["ٱللَّهَ","Аллах",4,34],["كَانَ","есть",4,34],["عَلِيّٗا","Возвышенный",4,34],["كَبِيرٗا","Великий",4,34],[34],["وَإِنۡ","и если",4,35],["خِفۡتُمۡ","вы опасаетесь",4,35],["شِقَاقَ","разлада",4,35]],[["بَيۡنِهِمَا","межд