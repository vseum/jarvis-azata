{"p":85,"j":5,"a":[[4,38,["وَٱلَّذِينَ","يُنفِقُونَ","أَمۡوَٰلَهُمۡ","رِئَآءَ","ٱلنَّاسِ","وَلَا","يُؤۡمِنُونَ","بِٱللَّهِ","وَلَا","بِٱلۡيَوۡمِ","ٱلۡأٓخِرِۗ","وَمَن","يَكُنِ","ٱلشَّيۡطَٰنُ","لَهُۥ","قَرِينٗا","فَسَآءَ","قَرِينٗا"],"валлазиина йунфиḳууна амвалахум ри'аан наси вала йу'минууна биллахи вала билйаумил ахири ваман йакуниш шайтану лахуу ḳариинан фасаа ḳариина","Они расходуют свое имущество напоказ людям и не веруют в Аллаха и Последний день. Если дьявол является товарищем, то плох такой товарищ!",["и которые","расходуют","своё имущество","напоказ","людям","и не","веруют","в Аллаха","и не","в День","Последний","а у кого","будет","шайтан","ему","товарищем","то плох","(такой) товарищ"]],[4,39,["وَمَاذَا","عَلَيۡهِمۡ","لَوۡ","ءَامَنُواْ","بِٱللَّهِ","وَٱلۡيَوۡمِ","ٱلۡأٓخِرِ","وَأَنفَقُواْ","مِمَّا","رَزَقَهُمُ","ٱللَّهُۚ","وَكَانَ","ٱللَّهُ","بِهِمۡ","عَلِيمًا"],"вамаза `алайхим лау амануу биллахи валйаумил ахири ва'анфаḳуу мимма разаḳахумуллаху ваканаллаху бихим `алиима","Что они потеряют, если уверуют в Аллаха и Последний день и станут расходовать из того, чем наделил их Аллах? Аллаху известно о них.",["и что","(во вред) им","если бы","они уверовали","в Аллаха","и в День","Последний","и расходовали","из того, чем","наделил их","Аллах","и есть","Аллах","о них","Знающий"]],[4,40,["إِنَّ","ٱللَّهَ","لَا","يَظۡلِمُ","مِثۡقَالَ","ذَرَّةٖۖ","وَإِن","تَكُ","حَسَنَةٗ","يُضَٰعِفۡهَا","وَيُؤۡتِ","مِن","لَّدُنۡهُ","أَجۡرًا","عَظِيمٗا"],"инналлаха ла йазлиму мисḳала зарратин ва'ин таку хасанатан йуда`ифха вайу'ти мил ладунху ажран `азиима","Аллах не совершает несправедливости даже весом в мельчайшую частицу, а если поступок окажется благим, то Он приумножит его и одарит от Себя великой наградой.",["поистине","Аллах","не","обижает","(на) вес","пылинки","и если","будет","доброе дело","Он удвоит его","и дарует","от","Себя","награду","великую"]],[4,41,["فَكَيۡفَ","إِذَا","جِئۡنَا","مِن","كُلِّ","أُمَّةِۭ","بِشَهِيدٖ","وَجِئۡنَا","بِكَ","عَلَىٰ","هَٰٓؤُلَآءِ","شَهِيدٗا"],"факайфа иза жи'на мин кулли уммати бишахиидин важи'на бика `ала ха'улаи шахиида","Что же произойдет, когда Мы приведем по свидетелю от каждой общины, а тебя приведем свидетелем против этих?",["так каково (будет)","когда","Мы приведём","из","каждой","общины","свидетеля","и Мы приведём","тебя","против","этих","свидетелем"]],[4,42,["يَوۡمَئِذٖ","يَوَدُّ","ٱلَّذِينَ","كَفَرُواْ","وَعَصَوُاْ","ٱلرَّسُولَ","لَوۡ","تُسَوَّىٰ","بِهِمُ","ٱلۡأَرۡضُ","وَلَا","يَكۡتُمُونَ","ٱللَّهَ","حَدِيثٗا"],"йаумаизин йаваддул лазиина кафаруу ва`асавур расуула лау тусавва бихимул арду вала йактумууналлаха хадииса","В тот день те, которые не уверовали и ослушались Посланника, пожелают, чтобы земля сровнялась с ними. Они не смогут утаить от Аллаха ни одной беседы.",["в тот день","пожелают","те, которые","не уверовали","и ослушались","Посланника","чтобы","сровнялась","с ними","земля","и не","скроют они","(от) Аллаха","(ни одного) слова"]],[4,43,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُواْ","لَا","تَقۡرَبُواْ","ٱلصَّلَوٰةَ","وَأَنتُمۡ","سُكَٰرَىٰ","حَتَّىٰ","تَعۡلَمُواْ","مَا","تَقُولُونَ","وَلَا","جُنُبًا","إِلَّا","عَابِرِي","سَبِيلٍ","حَتَّىٰ","تَغۡتَسِلُواْۚ","وَإِن","كُنتُم","مَّرۡضَىٰٓ","أَوۡ","عَلَىٰ","سَفَرٍ","أَوۡ","جَآءَ","أَحَدٞ","مِّنكُم","مِّنَ","ٱلۡغَآئِطِ","أَوۡ","لَٰمَسۡتُمُ","ٱلنِّسَآءَ","فَلَمۡ","تَجِدُواْ","مَآءٗ","فَتَيَمَّمُواْ","صَعِيدٗا","طَيِّبٗا","فَٱمۡسَحُواْ","بِوُجُوهِكُمۡ","وَأَيۡدِيكُمۡۗ","إِنَّ","ٱللَّهَ","كَانَ","عَفُوًّا","غَفُورًا"],"йа'аййухал лазиина амануу ла таḳрабус салавата ва'антум сукара хатта та`ламуу ма таḳуулууна вала жунубан илла `абирии сабиилин хатта тагтасилуу ва'ин кунтум марда ау `ала сафарин ау жаа ахадум минкум минал гаити ау ламастумун нисаа фалам тажидуу маан фатайаммамуу са`иидан таййибан фамсахуу бивужуухикум ва'айдиикум инналлаха кана `афувван гафуура","О те, которые уверовали! Не приближайтесь к намазу, будучи пьяными, пока не станете понимать то, что произносите, и, будучи в состоянии полового осквернения, пока не искупаетесь, если только вы не являетесь путником. Если же вы больны или находитесь в путешествии, если кто-либо из вас пришел из уборной или если вы имели близость с женщинами, и вы не нашли воды, то направьтесь к чистой земле и оботрите ваши лица и руки. Воистину, Аллах - Снисходительный, Прощающий.",["О вы","те, которые","уверовали","не","приближайтесь","(к) намазу","когда вы","пьяны","пока","(не) узнаете","что","вы говорите","и не","(в) осквернении","кроме","проходящих","путь","пока","(не) искупаетесь","и если","вы будете","больны","или","в","пути","или","пришёл","кто-либо","из вас","из","уборной","или","вы касались","женщин","и не","нашли","воды","то совершите таяммум","землёй","чистой","и оботрите","ваши лица","и ваши руки","поистине","Аллах","есть","Извиняющий","Прощающий"]],[4,44,["أَلَمۡ","تَرَ","إِلَى","ٱلَّذِينَ","أُوتُواْ","نَصِيبٗا","مِّنَ","ٱلۡكِتَٰبِ","يَشۡتَرُونَ","ٱلضَّلَٰلَةَ","وَيُرِيدُونَ","أَن","تَضِلُّواْ","ٱلسَّبِيلَ"],"алам тара илал лазиина уутуу насиибам минал китаби йаштаруунад далалата вайуриидууна ан тадиллус сабиил","Разве ты не видел тех, которым была дана часть Писания, которые приобретают заблуждение и хотят, чтобы вы сбились с пути?",["разве не","видел ты","на","тех, которым","было дано","часть","из","Писания","покупают","заблуждение","и хотят","чтобы","вы сбились","(с) пути"]]],"m":[[["وَٱلَّذِينَ","и которые",4,38],["يُنفِقُونَ","расходуют",4,38],["أَمۡوَٰلَهُمۡ","своё имущество",4,38],["رِئَآءَ","напоказ",4,38],["ٱلنَّاسِ","людям",4,38],["وَلَا","и не",4,38],["يُؤۡمِنُونَ","веруют",4,38]],[["بِٱللَّهِ","в Аллаха",4,38],["وَلَا","и не",4,38],["بِٱلۡيَوۡمِ","в День",4,38],["ٱلۡأٓخِرِۗ","Последний",4,38],["وَمَن","а у кого",4,38],["يَكُنِ","будет",4,38],["ٱلشَّيۡطَٰنُ","шайтан",4,38],["لَهُۥ","ему",4,38],["قَرِينٗا","товарищем",4,38],["فَسَآءَ","то плох",4,38]],[["قَرِينٗا","(такой) товарищ",4,38],[38],["وَمَاذَا","и что",4,39],["عَلَيۡهِمۡ","(во вред) им",4,39],["لَوۡ","если бы",4,39],["ءَامَنُواْ","они уверовали",4,39],["بِٱللَّهِ","в Аллаха",4,39]