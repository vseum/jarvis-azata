{"p":86,"j":5,"a":[[4,45,["وَٱللَّهُ","أَعۡلَمُ","بِأَعۡدَآئِكُمۡۚ","وَكَفَىٰ","بِٱللَّهِ","وَلِيّٗا","وَكَفَىٰ","بِٱللَّهِ","نَصِيرٗا"],"валлаху а`ламу би'а`даикум вакафа биллахи валиййан вакафа биллахи насиира","Аллаху лучше знать ваших врагов. Довольно того, что Аллах является Покровителем! Довольно того, что Аллах является Помощником!",["и Аллах","лучше знает","ваших врагов","и довольно","Аллаха","(как) Покровителя","и довольно","Аллаха","(как) Помощника"]],[4,46,["مِّنَ","ٱلَّذِينَ","هَادُواْ","يُحَرِّفُونَ","ٱلۡكَلِمَ","عَن","مَّوَاضِعِهِۦ","وَيَقُولُونَ","سَمِعۡنَا","وَعَصَيۡنَا","وَٱسۡمَعۡ","غَيۡرَ","مُسۡمَعٖ","وَرَٰعِنَا","لَيَّۢا","بِأَلۡسِنَتِهِمۡ","وَطَعۡنٗا","فِي","ٱلدِّينِۚ","وَلَوۡ","أَنَّهُمۡ","قَالُواْ","سَمِعۡنَا","وَأَطَعۡنَا","وَٱسۡمَعۡ","وَٱنظُرۡنَا","لَكَانَ","خَيۡرٗا","لَّهُمۡ","وَأَقۡوَمَ","وَلَٰكِن","لَّعَنَهُمُ","ٱللَّهُ","بِكُفۡرِهِمۡ","فَلَا","يُؤۡمِنُونَ","إِلَّا","قَلِيلٗا"],"мминал лазиина хадуу йухаррифуунал калима `ам мавади`ихии вайаḳуулууна сами`на ва`асайна васма` гайра мусма`ин вара`ина лаййа би'алсинатихим вата`нан фид диини валау аннахум ḳалуу сами`на ва'ата`на васма` ванзурна лакана хайрал лахум ва'аḳвама валакил ла`анахумуллаху бикуфрихим фала йу'минууна илла ḳалиила","Среди иудеев есть такие, которые переставляют слова со своих мест и говорят: «Мы слышали и ослушаемся» и «Послушай то, что нельзя слушать» и «Заботься о нас». Они кривят своими языками и поносят религию. А если бы они сказали: «Мы слышали и повинуемся» и «Выслушай» и «Присматривай за нами», то это было бы лучше для них и вернее. Однако Аллах проклял их за неверие, и они не веруют, за исключением немногих.",["из","тех, которые","исповедуют иудаизм","искажают","слова","с","их мест","и говорят","мы услышали","и ослушались","и слушай","не","слышащий","и раина","кривя","своими языками","и понося","в","религии","и если бы","они","сказали","мы услышали","и повиновались","и слушай","и взгляни на нас","непременно было бы","лучше","для них","и вернее","но","проклял их","Аллах","за их неверие","и не","веруют они","кроме","немногих"]],[4,47,["يَٰٓأَيُّهَا","ٱلَّذِينَ","أُوتُواْ","ٱلۡكِتَٰبَ","ءَامِنُواْ","بِمَا","نَزَّلۡنَا","مُصَدِّقٗا","لِّمَا","مَعَكُم","مِّن","قَبۡلِ","أَن","نَّطۡمِسَ","وُجُوهٗا","فَنَرُدَّهَا","عَلَىٰٓ","أَدۡبَارِهَآ","أَوۡ","نَلۡعَنَهُمۡ","كَمَا","لَعَنَّآ","أَصۡحَٰبَ","ٱلسَّبۡتِۚ","وَكَانَ","أَمۡرُ","ٱللَّهِ","مَفۡعُولًا"],"йа'аййухал лазиина уутул китаба аминуу бима наззална мусаддиḳал лима ма`акум мин ḳабли ан натмиса вужуухан фанаруддаха `ала адбариха ау нал`анахум кама ла`анна асхабас сабти вакана амруллахи маф`уула","О те, кому было дано Писание! Уверуйте в то, что Мы ниспослали в подтверждение того, что есть у вас, пока Мы не стерли ваши лица и не повернули их назад, пока Мы не прокляли вас, как прокляли тех, которые нарушили субботу. Веление Аллаха непременно исполняется!",["О вы","те, которым","было дано","Писание","уверуйте","в то, что","Мы ниспослали","подтверждающим","то, что","с вами","до","того","как","Мы сотрём","лица","и повернём их","на","их затылки","или","Мы проклянём их","как","Мы прокляли","людей","субботы","и есть","веление","Аллаха","исполняемое"]],[4,48,["إِنَّ","ٱللَّهَ","لَا","يَغۡفِرُ","أَن","يُشۡرَكَ","بِهِۦ","وَيَغۡفِرُ","مَا","دُونَ","ذَٰلِكَ","لِمَن","يَشَآءُۚ","وَمَن","يُشۡرِكۡ","بِٱللَّهِ","فَقَدِ","ٱفۡتَرَىٰٓ","إِثۡمًا","عَظِيمًا"],"инналлаха ла йагфиру ан йушрака бихии вайагфиру ма дууна залика лиман йашау ваман йушрик биллахи фаḳадифтара исман `азиима","Воистину, Аллах не прощает, когда к Нему приобщают сотоварищей, но прощает все остальные (или менее тяжкие) грехи, кому пожелает. Кто же приобщает сотоварищей к Аллаху, тот измышляет великий грех.",["поистине","Аллах","не","прощает","того, что","придают сотоварищей","Ему","и прощает","то, что","ниже","этого","кому","Он пожелает","а кто","приобщает сотоварищей","к Аллаху","тот уже","измыслил","грех","великий"]],[4,49,["أَلَمۡ","تَرَ","إِلَى","ٱلَّذِينَ","يُزَكُّونَ","أَنفُسَهُمۚ","بَلِ","ٱللَّهُ","يُزَكِّي","مَن","يَشَآءُ","وَلَا","يُظۡلَمُونَ","فَتِيلًا"],"алам тара илал лазиина йузаккууна анфусахум балиллаху йузаккии ман йашау вала йузламууна фатиила","Разве ты не видел тех, которые восхваляют сами себя? О нет! Аллах восхваляет, кого пожелает, и они не будут обижены даже на величину нити на финиковой косточке.",["разве не","видел ты","на","тех, которые","считают чистыми","самих себя","нет же","Аллах","очищает","кого","Он пожелает","и не","будут обижены они","(на) нить"]],[4,50,["ٱنظُرۡ","كَيۡفَ","يَفۡتَرُونَ","عَلَى","ٱللَّهِ","ٱلۡكَذِبَۖ","وَكَفَىٰ","بِهِۦٓ","إِثۡمٗا","مُّبِينًا"],"инзур кайфа йафтарууна `алаллахил казиба вакафа бихии исмам мубиина","Посмотри, как они возводят навет на Аллаха! Этого достаточно, чтобы совершить явный грех!",["посмотри","как","они измышляют","на","Аллаха","ложь","и довольно","этого","(как) греха","явного"]],[4,51,["أَلَمۡ","تَرَ","إِلَى","ٱلَّذِينَ","أُوتُواْ","نَصِيبٗا","مِّنَ","ٱلۡكِتَٰبِ","يُؤۡمِنُونَ","بِٱلۡجِبۡتِ","وَٱلطَّٰغُوتِ","وَيَقُولُونَ","لِلَّذِينَ","كَفَرُواْ","هَٰٓؤُلَآءِ","أَهۡدَىٰ","مِنَ","ٱلَّذِينَ","ءَامَنُواْ","سَبِيلًا"],"алам тара илал лазиина уутуу насиибам минал китаби йу'минууна билжибти ваттагуути вайаḳуулууна лиллазиина кафаруу ха'улаи ахда минал лазиина амануу сабиила","Разве ты не видел тех, кому дана часть Писания? Они веруют в джибта и тагута и говорят ради неверующих: «Эти следуют более верным путем, чем верующие».",["разве не","видел ты","на","тех, которым","было дано","часть","из","Писания","они веруют","в джибт","и тагут","и говорят","о тех, которые","не уверовали","эти","вернее (идут)","чем","те, которые","уверовали","путём"]]],"m":[[["وَٱللَّهُ","и Аллах",4,45],["أَعۡلَمُ","лучше знает",4,45],["بِأَعۡدَآئِكُمۡۚ","ваших врагов",4,45],["وَكَفَىٰ","и довольно",4,45],["بِٱللَّهِ","Аллаха",4,45],["وَلِيّٗا","(как) Покровителя",4,45],["وَكَفَىٰ","и довольно",4,45],["بِٱللَّهِ","Аллаха",4,45],["نَصِيرٗا","(как) Помощника",4,45],[45]],[["مِّنَ","из",4,46],["ٱلَّذِينَ","тех, которые",4,46],["هَادُواْ","исповедуют иудаиз