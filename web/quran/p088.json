{"p":88,"j":5,"a":[[4,60,["أَلَمۡ","تَرَ","إِلَى","ٱلَّذِينَ","يَزۡعُمُونَ","أَنَّهُمۡ","ءَامَنُواْ","بِمَآ","أُنزِلَ","إِلَيۡكَ","وَمَآ","أُنزِلَ","مِن","قَبۡلِكَ","يُرِيدُونَ","أَن","يَتَحَاكَمُوٓاْ","إِلَى","ٱلطَّٰغُوتِ","وَقَدۡ","أُمِرُوٓاْ","أَن","يَكۡفُرُواْ","بِهِۦۖ","وَيُرِيدُ","ٱلشَّيۡطَٰنُ","أَن","يُضِلَّهُمۡ","ضَلَٰلَۢا","بَعِيدٗا"],"алам тара илал лазиина йаз`умууна аннахум амануу бима унзила илайка вама унзила мин ḳаблика йуриидууна ан йатахакамуу илат тагуути ваḳад умируу ан йакфуруу бихии вайуриидуш шайтану ан йудиллахум далала ба`иида","Разве ты не видел тех, которые заявляют, что они уверовали в ниспосланное тебе и в ниспосланное до тебя, но хотят обращаться на суд к тагуту, хотя им приказано не веровать в него? Дьявол желает ввести их в глубокое заблуждение.",["Разве не","видел ты","на","тех, которые","утверждают","что они","уверовали","в то, что","ниспослано","тебе","и что","ниспослано","из","прежде тебя","желают они","чтобы","обращаться за судом","к","тагуту","хотя уже","им было велено","чтобы","отвергали","его","и желает","шайтан","чтобы","сбить их","заблуждением","далёким"]],[4,61,["وَإِذَا","قِيلَ","لَهُمۡ","تَعَالَوۡاْ","إِلَىٰ","مَآ","أَنزَلَ","ٱللَّهُ","وَإِلَى","ٱلرَّسُولِ","رَأَيۡتَ","ٱلۡمُنَٰفِقِينَ","يَصُدُّونَ","عَنكَ","صُدُودٗا"],"ва'иза ḳиила лахум та`алау ила ма анзалаллаху ва'илар расуули ра'айтал мунафиḳиина йасуддууна `анка судууда","Когда им говорят: «Придите к тому, что ниспослал Аллах, и к Посланнику», - ты видишь, как лицемеры стремительно отворачиваются от тебя.",["И когда","сказано","им","придите","к","тому, что","ниспослал","Аллах","и к","Посланнику","видишь ты","лицемеров","отворачиваются","от тебя","с отвращением"]],[4,62,["فَكَيۡفَ","إِذَآ","أَصَٰبَتۡهُم","مُّصِيبَةُۢ","بِمَا","قَدَّمَتۡ","أَيۡدِيهِمۡ","ثُمَّ","جَآءُوكَ","يَحۡلِفُونَ","بِٱللَّهِ","إِنۡ","أَرَدۡنَآ","إِلَّآ","إِحۡسَٰنٗا","وَتَوۡفِيقًا"],"факайфа иза асабатхум мусиибату бима ḳаддамат айдиихим сумма жауука йахлифууна биллахи ин арадна илла ихсанан ватауфииḳа","А что будет, когда беда постигнет их за то, что приготовили их руки, после чего они придут к тебе и будут клясться Аллахом: «Мы хотели только добра и примирения»?",["Как же","когда","постигнет их","беда","за то, что","уготовили","руки их","затем","приходят к тебе","клянясь","Аллахом","не","хотели мы","кроме","добра","и согласия"]],[4,63,["أُوْلَٰٓئِكَ","ٱلَّذِينَ","يَعۡلَمُ","ٱللَّهُ","مَا","فِي","قُلُوبِهِمۡ","فَأَعۡرِضۡ","عَنۡهُمۡ","وَعِظۡهُمۡ","وَقُل","لَّهُمۡ","فِيٓ","أَنفُسِهِمۡ","قَوۡلَۢا","بَلِيغٗا"],"улаикал лазиина йа`ламуллаху ма фии ḳулуубихим фа'а`рид `анхум ва`изхум ваḳул лахум фии анфусихим ḳаула балиига","Аллах знает, что у них в сердцах. Посему отвернись от них, но увещевай их и говори им наедине (или говори им о них) убедительные слова.",["Те","которые","знает","Аллах","что","в","сердцах их","так отвернись","от них","и увещевай их","и скажи","им","о","душах их","словом","проникновенным"]],[4,64,["وَمَآ","أَرۡسَلۡنَا","مِن","رَّسُولٍ","إِلَّا","لِيُطَاعَ","بِإِذۡنِ","ٱللَّهِۚ","وَلَوۡ","أَنَّهُمۡ","إِذ","ظَّلَمُوٓاْ","أَنفُسَهُمۡ","جَآءُوكَ","فَٱسۡتَغۡفَرُواْ","ٱللَّهَ","وَٱسۡتَغۡفَرَ","لَهُمُ","ٱلرَّسُولُ","لَوَجَدُواْ","ٱللَّهَ","تَوَّابٗا","رَّحِيمٗا"],"вама арсална мир расуулин илла лийута`а би'изниллахи валау аннахум из заламуу анфусахум жауука фастагфаруллаха вастагфара лахумур расуулу лаважадуллаха таввабар рахиима","Мы отправили посланников только для того, чтобы им повиновались с дозволения Аллаха. Если бы они, поступив несправедливо по отношению к себе, пришли к тебе и попросили прощения у Аллаха, если бы Посланник попросил прощения за них, то они нашли бы Аллаха Принимающим покаяния и Милосердным.",["И не","послали Мы","из","посланника","кроме как","чтобы повиновались ему","с дозволения","Аллаха","и если бы","они","когда","обидели","себя","пришли к тебе","и попросили прощения","у Аллаха","и попросил прощения","для них","Посланник","непременно нашли бы","Аллаха","Принимающим покаяние","Милосердным"]],[4,65,["فَلَا","وَرَبِّكَ","لَا","يُؤۡمِنُونَ","حَتَّىٰ","يُحَكِّمُوكَ","فِيمَا","شَجَرَ","بَيۡنَهُمۡ","ثُمَّ","لَا","يَجِدُواْ","فِيٓ","أَنفُسِهِمۡ","حَرَجٗا","مِّمَّا","قَضَيۡتَ","وَيُسَلِّمُواْ","تَسۡلِيمٗا"],"фала вараббика ла йу'минууна хатта йухаккимуука фиима шажара байнахум сумма ла йажидуу фии анфусихим харажам мимма ḳадайта вайусаллимуу таслиима","Но нет - клянусь твоим Господом! - они не уверуют, пока они не изберут тебя судьей во всем том, что запутано между ними, не перестанут испытывать в душе стеснение от твоего решения и не подчинятся полностью.",["Так нет","клянусь Господом твоим","не","уверуют они","пока не","сделают тебя судьёй","в том, что","возникло спорного","между ними","затем","не","найдут","в","душах своих","стеснения","от того, что","решил ты","и подчинятся","полным подчинением"]]],"m":[[["أَلَمۡ","Разве не",4,60],["تَرَ","видел ты",4,60],["إِلَى","на",4,60],["ٱلَّذِينَ","тех, которые",4,60],["يَزۡعُمُونَ","утверждают",4,60],["أَنَّهُمۡ","что они",4,60],["ءَامَنُواْ","уверовали",4,60],["بِمَآ","в то, что",4,60],["أُنزِلَ","ниспослано",4,60],["إِلَيۡكَ","тебе",4,60]],[["وَمَآ","и что",4,60],["أُنزِلَ","ниспослано",4,60],["مِن","из",4,60],["قَبۡلِكَ","прежде тебя",4,60],["يُرِيدُونَ","желают они",4,60],["أَن","чтобы",4,60],["يَتَحَاكَمُوٓاْ","обращаться за судом",4,60],["إِلَى","к",4,60],["ٱلطَّٰغُوتِ","тагуту",4,60]],[["وَقَدۡ","хотя уже",4,60],["أُمِرُوٓاْ","им было велено",4,60],["أَن","чтобы",4,60],["يَكۡفُرُواْ","отвергали",4,60],["بِهِۦۖ","его",4,60],["وَيُرِيدُ","и желает",4,60],["ٱلشَّيۡطَٰنُ","шайтан",4,60],["أَن","чтобы",4,60],["يُضِلَّهُمۡ","сбить их",4,60]],[["ضَلَٰلَۢا","заблуждением",4,60],["بَعِيدٗا","далёким",4,60],[60],["وَإِذَا","И когда",4,61],["قِيلَ","сказано",4,61],["لَهُمۡ","им",4,61],["تَعَالَوۡاْ","придите",4,61],["إِلَىٰ","к",4,61],["مَآ","тому, что",4,61],["أَنزَلَ","ниспослал",4,61]],[["ٱللَّهُ","Аллах",4,61],["وَإِلَى","и к",4,61],["ٱلرَّسُولِ","Посланнику",4,61],["رَأَيۡتَ","видишь ты",4,61],["ٱلۡمُنَٰفِقِينَ","лицемеров",4,61],["يَصُدُّونَ","отворачиваются",4,61],["عَنكَ","от тебя",4,61]],[["صُدُودٗا","с отвращением",4,61],[61],["فَكَيۡفَ","Как же",4,62],["إِذَآ","когда",4,62],["أَصَٰبَتۡهُم","постигнет их",4,62],["مُّصِيبَةُۢ","беда",4,62],["بِمَا","за то, что",4,62]],[["قَدَّمَتۡ","уготовили",4,62],["أَيۡدِيهِمۡ","руки их",4,62],["ثُمَّ","затем",4,62],["جَآءُوكَ","приходят к тебе",4,62],["يَحۡلِفُونَ","клянясь",4,62],["بِٱللَّهِ","Аллахом",4,62],["إِنۡ","не",4,62],["أَرَدۡنَآ","хотели мы",4,62],["إِلَّآ","кроме",4,62]],[["إِحۡسَٰنٗا","добра",4,62],["وَتَوۡفِيقًا","и согласия",4,62],[62],["أُوْلَٰٓئِكَ","Те",4,63],["ٱلَّذِينَ","которые",4,63],["يَعۡلَمُ","знает",4,63],["ٱللَّهُ","Аллах",4,63],["مَا","что",4,63]],[["فِي","в",4,63],["قُلُوبِهِمۡ","сердцах их",4,63],["فَأَعۡرِضۡ","так отвернись",4,63],["عَنۡهُمۡ","от них",4,63],["وَعِظۡهُمۡ","и увещевай их",4,63],["وَقُل","и скажи",4,63],["لَّهُمۡ","им",4,63],["فِيٓ","о",4,63]],[["أَنفُسِهِمۡ","душах их",4,63],["قَوۡلَۢا","словом",4,63],["بَلِيغٗا","проникновенным",4,63],[63],["وَمَآ","И не",4,64],["أَرۡسَلۡنَا","послали Мы",4,64],["مِن","из",4,64],["رَّسُولٍ","посланника",4,64],["إِلَّا","кроме как",4,64]],[["لِيُطَاعَ","чтобы повиновались ему",4,64],["بِإِذۡنِ","с дозволения",4,64],["ٱللَّهِۚ","Аллаха",4,64],["وَلَوۡ","и если бы",4,64],["أَنَّهُمۡ","они",4,64],["إِذ","когда",4,64],["ظَّلَمُوٓاْ","обидели",4,64],["أَنفُسَهُمۡ","себя",4,64]],[["جَآءُوكَ","пришли к тебе",4,64],["فَٱسۡتَغۡفَرُواْ","и попросили прощения",4,64],["ٱللَّهَ","у Аллаха",4,64],["وَٱسۡتَغۡفَرَ","и попросил прощения",4,64],["لَهُمُ","для них",4,64],["ٱلرَّسُولُ","Посланник",4,64]],[["لَوَجَدُواْ","непременно нашли бы",4,64],["ٱللَّهَ","Аллаха",4,64],["تَوَّابٗا","Принимающим покаяние",4,64],["رَّحِيمٗا","Милосердным",4,64],[64],["فَلَا","Так нет",4,65],["وَرَبِّكَ","клянусь Господом твоим",4,65],["لَا","не",4,65],["يُؤۡمِنُونَ","уверуют они",4,65]],[["حَتَّىٰ","пока не",4,65],["يُحَكِّمُوكَ","сделают тебя судьёй",4,65],["فِيمَا","в том, что",4,65],["شَجَرَ","возникло спорного",4,65],["بَيۡنَهُمۡ","между ними",4,65],["ثُمَّ","затем",4,65],["لَا","не",4,65],["يَجِدُواْ","найдут",4,65]],[["فِيٓ","в",4,65],["أَنفُسِهِمۡ","душах своих",4,65],["حَرَجٗا","стеснения",4,65],["مِّمَّا","от того, что",4,65],["قَضَيۡتَ","решил ты",4,65],["وَيُسَلِّمُواْ","и подчинятся",4,65],["تَسۡلِيمٗا","полным подчинением",4,65],[65]]]}