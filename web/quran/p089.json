{"p":89,"j":5,"a":[[4,66,["وَلَوۡ","أَنَّا","كَتَبۡنَا","عَلَيۡهِمۡ","أَنِ","ٱقۡتُلُوٓاْ","أَنفُسَكُمۡ","أَوِ","ٱخۡرُجُواْ","مِن","دِيَٰرِكُم","مَّا","فَعَلُوهُ","إِلَّا","قَلِيلٞ","مِّنۡهُمۡۖ","وَلَوۡ","أَنَّهُمۡ","فَعَلُواْ","مَا","يُوعَظُونَ","بِهِۦ","لَكَانَ","خَيۡرٗا","لَّهُمۡ","وَأَشَدَّ","تَثۡبِيتٗا"],"валау анна катабна `алайхим аниḳтулуу анфусакум авихружуу мин дийарикум ма фа`алууху илла ḳалиилум минхум валау аннахум фа`алуу ма йуу`азууна бихии лакана хайрал лахум ва'ашадда тасбиита","Если бы Мы предписали им: «Убейте самих себя (пусть невинные убьют беззаконников) или покиньте свои дома», - то лишь немногие из них совершили бы это. А если бы они совершили то, чем их увещевают, то так было бы лучше для них и сильнее укрепило бы их.",["И если бы","Мы","предписали","им","чтобы","убейте","себя","или","выйдите","из","жилищ ваших","не","сделали бы это","кроме","немногие","из них","а если бы","они","сделали","то, к чему","увещевают их","этим","непременно было бы","лучше","для них","и сильнее","утверждением"]],[4,67,["وَإِذٗا","لَّأٓتَيۡنَٰهُم","مِّن","لَّدُنَّآ","أَجۡرًا","عَظِيمٗا"],"ва'изал ла'атайнахум мил ладунна ажран `азиима","Вот тогда Мы даровали бы им от Нас великую награду",["И тогда","непременно Мы дали бы им","от","Себя","награду","великую"]],[4,68,["وَلَهَدَيۡنَٰهُمۡ","صِرَٰطٗا","مُّسۡتَقِيمٗا"],"валахадайнахум сиратам мустаḳиима","и повели бы их прямым путем.",["И непременно Мы повели бы их","путём","прямым"]],[4,69,["وَمَن","يُطِعِ","ٱللَّهَ","وَٱلرَّسُولَ","فَأُوْلَٰٓئِكَ","مَعَ","ٱلَّذِينَ","أَنۡعَمَ","ٱللَّهُ","عَلَيۡهِم","مِّنَ","ٱلنَّبِيِّـۧنَ","وَٱلصِّدِّيقِينَ","وَٱلشُّهَدَآءِ","وَٱلصَّٰلِحِينَۚ","وَحَسُنَ","أُوْلَٰٓئِكَ","رَفِيقٗا"],"ваман йути`иллаха варрасуула фа'улаика ма`ал лазиина ан`амаллаху `алайхим минан набиййиина вассиддииḳиина вашшухадаи вассалихиина вахасуна улаика рафииḳа","Те, которые повинуются Аллаху и Посланнику, окажутся вместе с пророками, правдивыми мужами, павшими мучениками и праведниками, которых облагодетельствовал Аллах. Как же прекрасны эти спутники!",["И кто","повинуется","Аллаху","и Посланнику","то те","с","теми, которых","облагодетельствовал","Аллах","их","из","пророков","и правдивейших","и мучеников","и праведников","и прекрасны","те","как спутники"]],[4,70,["ذَٰلِكَ","ٱلۡفَضۡلُ","مِنَ","ٱللَّهِۚ","وَكَفَىٰ","بِٱللَّهِ","عَلِيمٗا"],"заликал фадлу миналлахи вакафа биллахи `алиима","Такова милость от Аллаха, и довольно того, что Аллах ведает о всякой вещи.",["это","милость","от","Аллаха","и довольно","Аллаха","как Знающего"]],[4,71,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُواْ","خُذُواْ","حِذۡرَكُمۡ","فَٱنفِرُواْ","ثُبَاتٍ","أَوِ","ٱنفِرُواْ","جَمِيعٗا"],"йа'аййухал лазиина амануу хузуу хизракум фанфируу субатин авинфируу жамии`а","О те, которые уверовали! Соблюдайте осторожность и выступайте отрядами или же выступайте все вместе.",["О вы","которые","уверовали","берите","осторожность вашу","и выступайте","отрядами","или","выступайте","все вместе"]],[4,72,["وَإِنَّ","مِنكُمۡ","لَمَن","لَّيُبَطِّئَنَّ","فَإِنۡ","أَصَٰبَتۡكُم","مُّصِيبَةٞ","قَالَ","قَدۡ","أَنۡعَمَ","ٱللَّهُ","عَلَيَّ","إِذۡ","لَمۡ","أَكُن","مَّعَهُمۡ","شَهِيدٗا"],"ва'инна минкум ламал лайубаттианна фа'ин асабаткум мусиибатун ḳала ḳад ан`амаллаху `алаййа из лам акум ма`ахум шахиида","Воистину, среди вас есть такой, который задержится, и если вас постигнет несчастье, то он скажет: «Аллах оказал мне милость тем, что я не присутствовал рядом с ними».",["И поистине","среди вас","непременно тот, кто","непременно медлит","и если","постигла вас","беда","сказал он","уже","оказал милость","Аллах","мне","когда","не","был я","с ними","присутствующим"]],[4,73,["وَلَئِنۡ","أَصَٰبَكُمۡ","فَضۡلٞ","مِّنَ","ٱللَّهِ","لَيَقُولَنَّ","كَأَن","لَّمۡ","تَكُنۢ","بَيۡنَكُمۡ","وَبَيۡنَهُۥ","مَوَدَّةٞ","يَٰلَيۡتَنِي","كُنتُ","مَعَهُمۡ","فَأَفُوزَ","فَوۡزًا","عَظِيمٗا"],"валаин асабакум фадлум миналлахи лайаḳууланна ка'ал лам такум байнакум вабайнахуу маваддатун йалайтании кунту ма`ахум фа'афууза фаузан `азиима","Если же вас постигнет милость от Аллаха, то он непременно скажет, словно между ним и вами никогда не было никакой дружбы: «Вот если бы я был вместе с ними и добился великого успеха!».",["А если","постигла вас","милость","от","Аллаха","непременно скажет он","как будто","не","было","между вами","и между ним","любви","О, если бы я","был","с ними","и преуспел бы я","успехом","великим"]],[4,74,["فَلۡيُقَٰتِلۡ","فِي","سَبِيلِ","ٱللَّهِ","ٱلَّذِينَ","يَشۡرُونَ","ٱلۡحَيَوٰةَ","ٱلدُّنۡيَا","بِٱلۡأٓخِرَةِۚ","وَمَن","يُقَٰتِلۡ","فِي","سَبِيلِ","ٱللَّهِ","فَيُقۡتَلۡ","أَوۡ","يَغۡلِبۡ","فَسَوۡفَ","نُؤۡتِيهِ","أَجۡرًا","عَظِيمٗا"],"фалйуḳатил фии сабиилиллахил лазиина йашруунал хайаватад дунйа бил'ахирати ваман йуḳатил фии сабиилиллахи файуḳтал ау йаглиб фасауфа ну'тиихи ажран `азиима","Пусть сражаются на пути Аллаха те, которые покупают (или продают) мирскую жизнь за Последнюю жизнь. Того, кто будет сражаться на пути Аллаха и будет убит или одержит победу, Мы одарим великой наградой.",["Пусть же сражаются","на","пути","Аллаха","те, которые","продают","жизнь","ближнюю","за последнюю (жизнь)","И кто","сражается","на","пути","Аллаха","и будет убит","или","победит","то вскоре","Мы дадим ему","награду","великую"]]],"m":[[["وَلَوۡ","И если бы",4,66],["أَنَّا","Мы",4,66],["كَتَبۡنَا","предписали",4,66],["عَلَيۡهِمۡ","им",4,66],["أَنِ","чтобы",4,66],["ٱقۡتُلُوٓاْ","убейте",4,66],["أَنفُسَكُمۡ","себя",4,66],["أَوِ","или",4,66],["ٱخۡرُجُواْ","выйдите",4,66],["مِن","из",4,66]],[["دِيَٰرِكُم","жилищ ваших",4,66],["مَّا","не",4,66],["فَعَلُوهُ","сделали бы это",4,66],["إِلَّا","кроме",4,66],["قَلِيلٞ","немногие",4,66],["مِّنۡهُمۡۖ","из них",4,66],["وَلَوۡ","а если бы",4,66],["أَنَّهُمۡ","они",4,66],["فَعَلُواْ","сделали",4,66],["مَا","то, к чему",4,66],["يُوعَظُونَ","увещевают их",4,66]],[["بِهِۦ","этим",4,66],["لَكَانَ","непременно было бы",4,66],["خَيۡرٗا","лучше",4,66],["لَّهُمۡ","для них",4,66],["وَأَشَدَّ","и сильнее",4,66],["تَثۡبِيتٗا","утверждением",4,66],[66],["وَإِذٗا","И тогда",4,67],["لَّأٓتَيۡنَٰهُم","неп