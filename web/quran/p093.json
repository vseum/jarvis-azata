ного","вам","а он","верующий","то освобождение","раба","верующего","а если","был он","из","народа","между вами","и между ними","договор","то выкуп","вручаемый","для","семьи его","и освобождение","раба","верующего","а кто","не","находит","то пост","двух месяцев","подряд","как покаяние","от","Аллаха","и есть","Аллах","Знающий","Мудрый"]],[4,93,["وَمَن","يَقۡتُلۡ","مُؤۡمِنٗا","مُّتَعَمِّدٗا","فَجَزَآؤُهُۥ","جَهَنَّمُ","خَٰلِدٗا","فِيهَا","وَغَضِبَ","ٱللَّهُ","عَلَيۡهِ","وَلَعَنَهُۥ","وَأَعَدَّ","لَهُۥ","عَذَابًا","عَظِيمٗا"],"ваман йаḳтул му'минам мута`аммидан фажазаухуу жаханнаму халидан фииха вагадибаллаху `алайхи вала`анахуу ва'а`адда лахуу `азабан `азиима","Если же кто-либо убьет верующего преднамеренно, то возмездием ему будет Геенна, в которой он пребудет вечно. Аллах разгневается на него, проклянет его и приготовит ему великие мучения.",["А кто","убьёт","верующего","умышленно","то воздаяние его","Геенна","вечно пребывающим","в ней","и разгневался","Аллах","на него","и проклял Он его","и уготовил Он","ему","наказание","великое"]],[4,94,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُوٓاْ","إِذَا","ضَرَبۡتُمۡ","فِي","سَبِيلِ","ٱللَّهِ","فَتَبَيَّنُواْ","وَلَا","تَقُولُواْ","لِمَنۡ","أَلۡقَىٰٓ","إِلَيۡكُمُ","ٱلسَّلَٰمَ","لَسۡتَ","مُؤۡمِنٗا","تَبۡتَغُونَ","عَرَضَ","ٱلۡحَيَوٰةِ","ٱلدُّنۡيَا","فَعِندَ","ٱللَّهِ","مَغَانِمُ","كَثِيرَةٞۚ","كَذَٰلِكَ","كُنتُم","مِّن","قَبۡلُ","فَمَنَّ","ٱللَّهُ","عَلَيۡكُمۡ","فَتَبَيَّنُوٓاْۚ","إِنَّ","ٱللَّهَ","كَانَ","بِمَا","تَعۡمَلُونَ","خَبِيرٗا"],"йа'аййухал лазиина амануу иза дарабтум фии сабиилиллахи фатабаййануу вала таḳуулуу лиман алḳа илайкумус салама ласта му'минан табтагууна `арадал хайаватид дунйа фа`индаллахи маганиму касииратун казалика кунтум мин ḳаблу фаманналлаху `алайкум фатабаййануу инналлаха кана бима та`малууна хабиира","О те, которые уверовали! Когда вы выступаете на пути Аллаха, то удостоверяйтесь и не говорите тому, кто приветствует вас миром: «Ты - неверующий», - стремясь обрести тленные блага мирской жизни. У Аллаха есть богатая добыча. Такими вы были прежде, но Аллах оказал вам милость, и посему удостоверяйтесь. Воистину, Аллах ведает о том, что вы совершаете.",["о","те, которые","уверовали","когда","выступаете вы","на","пути","Аллаха","то удостоверяйтесь","и не","говорите","тому, кто","предложил","вам","мир (салам)","ты не","верующий","стремясь","к благам","жизни","ближней","ведь у","Аллаха","добыча","обильная","такими","были вы","из","прежде","но оказал милость","Аллах","вам","так удостоверяйтесь","поистине","Аллах","есть","о том, что","вы делаете","Сведущий"]]],"m":[[["وَمَا","И не",4,92],["كَانَ","подобает",4,92],["لِمُؤۡمِنٍ","верующему",4,92],["أَن","чтобы",4,92],["يَقۡتُلَ","убил он",4,92],["مُؤۡمِنًا","верующего",4,92],["إِلَّا","кроме как",4,92],["خَطَـٔٗاۚ","по ошибке",4,92],["وَمَن","а кто",4,92],["قَتَلَ","убил",4,92]],[["مُؤۡمِنًا","верующего",4,92],["خَطَـٔٗا","по ошибке",4,92],["فَتَحۡرِيرُ","то освобождение",4,92],["رَقَبَةٖ","раба",4,92],["مُّؤۡمِنَةٖ","верующего",4,92],["وَدِيَةٞ","и выкуп",4,92],["مُّسَلَّمَةٌ","вручаемый",4,92],["إِلَىٰٓ","для",4,92]],[["أَهۡلِهِۦٓ","семьи его",4,92],["إِلَّآ","кроме",4,92],["أَن","того, что",4,92],["يَصَّدَّقُواْۚ","простят они (как милостыню)",4,92],["فَإِن","а если",4,92],["كَانَ","был он",4,92],["مِن","из",4,92],["قَوۡمٍ","народа",4,92],["عَدُوّٖ","враждебного",4,92],["لَّكُمۡ","вам",4,92]],[["وَهُوَ","а он",4,92],["مُؤۡمِنٞ","верующий",4,92],["فَتَحۡرِيرُ","то освобождение",4,92],["رَقَبَةٖ","раба",4,92],["مُّؤۡمِنَةٖۖ","верующего",4,92],["وَإِن","а если",4,92],["كَانَ","был он",4,92]],[["مِن","из",4,92],["قَوۡمِۭ","народа",4,92],["بَيۡنَكُمۡ","между вами",4,92],["وَبَيۡنَهُم","и между ними",4,92],["مِّيثَٰقٞ","договор",4,92],["فَدِيَةٞ","то выкуп",4,92],["مُّسَلَّمَةٌ","вручаемый",4,92]],[["إِلَىٰٓ","для",4,92],["أَهۡلِهِۦ","семьи его",4,92],["وَتَحۡرِيرُ","и освобождение",4,92],["رَقَبَةٖ","раба",4,92],["مُّؤۡمِنَةٖۖ","верующего",4,92],["فَمَن","а кто",4,92],["لَّمۡ","не",4,92],["يَجِدۡ","находит",4,92]],[["فَصِيَامُ","