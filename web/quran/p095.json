{"p":95,"j":5,"a":[[4,102,["وَإِذَا","كُنتَ","فِيهِمۡ","فَأَقَمۡتَ","لَهُمُ","ٱلصَّلَوٰةَ","فَلۡتَقُمۡ","طَآئِفَةٞ","مِّنۡهُم","مَّعَكَ","وَلۡيَأۡخُذُوٓاْ","أَسۡلِحَتَهُمۡۖ","فَإِذَا","سَجَدُواْ","فَلۡيَكُونُواْ","مِن","وَرَآئِكُمۡ","وَلۡتَأۡتِ","طَآئِفَةٌ","أُخۡرَىٰ","لَمۡ","يُصَلُّواْ","فَلۡيُصَلُّواْ","مَعَكَ","وَلۡيَأۡخُذُواْ","حِذۡرَهُمۡ","وَأَسۡلِحَتَهُمۡۗ","وَدَّ","ٱلَّذِينَ","كَفَرُواْ","لَوۡ","تَغۡفُلُونَ","عَنۡ","أَسۡلِحَتِكُمۡ","وَأَمۡتِعَتِكُمۡ","فَيَمِيلُونَ","عَلَيۡكُم","مَّيۡلَةٗ","وَٰحِدَةٗۚ","وَلَا","جُنَاحَ","عَلَيۡكُمۡ","إِن","كَانَ","بِكُمۡ","أَذٗى","مِّن","مَّطَرٍ","أَوۡ","كُنتُم","مَّرۡضَىٰٓ","أَن","تَضَعُوٓاْ","أَسۡلِحَتَكُمۡۖ","وَخُذُواْ","حِذۡرَكُمۡۗ","إِنَّ","ٱللَّهَ","أَعَدَّ","لِلۡكَٰفِرِينَ","عَذَابٗا","مُّهِينٗا"],"ва'иза кунта фиихим фа'аḳамта лахумус салавата фалтаḳум таифатум минхум ма`ака валйа'хузуу аслихатахум фа'иза сажадуу фалйакуунуу мин вараикум валта'ти таифатун ухра лам йусаллуу фалйусаллуу ма`ака валйа'хузуу хизрахум ва'аслихатахум ваддал лазиина кафаруу лау тагфулууна `ан аслихатикум ва'амти`атикум файамиилууна `алайкум майлатан вахидатан вала жунаха `алайкум ин кана бикум азам мим матарин ау кунтум марда ан тада`уу аслихатакум вахузуу хизракум инналлаха а`адда лилкафириина `азабам мухиина","Когда ты находишься среди них и руководишь их намазом, то пусть одна группа из них встанет вместе с тобой, и пусть они возьмут свое оружие. Когда же они совершат земной поклон, пусть они находятся позади вас. Пусть затем придет другая группа, которая еще не молилась, пусть они помолятся вместе с тобой, будут осторожны и возьмут свое оружие. Неверующим хотелось бы, чтобы вы беспечно отнеслись к своему оружию и своим вещам, дабы они могли напасть на вас всего один раз (покончить с вами одним разом). На вас не будет греха, если вы отложите свое оружие, когда испытываете неудобство от дождя или больны, но будьте осторожны. Воистину, Аллах приготовил неверующим унизительные мучения.",["и когда","ты (находишься)","среди них","и ведёшь","для них","намаз","то пусть встанет","группа","из них","с тобой","и пусть возьмут","оружие своё","а когда","совершат земной поклон","то пусть будут","от","позади вас","и пусть придёт","группа","другая","не","молившиеся","и пусть молятся","с тобой","и пусть возьмут","осторожность свою","и оружие своё","хотели бы","те, которые","не уверовали","чтобы","небрежны вы","к","оружию вашему","и вещам вашим","и набросились бы","на вас","нападением","единым","и нет","греха","на вас","если","было","у вас","неудобство","от","дождя","или","были вы","больны","что","отложите вы","оружие ваше","но берите","осторожность вашу","поистине","Аллах","приготовил","для неверующих","наказание","унизительное"]],[4,103,["فَإِذَا","قَضَيۡتُمُ","ٱلصَّلَوٰةَ","فَٱذۡكُرُواْ","ٱللَّهَ","قِيَٰمٗا","وَقُعُودٗا","وَعَلَىٰ","جُنُوبِكُمۡۚ","فَإِذَا","ٱطۡمَأۡنَنتُمۡ","فَأَقِيمُواْ","ٱلصَّلَوٰةَۚ","إِنَّ","ٱلصَّلَوٰةَ","كَانَتۡ","عَلَى","ٱلۡمُؤۡمِنِينَ","كِتَٰبٗا","مَّوۡقُوتٗا"],"фа'иза ḳадайтумус салавата фазкуруллаха ḳийаман ваḳу`уудан ва`ала жунуубикум фа'изатма'нантум фа'аḳиимус салавата иннас салавата канат `алал му'миниина китабам мауḳуута","Когда вы завершите намаз, то поминайте Аллаха стоя, сидя или лежа на боках. Когда же вы окажетесь в безопасности, то совершайте намаз. Воистину, намаз предписан верующим в определенное время.",["а когда","завершите вы","намаз","то поминайте","Аллаха","стоя","и сидя","и на","боках ваших","а когда","будете в безопасности","то совершайте","намаз","поистине","намаз","является","для","верующих","предписанием","по времени"]],[4,104,["وَلَا","تَهِنُواْ","فِي","ٱبۡتِغَآءِ","ٱلۡقَوۡمِۖ","إِن","تَكُونُواْ","تَأۡلَمُونَ","فَإِنَّهُمۡ","يَأۡلَمُونَ","كَمَا","تَأۡلَمُونَۖ","وَتَرۡجُونَ","مِنَ","ٱللَّهِ","مَا","لَا","يَرۡجُونَۗ","وَكَانَ","ٱللَّهُ","عَلِيمًا","حَكِيمًا"],"вала тахинуу фибтигаил ḳауми ин такуунуу та'ламууна фа'иннахум йа'ламууна кама та'ламууна ватаржууна миналлахи ма ла йаржууна ваканаллаху `алииман хакиима","Не проявляйте слабости при преследовании врага. Если вы страдаете, то они тоже страдают так, как страдаете вы. Но вы надеетесь получить от Аллаха то, на что они не надеются. Аллах - Знающий, Мудрый.",["и не","ослабевайте","в","преследовании","(вражеского) народа","если","будете вы","страдать","то поистине, они","страдают","как","страдаете вы","и надеетесь вы","от","Аллаха","на то, что","не","надеются они","и есть","Аллах","Знающий","Мудрый"]],[4,105,["إِنَّآ","أَنزَلۡنَآ","إِلَيۡكَ","ٱلۡكِتَٰبَ","بِٱلۡحَقِّ","لِتَحۡكُمَ","بَيۡنَ","ٱلنَّاسِ","بِمَآ","أَرَىٰكَ","ٱللَّهُۚ","وَلَا","تَكُن","لِّلۡخَآئِنِينَ","خَصِيمٗا"],"инна анзална илайкал китаба билхаḳḳи литахкума байнан наси бима аракаллаху вала такул лилхаиниина хасиима","Мы ниспослали тебе Писание с истиной, чтобы ты разбирал тяжбы между людьми так, как тебе показал Аллах. Посему не препирайся за изменников.",["поистине, Мы","ниспослали Мы","тебе","Писание","с истиной","чтобы ты судил","между","людьми","тем, что","показал тебе","Аллах","и не","будь","за изменников","заступником"]]],"m":[[["وَإِذَا","и когда",4,102],["كُنتَ","ты (находишься)",4,102],["فِيهِمۡ","среди них",4,102],["فَأَقَمۡتَ","и ведёшь",4,102],["لَهُمُ","для них",4,102],["ٱلصَّلَوٰةَ","намаз",4,102],["فَلۡتَقُمۡ","то пусть встанет",4,102],["طَآئِفَةٞ","группа",4,102]],[["مِّنۡهُم","из них",4,102],["مَّعَكَ","с тобой",4,102],["وَلۡيَأۡخُذُوٓاْ","и пусть возьмут",4,102],["أَسۡلِحَتَهُمۡۖ","оружие своё",4,102],["فَإِذَا","а когда",4,102],["سَجَدُواْ","совершат земной поклон",4,102],["فَلۡيَكُونُواْ","то пусть будут",4,102]],[["مِن","от",4,102],["وَرَآئِكُمۡ","позади вас",4,102],["وَلۡتَأۡتِ","и пусть придёт",4,102],["طَآئِفَةٌ","группа",4,102],["أُخۡرَىٰ","другая",4,102],["لَمۡ","не",4,102],["يُصَلُّواْ","молившиеся",4,102]],[["فَلۡيُصَلُّواْ","и пусть молятся",4,102],["مَعَكَ","с тобой",4,102],["وَلۡيَأۡخُذُواْ","и пусть возьмут",4,102],["حِذۡرَهُمۡ","осторожность свою",4,102],["وَأَسۡلِحَتَهُمۡۗ","и оружие своё",4,102],["وَدَّ","хотели бы",4,102],["ٱلَّذِينَ","те, которые",4,102]],[["كَفَرُواْ"