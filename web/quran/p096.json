{"p":96,"j":5,"a":[[4,106,["وَٱسۡتَغۡفِرِ","ٱللَّهَۖ","إِنَّ","ٱللَّهَ","كَانَ","غَفُورٗا","رَّحِيمٗا"],"вастагфириллаха инналлаха кана гафуурар рахиима","Проси прощения у Аллаха, ведь Аллах - Прощающий, Милосердный.",["и проси прощения","у Аллаха","поистине","Аллах","был","Прощающим","Милосердным"]],[4,107,["وَلَا","تُجَٰدِلۡ","عَنِ","ٱلَّذِينَ","يَخۡتَانُونَ","أَنفُسَهُمۡۚ","إِنَّ","ٱللَّهَ","لَا","يُحِبُّ","مَن","كَانَ","خَوَّانًا","أَثِيمٗا"],"вала тужадил `анил лазиина йахтанууна анфусахум инналлаха ла йухиббу ман кана хавванан асиима","Не препирайся за тех, которые предают самих себя (ослушаются Аллаха), ведь Аллах не любит того, кто является изменником, грешником.",["и не","препирайся","за","тех, которые","предают","самих себя","поистине","Аллах","не","любит","того, кто","является","изменником","грешником"]],[4,108,["يَسۡتَخۡفُونَ","مِنَ","ٱلنَّاسِ","وَلَا","يَسۡتَخۡفُونَ","مِنَ","ٱللَّهِ","وَهُوَ","مَعَهُمۡ","إِذۡ","يُبَيِّتُونَ","مَا","لَا","يَرۡضَىٰ","مِنَ","ٱلۡقَوۡلِۚ","وَكَانَ","ٱللَّهُ","بِمَا","يَعۡمَلُونَ","مُحِيطًا"],"йастахфууна минан наси вала йастахфууна миналлахи вахуа ма`ахум из йубаййитууна ма ла йарда минал ḳаули ваканаллаху бима йа`малууна мухиита","Они укрываются от людей, но не укрываются от Аллаха, тогда как Он находится с ними, когда они произносят по ночам слова, которыми Он не доволен. Аллах объемлет то, что они совершают.",["укрываются они","от","людей","но не","укрываются они","от","Аллаха","а Он","с ними","когда","замышляют ночью","то, что","не","доволен Он","из","слов","и есть","Аллах","тем, что","делают они","Объемлющий"]],[4,109,["هَٰٓأَنتُمۡ","هَٰٓؤُلَآءِ","جَٰدَلۡتُمۡ","عَنۡهُمۡ","فِي","ٱلۡحَيَوٰةِ","ٱلدُّنۡيَا","فَمَن","يُجَٰدِلُ","ٱللَّهَ","عَنۡهُمۡ","يَوۡمَ","ٱلۡقِيَٰمَةِ","أَم","مَّن","يَكُونُ","عَلَيۡهِمۡ","وَكِيلٗا"],"ха'антум ха'улаи жадалтум `анхум фил хайаватид дунйа фаман йужадилуллаха `анхум йаумал ḳийамати ам ман йакууну `алайхим вакиила","Вот вы препираетесь за них в этом мире. Но кто станет препираться за них с Аллахом в День воскресения? Или кто будет их защитником?",["вот вы","эти (самые)","препирались вы","за них","в","жизни","ближней","но кто","будет препираться","(с) Аллахом","за них","в День","Воскресения","или","кто","будет","над ними","защитником"]],[4,110,["وَمَن","يَعۡمَلۡ","سُوٓءًا","أَوۡ","يَظۡلِمۡ","نَفۡسَهُۥ","ثُمَّ","يَسۡتَغۡفِرِ","ٱللَّهَ","يَجِدِ","ٱللَّهَ","غَفُورٗا","رَّحِيمٗا"],"ваман йа`мал сууан ау йазлим нафсахуу сумма йастагфириллаха йажидиллаха гафуурар рахиима","Если кто-либо совершит злодеяние или будет несправедлив по отношению к себе, а затем попросит у Аллаха прощения, то он найдет Аллаха Прощающим и Милосердным.",["и кто","совершит","зло","или","обидит","душу свою","затем","попросит прощения у","Аллаха","найдёт","Аллаха","Прощающим","Милосердным"]],[4,111,["وَمَن","يَكۡسِبۡ","إِثۡمٗا","فَإِنَّمَا","يَكۡسِبُهُۥ","عَلَىٰ","نَفۡسِهِۦۚ","وَكَانَ","ٱللَّهُ","عَلِيمًا","حَكِيمٗا"],"ваман йаксиб исман фа'иннама йаксибухуу `ала нафсихии ваканаллаху `алииман хакиима","Кто совершил грех, тот совершил его во вред себе. Аллах - Знающий, Мудрый.",["и кто","приобретёт","грех","то лишь","приобретает он его","против","самого себя","и есть","Аллах","Знающий","Мудрый"]],[4,112,["وَمَن","يَكۡسِبۡ","خَطِيٓـَٔةً","أَوۡ","إِثۡمٗا","ثُمَّ","يَرۡمِ","بِهِۦ","بَرِيٓـٔٗا","فَقَدِ","ٱحۡتَمَلَ","بُهۡتَٰنٗا","وَإِثۡمٗا","مُّبِينٗا"],"ваман йаксиб хатииатан ау исман сумма йарми бихии барииан фаḳадихтамала бухтанан ва'исмам мубиина","А кто совершил ошибку или грех и обвинил в этом невиновного, тот взвалил на себя бремя клеветы и очевидного греха.",["и кто","приобретёт","проступок","или","грех","затем","бросит","его","(на) невиновного","то уже","взвалил он (на себя)","клевету","и грех","явный"]],[4,113,["وَلَوۡلَا","فَضۡلُ","ٱللَّهِ","عَلَيۡكَ","وَرَحۡمَتُهُۥ","لَهَمَّت","طَّآئِفَةٞ","مِّنۡهُمۡ","أَن","يُضِلُّوكَ","وَمَا","يُضِلُّونَ","إِلَّآ","أَنفُسَهُمۡۖ","وَمَا","يَضُرُّونَكَ","مِن","شَيۡءٖۚ","وَأَنزَلَ","ٱللَّهُ","عَلَيۡكَ","ٱلۡكِتَٰبَ","وَٱلۡحِكۡمَةَ","وَعَلَّمَكَ","مَا","لَمۡ","تَكُن","تَعۡلَمُۚ","وَكَانَ","فَضۡلُ","ٱللَّهِ","عَلَيۡكَ","عَظِيمٗا"],"валаула фадлуллахи `алайка варахматухуу лахаммат таифатум минхум ан йудиллуука вама йудиллууна илла анфусахум вама йадурруунака мин шай'ин ва'анзалаллаху `алайкал китаба валхикмата ва`алламака ма лам такун та`ламу вакана фадлуллахи `алайка `азиима","Если бы не милосердие и милость Аллаха к тебе, то группа из них вознамерилась бы ввести тебя в заблуждение, однако они вводят в заблуждение только самих себя и ничем не вредят тебе. Аллах ниспослал тебе Писание и мудрость и научил тебя тому, чего ты не знал. Милость Аллаха к тебе велика!",["и если бы не","милость","Аллаха","к тебе","и милосердие Его","непременно задумала бы","группа","из них","чтобы","сбить тебя (с пути)","но не","сбивают они","кроме","самих себя","и не","вредят они тебе","ни","в чём","и ниспослал","Аллах","тебе","Писание","и мудрость","и научил тебя","тому, что","не","был ты","знающим","и является","милость","Аллаха","к тебе","великой"]]],"m":[[["وَٱسۡتَغۡفِرِ","и проси прощения",4,106],["ٱللَّهَۖ","у Аллаха",4,106],["إِنَّ","поистине",4,106],["ٱللَّهَ","Аллах",4,106],["كَانَ","был",4,106],["غَفُورٗا","Прощающим",4,106],["رَّحِيمٗا","Милосердным",4,106],[106],["وَلَا","и не",4,107],["تُجَٰدِلۡ","препирайся",4,107]],[["عَنِ","за",4,107],["ٱلَّذِينَ","тех, которые",4,107],["يَخۡتَانُونَ","предают",4,107],["أَنفُسَهُمۡۚ","самих себя",4,107],["إِنَّ","поистине",4,107],["ٱللَّهَ","Аллах",4,107],["لَا","не",4,107],["يُحِبُّ","любит",4,107],["مَن","того, кто",4,107],["كَانَ","является",4,107]],[["خَوَّانًا","изменником",4,107],["أَثِيمٗا","грешником",4,107],[107],["يَسۡتَخۡفُونَ","укрываются они",4,108],["مِنَ","от",4,108],["ٱلنَّاسِ","людей",4,108],["وَلَا","но не",4,108],["يَسۡتَخۡفُونَ","укрываются они",4,108]],[["مِنَ","от",4,108],["ٱللَّهِ","Аллаха",4,108],["وَهُوَ","а Он",4,108],["مَعَهُمۡ","с ними",4,108],["إِذۡ","когда",4,108],["يُبَيِّتُونَ","замышляют ночью",4,108],["مَا","то, что",4,108],["لَا","не",4,108],["يَرۡضَىٰ