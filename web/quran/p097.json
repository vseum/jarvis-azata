{"p":97,"j":5,"a":[[4,114,["لَّا","خَيۡرَ","فِي","كَثِيرٖ","مِّن","نَّجۡوَىٰهُمۡ","إِلَّا","مَنۡ","أَمَرَ","بِصَدَقَةٍ","أَوۡ","مَعۡرُوفٍ","أَوۡ","إِصۡلَٰحِۭ","بَيۡنَ","ٱلنَّاسِۚ","وَمَن","يَفۡعَلۡ","ذَٰلِكَ","ٱبۡتِغَآءَ","مَرۡضَاتِ","ٱللَّهِ","فَسَوۡفَ","نُؤۡتِيهِ","أَجۡرًا","عَظِيمٗا"],"лла хайра фии касиирим мин нажвахум илла ман амара бисадаḳатин ау ма`рууфин ау ислахи байнан наси ваман йаф`ал заликабтигаа мардатиллахи фасауфа ну'тиихи ажран `азиима","Многие из их тайных бесед не приносят добра, если только они не призывают раздавать милостыню, совершать одобряемое или примирять людей. Тому, кто поступает таким образом, стремясь к довольству Аллаха, Мы даруем великую награду.",["нет","блага","во","многих","из","тайных бесед их","кроме","(бесед) того, кто","велел","(раздавать) милостыню","или","одобряемое","или","примирение","между","людьми","и кто","делает","это","стремясь","к довольству","Аллаха","то вскоре","Мы дадим ему","награду","великую"]],[4,115,["وَمَن","يُشَاقِقِ","ٱلرَّسُولَ","مِنۢ","بَعۡدِ","مَا","تَبَيَّنَ","لَهُ","ٱلۡهُدَىٰ","وَيَتَّبِعۡ","غَيۡرَ","سَبِيلِ","ٱلۡمُؤۡمِنِينَ","نُوَلِّهِۦ","مَا","تَوَلَّىٰ","وَنُصۡلِهِۦ","جَهَنَّمَۖ","وَسَآءَتۡ","مَصِيرًا"],"ваман йушаḳиḳир расуула мим ба`ди ма табаййана лахул худа вайаттаби` гайра сабиилил му'миниина нуаллихии ма тавалла вануслихии жаханнама васаат масиира","А того, кто воспротивится Посланнику после того, как ему стал ясен прямой путь, и последует не путем верующих, Мы направим туда, куда он обратился, и сожжем в Геенне. Как же скверно это место прибытия!",["и кто","воспротивится","Посланнику","из","после","того, как","стал ясен","ему","прямой путь","и последует","не по","пути","верующих","Мы обратим его","к тому, к чему","обратился он","и сожжём его","(в) Геенне","и скверно","место прибытия"]],[4,116,["إِنَّ","ٱللَّهَ","لَا","يَغۡفِرُ","أَن","يُشۡرَكَ","بِهِۦ","وَيَغۡفِرُ","مَا","دُونَ","ذَٰلِكَ","لِمَن","يَشَآءُۚ","وَمَن","يُشۡرِكۡ","بِٱللَّهِ","فَقَدۡ","ضَلَّ","ضَلَٰلَۢا","بَعِيدًا"],"инналлаха ла йагфиру ан йушрака бихии вайагфиру ма дууна залика лиман йашау ваман йушрик биллахи фаḳад далла далала ба`иида","Воистину, Аллах не прощает, когда к Нему приобщают сотоварищей, но прощает все остальные (или менее тяжкие) грехи, кому пожелает. А кто приобщает к Аллаху сотоварищей, тот впал в глубокое заблуждение.",["поистине","Аллах","не","прощает","что","приобщают сотоварищей","к Нему","и прощает Он","то, что","ниже","этого","кому","пожелает Он","и кто","приобщает сотоварищей","к Аллаху","то уже","заблудился он","заблуждением","далёким"]],[4,117,["إِن","يَدۡعُونَ","مِن","دُونِهِۦٓ","إِلَّآ","إِنَٰثٗا","وَإِن","يَدۡعُونَ","إِلَّا","شَيۡطَٰنٗا","مَّرِيدٗا"],"ин йад`ууна мин дуунихии илла инасан ва'ин йад`ууна илла шайтанам мариида","Они взывают вместо Аллаха лишь к существам женского рода. Они взывают лишь к мятежному дьяволу.",["не","взывают они","из","помимо Него","кроме","(к) женским (божествам)","и не","взывают они","кроме","(к) дьяволу","мятежному"]],[4,118,["لَّعَنَهُ","ٱللَّهُۘ","وَقَالَ","لَأَتَّخِذَنَّ","مِنۡ","عِبَادِكَ","نَصِيبٗا","مَّفۡرُوضٗا"],"лла`анахуллаху ваḳала ла'аттахизанна мин `ибадика насиибам мафрууда","Аллах проклял его, и он сказал: «Я непременно заберу назначенную часть Твоих рабов.",["проклял его","Аллах","и сказал он","непременно возьму я","из","рабов Твоих","долю","назначенную"]],[4,119,["وَلَأُضِلَّنَّهُمۡ","وَلَأُمَنِّيَنَّهُمۡ","وَلَأٓمُرَنَّهُمۡ","فَلَيُبَتِّكُنَّ","ءَاذَانَ","ٱلۡأَنۡعَٰمِ","وَلَأٓمُرَنَّهُمۡ","فَلَيُغَيِّرُنَّ","خَلۡقَ","ٱللَّهِۚ","وَمَن","يَتَّخِذِ","ٱلشَّيۡطَٰنَ","وَلِيّٗا","مِّن","دُونِ","ٱللَّهِ","فَقَدۡ","خَسِرَ","خُسۡرَانٗا","مُّبِينٗا"],"валаудилланнахум валауманнийаннахум вала'амураннахум фалайубаттикунна азанал ан`ами вала'амураннахум фалайугаййирунна халḳаллахи ваман йаттахизиш шайтана валиййам мин дууниллахи фаḳад хасира хусранам мубиина","Я непременно введу их в заблуждение, возбужу в них надежды, прикажу им обрезать уши у скотины и прикажу им искажать творение Аллаха». Кто сделал дьявола своим покровителем и помощником вместо Аллаха, тот уже потерпел очевидный убыток.",["и непременно собью их","и непременно обнадёжу их","и непременно велю им","и непременно отрежут","уши","скота","и непременно велю им","и непременно изменят","творение","Аллаха","и кто","возьмёт","дьявола","покровителем","из","помимо","Аллаха","то уже","потерял он","потерей","явной"]],[4,120,["يَعِدُهُمۡ","وَيُمَنِّيهِمۡۖ","وَمَا","يَعِدُهُمُ","ٱلشَّيۡطَٰنُ","إِلَّا","غُرُورًا"],"йа`идухум вайуманниихим вама йа`идухумуш шайтану илла гуруура","Он дает им обещания и возбуждает в них надежды. Но дьявол не обещает им ничего, кроме обольщения.",["обещает он им","и обнадёживает их","и не","обещает им","дьявол","кроме","обольщения"]],[4,121,["أُوْلَٰٓئِكَ","مَأۡوَىٰهُمۡ","جَهَنَّمُ","وَلَا","يَجِدُونَ","عَنۡهَا","مَحِيصٗا"],"улаика ма'вахум жаханнаму вала йажидууна `анха махииса","Их пристанищем будет Геенна, и они не найдут пути к спасению оттуда.",["те","пристанище их","Геенна","и не","найдут они","от неё","избавления"]]],"m":[[["۞ لَّا","нет",4,114],["خَيۡرَ","блага",4,114],["فِي","во",4,114],["كَثِيرٖ","многих",4,114],["مِّن","из",4,114],["نَّجۡوَىٰهُمۡ","тайных бесед их",4,114],["إِلَّا","кроме",4,114],["مَنۡ","(бесед) того, кто",4,114],["أَمَرَ","велел",4,114],["بِصَدَقَةٍ","(раздавать) милостыню",4,114]],[["أَوۡ","или",4,114],["مَعۡرُوفٍ","одобряемое",4,114],["أَوۡ","или",4,114],["إِصۡلَٰحِۭ","примирение",4,114],["بَيۡنَ","между",4,114],["ٱلنَّاسِۚ","людьми",4,114],["وَمَن","и кто",4,114],["يَفۡعَلۡ","делает",4,114],["ذَٰلِكَ","это",4,114]],[["ٱبۡتِغَآءَ","стремясь",4,114],["مَرۡضَاتِ","к довольству",4,114],["ٱللَّهِ","Аллаха",4,114],["فَسَوۡفَ","то вскоре",4,114],["نُؤۡتِيهِ","Мы дадим ему",4,114],["أَجۡرًا","награду",4,114],["عَظِيمٗا","великую",4,114],[114],["وَمَن","и кто",4,115]],[["يُشَاقِقِ","воспротивится",4,115],["ٱلرَّسُولَ","Посланнику",4,115],["مِنۢ","из",4,115],["بَعۡدِ","после",4,115],["مَا","того, как",4,115],["تَبَيَّنَ","стал ясен",4,115],["لَهُ","ему",4,115],["ٱلۡهُدَىٰ","прямой путь",4,115],["وَيَتَّبِعۡ","и последует",4,115],["غَيۡرَ","не по",4,115]],[["سَبِيلِ","пути",4,115],["ٱلۡمُؤۡمِنِينَ","верующих",4,115],["نُوَلِّهِۦ","Мы обратим его",4,115],["مَا","к тому, к чему",4,115],["تَوَلَّىٰ","обратился он",4,115],["وَنُصۡلِهِۦ","и сожжём его",4,115],["جَهَنَّمَۖ","(в) Геенне",4,115],["وَسَآءَتۡ","и скверно",4,115]],[["مَصِيرًا","место прибытия",4,115],[115],["إِنَّ","поистине",4,116],["ٱللَّهَ","Аллах",4,116],["لَا","не",4,116],["يَغۡفِرُ","прощает",4,116],["أَن","что",4,116],["يُشۡرَكَ","приобщают сотоварищей",4,116],["بِهِۦ","к Нему",4,116],["وَيَغۡفِرُ","и прощает Он",4,116],["مَا","то, что",4,116],["دُونَ","ниже",4,116]],[["ذَٰلِكَ","этого",4,116],["لِمَن","кому",4,116],["يَشَآءُۚ","пожелает Он",4,116],["وَمَن","и кто",4,116],["يُشۡرِكۡ","приобщает сотоварищей",4,116],["بِٱللَّهِ","к Аллаху",4,116],["فَقَدۡ","то уже",4,116],["ضَلَّ","заблудился он",4,116],["ضَلَٰلَۢا","заблуждением",4,116],["بَعِيدًا","далёким",4,116]],[[116],["إِن","не",4,117],["يَدۡعُونَ","взывают они",4,117],["مِن","из",4,117],["دُونِهِۦٓ","помимо Него",4,117],["إِلَّآ","кроме",4,117],["إِنَٰثٗا","(к) женским (божествам)",4,117],["وَإِن","и не",4,117],["يَدۡعُونَ","взывают они",4,117]],[["إِلَّا","кроме",4,117],["شَيۡطَٰنٗا","(к) дьяволу",4,117],["مَّرِيدٗا","мятежному",4,117],[117],["لَّعَنَهُ","проклял его",4,118],["ٱللَّهُۘ","Аллах",4,118],["وَقَالَ","и сказал он",4,118],["لَأَتَّخِذَنَّ","непременно возьму я",4,118]],[["مِنۡ","из",4,118],["عِبَادِكَ","рабов Твоих",4,118],["نَصِيبٗا","долю",4,118],["مَّفۡرُوضٗا","назначенную",4,118],[118],["وَلَأُضِلَّنَّهُمۡ","и непременно собью их",4,119],["وَلَأُمَنِّيَنَّهُمۡ","и непременно обнадёжу их",4,119]],[["وَلَأٓمُرَنَّهُمۡ","и непременно велю им",4,119],["فَلَيُبَتِّكُنَّ","и непременно отрежут",4,119],["ءَاذَانَ","уши",4,119],["ٱلۡأَنۡعَٰمِ","скота",4,119],["وَلَأٓمُرَنَّهُمۡ","и непременно велю им",4,119]],[["فَلَيُغَيِّرُنَّ","и непременно изменят",4,119],["خَلۡقَ","творение",4,119],["ٱللَّهِۚ","Аллаха",4,11