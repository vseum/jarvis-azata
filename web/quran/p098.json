{"p":98,"j":5,"a":[[4,122,["وَٱلَّذِينَ","ءَامَنُواْ","وَعَمِلُواْ","ٱلصَّٰلِحَٰتِ","سَنُدۡخِلُهُمۡ","جَنَّٰتٖ","تَجۡرِي","مِن","تَحۡتِهَا","ٱلۡأَنۡهَٰرُ","خَٰلِدِينَ","فِيهَآ","أَبَدٗاۖ","وَعۡدَ","ٱللَّهِ","حَقّٗاۚ","وَمَنۡ","أَصۡدَقُ","مِنَ","ٱللَّهِ","قِيلٗا"],"валлазиина амануу ва`амилус салихати санудхилухум жаннатин тажрии мин тахтихал анхару халидиина фииха абадан ва`даллахи хаḳḳан ваман асдаḳу миналлахи ḳиила","А тех, которые уверовали и совершали праведные деяния, Мы введем в Райские сады, в которых текут реки. Они пребудут там вечно по истинному обещанию Аллаха. Чья речь правдивее речи Аллаха?",["а те, которые","уверовали","и совершали","праведные дела","Мы введём их","(в) сады","текут","от","под ними","реки","вечно пребывающими","в них","навеки","обещание","Аллаха","истинное","и кто","правдивее","чем","Аллах","словом"]],[4,123,["لَّيۡسَ","بِأَمَانِيِّكُمۡ","وَلَآ","أَمَانِيِّ","أَهۡلِ","ٱلۡكِتَٰبِۗ","مَن","يَعۡمَلۡ","سُوٓءٗا","يُجۡزَ","بِهِۦ","وَلَا","يَجِدۡ","لَهُۥ","مِن","دُونِ","ٱللَّهِ","وَلِيّٗا","وَلَا","نَصِيرٗا"],"ллайса би'аманиййикум вала аманиййи ахлил китаби ман йа`мал сууан йужза бихии вала йажид лахуу мин дууниллахи валиййан вала насиира","Этого не достичь посредством ваших мечтаний или мечтаний людей Писания. Кто творит зло, тот получит за него воздаяние и не найдет для себя вместо Аллаха ни покровителя, ни помощника.",["не","по мечтам вашим","и не","(по) мечтам","людей","Писания","кто","совершит","зло","получит воздаяние","за него","и не","найдёт","для себя","из","помимо","Аллаха","покровителя","и не","помощника"]],[4,124,["وَمَن","يَعۡمَلۡ","مِنَ","ٱلصَّٰلِحَٰتِ","مِن","ذَكَرٍ","أَوۡ","أُنثَىٰ","وَهُوَ","مُؤۡمِنٞ","فَأُوْلَٰٓئِكَ","يَدۡخُلُونَ","ٱلۡجَنَّةَ","وَلَا","يُظۡلَمُونَ","نَقِيرٗا"],"ваман йа`мал минас салихати мин закарин ау унса вахуа му'минун фа'улаика йадхулуунал жанната вала йузламууна наḳиира","А те мужчины и женщины, которые совершают некоторые из праведных поступков, будучи верующими, войдут в Рай, и не будут обижены даже на величину выемки на финиковой косточке.",["и кто","совершит","из","праведных дел","из (будь то)","мужчины","или","женщины","и он","верующий","то те","войдут","(в) Рай","и не","будут обижены","(на) выемку косточки"]],[4,125,["وَمَنۡ","أَحۡسَنُ","دِينٗا","مِّمَّنۡ","أَسۡلَمَ","وَجۡهَهُۥ","لِلَّهِ","وَهُوَ","مُحۡسِنٞ","وَٱتَّبَعَ","مِلَّةَ","إِبۡرَٰهِيمَ","حَنِيفٗاۗ","وَٱتَّخَذَ","ٱللَّهُ","إِبۡرَٰهِيمَ","خَلِيلٗا"],"ваман ахсану диинам мимман аслама важхахуу лиллахи вахуа мухсинун ваттаба`а миллата ибрахиима ханиифан ваттахазаллаху ибрахиима халиила","Чья религия может быть прекраснее религии того, кто покорил свой лик Аллаху, творя добро, и последовал за верой Ибрахима (Авраама), ханифа? Ведь Аллах сделал Ибрахима (Авраама) Своим возлюбленным.",["и кто","лучше","религией","чем тот, кто","покорил","лик свой","Аллаху","и он","творящий добро","и последовал","религии","Ибрахима","ханифа (единобожника)","и взял","Аллах","Ибрахима","возлюбленным другом"]],[4,126,["وَلِلَّهِ","مَا","فِي","ٱلسَّمَٰوَٰتِ","وَمَا","فِي","ٱلۡأَرۡضِۚ","وَكَانَ","ٱللَّهُ","بِكُلِّ","شَيۡءٖ","مُّحِيطٗا"],"валиллахи ма фис самавати вама фил арди ваканаллаху бикулли шай'им мухиита","Аллаху принадлежит то, что на небесах, и то, что на земле. Аллах объемлет всякую вещь.",["и Аллаху (принадлежит)","то, что","на","небесах","и то, что","на","земле","и есть","Аллах","всякую","вещь","Объемлющий"]],[4,127,["وَيَسۡتَفۡتُونَكَ","فِي","ٱلنِّسَآءِۖ","قُلِ","ٱللَّهُ","يُفۡتِيكُمۡ","فِيهِنَّ","وَمَا","يُتۡلَىٰ","عَلَيۡكُمۡ","فِي","ٱلۡكِتَٰبِ","فِي","يَتَٰمَى","ٱلنِّسَآءِ","ٱلَّٰتِي","لَا","تُؤۡتُونَهُنَّ","مَا","كُتِبَ","لَهُنَّ","وَتَرۡغَبُونَ","أَن","تَنكِحُوهُنَّ","وَٱلۡمُسۡتَضۡعَفِينَ","مِنَ","ٱلۡوِلۡدَٰنِ","وَأَن","تَقُومُواْ","لِلۡيَتَٰمَىٰ","بِٱلۡقِسۡطِۚ","وَمَا","تَفۡعَلُواْ","مِنۡ","خَيۡرٖ","فَإِنَّ","ٱللَّهَ","كَانَ","بِهِۦ","عَلِيمٗا"],"вайастафтуунака фин нисаи ḳулиллаху йуфтиикум фиихинна вама йутла `алайкум фил китаби фии йатаман нисаил латии ла ту'туунахунна ма кутиба лахунна ватаргабууна ан танкихуухунна валмустад`афиина минал вилдани ва'ан таḳуумуу лилйатама билḳисти вама таф`алуу мин хайрин фа'инналлаха кана бихии `алиима","Они просят тебя вынести решение относительно женщин. Скажи: «Аллах вынесет для вас решение относительно них и того, что читается вам в Писании по поводу осиротевших женщин, которым вы не даете того, что им предписано, размышляя о женитьбе на них, и по поводу слабых детей. А еще вы должны относиться к сиротам справедливо, и что бы вы ни сделали доброго, Аллаху известно об этом».",["и просят у тебя решения","о","женщинах","скажи","Аллах","выносит вам решение","о них","и то, что","читается","вам","в","Писании","о","сиротах","(из) женщин","которым","не","даёте вы им","то, что","предписано","им","и желаете вы","чтобы","жениться на них","и (о) слабых","из","детей","и чтобы","стояли вы","за сирот","по справедливости","и что бы ни","сделали вы","из","добра","то поистине","Аллах","есть","о нём","Знающий"]]],"m":[[["وَٱلَّذِينَ","а те, которые",4,122],["ءَامَنُواْ","уверовали",4,122],["وَعَمِلُواْ","и совершали",4,122],["ٱلصَّٰلِحَٰتِ","праведные дела",4,122],["سَنُدۡخِلُهُمۡ","Мы введём их",4,122]],[["جَنَّٰتٖ","(в) сады",4,122],["تَجۡرِي","текут",4,122],["مِن","от",4,122],["تَحۡتِهَا","под ними",4,122],["ٱلۡأَنۡهَٰرُ","реки",4,122],["خَٰلِدِينَ","вечно пребывающими",4,122],["فِيهَآ","в них",4,122],["أَبَدٗاۖ","навеки",4,122],["وَعۡدَ","обещание",4,122]],[["ٱللَّهِ","Аллаха",4,122],["حَقّٗاۚ","истинное",4,122],["وَمَنۡ","и кто",4,122],["أَصۡدَقُ","правдивее",4,122],["مِنَ","чем",4,122],["ٱللَّهِ","Аллах",4,122],["قِيلٗا","словом",4,122],[122],["لَّيۡسَ","не",4,123],["بِأَمَانِيِّكُمۡ","по мечтам вашим",4,123]],[["وَلَآ","и не",4,123],["أَمَانِيِّ","(по) мечтам",4,123],["أَهۡلِ","людей",4,123],["ٱلۡكِتَٰبِۗ","Писания",4,123],["مَن","кто",4,123],["يَعۡمَلۡ","совершит",4,123],["سُوٓءٗا","зло",4,123],["يُجۡزَ","получит воздаяние",4,123],["بِهِۦ","за него",4,123]],[["وَلَا","и не",4,123],["يَجِدۡ","найдёт",4,123],["لَهُۥ","для себя",4,123],["