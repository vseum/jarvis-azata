{"p":99,"j":5,"a":[[4,128,["وَإِنِ","ٱمۡرَأَةٌ","خَافَتۡ","مِنۢ","بَعۡلِهَا","نُشُوزًا","أَوۡ","إِعۡرَاضٗا","فَلَا","جُنَاحَ","عَلَيۡهِمَآ","أَن","يُصۡلِحَا","بَيۡنَهُمَا","صُلۡحٗاۚ","وَٱلصُّلۡحُ","خَيۡرٞۗ","وَأُحۡضِرَتِ","ٱلۡأَنفُسُ","ٱلشُّحَّۚ","وَإِن","تُحۡسِنُواْ","وَتَتَّقُواْ","فَإِنَّ","ٱللَّهَ","كَانَ","بِمَا","تَعۡمَلُونَ","خَبِيرٗا"],"ва'инимраатун хафат мим ба`лиха нушуузан ау и`радан фала жунаха `алайхима ан йуслиха байнахума сулхан вассулху хайрун ва'ухдиратил анфусуш шухха ва'ин тухсинуу вататтаḳуу фа'инналлаха кана бима та`малууна хабиира","Если женщина опасается, что муж будет проявлять к ней неприязнь или отворачиваться от нее, то на них обоих не будет греха, если они заключат между собой мир, ибо мирное решение - лучше. Душам свойственна скупость, но если вы будете добродетельны и богобоязненны, то ведь Аллах ведает о том, что вы совершаете.",["и если","женщина","боится","от","мужа своего","неприязни","или","отворачивания","то нет","греха","на них обоих","что","примирятся они оба","между собой","примирением","а мир","лучше","и подвержены","души","скупости","и если","будете творить добро","и бояться (Аллаха)","то поистине","Аллах","есть","о том, что","делаете вы","Сведущий"]],[4,129,["وَلَن","تَسۡتَطِيعُوٓاْ","أَن","تَعۡدِلُواْ","بَيۡنَ","ٱلنِّسَآءِ","وَلَوۡ","حَرَصۡتُمۡۖ","فَلَا","تَمِيلُواْ","كُلَّ","ٱلۡمَيۡلِ","فَتَذَرُوهَا","كَٱلۡمُعَلَّقَةِۚ","وَإِن","تُصۡلِحُواْ","وَتَتَّقُواْ","فَإِنَّ","ٱللَّهَ","كَانَ","غَفُورٗا","رَّحِيمٗا"],"валан тастатии`уу ан та`дилуу байнан нисаи валау харастум фала тамиилуу куллал майли фатазарууха калму`аллаḳати ва'ин туслихуу вататтаḳуу фа'инналлаха кана гафуурар рахиима","Вы не сможете относиться к женам одинаково справедливо даже при сильном желании. Не наклоняйтесь же полностью к одной, оставляя другую словно висящей (не уделяйте все внимание только одной жене, оставляя другую в таком положении, когда она, выйдя замуж, чувствует себя незамужней). Но если вы исправите положение и будете богобоязненны, то ведь Аллах - Прощающий, Милосердный.",["и никогда не","сможете вы","чтобы","быть справедливыми","между","жёнами","даже если","стремились бы вы","так не","склоняйтесь","всей","склонностью","оставляя её","как подвешенную","и если","исправите вы","и будете бояться (Аллаха)","то поистине","Аллах","есть","Прощающий","Милосердный"]],[4,130,["وَإِن","يَتَفَرَّقَا","يُغۡنِ","ٱللَّهُ","كُلّٗا","مِّن","سَعَتِهِۦۚ","وَكَانَ","ٱللَّهُ","وَٰسِعًا","حَكِيمٗا"],"ва'ин йатафарраḳа йугниллаху куллам мин са`атихии ваканаллаху васи`ан хакиима","Если они расстанутся, то Аллах обогатит каждого из них из Своей милости. Аллах - Объемлющий, Мудрый.",["и если","разойдутся они оба","обогатит","Аллах","каждого","из","обилия Своего","и есть","Аллах","Объемлющий","Мудрый"]],[4,131,["وَلِلَّهِ","مَا","فِي","ٱلسَّمَٰوَٰتِ","وَمَا","فِي","ٱلۡأَرۡضِۗ","وَلَقَدۡ","وَصَّيۡنَا","ٱلَّذِينَ","أُوتُواْ","ٱلۡكِتَٰبَ","مِن","قَبۡلِكُمۡ","وَإِيَّاكُمۡ","أَنِ","ٱتَّقُواْ","ٱللَّهَۚ","وَإِن","تَكۡفُرُواْ","فَإِنَّ","لِلَّهِ","مَا","فِي","ٱلسَّمَٰوَٰتِ","وَمَا","فِي","ٱلۡأَرۡضِۚ","وَكَانَ","ٱللَّهُ","غَنِيًّا","حَمِيدٗا"],"валиллахи ма фис самавати вама фил арди валаḳад вассайнал лазиина уутул китаба мин ḳабликум ва'иййакум аниттаḳуллаха ва'ин такфуруу фа'инна лиллахи ма фис самавати вама фил арди ваканаллаху ганиййан хамиида","Аллаху принадлежит то, что на небесах, и то, что на земле. Мы заповедали тем, кому было даровано Писание до вас, а также вам, чтобы вы боялись Аллаха. Если вы не уверуете, то ведь Аллаху принадлежит то, что на небесах, и то, что на земле. Аллах - Богатый, Достохвальный.",["и Аллаху (принадлежит)","то, что","на","небесах","и то, что","на","земле","и уже","заповедали Мы","тем, которым","было дано","Писание","из","прежде вас","и вам","чтобы","бойтесь","Аллаха","и если","не уверуете","то поистине","Аллаху (принадлежит)","то, что","на","небесах","и то, что","на","земле","и есть","Аллах","Богатый","Достохвальный"]],[4,132,["وَلِلَّهِ","مَا","فِي","ٱلسَّمَٰوَٰتِ","وَمَا","فِي","ٱلۡأَرۡضِۚ","وَكَفَىٰ","بِٱللَّهِ","وَكِيلًا"],"валиллахи ма фис самавати вама фил арди вакафа биллахи вакиила","Аллаху принадлежит то, что на небесах, и то, что на земле. Довольно того, что Аллах является Попечителем и Хранителем!",["и Аллаху (принадлежит)","то, что","на","небесах","и то, что","на","земле","и достаточно","Аллаха","Попечителем"]],[4,133,["إِن","يَشَأۡ","يُذۡهِبۡكُمۡ","أَيُّهَا","ٱلنَّاسُ","وَيَأۡتِ","بِـَٔاخَرِينَۚ","وَكَانَ","ٱللَّهُ","عَلَىٰ","ذَٰلِكَ","قَدِيرٗا"],"ин йаша' йузхибкум аййухан насу вайа'ти би'ахариина ваканаллаху `ала залика ḳадиира","О люди! Если Он пожелает, то уведет вас и приведет других. Аллах способен на это.",["если","пожелает Он","уведёт Он вас","о","люди","и приведёт","других","и есть","Аллах","на","это","Способный"]],[4,134,["مَّن","كَانَ","يُرِيدُ","ثَوَابَ","ٱلدُّنۡيَا","فَعِندَ","ٱللَّهِ","ثَوَابُ","ٱلدُّنۡيَا","وَٱلۡأٓخِرَةِۚ","وَكَانَ","ٱللَّهُ","سَمِيعَۢا","بَصِيرٗا"],"мман кана йурииду савабад дунйа фа`индаллахи савабуд дунйа вал'ахирати ваканаллаху самии`а басиира","Если кто желает вознаграждения в этом мире, то ведь у Аллаха есть награда как в этом мире, так и в Последней жизни. Аллах - Слышащий, Видящий.",["кто","будет","желать","награды","ближнего мира","то у","Аллаха","награда","ближнего мира","и Последней жизни","и есть","Аллах","Слышащий","Видящий"]]],"m":[[["وَإِنِ","и если",4,128],["ٱمۡرَأَةٌ","женщина",4,128],["خَافَتۡ","боится",4,128],["مِنۢ","от",4,128],["بَعۡلِهَا","мужа своего",4,128],["نُشُوزًا","неприязни",4,128],["أَوۡ","или",4,128],["إِعۡرَاضٗا","отворачивания",4,128],["فَلَا","то нет",4,128],["جُنَاحَ","греха",4,128]],[["عَلَيۡهِمَآ","на них обоих",4,128],["أَن","что",4,128],["يُصۡلِحَا","примирятся они оба",4,128],["بَيۡنَهُمَا","между собой",4,128],["صُلۡحٗاۚ","примирением",4,128],["وَٱلصُّلۡحُ","а мир",4,128],["خَيۡرٞۗ","лучше",4,128],["وَأُحۡضِرَتِ","и подвержены",4,128]],[["ٱلۡأَنفُسُ","души",4,128],["ٱلشُّحَّۚ","скупости",4,128],["وَإِن","и если",4,128],["تُحۡسِنُواْ","будете творить добро",4,128],["وَتَتَّقُواْ","и бояться (Аллаха)",4,128],["فَإِنَّ","то поистине",4,128],["ٱللَّهَ","Аллах",4,128],["كَانَ","есть",4,128]],[["بِمَا","о том, что",4,128],["تَعۡمَلُونَ","делаете вы",4,128],["خَبِيرٗا","Сведущий",4,128],[128],["وَلَن","и никогда не",4,129],["تَسۡتَطِيعُوٓاْ","сможете вы",4,129],["أَن","чтобы",4,129],["تَعۡدِلُواْ","быть справедливыми",4,129]],[["بَيۡنَ","между",4,129],["ٱلنِّسَآءِ","жёнами",4,129],["وَلَوۡ","даже если",4,129],["حَرَصۡتُمۡۖ","стремились бы вы",4,129],["فَلَا","так не",4,129],["تَمِيلُواْ","склоняйтесь",4,129],["كُلَّ","всей",4,129],["ٱلۡمَيۡلِ","склонностью",4,129]],[["فَتَذَرُوهَا","оставляя её",4,129],["كَٱلۡمُعَلَّقَةِۚ","как подвешенную",4,129],["وَإِن","и если",4,129],["تُصۡلِحُواْ","исправите вы",4,129],["وَتَتَّقُواْ","и будете бояться (Аллаха)",4,129],["فَإِنَّ","то поистине",4,129],["ٱللَّهَ","Аллах",4,129]],[["كَانَ","есть",4,129],["غَفُورٗا","Прощающий",4,129],["رَّحِيمٗا","Милосердный",4,129],[129],["وَإِن","и если",4,130],["يَتَفَرَّقَا","разойдутся они оба",4,130],["يُغۡنِ","обогатит",4,130],["ٱللَّهُ","Аллах",4,130],["كُلّٗا","каждого",4,130]],[["مِّن","из",4,130],["سَعَتِهِۦۚ","обилия Своего",4,130],["وَكَانَ","и есть",4,130],["ٱللَّهُ","Аллах",4,130],["وَٰسِعًا","Объемлющий",4,130],["حَكِيمٗا","Мудрый",4,130],[130],["وَلِلَّهِ","и Аллаху (принадлежит)",4,131],["مَا","то, что",4,131],["فِي","на",4,131]],[["ٱلسَّمَٰوَٰتِ","небесах",4,131],["وَمَا","и то, что",4,131],["فِي","на",4,131],["ٱلۡأَرۡضِۗ","земле",4,131],["وَلَقَدۡ","и уже",4,131],["وَصَّيۡنَا","заповедали Мы",4,131],["ٱلَّذِينَ","тем, которым",4,131],["أُوتُواْ","было дано",4,131],["ٱلۡكِتَٰبَ","Писание",4,131]],[["مِن","из",4,131],["قَبۡلِكُمۡ","прежде вас",4,131],["وَإِيَّاكُمۡ","и вам",4,131],["أَنِ","чтобы",4,131],["ٱتَّقُواْ","бойтесь",4,131],["ٱللَّهَۚ","Аллаха",4,131],["وَإِن","и если",4,131],["تَكۡفُرُواْ","не уверуете",4,131],["فَإِنَّ","то поистине",4,131],["لِلَّهِ","Аллаху (принадлежит)",4,131]],[["مَا","то, что",4,131],["فِي","на",4,131],["ٱلسَّمَٰوَٰتِ","небесах",4,131],["وَمَا","и то, что",4,131],["فِي","на",4,131],["ٱلۡأَرۡضِۚ","земле",4,131],["وَكَانَ","и есть",4,131],["ٱللَّهُ","Аллах",4,131],["غَنِيًّا","Богатый",4,131],["حَمِيدٗا","Достохвальный",4,131],[131]],[["وَلِلَّهِ","и Аллаху (принадлежит)",4,132],["مَا","то, что",4,132],["فِي","на",4,132],["ٱلسَّمَٰوَٰتِ","небесах",4,132],["وَمَا","и то, что",4,132],["فِي","на",4,132],["ٱلۡأَرۡضِۚ","земле",4,132],["وَكَفَىٰ","и достаточно",4,132],["بِٱللَّهِ","Аллаха",4,132],["وَكِيلًا","Попечителем",4,132],[132]],[["إِن","если",4,133],["يَشَأۡ","пожелает Он",4,133],["يُذۡهِبۡكُمۡ","уведёт Он вас",4,133],["أَيُّهَا","о",4,133],["ٱلنَّاسُ","люди",4,133],["وَيَأۡتِ","и приведёт",4,133],["بِـَٔاخَرِينَۚ","других",4,133],["وَكَانَ","и есть",4,133]],[["ٱللَّهُ","Аллах",4,133],["عَلَىٰ","на",4,133],["ذَٰلِكَ","это",4,133],["قَدِيرٗا","Способный",4,133],[133],["مَّن","кто",4,134],["كَانَ","будет",4,134],["يُرِيدُ","желать",4,134],["ثَوَابَ","награды",4,134],["ٱلدُّنۡيَا","ближнего мира",4,134],["فَعِندَ","то у",4,134]],[["ٱللَّهِ","Аллаха",4,134],["ثَوَابُ","награда",4,134],["ٱلدُّنۡيَا","ближнего мира",4,134],["وَٱلۡأٓخِرَةِۚ","и Последней жизни",4,134],["وَكَانَ","и есть",4,134],["ٱللَّهُ","Аллах",4,134],["سَمِيعَۢا","Слышащий",4,134],["بَصِيرٗا","Видящий",4,134],[134]]]}