{"p":101,"j":5,"a":[[4,141,["ٱلَّذِينَ","يَتَرَبَّصُونَ","بِكُمۡ","فَإِن","كَانَ","لَكُمۡ","فَتۡحٞ","مِّنَ","ٱللَّهِ","قَالُوٓاْ","أَلَمۡ","نَكُن","مَّعَكُمۡ","وَإِن","كَانَ","لِلۡكَٰفِرِينَ","نَصِيبٞ","قَالُوٓاْ","أَلَمۡ","نَسۡتَحۡوِذۡ","عَلَيۡكُمۡ","وَنَمۡنَعۡكُم","مِّنَ","ٱلۡمُؤۡمِنِينَۚ","فَٱللَّهُ","يَحۡكُمُ","بَيۡنَكُمۡ","يَوۡمَ","ٱلۡقِيَٰمَةِۚ","وَلَن","يَجۡعَلَ","ٱللَّهُ","لِلۡكَٰفِرِينَ","عَلَى","ٱلۡمُؤۡمِنِينَ","سَبِيلًا"],"аллазиина йатараббасууна бикум фа'ин кана лакум фатхум миналлахи ḳалуу алам накум ма`акум ва'ин кана лилкафириина насиибун ḳалуу алам настахвиз `алайкум ванамна`кум минал му'миниина фаллаху йахкуму байнакум йаумал ḳийамати валан йаж`алаллаху лилкафириина `алал му'миниина сабиила","Они ждут, когда вас постигнет беда. Если Аллах одаряет вас победой, они говорят: «Разве мы не были с вами?». Если же доля достается неверующим, они говорят: «Разве мы не покровительствовали вам (или не помогали вам) и не защитили вас от верующих?». Аллах рассудит между вами в День воскресения. Аллах не откроет неверующим пути против верующих.",["те, которые","выжидают","(беды) для вас","и если","была","вам","победа","от","Аллаха","они говорят","разве не","были мы","с вами","а если","была","неверующим","доля","они говорят","разве не","одолели мы","вас","и (не) защитили вас","от","верующих","и Аллах","рассудит","между вами","в День","воскресения","и никогда не","сделает","Аллах","неверующим","против","верующих","пути"]],[4,142,["إِنَّ","ٱلۡمُنَٰفِقِينَ","يُخَٰدِعُونَ","ٱللَّهَ","وَهُوَ","خَٰدِعُهُمۡ","وَإِذَا","قَامُوٓاْ","إِلَى","ٱلصَّلَوٰةِ","قَامُواْ","كُسَالَىٰ","يُرَآءُونَ","ٱلنَّاسَ","وَلَا","يَذۡكُرُونَ","ٱللَّهَ","إِلَّا","قَلِيلٗا"],"иннал мунафиḳиина йухади`ууналлаха вахуа хади`ухум ва'иза ḳамуу илас салавати ḳамуу кусала йурауунан наса вала йазкурууналлаха илла ḳалиила","Воистину, лицемеры пытаются обмануть Аллаха, но это Он обманывает их. Когда они встают на намаз, то встают неохотно, показывая себя перед людьми и поминая Аллаха лишь немного.",["поистине","лицемеры","обманывают","Аллаха","а Он","обманывает их","и когда","встают они","на","намаз","встают они","ленивыми","показываясь","людям","и не","поминают","Аллаха","кроме","немного"]],[4,143,["مُّذَبۡذَبِينَ","بَيۡنَ","ذَٰلِكَ","لَآ","إِلَىٰ","هَٰٓؤُلَآءِ","وَلَآ","إِلَىٰ","هَٰٓؤُلَآءِۚ","وَمَن","يُضۡلِلِ","ٱللَّهُ","فَلَن","تَجِدَ","لَهُۥ","سَبِيلٗا"],"ммузабзабиина байна залика ла ила ха'улаи вала ила ха'улаи ваман йудлилиллаху фалан тажида лахуу сабиила","Они колеблются между этим (верой и неверием), но не принадлежат ни к тем, ни к другим. Для того, кого Аллах вводит в заблуждение, ты уже не найдешь дороги.",["колеблющиеся","между","этим","не","к","этим","и не","к","тем","и кого","введёт в заблуждение","Аллах","то никогда не","найдёшь","для него","пути"]],[4,144,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُواْ","لَا","تَتَّخِذُواْ","ٱلۡكَٰفِرِينَ","أَوۡلِيَآءَ","مِن","دُونِ","ٱلۡمُؤۡمِنِينَۚ","أَتُرِيدُونَ","أَن","تَجۡعَلُواْ","لِلَّهِ","عَلَيۡكُمۡ","سُلۡطَٰنٗا","مُّبِينًا"],"йа'аййухал лазиина амануу ла таттахизул кафириина аулийаа мин дуунил му'миниина атуриидууна ан таж`алуу лиллахи `алайкум султанам мубиина","О те, которые уверовали! Не берите неверующих себе в помощники и друзья вместо верующих. Неужели вы хотите предоставить Аллаху очевидный довод против вас самих?",["О вы","которые","уверовали","не","берите","неверующих","покровителями","из","вместо","верующих","разве хотите вы","чтобы","предоставить","Аллаху","против вас","довод","явный"]],[4,145,["إِنَّ","ٱلۡمُنَٰفِقِينَ","فِي","ٱلدَّرۡكِ","ٱلۡأَسۡفَلِ","مِنَ","ٱلنَّارِ","وَلَن","تَجِدَ","لَهُمۡ","نَصِيرًا"],"иннал мунафиḳиина фид даркил асфали минан нари валан тажида лахум насиира","Воистину, лицемеры окажутся на нижайшей ступени Огня, и ты не найдешь для них помощника,",["поистине","лицемеры","в","ступени","нижайшей","из","Огня","и никогда не","найдёшь","для них","помощника"]],[4,146,["إِلَّا","ٱلَّذِينَ","تَابُواْ","وَأَصۡلَحُواْ","وَٱعۡتَصَمُواْ","بِٱللَّهِ","وَأَخۡلَصُواْ","دِينَهُمۡ","لِلَّهِ","فَأُوْلَٰٓئِكَ","مَعَ","ٱلۡمُؤۡمِنِينَۖ","وَسَوۡفَ","يُؤۡتِ","ٱللَّهُ","ٱلۡمُؤۡمِنِينَ","أَجۡرًا","عَظِيمٗا"],"иллал лазиина табуу ва'аслахуу ва`тасамуу биллахи ва'ахласуу диинахум лиллахи фа'улаика ма`ал му'миниина васауфа йу'тиллахул му'миниина ажран `азиима","если только они не раскаются и исправят содеянное, крепко ухватятся за Аллаха и очистят свою веру перед Ним. Такие окажутся вместе с верующими, а ведь Аллах одарит верующих великой наградой.",["кроме","тех, которые","покаялись","и исправились","и крепко держались","за Аллаха","и очистили","свою религию","ради Аллаха","то эти","с","верующими","и вскоре","дарует","Аллах","верующим","награду","великую"]],[4,147,["مَّا","يَفۡعَلُ","ٱللَّهُ","بِعَذَابِكُمۡ","إِن","شَكَرۡتُمۡ","وَءَامَنتُمۡۚ","وَكَانَ","ٱللَّهُ","شَاكِرًا","عَلِيمٗا"],"мма йаф`алуллаху би`азабикум ин шакартум ва'амантум ваканаллаху шакиран `алиима","Зачем Аллаху подвергать вас мучениям, если вы будете благодарны и уверуете? Аллах - Признательный, Знающий.",["что","сделает","Аллах","наказанием вас","если","будете благодарны","и уверуете","и был","Аллах","Признательным","Знающим"]]],"m":[[["ٱلَّذِينَ","те, которые",4,141],["يَتَرَبَّصُونَ","выжидают",4,141],["بِكُمۡ","(беды) для вас",4,141],["فَإِن","и если",4,141],["كَانَ","была",4,141],["لَكُمۡ","вам",4,141],["فَتۡحٞ","победа",4,141],["مِّنَ","от",4,141],["ٱللَّهِ","Аллаха",4,141],["قَالُوٓاْ","они говорят",4,141],["أَلَمۡ","разве не",4,141]],[["نَكُن","были мы",4,141],["مَّعَكُمۡ","с вами",4,141],["وَإِن","а если",4,141],["كَانَ","была",4,141],["لِلۡكَٰفِرِينَ","неверующим",4,141],["نَصِيبٞ","доля",4,141],["قَالُوٓاْ","они говорят",4,141],["أَلَمۡ","разве не",4,141],["نَسۡتَحۡوِذۡ","одолели мы",4,141]],[["عَلَيۡكُمۡ","вас",4,141],["وَنَمۡنَعۡكُم","и (не) защитили вас",4,141],["مِّنَ","от",4,141],["ٱلۡمُؤۡمِنِينَۚ","верующих",4,141],["فَٱللَّهُ","и Аллах",4,141],["يَحۡكُمُ","рассудит",4,141],["بَيۡنَكُمۡ","между вами",4,141],["يَوۡمَ","в День",4,141]],[["ٱلۡقِيَٰمَةِۚ","воскресения",4,141],["وَل