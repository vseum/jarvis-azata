{"p":102,"j":6,"a":[[4,148,["لَّا","يُحِبُّ","ٱللَّهُ","ٱلۡجَهۡرَ","بِٱلسُّوٓءِ","مِنَ","ٱلۡقَوۡلِ","إِلَّا","مَن","ظُلِمَۚ","وَكَانَ","ٱللَّهُ","سَمِيعًا","عَلِيمًا"],"лла йухиббуллахул жахра биссууи минал ḳаули илла ман зулима ваканаллаху самии`ан `алиима","Аллах не любит, когда злословят вслух, если только этого не делает тот, с кем поступили несправедливо. Аллах - Слышащий, Знающий.",["не","любит","Аллах","оглашения","дурного","из","слов","кроме","того, кто","был обижен","и был","Аллах","Слышащим","Знающим"]],[4,149,["إِن","تُبۡدُواْ","خَيۡرًا","أَوۡ","تُخۡفُوهُ","أَوۡ","تَعۡفُواْ","عَن","سُوٓءٖ","فَإِنَّ","ٱللَّهَ","كَانَ","عَفُوّٗا","قَدِيرًا"],"ин тубдуу хайран ау тухфууху ау та`фуу `ан сууин фа'инналлаха кана `афувван ḳадиира","Если вы обнаружите добро, скроете его или простите злодеяние, то ведь Аллах - Снисходительный, Всемогущий.",["если","проявите","добро","или","скроете его","или","простите","за","зло","то поистине","Аллах","был","Снисходительным","Всемогущим"]],[4,150,["إِنَّ","ٱلَّذِينَ","يَكۡفُرُونَ","بِٱللَّهِ","وَرُسُلِهِۦ","وَيُرِيدُونَ","أَن","يُفَرِّقُواْ","بَيۡنَ","ٱللَّهِ","وَرُسُلِهِۦ","وَيَقُولُونَ","نُؤۡمِنُ","بِبَعۡضٖ","وَنَكۡفُرُ","بِبَعۡضٖ","وَيُرِيدُونَ","أَن","يَتَّخِذُواْ","بَيۡنَ","ذَٰلِكَ","سَبِيلًا"],"иннал лазиина йакфурууна биллахи варусулихии вайуриидууна ан йуфарриḳуу байналлахи варусулихии вайаḳуулууна ну'мину биба`дин ванакфуру биба`дин вайуриидууна ан йаттахизуу байна залика сабиила","Воистину, те, которые не веруют в Аллаха и Его посланников, хотят различать между Аллахом и Его посланниками и говорят: «Мы веруем в одних и не веруем в других», - и хотят найти путь между этим,",["поистине","те, которые","не веруют","в Аллаха","и Его посланников","и хотят","чтобы","различать","между","Аллахом","и Его посланниками","и говорят","веруем","в одних","и не веруем","в других","и хотят","чтобы","избрать","между","этим","путь"]],[4,151,["أُوْلَٰٓئِكَ","هُمُ","ٱلۡكَٰفِرُونَ","حَقّٗاۚ","وَأَعۡتَدۡنَا","لِلۡكَٰفِرِينَ","عَذَابٗا","مُّهِينٗا"],"улаика хумул кафирууна хаḳḳан ва'а`тадна лилкафириина `азабам мухиина","являются подлинными неверующими. Мы приготовили для неверующих унизительные мучения.",["те","они","неверующие","подлинно","и Мы приготовили","для неверующих","наказание","унизительное"]],[4,152,["وَٱلَّذِينَ","ءَامَنُواْ","بِٱللَّهِ","وَرُسُلِهِۦ","وَلَمۡ","يُفَرِّقُواْ","بَيۡنَ","أَحَدٖ","مِّنۡهُمۡ","أُوْلَٰٓئِكَ","سَوۡفَ","يُؤۡتِيهِمۡ","أُجُورَهُمۡۚ","وَكَانَ","ٱللَّهُ","غَفُورٗا","رَّحِيمٗا"],"валлазиина амануу биллахи варусулихии валам йуфарриḳуу байна ахадим минхум улаика сауфа йу'тиихим ужуурахум ваканаллаху гафуурар рахиима","А тех, которые уверовали в Аллаха и Его посланников и не делают различий между любым из них, Он одарит их наградой. Аллах - Прощающий, Милосердный.",["а те, которые","уверовали","в Аллаха","и Его посланников","и не","различали","между","одним","из них","тем","вскоре","Он дарует им","их награды","и был","Аллах","Прощающим","Милосердным"]],[4,153,["يَسۡـَٔلُكَ","أَهۡلُ","ٱلۡكِتَٰبِ","أَن","تُنَزِّلَ","عَلَيۡهِمۡ","كِتَٰبٗا","مِّنَ","ٱلسَّمَآءِۚ","فَقَدۡ","سَأَلُواْ","مُوسَىٰٓ","أَكۡبَرَ","مِن","ذَٰلِكَ","فَقَالُوٓاْ","أَرِنَا","ٱللَّهَ","جَهۡرَةٗ","فَأَخَذَتۡهُمُ","ٱلصَّٰعِقَةُ","بِظُلۡمِهِمۡۚ","ثُمَّ","ٱتَّخَذُواْ","ٱلۡعِجۡلَ","مِنۢ","بَعۡدِ","مَا","جَآءَتۡهُمُ","ٱلۡبَيِّنَٰتُ","فَعَفَوۡنَا","عَن","ذَٰلِكَۚ","وَءَاتَيۡنَا","مُوسَىٰ","سُلۡطَٰنٗا","مُّبِينٗا"],"йас'алука ахлул китаби ан туназзила `алайхим китабам минас самаи фаḳад са'алуу мууса акбара мин залика фаḳалуу ариналлаха жахратан фа'ахазатхумус са`иḳату бизулмихим сумматтахазул `ижла мим ба`ди ма жаатхумул баййинату фа`афауна `ан залика ва'атайна мууса султанам мубиина","Люди Писания просят тебя, чтобы ты низвел им писание с неба. Мусу (Моисея) они попросили о еще большем, когда сказали: «Покажи нам Аллаха открыто». Тогда молния поразила (или гибель постигла) их за их несправедливость. А затем они стали поклоняться тельцу после того, как к ним явились ясные знамения, но Мы простили это и даровали Мусе (Моисею) явное доказательство.",["просят тебя","люди","Писания","чтобы","ты низвёл","им","книгу","с","неба","и уже","просили они","Мусу","о большем","чем","это","и сказали они","покажи нам","Аллаха","открыто","и поразила их","молния","за их несправедливость","затем","избрали они","тельца","из","после","того как","пришли к ним","ясные знамения","и Мы простили","за","это","и Мы даровали","Мусе","доказательство","явное"]],[4,154,["وَرَفَعۡنَا","فَوۡقَهُمُ","ٱلطُّورَ","بِمِيثَٰقِهِمۡ","وَقُلۡنَا","لَهُمُ","ٱدۡخُلُواْ","ٱلۡبَابَ","سُجَّدٗا","وَقُلۡنَا","لَهُمۡ","لَا","تَعۡدُواْ","فِي","ٱلسَّبۡتِ","وَأَخَذۡنَا","مِنۡهُم","مِّيثَٰقًا","غَلِيظٗا"],"варафа`на фауḳахумут туура бимиисаḳихим ваḳулна лахумудхулул баба сужжадан ваḳулна лахум ла та`дуу фис сабти ва'ахазна минхум миисаḳан галииза","Мы воздвигли над ними гору, согласно завету с ними, и сказали им: «Войдите во врата, поклонившись!». Мы также сказали им: «Не нарушайте субботы!». Мы заключили с ними суровый завет.",["и Мы подняли","над ними","гору","по их завету","и Мы сказали","им","войдите","во врата","поклонившись","и Мы сказали","им","не","преступайте","в","субботу","и Мы взяли","с них","завет","суровый"]]],"m":[[["۞ لَّا","не",4,148],["يُحِبُّ","любит",4,148],["ٱللَّهُ","Аллах",4,148],["ٱلۡجَهۡرَ","оглашения",4,148],["بِٱلسُّوٓءِ","дурного",4,148],["مِنَ","из",4,148],["ٱلۡقَوۡلِ","слов",4,148],["إِلَّا","кроме",4,148],["مَن","того, кто",4,148],["ظُلِمَۚ","был обижен",4,148],["وَكَانَ","и был",4,148]],[["ٱللَّهُ","Аллах",4,148],["سَمِيعًا","Слышащим",4,148],["عَلِيمًا","Знающим",4,148],[148],["إِن","если",4,149],["تُبۡدُواْ","проявите",4,149],["خَيۡرًا","добро",4,149],["أَوۡ","или",4,149],["تُخۡفُوهُ","скроете его",4,149],["أَوۡ","или",4,149],["تَعۡفُواْ","простите",4,149],["عَن","за",4,149]],[["سُوٓءٖ","зло",4,149],["فَإِنَّ","то поистине",4,149],["ٱللَّهَ","Аллах",4,149],["كَانَ","был",4,149],["عَفُوّٗا","Снисходительным",4,149],["قَدِيرًا","Всемогущим",4,149],[149],["إِنَّ","поистине",4,150],["ٱلَّذِينَ","те, ко