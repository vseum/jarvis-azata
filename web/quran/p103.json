{"p":103,"j":6,"a":[[4,155,["فَبِمَا","نَقۡضِهِم","مِّيثَٰقَهُمۡ","وَكُفۡرِهِم","بِـَٔايَٰتِ","ٱللَّهِ","وَقَتۡلِهِمُ","ٱلۡأَنۢبِيَآءَ","بِغَيۡرِ","حَقّٖ","وَقَوۡلِهِمۡ","قُلُوبُنَا","غُلۡفُۢۚ","بَلۡ","طَبَعَ","ٱللَّهُ","عَلَيۡهَا","بِكُفۡرِهِمۡ","فَلَا","يُؤۡمِنُونَ","إِلَّا","قَلِيلٗا"],"фабима наḳдихим миисаḳахум вакуфрихим би'айатиллахи ваḳатлихимул амбийаа бигайри хаḳḳин ваḳаулихим ḳулуубуна гулфу бал таба`аллаху `алайха бикуфрихим фала йу'минууна илла ḳалиила","За то, что они нарушили свой завет, не уверовали в знамения Аллаха, несправедливо убивали пророков и говорили: «Наши сердца покрыты завесой (или переполнены знаниями)». О нет, это Аллах запечатал их сердца за их неверие, и поэтому их вера ничтожна (или лишь немногие из них являются верующими).",["так за","нарушение ими","их завета","и неверие их","в знамения","Аллаха","и убийство ими","пророков","без","права","и слова их","сердца наши","покрыты","нет же","запечатал","Аллах","их","за их неверие","и не","веруют они","кроме","немногих"]],[4,156,["وَبِكُفۡرِهِمۡ","وَقَوۡلِهِمۡ","عَلَىٰ","مَرۡيَمَ","بُهۡتَٰنًا","عَظِيمٗا"],"вабикуфрихим ваḳаулихим `ала марйама бухтанан `азиима","За то, что они не уверовали, возвели на Марьям (Марию) великий навет",["и за их неверие","и слова их","на","Марьям","клевету","великую"]],[4,157,["وَقَوۡلِهِمۡ","إِنَّا","قَتَلۡنَا","ٱلۡمَسِيحَ","عِيسَى","ٱبۡنَ","مَرۡيَمَ","رَسُولَ","ٱللَّهِ","وَمَا","قَتَلُوهُ","وَمَا","صَلَبُوهُ","وَلَٰكِن","شُبِّهَ","لَهُمۡۚ","وَإِنَّ","ٱلَّذِينَ","ٱخۡتَلَفُواْ","فِيهِ","لَفِي","شَكّٖ","مِّنۡهُۚ","مَا","لَهُم","بِهِۦ","مِنۡ","عِلۡمٍ","إِلَّا","ٱتِّبَاعَ","ٱلظَّنِّۚ","وَمَا","قَتَلُوهُ","يَقِينَۢا"],"ваḳаулихим инна ḳаталнал масииха `иисабна марйама расуулаллахи вама ḳаталууху вама салабууху валакин шуббиха лахум ва'иннал лазиинахталафуу фиихи лафии шакким минху ма лахум бихии мин `илмин иллаттиба`аз занни вама ḳаталууху йаḳиина","и сказали: «Воистину, мы убили Мессию Ису (Иисуса), сына Марьям (Марии), посланника Аллаха». Однако они не убили его и не распяли, а это только показалось им. Те, которые препираются по этому поводу, пребывают в сомнении и ничего не ведают об этом, а лишь следуют предположениям. Они действительно не убивали его (или не убивали его с уверенностью).",["и слова их","поистине мы","убили","Мессию","Ису","сына","Марьям","посланника","Аллаха","и не","убили они его","и не","распяли его","но","это показалось","им","и поистине","те, которые","разошлись","о нём","непременно в","сомнении","о нём","нет","у них","о нём","никакого","знания","кроме","следования","предположению","и не","убили они его","достоверно"]],[4,158,["بَل","رَّفَعَهُ","ٱللَّهُ","إِلَيۡهِۚ","وَكَانَ","ٱللَّهُ","عَزِيزًا","حَكِيمٗا"],"бал ррафа`ахуллаху илайхи ваканаллаху `азиизан хакиима","О нет! Это Аллах вознес его к Себе, ведь Аллах - Могущественный, Мудрый.",["нет же","вознёс его","Аллах","к Себе","и был","Аллах","Могущественным","Мудрым"]],[4,159,["وَإِن","مِّنۡ","أَهۡلِ","ٱلۡكِتَٰبِ","إِلَّا","لَيُؤۡمِنَنَّ","بِهِۦ","قَبۡلَ","مَوۡتِهِۦۖ","وَيَوۡمَ","ٱلۡقِيَٰمَةِ","يَكُونُ","عَلَيۡهِمۡ","شَهِيدٗا"],"ва'им мин ахлил китаби илла лайу'минанна бихии ḳабла маутихии вайаумал ḳийамати йакууну `алайхим шахиида","Среди людей Писания не останется такого, который не уверует в него (Ису или Мухаммада) до его смерти (до смерти Иисуса или до своей смерти), а в День воскресения он будет свидетелем против них.",["и нет","из","людей","Писания","кроме (того, кто)","непременно уверует","в него","до","его смерти","и в День","воскресения","будет он","против них","свидетелем"]],[4,160,["فَبِظُلۡمٖ","مِّنَ","ٱلَّذِينَ","هَادُواْ","حَرَّمۡنَا","عَلَيۡهِمۡ","طَيِّبَٰتٍ","أُحِلَّتۡ","لَهُمۡ","وَبِصَدِّهِمۡ","عَن","سَبِيلِ","ٱللَّهِ","كَثِيرٗا"],"фабизулмим минал лазиина хадуу харрамна `алайхим таййибатин ухиллат лахум вабисаддихим `ан сабиилиллахи касиира","За то, что иудеи поступали несправедливо и многих сбивали (или часто сбивали людей) с пути Аллаха, Мы запретили им блага, которые были дозволены им.",["и за несправедливость","от","тех, которые","стали иудеями","Мы запретили","им","блага","которые были дозволены","им","и за их отвращение","от","пути","Аллаха","многих"]],[4,161,["وَأَخۡذِهِمُ","ٱلرِّبَوٰاْ","وَقَدۡ","نُهُواْ","عَنۡهُ","وَأَكۡلِهِمۡ","أَمۡوَٰلَ","ٱلنَّاسِ","بِٱلۡبَٰطِلِۚ","وَأَعۡتَدۡنَا","لِلۡكَٰفِرِينَ","مِنۡهُمۡ","عَذَابًا","أَلِيمٗا"],"ва'ахзихимур рибава ваḳад нухуу `анху ва'аклихим амвалан наси билбатили ва'а`тадна лилкафириина минхум `азабан алиима","А также за то, что они брали лихву, хотя она была запрещена им, и незаконно пожирали имущество людей. Для неверующих из них Мы приготовили мучительные страдания.",["и (за) взимание ими","лихвы","а ведь","было запрещено им","это","и пожирание ими","имущества","людей","незаконно","и Мы приготовили","для неверующих","из них","наказание","мучительное"]],[4,162,["لَّٰكِنِ","ٱلرَّٰسِخُونَ","فِي","ٱلۡعِلۡمِ","مِنۡهُمۡ","وَٱلۡمُؤۡمِنُونَ","يُؤۡمِنُونَ","بِمَآ","أُنزِلَ","إِلَيۡكَ","وَمَآ","أُنزِلَ","مِن","قَبۡلِكَۚ","وَٱلۡمُقِيمِينَ","ٱلصَّلَوٰةَۚ","وَٱلۡمُؤۡتُونَ","ٱلزَّكَوٰةَ","وَٱلۡمُؤۡمِنُونَ","بِٱللَّهِ","وَٱلۡيَوۡمِ","ٱلۡأٓخِرِ","أُوْلَٰٓئِكَ","سَنُؤۡتِيهِمۡ","أَجۡرًا","عَظِيمًا"],"ллакинир расихууна фил `илми минхум валму'минууна йу'минууна бима унзила илайка вама унзила мин ḳаблика валмуḳиимиинас салавата валму'тууназ закавата валму'минууна биллахи валйаумил ахири улаика сану'тиихим ажран `азиима","Однако тех из них, которые обладают основательными знаниями и веруют в то, что ниспослано тебе и что ниспослано до тебя, которые совершают намаз, выплачивают закят и веруют в Аллаха и Последний день, Мы одарим великим вознаграждением.",["но","основательные","в","знании","из них","и верующие","веруют","в то, что","ниспослано","тебе","и то, что","ниспослано","от","прежде тебя","и совершающие","намаз","и дающие","закят","и верующие","в Аллаха","и День","Последний","тем","Мы дадим им","награду","великую"]]],"m":[[["فَبِمَا","так за",4,155],["نَقۡضِهِم","нарушение ими",4,155],["مِّيثَٰقَهُمۡ","их завета",4,155],["وَكُفۡرِهِم","и неверие их",4,155