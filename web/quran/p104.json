{"p":104,"j":6,"a":[[4,163,["إِنَّآ","أَوۡحَيۡنَآ","إِلَيۡكَ","كَمَآ","أَوۡحَيۡنَآ","إِلَىٰ","نُوحٖ","وَٱلنَّبِيِّـۧنَ","مِنۢ","بَعۡدِهِۦۚ","وَأَوۡحَيۡنَآ","إِلَىٰٓ","إِبۡرَٰهِيمَ","وَإِسۡمَٰعِيلَ","وَإِسۡحَٰقَ","وَيَعۡقُوبَ","وَٱلۡأَسۡبَاطِ","وَعِيسَىٰ","وَأَيُّوبَ","وَيُونُسَ","وَهَٰرُونَ","وَسُلَيۡمَٰنَۚ","وَءَاتَيۡنَا","دَاوُۥدَ","زَبُورٗا"],"инна аухайна илайка кама аухайна ила нуухин ваннабиййиина мим ба`дихии ва'аухайна ила ибрахиима ва'исма`иила ва'исхаḳа вайа`ḳууба вал'асбати ва`ииса ва'аййууба вайуунуса вахарууна васулаймана ва'атайна давууда забуура","Воистину, Мы внушили тебе откровение, подобно тому, как внушили его Нуху (Ною) и пророкам после него. Мы внушили откровение Ибрахиму (Аврааму), Исмаилу (Измаилу), Исхаку (Исааку), Йакубу (Иакову) и коленам (двенадцати сыновьям Йакуба), Исе (Иисусу), Айюбу (Иову), Йунусу (Ионе), Харуну (Аарону), Сулейману (Соломону). Давуду (Давиду) же Мы даровали Забур (Псалтирь).",["поистине Мы","внушили откровение","тебе","как","Мы внушили","к","Нуху","и пророкам","из","после него","и Мы внушили","к","Ибрахиму","и Исмаилу","и Исхаку","и Якубу","и коленам","и Исе","и Айюбу","и Юнусу","и Харуну","и Сулейману","и Мы даровали","Давуду","Забур"]],[4,164,["وَرُسُلٗا","قَدۡ","قَصَصۡنَٰهُمۡ","عَلَيۡكَ","مِن","قَبۡلُ","وَرُسُلٗا","لَّمۡ","نَقۡصُصۡهُمۡ","عَلَيۡكَۚ","وَكَلَّمَ","ٱللَّهُ","مُوسَىٰ","تَكۡلِيمٗا"],"варусулан ḳад ḳасаснахум `алайка мин ḳаблу варусулал лам наḳсусхум `алайка вакалламаллаху мууса таклиима","Мы отправили посланников, о которых Мы уже рассказали тебе прежде, и посланников, о которых Мы тебе не рассказывали. А с Мусой (Моисеем) Аллах вел беседу.",["и посланников","уже","Мы рассказали о них","тебе","от","прежде","и посланников","не","рассказали Мы о них","тебе","и говорил","Аллах","с Мусой","беседой"]],[4,165,["رُّسُلٗا","مُّبَشِّرِينَ","وَمُنذِرِينَ","لِئَلَّا","يَكُونَ","لِلنَّاسِ","عَلَى","ٱللَّهِ","حُجَّةُۢ","بَعۡدَ","ٱلرُّسُلِۚ","وَكَانَ","ٱللَّهُ","عَزِيزًا","حَكِيمٗا"],"ррусулам мубашшириина вамунзириина ли'алла йакууна линнаси `алаллахи хужжату ба`дар русули ваканаллаху `азиизан хакиима","Мы отправили посланников, которые несли благую весть и предостерегали, дабы после пришествия посланников у людей не было никакого довода против Аллаха. Аллах - Могущественный, Мудрый.",["посланников","благовествующих","и предостерегающих","чтобы не","был","у людей","против","Аллаха","довод","после","посланников","и был","Аллах","Могущественным","Мудрым"]],[4,166,["لَّٰكِنِ","ٱللَّهُ","يَشۡهَدُ","بِمَآ","أَنزَلَ","إِلَيۡكَۖ","أَنزَلَهُۥ","بِعِلۡمِهِۦۖ","وَٱلۡمَلَٰٓئِكَةُ","يَشۡهَدُونَۚ","وَكَفَىٰ","بِٱللَّهِ","شَهِيدًا"],"ллакиниллаху йашхаду бима анзала илайка анзалахуу би`илмихии валмалаикату йашхадууна вакафа биллахи шахиида","Но Аллах сам свидетельствует о том, что Он ниспослал тебе. Он ниспослал это по Своему знанию (или со Своим знанием). Ангелы также приносят свидетельство, но довольно того, что Аллах является Свидетелем!",["но","Аллах","свидетельствует","о том, что","Он ниспослал","тебе","Он ниспослал его","по Своему знанию","и ангелы","свидетельствуют","и достаточно","Аллаха","Свидетелем"]],[4,167,["إِنَّ","ٱلَّذِينَ","كَفَرُواْ","وَصَدُّواْ","عَن","سَبِيلِ","ٱللَّهِ","قَدۡ","ضَلُّواْ","ضَلَٰلَۢا","بَعِيدًا"],"иннал лазиина кафаруу васаддуу `ан сабиилиллахи ḳад даллуу далала ба`иида","Воистину, те, которые не уверовали и сбивали других с пути Аллаха, впали в глубокое заблуждение.",["поистине","те, которые","не уверовали","и отвращали","от","пути","Аллаха","уже","заблудились они","заблуждением","далёким"]],[4,168,["إِنَّ","ٱلَّذِينَ","كَفَرُواْ","وَظَلَمُواْ","لَمۡ","يَكُنِ","ٱللَّهُ","لِيَغۡفِرَ","لَهُمۡ","وَلَا","لِيَهۡدِيَهُمۡ","طَرِيقًا"],"иннал лазиина кафаруу вазаламуу лам йакуниллаху лийагфира лахум вала лийахдийахум тарииḳа","Воистину, тех, которые не уверовали и поступали несправедливо, Аллах не простит и не поведет их никаким путем,",["поистине","те, которые","не уверовали","и поступали несправедливо","не","будет","Аллах","чтобы простить","им","и не","чтобы повести их","путём"]],[4,169,["إِلَّا","طَرِيقَ","جَهَنَّمَ","خَٰلِدِينَ","فِيهَآ","أَبَدٗاۚ","وَكَانَ","ذَٰلِكَ","عَلَى","ٱللَّهِ","يَسِيرٗا"],"илла тарииḳа жаханнама халидиина фииха абадан вакана залика `алаллахи йасиира","кроме пути в Геенну, в которой они пребудут вечно. Это для Аллаха легко.",["кроме","пути","Геенны","вечно пребывающими","в ней","навсегда","и было","это","для","Аллаха","лёгким"]],[4,170,["يَٰٓأَيُّهَا","ٱلنَّاسُ","قَدۡ","جَآءَكُمُ","ٱلرَّسُولُ","بِٱلۡحَقِّ","مِن","رَّبِّكُمۡ","فَـَٔامِنُواْ","خَيۡرٗا","لَّكُمۡۚ","وَإِن","تَكۡفُرُواْ","فَإِنَّ","لِلَّهِ","مَا","فِي","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِۚ","وَكَانَ","ٱللَّهُ","عَلِيمًا","حَكِيمٗا"],"йа'аййухан насу ḳад жаакумур расуулу билхаḳḳи мир раббикум фа'аминуу хайрал лакум ва'ин такфуруу фа'инна лиллахи ма фис самавати вал'арди ваканаллаху `алииман хакиима","О люди! Посланник принес вам истину от вашего Господа. Уверуйте же, ведь так будет лучше для вас. Если же вы не уверуете, то ведь Аллаху принадлежит то, что на небесах и на земле. Аллах - Знающий, Мудрый.",["О","люди","уже","пришёл к вам","Посланник","с истиной","от","вашего Господа","так уверуйте","лучше","для вас","а если","не уверуете","то поистине","Аллаху","то, что","в","небесах","и земле","и был","Аллах","Знающим","Мудрым"]]],"m":[[["۞ إِنَّآ","поистине Мы",4,163],["أَوۡحَيۡنَآ","внушили откровение",4,163],["إِلَيۡكَ","тебе",4,163],["كَمَآ","как",4,163],["أَوۡحَيۡنَآ","Мы внушили",4,163],["إِلَىٰ","к",4,163],["نُوحٖ","Нуху",4,163],["وَٱلنَّبِيِّـۧنَ","и пророкам",4,163],["مِنۢ","из",4,163],["بَعۡدِهِۦۚ","после него",4,163]],[["وَأَوۡحَيۡنَآ","и Мы внушили",4,163],["إِلَىٰٓ","к",4,163],["إِبۡرَٰهِيمَ","Ибрахиму",4,163],["وَإِسۡمَٰعِيلَ","и Исмаилу",4,163],["وَإِسۡحَٰقَ","и Исхаку",4,163],["وَيَعۡقُوبَ","и Якубу",4,163]],[["وَٱلۡأَسۡبَاطِ","и коленам",4,163],["وَعِيسَىٰ","и Исе",4,163],["وَأَيُّوبَ","и Айюбу",4,163],["وَيُونُسَ","и Юнусу",4,163],["وَهَٰرُونَ","и Харуну",4,163],["وَسُلَيۡمَٰنَۚ","и Сулейману",4,163]],[["وَءَاتَيۡنَا","и Мы даровали",4,163],["دَاوُۥدَ","Давуду",4,163],["زَبُورٗا","Забур",4,163],[163],["وَرُسُلٗا","и посланников",4,164],["قَدۡ","уже",4,164],["قَصَصۡنَٰهُمۡ","Мы рассказали о них",4,164],["عَلَيۡكَ","тебе",4,164]],[["مِن","от",4,164],["قَبۡلُ","прежде",4,164],["وَرُسُلٗا","и посланников",4,164],["لَّمۡ","не",4,164],["نَقۡصُصۡهُمۡ","рассказали Мы о них",4,164],["عَلَيۡكَۚ","тебе",4,164],["وَكَلَّمَ","и говорил",4,164],["ٱللَّهُ","Аллах",4,164],["مُوسَىٰ","с Мусой",4,164]],[["تَكۡلِيمٗا","беседой",4,164],[164],["رُّسُلٗا","посланников",4,165],["مُّبَشِّرِينَ","благовествующих",4,165],["وَمُنذِرِينَ","и предостерегающих",4,165],["لِئَلَّا","чтобы не",4,165],["يَكُونَ","был",4,165]],[["لِلنَّاسِ","у людей",4,165],["عَلَى","против",4,165],["ٱللَّهِ","Аллаха",4,165],["حُجَّةُۢ","довод",4,165],["بَعۡدَ","после",4,165],["ٱلرُّسُلِۚ","посланников",4,165],["وَكَانَ","и был",4,165],["ٱللَّهُ","Аллах",4,165],["عَزِيزًا","Могущественным",4,165],["حَكِيمٗا","Мудрым",4,165]],[[165],["لَّٰكِنِ","но",4,166],["ٱللَّهُ","Аллах",4,166],["يَشۡهَدُ","свидетельствует",4,166],["بِمَآ","о том, что",4,166],["أَنزَلَ","Он ниспослал",4,166],["إِلَيۡكَۖ","тебе",4,166],["أَنزَلَهُۥ","Он ниспослал его",4,166],["بِعِلۡمِهِۦۖ","по Своему знанию",4,166]],[["وَٱلۡمَلَٰٓئِكَةُ","и ангелы",4,166],["يَشۡهَدُونَۚ","свидетельствуют",4,166],["وَكَفَىٰ","и достаточно",4,166],["بِٱللَّهِ","Аллаха",4,166],["شَهِيدًا","Свидетелем",4,166],[166],["إِنَّ","поистине",4,167],["ٱلَّذِينَ","те, которые",4,167]],[["كَفَرُواْ","не уверовали",4,167],["وَصَدُّواْ","и отвращали",4,167],["عَن","от",4,167],["سَبِيلِ","пути",4,167],["ٱللَّهِ","Аллаха",4,167],["قَدۡ","уже",4,167],["ضَلُّواْ","заблудились они",4,167],["ضَلَٰلَۢا","заблуждением",4,167],["بَعِيدًا","далёким",4,167]],[[167],["إِنَّ","поистине",4,168],["ٱلَّذِينَ","те, которые",4,168],["كَفَرُواْ","не уверовали",4,168],["وَظَلَمُواْ","и поступали несправедливо",4,168],["لَمۡ","не",4,168],["يَكُنِ","будет",4,168],["ٱللَّهُ","Аллах",4,168],["لِيَغۡفِرَ","чтобы простить",4,168],["لَهُمۡ","им",4,168],["وَلَا","и не",4,168]],[["لِيَهۡدِيَهُمۡ","чтобы повести их",4,168],["طَرِيقًا","путём",4,168],[168],["إِلَّا","кроме",4,169],["طَرِيقَ","пути",4,169],["جَهَنَّمَ","Геенны",4,169],["خَٰلِدِينَ","вечно пребывающими",4,169],["فِيهَآ","в ней",4,169],["أَبَدٗاۚ","навсегда",4,169]],[["وَكَانَ","и было",4,169],["ذَٰلِكَ","это",4,169],["عَلَى","для",4,169],["ٱللَّهِ","Аллаха",4,169],["يَسِيرٗا","лёгким",4,169],[169],["يَٰٓأَيُّهَا","О",4,170],["ٱلنَّاسُ","люди",4,170],["قَدۡ","уже",4,170],["جَآءَكُمُ","пришёл к вам",4,170]],[["ٱلرَّسُولُ","Посланник",4,170],["بِٱلۡحَقِّ","с истиной",4,170],["مِن","от",4,170],["رَّبِّكُمۡ","вашего Господа",4,170],["فَـَٔامِنُواْ","так уверуйте",4,170],["خَيۡرٗا","лучше",4,170],["لَّكُمۡۚ","для вас",4,170],["وَإِن","а если",4,170],["تَكۡفُرُواْ","не уверуете",4,170]],[["فَإِنَّ","то поистине",4,170],["لِلَّهِ","Аллаху",4,170],["مَا","то, что",4,170],["فِي","в",4,170],["ٱلسَّمَٰوَٰتِ","небесах",4,170],["وَٱلۡأَرۡضِۚ","и земле",4,170],["وَكَانَ","и был",4,170],["ٱللَّهُ","Аллах",4,170],["عَلِيمًا","Знающим",4,170],["حَكِيمٗا","Мудрым",4,170],[170]]]}