{"p":105,"j":6,"a":[[4,171,["يَٰٓأَهۡلَ","ٱلۡكِتَٰبِ","لَا","تَغۡلُواْ","فِي","دِينِكُمۡ","وَلَا","تَقُولُواْ","عَلَى","ٱللَّهِ","إِلَّا","ٱلۡحَقَّۚ","إِنَّمَا","ٱلۡمَسِيحُ","عِيسَى","ٱبۡنُ","مَرۡيَمَ","رَسُولُ","ٱللَّهِ","وَكَلِمَتُهُۥٓ","أَلۡقَىٰهَآ","إِلَىٰ","مَرۡيَمَ","وَرُوحٞ","مِّنۡهُۖ","فَـَٔامِنُواْ","بِٱللَّهِ","وَرُسُلِهِۦۖ","وَلَا","تَقُولُواْ","ثَلَٰثَةٌۚ","ٱنتَهُواْ","خَيۡرٗا","لَّكُمۡۚ","إِنَّمَا","ٱللَّهُ","إِلَٰهٞ","وَٰحِدٞۖ","سُبۡحَٰنَهُۥٓ","أَن","يَكُونَ","لَهُۥ","وَلَدٞۘ","لَّهُۥ","مَا","فِي","ٱلسَّمَٰوَٰتِ","وَمَا","فِي","ٱلۡأَرۡضِۗ","وَكَفَىٰ","بِٱللَّهِ","وَكِيلٗا"],"йа'ахлал китаби ла таглуу фии дииникум вала таḳуулуу `алаллахи иллал хаḳḳа иннамал масииху `иисабну марйама расуулуллахи вакалиматухуу алḳаха ила марйама варуухум минху фа'аминуу биллахи варусулихии вала таḳуулуу саласатунинтахуу хайрал лакум иннамаллаху илахун вахидун субханахуу ан йакууна лахуу валадул лахуу ма фис самавати вама фил арди вакафа биллахи вакиила","О люди Писания! Не проявляйте чрезмерности в вашей религии и говорите об Аллахе только правду. Мессия Иса (Иисус), сын Марьям (Марии), является посланником Аллаха, Его Словом, которое Он послал Марьям (Марии), и духом от Него. Веруйте же в Аллаха и Его посланников и не говорите: «Троица!». Прекратите, ведь так будет лучше для вас. Воистину, Аллах является Единственным Богом. Он пречист и далек от того, чтобы у Него был сын. Ему принадлежит то, что на небесах, и то, что на земле. Довольно того, что Аллах является Попечителем и Хранителем!",["О люди","Писания","не","преступайте меры","в","вашей религии","и не","говорите","об","Аллахе","кроме","истины","лишь","Мессия","Иса","сын","Марьям","посланник","Аллаха","и Его слово","Он передал его","к","Марьям","и дух","от Него","так уверуйте","в Аллаха","и Его посланников","и не","говорите","три","перестаньте","лучше","для вас","лишь","Аллах","Бог","Единый","пречист Он","чтобы","был","у Него","сын","Ему","то, что","в","небесах","и то, что","на","земле","и достаточно","Аллаха","Попечителем"]],[4,172,["لَّن","يَسۡتَنكِفَ","ٱلۡمَسِيحُ","أَن","يَكُونَ","عَبۡدٗا","لِّلَّهِ","وَلَا","ٱلۡمَلَٰٓئِكَةُ","ٱلۡمُقَرَّبُونَۚ","وَمَن","يَسۡتَنكِفۡ","عَنۡ","عِبَادَتِهِۦ","وَيَسۡتَكۡبِرۡ","فَسَيَحۡشُرُهُمۡ","إِلَيۡهِ","جَمِيعٗا"],"ллан йастанкифал масииху ан йакууна `абдал лиллахи валал малаикатул муḳаррабууна ваман йастанкиф `ан `ибадатихии вайастакбир фасайахшурухум илайхи жамии`а","Ни Мессия, ни приближенные ангелы никогда не посчитают для себя унизительным быть рабами Аллаха. А тех, кто посчитает для себя унизительным поклоняться Ему и проявит высокомерие, Он соберет к Себе вместе.",["никогда не","погнушается","Мессия","чтобы","быть","рабом","Аллаха","и не","ангелы","приближённые","а кто","погнушается","от","поклонения Ему","и возгордится","то Он соберёт их","к Себе","всех вместе"]],[4,173,["فَأَمَّا","ٱلَّذِينَ","ءَامَنُواْ","وَعَمِلُواْ","ٱلصَّٰلِحَٰتِ","فَيُوَفِّيهِمۡ","أُجُورَهُمۡ","وَيَزِيدُهُم","مِّن","فَضۡلِهِۦۖ","وَأَمَّا","ٱلَّذِينَ","ٱسۡتَنكَفُواْ","وَٱسۡتَكۡبَرُواْ","فَيُعَذِّبُهُمۡ","عَذَابًا","أَلِيمٗا","وَلَا","يَجِدُونَ","لَهُم","مِّن","دُونِ","ٱللَّهِ","وَلِيّٗا","وَلَا","نَصِيرٗا"],"фа'аммал лазиина амануу ва`амилус салихати файуаффиихим ужуурахум вайазиидухум мин фадлихии ва'аммал лазиинастанкафуу вастакбаруу файу`аззибухум `азабан алииман вала йажидууна лахум мин дууниллахи валиййан вала насиира","Тех, которые уверовали и совершали праведные деяния, Он одарит вознаграждением сполна и даже приумножит его по Своей милости. А тех, которые считали для себя унизительным поклоняться Ему и проявляли высокомерие, Он подвергнет мучительным страданиям. Они не найдут себе вместо Него ни покровителя, ни помощника.",["а что касается","тех, которые","уверовали","и совершали","праведные дела","то Он воздаст им сполна","их награды","и прибавит им","из","Своей щедрости","а что касается","тех, которые","погнушались","и возгордились","то Он накажет их","наказанием","мучительным","и не","найдут они","себе","из","вместо","Аллаха","покровителя","и не","помощника"]],[4,174,["يَٰٓأَيُّهَا","ٱلنَّاسُ","قَدۡ","جَآءَكُم","بُرۡهَٰنٞ","مِّن","رَّبِّكُمۡ","وَأَنزَلۡنَآ","إِلَيۡكُمۡ","نُورٗا","مُّبِينٗا"],"йа'аййухан насу ḳад жаакум бурханум мир раббикум ва'анзална илайкум нуурам мубиина","О люди! К вам уже явилось доказательство от вашего Господа, и Мы ниспослали вам ясный свет.",["О","люди","уже","пришло к вам","доказательство","от","вашего Господа","и Мы ниспослали","вам","свет","ясный"]],[4,175,["فَأَمَّا","ٱلَّذِينَ","ءَامَنُواْ","بِٱللَّهِ","وَٱعۡتَصَمُواْ","بِهِۦ","فَسَيُدۡخِلُهُمۡ","فِي","رَحۡمَةٖ","مِّنۡهُ","وَفَضۡلٖ","وَيَهۡدِيهِمۡ","إِلَيۡهِ","صِرَٰطٗا","مُّسۡتَقِيمٗا"],"фа'аммал лазиина амануу биллахи ва`тасамуу бихии фасайудхилухум фии рахматим минху вафадлин вайахдиихим илайхи сиратам мустаḳиима","Тех, которые уверовали в Аллаха и крепко ухватились за Него, Он введет в Свою милость и щедрость и поведет к Себе прямым путем.",["а что касается","тех, которые","уверовали","в Аллаха","и крепко держались","за Него","то Он введёт их","в","милость","от Него","и щедрость","и поведёт их","к Себе","путём","прямым"]]],"m":[[["يَٰٓأَهۡلَ","О люди",4,171],["ٱلۡكِتَٰبِ","Писания",4,171],["لَا","не",4,171],["تَغۡلُواْ","преступайте меры",4,171],["فِي","в",4,171],["دِينِكُمۡ","вашей религии",4,171],["وَلَا","и не",4,171],["تَقُولُواْ","говорите",4,171]],[["عَلَى","об",4,171],["ٱللَّهِ","Аллахе",4,171],["إِلَّا","кроме",4,171],["ٱلۡحَقَّۚ","истины",4,171],["إِنَّمَا","лишь",4,171],["ٱلۡمَسِيحُ","Мессия",4,171],["عِيسَى","Иса",4,171],["ٱبۡنُ","сын",4,171],["مَرۡيَمَ","Марьям",4,171],["رَسُولُ","посланник",4,171]],[["ٱللَّهِ","Аллаха",4,171],["وَكَلِمَتُهُۥٓ","и Его слово",4,171],["أَلۡقَىٰهَآ","Он передал его",4,171],["إِلَىٰ","к",4,171],["مَرۡيَمَ","Марьям",4,171],["وَرُوحٞ","и дух",4,171],["مِّنۡهُۖ","от Него",4,171],["فَـَٔامِنُواْ","так уверуйте",4,171],["بِٱللَّهِ","в Аллаха",4,171]],[["وَرُسُلِهِۦۖ","и Его посланников",4,171],["وَلَا","и не",4,171],["تَقُولُواْ","говорите",4,171],["ثَلَٰثَةٌۚ","три",4,171],["ٱنتَهُواْ","пе