{"p":108,"j":6,"a":[[5,6,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُوٓاْ","إِذَا","قُمۡتُمۡ","إِلَى","ٱلصَّلَوٰةِ","فَٱغۡسِلُواْ","وُجُوهَكُمۡ","وَأَيۡدِيَكُمۡ","إِلَى","ٱلۡمَرَافِقِ","وَٱمۡسَحُواْ","بِرُءُوسِكُمۡ","وَأَرۡجُلَكُمۡ","إِلَى","ٱلۡكَعۡبَيۡنِۚ","وَإِن","كُنتُمۡ","جُنُبٗا","فَٱطَّهَّرُواْۚ","وَإِن","كُنتُم","مَّرۡضَىٰٓ","أَوۡ","عَلَىٰ","سَفَرٍ","أَوۡ","جَآءَ","أَحَدٞ","مِّنكُم","مِّنَ","ٱلۡغَآئِطِ","أَوۡ","لَٰمَسۡتُمُ","ٱلنِّسَآءَ","فَلَمۡ","تَجِدُواْ","مَآءٗ","فَتَيَمَّمُواْ","صَعِيدٗا","طَيِّبٗا","فَٱمۡسَحُواْ","بِوُجُوهِكُمۡ","وَأَيۡدِيكُم","مِّنۡهُۚ","مَا","يُرِيدُ","ٱللَّهُ","لِيَجۡعَلَ","عَلَيۡكُم","مِّنۡ","حَرَجٖ","وَلَٰكِن","يُرِيدُ","لِيُطَهِّرَكُمۡ","وَلِيُتِمَّ","نِعۡمَتَهُۥ","عَلَيۡكُمۡ","لَعَلَّكُمۡ","تَشۡكُرُونَ"],"йа'аййухал лазиина амануу иза ḳумтум илас салавати фагсилуу вужуухакум ва'айдийакум илал марафиḳи вамсахуу биру'уусикум ва'аржулакум илал ка`байни ва'ин кунтум жунубан фаттаххаруу ва'ин кунтум марда ау `ала сафарин ау жаа ахадум минкум минал гаити ау ламастумун нисаа фалам тажидуу маан фатайаммамуу са`иидан таййибан фамсахуу бивужуухикум ва'айдиикум минху ма йуриидуллаху лийаж`ала `алайкум мин харажин валакин йурииду лийутаххиракум валийутимма ни`матахуу `алайкум ла`аллакум ташкуруун","О те, которые уверовали! Когда вы встаете на намаз, то умойте ваши лица и ваши руки до локтей, оботрите ваши головы и умойте ваши ноги до щиколоток. А если вы находитесь в половом осквернении, то очиститесь. Если же вы больны или находитесь в путешествии, если кто-либо из вас пришел из уборной или если вы имели близость с женщинами, и вы не нашли воды, то направьтесь к чистой земле и оботрите ею ваши лица и руки. Аллах не хочет создавать для вас трудности, а хочет очистить вас и довести до конца Свою милость по отношению к вам, - быть может, вы будете благодарны.",["О","те, которые","уверовали","когда","вы встаёте","к","намазу","то мойте","ваши лица","и ваши руки","до","локтей","и обтирайте","ваши головы","и ваши ноги","до","щиколоток","а если","вы","в осквернении","то очиститесь","а если","вы","больны","или","в","пути","или","пришёл","кто-либо","из вас","из","отхожего места","или","вы касались","женщин","и не","нашли","воды","то совершите таяммум","землёй","чистой","и обтирайте","ваши лица","и ваши руки","ею","не","хочет","Аллах","чтобы сделать","для вас","какое-либо","затруднение","но","Он хочет","очистить вас","и довершить","Его милость","вам","чтобы вы","благодарили"]],[5,7,["وَٱذۡكُرُواْ","نِعۡمَةَ","ٱللَّهِ","عَلَيۡكُمۡ","وَمِيثَٰقَهُ","ٱلَّذِي","وَاثَقَكُم","بِهِۦٓ","إِذۡ","قُلۡتُمۡ","سَمِعۡنَا","وَأَطَعۡنَاۖ","وَٱتَّقُواْ","ٱللَّهَۚ","إِنَّ","ٱللَّهَ","عَلِيمُۢ","بِذَاتِ","ٱلصُّدُورِ"],"вазкуруу ни`маталлахи `алайкум вамиисаḳахул лазии васаḳакум бихии из ḳултум сами`на ва'ата`на ваттаḳуллаха инналлаха `алииму бизатис судуур","Помните о милости Аллаха к вам и завете, который Он заключил с вами, когда вы сказали: «Слушаем и повинуемся». Бойтесь Аллаха, ведь Аллаху известно о том, что в груди.",["и помните","милость","Аллаха","к вам","и Его завет","который","Он заключил с вами","им","когда","вы сказали","мы услышали","и мы повиновались","и бойтесь","Аллаха","поистине","Аллах","Знающий","о сокровенном","в грудях"]],[5,8,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُواْ","كُونُواْ","قَوَّٰمِينَ","لِلَّهِ","شُهَدَآءَ","بِٱلۡقِسۡطِۖ","وَلَا","يَجۡرِمَنَّكُمۡ","شَنَـَٔانُ","قَوۡمٍ","عَلَىٰٓ","أَلَّا","تَعۡدِلُواْۚ","ٱعۡدِلُواْ","هُوَ","أَقۡرَبُ","لِلتَّقۡوَىٰۖ","وَٱتَّقُواْ","ٱللَّهَۚ","إِنَّ","ٱللَّهَ","خَبِيرُۢ","بِمَا","تَعۡمَلُونَ"],"йа'аййухал лазиина амануу куунуу ḳаввамиина лиллахи шухадаа билḳисти вала йажриманнакум шанаану ḳаумин `ала алла та`дилу`дилуу хуа аḳрабу литтаḳва ваттаḳуллаха инналлаха хабииру бима та`малуун","О те, которые уверовали! Будьте стойки ради Аллаха, свидетельствуя беспристрастно, и пусть ненависть людей не подтолкнет вас к несправедливости. Будьте справедливы, ибо это ближе к богобоязненности. Бойтесь Аллаха, ведь Аллах ведает о том, что вы совершаете.",["О","те, которые","уверовали","будьте","стойкими","ради Аллаха","свидетелями","по справедливости","и пусть не","побуждает вас","ненависть","к людям","к тому","чтобы не","вы были справедливы","будьте справедливы","это","ближе","к богобоязненности","и бойтесь","Аллаха","поистине","Аллах","Сведущ","о том, что","вы делаете"]],[5,9,["وَعَدَ","ٱللَّهُ","ٱلَّذِينَ","ءَامَنُواْ","وَعَمِلُواْ","ٱلصَّٰلِحَٰتِ","لَهُم","مَّغۡفِرَةٞ","وَأَجۡرٌ","عَظِيمٞ"],"ва`адаллахул лазиина амануу ва`амилус салихати лахум магфиратун ва'ажрун `азиим","Аллах обещал тем, которые уверовали и совершали праведные деяния, прощение и великую награду.",["обещал","Аллах","тем, которые","уверовали","и совершали","праведные дела","для них","прощение","и награда","великая"]]],"m":[[["يَٰٓأَيُّهَا","О",5,6],["ٱلَّذِينَ","те, которые",5,6],["ءَامَنُوٓاْ","уверовали",5,6],["إِذَا","когда",5,6],["قُمۡتُمۡ","вы встаёте",5,6],["إِلَى","к",5,6],["ٱلصَّلَوٰةِ","намазу",5,6],["فَٱغۡسِلُواْ","то мойте",5,6]],[["وُجُوهَكُمۡ","ваши лица",5,6],["وَأَيۡدِيَكُمۡ","и ваши руки",5,6],["إِلَى","до",5,6],["ٱلۡمَرَافِقِ","локтей",5,6],["وَٱمۡسَحُواْ","и обтирайте",5,6],["بِرُءُوسِكُمۡ","ваши головы",5,6]],[["وَأَرۡجُلَكُمۡ","и ваши ноги",5,6],["إِلَى","до",5,6],["ٱلۡكَعۡبَيۡنِۚ","щиколоток",5,6],["وَإِن","а если",5,6],["كُنتُمۡ","вы",5,6],["جُنُبٗا","в осквернении",5,6],["فَٱطَّهَّرُواْۚ","то очиститесь",5,6]],[["وَإِن","а если",5,6],["كُنتُم","вы",5,6],["مَّرۡضَىٰٓ","больны",5,6],["أَوۡ","или",5,6],["عَلَىٰ","в",5,6],["سَفَرٍ","пути",5,6],["أَوۡ","или",5,6],["جَآءَ","пришёл",5,6],["أَحَدٞ","кто-либо",5,6],["مِّنكُم","из вас",5,6],["مِّنَ","из",5,6],["ٱلۡغَآئِطِ","отхожего места",5,6]],[["أَوۡ","или",5,6],["لَٰمَسۡتُمُ","вы касались",5,6],["ٱلنِّسَآءَ","женщин",5,6],["فَلَمۡ","и не",5,6],["تَجِدُواْ","нашли",5,6],["مَآءٗ","воды",5,6],["فَتَيَمَّمُواْ","то совершите таяммум",5,6],["صَعِيدٗا","землёй",5,6],["طَيِّبٗا","чистой",5,6]],[["فَٱمۡسَحُواْ","и обтирайте",5,6],["بِوُجُوهِكُمۡ","ваши лица",5,6],["وَأَيۡدِيكُم","и ваши руки",5,6],["مِّنۡهُۚ","ею",5,6],