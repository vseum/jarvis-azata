{"p":109,"j":6,"a":[[5,10,["وَٱلَّذِينَ","كَفَرُواْ","وَكَذَّبُواْ","بِـَٔايَٰتِنَآ","أُوْلَٰٓئِكَ","أَصۡحَٰبُ","ٱلۡجَحِيمِ"],"валлазиина кафаруу ваказзабуу би'айатина улаика асхабул жахиим","А те, которые не уверовали и сочли ложью Наши знамения, окажутся обитателями Ада.",["а те, которые","не уверовали","и сочли ложью","Наши знамения","те","обитатели","Ада"]],[5,11,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُواْ","ٱذۡكُرُواْ","نِعۡمَتَ","ٱللَّهِ","عَلَيۡكُمۡ","إِذۡ","هَمَّ","قَوۡمٌ","أَن","يَبۡسُطُوٓاْ","إِلَيۡكُمۡ","أَيۡدِيَهُمۡ","فَكَفَّ","أَيۡدِيَهُمۡ","عَنكُمۡۖ","وَٱتَّقُواْ","ٱللَّهَۚ","وَعَلَى","ٱللَّهِ","فَلۡيَتَوَكَّلِ","ٱلۡمُؤۡمِنُونَ"],"йа'аййухал лазиина аманузкуруу ни`маталлахи `алайкум из хамма ḳаумун ан йабсутуу илайкум айдийахум факаффа айдийахум `анкум ваттаḳуллаха ва`алаллахи фалйатаваккалил му'минуун","О те, которые уверовали! Помните о милости, которую Аллах оказал вам, когда люди вознамерились протянуть к вам свои руки, но Он убрал от вас их руки. Бойтесь Аллаха, и пусть на Аллаха уповают верующие!",["О","те, которые","уверовали","помните","милость","Аллаха","к вам","когда","намерились","люди","чтобы","протянуть","к вам","свои руки","но Он удержал","их руки","от вас","и бойтесь","Аллаха","и на","Аллаха","пусть уповают","верующие"]],[5,12,["وَلَقَدۡ","أَخَذَ","ٱللَّهُ","مِيثَٰقَ","بَنِيٓ","إِسۡرَٰٓءِيلَ","وَبَعَثۡنَا","مِنۡهُمُ","ٱثۡنَيۡ","عَشَرَ","نَقِيبٗاۖ","وَقَالَ","ٱللَّهُ","إِنِّي","مَعَكُمۡۖ","لَئِنۡ","أَقَمۡتُمُ","ٱلصَّلَوٰةَ","وَءَاتَيۡتُمُ","ٱلزَّكَوٰةَ","وَءَامَنتُم","بِرُسُلِي","وَعَزَّرۡتُمُوهُمۡ","وَأَقۡرَضۡتُمُ","ٱللَّهَ","قَرۡضًا","حَسَنٗا","لَّأُكَفِّرَنَّ","عَنكُمۡ","سَيِّـَٔاتِكُمۡ","وَلَأُدۡخِلَنَّكُمۡ","جَنَّٰتٖ","تَجۡرِي","مِن","تَحۡتِهَا","ٱلۡأَنۡهَٰرُۚ","فَمَن","كَفَرَ","بَعۡدَ","ذَٰلِكَ","مِنكُمۡ","فَقَدۡ","ضَلَّ","سَوَآءَ","ٱلسَّبِيلِ"],"валаḳад ахазаллаху миисаḳа бании исраиила ваба`асна минхумуснай `ашара наḳиибан ваḳалаллаху иннии ма`акум ла'ин аḳамтумус салавата ва'атайтумуз закавата ва'амантум бирусулии ва`аззартумуухум ва'аḳрадтумуллаха ḳардан хасанал ла'укаффиранна `анкум саййиатикум валаудхиланнакум жаннатин тажрии мин тахтихал анхару фаман кафара ба`да залика минкум фаḳад далла саваас сабиил","Аллах взял завет с сынов Исраила (Израиля). Мы создали среди них двенадцать вождей. Аллах сказал: «Я - с вами. Если вы будете совершать намаз и выплачивать закят, уверуете в Моих посланников, поможете им и одолжите Аллаху прекрасный заем, то Я отпущу вам ваши прегрешения и введу вас в сады, в которых текут реки. А если кто-либо из вас после этого станет неверующим, то он сойдет с прямого пути».",["и уже","взял","Аллах","завет","с сынов","Исраила","и Мы направили","из них","двенадцать","(десять)","старейшин","и сказал","Аллах","поистине, Я","с вами","если","вы будете совершать","намаз","и давать","закят","и уверуете","в Моих посланников","и поддержите их","и дадите взаймы","Аллаху","заём","прекрасный","непременно Я сниму","с вас","ваши злые деяния","и непременно введу вас","в сады","текут","из","под ними","реки","а кто","не уверовал","после","этого","из вас","тот уже","сбился","с ровного","пути"]],[5,13,["فَبِمَا","نَقۡضِهِم","مِّيثَٰقَهُمۡ","لَعَنَّٰهُمۡ","وَجَعَلۡنَا","قُلُوبَهُمۡ","قَٰسِيَةٗۖ","يُحَرِّفُونَ","ٱلۡكَلِمَ","عَن","مَّوَاضِعِهِۦ","وَنَسُواْ","حَظّٗا","مِّمَّا","ذُكِّرُواْ","بِهِۦۚ","وَلَا","تَزَالُ","تَطَّلِعُ","عَلَىٰ","خَآئِنَةٖ","مِّنۡهُمۡ","إِلَّا","قَلِيلٗا","مِّنۡهُمۡۖ","فَٱعۡفُ","عَنۡهُمۡ","وَٱصۡفَحۡۚ","إِنَّ","ٱللَّهَ","يُحِبُّ","ٱلۡمُحۡسِنِينَ"],"фабима наḳдихим миисаḳахум ла`аннахум важа`ална ḳулуубахум ḳасийатан йухаррифуунал калима `ам мавади`ихии ванасуу хаззам мимма зуккируу бихии вала тазалу таттали`у `ала хаинатим минхум илла ḳалиилам минхум фа`фу `анхум васфах инналлаха йухиббул мухсиниин","За то, что они нарушили завет, Мы прокляли их и ожесточили их сердца. Они искажают слова, меняя их местами, и забыли долю из того, чему их научили. Ты всегда будешь обнаруживать их измену, за исключением некоторых из них. Прости же их и будь великодушен, ведь Аллах любит творящих добро.",["так за","их нарушение","их завета","Мы прокляли их","и Мы сделали","их сердца","чёрствыми","они искажают","слова","с","их мест","и забыли","долю","из того, что","им напоминалось","о нём","и не","перестанешь ты","узнавать","о","вероломстве","с их стороны","кроме","немногих","из них","так прости","их","и будь снисходителен","поистине","Аллах","любит","творящих добро"]]],"m":[[["وَٱلَّذِينَ","а те, которые",5,10],["كَفَرُواْ","не уверовали",5,10],["وَكَذَّبُواْ","и сочли ложью",5,10],["بِـَٔايَٰتِنَآ","Наши знамения",5,10],["أُوْلَٰٓئِكَ","те",5,10],["أَصۡحَٰبُ","обитатели",5,10]],[["ٱلۡجَحِيمِ","Ада",5,10],[10],["يَٰٓأَيُّهَا","О",5,11],["ٱلَّذِينَ","те, которые",5,11],["ءَامَنُواْ","уверовали",5,11],["ٱذۡكُرُواْ","помните",5,11],["نِعۡمَتَ","милость",5,11]],[["ٱللَّهِ","Аллаха",5,11],["عَلَيۡكُمۡ","к вам",5,11],["إِذۡ","когда",5,11],["هَمَّ","намерились",5,11],["قَوۡمٌ","люди",5,11],["أَن","чтобы",5,11],["يَبۡسُطُوٓاْ","протянуть",5,11],["إِلَيۡكُمۡ","к вам",5,11],["أَيۡدِيَهُمۡ","свои руки",5,11]],[["فَكَفَّ","но Он удержал",5,11],["أَيۡدِيَهُمۡ","их руки",5,11],["عَنكُمۡۖ","от вас",5,11],["وَٱتَّقُواْ","и бойтесь",5,11],["ٱللَّهَۚ","Аллаха",5,11],["وَعَلَى","и на",5,11],["ٱللَّهِ","Аллаха",5,11],["فَلۡيَتَوَكَّلِ","пусть уповают",5,11]],[["ٱلۡمُؤۡمِنُونَ","верующие",5,11],[11],["۞ وَلَقَدۡ","и уже",5,12],["أَخَذَ","взял",5,12],["ٱللَّهُ","Аллах",5,12],["مِيثَٰقَ","завет",5,12],["بَنِيٓ","с сынов",5,12]],[["إِسۡرَٰٓءِيلَ","Исраила",5,12],["وَبَعَثۡنَا","и Мы направили",5,12],["مِنۡهُمُ","из них",5,12],["ٱثۡنَيۡ","двенадцать",5,12],["عَشَرَ","(десять)",5,12],["نَقِيبٗاۖ","старейшин",5,12],["وَقَالَ","и сказал",5,12],["ٱللَّهُ","Аллах",5,12]],[["إِنِّي","поистине, Я",5,12],["مَعَكُمۡۖ","с вами",5,12],["لَئِنۡ","если",5,12],["أَقَمۡتُمُ","вы будете совершать",5,12],["ٱلصَّلَوٰةَ","намаз",5,12],["وَءَاتَيۡتُمُ","и давать",5,12],["ٱلزَّكَوٰةَ","закят",5,12]],[["وَءَامَنتُم","и уверуете",5,12],["بِرُسُلِي","в Моих посланников",5,12],["وَعَزَّرۡتُمُوهُمۡ","и поддержите их",5,12],["وَأَقۡرَضۡتُمُ","и дадите взаймы",5,12],["ٱللَّهَ","Аллаху",5,12],["قَرۡضًا","заём",5,12]],[["حَسَنٗا","прекрасный",5,12],["لَّأُكَفِّرَنَّ","непременно Я сниму",5,12],["عَنكُمۡ","с вас",5,12],["سَيِّـَٔاتِكُمۡ","ваши злые деяния",5,12],["وَلَأُدۡخِلَنَّكُمۡ","и непременно введу вас",5,12]],[["جَنَّٰتٖ","в сады",5,12],["تَجۡرِي","текут",5,12],["مِن","из",5,12],["تَحۡتِهَا","под ними",5,12],["ٱلۡأَنۡهَٰرُۚ","реки",5,12],["فَمَن","а кто",5,12],["كَفَرَ","не уверовал",5,12],["بَعۡدَ","после",5,12]],[["ذَٰلِكَ","этого",5,12],["مِنكُمۡ","из вас",5,12],["فَقَدۡ","тот уже",5,12],["ضَلَّ","сбился",5,12],["سَوَآءَ","с ровного",5,12],["ٱلسَّبِيلِ","пути",5,12],[12],["فَبِمَا","так за",5,13]],[["نَقۡضِهِم","их нарушение",5,13],["مِّيثَٰقَهُمۡ","их завета",5,13],["لَعَنَّٰهُمۡ","Мы прокляли их",5,13],["وَجَعَلۡنَا","и Мы сделали",5,13],["قُلُوبَهُمۡ","их сердца",5,13],["قَٰسِيَةٗۖ","чёрствыми",5,13]],[["يُحَرِّفُونَ","они искажают",5,13],["ٱلۡكَلِمَ","слова",5,13],["عَن","с",5,13],["مَّوَاضِعِهِۦ","их мест",5,13],["وَنَسُواْ","и забыли",5,13],["حَظّٗا","долю",5,13],["مِّمَّا","из того, что",5,13]],[["ذُكِّرُواْ","им напоминалось",5,13],["بِهِۦۚ","о нём",5,13],["وَلَا","и не",5,13],["تَزَالُ","перестанешь ты",5,13],["تَطَّلِعُ","узнавать",5,13],["عَلَىٰ","о",5,13],["خَآئِنَةٖ","вероломстве",5,13],["مِّنۡهُمۡ","с их стороны",5,13],["إِلَّا","кроме",5,13],["قَلِيلٗا","немногих",5,13],["مِّنۡهُمۡۖ","из них",5,13]],[["فَٱعۡفُ","так прости",5,13],["عَنۡهُمۡ","их",5,13],["وَٱصۡفَحۡۚ","и будь снисходителен",5,13],["إِنَّ","поистине",5,13],["ٱللَّهَ","Аллах",5,13],["يُحِبُّ","любит",5,13],["ٱلۡمُحۡسِنِينَ","творящих добро",5,13],[13]]]}