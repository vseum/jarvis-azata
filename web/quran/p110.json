{"p":110,"j":6,"a":[[5,14,["وَمِنَ","ٱلَّذِينَ","قَالُوٓاْ","إِنَّا","نَصَٰرَىٰٓ","أَخَذۡنَا","مِيثَٰقَهُمۡ","فَنَسُواْ","حَظّٗا","مِّمَّا","ذُكِّرُواْ","بِهِۦ","فَأَغۡرَيۡنَا","بَيۡنَهُمُ","ٱلۡعَدَاوَةَ","وَٱلۡبَغۡضَآءَ","إِلَىٰ","يَوۡمِ","ٱلۡقِيَٰمَةِۚ","وَسَوۡفَ","يُنَبِّئُهُمُ","ٱللَّهُ","بِمَا","كَانُواْ","يَصۡنَعُونَ"],"ваминал лазиина ḳалуу инна насара ахазна миисаḳахум фанасуу хаззам мимма зуккируу бихии фа'аграйна байнахумул `адавата валбагдаа ила йаумил ḳийамати васауфа йунаббиухумуллаху бима кануу йасна`уун","Мы также взяли завет с тех, которые сказали: «Мы - христиане». Они забыли долю из того, что им напомнили, и тогда Мы возбудили между ними вражду и ненависть до Дня воскресения. Аллах поведает им о том, что они творили.",["и у","тех, которые","сказали","поистине, мы","христиане","Мы взяли","их завет","но они забыли","долю","из того, что","им напоминалось","о нём","и Мы возбудили","между ними","вражду","и ненависть","до","Дня","Воскресения","и скоро","сообщит им","Аллах","о том, что","они","творили"]],[5,15,["يَٰٓأَهۡلَ","ٱلۡكِتَٰبِ","قَدۡ","جَآءَكُمۡ","رَسُولُنَا","يُبَيِّنُ","لَكُمۡ","كَثِيرٗا","مِّمَّا","كُنتُمۡ","تُخۡفُونَ","مِنَ","ٱلۡكِتَٰبِ","وَيَعۡفُواْ","عَن","كَثِيرٖۚ","قَدۡ","جَآءَكُم","مِّنَ","ٱللَّهِ","نُورٞ","وَكِتَٰبٞ","مُّبِينٞ"],"йа'ахлал китаби ḳад жаакум расуулуна йубаййину лакум касиирам мимма кунтум тухфууна минал китаби вайа`фуу `ан касиирин ḳад жаакум миналлахи нуурун вакитабум мубиин","О люди Писания! К вам явился Наш Посланник, который разъясняет вам многое из того, что вы скрываете из Писания, и воздерживается от многого. Явились к вам от Аллаха свет (Мухаммад) и ясное Писание.",["О люди","Писания","уже","пришёл к вам","Наш Посланник","разъясняющий","вам","многое","из того, что","вы","скрывали","из","Писания","и прощающий","о","многом","уже","пришёл к вам","от","Аллаха","свет","и Писание","ясное"]],[5,16,["يَهۡدِي","بِهِ","ٱللَّهُ","مَنِ","ٱتَّبَعَ","رِضۡوَٰنَهُۥ","سُبُلَ","ٱلسَّلَٰمِ","وَيُخۡرِجُهُم","مِّنَ","ٱلظُّلُمَٰتِ","إِلَى","ٱلنُّورِ","بِإِذۡنِهِۦ","وَيَهۡدِيهِمۡ","إِلَىٰ","صِرَٰطٖ","مُّسۡتَقِيمٖ"],"йахдии бихиллаху маниттаба`а ридванахуу субулас салами вайухрижухум миназ зулумати илан нуури би'изнихии вайахдиихим ила сиратим мустаḳиим","Посредством его Аллах ведет по путям мира тех, кто стремится снискать Его довольство. По Своему соизволению Он выводит их из мраков к свету и наставляет их на прямой путь.",["ведёт","им","Аллах","того, кто","последовал","Его довольству","путями","мира","и выводит их","из","мраков","к","свету","Его дозволением","и ведёт их","к","пути","прямому"]],[5,17,["لَّقَدۡ","كَفَرَ","ٱلَّذِينَ","قَالُوٓاْ","إِنَّ","ٱللَّهَ","هُوَ","ٱلۡمَسِيحُ","ٱبۡنُ","مَرۡيَمَۚ","قُلۡ","فَمَن","يَمۡلِكُ","مِنَ","ٱللَّهِ","شَيۡـًٔا","إِنۡ","أَرَادَ","أَن","يُهۡلِكَ","ٱلۡمَسِيحَ","ٱبۡنَ","مَرۡيَمَ","وَأُمَّهُۥ","وَمَن","فِي","ٱلۡأَرۡضِ","جَمِيعٗاۗ","وَلِلَّهِ","مُلۡكُ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِ","وَمَا","بَيۡنَهُمَاۚ","يَخۡلُقُ","مَا","يَشَآءُۚ","وَٱللَّهُ","عَلَىٰ","كُلِّ","شَيۡءٖ","قَدِيرٞ"],"ллаḳад кафарал лазиина ḳалуу инналлаха хуал масиихубну марйама ḳул фаман йамлику миналлахи шай'ан ин арада ан йухликал масиихабна марйама ва'уммахуу ваман фил арди жамии`ан валиллахи мулкус самавати вал'арди вама байнахума йахлуḳу ма йашау валлаху `ала кулли шай'ин ḳадиир","Не уверовали те, которые сказали: «Воистину, Аллах - это Мессия, сын Марьям (Марии)». Скажи: «Кто может хотя бы немного помешать Аллаху, если Он пожелает погубить Мессию, сына Марьям (Марии), его мать и всех, кто на земле?». Аллаху принадлежит власть над небесами, землей и тем, что между ними. Он создает, что пожелает. Аллах способен на всякую вещь.",["уже","не уверовали","те, которые","сказали","поистине","Аллах","Он","Мессия","сын","Марьям","скажи","кто же","властен","перед","Аллахом","чем-либо","если","Он пожелает","чтобы","погубить","Мессию","сына","Марьям","и его мать","и тех, кто","на","земле","всех","и Аллаху","власть","небес","и земли","и того, что","между ними","Он творит","что","Он пожелает","и Аллах","над","всякой","вещью","Всемогущ"]]],"m":[[["وَمِنَ","и у",5,14],["ٱلَّذِينَ","тех, которые",5,14],["قَالُوٓاْ","сказали",5,14],["إِنَّا","поистине, мы",5,14],["نَصَٰرَىٰٓ","христиане",5,14],["أَخَذۡنَا","Мы взяли",5,14],["مِيثَٰقَهُمۡ","их завет",5,14]],[["فَنَسُواْ","но они забыли",5,14],["حَظّٗا","долю",5,14],["مِّمَّا","из того, что",5,14],["ذُكِّرُواْ","им напоминалось",5,14],["بِهِۦ","о нём",5,14],["فَأَغۡرَيۡنَا","и Мы возбудили",5,14],["بَيۡنَهُمُ","между ними",5,14],["ٱلۡعَدَاوَةَ","вражду",5,14]],[["وَٱلۡبَغۡضَآءَ","и ненависть",5,14],["إِلَىٰ","до",5,14],["يَوۡمِ","Дня",5,14],["ٱلۡقِيَٰمَةِۚ","Воскресения",5,14],["وَسَوۡفَ","и скоро",5,14],["يُنَبِّئُهُمُ","сообщит им",5,14],["ٱللَّهُ","Аллах",5,14]],[["بِمَا","о том, что",5,14],["كَانُواْ","они",5,14],["يَصۡنَعُونَ","творили",5,14],[14],["يَٰٓأَهۡلَ","О люди",5,15],["ٱلۡكِتَٰبِ","Писания",5,15]],[["قَدۡ","уже",5,15],["جَآءَكُمۡ","пришёл к вам",5,15],["رَسُولُنَا","Наш Посланник",5,15],["يُبَيِّنُ","разъясняющий",5,15],["لَكُمۡ","вам",5,15],["كَثِيرٗا","многое",5,15],["مِّمَّا","из того, что",5,15]],[["كُنتُمۡ","вы",5,15],["تُخۡفُونَ","скрывали",5,15],["مِنَ","из",5,15],["ٱلۡكِتَٰبِ","Писания",5,15],["وَيَعۡفُواْ","и прощающий",5,15],["عَن","о",5,15]],[["كَثِيرٖۚ","многом",5,15],["قَدۡ","уже",5,15],["جَآءَكُم","пришёл к вам",5,15],["مِّنَ","от",5,15],["ٱللَّهِ","Аллаха",5,15],["نُورٞ","свет",5,15],["وَكِتَٰبٞ","и Писание",5,15]],[["مُّبِينٞ","ясное",5,15],[15],["يَهۡدِي","ведёт",5,16],["بِهِ","им",5,16],["ٱللَّهُ","Аллах",5,16],["مَنِ","того, кто",5,16],["ٱتَّبَعَ","последовал",5,16],["رِضۡوَٰنَهُۥ","Его довольству",5,16]],[["سُبُلَ","путями",5,16],["ٱلسَّلَٰمِ","мира",5,16],["وَيُخۡرِجُهُم","и выводит их",5,16],["مِّنَ","из",5,16],["ٱلظُّلُمَٰتِ","мраков",5,16],["إِلَى","к",5,16]],[["ٱلنُّورِ","свету",5,16],["بِإِذۡنِهِۦ","Его дозволением",5,16],["وَيَهۡدِيهِمۡ","и ведёт их",5,16],["إِلَىٰ","к",5,16],["صِرَٰطٖ","пути",5,16],["مُّسۡتَقِيمٖ","прямому",5,16]],[[16],["لَّقَدۡ","уже",5,17],["كَفَرَ","не 