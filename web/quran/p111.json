{"p":111,"j":6,"a":[[5,18,["وَقَالَتِ","ٱلۡيَهُودُ","وَٱلنَّصَٰرَىٰ","نَحۡنُ","أَبۡنَٰٓؤُاْ","ٱللَّهِ","وَأَحِبَّٰٓؤُهُۥۚ","قُلۡ","فَلِمَ","يُعَذِّبُكُم","بِذُنُوبِكُمۖ","بَلۡ","أَنتُم","بَشَرٞ","مِّمَّنۡ","خَلَقَۚ","يَغۡفِرُ","لِمَن","يَشَآءُ","وَيُعَذِّبُ","مَن","يَشَآءُۚ","وَلِلَّهِ","مُلۡكُ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِ","وَمَا","بَيۡنَهُمَاۖ","وَإِلَيۡهِ","ٱلۡمَصِيرُ"],"ваḳалатил йахууду ваннасара нахну абнауллахи ва'ахиббаухуу ḳул фалима йу`аззибукум бизунуубикум бал антум башарум мимман халаḳа йагфиру лиман йашау вайу`аззибу ман йашау валиллахи мулкус самавати вал'арди вама байнахума ва'илайхил масиир","Иудеи и христиане сказали: «Мы - сыны Аллаха и Его возлюбленные». Скажи: «Почему же Он причиняет вам мучения за ваши грехи? О нет! Вы всего лишь одни из людей, которых Он сотворил. Он прощает, кого пожелает, и причиняет мучения, кому пожелает. Аллаху принадлежит власть над небесами, землей и тем, что между ними, и к Нему предстоит прибытие».",["и сказали","иудеи","и христиане","мы","сыны","Аллаха","и Его любимцы","скажи","так почему","Он мучает вас","за ваши грехи","нет","вы","люди","из тех, кого","Он сотворил","Он прощает","тому, кому","Он пожелает","и мучает","кого","Он пожелает","и Аллаху","власть","небес","и земли","и того, что","между ними","и к Нему","возвращение"]],[5,19,["يَٰٓأَهۡلَ","ٱلۡكِتَٰبِ","قَدۡ","جَآءَكُمۡ","رَسُولُنَا","يُبَيِّنُ","لَكُمۡ","عَلَىٰ","فَتۡرَةٖ","مِّنَ","ٱلرُّسُلِ","أَن","تَقُولُواْ","مَا","جَآءَنَا","مِنۢ","بَشِيرٖ","وَلَا","نَذِيرٖۖ","فَقَدۡ","جَآءَكُم","بَشِيرٞ","وَنَذِيرٞۗ","وَٱللَّهُ","عَلَىٰ","كُلِّ","شَيۡءٖ","قَدِيرٞ"],"йа'ахлал китаби ḳад жаакум расуулуна йубаййину лакум `ала фатратим минар русули ан таḳуулуу ма жаана мим башиирин вала назиирин фаḳад жаакум башиирун ваназиирун валлаху `ала кулли шай'ин ḳадиир","О люди Писания! После периода, когда не было посланников, к вам явился Наш Посланник, давая вам разъяснения, дабы вы не говорили: «К нам не приходил добрый вестник и предостерегающий увещеватель». Добрый вестник и предостерегающий увещеватель уже явился к вам. Аллах способен на всякую вещь.",["О люди","Писания","уже","пришёл к вам","Наш Посланник","он разъясняет","вам","после","перерыва","в","посланниках","чтобы не","вы сказали","не","пришёл к нам","никакой","благовеститель","и не","предостерегающий","и вот уже","пришёл к вам","благовеститель","и предостерегающий","и Аллах","над","всякой","вещью","Всемогущ"]],[5,20,["وَإِذۡ","قَالَ","مُوسَىٰ","لِقَوۡمِهِۦ","يَٰقَوۡمِ","ٱذۡكُرُواْ","نِعۡمَةَ","ٱللَّهِ","عَلَيۡكُمۡ","إِذۡ","جَعَلَ","فِيكُمۡ","أَنۢبِيَآءَ","وَجَعَلَكُم","مُّلُوكٗا","وَءَاتَىٰكُم","مَّا","لَمۡ","يُؤۡتِ","أَحَدٗا","مِّنَ","ٱلۡعَٰلَمِينَ"],"ва'из ḳала мууса лиḳаумихии йаḳаумизкуруу ни`маталлахи `алайкум из жа`ала фиикум амбийаа важа`алакум мулуукан ва'атакум ма лам йу'ти ахадам минал `аламиин","Вот Муса (Моисей) сказал своему народу: «О мой народ! Помните милость, которую Аллах оказал вам, когда создал среди вас пророков, сделал вас царями и даровал вам то, чего не даровал никому из миров.",["и вот","сказал","Муса","своему народу","о мой народ","помните","милость","Аллаха","к вам","когда","Он поместил","среди вас","пророков","и сделал вас","царями","и даровал вам","то, что","не","Он давал","никому","из","миров"]],[5,21,["يَٰقَوۡمِ","ٱدۡخُلُواْ","ٱلۡأَرۡضَ","ٱلۡمُقَدَّسَةَ","ٱلَّتِي","كَتَبَ","ٱللَّهُ","لَكُمۡ","وَلَا","تَرۡتَدُّواْ","عَلَىٰٓ","أَدۡبَارِكُمۡ","فَتَنقَلِبُواْ","خَٰسِرِينَ"],"йаḳаумидхулул ардал муḳаддасатал латии катабаллаху лакум вала тартаддуу `ала адбарикум фатанḳалибуу хасириин","О мой народ! Ступите на священную землю, которую Аллах предписал вам, и не обращайтесь вспять, а не то вернетесь потерпевшими убыток».",["о мой народ","войдите в","землю","святую","которую","предписал","Аллах","вам","и не","отступайте","на","ваши спины","и окажетесь","потерпевшими убыток"]],[5,22,["قَالُواْ","يَٰمُوسَىٰٓ","إِنَّ","فِيهَا","قَوۡمٗا","جَبَّارِينَ","وَإِنَّا","لَن","نَّدۡخُلَهَا","حَتَّىٰ","يَخۡرُجُواْ","مِنۡهَا","فَإِن","يَخۡرُجُواْ","مِنۡهَا","فَإِنَّا","دَٰخِلُونَ"],"ḳалуу йамууса инна фииха ḳауман жаббариина ва'инна лан надхулаха хатта йахружуу минха фа'ин йахружуу минха фа'инна дахилуун","Они сказали: «О Муса (Моисей)! Там обитают могучие люди, и мы не войдем туда, пока они не уйдут оттуда. Если же они уйдут оттуда, то мы войдем».",["они сказали","о Муса","поистине","в ней","народ","могучий","и поистине, мы","никогда не","войдём в неё","пока не","они выйдут","из неё","и если","они выйдут","из неё","то поистине, мы","войдём"]],[5,23,["قَالَ","رَجُلَانِ","مِنَ","ٱلَّذِينَ","يَخَافُونَ","أَنۡعَمَ","ٱللَّهُ","عَلَيۡهِمَا","ٱدۡخُلُواْ","عَلَيۡهِمُ","ٱلۡبَابَ","فَإِذَا","دَخَلۡتُمُوهُ","فَإِنَّكُمۡ","غَٰلِبُونَۚ","وَعَلَى","ٱللَّهِ","فَتَوَكَّلُوٓاْ","إِن","كُنتُم","مُّؤۡمِنِينَ"],"ḳала ражулани минал лазиина йахафууна ан`амаллаху `алайхимадхулуу `алайхимул баба фа'иза дахалтумууху фа'иннакум галибууна ва`алаллахи фатаваккалуу ин кунтум му'миниин","Двое богобоязненных мужчин, которым Аллах оказал милость, сказали: «Входите к ним через ворота. Когда вы войдете туда, вы непременно одержите победу. Уповайте только на Аллаха, если вы являетесь верующими».",["сказали","двое мужчин","из","тех, которые","боялись","облагодетельствовал","Аллах","их обоих","войдите","к ним","через ворота","и когда","вы войдёте в них","то поистине, вы","победители","и на","Аллаха","уповайте","если","вы","верующие"]]],"m":[[["وَقَالَتِ","и сказали",5,18],["ٱلۡيَهُودُ","иудеи",5,18],["وَٱلنَّصَٰرَىٰ","и христиане",5,18],["نَحۡنُ","мы",5,18],["أَبۡنَٰٓؤُاْ","сыны",5,18],["ٱللَّهِ","Аллаха",5,18],["وَأَحِبَّٰٓؤُهُۥۚ","и Его любимцы",5,18],["قُلۡ","скажи",5,18]],[["فَلِمَ","так почему",5,18],["يُعَذِّبُكُم","Он мучает вас",5,18],["بِذُنُوبِكُمۖ","за ваши грехи",5,18],["بَلۡ","нет",5,18],["أَنتُم","вы",5,18],["بَشَرٞ","люди",5,18],["مِّمَّنۡ","из тех, кого",5,18],["خَلَقَۚ","Он сотворил",5,18],["يَغۡفِرُ","Он прощает",5,18],["لِمَن","тому, кому",5,18]],[["يَشَآءُ","Он пожелает",5,18],["وَيُعَذِّبُ","и мучает",5,18],["مَن","кого",5,18],["يَشَآءُۚ","Он пожелает",5,18],["وَلِلَّهِ","и Аллаху",5,18],["مُلۡكُ","власть",5,18],["ٱلسَّمَٰوَٰتِ","небес",5,18],["وَٱلۡأَرۡضِ","и земли",5,18]],[["وَمَا","и того, что",5,18],["بَيۡنَهُمَاۖ","между ними",5,18],["وَإِلَيۡهِ","и к Нему",5,18],["ٱلۡمَصِيرُ","возвращение",5,18],[18],["يَٰٓأَهۡلَ","О люди",5,19],["ٱلۡكِتَٰبِ","Писания",5,19],["قَدۡ","уже",5,19],["جَآءَكُمۡ","пришёл к вам",5,19]],[["رَسُولُنَا","Наш Посланник",5,19],["يُبَيِّنُ","он разъясняет",5,19],["لَكُمۡ","вам",5,19],["عَلَىٰ","после",5,19],["فَتۡرَةٖ","перерыва",5,19],["مِّنَ","в",5,19],["ٱلرُّسُلِ","посланниках",5,19],["أَن","чтобы не",5,19],["تَقُولُواْ","вы сказали",5,19],["مَا","не",5,19],["جَآءَنَا","пришёл к нам",5,19]],[["مِنۢ","никакой",5,19],["بَشِيرٖ","благовеститель",5,19],["وَلَا","и не",5,19],["نَذِيرٖۖ","предостерегающий",5,19],["فَقَدۡ","и вот уже",5,19],["جَآءَكُم","пришёл к вам",5,19],["بَشِيرٞ","благовеститель",5,19],["وَنَذِيرٞۗ","и предостерегающий",5,19],["وَٱللَّهُ","и Аллах",5,19],["عَلَىٰ","над",5,19],["كُلِّ","всякой",5,19]],[["شَيۡءٖ","вещью",5,19],["قَدِيرٞ","Всемогущ",5,19],[19],["وَإِذۡ","и вот",5,20],["قَالَ","сказал",5,20],["مُوسَىٰ","Муса",5,20],["لِقَوۡمِهِۦ","своему народу",5,20],["يَٰقَوۡمِ","о мой народ",5,20],["ٱذۡكُرُواْ","помните",5,20]],[["نِعۡمَةَ","милость",5,20],["ٱللَّهِ","Аллаха",5,20],["عَلَيۡكُمۡ","к вам",5,20],["إِذۡ","когда",5,20],["جَعَلَ","Он поместил",5,20],["فِيكُمۡ","среди вас",5,20],["أَنۢبِيَآءَ","пророков",5,20],["وَجَعَلَكُم","и сделал вас",5,20],["مُّلُوكٗا","царями",5,20]],[["وَءَاتَىٰكُم","и даровал вам",5,20],["مَّا","то, что",5,20],["لَمۡ","не",5,20],["يُؤۡتِ","Он давал",5,20],["أَحَدٗا","никому",5,20],["مِّنَ","из",5,20],["ٱلۡعَٰلَمِينَ","миров",5,20],[20],["يَٰقَوۡمِ","о мой народ",5,21],["ٱدۡخُلُواْ","войдите в",5,21]],[["ٱلۡأَرۡضَ","землю",5,21],["ٱلۡمُقَدَّسَةَ","святую",5,21],["ٱلَّتِي","которую",5,21],["كَتَبَ","предписал",5,21],["ٱللَّهُ","Аллах",5,21],["لَكُمۡ","вам",5,21],["وَلَا","и не",5,21],["تَرۡتَدُّواْ","отступайте",5,21],["عَلَىٰٓ","на",5,21],["أَدۡبَارِكُمۡ","ваши спины",5,21]],[["فَتَنقَلِبُواْ","и окажетесь",5,21],["خَٰسِرِينَ","потерпевшими убыток",5,21],[21],["قَالُواْ","они сказали",5,22],["يَٰمُوسَىٰٓ","о Муса",5,22],["إِنَّ","поистине",5,22],["فِيهَا","в ней",5,22],["قَوۡمٗا","народ",5,22],["جَبَّارِينَ","могучий",5,22]],[["وَإِنَّا","и поистине, мы",5,22],["لَن","никогда не",5,22],["نَّدۡخُلَهَا","войдём в неё",5,22],["حَتَّىٰ","пока не",5,22],["يَخۡرُجُواْ","они выйдут",5,22],["مِنۡهَا","из неё",5,22],["فَإِن","и если",5,22],["يَخۡرُجُواْ","они выйдут",5,22],["مِنۡهَا","из неё",5,22]],[["فَإِنَّا","то поистине, мы",5,22],["دَٰخِلُونَ","войдём",5,22],[22],["قَالَ","сказали",5,23],["رَجُلَانِ","двое мужчин",5,23],["مِنَ","из",5,23],["ٱلَّذِينَ","тех, которые",5,23],["يَخَافُونَ","боялись",5,23]],[["أَنۡعَمَ","облагодетельствовал",5,23],["ٱللَّهُ","Аллах",5,23],["عَلَيۡهِمَا","их обоих",5,23],["ٱدۡخُلُواْ","войдите",5,23],["عَلَيۡهِمُ","к ним",5,23],["ٱلۡبَابَ","через ворота",5,23],["فَإِذَا","и когда",5,23],["دَخَلۡتُمُوهُ","вы войдёте в них",5,23]],[["فَإِنَّكُمۡ","то поистине, вы",5,23],["غَٰلِبُونَۚ","победители",5,23],["وَعَلَى","и на",5,23],["ٱللَّهِ","Аллаха",5,23],["فَتَوَكَّلُوٓاْ","уповайте",5,23],["إِن","если",5,23],["كُنتُم","вы",5,23],["مُّؤۡمِنِينَ","верующие",5,23],[23]]]}