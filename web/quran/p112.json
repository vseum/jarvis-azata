{"p":112,"j":6,"a":[[5,24,["قَالُواْ","يَٰمُوسَىٰٓ","إِنَّا","لَن","نَّدۡخُلَهَآ","أَبَدٗا","مَّا","دَامُواْ","فِيهَا","فَٱذۡهَبۡ","أَنتَ","وَرَبُّكَ","فَقَٰتِلَآ","إِنَّا","هَٰهُنَا","قَٰعِدُونَ"],"ḳалуу йамууса инна лан надхулаха абадам ма дамуу фииха фазхаб анта вараббука фаḳатила инна хахуна ḳа`идуун","Они сказали: «О Муса (Моисей)! Мы ни за что не войдем туда, пока они находятся там. Ступай и сражайся вместе со своим Господом, мы же посидим здесь».",["они сказали","о Муса","поистине, мы","никогда не","войдём в неё","вовек","пока","они остаются","в ней","так иди","ты","и твой Господь","и сражайтесь вдвоём","поистине, мы","здесь","сидим"]],[5,25,["قَالَ","رَبِّ","إِنِّي","لَآ","أَمۡلِكُ","إِلَّا","نَفۡسِي","وَأَخِيۖ","فَٱفۡرُقۡ","بَيۡنَنَا","وَبَيۡنَ","ٱلۡقَوۡمِ","ٱلۡفَٰسِقِينَ"],"ḳала рабби иннии ла амлику илла нафсии ва'ахии фафруḳ байнана вабайнал ḳаумил фасиḳиин","Он сказал: «Господи! Я властен только над самим собой и моим братом. Разлучи же нас с (или рассуди между нами и) нечестивыми людьми».",["он сказал","Господи","поистине, я","не","владею","кроме как","собой","и моим братом","так разлучи","между нами","и между","народом","нечестивым"]],[5,26,["قَالَ","فَإِنَّهَا","مُحَرَّمَةٌ","عَلَيۡهِمۡۛ","أَرۡبَعِينَ","سَنَةٗۛ","يَتِيهُونَ","فِي","ٱلۡأَرۡضِۚ","فَلَا","تَأۡسَ","عَلَى","ٱلۡقَوۡمِ","ٱلۡفَٰسِقِينَ"],"ḳала фа'иннаха мухарраматун `алайхим арба`иина санатан йатиихууна фил арди фала та'са `алал ḳаумил фасиḳиин","Он сказал: «Тогда она будет запретна для них в течение сорока лет. Они будут скитаться по земле. Не печалься же о нечестивых людях».",["Он сказал","так поистине, она","запрещена","им","сорок","лет","они будут скитаться","по","земле","так не","печалься","о","народе","нечестивом"]],[5,27,["وَٱتۡلُ","عَلَيۡهِمۡ","نَبَأَ","ٱبۡنَيۡ","ءَادَمَ","بِٱلۡحَقِّ","إِذۡ","قَرَّبَا","قُرۡبَانٗا","فَتُقُبِّلَ","مِنۡ","أَحَدِهِمَا","وَلَمۡ","يُتَقَبَّلۡ","مِنَ","ٱلۡأٓخَرِ","قَالَ","لَأَقۡتُلَنَّكَۖ","قَالَ","إِنَّمَا","يَتَقَبَّلُ","ٱللَّهُ","مِنَ","ٱلۡمُتَّقِينَ"],"ватлу `алайхим набаабнай адама билхаḳḳи из ḳарраба ḳурбанан фатуḳуббила мин ахадихима валам йутаḳаббал минал ахари ḳала ла'аḳтуланнака ḳала иннама йатаḳаббалуллаху минал муттаḳиин","Прочти им истинный рассказ о двух сыновьях Адама. Вот они оба принесли жертву, и она была принята от одного из них и была не принята от другого. Он сказал: «Я непременно убью тебя». Он ответил: «Воистину, Аллах принимает только от богобоязненных.",["и прочти","им","весть","о двух сыновьях","Адама","по истине","когда","они оба принесли","жертву","и была принята","от","одного из них","и не","была принята","от","другого","он сказал","непременно я убью тебя","он сказал","лишь","принимает","Аллах","от","богобоязненных"]],[5,28,["لَئِنۢ","بَسَطتَ","إِلَيَّ","يَدَكَ","لِتَقۡتُلَنِي","مَآ","أَنَا۠","بِبَاسِطٖ","يَدِيَ","إِلَيۡكَ","لِأَقۡتُلَكَۖ","إِنِّيٓ","أَخَافُ","ٱللَّهَ","رَبَّ","ٱلۡعَٰلَمِينَ"],"ла'им басатта илаййа йадака литаḳтулании ма ана бибаситин йадийа илайка ли'аḳтулака иннии ахафуллаха раббал `аламиин","Если ты протянешь ко мне руку, чтобы убить меня, я все равно не протяну руки, чтобы убить тебя. Воистину, я боюсь Аллаха, Господа миров.",["если же","ты протянешь","ко мне","свою руку","чтобы убить меня","не","я","протяну","свою руку","к тебе","чтобы убить тебя","поистине, я","боюсь","Аллаха","Господа","миров"]],[5,29,["إِنِّيٓ","أُرِيدُ","أَن","تَبُوٓأَ","بِإِثۡمِي","وَإِثۡمِكَ","فَتَكُونَ","مِنۡ","أَصۡحَٰبِ","ٱلنَّارِۚ","وَذَٰلِكَ","جَزَٰٓؤُاْ","ٱلظَّٰلِمِينَ"],"иннии урииду ан табууа би'исмии ва'исмика фатакууна мин асхабин нари вазалика жазауз залимиин","Я хочу, чтобы ты вернулся с моим грехом и твоим грехом и оказался среди обитателей Огня. Таково воздаяние беззаконникам».",["поистине, я","хочу","чтобы","ты понёс","мой грех","и твой грех","и оказался","из","обитателей","Огня","и это","воздаяние","беззаконников"]],[5,30,["فَطَوَّعَتۡ","لَهُۥ","نَفۡسُهُۥ","قَتۡلَ","أَخِيهِ","فَقَتَلَهُۥ","فَأَصۡبَحَ","مِنَ","ٱلۡخَٰسِرِينَ"],"фатавва`ат лахуу нафсухуу ḳатла ахиихи фаḳаталахуу фа'асбаха минал хасириин","Душа подтолкнула его на убийство своего брата, и он убил его и оказался одним из потерпевших убыток.",["и подтолкнула","его","его душа","к убийству","его брата","и он убил его","и стал","из","потерпевших убыток"]],[5,31,["فَبَعَثَ","ٱللَّهُ","غُرَابٗا","يَبۡحَثُ","فِي","ٱلۡأَرۡضِ","لِيُرِيَهُۥ","كَيۡفَ","يُوَٰرِي","سَوۡءَةَ","أَخِيهِۚ","قَالَ","يَٰوَيۡلَتَىٰٓ","أَعَجَزۡتُ","أَنۡ","أَكُونَ","مِثۡلَ","هَٰذَا","ٱلۡغُرَابِ","فَأُوَٰرِيَ","سَوۡءَةَ","أَخِيۖ","فَأَصۡبَحَ","مِنَ","ٱلنَّٰدِمِينَ"],"фаба`асаллаху гурабан йабхасу фил арди лийурийахуу кайфа йуарии сауата ахиихи ḳала йавайлата а`ажазту ан акууна мисла хазал гураби фа'уарийа сауата ахии фа'асбаха минан надимиин","Аллах послал ворона, который стал разгребать землю, чтобы показать ему, как спрятать труп его брата. Он сказал: «Горе мне! Неужели я не могу поступить, как этот ворон, и спрятать труп моего брата?». Так он оказался одним из сожалеющих.",["и послал","Аллах","ворона","который рыл","в","земле","чтобы показать ему","как","скрыть","тело","его брата","он сказал","горе мне","неужели я не в силах","чтобы","быть","подобным","этому","ворону","и скрыть","тело","моего брата","и стал","из","раскаявшихся"]]],"m":[[["قَالُواْ","они сказали",5,24],["يَٰمُوسَىٰٓ","о Муса",5,24],["إِنَّا","поистине, мы",5,24],["لَن","никогда не",5,24],["نَّدۡخُلَهَآ","войдём в неё",5,24],["أَبَدٗا","вовек",5,24],["مَّا","пока",5,24],["دَامُواْ","они остаются",5,24],["فِيهَا","в ней",5,24],["فَٱذۡهَبۡ","так иди",5,24]],[["أَنتَ","ты",5,24],["وَرَبُّكَ","и твой Господь",5,24],["فَقَٰتِلَآ","и сражайтесь вдвоём",5,24],["إِنَّا","поистине, мы",5,24],["هَٰهُنَا","здесь",5,24],["قَٰعِدُونَ","сидим",5,24],[24],["قَالَ","он сказал",5,25],["رَبِّ","Господи",5,25]],[["إِنِّي","поистине, я",5,25],["لَآ","не",5,25],["أَمۡلِكُ","владею",5,25],["إِلَّا","кроме как",5,25],["نَفۡسِي","собой",5,25],["وَأَخِيۖ","и моим братом",5,25],["فَٱفۡرُقۡ","так разлучи",5,25],["بَيۡنَنَا","между нами",5,25],["وَبَيۡنَ","и между",5,25],["ٱلۡقَوۡمِ","народом",5,25]],[["ٱلۡفَٰسِقِينَ","нечестивым",5,25],[25],["قَالَ","Он сказал",5,26],["فَإِنَّهَا","так поистине, она",5,26],["مُحَرَّمَةٌ","запрещена",5,26],["عَلَيۡهِمۡۛ","им",5,26],["أَرۡبَعِينَ","сорок",5,26],["سَنَةٗۛ","лет",5,26]],[["يَتِيهُونَ","они будут скитаться",5,26],["فِي","по",5,26],["ٱلۡأَرۡضِۚ","земле",5,26],["فَلَا","так не",5,26],["تَأۡسَ","печалься",5,26],["عَلَى","о",5,26],["ٱلۡقَوۡمِ","народе",5,26],["ٱلۡفَٰسِقِينَ","нечестивом",5,26]],[[26],["۞ وَٱتۡلُ","и прочти",5,27],["عَلَيۡهِمۡ","им",5,27],["نَبَأَ","весть",5,27],["ٱبۡنَيۡ","о двух сыновьях",5,27],["ءَادَمَ","Адама",5,27],["بِٱلۡحَقِّ","по истине",5,27],["إِذۡ","когда",5,27],["قَرَّبَا","они оба принесли",5,27],["قُرۡبَانٗا","жертву",5,27]],[["فَتُقُبِّلَ","и была принята",5,27],["مِنۡ","от",5,27],["أَحَدِهِمَا","одного из них",5,27],["وَلَمۡ","и не",5,27],["يُتَقَبَّلۡ","была принята",5,27],["مِنَ","от",5,27],["ٱلۡأٓخَرِ","другого",5,27],["قَالَ","он сказал",5,27],["لَأَقۡتُلَنَّكَۖ","непременно я убью тебя",5,27]],[["قَالَ","он сказал",5,27],["إِنَّمَا","лишь",5,27],["يَتَقَبَّلُ","принимает",5,27],["ٱللَّهُ","Аллах",5,27],["مِنَ","от",5,27],["ٱلۡمُتَّقِينَ","богобоязненных",5,27],[27],["لَئِنۢ","если же",5,28],["بَسَطتَ","ты протянешь",5,28],["إِلَيَّ","ко мне",5,28],["يَدَكَ","свою руку",5,28]],[["لِتَقۡتُلَنِي","чтобы убить меня",5,28],["مَآ","не",5,28],["أَنَا۠","я",5,28],["بِبَاسِطٖ","протяну",5,28],["يَدِيَ","свою руку",5,28],["إِلَيۡكَ","к тебе",5,28],["لِأَقۡتُلَكَۖ","чтобы убить тебя",5,28],["إِنِّيٓ","поистине, я",5,28],["أَخَافُ","боюсь",5,28],["ٱللَّهَ","Аллаха",5,28]],[["رَبَّ","Господа",5,28],["ٱلۡعَٰلَمِينَ","миров",5,28],[28],["إِنِّيٓ","поистине, я",5,29],["أُرِيدُ","хочу",5,29],["أَن","чтобы",5,29],["تَبُوٓأَ","ты понёс",5,29],["بِإِثۡمِي","мой грех",5,29],["وَإِثۡمِكَ","и твой грех",5,29],["فَتَكُونَ","и оказался",5,29]],[["مِنۡ","из",5,29],["أَصۡحَٰبِ","обитателей",5,29],["ٱلنَّارِۚ","Огня",5,29],["وَذَٰلِكَ","и это",5,29],["جَزَٰٓؤُاْ","воздаяние",5,29