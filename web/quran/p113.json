{"p":113,"j":6,"a":[[5,32,["مِنۡ","أَجۡلِ","ذَٰلِكَ","كَتَبۡنَا","عَلَىٰ","بَنِيٓ","إِسۡرَٰٓءِيلَ","أَنَّهُۥ","مَن","قَتَلَ","نَفۡسَۢا","بِغَيۡرِ","نَفۡسٍ","أَوۡ","فَسَادٖ","فِي","ٱلۡأَرۡضِ","فَكَأَنَّمَا","قَتَلَ","ٱلنَّاسَ","جَمِيعٗا","وَمَنۡ","أَحۡيَاهَا","فَكَأَنَّمَآ","أَحۡيَا","ٱلنَّاسَ","جَمِيعٗاۚ","وَلَقَدۡ","جَآءَتۡهُمۡ","رُسُلُنَا","بِٱلۡبَيِّنَٰتِ","ثُمَّ","إِنَّ","كَثِيرٗا","مِّنۡهُم","بَعۡدَ","ذَٰلِكَ","فِي","ٱلۡأَرۡضِ","لَمُسۡرِفُونَ"],"мин ажли залика катабна `ала бании исраиила аннахуу ман ḳатала нафса бигайри нафсин ау фасадин фил арди факааннама ḳаталан наса жамии`ан ваман ахйаха факааннама ахйан наса жамии`ан валаḳад жаатхум русулуна билбаййинати сумма инна касиирам минхум ба`да залика фил арди ламусрифуун","По этой причине Мы предписали сынам Исраила (Израиля): кто убьет человека не за убийство или распространение нечестия на земле, тот словно убил всех людей, а кто сохранит жизнь человеку, тот словно сохранит жизнь всем людям. Наши посланники уже явились к ним с ясными знамениями, но многие из них после этого излишествуют на земле.",["из-за","причины","этой","Мы предписали","для","сынов","Исраила","что тот","кто","убьёт","душу","не за","душу","или","(за) нечестие","на","земле","то словно","убил","людей","всех","и кто","сохранит ей жизнь","то словно","сохранил жизнь","людям","всем","и уже","пришли к ним","Наши посланники","с ясными знамениями","затем","поистине","многие","из них","после","этого","на","земле","непременно излишествуют"]],[5,33,["إِنَّمَا","جَزَٰٓؤُاْ","ٱلَّذِينَ","يُحَارِبُونَ","ٱللَّهَ","وَرَسُولَهُۥ","وَيَسۡعَوۡنَ","فِي","ٱلۡأَرۡضِ","فَسَادًا","أَن","يُقَتَّلُوٓاْ","أَوۡ","يُصَلَّبُوٓاْ","أَوۡ","تُقَطَّعَ","أَيۡدِيهِمۡ","وَأَرۡجُلُهُم","مِّنۡ","خِلَٰفٍ","أَوۡ","يُنفَوۡاْ","مِنَ","ٱلۡأَرۡضِۚ","ذَٰلِكَ","لَهُمۡ","خِزۡيٞ","فِي","ٱلدُّنۡيَاۖ","وَلَهُمۡ","فِي","ٱلۡأٓخِرَةِ","عَذَابٌ","عَظِيمٌ"],"иннама жазаул лазиина йухарибууналлаха варасуулахуу вайас`ауна фил арди фасадан ан йуḳатталуу ау йусаллабуу ау туḳатта`а айдиихим ва'аржулухум мин хилафин ау йунфау минал арди залика лахум хизйун фид дунйа валахум фил ахирати `азабун `азиим","Воистину, те, которые сражаются против Аллаха и Его Посланника и стремятся сотворить на земле нечестие, в воздаяние должны быть убиты или распяты, или у них должны быть отсечены накрест руки и ноги, или они должны быть изгнаны из страны. Это будет для них позором в этом мире, а в Последней жизни для них уготованы великие мучения.",["лишь","воздаяние","тех, которые","воюют","с Аллахом","и Его Посланником","и стремятся","на","земле","(сеять) нечестие","(в том) чтобы","были убиты","или","были распяты","или","были отсечены","их руки","и их ноги","с","противоположных сторон","или","были изгнаны","из","страны","это","для них","позор","в","этом мире","и для них","в","Последней жизни","наказание","великое"]],[5,34,["إِلَّا","ٱلَّذِينَ","تَابُواْ","مِن","قَبۡلِ","أَن","تَقۡدِرُواْ","عَلَيۡهِمۡۖ","فَٱعۡلَمُوٓاْ","أَنَّ","ٱللَّهَ","غَفُورٞ","رَّحِيمٞ"],"иллал лазиина табуу мин ḳабли ан таḳдируу `алайхим фа`ламуу анналлаха гафуурур рахиим","Исключением являются те, которые раскаялись и вернулись до того, как вы получили власть над ними. Знайте же, что Аллах - Прощающий, Милосердный.",["кроме","тех, которые","раскаялись","ещё","до того","как","вы одолеете","их","то знайте","что","Аллах","Прощающий","Милосердный"]],[5,35,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُواْ","ٱتَّقُواْ","ٱللَّهَ","وَٱبۡتَغُوٓاْ","إِلَيۡهِ","ٱلۡوَسِيلَةَ","وَجَٰهِدُواْ","فِي","سَبِيلِهِۦ","لَعَلَّكُمۡ","تُفۡلِحُونَ"],"йа'аййухал лазиина амануттаḳуллаха вабтагуу илайхил васиилата важахидуу фии сабиилихии ла`аллакум туфлихуун","О те, которые уверовали! Бойтесь Аллаха, ищите близости к Нему и сражайтесь на Его пути, - быть может, вы преуспеете.",["о","те, которые","уверовали","бойтесь","Аллаха","и ищите","к Нему","приближения","и боритесь","на","Его пути","быть может, вы","преуспеете"]],[5,36,["إِنَّ","ٱلَّذِينَ","كَفَرُواْ","لَوۡ","أَنَّ","لَهُم","مَّا","فِي","ٱلۡأَرۡضِ","جَمِيعٗا","وَمِثۡلَهُۥ","مَعَهُۥ","لِيَفۡتَدُواْ","بِهِۦ","مِنۡ","عَذَابِ","يَوۡمِ","ٱلۡقِيَٰمَةِ","مَا","تُقُبِّلَ","مِنۡهُمۡۖ","وَلَهُمۡ","عَذَابٌ","أَلِيمٞ"],"иннал лазиина кафаруу лау анна лахум ма фил арди жамии`ан вамислахуу ма`ахуу лийафтадуу бихии мин `азаби йаумил ḳийамати ма туḳуббила минхум валахум `азабун алиим","Воистину, если бы у неверующих было все, что есть на земле, и еще столько же, чтобы откупиться от мучений в День воскресения, то это не было бы принято от них. Им уготованы мучительные страдания.",["поистине","те, которые","не уверовали","если бы","что","у них","то, что","на","земле","всё","и подобное ему","вместе с ним","чтобы откупиться","этим","от","наказания","Дня","Воскресения","не","было бы принято","от них","и для них","наказание","мучительное"]]],"m":[[["مِنۡ","из-за",5,32],["أَجۡلِ","причины",5,32],["ذَٰلِكَ","этой",5,32],["كَتَبۡنَا","Мы предписали",5,32],["عَلَىٰ","для",5,32],["بَنِيٓ","сынов",5,32],["إِسۡرَٰٓءِيلَ","Исраила",5,32],["أَنَّهُۥ","что тот",5,32],["مَن","кто",5,32],["قَتَلَ","убьёт",5,32]],[["نَفۡسَۢا","душу",5,32],["بِغَيۡرِ","не за",5,32],["نَفۡسٍ","душу",5,32],["أَوۡ","или",5,32],["فَسَادٖ","(за) нечестие",5,32],["فِي","на",5,32],["ٱلۡأَرۡضِ","земле",5,32],["فَكَأَنَّمَا","то словно",5,32],["قَتَلَ","убил",5,32]],[["ٱلنَّاسَ","людей",5,32],["جَمِيعٗا","всех",5,32],["وَمَنۡ","и кто",5,32],["أَحۡيَاهَا","сохранит ей жизнь",5,32],["فَكَأَنَّمَآ","то словно",5,32],["أَحۡيَا","сохранил жизнь",5,32],["ٱلنَّاسَ","людям",5,32]],[["جَمِيعٗاۚ","всем",5,32],["وَلَقَدۡ","и уже",5,32],["جَآءَتۡهُمۡ","пришли к ним",5,32],["رُسُلُنَا","Наши посланники",5,32],["بِٱلۡبَيِّنَٰتِ","с ясными знамениями",5,32],["ثُمَّ","затем",5,32],["إِنَّ","поистине",5,32],["كَثِيرٗا","многие",5,32]],[["مِّنۡهُم","из них",5,32],["بَعۡدَ","после",5,32],["ذَٰلِكَ","этого",5,32],["فِي","на",5,32],["ٱلۡأَرۡضِ","земле",5,32],["لَمُسۡرِفُونَ","непременно излишествуют",5,32],[32],["إِنَّمَا","лишь",5,33]],[["جَزَٰٓؤُاْ","воздаяние",5,33],["ٱلَّذِينَ","тех, которые",5,33],["يُحَارِبُونَ","воюют",5,