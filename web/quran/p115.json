{"p":115,"j":6,"a":[[5,42,["سَمَّٰعُونَ","لِلۡكَذِبِ","أَكَّٰلُونَ","لِلسُّحۡتِۚ","فَإِن","جَآءُوكَ","فَٱحۡكُم","بَيۡنَهُمۡ","أَوۡ","أَعۡرِضۡ","عَنۡهُمۡۖ","وَإِن","تُعۡرِضۡ","عَنۡهُمۡ","فَلَن","يَضُرُّوكَ","شَيۡـٔٗاۖ","وَإِنۡ","حَكَمۡتَ","فَٱحۡكُم","بَيۡنَهُم","بِٱلۡقِسۡطِۚ","إِنَّ","ٱللَّهَ","يُحِبُّ","ٱلۡمُقۡسِطِينَ"],"самма`ууна лилказиби аккалууна лиссухти фа'ин жауука фахкум байнахум ау а`рид `анхум ва'ин ту`рид `анхум фалан йадурруука шай'ан ва'ин хакамта фахкум байнахум билḳисти инналлаха йухиббул муḳситиин","Они охотно выслушивают ложь и пожирают запретное. Если они явятся к тебе, то рассуди их или же отвернись от них. Если ты отвернешься от них, то они нисколько не навредят тебе. Но если ты вынесешь решение, то суди их беспристрастно. Воистину, Аллах любит беспристрастных.",["охотно слушающие","ложь","пожирающие","запретное","и если","придут к тебе","то суди","между ними","или","отвернись","от них","и если","ты отвернёшься","от них","то никак не","навредят тебе","ничем","а если","ты судишь","то суди","между ними","по справедливости","поистине","Аллах","любит","справедливых"]],[5,43,["وَكَيۡفَ","يُحَكِّمُونَكَ","وَعِندَهُمُ","ٱلتَّوۡرَىٰةُ","فِيهَا","حُكۡمُ","ٱللَّهِ","ثُمَّ","يَتَوَلَّوۡنَ","مِنۢ","بَعۡدِ","ذَٰلِكَۚ","وَمَآ","أُوْلَٰٓئِكَ","بِٱلۡمُؤۡمِنِينَ"],"вакайфа йухаккимуунака ва`индахумут таурату фииха хукмуллахи сумма йатаваллауна мим ба`ди залика вама улаика билму'миниин","Но как они выберут тебя судьей, если у них есть Таурат (Тора), содержащий закон Аллаха? Даже после этого они отворачиваются, ибо они не являются верующими.",["и как","они делают тебя судьёй","тогда как у них","Таурат","в нём","решение","Аллаха","затем","они отворачиваются","(даже)","после","этого","и не","те","верующие"]],[5,44,["إِنَّآ","أَنزَلۡنَا","ٱلتَّوۡرَىٰةَ","فِيهَا","هُدٗى","وَنُورٞۚ","يَحۡكُمُ","بِهَا","ٱلنَّبِيُّونَ","ٱلَّذِينَ","أَسۡلَمُواْ","لِلَّذِينَ","هَادُواْ","وَٱلرَّبَّٰنِيُّونَ","وَٱلۡأَحۡبَارُ","بِمَا","ٱسۡتُحۡفِظُواْ","مِن","كِتَٰبِ","ٱللَّهِ","وَكَانُواْ","عَلَيۡهِ","شُهَدَآءَۚ","فَلَا","تَخۡشَوُاْ","ٱلنَّاسَ","وَٱخۡشَوۡنِ","وَلَا","تَشۡتَرُواْ","بِـَٔايَٰتِي","ثَمَنٗا","قَلِيلٗاۚ","وَمَن","لَّمۡ","يَحۡكُم","بِمَآ","أَنزَلَ","ٱللَّهُ","فَأُوْلَٰٓئِكَ","هُمُ","ٱلۡكَٰفِرُونَ"],"инна анзалнат таурата фииха худан вануурун йахкуму бихан набиййуунал лазиина асламуу лиллазиина хадуу варраббаниййууна вал'ахбару бимастухфизуу мин китабиллахи вакануу `алайхи шухадаа фала тахшавун наса вахшауни вала таштаруу би'айатии саманан ḳалиилан вамал лам йахкум бима анзалаллаху фа'улаика хумул кафируун","Мы ниспослали Таурат (Тору), в котором содержится верное руководство и свет. Покорившиеся пророки выносили по нему решения для исповедующих иудаизм. Раввины и первосвященники поступали таким же образом в соответствии с тем, что им было поручено сохранить из Писания Аллаха. Они свидетельствовали о нем. Не бойтесь же людей, а бойтесь Меня, и не продавайте Мои знамения за ничтожную цену. Те же, которые не принимают решений в соответствии с тем, что ниспослал Аллах, являются неверующими.",["поистине Мы","ниспослали","Таурат","в нём","руководство","и свет","судят","по нему","пророки","которые","покорились","для тех, которые","исповедуют иудаизм","и раввины","и первосвященники","тем, что","им поручено хранить","из","Писания","Аллаха","и были они","о нём","свидетелями","так не","бойтесь","людей","и бойтесь Меня","и не","продавайте","Мои знамения","за цену","малую","и кто","не","судит","по тому, что","ниспослал","Аллах","то те","они","неверующие"]],[5,45,["وَكَتَبۡنَا","عَلَيۡهِمۡ","فِيهَآ","أَنَّ","ٱلنَّفۡسَ","بِٱلنَّفۡسِ","وَٱلۡعَيۡنَ","بِٱلۡعَيۡنِ","وَٱلۡأَنفَ","بِٱلۡأَنفِ","وَٱلۡأُذُنَ","بِٱلۡأُذُنِ","وَٱلسِّنَّ","بِٱلسِّنِّ","وَٱلۡجُرُوحَ","قِصَاصٞۚ","فَمَن","تَصَدَّقَ","بِهِۦ","فَهُوَ","كَفَّارَةٞ","لَّهُۥۚ","وَمَن","لَّمۡ","يَحۡكُم","بِمَآ","أَنزَلَ","ٱللَّهُ","فَأُوْلَٰٓئِكَ","هُمُ","ٱلظَّٰلِمُونَ"],"вакатабна `алайхим фииха аннан нафса биннафси вал`айна бил`айни вал'анфа бил'анфи вал'узуна бил'узуни вассинна биссинни валжурууха ḳисасун фаман тасаддаḳа бихии фахуа каффаратул лахуу вамал лам йахкум бима анзалаллаху фа'улаика хумуз залимуун","Мы предписали им в нем: душа - за душу, око - за око, нос - за нос, ухо - за ухо, зуб - за зуб, а за раны - возмездие. Но если кто-нибудь пожертвует этим, то это станет для него искуплением. Те же, которые не принимают решений в соответствии с тем, что ниспослал Аллах, являются беззаконниками.",["и Мы предписали","им","в нём","что","душа","за душу","и глаз","за глаз","и нос","за нос","и ухо","за ухо","и зуб","за зуб","и раны","возмездие","а кто","пожертвует","этим","то это","искупление","для него","и кто","не","судит","по тому, что","ниспослал","Аллах","то те","они","беззаконники"]]],"m":[[["سَمَّٰعُونَ","охотно слушающие",5,42],["لِلۡكَذِبِ","ложь",5,42],["أَكَّٰلُونَ","пожирающие",5,42],["لِلسُّحۡتِۚ","запретное",5,42],["فَإِن","и если",5,42],["جَآءُوكَ","придут к тебе",5,42]],[["فَٱحۡكُم","то суди",5,42],["بَيۡنَهُمۡ","между ними",5,42],["أَوۡ","или",5,42],["أَعۡرِضۡ","отвернись",5,42],["عَنۡهُمۡۖ","от них",5,42],["وَإِن","и если",5,42],["تُعۡرِضۡ","ты отвернёшься",5,42],["عَنۡهُمۡ","от них",5,42],["فَلَن","то никак не",5,42]],[["يَضُرُّوكَ","навредят тебе",5,42],["شَيۡـٔٗاۖ","ничем",5,42],["وَإِنۡ","а если",5,42],["حَكَمۡتَ","ты судишь",5,42],["فَٱحۡكُم","то суди",5,42],["بَيۡنَهُم","между ними",5,42],["بِٱلۡقِسۡطِۚ","по справедливости",5,42]],[["إِنَّ","поистине",5,42],["ٱللَّهَ","Аллах",5,42],["يُحِبُّ","любит",5,42],["ٱلۡمُقۡسِطِينَ","справедливых",5,42],[42],["وَكَيۡفَ","и как",5,43],["يُحَكِّمُونَكَ","они делают тебя судьёй",5,43],["وَعِندَهُمُ","тогда как у них",5,43]],[["ٱلتَّوۡرَىٰةُ","Таурат",5,43],["فِيهَا","в нём",5,43],["حُكۡمُ","решение",5,43],["ٱللَّهِ","Аллаха",5,43],["ثُمَّ","затем",5,43],["يَتَوَلَّوۡنَ","они отворачиваются",5,43],["مِنۢ","(даже)",5,43],["بَعۡدِ","после",5,43],["ذَٰلِكَۚ","этого",5,43]],[["وَمَآ","и не",5,43],["أُوْلَٰٓئِكَ","те",5,43],["بِٱلۡمُؤۡمِنِينَ","верующие",5,43],[43],["إِنَّآ","поистине Мы",5,44],["أَنزَلۡ