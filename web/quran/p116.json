{"p":116,"j":6,"a":[[5,46,["وَقَفَّيۡنَا","عَلَىٰٓ","ءَاثَٰرِهِم","بِعِيسَى","ٱبۡنِ","مَرۡيَمَ","مُصَدِّقٗا","لِّمَا","بَيۡنَ","يَدَيۡهِ","مِنَ","ٱلتَّوۡرَىٰةِۖ","وَءَاتَيۡنَٰهُ","ٱلۡإِنجِيلَ","فِيهِ","هُدٗى","وَنُورٞ","وَمُصَدِّقٗا","لِّمَا","بَيۡنَ","يَدَيۡهِ","مِنَ","ٱلتَّوۡرَىٰةِ","وَهُدٗى","وَمَوۡعِظَةٗ","لِّلۡمُتَّقِينَ"],"ваḳаффайна `ала асарихим би`иисабни марйама мусаддиḳал лима байна йадайхи минат таурати ва'атайнахул инжиила фиихи худан вануурун вамусаддиḳал лима байна йадайхи минат таурати вахудан вамау`изатал лилмуттаḳиин","Вслед за ними Мы отправили Ису (Иисуса), сына Марьям (Марии), с подтверждением истинности того, что было прежде ниспослано в Таурате (Торе). Мы даровали ему Инджил (Евангелие), в котором было верное руководство и свет, которое подтверждало то, что прежде было ниспослано в Таурате (Торе). Он был верным руководством и увещеванием для богобоязненных.",["и Мы отправили вслед","по","их следам","Ису","сына","Марьям","подтверждающим","то, что","перед","ним","из","Таурата","и Мы дали ему","Инджил","в нём","руководство","и свет","и подтверждающим","то, что","перед","ним","из","Таурата","и руководством","и увещеванием","для богобоязненных"]],[5,47,["وَلۡيَحۡكُمۡ","أَهۡلُ","ٱلۡإِنجِيلِ","بِمَآ","أَنزَلَ","ٱللَّهُ","فِيهِۚ","وَمَن","لَّمۡ","يَحۡكُم","بِمَآ","أَنزَلَ","ٱللَّهُ","فَأُوْلَٰٓئِكَ","هُمُ","ٱلۡفَٰسِقُونَ"],"валйахкум ахлул инжиили бима анзалаллаху фиихи вамал лам йахкум бима анзалаллаху фа'улаика хумул фасиḳуун","Пусть люди Инджила (Евангелия) судят согласно тому, что Аллах ниспослал в нем. Те же, которые не принимают решений в соответствии с тем, что ниспослал Аллах, являются нечестивцами.",["и пусть судят","люди","Инджила","по тому, что","ниспослал","Аллах","в нём","и кто","не","судит","по тому, что","ниспослал","Аллах","то те","они","нечестивцы"]],[5,48,["وَأَنزَلۡنَآ","إِلَيۡكَ","ٱلۡكِتَٰبَ","بِٱلۡحَقِّ","مُصَدِّقٗا","لِّمَا","بَيۡنَ","يَدَيۡهِ","مِنَ","ٱلۡكِتَٰبِ","وَمُهَيۡمِنًا","عَلَيۡهِۖ","فَٱحۡكُم","بَيۡنَهُم","بِمَآ","أَنزَلَ","ٱللَّهُۖ","وَلَا","تَتَّبِعۡ","أَهۡوَآءَهُمۡ","عَمَّا","جَآءَكَ","مِنَ","ٱلۡحَقِّۚ","لِكُلّٖ","جَعَلۡنَا","مِنكُمۡ","شِرۡعَةٗ","وَمِنۡهَاجٗاۚ","وَلَوۡ","شَآءَ","ٱللَّهُ","لَجَعَلَكُمۡ","أُمَّةٗ","وَٰحِدَةٗ","وَلَٰكِن","لِّيَبۡلُوَكُمۡ","فِي","مَآ","ءَاتَىٰكُمۡۖ","فَٱسۡتَبِقُواْ","ٱلۡخَيۡرَٰتِۚ","إِلَى","ٱللَّهِ","مَرۡجِعُكُمۡ","جَمِيعٗا","فَيُنَبِّئُكُم","بِمَا","كُنتُمۡ","فِيهِ","تَخۡتَلِفُونَ"],"ва'анзална илайкал китаба билхаḳḳи мусаддиḳал лима байна йадайхи минал китаби вамухайминан `алайхи фахкум байнахум бима анзалаллаху вала таттаби` ахваахум `амма жаака минал хаḳḳи ликуллин жа`ална минкум шир`атан ваминхажан валау шааллаху лажа`алакум умматан вахидатан валакил лийаблуакум фии ма атакум фастабиḳул хайрати илаллахи маржи`укум жамии`ан файунаббиукум бима кунтум фиихи тахталифуун","Мы ниспослали тебе Писание с истиной в подтверждение прежних Писаний, и для того, чтобы оно предохраняло их (или свидетельствовало о них; или возвысилось над ними). Суди же их согласно тому, что ниспослал Аллах, и не потакай их желаниям, уклоняясь от явившейся к тебе истины. Каждому из вас Мы установили закон и путь. Если бы Аллах пожелал, то сделал бы вас одной общиной, однако Он разделил вас, чтобы испытать вас тем, что Он даровал вам. Состязайтесь же в добрых делах. Всем вам предстоит вернуться к Аллаху, и Он поведает вам о том, в чем вы расходились во мнениях.",["и Мы ниспослали","тебе","Писание","с истиной","подтверждающим","то, что","перед","ним","из","Писания","и охраняющим","его","так суди","между ними","по тому, что","ниспослал","Аллах","и не","следуй","их желаниям","(уклоняясь) от того, что","пришло к тебе","из","истины","для каждого","Мы установили","из вас","закон","и путь","и если бы","пожелал","Аллах","непременно сделал бы вас","общиной","единой","но","чтобы испытать вас","в","том, что","Он дал вам","так состязайтесь","(в) добрых делах","к","Аллаху","ваше возвращение","всех","и Он сообщит вам","о том, что","вы были","в этом","расходились"]],[5,49,["وَأَنِ","ٱحۡكُم","بَيۡنَهُم","بِمَآ","أَنزَلَ","ٱللَّهُ","وَلَا","تَتَّبِعۡ","أَهۡوَآءَهُمۡ","وَٱحۡذَرۡهُمۡ","أَن","يَفۡتِنُوكَ","عَنۢ","بَعۡضِ","مَآ","أَنزَلَ","ٱللَّهُ","إِلَيۡكَۖ","فَإِن","تَوَلَّوۡاْ","فَٱعۡلَمۡ","أَنَّمَا","يُرِيدُ","ٱللَّهُ","أَن","يُصِيبَهُم","بِبَعۡضِ","ذُنُوبِهِمۡۗ","وَإِنَّ","كَثِيرٗا","مِّنَ","ٱلنَّاسِ","لَفَٰسِقُونَ"],"ва'анихкум байнахум бима анзалаллаху вала таттаби` ахваахум вахзархум ан йафтинуука `ам ба`ди ма анзалаллаху илайка фа'ин таваллау фа`лам аннама йуриидуллаху ан йусиибахум биба`ди зунуубихим ва'инна касиирам минан наси лафасиḳуун","Суди между ними согласно тому, что ниспослал Аллах, не потакай их желаниям и остерегайся их, дабы они не отвратили тебя от части того, что ниспослал тебе Аллах. Если же они отвернутся, то знай, что Аллах желает покарать их за некоторые из их грехов. Воистину, многие люди являются нечестивцами.",["и чтобы","суди","между ними","по тому, что","ниспослал","Аллах","и не","следуй","их желаниям","и остерегайся их","чтобы не","отвратили тебя","от","части","того, что","ниспослал","Аллах","тебе","а если","отвернутся","то знай","что лишь","желает","Аллах","чтобы","поразить их","за некоторые","их грехи","и поистине","многие","из","людей","непременно нечестивцы"]],[5,50,["أَفَحُكۡمَ","ٱلۡجَٰهِلِيَّةِ","يَبۡغُونَۚ","وَمَنۡ","أَحۡسَنُ","مِنَ","ٱللَّهِ","حُكۡمٗا","لِّقَوۡمٖ","يُوقِنُونَ"],"афахукмал жахилиййати йабгууна ваман ахсану миналлахи хукмал лиḳаумин йууḳинуун","Неужели они ищут суда времен невежества? Чьи решения могут быть лучше решений Аллаха для людей убежденных?",["неужели суд","невежества","они ищут","и кто","лучше","чем","Аллах","судом","для людей","(которые) убеждены"]]],"m":[[["وَقَفَّيۡنَا","и Мы отправили вслед",5,46],["عَلَىٰٓ","по",5,46],["ءَاثَٰرِهِم","их следам",5,46],["بِعِيسَى","Ису",5,46],["ٱبۡنِ","сына",5,46],["مَرۡيَمَ","Марьям",5,46],["مُصَدِّقٗا","подтверждающим",5,46],["لِّمَا","то, что",5,46],["بَيۡنَ","перед",5,46],["يَدَيۡهِ","ним",5,46],["مِنَ","из",5,46]],[["ٱلتَّوۡرَىٰةِۖ","Таурата