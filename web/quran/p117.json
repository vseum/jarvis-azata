{"p":117,"j":6,"a":[[5,51,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُواْ","لَا","تَتَّخِذُواْ","ٱلۡيَهُودَ","وَٱلنَّصَٰرَىٰٓ","أَوۡلِيَآءَۘ","بَعۡضُهُمۡ","أَوۡلِيَآءُ","بَعۡضٖۚ","وَمَن","يَتَوَلَّهُم","مِّنكُمۡ","فَإِنَّهُۥ","مِنۡهُمۡۗ","إِنَّ","ٱللَّهَ","لَا","يَهۡدِي","ٱلۡقَوۡمَ","ٱلظَّٰلِمِينَ"],"йа'аййухал лазиина амануу ла таттахизул йахууда ваннасара аулийаа ба`духум аулийау ба`дин ваман йатаваллахум минкум фа'иннахуу минхум инналлаха ла йахдил ḳаумаз залимиин","О те, которые уверовали! Не считайте иудеев и христиан своими помощниками и друзьями, поскольку они помогают друг другу. Если же кто-либо из вас считает их своими помощниками и друзьями, то он сам является одним из них. Воистину, Аллах не ведет прямым путем несправедливых людей.",["о","те, которые","уверовали","не","берите","иудеев","и христиан","союзниками","одни из них","союзники","других","и кто","берёт их в союзники","из вас","то поистине он","из них","поистине","Аллах","не","ведёт прямым путём","людей","несправедливых"]],[5,52,["فَتَرَى","ٱلَّذِينَ","فِي","قُلُوبِهِم","مَّرَضٞ","يُسَٰرِعُونَ","فِيهِمۡ","يَقُولُونَ","نَخۡشَىٰٓ","أَن","تُصِيبَنَا","دَآئِرَةٞۚ","فَعَسَى","ٱللَّهُ","أَن","يَأۡتِيَ","بِٱلۡفَتۡحِ","أَوۡ","أَمۡرٖ","مِّنۡ","عِندِهِۦ","فَيُصۡبِحُواْ","عَلَىٰ","مَآ","أَسَرُّواْ","فِيٓ","أَنفُسِهِمۡ","نَٰدِمِينَ"],"фатарал лазиина фии ḳулуубихим марадун йусари`ууна фиихим йаḳуулууна нахша ан тусиибана даиратун фа`асаллаху ан йа'тийа билфатхи ау амрим мин `индихии файусбихуу `ала ма асарруу фии анфусихим надимиин","Ты видишь, что те, чьи сердца поражены недугом, поспешают среди них и говорят: «Мы боимся, что нас постигнет беда». Но, может быть, Аллах явится с победой или своим повелением, и тогда они станут сожалеть о том, что утаивали в себе.",["и ты видишь","тех, которые","в","их сердцах","болезнь","спешат","к ним","говоря","мы боимся","что","постигнет нас","беда","но может быть","Аллах","(что)","явится","с победой","или","повелением","от","Себя","и станут они","о","том, что","скрывали","в","себе","сожалеющими"]],[5,53,["وَيَقُولُ","ٱلَّذِينَ","ءَامَنُوٓاْ","أَهَٰٓؤُلَآءِ","ٱلَّذِينَ","أَقۡسَمُواْ","بِٱللَّهِ","جَهۡدَ","أَيۡمَٰنِهِمۡ","إِنَّهُمۡ","لَمَعَكُمۡۚ","حَبِطَتۡ","أَعۡمَٰلُهُمۡ","فَأَصۡبَحُواْ","خَٰسِرِينَ"],"вайаḳуулул лазиина амануу ахаулаил лазиина аḳсамуу биллахи жахда айманихим иннахум лама`акум хабитат а`малухум фа'асбахуу хасириин","Те, которые уверовали, скажут: «Неужели это - те, которые приносили величайшие клятвы именем Аллаха о том, что они были с вами?». Тщетны были их деяния, и они оказались потерпевшими убыток.",["и скажут","те, которые","уверовали","неужели эти","те, которые","клялись","Аллахом","крепчайшими","своими клятвами","что они","непременно с вами","тщетны стали","их деяния","и стали они","потерпевшими убыток"]],[5,54,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُواْ","مَن","يَرۡتَدَّ","مِنكُمۡ","عَن","دِينِهِۦ","فَسَوۡفَ","يَأۡتِي","ٱللَّهُ","بِقَوۡمٖ","يُحِبُّهُمۡ","وَيُحِبُّونَهُۥٓ","أَذِلَّةٍ","عَلَى","ٱلۡمُؤۡمِنِينَ","أَعِزَّةٍ","عَلَى","ٱلۡكَٰفِرِينَ","يُجَٰهِدُونَ","فِي","سَبِيلِ","ٱللَّهِ","وَلَا","يَخَافُونَ","لَوۡمَةَ","لَآئِمٖۚ","ذَٰلِكَ","فَضۡلُ","ٱللَّهِ","يُؤۡتِيهِ","مَن","يَشَآءُۚ","وَٱللَّهُ","وَٰسِعٌ","عَلِيمٌ"],"йа'аййухал лазиина амануу ман йартадда минкум `ан диинихии фасауфа йа'тиллаху биḳаумин йухиббухум вайухиббуунахуу азиллатин `алал му'миниина а`иззатин `алал кафириина йужахидууна фии сабиилиллахи вала йахафууна лаумата лаимин залика фадлуллахи йу'тиихи ман йашау валлаху васи`ун `алиим","О те, которые уверовали! Если кто-нибудь из вас отступит от своей религии, то Аллах приведет других людей, которых Он будет любить и которые будут любить Его. Они будут смиренны перед верующими и непреклонны перед неверующими, будут сражаться на пути Аллаха и не будут бояться порицания порицающих. Такова милость Аллаха, которую Он дарует, кому пожелает. Аллах - Объемлющий, Знающий.",["о","те, которые","уверовали","кто","отступит","из вас","от","своей религии","то вскоре","приведёт","Аллах","людей","Он любит их","и они любят Его","смиренных","перед","верующими","непреклонных","перед","неверующими","они борются","на","пути","Аллаха","и не","боятся","порицания","порицающего","это","милость","Аллаха","Он дарует её","кому","пожелает","и Аллах","Объемлющий","Знающий"]],[5,55,["إِنَّمَا","وَلِيُّكُمُ","ٱللَّهُ","وَرَسُولُهُۥ","وَٱلَّذِينَ","ءَامَنُواْ","ٱلَّذِينَ","يُقِيمُونَ","ٱلصَّلَوٰةَ","وَيُؤۡتُونَ","ٱلزَّكَوٰةَ","وَهُمۡ","رَٰكِعُونَ"],"иннама валиййукумуллаху варасуулухуу валлазиина аманул лазиина йуḳиимуунас салавата вайу'тууназ закавата вахум раки`уун","Вашим Покровителем является только Аллах, Его Посланник и верующие, которые совершают намаз, выплачивают закят и преклоняются.",["лишь","ваш Покровитель","Аллах","и Его Посланник","и те, которые","уверовали","которые","совершают","намаз","и дают","закят","и они","преклоняются"]],[5,56,["وَمَن","يَتَوَلَّ","ٱللَّهَ","وَرَسُولَهُۥ","وَٱلَّذِينَ","ءَامَنُواْ","فَإِنَّ","حِزۡبَ","ٱللَّهِ","هُمُ","ٱلۡغَٰلِبُونَ"],"ваман йатаваллаллаха варасуулахуу валлазиина амануу фа'инна хизбаллахи хумул галибуун","Если они считают Аллаха, Его Посланника и верующих своими покровителями и помощниками, то ведь поборники Аллаха непременно окажутся победителями.",["и кто","берёт в покровители","Аллаха","и Его Посланника","и тех, которые","уверовали","то поистине","партия","Аллаха","они","победители"]],[5,57,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُواْ","لَا","تَتَّخِذُواْ","ٱلَّذِينَ","ٱتَّخَذُواْ","دِينَكُمۡ","هُزُوٗا","وَلَعِبٗا","مِّنَ","ٱلَّذِينَ","أُوتُواْ","ٱلۡكِتَٰبَ","مِن","قَبۡلِكُمۡ","وَٱلۡكُفَّارَ","أَوۡلِيَآءَۚ","وَٱتَّقُواْ","ٱللَّهَ","إِن","كُنتُم","مُّؤۡمِنِينَ"],"йа'аййухал лазиина амануу ла таттахизул лазиинаттахазуу диинакум хузуан вала`ибам минал лазиина уутул китаба мин ḳабликум валкуффара аулийаа ваттаḳуллаха ин кунтум му'миниин","О те, которые уверовали! Не считайте тех, которым Писание было даровано до вас и которые глумятся над вашей религией и считают ее развлечением, и неверующих своими помощниками и друзьями. Бойтесь Аллаха, если вы 