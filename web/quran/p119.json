{"p":119,"j":6,"a":[[5,65,["وَلَوۡ","أَنَّ","أَهۡلَ","ٱلۡكِتَٰبِ","ءَامَنُواْ","وَٱتَّقَوۡاْ","لَكَفَّرۡنَا","عَنۡهُمۡ","سَيِّـَٔاتِهِمۡ","وَلَأَدۡخَلۡنَٰهُمۡ","جَنَّٰتِ","ٱلنَّعِيمِ"],"валау анна ахлал китаби амануу ваттаḳау лакаффарна `анхум саййиатихим валаадхалнахум жаннатин на`иим","Если бы люди Писания уверовали и устрашились, то Мы простили бы им злодеяния и ввели бы их в Сады блаженства.",["и если бы","что","люди","Писания","уверовали","и были богобоязненны","непременно Мы стёрли бы","с них","их злодеяния","и непременно ввели бы Мы их","в Сады","блаженства"]],[5,66,["وَلَوۡ","أَنَّهُمۡ","أَقَامُواْ","ٱلتَّوۡرَىٰةَ","وَٱلۡإِنجِيلَ","وَمَآ","أُنزِلَ","إِلَيۡهِم","مِّن","رَّبِّهِمۡ","لَأَكَلُواْ","مِن","فَوۡقِهِمۡ","وَمِن","تَحۡتِ","أَرۡجُلِهِمۚ","مِّنۡهُمۡ","أُمَّةٞ","مُّقۡتَصِدَةٞۖ","وَكَثِيرٞ","مِّنۡهُمۡ","سَآءَ","مَا","يَعۡمَلُونَ"],"валау аннахум аḳамут таурата вал'инжиила вама унзила илайхим мир раббихим ла'акалуу мин фауḳихим вамин тахти аржулихим минхум умматум муḳтасидатун вакасиирум минхум саа ма йа`малуун","Если бы они руководствовались Тауратом (Торой), Инджилом (Евангелием) и тем, что было ниспослано им от их Господа, то они питались бы тем, что над ними, и тем, что у них под ногами. Среди них есть умеренные люди (праведники, уверовавшие в Пророка Мухаммада, избегающие чрезмерности в религии и не делающие упущений), но плохо то, что совершают многие из них.",["и если бы","что они","соблюдали","Таурат","и Инджил","и то, что","ниспослано","им","от","их Господа","непременно питались бы","от","того, что над ними","и от","того, что под","их ногами","среди них","община","умеренная","и многие","из них","скверно","то, что","они делают"]],[5,67,["يَٰٓأَيُّهَا","ٱلرَّسُولُ","بَلِّغۡ","مَآ","أُنزِلَ","إِلَيۡكَ","مِن","رَّبِّكَۖ","وَإِن","لَّمۡ","تَفۡعَلۡ","فَمَا","بَلَّغۡتَ","رِسَالَتَهُۥۚ","وَٱللَّهُ","يَعۡصِمُكَ","مِنَ","ٱلنَّاسِۗ","إِنَّ","ٱللَّهَ","لَا","يَهۡدِي","ٱلۡقَوۡمَ","ٱلۡكَٰفِرِينَ"],"йа'аййухар расуулу баллиг ма унзила илайка мир раббика ва'ил лам таф`ал фама баллагта рисалатахуу валлаху йа`симука минан наси инналлаха ла йахдил ḳаумал кафириин","О Посланник! Возвести то, что ниспослано тебе от своего Господа. Если ты не сделаешь этого, то не донесешь Его послания. Аллах защитит тебя от людей. Воистину, Аллах не наставляет на прямой путь неверующих людей.",["о","Посланник","доведи","то, что","ниспослано","тебе","от","твоего Господа","и если","не","сделаешь","то не","ты донес","Его послание","и Аллах","защитит тебя","от","людей","поистине","Аллах","не","ведет прямым путем","людей","неверующих"]],[5,68,["قُلۡ","يَٰٓأَهۡلَ","ٱلۡكِتَٰبِ","لَسۡتُمۡ","عَلَىٰ","شَيۡءٍ","حَتَّىٰ","تُقِيمُواْ","ٱلتَّوۡرَىٰةَ","وَٱلۡإِنجِيلَ","وَمَآ","أُنزِلَ","إِلَيۡكُم","مِّن","رَّبِّكُمۡۗ","وَلَيَزِيدَنَّ","كَثِيرٗا","مِّنۡهُم","مَّآ","أُنزِلَ","إِلَيۡكَ","مِن","رَّبِّكَ","طُغۡيَٰنٗا","وَكُفۡرٗاۖ","فَلَا","تَأۡسَ","عَلَى","ٱلۡقَوۡمِ","ٱلۡكَٰفِرِينَ"],"ḳул йа'ахлал китаби ластум `ала шай'ин хатта туḳиимут таурата вал'инжиила вама унзила илайкум мир раббикум валайазииданна касиирам минхум ма унзила илайка мир раббика тугйанан вакуфран фала та'са `алал ḳаумил кафириин","Скажи: «О люди Писания! Вы не будете идти прямым путем, пока не станете руководствоваться Тауратом (Торой), Инджилом (Евангелием) и тем, что ниспослано вам от вашего Господа». Ниспосланное тебе от твоего Господа приумножает во многих из них несправедливость и неверие. Не печалься же о неверующих людях.",["скажи","о люди","Писания","вы не","на","чем-либо (истинном)","пока не","соблюдете","Таурат","и Инджил","и то, что","ниспослано","вам","от","вашего Господа","и непременно умножит","многим","из них","то, что","ниспослано","тебе","от","твоего Господа","бесчинство","и неверие","так не","печалься","о","людях","неверующих"]],[5,69,["إِنَّ","ٱلَّذِينَ","ءَامَنُواْ","وَٱلَّذِينَ","هَادُواْ","وَٱلصَّٰبِـُٔونَ","وَٱلنَّصَٰرَىٰ","مَنۡ","ءَامَنَ","بِٱللَّهِ","وَٱلۡيَوۡمِ","ٱلۡأٓخِرِ","وَعَمِلَ","صَٰلِحٗا","فَلَا","خَوۡفٌ","عَلَيۡهِمۡ","وَلَا","هُمۡ","يَحۡزَنُونَ"],"иннал лазиина амануу валлазиина хадуу вассабиууна ваннасара ман амана биллахи валйаумил ахири ва`амила салихан фала хауфун `алайхим вала хум йахзануун","Воистину, верующие, а также иудеи, сабии и христиане, которые уверовали в Аллаха и в Последний день и поступали праведно, не познают страха и не будут опечалены.",["поистине","те, которые","уверовали","и те, которые","исповедуют иудейство","и сабии","и христиане","кто","уверовал","в Аллаха","и в день","Последний","и совершал","праведное","то нет","страха","над ними","и не","они","будут опечалены"]],[5,70,["لَقَدۡ","أَخَذۡنَا","مِيثَٰقَ","بَنِيٓ","إِسۡرَٰٓءِيلَ","وَأَرۡسَلۡنَآ","إِلَيۡهِمۡ","رُسُلٗاۖ","كُلَّمَا","جَآءَهُمۡ","رَسُولُۢ","بِمَا","لَا","تَهۡوَىٰٓ","أَنفُسُهُمۡ","فَرِيقٗا","كَذَّبُواْ","وَفَرِيقٗا","يَقۡتُلُونَ"],"лаḳад ахазна миисаḳа бании исраиила ва'арсална илайхим русулан куллама жаахум расуулу бима ла тахва анфусухум фарииḳан каззабуу вафарииḳан йаḳтулуун","Мы уже заключили завет с сынами Исраила (Израиля) и отправили к ним посланников. Каждый раз, когда посланники приносили им то, что им было не по душе, они нарекали лжецами одних и убивали других.",["уже","Мы взяли","завет","сынов","Исраила","и Мы отправили","к ним","посланников","всякий раз, когда","приходил к ним","посланник","с тем, что","не","желали","их души","одних","они сочли лжецами","и других","они убивают"]]],"m":[[["وَلَوۡ","и если бы",5,65],["أَنَّ","что",5,65],["أَهۡلَ","люди",5,65],["ٱلۡكِتَٰبِ","Писания",5,65],["ءَامَنُواْ","уверовали",5,65],["وَٱتَّقَوۡاْ","и были богобоязненны",5,65],["لَكَفَّرۡنَا","непременно Мы стёрли бы",5,65],["عَنۡهُمۡ","с них",5,65]],[["سَيِّـَٔاتِهِمۡ","их злодеяния",5,65],["وَلَأَدۡخَلۡنَٰهُمۡ","и непременно ввели бы Мы их",5,65],["جَنَّٰتِ","в Сады",5,65],["ٱلنَّعِيمِ","блаженства",5,65],[65],["وَلَوۡ","и если бы",5,66],["أَنَّهُمۡ","что они",5,66],["أَقَامُواْ","соблюдали",5,66]],[["ٱلتَّوۡرَىٰةَ","Таурат",5,66],["وَٱلۡإِنجِيلَ","и Инджил",5,66],["وَمَآ","и то, что",5,66],["أُنزِلَ","ниспослано",5,66],["إِلَيۡ