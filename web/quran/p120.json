{"p":120,"j":6,"a":[[5,71,["وَحَسِبُوٓاْ","أَلَّا","تَكُونَ","فِتۡنَةٞ","فَعَمُواْ","وَصَمُّواْ","ثُمَّ","تَابَ","ٱللَّهُ","عَلَيۡهِمۡ","ثُمَّ","عَمُواْ","وَصَمُّواْ","كَثِيرٞ","مِّنۡهُمۡۚ","وَٱللَّهُ","بَصِيرُۢ","بِمَا","يَعۡمَلُونَ"],"вахасибуу алла такууна фитнатун фа`амуу васаммуу сумма табаллаху `алайхим сумма `амуу васаммуу касиирум минхум валлаху басииру бима йа`малуун","Они посчитали, что не будет искушения, и потому стали слепы и глухи. Затем Аллах принял их покаяние, после чего многие из них снова стали слепы и глухи. Аллах видит то, что они совершают.",["и они посчитали","что не","будет","искушения","и ослепли они","и оглохли","затем","принял покаяние","Аллах","их","затем","ослепли они","и оглохли","многие","из них","и Аллах","Видящий","то, что","они делают"]],[5,72,["لَقَدۡ","كَفَرَ","ٱلَّذِينَ","قَالُوٓاْ","إِنَّ","ٱللَّهَ","هُوَ","ٱلۡمَسِيحُ","ٱبۡنُ","مَرۡيَمَۖ","وَقَالَ","ٱلۡمَسِيحُ","يَٰبَنِيٓ","إِسۡرَٰٓءِيلَ","ٱعۡبُدُواْ","ٱللَّهَ","رَبِّي","وَرَبَّكُمۡۖ","إِنَّهُۥ","مَن","يُشۡرِكۡ","بِٱللَّهِ","فَقَدۡ","حَرَّمَ","ٱللَّهُ","عَلَيۡهِ","ٱلۡجَنَّةَ","وَمَأۡوَىٰهُ","ٱلنَّارُۖ","وَمَا","لِلظَّٰلِمِينَ","مِنۡ","أَنصَارٖ"],"лаḳад кафарал лазиина ḳалуу инналлаха хуал масиихубну марйама ваḳалал масииху йабании исраиила`будуллаха раббии вараббакум иннахуу ман йушрик биллахи фаḳад харрамаллаху `алайхил жанната вама'вахун нару вама лиззалимиина мин ансар","Не уверовали те, которые говорят: «Аллах - это Мессия, сын Марьям (Марии)». Мессия сказал: «О сыны Исраила (Израиля)! Поклоняйтесь Аллаху, Господу моему и Господу вашему». Воистину, кто приобщает к Аллаху сотоварищей, тому Он запретил Рай. Его пристанищем будет Геенна, и у беззаконников не будет помощников.",["уже","не уверовали","те, которые","сказали","поистине","Аллах","Он","Мессия","сын","Марьям","и сказал","Мессия","о сыны","Исраила","поклоняйтесь","Аллаху","моему Господу","и вашему Господу","поистине","кто","приобщает сотоварищей","к Аллаху","то уже","запретил","Аллах","ему","Рай","и его пристанище","Огонь","и нет","у беззаконников","никаких","помощников"]],[5,73,["لَّقَدۡ","كَفَرَ","ٱلَّذِينَ","قَالُوٓاْ","إِنَّ","ٱللَّهَ","ثَالِثُ","ثَلَٰثَةٖۘ","وَمَا","مِنۡ","إِلَٰهٍ","إِلَّآ","إِلَٰهٞ","وَٰحِدٞۚ","وَإِن","لَّمۡ","يَنتَهُواْ","عَمَّا","يَقُولُونَ","لَيَمَسَّنَّ","ٱلَّذِينَ","كَفَرُواْ","مِنۡهُمۡ","عَذَابٌ","أَلِيمٌ"],"ллаḳад кафарал лазиина ḳалуу инналлаха салису саласатин вама мин илахин илла илахун вахидун ва'ил лам йантахуу `амма йаḳуулууна лайамассаннал лазиина кафаруу минхум `азабун алиим","Не уверовали те, которые говорят: «Аллах является третьим в троице». Нет божества, кроме Единственного Бога! Если они не отрекутся от того, что говорят, то неверующих из их числа коснутся мучительные страдания.",["уже","не уверовали","те, которые","сказали","поистине","Аллах","третий","из трех","и нет","никакого","божества","кроме","Бога","Единого","и если","не","прекратят","от того, что","они говорят","непременно коснется","тех, которые","не уверовали","из них","наказание","мучительное"]],[5,74,["أَفَلَا","يَتُوبُونَ","إِلَى","ٱللَّهِ","وَيَسۡتَغۡفِرُونَهُۥۚ","وَٱللَّهُ","غَفُورٞ","رَّحِيمٞ"],"афала йатуубууна илаллахи вайастагфируунахуу валлаху гафуурур рахиим","Неужели они не раскаются перед Аллахом и не попросят у Него прощения? Ведь Аллах - Прощающий, Милосердный.",["неужели не","покаются","к","Аллаху","и попросят у Него прощения","и Аллах","Прощающий","Милосердный"]],[5,75,["مَّا","ٱلۡمَسِيحُ","ٱبۡنُ","مَرۡيَمَ","إِلَّا","رَسُولٞ","قَدۡ","خَلَتۡ","مِن","قَبۡلِهِ","ٱلرُّسُلُ","وَأُمُّهُۥ","صِدِّيقَةٞۖ","كَانَا","يَأۡكُلَانِ","ٱلطَّعَامَۗ","ٱنظُرۡ","كَيۡفَ","نُبَيِّنُ","لَهُمُ","ٱلۡأٓيَٰتِ","ثُمَّ","ٱنظُرۡ","أَنَّىٰ","يُؤۡفَكُونَ"],"ммал масиихубну марйама илла расуулун ḳад халат мин ḳаблихир русулу ва'уммухуу сиддииḳатун кана йа'куланит та`аманзур кайфа нубаййину лахумул айати сумманзур анна йу'факуун","Мессия, сын Марьям (Марии), был всего лишь посланником. До него тоже были посланники, а его мать была правдивейшей женщиной. Оба они принимали пищу. Посмотри, как Мы разъясняем им знамения. А затем посмотри, до чего они отвращены от истины.",["не","Мессия","сын","Марьям","кроме как","посланник","уже","прошли","ещё","до него","посланники","и его мать","правдивейшая","они оба","ели","пищу","посмотри","как","Мы разъясняем","им","знамения","затем","посмотри","как","они отвращены"]],[5,76,["قُلۡ","أَتَعۡبُدُونَ","مِن","دُونِ","ٱللَّهِ","مَا","لَا","يَمۡلِكُ","لَكُمۡ","ضَرّٗا","وَلَا","نَفۡعٗاۚ","وَٱللَّهُ","هُوَ","ٱلسَّمِيعُ","ٱلۡعَلِيمُ"],"ḳул ата`будууна мин дууниллахи ма ла йамлику лакум дарран вала наф`ан валлаху хуас самии`ул `алиим","Скажи: «Неужели вы станете поклоняться вместо Аллаха тому, что не властно принести вам ни вреда, ни пользы? Это Аллах является Слышащим, Знающим!».",["скажи","неужели вы поклоняетесь","из","помимо","Аллаха","тому, что","не","властно","для вас","во вред","и не","в пользу","и Аллах","Он","Слышащий","Знающий"]]],"m":[[["وَحَسِبُوٓاْ","и они посчитали",5,71],["أَلَّا","что не",5,71],["تَكُونَ","будет",5,71],["فِتۡنَةٞ","искушения",5,71],["فَعَمُواْ","и ослепли они",5,71],["وَصَمُّواْ","и оглохли",5,71],["ثُمَّ","затем",5,71],["تَابَ","принял покаяние",5,71],["ٱللَّهُ","Аллах",5,71]],[["عَلَيۡهِمۡ","их",5,71],["ثُمَّ","затем",5,71],["عَمُواْ","ослепли они",5,71],["وَصَمُّواْ","и оглохли",5,71],["كَثِيرٞ","многие",5,71],["مِّنۡهُمۡۚ","из них",5,71],["وَٱللَّهُ","и Аллах",5,71],["بَصِيرُۢ","Видящий",5,71],["بِمَا","то, что",5,71]],[["يَعۡمَلُونَ","они делают",5,71],[71],["لَقَدۡ","уже",5,72],["كَفَرَ","не уверовали",5,72],["ٱلَّذِينَ","те, которые",5,72],["قَالُوٓاْ","сказали",5,72],["إِنَّ","поистине",5,72],["ٱللَّهَ","Аллах",5,72],["هُوَ","Он",5,72]],[["ٱلۡمَسِيحُ","Мессия",5,72],["ٱبۡنُ","сын",5,72],["مَرۡيَمَۖ","Марьям",5,72],["وَقَالَ","и сказал",5,72],["ٱلۡمَسِيحُ","Мессия",5,72],["يَٰبَنِيٓ","о сыны",5,72],["إِسۡرَٰٓءِيلَ","Исраила",5,72],["ٱعۡبُدُواْ","поклоняйтесь",5,72]],[["ٱللَّهَ","Аллаху",5,72],["رَبِّي","моему Господу",5,72],["وَرَبَّكُمۡۖ","и вашему Господу",5,72],["إِنَّهُۥ","поистине",