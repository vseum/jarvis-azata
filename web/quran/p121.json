{"p":121,"j":7,"a":[[5,77,["قُلۡ","يَٰٓأَهۡلَ","ٱلۡكِتَٰبِ","لَا","تَغۡلُواْ","فِي","دِينِكُمۡ","غَيۡرَ","ٱلۡحَقِّ","وَلَا","تَتَّبِعُوٓاْ","أَهۡوَآءَ","قَوۡمٖ","قَدۡ","ضَلُّواْ","مِن","قَبۡلُ","وَأَضَلُّواْ","كَثِيرٗا","وَضَلُّواْ","عَن","سَوَآءِ","ٱلسَّبِيلِ"],"ḳул йа'ахлал китаби ла таглуу фии дииникум гайрал хаḳḳи вала таттаби`уу ахваа ḳаумин ḳад даллуу мин ḳаблу ва'адаллуу касииран вадаллуу `ан саваис сабиил","Скажи: «О люди Писания! Не проявляйте чрезмерности в вашей религии вопреки истине и не потакайте желаниям людей, которые еще раньше впали в заблуждение, ввели в заблуждение многих других и сбились с прямого пути».",["скажи","о люди","Писания","не","преступайте меру","в","вашей религии","вопреки","истине","и не","следуйте","страстям","людей","уже","заблудились","ещё","раньше","и ввели в заблуждение","многих","и сбились","с","ровного","пути"]],[5,78,["لُعِنَ","ٱلَّذِينَ","كَفَرُواْ","مِنۢ","بَنِيٓ","إِسۡرَٰٓءِيلَ","عَلَىٰ","لِسَانِ","دَاوُۥدَ","وَعِيسَى","ٱبۡنِ","مَرۡيَمَۚ","ذَٰلِكَ","بِمَا","عَصَواْ","وَّكَانُواْ","يَعۡتَدُونَ"],"лу`инал лазиина кафаруу мим бании исраиила `ала лисани давууда ва`иисабни марйама залика бима `асав вакануу йа`тадуун","Неверующие сыны Исраила (Израиля) были прокляты языком Давуда (Давида) и Исы (Иисуса), сына Марьям (Марии). Это произошло потому, что они ослушались и преступали границы дозволенного.",["прокляты","те, которые","не уверовали","из","сынов","Исраила","через","язык","Давуда","и Исы","сына","Марьям","это","за то, что","они ослушались","и были","преступающими"]],[5,79,["كَانُواْ","لَا","يَتَنَاهَوۡنَ","عَن","مُّنكَرٖ","فَعَلُوهُۚ","لَبِئۡسَ","مَا","كَانُواْ","يَفۡعَلُونَ"],"кануу ла йатанахауна `ам мункарин фа`алууху лаби'са ма кануу йаф`алуун","Они не удерживали друг друга от предосудительных поступков, которые они совершали. Как же скверно было то, что они делали!",["они были","не","удерживающими друг друга","от","порицаемого","совершали они его","непременно скверно","то, что","они были","делающими"]],[5,80,["تَرَىٰ","كَثِيرٗا","مِّنۡهُمۡ","يَتَوَلَّوۡنَ","ٱلَّذِينَ","كَفَرُواْۚ","لَبِئۡسَ","مَا","قَدَّمَتۡ","لَهُمۡ","أَنفُسُهُمۡ","أَن","سَخِطَ","ٱللَّهُ","عَلَيۡهِمۡ","وَفِي","ٱلۡعَذَابِ","هُمۡ","خَٰلِدُونَ"],"тара касиирам минхум йатаваллаунал лазиина кафаруу лаби'са ма ḳаддамат лахум анфусухум ан сахиталлаху `алайхим вафил `азаби хум халидуун","Ты видишь, что многие из них дружат с неверующими. Скверно то, что уготовили им их души, ведь поэтому Аллах разгневался на них. Они будут мучаться вечно.",["ты видишь","многих","из них","дружат с","теми, которые","не уверовали","непременно скверно","то, что","уготовили","им","их души","что","разгневался","Аллах","на них","и в","наказании","они","вечно пребывающие"]],[5,81,["وَلَوۡ","كَانُواْ","يُؤۡمِنُونَ","بِٱللَّهِ","وَٱلنَّبِيِّ","وَمَآ","أُنزِلَ","إِلَيۡهِ","مَا","ٱتَّخَذُوهُمۡ","أَوۡلِيَآءَ","وَلَٰكِنَّ","كَثِيرٗا","مِّنۡهُمۡ","فَٰسِقُونَ"],"валау кануу йу'минууна биллахи ваннабиййи вама унзила илайхи маттахазуухум аулийаа валакинна касиирам минхум фасиḳуун","Если бы они уверовали в Аллаха, Пророка и то, что было ниспослано ему, то не стали бы брать их себе в помощники и друзья. Но многие из них являются нечестивцами.",["и если бы","были они","верующими","в Аллаха","и Пророка","и то, что","ниспослано","ему","не","взяли бы они их","покровителями","но","многие","из них","нечестивцы"]],[5,82,["لَتَجِدَنَّ","أَشَدَّ","ٱلنَّاسِ","عَدَٰوَةٗ","لِّلَّذِينَ","ءَامَنُواْ","ٱلۡيَهُودَ","وَٱلَّذِينَ","أَشۡرَكُواْۖ","وَلَتَجِدَنَّ","أَقۡرَبَهُم","مَّوَدَّةٗ","لِّلَّذِينَ","ءَامَنُواْ","ٱلَّذِينَ","قَالُوٓاْ","إِنَّا","نَصَٰرَىٰۚ","ذَٰلِكَ","بِأَنَّ","مِنۡهُمۡ","قِسِّيسِينَ","وَرُهۡبَانٗا","وَأَنَّهُمۡ","لَا","يَسۡتَكۡبِرُونَ"],"латажиданна ашаддан наси `адаватал лиллазиина аманул йахууда валлазиина ашракуу валатажиданна аḳрабахум маваддатал лиллазиина аманул лазиина ḳалуу инна насара залика би'анна минхум ḳиссиисиина варухбанан ва'аннахум ла йастакбируун","Ты непременно найдешь самыми лютыми врагами верующих иудеев и многобожников. Ты также непременно найдешь, что ближе всех в любви к верующим, являются те, которые говорят: «Мы - христиане». Это потому, что среди них есть священники и монахи, и потому, что они не проявляют высокомерия.",["непременно найдешь","самыми сильными","из людей","во вражде","к тем, которые","уверовали","иудеев","и тех, которые","приобщали сотоварищей","и непременно найдешь","ближайшими из них","в любви","к тем, которые","уверовали","тех, которые","сказали","поистине, мы","христиане","это","потому, что","среди них","священники","и монахи","и что они","не","превозносятся"]]],"m":[[["قُلۡ","скажи",5,77],["يَٰٓأَهۡلَ","о люди",5,77],["ٱلۡكِتَٰبِ","Писания",5,77],["لَا","не",5,77],["تَغۡلُواْ","преступайте меру",5,77],["فِي","в",5,77],["دِينِكُمۡ","вашей религии",5,77],["غَيۡرَ","вопреки",5,77],["ٱلۡحَقِّ","истине",5,77]],[["وَلَا","и не",5,77],["تَتَّبِعُوٓاْ","следуйте",5,77],["أَهۡوَآءَ","страстям",5,77],["قَوۡمٖ","людей",5,77],["قَدۡ","уже",5,77],["ضَلُّواْ","заблудились",5,77],["مِن","ещё",5,77],["قَبۡلُ","раньше",5,77],["وَأَضَلُّواْ","и ввели в заблуждение",5,77]],[["كَثِيرٗا","многих",5,77],["وَضَلُّواْ","и сбились",5,77],["عَن","с",5,77],["سَوَآءِ","ровного",5,77],["ٱلسَّبِيلِ","пути",5,77],[77],["لُعِنَ","прокляты",5,78],["ٱلَّذِينَ","те, которые",5,78]],[["كَفَرُواْ","не уверовали",5,78],["مِنۢ","из",5,78],["بَنِيٓ","сынов",5,78],["إِسۡرَٰٓءِيلَ","Исраила",5,78],["عَلَىٰ","через",5,78],["لِسَانِ","язык",5,78],["دَاوُۥدَ","Давуда",5,78],["وَعِيسَى","и Исы",5,78]],[["ٱبۡنِ","сына",5,78],["مَرۡيَمَۚ","Марьям",5,78],["ذَٰلِكَ","это",5,78],["بِمَا","за то, что",5,78],["عَصَواْ","они ослушались",5,78],["وَّكَانُواْ","и были",5,78],["يَعۡتَدُونَ","преступающими",5,78],[78]],[["كَانُواْ","они были",5,79],["لَا","не",5,79],["يَتَنَاهَوۡنَ","удерживающими друг друга",5,79],["عَن","от",5,79],["مُّنكَرٖ","порицаемого",5,79],["فَعَلُوهُۚ","совершали они его",5,79],["لَبِئۡسَ","непременно скверно",5,79]],[["مَا","то, что",5,79],["كَانُواْ","они были",5,79],["يَفۡعَلُونَ","делающими",5,79],[79],["تَرَىٰ","ты видишь",5,80],["كَثِيرٗا","многих",5,80],["مِّنۡهُمۡ","из них",5,80]],[["يَتَوَلَّوۡنَ","дружат с",5,80],["ٱلَّذِينَ","теми, которые",5,80],["كَفَرُواْۚ","не уверовали",5,80],["لَبِئۡسَ","непременно скверно",5,80],["مَا","то, что",5,80],["قَدَّمَتۡ","уготовили",5,80],["لَهُمۡ","им",5,80],["أَنفُسُهُمۡ","их души",5,80]],[["أَن","что",5,80],["سَخِطَ","разгневался",5,80],["ٱللَّهُ","Аллах",5,80],["عَلَيۡهِمۡ","на них",5,80],["وَفِي","и в",5,80],["ٱلۡعَذَابِ","наказании",5,80],["هُمۡ","они",5,80],["خَٰلِدُونَ","вечно пребывающие",5,80],[80]],[["وَلَوۡ","и если бы",5,81],["كَانُواْ","были они",5,81],["يُؤۡمِنُونَ","верующими",5,81],["بِٱللَّهِ","в Аллаха",5,81],["وَٱلنَّبِيِّ","и Пророка",5,81],["وَمَآ","и то, что",5,81],["أُنزِلَ","ниспослано",5,81],["إِلَيۡهِ","ему",5,81]],[["مَا","не",5,81],["ٱتَّخَذُوهُمۡ","взяли бы они их",5,81],["أَوۡلِيَآءَ","покровителями",5,81],["وَلَٰكِنَّ","но",5,81],["كَثِيرٗا","многие",5,81],["مِّنۡهُمۡ","из них",5,81],["فَٰسِقُونَ","нечестивцы",5,81]],[[81],["۞ لَتَجِدَنَّ","непременно найдешь",5,82],["أَشَدَّ","самыми сильными",5,82],["ٱلنَّاسِ","из людей",5,82],["عَدَٰوَةٗ","во вражде",5,82],["لِّلَّذِينَ","к тем, которые",5,82],["ءَامَنُواْ","уверовали",5,82],["ٱلۡيَهُودَ","иудеев",5,82]],[["وَٱلَّذِينَ","и тех, которые",5,82],["أَشۡرَكُواْۖ","приобщали сотоварищей",5,82],["وَلَتَجِدَنَّ","и непременно найдешь",5,82],["أَقۡرَبَهُم","ближайшими из них",5,82],["مَّوَدَّةٗ","в любви",5,82],["لِّلَّذِينَ","к тем, которые",5,82]],[["ءَامَنُواْ","уверовали",5,82],["ٱلَّذِينَ","тех, которые",5,82],["قَالُوٓاْ","сказали",5,82],["إِنَّا","поистине, мы",5,82],["نَصَٰرَىٰۚ","христиане",5,82],["ذَٰلِكَ","это",5,82],["بِأَنَّ","потому, что",5,82],["مِنۡهُمۡ","среди них",5,82]],[["قِسِّيسِينَ","священники",5,82],["وَرُهۡبَانٗا","и монахи",5,82],["وَأَنَّهُمۡ","и что они",5,82],["لَا","не",5,82],["يَسۡتَكۡبِرُونَ","превозносятся",5,82],[82]]]}