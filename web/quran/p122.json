{"p":122,"j":7,"a":[[5,83,["وَإِذَا","سَمِعُواْ","مَآ","أُنزِلَ","إِلَى","ٱلرَّسُولِ","تَرَىٰٓ","أَعۡيُنَهُمۡ","تَفِيضُ","مِنَ","ٱلدَّمۡعِ","مِمَّا","عَرَفُواْ","مِنَ","ٱلۡحَقِّۖ","يَقُولُونَ","رَبَّنَآ","ءَامَنَّا","فَٱكۡتُبۡنَا","مَعَ","ٱلشَّٰهِدِينَ"],"ва'иза сами`уу ма унзила илар расуули тара а`йунахум тафииду минад дам`и мимма `арафуу минал хаḳḳи йаḳуулууна раббана аманна фактубна ма`аш шахидиин","Когда они слышат то, что было ниспослано Посланнику, ты видишь, как их глаза переполняются слезами по причине истины, которую они узнают. Они говорят: «Господь наш! Мы уверовали. Запиши же нас в число свидетелей.",["и когда","услышали они","то, что","ниспослано","к","Посланнику","ты видишь","их глаза","переполняются","от","слёз","из-за того, что","узнали они","из","истины","говорят они","Господь наш","мы уверовали","так запиши нас","вместе с","свидетелями"]],[5,84,["وَمَا","لَنَا","لَا","نُؤۡمِنُ","بِٱللَّهِ","وَمَا","جَآءَنَا","مِنَ","ٱلۡحَقِّ","وَنَطۡمَعُ","أَن","يُدۡخِلَنَا","رَبُّنَا","مَعَ","ٱلۡقَوۡمِ","ٱلصَّٰلِحِينَ"],"вама лана ла ну'мину биллахи вама жаана минал хаḳḳи ванатма`у ан йудхилана раббуна ма`ал ḳаумис салихиин","Отчего нам не веровать в Аллаха и ту истину, которая явилась к нам? Мы желаем, чтобы наш Господь ввел нас вРай вместе с праведными людьми».",["и что","у нас","не","мы веруем","в Аллаха","и в то, что","пришло к нам","из","истины","и мы желаем","чтобы","ввел нас","наш Господь","вместе с","людьми","праведными"]],[5,85,["فَأَثَٰبَهُمُ","ٱللَّهُ","بِمَا","قَالُواْ","جَنَّٰتٖ","تَجۡرِي","مِن","تَحۡتِهَا","ٱلۡأَنۡهَٰرُ","خَٰلِدِينَ","فِيهَاۚ","وَذَٰلِكَ","جَزَآءُ","ٱلۡمُحۡسِنِينَ"],"фа'асабахумуллаху бима ḳалуу жаннатин тажрии мин тахтихал анхару халидиина фииха вазалика жазаул мухсиниин","Аллах вознаградил их за то, что они сказали, Райскими садами, в которых текут реки и в которых они пребудут вечно. Таково воздаяние творящим добро.",["и вознаградил их","Аллах","за то, что","сказали они","садами","течет","из","под ними","реки","вечно пребывающими","в них","и это","воздаяние","творящих добро"]],[5,86,["وَٱلَّذِينَ","كَفَرُواْ","وَكَذَّبُواْ","بِـَٔايَٰتِنَآ","أُوْلَٰٓئِكَ","أَصۡحَٰبُ","ٱلۡجَحِيمِ"],"валлазиина кафаруу ваказзабуу би'айатина улаика асхабул жахиим","А те, которые не уверовали и сочли ложью Наши знамения, являются обитателями Ада.",["а те, которые","не уверовали","и сочли ложью","Наши знамения","те","обитатели","Ада"]],[5,87,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُواْ","لَا","تُحَرِّمُواْ","طَيِّبَٰتِ","مَآ","أَحَلَّ","ٱللَّهُ","لَكُمۡ","وَلَا","تَعۡتَدُوٓاْۚ","إِنَّ","ٱللَّهَ","لَا","يُحِبُّ","ٱلۡمُعۡتَدِينَ"],"йа'аййухал лазиина амануу ла тухарримуу таййибати ма ахаллаллаху лакум вала та`тадуу инналлаха ла йухиббул му`тадиин","О те, которые уверовали! Не запрещайте блага, которые Аллах сделал дозволенными для вас, и не преступайте границы дозволенного. Воистину, Аллах не любит преступников.",["о","те, которые","уверовали","не","запрещайте","блага","того, что","дозволил","Аллах","вам","и не","преступайте","поистине","Аллах","не","любит","преступающих"]],[5,88,["وَكُلُواْ","مِمَّا","رَزَقَكُمُ","ٱللَّهُ","حَلَٰلٗا","طَيِّبٗاۚ","وَٱتَّقُواْ","ٱللَّهَ","ٱلَّذِيٓ","أَنتُم","بِهِۦ","مُؤۡمِنُونَ"],"вакулуу мимма разаḳакумуллаху халалан таййибан ваттаḳуллахал лазии антум бихии му'минуун","Ешьте из того, чем Аллах наделил вас, дозволенное и благое, и бойтесь Аллаха, в Которого вы веруете.",["и ешьте","из того, чем","наделил вас","Аллах","дозволенное","благое","и бойтесь","Аллаха","Которого","вы","в Него","верующие"]],[5,89,["لَا","يُؤَاخِذُكُمُ","ٱللَّهُ","بِٱللَّغۡوِ","فِيٓ","أَيۡمَٰنِكُمۡ","وَلَٰكِن","يُؤَاخِذُكُم","بِمَا","عَقَّدتُّمُ","ٱلۡأَيۡمَٰنَۖ","فَكَفَّٰرَتُهُۥٓ","إِطۡعَامُ","عَشَرَةِ","مَسَٰكِينَ","مِنۡ","أَوۡسَطِ","مَا","تُطۡعِمُونَ","أَهۡلِيكُمۡ","أَوۡ","كِسۡوَتُهُمۡ","أَوۡ","تَحۡرِيرُ","رَقَبَةٖۖ","فَمَن","لَّمۡ","يَجِدۡ","فَصِيَامُ","ثَلَٰثَةِ","أَيَّامٖۚ","ذَٰلِكَ","كَفَّٰرَةُ","أَيۡمَٰنِكُمۡ","إِذَا","حَلَفۡتُمۡۚ","وَٱحۡفَظُوٓاْ","أَيۡمَٰنَكُمۡۚ","كَذَٰلِكَ","يُبَيِّنُ","ٱللَّهُ","لَكُمۡ","ءَايَٰتِهِۦ","لَعَلَّكُمۡ","تَشۡكُرُونَ"],"ла йу'ахизукумуллаху биллагви фии айманикум валакин йу'ахизукум бима `аḳḳадттумул аймана факаффаратухуу ит`аму `ашарати масакиина мин аусати ма тут`имууна ахлиикум ау кисватухум ау тахрииру раḳабатин фамал лам йажид фасийаму саласати аййамин залика каффарату айманикум иза халафтум вахфазуу айманакум казалика йубаййинуллаху лакум айатихии ла`аллакум ташкуруун","Аллах не взыщет с вас за празднословные клятвы, но взыщет за то, что вы скрепили клятвами. В искупление этого необходимо накормить десятерых бедняков средним (или лучшим) из того, чем вы кормите свои семьи, или одеть их, или освободить раба. Кто не сможет сделать этого, тот должен поститься в течение трех дней. Таково искупление ваших клятв, если вы поклялись инарушили клятву. Оберегайте же свои клятвы. Так Аллах разъясняет вам Свои знамения, - быть может, вы будете благодарны.",["не","взыщет с вас","Аллах","за пустое","в","ваших клятвах","но","взыщет Он с вас","за то, что","вы скрепили","клятвами","и искупление этого","кормление","десяти","бедняков","из","среднего","того, что","вы кормите","ваши семьи","или","одевание их","или","освобождение","раба","а кто","не","найдет","то пост","трех","дней","это","искупление","ваших клятв","когда","вы поклялись","и оберегайте","ваши клятвы","так","разъясняет","Аллах","вам","Свои знамения","быть может, вы","будете благодарны"]]],"m":[[["وَإِذَا","и когда",5,83],["سَمِعُواْ","услышали они",5,83],["مَآ","то, что",5,83],["أُنزِلَ","ниспослано",5,83],["إِلَى","к",5,83],["ٱلرَّسُولِ","Посланнику",5,83],["تَرَىٰٓ","ты видишь",5,83],["أَعۡيُنَهُمۡ","их глаза",5,83],["تَفِيضُ","переполняются",5,83],["مِنَ","от",5,83]],[["ٱلدَّمۡعِ","слёз",5,83],["مِمَّا","из-за того, что",5,83],["عَرَفُواْ","узнали они",5,83],["مِنَ","из",5,83],["ٱلۡحَقِّۖ","истины",5,83],["يَقُولُونَ","говорят они",5,83],["رَبَّنَآ","Господь наш",5,83],["ءَامَنَّا","мы уверовали",5,83],["فَٱكۡتُبۡنَا","так запиши нас",5,83],["مَعَ","вместе с",5,83]],[["ٱلشَّٰهِدِينَ","свидетелями",5,83],[83],["وَمَا","и что",5,84],["لَنَا","у нас",5,84],["لَا","не",5,84],["نُؤۡمِنُ","мы веруем",5,84],["بِٱللَّهِ","в Аллаха",5,84],["وَمَا","и в то, что",5,84],["جَآءَنَا","пришло к нам",5,84],["مِنَ","из",5,84],["ٱلۡحَقِّ","истины",5,84]],[["وَنَطۡمَعُ","и мы желаем",5,84],["أَن","чтобы",5,84],["يُدۡخِلَنَا","ввел нас",5,84],["رَبُّنَا","наш Господь",5,84],["مَعَ","вместе с",5,84],["ٱلۡقَوۡمِ","людьми",5,84],["ٱلصَّٰلِحِينَ","праведными",5,84],[84],["فَأَثَٰبَهُمُ","и вознаградил их",5,85]],[["ٱللَّهُ","Аллах",5,85],["بِمَا","за то, что",5,85],["قَالُواْ","сказали они",5,85],["جَنَّٰتٖ","садами",5,85],["تَجۡرِي","течет",5,85],["مِن","из",5,85],["تَحۡتِهَا","под ними",5,85],["ٱلۡأَنۡهَٰرُ","реки",5,85],["خَٰلِدِينَ","вечно пребывающими",5,85],["فِيهَاۚ","в них",5,85]],[["وَذَٰلِكَ","и это",5,85],["جَزَآءُ","воздаяние",5,85],["ٱلۡمُحۡسِنِينَ","творящих добро",5,85],[85],["وَٱلَّذِينَ","а те, которые",5,86],["كَفَرُواْ","не уверовали",5,86],["وَكَذَّبُواْ","и сочли ложью",5,86]],[["بِـَٔايَٰتِنَآ","Наши знамения",5,86],["أُوْلَٰٓئِكَ","те",5,86],["أَصۡحَٰبُ","обитатели",5,86],["ٱلۡجَحِيمِ","Ада",5,86],[86],["يَٰٓأَيُّهَا","о",5,87],["ٱلَّذِينَ","те, которые",5,87],["ءَامَنُواْ","уверовали",5,87]],[["لَا","не",5,87],["تُحَرِّمُواْ","запрещайте",5,87],["طَيِّبَٰتِ","блага",5,87],["مَآ","того, что",5,87],["أَحَلَّ","дозволил",5,87],["ٱللَّهُ","Аллах",5,87],["لَكُمۡ","вам",5,87],["وَلَا","и не",5,87],["تَعۡتَدُوٓاْۚ","преступайте",5,87],["إِنَّ","поистине",5,87],["ٱللَّهَ","Аллах",5,87]],[["لَا","не",5,87],["يُحِبُّ","любит",5,87],["ٱلۡمُعۡتَدِينَ","преступающих",5,87],[87],["وَكُلُواْ","и ешьте",5,88],["مِمَّا","из того, чем",5,88],["رَزَقَكُمُ","наделил вас",5,88],["ٱللَّهُ","Аллах",5,88],["حَلَٰلٗا","дозволенное",5,88],["طَيِّبٗاۚ","благое",5,88]],[["وَٱتَّقُواْ","и бойтесь",5,88],["ٱللَّهَ","Аллаха",5,88],["ٱلَّذِيٓ","Которого",5,88],["أَنتُم","вы",5,88],["بِهِۦ","в Него",5,88],["مُؤۡمِنُونَ","верующие",5,88],[88],["لَا","не",5,89],["يُؤَاخ