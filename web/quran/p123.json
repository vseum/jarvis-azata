95],["ٱلۡكَعۡبَةِ","Каабы",5,95],["أَوۡ","или",5,95],["كَفَّٰرَةٞ","искупление",5,95],["طَعَامُ","кормление",5,95]],[["مَسَٰكِينَ","бедняков",5,95],["أَوۡ","или",5,95],["عَدۡلُ","равноценное",5,95],["ذَٰلِكَ","этому",5,95],["صِيَامٗا","постом",5,95],["لِّيَذُوقَ","чтобы вкусил он",5,95],["وَبَالَ","пагубность",5,95],["أَمۡرِهِۦۗ","своего дела",5,95],["عَفَا","простил",5,95],["ٱللَّهُ","Аллах",5,95],["عَمَّا","то, что",5,95]],[["سَلَفَۚ","было прежде",5,95],["وَمَنۡ","а кто",5,95],["عَادَ","вернется",5,95],["فَيَنتَقِمُ","то отомстит",5,95],["ٱللَّهُ","Аллах",5,95],["مِنۡهُۚ","ему",5,95],["وَٱللَّهُ","и Аллах",5,95],["عَزِيزٞ","Могущественный",5,95],["ذُو","Обладатель",5,95],["ٱنتِقَامٍ","возмездия",5,95],[95]]]}