{"p":123,"j":7,"a":[[5,90,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُوٓاْ","إِنَّمَا","ٱلۡخَمۡرُ","وَٱلۡمَيۡسِرُ","وَٱلۡأَنصَابُ","وَٱلۡأَزۡلَٰمُ","رِجۡسٞ","مِّنۡ","عَمَلِ","ٱلشَّيۡطَٰنِ","فَٱجۡتَنِبُوهُ","لَعَلَّكُمۡ","تُفۡلِحُونَ"],"йа'аййухал лазиина амануу иннамал хамру валмайсиру вал'ансабу вал'азламу рижсум мин `амалиш шайтани фажтанибууху ла`аллакум туфлихуун","О те, которые уверовали! Воистину, опьяняющие напитки, азартные игры, каменные жертвенники (или идолы) и гадальные стрелы являются скверной из деяний дьявола. Сторонитесь же ее, - быть может, вы преуспеете.",["о","те, которые","уверовали","поистине","опьяняющее","и азартные игры","и жертвенники","и гадальные стрелы","скверна","из","деяния","дьявола","так сторонитесь его","быть может, вы","преуспеете"]],[5,91,["إِنَّمَا","يُرِيدُ","ٱلشَّيۡطَٰنُ","أَن","يُوقِعَ","بَيۡنَكُمُ","ٱلۡعَدَٰوَةَ","وَٱلۡبَغۡضَآءَ","فِي","ٱلۡخَمۡرِ","وَٱلۡمَيۡسِرِ","وَيَصُدَّكُمۡ","عَن","ذِكۡرِ","ٱللَّهِ","وَعَنِ","ٱلصَّلَوٰةِۖ","فَهَلۡ","أَنتُم","مُّنتَهُونَ"],"иннама йуриидуш шайтану ан йууḳи`а байнакумул `адавата валбагдаа фил хамри валмайсири вайасуддакум `ан зикриллахи ва`анис салавати фахал антум мунтахуун","Воистину, дьявол при помощи опьяняющих напитков и азартных игр хочет посеять между вами вражду и ненависть и отвратить вас от поминания Аллаха и намаза. Неужели вы не прекратите?",["лишь","хочет","дьявол","чтобы","посеять","между вами","вражду","и ненависть","через","опьяняющее","и азартные игры","и отвратить вас","от","поминания","Аллаха","и от","намаза","так разве","вы","прекратите"]],[5,92,["وَأَطِيعُواْ","ٱللَّهَ","وَأَطِيعُواْ","ٱلرَّسُولَ","وَٱحۡذَرُواْۚ","فَإِن","تَوَلَّيۡتُمۡ","فَٱعۡلَمُوٓاْ","أَنَّمَا","عَلَىٰ","رَسُولِنَا","ٱلۡبَلَٰغُ","ٱلۡمُبِينُ"],"ва'атии`уллаха ва'атии`ур расуула вахзаруу фа'ин таваллайтум фа`ламуу аннама `ала расуулинал балагул мубиин","Повинуйтесь Аллаху, повинуйтесь Посланнику и остерегайтесь! Но если вы отвернетесь, то знайте, что на Нашего Посланника возложена только ясная передача откровения.",["и повинуйтесь","Аллаху","и повинуйтесь","Посланнику","и остерегайтесь","а если","вы отвернетесь","то знайте","что лишь","на","Нашем Посланнике","передача","ясная"]],[5,93,["لَيۡسَ","عَلَى","ٱلَّذِينَ","ءَامَنُواْ","وَعَمِلُواْ","ٱلصَّٰلِحَٰتِ","جُنَاحٞ","فِيمَا","طَعِمُوٓاْ","إِذَا","مَا","ٱتَّقَواْ","وَّءَامَنُواْ","وَعَمِلُواْ","ٱلصَّٰلِحَٰتِ","ثُمَّ","ٱتَّقَواْ","وَّءَامَنُواْ","ثُمَّ","ٱتَّقَواْ","وَّأَحۡسَنُواْۚ","وَٱللَّهُ","يُحِبُّ","ٱلۡمُحۡسِنِينَ"],"лайса `алал лазиина амануу ва`амилус салихати жунахун фиима та`имуу иза маттаḳав вва'амануу ва`амилус салихати сумматтаḳав вва'амануу сумматтаḳав вва'ахсануу валлаху йухиббул мухсиниин","На тех, которые уверовали и совершают праведные деяния, нет греха за то, чем они питались, если они были богобоязненны, веровали и совершали праведные деяния, если после этого они опять были богобоязненны и веровали, если после этого они опять были богобоязненны и творили добро. Ведь Аллах любит творящих добро.",["нет","на","тех, которые","уверовали","и совершали","праведные дела","греха","в том, что","они вкусили","если","только","они были богобоязненны","и уверовали","и совершали","праведные дела","затем","были богобоязненны","и уверовали","затем","были богобоязненны","и творили добро","и Аллах","любит","творящих добро"]],[5,94,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُواْ","لَيَبۡلُوَنَّكُمُ","ٱللَّهُ","بِشَيۡءٖ","مِّنَ","ٱلصَّيۡدِ","تَنَالُهُۥٓ","أَيۡدِيكُمۡ","وَرِمَاحُكُمۡ","لِيَعۡلَمَ","ٱللَّهُ","مَن","يَخَافُهُۥ","بِٱلۡغَيۡبِۚ","فَمَنِ","ٱعۡتَدَىٰ","بَعۡدَ","ذَٰلِكَ","فَلَهُۥ","عَذَابٌ","أَلِيمٞ"],"йа'аййухал лазиина амануу лайаблуаннакумуллаху бишай'им минас сайди таналухуу айдиикум варимахукум лийа`ламаллаху ман йахафухуу билгайби фамани`тада ба`да залика фалахуу `азабун алиим","О те, которые уверовали! Аллах обязательно подвергнет вас испытанию охотничьей добычей, которую смогут достать ваши руки и копья, чтобы Аллах узнал тех, кто боится Его, не видя Его воочию (или втайне от людей). А кто преступит границы дозволенного после этого, тому будут уготованы мучительные страдания.",["о","те, которые","уверовали","непременно испытает вас","Аллах","чем-то","из","дичи","достают ее","ваши руки","и ваши копья","чтобы узнал","Аллах","кто","боится Его","втайне","а кто","преступит","после","этого","то ему","наказание","мучительное"]],[5,95,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُواْ","لَا","تَقۡتُلُواْ","ٱلصَّيۡدَ","وَأَنتُمۡ","حُرُمٞۚ","وَمَن","قَتَلَهُۥ","مِنكُم","مُّتَعَمِّدٗا","فَجَزَآءٞ","مِّثۡلُ","مَا","قَتَلَ","مِنَ","ٱلنَّعَمِ","يَحۡكُمُ","بِهِۦ","ذَوَا","عَدۡلٖ","مِّنكُمۡ","هَدۡيَۢا","بَٰلِغَ","ٱلۡكَعۡبَةِ","أَوۡ","كَفَّٰرَةٞ","طَعَامُ","مَسَٰكِينَ","أَوۡ","عَدۡلُ","ذَٰلِكَ","صِيَامٗا","لِّيَذُوقَ","وَبَالَ","أَمۡرِهِۦۗ","عَفَا","ٱللَّهُ","عَمَّا","سَلَفَۚ","وَمَنۡ","عَادَ","فَيَنتَقِمُ","ٱللَّهُ","مِنۡهُۚ","وَٱللَّهُ","عَزِيزٞ","ذُو","ٱنتِقَامٍ"],"йа'аййухал лазиина амануу ла таḳтулус сайда ва'антум хурумун ваман ḳаталахуу минкум мута`аммидан фажазаум мислу ма ḳатала минан на`ами йахкуму бихии зава `адлим минкум хадйа балигал ка`бати ау каффаратун та`аму масакиина ау `адлу залика сийамал лийазууḳа вабала амрихии `афаллаху `амма салафа ваман `ада файантаḳимуллаху минху валлаху `азиизун зунтиḳам","О те, которые уверовали! Не убивайте охотничью добычу, находясь в ихраме. Если кто-нибудь из вас убьет ее преднамеренно, то воздаянием за это будет скотина, подобная той, что он убил. Выносят решение о ней (о жертвенной скотине) двое справедливых мужей из вас, и эта жертва должна достичь Каабы. Или же для искупления этого следует накормить бедняков или соблюсти равноценный пост, дабы он вкусил пагубность своего поступка. Аллах простил то, что было прежде, но если кто-нибудь вернется к этому, то Аллах отомстит ему. Аллах - Могущественный, Способный на возмездие.",["о","те, которые","уверовали","не","убивайте","дичь","когда вы","в ихраме","а кто","убьет ее","из вас","умышленно","то воздаяние","подобное","тому, что","он убил","из","скота","судят","о нем","двое","справедливых","из вас","жертвенным животным","достигающим","Каабы","или","искупление","кормление","бедняков","или","равноценное","этому","постом","чтобы вкусил он","пагубность","своего дела","простил","Аллах","то, что","было прежде","а кто","вернется","то отомстит","Аллах","ему","и Аллах","Могущественный","Обладатель","возмездия"]]],"m":[[["يَٰٓأَيُّهَا","о",5,90],["ٱلَّذِينَ","те, которые",5,90],["ءَامَنُوٓاْ","уверовали",5,90],["إِنَّمَا","поистине",5,90],["ٱلۡخَمۡرُ","опьяняющее",5,90],["وَٱلۡمَيۡسِرُ","и азартные игры",5,90],["وَٱلۡأَنصَابُ","и жертвенники",5,90],["وَٱلۡأَزۡلَٰمُ","и гадальные стрелы",5,90],["رِجۡسٞ","скверна",5,90]],[["مِّنۡ","из",5,90],["عَمَلِ","деяния",5,90],["ٱلشَّيۡطَٰنِ","дьявола",5,90],["فَٱجۡتَنِبُوهُ","так сторонитесь его",5,90],["لَعَلَّكُمۡ","быть может, вы",5,90],["تُفۡلِحُونَ","преуспеете",5,90],[90],["إِنَّمَا","лишь",5,91],["يُرِيدُ","хочет",5,91]],[["ٱلشَّيۡطَٰنُ","дьявол",5,91],["أَن","чтобы",5,91],["يُوقِعَ","посеять",5,91],["بَيۡنَكُمُ","между вами",5,91],["ٱلۡعَدَٰوَةَ","вражду",5,91],["وَٱلۡبَغۡضَآءَ","и ненависть",5,91],["فِي","через",5,91],["ٱلۡخَمۡرِ","опьяняющее",5,91],["وَٱلۡمَيۡسِرِ","и азартные игры",5,91]],[["وَيَصُدَّكُمۡ","и отвратить вас",5,91],["عَن","от",5,91],["ذِكۡرِ","поминания",5,91],["ٱللَّهِ","Аллаха",5,91],["وَعَنِ","и от",5,91],["ٱلصَّلَوٰةِۖ","намаза",5,91],["فَهَلۡ","так разве",5,91],["أَنتُم","вы",5,91],["مُّنتَهُونَ","прекратите",5,91],[91],["وَأَطِيعُواْ","и повинуйтесь",5,92]],[["ٱللَّهَ","Аллаху",5,92],["وَأَطِيعُواْ","и повинуйтесь",5,92],["ٱلرَّسُولَ","Посланнику",5,92],["وَٱحۡذَرُواْۚ","и остерегайтесь",5,92],["فَإِن","а если",5,92],["تَوَلَّيۡتُمۡ","вы отвернетесь",5,92],["فَٱعۡلَمُوٓاْ","то знайте",5,92],["أَنَّمَا","что лишь",5,92],["عَلَىٰ","на",5,92]],[["رَسُولِنَا","Нашем Посланнике",5,92],["ٱلۡبَلَٰغُ","передача",5,92],["ٱلۡمُبِينُ","ясная",5,92],[92],["لَيۡسَ","нет",5,93],["عَلَى","на",5,93],["ٱلَّذِينَ","тех, которые",5,93],["ءَامَنُواْ","уверовали",5,93],["وَعَمِلُواْ","и совершали",5,93]],[["ٱلصَّٰلِحَٰتِ","правед