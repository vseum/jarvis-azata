{"p":124,"j":7,"a":[[5,96,["أُحِلَّ","لَكُمۡ","صَيۡدُ","ٱلۡبَحۡرِ","وَطَعَامُهُۥ","مَتَٰعٗا","لَّكُمۡ","وَلِلسَّيَّارَةِۖ","وَحُرِّمَ","عَلَيۡكُمۡ","صَيۡدُ","ٱلۡبَرِّ","مَا","دُمۡتُمۡ","حُرُمٗاۗ","وَٱتَّقُواْ","ٱللَّهَ","ٱلَّذِيٓ","إِلَيۡهِ","تُحۡشَرُونَ"],"ухилла лакум сайдул бахри вата`амухуу мата`ал лакум валиссаййарати вахуррима `алайкум сайдул барри ма думтум хуруман ваттаḳуллахал лазии илайхи тухшаруун","Вам дозволены морская добыча и еда во благо вам и путникам, но вам запрещена охотничья добыча на суше, пока вы находитесь в ихраме. Бойтесь Аллаха, к Которому вы будете собраны.",["дозволена","вам","добыча","моря","и его пища","как польза","вам","и путникам","и запрещена","вам","добыча","суши","пока","вы пребываете","в ихраме","и бойтесь","Аллаха","Которого","к Нему","вы будете собраны"]],[5,97,["جَعَلَ","ٱللَّهُ","ٱلۡكَعۡبَةَ","ٱلۡبَيۡتَ","ٱلۡحَرَامَ","قِيَٰمٗا","لِّلنَّاسِ","وَٱلشَّهۡرَ","ٱلۡحَرَامَ","وَٱلۡهَدۡيَ","وَٱلۡقَلَٰٓئِدَۚ","ذَٰلِكَ","لِتَعۡلَمُوٓاْ","أَنَّ","ٱللَّهَ","يَعۡلَمُ","مَا","فِي","ٱلسَّمَٰوَٰتِ","وَمَا","فِي","ٱلۡأَرۡضِ","وَأَنَّ","ٱللَّهَ","بِكُلِّ","شَيۡءٍ","عَلِيمٌ"],"жа`алаллахул ка`батал байтал харама ḳийамал линнаси вашшахрал харама валхадйа валḳалаида залика лита`ламуу анналлаха йа`ламу ма фис самавати вама фил арди ва'анналлаха бикулли шай'ин `алиим","Аллах сделал Каабу, Заповедный дом, а также запретный месяц, жертвенных животных и животных (или людей) с ожерельями опорой для людей. Это - для того, чтобы вы знали, что Аллаху известно о том, что на небесах, и том, что на земле, и что Аллах ведает о всякой вещи.",["сделал","Аллах","Каабу","Дом","Заповедный","опорой","для людей","и месяц","запретный","и жертвенных животных","и ожерелья","это","чтобы вы знали","что","Аллах","знает","то, что","в","небесах","и то, что","в","земле","и что","Аллах","о всякой","вещи","Знающий"]],[5,98,["ٱعۡلَمُوٓاْ","أَنَّ","ٱللَّهَ","شَدِيدُ","ٱلۡعِقَابِ","وَأَنَّ","ٱللَّهَ","غَفُورٞ","رَّحِيمٞ"],"и`ламуу анналлаха шадиидул `иḳаби ва'анналлаха гафуурур рахиим","Знайте, что Аллах суров в наказании и что Аллах - Прощающий, Милосердный.",["знайте","что","Аллах","суров","в наказании","и что","Аллах","Прощающий","Милосердный"]],[5,99,["مَّا","عَلَى","ٱلرَّسُولِ","إِلَّا","ٱلۡبَلَٰغُۗ","وَٱللَّهُ","يَعۡلَمُ","مَا","تُبۡدُونَ","وَمَا","تَكۡتُمُونَ"],"мма `алар расуули иллал балагу валлаху йа`ламу ма тубдууна вама тактумуун","На Пророка не возложено ничего, кроме передачи откровения. Аллах знает о том, что вы обнаруживаете, и том, что вы скрываете.",["не","на","Посланнике","кроме","передачи","и Аллах","знает","то, что","вы обнаруживаете","и то, что","вы скрываете"]],[5,100,["قُل","لَّا","يَسۡتَوِي","ٱلۡخَبِيثُ","وَٱلطَّيِّبُ","وَلَوۡ","أَعۡجَبَكَ","كَثۡرَةُ","ٱلۡخَبِيثِۚ","فَٱتَّقُواْ","ٱللَّهَ","يَٰٓأُوْلِي","ٱلۡأَلۡبَٰبِ","لَعَلَّكُمۡ","تُفۡلِحُونَ"],"ḳул ла йаставил хабиису ваттаййибу валау а`жабака касратул хабииси фаттаḳуллаха йа'улил албаби ла`аллакум туфлихуун","Скажи: «Скверное и благое не равны, даже если изобилие скверного понравилось тебе (или удивило тебя)». Бойтесь же Аллаха, обладатели разума, - быть может, вы преуспеете.",["скажи","не","равны","скверное","и благое","даже если","восхитило тебя","обилие","скверного","так бойтесь","Аллаха","о обладатели","разума","быть может, вы","преуспеете"]],[5,101,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُواْ","لَا","تَسۡـَٔلُواْ","عَنۡ","أَشۡيَآءَ","إِن","تُبۡدَ","لَكُمۡ","تَسُؤۡكُمۡ","وَإِن","تَسۡـَٔلُواْ","عَنۡهَا","حِينَ","يُنَزَّلُ","ٱلۡقُرۡءَانُ","تُبۡدَ","لَكُمۡ","عَفَا","ٱللَّهُ","عَنۡهَاۗ","وَٱللَّهُ","غَفُورٌ","حَلِيمٞ"],"йа'аййухал лазиина амануу ла тас'алуу `ан ашйаа ин тубда лакум тасу'кум ва'ин тас'алуу `анха хиина йуназзалул ḳур'ану тубда лакум `афаллаху `анха валлаху гафуурун халиим","О те, которые уверовали! Не спрашивайте о вещах, которые огорчат вас, если станут вам известны. А ведь они станут вам известны, если вы спросите о них, когда ниспосылается Коран. Аллах простил вам это, ибо Аллах - Прощающий, Выдержанный.",["о","те, которые","уверовали","не","спрашивайте","о","вещах","если","откроются","вам","огорчат вас","а если","спросите","о них","когда","ниспосылается","Коран","откроются","вам","простил","Аллах","это","и Аллах","Прощающий","Выдержанный"]],[5,102,["قَدۡ","سَأَلَهَا","قَوۡمٞ","مِّن","قَبۡلِكُمۡ","ثُمَّ","أَصۡبَحُواْ","بِهَا","كَٰفِرِينَ"],"ḳад са'алаха ḳаумум мин ḳабликум сумма асбахуу биха кафириин","Люди до вас спрашивали о них и по этой причине стали неверующими (или затем стали неверующими в них).",["уже","спрашивали о них","люди","ещё","до вас","затем","стали","из-за них","неверующими"]],[5,103,["مَا","جَعَلَ","ٱللَّهُ","مِنۢ","بَحِيرَةٖ","وَلَا","سَآئِبَةٖ","وَلَا","وَصِيلَةٖ","وَلَا","حَامٖ","وَلَٰكِنَّ","ٱلَّذِينَ","كَفَرُواْ","يَفۡتَرُونَ","عَلَى","ٱللَّهِ","ٱلۡكَذِبَۖ","وَأَكۡثَرُهُمۡ","لَا","يَعۡقِلُونَ"],"ма жа`алаллаху мим бахииратин вала саибатин вала васиилатин вала хамин валакиннал лазиина кафаруу йафтарууна `алаллахил казиба ва'аксарухум ла йа`ḳилуун","Аллах не распоряжался относительно бахиры, саибы, васыли и хами. Но неверующие возводят навет на Аллаха, и большая часть их не разумеет.",["не","установил","Аллах","никакой","бахиры","и не","саибы","и не","васили","и не","хами","но","те, которые","не уверовали","возводят","на","Аллаха","ложь","и большинство из них","не","разумеют"]]],"m":[[["أُحِلَّ","дозволена",5,96],["لَكُمۡ","вам",5,96],["صَيۡدُ","добыча",5,96],["ٱلۡبَحۡرِ","моря",5,96],["وَطَعَامُهُۥ","и его пища",5,96],["مَتَٰعٗا","как польза",5,96],["لَّكُمۡ","вам",5,96],["وَلِلسَّيَّارَةِۖ","и путникам",5,96],["وَحُرِّمَ","и запрещена",5,96]],[["عَلَيۡكُمۡ","вам",5,96],["صَيۡدُ","добыча",5,96],["ٱلۡبَرِّ","суши",5,96],["مَا","пока",5,96],["دُمۡتُمۡ","вы пребываете",5,96],["حُرُمٗاۗ","в ихраме",5,96],["وَٱتَّقُواْ","и бойтесь",5,96],["ٱللَّهَ","Аллаха",5,96],["ٱلَّذِيٓ","Которого",5,96],["إِلَيۡهِ","к Нему",5,96]],[["تُحۡشَرُونَ","вы будете собраны",5,96],[96],["۞ جَعَلَ","сделал",5,97],["ٱللَّهُ","Аллах",5,97],["ٱلۡكَعۡبَةَ","Каабу",5,97],["ٱلۡبَيۡتَ","Дом",5,97],["ٱلۡحَرَامَ","Заповедн