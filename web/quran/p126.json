{"p":126,"j":7,"a":[[5,109,["يَوۡمَ","يَجۡمَعُ","ٱللَّهُ","ٱلرُّسُلَ","فَيَقُولُ","مَاذَآ","أُجِبۡتُمۡۖ","قَالُواْ","لَا","عِلۡمَ","لَنَآۖ","إِنَّكَ","أَنتَ","عَلَّٰمُ","ٱلۡغُيُوبِ"],"йаума йажма`уллахур русула файаḳуулу маза ужибтум ḳалуу ла `илма лана иннака анта `алламул гуйууб","В тот день, когда Аллах соберет посланников и скажет: «Что вам ответили?». - они скажут: «Мы не обладаем знанием. Воистину, Ты - Ведающий сокровенное».",["в день","соберёт","Аллах","посланников","и скажет Он","что","вам ответили","они сказали","нет","знания","у нас","поистине, Ты","Ты","Знающий","сокровенное"]],[5,110,["إِذۡ","قَالَ","ٱللَّهُ","يَٰعِيسَى","ٱبۡنَ","مَرۡيَمَ","ٱذۡكُرۡ","نِعۡمَتِي","عَلَيۡكَ","وَعَلَىٰ","وَٰلِدَتِكَ","إِذۡ","أَيَّدتُّكَ","بِرُوحِ","ٱلۡقُدُسِ","تُكَلِّمُ","ٱلنَّاسَ","فِي","ٱلۡمَهۡدِ","وَكَهۡلٗاۖ","وَإِذۡ","عَلَّمۡتُكَ","ٱلۡكِتَٰبَ","وَٱلۡحِكۡمَةَ","وَٱلتَّوۡرَىٰةَ","وَٱلۡإِنجِيلَۖ","وَإِذۡ","تَخۡلُقُ","مِنَ","ٱلطِّينِ","كَهَيۡـَٔةِ","ٱلطَّيۡرِ","بِإِذۡنِي","فَتَنفُخُ","فِيهَا","فَتَكُونُ","طَيۡرَۢا","بِإِذۡنِيۖ","وَتُبۡرِئُ","ٱلۡأَكۡمَهَ","وَٱلۡأَبۡرَصَ","بِإِذۡنِيۖ","وَإِذۡ","تُخۡرِجُ","ٱلۡمَوۡتَىٰ","بِإِذۡنِيۖ","وَإِذۡ","كَفَفۡتُ","بَنِيٓ","إِسۡرَٰٓءِيلَ","عَنكَ","إِذۡ","جِئۡتَهُم","بِٱلۡبَيِّنَٰتِ","فَقَالَ","ٱلَّذِينَ","كَفَرُواْ","مِنۡهُمۡ","إِنۡ","هَٰذَآ","إِلَّا","سِحۡرٞ","مُّبِينٞ"],"из ḳалаллаху йа`иисабна марйамазкур ни`матии `алайка ва`ала валидатика из аййадттука бируухил ḳудуси тукаллимун наса фил махди вакахлан ва'из `алламтукал китаба валхикмата ваттаурата вал'инжиила ва'из тахлуḳу минат тиини кахай'атит тайри би'изнии фатанфуху фииха фатакууну тайра би'изнии ватубриул акмаха вал'абраса би'изнии ва'из тухрижул маута би'изнии ва'из кафафту бании исраиила `анка из жи'тахум билбаййинати фаḳалал лазиина кафаруу минхум ин хаза илла сихрум мубиин","Аллах скажет: «О Иса (Иисус), сын Марьям (Марии)! Помни о милости, которую Я оказал тебе и твоей матери. Я поддержал тебя Святым Духом (Джибрилем), благодаря чему ты говорил с людьми в колыбели и будучи взрослым. Я научил тебя Писанию, мудрости, Таурату (Торе) и Инджилу (Евангелию). По Моему соизволению ты лепил изваяния птиц из глины и дул на них, и по Моему соизволению они становились птицами. По Моему соизволению ты исцелял слепого (или лишенного зрения от рождения; или обладающего слабым зрением) и прокаженного, по Моему соизволению ты выводил покойников живыми из могил. Я отвратил от тебя (защитил тебя от) сынов Исраила (Израиля), когда ты явился к ним с ясными знамениями, а неверующие из их числа сказали, что это - всего лишь очевидное колдовство».",["вот","сказал","Аллах","о Иса","сын","Марьям","помни","милость Мою","тебе","и","матери твоей","когда","Я поддержал тебя","Духом","Святым","ты говорил","с людьми","в","колыбели","и взрослым","и когда","Я научил тебя","Писанию","и мудрости","и Таурату","и Инджилу","и когда","ты лепил","из","глины","подобие","птицы","с Моего позволения","и ты дул","в неё","и она становилась","птицей","с Моего позволения","и ты исцелял","слепорождённого","и прокажённого","с Моего позволения","и когда","ты выводил","мёртвых","с Моего позволения","и когда","Я удержал","сынов","Исраила","от тебя","когда","ты пришёл к ним","с ясными знамениями","и сказали","те, которые","не уверовали","из них","не","это","лишь","колдовство","явное"]],[5,111,["وَإِذۡ","أَوۡحَيۡتُ","إِلَى","ٱلۡحَوَارِيِّـۧنَ","أَنۡ","ءَامِنُواْ","بِي","وَبِرَسُولِي","قَالُوٓاْ","ءَامَنَّا","وَٱشۡهَدۡ","بِأَنَّنَا","مُسۡلِمُونَ"],"ва'из аухайту илал хавариййиина ан аминуу бии вабирасуулии ḳалуу аманна вашхад би'аннана муслимуун","Я внушил апостолам: «Уверуйте в Меня и Моего посланника». Они сказали: «Мы уверовали! Засвидетельствуй же, что мы стали мусульманами».",["и когда","Я внушил","к","апостолам","чтобы","уверуйте","в Меня","и в посланника Моего","они сказали","мы уверовали","и засвидетельствуй","что мы","мусульмане"]],[5,112,["إِذۡ","قَالَ","ٱلۡحَوَارِيُّونَ","يَٰعِيسَى","ٱبۡنَ","مَرۡيَمَ","هَلۡ","يَسۡتَطِيعُ","رَبُّكَ","أَن","يُنَزِّلَ","عَلَيۡنَا","مَآئِدَةٗ","مِّنَ","ٱلسَّمَآءِۖ","قَالَ","ٱتَّقُواْ","ٱللَّهَ","إِن","كُنتُم","مُّؤۡمِنِينَ"],"из ḳалал хавариййууна йа`иисабна марйама хал йастатии`у раббука ан йуназзила `алайна маидатам минас самаи ḳалаттаḳуллаха ин кунтум му'миниин","Вот сказали апостолы: «О Иса (Иисус), сын Марьям (Марии)! Может ли твой Господь ниспослать нам трапезу с неба?». Он сказал: «Бойтесь Аллаха, если вы являетесь верующими».",["вот","сказали","апостолы","о Иса","сын","Марьям","разве","может","Господь твой","чтобы","ниспослал","нам","трапезу","с","неба","он сказал","бойтесь","Аллаха","если","вы являетесь","верующими"]],[5,113,["قَالُواْ","نُرِيدُ","أَن","نَّأۡكُلَ","مِنۡهَا","وَتَطۡمَئِنَّ","قُلُوبُنَا","وَنَعۡلَمَ","أَن","قَدۡ","صَدَقۡتَنَا","وَنَكُونَ","عَلَيۡهَا","مِنَ","ٱلشَّٰهِدِينَ"],"ḳалуу нурииду ан на'кула минха вататмаинна ḳулуубуна вана`лама ан ḳад садаḳтана ванакууна `алайха минаш шахидиин","Они сказали: «Мы хотим отведать ее, чтобы наши сердца успокоились, чтобы мы узнали, что ты сказал нам правду, и чтобы мы были свидетелями о ней».",["они сказали","мы хотим","чтобы","мы поели","из неё","и успокоились","сердца наши","и узнали мы","что","уже","ты сказал нам правду","и были мы","о ней","среди","свидетелей"]]],"m":[[["۞ يَوۡمَ","в день",5,109],["يَجۡمَعُ","соберёт",5,109],["ٱللَّهُ","Аллах",5,109],["ٱلرُّسُلَ","посланников",5,109],["فَيَقُولُ","и скажет Он",5,109],["مَاذَآ","что",5,109],["أُجِبۡتُمۡۖ","вам ответили",5,109],["قَالُواْ","они сказали",5,109],["لَا","нет",5,109],["عِلۡمَ","знания",5,109]],[["لَنَآۖ","у нас",5,109],["إِنَّكَ","поистине, Ты",5,109],["أَنتَ","Ты",5,109],["عَلَّٰمُ","Знающий",5,109],["ٱلۡغُيُوبِ","сокровенное",5,109],[109],["إِذۡ","вот",5,110],["قَالَ","сказал",5,110],["ٱللَّهُ","Аллах",5,110],["يَٰعِيسَى","о Иса",5,110],["ٱبۡنَ","сын",5,110],["مَرۡيَمَ","Марьям",5,110]],[["ٱذۡكُرۡ","помни",5,110],["نِعۡمَتِي","милость Мою",5,110],["عَلَيۡكَ","тебе",5,110],["وَعَلَىٰ","и",5,110],["وَٰلِدَتِكَ","матери твоей",5,110],["إِذۡ","когда",5,110],["أَيَّدتُّكَ","Я поддер