{"p":128,"j":7,"a":[[6,1,["ٱلۡحَمۡدُ","لِلَّهِ","ٱلَّذِي","خَلَقَ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضَ","وَجَعَلَ","ٱلظُّلُمَٰتِ","وَٱلنُّورَۖ","ثُمَّ","ٱلَّذِينَ","كَفَرُواْ","بِرَبِّهِمۡ","يَعۡدِلُونَ"],"алхамду лиллахил лазии халаḳас самавати вал'арда важа`алаз зулумати ваннуура суммал лазиина кафаруу бираббихим йа`дилуун","Хвала Аллаху, Который сотворил небеса и землю и установил мраки и свет. Но даже после этого те, которые не уверовали, приравнивают к своему Господу других.",["хвала","Аллаху","Который","сотворил","небеса","и землю","и установил","мраки","и свет","затем","те, которые","не уверовали","с Господом своим","приравнивают"]],[6,2,["هُوَ","ٱلَّذِي","خَلَقَكُم","مِّن","طِينٖ","ثُمَّ","قَضَىٰٓ","أَجَلٗاۖ","وَأَجَلٞ","مُّسَمًّى","عِندَهُۥۖ","ثُمَّ","أَنتُمۡ","تَمۡتَرُونَ"],"хуал лазии халаḳакум мин тиинин сумма ḳада ажалан ва'ажалум мусамман `индахуу сумма антум тамтаруун","Он - Тот, Кто сотворил вас из глины, а затем назначил срок для вашей смерти. У Него есть также назначенный срок для воскрешения, но после этого вы все еще препираетесь.",["Он","Тот, Который","сотворил вас","из","глины","затем","определил Он","срок","и срок","назначенный","у Него","затем","вы","сомневаетесь"]],[6,3,["وَهُوَ","ٱللَّهُ","فِي","ٱلسَّمَٰوَٰتِ","وَفِي","ٱلۡأَرۡضِ","يَعۡلَمُ","سِرَّكُمۡ","وَجَهۡرَكُمۡ","وَيَعۡلَمُ","مَا","تَكۡسِبُونَ"],"вахуаллаху фис самавати вафил арди йа`ламу сирракум важахракум вайа`ламу ма таксибуун","Он - Аллах на небесах и на земле. Он знает то, что вы утаиваете и совершаете открыто, и знает то, что вы приобретаете.",["и Он","Аллах","на","небесах","и на","земле","Он знает","тайное ваше","и явное ваше","и Он знает","что","вы приобретаете"]],[6,4,["وَمَا","تَأۡتِيهِم","مِّنۡ","ءَايَةٖ","مِّنۡ","ءَايَٰتِ","رَبِّهِمۡ","إِلَّا","كَانُواْ","عَنۡهَا","مُعۡرِضِينَ"],"вама та'тиихим мин айатим мин айати раббихим илла кануу `анха му`ридиин","Какое бы знамение из знамений их Господа ни являлось к ним, они отворачивались от него.",["и не","приходит к ним","никакое","знамение","из","знамений","Господа их","кроме как","были они","от него","отворачивающимися"]],[6,5,["فَقَدۡ","كَذَّبُواْ","بِٱلۡحَقِّ","لَمَّا","جَآءَهُمۡ","فَسَوۡفَ","يَأۡتِيهِمۡ","أَنۢبَٰٓؤُاْ","مَا","كَانُواْ","بِهِۦ","يَسۡتَهۡزِءُونَ"],"фаḳад каззабуу билхаḳḳи ламма жаахум фасауфа йа'тиихим амбау ма кануу бихии йастахзиуун","Они сочли ложью истину, когда она явилась к ним, но до них дойдут вести о том, над чем они насмехались.",["и уже","они сочли ложью","истину","когда","она пришла к ним","но вскоре","придут к ним","вести","о том, что","были они","над этим","насмехаются"]],[6,6,["أَلَمۡ","يَرَوۡاْ","كَمۡ","أَهۡلَكۡنَا","مِن","قَبۡلِهِم","مِّن","قَرۡنٖ","مَّكَّنَّٰهُمۡ","فِي","ٱلۡأَرۡضِ","مَا","لَمۡ","نُمَكِّن","لَّكُمۡ","وَأَرۡسَلۡنَا","ٱلسَّمَآءَ","عَلَيۡهِم","مِّدۡرَارٗا","وَجَعَلۡنَا","ٱلۡأَنۡهَٰرَ","تَجۡرِي","مِن","تَحۡتِهِمۡ","فَأَهۡلَكۡنَٰهُم","بِذُنُوبِهِمۡ","وَأَنشَأۡنَا","مِنۢ","بَعۡدِهِمۡ","قَرۡنًا","ءَاخَرِينَ"],"алам йарау кам ахлакна мин ḳаблихим мин ḳарним макканнахум фил арди ма лам нумаккил лакум ва'арсалнас самаа `алайхим мидраран важа`алнал анхара тажрии мин тахтихим фа'ахлакнахум бизунуубихим ва'анша'на мим ба`дихим ḳарнан ахариин","Разве они не видели, сколько поколений Мы погубили до них? Мы одарили их на земле властью, которой не одарили вас, ниспосылали им с неба обильные дожди и заставляли реки течь под ними. Мы погубили их за их грехи и создали после них другие поколения.",["разве не","видели они","сколько","Мы погубили","из","прежде них","из","поколений","Мы утвердили их","на","земле","как","не","утвердили Мы","вас","и Мы послали","небо","на них","обильно льющимся","и Мы сделали","реки","текут","из","под ними","и Мы погубили их","за грехи их","и Мы создали","из","после них","поколение","другое"]],[6,7,["وَلَوۡ","نَزَّلۡنَا","عَلَيۡكَ","كِتَٰبٗا","فِي","قِرۡطَاسٖ","فَلَمَسُوهُ","بِأَيۡدِيهِمۡ","لَقَالَ","ٱلَّذِينَ","كَفَرُوٓاْ","إِنۡ","هَٰذَآ","إِلَّا","سِحۡرٞ","مُّبِينٞ"],"валау наззална `алайка китабан фии ḳиртасин фаламасууху би'айдиихим лаḳалал лазиина кафаруу ин хаза илла сихрум мубиин","Если бы даже Мы ниспослали тебе Писание на бумаге, и они прикоснулись бы к ней своими руками, неверующие все равно бы сказали: «Это - очевидное колдовство».",["и если бы","Мы ниспослали","тебе","Писание","на","бумаге","и потрогали они его","руками своими","непременно сказали бы","те, которые","не уверовали","не","это","лишь","колдовство","явное"]],[6,8,["وَقَالُواْ","لَوۡلَآ","أُنزِلَ","عَلَيۡهِ","مَلَكٞۖ","وَلَوۡ","أَنزَلۡنَا","مَلَكٗا","لَّقُضِيَ","ٱلۡأَمۡرُ","ثُمَّ","لَا","يُنظَرُونَ"],"ваḳалуу лаула унзила `алайхи малакун валау анзална малакал лаḳудийал амру сумма ла йунзаруун","Они сказали: «Почему к нему не спускается ангел?». Если бы Мы ниспослали ангела, то решение уже было бы вынесено, после чего они не получили бы отсрочки.",["и сказали они","почему не","ниспослан","ему","ангел","и если бы","Мы ниспослали","ангела","непременно решено было бы","дело","затем","не","была бы им отсрочка"]]],"m":[["h",6],["b"],[["ٱلۡحَمۡدُ","хвала",6,1],["لِلَّهِ","Аллаху",6,1],["ٱلَّذِي","Который",6,1],["خَلَقَ","сотворил",6,1],["ٱلسَّمَٰوَٰتِ","небеса",6,1],["وَٱلۡأَرۡضَ","и землю",6,1],["وَجَعَلَ","и установил",6,1],["ٱلظُّلُمَٰتِ","мраки",6,1]],[["وَٱلنُّورَۖ","и свет",6,1],["ثُمَّ","затем",6,1],["ٱلَّذِينَ","те, которые",6,1],["كَفَرُواْ","не уверовали",6,1],["بِرَبِّهِمۡ","с Господом своим",6,1],["يَعۡدِلُونَ","приравнивают",6,1],[1],["هُوَ","Он",6,2],["ٱلَّذِي","Тот, Который",6,2]],[["خَلَقَكُم","сотворил вас",6,2],["مِّن","из",6,2],["طِينٖ","глины",6,2],["ثُمَّ","затем",6,2],["قَضَىٰٓ","определил Он",6,2],["أَجَلٗاۖ","срок",6,2],["وَأَجَلٞ","и срок",6,2],["مُّسَمًّى","назначенный",6,2],["عِندَهُۥۖ","у Него",6,2],["ثُمَّ","затем",6,2],["أَنتُمۡ","вы",6,2]],[["تَمۡتَرُونَ","сомневаетесь",6,2],[2],["وَهُوَ","и Он",6,3],["ٱللَّهُ","Аллах",6,3],["فِي","на",6,3],["ٱلسَّمَٰوَٰتِ","небесах",6,3],["وَفِي","и на",6,3],["ٱلۡأَرۡضِ","земле",6,3],["يَعۡلَمُ","Он знает",6,3],["سِرَّكُمۡ","тайное ваше",6,3]],[["وَجَهۡرَكُمۡ","и явное ваше",6,3],["وَيَعۡلَمُ","и Он знает",6,3],["مَا","что",6,3],["تَكۡسِبُونَ","вы приобретаете",6,3],[3],["وَمَا","и не",6,4],["تَأۡتِيهِم","приходит к ним",6,4],["مِّنۡ","никакое",6,4],["ءَايَةٖ","знамение",6,4],["مِّنۡ","из",6,4]],[["ءَايَٰتِ","знамений",6,4],["رَبِّهِمۡ","Господа их",6,4],["إِلَّا","кроме как",6,4],["كَانُواْ","были они",6,4],["عَنۡهَا","от него",6,4],["مُعۡرِضِينَ","отворачивающимися",6,4],[4],["فَقَدۡ","и уже",6,5],["كَذَّبُواْ","они сочли ложью",6,5],["بِٱلۡحَقِّ","истину",6,5]],[["لَمَّا","когда",6,5],["جَآءَهُمۡ","она пришла к ним",6,5],["فَسَوۡفَ","но вскоре",6,5],["يَأۡتِيهِمۡ","придут к ним",6,5],["أَنۢبَٰٓؤُاْ","вести",6,5],["مَا","о том, что",6,5],["كَانُواْ","были они",6,5],["بِهِۦ","над этим",6,5],["يَسۡتَهۡزِءُونَ","насмехаются",6,5],[5],["أَلَمۡ","разве не",6,6]],[["يَرَوۡاْ","видели они",6,6],["كَمۡ","сколько",6,6],["أَهۡلَكۡنَا","Мы погубили",6,6],["مِن","из",6,6],["قَبۡلِهِم","прежде них",6,6],["مِّن","из",6,6],["قَرۡنٖ","поколений",6,6],["مَّكَّنَّٰهُمۡ","Мы утвердили их",6,6],["فِي","на",6,6],["ٱلۡأَرۡضِ","земле",6,6],["مَا","как",6,6],["لَمۡ","не",6,6]],[["نُمَكِّن","утвердили Мы",6,6],["لَّكُمۡ","вас",6,6],["وَأَرۡسَلۡنَا","и Мы послали",6,6],["ٱلسَّمَآءَ","небо",6,6],["عَلَيۡهِم","на них",6,6],["مِّدۡرَارٗا","обильно льющимся",6,6],["وَجَعَلۡنَا","и Мы сделали",6,6],["ٱلۡأَنۡهَٰرَ","реки",6,6]],[["تَجۡرِي","текут",6,6],["مِن","из",6,6],["تَحۡتِهِمۡ","под ними",6,6],["فَأَهۡلَكۡنَٰهُم","и Мы погубили их",6,6],["بِذُنُوبِهِمۡ","за грехи их",6,6],["وَأَنشَأۡنَا","и Мы создали",6,6],["مِنۢ","из",6,6],["بَعۡدِهِمۡ","после них",6,6],["قَرۡنًا","поколение",6,6]],[["ءَاخَرِينَ","другое",6,6],[6],["وَلَوۡ","и если бы",6,7],["نَزَّلۡنَا","Мы ниспослали",6,7],["عَلَيۡكَ","тебе",6,7],["كِتَٰبٗا","Писание",6,7],["فِي","на",6,7],["قِرۡطَاسٖ","бумаге",6,7],["فَلَمَسُوهُ","и потрогали они его",6,7],["بِأَيۡدِيهِمۡ","руками своими",6,7]],[["لَقَالَ","непременно сказали бы",6,7],["ٱلَّذِينَ","те, которые",6,7],["كَفَرُوٓاْ","не уверова