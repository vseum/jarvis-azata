{"p":129,"j":7,"a":[[6,9,["وَلَوۡ","جَعَلۡنَٰهُ","مَلَكٗا","لَّجَعَلۡنَٰهُ","رَجُلٗا","وَلَلَبَسۡنَا","عَلَيۡهِم","مَّا","يَلۡبِسُونَ"],"валау жа`алнаху малакал лажа`алнаху ражулан валалабасна `алайхим ма йалбисуун","Если бы даже Мы ниспослали ангела, Мы все равно сделали бы его мужчиной и привели бы их в замешательство относительно того, в чем они сомневаются.",["и если бы","Мы сделали его","ангелом","непременно Мы сделали бы его","мужчиной","и непременно Мы запутали бы","им","то, что","они запутывают"]],[6,10,["وَلَقَدِ","ٱسۡتُهۡزِئَ","بِرُسُلٖ","مِّن","قَبۡلِكَ","فَحَاقَ","بِٱلَّذِينَ","سَخِرُواْ","مِنۡهُم","مَّا","كَانُواْ","بِهِۦ","يَسۡتَهۡزِءُونَ"],"валаḳадистухзиа бирусулим мин ḳаблика фахаḳа биллазиина сахируу минхум ма кануу бихии йастахзиуун","До тебя посланников также подвергали осмеянию, но тех, кто насмехался над ними, окружало (или постигало) то, над чем они издевались.",["и уже","осмеяны были","посланники","из","прежде тебя","и окружило","тех, которые","насмехались","над ними","то, что","были они","над этим","насмехаются"]],[6,11,["قُلۡ","سِيرُواْ","فِي","ٱلۡأَرۡضِ","ثُمَّ","ٱنظُرُواْ","كَيۡفَ","كَانَ","عَٰقِبَةُ","ٱلۡمُكَذِّبِينَ"],"ḳул сиируу фил арди сумманзуруу кайфа кана `аḳибатул муказзибиин","Скажи: «Постранствуйте по земле и посмотрите, каким был конец тех, которые сочли ложью истину».",["скажи","странствуйте","по","земле","затем","посмотрите","как","был","конец","считавших ложью"]],[6,12,["قُل","لِّمَن","مَّا","فِي","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِۖ","قُل","لِّلَّهِۚ","كَتَبَ","عَلَىٰ","نَفۡسِهِ","ٱلرَّحۡمَةَۚ","لَيَجۡمَعَنَّكُمۡ","إِلَىٰ","يَوۡمِ","ٱلۡقِيَٰمَةِ","لَا","رَيۡبَ","فِيهِۚ","ٱلَّذِينَ","خَسِرُوٓاْ","أَنفُسَهُمۡ","فَهُمۡ","لَا","يُؤۡمِنُونَ"],"ḳул лимам ма фис самавати вал'арди ḳул лиллахи катаба `ала нафсихир рахмата лайажма`аннакум ила йаумил ḳийамати ла райба фиихил лазиина хасируу анфусахум фахум ла йу'минуун","Скажи: «Кому принадлежит то, что на небесах и на земле?». Скажи: «Аллаху! Он предписал Себе милосердие. Он непременно соберет вас вместе в День воскресения, в котором нет сомнения. Те, которые потеряли самих себя, никогда не уверуют».",["скажи","кому","то, что","на","небесах","и земле","скажи","Аллаху","Он предписал","на","Себя","милость","непременно соберёт Он вас","к","Дню","воскресения","нет","сомнения","в нём","те, которые","потеряли","самих себя","то они","не","уверуют"]],[6,13,["وَلَهُۥ","مَا","سَكَنَ","فِي","ٱلَّيۡلِ","وَٱلنَّهَارِۚ","وَهُوَ","ٱلسَّمِيعُ","ٱلۡعَلِيمُ"],"валахуу ма сакана фил лайли ваннахари вахуас самии`ул `алиим","Ему принадлежит все, что покоится днем и ночью, и Он - Слышащий, Знающий.",["и Ему","то, что","покоится","в","ночи","и дне","и Он","Слышащий","Знающий"]],[6,14,["قُلۡ","أَغَيۡرَ","ٱللَّهِ","أَتَّخِذُ","وَلِيّٗا","فَاطِرِ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِ","وَهُوَ","يُطۡعِمُ","وَلَا","يُطۡعَمُۗ","قُلۡ","إِنِّيٓ","أُمِرۡتُ","أَنۡ","أَكُونَ","أَوَّلَ","مَنۡ","أَسۡلَمَۖ","وَلَا","تَكُونَنَّ","مِنَ","ٱلۡمُشۡرِكِينَ"],"ḳул агайраллахи аттахизу валиййан фатирис самавати вал'арди вахуа йут`иму вала йут`аму ḳул иннии умирту ан акууна аввала ман аслама вала такуунанна минал мушрикиин","Скажи: «Неужели я возьму своим покровителем кого-либо, кроме Аллаха, Творца небес и земли? Он кормит, а Его не кормят». Скажи: «Мне велено быть первым из тех, кто покорился». Не будь же в числе многобожников.",["скажи","разве иного, кроме","Аллаха","я возьму","покровителем","Творца","небес","и земли","и Он","кормит","и не","кормят Его","скажи","поистине, я","мне велено","чтобы","я был","первым","кто","покорился","и не","будь же","из","многобожников"]],[6,15,["قُلۡ","إِنِّيٓ","أَخَافُ","إِنۡ","عَصَيۡتُ","رَبِّي","عَذَابَ","يَوۡمٍ","عَظِيمٖ"],"ḳул иннии ахафу ин `асайту раббии `азаба йаумин `азиим","Скажи: «Я боюсь, что если я ослушаюсь моего Господа, то меня постигнут мучения в Великий день».",["скажи","поистине, я","боюсь","если","ослушался я","Господа моего","наказания","дня","великого"]],[6,16,["مَّن","يُصۡرَفۡ","عَنۡهُ","يَوۡمَئِذٖ","فَقَدۡ","رَحِمَهُۥۚ","وَذَٰلِكَ","ٱلۡفَوۡزُ","ٱلۡمُبِينُ"],"мман йусраф `анху йаумаизин фаḳад рахимахуу вазаликал фаузул мубиин","Тот, кто будет отвращен от них (мучений) в тот день, того Он помиловал. Это будет очевидное преуспеяние.",["кто","будет отвращён","от него","в тот день","то уже","Он помиловал его","и это","преуспеяние","явное"]],[6,17,["وَإِن","يَمۡسَسۡكَ","ٱللَّهُ","بِضُرّٖ","فَلَا","كَاشِفَ","لَهُۥٓ","إِلَّا","هُوَۖ","وَإِن","يَمۡسَسۡكَ","بِخَيۡرٖ","فَهُوَ","عَلَىٰ","كُلِّ","شَيۡءٖ","قَدِيرٞ"],"ва'ин йамсаскаллаху бидуррин фала кашифа лахуу илла хуа ва'ин йамсаска бихайрин фахуа `ала кулли шай'ин ḳадиир","Если Аллах коснется тебя бедой, то никто не сможет избавить от нее, кроме Него. Если же Он коснется тебя благом, то ведь Он способен на всякую вещь.",["и если","коснётся тебя","Аллах","бедой","то нет","избавителя","от неё","кроме","Него","и если","Он коснётся тебя","благом","то Он","над","всякой","вещью","Всемогущ"]],[6,18,["وَهُوَ","ٱلۡقَاهِرُ","فَوۡقَ","عِبَادِهِۦۚ","وَهُوَ","ٱلۡحَكِيمُ","ٱلۡخَبِيرُ"],"вахуал ḳахиру фауḳа `ибадихии вахуал хакиимул хабиир","Он - Одолевающий и находится над Своими рабами. Он - Мудрый, Ведающий.",["и Он","Одолевающий","над","Своими рабами","и Он","Мудрый","Ведающий"]]],"m":[[["وَلَوۡ","и если бы",6,9],["جَعَلۡنَٰهُ","Мы сделали его",6,9],["مَلَكٗا","ангелом",6,9],["لَّجَعَلۡنَٰهُ","непременно Мы сделали бы его",6,9],["رَجُلٗا","мужчиной",6,9],["وَلَلَبَسۡنَا","и непременно Мы запутали бы",6,9],["عَلَيۡهِم","им",6,9],["مَّا","то, что",6,9]],[["يَلۡبِسُونَ","они запутывают",6,9],[9],["وَلَقَدِ","и уже",6,10],["ٱسۡتُهۡزِئَ","осмеяны были",6,10],["بِرُسُلٖ","посланники",6,10],["مِّن","из",6,10],["قَبۡلِكَ","прежде тебя",6,10],["فَحَاقَ","и окружило",6,10]],[["بِٱلَّذِينَ","тех, которые",6,10],["سَخِرُواْ","насмехались",6,10],["مِنۡهُم","над ними",6,10],["مَّا","то, что",6,10],["كَانُواْ","были они",6,10],["بِهِۦ","над этим",6,10],["يَسۡتَهۡزِءُونَ","насмехаются",6,10],[10]],[["قُلۡ","скажи",6,11],["سِيرُواْ","странствуйте",6,11],["فِي","по",6,11],["ٱلۡأَرۡضِ","земле",6,11],["ثُمَّ","затем",6,11],["ٱنظُرُواْ","посмотрите",6,11],["كَيۡفَ","как",6,11],["كَانَ","был",6,11],["عَٰقِبَةُ","конец",6,11]],[["ٱلۡمُكَذِّبِينَ","считавших ложью",6,11],[11],["قُل","скажи",6,12],["لِّمَن","кому",6,12],["مَّا","то, что",6,12],["فِي","на",6,12],["ٱلسَّمَٰوَٰتِ","небесах",6,12],["وَٱلۡأَرۡضِۖ","и земле",6,12],["قُل","скажи",6,12],["لِّلَّهِۚ","Аллаху",6,12]],[["كَتَبَ","Он предписал",6,12],["عَلَىٰ","на",6,12],["نَفۡسِهِ","Себя",6,12],["ٱلرَّحۡمَةَۚ","милость",6,12],["لَيَجۡمَعَنَّكُمۡ","непременно соберёт Он вас",6,12],["إِلَىٰ","к",6,12],["يَوۡمِ","Дню",6,12],["ٱلۡقِيَٰمَةِ","воскресения",6,12]],[["لَا","нет",6,12],["رَيۡبَ","сомнения",6,12],["فِيهِۚ","в нём",6,12],["ٱلَّذِينَ","те, которые",6,12],["خَسِرُوٓاْ","потеряли",6,12],["أَنفُسَهُمۡ","самих себя",6,12],["فَهُمۡ","то они",6,12],["لَا","не",6,12],["يُؤۡمِنُونَ","уверуют",6,12]],[[12],["۞ وَلَهُۥ","и Ему",6,13],["مَا","то, что",6,13],["سَكَنَ","покоится",6,13],["فِي","в",6,13],["ٱلَّيۡلِ","ночи",6,13],["وَٱلنَّهَارِۚ","и дне",6,13],["وَهُوَ","и Он",6,13],["ٱلسَّمِيعُ","Слышащий",6,13],["ٱلۡعَلِيمُ","Знающий",6,13]],[[13],["قُلۡ","скажи",6,14],["أَغَيۡرَ","разве иного, кроме",6,14],["ٱللَّهِ","Аллаха",6,14],["أَتَّخِذُ","я возьму",6,14],["وَلِيّٗا","покровителем",6,14],["فَاطِرِ","Творца",6,14],["ٱلسَّمَٰوَٰتِ","небес",6,14],["وَٱلۡأَرۡضِ","и земли",6,14],["وَهُوَ","и Он",6,14],["يُطۡعِمُ","кормит",6,14]],[["وَلَا","и не",6,14],["يُطۡعَمُۗ","кормят Его",6,14],["قُلۡ","скажи",6,14],["إِنِّيٓ","поистине, я",6,14],["أُمِرۡتُ","мне велено",6,14],["أَنۡ","чтобы",6,14],["أَكُونَ","я был",6,14],["أَوَّلَ","первым",6,14],["مَنۡ","кто",6,14],["أَسۡلَمَۖ","покорился",6,14],["وَلَا","и не",6,14]],[["تَكُونَنَّ","будь же",6,14],["مِنَ","из",6,14],["ٱلۡمُشۡرِكِينَ","многобожников",6,14],[14],["قُلۡ","скажи",6,15],["إِنِّيٓ","поистине, я",6,15],["أَخَافُ","боюсь",6,15],["إِنۡ","если",6,15],["عَصَيۡتُ","ослушался я",6,15]],[["رَبِّي","Господа моего",6,15],["عَذَابَ","наказания",6,15],["يَوۡمٍ","дня",6,15],["عَظِيمٖ","великого",6,15],[15],["مَّن","кто",6,16],["يُصۡرَفۡ","будет отвращён",6,16],["عَنۡهُ","от него",6,16],["يَوۡمَئِذٖ","в тот день",6,16],["فَقَدۡ","то уже",6,16]],[["رَحِمَهُۥۚ","Он помиловал его",6,16],["وَذَٰلِكَ","и это",6,16],["ٱلۡفَوۡزُ","преуспеяние",6,16],["ٱلۡمُبِينُ","явное",6,16],[16],["وَإِن","и если",6,17],["يَمۡسَسۡكَ","коснётся тебя",6,17],["ٱللَّهُ","Аллах",6,17],["بِضُرّٖ","бедой",6,17]],[["فَلَا","то нет",6,17],["كَاشِفَ","избавителя",6,17],["لَهُۥٓ","от неё",6,17],["إِلَّا","кроме",6,17],["هُوَۖ","Него",6,17],["وَإِن","и если",6,17],["يَمۡسَسۡكَ","Он коснётся тебя",6,17],["بِخَيۡرٖ","благом",6,17],["فَهُوَ","то Он",6,17],["عَلَىٰ","над",6,17],["كُلِّ","всякой",6,17],["شَيۡءٖ","вещью",6,17]],[["قَدِيرٞ","Всемогущ",6,17],[17],["وَهُوَ","и Он",6,18],["ٱلۡقَاهِرُ","Одолевающий",6,18],["فَوۡقَ","над",6,18],["عِبَادِهِۦۚ","Своими рабами",6,18],["وَهُوَ","и Он",6,18],["ٱلۡحَكِيمُ","Мудрый",6,18],["ٱلۡخَبِيرُ","Ведающий",6,18],[18]]]}