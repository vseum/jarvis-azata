{"p":130,"j":7,"a":[[6,19,["قُلۡ","أَيُّ","شَيۡءٍ","أَكۡبَرُ","شَهَٰدَةٗۖ","قُلِ","ٱللَّهُۖ","شَهِيدُۢ","بَيۡنِي","وَبَيۡنَكُمۡۚ","وَأُوحِيَ","إِلَيَّ","هَٰذَا","ٱلۡقُرۡءَانُ","لِأُنذِرَكُم","بِهِۦ","وَمَنۢ","بَلَغَۚ","أَئِنَّكُمۡ","لَتَشۡهَدُونَ","أَنَّ","مَعَ","ٱللَّهِ","ءَالِهَةً","أُخۡرَىٰۚ","قُل","لَّآ","أَشۡهَدُۚ","قُلۡ","إِنَّمَا","هُوَ","إِلَٰهٞ","وَٰحِدٞ","وَإِنَّنِي","بَرِيٓءٞ","مِّمَّا","تُشۡرِكُونَ"],"ḳул аййу шай'ин акбару шахадатан ḳулиллаху шахииду байнии вабайнакум ва'уухийа илаййа хазал ḳур'ану ли'унзиракум бихии вамам балага а'иннакум латашхадууна анна ма`аллахи алихатан ухра ḳул ла ашхаду ḳул иннама хуа илахун вахидун ва'иннании барииум мимма тушрикуун","Скажи: «Чье свидетельство является самым важным?». Скажи: «Аллах - Свидетель между мною и вами. Этот Коран дан мне в откровение, чтобы я предостерег посредством него вас и тех, до кого он дойдет. Неужели вы действительно свидетельствуете, что наряду с Аллахом существуют другие боги?». Скажи: «Я не свидетельствую об этом». Скажи: «Он является Единственным Богом, и я не причастен к тому, что вы приобщаете в сотоварищи».",["скажи","какая","вещь","величайшая","свидетельством","скажи","Аллах","Свидетель","между мной","и между вами","и внушён был","мне","этот","Коран","чтобы я предостерёг вас","им","и тех, кого","он достиг","разве вы","непременно свидетельствуете","что","с","Аллахом","боги","другие","скажи","не","свидетельствую я","скажи","лишь","Он","Бог","Единый","и поистине, я","непричастен","к тому, что","вы приобщаете"]],[6,20,["ٱلَّذِينَ","ءَاتَيۡنَٰهُمُ","ٱلۡكِتَٰبَ","يَعۡرِفُونَهُۥ","كَمَا","يَعۡرِفُونَ","أَبۡنَآءَهُمُۘ","ٱلَّذِينَ","خَسِرُوٓاْ","أَنفُسَهُمۡ","فَهُمۡ","لَا","يُؤۡمِنُونَ"],"аллазиина атайнахумул китаба йа`рифуунахуу кама йа`рифууна абнаахумул лазиина хасируу анфусахум фахум ла йу'минуун","Те, кому Мы даровали Писание, знают его, как знают своих сыновей. Те, которые потеряли самих себя, никогда не уверуют.",["те, которым","Мы даровали им","Писание","они знают его","как","знают они","сыновей своих","те, которые","потеряли","самих себя","то они","не","уверуют"]],[6,21,["وَمَنۡ","أَظۡلَمُ","مِمَّنِ","ٱفۡتَرَىٰ","عَلَى","ٱللَّهِ","كَذِبًا","أَوۡ","كَذَّبَ","بِـَٔايَٰتِهِۦٓۚ","إِنَّهُۥ","لَا","يُفۡلِحُ","ٱلظَّٰلِمُونَ"],"ваман азламу мимманифтара `алаллахи казибан ау каззаба би'айатихии иннахуу ла йуфлихуз залимуун","Кто может быть несправедливее того, кто возвел на Аллаха навет или счел ложью Его знамения? Воистину, не преуспеют беззаконники.",["и кто","несправедливее","того, кто","измыслил","на","Аллаха","ложь","или","счёл ложью","знамения Его","поистине","не","преуспеют","беззаконники"]],[6,22,["وَيَوۡمَ","نَحۡشُرُهُمۡ","جَمِيعٗا","ثُمَّ","نَقُولُ","لِلَّذِينَ","أَشۡرَكُوٓاْ","أَيۡنَ","شُرَكَآؤُكُمُ","ٱلَّذِينَ","كُنتُمۡ","تَزۡعُمُونَ"],"вайаума нахшурухум жамии`ан сумма наḳуулу лиллазиина ашракуу айна шуракаукумул лазиина кунтум таз`умуун","В тот день Мы соберем их вместе, а затем скажем тем, кто приобщал сотоварищей: «Где сотоварищи, о существовании которых вы предполагали?».",["и в день","Мы соберём их","всех","затем","Мы скажем","тем, которые","приобщали сотоварищей","где","сотоварищи ваши","которых","вы были","утверждаете"]],[6,23,["ثُمَّ","لَمۡ","تَكُن","فِتۡنَتُهُمۡ","إِلَّآ","أَن","قَالُواْ","وَٱللَّهِ","رَبِّنَا","مَا","كُنَّا","مُشۡرِكِينَ"],"сумма лам такун фитнатухум илла ан ḳалуу валлахи раббина ма кунна мушрикиин","Тогда у них не будет никакого оправдания, кроме слов: «Клянемся Аллахом, нашим Господом, мы не были многобожниками!».",["затем","не","будет","оправданием их","кроме","того, что","сказали они","клянёмся Аллахом","Господом нашим","не","были мы","многобожниками"]],[6,24,["ٱنظُرۡ","كَيۡفَ","كَذَبُواْ","عَلَىٰٓ","أَنفُسِهِمۡۚ","وَضَلَّ","عَنۡهُم","مَّا","كَانُواْ","يَفۡتَرُونَ"],"инзур кайфа казабуу `ала анфусихим вадалла `анхум ма кануу йафтаруун","Посмотри, как они лгут о самих себе! Но покинет их (или исчезнет) то, что они измышляли.",["посмотри","как","солгали они","на","самих себя","и исчезло","от них","то, что","были они","измышляют"]],[6,25,["وَمِنۡهُم","مَّن","يَسۡتَمِعُ","إِلَيۡكَۖ","وَجَعَلۡنَا","عَلَىٰ","قُلُوبِهِمۡ","أَكِنَّةً","أَن","يَفۡقَهُوهُ","وَفِيٓ","ءَاذَانِهِمۡ","وَقۡرٗاۚ","وَإِن","يَرَوۡاْ","كُلَّ","ءَايَةٖ","لَّا","يُؤۡمِنُواْ","بِهَاۖ","حَتَّىٰٓ","إِذَا","جَآءُوكَ","يُجَٰدِلُونَكَ","يَقُولُ","ٱلَّذِينَ","كَفَرُوٓاْ","إِنۡ","هَٰذَآ","إِلَّآ","أَسَٰطِيرُ","ٱلۡأَوَّلِينَ"],"ваминхум ман йастами`у илайка важа`ална `ала ḳулуубихим акиннатан ан йафḳахууху вафии азанихим ваḳран ва'ин йарау кулла айатил ла йу'минуу биха хатта иза жауука йужадилуунака йаḳуулул лазиина кафаруу ин хаза илла асатиирул аввалиин","Среди них есть такие, которые слушают тебя, но Мы накинули на их сердца покрывала, чтобы они не могли понять его (Коран), и поразили их уши глухотой. Какое бы знамение они ни увидели, они все равно не уверуют в него, и поэтому, когда они приходят к тебе, чтобы препираться с тобой, неверующие говорят: «Это - всего лишь легенды древних народов».",["и из них","тот, кто","слушает","тебя","и Мы положили","на","сердца их","покровы","чтобы (не)","они поняли его","и в","ушах их","глухоту","и если","увидят они","всякое","знамение","не","уверуют они","в него","пока","когда","придут они к тебе","препираются с тобой","говорят","те, которые","не уверовали","не","это","лишь","легенды","древних"]],[6,26,["وَهُمۡ","يَنۡهَوۡنَ","عَنۡهُ","وَيَنۡـَٔوۡنَ","عَنۡهُۖ","وَإِن","يُهۡلِكُونَ","إِلَّآ","أَنفُسَهُمۡ","وَمَا","يَشۡعُرُونَ"],"вахум йанхауна `анху вайан'ауна `анху ва'ин йухликууна илла анфусахум вама йаш`уруун","Они удерживают других от него (прямого пути), и сами сторонятся его, однако они губят только самих себя, не ощущая этого.",["и они","удерживают","от него","и удаляются","от него","и не","губят они","кроме","самих себя","и не","ощущают они"]],[6,27,["وَلَوۡ","تَرَىٰٓ","إِذۡ","وُقِفُواْ","عَلَى","ٱلنَّارِ","فَقَالُواْ","يَٰلَيۡتَنَا","نُرَدُّ","وَلَا","نُكَذِّبَ","بِـَٔايَٰتِ","رَبِّنَا","وَنَكُونَ","مِنَ","ٱلۡمُؤۡمِنِينَ"],"валау тара из вуḳифуу `алан нари фаḳалуу йалайтана нурадду вала нуказзиба би'айати раббина ванакууна минал му'миниин","Если бы ты только увидел их, когда их остановят перед Огнем. Они скажут: «О, если бы нас вернули обратно! Мы не считали бы ложью знамения нашего Господа и стали бы верующими!».",["и если бы","ты увидел","когда","поставлены были они","перед","Огнём","и сказали они","о, если бы нас","вернули","и не","сочли бы мы ложью","знамения","Господа нашего","и были бы мы","из","верующих"]]],"m":[[["قُلۡ","скажи",6,19],["أَيُّ","какая",6,19],["شَيۡءٍ","вещь",6,19],["أَكۡبَرُ","величайшая",6,19],["شَهَٰدَةٗۖ","свидетельством",6,19],["قُلِ","скажи",6,19],["ٱللَّهُۖ","Аллах",6,19],["شَهِيدُۢ","Свидетель",6,19],["بَيۡنِي","между мной",6,19],["وَبَيۡنَكُمۡۚ","и между вами",6,19],["وَأُوحِيَ","и внушён был",6,19],["إِلَيَّ","мне",6,19],["هَٰذَا","этот",6,19]],[["ٱلۡقُرۡءَانُ","Коран",6,19],["لِأُنذِرَكُم","чтобы я предостерёг вас",6,19],["بِهِۦ","им",6,19],["وَمَنۢ","и тех, кого",6,19],["بَلَغَۚ","он достиг",6,19],["أَئِنَّكُمۡ","разве вы",6,19],["لَتَشۡهَدُونَ","непременно свидетельствуете",6,19],["أَنَّ","что",6,19],["مَعَ","с",6,19],["ٱللَّهِ","Аллахом",6,19]],[["ءَالِهَةً","боги",6,19],["أُخۡرَىٰۚ","другие",6,19],["قُل","скажи",6,19],["لَّآ","не",6,19],["أَشۡهَدُۚ","свидетельствую я",6,19],["قُلۡ","скажи",6,19],["إِنَّمَا","лишь",6,19],["هُوَ","Он",6,19],["إِلَٰهٞ","Бог",6,19],["وَٰحِدٞ","Единый",6,19],["وَإِنَّنِي","и поистине, я",6,19],["بَرِيٓءٞ","непричастен",6,19],["مِّمَّا","к тому, что",6,19]],[["تُشۡرِكُونَ","вы приобщаете",6,19],[19],["ٱلَّذِينَ","те, которым",6,20],["ءَاتَيۡنَٰهُمُ","Мы даровали им",6,20],["ٱلۡكِتَٰبَ","Писание",6,20],["يَعۡرِفُونَهُۥ","они знают его",6,20],["كَمَا","как",6,20],["يَعۡرِفُونَ","знают они",6,20]],[["أَبۡنَآءَهُمُۘ","сыновей своих",6,20],["ٱلَّذِينَ","те, которые",6,20],["خَسِرُوٓاْ","потеряли",6,20],["أَنفُسَهُمۡ","самих себя",6,20],["فَهُمۡ","то они",6,20],["لَا","не",6,20],["يُؤۡمِنُونَ","уверуют",6,20],[20],["وَمَنۡ","и кто",6,21],["أَظۡلَمُ","несправедливее