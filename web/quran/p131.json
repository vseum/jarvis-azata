{"p":131,"j":7,"a":[[6,28,["بَلۡ","بَدَا","لَهُم","مَّا","كَانُواْ","يُخۡفُونَ","مِن","قَبۡلُۖ","وَلَوۡ","رُدُّواْ","لَعَادُواْ","لِمَا","نُهُواْ","عَنۡهُ","وَإِنَّهُمۡ","لَكَٰذِبُونَ"],"бал бада лахум ма кануу йухфууна мин ḳаблу валау руддуу ла`адуу лима нухуу `анху ва'иннахум лаказибуун","О нет! Им открылось то, что они скрывали прежде. Если бы их вернули обратно, то они непременно вернулись бы к тому, что им было запрещено. Воистину, они - лжецы.",["нет же","открылось","им","то, что","были они","скрывают","из","прежде","и если бы","их вернули","непременно вернулись бы они","к тому, что","запрещено было им","от него","и поистине, они","непременно лжецы"]],[6,29,["وَقَالُوٓاْ","إِنۡ","هِيَ","إِلَّا","حَيَاتُنَا","ٱلدُّنۡيَا","وَمَا","نَحۡنُ","بِمَبۡعُوثِينَ"],"ваḳалуу ин хийа илла хайатунад дунйа вама нахну бимаб`уусиин","Они говорят: «Есть только наша мирская жизнь, и мы не будем воскрешены».",["и они сказали","не","она","кроме","наша жизнь","ближняя","и не","мы","воскрешенные"]],[6,30,["وَلَوۡ","تَرَىٰٓ","إِذۡ","وُقِفُواْ","عَلَىٰ","رَبِّهِمۡۚ","قَالَ","أَلَيۡسَ","هَٰذَا","بِٱلۡحَقِّۚ","قَالُواْ","بَلَىٰ","وَرَبِّنَاۚ","قَالَ","فَذُوقُواْ","ٱلۡعَذَابَ","بِمَا","كُنتُمۡ","تَكۡفُرُونَ"],"валау тара из вуḳифуу `ала раббихим ḳала алайса хаза билхаḳḳи ḳалуу бала вараббина ḳала фазууḳул `азаба бима кунтум такфуруун","Если бы ты только увидел их, когда их остановят перед их Господом. Он скажет: «Разве это не истина?». Они скажут: «Конечно, клянемся нашим Господом!». Он скажет: «Вкусите же мучения за то, что вы не верили!».",["если бы","ты увидел","когда","они будут поставлены","перед","их Господом","Он скажет","разве не","это","истина","они скажут","да","клянёмся нашим Господом","Он скажет","вкусите же","наказание","за то, что","вы","не веровали"]],[6,31,["قَدۡ","خَسِرَ","ٱلَّذِينَ","كَذَّبُواْ","بِلِقَآءِ","ٱللَّهِۖ","حَتَّىٰٓ","إِذَا","جَآءَتۡهُمُ","ٱلسَّاعَةُ","بَغۡتَةٗ","قَالُواْ","يَٰحَسۡرَتَنَا","عَلَىٰ","مَا","فَرَّطۡنَا","فِيهَا","وَهُمۡ","يَحۡمِلُونَ","أَوۡزَارَهُمۡ","عَلَىٰ","ظُهُورِهِمۡۚ","أَلَا","سَآءَ","مَا","يَزِرُونَ"],"ḳад хасирал лазиина каззабуу билиḳаиллахи хатта иза жаатхумус са`ату багтатан ḳалуу йахасратана `ала ма фарратна фииха вахум йахмилууна аузарахум `ала зухуурихим ала саа ма йазируун","Те, которые отрицали встречу с Аллахом, уже оказались в убытке. Когда же внезапно для них настанет Час, они, неся свои ноши на спинах, скажут: «Горе нам за то, что мы упустили там!». Как же скверно то, что они понесут!",["уже","потерпели убыток","те, которые","отрицали","встречу","с Аллахом","пока","когда","пришёл к ним","Час","внезапно","они сказали","о горе нам","за","то, что","мы упустили","в ней","и они","несут","свои ноши","на","своих спинах","о да","скверно","то, что","они несут"]],[6,32,["وَمَا","ٱلۡحَيَوٰةُ","ٱلدُّنۡيَآ","إِلَّا","لَعِبٞ","وَلَهۡوٞۖ","وَلَلدَّارُ","ٱلۡأٓخِرَةُ","خَيۡرٞ","لِّلَّذِينَ","يَتَّقُونَۚ","أَفَلَا","تَعۡقِلُونَ"],"вамал хайаватуд дунйа илла ла`ибун валахвун валаддарул ахирату хайрул лиллазиина йаттаḳууна афала та`ḳилуун","Мирская жизнь - всего лишь игра и потеха, а последняя обитель лучше для тех, кто богобоязнен. Неужели вы не разумеете?",["и не","жизнь","мирская","кроме","игра","и потеха","а обитель непременно","последняя","лучше","для тех, которые","богобоязненны","разве не","вы разумеете"]],[6,33,["قَدۡ","نَعۡلَمُ","إِنَّهُۥ","لَيَحۡزُنُكَ","ٱلَّذِي","يَقُولُونَۖ","فَإِنَّهُمۡ","لَا","يُكَذِّبُونَكَ","وَلَٰكِنَّ","ٱلظَّٰلِمِينَ","بِـَٔايَٰتِ","ٱللَّهِ","يَجۡحَدُونَ"],"ḳад на`ламу иннахуу лайахзунукал лазии йаḳуулууна фа'иннахум ла йуказзибуунака валакинназ залимиина би'айатиллахи йажхадуун","Мы знаем, что тебя печалит то, что они говорят. Они не считают лжецом тебя - беззаконники отвергают знамения Аллаха!",["уже","Мы знаем","что это","непременно печалит тебя","то, что","они говорят","и, поистине, они","не","считают лжецом тебя","но","беззаконники","знамения","Аллаха","они отвергают"]],[6,34,["وَلَقَدۡ","كُذِّبَتۡ","رُسُلٞ","مِّن","قَبۡلِكَ","فَصَبَرُواْ","عَلَىٰ","مَا","كُذِّبُواْ","وَأُوذُواْ","حَتَّىٰٓ","أَتَىٰهُمۡ","نَصۡرُنَاۚ","وَلَا","مُبَدِّلَ","لِكَلِمَٰتِ","ٱللَّهِۚ","وَلَقَدۡ","جَآءَكَ","مِن","نَّبَإِيْ","ٱلۡمُرۡسَلِينَ"],"валаḳад куззибат русулум мин ḳаблика фасабаруу `ала ма куззибуу ва'уузуу хатта атахум насруна вала мубаддила ликалиматиллахи валаḳад жаака мин набаил мурсалиин","До тебя посланников также считали лжецами, но они терпели то, что их так называли и обижали, пока не являлась к ним Наша помощь. Никто не исказит слов Аллаха, и до тебя уже дошли некоторые вести о посланниках.",["и уже","были сочтены лжецами","посланники","из","прежде тебя","и они терпели","над","тем, что","их сочли лжецами","и их обижали","пока","пришла к ним","Наша помощь","и нет","изменяющего","слова","Аллаха","и уже","пришли к тебе","из","вестей","посланников"]],[6,35,["وَإِن","كَانَ","كَبُرَ","عَلَيۡكَ","إِعۡرَاضُهُمۡ","فَإِنِ","ٱسۡتَطَعۡتَ","أَن","تَبۡتَغِيَ","نَفَقٗا","فِي","ٱلۡأَرۡضِ","أَوۡ","سُلَّمٗا","فِي","ٱلسَّمَآءِ","فَتَأۡتِيَهُم","بِـَٔايَةٖۚ","وَلَوۡ","شَآءَ","ٱللَّهُ","لَجَمَعَهُمۡ","عَلَى","ٱلۡهُدَىٰۚ","فَلَا","تَكُونَنَّ","مِنَ","ٱلۡجَٰهِلِينَ"],"ва'ин кана кабура `алайка и`радухум фа'инистата`та ан табтагийа нафаḳан фил арди ау сулламан фис самаи фата'тийахум би'айатин валау шааллаху лажама`ахум `алал худа фала такуунанна минал жахилиин","Если тебя тяготит их отвращение, то если ты сможешь отыскать проход в земле или лестницу на небо, то принеси им знамение. Если бы Аллах пожелал, то собрал бы их всех на прямом пути. Посему не будь одним из невежд.",["и если","было","тяжко","для тебя","их отвращение","то если","ты сможешь","чтобы","отыскать","проход","в","земле","или","лестницу","в","небо","и принести им","знамение","а если бы","пожелал","Аллах","непременно собрал бы их","на","прямом пути","так не","будь же","из","невежд"]]],"m":[[["بَلۡ","нет же",6,28],["بَدَا","открылось",6,28],["لَهُم","им",6,28],["مَّا","то, что",6,28],["كَانُواْ","были они",6,28],["يُخۡفُونَ","скрывают",6,28],["مِن","из",6,28],["قَبۡلُۖ","прежде",6,28],["وَلَوۡ","и если бы",6,28],["رُدُّواْ","их вернули",6,28],["لَعَادُواْ","непременно вернулись бы они",6,28],["لِمَا","к тому, что",6,28],["نُهُواْ","запрещено было им",6,28],["عَنۡهُ","от него",6,28]],[["وَإِنَّهُمۡ","и поистине, они",6,28],["لَكَٰذِبُونَ","непременно лжецы",6,28],[28],["وَقَالُوٓاْ","и они сказали",6,29],["إِنۡ","не",6,29],["هِيَ","она",6,29],["إِلَّا","кроме",6,29],["حَيَاتُنَا","наша жизнь",6,29],["ٱلدُّنۡيَا","ближняя",6,29],["وَمَا","и не",6,29],["نَحۡنُ","мы",6,29]],[["بِمَبۡعُوثِينَ","воскрешенные",6,29],[29],["وَلَوۡ","если бы",6,30],["تَرَىٰٓ","ты увидел",6,30],["إِذۡ","когда",6,30],["وُقِفُواْ","они будут поставлены",6,30],["عَلَىٰ","перед",6,30],["رَبِّهِمۡۚ","их Господом",6,30],["قَالَ","Он скажет",6,30],["أَلَيۡسَ","разве не",6,30],["هَٰذَا","это",6,30]],[["بِٱلۡحَقِّۚ","истина",6,30],["قَالُواْ","они скажут",6,30],["بَلَىٰ","да",6,30],["وَرَبِّنَاۚ","клянёмся нашим Господом",6,30],["قَالَ","Он скажет",6,30],["فَذُوقُواْ","вкусите же",6,30],["ٱلۡعَذَابَ","наказание",6,30],["بِمَا","за то, что",6,30],["كُنتُمۡ","вы",6,30],["تَكۡفُرُونَ","не веровали",6,30]],[[30],["قَدۡ","уже",6,31],["خَسِرَ","потерпели убыток",6,31],["ٱلَّذِينَ","те, которые",6,31],["كَذَّبُواْ","отрицали",6,31],["بِلِقَآءِ","встречу",6,31],["ٱللَّهِۖ","с Аллахом",6,31],["حَتَّىٰٓ","пока",6,31],["إِذَا","когда",6,31],["جَآءَتۡهُمُ","пришёл к ним",6,31],["ٱلسَّاعَةُ","Час",6,31]],[["بَغۡتَةٗ","внезапно",6,31],["قَالُواْ","они сказали",6,31],["يَٰحَسۡرَتَنَا","о горе нам",6,31],["عَلَىٰ","за",6,31],["مَا","то, что",6,31],["فَرَّطۡنَا","мы упустили",6,31],["فِيهَا","в ней",6,31],["وَهُمۡ","и они",6,31],["يَحۡمِلُونَ","несут",6,31],["أَوۡزَارَهُمۡ","свои ноши",6,31]],[["عَلَىٰ","на",6,31],["ظُهُورِهِمۡۚ","своих спинах",6,31],["أَلَا","о да",6,31],["سَآءَ","скверно",6,31],["مَا","то, что",6,31],["يَزِرُونَ","они несут",6,31],[31],["وَمَا","и не",6,32],["ٱلۡحَيَوٰةُ","жизнь",6,32],["ٱلدُّنۡيَآ","мирская",6,32],["إِلَّا","кроме",6,32]],[["لَعِبٞ","игра",6,32],["وَلَهۡوٞۖ","и п