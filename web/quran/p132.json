{"p":132,"j":7,"a":[[6,36,["إِنَّمَا","يَسۡتَجِيبُ","ٱلَّذِينَ","يَسۡمَعُونَۘ","وَٱلۡمَوۡتَىٰ","يَبۡعَثُهُمُ","ٱللَّهُ","ثُمَّ","إِلَيۡهِ","يُرۡجَعُونَ"],"иннама йастажиибул лазиина йасма`ууна валмаута йаб`асухумуллаху сумма илайхи йуржа`уун","Отвечают только те, кто внимает. А мертвых Аллах воскресит, после чего они будут возвращены к Нему.",["лишь","откликаются","те, которые","слышат","а мёртвых","воскресит их","Аллах","затем","к Нему","они будут возвращены"]],[6,37,["وَقَالُواْ","لَوۡلَا","نُزِّلَ","عَلَيۡهِ","ءَايَةٞ","مِّن","رَّبِّهِۦۚ","قُلۡ","إِنَّ","ٱللَّهَ","قَادِرٌ","عَلَىٰٓ","أَن","يُنَزِّلَ","ءَايَةٗ","وَلَٰكِنَّ","أَكۡثَرَهُمۡ","لَا","يَعۡلَمُونَ"],"ваḳалуу лаула нуззила `алайхи айатум мир раббихии ḳул инналлаха ḳадирун `ала ан йуназзила айатан валакинна аксарахум ла йа`ламуун","Они говорят: «Почему ему не ниспослано знамение от его Господа?». Скажи: «Аллах способен ниспослать знамение». Но большинство их не обладает знанием.",["и сказали они","почему не","ниспослано","ему","знамение","от","его Господа","скажи","поистине","Аллах","способен","на то","чтобы","ниспослать","знамение","но","большинство их","не","знают"]],[6,38,["وَمَا","مِن","دَآبَّةٖ","فِي","ٱلۡأَرۡضِ","وَلَا","طَٰٓئِرٖ","يَطِيرُ","بِجَنَاحَيۡهِ","إِلَّآ","أُمَمٌ","أَمۡثَالُكُمۚ","مَّا","فَرَّطۡنَا","فِي","ٱلۡكِتَٰبِ","مِن","شَيۡءٖۚ","ثُمَّ","إِلَىٰ","رَبِّهِمۡ","يُحۡشَرُونَ"],"вама мин даббатин фил арди вала та'ирин йатииру бижанахайхи илла умамун амсалукум ма фарратна фил китаби мин шай'ин сумма ила раббихим йухшаруун","Все живые существа на земле и птицы, летающие на двух крыльях, являются подобными вам сообществами. Мы ничего не упустили в Писании. А затем они будут собраны к своему Господу.",["и нет","никакого","животного","на","земле","и ни","птицы","летающей","на двух своих крыльях","кроме","общины","подобные вам","не","Мы упустили","в","Писании","никакой","вещи","затем","к","их Господу","они будут собраны"]],[6,39,["وَٱلَّذِينَ","كَذَّبُواْ","بِـَٔايَٰتِنَا","صُمّٞ","وَبُكۡمٞ","فِي","ٱلظُّلُمَٰتِۗ","مَن","يَشَإِ","ٱللَّهُ","يُضۡلِلۡهُ","وَمَن","يَشَأۡ","يَجۡعَلۡهُ","عَلَىٰ","صِرَٰطٖ","مُّسۡتَقِيمٖ"],"валлазиина каззабуу би'айатина суммун вабукмун физ зулумати ман йашаиллаху йудлилху ваман йаша' йаж`алху `ала сиратим мустаḳиим","Те, которые считают ложью Наши знамения, глухи и немы во мраках. Аллах вводит в заблуждение, кого пожелает, и наставляет на прямой путь, кого пожелает.",["а те, которые","отвергли","Наши знамения","глухи","и немы","во","мраках","кого","пожелает","Аллах","Он сбивает его","и кого","Он пожелает","Он поставит его","на","путь","прямой"]],[6,40,["قُلۡ","أَرَءَيۡتَكُمۡ","إِنۡ","أَتَىٰكُمۡ","عَذَابُ","ٱللَّهِ","أَوۡ","أَتَتۡكُمُ","ٱلسَّاعَةُ","أَغَيۡرَ","ٱللَّهِ","تَدۡعُونَ","إِن","كُنتُمۡ","صَٰدِقِينَ"],"ḳул араайтакум ин атакум `азабуллахи ау ататкумус са`ату агайраллахи тад`ууна ин кунтум садиḳиин","Скажи: «Скажите мне, станете ли вы призывать кого-либо наряду с Аллахом, если вас поразит наказание Аллаха или наступит Час, если только вы говорите правду?».",["скажи","как вы думаете","если","придёт к вам","наказание","Аллаха","или","придёт к вам","Час","разве иного, чем","Аллах","вы призываете","если","вы","правдивы"]],[6,41,["بَلۡ","إِيَّاهُ","تَدۡعُونَ","فَيَكۡشِفُ","مَا","تَدۡعُونَ","إِلَيۡهِ","إِن","شَآءَ","وَتَنسَوۡنَ","مَا","تُشۡرِكُونَ"],"бал иййаху тад`ууна файакшифу ма тад`ууна илайхи ин шаа ватансауна ма тушрикуун","О нет! Вы будете призывать только Его. Если Он пожелает, то избавит вас от того, по поводу чего вы станете взывать к Нему, и тогда вы забудете о тех, кого приобщали в сотоварищи.",["нет же","лишь Его","вы призываете","и Он устранит","то, по поводу чего","вы взываете","к Нему","если","пожелает","и вы забудете","то, что","вы приобщаете"]],[6,42,["وَلَقَدۡ","أَرۡسَلۡنَآ","إِلَىٰٓ","أُمَمٖ","مِّن","قَبۡلِكَ","فَأَخَذۡنَٰهُم","بِٱلۡبَأۡسَآءِ","وَٱلضَّرَّآءِ","لَعَلَّهُمۡ","يَتَضَرَّعُونَ"],"валаḳад арсална ила умамим мин ḳаблика фа'ахазнахум билба'саи ваддарраи ла`аллахум йатадарра`уун","Мы уже отправляли посланников к народам до тебя. Мы подвергали их нищете и недугам, дабы они проявили смирение.",["и уже","Мы посылали","к","народам","из","прежде тебя","и Мы схватили их","бедствиями","и недугами","чтобы они","смирились"]],[6,43,["فَلَوۡلَآ","إِذۡ","جَآءَهُم","بَأۡسُنَا","تَضَرَّعُواْ","وَلَٰكِن","قَسَتۡ","قُلُوبُهُمۡ","وَزَيَّنَ","لَهُمُ","ٱلشَّيۡطَٰنُ","مَا","كَانُواْ","يَعۡمَلُونَ"],"фалаула из жаахум ба'суна тадарра`уу валакин ḳасат ḳулуубухум вазаййана лахумуш шайтану ма кануу йа`малуун","Почему же, когда их поражало Наше наказание, они не проявили смирение? Их сердца ожесточались, а дьявол приукрашивал для них то, что они совершали.",["почему же не","когда","пришло к ним","Наше наказание","они смирились","но","ожесточились","их сердца","и приукрасил","для них","шайтан","то, что","они","делали"]],[6,44,["فَلَمَّا","نَسُواْ","مَا","ذُكِّرُواْ","بِهِۦ","فَتَحۡنَا","عَلَيۡهِمۡ","أَبۡوَٰبَ","كُلِّ","شَيۡءٍ","حَتَّىٰٓ","إِذَا","فَرِحُواْ","بِمَآ","أُوتُوٓاْ","أَخَذۡنَٰهُم","بَغۡتَةٗ","فَإِذَا","هُم","مُّبۡلِسُونَ"],"фаламма насуу ма зуккируу бихии фатахна `алайхим абваба кулли шай'ин хатта иза фарихуу бима уутуу ахазнахум багтатан фа'иза хум мублисуун","Когда они позабыли о том, что им напоминали, Мы распахнули перед ними врата ко всякой вещи. Когда же они возрадовались дарованному, Мы схватили их внезапно, и они пришли в отчаяние!",["и когда","они забыли","то, что","им напоминали","о нём","Мы открыли","для них","врата","всякой","вещи","пока","когда","они возрадовались","тому, что","им было дано","Мы схватили их","внезапно","и вот","они","в отчаянии"]]],"m":[[["۞ إِنَّمَا","лишь",6,36],["يَسۡتَجِيبُ","откликаются",6,36],["ٱلَّذِينَ","те, которые",6,36],["يَسۡمَعُونَۘ","слышат",6,36],["وَٱلۡمَوۡتَىٰ","а мёртвых",6,36],["يَبۡعَثُهُمُ","воскресит их",6,36],["ٱللَّهُ","Аллах",6,36],["ثُمَّ","затем",6,36],["إِلَيۡهِ","к Нему",6,36]],[["يُرۡجَعُونَ","они будут возвращены",6,36],[36],["وَقَالُواْ","и сказали они",6,37],["لَوۡلَا","почему не",6,37],["نُزِّلَ","ниспослано",6,37],["عَلَيۡهِ","ему",6,37],["ءَايَةٞ","знамение",6,37],["مِّن","от",6,37],["رَّبِّهِۦۚ","его Господа",6,37],["قُلۡ","скажи",6,37],["إِنَّ","поистине",6,37],["ٱللَّهَ","Аллах",6,37]],[["قَادِرٌ","способен",6,37],["عَلَىٰٓ","на то",6,37],["أَن","чтобы",6,37],["يُنَزِّلَ","ниспослать",6,37],["ءَايَةٗ","знамение",6,37],["وَلَٰكِنَّ","но",6,37],["أَكۡثَرَهُمۡ","большинство их",6,37],["لَا","не",6,37],["يَعۡلَمُونَ","знают",6,37],[37],["وَمَا","и нет",6,38]],[["مِن","никакого",6,38],["دَآبَّةٖ","животного",6,38],["فِي","на",6,38],["ٱلۡأَرۡضِ","земле",6,38],["وَلَا","и ни",6,38],["طَٰٓئِرٖ","птицы",6,38],["يَطِيرُ","летающей",6,38],["بِجَنَاحَيۡهِ","на двух своих крыльях",6,38],["إِلَّآ","кроме",6,38],["أُمَمٌ","общины",6,38],["أَمۡثَالُكُمۚ","подобные вам",6,38]],[["مَّا","не",6,38],["فَرَّطۡنَا","Мы упустили",6,38],["فِي","в",6,38],["ٱلۡكِتَٰبِ","Писании",6,38],["مِن","никакой",6,38],["شَيۡءٖۚ","вещи",6,38],["ثُمَّ","затем",6,38],["إِلَىٰ","к",6,38],["رَبِّهِمۡ","их Господу",6,38],["يُحۡشَرُونَ","они будут собраны",6,38],[38]],[["وَٱلَّذِينَ","а те, которые",6,39],["كَذَّبُواْ","отвергли",6,39],["بِـَٔايَٰتِنَا","Наши знамения",6,39],["صُمّٞ","глухи",6,39],["وَبُكۡمٞ","и немы",6,39],["فِي","во",6,39],["ٱلظُّلُمَٰتِۗ","мраках",6,39],["مَن","кого",6,39],["يَشَإِ","пожелает",6,39],["ٱللَّهُ","Аллах",6,39]],[["يُضۡلِلۡهُ","Он сбивает его",6,39],["وَمَن","и кого",6,39],["يَشَأۡ","Он пожелает",6,39],["يَجۡعَلۡهُ","Он поставит его",6,39],["عَلَىٰ","на",6,39],["صِرَٰطٖ","путь",6,39],["مُّسۡتَقِيمٖ","прямой",6,39],[39],["قُلۡ","скажи",6,40]],[["أَرَءَيۡتَكُمۡ","как вы думаете",6,40],["إِنۡ","если",6,40],["أَتَىٰكُمۡ","придёт к вам",6,40],["عَذَابُ","наказание",6,40],["ٱللَّهِ","Аллаха",6,40],["أَوۡ","или",6,40],["أَتَتۡكُمُ","придёт к вам",6,40],["ٱلسَّاعَةُ","Час",6,40],["أَغَيۡرَ","разве иного, чем",6,40],["ٱللَّهِ","Аллах",6,40]],[["تَدۡعُونَ","вы призываете",6,40],["إِن","если",6,40],["كُنتُمۡ","вы",6,40],["صَٰدِقِينَ","правдивы",6,40],[40],["بَلۡ","нет же",6,41],["إِيَّاهُ","лишь Его",6,41],["تَدۡعُونَ","вы призываете",6,41],["فَيَكۡشِفُ","и Он устранит",6,41],["مَا","то, по поводу чего",6,41]],[["تَدۡعُونَ","вы взываете",6,41],["إِلَيۡهِ","к Нему",6,41],["إِن","если",6,41],["شَآءَ","пожелает",6,41],["وَتَنسَوۡنَ","и вы забудете",6,41],["مَا","то, что",6,41],["تُشۡرِكُونَ","вы приобщаете",6,41],[41],["وَلَقَدۡ","и уже",6,42],["أَرۡسَلۡنَآ","Мы посылали",6,42]],[["إِلَىٰٓ","к",6,42],["أُمَمٖ","народам",6,42],["مِّن","из",6,42],["قَبۡلِكَ","прежде тебя",6,42],["فَأَخَذۡنَٰهُم","и Мы схватили их",6,42],["بِٱلۡبَأۡسَآءِ","бедствиями",6,42],["وَٱلضَّرَّآءِ","и недугами",6,42],["لَعَلَّهُمۡ","чтобы они",6,42],["يَتَضَرَّعُونَ","смирились",6,42]],[[42],["فَلَوۡلَآ","почему же не",6,43],["إِذۡ","когда",6,43],["جَآءَهُم","пришло к ним",6,43],["بَأۡسُنَا","Наше наказание",6,43],["تَضَرَّعُواْ","они смирились",6,43],["وَلَٰكِن","но",6,43],["قَسَتۡ","ожесточились",6,43],["قُلُوبُهُمۡ","их сердца",6,43]],[["وَزَيَّنَ","и приукрасил",6,43],["لَهُمُ","для них",6,43],["ٱلشَّيۡطَٰنُ","шайтан",6,43],["مَا","то, что",6,43],["كَانُواْ","они",6,43],["يَعۡمَلُونَ","делали",6,43],[43],["فَلَمَّا","и когда",6,44]],[["نَسُواْ","они забыли",6,44],["مَا","то, что",6,44],["ذُكِّرُواْ","им напоминали",6,44],["بِهِۦ","о нём",6,44],["فَتَحۡنَا","Мы открыли",6,44],["عَلَيۡهِمۡ","для них",6,44],["أَبۡوَٰبَ","врата",6,44],["كُلِّ","всякой",6,44],["شَيۡءٍ","вещи",6,44]],[["حَتَّىٰٓ","пока",6,44],["إِذَا","когда",6,44],["فَرِحُواْ","они возрадовались",6,44],["بِمَآ","тому, что",6,44],["أُوتُوٓاْ","им было дано",6,44],["أَخَذۡنَٰهُم","Мы схватили их",6,44],["بَغۡتَةٗ","внезапно",6,44],["فَإِذَا","и вот",6,44],["هُم","они",6,44],["مُّبۡلِسُونَ","в отчаянии",6,44],[44]]]}