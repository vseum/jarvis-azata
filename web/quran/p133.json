{"p":133,"j":7,"a":[[6,45,["فَقُطِعَ","دَابِرُ","ٱلۡقَوۡمِ","ٱلَّذِينَ","ظَلَمُواْۚ","وَٱلۡحَمۡدُ","لِلَّهِ","رَبِّ","ٱلۡعَٰلَمِينَ"],"фаḳути`а дабирул ḳаумил лазиина заламуу валхамду лиллахи раббил `аламиин","Беззаконники были уничтожены до основания. Хвала Аллаху, Господу миров!",["и был отсечён","последний","людей","которые","были несправедливы","и хвала","Аллаху","Господу","миров"]],[6,46,["قُلۡ","أَرَءَيۡتُمۡ","إِنۡ","أَخَذَ","ٱللَّهُ","سَمۡعَكُمۡ","وَأَبۡصَٰرَكُمۡ","وَخَتَمَ","عَلَىٰ","قُلُوبِكُم","مَّنۡ","إِلَٰهٌ","غَيۡرُ","ٱللَّهِ","يَأۡتِيكُم","بِهِۗ","ٱنظُرۡ","كَيۡفَ","نُصَرِّفُ","ٱلۡأٓيَٰتِ","ثُمَّ","هُمۡ","يَصۡدِفُونَ"],"ḳул араайтум ин ахазаллаху сам`акум ва'абсаракум вахатама `ала ḳулуубикум ман илахун гайруллахи йа'тиикум бихинзур кайфа нусаррифул айати сумма хум йасдифуун","Скажи: «Как вы думаете, если Аллах отнимет ваш слух и ваше зрение и запечатает ваши сердца, какое божество, кроме Аллаха, вернет вам все это?». Посмотри, как Мы разъясняем знамения, однако они все еще отворачиваются.",["скажи","как вы думаете","если","отнимет","Аллах","ваш слух","и ваши взоры","и запечатает","на","ваших сердцах","кто","божество","кроме","Аллаха","вернёт вам","это","посмотри","как","Мы разъясняем","знамения","затем","они","отворачиваются"]],[6,47,["قُلۡ","أَرَءَيۡتَكُمۡ","إِنۡ","أَتَىٰكُمۡ","عَذَابُ","ٱللَّهِ","بَغۡتَةً","أَوۡ","جَهۡرَةً","هَلۡ","يُهۡلَكُ","إِلَّا","ٱلۡقَوۡمُ","ٱلظَّٰلِمُونَ"],"ḳул араайтакум ин атакум `азабуллахи багтатан ау жахратан хал йухлаку иллал ḳаумуз залимуун","Скажи: «Как вы думаете, если наказание Аллаха поразит вас неожиданно или открыто, разве будет погублен кто-либо, кроме несправедливых людей?».",["скажи","как вы думаете","если","придёт к вам","наказание","Аллаха","внезапно","или","открыто","разве","будет погублен","кроме","людей","несправедливых"]],[6,48,["وَمَا","نُرۡسِلُ","ٱلۡمُرۡسَلِينَ","إِلَّا","مُبَشِّرِينَ","وَمُنذِرِينَۖ","فَمَنۡ","ءَامَنَ","وَأَصۡلَحَ","فَلَا","خَوۡفٌ","عَلَيۡهِمۡ","وَلَا","هُمۡ","يَحۡزَنُونَ"],"вама нурсилул мурсалиина илла мубашшириина вамунзириина фаман амана ва'аслаха фала хауфун `алайхим вала хум йахзануун","Мы отправляем посланников только добрыми вестниками и предостерегающими увещевателями. Те, которые уверовали и совершали праведные деяния, не познают страха и не будут опечалены.",["и не","Мы посылаем","посланников","кроме как","добрыми вестниками","и увещевателями","а кто","уверовал","и исправился","то нет","страха","над ними","и не","они","будут опечалены"]],[6,49,["وَٱلَّذِينَ","كَذَّبُواْ","بِـَٔايَٰتِنَا","يَمَسُّهُمُ","ٱلۡعَذَابُ","بِمَا","كَانُواْ","يَفۡسُقُونَ"],"валлазиина каззабуу би'айатина йамассухумул `азабу бима кануу йафсуḳуун","А тех, которые считают ложью Наши знамения, коснутся мучения за то, что они были нечестивцами.",["а те, которые","отвергли","Наши знамения","коснётся их","наказание","за то, что","они","нечествовали"]],[6,50,["قُل","لَّآ","أَقُولُ","لَكُمۡ","عِندِي","خَزَآئِنُ","ٱللَّهِ","وَلَآ","أَعۡلَمُ","ٱلۡغَيۡبَ","وَلَآ","أَقُولُ","لَكُمۡ","إِنِّي","مَلَكٌۖ","إِنۡ","أَتَّبِعُ","إِلَّا","مَا","يُوحَىٰٓ","إِلَيَّۚ","قُلۡ","هَلۡ","يَسۡتَوِي","ٱلۡأَعۡمَىٰ","وَٱلۡبَصِيرُۚ","أَفَلَا","تَتَفَكَّرُونَ"],"ḳул ла аḳуулу лакум `индии хазаинуллахи вала а`ламул гайба вала аḳуулу лакум иннии малакун ин аттаби`у илла ма йууха илаййа ḳул хал йаставил а`ма валбасииру афала татафаккаруун","Скажи: «Я не говорю вам, что при мне сокровищницы Аллаха, и я не ведаю сокровенного. Я не говорю вам, что являюсь ангелом. Я следую лишь тому, что ниспосылается мне в откровении». Скажи: «Разве равны слепой и зрячий? Неужели вы не поразмыслите?».",["скажи","не","я говорю","вам","у меня","сокровищницы","Аллаха","и не","я знаю","сокровенное","и не","я говорю","вам","что я","ангел","не","следую я","кроме","того, что","внушается","мне","скажи","разве","равны","слепой","и зрячий","разве не","вы поразмыслите"]],[6,51,["وَأَنذِرۡ","بِهِ","ٱلَّذِينَ","يَخَافُونَ","أَن","يُحۡشَرُوٓاْ","إِلَىٰ","رَبِّهِمۡ","لَيۡسَ","لَهُم","مِّن","دُونِهِۦ","وَلِيّٞ","وَلَا","شَفِيعٞ","لَّعَلَّهُمۡ","يَتَّقُونَ"],"ва'анзир бихил лазиина йахафууна ан йухшаруу ила раббихим лайса лахум мин дуунихии валиййун вала шафии`ул ла`аллахум йаттаḳуун","Предостерегай им тех, которые страшатся того, что они будут собраны перед своим Господом тогда, когда не будет у них, помимо Него, ни покровителя, ни заступника. Быть может, они устрашатся!",["и предостерегай","им","тех, которые","боятся","что","они будут собраны","к","их Господу","нет","у них","из","помимо Него","покровителя","и ни","заступника","чтобы они","были богобоязненны"]],[6,52,["وَلَا","تَطۡرُدِ","ٱلَّذِينَ","يَدۡعُونَ","رَبَّهُم","بِٱلۡغَدَوٰةِ","وَٱلۡعَشِيِّ","يُرِيدُونَ","وَجۡهَهُۥۖ","مَا","عَلَيۡكَ","مِنۡ","حِسَابِهِم","مِّن","شَيۡءٖ","وَمَا","مِنۡ","حِسَابِكَ","عَلَيۡهِم","مِّن","شَيۡءٖ","فَتَطۡرُدَهُمۡ","فَتَكُونَ","مِنَ","ٱلظَّٰلِمِينَ"],"вала татрудил лазиина йад`ууна раббахум билгадавати вал`ашиййи йуриидууна важхахуу ма `алайка мин хисабихим мин шай'ин вама мин хисабика `алайхим мин шай'ин фататрудахум фатакууна миназ залимиин","Не прогоняй тех, которые взывают к своему Господу утром и перед закатом, стремясь к Его Лику. Ты нисколько не в ответе за них, и они нисколько не в ответе за тебя. Если же ты прогонишь их, то окажешься одним из беззаконников.",["и не","прогоняй","тех, которые","взывают","к своему Господу","утром","и вечером","желая","Его Лика","нет","на тебе","из","их отчёта","ни","чего-либо","и нет","из","твоего отчёта","на них","ни","чего-либо","и прогнал бы их","и оказался бы","из","беззаконников"]]],"m":[[["فَقُطِعَ","и был отсечён",6,45],["دَابِرُ","последний",6,45],["ٱلۡقَوۡمِ","людей",6,45],["ٱلَّذِينَ","которые",6,45],["ظَلَمُواْۚ","были несправедливы",6,45],["وَٱلۡحَمۡدُ","и хвала",6,45],["لِلَّهِ","Аллаху",6,45],["رَبِّ","Господу",6,45],["ٱلۡعَٰلَمِينَ","миров",6,45],[45]],[["قُلۡ","скажи",6,46],["أَرَءَيۡتُمۡ","как вы думаете",6,46],["إِنۡ","если",6,46],["أَخَذَ","отнимет",6,46],["ٱللَّهُ","Аллах",6,46],["سَمۡعَكُمۡ","ваш слух",6,46],["وَأَبۡصَٰرَكُمۡ","и ваши взоры",6,46],["وَخَتَمَ","и запечатает",6,46],["عَلَىٰ","на",6,46],["قُلُوبِكُم","ваших сердцах",6,46]],[["مَّنۡ","кто",6,46],["إِلَٰهٌ","божество",6,46],["غَيۡرُ","кроме",6,46],["ٱللَّهِ","Аллаха",6,46],["يَأۡتِيكُم","вернёт вам",6,46],["بِهِۗ","это",6,46],["ٱنظُرۡ","посмотри",6,46],["كَيۡفَ","как",6,46],["نُصَرِّفُ","Мы разъясняем",6,46],["ٱلۡأٓيَٰتِ","знамения",6,46]],[["ثُمَّ","затем",6,46],["هُمۡ","они",6,46],["يَصۡدِفُونَ","отворачиваются",6,46],[46],["قُلۡ","скажи",6,47],["أَرَءَيۡتَكُمۡ","как вы думаете",6,47],["إِنۡ","если",6,47],["أَتَىٰكُمۡ","придёт к вам",6,47],["عَذَابُ","наказание",6,47],["ٱللَّهِ","Аллаха",6,47]],[["بَغۡتَةً","внезапно",6,47],["أَوۡ","или",6,47],["جَهۡرَةً","открыто",6,47],["هَلۡ","разве",6,47],["يُهۡلَكُ","будет погублен",6,47],["إِلَّا","кроме",6,47],["ٱلۡقَوۡمُ","людей",6,47],["ٱلظَّٰلِمُونَ","несправедливых",6,47],[47],["وَمَا","и не",6,48]],[["نُرۡسِلُ","Мы посылаем",6,48],["ٱلۡمُرۡسَلِينَ","посланников",6,48],["إِلَّا","кроме как",6,48],["مُبَشِّرِينَ","добрыми вестниками",6,48],["وَمُنذِرِينَۖ","и увещевателями",6,48],["فَمَنۡ","а кто",6,48],["ءَامَنَ","уверовал",6,48],["وَأَصۡلَحَ","и исправился",6,48]],[["فَلَا","то нет",6,48],["خَوۡفٌ","страха",6,48],["عَلَيۡهِمۡ","над ними",6,48],["وَلَا","и не",6,48],["هُمۡ","они",6,48],["يَحۡزَنُونَ","будут опечалены",6,48],[48],["وَٱلَّذِينَ","а те, которые",6,49],["كَذَّبُواْ","отвергли",6,49],["بِـَٔايَٰتِنَا","Наши знамения",6,49]],[["يَمَسُّهُمُ","коснётся их",6,49],["ٱلۡعَذَابُ","наказание",6,49],["بِمَا","за то, что",6,49],["كَانُواْ","они",6,49],["يَفۡسُقُونَ","нечествовали",6,49],[49],["قُل","скажи",6,50],["لَّآ","не",6,50],["أَقُولُ","я говорю",6,50],["لَكُمۡ","вам",6,50]],[["عِندِي","у меня",6,50],["خَزَآئِنُ","сокровищницы",6,50],["ٱللَّهِ","Аллаха",6,50],["وَلَآ","и не",6,50],["أَعۡلَمُ","я знаю",6,50],["ٱلۡغَيۡبَ","сокровенное",6,50],["وَلَآ","и не",6,50],["أَقُولُ","я говорю",6,50],["لَكُمۡ","вам",6,50],["إِنِّي","что я",6,50],["مَلَكٌۖ","ангел",6,50]],[["إِنۡ","не",6,50],["أَتَّبِعُ","следую я",6,50],["إِلَّا","кроме",6,50],["مَا","того, что",6,50],["يُوحَىٰٓ","внушается",6,50],["إِلَيَّۚ","мне",6,50],["قُلۡ","скажи",6,50],["هَلۡ","разве",6,50],["يَسۡتَوِي","равны",6,50],["ٱلۡأَعۡمَىٰ","слепой",6,50],["وَٱلۡبَصِيرُۚ","и зрячий",6,50]],[["أَفَلَا","разве не",6,50],["تَتَفَكَّرُونَ","вы поразмыслите",6,50],[50],["وَأَنذِرۡ","и предостерегай",6,51],["بِهِ","им",6,51],["ٱلَّذِينَ","тех, которые",6,51],["يَخَافُونَ","боятся",6,51],["أَن","что",6,51],["يُحۡشَرُوٓاْ","они будут собраны",6,51]],[["إِلَىٰ","к",6,51],["رَبِّهِمۡ","их Господу",6,51],["لَيۡسَ","нет",6,51],["لَهُم","у них",6,51],["مِّن","из",6,51],["دُونِهِۦ","помимо Него",6,51],["وَلِيّٞ","покровителя",6,51],["وَلَا","и ни",6,51],["شَفِيعٞ","заступника",6,51],["لَّعَلَّهُمۡ","чтобы они",6,51],["يَتَّقُونَ","были богобоязненны",6,51]],[[51],["وَلَا","и не",6,52],["تَطۡرُدِ","прогоняй",6,52],["ٱلَّذِينَ","тех, которые",6,52],["يَدۡعُونَ","взывают",6,52],["رَبَّهُم","к своему Господу",6,52],["بِٱلۡغَدَوٰةِ","утром",6,52],["وَٱلۡعَشِيِّ","и вечером",6,52],["يُرِيدُونَ","желая",6,52]],[["وَجۡهَهُۥۖ","Его Лика",6,52],["مَا","нет",6,52],["عَلَيۡكَ","на тебе",6,52],["مِنۡ","из",6,52],["حِسَابِهِم","их отчёта",6,52],["مِّن","ни",6,52],["شَيۡءٖ","чего-либо",6,52],["وَمَا","и нет",6,52],["مِنۡ","из",6,52],["حِسَابِكَ","твоего отчёта",6,52]],[["عَلَيۡهِم","на них",6,52],["مِّن","ни",6,52],["شَيۡءٖ","чего-либо",6,52],["فَتَطۡرُدَهُمۡ","и прогнал бы их",6,52],["فَتَكُونَ","и оказался бы",6,52],["مِنَ","из",6,52],["ٱلظَّٰلِمِينَ","беззаконников",6,52],[52]]]}