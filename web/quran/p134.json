{"p":134,"j":7,"a":[[6,53,["وَكَذَٰلِكَ","فَتَنَّا","بَعۡضَهُم","بِبَعۡضٖ","لِّيَقُولُوٓاْ","أَهَٰٓؤُلَآءِ","مَنَّ","ٱللَّهُ","عَلَيۡهِم","مِّنۢ","بَيۡنِنَآۗ","أَلَيۡسَ","ٱللَّهُ","بِأَعۡلَمَ","بِٱلشَّٰكِرِينَ"],"ваказалика фатанна ба`дахум биба`дил лийаḳуулуу ахаулаи манналлаху `алайхим мим байнина алайсаллаху би'а`лама бишшакириин","Так Мы искушали одних из них другими, дабы они сказали: «Неужели среди нас Аллах оказал милость только этим?». Разве Аллах не лучше знает тех, кто благодарен?",["и так","Мы испытали","одних из них","другими","чтобы они сказали","неужели этим","оказал милость","Аллах","им","из","среди нас","разве не","Аллах","лучше знает","благодарных"]],[6,54,["وَإِذَا","جَآءَكَ","ٱلَّذِينَ","يُؤۡمِنُونَ","بِـَٔايَٰتِنَا","فَقُلۡ","سَلَٰمٌ","عَلَيۡكُمۡۖ","كَتَبَ","رَبُّكُمۡ","عَلَىٰ","نَفۡسِهِ","ٱلرَّحۡمَةَ","أَنَّهُۥ","مَنۡ","عَمِلَ","مِنكُمۡ","سُوٓءَۢا","بِجَهَٰلَةٖ","ثُمَّ","تَابَ","مِنۢ","بَعۡدِهِۦ","وَأَصۡلَحَ","فَأَنَّهُۥ","غَفُورٞ","رَّحِيمٞ"],"ва'иза жаакал лазиина йу'минууна би'айатина фаḳул саламун `алайкум катаба раббукум `ала нафсихир рахмата аннахуу ман `амила минкум сууа бижахалатин сумма таба мим ба`дихии ва'аслаха фа'аннахуу гафуурур рахиим","Когда к тебе приходят те, которые уверовали в Наши знамения, говори им: «Мир вам! Ваш Господь предписал себе быть Милосердным, и если кто из вас сотворит зло по своему невежеству, а затем раскается и станет совершать праведные деяния, то ведь Он - Прощающий, Милосердный».",["и когда","приходят к тебе","те, которые","веруют","в Наши знамения","то скажи","мир","вам","предписал","ваш Господь","на","Себя","милость","что","кто","сделал","из вас","зло","по невежеству","затем","покаялся","из","после этого","и исправился","то, поистине, Он","Прощающий","Милосердный"]],[6,55,["وَكَذَٰلِكَ","نُفَصِّلُ","ٱلۡأٓيَٰتِ","وَلِتَسۡتَبِينَ","سَبِيلُ","ٱلۡمُجۡرِمِينَ"],"ваказалика нуфассилул айати валитастабиина сабиилул мужримиин","Таким образом Мы разъясняем знамения, чтобы стал ясен путь грешников.",["и так","Мы разъясняем","знамения","и чтобы стал ясен","путь","грешников"]],[6,56,["قُلۡ","إِنِّي","نُهِيتُ","أَنۡ","أَعۡبُدَ","ٱلَّذِينَ","تَدۡعُونَ","مِن","دُونِ","ٱللَّهِۚ","قُل","لَّآ","أَتَّبِعُ","أَهۡوَآءَكُمۡ","قَدۡ","ضَلَلۡتُ","إِذٗا","وَمَآ","أَنَا۠","مِنَ","ٱلۡمُهۡتَدِينَ"],"ḳул иннии нухииту ан а`будал лазиина тад`ууна мин дууниллахи ḳул ла аттаби`у ахваакум ḳад далалту изан вама ана минал мухтадиин","Скажи: «Мне запрещено поклоняться тем, к кому вы взываете наряду с Аллахом». Скажи: «Я не стану потакать вашим желаниям. В противном случае я собьюсь с пути и не окажусь в числе следующих прямым путем».",["скажи","поистине, мне","запрещено","чтобы","я поклонялся","тем, которых","вы призываете","из","помимо","Аллаха","скажи","не","я последую","вашим страстям","уже","я сбился бы с пути","тогда","и не","я","из","следующих прямым путём"]],[6,57,["قُلۡ","إِنِّي","عَلَىٰ","بَيِّنَةٖ","مِّن","رَّبِّي","وَكَذَّبۡتُم","بِهِۦۚ","مَا","عِندِي","مَا","تَسۡتَعۡجِلُونَ","بِهِۦٓۚ","إِنِ","ٱلۡحُكۡمُ","إِلَّا","لِلَّهِۖ","يَقُصُّ","ٱلۡحَقَّۖ","وَهُوَ","خَيۡرُ","ٱلۡفَٰصِلِينَ"],"ḳул иннии `ала баййинатим мир раббии ваказзабтум бихии ма `индии ма таста`жилууна бихии инил хукму илла лиллахи йаḳуссул хаḳḳа вахуа хайрул фасилиин","Скажи: «Я руководствуюсь ясным доказательством от моего Господа, а вы считаете это ложью. Я не владею тем, что вы торопите. Решение принимает только Аллах. Он изрекает истину и является Наилучшим из судий».",["скажи","поистине, я","на","ясном доказательстве","от","моего Господа","а вы сочли ложью","его","нет","у меня","того, что","вы торопите","его","не","решение","кроме","у Аллаха","Он излагает","истину","и Он","лучший","из судей"]],[6,58,["قُل","لَّوۡ","أَنَّ","عِندِي","مَا","تَسۡتَعۡجِلُونَ","بِهِۦ","لَقُضِيَ","ٱلۡأَمۡرُ","بَيۡنِي","وَبَيۡنَكُمۡۗ","وَٱللَّهُ","أَعۡلَمُ","بِٱلظَّٰلِمِينَ"],"ḳул лау анна `индии ма таста`жилууна бихии лаḳудийал амру байнии вабайнакум валлаху а`ламу биззалимиин","Скажи: «Если бы я владел тем, что вы торопите, то спор между мной и вами был бы уже решен. Но Аллаху лучше знать о беззаконниках.",["скажи","если бы","что","у меня","то, что","вы торопите","его","непременно было бы решено","дело","между мной","и между вами","а Аллах","лучше знает","о беззаконниках"]],[6,59,["وَعِندَهُۥ","مَفَاتِحُ","ٱلۡغَيۡبِ","لَا","يَعۡلَمُهَآ","إِلَّا","هُوَۚ","وَيَعۡلَمُ","مَا","فِي","ٱلۡبَرِّ","وَٱلۡبَحۡرِۚ","وَمَا","تَسۡقُطُ","مِن","وَرَقَةٍ","إِلَّا","يَعۡلَمُهَا","وَلَا","حَبَّةٖ","فِي","ظُلُمَٰتِ","ٱلۡأَرۡضِ","وَلَا","رَطۡبٖ","وَلَا","يَابِسٍ","إِلَّا","فِي","كِتَٰبٖ","مُّبِينٖ"],"ва`индахуу мафатихул гайби ла йа`ламуха илла хуа вайа`ламу ма фил барри валбахри вама тасḳуту мин вараḳатин илла йа`ламуха вала хаббатин фии зулуматил арди вала ратбин вала йабисин илла фии китабим мубиин","У Него ключи к сокровенному, и знает о них только Он. Ему известно то, что на суше и в море. Даже лист падает только с Его ведома. Нет ни зернышка во мраках земли, ни чего-либо свежего или сухого, чего бы не было в ясном Писании.",["и у Него","ключи","сокровенного","не","знает их","кроме","Него","и Он знает","то, что","на","суше","и море","и не","падает","ни один","лист","кроме как","Он знает его","и ни","зерна","в","мраках","земли","и ни","влажного","и ни","сухого","кроме как","в","Писании","ясном"]]],"m":[[["وَكَذَٰلِكَ","и так",6,53],["فَتَنَّا","Мы испытали",6,53],["بَعۡضَهُم","одних из них",6,53],["بِبَعۡضٖ","другими",6,53],["لِّيَقُولُوٓاْ","чтобы они сказали",6,53],["أَهَٰٓؤُلَآءِ","неужели этим",6,53],["مَنَّ","оказал милость",6,53],["ٱللَّهُ","Аллах",6,53]],[["عَلَيۡهِم","им",6,53],["مِّنۢ","из",6,53],["بَيۡنِنَآۗ","среди нас",6,53],["أَلَيۡسَ","разве не",6,53],["ٱللَّهُ","Аллах",6,53],["بِأَعۡلَمَ","лучше знает",6,53],["بِٱلشَّٰكِرِينَ","благодарных",6,53],[53],["وَإِذَا","и когда",6,54]],[["جَآءَكَ","приходят к тебе",6,54],["ٱلَّذِينَ","те, которые",6,54],["يُؤۡمِنُونَ","веруют",6,54],["بِـَٔايَٰتِنَا","в Наши знамения",6,54],["فَقُلۡ","то скажи",6,54],["سَلَٰمٌ","мир",6,54],["عَلَيۡكُمۡۖ","вам",6,54],["كَتَبَ","предписал",6,54]],[["رَبُّكُمۡ","ваш Господь",6,54],["عَلَىٰ","на",6,54],["نَفۡسِهِ","Себя",6,54],["ٱلرَّحۡمَةَ","милость",6,54],["أَنَّهُۥ","что",6,54],["مَنۡ","кто",6,54],["عَمِلَ","сделал",6,54],["مِنكُمۡ","из вас",6,54],["سُوٓءَۢا","зло",6,54]],[["بِجَهَٰلَةٖ","по невежеству",6,54],["ثُمَّ","затем",6,54],["تَابَ","покаялся",6,54],["مِنۢ","из",6,54],["بَعۡدِهِۦ","после этого",6,54],["وَأَصۡلَحَ","и исправился",6,54],["فَأَنَّهُۥ","то, поистине, Он",6,54],["غَفُورٞ","Прощающий",6,54],["رَّحِيمٞ","Милосердный",6,54],[54]],[["وَكَذَٰلِكَ","и так",6,55],["نُفَصِّلُ","Мы разъясняем",6,55],["ٱلۡأٓيَٰتِ","знамения",6,55],["وَلِتَسۡتَبِينَ","и чтобы стал ясен",6,55],["سَبِيلُ","путь",6,55],["ٱلۡمُجۡرِمِينَ","грешников",6,55],[55]],[["قُلۡ","скажи",6,56],["إِنِّي","поистине, мне",6,56],["نُهِيتُ","запрещено",6,56],["أَنۡ","чтобы",6,56],["أَعۡبُدَ","я поклонялся",6,56],["ٱلَّذِينَ","тем, которых",6,56],["تَدۡعُونَ","вы призываете",6,56],["مِن","из",6,56],["دُونِ","помимо",6,56],["ٱللَّهِۚ","Аллаха",6,56],["قُل","скажи",6,56],["لَّآ","не",6,56],["أَتَّبِعُ","я последую",6,56]],[["أَهۡوَآءَكُمۡ","вашим страстям",6,56],["قَدۡ","уже",6,56],["ضَلَلۡتُ","я сбился бы с пути",6,56],["إِذٗا","тогда",6,56],["وَمَآ","и не",6,56],["أَنَا۠","я",6,56],["مِنَ","из",6,56],["ٱلۡمُهۡتَدِينَ","следующих прямым путём",6,56],[56]],[["قُلۡ","скажи",6,57],["إِنِّي","поистине, я",6,57],["عَلَىٰ","на",6,57],["بَيِّنَةٖ","ясном доказательстве",6,57],["مِّن","от",6,57],["رَّبِّي","моего Господа",6,57],["وَكَذَّبۡتُم","а вы сочли ложью",6,57],["بِهِۦۚ","его",6,57],["مَا","нет",6,57],["عِندِي","у меня",6,57],["مَا","того, что",6,57]],[["تَسۡتَعۡجِلُونَ","вы торопите",6,57],["بِهِۦٓۚ","его",6,57],["إِنِ","не",6,57],["ٱلۡحُكۡمُ","решение",6,57],["إِلَّا","кроме",6,57],["لِلَّهِۖ","у Аллаха",6,57],["يَقُصُّ","Он излагает",6,57],["ٱلۡحَقَّۖ","истину",6,57],["وَهُوَ","и Он",6,57],["خَيۡرُ","лучший",6,57]],[["ٱلۡفَٰصِلِينَ","из судей",6,57],[57],["قُل","скажи",6,58],["لَّوۡ","если бы",6,58],["أَنَّ","что",6,58],["عِندِي","у меня",6,58],["مَا","то, что",6,58],["تَسۡتَعۡجِلُونَ","вы торопите",6,58],["بِهِۦ","его",6,58],["لَقُضِيَ","непременно было бы решено",6,58]],[["ٱلۡأَمۡرُ","дело",6,58],["بَيۡنِي","между мной",6,58],["وَبَيۡنَكُمۡۗ","и между вами",6,58],["وَٱللَّهُ","а Аллах",6,58],["أَعۡلَمُ","лучше знает",6,58],["بِٱلظَّٰلِمِينَ","о беззаконниках",6,58],[58]],[["۞ وَعِندَهُۥ","и у Него",6,59],["مَفَاتِحُ","ключи",6,59],["ٱلۡغَيۡبِ","сокровенного",6,59],["لَا","не",6,59],["يَعۡلَمُهَآ","знает их",6,59],["إِلَّا","кроме",6,59],["هُوَۚ","Него",6,59],["وَيَعۡلَمُ","и Он знает",6,59],["مَا","то, что",6,59],["فِي","на",6,59]],[["ٱلۡبَرِّ","суше",6,59],["وَٱلۡبَحۡرِۚ","и море",6,59],["وَمَا","и не",6,59],["تَسۡقُطُ","падает",6,59],["مِن","ни один",6,59],["وَرَقَةٍ","лист",6,59],["إِلَّا","кроме как",6,59],["يَعۡلَمُهَا","Он знает его",6,59],["وَلَا","и ни",6,59],["حَبَّةٖ","зерна",6,59]],[["فِي","в",6,59],["ظُلُمَٰتِ","мраках",6,59],["ٱلۡأَرۡضِ","земли",6,59],["وَلَا","и ни",6,59],["رَطۡبٖ","влажного",6,59],["وَلَا","и ни",6,59],["يَابِسٍ","сухого",6,59],["إِلَّا","кроме как",6,59],["فِي","в",6,59],["كِتَٰبٖ","Писании",6,59],["مُّبِينٖ","ясном",6,59],[59]]]}