{"p":136,"j":7,"a":[[6,69,["وَمَا","عَلَى","ٱلَّذِينَ","يَتَّقُونَ","مِنۡ","حِسَابِهِم","مِّن","شَيۡءٖ","وَلَٰكِن","ذِكۡرَىٰ","لَعَلَّهُمۡ","يَتَّقُونَ"],"вама `алал лазиина йаттаḳууна мин хисабихим мин шай'ин валакин зикра ла`аллахум йаттаḳуун","Те, которые богобоязненны, не несут никакой ответственности за их расчет. Они должны лишь напоминать им, - быть может, они устрашатся.",["и нет","на","тех, которые","богобоязненны","из","их расчёта","ни","чего-либо","но","напоминание","чтобы они","были богобоязненны"]],[6,70,["وَذَرِ","ٱلَّذِينَ","ٱتَّخَذُواْ","دِينَهُمۡ","لَعِبٗا","وَلَهۡوٗا","وَغَرَّتۡهُمُ","ٱلۡحَيَوٰةُ","ٱلدُّنۡيَاۚ","وَذَكِّرۡ","بِهِۦٓ","أَن","تُبۡسَلَ","نَفۡسُۢ","بِمَا","كَسَبَتۡ","لَيۡسَ","لَهَا","مِن","دُونِ","ٱللَّهِ","وَلِيّٞ","وَلَا","شَفِيعٞ","وَإِن","تَعۡدِلۡ","كُلَّ","عَدۡلٖ","لَّا","يُؤۡخَذۡ","مِنۡهَآۗ","أُوْلَٰٓئِكَ","ٱلَّذِينَ","أُبۡسِلُواْ","بِمَا","كَسَبُواْۖ","لَهُمۡ","شَرَابٞ","مِّنۡ","حَمِيمٖ","وَعَذَابٌ","أَلِيمُۢ","بِمَا","كَانُواْ","يَكۡفُرُونَ"],"вазарил лазиинаттахазуу диинахум ла`ибан валахван вагарратхумул хайаватуд дунйа вазаккир бихии ан тубсала нафсу бима касабат лайса лаха мин дууниллахи валиййун вала шафии`ун ва'ин та`дил кулла `адлил ла йу'хаз минха улаикал лазиина убсилуу бима касабуу лахум шарабум мин хамиимин ва`азабун алииму бима кануу йакфуруун","Покинь тех, которые считают свою религию забавой и потехой и обольщаются мирской жизнью. Но увещевай их этим, дабы душа не обрекла себя на погибель тем, что приобрела, когда не будет у нее покровителя и заступника, кроме Аллаха, и когда от нее ничего не будет принято, какой бы выкуп она ни предложила. Они обрекли себя на погибель тем, что приобрели. Им уготованы кипящее питье и мучительные страдания за то, что они были неверующими.",["и оставь","тех, которые","взяли","свою религию","игрой","и потехой","и обольстила их","жизнь","мирская","и напоминай","этим","дабы не","была погублена","душа","за то, что","она приобрела","нет","у неё","из","помимо","Аллаха","покровителя","и ни","заступника","и если","она предложит выкуп","всякий","выкуп","не","будет принят","от неё","те","которые","преданы гибели","за то, что","они приобрели","им","питьё","из","кипятка","и наказание","мучительное","за то, что","они","не веровали"]],[6,71,["قُلۡ","أَنَدۡعُواْ","مِن","دُونِ","ٱللَّهِ","مَا","لَا","يَنفَعُنَا","وَلَا","يَضُرُّنَا","وَنُرَدُّ","عَلَىٰٓ","أَعۡقَابِنَا","بَعۡدَ","إِذۡ","هَدَىٰنَا","ٱللَّهُ","كَٱلَّذِي","ٱسۡتَهۡوَتۡهُ","ٱلشَّيَٰطِينُ","فِي","ٱلۡأَرۡضِ","حَيۡرَانَ","لَهُۥٓ","أَصۡحَٰبٞ","يَدۡعُونَهُۥٓ","إِلَى","ٱلۡهُدَى","ٱئۡتِنَاۗ","قُلۡ","إِنَّ","هُدَى","ٱللَّهِ","هُوَ","ٱلۡهُدَىٰۖ","وَأُمِرۡنَا","لِنُسۡلِمَ","لِرَبِّ","ٱلۡعَٰلَمِينَ"],"ḳул анад`уу мин дууниллахи ма ла йанфа`уна вала йадурруна ванурадду `ала а`ḳабина ба`да из хаданаллаху каллазистахватхуш шайатиину фил арди хайрана лахуу асхабун йад`уунахуу илал худатина ḳул инна худаллахи хуал худа ва'умирна линуслима лираббил `аламиин","Скажи: «Разве мы станем поклоняться помимо Аллаха тому, что не приносит нам пользы и не причиняет вреда? Разве мы обратимся вспять после того, как Аллах наставил нас на прямой путь, подобно тому, кого дьяволы на земле обольстили и привели в замешательство, чьи товарищи призывают его на прямой путь: «Иди к нам!»». Скажи: «Путь Аллаха - единственно верный путь, и нам велено покориться Господу миров.",["скажи","разве мы будем призывать","из","помимо","Аллаха","то, что","не","приносит нам пользы","и не","вредит нам","и будем возвращены","на","наши пятки","после","того как","наставил нас","Аллах","как тот, кого","соблазнили","шайтаны","на","земле","растерянный","у него","товарищи","зовут его","к","прямому пути","приди к нам","скажи","поистине","путь","Аллаха","он","прямой путь","и нам велено","чтобы мы покорились","Господу","миров"]],[6,72,["وَأَنۡ","أَقِيمُواْ","ٱلصَّلَوٰةَ","وَٱتَّقُوهُۚ","وَهُوَ","ٱلَّذِيٓ","إِلَيۡهِ","تُحۡشَرُونَ"],"ва'ан аḳиимус салавата ваттаḳууху вахуал лазии илайхи тухшаруун","Совершайте намаз и бойтесь Его, ведь к Нему вы будете собраны».",["и чтобы","совершайте","намаз","и бойтесь Его","и Он","Тот, который","к Нему","вы будете собраны"]],[6,73,["وَهُوَ","ٱلَّذِي","خَلَقَ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضَ","بِٱلۡحَقِّۖ","وَيَوۡمَ","يَقُولُ","كُن","فَيَكُونُۚ","قَوۡلُهُ","ٱلۡحَقُّۚ","وَلَهُ","ٱلۡمُلۡكُ","يَوۡمَ","يُنفَخُ","فِي","ٱلصُّورِۚ","عَٰلِمُ","ٱلۡغَيۡبِ","وَٱلشَّهَٰدَةِۚ","وَهُوَ","ٱلۡحَكِيمُ","ٱلۡخَبِيرُ"],"вахуал лазии халаḳас самавати вал'арда билхаḳḳи вайаума йаḳуулу кун файакууну ḳаулухул хаḳḳу валахул мулку йаума йунфаху фис суури `алимул гайби вашшахадати вахуал хакиимул хабиир","Он - Тот, Кто сотворил небеса и землю ради истины. В тот день Он скажет: «Будь!». - и это сбудется. Его Слово есть истина. Ему одному будет принадлежать власть в тот день, когда подуют в Рог. Он знает сокровенное и явное, и Он - Мудрый, Ведающий.",["и Он","Тот, Который","сотворил","небеса","и землю","с истиной","и в день","Он говорит","будь","и оно сбывается","Его слово","истина","и Ему","власть","в день","подуют","в","Рог","Знающий","сокровенное","и явное","и Он","Мудрый","Ведающий"]]],"m":[[["وَمَا","и нет",6,69],["عَلَى","на",6,69],["ٱلَّذِينَ","тех, которые",6,69],["يَتَّقُونَ","богобоязненны",6,69],["مِنۡ","из",6,69],["حِسَابِهِم","их расчёта",6,69],["مِّن","ни",6,69],["شَيۡءٖ","чего-либо",6,69],["وَلَٰكِن","но",6,69]],[["ذِكۡرَىٰ","напоминание",6,69],["لَعَلَّهُمۡ","чтобы они",6,69],["يَتَّقُونَ","были богобоязненны",6,69],[69],["وَذَرِ","и оставь",6,70],["ٱلَّذِينَ","тех, которые",6,70],["ٱتَّخَذُواْ","взяли",6,70]],[["دِينَهُمۡ","свою религию",6,70],["لَعِبٗا","игрой",6,70],["وَلَهۡوٗا","и потехой",6,70],["وَغَرَّتۡهُمُ","и обольстила их",6,70],["ٱلۡحَيَوٰةُ","жизнь",6,70],["ٱلدُّنۡيَاۚ","мирская",6,70],["وَذَكِّرۡ","и напоминай",6,70],["بِهِۦٓ","этим",6,70]],[["أَن","дабы не",6,70],["تُبۡسَلَ","была погублена",6,70],["نَفۡسُۢ","душа",6,70],["بِمَا","за то, что",6,70],["كَسَبَتۡ","она приобрела",6,70],["لَيۡسَ","нет",6,70],["لَهَا","у неё",6,70],["مِن","из",6,70],["دُونِ","помимо",6,70],["ٱللَّهِ","Аллаха",6,