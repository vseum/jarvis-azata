{"p":137,"j":7,"a":[[6,74,["وَإِذۡ","قَالَ","إِبۡرَٰهِيمُ","لِأَبِيهِ","ءَازَرَ","أَتَتَّخِذُ","أَصۡنَامًا","ءَالِهَةً","إِنِّيٓ","أَرَىٰكَ","وَقَوۡمَكَ","فِي","ضَلَٰلٖ","مُّبِينٖ"],"ва'из ḳала ибрахииму ли'абиихи азара ататтахизу аснаман алихатан иннии арака ваḳаумака фии далалим мубиин","Вот Ибрахим (Авраам) сказал своему отцу Азару: «Неужели ты считаешь идолов богами? Я вижу, что ты и твой народ находитесь в очевидном заблуждении».",["и вот","сказал","Ибрахим","своему отцу","Азару","разве ты берёшь","идолов","богами","поистине, я","вижу тебя","и твой народ","в","заблуждении","явном"]],[6,75,["وَكَذَٰلِكَ","نُرِيٓ","إِبۡرَٰهِيمَ","مَلَكُوتَ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِ","وَلِيَكُونَ","مِنَ","ٱلۡمُوقِنِينَ"],"ваказалика нурии ибрахиима малакуутас самавати вал'арди валийакууна минал мууḳиниин","Так Мы показали Ибрахиму (Аврааму) царство небес и земли, дабы он стал одним из убежденных.",["И так","Мы показываем","Ибрахиму","царство","небес","и земли","и чтобы он стал","из","убеждённых"]],[6,76,["فَلَمَّا","جَنَّ","عَلَيۡهِ","ٱلَّيۡلُ","رَءَا","كَوۡكَبٗاۖ","قَالَ","هَٰذَا","رَبِّيۖ","فَلَمَّآ","أَفَلَ","قَالَ","لَآ","أُحِبُّ","ٱلۡأٓفِلِينَ"],"фаламма жанна `алайхил лайлу ра'а каукабан ḳала хаза раббии фаламма афала ḳала ла ухиббул афилиин","Когда ночь покрыла его своим мраком, он увидел звезду и сказал: «Вот мой Господь!». Когда же она закатилась, он сказал: «Я не люблю тех, кто закатывается».",["И когда","покрыла","его","ночь","он увидел","звезду","он сказал","Это","мой Господь","Когда же","она закатилась","он сказал","не","люблю я","закатывающихся"]],[6,77,["فَلَمَّا","رَءَا","ٱلۡقَمَرَ","بَازِغٗا","قَالَ","هَٰذَا","رَبِّيۖ","فَلَمَّآ","أَفَلَ","قَالَ","لَئِن","لَّمۡ","يَهۡدِنِي","رَبِّي","لَأَكُونَنَّ","مِنَ","ٱلۡقَوۡمِ","ٱلضَّآلِّينَ"],"фаламма ра'ал ḳамара базиган ḳала хаза раббии фаламма афала ḳала ла'ил лам йахдинии раббии ла'акуунанна минал ḳаумид даллиин","Когда он увидел восходящую луну, то сказал: «Вот мой Господь!». Когда же она закатилась, он сказал: «Если мой Господь не наставит меня на прямой путь, то я стану одним из заблудших людей».",["И когда","он увидел","луну","восходящую","он сказал","Это","мой Господь","Когда же","она закатилась","он сказал","Если","не","наставит меня","мой Господь","непременно буду я","из","людей","заблудших"]],[6,78,["فَلَمَّا","رَءَا","ٱلشَّمۡسَ","بَازِغَةٗ","قَالَ","هَٰذَا","رَبِّي","هَٰذَآ","أَكۡبَرُۖ","فَلَمَّآ","أَفَلَتۡ","قَالَ","يَٰقَوۡمِ","إِنِّي","بَرِيٓءٞ","مِّمَّا","تُشۡرِكُونَ"],"фаламма ра'аш шамса базигатан ḳала хаза раббии хаза акбару фаламма афалат ḳала йаḳауми иннии барииум мимма тушрикуун","Когда он увидел восходящее солнце, то сказал: «Вот мой Господь! Оно больше других». Когда же оно зашло, он сказал: «О мой народ! Я непричастен к тому, что вы приобщаете в сотоварищи.",["И когда","он увидел","солнце","восходящее","он сказал","Это","мой Господь","это","больше","Когда же","оно зашло","он сказал","О мой народ","Поистине, я","непричастен","к тому, что","вы приобщаете"]],[6,79,["إِنِّي","وَجَّهۡتُ","وَجۡهِيَ","لِلَّذِي","فَطَرَ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضَ","حَنِيفٗاۖ","وَمَآ","أَنَا۠","مِنَ","ٱلۡمُشۡرِكِينَ"],"иннии важжахту важхийа лиллазии фатарас самавати вал'арда ханиифан вама ана минал мушрикиин","Я искренне обратил свой лик к Тому, Кто сотворил небеса и землю, и Я не принадлежу к многобожникам!».",["Поистине, я","обратил","своё лицо","к Тому, Кто","сотворил","небеса","и землю","единобожником","и не","я","из","многобожников"]],[6,80,["وَحَآجَّهُۥ","قَوۡمُهُۥۚ","قَالَ","أَتُحَٰٓجُّوٓنِّي","فِي","ٱللَّهِ","وَقَدۡ","هَدَىٰنِۚ","وَلَآ","أَخَافُ","مَا","تُشۡرِكُونَ","بِهِۦٓ","إِلَّآ","أَن","يَشَآءَ","رَبِّي","شَيۡـٔٗاۚ","وَسِعَ","رَبِّي","كُلَّ","شَيۡءٍ","عِلۡمًاۚ","أَفَلَا","تَتَذَكَّرُونَ"],"вахажжахуу ḳаумухуу ḳала атухажжууннии филлахи ваḳад хадани вала ахафу ма тушрикууна бихии илла ан йашаа раббии шай'ан васи`а раббии кулла шай'ин `илман афала татазаккаруун","Его народ стал препираться с ним, и тогда он сказал: «Неужели вы станете препираться со мной относительно Аллаха, в то время как Он наставил меня на прямой путь? И я не боюсь тех, кого вы приобщаете в сотоварищи к Нему, если только мой Господь не пожелает чего-либо. Мой Господь объемлет знанием всякую вещь. Неужели вы не помяните назидание?",["И препирался с ним","его народ","Он сказал","Неужели вы препираетесь со мной","относительно","Аллаха","а уже","Он наставил меня","И не","боюсь я","того, что","вы приобщаете","к Нему","разве что","если","пожелает","мой Господь","чего-либо","Объемлет","мой Господь","всякую","вещь","знанием","Неужели не","вы опомнитесь"]],[6,81,["وَكَيۡفَ","أَخَافُ","مَآ","أَشۡرَكۡتُمۡ","وَلَا","تَخَافُونَ","أَنَّكُمۡ","أَشۡرَكۡتُم","بِٱللَّهِ","مَا","لَمۡ","يُنَزِّلۡ","بِهِۦ","عَلَيۡكُمۡ","سُلۡطَٰنٗاۚ","فَأَيُّ","ٱلۡفَرِيقَيۡنِ","أَحَقُّ","بِٱلۡأَمۡنِۖ","إِن","كُنتُمۡ","تَعۡلَمُونَ"],"вакайфа ахафу ма ашрактум вала тахафууна аннакум ашрактум биллахи ма лам йуназзил бихии `алайкум султанан фа'аййул фарииḳайни ахаḳḳу бил'амни ин кунтум та`ламуун","Как я могу бояться тех, кого вы приобщаете в сотоварищи, если вы не боитесь приобщать в сотоварищи к Аллаху тех, о ком Он не ниспослал вам никакого доказательства? Какая же из двух групп имеет больше оснований чувствовать себя в безопасности, если вы только знаете?».",["И как","мне бояться","того, что","вы приобщили","и не","вы боитесь","что вы","приобщили","к Аллаху","то, что","не","Он ниспослал","на это","вам","доказательства","Так какая же","из двух сторон","более достойна","безопасности","если","вы","знаете"]]],"m":[[["۞ وَإِذۡ","и вот",6,74],["قَالَ","сказал",6,74],["إِبۡرَٰهِيمُ","Ибрахим",6,74],["لِأَبِيهِ","своему отцу",6,74],["ءَازَرَ","Азару",6,74],["أَتَتَّخِذُ","разве ты берёшь",6,74],["أَصۡنَامًا","идолов",6,74],["ءَالِهَةً","богами",6,74],["إِنِّيٓ","поистине, я",6,74]],[["أَرَىٰكَ","вижу тебя",6,74],["وَقَوۡمَكَ","и твой народ",6,74],["فِي","в",6,74],["ضَلَٰلٖ","заблуждении",6,74],["مُّبِينٖ","явном",6,74],[74],["وَكَذَٰلِكَ","И так",6,75],["نُرِيٓ","Мы показываем",6,75],["إِبۡرَٰهِيمَ","Ибрахиму",6,75]],[["مَلَكُوتَ","царство",6,75],["ٱلسَّمَٰوَٰتِ","небес",6,75],["وَٱلۡأَرۡضِ","и земли",6,75],["وَلِيَكُونَ","и чтобы он стал",6,75],["مِنَ","из",6,75],["ٱلۡمُوقِنِينَ","убеждённых",6,75],[75]],[["فَلَمَّا","И когда",6,76],["جَنَّ","покрыла",6,76],["عَلَيۡهِ","его",6,76],["ٱلَّيۡلُ","ночь",6,76],["رَءَا","он увидел",6,76],["كَوۡكَبٗاۖ","звезду",6,76],["قَالَ","он сказал",6,76],["هَٰذَا","Это",6,76],["رَبِّيۖ","мой Господь",6,76],["فَلَمَّآ","Когда же",6,76],["أَفَلَ","она закатилась",6,76],["قَالَ","он сказал",6,76]],[["لَآ","не",6,76],["أُحِبُّ","люблю я",6,76],["ٱلۡأٓفِلِينَ","закатывающихся",6,76],[76],["فَلَمَّا","И когда",6,77],["رَءَا","он увидел",6,77],["ٱلۡقَمَرَ","луну",6,77],["بَازِغٗا","восходящую",6,77],["قَالَ","он сказал",6,77],["هَٰذَا","Это",6,77]],[["رَبِّيۖ","мой Господь",6,77],["فَلَمَّآ","Когда же",6,77],["أَفَلَ","она закатилась",6,77],["قَالَ","он сказал",6,77],["لَئِن","Если",6,77],["لَّمۡ","не",6,77],["يَهۡدِنِي","наставит меня",6,77],["رَبِّي","мой Господь",6,77],["لَأَكُونَنَّ","непременно буду я",6,77],["مِنَ","из",6,77],["ٱلۡقَوۡمِ","людей",6,77]],[["ٱلضَّآلِّينَ","заблудших",6,77],[77],["فَلَمَّا","И когда",6,78],["رَءَا","он увидел",6,78],["ٱلشَّمۡسَ","солнце",6,78],["بَازِغَةٗ","восходящее",6,78],["قَالَ","он сказал",6,78],["هَٰذَا","Это",6,78],["رَبِّي","мой Господь",6,78],["هَٰذَآ","это",6,78]],[["أَكۡبَرُۖ","больше",6,78],["فَلَمَّآ","Когда же",6,78],["أَفَلَتۡ","оно зашло",6,78],["قَالَ","он сказал",6,78],["يَٰقَوۡمِ","О мой народ",6,78],["إِنِّي","Поистине, я",6,78],["بَرِيٓءٞ","непричастен",6,78],["مِّمَّا","к тому, что",6,78],["تُشۡرِكُونَ","вы приобщаете",6,78],[78]],[["إِنِّي","Поистине, я",6,79],["وَجَّهۡتُ","обратил",6,79],["وَجۡهِيَ","своё лицо",6,79],["لِلَّذِي","к Тому, Кто",6,79],["فَطَرَ","сотворил",6,79],["ٱلسَّمَٰوَٰتِ","небеса",6,79],["وَٱلۡأَرۡضَ","и землю",6,79]],[["حَنِيفٗاۖ","единобожником",6,79],["وَمَآ","и не",6,79],["أَنَا۠","я",6,79],["مِنَ","из",6,79],["ٱلۡمُشۡرِكِينَ","многобожников",6,79],[79],["وَحَآجَّهُۥ","И препирался с ним",6,80],["قَوۡمُهُۥۚ","его народ",6,80],["قَالَ","Он сказал",6,80]],[["أَتُحَٰٓجُّوٓنِّي","Неужели вы препираетесь со мной",6,80],["فِي","относительно",6,80],["ٱللَّهِ","Аллаха",6,80],["وَقَدۡ","а уже",6,80],["هَدَىٰنِۚ","Он наставил меня",6,80],["وَلَآ","И не",6,80],["أَخَافُ","боюсь я",6,80],["مَا","того, что",6,80],["تُشۡرِكُونَ","вы приобщаете",6,80],["بِهِۦٓ","к Нему",6,80]],[["إِلَّآ","разве что",6,80],["أَن","если",6,80],["يَشَآءَ","пожелает",6,80],["رَبِّي","мой Господь",6,80],["شَيۡـٔٗاۚ","чего-либо",6,80],["وَسِعَ","Объемлет",6,80],["رَبِّي","мой Господь",6,80],["كُلَّ","всякую",6,80],["شَيۡءٍ","вещь",6,80],["عِلۡمًاۚ","знанием",6,80],["أَفَلَا","Неужели не",6,80]],[["تَتَذَكَّرُونَ","вы опомнитесь",6,80],[80],["وَكَيۡفَ","И как",6,81],["أَخَافُ","мне бояться",6,81],["مَآ","того, что",6,81],["أَشۡرَكۡتُمۡ","вы приобщили",6,81],["وَلَا","и не",6,81]],[["تَخَافُونَ","вы боитесь",6,81],["أَنَّكُمۡ","что вы",6,81],["أَشۡرَكۡتُم","приобщили",6,81],["بِٱللَّهِ","к Аллаху",6,81],["مَا","то, что",6,81],["لَمۡ","не",6,81],["يُنَزِّلۡ","Он ниспослал",6,81],["بِهِۦ","на это",6,81],["عَلَيۡكُمۡ","вам",6,81]],[["سُلۡطَٰنٗاۚ","доказательства",6,81],["فَأَيُّ","Так какая же",6,81],["ٱلۡفَرِيقَيۡنِ","из двух сторон",6,81],["أَحَقُّ","более достойна",6,81],["بِٱلۡأَمۡنِۖ","безопасности",6,81],["إِن","если",6,81],["كُنتُمۡ","вы",6,81],["تَعۡلَمُونَ","знаете",6,81],[81]]]}