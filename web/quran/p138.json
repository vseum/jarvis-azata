{"p":138,"j":7,"a":[[6,82,["ٱلَّذِينَ","ءَامَنُواْ","وَلَمۡ","يَلۡبِسُوٓاْ","إِيمَٰنَهُم","بِظُلۡمٍ","أُوْلَٰٓئِكَ","لَهُمُ","ٱلۡأَمۡنُ","وَهُم","مُّهۡتَدُونَ"],"аллазиина амануу валам йалбисуу ииманахум бизулмин улаика лахумул амну вахум мухтадуун","Те, которые уверовали и не облекли свою веру в несправедливость, пребывают в безопасности, и они следуют прямым путем.",["Те, которые","уверовали","и не","облекли","свою веру","несправедливостью","те","им","безопасность","и они","следующие прямым путём"]],[6,83,["وَتِلۡكَ","حُجَّتُنَآ","ءَاتَيۡنَٰهَآ","إِبۡرَٰهِيمَ","عَلَىٰ","قَوۡمِهِۦۚ","نَرۡفَعُ","دَرَجَٰتٖ","مَّن","نَّشَآءُۗ","إِنَّ","رَبَّكَ","حَكِيمٌ","عَلِيمٞ"],"ватилка хужжатуна атайнаха ибрахиима `ала ḳаумихии нарфа`у даражатим ман нашау инна раббака хакиимун `алиим","Таковы Наши доводы, которые Мы предоставили Ибрахиму (Аврааму) против его народа. Мы возвышаем по степеням, кого пожелаем. Воистину, твой Господь - Мудрый, Знающий.",["И это","Наш довод","Мы дали его","Ибрахиму","против","его народа","Мы возвышаем","по степеням","кого","Мы пожелаем","Поистине","твой Господь","Мудрый","Знающий"]],[6,84,["وَوَهَبۡنَا","لَهُۥٓ","إِسۡحَٰقَ","وَيَعۡقُوبَۚ","كُلًّا","هَدَيۡنَاۚ","وَنُوحًا","هَدَيۡنَا","مِن","قَبۡلُۖ","وَمِن","ذُرِّيَّتِهِۦ","دَاوُۥدَ","وَسُلَيۡمَٰنَ","وَأَيُّوبَ","وَيُوسُفَ","وَمُوسَىٰ","وَهَٰرُونَۚ","وَكَذَٰلِكَ","نَجۡزِي","ٱلۡمُحۡسِنِينَ"],"вавахабна лахуу исхаḳа вайа`ḳууба куллан хадайна вануухан хадайна мин ḳаблу вамин зурриййатихии давууда васулаймана ва'аййууба вайуусуфа вамууса вахарууна ваказалика нажзил мухсиниин","Мы даровали ему Исхака (Исаака) и Йакуба (Иакова). Мы повели их обоих прямым путем. Еще раньше Мы повели прямым путем Нуха (Ноя), а из его потомства - Давуда (Давида), Сулеймана (Соломона), Айюба (Иова), Йусуфа (Иосифа), Мусу (Моисея) и Харуна (Аарона). Таким образом Мы воздаем творящим добро.",["И Мы даровали","ему","Исхака","и Йакуба","всех","Мы наставили","и Нуха","Мы наставили","ещё","раньше","и из","его потомства","Давуда","и Сулеймана","и Айюба","и Йусуфа","и Мусу","и Харуна","И так","Мы воздаём","творящим добро"]],[6,85,["وَزَكَرِيَّا","وَيَحۡيَىٰ","وَعِيسَىٰ","وَإِلۡيَاسَۖ","كُلّٞ","مِّنَ","ٱلصَّٰلِحِينَ"],"вазакариййа вайахйа ва`ииса ва'илйаса куллум минас салихиин","А также Закарию (Захарию), Йахйу (Иоанна), Ису (Иисуса) и Ильяса (Илию). Все они были из числа праведников.",["И Закарию","и Йахью","и Ису","и Ильяса","все","из","праведников"]],[6,86,["وَإِسۡمَٰعِيلَ","وَٱلۡيَسَعَ","وَيُونُسَ","وَلُوطٗاۚ","وَكُلّٗا","فَضَّلۡنَا","عَلَى","ٱلۡعَٰلَمِينَ"],"ва'исма`иила валйаса`а вайуунуса валуутан вакуллан фаддална `алал `аламиин","А также Исмаила (Измаила), Альяcу (Елисея), Йунуса (Иону) и Лута (Лота). Всех их Мы превознесли над мирами.",["И Исмаила","и Альясу","и Йунуса","и Лута","и всех","Мы превознесли","над","мирами"]],[6,87,["وَمِنۡ","ءَابَآئِهِمۡ","وَذُرِّيَّٰتِهِمۡ","وَإِخۡوَٰنِهِمۡۖ","وَٱجۡتَبَيۡنَٰهُمۡ","وَهَدَيۡنَٰهُمۡ","إِلَىٰ","صِرَٰطٖ","مُّسۡتَقِيمٖ"],"вамин абаихим вазурриййатихим ва'ихванихим важтабайнахум вахадайнахум ила сиратим мустаḳиим","А также некоторых из их отцов, потомков и братьев. Мы избрали их и повели прямым путем.",["И из","их отцов","и их потомков","и их братьев","и Мы избрали их","и Мы повели их","к","пути","прямому"]],[6,88,["ذَٰلِكَ","هُدَى","ٱللَّهِ","يَهۡدِي","بِهِۦ","مَن","يَشَآءُ","مِنۡ","عِبَادِهِۦۚ","وَلَوۡ","أَشۡرَكُواْ","لَحَبِطَ","عَنۡهُم","مَّا","كَانُواْ","يَعۡمَلُونَ"],"залика худаллахи йахдии бихии ман йашау мин `ибадихии валау ашракуу лахабита `анхум ма кануу йа`малуун","Таково руководство Аллаха, посредством которого Он ведет прямым путем тех из Своих рабов, кого пожелает. Но если бы они приобщили сотоварищей, то стало бы тщетным все, что они совершали.",["Это","руководство","Аллаха","Он ведёт","им","кого","пожелает","из","Своих рабов","А если бы","они приобщили","непременно стало бы тщетным","у них","то, что","они были","совершали"]],[6,89,["أُوْلَٰٓئِكَ","ٱلَّذِينَ","ءَاتَيۡنَٰهُمُ","ٱلۡكِتَٰبَ","وَٱلۡحُكۡمَ","وَٱلنُّبُوَّةَۚ","فَإِن","يَكۡفُرۡ","بِهَا","هَٰٓؤُلَآءِ","فَقَدۡ","وَكَّلۡنَا","بِهَا","قَوۡمٗا","لَّيۡسُواْ","بِهَا","بِكَٰفِرِينَ"],"улаикал лазиина атайнахумул китаба валхукма ваннубуввата фа'ин йакфур биха ха'улаи фаḳад ваккална биха ḳаумал лайсуу биха бикафириин","Это - те, кому Мы даровали Писание, мудрость и пророчество. И даже если они не уверуют в это, Мы уже вверили это другим людям, которые не станут неверующими.",["Те","те, кому","Мы даровали им","Писание","и мудрость","и пророчество","А если","не уверуют","в это","эти","то уже","Мы вверили","это","людям","не являющимся","в это","неверующими"]],[6,90,["أُوْلَٰٓئِكَ","ٱلَّذِينَ","هَدَى","ٱللَّهُۖ","فَبِهُدَىٰهُمُ","ٱقۡتَدِهۡۗ","قُل","لَّآ","أَسۡـَٔلُكُمۡ","عَلَيۡهِ","أَجۡرًاۖ","إِنۡ","هُوَ","إِلَّا","ذِكۡرَىٰ","لِلۡعَٰلَمِينَ"],"улаикал лазиина хадаллаху фабихудахумуḳтадих ḳул ла ас'алукум `алайхи ажран ин хуа илла зикра лил`аламиин","Это - те, кого Аллах повел прямым путем. Следуй же их прямым путем. Скажи: «Я не прошу у вас вознаграждения за него. Это не что иное, как Напоминание для миров».",["Те","те, кого","наставил","Аллах","так их прямым путём","следуй","Скажи","Не","прошу я у вас","за него","награды","Не","это","лишь","напоминание","для миров"]]],"m":[[["ٱلَّذِينَ","Те, которые",6,82],["ءَامَنُواْ","уверовали",6,82],["وَلَمۡ","и не",6,82],["يَلۡبِسُوٓاْ","облекли",6,82],["إِيمَٰنَهُم","свою веру",6,82],["بِظُلۡمٍ","несправедливостью",6,82],["أُوْلَٰٓئِكَ","те",6,82],["لَهُمُ","им",6,82],["ٱلۡأَمۡنُ","безопасность",6,82]],[["وَهُم","и они",6,82],["مُّهۡتَدُونَ","следующие прямым путём",6,82],[82],["وَتِلۡكَ","И это",6,83],["حُجَّتُنَآ","Наш довод",6,83],["ءَاتَيۡنَٰهَآ","Мы дали его",6,83],["إِبۡرَٰهِيمَ","Ибрахиму",6,83],["عَلَىٰ","против",6,83]],[["قَوۡمِهِۦۚ","его народа",6,83],["نَرۡفَعُ","Мы возвышаем",6,83],["دَرَجَٰتٖ","по степеням",6,83],["مَّن","кого",6,83],["نَّشَآءُۗ","Мы пожелаем",6,83],["إِنَّ","Поистине",6,83],["رَبَّكَ","твой Господь",6,83],["حَكِيمٌ","Мудрый",6,83],["عَلِيمٞ","Знающий",6,83],[83]],[["