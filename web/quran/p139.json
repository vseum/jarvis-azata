,93],["إِلَيۡهِ","ему",6,93],["شَيۡءٞ","ничего",6,93],["وَمَن","и того, кто",6,93],["قَالَ","сказал",6,93],["سَأُنزِلُ","Я ниспошлю",6,93]],[["مِثۡلَ","подобное",6,93],["مَآ","тому, что",6,93],["أَنزَلَ","ниспослал",6,93],["ٱللَّهُۗ","Аллах",6,93],["وَلَوۡ","И если бы",6,93],["تَرَىٰٓ","ты видел",6,93],["إِذِ","когда",6,93],["ٱلظَّٰلِمُونَ","беззаконники",6,93],["فِي","в",6,93],["غَمَرَٰتِ","агонии",6,93],["ٱلۡمَوۡتِ","смерти",6,93]],[["وَٱلۡمَلَٰٓئِكَةُ","а ангелы",6,93],["بَاسِطُوٓاْ","простирают",6,93],["أَيۡدِيهِمۡ","свои руки",6,93],["أَخۡرِجُوٓاْ","Выведите",6,93],["أَنفُسَكُمُۖ","свои души",6,93],["ٱلۡيَوۡمَ","Сегодня",6,93]],[["تُجۡزَوۡنَ","вам будет воздано",6,93],["عَذَابَ","наказанием",6,93],["ٱلۡهُونِ","унизительным",6,93],["بِمَا","за то, что",6,93],["كُنتُمۡ","вы были",6,93],["تَقُولُونَ","говорили",6,93],["عَلَى","об",6,93],["ٱللَّهِ","Аллахе",6,93],["غَيۡرَ","иное, чем",6,93],["ٱلۡحَقِّ","истина",6,93]],[["وَكُنتُمۡ","и вы были",6,93],["عَنۡ","от",6,93],["ءَايَٰتِهِۦ","Его знамений",6,93],["تَسۡتَكۡبِرُونَ","превозносились",6,93],[93],["وَلَقَدۡ","И ведь уже",6,94],["جِئۡتُمُونَا","вы пришли к Нам",6,94],["فُرَٰدَىٰ","поодиночке",6,94]],[["كَمَا","как",6,94],["خَلَقۡنَٰكُمۡ","Мы сотворили вас",6,94],["أَوَّلَ","в первый",6,94],["مَرَّةٖ","раз",6,94],["وَتَرَكۡتُم","и вы оставили",6,94],["مَّا","то, что",6,94],["خَوَّلۡنَٰكُمۡ","Мы даровали вам",6,94],["وَرَآءَ","позади",6,94],["ظُهُورِكُمۡۖ","ваших спин",6,94]],[["وَمَا","И не",6,94],["نَرَىٰ","видим Мы",6,94],["مَعَكُمۡ","с вами",6,94],["شُفَعَآءَكُمُ","ваших заступников",6,94],["ٱلَّذِينَ","тех, которых",6,94],["زَعَمۡتُمۡ","вы утверждали",6,94],["أَنَّهُمۡ","что они",6,94],["فِيكُمۡ","у вас",6,94],["شُرَكَٰٓؤُاْۚ","сотоварищи",6,94]],[["لَقَد","Уже",6,94],["تَّقَطَّعَ","разорвано",6,94],["بَيۡنَكُمۡ","между вами",6,94],["وَضَلَّ","и исчезло",6,94],["عَنكُم","от вас",6,94],["مَّا","то, что",6,94],["كُنتُمۡ","вы были",6,94],["تَزۡعُمُونَ","утверждали",6,94],[94]]]}