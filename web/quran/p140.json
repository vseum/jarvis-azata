{"p":140,"j":7,"a":[[6,95,["إِنَّ","ٱللَّهَ","فَالِقُ","ٱلۡحَبِّ","وَٱلنَّوَىٰۖ","يُخۡرِجُ","ٱلۡحَيَّ","مِنَ","ٱلۡمَيِّتِ","وَمُخۡرِجُ","ٱلۡمَيِّتِ","مِنَ","ٱلۡحَيِّۚ","ذَٰلِكُمُ","ٱللَّهُۖ","فَأَنَّىٰ","تُؤۡفَكُونَ"],"инналлаха фалиḳул хабби ваннава йухрижул хаййа минал маййити вамухрижул маййити минал хаййи заликумуллаху фа'анна ту'факуун","Аллах раскрывает зерно и косточку. Он извлекает живое из мертвого и извлекает мертвое из живого. Таков Аллах! До чего же вы отвращены от истины!",["Поистине","Аллах","раскалывающий","зерно","и косточку","Он выводит","живое","из","мёртвого","и выводящий","мёртвое","из","живого","Таков","Аллах","так куда же","вы отвращены"]],[6,96,["فَالِقُ","ٱلۡإِصۡبَاحِ","وَجَعَلَ","ٱلَّيۡلَ","سَكَنٗا","وَٱلشَّمۡسَ","وَٱلۡقَمَرَ","حُسۡبَانٗاۚ","ذَٰلِكَ","تَقۡدِيرُ","ٱلۡعَزِيزِ","ٱلۡعَلِيمِ"],"фалиḳул исбахи важа`алал лайла саканан вашшамса валḳамара хусбанан залика таḳдиирул `азиизил `алиим","Он раскрывает утреннюю зарю. Он предназначил ночь для покоя, а солнце и луну - для исчисления. Таково установление Могущественного, Знающего.",["Раскалывающий","утреннюю зарю","и Он сделал","ночь","покоем","и солнце","и луну","для исчисления","Это","установление","Могущественного","Знающего"]],[6,97,["وَهُوَ","ٱلَّذِي","جَعَلَ","لَكُمُ","ٱلنُّجُومَ","لِتَهۡتَدُواْ","بِهَا","فِي","ظُلُمَٰتِ","ٱلۡبَرِّ","وَٱلۡبَحۡرِۗ","قَدۡ","فَصَّلۡنَا","ٱلۡأٓيَٰتِ","لِقَوۡمٖ","يَعۡلَمُونَ"],"вахуал лазии жа`ала лакумун нужуума литахтадуу биха фии зулуматил барри валбахри ḳад фассалнал айати лиḳаумин йа`ламуун","Он - Тот, Кто сотворил для вас звезды, чтобы вы находили по ним путь во мраках суши и моря. Мы уже разъяснили знамения для людей знающих.",["И Он","Тот, Кто","сделал","для вас","звёзды","чтобы вы находили путь","по ним","во","мраках","суши","и моря","Уже","Мы разъяснили","знамения","для людей","которые знают"]],[6,98,["وَهُوَ","ٱلَّذِيٓ","أَنشَأَكُم","مِّن","نَّفۡسٖ","وَٰحِدَةٖ","فَمُسۡتَقَرّٞ","وَمُسۡتَوۡدَعٞۗ","قَدۡ","فَصَّلۡنَا","ٱلۡأٓيَٰتِ","لِقَوۡمٖ","يَفۡقَهُونَ"],"вахуал лазии аншаакум мин нафсин вахидатин фамустаḳаррун вамустауда`ун ḳад фассалнал айати лиḳаумин йафḳахуун","Он - Тот, Кто сотворил вас из одной души. Для вас есть место пребывания (на земле или в утробах матерей) и место хранения (в могилах или чреслах отцов). Мы уже разъяснили знамения для людей понимающих.",["И Он","Тот, Кто","создал вас","из","души","одной","и место пребывания","и место хранения","Уже","Мы разъяснили","знамения","для людей","которые понимают"]],[6,99,["وَهُوَ","ٱلَّذِيٓ","أَنزَلَ","مِنَ","ٱلسَّمَآءِ","مَآءٗ","فَأَخۡرَجۡنَا","بِهِۦ","نَبَاتَ","كُلِّ","شَيۡءٖ","فَأَخۡرَجۡنَا","مِنۡهُ","خَضِرٗا","نُّخۡرِجُ","مِنۡهُ","حَبّٗا","مُّتَرَاكِبٗا","وَمِنَ","ٱلنَّخۡلِ","مِن","طَلۡعِهَا","قِنۡوَانٞ","دَانِيَةٞ","وَجَنَّٰتٖ","مِّنۡ","أَعۡنَابٖ","وَٱلزَّيۡتُونَ","وَٱلرُّمَّانَ","مُشۡتَبِهٗا","وَغَيۡرَ","مُتَشَٰبِهٍۗ","ٱنظُرُوٓاْ","إِلَىٰ","ثَمَرِهِۦٓ","إِذَآ","أَثۡمَرَ","وَيَنۡعِهِۦٓۚ","إِنَّ","فِي","ذَٰلِكُمۡ","لَأٓيَٰتٖ","لِّقَوۡمٖ","يُؤۡمِنُونَ"],"вахуал лазии анзала минас самаи маан фа'ахражна бихии набата кулли шай'ин фа'ахражна минху хадиран нухрижу минху хаббам мутаракибан ваминан нахли мин тал`иха ḳинванун данийатун важаннатим мин а`набин ваззайтууна варруммана муштабихан вагайра муташабихининзуруу ила самарихии иза асмара вайан`ихии инна фии заликум ла'айатил лиḳаумин йу'минуун","Он - Тот, Кто ниспослал с неба воду. Посредством нее Мы взрастили растения всех видов. Мы выводим из них зеленые травы, а из них - расположенные одно на другом зерна. На финиковых пальмах из завязей вырастают свисающие низко гроздья. Мы взращиваем виноградники, оливки и гранаты, которые имеют сходства и различия. Взгляните на их плоды, когда они появляются и когда созревают. Воистину, в этом - знамения для людей верующих.",["И Он","Тот, Кто","ниспослал","с","неба","воду","и Мы вывели","ею","ростки","всякой","вещи","и Мы вывели","из них","зелень","Мы выводим","из неё","зёрна","громоздящиеся","И из","пальм","из","их завязей","гроздья","низко свисающие","и сады","из","винограда","и маслины","и гранаты","схожие","и не","схожие","Взгляните","на","его плоды","когда","он плодоносит","и его созревание","Поистине","в","этом","непременно знамения","для людей","которые веруют"]],[6,100,["وَجَعَلُواْ","لِلَّهِ","شُرَكَآءَ","ٱلۡجِنَّ","وَخَلَقَهُمۡۖ","وَخَرَقُواْ","لَهُۥ","بَنِينَ","وَبَنَٰتِۭ","بِغَيۡرِ","عِلۡمٖۚ","سُبۡحَٰنَهُۥ","وَتَعَٰلَىٰ","عَمَّا","يَصِفُونَ"],"важа`алуу лиллахи шуракаал жинна вахалаḳахум вахараḳуу лахуу баниина вабанати бигайри `илмин субханахуу вата`ала `амма йасифуун","Они приобщили к Аллаху в сотоварищи джиннов, а ведь Он создал их. Они выдумали для Него сыновей и дочерей, не имея об этом никакого знания. Пречист Он и превыше всего, что они приписывают Ему.",["И они сделали","Аллаху","сотоварищами","джиннов","а Он сотворил их","и они выдумали","Ему","сыновей","и дочерей","без","знания","Пречист Он","и превыше","того, что","они приписывают"]],[6,101,["بَدِيعُ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِۖ","أَنَّىٰ","يَكُونُ","لَهُۥ","وَلَدٞ","وَلَمۡ","تَكُن","لَّهُۥ","صَٰحِبَةٞۖ","وَخَلَقَ","كُلَّ","شَيۡءٖۖ","وَهُوَ","بِكُلِّ","شَيۡءٍ","عَلِيمٞ"],"бадии`ус самавати вал'арди анна йакууну лахуу валадун валам такул лахуу сахибатун вахалаḳа кулла шай'ин вахуа бикулли шай'ин `алиим","Он - Созидатель небес и земли. Как может быть у Него сын, если у Него нет супруги? Он сотворил всякую вещь и ведает обо всем сущем.",["Создатель","небес","и земли","Как","может быть","у Него","сын","если не","было","у Него","супруги","и Он сотворил","всякую","вещь","и Он","о всякой","вещи","Знающий"]]],"m":[[["۞ إِنَّ","Поистине",6,95],["ٱللَّهَ","Аллах",6,95],["فَالِقُ","раскалывающий",6,95],["ٱلۡحَبِّ","зерно",6,95],["وَٱلنَّوَىٰۖ","и косточку",6,95],["يُخۡرِجُ","Он выводит",6,95],["ٱلۡحَيَّ","живое",6,95],["مِنَ","из",6,95],["ٱلۡمَيِّتِ","мёртвого",6,95],["وَمُخۡرِجُ","и выводящий",6,95]],[["ٱلۡمَيِّتِ","мёртвое",6,95],["مِنَ","из",6,95],["ٱلۡحَيِّۚ","живого",6,95],["ذَٰلِكُمُ","Таков",6,95],["ٱللَّهُۖ","Аллах",6,95],["فَأَنَّىٰ","так куда же",6,95