{"p":141,"j":7,"a":[[6,102,["ذَٰلِكُمُ","ٱللَّهُ","رَبُّكُمۡۖ","لَآ","إِلَٰهَ","إِلَّا","هُوَۖ","خَٰلِقُ","كُلِّ","شَيۡءٖ","فَٱعۡبُدُوهُۚ","وَهُوَ","عَلَىٰ","كُلِّ","شَيۡءٖ","وَكِيلٞ"],"заликумуллаху раббукум ла илаха илла хуа халиḳу кулли шай'ин фа`будууху вахуа `ала кулли шай'ин вакиил","Таков Аллах, ваш Господь. Нет божества, кроме Него, Творца всякой вещи. Поклоняйтесь же Ему! Он является Попечителем и Хранителем всякой вещи.",["Таков","Аллах","ваш Господь","нет","божества","кроме","Него","Творец","всякой","вещи","так поклоняйтесь Ему","и Он","над","всякой","вещью","Попечитель"]],[6,103,["لَّا","تُدۡرِكُهُ","ٱلۡأَبۡصَٰرُ","وَهُوَ","يُدۡرِكُ","ٱلۡأَبۡصَٰرَۖ","وَهُوَ","ٱللَّطِيفُ","ٱلۡخَبِيرُ"],"лла тудрикухул абсару вахуа йудрикул абсара вахуал латиифул хабиир","Взоры не могут постичь Его, а Он постигает взоры. Он - Проницательный (или Добрый), Сведущий.",["Не","постигают Его","взоры","а Он","постигает","взоры","и Он","Проницательный","Сведущий"]],[6,104,["قَدۡ","جَآءَكُم","بَصَآئِرُ","مِن","رَّبِّكُمۡۖ","فَمَنۡ","أَبۡصَرَ","فَلِنَفۡسِهِۦۖ","وَمَنۡ","عَمِيَ","فَعَلَيۡهَاۚ","وَمَآ","أَنَا۠","عَلَيۡكُم","بِحَفِيظٖ"],"ḳад жаакум басаиру мир раббикум фаман абсара фалинафсихии ваман `амийа фа`алайха вама ана `алайкум бихафииз","Скажи: «К вам уже явились наглядные знамения от вашего Господа. Кто узрел, тот поступил во благо себе, а кто был слепым, тот навредил себе. Я не являюсь вашим хранителем».",["Уже","пришли к вам","наглядные знамения","от","вашего Господа","И кто","прозрел","то для своей души","а кто","ослеп","то во вред ей","И не","я","над вами","хранитель"]],[6,105,["وَكَذَٰلِكَ","نُصَرِّفُ","ٱلۡأٓيَٰتِ","وَلِيَقُولُواْ","دَرَسۡتَ","وَلِنُبَيِّنَهُۥ","لِقَوۡمٖ","يَعۡلَمُونَ"],"ваказалика нусаррифул айати валийаḳуулуу дараста валинубаййинахуу лиḳаумин йа`ламуун","Вот так Мы излагаем различным образом аяты, чтобы они сказали: «Ты обучился этому!». - и чтобы Мы разъяснили его людям знающим.",["И так","Мы разнообразно излагаем","знамения","и чтобы они сказали","ты изучал","и чтобы Мы разъяснили его","для людей","которые знают"]],[6,106,["ٱتَّبِعۡ","مَآ","أُوحِيَ","إِلَيۡكَ","مِن","رَّبِّكَۖ","لَآ","إِلَٰهَ","إِلَّا","هُوَۖ","وَأَعۡرِضۡ","عَنِ","ٱلۡمُشۡرِكِينَ"],"иттаби` ма уухийа илайка мир раббика ла илаха илла хуа ва'а`рид `анил мушрикиин","Следуй тому, что дано тебе в откровении от твоего Господа. Нет божества, кроме Него. И отвернись от многобожников.",["Следуй","тому, что","внушено","тебе","от","твоего Господа","нет","божества","кроме","Него","и отвернись","от","многобожников"]],[6,107,["وَلَوۡ","شَآءَ","ٱللَّهُ","مَآ","أَشۡرَكُواْۗ","وَمَا","جَعَلۡنَٰكَ","عَلَيۡهِمۡ","حَفِيظٗاۖ","وَمَآ","أَنتَ","عَلَيۡهِم","بِوَكِيلٖ"],"валау шааллаху ма ашракуу вама жа`алнака `алайхим хафиизан вама анта `алайхим бивакиил","Если бы Аллах пожелал, то они не приобщали бы сотоварищей. Мы не назначили тебя их хранителем, и ты не являешься их попечителем.",["И если бы","пожелал","Аллах","не","приобщали бы они","И не","Мы сделали тебя","над ними","хранителем","и не","ты","над ними","попечитель"]],[6,108,["وَلَا","تَسُبُّواْ","ٱلَّذِينَ","يَدۡعُونَ","مِن","دُونِ","ٱللَّهِ","فَيَسُبُّواْ","ٱللَّهَ","عَدۡوَۢا","بِغَيۡرِ","عِلۡمٖۗ","كَذَٰلِكَ","زَيَّنَّا","لِكُلِّ","أُمَّةٍ","عَمَلَهُمۡ","ثُمَّ","إِلَىٰ","رَبِّهِم","مَّرۡجِعُهُمۡ","فَيُنَبِّئُهُم","بِمَا","كَانُواْ","يَعۡمَلُونَ"],"вала тасуббул лазиина йад`ууна мин дууниллахи файасуббуллаха `адва бигайри `илмин казалика заййанна ликулли умматин `амалахум сумма ила раббихим маржи`ухум файунаббиухум бима кануу йа`малуун","Не оскорбляйте тех, к кому они взывают помимо Аллаха, а не то они станут оскорблять Аллаха из враждебности и по невежеству. Так Мы приукрасили для каждого народа их деяния. Потом им предстоит вернуться к своему Господу, и Он поведает им о том, что они совершали.",["И не","оскорбляйте","тех, которых","они призывают","из","помимо","Аллаха","а то они оскорбят","Аллаха","по вражде","без","знания","Так","Мы украсили","для каждой","общины","их деяние","Затем","к","их Господу","их возвращение","и Он сообщит им","о том, что","они были","совершали"]],[6,109,["وَأَقۡسَمُواْ","بِٱللَّهِ","جَهۡدَ","أَيۡمَٰنِهِمۡ","لَئِن","جَآءَتۡهُمۡ","ءَايَةٞ","لَّيُؤۡمِنُنَّ","بِهَاۚ","قُلۡ","إِنَّمَا","ٱلۡأٓيَٰتُ","عِندَ","ٱللَّهِۖ","وَمَا","يُشۡعِرُكُمۡ","أَنَّهَآ","إِذَا","جَآءَتۡ","لَا","يُؤۡمِنُونَ"],"ва'аḳсамуу биллахи жахда айманихим ла'ин жаатхум айатул лайу'минунна биха ḳул иннамал айату `индаллахи вама йуш`ирукум аннаха иза жаат ла йу'минуун","Именем Аллаха они принесли величайшие клятвы о том, что если к ним явится знамение, они непременно уверуют в него. Скажи: «Знамения находятся у Аллаха. И откуда вам знать, что они не уверуют, если даже оно придет к ним?».",["И они поклялись","Аллахом","сильнейшими","из своих клятв","что если","придёт к ним","знамение","непременно уверуют они","в него","Скажи","Только лишь","знамения","у","Аллаха","И что","даст вам знать","что оно","когда","придёт","не","уверуют они"]],[6,110,["وَنُقَلِّبُ","أَفۡـِٔدَتَهُمۡ","وَأَبۡصَٰرَهُمۡ","كَمَا","لَمۡ","يُؤۡمِنُواْ","بِهِۦٓ","أَوَّلَ","مَرَّةٖ","وَنَذَرُهُمۡ","فِي","طُغۡيَٰنِهِمۡ","يَعۡمَهُونَ"],"вануḳаллибу аф'идатахум ва'абсарахум кама лам йу'минуу бихии аввала марратин ваназарухум фии тугйанихим йа`махуун","Мы отворачиваем их сердца и умы, поскольку они не уверовали в него в первый раз, и оставляем их скитаться вслепую в собственном беззаконии.",["И Мы переворачиваем","их сердца","и их взоры","как","не","уверовали они","в него","в первый","раз","и Мы оставляем их","в","их беззаконии","блуждающими вслепую"]]],"m":[[["ذَٰلِكُمُ","Таков",6,102],["ٱللَّهُ","Аллах",6,102],["رَبُّكُمۡۖ","ваш Господь",6,102],["لَآ","нет",6,102],["إِلَٰهَ","божества",6,102],["إِلَّا","кроме",6,102],["هُوَۖ","Него",6,102],["خَٰلِقُ","Творец",6,102],["كُلِّ","всякой",6,102],["شَيۡءٖ","вещи",6,102]],[["فَٱعۡبُدُوهُۚ","так поклоняйтесь Ему",6,102],["وَهُوَ","и Он",6,102],["عَلَىٰ","над",6,102],["كُلِّ","всякой",6,102],["شَيۡءٖ","вещью",6,102],["وَكِيلٞ","Попечитель",6,102],[102],["لَّا","Не",6,103],["تُدۡرِكُهُ","постигают Его",6,103]],[["ٱلۡأَبۡصَٰرُ","взоры",6,103],["وَهُوَ","а Он",6,103],["يُدۡرِكُ","постигает",6,103],["ٱلۡأَبۡصَٰرَۖ","взоры",6,103],["وَهُوَ","и Он",6,103],["ٱللَّطِيفُ","Проницательный",6,103],["ٱلۡخَبِيرُ","Сведущий",6,103],[103]],[["قَدۡ","Уже",6,104],["جَآءَكُم","пришли к вам",6,104],["بَصَآئِرُ","наглядные знамения",6,104],["مِن","от",6,104],["رَّبِّكُمۡۖ","вашего Господа",6,104],["فَمَنۡ","И кто",6,104],["أَبۡصَرَ","прозрел",6,104],["فَلِنَفۡسِهِۦۖ","то для своей души",6,104],["وَمَنۡ","а кто",6,104],["عَمِيَ","ослеп",6,104]],[["فَعَلَيۡهَاۚ","то во вред ей",6,104],["وَمَآ","И не",6,104],["أَنَا۠","я",6,104],["عَلَيۡكُم","над вами",6,104],["بِحَفِيظٖ","хранитель",6,104],[104],["وَكَذَٰلِكَ","И так",6,105],["نُصَرِّفُ","Мы разнообразно излагаем",6,105]],[["ٱلۡأٓيَٰتِ","знамения",6,105],["وَلِيَقُولُواْ","и чтобы они сказали",6,105],["دَرَسۡتَ","ты изучал",6,105],["وَلِنُبَيِّنَهُۥ","и чтобы Мы разъяснили его",6,105],["لِقَوۡمٖ","для людей",6,105],["يَعۡلَمُونَ","которые знают",6,105],[105]],[["ٱتَّبِعۡ","Следуй",6,106],["مَآ","тому, что",6,106],["أُوحِيَ","внушено",6,106],["إِلَيۡكَ","тебе",6,106],["مِن","от",6,106],["رَّبِّكَۖ","твоего Господа",6,106],["لَآ","нет",6,106],["إِلَٰهَ","божества",6,106],["إِلَّا","кроме",6,106],["هُوَۖ","Него",6,106],["وَأَعۡرِضۡ","и отвернись",6,106],["عَنِ","от",6,106]],[["ٱلۡمُشۡرِكِينَ","многобожников",6,106],[106],["وَلَوۡ","И если бы",6,107],["شَآءَ","пожелал",6,107],["ٱللَّهُ","Аллах",6,107],["مَآ","не",6,107],["أَشۡرَكُواْۗ","приобщали бы они",6,107],["وَمَا","И не",6,107],["جَعَلۡنَٰكَ","Мы сделали тебя",6,107],["عَلَيۡهِمۡ","над ними",6,107]],[["حَفِيظٗاۖ","хранителем",6,107],["وَمَآ","и не",6,107],["أَنتَ","ты",6,107],["عَلَيۡهِم","над ними",6,107],["بِوَكِيلٖ","попечитель",6,107],[107],["وَلَا","И не",6,108],["تَسُبُّواْ","оскорбляйте",6,108],["ٱلَّذِينَ","тех, которых",6,108]],[["يَدۡعُونَ","они призывают",6,108],["مِن","из",6,108],["دُونِ","помимо",6,108],["ٱللَّهِ","Аллаха",6,1