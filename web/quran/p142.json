{"p":142,"j":8,"a":[[6,111,["وَلَوۡ","أَنَّنَا","نَزَّلۡنَآ","إِلَيۡهِمُ","ٱلۡمَلَٰٓئِكَةَ","وَكَلَّمَهُمُ","ٱلۡمَوۡتَىٰ","وَحَشَرۡنَا","عَلَيۡهِمۡ","كُلَّ","شَيۡءٖ","قُبُلٗا","مَّا","كَانُواْ","لِيُؤۡمِنُوٓاْ","إِلَّآ","أَن","يَشَآءَ","ٱللَّهُ","وَلَٰكِنَّ","أَكۡثَرَهُمۡ","يَجۡهَلُونَ"],"валау аннана наззална илайхимул малаиката вакалламахумул маута вахашарна `алайхим кулла шай'ин ḳубулам ма кануу лийу'минуу илла ан йашааллаху валакинна аксарахум йажхалуун","Даже если бы Мы ниспослали им ангелов, и мертвые заговорили бы с ними, и Мы собрали бы перед ними все сущее, они ни за что не уверовали бы, если бы только этого не пожелал Аллах. Однако большинство их не ведает об этом.",["И если бы","что Мы","ниспослали","им","ангелов","и заговорили с ними","мёртвые","и Мы собрали","перед ними","всякую","вещь","воочию","не","были они","чтобы уверовать","кроме","как","пожелает","Аллах","Однако","большинство их","невежественны"]],[6,112,["وَكَذَٰلِكَ","جَعَلۡنَا","لِكُلِّ","نَبِيٍّ","عَدُوّٗا","شَيَٰطِينَ","ٱلۡإِنسِ","وَٱلۡجِنِّ","يُوحِي","بَعۡضُهُمۡ","إِلَىٰ","بَعۡضٖ","زُخۡرُفَ","ٱلۡقَوۡلِ","غُرُورٗاۚ","وَلَوۡ","شَآءَ","رَبُّكَ","مَا","فَعَلُوهُۖ","فَذَرۡهُمۡ","وَمَا","يَفۡتَرُونَ"],"ваказалика жа`ална ликулли набиййин `адувван шайатиинал инси валжинни йуухии ба`духум ила ба`дин зухруфал ḳаули гурууран валау шаа раббука ма фа`алууху фазархум вама йафтаруун","Так Мы определили для каждого пророка врагов - дьяволов из числа людей и джиннов, внушающих друг другу красивые слова обольщения. Если бы твой Господь пожелал, они не поступали бы так. Оставь же их вместе с их измышлениями.",["И так","Мы сделали","для каждого","пророка","врага","дьяволов","из людей","и джиннов","внушают","одни из них","к","другим","украшенные","слова","для обольщения","И если бы","пожелал","твой Господь","не","сделали бы они это","Так оставь их","и то, что","они измышляют"]],[6,113,["وَلِتَصۡغَىٰٓ","إِلَيۡهِ","أَفۡـِٔدَةُ","ٱلَّذِينَ","لَا","يُؤۡمِنُونَ","بِٱلۡأٓخِرَةِ","وَلِيَرۡضَوۡهُ","وَلِيَقۡتَرِفُواْ","مَا","هُم","مُّقۡتَرِفُونَ"],"валитасга илайхи аф'идатул лазиина ла йу'минууна бил'ахирати валийардауху валийаḳтарифуу ма хум муḳтарифуун","Мы сделали так, чтобы к этим словам склонялись сердца тех, которые не верят в Последнюю жизнь, и чтобы они довольствовались ими и совершали то, что они совершают.",["И чтобы склонялись","к нему","сердца","тех, которые","не","веруют","в Последнюю жизнь","и чтобы они довольствовались им","и чтобы они совершали","то, что","они","совершают"]],[6,114,["أَفَغَيۡرَ","ٱللَّهِ","أَبۡتَغِي","حَكَمٗا","وَهُوَ","ٱلَّذِيٓ","أَنزَلَ","إِلَيۡكُمُ","ٱلۡكِتَٰبَ","مُفَصَّلٗاۚ","وَٱلَّذِينَ","ءَاتَيۡنَٰهُمُ","ٱلۡكِتَٰبَ","يَعۡلَمُونَ","أَنَّهُۥ","مُنَزَّلٞ","مِّن","رَّبِّكَ","بِٱلۡحَقِّۖ","فَلَا","تَكُونَنَّ","مِنَ","ٱلۡمُمۡتَرِينَ"],"афагайраллахи абтагии хакаман вахуал лазии анзала илайкумул китаба муфассалан валлазиина атайнахумул китаба йа`ламууна аннахуу муназзалум мир раббика билхаḳḳи фала такуунанна минал мумтариин","Скажи: «Неужели я пожелаю иного судью, помимо Аллаха, в то время как Он ниспослал вам Писание, подробно разъяснив его?». Те, кому Мы даровали Писание, знают, что оно ниспослано от твоего Господа с истиной. Посему не будь в числе тех, кто сомневается.",["Неужели помимо","Аллаха","я буду искать","судью","тогда как Он","Тот, Кто","ниспослал","вам","Писание","разъяснённым","И те, которым","Мы даровали им","Писание","знают","что оно","ниспослано","от","твоего Господа","с истиной","так не","будь же","из","сомневающихся"]],[6,115,["وَتَمَّتۡ","كَلِمَتُ","رَبِّكَ","صِدۡقٗا","وَعَدۡلٗاۚ","لَّا","مُبَدِّلَ","لِكَلِمَٰتِهِۦۚ","وَهُوَ","ٱلسَّمِيعُ","ٱلۡعَلِيمُ"],"ватаммат калимату раббика сидḳан ва`адлал ла мубаддила ликалиматихии вахуас самии`ул `алиим","Слово твоего Господа исполнилось правдиво и справедливо! Никто не изменит Его Слов. Он - Слышащий, Знающий.",["И исполнилось","слово","твоего Господа","правдиво","и справедливо","нет","изменяющего","Его слова","и Он","Слышащий","Знающий"]],[6,116,["وَإِن","تُطِعۡ","أَكۡثَرَ","مَن","فِي","ٱلۡأَرۡضِ","يُضِلُّوكَ","عَن","سَبِيلِ","ٱللَّهِۚ","إِن","يَتَّبِعُونَ","إِلَّا","ٱلظَّنَّ","وَإِنۡ","هُمۡ","إِلَّا","يَخۡرُصُونَ"],"ва'ин тути` аксара ман фил арди йудиллуука `ан сабиилиллахи ин йаттаби`ууна иллаз занна ва'ин хум илла йахрусуун","Если ты станешь повиноваться большинству тех, кто на земле, они собьют тебя с пути Аллаха. Они следуют лишь предположениям и только измышляют.",["И если","ты подчинишься","большинству","тех, кто","на","земле","они собьют тебя","с","пути","Аллаха","Не","следуют они","кроме","предположения","и не","они","кроме","измышляют"]],[6,117,["إِنَّ","رَبَّكَ","هُوَ","أَعۡلَمُ","مَن","يَضِلُّ","عَن","سَبِيلِهِۦۖ","وَهُوَ","أَعۡلَمُ","بِٱلۡمُهۡتَدِينَ"],"инна раббака хуа а`ламу ман йадиллу `ан сабиилихии вахуа а`ламу билмухтадиин","Воистину, твоему Господу лучше знать, кто сбивается с Его пути. Ему также лучше знать, кто следует прямым путем.",["Поистине","твой Господь","Он","лучше знает","кто","сбивается","с","Его пути","и Он","лучше знает","следующих прямым путём"]],[6,118,["فَكُلُواْ","مِمَّا","ذُكِرَ","ٱسۡمُ","ٱللَّهِ","عَلَيۡهِ","إِن","كُنتُم","بِـَٔايَٰتِهِۦ","مُؤۡمِنِينَ"],"факулуу мимма зукирасмуллахи `алайхи ин кунтум би'айатихии му'миниин","Ешьте же из того, над чем произнесено имя Аллаха, если вы веруете в Его знамения.",["Ешьте же","из того, что","упомянуто","имя","Аллаха","над ним","если","вы","в Его знамения","верующие"]]],"m":[[["۞ وَلَوۡ","И если бы",6,111],["أَنَّنَا","что Мы",6,111],["نَزَّلۡنَآ","ниспослали",6,111],["إِلَيۡهِمُ","им",6,111],["ٱلۡمَلَٰٓئِكَةَ","ангелов",6,111],["وَكَلَّمَهُمُ","и заговорили с ними",6,111],["ٱلۡمَوۡتَىٰ","мёртвые",6,111],["وَحَشَرۡنَا","и Мы собрали",6,111]],[["عَلَيۡهِمۡ","перед ними",6,111],["كُلَّ","всякую",6,111],["شَيۡءٖ","вещь",6,111],["قُبُلٗا","воочию",6,111],["مَّا","не",6,111],["كَانُواْ","были они",6,111],["لِيُؤۡمِنُوٓاْ","чтобы уверовать",6,111],["إِلَّآ","кроме",6,111],["أَن","как",6,111],["يَشَآءَ","пожелает",6,111],["ٱللَّهُ","Аллах",6,111],["وَلَٰكِنَّ","Однако",6,111]],[["أَكۡثَرَهُمۡ","большинство их",6,111],["يَجۡهَلُونَ","невежественны",6,111],[111],["وَكَذَٰلِكَ","И так",6,112],["جَعَلۡنَا","Мы сделали",6,112],["لِكُلِّ","для каждого",6,112],["نَبِيٍّ","пророка",6,112],["عَدُوّٗا","врага",6,112]],[["شَيَٰطِينَ","дьяволов",6,112],["ٱلۡإِنسِ","из людей",6,112],["وَٱلۡجِنِّ","и джиннов",6,112],["يُوحِي","внушают",6,112],["بَعۡضُهُمۡ","одни из них",6,112],["إِلَىٰ","к",6,112],["بَعۡضٖ","другим",6,112],["زُخۡرُفَ","украшенные",6,112]],[["ٱلۡقَوۡلِ","слова",6,112],["غُرُورٗاۚ","для обольщения",6,112],["وَلَوۡ","И если бы",6,112],["شَآءَ","пожелал",6,112],["رَبُّكَ","твой Господь",6,112],["مَا","не",6,112],["فَعَلُوهُۖ","сделали бы они это",6,112],["فَذَرۡهُمۡ","Так оставь их",6,112],["وَمَا","и то, что",6,112],["يَفۡتَرُونَ","они измышляют",6,112]],[[112],["وَلِتَصۡغَىٰٓ","И чтобы склонялись",6,113],["إِلَيۡهِ","к нему",6,113],["أَفۡـِٔدَةُ","сердца",6,113],["ٱلَّذِينَ","тех, которые",6,113],["لَا","не",6,113],["يُؤۡمِنُونَ","веруют",6,113],["بِٱلۡأٓخِرَةِ","в Последнюю жизнь",6,113]],[["وَلِيَرۡضَوۡهُ","и чтобы они довольствовались им",6,113],["وَلِيَقۡتَرِفُواْ","и чтобы они совершали",6,113],["مَا","то, что",6,113],["هُم","они",6,113],["مُّقۡتَرِفُونَ","совершают",6,113],[113],["أَفَغَيۡرَ","Неужели помимо",6,114],["ٱللَّهِ","Аллаха",6,114]],[["أَبۡتَغِي","я буду искать",6,114],["حَكَمٗا","судью",6,114],["وَهُوَ","тогда как Он",6,114],["ٱلَّذِيٓ","Тот, Кто",6,114],["أَنزَلَ","ниспослал",6,114],["إِلَيۡكُمُ","вам",6,114],["ٱلۡكِتَٰبَ","Писание",6,114],["مُفَصَّلٗاۚ","разъяснённым",6,114]],[["وَٱلَّذِينَ","И те, которым",6,114],["ءَاتَيۡنَٰهُمُ","Мы даровали им",6,114],["ٱلۡكِتَٰبَ","Писание",6,114],["يَعۡلَمُونَ","знают",6,114],["أَنَّهُۥ","что оно",6,114],["مُنَزَّلٞ","ниспослано",6,114],["مِّن","от",6,114],["رَّبِّكَ","твоего Господа",6,114],["بِٱلۡحَقِّۖ","с истиной",6,114]],[["فَلَا","так не",6,114],["تَكُونَنَّ","будь же",6,114],["مِنَ","из",6,114],["ٱلۡمُمۡتَرِينَ","сомневающихся",6,114],[114],["وَتَمَّتۡ","И исполнилось",6,115],["كَلِمَتُ","слово",6,115],["رَبِّكَ","твоего Господа",6,115],["صِدۡقٗا","правдиво",6,115]],[["وَعَدۡلٗاۚ","и справедливо",6,115],["لَّا","нет",6,115],["مُبَدِّلَ","изменяющего",6,115],["لِكَلِمَٰتِهِۦۚ","Его слова",6,115],["وَهُوَ","и Он",6,115],["ٱلسَّمِيعُ","Слышащий",6,115],["ٱلۡعَلِيمُ","Знающий",6,115],[115],["وَإِن","И если",6,116]],[["تُطِعۡ","ты подчинишься",6,116],["أَكۡثَرَ","большинству",6,116],["مَن","тех, кто",6,116],["فِي","на",6,116],["ٱلۡأَرۡضِ","земле",6,116],["يُضِلُّوكَ","они собьют тебя",6,116],["عَن","с",6,116],["سَبِيلِ","пути",6,116],["ٱللَّهِۚ","Аллаха",6,116],["إِن","Не",6,116]],[["يَتَّبِعُونَ","следуют они",6,116],["إِلَّا","кроме",6,116],["ٱلظَّنَّ","предположения",6,116],["وَإِنۡ","и не",6,116],["هُمۡ","они",6,116],["إِلَّا","кроме",6,116],["يَخۡرُصُونَ","измышляют",6,116],[116],["إِنَّ","Поистине",6,117],["رَبَّكَ","твой Господь",6,117],["هُوَ","Он",6,117]],[["أَعۡلَمُ","лучше знает",6,117],["مَن","кто",6,117],["يَضِلُّ","сбивается",6,117],["عَن","с",6,117],["سَبِيلِهِۦۖ","Его пути",6,117],["وَهُوَ","и Он",6,117],["أَعۡلَمُ","лучше знает",6,117],["بِٱلۡمُهۡتَدِينَ","следующих прямым путём",6,117],[117]],[["فَكُلُواْ","Ешьте же",6,118],["مِمَّا","из того, что",6,118],["ذُكِرَ","упомянуто",6,118],["ٱسۡمُ","имя",6,118],["ٱللَّهِ","Аллаха",6,118],["عَلَيۡهِ","над ним",6,118],["إِن","если",6,118],["كُنتُم","вы",6,118],["بِـَٔايَٰتِهِۦ","в Его знамения",6,118],["مُؤۡمِنِينَ","верующие",6,118],[118]]]}