{"p":143,"j":8,"a":[[6,119,["وَمَا","لَكُمۡ","أَلَّا","تَأۡكُلُواْ","مِمَّا","ذُكِرَ","ٱسۡمُ","ٱللَّهِ","عَلَيۡهِ","وَقَدۡ","فَصَّلَ","لَكُم","مَّا","حَرَّمَ","عَلَيۡكُمۡ","إِلَّا","مَا","ٱضۡطُرِرۡتُمۡ","إِلَيۡهِۗ","وَإِنَّ","كَثِيرٗا","لَّيُضِلُّونَ","بِأَهۡوَآئِهِم","بِغَيۡرِ","عِلۡمٍۚ","إِنَّ","رَبَّكَ","هُوَ","أَعۡلَمُ","بِٱلۡمُعۡتَدِينَ"],"вама лакум алла та'кулуу мимма зукирасмуллахи `алайхи ваḳад фассала лакум ма харрама `алайкум илла мадтуриртум илайхи ва'инна касиирал лайудиллууна би'ахваихим бигайри `илмин инна раббака хуа а`ламу билму`тадиин","Почему вы не должны есть из того, над чем произнесено имя Аллаха, в то время как Он уже подробно разъяснил вам, что вам запрещено, если только вы не принуждены к этому? Воистину, многие вводят других в заблуждение своими собственными желаниями, без всякого знания. Воистину, твоему Господу лучше знать преступников.",["И что","с вами","что не","вы едите","из того, что","упомянуто","имя","Аллаха","над ним","когда уже","Он разъяснил","вам","то, что","Он запретил","вам","кроме","того, к чему","вы вынуждены","к нему","И поистине","многие","непременно сбивают","своими страстями","без","знания","Поистине","твой Господь","Он","лучше знает","преступающих"]],[6,120,["وَذَرُواْ","ظَٰهِرَ","ٱلۡإِثۡمِ","وَبَاطِنَهُۥٓۚ","إِنَّ","ٱلَّذِينَ","يَكۡسِبُونَ","ٱلۡإِثۡمَ","سَيُجۡزَوۡنَ","بِمَا","كَانُواْ","يَقۡتَرِفُونَ"],"вазаруу захирал исми вабатинахуу иннал лазиина йаксибуунал исма сайужзауна бима кануу йаḳтарифуун","Оставьте грехи очевидные и сокрытые. Воистину, те, которые совершают грех, получат воздаяние за то, что они совершали.",["Оставьте","явный","грех","и тайный его","поистине","те, которые","приобретают","грех","будет воздано им","за то, что","они были","совершают"]],[6,121,["وَلَا","تَأۡكُلُواْ","مِمَّا","لَمۡ","يُذۡكَرِ","ٱسۡمُ","ٱللَّهِ","عَلَيۡهِ","وَإِنَّهُۥ","لَفِسۡقٞۗ","وَإِنَّ","ٱلشَّيَٰطِينَ","لَيُوحُونَ","إِلَىٰٓ","أَوۡلِيَآئِهِمۡ","لِيُجَٰدِلُوكُمۡۖ","وَإِنۡ","أَطَعۡتُمُوهُمۡ","إِنَّكُمۡ","لَمُشۡرِكُونَ"],"вала та'кулуу мимма лам йузкарисмуллахи `алайхи ва'иннахуу лафисḳун ва'иннаш шайатиина лайуухууна ила аулийаихим лийужадилуукум ва'ин ата`тумуухум иннакум ламушрикуун","Не ешьте из того, над чем не было произнесено имя Аллаха, ибо это есть нечестие. Воистину, дьяволы внушают своим помощникам препираться с вами. Если вы станете повиноваться им, то окажетесь многобожниками.",["И не","ешьте","из того, что","не","было упомянуто","имя","Аллаха","над ним","и поистине, это","непременно нечестие","И поистине","дьяволы","непременно внушают","к","своим приспешникам","чтобы препирались с вами","и если","вы повинуетесь им","поистине, вы","непременно многобожники"]],[6,122,["أَوَمَن","كَانَ","مَيۡتٗا","فَأَحۡيَيۡنَٰهُ","وَجَعَلۡنَا","لَهُۥ","نُورٗا","يَمۡشِي","بِهِۦ","فِي","ٱلنَّاسِ","كَمَن","مَّثَلُهُۥ","فِي","ٱلظُّلُمَٰتِ","لَيۡسَ","بِخَارِجٖ","مِّنۡهَاۚ","كَذَٰلِكَ","زُيِّنَ","لِلۡكَٰفِرِينَ","مَا","كَانُواْ","يَعۡمَلُونَ"],"аваман кана майтан фа'ахйайнаху важа`ална лахуу нууран йамшии бихии фин наси камам масалухуу физ зулумати лайса бихарижим минха казалика зуййина лилкафириина ма кануу йа`малуун","Разве тот, кто был мертвецом, и Мы вернули его к жизни и наделили светом, благодаря которому он ходит среди людей, подобен тому, кто находится во мраках и не может выйти из них? Так неверующим представляется прекрасным то, что они совершают.",["Разве тот, кто","был","мёртвым","и Мы оживили его","и Мы сделали","ему","свет","он ходит","с ним","среди","людей","как тот, кто","подобие его","в","мраках","не","выходящий","из них","Так","разукрашено","для неверующих","то, что","они были","делают"]],[6,123,["وَكَذَٰلِكَ","جَعَلۡنَا","فِي","كُلِّ","قَرۡيَةٍ","أَكَٰبِرَ","مُجۡرِمِيهَا","لِيَمۡكُرُواْ","فِيهَاۖ","وَمَا","يَمۡكُرُونَ","إِلَّا","بِأَنفُسِهِمۡ","وَمَا","يَشۡعُرُونَ"],"ваказалика жа`ална фии кулли ḳарйатин акабира мужримииха лийамкуруу фииха вама йамкурууна илла би'анфусихим вама йаш`уруун","Вот так в каждом селении Мы создавали главных грешников, чтобы они строили там козни. Однако они строят козни только против самих себя, но не ощущают этого.",["И так","Мы сделали","в","каждом","селении","главных","его грешников","чтобы строили козни","в нём","И не","строят козни","кроме как","против самих себя","и не","ощущают"]],[6,124,["وَإِذَا","جَآءَتۡهُمۡ","ءَايَةٞ","قَالُواْ","لَن","نُّؤۡمِنَ","حَتَّىٰ","نُؤۡتَىٰ","مِثۡلَ","مَآ","أُوتِيَ","رُسُلُ","ٱللَّهِۘ","ٱللَّهُ","أَعۡلَمُ","حَيۡثُ","يَجۡعَلُ","رِسَالَتَهُۥۗ","سَيُصِيبُ","ٱلَّذِينَ","أَجۡرَمُواْ","صَغَارٌ","عِندَ","ٱللَّهِ","وَعَذَابٞ","شَدِيدُۢ","بِمَا","كَانُواْ","يَمۡكُرُونَ"],"ва'иза жаатхум айатун ḳалуу лан ну'мина хатта ну'та мисла ма уутийа русулуллахиллаху а`ламу хайсу йаж`алу рисалатахуу сайусиибул лазиина ажрамуу сагарун `индаллахи ва`азабун шадииду бима кануу йамкуруун","Когда им явилось знамение, они сказали: «Мы не уверуем, пока не получим то, что получили посланники Аллаха». Аллах лучше знает, кому доверить Свое послание. Грешников же постигнет унижение перед Аллахом и тяжкие мучения за то, что они строили козни.",["И когда","пришло к ним","знамение","они сказали","никогда не","уверуем","пока","не будет дано нам","подобное","тому, что","было дано","посланникам","Аллаха","Аллах","лучше знает","где","помещает","Своё послание","постигнет","тех, которые","совершили преступления","унижение","у","Аллаха","и наказание","суровое","за то, что","они были","строят козни"]]],"m":[[["وَمَا","И что",6,119],["لَكُمۡ","с вами",6,119],["أَلَّا","что не",6,119],["تَأۡكُلُواْ","вы едите",6,119],["مِمَّا","из того, что",6,119],["ذُكِرَ","упомянуто",6,119],["ٱسۡمُ","имя",6,119],["ٱللَّهِ","Аллаха",6,119],["عَلَيۡهِ","над ним",6,119],["وَقَدۡ","когда уже",6,119],["فَصَّلَ","Он разъяснил",6,119]],[["لَكُم","вам",6,119],["مَّا","то, что",6,119],["حَرَّمَ","Он запретил",6,119],["عَلَيۡكُمۡ","вам",6,119],["إِلَّا","кроме",6,119],["مَا","того, к чему",6,119],["ٱضۡطُرِرۡتُمۡ","вы вынуждены",6,119],["إِلَيۡهِۗ","к нему",6,119],["وَإِنَّ","И поистине",6,119],["كَثِيرٗا","многие",6,119],["لَّيُضِلُّونَ","непременно сбивают",6,119]],[["بِأَهۡوَآئِهِم","своими страстями",6,119],["بِغَيۡرِ","без",6,119],["عِلۡمٍۚ","знания",6,119],["إِنَّ","Поистине",6,119],["رَبَّكَ","твой Господь",6,119],["هُوَ","Он",6,119],["أَعۡلَمُ","лучше знает",6,119],["بِٱلۡمُعۡتَدِينَ","преступающих",6,119],[119]],[["وَذَرُواْ","Оставьте",6,120],["ظَٰهِرَ","явный",6,120],["ٱلۡإِثۡمِ","грех",6,120],["وَبَاطِنَهُۥٓۚ","и тайный его",6,120],["إِنَّ","поистине",6,120],["ٱلَّذِينَ","те, которые",6,120],["يَكۡسِبُونَ","приобретают",6,120],["ٱلۡإِثۡمَ","грех",6,120]],[["سَيُجۡزَوۡنَ","будет воздано им",6,120],["بِمَا","за то, что",6,120],["كَانُواْ","они были",6,120],["يَقۡتَرِفُونَ","совершают",6,120],[120],["وَلَا","И не",6,121],["تَأۡكُلُواْ","ешьте",6,121],["مِمَّا","из того, что",6,121],["لَمۡ","не",6,121],["يُذۡكَرِ","было упомянуто",6,121]],[["ٱسۡمُ","имя",6,121],["ٱللَّهِ","Аллаха",6,121],["عَلَيۡهِ","над ним",6,121],["وَإِنَّهُۥ","и поистине, это",6,121],["لَفِسۡقٞۗ","непременно нечестие",6,121],["وَإِنَّ","И поистине",6,121],["ٱلشَّيَٰطِينَ","дьяволы",6,121],["لَيُوحُونَ","непременно внушают",6,121],["إِلَىٰٓ","к",6,121]],[["أَوۡلِيَآئِهِمۡ","своим приспешникам",6,121],["لِيُجَٰدِلُوكُمۡۖ","чтобы препирались с вами",6,121],["وَإِنۡ","и если",6,121],["أَطَعۡتُمُوهُمۡ","вы повинуетесь им",6,121],["إِنَّكُمۡ","поистине, вы",6,121],["لَمُشۡرِكُونَ","непременно многобожники",6,121],[121]],[["أَوَمَن","Разве тот, кто",6,122],["كَانَ","был",6,122],["مَيۡتٗا","мёртвым",6,122],["فَأَحۡيَيۡنَٰهُ","и Мы оживили его",6,122],["وَجَعَلۡنَا","и Мы сделали",6,122],["لَهُۥ","ему",6,122],["نُورٗا","свет",6,122],["يَمۡشِي","он ходит",6,122],["بِهِۦ","с ним",6,122],["فِي","среди",6,122]],[["ٱلنَّاسِ","людей",6,122],["كَمَن","как тот, кто",6,122],["مَّثَلُهُۥ","подобие его",6,122],["فِي","в",6,122],["ٱلظُّلُمَٰتِ","мраках",6,122],["لَيۡسَ","не",6,122],["بِخَارِجٖ","выходящий",6,122],["مِّنۡهَاۚ","из них",6,122],["كَذَٰلِكَ","Так",6,122]],[["زُيِّنَ","разукрашено",6,122],["لِلۡكَٰفِرِينَ","для неверующих",6,122],["مَا","то, что",6,122],["كَانُواْ","они были",6,122],["يَعۡمَلُونَ","делают",6,122],[122],["وَكَذَٰلِكَ","И так",6,123],["جَعَلۡنَا","Мы сделали",6,123]],[["فِي","в",6,123],["كُلِّ","каждом",6,123],["قَرۡيَةٍ","селении",6,123],["أَكَٰبِرَ","главных",6,123],["مُجۡرِمِيهَا","его грешников",6,123],["لِيَمۡكُرُواْ","чтобы строили козни",6,123],["فِيهَاۖ","в нём",6,123],["وَمَا","И не",6,123]],[["يَمۡكُرُونَ","строят козни",6,123],["إِلَّا","кроме как",6,123],["بِأَنفُسِهِمۡ","против самих себя",6,123],["وَمَا","и не",6,123],["يَشۡعُرُونَ","ощущают",6,123],[123],["وَإِذَا","И когда",6,124],["جَآءَتۡهُمۡ","пришло к ним",6,124]],[["ءَايَةٞ","знамение",6,124],["قَالُواْ","они сказали",6,124],["لَن","никогда не",6,124],["نُّؤۡمِنَ","уверуем",6,124],["حَتَّىٰ","пока",6,124],["نُؤۡتَىٰ","не будет дано нам",6,124],["مِثۡلَ","подобное",6,124],["مَآ","тому, что",6,124],["أُوتِيَ","было дано",6,124],["رُسُلُ","посланникам",6,124],["ٱللَّهِۘ","Аллаха",6,124],["ٱللَّهُ","Аллах",6,124]],[["أَعۡلَمُ","лучше знает",6,124],["حَيۡثُ","где",6,124],["يَجۡعَلُ","помещает",6,124],["رِسَالَتَهُۥۗ","Своё послание",6,124],["سَيُصِيبُ","постигнет",6,124],["ٱلَّذِينَ","тех, которые",6,124],["أَجۡرَمُواْ","совершили преступления",6,124]],[["صَغَارٌ","унижение",6,124],["عِندَ","у",6,124],["ٱللَّهِ","Аллаха",6,124],["وَعَذَابٞ","и наказание",6,124],["شَدِيدُۢ","суровое",6,124],["بِمَا","за то, что",6,124],["كَانُواْ","они были",6,124],["يَمۡكُرُونَ","строят козни",6,124],[124]]]}