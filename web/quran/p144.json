{"p":144,"j":8,"a":[[6,125,["فَمَن","يُرِدِ","ٱللَّهُ","أَن","يَهۡدِيَهُۥ","يَشۡرَحۡ","صَدۡرَهُۥ","لِلۡإِسۡلَٰمِۖ","وَمَن","يُرِدۡ","أَن","يُضِلَّهُۥ","يَجۡعَلۡ","صَدۡرَهُۥ","ضَيِّقًا","حَرَجٗا","كَأَنَّمَا","يَصَّعَّدُ","فِي","ٱلسَّمَآءِۚ","كَذَٰلِكَ","يَجۡعَلُ","ٱللَّهُ","ٱلرِّجۡسَ","عَلَى","ٱلَّذِينَ","لَا","يُؤۡمِنُونَ"],"фаман йуридиллаху ан йахдийахуу йашрах садрахуу лил'ислами ваман йурид ан йудиллахуу йаж`ал садрахуу даййиḳан харажан ка'аннама йасса``аду фис самаи казалика йаж`алуллахур рижса `алал лазиина ла йу'минуун","Кого Аллах желает наставить на прямой путь, тому Он раскрывает грудь для ислама, а кого Он желает ввести в заблуждение, тому Он сдавливает и сжимает грудь, словно тот забирается на небо. Так Аллах насылает скверну (или наказание) на тех, кто не верует.",["И кого","пожелает","Аллах","чтобы","наставить его","раскрывает","его грудь","для ислама","и кого","пожелает","чтобы","ввести его в заблуждение","делает","его грудь","тесной","стеснённой","словно","поднимается","в","небо","Так","помещает","Аллах","скверну","на","тех, которые","не","веруют"]],[6,126,["وَهَٰذَا","صِرَٰطُ","رَبِّكَ","مُسۡتَقِيمٗاۗ","قَدۡ","فَصَّلۡنَا","ٱلۡأٓيَٰتِ","لِقَوۡمٖ","يَذَّكَّرُونَ"],"вахаза сирату раббика мустаḳииман ḳад фассалнал айати лиḳаумин йаззаккаруун","Таков прямой путь твоего Господа. Мы уже подробно разъяснили знамения людям поминающим.",["И это","путь","твоего Господа","прямой","уже","Мы разъяснили","знамения","для людей","которые поминают"]],[6,127,["لَهُمۡ","دَارُ","ٱلسَّلَٰمِ","عِندَ","رَبِّهِمۡۖ","وَهُوَ","وَلِيُّهُم","بِمَا","كَانُواْ","يَعۡمَلُونَ"],"лахум дарус салами `инда раббихим вахуа валиййухум бима кануу йа`малуун","Им уготована Обитель мира и благополучия у их Господа. Он является их Покровителем благодаря тому, что они совершали.",["Для них","обитель","мира","у","их Господа","и Он","их Покровитель","за то, что","они были","делают"]],[6,128,["وَيَوۡمَ","يَحۡشُرُهُمۡ","جَمِيعٗا","يَٰمَعۡشَرَ","ٱلۡجِنِّ","قَدِ","ٱسۡتَكۡثَرۡتُم","مِّنَ","ٱلۡإِنسِۖ","وَقَالَ","أَوۡلِيَآؤُهُم","مِّنَ","ٱلۡإِنسِ","رَبَّنَا","ٱسۡتَمۡتَعَ","بَعۡضُنَا","بِبَعۡضٖ","وَبَلَغۡنَآ","أَجَلَنَا","ٱلَّذِيٓ","أَجَّلۡتَ","لَنَاۚ","قَالَ","ٱلنَّارُ","مَثۡوَىٰكُمۡ","خَٰلِدِينَ","فِيهَآ","إِلَّا","مَا","شَآءَ","ٱللَّهُۚ","إِنَّ","رَبَّكَ","حَكِيمٌ","عَلِيمٞ"],"вайаума йахшурухум жамии`ан йама`шарал жинни ḳадистаксартум мминал инси ваḳала аулийаухум минал инси раббанастамта`а ба`дуна биба`дин вабалагна ажаланал лазии ажжалта лана ḳалан нару масвакум халидиина фииха илла ма шааллаху инна раббака хакиимун `алиим","В тот день Он соберет их вместе: «О сонмище джиннов! Вы ввели в заблуждение многих людей». Их помощники из числа людей скажут: «Господь наш! Одни из нас пользовались другими, и мы достигли нашего срока, который Ты назначил нам». Он скажет: «Огонь будет вашей обителью, в которой вы пребудете вечно, если только Аллах не пожелает иначе!». Воистину, твой Господь - Мудрый, Знающий.",["И в день","Он соберёт их","всех","о сонмище","джиннов","уже","вы овладели многими","из","людей","И сказали","их приспешники","из","людей","Господь наш","пользовался","один из нас","другим","и мы достигли","нашего срока","который","Ты назначил","нам","Он сказал","Огонь","ваше пристанище","вечно пребывающие","в нём","кроме","того, что","пожелал","Аллах","поистине","твой Господь","Мудрый","Знающий"]],[6,129,["وَكَذَٰلِكَ","نُوَلِّي","بَعۡضَ","ٱلظَّٰلِمِينَ","بَعۡضَۢا","بِمَا","كَانُواْ","يَكۡسِبُونَ"],"ваказалика нуаллии ба`даз залимиина ба`да бима кануу йаксибуун","Так Мы позволяем одним беззаконникам править другими за то, что они приобретают.",["И так","Мы ставим во главе","одних","беззаконников","над другими","за то, что","они были","приобретают"]],[6,130,["يَٰمَعۡشَرَ","ٱلۡجِنِّ","وَٱلۡإِنسِ","أَلَمۡ","يَأۡتِكُمۡ","رُسُلٞ","مِّنكُمۡ","يَقُصُّونَ","عَلَيۡكُمۡ","ءَايَٰتِي","وَيُنذِرُونَكُمۡ","لِقَآءَ","يَوۡمِكُمۡ","هَٰذَاۚ","قَالُواْ","شَهِدۡنَا","عَلَىٰٓ","أَنفُسِنَاۖ","وَغَرَّتۡهُمُ","ٱلۡحَيَوٰةُ","ٱلدُّنۡيَا","وَشَهِدُواْ","عَلَىٰٓ","أَنفُسِهِمۡ","أَنَّهُمۡ","كَانُواْ","كَٰفِرِينَ"],"йама`шарал жинни вал'инси алам йа'тикум русулум минкум йаḳуссууна `алайкум айатии вайунзируунакум лиḳаа йаумикум хаза ḳалуу шахидна `ала анфусина вагарратхумул хайаватуд дунйа вашахидуу `ала анфусихим аннахум кануу кафириин","Мы скажем: «О сонмище джиннов и людей! Разве к вам не приходили посланники из вашего числа, которые читали вам Мои аяты и предупреждали вас о встрече с этим днем вашим?». Они скажут: «Мы свидетельствуем против самих себя». Мирская жизнь обольстила их, и они принесут свидетельство против самих себя о том, что они были неверующими.",["О сонмище","джиннов","и людей","разве не","приходили к вам","посланники","из вас","рассказывающие","вам","Мои аяты","и предупреждающие вас","о встрече","вашего дня","этого","Они сказали","мы свидетельствуем","против","самих себя","И обольстила их","жизнь","мирская","и они засвидетельствовали","против","самих себя","что они","были","неверующими"]],[6,131,["ذَٰلِكَ","أَن","لَّمۡ","يَكُن","رَّبُّكَ","مُهۡلِكَ","ٱلۡقُرَىٰ","بِظُلۡمٖ","وَأَهۡلُهَا","غَٰفِلُونَ"],"залика ал лам йакур раббука мухликал ḳура бизулмин ва'ахлуха гафилуун","Это произойдет потому, что твой Господь не губит города несправедливо, пока их жители пребывают в неведении.",["Это","потому что","не","был","твой Господь","губящим","селения","за несправедливость","а их жители","беспечны"]]],"m":[[["فَمَن","И кого",6,125],["يُرِدِ","пожелает",6,125],["ٱللَّهُ","Аллах",6,125],["أَن","чтобы",6,125],["يَهۡدِيَهُۥ","наставить его",6,125],["يَشۡرَحۡ","раскрывает",6,125],["صَدۡرَهُۥ","его грудь",6,125],["لِلۡإِسۡلَٰمِۖ","для ислама",6,125],["وَمَن","и кого",6,125],["يُرِدۡ","пожелает",6,125]],[["أَن","чтобы",6,125],["يُضِلَّهُۥ","ввести его в заблуждение",6,125],["يَجۡعَلۡ","делает",6,125],["صَدۡرَهُۥ","его грудь",6,125],["ضَيِّقًا","тесной",6,125],["حَرَجٗا","стеснённой",6,125],["كَأَنَّمَا","словно",6,125],["يَصَّعَّدُ","поднимается",6,125]],[["فِي","в",6,125],["ٱلسَّمَآءِۚ","небо",6,125],["كَذَٰلِكَ","Так",6,125],["يَجۡعَلُ","