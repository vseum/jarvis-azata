{"p":145,"j":8,"a":[[6,132,["وَلِكُلّٖ","دَرَجَٰتٞ","مِّمَّا","عَمِلُواْۚ","وَمَا","رَبُّكَ","بِغَٰفِلٍ","عَمَّا","يَعۡمَلُونَ"],"валикуллин даражатум мимма `амилуу вама раббука бигафилин `амма йа`малуун","Для всех будут ступени, соответствующие тому, что они совершили. Господь твой не находится в неведении относительно того, что они совершают.",["И для всех","ступени","из того, что","они совершили","И не","твой Господь","беспечен","к тому, что","они делают"]],[6,133,["وَرَبُّكَ","ٱلۡغَنِيُّ","ذُو","ٱلرَّحۡمَةِۚ","إِن","يَشَأۡ","يُذۡهِبۡكُمۡ","وَيَسۡتَخۡلِفۡ","مِنۢ","بَعۡدِكُم","مَّا","يَشَآءُ","كَمَآ","أَنشَأَكُم","مِّن","ذُرِّيَّةِ","قَوۡمٍ","ءَاخَرِينَ"],"вараббукал ганиййу зур рахмати ин йаша' йузхибкум вайастахлиф мим ба`дикум ма йашау кама аншаакум мин зурриййати ḳаумин ахариин","Господь твой богат и обладает милостью. Если Он пожелает, то уничтожит вас и сделает вашими преемниками, кого пожелает, подобно тому, как Он сотворил вас из потомства других людей.",["И твой Господь","Богатый","обладатель","милости","если","Он пожелает","Он уведёт вас","и сделает преемником","из","после вас","кого","Он пожелает","как","Он произвёл вас","из","потомства","народа","других"]],[6,134,["إِنَّ","مَا","تُوعَدُونَ","لَأٓتٖۖ","وَمَآ","أَنتُم","بِمُعۡجِزِينَ"],"инна ма туу`адууна ла'атин вама антум биму`жизиин","Воистину, обещанное вам наступит, и вы не сможете избежать этого.",["Поистине","то, что","вам обещано","непременно наступит","И не","вы","способны избежать"]],[6,135,["قُلۡ","يَٰقَوۡمِ","ٱعۡمَلُواْ","عَلَىٰ","مَكَانَتِكُمۡ","إِنِّي","عَامِلٞۖ","فَسَوۡفَ","تَعۡلَمُونَ","مَن","تَكُونُ","لَهُۥ","عَٰقِبَةُ","ٱلدَّارِۚ","إِنَّهُۥ","لَا","يُفۡلِحُ","ٱلظَّٰلِمُونَ"],"ḳул йаḳауми`малуу `ала маканатикум иннии `амилун фасауфа та`ламууна ман такууну лахуу `аḳибатуд дари иннахуу ла йуфлихуз залимуун","Скажи: «О мой народ! Действуйте по своему усмотрению, и я тоже буду действовать. Вы узнаете, кому достанется Последняя обитель. Воистину, не преуспеют беззаконники».",["Скажи","о мой народ","действуйте","по","своему положению","поистине, я","действующий","И скоро","вы узнаете","у кого","будет","у него","исход","обители","поистине","не","преуспеют","беззаконники"]],[6,136,["وَجَعَلُواْ","لِلَّهِ","مِمَّا","ذَرَأَ","مِنَ","ٱلۡحَرۡثِ","وَٱلۡأَنۡعَٰمِ","نَصِيبٗا","فَقَالُواْ","هَٰذَا","لِلَّهِ","بِزَعۡمِهِمۡ","وَهَٰذَا","لِشُرَكَآئِنَاۖ","فَمَا","كَانَ","لِشُرَكَآئِهِمۡ","فَلَا","يَصِلُ","إِلَى","ٱللَّهِۖ","وَمَا","كَانَ","لِلَّهِ","فَهُوَ","يَصِلُ","إِلَىٰ","شُرَكَآئِهِمۡۗ","سَآءَ","مَا","يَحۡكُمُونَ"],"важа`алуу лиллахи мимма зараа минал харси вал'ан`ами насиибан фаḳалуу хаза лиллахи биза`михим вахаза лишуракаина фама кана лишуракаихим фала йасилу илаллахи вама кана лиллахи фахуа йасилу ила шуракаихим саа ма йахкумуун","Они предназначают Аллаху долю того, что Он вырастил из посевов и скота, и по своему разумению говорят: «Это - Аллаху, а это - сотоварищам». То, что предназначено сотоварищам, не попадает Аллаху, а то, что предназначено Аллаху, попадает сотоварищам. Скверно то, что они решают!",["И они сделали","для Аллаха","из того, что","Он произвёл","из","посевов","и скота","долю","и сказали","это","Аллаху","по их утверждению","а это","нашим сотоварищам","И то, что","было","для их сотоварищей","то не","доходит","до","Аллаха","а то, что","было","для Аллаха","то оно","доходит","до","их сотоварищей","скверно","то, что","они решают"]],[6,137,["وَكَذَٰلِكَ","زَيَّنَ","لِكَثِيرٖ","مِّنَ","ٱلۡمُشۡرِكِينَ","قَتۡلَ","أَوۡلَٰدِهِمۡ","شُرَكَآؤُهُمۡ","لِيُرۡدُوهُمۡ","وَلِيَلۡبِسُواْ","عَلَيۡهِمۡ","دِينَهُمۡۖ","وَلَوۡ","شَآءَ","ٱللَّهُ","مَا","فَعَلُوهُۖ","فَذَرۡهُمۡ","وَمَا","يَفۡتَرُونَ"],"ваказалика заййана ликасиирим минал мушрикиина ḳатла ауладихим шуракаухум лийурдуухум валийалбисуу `алайхим диинахум валау шааллаху ма фа`алууху фазархум вама йафтаруун","Так многим многобожникам их сотоварищи представили прекрасным убийство детей, дабы погубить их и сделать запутанной их религию. Если бы Аллах пожелал, они не поступали бы таким образом. Оставь же их вместе с их измышлениями.",["И так","разукрасили","для многих","из","многобожников","убийство","их детей","их сотоварищи","чтобы погубить их","и чтобы запутать","для них","их религию","И если бы","пожелал","Аллах","не","сделали бы они это","Оставь же их","и то, что","они измышляют"]]],"m":[[["وَلِكُلّٖ","И для всех",6,132],["دَرَجَٰتٞ","ступени",6,132],["مِّمَّا","из того, что",6,132],["عَمِلُواْۚ","они совершили",6,132],["وَمَا","И не",6,132],["رَبُّكَ","твой Господь",6,132],["بِغَٰفِلٍ","беспечен",6,132],["عَمَّا","к тому, что",6,132]],[["يَعۡمَلُونَ","они делают",6,132],[132],["وَرَبُّكَ","И твой Господь",6,133],["ٱلۡغَنِيُّ","Богатый",6,133],["ذُو","обладатель",6,133],["ٱلرَّحۡمَةِۚ","милости",6,133],["إِن","если",6,133],["يَشَأۡ","Он пожелает",6,133]],[["يُذۡهِبۡكُمۡ","Он уведёт вас",6,133],["وَيَسۡتَخۡلِفۡ","и сделает преемником",6,133],["مِنۢ","из",6,133],["بَعۡدِكُم","после вас",6,133],["مَّا","кого",6,133],["يَشَآءُ","Он пожелает",6,133],["كَمَآ","как",6,133]],[["أَنشَأَكُم","Он произвёл вас",6,133],["مِّن","из",6,133],["ذُرِّيَّةِ","потомства",6,133],["قَوۡمٍ","народа",6,133],["ءَاخَرِينَ","других",6,133],[133],["إِنَّ","Поистине",6,134],["مَا","то, что",6,134]],[["تُوعَدُونَ","вам обещано",6,134],["لَأٓتٖۖ","непременно наступит",6,134],["وَمَآ","И не",6,134],["أَنتُم","вы",6,134],["بِمُعۡجِزِينَ","способны избежать",6,134],[134],["قُلۡ","Скажи",6,135],["يَٰقَوۡمِ","о мой народ",6,135]],[["ٱعۡمَلُواْ","действуйте",6,135],["عَلَىٰ","по",6,135],["مَكَانَتِكُمۡ","своему положению",6,135],["إِنِّي","поистине, я",6,135],["عَامِلٞۖ","действующий",6,135],["فَسَوۡفَ","И скоро",6,135],["تَعۡلَمُونَ","вы узнаете",6,135]],[["مَن","у кого",6,135],["تَكُونُ","будет",6,135],["لَهُۥ","у него",6,135],["عَٰقِبَةُ","исход",6,135],["ٱلدَّارِۚ","обители",6,135],["إِنَّهُۥ","поистине",6,135],["لَا","не",6,135],["يُفۡلِحُ","преуспеют",6,135],["ٱلظَّٰلِمُونَ","беззаконники",6,135]],[[135],["وَجَعَلُواْ","И они сделали",6,136],["لِلَّهِ","для Аллаха",6,136],["مِمَّا","из того, что",6,136],["ذَرَأَ","Он произвёл",6,136],["مِنَ","из",6,136],["ٱلۡحَرۡثِ","посевов",6,136],["وَٱلۡأَنۡعَٰمِ","и скота",6,136]],[["نَصِيبٗا","долю",6,136],["فَقَالُواْ","и сказали",6,136],["هَٰذَا","это",6,136],["لِلَّهِ","Аллаху",6,136],["بِزَعۡمِهِمۡ","по их утверждению",6,136],["وَهَٰذَا","а это",6,136],["لِشُرَكَآئِنَاۖ","нашим сотоварищам",6,136]],[["فَمَا","И то, что",6,136],["كَانَ","было",6,136],["لِشُرَكَآئِهِمۡ","для их сотоварищей",6,136],["فَلَا","то не",6,136],["يَصِلُ","доходит",6,136],["إِلَى","до",6,136],["ٱللَّهِۖ","Аллаха",6,136]],[["وَمَا","а то, что",6,136],["كَانَ","было",6,136],["لِلَّهِ","для Аллаха",6,136],["فَهُوَ","то оно",6,136],["يَصِلُ","доходит",6,136],["إِلَىٰ","до",6,136],["شُرَكَآئِهِمۡۗ","их сотоварищей",6,136]],[["سَآءَ","скверно",6,136],["مَا","то, что",6,136],["يَحۡكُمُونَ","они решают",6,136],[136],["وَكَذَٰلِكَ","И так",6,137],["زَيَّنَ","разукрасили",6,137]],[["لِكَثِيرٖ","для многих",6,137],["مِّنَ","из",6,137],["ٱلۡمُشۡرِكِينَ","многобожников",6,137],["قَتۡلَ","убийство",6,137],["أَوۡلَٰدِهِمۡ","их детей",6,137]],[["شُرَكَآؤُهُمۡ","их сотоварищи",6,137],["لِيُرۡدُوهُمۡ","чтобы погубить их",6,137],["وَلِيَلۡبِسُواْ","и чтобы запутать",6,137],["عَلَيۡهِمۡ","для них",6,137],["دِينَهُمۡۖ","их религию",6,137]],[["وَلَوۡ","И если бы",6,137],["شَآءَ","пожелал",6,137],["ٱللَّهُ","Аллах",6,137],["مَا","не",6,137],["فَعَلُوهُۖ","сделали бы они это",6,137],["فَذَرۡهُمۡ","Оставь же их",6,137],["وَمَا","и то, что",6,137],["يَفۡتَرُونَ","они измышляют",6,137],[137]]]}