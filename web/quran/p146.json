{"p":146,"j":8,"a":[[6,138,["وَقَالُواْ","هَٰذِهِۦٓ","أَنۡعَٰمٞ","وَحَرۡثٌ","حِجۡرٞ","لَّا","يَطۡعَمُهَآ","إِلَّا","مَن","نَّشَآءُ","بِزَعۡمِهِمۡ","وَأَنۡعَٰمٌ","حُرِّمَتۡ","ظُهُورُهَا","وَأَنۡعَٰمٞ","لَّا","يَذۡكُرُونَ","ٱسۡمَ","ٱللَّهِ","عَلَيۡهَا","ٱفۡتِرَآءً","عَلَيۡهِۚ","سَيَجۡزِيهِم","بِمَا","كَانُواْ","يَفۡتَرُونَ"],"ваḳалуу хазихии ан`амун вахарсун хижрул ла йат`амуха илла ман нашау биза`михим ва'ан`амун хурримат зухууруха ва'ан`амул ла йазкуруунасмаллахи `алайхафтираан `алайхи сайажзиихим бима кануу йафтаруун","На основании своих предположений они говорят: «Эта скотина и эти посевы запретны. Питаться ими может только тот, кому мы позволим». На одной скотине они запрещают ездить верхом и возить грузы, а над другой скотиной они не произносят имени Аллаха, возводя на Него навет. Он воздаст им за то, что они измышляют!",["И сказали","это","скот","и посевы","запретные","не","ест их","кроме","кого","мы пожелаем","по их утверждению","и скот","запрещены","его спины","и скот","не","они упоминают","имя","Аллаха","над ним","измышляя","на Него","Он воздаст им","за то, что","они были","измышляют"]],[6,139,["وَقَالُواْ","مَا","فِي","بُطُونِ","هَٰذِهِ","ٱلۡأَنۡعَٰمِ","خَالِصَةٞ","لِّذُكُورِنَا","وَمُحَرَّمٌ","عَلَىٰٓ","أَزۡوَٰجِنَاۖ","وَإِن","يَكُن","مَّيۡتَةٗ","فَهُمۡ","فِيهِ","شُرَكَآءُۚ","سَيَجۡزِيهِمۡ","وَصۡفَهُمۡۚ","إِنَّهُۥ","حَكِيمٌ","عَلِيمٞ"],"ваḳалуу ма фии бутууни хазихил ан`ами халисатул лизукуурина вамухаррамун `ала азважина ва'ин йакум майтатан фахум фиихи шуракау сайажзиихим васфахум иннахуу хакиимун `алиим","Они говорят: «То, что находится в утробах этой скотины, дозволено нашим мужчинам и запрещено нашим женам». Если же он рождается мертвым, то все они получают право на него. Аллах воздаст им за то, что они приписывали, ведь Он - Мудрый, Знающий.",["И сказали","то, что","в","утробах","этого","скота","исключительно","для наших мужчин","и запрещено","для","наших жён","А если","будет","мёртвым","то они","в нём","соучастники","Он воздаст им","за их приписывание","поистине, Он","Мудрый","Знающий"]],[6,140,["قَدۡ","خَسِرَ","ٱلَّذِينَ","قَتَلُوٓاْ","أَوۡلَٰدَهُمۡ","سَفَهَۢا","بِغَيۡرِ","عِلۡمٖ","وَحَرَّمُواْ","مَا","رَزَقَهُمُ","ٱللَّهُ","ٱفۡتِرَآءً","عَلَى","ٱللَّهِۚ","قَدۡ","ضَلُّواْ","وَمَا","كَانُواْ","مُهۡتَدِينَ"],"ḳад хасирал лазиина ḳаталуу ауладахум сафаха бигайри `илмин вахаррамуу ма разаḳахумуллахуфтираан `алаллахи ḳад даллуу вама кануу мухтадиин","Понесли урон те, которые убивали своих детей по глупости, без всякого знания, и запрещали то, чем наделял их Аллах, возводя навет на Аллаха. Они впали в заблуждение и не последовали прямым путем.",["Уже","понесли урон","те, которые","убили","своих детей","по глупости","без","знания","и запретили","то, чем","наделил их","Аллах","измышляя","на","Аллаха","Уже","они заблудились","и не","были они","следующими прямым путём"]],[6,141,["وَهُوَ","ٱلَّذِيٓ","أَنشَأَ","جَنَّٰتٖ","مَّعۡرُوشَٰتٖ","وَغَيۡرَ","مَعۡرُوشَٰتٖ","وَٱلنَّخۡلَ","وَٱلزَّرۡعَ","مُخۡتَلِفًا","أُكُلُهُۥ","وَٱلزَّيۡتُونَ","وَٱلرُّمَّانَ","مُتَشَٰبِهٗا","وَغَيۡرَ","مُتَشَٰبِهٖۚ","كُلُواْ","مِن","ثَمَرِهِۦٓ","إِذَآ","أَثۡمَرَ","وَءَاتُواْ","حَقَّهُۥ","يَوۡمَ","حَصَادِهِۦۖ","وَلَا","تُسۡرِفُوٓاْۚ","إِنَّهُۥ","لَا","يُحِبُّ","ٱلۡمُسۡرِفِينَ"],"вахуал лазии аншаа жаннатим ма`руушатин вагайра ма`руушатин ваннахла ваззар`а мухталифан укулухуу ваззайтууна варруммана муташабихан вагайра муташабихин кулуу мин самарихии иза асмара ва'атуу хаḳḳахуу йаума хасадихии вала тусрифуу иннахуу ла йухиббул мусрифиин","Он - Тот, Кто создал сады на трельяжах и без трельяжей, финиковые пальмы и злаки с различным вкусом, оливки и гранаты, имеющие сходства и различия. Вкушайте эти плоды, когда они созревают, и отдавайте должное в день уборки, но не излишествуйте, ведь Он не любит тех, кто излишествует.",["И Он","Тот, Кто","создал","сады","на подпорках","и не","на подпорках","и финиковые пальмы","и злаки","различный","его плод","и оливки","и гранаты","сходные","и не","сходные","Ешьте","из","его плодов","когда","он плодоносит","и давайте","должное с него","в день","его сбора","И не","излишествуйте","поистине, Он","не","любит","излишествующих"]],[6,142,["وَمِنَ","ٱلۡأَنۡعَٰمِ","حَمُولَةٗ","وَفَرۡشٗاۚ","كُلُواْ","مِمَّا","رَزَقَكُمُ","ٱللَّهُ","وَلَا","تَتَّبِعُواْ","خُطُوَٰتِ","ٱلشَّيۡطَٰنِۚ","إِنَّهُۥ","لَكُمۡ","عَدُوّٞ","مُّبِينٞ"],"ваминал ан`ами хамуулатан вафаршан кулуу мимма разаḳакумуллаху вала таттаби`уу хутуатиш шайтани иннахуу лакум `адуввум мубиин","Среди скотины есть предназначенная для перевозки и не предназначенная для этого. Ешьте из того, чем вас наделил Аллах, и не следуйте по стопам дьявола, ведь он для вас - явный враг.",["И из","скота","вьючный","и низкорослый","ешьте","из того, что","наделил вас","Аллах","и не","следуйте","стопам","шайтана","поистине, он","для вас","враг","явный"]]],"m":[[["وَقَالُواْ","И сказали",6,138],["هَٰذِهِۦٓ","это",6,138],["أَنۡعَٰمٞ","скот",6,138],["وَحَرۡثٌ","и посевы",6,138],["حِجۡرٞ","запретные",6,138],["لَّا","не",6,138],["يَطۡعَمُهَآ","ест их",6,138],["إِلَّا","кроме",6,138],["مَن","кого",6,138]],[["نَّشَآءُ","мы пожелаем",6,138],["بِزَعۡمِهِمۡ","по их утверждению",6,138],["وَأَنۡعَٰمٌ","и скот",6,138],["حُرِّمَتۡ","запрещены",6,138],["ظُهُورُهَا","его спины",6,138],["وَأَنۡعَٰمٞ","и скот",6,138],["لَّا","не",6,138],["يَذۡكُرُونَ","они упоминают",6,138]],[["ٱسۡمَ","имя",6,138],["ٱللَّهِ","Аллаха",6,138],["عَلَيۡهَا","над ним",6,138],["ٱفۡتِرَآءً","измышляя",6,138],["عَلَيۡهِۚ","на Него",6,138],["سَيَجۡزِيهِم","Он воздаст им",6,138],["بِمَا","за то, что",6,138],["كَانُواْ","они были",6,138]],[["يَفۡتَرُونَ","измышляют",6,138],[138],["وَقَالُواْ","И сказали",6,139],["مَا","то, что",6,139],["فِي","в",6,139],["بُطُونِ","утробах",6,139],["هَٰذِهِ","этого",6,139],["ٱلۡأَنۡعَٰمِ","скота",6,139]],[["خَالِصَةٞ","исключительно",6,139],["لِّذُكُورِنَا","для наших мужчин",6,139],["وَمُحَرَّمٌ","и запрещено",6,139],["عَلَىٰٓ","для",6,139],["أَزۡوَٰجِنَاۖ","наших жён",6,139],["وَإِن","А если",6,139],["يَكُن","будет",6,139]],[["مَّيۡتَةٗ","мёртвым",6,139]