",6,142],["مِمَّا","из того, что",6,142],["رَزَقَكُمُ","наделил вас",6,142]],[["ٱللَّهُ","Аллах",6,142],["وَلَا","и не",6,142],["تَتَّبِعُواْ","следуйте",6,142],["خُطُوَٰتِ","стопам",6,142],["ٱلشَّيۡطَٰنِۚ","шайтана",6,142],["إِنَّهُۥ","поистине, он",6,142],["لَكُمۡ","для вас",6,142],["عَدُوّٞ","враг",6,142],["مُّبِينٞ","явный",6,142],[142]]]}