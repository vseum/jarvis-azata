{"p":149,"j":8,"a":[[6,152,["وَلَا","تَقۡرَبُواْ","مَالَ","ٱلۡيَتِيمِ","إِلَّا","بِٱلَّتِي","هِيَ","أَحۡسَنُ","حَتَّىٰ","يَبۡلُغَ","أَشُدَّهُۥۚ","وَأَوۡفُواْ","ٱلۡكَيۡلَ","وَٱلۡمِيزَانَ","بِٱلۡقِسۡطِۖ","لَا","نُكَلِّفُ","نَفۡسًا","إِلَّا","وُسۡعَهَاۖ","وَإِذَا","قُلۡتُمۡ","فَٱعۡدِلُواْ","وَلَوۡ","كَانَ","ذَا","قُرۡبَىٰۖ","وَبِعَهۡدِ","ٱللَّهِ","أَوۡفُواْۚ","ذَٰلِكُمۡ","وَصَّىٰكُم","بِهِۦ","لَعَلَّكُمۡ","تَذَكَّرُونَ"],"вала таḳрабуу малал йатиими илла биллатии хийа ахсану хатта йаблуга ашуддахуу ва'ауфул кайла валмиизана билḳисти ла нукаллифу нафсан илла вус`аха ва'иза ḳултум фа`дилуу валау кана за ḳурба ваби`ахдиллахи ауфуу заликум вассакум бихии ла`аллакум тазаккаруун","Не приближайтесь к имуществу сироты, кроме как во благо ему, пока он не достигнет зрелого возраста. Наполняйте меру и весы по справедливости. Мы не возлагаем на человека сверх его возможностей. Когда вы произносите слово, будьте справедливы, даже если это касается родственника. Будьте верны договору с Аллахом. Это заповедал вам Аллах, - быть может, вы помяните назидание.",["И не","приближайтесь","к имуществу","сироты","кроме как","тем, что","оно","наилучшее","пока","не достигнет","своей зрелости","И наполняйте","меру","и весы","по справедливости","не","Мы возлагаем","на душу","кроме","её возможности","И когда","вы говорите","то будьте справедливы","и даже если","был","обладатель","родства","И завет","Аллаха","исполняйте","Это","Он заповедал вам","это","быть может, вы","помяните"]],[6,153,["وَأَنَّ","هَٰذَا","صِرَٰطِي","مُسۡتَقِيمٗا","فَٱتَّبِعُوهُۖ","وَلَا","تَتَّبِعُواْ","ٱلسُّبُلَ","فَتَفَرَّقَ","بِكُمۡ","عَن","سَبِيلِهِۦۚ","ذَٰلِكُمۡ","وَصَّىٰكُم","بِهِۦ","لَعَلَّكُمۡ","تَتَّقُونَ"],"ва'анна хаза сиратии мустаḳииман фаттаби`ууху вала таттаби`ус субула фатафарраḳа бикум `ан сабиилихии заликум вассакум бихии ла`аллакум таттаḳуун","Таков Мой прямой путь. Следуйте по нему и не следуйте другими путями, поскольку они собьют вас с Его пути. Он заповедал вам это, - быть может, вы устрашитесь.",["И что","это","Мой путь","прямой","так следуйте ему","и не","следуйте","путям","и разлучат","вас","с","Его путём","Это","Он заповедал вам","это","быть может, вы","будете богобоязненны"]],[6,154,["ثُمَّ","ءَاتَيۡنَا","مُوسَى","ٱلۡكِتَٰبَ","تَمَامًا","عَلَى","ٱلَّذِيٓ","أَحۡسَنَ","وَتَفۡصِيلٗا","لِّكُلِّ","شَيۡءٖ","وَهُدٗى","وَرَحۡمَةٗ","لَّعَلَّهُم","بِلِقَآءِ","رَبِّهِمۡ","يُؤۡمِنُونَ"],"сумма атайна муусал китаба тамаман `алал лазии ахсана ватафсиилал ликулли шай'ин вахудан варахматал ла`аллахум билиḳаи раббихим йу'минуун","Мы также даровали Мусе (Моисею) Писание в завершение милости к тому, кто был добродетелен, как разъяснение всякой вещи, верное руководство и милость, дабы они уверовали во встречу со своим Господом.",["Затем","Мы дали","Мусе","Писание","в завершение","для","того, кто","творил добро","и разъяснение","всякой","вещи","и руководство","и милость","быть может, они","во встречу","со своим Господом","уверуют"]],[6,155,["وَهَٰذَا","كِتَٰبٌ","أَنزَلۡنَٰهُ","مُبَارَكٞ","فَٱتَّبِعُوهُ","وَٱتَّقُواْ","لَعَلَّكُمۡ","تُرۡحَمُونَ"],"вахаза китабун анзалнаху мубаракун фаттаби`ууху ваттаḳуу ла`аллакум турхамуун","Это - благословенное Писание, которое Мы ниспослали. Следуйте же ему и будьте богобоязненны, - быть может, вы будете помилованы.",["И это","Писание","Мы ниспослали его","благословенное","следуйте же ему","и будьте богобоязненны","быть может, вы","будете помилованы"]],[6,156,["أَن","تَقُولُوٓاْ","إِنَّمَآ","أُنزِلَ","ٱلۡكِتَٰبُ","عَلَىٰ","طَآئِفَتَيۡنِ","مِن","قَبۡلِنَا","وَإِن","كُنَّا","عَن","دِرَاسَتِهِمۡ","لَغَٰفِلِينَ"],"ан таḳуулуу иннама унзилал китабу `ала таифатайни мин ḳаблина ва'ин кунна `ан дирасатихим лагафилиин","Мы ниспослали его, чтобы вы не говорили: «Писание было ниспослано только двум общинам до нас, и мы ничего не знали о том, что они изучали».",["Чтобы не","сказали вы","лишь","было ниспослано","Писание","на","две общины","из","до нас","и поистине","мы были","к","их изучению","непременно невнимательны"]],[6,157,["أَوۡ","تَقُولُواْ","لَوۡ","أَنَّآ","أُنزِلَ","عَلَيۡنَا","ٱلۡكِتَٰبُ","لَكُنَّآ","أَهۡدَىٰ","مِنۡهُمۡۚ","فَقَدۡ","جَآءَكُم","بَيِّنَةٞ","مِّن","رَّبِّكُمۡ","وَهُدٗى","وَرَحۡمَةٞۚ","فَمَنۡ","أَظۡلَمُ","مِمَّن","كَذَّبَ","بِـَٔايَٰتِ","ٱللَّهِ","وَصَدَفَ","عَنۡهَاۗ","سَنَجۡزِي","ٱلَّذِينَ","يَصۡدِفُونَ","عَنۡ","ءَايَٰتِنَا","سُوٓءَ","ٱلۡعَذَابِ","بِمَا","كَانُواْ","يَصۡدِفُونَ"],"ау таḳуулуу лау анна унзила `алайнал китабу лакунна ахда минхум фаḳад жаакум баййинатум мир раббикум вахудан варахматун фаман азламу мимман каззаба би'айатиллахи васадафа `анха санажзил лазиина йасдифууна `ан айатина сууал `азаби бима кануу йасдифуун","Или чтобы вы не говорили: «Если бы нам было ниспослано Писание, то мы придерживались бы прямого пути лучше, чем они». К вам уже явилось ясное знамение от вашего Господа, верное руководство и милость. Кто же несправедливее того, кто считает ложью знамения Аллаха и отворачивается от них? Мы воздадим тем, кто отворачивается от Наших знамений, тяжкими мучениями за то, что они отворачивались.",["Или","вы скажете","если бы","что","было ниспослано","нам","Писание","непременно были бы мы","вернее на прямом пути","чем они","Так уже","пришло к вам","ясное знамение","от","вашего Господа","и руководство","и милость","Кто же","несправедливее","того, кто","счёл ложью","аяты","Аллаха","и отвернулся","от них","Мы воздадим","тем, которые","отворачиваются","от","Наших знамений","худшим","наказанием","за то, что","они были","отворачиваются"]]],"m":[[["وَلَا","И не",6,152],["تَقۡرَبُواْ","приближайтесь",6,152],["مَالَ","к имуществу",6,152],["ٱلۡيَتِيمِ","сироты",6,152],["إِلَّا","кроме как",6,152],["بِٱلَّتِي","тем, что",6,152],["هِيَ","оно",6,152],["أَحۡسَنُ","наилучшее",6,152],["حَتَّىٰ","пока",6,152],["يَبۡلُغَ","не достигнет",6,152],["أَشُدَّهُۥۚ","своей зрелости",6,152]],[["وَأَوۡفُواْ","И наполняйте",6,152],["ٱلۡكَيۡلَ","меру",6,152],["وَٱلۡمِيزَانَ","и весы",6,152],["بِٱلۡقِسۡطِۖ","по справедливости",6,152],["لَا","не",6,152],["نُكَلِّفُ","Мы возлагаем",6,152],["نَفۡسًا","на душу",6,152],["إِلَّا","кроме",6,152]],[["وُسۡعَهَاۖ","её возможности",6,152],["وَإِذَا","И когда",6,152],["قُلۡتُمۡ","вы говорите",6,152],["فَٱعۡدِلُواْ","то будьте справедливы",6,152],["وَلَوۡ","и даже если",6,152],["كَانَ","был",6,152],["ذَا","обладатель",6,152],["قُرۡبَىٰۖ","родства",6,152],["وَبِعَهۡدِ","И завет",6,152]],[["ٱللَّهِ","Аллаха",6,152],["أَوۡفُواْۚ","исполняйте",6,152],["ذَٰلِكُمۡ","Это",6,152],["وَصَّىٰكُم","Он заповедал вам",6,152],["بِهِۦ","это",6,152],["لَعَلَّكُمۡ","быть может, вы",6,152],["تَذَكَّرُونَ","помяните",6,152],[152]],[["وَأَنَّ","И что",6,153],["هَٰذَا","это",6,153],["صِرَٰطِي","Мой путь",6,153],["مُسۡتَقِيمٗا","прямой",6,153],["فَٱتَّبِعُوهُۖ","так следуйте ему",6,153],["وَلَا","и не",6,153],["تَتَّبِعُواْ","следуйте",6,153],["ٱلسُّبُلَ","путям",6,153]],[["فَتَفَرَّقَ","и разлучат",6,153],["بِكُمۡ","вас",6,153],["عَن","с",6,153],["سَبِيلِهِۦۚ","Его путём",6,153],["ذَٰلِكُمۡ","Это",6,153],["وَصَّىٰكُم","Он заповедал вам",6,153],["بِهِۦ","это",6,153],["لَعَلَّكُمۡ","быть может, вы",6,153]],[["تَتَّقُونَ","будете богобоязненны",6,153],[153],["ثُمَّ","Затем",6,154],["ءَاتَيۡنَا","Мы дали",6,154],["مُوسَى","Мусе",6,154],["ٱلۡكِتَٰبَ","Писание",6,154],["تَمَامًا","в завершение",6,154],["عَلَى","для",6,154],["ٱلَّذِيٓ","того, кто",6,154]],[["أَحۡسَنَ","творил добро",6,154],["وَتَفۡصِيلٗا","и разъяснение",6,154],["لِّكُلِّ","всякой",6,154],["شَيۡءٖ","вещи",6,154],["وَهُدٗى","и руководство",6,154],["وَرَحۡمَةٗ","и милость",6,154],["لَّعَلَّهُم","быть может, они",6,154],["بِلِقَآءِ","во встречу",6,154]],[["رَبِّهِمۡ","со своим Господом",6,154],["يُؤۡمِنُونَ","уверуют",6,154],[154],["وَهَٰذَا","И это",6,155],["كِتَٰبٌ","Писание",6,155],["أَنزَلۡنَٰهُ","Мы ниспослали его",6,155],["مُبَارَكٞ","благословенное",6,155],["فَٱتَّبِعُوهُ","следуйте же ему",6,155]],[["وَٱتَّقُواْ","и будьте богобоязненны",6,155],["لَعَلَّكُمۡ","быть может, вы",6,155],["تُرۡحَمُونَ","будете помилованы",6,155],[155],["أَن","Чтобы не",6,156],["تَقُولُوٓاْ","сказали вы",6,156],["إِنَّمَآ","лишь",6,156],["أُنزِلَ","было ниспослано",6,156],["ٱلۡكِتَٰبُ","Писание",6,156]],[["عَلَىٰ","на",6,156],["طَآئِفَتَيۡنِ","две общины",6,156],["مِن","из",6,156],["قَبۡلِنَا","до нас",6,156],["وَإِن","и поистине",6,156],["كُنَّا","мы были",6,156],["عَن","к",6,156],["دِرَاسَتِهِمۡ","их изучению",6,156],["لَغَٰفِلِينَ","непременно невнимательны",6,156]],[[156],["أَوۡ","Или",6,157],["تَقُولُواْ","вы скажете",6,157],["لَوۡ","если бы",6,157],["أَنَّآ","что",6,157],["أُنزِلَ","было ниспослано",6,157],["عَلَيۡنَا","нам",6,157],["ٱلۡكِتَٰبُ","Писание",6,157],["لَكُنَّآ","непременно были бы мы",6,157],["أَهۡدَىٰ","вернее на прямом пути",6,157],["مِنۡهُمۡۚ","чем они",6,157]],[["فَقَدۡ","Так уже",6,157],["جَآءَكُم","пришло к вам",6,157],["بَيِّنَةٞ","ясное знамение",6,157],["مِّن","от",6,157],["رَّبِّكُمۡ","вашего Господа",6,157],["وَهُدٗى","и руководство",6,157],["وَرَحۡمَةٞۚ","и милость",6,157],["فَمَنۡ","Кто же",6,157]],[["أَظۡلَمُ","несправедливее",6,157],["مِمَّن","того, кто",6,157],["كَذَّبَ","счёл ложью",6,157],["بِـَٔايَٰتِ","аяты",6,157],["ٱللَّهِ","Аллаха",6,157],["وَصَدَفَ","и отвернулся",6,157],["عَنۡهَاۗ","от них",6,157],["سَنَجۡزِي","Мы воздадим",6,157],["ٱلَّذِينَ","тем, которые",6,157]],[["يَصۡدِفُونَ","отворачиваются",6,157],["عَنۡ","от",6,157],["ءَايَٰتِنَا","Наших знамений",6,157],["سُوٓءَ","худшим",6,157],["ٱلۡعَذَابِ","наказанием",6,157],["بِمَا","за то, что",6,157],["كَانُواْ","они были",6,157],["يَصۡدِفُونَ","отворачиваются",6,157],[157]]]}