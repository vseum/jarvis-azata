{"p":151,"j":8,"a":[[7,1,["الٓمٓصٓ"],"лмс","Алиф. Лам. Мим. Сад.",["Алиф Лам Мим Сад"]],[7,2,["كِتَٰبٌ","أُنزِلَ","إِلَيۡكَ","فَلَا","يَكُن","فِي","صَدۡرِكَ","حَرَجٞ","مِّنۡهُ","لِتُنذِرَ","بِهِۦ","وَذِكۡرَىٰ","لِلۡمُؤۡمِنِينَ"],"китабун унзила илайка фала йакун фии садрика харажум минху литунзира бихии вазикра лилму'миниин","Тебе ниспослано Писание, которое не должно сжимать твою грудь, дабы ты увещевал им и напоминал верующим.",["Писание","ниспослано","тебе","и пусть не","будет","в","твоей груди","стеснения","из-за него","чтобы ты увещевал","им","и напоминание","для верующих"]],[7,3,["ٱتَّبِعُواْ","مَآ","أُنزِلَ","إِلَيۡكُم","مِّن","رَّبِّكُمۡ","وَلَا","تَتَّبِعُواْ","مِن","دُونِهِۦٓ","أَوۡلِيَآءَۗ","قَلِيلٗا","مَّا","تَذَكَّرُونَ"],"иттаби`уу ма унзила илайкум мир раббикум вала таттаби`уу мин дуунихии аулийаа ḳалиилам ма тазаккаруун","Следуйте за тем, что ниспослано вам от вашего Господа, и не следуйте за иными помощниками, помимо Него. Как же мало вы поминаете назидание!",["следуйте","тому, что","ниспослано","вам","от","вашего Господа","и не","следуйте","из","помимо Него","покровителям","мало","же","вы поминаете"]],[7,4,["وَكَم","مِّن","قَرۡيَةٍ","أَهۡلَكۡنَٰهَا","فَجَآءَهَا","بَأۡسُنَا","بَيَٰتًا","أَوۡ","هُمۡ","قَآئِلُونَ"],"вакам мин ḳарйатин ахлакнаха фажааха ба'суна байатан ау хум ḳаилуун","Сколько же селений Мы погубили! Наше наказание поражало их ночью или во время полуденного отдыха.",["и сколько","из","селений","Мы погубили их","и постигло их","Наше наказание","ночью","или","они","отдыхали в полдень"]],[7,5,["فَمَا","كَانَ","دَعۡوَىٰهُمۡ","إِذۡ","جَآءَهُم","بَأۡسُنَآ","إِلَّآ","أَن","قَالُوٓاْ","إِنَّا","كُنَّا","ظَٰلِمِينَ"],"фама кана да`вахум из жаахум ба'суна илла ан ḳалуу инна кунна залимиин","А когда Наше наказание поражало их, они лишь говорили: «Воистину, мы были несправедливы!».",["и не","было","их возгласом","когда","пришло к ним","Наше наказание","кроме","того, что","они сказали","поистине, мы","были","несправедливыми"]],[7,6,["فَلَنَسۡـَٔلَنَّ","ٱلَّذِينَ","أُرۡسِلَ","إِلَيۡهِمۡ","وَلَنَسۡـَٔلَنَّ","ٱلۡمُرۡسَلِينَ"],"фаланас'аланнал лазиина урсила илайхим валанас'аланнал мурсалиин","Мы непременно спросим тех, к кому были отправлены посланники, и непременно спросим самих посланников.",["и непременно Мы спросим","тех, которым","были посланы","к ним (посланники)","и непременно Мы спросим","посланников"]],[7,7,["فَلَنَقُصَّنَّ","عَلَيۡهِم","بِعِلۡمٖۖ","وَمَا","كُنَّا","غَآئِبِينَ"],"фаланаḳуссанна `алайхим би`илмин вама кунна гаибиин","Мы непременно расскажем им об их деяниях на основании знания. Мы никогда не отсутствовали.",["и непременно Мы расскажем","им","со знанием","и не","были Мы","отсутствующими"]],[7,8,["وَٱلۡوَزۡنُ","يَوۡمَئِذٍ","ٱلۡحَقُّۚ","فَمَن","ثَقُلَتۡ","مَوَٰزِينُهُۥ","فَأُوْلَٰٓئِكَ","هُمُ","ٱلۡمُفۡلِحُونَ"],"валвазну йаумаизинил хаḳḳу фаман саḳулат мавазиинухуу фа'улаика хумул муфлихуун","В тот день взвешивать будут правильно. Те, чья чаша Весов будет перевешивать, окажутся преуспевшими.",["и взвешивание","в тот день","истинно","и у кого","перевесят","его весы","то те","они","преуспевшие"]],[7,9,["وَمَنۡ","خَفَّتۡ","مَوَٰزِينُهُۥ","فَأُوْلَٰٓئِكَ","ٱلَّذِينَ","خَسِرُوٓاْ","أَنفُسَهُم","بِمَا","كَانُواْ","بِـَٔايَٰتِنَا","يَظۡلِمُونَ"],"ваман хаффат мавазиинухуу фа'улаикал лазиина хасируу анфусахум бима кануу би'айатина йазлимуун","Те же, чья чаша Весов окажется легче, потеряют самих себя, поскольку они были несправедливы к Нашим знамениям.",["а у кого","окажутся лёгкими","его весы","то те","те, которые","потеряли","самих себя","за то, что","они были","к Нашим знамениям","несправедливы"]],[7,10,["وَلَقَدۡ","مَكَّنَّٰكُمۡ","فِي","ٱلۡأَرۡضِ","وَجَعَلۡنَا","لَكُمۡ","فِيهَا","مَعَٰيِشَۗ","قَلِيلٗا","مَّا","تَشۡكُرُونَ"],"валаḳад макканнакум фил арди важа`ална лакум фииха ма`айиша ḳалиилам ма ташкуруун","Мы наделили вас властью на земле и определили для вас средства к существованию. Как же мала ваша благодарность!",["и действительно","Мы утвердили вас","на","земле","и Мы сделали","для вас","на ней","средства к жизни","мало","же","вы благодарите"]],[7,11,["وَلَقَدۡ","خَلَقۡنَٰكُمۡ","ثُمَّ","صَوَّرۡنَٰكُمۡ","ثُمَّ","قُلۡنَا","لِلۡمَلَٰٓئِكَةِ","ٱسۡجُدُواْ","لِأٓدَمَ","فَسَجَدُوٓاْ","إِلَّآ","إِبۡلِيسَ","لَمۡ","يَكُن","مِّنَ","ٱلسَّٰجِدِينَ"],"валаḳад халаḳнакум сумма савварнакум сумма ḳулна лилмалаикатисжудуу ли'адама фасажадуу илла иблииса лам йакум минас сажидиин","Мы сотворили вас, потом придали вам облик. Потом Мы сказали ангелам: «Падите ниц перед Адамом!». Они пали ниц, и только Иблис не был в числе поклонившихся.",["и действительно","Мы сотворили вас","затем","Мы придали вам облик","затем","Мы сказали","ангелам","падите ниц","перед Адамом","и пали они ниц","кроме","Иблиса","не","был он","из","падших ниц"]]],"m":[["h",7],["b"],[["الٓمٓصٓ","Алиф Лам Мим Сад",7,1],[1],["كِتَٰبٌ","Писание",7,2],["أُنزِلَ","ниспослано",7,2],["إِلَيۡكَ","тебе",7,2],["فَلَا","и пусть не",7,2],["يَكُن","будет",7,2],["فِي","в",7,2],["صَدۡرِكَ","твоей груди",7,2],["حَرَجٞ","стеснения",7,2],["مِّنۡهُ","из-за него",7,2]],[["لِتُنذِرَ","чтобы ты увещевал",7,2],["بِهِۦ","им",7,2],["وَذِكۡرَىٰ","и напоминание",7,2],["لِلۡمُؤۡمِنِينَ","для верующих",7,2],[2],["ٱتَّبِعُواْ","следуйте",7,3],["مَآ","тому, что",7,3],["أُنزِلَ","ниспослано",7,3],["إِلَيۡكُم","вам",7,3]],[["مِّن","от",7,3],["رَّبِّكُمۡ","вашего Господа",7,3],["وَلَا","и не",7,3],["تَتَّبِعُواْ","следуйте",7,3],["مِن","из",7,3],["دُونِهِۦٓ","помимо Него",7,3],["أَوۡلِيَآءَۗ","покровителям",7,3],["قَلِيلٗا","мало",7,3],["مَّا","же",7,3],["تَذَكَّرُونَ","вы поминаете",7,3],[3]],[["وَكَم","и сколько",7,4],["مِّن","из",7,4],["قَرۡيَةٍ","селений",7,4],["أَهۡلَكۡنَٰهَا","Мы погубили их",7,4],["فَجَآءَهَا","и постигло их",7,4],["بَأۡسُنَا","Наше наказание",7,4],["بَيَٰتًا","ночью",7,4],["أَوۡ","или",7,4],["هُمۡ","они",7,4],["قَآئِلُونَ","отдыхали в полдень",7,4]],[[4],["فَمَا","и не",7,5],["كَانَ","было",7,5],["دَعۡوَىٰهُمۡ","их возгласом",7,5],["إِذۡ","когда",7,5],["جَآءَهُم","пришло к ним",7,5],["بَأۡسُنَآ","Наше наказание",7,5],["إِلَّآ","кроме",7,5],["أَن","того, что",7,5],["قَالُوٓاْ","они сказали",7,5],["إِنَّا","поистине, мы",7,5],["كُنَّا","были",7,5]],[["ظَٰلِمِينَ","несправедливыми",7,5],[5],["فَلَنَسۡـَٔلَنَّ","и непременно Мы спросим",7,6],["ٱلَّذِينَ","тех, которым",7,6],["أُرۡسِلَ","были посланы",7,6],["إِلَيۡهِمۡ","к ним (посланники)",7,6],["وَلَنَسۡـَٔلَنَّ","и непременно Мы спросим",7,6]],[["ٱلۡمُرۡسَلِينَ","посланников",7,6],[6],["فَلَنَقُصَّنَّ","и непременно Мы расскажем",7,7],["عَلَيۡهِم","им",7,7],["بِعِلۡمٖۖ","со знанием",7,7],["وَمَا","и не",7,7],["كُنَّا","были Мы",7,7],["غَآئِبِينَ","отсутствующими",7,7],[7]],[["وَٱلۡوَزۡنُ","и взвешивание",7,8],["يَوۡمَئِذٍ","в тот день",7,8],["ٱلۡحَقُّۚ","истинно",7,8],["فَمَن","и у кого",7,8],["ثَقُلَتۡ","перевесят",7,8],["مَوَٰزِينُهُۥ","его весы",7,8],["فَأُوْلَٰٓئِكَ","то те",7,8],["هُمُ","они",7,8]],[["ٱلۡمُفۡلِحُونَ","преуспевшие",7,8],[8],["وَمَنۡ","а у кого",7,9],["خَفَّتۡ","окажутся лёгкими",7,9],["مَوَٰزِينُهُۥ","его весы",7,9],["فَأُوْلَٰٓئِكَ","то те",7,9],["ٱلَّذِينَ","те, которые",7,9],["خَسِرُوٓاْ","потеряли",7,9]],[["أَنفُسَهُم","самих себя",7,9],["بِمَا","за то, что",7,9],["كَانُواْ","они были",7,9],["بِـَٔايَٰتِنَا","к Нашим знамениям",7,9],["يَظۡلِمُونَ","несправедливы",7,9],[9],["وَلَقَدۡ","и действительно",7,10],["مَكَّنَّٰكُمۡ","Мы утвердили вас",7,10]],[["فِي","на",7,10],["ٱلۡأَرۡضِ","земле",7,10],["وَجَعَلۡنَا","и Мы сделали",7,10],["لَكُمۡ","для вас",7,10],["فِيهَا","на ней",7,10],["مَعَٰيِشَۗ","средства к жизни",7,10],["قَلِيلٗا","мало",7,10],["مَّا","же",7,10],["تَشۡكُرُونَ","вы благодарите",7,10],[10]],[["وَلَقَدۡ","и действительно",7,11],["خَلَقۡنَٰكُمۡ","Мы сотворили вас",7,11],["ثُمَّ","затем",7,11],["صَوَّرۡنَٰكُمۡ","Мы придали вам облик",7,11],["ثُمَّ","затем",7,11],["قُلۡنَا","Мы сказали",7,11],["لِلۡمَلَٰٓئِكَةِ","ангелам",7,11],["ٱسۡجُدُواْ","падите ниц",7,11]],[["لِأٓدَمَ","перед Адамом",7,11],["فَسَجَدُوٓاْ","и пали они ниц",7,11],["إِلَّآ","кроме",7,11],["إِبۡلِيسَ","Иблиса",7,11],["لَمۡ","не",7,11],["يَكُن","был он",7,11],["مِّنَ","из",7,11],["ٱلسَّٰجِدِينَ","падших ниц",7,11],[11]]]}