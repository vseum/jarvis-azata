{"p":153,"j":8,"a":[[7,23,["قَالَا","رَبَّنَا","ظَلَمۡنَآ","أَنفُسَنَا","وَإِن","لَّمۡ","تَغۡفِرۡ","لَنَا","وَتَرۡحَمۡنَا","لَنَكُونَنَّ","مِنَ","ٱلۡخَٰسِرِينَ"],"ḳала раббана заламна анфусана ва'ил лам тагфир лана ватархамна ланакуунанна минал хасириин","Они сказали: «Господь наш! Мы поступили несправедливо по отношению к себе, и если Ты не простишь нас и не смилостивишься над нами, то мы непременно окажемся одними из потерпевших урон».",["сказали они оба","Господь наш","мы обидели","самих себя","и если","не","Ты простишь","нам","и (не) помилуешь нас","непременно мы будем","из","потерпевших убыток"]],[7,24,["قَالَ","ٱهۡبِطُواْ","بَعۡضُكُمۡ","لِبَعۡضٍ","عَدُوّٞۖ","وَلَكُمۡ","فِي","ٱلۡأَرۡضِ","مُسۡتَقَرّٞ","وَمَتَٰعٌ","إِلَىٰ","حِينٖ"],"ḳалахбитуу ба`дукум либа`дин `адуввун валакум фил арди мустаḳаррун вамата`ун ила хиин","Аллах сказал: «Низвергнитесь и будьте врагами друг другу! Земля будет для вас обителью и предметом пользования на некоторое время».",["сказал","низвергнитесь","одни из вас","другим","враг","и для вас","на","земле","пристанище","и пользование","до","времени"]],[7,25,["قَالَ","فِيهَا","تَحۡيَوۡنَ","وَفِيهَا","تَمُوتُونَ","وَمِنۡهَا","تُخۡرَجُونَ"],"ḳала фииха тахйауна вафииха тамуутууна ваминха тухражуун","Аллах сказал: «На ней вы будете жить, на ней будете умирать и из нее будете выведены».",["сказал","на ней","вы будете жить","и на ней","вы будете умирать","и из неё","вы будете выведены"]],[7,26,["يَٰبَنِيٓ","ءَادَمَ","قَدۡ","أَنزَلۡنَا","عَلَيۡكُمۡ","لِبَاسٗا","يُوَٰرِي","سَوۡءَٰتِكُمۡ","وَرِيشٗاۖ","وَلِبَاسُ","ٱلتَّقۡوَىٰ","ذَٰلِكَ","خَيۡرٞۚ","ذَٰلِكَ","مِنۡ","ءَايَٰتِ","ٱللَّهِ","لَعَلَّهُمۡ","يَذَّكَّرُونَ"],"йабании адама ḳад анзална `алайкум либасан йуарии сауатикум вариишан валибасут таḳва залика хайрун залика мин айатиллахи ла`аллахум йаззаккаруун","О сыны Адама! Мы ниспослали вам одеяние для прикрытия ваших срамных мест и украшения. Однако одеяние из богобоязненности - лучше. Таково одно из знамений Аллаха. Быть может, они помянут назидание.",["о сыны","Адама","уже","Мы ниспослали","вам","одеяние","прикрывающее","ваши срамные места","и украшение","но одеяние","богобоязненности","это","лучше","это","из","знамений","Аллаха","быть может, они","помянут назидание"]],[7,27,["يَٰبَنِيٓ","ءَادَمَ","لَا","يَفۡتِنَنَّكُمُ","ٱلشَّيۡطَٰنُ","كَمَآ","أَخۡرَجَ","أَبَوَيۡكُم","مِّنَ","ٱلۡجَنَّةِ","يَنزِعُ","عَنۡهُمَا","لِبَاسَهُمَا","لِيُرِيَهُمَا","سَوۡءَٰتِهِمَآۚ","إِنَّهُۥ","يَرَىٰكُمۡ","هُوَ","وَقَبِيلُهُۥ","مِنۡ","حَيۡثُ","لَا","تَرَوۡنَهُمۡۗ","إِنَّا","جَعَلۡنَا","ٱلشَّيَٰطِينَ","أَوۡلِيَآءَ","لِلَّذِينَ","لَا","يُؤۡمِنُونَ"],"йабании адама ла йафтинаннакумуш шайтану кама ахража абавайкум минал жаннати йанзи`у `анхума либасахума лийурийахума сауатихима иннахуу йаракум хуа ваḳабиилухуу мин хайсу ла тараунахум инна жа`алнаш шайатиина аулийаа лиллазиина ла йу'минуун","О сыны Адама! Не позволяйте дьяволу совратить вас, подобно тому, как он вывел из Рая ваших родителей. Он сорвал с них одежды, чтобы показать им их срамные места. Воистину, он и его сородичи видят вас оттуда, где вы их не видите. Воистину, Мы сделали дьяволов покровителями и помощниками тех, которые не веруют.",["о сыны","Адама","пусть не","соблазнит вас","сатана","как","он вывел","ваших родителей","из","Рая","снимая","с них обоих","их одежду","чтобы показать им","их срамные места","поистине, он","видит вас","он","и его племя","оттуда","где","не","вы видите их","поистине, Мы","сделали","дьяволов","покровителями","для тех, которые","не","веруют"]],[7,28,["وَإِذَا","فَعَلُواْ","فَٰحِشَةٗ","قَالُواْ","وَجَدۡنَا","عَلَيۡهَآ","ءَابَآءَنَا","وَٱللَّهُ","أَمَرَنَا","بِهَاۗ","قُلۡ","إِنَّ","ٱللَّهَ","لَا","يَأۡمُرُ","بِٱلۡفَحۡشَآءِۖ","أَتَقُولُونَ","عَلَى","ٱللَّهِ","مَا","لَا","تَعۡلَمُونَ"],"ва'иза фа`алуу фахишатан ḳалуу важадна `алайха абаана валлаху амарана биха ḳул инналлаха ла йа'муру билфахшаи атаḳуулууна `алаллахи ма ла та`ламуун","Когда они совершают мерзость, они говорят: «Мы видели, что наши отцы поступали таким образом. Аллах повелел нам это». Скажи: «Аллах не велит совершать мерзость. Неужели вы станете наговаривать на Аллаха то, чего не знаете?».",["и когда","они совершают","мерзость","они говорят","мы застали","за этим","наших отцов","и Аллах","повелел нам","это","скажи","поистине","Аллах","не","велит","мерзость","неужели вы говорите","на","Аллаха","то, что","не","вы знаете"]],[7,29,["قُلۡ","أَمَرَ","رَبِّي","بِٱلۡقِسۡطِۖ","وَأَقِيمُواْ","وُجُوهَكُمۡ","عِندَ","كُلِّ","مَسۡجِدٖ","وَٱدۡعُوهُ","مُخۡلِصِينَ","لَهُ","ٱلدِّينَۚ","كَمَا","بَدَأَكُمۡ","تَعُودُونَ"],"ḳул амара раббии билḳисти ва'аḳиимуу вужуухакум `инда кулли масжидин вад`ууху мухлисиина лахуд диина кама бадаакум та`уудуун","Скажи: «Мой Господь велел поступать справедливо». Обращайте к Нему лица в любом месте поклонения и взывайте к Нему, очищая перед Ним веру. Он сотворил вас изначально, и так же вы будете возвращены».",["скажи","повелел","мой Господь","справедливость","и обращайте","ваши лица","при","каждой","мечети","и взывайте к Нему","очищая","для Него","веру","как","Он начал вас","вы вернётесь"]],[7,30,["فَرِيقًا","هَدَىٰ","وَفَرِيقًا","حَقَّ","عَلَيۡهِمُ","ٱلضَّلَٰلَةُۚ","إِنَّهُمُ","ٱتَّخَذُواْ","ٱلشَّيَٰطِينَ","أَوۡلِيَآءَ","مِن","دُونِ","ٱللَّهِ","وَيَحۡسَبُونَ","أَنَّهُم","مُّهۡتَدُونَ"],"фарииḳан хада вафарииḳан хаḳḳа `алайхимуд далалату иннахумуттахазуш шайатиина аулийаа мин дууниллахи вайахсабууна аннахум мухтадуун","Он одних наставил на прямой путь, а другим заслуженно предписал заблуждение. Они сочли дьяволов своими покровителями и помощниками вместо Аллаха и полагают, что следуют прямым путем.",["одних","Он наставил","а других","утвердилось","над ними","заблуждение","поистине, они","взяли","дьяволов","покровителями","из","помимо","Аллаха","и полагают","что они","на прямом пути"]]],"m":[[["قَالَا","сказали они оба",7,23],["رَبَّنَا","Господь наш",7,23],["ظَلَمۡنَآ","мы обидели",7,23],["أَنفُسَنَا","самих себя",7,23],["وَإِن","и если",7,23],["لَّمۡ","не",7,23],["تَغۡفِرۡ","Ты простишь",7,23],["لَنَا","нам",7,23],["وَتَرۡح