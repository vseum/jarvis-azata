{"p":155,"j":8,"a":[[7,38,["قَالَ","ٱدۡخُلُواْ","فِيٓ","أُمَمٖ","قَدۡ","خَلَتۡ","مِن","قَبۡلِكُم","مِّنَ","ٱلۡجِنِّ","وَٱلۡإِنسِ","فِي","ٱلنَّارِۖ","كُلَّمَا","دَخَلَتۡ","أُمَّةٞ","لَّعَنَتۡ","أُخۡتَهَاۖ","حَتَّىٰٓ","إِذَا","ٱدَّارَكُواْ","فِيهَا","جَمِيعٗا","قَالَتۡ","أُخۡرَىٰهُمۡ","لِأُولَىٰهُمۡ","رَبَّنَا","هَٰٓؤُلَآءِ","أَضَلُّونَا","فَـَٔاتِهِمۡ","عَذَابٗا","ضِعۡفٗا","مِّنَ","ٱلنَّارِۖ","قَالَ","لِكُلّٖ","ضِعۡفٞ","وَلَٰكِن","لَّا","تَعۡلَمُونَ"],"ḳаладхулуу фии умамин ḳад халат мин ḳабликум минал жинни вал'инси фин нари куллама дахалат умматул ла`анат ухтаха хатта изаддаракуу фииха жамии`ан ḳалат ухрахум ли'уулахум раббана ха'улаи адаллууна фа'атихим `азабан ди`фам минан нари ḳала ликуллин ди`фун валакил ла та`ламуун","Аллах скажет: «Войдите в Ад вместе с народами из числа людей и джиннов, которые прожили до вас». Каждый раз, когда один народ будет входить туда, он будет проклинать родственный ему народ. Когда же они будут собраны там вместе, то последние из них скажут о первых: «Господь наш! Это они ввели нас в заблуждение. Удвой же их мучения в Огне». Он скажет: «Всем воздастся вдвойне, но вы не знаете этого».",["скажет","войдите","в числе","общин","уже","прошедших","до","вас","из","джиннов","и людей","в","Огонь","всякий раз","входила","община","проклинала она","свою сестру","пока","когда","настигли друг друга","там","все","скажет","последняя из них","о первой из них","Господь наш","эти","сбили нас","так дай им","наказание","двойное","из","Огня","скажет Он","каждому","вдвойне","но","не","вы знаете"]],[7,39,["وَقَالَتۡ","أُولَىٰهُمۡ","لِأُخۡرَىٰهُمۡ","فَمَا","كَانَ","لَكُمۡ","عَلَيۡنَا","مِن","فَضۡلٖ","فَذُوقُواْ","ٱلۡعَذَابَ","بِمَا","كُنتُمۡ","تَكۡسِبُونَ"],"ваḳалат уулахум ли'ухрахум фама кана лакум `алайна мин фадлин фазууḳул `азаба бима кунтум таксибуун","Тогда первые из них скажут последним: «Вы не были лучше нас. Посему вкусите наказание за то, что вы приобретали».",["и скажет","первая из них","последней из них","и не","было","у вас","над нами","никакого","превосходства","вкусите же","наказание","за то, что","вы","приобретали"]],[7,40,["إِنَّ","ٱلَّذِينَ","كَذَّبُواْ","بِـَٔايَٰتِنَا","وَٱسۡتَكۡبَرُواْ","عَنۡهَا","لَا","تُفَتَّحُ","لَهُمۡ","أَبۡوَٰبُ","ٱلسَّمَآءِ","وَلَا","يَدۡخُلُونَ","ٱلۡجَنَّةَ","حَتَّىٰ","يَلِجَ","ٱلۡجَمَلُ","فِي","سَمِّ","ٱلۡخِيَاطِۚ","وَكَذَٰلِكَ","نَجۡزِي","ٱلۡمُجۡرِمِينَ"],"иннал лазиина каззабуу би'айатина вастакбаруу `анха ла туфаттаху лахум абвабус самаи вала йадхулуунал жанната хатта йалижал жамалу фии саммил хийати ваказалика нажзил мужримиин","Воистину, не откроются врата небесные для тех, кто считал ложью Наши знамения и превозносился над ними. Они не войдут в Рай, пока верблюд не пройдет сквозь игольное ушко. Так Мы воздаем грешникам.",["поистине","те, которые","сочли ложью","Наши знамения","и возгордились","перед ними","не","откроются","для них","врата","неба","и не","войдут они","в Рай","пока не","пройдёт","верблюд","в","ушко","иглы","и так","Мы воздаём","грешникам"]],[7,41,["لَهُم","مِّن","جَهَنَّمَ","مِهَادٞ","وَمِن","فَوۡقِهِمۡ","غَوَاشٖۚ","وَكَذَٰلِكَ","نَجۡزِي","ٱلظَّٰلِمِينَ"],"лахум мин жаханнама михадун вамин фауḳихим гавашин ваказалика нажзиз залимиин","Их ложа будут из Геенны, а над ними будут покрывала. Так Мы воздаем беззаконникам.",["у них","из","Геенны","ложе","и","над ними","покрывала","и так","Мы воздаём","несправедливым"]],[7,42,["وَٱلَّذِينَ","ءَامَنُواْ","وَعَمِلُواْ","ٱلصَّٰلِحَٰتِ","لَا","نُكَلِّفُ","نَفۡسًا","إِلَّا","وُسۡعَهَآ","أُوْلَٰٓئِكَ","أَصۡحَٰبُ","ٱلۡجَنَّةِۖ","هُمۡ","فِيهَا","خَٰلِدُونَ"],"валлазиина амануу ва`амилус салихати ла нукаллифу нафсан илла вус`аха улаика асхабул жаннати хум фииха халидуун","Те, которые уверовали и совершали праведные деяния, будут обитателями Рая и пребудут там вечно. Мы не возлагаем на человека сверх его возможностей.",["а те, которые","уверовали","и совершали","праведные деяния","не","Мы возлагаем","на душу","кроме","её возможностей","те","обитатели","Рая","они","в нём","вечно пребывающие"]],[7,43,["وَنَزَعۡنَا","مَا","فِي","صُدُورِهِم","مِّنۡ","غِلّٖ","تَجۡرِي","مِن","تَحۡتِهِمُ","ٱلۡأَنۡهَٰرُۖ","وَقَالُواْ","ٱلۡحَمۡدُ","لِلَّهِ","ٱلَّذِي","هَدَىٰنَا","لِهَٰذَا","وَمَا","كُنَّا","لِنَهۡتَدِيَ","لَوۡلَآ","أَنۡ","هَدَىٰنَا","ٱللَّهُۖ","لَقَدۡ","جَآءَتۡ","رُسُلُ","رَبِّنَا","بِٱلۡحَقِّۖ","وَنُودُوٓاْ","أَن","تِلۡكُمُ","ٱلۡجَنَّةُ","أُورِثۡتُمُوهَا","بِمَا","كُنتُمۡ","تَعۡمَلُونَ"],"ваназа`на ма фии судуурихим мин гиллин тажрии мин тахтихимул анхару ваḳалул хамду лиллахил лазии хадана лихаза вама кунна линахтадийа лаула ан хаданаллаху лаḳад жаат русулу раббина билхаḳḳи вануудуу ан тилкумул жаннату ууристумууха бима кунтум та`малуун","Мы исторгнем из их сердец злобу, и под ними будут протекать реки. Они скажут: «Хвала Аллаху, Который привел нас к этому! Мы не последовали бы прямым путем, если бы Аллах не наставил нас. И посланники Господа нашего принесли истину». Им будет возвещено: «Вот Рай, который вы унаследовали за то, что совершали».",["и Мы исторгнем","то, что","в","их груди","из","злобы","текут","из","под ними","реки","и скажут они","хвала","Аллаху","Который","наставил нас","к этому","и не","были мы","чтобы следовать прямым путём","если бы не","то, что","наставил нас","Аллах","действительно","пришли","посланники","нашего Господа","с истиной","и будет возглашено им","что","вот этот","Рай","вы унаследовали его","за то, что","вы","делали"]]],"m":[[["قَالَ","скажет",7,38],["ٱدۡخُلُواْ","войдите",7,38],["فِيٓ","в числе",7,38],["أُمَمٖ","общин",7,38],["قَدۡ","уже",7,38],["خَلَتۡ","прошедших",7,38],["مِن","до",7,38],["قَبۡلِكُم","вас",7,38],["مِّنَ","из",7,38],["ٱلۡجِنِّ","джиннов",7,38],["وَٱلۡإِنسِ","и людей",7,38]],[["فِي","в",7,38],["ٱلنَّارِۖ","Огонь",7,38],["كُلَّمَا","всякий раз",7,38],["دَخَلَتۡ","входила",7,38],["أُمَّةٞ","община",7,38],["لَّعَنَتۡ","проклинала она",7,38],["أُخۡتَهَاۖ","свою сестру",7,38],["حَتَّىٰٓ","пока",7,38],["إِذَا","когда",7,38],["ٱدَّارَكُواْ","настигли друг друга",7,38],["فِيهَا","там",7,38]],[["جَمِيعٗا","все",7,38],["قَالَتۡ","скажет",7,38],[