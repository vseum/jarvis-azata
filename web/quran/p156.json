{"p":156,"j":8,"a":[[7,44,["وَنَادَىٰٓ","أَصۡحَٰبُ","ٱلۡجَنَّةِ","أَصۡحَٰبَ","ٱلنَّارِ","أَن","قَدۡ","وَجَدۡنَا","مَا","وَعَدَنَا","رَبُّنَا","حَقّٗا","فَهَلۡ","وَجَدتُّم","مَّا","وَعَدَ","رَبُّكُمۡ","حَقّٗاۖ","قَالُواْ","نَعَمۡۚ","فَأَذَّنَ","مُؤَذِّنُۢ","بَيۡنَهُمۡ","أَن","لَّعۡنَةُ","ٱللَّهِ","عَلَى","ٱلظَّٰلِمِينَ"],"ванада асхабул жаннати асхабан нари ан ḳад важадна ма ва`адана раббуна хаḳḳан фахал важадттум ма ва`ада раббукум хаḳḳан ḳалуу на`ам фа'аззана му'аззину байнахум ал ла`натуллахи `алаз залимиин","Обитатели Рая воззовут к обитателям Огня: «Мы уже убедились в том, что обещанное нам нашим Господом - истина. Убедились ли вы в том, что обещанное вашим Господом - истина?». Они скажут: «Да». Тогда глашатай возвестит среди них: «Да пребудет проклятие Аллаха над беззаконниками,",["и воззвали","обитатели","Рая","к обитателям","Огня","что","уже","мы нашли","то, что","обещал нам","наш Господь","истиной","так ли","вы нашли","то, что","обещал","ваш Господь","истиной","сказали они","да","и возвестил","глашатай","между ними","что","проклятие","Аллаха","над","беззаконниками"]],[7,45,["ٱلَّذِينَ","يَصُدُّونَ","عَن","سَبِيلِ","ٱللَّهِ","وَيَبۡغُونَهَا","عِوَجٗا","وَهُم","بِٱلۡأٓخِرَةِ","كَٰفِرُونَ"],"аллазиина йасуддууна `ан сабиилиллахи вайабгуунаха `иважан вахум бил'ахирати кафируун","которые сбивали других с пути Аллаха, пытались исказить его и не верили в Последнюю жизнь».",["те, которые","отвращают","от","пути","Аллаха","и желают ему","кривизны","и они","в Последнюю жизнь","неверующие"]],[7,46,["وَبَيۡنَهُمَا","حِجَابٞۚ","وَعَلَى","ٱلۡأَعۡرَافِ","رِجَالٞ","يَعۡرِفُونَ","كُلَّۢا","بِسِيمَىٰهُمۡۚ","وَنَادَوۡاْ","أَصۡحَٰبَ","ٱلۡجَنَّةِ","أَن","سَلَٰمٌ","عَلَيۡكُمۡۚ","لَمۡ","يَدۡخُلُوهَا","وَهُمۡ","يَطۡمَعُونَ"],"вабайнахума хижабун ва`алал а`рафи рижалун йа`рифууна кулла бисиимахум ванадау асхабал жаннати ан саламун `алайкум лам йадхулууха вахум йатма`уун","Между ними будет изгородь, а на оградах будут люди, которые распознают каждого из них по их признакам. Они воззовут к обитателям Рая: «Мир вам!». Они пока не войдут в Рай, хотя будут желать этого.",["и между ними","преграда","и на","оградах","мужи","узнают","всех","по их признакам","и воззвали они","к обитателям","Рая","что","мир","вам","не","вошли они в него","но они","желают"]],[7,47,["وَإِذَا","صُرِفَتۡ","أَبۡصَٰرُهُمۡ","تِلۡقَآءَ","أَصۡحَٰبِ","ٱلنَّارِ","قَالُواْ","رَبَّنَا","لَا","تَجۡعَلۡنَا","مَعَ","ٱلۡقَوۡمِ","ٱلظَّٰلِمِينَ"],"ва'иза сурифат абсарухум тилḳаа асхабин нари ḳалуу раббана ла таж`ална ма`ал ḳаумиз залимиин","Когда же их взоры обратятся к обитателям Огня, они скажут: «Господь наш! Не помещай нас с людьми несправедливыми!».",["и когда","обращены","их взоры","в сторону","обитателей","Огня","сказали они","Господь наш","не","помещай нас","с","людьми","несправедливыми"]],[7,48,["وَنَادَىٰٓ","أَصۡحَٰبُ","ٱلۡأَعۡرَافِ","رِجَالٗا","يَعۡرِفُونَهُم","بِسِيمَىٰهُمۡ","قَالُواْ","مَآ","أَغۡنَىٰ","عَنكُمۡ","جَمۡعُكُمۡ","وَمَا","كُنتُمۡ","تَسۡتَكۡبِرُونَ"],"ванада асхабул а`рафи рижалан йа`рифуунахум бисиимахум ḳалуу ма агна `анкум жам`укум вама кунтум тастакбируун","Люди на оградах обратятся к мужчинам, которых они узнают по их признакам, и скажут: «Не помогло вам то, что вы собирали, и ваше высокомерие.",["и воззвали","обитатели","оград","к мужам","которых узнают они","по их признакам","сказали они","не","помогло","вам","ваше собирание","и то, что","вы были","кичились"]],[7,49,["أَهَٰٓؤُلَآءِ","ٱلَّذِينَ","أَقۡسَمۡتُمۡ","لَا","يَنَالُهُمُ","ٱللَّهُ","بِرَحۡمَةٍۚ","ٱدۡخُلُواْ","ٱلۡجَنَّةَ","لَا","خَوۡفٌ","عَلَيۡكُمۡ","وَلَآ","أَنتُمۡ","تَحۡزَنُونَ"],"ахаулаил лазиина аḳсамтум ла йаналухумуллаху бирахматинидхулул жанната ла хауфун `алайкум вала антум тахзануун","Разве это не те, о которых вы клялись, что Аллах никогда не проявит к ним милости?». Им будет сказано: «Войдите в Рай! Вы не познаете страха и не будете опечалены».",["разве эти","те, о которых","вы клялись","не","окажет им","Аллах","милости","войдите","в Рай","нет","страха","над вами","и не","вы","опечалитесь"]],[7,50,["وَنَادَىٰٓ","أَصۡحَٰبُ","ٱلنَّارِ","أَصۡحَٰبَ","ٱلۡجَنَّةِ","أَنۡ","أَفِيضُواْ","عَلَيۡنَا","مِنَ","ٱلۡمَآءِ","أَوۡ","مِمَّا","رَزَقَكُمُ","ٱللَّهُۚ","قَالُوٓاْ","إِنَّ","ٱللَّهَ","حَرَّمَهُمَا","عَلَى","ٱلۡكَٰفِرِينَ"],"ванада асхабун нари асхабал жаннати ан афиидуу `алайна минал маи ау мимма разаḳакумуллаху ḳалуу инналлаха харрамахума `алал кафириин","Обитатели Огня воззовут к обитателям Рая: «Пролейте на нас воду или то, чем вас наделил Аллах». Они скажут: «Аллах запретил это для неверующих,",["и воззвали","обитатели","Огня","к обитателям","Рая","что","пролейте","на нас","из","воды","или","из того, что","наделил вас","Аллах","сказали они","поистине","Аллах","запретил их обоих","для","неверующих"]],[7,51,["ٱلَّذِينَ","ٱتَّخَذُواْ","دِينَهُمۡ","لَهۡوٗا","وَلَعِبٗا","وَغَرَّتۡهُمُ","ٱلۡحَيَوٰةُ","ٱلدُّنۡيَاۚ","فَٱلۡيَوۡمَ","نَنسَىٰهُمۡ","كَمَا","نَسُواْ","لِقَآءَ","يَوۡمِهِمۡ","هَٰذَا","وَمَا","كَانُواْ","بِـَٔايَٰتِنَا","يَجۡحَدُونَ"],"аллазиинаттахазуу диинахум лахван вала`ибан вагарратхумул хайаватуд дунйа фалйаума нансахум кама насуу лиḳаа йаумихим хаза вама кануу би'айатина йажхадуун","которые обратили свою религию в потеху и игру и обольстились мирской жизнью». Сегодня Мы предадим их забвению, подобно тому, как они предали забвению встречу в этот день и отвергли Наши знамения.",["те, которые","взяли","свою религию","забавой","и игрой","и обольстила их","жизнь","мирская","и сегодня","Мы забудем их","как","они забыли","встречу","их дня","этого","и как","они были","Наши знамения","отвергали"]]],"m":[[["وَنَادَىٰٓ","и воззвали",7,44],["أَصۡحَٰبُ","обитатели",7,44],["ٱلۡجَنَّةِ","Рая",7,44],["أَصۡحَٰبَ","к обитателям",7,44],["ٱلنَّارِ","Огня",7,44],["أَن","что",7,44],["قَدۡ","уже",7,44],["وَجَدۡنَا","мы нашли",7,44],["مَا","то, что",7,44],["وَعَدَنَا","обещал нам",7,44],["رَبُّنَا","наш Господь",7,44],["حَقّٗا","истиной",7,44]],[["فَهَلۡ","так ли",7,44],["وَجَدتُّم","вы нашли",7,44],["مَّا","то, что",7,44],["وَعَدَ","обещал",7,44],["رَبُّكُمۡ","ваш Господь",7,44],["حَقّٗاۖ","истиной",7,44],["قَالُواْ","сказали они",7,44],["نَعَمۡۚ","да",7,44],["فَأَذَّنَ","и возвестил",7,44],["مُؤَذِّنُۢ","глашатай",7,44],["بَيۡنَهُمۡ","между ними",7,44],["أَن","что",7,44]],[["لَّعۡنَةُ","проклятие",7,44],["ٱللَّهِ","Аллаха",7,44],["عَلَى","над",7,44],["ٱلظَّٰلِمِينَ","беззаконниками",7,44],[44],["ٱلَّذِينَ","те, которые",7,45],["يَصُدُّونَ","отвращают",7,45],["عَن","от",7,45],["سَبِيلِ","пути",7,45],["ٱللَّهِ","Аллаха",7,45],["وَيَبۡغُونَهَا","и желают ему",7,45]],[["عِوَجٗا","кривизны",7,45],["وَهُم","и они",7,45],["بِٱلۡأٓخِرَةِ","в Последнюю жизнь",7,45],["كَٰفِرُونَ","неверующие",7,45],[45],["وَبَيۡنَهُمَا","и между ними",7,46],["حِجَابٞۚ","преграда",7,46],["وَعَلَى","и на",7,46],["ٱلۡأَعۡرَافِ","оградах",7,46]],[["رِجَالٞ","мужи",7,46],["يَعۡرِفُونَ","узнают",7,46],["كُلَّۢا","всех",7,46],["بِسِيمَىٰهُمۡۚ","по их признакам",7,46],["وَنَادَوۡاْ","и воззвали они",7,46],["أَصۡحَٰبَ","к обитателям",7,46],["ٱلۡجَنَّةِ","Рая",7,46],["أَن","что",7,46],["سَلَٰمٌ","мир",7,46],["عَلَيۡكُمۡۚ","вам",7,46]],[["لَمۡ","не",7,46],["يَدۡخُلُوهَا","вошли они в него",7,46],["وَهُمۡ","но они",7,46],["يَطۡمَعُونَ","желают",7,46],[46],["۞ وَإِذَا","и когда",7,47],["صُرِفَتۡ","обращены",7,47],["أَبۡصَٰرُهُمۡ","их взоры",7,47],["تِلۡقَآءَ","в сторону",7,47]],[["أَصۡحَٰبِ","обитателей",7,47],["ٱلنَّارِ","Огня",7,47],["قَالُواْ","сказали они",7,47],["رَبَّنَا","Господь наш",7,47],["لَا","не",7,47],["تَجۡعَلۡنَا","помещай нас",7,47],["مَعَ","с",7,47],["ٱلۡقَوۡمِ","людьми",7,47],["ٱلظَّٰلِمِينَ","несправедливыми",7,47],[47],["وَنَادَىٰٓ","и воззвали",7,48],["أَصۡحَٰبُ","обитатели",7,48]],[["ٱلۡأَعۡرَافِ","оград",7,48],["رِجَالٗا","к мужам",7,48],["يَعۡرِفُونَهُم","которых узнают они",7,48],["بِسِيمَىٰهُمۡ","по их признакам",7,48],["قَالُواْ","сказали они",7,48],["مَآ","не",7,48],["أَغۡنَىٰ","помогло",7,48],["عَنكُمۡ","вам",7,48],["جَمۡعُكُمۡ","ваше собирание",7,48]],[["وَمَا","и то, что",7,48],["كُنتُمۡ","вы были",7,48],["تَسۡتَكۡبِرُونَ","кичились",7,48],[48],["أَهَٰٓؤُلَآءِ","разве эти",7,49],["ٱلَّذِينَ","те, о которых",7,49],["أَقۡسَمۡتُمۡ","вы клялись",7,49],["لَا","не",7,49],["يَنَالُهُمُ","окажет им",7,49]],[["ٱللَّهُ","Аллах",7,49],["بِرَحۡمَةٍۚ","милости",7,49],["ٱدۡخُلُواْ","войдите",7,49],["ٱلۡجَنَّةَ","в Рай",7,49],["لَا","нет",7,49],["خَوۡفٌ","страха",7,49],["عَلَيۡكُمۡ","над вами",7,49],["وَلَآ","и не",7,49],["أَنتُمۡ","вы",7,49],["تَحۡزَنُونَ","опечалитесь",7,49]],[[49],["وَنَادَىٰٓ","и воззвали",7,50],["أَصۡحَٰبُ","обитатели",7,50],["ٱلنَّارِ","Огня",7,50],["أَصۡحَٰبَ","к обитателям",7,50],["ٱلۡجَنَّةِ","Рая",7,50],["أَنۡ","что",7,50],["أَفِيضُواْ","пролейте",7,50],["عَلَيۡنَا","на нас",7,50]],[["مِنَ","из",7,50],["ٱلۡمَآءِ","воды",7,50],["أَوۡ","или",7,50],["مِمَّا","из того, что",7,50],["رَزَقَكُمُ","наделил вас",7,50],["ٱللَّهُۚ","Аллах",7,50],["قَالُوٓاْ","сказали они",7,50],["إِنَّ","поистине",7,50],["ٱللَّهَ","Аллах",7,50],["حَرَّمَهُمَا","запретил их обоих",7,50],["عَلَى","для",7,50]],[["ٱلۡكَٰفِرِينَ","неверующих",7,50],[50],["ٱلَّذِينَ","те, которые",7,51],["ٱتَّخَذُواْ","взяли",7,51],["دِينَهُمۡ","свою религию",7,51],["لَهۡوٗا","забавой",7,51],["وَلَعِبٗا","и игрой",7,51]],[["وَغَرَّتۡهُمُ","и обольстила их",7,51],["ٱلۡحَيَوٰةُ","жизнь",7,51],["ٱلدُّنۡيَاۚ","мирская",7,51],["فَٱلۡيَوۡمَ","и сегодня",7,51],["نَنسَىٰهُمۡ","Мы забудем их",7,51],["كَمَا","как",7,51],["نَسُواْ","они забыли",7,51]],[["لِقَآءَ","встречу",7,51],["يَوۡمِهِمۡ","их дня",7,51],["هَٰذَا","этого",7,51],["وَمَا","и как",7,51],["كَانُواْ","они были",7,51],["بِـَٔايَٰتِنَا","Наши знамения",7,51],["يَجۡحَدُونَ","отвергали",7,51],[51]]]}