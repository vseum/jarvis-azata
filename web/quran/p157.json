{"p":157,"j":8,"a":[[7,52,["وَلَقَدۡ","جِئۡنَٰهُم","بِكِتَٰبٖ","فَصَّلۡنَٰهُ","عَلَىٰ","عِلۡمٍ","هُدٗى","وَرَحۡمَةٗ","لِّقَوۡمٖ","يُؤۡمِنُونَ"],"валаḳад жи'нахум бикитабин фассалнаху `ала `илмин худан варахматал лиḳаумин йу'минуун","Мы преподнесли им Писание, которое разъяснили на основании знания, как верное руководство и милость для верующих людей.",["и ведь уже","Мы принесли им","Писание","Мы разъяснили его","на основе","знания","руководством","и милостью","для людей","которые веруют"]],[7,53,["هَلۡ","يَنظُرُونَ","إِلَّا","تَأۡوِيلَهُۥۚ","يَوۡمَ","يَأۡتِي","تَأۡوِيلُهُۥ","يَقُولُ","ٱلَّذِينَ","نَسُوهُ","مِن","قَبۡلُ","قَدۡ","جَآءَتۡ","رُسُلُ","رَبِّنَا","بِٱلۡحَقِّ","فَهَل","لَّنَا","مِن","شُفَعَآءَ","فَيَشۡفَعُواْ","لَنَآ","أَوۡ","نُرَدُّ","فَنَعۡمَلَ","غَيۡرَ","ٱلَّذِي","كُنَّا","نَعۡمَلُۚ","قَدۡ","خَسِرُوٓاْ","أَنفُسَهُمۡ","وَضَلَّ","عَنۡهُم","مَّا","كَانُواْ","يَفۡتَرُونَ"],"хал йанзурууна илла та'виилахуу йаума йа'тии та'виилухуу йаḳуулул лазиина насууху мин ḳаблу ḳад жаат русулу раббина билхаḳḳи фахал лана мин шуфа`аа файашфа`уу лана ау нурадду фана`мала гайрал лазии кунна на`малу ḳад хасируу анфусахум вадалла `анхум ма кануу йафтаруун","Неужели они дожидаются чего-либо, кроме исполнения пророчества? В тот день, когда оно исполнится, те, которые предали его забвению прежде, скажут: «Посланники нашего Господа принесли истину. Найдутся ли для нас заступники, которые заступились бы за нас? И не вернут ли нас обратно, чтобы мы совершили не то, что совершили прежде?». Они потеряют самих себя, и покинет их (или исчезнет) то, что они измышляли.",["разве","ждут они","кроме","его исполнения","в день","придёт","его исполнение","скажут","те, которые","забыли его","из","прежде","уже","пришли","посланники","нашего Господа","с истиной","так есть ли","у нас","какие-либо","заступники","и заступятся они","за нас","или","нас вернут","и мы сделаем","иное","чем то, что","мы были","делали","уже","погубили они","самих себя","и исчезло","от них","то, что","они были","измышляли"]],[7,54,["إِنَّ","رَبَّكُمُ","ٱللَّهُ","ٱلَّذِي","خَلَقَ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضَ","فِي","سِتَّةِ","أَيَّامٖ","ثُمَّ","ٱسۡتَوَىٰ","عَلَى","ٱلۡعَرۡشِۖ","يُغۡشِي","ٱلَّيۡلَ","ٱلنَّهَارَ","يَطۡلُبُهُۥ","حَثِيثٗا","وَٱلشَّمۡسَ","وَٱلۡقَمَرَ","وَٱلنُّجُومَ","مُسَخَّرَٰتِۭ","بِأَمۡرِهِۦٓۗ","أَلَا","لَهُ","ٱلۡخَلۡقُ","وَٱلۡأَمۡرُۗ","تَبَارَكَ","ٱللَّهُ","رَبُّ","ٱلۡعَٰلَمِينَ"],"инна раббакумуллахул лазии халаḳас самавати вал'арда фии ситтати аййамин суммастава `алал `арши йугшил лайлан нахара йатлубухуу хасиисан вашшамса валḳамара ваннужуума мусаххарати би'амрихии ала лахул халḳу вал'амру табаракаллаху раббул `аламиин","Воистину, ваш Господь - Аллах, Который сотворил небеса и землю за шесть дней, а затем вознесся на Трон (или утвердился на Троне). Он покрывает ночью день, который поспешно за ней следует. Солнце, луна и звезды - все они покорны Его воле. Несомненно, Он творит и повелевает. Благословен Аллах, Господь миров!",["поистине","ваш Господь","Аллах","Который","сотворил","небеса","и землю","за","шесть","дней","затем","вознёсся","на","Трон","покрывает Он","ночью","день","преследуя его","стремительно","и солнце","и луну","и звёзды","подчинёнными","Его повелением","о да","Ему","творение","и повеление","благословен","Аллах","Господь","миров"]],[7,55,["ٱدۡعُواْ","رَبَّكُمۡ","تَضَرُّعٗا","وَخُفۡيَةًۚ","إِنَّهُۥ","لَا","يُحِبُّ","ٱلۡمُعۡتَدِينَ"],"ид`уу раббакум тадарру`ан вахуфйатан иннахуу ла йухиббул му`тадиин","Взывайте к Господу своему со смирением и в тайне. Воистину, Он не любит преступников.",["взывайте","к Господу вашему","смиренно","и тайно","поистине, Он","не","любит","преступающих"]],[7,56,["وَلَا","تُفۡسِدُواْ","فِي","ٱلۡأَرۡضِ","بَعۡدَ","إِصۡلَٰحِهَا","وَٱدۡعُوهُ","خَوۡفٗا","وَطَمَعًاۚ","إِنَّ","رَحۡمَتَ","ٱللَّهِ","قَرِيبٞ","مِّنَ","ٱلۡمُحۡسِنِينَ"],"вала туфсидуу фил арди ба`да ислахиха вад`ууху хауфан ватама`ан инна рахматаллахи ḳариибум минал мухсиниин","Не распространяйте нечестия на земле после того, как она приведена в порядок. Взывайте к Нему со страхом и надеждой. Воистину, милость Аллаха близка к творящим добро.",["и не","распространяйте нечестие","на","земле","после","её благоустройства","и взывайте к Нему","со страхом","и надеждой","поистине","милость","Аллаха","близка","к","творящим добро"]],[7,57,["وَهُوَ","ٱلَّذِي","يُرۡسِلُ","ٱلرِّيَٰحَ","بُشۡرَۢا","بَيۡنَ","يَدَيۡ","رَحۡمَتِهِۦۖ","حَتَّىٰٓ","إِذَآ","أَقَلَّتۡ","سَحَابٗا","ثِقَالٗا","سُقۡنَٰهُ","لِبَلَدٖ","مَّيِّتٖ","فَأَنزَلۡنَا","بِهِ","ٱلۡمَآءَ","فَأَخۡرَجۡنَا","بِهِۦ","مِن","كُلِّ","ٱلثَّمَرَٰتِۚ","كَذَٰلِكَ","نُخۡرِجُ","ٱلۡمَوۡتَىٰ","لَعَلَّكُمۡ","تَذَكَّرُونَ"],"вахуал лазии йурсилур рийаха бушра байна йадай рахматихии хатта иза аḳаллат сахабан сиḳалан суḳнаху либаладим маййитин фа'анзална бихил маа фа'ахражна бихии мин куллис самарати казалика нухрижул маута ла`аллакум тазаккаруун","Он - Тот, Кто направляет ветры добрыми вестниками Своей милости. Когда же они приносят тяжелые облака, Мы пригоняем их к мертвой земле, проливаем воду и посредством этого взращиваем всевозможные плоды. Таким же образом Мы воскрешаем мертвых. Быть может, вы помяните назидание.",["и Он","Тот, Который","посылает","ветры","благовестниками","перед","лицом","Его милости","пока","когда","подняли они","облака","тяжёлые","Мы погнали их","к земле","мёртвой","и Мы ниспослали","на неё","воду","и Мы вывели","ею","из","всех","плодов","так","Мы выводим","мёртвых","может быть, вы","помянете назидание"]]],"m":[[["وَلَقَدۡ","и ведь уже",7,52],["جِئۡنَٰهُم","Мы принесли им",7,52],["بِكِتَٰبٖ","Писание",7,52],["فَصَّلۡنَٰهُ","Мы разъяснили его",7,52],["عَلَىٰ","на основе",7,52],["عِلۡمٍ","знания",7,52],["هُدٗى","руководством",7,52],["وَرَحۡمَةٗ","и милостью",7,52],["لِّقَوۡمٖ","для людей",7,52]],[["يُؤۡمِنُونَ","которые веруют",7,52],[52],["هَلۡ","разве",7,53],["يَنظُرُونَ","ждут они",7,53],["إِلَّا","кроме",7,53],["تَأۡوِيلَهُۥۚ","его исполнения",7,53],["يَوۡمَ","в день",7,53],["يَأۡتِي","придёт",7,53],["تَأۡوِيلُهُۥ","его исполнение",7,53],["يَقُولُ","скажут",7,53]],[["ٱلَّذِين