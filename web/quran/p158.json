{"p":158,"j":8,"a":[[7,58,["وَٱلۡبَلَدُ","ٱلطَّيِّبُ","يَخۡرُجُ","نَبَاتُهُۥ","بِإِذۡنِ","رَبِّهِۦۖ","وَٱلَّذِي","خَبُثَ","لَا","يَخۡرُجُ","إِلَّا","نَكِدٗاۚ","كَذَٰلِكَ","نُصَرِّفُ","ٱلۡأٓيَٰتِ","لِقَوۡمٖ","يَشۡكُرُونَ"],"валбаладут таййибу йахружу набатухуу би'изни раббихии валлазии хабуса ла йахружу илла накидан казалика нусаррифул айати лиḳаумин йашкуруун","На хорошей земле растения растут по воле ее Господа, а на плохой земле они растут с трудом. Так Мы разъясняем знамения для благодарных людей.",["и земля","хорошая","выходит","её растительность","с дозволения","её Господа","а та, которая","плоха","не","выходит","кроме как","скудной","так","Мы разъясняем","знамения","для людей","которые благодарны"]],[7,59,["لَقَدۡ","أَرۡسَلۡنَا","نُوحًا","إِلَىٰ","قَوۡمِهِۦ","فَقَالَ","يَٰقَوۡمِ","ٱعۡبُدُواْ","ٱللَّهَ","مَا","لَكُم","مِّنۡ","إِلَٰهٍ","غَيۡرُهُۥٓ","إِنِّيٓ","أَخَافُ","عَلَيۡكُمۡ","عَذَابَ","يَوۡمٍ","عَظِيمٖ"],"лаḳад арсална нуухан ила ḳаумихии фаḳала йаḳауми`будуллаха ма лакум мин илахин гайрухуу иннии ахафу `алайкум `азаба йаумин `азиим","Мы послали Нуха (Ноя) к его народу, и он сказал: «О мой народ! Поклоняйтесь Аллаху, ибо нет у вас другого божества, кроме Него. Я боюсь, что вас постигнут мучения в Великий день».",["уже","Мы послали","Нуха","к","его народу","и сказал он","о народ мой","поклоняйтесь","Аллаху","нет","у вас","никакого","божества","кроме Него","поистине, я","боюсь","за вас","мучения","дня","великого"]],[7,60,["قَالَ","ٱلۡمَلَأُ","مِن","قَوۡمِهِۦٓ","إِنَّا","لَنَرَىٰكَ","فِي","ضَلَٰلٖ","مُّبِينٖ"],"ḳалал малау мин ḳаумихии инна ланарака фии далалим мубиин","Знатные люди из его народа сказали: «Мы видим, что ты находишься в очевидном заблуждении».",["сказала","знать","из","его народа","поистине, мы","непременно видим тебя","в","заблуждении","явном"]],[7,61,["قَالَ","يَٰقَوۡمِ","لَيۡسَ","بِي","ضَلَٰلَةٞ","وَلَٰكِنِّي","رَسُولٞ","مِّن","رَّبِّ","ٱلۡعَٰلَمِينَ"],"ḳала йаḳауми лайса бии далалатун валакиннии расуулум мир раббил `аламиин","Он сказал: «О мой народ! Я не заблуждаюсь. Напротив, я - посланник Господа миров.",["сказал он","о народ мой","нет","во мне","заблуждения","но я","посланник","от","Господа","миров"]],[7,62,["أُبَلِّغُكُمۡ","رِسَٰلَٰتِ","رَبِّي","وَأَنصَحُ","لَكُمۡ","وَأَعۡلَمُ","مِنَ","ٱللَّهِ","مَا","لَا","تَعۡلَمُونَ"],"убаллигукум рисалати раббии ва'ансаху лакум ва'а`ламу миналлахи ма ла та`ламуун","Я сообщаю вам послания моего Господа и даю вам искренние советы. Я узнаю от Аллаха то, чего вы не знаете.",["я передаю вам","послания","моего Господа","и я советую","вам","и я знаю","от","Аллаха","то, что","не","вы знаете"]],[7,63,["أَوَعَجِبۡتُمۡ","أَن","جَآءَكُمۡ","ذِكۡرٞ","مِّن","رَّبِّكُمۡ","عَلَىٰ","رَجُلٖ","مِّنكُمۡ","لِيُنذِرَكُمۡ","وَلِتَتَّقُواْ","وَلَعَلَّكُمۡ","تُرۡحَمُونَ"],"ава`ажибтум ан жаакум зикрум мир раббикум `ала ражулим минкум лийунзиракум валитаттаḳуу вала`аллакум турхамуун","Неужели вы удивляетесь тому, что напоминание от вашего Господа явилось к вам через мужчину из вашей среды, чтобы он мог предостеречь вас и чтобы вы стали богобоязненны? Быть может, тогда вы будете помилованы».",["разве удивились вы","что","пришло к вам","напоминание","от","вашего Господа","через","мужа","из вас","чтобы он предостерёг вас","и чтобы вы остерегались","и может быть, вы","будете помилованы"]],[7,64,["فَكَذَّبُوهُ","فَأَنجَيۡنَٰهُ","وَٱلَّذِينَ","مَعَهُۥ","فِي","ٱلۡفُلۡكِ","وَأَغۡرَقۡنَا","ٱلَّذِينَ","كَذَّبُواْ","بِـَٔايَٰتِنَآۚ","إِنَّهُمۡ","كَانُواْ","قَوۡمًا","عَمِينَ"],"факаззабууху фа'анжайнаху валлазиина ма`ахуу фил фулки ва'аграḳнал лазиина каззабуу би'айатина иннахум кануу ḳауман `амиин","Они сочли его лжецом, а Мы спасли его и тех, кто был с ним, в ковчеге, и потопили тех, кто счел ложью Наши знамения. Воистину, они были слепыми людьми.",["и сочли его лжецом","и Мы спасли его","и тех, которые","с ним","в","ковчеге","и Мы потопили","тех, которые","сочли ложью","Наши знамения","поистине, они","были","людьми","слепыми"]],[7,65,["وَإِلَىٰ","عَادٍ","أَخَاهُمۡ","هُودٗاۚ","قَالَ","يَٰقَوۡمِ","ٱعۡبُدُواْ","ٱللَّهَ","مَا","لَكُم","مِّنۡ","إِلَٰهٍ","غَيۡرُهُۥٓۚ","أَفَلَا","تَتَّقُونَ"],"ва'ила `адин ахахум хуудан ḳала йаḳауми`будуллаха ма лакум мин илахин гайрухуу афала таттаḳуун","Мы отправили к адитам их брата Худа. Он сказал: «О мой народ! Поклоняйтесь Аллаху, ибо нет у вас другого божества, кроме Него. Неужели вы не устрашитесь?».",["и к","адитам","брата их","Худа","сказал он","о народ мой","поклоняйтесь","Аллаху","нет","у вас","никакого","божества","кроме Него","разве же не","устрашитесь вы"]],[7,66,["قَالَ","ٱلۡمَلَأُ","ٱلَّذِينَ","كَفَرُواْ","مِن","قَوۡمِهِۦٓ","إِنَّا","لَنَرَىٰكَ","فِي","سَفَاهَةٖ","وَإِنَّا","لَنَظُنُّكَ","مِنَ","ٱلۡكَٰذِبِينَ"],"ḳалал малаул лазиина кафаруу мин ḳаумихии инна ланарака фии сафахатин ва'инна ланазуннука минал казибиин","Знатные люди из его народа, которые не уверовали, сказали: «Мы видим, что ты глупец, и считаем тебя одним из лжецов».",["сказала","знать","те, которые","не уверовали","из","его народа","поистине, мы","непременно видим тебя","в","глупости","и поистине, мы","непременно считаем тебя","из","лжецов"]],[7,67,["قَالَ","يَٰقَوۡمِ","لَيۡسَ","بِي","سَفَاهَةٞ","وَلَٰكِنِّي","رَسُولٞ","مِّن","رَّبِّ","ٱلۡعَٰلَمِينَ"],"ḳала йаḳауми лайса бии сафахатун валакиннии расуулум мир раббил `аламиин","Он сказал: «О мой народ! Я не являюсь глупцом, а являюсь посланником Господа миров.",["сказал он","о народ мой","нет","во мне","глупости","но я","посланник","от","Господа","миров"]]],"m":[[["وَٱلۡبَلَدُ","и земля",7,58],["ٱلطَّيِّبُ","хорошая",7,58],["يَخۡرُجُ","выходит",7,58],["نَبَاتُهُۥ","её растительность",7,58],["بِإِذۡنِ","с дозволения",7,58],["رَبِّهِۦۖ","её Господа",7,58],["وَٱلَّذِي","а та, которая",7,58],["خَبُثَ","плоха",7,58],["لَا","не",7,58],["يَخۡرُجُ","выходит",7,58]],[["إِلَّا","кроме как",7,58],["نَكِدٗاۚ","скудной",7,58],["كَذَٰلِكَ","так",7,58],["نُصَرِّفُ","Мы разъясняем",7,58],["ٱلۡأٓيَٰتِ","знамения",7,58],["لِقَوۡمٖ","для людей",7,58],["يَشۡكُرُونَ","которые благодарны",7,58],[58]],[["لَقَدۡ","уже",7,59],["أَرۡسَلۡنَا","Мы послали",7,59],["نُوحًا","Нуха",7,59],["إِلَىٰ","к",7,59],["قَوۡمِهِۦ","его народу",7,59],["فَقَالَ","и сказал он",7,59],["يَٰقَوۡمِ","о народ мой",7,59],["ٱعۡبُدُواْ","поклоняйтесь",7,59],["ٱللَّهَ","Аллаху",7,59],["مَا","нет",7,59],["لَكُم","у вас",7,59]],[["مِّنۡ","никакого",7,59],["إِلَٰهٍ","божества",7,59],["غَيۡرُهُۥٓ","кроме Него",7,59],["إِنِّيٓ","поистине, я",7,59],["أَخَافُ","боюсь",7,59],["عَلَيۡكُمۡ","за вас",7,59],["عَذَابَ","мучения",7,59],["يَوۡمٍ","дня",7,59],["عَظِيمٖ","великого",7,59],[59]],[["قَالَ","сказала",7,60],["ٱلۡمَلَأُ","знать",7,60],["مِن","из",7,60],["قَوۡمِهِۦٓ","его народа",7,60],["إِنَّا","поистине, мы",7,60],["لَنَرَىٰكَ","непременно видим тебя",7,60],["فِي","в",7,60],["ضَلَٰلٖ","заблуждении",7,60],["مُّبِينٖ","явном",7,60],[60],["قَالَ","сказал он",7,61]],[["يَٰقَوۡمِ","о народ мой",7,61],["لَيۡسَ","нет",7,61],["بِي","во мне",7,61],["ضَلَٰلَةٞ","заблуждения",7,61],["وَلَٰكِنِّي","но я",7,61],["رَسُولٞ","посланник",7,61],["مِّن","от",7,61],["رَّبِّ","Господа",7,61],["ٱلۡعَٰلَمِينَ","миров",7,61]],[[61],["أُبَلِّغُكُمۡ","я передаю вам",7,62],["رِسَٰلَٰتِ","послания",7,62],["رَبِّي","моего Господа",7,62],["وَأَنصَحُ","и я советую",7,62],["لَكُمۡ","вам",7,62],["وَأَعۡلَمُ","и я знаю",7,62],["مِنَ","от",7,62],["ٱللَّهِ","Аллаха",7,62]],[["مَا","то, что",7,62],["لَا","не",7,62],["تَعۡلَمُونَ","вы знаете",7,62],[62],["أَوَعَجِبۡتُمۡ","разве удивились вы",7,63],["أَن","что",7,63],["جَآءَكُمۡ","пришло к вам",7,63],["ذِكۡرٞ","напоминание",7,63],["مِّن","от",7,63],["رَّبِّكُمۡ","вашего Господа",7,63],["عَلَىٰ","через",7,63]],[["رَجُلٖ","мужа",7,63],["مِّنكُمۡ","из вас",7,63],["لِيُنذِرَكُمۡ","чтобы он предостерёг вас",7,63],["وَلِتَتَّقُواْ","и чтобы вы остерегались",7,63],["وَلَعَلَّكُمۡ","и может быть, вы",7,63],["تُرۡحَمُونَ","будете помилованы",7,63],[63],["فَكَذَّبُوهُ","и сочли его лжецом",7,64]],[["فَأَنجَيۡنَٰهُ","и Мы спасли его",7,64],["وَٱلَّذِينَ","и тех, которые",7,64],["مَعَهُۥ","с ним",7,64],["فِي","в",7,64],["ٱلۡفُلۡكِ","ковчеге",7,64],["وَأَغۡرَقۡنَا","и Мы потопили",7,64],["ٱلَّذِينَ","тех, которые",7,64],["كَذَّبُواْ","сочли ложью",7,64]],[["بِـَٔايَٰتِنَآۚ","Наши знамения",7,64],["إِنَّهُمۡ","поистине, они",7,64],["كَانُواْ","были",7,64],["قَوۡمًا","людьми",7,64],["عَمِينَ","слепыми",7,64],[64],["۞ وَإِلَىٰ","и к",7,65],["عَادٍ","адитам",7,65],["أَخَاهُمۡ","брата их",7,65]],[["هُودٗاۚ","Худа",7,65],["قَالَ","сказал он",7,65],["يَٰقَوۡمِ","о народ мой",7,65],["ٱعۡبُدُواْ","поклоняйтесь",7,65],["ٱللَّهَ","Аллаху",7,65],["مَا","нет",7,65],["لَكُم","у вас",7,65],["مِّنۡ","никакого",7,65],["إِلَٰهٍ","божества",7,65],["غَيۡرُهُۥٓۚ","кроме Него",7,65],["أَفَلَا","разве же не",7,65],["تَتَّقُونَ","устрашитесь вы",7,65]],[[65],["قَالَ","сказала",7,66],["ٱلۡمَلَأُ","знать",7,66],["ٱلَّذِينَ","те, которые",7,66],["كَفَرُواْ","не уверовали",7,66],["مِن","из",7,66],["قَوۡمِهِۦٓ","его народа",7,66],["إِنَّا","поистине, мы",7,66],["لَنَرَىٰكَ","непременно видим тебя",7,66],["فِي","в",7,66]],[["سَفَاهَةٖ","глупости",7,66],["وَإِنَّا","и поистине, мы",7,66],["لَنَظُنُّكَ","непременно считаем тебя",7,66],["مِنَ","из",7,66],["ٱلۡكَٰذِبِينَ","лжецов",7,66],[66],["قَالَ","сказал он",7,67],["يَٰقَوۡمِ","о народ мой",7,67]],[["لَيۡسَ","нет",7,67],["بِي","во мне",7,67],["سَفَاهَةٞ","глупости",7,67],["وَلَٰكِنِّي","но я",7,67],["رَسُولٞ","посланник",7,67],["مِّن","от",7,67],["رَّبِّ","Господа",7,67],["ٱلۡعَٰلَمِينَ","миров",7,67],[67]]]}