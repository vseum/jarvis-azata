{"p":159,"j":8,"a":[[7,68,["أُبَلِّغُكُمۡ","رِسَٰلَٰتِ","رَبِّي","وَأَنَا۠","لَكُمۡ","نَاصِحٌ","أَمِينٌ"],"убаллигукум рисалати раббии ва'ана лакум насихун амиин","Я доношу до вас послания от вашего Господа, и я для вас - надежный и добрый советчик.",["я передаю вам","послания","моего Господа","и я","для вас","советчик","надёжный"]],[7,69,["أَوَعَجِبۡتُمۡ","أَن","جَآءَكُمۡ","ذِكۡرٞ","مِّن","رَّبِّكُمۡ","عَلَىٰ","رَجُلٖ","مِّنكُمۡ","لِيُنذِرَكُمۡۚ","وَٱذۡكُرُوٓاْ","إِذۡ","جَعَلَكُمۡ","خُلَفَآءَ","مِنۢ","بَعۡدِ","قَوۡمِ","نُوحٖ","وَزَادَكُمۡ","فِي","ٱلۡخَلۡقِ","بَصۜۡطَةٗۖ","فَٱذۡكُرُوٓاْ","ءَالَآءَ","ٱللَّهِ","لَعَلَّكُمۡ","تُفۡلِحُونَ"],"ава`ажибтум ан жаакум зикрум мир раббикум `ала ражулим минкум лийунзиракум вазкуруу из жа`алакум хулафаа мим ба`ди ḳауми нуухин вазадакум фил халḳи бастатан фазкуруу алааллахи ла`аллакум туфлихуун","Неужели вы удивляетесь тому, что напоминание от вашего Господа дошло до вас через мужчину, который является одним из вас, чтобы он мог предостеречь вас? Помните о том, как Он сделал вас преемниками народа Нуха (Ноя) и сделал вас еще более рослыми. Помните о милостях Аллаха, - быть может, вы преуспеете».",["разве удивились вы","что","пришло к вам","напоминание","от","вашего Господа","через","мужа","из вас","чтобы он предостерёг вас","и помните","как","Он сделал вас","преемниками","из","после","народа","Нуха","и увеличил вас","в","сложении","величиной","так помните","милости","Аллаха","может быть, вы","преуспеете"]],[7,70,["قَالُوٓاْ","أَجِئۡتَنَا","لِنَعۡبُدَ","ٱللَّهَ","وَحۡدَهُۥ","وَنَذَرَ","مَا","كَانَ","يَعۡبُدُ","ءَابَآؤُنَا","فَأۡتِنَا","بِمَا","تَعِدُنَآ","إِن","كُنتَ","مِنَ","ٱلصَّٰدِقِينَ"],"ḳалуу ажи'тана лина`будаллаха вахдахуу ваназара ма кана йа`буду абауна фа'тина бима та`идуна ин кунта минас садиḳиин","Они сказали: «Неужели ты пришел к нам для того, чтобы мы поклонялись одному Аллаху и отреклись от того, чему поклонялись наши отцы? Ниспошли нам то, чем ты угрожаешь (или что ты обещаешь), если ты говоришь правду».",["сказали они","разве пришёл ты к нам","чтобы мы поклонялись","Аллаху","одному","и оставили","то, чему","были","поклонялись","наши отцы","так принеси нам","то, что","ты обещаешь нам","если","ты","из","правдивых"]],[7,71,["قَالَ","قَدۡ","وَقَعَ","عَلَيۡكُم","مِّن","رَّبِّكُمۡ","رِجۡسٞ","وَغَضَبٌۖ","أَتُجَٰدِلُونَنِي","فِيٓ","أَسۡمَآءٖ","سَمَّيۡتُمُوهَآ","أَنتُمۡ","وَءَابَآؤُكُم","مَّا","نَزَّلَ","ٱللَّهُ","بِهَا","مِن","سُلۡطَٰنٖۚ","فَٱنتَظِرُوٓاْ","إِنِّي","مَعَكُم","مِّنَ","ٱلۡمُنتَظِرِينَ"],"ḳала ḳад ваḳа`а `алайкум мир раббикум рижсун вагадабун атужадилуунании фии асмаин саммайтумууха антум ва'абаукум ма наззалаллаху биха мин султанин фантазируу иннии ма`акум минал мунтазириин","Он сказал: «Наказание и гнев вашего Господа уже поразили вас. Неужели вы станете пререкаться со мной относительно имен, которые придумали вы и ваши отцы? Аллах не ниспосылал о них никакого доказательства. Ждите, и я подожду вместе с вами».",["сказал он","уже","пала","на вас","от","вашего Господа","кара","и гнев","разве спорите вы со мной","о","именах","вы назвали их","вы","и ваши отцы","не","ниспослал","Аллах","о них","никакого","довода","так ждите","поистине, я","с вами","из","ожидающих"]],[7,72,["فَأَنجَيۡنَٰهُ","وَٱلَّذِينَ","مَعَهُۥ","بِرَحۡمَةٖ","مِّنَّا","وَقَطَعۡنَا","دَابِرَ","ٱلَّذِينَ","كَذَّبُواْ","بِـَٔايَٰتِنَاۖ","وَمَا","كَانُواْ","مُؤۡمِنِينَ"],"фа'анжайнаху валлазиина ма`ахуу бирахматим минна ваḳата`на дабирал лазиина каззабуу би'айатина вама кануу му'миниин","Мы спасли его и тех, кто был с ним, по Своей милости и искоренили тех, которые сочли ложью Наши знамения и не стали верующими.",["и Мы спасли его","и тех, которые","с ним","по милости","от Нас","и Мы отсекли","корень","тех, которые","сочли ложью","Наши знамения","и не","были они","верующими"]],[7,73,["وَإِلَىٰ","ثَمُودَ","أَخَاهُمۡ","صَٰلِحٗاۚ","قَالَ","يَٰقَوۡمِ","ٱعۡبُدُواْ","ٱللَّهَ","مَا","لَكُم","مِّنۡ","إِلَٰهٍ","غَيۡرُهُۥۖ","قَدۡ","جَآءَتۡكُم","بَيِّنَةٞ","مِّن","رَّبِّكُمۡۖ","هَٰذِهِۦ","نَاقَةُ","ٱللَّهِ","لَكُمۡ","ءَايَةٗۖ","فَذَرُوهَا","تَأۡكُلۡ","فِيٓ","أَرۡضِ","ٱللَّهِۖ","وَلَا","تَمَسُّوهَا","بِسُوٓءٖ","فَيَأۡخُذَكُمۡ","عَذَابٌ","أَلِيمٞ"],"ва'ила самууда ахахум салихан ḳала йаḳауми`будуллаха ма лакум мин илахин гайрухуу ḳад жааткум баййинатум мир раббикум хазихии наḳатуллахи лакум айатан фазарууха та'кул фии ардиллахи вала тамассууха бисууин файа'хузакум `азабун алиим","Мы отправили к самудянам их брата Салиха. Он сказал: «О мой народ! Поклоняйтесь Аллаху, ибо нет у вас другого божества, кроме Него. К вам явилось ясное знамение от вашего Господа. Эта верблюдица Аллаха является знамением для вас. Позвольте ей пастись на земле Аллаха и не причиняйте ей зла, а не то вас постигнут мучительные страдания.",["и к","самудянам","брата их","Салиха","сказал он","о народ мой","поклоняйтесь","Аллаху","нет","у вас","никакого","божества","кроме Него","уже","пришло к вам","ясное знамение","от","вашего Господа","эта","верблюдица","Аллаха","для вас","знамение","оставьте же её","пусть ест","на","земле","Аллаха","и не","касайтесь её","злом","а то постигнет вас","наказание","мучительное"]]],"m":[[["أُبَلِّغُكُمۡ","я передаю вам",7,68],["رِسَٰلَٰتِ","послания",7,68],["رَبِّي","моего Господа",7,68],["وَأَنَا۠","и я",7,68],["لَكُمۡ","для вас",7,68],["نَاصِحٌ","советчик",7,68],["أَمِينٌ","надёжный",7,68],[68],["أَوَعَجِبۡتُمۡ","разве удивились вы",7,69]],[["أَن","что",7,69],["جَآءَكُمۡ","пришло к вам",7,69],["ذِكۡرٞ","напоминание",7,69],["مِّن","от",7,69],["رَّبِّكُمۡ","вашего Господа",7,69],["عَلَىٰ","через",7,69],["رَجُلٖ","мужа",7,69],["مِّنكُمۡ","из вас",7,69],["لِيُنذِرَكُمۡۚ","чтобы он предостерёг вас",7,69]],[["وَٱذۡكُرُوٓاْ","и помните",7,69],["إِذۡ","как",7,69],["جَعَلَكُمۡ","Он сделал вас",7,69],["خُلَفَآءَ","преемниками",7,69],["مِنۢ","из",7,69],["بَعۡدِ","после",7,69],["قَوۡمِ","народа",7,69],["نُوحٖ","Нуха",7,69],["وَزَادَكُمۡ","и увеличил вас",7,69]],[["فِي","в",7,69],["ٱلۡخَلۡقِ","сложении",7,69],["بَصۜۡطَةٗۖ","величиной",7,69],["فَٱذۡكُرُوٓاْ","так помните",7,69],["ءَالَآءَ","милости",7,69],["ٱللَّهِ","Аллаха",7,69],["لَعَلَّكُمۡ","может быть, вы",7,69],["تُفۡلِحُونَ","преуспеете",7,69]],[[69],["قَالُوٓاْ","сказали они",7,70],["أَجِئۡتَنَا","разве пришёл ты к нам",7,70],["لِنَعۡبُدَ","чтобы мы поклонялись",7,70],["ٱللَّهَ","Аллаху",7,70],["وَحۡدَهُۥ","одному",7,70],["وَنَذَرَ","и оставили",7,70],["مَا","то, чему",7,70],["كَانَ","были",7,70]],[["يَعۡبُدُ","поклонялись",7,70],["ءَابَآؤُنَا","наши отцы",7,70],["فَأۡتِنَا","так принеси нам",7,70],["بِمَا","то, что",7,70],["تَعِدُنَآ","ты обещаешь нам",7,70],["إِن","если",7,70],["كُنتَ","ты",7,70],["مِنَ","из",7,70],["ٱلصَّٰدِقِينَ","правдивых",7,70]],[[70],["قَالَ","сказал он",7,71],["قَدۡ","уже",7,71],["وَقَعَ","пала",7,71],["عَلَيۡكُم","на вас",7,71],["مِّن","от",7,71],["رَّبِّكُمۡ","вашего Господа",7,71],["رِجۡسٞ","кара",7,71],["وَغَضَبٌۖ","и гнев",7,71]],[["أَتُجَٰدِلُونَنِي","разве спорите вы со мной",7,71],["فِيٓ","о",7,71],["أَسۡمَآءٖ","именах",7,71],["سَمَّيۡتُمُوهَآ","вы назвали их",7,71],["أَنتُمۡ","вы",7,71],["وَءَابَآؤُكُم","и ваши отцы",7,71]],[["مَّا","не",7,71],["نَزَّلَ","ниспослал",7,71],["ٱللَّهُ","Аллах",7,71],["بِهَا","о них",7,71],["مِن","никакого",7,71],["سُلۡطَٰنٖۚ","довода",7,71],["فَٱنتَظِرُوٓاْ","так ждите",7,71],["إِنِّي","поистине, я",7,71],["مَعَكُم","с вами",7,71],["مِّنَ","из",7,71]],[["ٱلۡمُنتَظِرِينَ","ожидающих",7,71],[71],["فَأَنجَيۡنَٰهُ","и Мы спасли его",7,72],["وَٱلَّذِينَ","и тех, которые",7,72],["مَعَهُۥ","с ним",7,72],["بِرَحۡمَةٖ","по милости",7,72],["مِّنَّا","от Нас",7,72]],[["وَقَطَعۡنَا","и Мы отсекли",7,72],["دَابِرَ","корень",7,72],["ٱلَّذِينَ","тех, которые",7,72],["كَذَّبُواْ","сочли ложью",7,72],["بِـَٔايَٰتِنَاۖ","Наши знамения",7,72],["وَمَا","и не",7,72],["كَانُواْ","были они",7,72],["مُؤۡمِنِينَ","верующими",7,72]],[[72],["وَإِلَىٰ","и к",7,73],["ثَمُودَ","самудянам",7,73],["أَخَاهُمۡ","брата их",7,73],["صَٰلِحٗاۚ","Салиха",7,73],["قَالَ","сказал он",7,73],["يَٰقَوۡمِ","о народ мой",7,73],["ٱعۡبُدُواْ","поклоняйтесь",7,73],["ٱللَّهَ","Аллаху",7,73]],[["مَا","нет",7,73],["لَكُم","у вас",7,73],["مِّنۡ","никакого",7,73],["إِلَٰهٍ","божества",7,73],["غَيۡرُهُۥۖ","кроме Него",7,73],["قَدۡ","уже",7,73],["جَآءَتۡكُم","пришло к вам",7,73],["بَيِّنَةٞ","ясное знамение",7,73],["مِّن","от",7,73]],[["رَّبِّكُمۡۖ","вашего Господа",7,73],["هَٰذِهِۦ","эта",7,73],["نَاقَةُ","верблюдица",7,73],["ٱللَّهِ","Аллаха",7,73],["لَكُمۡ","для вас",7,73],["ءَايَةٗۖ","знамение",7,73],["فَذَرُوهَا","оставьте же её",7,73],["تَأۡكُلۡ","пусть ест",7,73]],[["فِيٓ","на",7,73],["أَرۡضِ","земле",7,73],["ٱللَّهِۖ","Аллаха",7,73],["وَلَا","и не",7,73],["تَمَسُّوهَا","касайтесь её",7,73],["بِسُوٓءٖ","злом",7,73],["فَيَأۡخُذَكُمۡ","а то постигнет вас",7,73],["عَذَابٌ","наказание",7,73],["أَلِيمٞ","мучительное",7,73],[73]]]}