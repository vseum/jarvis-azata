{"p":160,"j":8,"a":[[7,74,["وَٱذۡكُرُوٓاْ","إِذۡ","جَعَلَكُمۡ","خُلَفَآءَ","مِنۢ","بَعۡدِ","عَادٖ","وَبَوَّأَكُمۡ","فِي","ٱلۡأَرۡضِ","تَتَّخِذُونَ","مِن","سُهُولِهَا","قُصُورٗا","وَتَنۡحِتُونَ","ٱلۡجِبَالَ","بُيُوتٗاۖ","فَٱذۡكُرُوٓاْ","ءَالَآءَ","ٱللَّهِ","وَلَا","تَعۡثَوۡاْ","فِي","ٱلۡأَرۡضِ","مُفۡسِدِينَ"],"вазкуруу из жа`алакум хулафаа мим ба`ди `адин вабавваакум фил арди таттахизууна мин сухуулиха ḳусууран ватанхитуунал жибала буйуутан фазкуруу алааллахи вала та`сау фил арди муфсидиин","Помните о том, как Он сделал вас преемниками адитов и расселил вас на земле, на равнинах которой вы воздвигаете дворцы, а в горах высекаете жилища. Помните о милостях Аллаха и не творите на земле зла, распространяя нечестие».",["и помните","как","Он сделал вас","преемниками","из","после","адитов","и поселил вас","на","земле","вы возводите","на","её равнинах","дворцы","и высекаете","в горах","жилища","так помните","милости","Аллаха","и не","бесчинствуйте","на","земле","распространяя нечестие"]],[7,75,["قَالَ","ٱلۡمَلَأُ","ٱلَّذِينَ","ٱسۡتَكۡبَرُواْ","مِن","قَوۡمِهِۦ","لِلَّذِينَ","ٱسۡتُضۡعِفُواْ","لِمَنۡ","ءَامَنَ","مِنۡهُمۡ","أَتَعۡلَمُونَ","أَنَّ","صَٰلِحٗا","مُّرۡسَلٞ","مِّن","رَّبِّهِۦۚ","قَالُوٓاْ","إِنَّا","بِمَآ","أُرۡسِلَ","بِهِۦ","مُؤۡمِنُونَ"],"ḳалал малаул лазиинастакбаруу мин ḳаумихии лиллазиинастуд`ифуу лиман амана минхум ата`ламууна анна салихам мурсалум мир раббихии ḳалуу инна бима урсила бихии му'минуун","Знатные люди из его народа, которые превозносились, сказали уверовавшим из числа тех, кто был слаб: «Знаете ли вы, что Салих послан своим Господом?». Они сказали: «Мы веруем в то, с чем он послан».",["сказала","знать","те, которые","превозносились","из","его народа","тем, которые","были угнетены","тем, кто","уверовал","из них","знаете ли вы","что","Салих","посланный","от","его Господа","сказали они","поистине, мы","в то, что","послан он","с этим","верующие"]],[7,76,["قَالَ","ٱلَّذِينَ","ٱسۡتَكۡبَرُوٓاْ","إِنَّا","بِٱلَّذِيٓ","ءَامَنتُم","بِهِۦ","كَٰفِرُونَ"],"ḳалал лазиинастакбаруу инна биллазии амантум бихии кафируун","Те, которые превозносились, сказали: «А мы отказываемся уверовать в то, во что уверовали вы».",["сказали","те, которые","превозносились","поистине, мы","в то, что","вы уверовали","в него","неверующие"]],[7,77,["فَعَقَرُواْ","ٱلنَّاقَةَ","وَعَتَوۡاْ","عَنۡ","أَمۡرِ","رَبِّهِمۡ","وَقَالُواْ","يَٰصَٰلِحُ","ٱئۡتِنَا","بِمَا","تَعِدُنَآ","إِن","كُنتَ","مِنَ","ٱلۡمُرۡسَلِينَ"],"фа`аḳарун наḳата ва`атау `ан амри раббихим ваḳалуу йасалихутина бима та`идуна ин кунта минал мурсалиин","Они подрезали верблюдице поджилки, ослушались своего Господа и сказали: «О Салих! Ниспошли нам то, чем ты угрожаешь, если ты действительно являешься одним из посланников».",["и подрезали они","верблюдицу","и дерзко восстали","против","повеления","их Господа","и сказали они","о Салих","принеси нам","то, что","ты обещаешь нам","если","ты","из","посланников"]],[7,78,["فَأَخَذَتۡهُمُ","ٱلرَّجۡفَةُ","فَأَصۡبَحُواْ","فِي","دَارِهِمۡ","جَٰثِمِينَ"],"фа'ахазатхумур ражфату фа'асбахуу фии дарихим жасимиин","Их поразило землетрясение, и они оказались повергнуты ниц в своих домах.",["и схватило их","землетрясение","и оказались они","в","их жилище","повергнутыми ниц"]],[7,79,["فَتَوَلَّىٰ","عَنۡهُمۡ","وَقَالَ","يَٰقَوۡمِ","لَقَدۡ","أَبۡلَغۡتُكُمۡ","رِسَالَةَ","رَبِّي","وَنَصَحۡتُ","لَكُمۡ","وَلَٰكِن","لَّا","تُحِبُّونَ","ٱلنَّٰصِحِينَ"],"фатавалла `анхум ваḳала йаḳауми лаḳад аблагтукум рисалата раббии ванасахту лакум валакил ла тухиббуунан насихиин","Он отвернулся от них и сказал: «О мой народ! Я донес до вас послание моего Господа и искренне желал вам добра, но вы не любите тех, кто желает вам добра».",["и отвернулся он","от них","и сказал","о народ мой","уже","я передал вам","послание","моего Господа","и я дал совет","вам","но","не","любите вы","советующих"]],[7,80,["وَلُوطًا","إِذۡ","قَالَ","لِقَوۡمِهِۦٓ","أَتَأۡتُونَ","ٱلۡفَٰحِشَةَ","مَا","سَبَقَكُم","بِهَا","مِنۡ","أَحَدٖ","مِّنَ","ٱلۡعَٰلَمِينَ"],"валуутан из ḳала лиḳаумихии ата'туунал фахишата ма сабаḳакум биха мин ахадим минал `аламиин","Мы отправили Лута (Лота), и он сказал своему народу: «Неужели вы станете совершать мерзость, которую до вас не совершал никто из миров?",["и Лута","когда","сказал он","своему народу","разве совершаете вы","мерзость","не","опередил вас","в ней","ни","один","из","миров"]],[7,81,["إِنَّكُمۡ","لَتَأۡتُونَ","ٱلرِّجَالَ","شَهۡوَةٗ","مِّن","دُونِ","ٱلنِّسَآءِۚ","بَلۡ","أَنتُمۡ","قَوۡمٞ","مُّسۡرِفُونَ"],"иннакум лата'туунар рижала шахватам мин дуунин нисаи бал антум ḳаумум мусрифуун","В похотливом вожделении вы приходите к мужчинам вместо женщин. Воистину, вы - народ излишествующий».",["поистине, вы","непременно приходите к","мужчинам","по похоти","из","помимо","женщин","нет же","вы","народ","излишествующий"]]],"m":[[["وَٱذۡكُرُوٓاْ","и помните",7,74],["إِذۡ","как",7,74],["جَعَلَكُمۡ","Он сделал вас",7,74],["خُلَفَآءَ","преемниками",7,74],["مِنۢ","из",7,74],["بَعۡدِ","после",7,74],["عَادٖ","адитов",7,74],["وَبَوَّأَكُمۡ","и поселил вас",7,74]],[["فِي","на",7,74],["ٱلۡأَرۡضِ","земле",7,74],["تَتَّخِذُونَ","вы возводите",7,74],["مِن","на",7,74],["سُهُولِهَا","её равнинах",7,74],["قُصُورٗا","дворцы",7,74],["وَتَنۡحِتُونَ","и высекаете",7,74]],[["ٱلۡجِبَالَ","в горах",7,74],["بُيُوتٗاۖ","жилища",7,74],["فَٱذۡكُرُوٓاْ","так помните",7,74],["ءَالَآءَ","милости",7,74],["ٱللَّهِ","Аллаха",7,74],["وَلَا","и не",7,74],["تَعۡثَوۡاْ","бесчинствуйте",7,74],["فِي","на",7,74],["ٱلۡأَرۡضِ","земле",7,74]],[["مُفۡسِدِينَ","распространяя нечестие",7,74],[74],["قَالَ","сказала",7,75],["ٱلۡمَلَأُ","знать",7,75],["ٱلَّذِينَ","те, которые",7,75],["ٱسۡتَكۡبَرُواْ","превозносились",7,75],["مِن","из",7,75]],[["قَوۡمِهِۦ","его народа",7,75],["لِلَّذِينَ","тем, которые",7,75],["ٱسۡتُضۡعِفُواْ","были угнетены",7,75],["لِمَنۡ","тем, кто",7,75],["ءَامَنَ","уверовал",7,75],["مِنۡهُمۡ","из них",7,75],["أَتَعۡلَمُونَ","знаете ли вы",7,75]],[["أَنَّ","что",7,75],["صَٰلِحٗا","Салих",7,75],["مُّرۡسَلٞ","посланный",7,75],["مِّن","от",7,75],["رَّبِّهِۦۚ","его Господа",7,75],["قَالُوٓاْ","сказали они",7,75],["إِنَّا","поистине, мы",7,75],["بِمَآ","в то, что",7,75],["أُرۡسِلَ","послан он",7,75],["بِهِۦ","с этим",7,75]],[["مُؤۡمِنُونَ","верующие",7,75],[75],["قَالَ","сказали",7,76],["ٱلَّذِينَ","те, которые",7,76],["ٱسۡتَكۡبَرُوٓاْ","превозносились",7,76],["إِنَّا","поистине, мы",7,76],["بِٱلَّذِيٓ","в то, что",7,76]],[["ءَامَنتُم","вы уверовали",7,76],["بِهِۦ","в него",7,76],["كَٰفِرُونَ","неверующие",7,76],[76],["فَعَقَرُواْ","и подрезали они",7,77],["ٱلنَّاقَةَ","верблюдицу",7,77],["وَعَتَوۡاْ","и дерзко восстали",7,77],["عَنۡ","против",7,77]],[["أَمۡرِ","повеления",7,77],["رَبِّهِمۡ","их Господа",7,77],["وَقَالُواْ","и сказали они",7,77],["يَٰصَٰلِحُ","о Салих",7,77],["ٱئۡتِنَا","принеси нам",7,77],["بِمَا","то, что",7,77],["تَعِدُنَآ","ты обещаешь нам",7,77],["إِن","если",7,77],["كُنتَ","ты",7,77],["مِنَ","из",7,77]],[["ٱلۡمُرۡسَلِينَ","посланников",7,77],[77],["فَأَخَذَتۡهُمُ","и схватило их",7,78],["ٱلرَّجۡفَةُ","землетрясение",7,78],["فَأَصۡبَحُواْ","и оказались они",7,78],["فِي","в",7,78],["دَارِهِمۡ","их жилище",7,78]],[["جَٰثِمِينَ","повергнутыми ниц",7,78],[78],["فَتَوَلَّىٰ","и отвернулся он",7,79],["عَنۡهُمۡ","от них",7,79],["وَقَالَ","и сказал",7,79],["يَٰقَوۡمِ","о народ мой",7,79],["لَقَدۡ","уже",7,79],["أَبۡلَغۡتُكُمۡ","я передал вам",7,79]],[["رِسَالَةَ","послание",7,79],["رَبِّي","моего Господа",7,79],["وَنَصَحۡتُ","и я дал совет",7,79],["لَكُمۡ","вам",7,79],["وَلَٰكِن","но",7,79],["لَّا","не",7,79],["تُحِبُّونَ","любите вы",7,79],["ٱلنَّٰصِحِينَ","советующих",7,79]],[[79],["وَلُوطًا","и Лута",7,80],["إِذۡ","когда",7,80],["قَالَ","сказал он",7,80],["لِقَوۡمِهِۦٓ","своему народу",7,80],["أَتَأۡتُونَ","разве совершаете вы",7,80],["ٱلۡفَٰحِشَةَ","мерзость",7,80],["مَا","не",7,80],["سَبَقَكُم","опередил вас",7,80]],[["بِهَا","в ней",7,80],["مِنۡ","ни",7,80],["أَحَدٖ","один",7,80],["مِّنَ","из",7,80],["ٱلۡعَٰلَمِينَ","миров",7,80],[80],["إِنَّكُمۡ","поистине, вы",7,81],["لَتَأۡتُونَ","непременно приходите 