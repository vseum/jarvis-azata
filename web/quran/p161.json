{"p":161,"j":8,"a":[[7,82,["وَمَا","كَانَ","جَوَابَ","قَوۡمِهِۦٓ","إِلَّآ","أَن","قَالُوٓاْ","أَخۡرِجُوهُم","مِّن","قَرۡيَتِكُمۡۖ","إِنَّهُمۡ","أُنَاسٞ","يَتَطَهَّرُونَ"],"вама кана жаваба ḳаумихии илла ан ḳалуу ахрижуухум мин ḳарйатикум иннахум унасун йататаххаруун","В ответ его народ лишь сказал: «Прогоните их из вашего селения. Воистину, эти люди хотят очиститься».",["и не","был","ответом","его народа","кроме","то, что","сказали они","изгоните их","из","вашего селения","поистине, они","люди","очищающиеся"]],[7,83,["فَأَنجَيۡنَٰهُ","وَأَهۡلَهُۥٓ","إِلَّا","ٱمۡرَأَتَهُۥ","كَانَتۡ","مِنَ","ٱلۡغَٰبِرِينَ"],"фа'анжайнаху ва'ахлахуу илламраатахуу канат минал габириин","Мы спасли его и его семью, кроме жены, которая оказалась в числе оставшихся позади.",["и Мы спасли его","и его семью","кроме","его жены","была она","из","оставшихся позади"]],[7,84,["وَأَمۡطَرۡنَا","عَلَيۡهِم","مَّطَرٗاۖ","فَٱنظُرۡ","كَيۡفَ","كَانَ","عَٰقِبَةُ","ٱلۡمُجۡرِمِينَ"],"ва'амтарна `алайхим матаран фанзур кайфа кана `аḳибатул мужримиин","Мы пролили на них дождь. Посмотри же, каким был конец грешников!",["и Мы пролили","на них","дождь","посмотри же","каким","был","конец","грешников"]],[7,85,["وَإِلَىٰ","مَدۡيَنَ","أَخَاهُمۡ","شُعَيۡبٗاۚ","قَالَ","يَٰقَوۡمِ","ٱعۡبُدُواْ","ٱللَّهَ","مَا","لَكُم","مِّنۡ","إِلَٰهٍ","غَيۡرُهُۥۖ","قَدۡ","جَآءَتۡكُم","بَيِّنَةٞ","مِّن","رَّبِّكُمۡۖ","فَأَوۡفُواْ","ٱلۡكَيۡلَ","وَٱلۡمِيزَانَ","وَلَا","تَبۡخَسُواْ","ٱلنَّاسَ","أَشۡيَآءَهُمۡ","وَلَا","تُفۡسِدُواْ","فِي","ٱلۡأَرۡضِ","بَعۡدَ","إِصۡلَٰحِهَاۚ","ذَٰلِكُمۡ","خَيۡرٞ","لَّكُمۡ","إِن","كُنتُم","مُّؤۡمِنِينَ"],"ва'ила мадйана ахахум шу`айбан ḳала йаḳауми`будуллаха ма лакум мин илахин гайрухуу ḳад жааткум баййинатум мир раббикум фа'ауфул кайла валмиизана вала табхасун наса ашйаахум вала туфсидуу фил арди ба`да ислахиха заликум хайрул лакум ин кунтум му'миниин","Мы отправили к мадьянитам их брата Шуейба. Он сказал: «О мой народ! Поклоняйтесь Аллаху, ибо нет у вас другого божества, кроме Него. К вам явилось ясное знамение от вашего Господа. Наполняйте же меру и весы сполна, не придерживайте имущества людей и не распространяйте нечестия на земле после того, как на ней наведен порядок. Так лучше для вас, если только вы являетесь верующими.",["и к","мадьянитам","брата их","Шуейба","сказал он","о народ мой","поклоняйтесь","Аллаху","нет","у вас","никакого","божества","кроме Него","уже","пришло к вам","ясное знамение","от","вашего Господа","так соблюдайте сполна","меру","и вес","и не","урезайте","людям","их вещи","и не","распространяйте нечестие","на","земле","после","её благоустройства","это","лучше","для вас","если","вы","верующие"]],[7,86,["وَلَا","تَقۡعُدُواْ","بِكُلِّ","صِرَٰطٖ","تُوعِدُونَ","وَتَصُدُّونَ","عَن","سَبِيلِ","ٱللَّهِ","مَنۡ","ءَامَنَ","بِهِۦ","وَتَبۡغُونَهَا","عِوَجٗاۚ","وَٱذۡكُرُوٓاْ","إِذۡ","كُنتُمۡ","قَلِيلٗا","فَكَثَّرَكُمۡۖ","وَٱنظُرُواْ","كَيۡفَ","كَانَ","عَٰقِبَةُ","ٱلۡمُفۡسِدِينَ"],"вала таḳ`удуу бикулли сиратин туу`идууна ватасуддууна `ан сабиилиллахи ман амана бихии ватабгуунаха `иважан вазкуруу из кунтум ḳалиилан факассаракум ванзуруу кайфа кана `аḳибатул муфсидиин","Не садитесь на дорогах, угрожая и сбивая с пути Аллаха тех, кто уверовал в Него, и пытаясь исказить его. Помните, что вас было мало, а Он приумножил ваше число. Посмотри же, каким был конец злодеев!",["и не","сидите","на каждой","дороге","угрожая","и отвращая","от","пути","Аллаха","того, кто","уверовал","в Него","и желая ему","кривизны","и помните","когда","вы были","малочисленны","и Он умножил вас","и посмотрите","каким","был","конец","распространяющих нечестие"]],[7,87,["وَإِن","كَانَ","طَآئِفَةٞ","مِّنكُمۡ","ءَامَنُواْ","بِٱلَّذِيٓ","أُرۡسِلۡتُ","بِهِۦ","وَطَآئِفَةٞ","لَّمۡ","يُؤۡمِنُواْ","فَٱصۡبِرُواْ","حَتَّىٰ","يَحۡكُمَ","ٱللَّهُ","بَيۡنَنَاۚ","وَهُوَ","خَيۡرُ","ٱلۡحَٰكِمِينَ"],"ва'ин кана таифатум минкум амануу биллазии урсилту бихии ватаифатул лам йу'минуу фасбируу хатта йахкумаллаху байнана вахуа хайрул хакимиин","Если одна часть из вас уверовала в то, с чем я послан, а другая не уверовала, то потерпите, пока Аллах не рассудит между нами, ибо Он - Наилучший из судей».",["и если","есть","часть","из вас","уверовали","в то, что","я послан","с этим","и часть","не","уверовали","то терпите","пока","рассудит","Аллах","между нами","и Он","лучший","из судей"]]],"m":[[["وَمَا","и не",7,82],["كَانَ","был",7,82],["جَوَابَ","ответом",7,82],["قَوۡمِهِۦٓ","его народа",7,82],["إِلَّآ","кроме",7,82],["أَن","то, что",7,82],["قَالُوٓاْ","сказали они",7,82],["أَخۡرِجُوهُم","изгоните их",7,82],["مِّن","из",7,82]],[["قَرۡيَتِكُمۡۖ","вашего селения",7,82],["إِنَّهُمۡ","поистине, они",7,82],["أُنَاسٞ","люди",7,82],["يَتَطَهَّرُونَ","очищающиеся",7,82],[82],["فَأَنجَيۡنَٰهُ","и Мы спасли его",7,83],["وَأَهۡلَهُۥٓ","и его семью",7,83]],[["إِلَّا","кроме",7,83],["ٱمۡرَأَتَهُۥ","его жены",7,83],["كَانَتۡ","была она",7,83],["مِنَ","из",7,83],["ٱلۡغَٰبِرِينَ","оставшихся позади",7,83],[83],["وَأَمۡطَرۡنَا","и Мы пролили",7,84],["عَلَيۡهِم","на них",7,84]],[["مَّطَرٗاۖ","дождь",7,84],["فَٱنظُرۡ","посмотри же",7,84],["كَيۡفَ","каким",7,84],["كَانَ","был",7,84],["عَٰقِبَةُ","конец",7,84],["ٱلۡمُجۡرِمِينَ","грешников",7,84],[84]],[["وَإِلَىٰ","и к",7,85],["مَدۡيَنَ","мадьянитам",7,85],["أَخَاهُمۡ","брата их",7,85],["شُعَيۡبٗاۚ","Шуейба",7,85],["قَالَ","сказал он",7,85],["يَٰقَوۡمِ","о народ мой",7,85],["ٱعۡبُدُواْ","поклоняйтесь",7,85],["ٱللَّهَ","Аллаху",7,85]],[["مَا","нет",7,85],["لَكُم","у вас",7,85],["مِّنۡ","никакого",7,85],["إِلَٰهٍ","божества",7,85],["غَيۡرُهُۥۖ","кроме Него",7,85],["قَدۡ","уже",7,85],["جَآءَتۡكُم","пришло к вам",7,85],["بَيِّنَةٞ","ясное знамение",7,85],["مِّن","от",7,85]],[["رَّبِّكُمۡۖ","вашего Господа",7,85],["فَأَوۡفُواْ","так соблюдайте сполна",7,85],["ٱلۡكَيۡلَ","меру",7,85],["وَٱلۡمِيزَانَ","и вес",7,85],["وَلَا","и не",7,85],["تَبۡخَسُواْ","урезайте",7,85]],[["ٱلنَّاسَ","людям",7,85],["أَشۡيَآءَهُمۡ","их вещи",7,85],["وَلَا","и не",7,85],["تُفۡسِدُواْ","распространяйте нечестие",7,85],["فِي","на",7,85],["ٱلۡأَرۡضِ","земле",7,85],["بَعۡدَ","после",7,85]],[["إِصۡلَٰحِهَاۚ","её благоустройства",7,85],["ذَٰلِكُمۡ","это",7,85],["خَيۡرٞ","лучше",7,85],["لَّكُمۡ","для вас",7,85],["إِن","если",7,85],["كُنتُم","вы",7,85],["مُّؤۡمِنِينَ","верующие",7,85]],[[85],["وَلَا","и не",7,86],["تَقۡعُدُواْ","сидите",7,86],["بِكُلِّ","на каждой",7,86],["صِرَٰطٖ","дороге",7,86],["تُوعِدُونَ","угрожая",7,86],["وَتَصُدُّونَ","и отвращая",7,86]],[["عَن","от",7,86],["سَبِيلِ","пути",7,86],["ٱللَّهِ","Аллаха",7,86],["مَنۡ","того, кто",7,86],["ءَامَنَ","уверовал",7,86],["بِهِۦ","в Него",7,86],["وَتَبۡغُونَهَا","и желая ему",7,86],["عِوَجٗاۚ","кривизны",7,86]],[["وَٱذۡكُرُوٓاْ","и помните",7,86],["إِذۡ","когда",7,86],["كُنتُمۡ","вы были",7,86],["قَلِيلٗا","малочисленны",7,86],["فَكَثَّرَكُمۡۖ","и Он умножил вас",7,86],["وَٱنظُرُواْ","и посмотрите",7,86]],[["كَيۡفَ","каким",7,86],["كَانَ","был",7,86],["عَٰقِبَةُ","конец",7,86],["ٱلۡمُفۡسِدِينَ","распространяющих нечестие",7,86],[86],["وَإِن","и если",7,87],["كَانَ","есть",7,87],["طَآئِفَةٞ","часть",7,87]],[["مِّنكُمۡ","из вас",7,87],["ءَامَنُواْ","уверовали",7,87],["بِٱلَّذِيٓ","в то, что",7,87],["أُرۡسِلۡتُ","я послан",7,87],["بِهِۦ","с этим",7,87],["وَطَآئِفَةٞ","и часть",7,87],["لَّمۡ","не",7,87],["يُؤۡمِنُواْ","уверовали",7,87]],[["فَٱصۡبِرُواْ","то терпите",7,87],["حَتَّىٰ","пока",7,87],["يَحۡكُمَ","рассудит",7,87],["ٱللَّهُ","Аллах",7,87],["بَيۡنَنَاۚ","между нами",7,87],["وَهُوَ","и Он",7,87],["خَيۡرُ","лучший",7,87],["ٱلۡحَٰكِمِينَ","из судей",7,87],[87]]]}