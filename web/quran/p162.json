{"p":162,"j":9,"a":[[7,88,["قَالَ","ٱلۡمَلَأُ","ٱلَّذِينَ","ٱسۡتَكۡبَرُواْ","مِن","قَوۡمِهِۦ","لَنُخۡرِجَنَّكَ","يَٰشُعَيۡبُ","وَٱلَّذِينَ","ءَامَنُواْ","مَعَكَ","مِن","قَرۡيَتِنَآ","أَوۡ","لَتَعُودُنَّ","فِي","مِلَّتِنَاۚ","قَالَ","أَوَلَوۡ","كُنَّا","كَٰرِهِينَ"],"ḳалал малаул лазиинастакбаруу мин ḳаумихии ланухрижаннака йашу`айбу валлазиина амануу ма`ака мин ḳарйатина ау лата`уудунна фии миллатина ḳала авалау кунна карихиин","Знатные люди из его народа, которые превозносились, сказали: «О Шуейб! Мы непременно изгоним тебя и тех, кто уверовал вместе с тобой, из нашего города или же ты вернешься в нашу религию». Шуейб сказал: «Даже если это ненавистно нам?",["сказала","знать","те, которые","превозносились","из","его народа","непременно изгоним тебя","о Шуейб","и тех, которые","уверовали","с тобой","из","нашего селения","или","непременно вернётесь вы","в","нашу веру","сказал он","разве даже если","мы были","ненавидящими"]],[7,89,["قَدِ","ٱفۡتَرَيۡنَا","عَلَى","ٱللَّهِ","كَذِبًا","إِنۡ","عُدۡنَا","فِي","مِلَّتِكُم","بَعۡدَ","إِذۡ","نَجَّىٰنَا","ٱللَّهُ","مِنۡهَاۚ","وَمَا","يَكُونُ","لَنَآ","أَن","نَّعُودَ","فِيهَآ","إِلَّآ","أَن","يَشَآءَ","ٱللَّهُ","رَبُّنَاۚ","وَسِعَ","رَبُّنَا","كُلَّ","شَيۡءٍ","عِلۡمًاۚ","عَلَى","ٱللَّهِ","تَوَكَّلۡنَاۚ","رَبَّنَا","ٱفۡتَحۡ","بَيۡنَنَا","وَبَيۡنَ","قَوۡمِنَا","بِٱلۡحَقِّ","وَأَنتَ","خَيۡرُ","ٱلۡفَٰتِحِينَ"],"ḳадифтарайна `алаллахи казибан ин `удна фии миллатикум ба`да из нажжаналлаху минха вама йакууну лана ан на`ууда фииха илла ан йашааллаху раббуна васи`а раббуна кулла шай'ин `илман `алаллахи таваккална раббанафтах байнана вабайна ḳаумина билхаḳḳи ва'анта хайрул фатихиин","Мы возведем навет на Аллаха, если вернемся в вашу религию после того, как Аллах спас нас от нее. Не бывать тому, чтобы мы вернулись в вашу религию, если только этого не пожелает Аллах, наш Господь. Наш Господь объемлет знанием всякую вещь. Мы уповаем только на Аллаха. Господь наш! Рассуди между нами и нашим народом по справедливости, ведь Ты - Наилучший из судей».",["уже","мы возвели бы","на","Аллаха","ложь","если","вернёмся мы","в","вашу веру","после","того как","спас нас","Аллах","от неё","и не","будет","нам","чтобы","мы вернулись","в неё","разве","что","пожелает","Аллах","наш Господь","объемлет","наш Господь","всякую","вещь","знанием","на","Аллаха","мы уповаем","Господь наш","рассуди","между нами","и между","нашим народом","по истине","и Ты","лучший","из рассуживающих"]],[7,90,["وَقَالَ","ٱلۡمَلَأُ","ٱلَّذِينَ","كَفَرُواْ","مِن","قَوۡمِهِۦ","لَئِنِ","ٱتَّبَعۡتُمۡ","شُعَيۡبًا","إِنَّكُمۡ","إِذٗا","لَّخَٰسِرُونَ"],"ваḳалал малаул лазиина кафаруу мин ḳаумихии ла'иниттаба`тум шу`айбан иннакум изал лахасируун","Знатные люди из его народа, которые не уверовали, сказали: «Если вы последуете за Шуейбом, то непременно окажетесь в числе потерпевших урон».",["и сказала","знать","те, которые","не уверовали","из","его народа","если","последуете вы","за Шуейбом","поистине, вы","тогда","непременно потерпевшие убыток"]],[7,91,["فَأَخَذَتۡهُمُ","ٱلرَّجۡفَةُ","فَأَصۡبَحُواْ","فِي","دَارِهِمۡ","جَٰثِمِينَ"],"фа'ахазатхумур ражфату фа'асбахуу фии дарихим жасимиин","Их постигло землетрясение, и они оказались повергнуты ниц в своих домах.",["и постигло их","сотрясение","и стали они","в","их жилищах","повергнутыми ниц"]],[7,92,["ٱلَّذِينَ","كَذَّبُواْ","شُعَيۡبٗا","كَأَن","لَّمۡ","يَغۡنَوۡاْ","فِيهَاۚ","ٱلَّذِينَ","كَذَّبُواْ","شُعَيۡبٗا","كَانُواْ","هُمُ","ٱلۡخَٰسِرِينَ"],"аллазиина каззабуу шу`айбан ка'ал лам йагнау фиихал лазиина каззабуу шу`айбан кануу хумул хасириин","Те, которые сочли Шуейба лжецом, словно никогда не жили там. Те, которые сочли Шуейба лжецом, оказались потерпевшими убыток.",["те, которые","сочли лжецом","Шуайба","словно","не","жили","там","те, которые","сочли лжецом","Шуайба","были","они","потерпевшими убыток"]],[7,93,["فَتَوَلَّىٰ","عَنۡهُمۡ","وَقَالَ","يَٰقَوۡمِ","لَقَدۡ","أَبۡلَغۡتُكُمۡ","رِسَٰلَٰتِ","رَبِّي","وَنَصَحۡتُ","لَكُمۡۖ","فَكَيۡفَ","ءَاسَىٰ","عَلَىٰ","قَوۡمٖ","كَٰفِرِينَ"],"фатавалла `анхум ваḳала йаḳауми лаḳад аблагтукум рисалати раббии ванасахту лакум факайфа аса `ала ḳаумин кафириин","Он отвернулся от них и сказал: «О мой народ! Я донес до вас послания моего Господа и искренне желал вам добра. Как я могу печалиться о неверующих людях?».",["и отвернулся он","от них","и сказал","о народ мой","непременно уже","я донёс до вас","послания","Господа моего","и дал совет","вам","так как же","мне печалиться","о","народе","неверующих"]],[7,94,["وَمَآ","أَرۡسَلۡنَا","فِي","قَرۡيَةٖ","مِّن","نَّبِيٍّ","إِلَّآ","أَخَذۡنَآ","أَهۡلَهَا","بِٱلۡبَأۡسَآءِ","وَٱلضَّرَّآءِ","لَعَلَّهُمۡ","يَضَّرَّعُونَ"],"вама арсална фии ḳарйатим мин набиййин илла ахазна ахлаха билба'саи ваддарраи ла`аллахум йаддарра`уун","В какое бы селение Мы не отправляли пророка, Мы непременно подвергали его жителей невзгодам и напастям, дабы они проявили смирение.",["и не","Мы посылали","в","селение","никакого","пророка","кроме как","Мы схватили","жителей его","бедствиями","и невзгодами","чтобы они","смирились"]],[7,95,["ثُمَّ","بَدَّلۡنَا","مَكَانَ","ٱلسَّيِّئَةِ","ٱلۡحَسَنَةَ","حَتَّىٰ","عَفَواْ","وَّقَالُواْ","قَدۡ","مَسَّ","ءَابَآءَنَا","ٱلضَّرَّآءُ","وَٱلسَّرَّآءُ","فَأَخَذۡنَٰهُم","بَغۡتَةٗ","وَهُمۡ","لَا","يَشۡعُرُونَ"],"сумма баддална маканас саййиатил хасаната хатта `афав ваḳалуу ḳад масса абаанад даррау вассаррау фа'ахазнахум багтатан вахум ла йаш`уруун","Затем Мы заменяли зло добром, и тогда они начинали благоденствовать и говорили: «Наших отцов также касались невзгоды и радости». Мы хватали их внезапно, когда они даже не помышляли об этом.",["затем","Мы заменили","вместо","зла","добро","пока не","они умножились","и сказали","уже","касались","отцов наших","невзгоды","и радости","и схватили Мы их","внезапно","а они","не","осознавали"]]],"m":[[["۞ قَالَ","сказала",7,88],["ٱلۡمَلَأُ","знать",7,88],["ٱلَّذِينَ","те, которые",7,88],["ٱسۡتَكۡبَرُواْ","превозносились",7,88],["مِن","из",7,88],["قَوۡمِهِۦ","его народа",7,88],["لَنُخۡرِجَنَّكَ","непременно изгоним тебя",7,88],["يَٰشُعَيۡبُ","о Ш