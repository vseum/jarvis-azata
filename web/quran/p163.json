{"p":163,"j":9,"a":[[7,96,["وَلَوۡ","أَنَّ","أَهۡلَ","ٱلۡقُرَىٰٓ","ءَامَنُواْ","وَٱتَّقَوۡاْ","لَفَتَحۡنَا","عَلَيۡهِم","بَرَكَٰتٖ","مِّنَ","ٱلسَّمَآءِ","وَٱلۡأَرۡضِ","وَلَٰكِن","كَذَّبُواْ","فَأَخَذۡنَٰهُم","بِمَا","كَانُواْ","يَكۡسِبُونَ"],"валау анна ахлал ḳура амануу ваттаḳау лафатахна `алайхим баракатим минас самаи вал'арди валакин каззабуу фа'ахазнахум бима кануу йаксибуун","Если бы жители селений уверовали и стали богобоязненны, Мы раскрыли бы перед ними благодать с неба и земли. Но они сочли это ложью, и Мы схватили их за то, что они приобретали.",["и если бы","что","жители","селений","уверовали","и были богобоязненны","непременно открыли бы Мы","для них","благословения","от","неба","и земли","но","они сочли ложью","и схватили Мы их","за то, что","они","приобретали"]],[7,97,["أَفَأَمِنَ","أَهۡلُ","ٱلۡقُرَىٰٓ","أَن","يَأۡتِيَهُم","بَأۡسُنَا","بَيَٰتٗا","وَهُمۡ","نَآئِمُونَ"],"афаамина ахлул ḳура ан йа'тийахум ба'суна байатан вахум наимуун","Неужели жители селений не опасались того, что Наше наказание постигнет их ночью, когда они спят?",["неужели же в безопасности","жители","селений","что","придёт к ним","Наша кара","ночью","а они","спят"]],[7,98,["أَوَأَمِنَ","أَهۡلُ","ٱلۡقُرَىٰٓ","أَن","يَأۡتِيَهُم","بَأۡسُنَا","ضُحٗى","وَهُمۡ","يَلۡعَبُونَ"],"аваамина ахлул ḳура ан йа'тийахум ба'суна духан вахум йал`абуун","Неужели жители селений не опасались того, что Наше наказание постигнет их утром, когда они забавляются?",["или в безопасности","жители","селений","что","придёт к ним","Наша кара","утром","а они","забавляются"]],[7,99,["أَفَأَمِنُواْ","مَكۡرَ","ٱللَّهِۚ","فَلَا","يَأۡمَنُ","مَكۡرَ","ٱللَّهِ","إِلَّا","ٱلۡقَوۡمُ","ٱلۡخَٰسِرُونَ"],"афааминуу макраллахи фала йа'ману макраллахи иллал ḳаумул хасируун","Неужели они не опасались хитрости Аллаха? Хитрости Аллаха не опасаются только люди, терпящие убыток!",["неужели же в безопасности они от","хитрости","Аллаха","и не","в безопасности от","хитрости","Аллаха","кроме","люди","потерпевшие убыток"]],[7,100,["أَوَلَمۡ","يَهۡدِ","لِلَّذِينَ","يَرِثُونَ","ٱلۡأَرۡضَ","مِنۢ","بَعۡدِ","أَهۡلِهَآ","أَن","لَّوۡ","نَشَآءُ","أَصَبۡنَٰهُم","بِذُنُوبِهِمۡۚ","وَنَطۡبَعُ","عَلَىٰ","قُلُوبِهِمۡ","فَهُمۡ","لَا","يَسۡمَعُونَ"],"авалам йахди лиллазиина йарисуунал арда мим ба`ди ахлиха ал лау нашау асабнахум бизунуубихим ванатба`у `ала ḳулуубихим фахум ла йасма`уун","Разве не ясно тем, которые унаследовали землю от ее прежних жителей, что если бы Мы пожелали, то покарали бы их за грехи? Мы запечатываем их сердца, и они не способны слышать.",["разве не","стало ясно","тем, которые","наследуют","землю","вслед","за","жителями её","что","если бы","Мы пожелали","Мы поразили бы их","за грехи их","и Мы запечатываем","на","сердцах их","и они","не","слышат"]],[7,101,["تِلۡكَ","ٱلۡقُرَىٰ","نَقُصُّ","عَلَيۡكَ","مِنۡ","أَنۢبَآئِهَاۚ","وَلَقَدۡ","جَآءَتۡهُمۡ","رُسُلُهُم","بِٱلۡبَيِّنَٰتِ","فَمَا","كَانُواْ","لِيُؤۡمِنُواْ","بِمَا","كَذَّبُواْ","مِن","قَبۡلُۚ","كَذَٰلِكَ","يَطۡبَعُ","ٱللَّهُ","عَلَىٰ","قُلُوبِ","ٱلۡكَٰفِرِينَ"],"тилкал ḳура наḳуссу `алайка мин амбаиха валаḳад жаатхум русулухум билбаййинати фама кануу лийу'минуу бима каззабуу мин ḳаблу казалика йатба`уллаху `ала ḳулуубил кафириин","Мы рассказываем тебе повествования об этих селениях. Их посланники приходили к ним с ясными знамениями. Однако они не хотели уверовать в то, что они сочли ложью прежде. Так Аллах запечатывает сердца неверующих.",["это","селения","Мы рассказываем","тебе","из","вестей их","и непременно уже","приходили к ним","посланники их","с ясными знамениями","но не","были они","чтобы уверовать","в то, что","они сочли ложью","из","прежде","так","запечатывает","Аллах","на","сердцах","неверующих"]],[7,102,["وَمَا","وَجَدۡنَا","لِأَكۡثَرِهِم","مِّنۡ","عَهۡدٖۖ","وَإِن","وَجَدۡنَآ","أَكۡثَرَهُمۡ","لَفَٰسِقِينَ"],"вама важадна ли'аксарихим мин `ахдин ва'ин важадна аксарахум лафасиḳиин","Большинство из них Мы не нашли верными завету. Воистину, Мы нашли большинство из них нечестивцами.",["и не","Мы нашли","у большинства их","никакого","завета","и поистине","Мы нашли","большинство их","непременно нечестивыми"]],[7,103,["ثُمَّ","بَعَثۡنَا","مِنۢ","بَعۡدِهِم","مُّوسَىٰ","بِـَٔايَٰتِنَآ","إِلَىٰ","فِرۡعَوۡنَ","وَمَلَإِيْهِۦ","فَظَلَمُواْ","بِهَاۖ","فَٱنظُرۡ","كَيۡفَ","كَانَ","عَٰقِبَةُ","ٱلۡمُفۡسِدِينَ"],"сумма ба`асна мим ба`дихим мууса би'айатина ила фир`ауна вамалаихии фазаламуу биха фанзур кайфа кана `аḳибатул муфсидиин","После них Мы отправили Мусу (Моисея) с Нашими знамениями к Фараону и его знати, но они поступили с ними несправедливо. Посмотри же, каким был конец распространявших нечестие!",["затем","Мы послали","вслед","за ними","Мусу","с Нашими знамениями","к","Фараону","и знати его","и несправедливо поступили они","с ними","так посмотри","каким","был","конец","распространявших нечестие"]],[7,104,["وَقَالَ","مُوسَىٰ","يَٰفِرۡعَوۡنُ","إِنِّي","رَسُولٞ","مِّن","رَّبِّ","ٱلۡعَٰلَمِينَ"],"ваḳала мууса йафир`ауну иннии расуулум мир раббил `аламиин","Муса (Моисей) сказал: «О Фараон! Я - посланник от Господа миров.",["и сказал","Муса","о Фараон","поистине, я","посланник","от","Господа","миров"]]],"m":[[["وَلَوۡ","и если бы",7,96],["أَنَّ","что",7,96],["أَهۡلَ","жители",7,96],["ٱلۡقُرَىٰٓ","селений",7,96],["ءَامَنُواْ","уверовали",7,96],["وَٱتَّقَوۡاْ","и были богобоязненны",7,96],["لَفَتَحۡنَا","непременно открыли бы Мы",7,96],["عَلَيۡهِم","для них",7,96],["بَرَكَٰتٖ","благословения",7,96]],[["مِّنَ","от",7,96],["ٱلسَّمَآءِ","неба",7,96],["وَٱلۡأَرۡضِ","и земли",7,96],["وَلَٰكِن","но",7,96],["كَذَّبُواْ","они сочли ложью",7,96],["فَأَخَذۡنَٰهُم","и схватили Мы их",7,96],["بِمَا","за то, что",7,96],["كَانُواْ","они",7,96]],[["يَكۡسِبُونَ","приобретали",7,96],[96],["أَفَأَمِنَ","неужели же в безопасности",7,97],["أَهۡلُ","жители",7,97],["ٱلۡقُرَىٰٓ","селений",7,97],["أَن","что",7,97],["يَأۡتِيَهُم","придёт к ним",7,97],["بَأۡسُنَا","Наша кара",7,97],["بَيَٰتٗا","ночью",7,97]],[["وَهُمۡ","а они",7,97],["نَآئِمُونَ","спят",7,97],[97],["أَوَأَمِنَ","или в безопасности",7,98],["أَهۡلُ","жители",7,98]