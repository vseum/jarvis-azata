{"p":164,"j":9,"a":[[7,105,["حَقِيقٌ","عَلَىٰٓ","أَن","لَّآ","أَقُولَ","عَلَى","ٱللَّهِ","إِلَّا","ٱلۡحَقَّۚ","قَدۡ","جِئۡتُكُم","بِبَيِّنَةٖ","مِّن","رَّبِّكُمۡ","فَأَرۡسِلۡ","مَعِيَ","بَنِيٓ","إِسۡرَٰٓءِيلَ"],"хаḳииḳун `ала ал ла аḳуула `алаллахи иллал хаḳḳа ḳад жи'тукум бибаййинатим мир раббикум фа'арсил ма`ийа бании исраиил","Мне полагается говорить об Аллахе только правду. Я принес вам ясное знамение от вашего Господа. Пошли же со мной сынов Исраила (Израиля)».",["надлежит","мне","чтобы","не","я говорил","об","Аллахе","кроме","истины","уже","я пришёл к вам","с ясным знамением","от","Господа вашего","так отпусти","со мной","сынов","Исраила"]],[7,106,["قَالَ","إِن","كُنتَ","جِئۡتَ","بِـَٔايَةٖ","فَأۡتِ","بِهَآ","إِن","كُنتَ","مِنَ","ٱلصَّٰدِقِينَ"],"ḳала ин кунта жи'та би'айатин фа'ти биха ин кунта минас садиḳиин","Он сказал: «Если ты принес знамение, то покажи его, если ты говоришь правду».",["он сказал","если","ты","пришёл","со знамением","то приведи","его","если","ты","из","правдивых"]],[7,107,["فَأَلۡقَىٰ","عَصَاهُ","فَإِذَا","هِيَ","ثُعۡبَانٞ","مُّبِينٞ"],"фа'алḳа `асаху фа'иза хийа су`банум мубиин","Он бросил свой посох, и тот превратился в явную змею.",["и бросил он","свой посох","и вот","он","змей","явный"]],[7,108,["وَنَزَعَ","يَدَهُۥ","فَإِذَا","هِيَ","بَيۡضَآءُ","لِلنَّٰظِرِينَ"],"ваназа`а йадахуу фа'иза хийа байдау линназириин","Затем он вытащил руку, и она стала белой (цвета молока, светящейся) для тех, кто смотрел на нее.",["и вытащил он","руку свою","и вот","она","белая","для смотрящих"]],[7,109,["قَالَ","ٱلۡمَلَأُ","مِن","قَوۡمِ","فِرۡعَوۡنَ","إِنَّ","هَٰذَا","لَسَٰحِرٌ","عَلِيمٞ"],"ḳалал малау мин ḳауми фир`ауна инна хаза ласахирун `алиим","Знать из народа Фараона сказала: «Воистину, он - знающий колдун.",["сказала","знать","из","народа","Фараона","поистине","этот","непременно колдун","знающий"]],[7,110,["يُرِيدُ","أَن","يُخۡرِجَكُم","مِّنۡ","أَرۡضِكُمۡۖ","فَمَاذَا","تَأۡمُرُونَ"],"йурииду ан йухрижакум мин ардикум фамаза та'муруун","Он хочет вывести вас из вашей страны. Что же вы посоветуете?».",["он хочет","чтобы","вывести вас","из","земли вашей","так что же","вы повелеваете"]],[7,111,["قَالُوٓاْ","أَرۡجِهۡ","وَأَخَاهُ","وَأَرۡسِلۡ","فِي","ٱلۡمَدَآئِنِ","حَٰشِرِينَ"],"ḳалуу аржих ва'ахаху ва'арсил фил мадаини хашириин","Они сказали: «Повремени с ним и его братом и разошли по городам сборщиков,",["они сказали","дай отсрочку ему","и брату его","и пошли","в","города","собирающих"]],[7,112,["يَأۡتُوكَ","بِكُلِّ","سَٰحِرٍ","عَلِيمٖ"],"йа'туука бикулли сахирин `алиим","чтобы они привели к тебе всех знающих колдунов».",["пусть приведут к тебе","всякого","колдуна","знающего"]],[7,113,["وَجَآءَ","ٱلسَّحَرَةُ","فِرۡعَوۡنَ","قَالُوٓاْ","إِنَّ","لَنَا","لَأَجۡرًا","إِن","كُنَّا","نَحۡنُ","ٱلۡغَٰلِبِينَ"],"важаас сахарату фир`ауна ḳалуу инна лана ла'ажран ин кунна нахнул галибиин","Колдуны пришли к Фараону и сказали: «Если мы одержим верх, то нам полагается вознаграждение!».",["и пришли","колдуны","к Фараону","они сказали","поистине","для нас","непременно награда","если","будем","мы","победителями"]],[7,114,["قَالَ","نَعَمۡ","وَإِنَّكُمۡ","لَمِنَ","ٱلۡمُقَرَّبِينَ"],"ḳала на`ам ва'иннакум ламинал муḳаррабиин","Он сказал: «Да, вы станете одними из приближенных».",["он сказал","да","и поистине вы","непременно из","приближённых"]],[7,115,["قَالُواْ","يَٰمُوسَىٰٓ","إِمَّآ","أَن","تُلۡقِيَ","وَإِمَّآ","أَن","نَّكُونَ","نَحۡنُ","ٱلۡمُلۡقِينَ"],"ḳалуу йамууса имма ан тулḳийа ва'имма ан накууна нахнул мулḳиин","Они сказали: «О Муса (Моисей)! Либо ты бросишь, либо бросим мы».",["они сказали","о Муса","либо","что","ты бросишь","либо","что","будем","мы","бросающими"]],[7,116,["قَالَ","أَلۡقُواْۖ","فَلَمَّآ","أَلۡقَوۡاْ","سَحَرُوٓاْ","أَعۡيُنَ","ٱلنَّاسِ","وَٱسۡتَرۡهَبُوهُمۡ","وَجَآءُو","بِسِحۡرٍ","عَظِيمٖ"],"ḳала алḳуу фаламма алḳау сахаруу а`йунан наси вастархабуухум важауу бисихрин `азиим","Он сказал: «Бросайте!». Когда же они бросили, то очаровали взоры людей, вселили в них страх и явили великое колдовство.",["он сказал","бросайте","и когда","они бросили","околдовали они","глаза","людей","и устрашили их","и явили","колдовство","великое"]],[7,117,["وَأَوۡحَيۡنَآ","إِلَىٰ","مُوسَىٰٓ","أَنۡ","أَلۡقِ","عَصَاكَۖ","فَإِذَا","هِيَ","تَلۡقَفُ","مَا","يَأۡفِكُونَ"],"ва'аухайна ила мууса ан алḳи `асака фа'иза хийа талḳафу ма йа'фикуун","Мы внушили Мусе (Моисею): «Брось свой посох!». И вот она (змея) стала заглатывать то, что они измыслили.",["и внушили Мы","(к)","Мусе","что","брось","посох свой","и вот","он","заглатывает","то, что","они измышляли"]],[7,118,["فَوَقَعَ","ٱلۡحَقُّ","وَبَطَلَ","مَا","كَانُواْ","يَعۡمَلُونَ"],"фаваḳа`ал хаḳḳу вабатала ма кануу йа`малуун","Истина подтвердилась, и тщетным оказалось то, что они совершали.",["и утвердилась","истина","и стало тщетным","то, что","они","делали"]],[7,119,["فَغُلِبُواْ","هُنَالِكَ","وَٱنقَلَبُواْ","صَٰغِرِينَ"],"фагулибуу хуналика ванḳалабуу сагириин","Они были повержены там и вернулись униженными.",["и побеждены были они","там","и вернулись","униженными"]],[7,120,["وَأُلۡقِيَ","ٱلسَّحَرَةُ","سَٰجِدِينَ"],"ва'улḳийас сахарату сажидиин","Колдуны пали ниц",["и пали","колдуны","ниц"]]],"m":[[["حَقِيقٌ","надлежит",7,105],["عَلَىٰٓ","мне",7,105],["أَن","чтобы",7,105],["لَّآ","не",7,105],["أَقُولَ","я говорил",7,105],["عَلَى","об",7,105],["ٱللَّهِ","Аллахе",7,105],["إِلَّا","кроме",7,105],["ٱلۡحَقَّۚ","истины",7,105],["قَدۡ","уже",7,105],["جِئۡتُكُم","я пришёл к вам",7,105]],[["بِبَيِّنَةٖ","с ясным знамением",7,105],["مِّن","от",7,105],["رَّبِّكُمۡ","Господа вашего",7,105],["فَأَرۡسِلۡ","так отпусти",7,105],["مَعِيَ","со мной",7,105],["بَنِيٓ","сынов",7,105],["إِسۡرَٰٓءِيلَ","Исраила",7,105],[105],["قَالَ","он сказал",7,106],["إِن","если",7,106],["كُنتَ","ты",7,106]],[["جِئۡتَ","пришёл",7,106],["بِـَٔايَةٖ","со знамением",7,106],["فَأۡتِ","то приведи",7,106],["بِهَآ","его",7,106],["إِن","если",7,106],["كُنتَ","ты",7,106],["مِنَ","из",7,106],["ٱلصَّٰدِقِينَ","правдивых",7,106],[106],["فَأَلۡقَىٰ","и бросил он",7,107]],[["عَصَاهُ","свой п