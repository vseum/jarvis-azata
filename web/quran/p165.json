َ","сказал",7,128],["مُوسَىٰ","Муса",7,128],["لِقَوۡمِهِ","народу своему",7,128]],[["ٱسۡتَعِينُواْ","просите помощи",7,128],["بِٱللَّهِ","у Аллаха",7,128],["وَٱصۡبِرُوٓاْۖ","и терпите",7,128],["إِنَّ","поистине",7,128],["ٱلۡأَرۡضَ","земля",7,128],["لِلَّهِ","принадлежит Аллаху",7,128],["يُورِثُهَا","Он даёт её в наследие",7,128],["مَن","кому",7,128]],[["يَشَآءُ","Он пожелает",7,128],["مِنۡ","из",7,128],["عِبَادِهِۦۖ","рабов Своих",7,128],["وَٱلۡعَٰقِبَةُ","и (благой) исход",7,128],["لِلۡمُتَّقِينَ","для богобоязненных",7,128],[128],["قَالُوٓاْ","они сказали",7,129],["أُوذِينَا","нас мучили",7,129]],[["مِن","ещё",7,129],["قَبۡلِ","до",7,129],["أَن","того как",7,129],["تَأۡتِيَنَا","ты пришёл к нам",7,129],["وَمِنۢ","и",7,129],["بَعۡدِ","после",7,129],["مَا","того как",7,129],["جِئۡتَنَاۚ","ты пришёл к нам",7,129],["قَالَ","он сказал",7,129],["عَسَىٰ","быть может",7,129],["رَبُّكُمۡ","Господь ваш",7,129]],[["أَن","что",7,129],["يُهۡلِكَ","погубит",7,129],["عَدُوَّكُمۡ","врага вашего",7,129],["وَيَسۡتَخۡلِفَكُمۡ","и сделает вас преемниками",7,129],["فِي","на",7,129],["ٱلۡأَرۡضِ","земле",7,129]],[["فَيَنظُرَ","и посмотрит",7,129],["كَيۡفَ","как",7,129],["تَعۡمَلُونَ","вы будете поступать",7,129],[129],["وَلَقَدۡ","и непременно уже",7,130],["أَخَذۡنَآ","Мы поразили",7,130],["ءَالَ","род",7,130],["فِرۡعَوۡنَ","Фараона",7,130]],[["بِٱلسِّنِينَ","годами (засухи)",7,130],["وَنَقۡصٖ","и недостатком",7,130],["مِّنَ","из",7,130],["ٱلثَّمَرَٰتِ","плодов",7,130],["لَعَلَّهُمۡ","чтобы они",7,130],["يَذَّكَّرُونَ","помянули назидание",7,130],[130]]]}