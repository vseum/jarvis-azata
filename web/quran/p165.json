{"p":165,"j":9,"a":[[7,121,["قَالُوٓاْ","ءَامَنَّا","بِرَبِّ","ٱلۡعَٰلَمِينَ"],"ḳалуу аманна бираббил `аламиин","и сказали: «Мы уверовали в Господа миров,",["они сказали","мы уверовали","в Господа","миров"]],[7,122,["رَبِّ","مُوسَىٰ","وَهَٰرُونَ"],"рабби мууса вахаруун","Господа Мусы (Моисея) и Харуна (Аарона)».",["Господа","Мусы","и Харуна"]],[7,123,["قَالَ","فِرۡعَوۡنُ","ءَامَنتُم","بِهِۦ","قَبۡلَ","أَنۡ","ءَاذَنَ","لَكُمۡۖ","إِنَّ","هَٰذَا","لَمَكۡرٞ","مَّكَرۡتُمُوهُ","فِي","ٱلۡمَدِينَةِ","لِتُخۡرِجُواْ","مِنۡهَآ","أَهۡلَهَاۖ","فَسَوۡفَ","تَعۡلَمُونَ"],"ḳала фир`ауну амантум бихии ḳабла ан азана лакум инна хаза ламакрум макартумууху фил мадиинати литухрижуу минха ахлаха фасауфа та`ламуун","Фараон сказал: «Вы уверовали в него без моего дозволения? Воистину, это - козни, которые вы задумали в городе, чтобы изгнать из него его жителей. Но скоро вы узнаете!",["сказал","Фараон","вы уверовали","в него","прежде","чем","я разрешу","вам","поистине","это","непременно козни","которые вы задумали","в","городе","чтобы вы вывели","из него","жителей его","но скоро","вы узнаете"]],[7,124,["لَأُقَطِّعَنَّ","أَيۡدِيَكُمۡ","وَأَرۡجُلَكُم","مِّنۡ","خِلَٰفٖ","ثُمَّ","لَأُصَلِّبَنَّكُمۡ","أَجۡمَعِينَ"],"ла'уḳатти`анна айдийакум ва'аржулакум мин хилафин сумма ла'усаллибаннакум ажма`иин","Я отрублю вам руки и ноги накрест, а затем распну всех вас».",["непременно отрублю я","руки ваши","и ноги ваши","с","противоположных сторон","затем","непременно распну я вас","всех"]],[7,125,["قَالُوٓاْ","إِنَّآ","إِلَىٰ","رَبِّنَا","مُنقَلِبُونَ"],"ḳалуу инна ила раббина мунḳалибуун","Они сказали: «Воистину, мы возвращаемся к нашему Господу.",["они сказали","поистине, мы","к","Господу нашему","возвращаемся"]],[7,126,["وَمَا","تَنقِمُ","مِنَّآ","إِلَّآ","أَنۡ","ءَامَنَّا","بِـَٔايَٰتِ","رَبِّنَا","لَمَّا","جَآءَتۡنَاۚ","رَبَّنَآ","أَفۡرِغۡ","عَلَيۡنَا","صَبۡرٗا","وَتَوَفَّنَا","مُسۡلِمِينَ"],"вама танḳиму минна илла ан аманна би'айати раббина ламма жаатна раббана африг `алайна сабран ватаваффана муслимиин","Ты мстишь нам только за то, что мы уверовали в знамения нашего Господа, когда они явились к нам. Господь наш! Ниспошли нам терпение и умертви нас мусульманами».",["и не","ты мстишь","нам","кроме как","за то, что","мы уверовали","в знамения","Господа нашего","когда","они пришли к нам","Господь наш","излей","на нас","терпение","и упокой нас","мусульманами"]],[7,127,["وَقَالَ","ٱلۡمَلَأُ","مِن","قَوۡمِ","فِرۡعَوۡنَ","أَتَذَرُ","مُوسَىٰ","وَقَوۡمَهُۥ","لِيُفۡسِدُواْ","فِي","ٱلۡأَرۡضِ","وَيَذَرَكَ","وَءَالِهَتَكَۚ","قَالَ","سَنُقَتِّلُ","أَبۡنَآءَهُمۡ","وَنَسۡتَحۡيِۦ","نِسَآءَهُمۡ","وَإِنَّا","فَوۡقَهُمۡ","قَٰهِرُونَ"],"ваḳалал малау мин ḳауми фир`ауна атазару мууса ваḳаумахуу лийуфсидуу фил арди вайазарака ва'алихатака ḳала сануḳаттилу абнаахум ванастахйии нисаахум ва'инна фауḳахум ḳахируун","Знатные люди из народа Фараона сказали: «Неужели ты позволишь Мусе (Моисею) и его народу распространять на земле нечестие и отречься от тебя и твоих богов?». Он сказал: «Мы будем убивать их сыновей и оставлять в живых их женщин. Мы обладаем непоколебимой властью над ними».",["и сказала","знать","из","народа","Фараона","неужели оставишь ты","Мусу","и народ его","чтобы сеяли нечестие","на","земле","и оставил он тебя","и богов твоих","он сказал","мы будем убивать","сыновей их","и оставлять в живых","женщин их","и поистине мы","над ними","властвующие"]],[7,128,["قَالَ","مُوسَىٰ","لِقَوۡمِهِ","ٱسۡتَعِينُواْ","بِٱللَّهِ","وَٱصۡبِرُوٓاْۖ","إِنَّ","ٱلۡأَرۡضَ","لِلَّهِ","يُورِثُهَا","مَن","يَشَآءُ","مِنۡ","عِبَادِهِۦۖ","وَٱلۡعَٰقِبَةُ","لِلۡمُتَّقِينَ"],"ḳала мууса лиḳаумихиста`иинуу биллахи васбируу иннал арда лиллахи йуурисуха ман йашау мин `ибадихии вал`аḳибату лилмуттаḳиин","Муса (Моисей) сказал своему народу: «Просите помощи у Аллаха и терпите. Воистину, земля принадлежит Аллаху. Он дарует ее в наследие тому из Своих рабов, кому пожелает, и благой конец уготован богобоязненным».",["сказал","Муса","народу своему","просите помощи","у Аллаха","и терпите","поистине","земля","принадлежит Аллаху","Он даёт её в наследие","кому","Он пожелает","из","рабов Своих","и (благой) исход","для богобоязненных"]],[7,129,["قَالُوٓاْ","أُوذِينَا","مِن","قَبۡلِ","أَن","تَأۡتِيَنَا","وَمِنۢ","بَعۡدِ","مَا","جِئۡتَنَاۚ","قَالَ","عَسَىٰ","رَبُّكُمۡ","أَن","يُهۡلِكَ","عَدُوَّكُمۡ","وَيَسۡتَخۡلِفَكُمۡ","فِي","ٱلۡأَرۡضِ","فَيَنظُرَ","كَيۡفَ","تَعۡمَلُونَ"],"ḳалуу уузиина мин ḳабли ан та'тийана вамим ба`ди ма жи'тана ḳала `аса раббукум ан йухлика `адуввакум вайастахлифакум фил арди файанзура кайфа та`малуун","Они сказали: «Нам причиняли страдания до того, как ты явился к нам, и причиняют их после твоего пришествия». Он сказал: «Быть может, ваш Господь погубит вашего врага и сделает вас их преемниками на земле, а затем посмотрит, как вы будете поступать».",["они сказали","нас мучили","ещё","до","того как","ты пришёл к нам","и","после","того как","ты пришёл к нам","он сказал","быть может","Господь ваш","что","погубит","врага вашего","и сделает вас преемниками","на","земле","и посмотрит","как","вы будете поступать"]],[7,130,["وَلَقَدۡ","أَخَذۡنَآ","ءَالَ","فِرۡعَوۡنَ","بِٱلسِّنِينَ","وَنَقۡصٖ","مِّنَ","ٱلثَّمَرَٰتِ","لَعَلَّهُمۡ","يَذَّكَّرُونَ"],"валаḳад ахазна ала фир`ауна биссиниина ванаḳсим минас самарати ла`аллахум йаззаккаруун","Мы поразили род Фараона засушливыми годами и неурожаем плодов, дабы они помянули назидание.",["и непременно уже","Мы поразили","род","Фараона","годами (засухи)","и недостатком","из","плодов","чтобы они","помянули назидание"]]],"m":[[["قَالُوٓاْ","они сказали",7,121],["ءَامَنَّا","мы уверовали",7,121],["بِرَبِّ","в Господа",7,121],["ٱلۡعَٰلَمِينَ","миров",7,121],[121],["رَبِّ","Господа",7,122],["مُوسَىٰ","Мусы",7,122],["وَهَٰرُونَ","и Харуна",7,122],[122],["قَالَ","сказал",7,123]],[["فِرۡعَوۡنُ","Фараон",7,123],["ءَامَنتُم","вы уверовали",7,123],["بِهِۦ","в него",7,123],["قَبۡلَ","прежде",7,123],["أَنۡ","чем",7,123],["ءَاذَنَ","я разрешу",7,123],["لَكُمۡۖ","вам",7,123],["إِنَّ","поистине",7,123],["هَٰذَا","это",7,123],["لَمَكۡرٞ","н