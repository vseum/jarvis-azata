{"p":166,"j":9,"a":[[7,131,["فَإِذَا","جَآءَتۡهُمُ","ٱلۡحَسَنَةُ","قَالُواْ","لَنَا","هَٰذِهِۦۖ","وَإِن","تُصِبۡهُمۡ","سَيِّئَةٞ","يَطَّيَّرُواْ","بِمُوسَىٰ","وَمَن","مَّعَهُۥٓۗ","أَلَآ","إِنَّمَا","طَٰٓئِرُهُمۡ","عِندَ","ٱللَّهِ","وَلَٰكِنَّ","أَكۡثَرَهُمۡ","لَا","يَعۡلَمُونَ"],"фа'иза жаатхумул хасанату ḳалуу лана хазихии ва'ин тусибхум саййиатун йаттаййаруу бимууса вамам ма`ахуу ала иннама та'ирухум `индаллахи валакинна аксарахум ла йа`ламуун","Когда их постигало добро, они говорили: «Это - для нас». А когда их постигало зло, они связывали его с Мусой (Моисеем) и теми, кто был с ним. Воистину, их дурные предзнаменования были у Аллаха, но большинство из них не знает этого.",["и когда","приходило к ним","добро","они говорили","нам (положено)","это","а если","постигало их","зло","они видели дурной знак","в Мусе","и тех, кто","с ним","знайте же","лишь","их рок","у","Аллаха","но","большинство их","не","знают"]],[7,132,["وَقَالُواْ","مَهۡمَا","تَأۡتِنَا","بِهِۦ","مِنۡ","ءَايَةٖ","لِّتَسۡحَرَنَا","بِهَا","فَمَا","نَحۡنُ","لَكَ","بِمُؤۡمِنِينَ"],"ваḳалуу махма та'тина бихии мин айатил литасхарана биха фама нахну лака биму'миниин","Они сказали: «Какие бы знамения ты ни показывал, чтобы околдовать нас ими, мы не поверим тебе».",["и сказали они","какое бы ни","ты принёс нам","его","из","знамений","чтобы околдовать нас","им","то не","мы","тебе","верующие"]],[7,133,["فَأَرۡسَلۡنَا","عَلَيۡهِمُ","ٱلطُّوفَانَ","وَٱلۡجَرَادَ","وَٱلۡقُمَّلَ","وَٱلضَّفَادِعَ","وَٱلدَّمَ","ءَايَٰتٖ","مُّفَصَّلَٰتٖ","فَٱسۡتَكۡبَرُواْ","وَكَانُواْ","قَوۡمٗا","مُّجۡرِمِينَ"],"фа'арсална `алайхимут тууфана валжарада валḳуммала ваддафади`а ваддама айатим муфассалатин фастакбаруу вакануу ḳаумам мужримиин","Мы наслали на них потоп, саранчу, вшей, жаб и кровь в качестве различных знамений. Однако они возгордились - они были народом грешным.",["и наслали Мы","на них","потоп","и саранчу","и вшей","и жаб","и кровь","знамениями","разъяснёнными","но возгордились они","и были они","народом","преступным"]],[7,134,["وَلَمَّا","وَقَعَ","عَلَيۡهِمُ","ٱلرِّجۡزُ","قَالُواْ","يَٰمُوسَى","ٱدۡعُ","لَنَا","رَبَّكَ","بِمَا","عَهِدَ","عِندَكَۖ","لَئِن","كَشَفۡتَ","عَنَّا","ٱلرِّجۡزَ","لَنُؤۡمِنَنَّ","لَكَ","وَلَنُرۡسِلَنَّ","مَعَكَ","بَنِيٓ","إِسۡرَٰٓءِيلَ"],"валамма ваḳа`а `алайхимур рижзу ḳалуу йамуусад`у лана раббака бима `ахида `индака ла'ин кашафта `аннар рижза лану'минанна лака валанурсиланна ма`ака бании исраиил","Когда наказание поражало их, они говорили: «О Муса (Моисей)! Помолись за нас твоему Господу о том, что Он обещал тебе. Если ты избавишь нас от наказания, то мы поверим тебе и отпустим с тобой сынов Исраила (Израиля)».",["и когда","пало","на них","наказание","они сказали","о Муса","помолись","за нас","Господу твоему","ради того, что","Он завещал","тебе","если","ты снимешь","с нас","наказание","непременно уверуем мы","тебе","и непременно отпустим","с тобой","сынов","Исраила"]],[7,135,["فَلَمَّا","كَشَفۡنَا","عَنۡهُمُ","ٱلرِّجۡزَ","إِلَىٰٓ","أَجَلٍ","هُم","بَٰلِغُوهُ","إِذَا","هُمۡ","يَنكُثُونَ"],"фаламма кашафна `анхумур рижза ила ажалин хум балигууху иза хум йанкусуун","Когда же Мы избавляли их от наказания до определенного срока, которого они непременно должны были достичь, они нарушали обещание.",["но когда","Мы сняли","с них","наказание","до","срока","они","достигающие его","вот","они","нарушают (обещание)"]],[7,136,["فَٱنتَقَمۡنَا","مِنۡهُمۡ","فَأَغۡرَقۡنَٰهُمۡ","فِي","ٱلۡيَمِّ","بِأَنَّهُمۡ","كَذَّبُواْ","بِـَٔايَٰتِنَا","وَكَانُواْ","عَنۡهَا","غَٰفِلِينَ"],"фантаḳамна минхум фа'аграḳнахум фил йамми би'аннахум каззабуу би'айатина вакануу `анха гафилиин","Мы отомстили им и потопили их в море за то, что они сочли ложью Наши знамения и пренебрегли ими.",["и отомстили Мы","им","и потопили Мы их","в","море","за то, что они","сочли ложью","Наши знамения","и были они","к ним","беспечны"]],[7,137,["وَأَوۡرَثۡنَا","ٱلۡقَوۡمَ","ٱلَّذِينَ","كَانُواْ","يُسۡتَضۡعَفُونَ","مَشَٰرِقَ","ٱلۡأَرۡضِ","وَمَغَٰرِبَهَا","ٱلَّتِي","بَٰرَكۡنَا","فِيهَاۖ","وَتَمَّتۡ","كَلِمَتُ","رَبِّكَ","ٱلۡحُسۡنَىٰ","عَلَىٰ","بَنِيٓ","إِسۡرَٰٓءِيلَ","بِمَا","صَبَرُواْۖ","وَدَمَّرۡنَا","مَا","كَانَ","يَصۡنَعُ","فِرۡعَوۡنُ","وَقَوۡمُهُۥ","وَمَا","كَانُواْ","يَعۡرِشُونَ"],"ва'аураснал ḳаумал лазиина кануу йустад`афууна машариḳал арди вамагарибахал латии баракна фииха ватаммат калимату раббикал хусна `ала бании исраиила бима сабаруу вадаммарна ма кана йасна`у фир`ауну ваḳаумухуу вама кануу йа`ришуун","Мы даровали в наследие тем, которых считали слабыми, восточные и западные земли, которые Мы благословили. Сбылось прекрасное Слово твоего Господа о сынах Исраила (Израиля), поскольку они проявили терпение. Мы разрушили то, что содеяли Фараон и его народ и что они воздвигали.",["и дали Мы в наследие","людям","тем, которые","были","притесняемы","восточные части","земли","и западные её","которые","Мы благословили","в ней","и исполнилось","слово","Господа твоего","прекрасное","о","сынах","Исраила","за то, что","они терпели","и разрушили Мы","то, что","обычно","делал","Фараон","и народ его","и то, что","они","воздвигали"]]],"m":[[["فَإِذَا","и когда",7,131],["جَآءَتۡهُمُ","приходило к ним",7,131],["ٱلۡحَسَنَةُ","добро",7,131],["قَالُواْ","они говорили",7,131],["لَنَا","нам (положено)",7,131],["هَٰذِهِۦۖ","это",7,131],["وَإِن","а если",7,131],["تُصِبۡهُمۡ","постигало их",7,131],["سَيِّئَةٞ","зло",7,131]],[["يَطَّيَّرُواْ","они видели дурной знак",7,131],["بِمُوسَىٰ","в Мусе",7,131],["وَمَن","и тех, кто",7,131],["مَّعَهُۥٓۗ","с ним",7,131],["أَلَآ","знайте же",7,131],["إِنَّمَا","лишь",7,131],["طَٰٓئِرُهُمۡ","их рок",7,131],["عِندَ","у",7,131],["ٱللَّهِ","Аллаха",7,131],["وَلَٰكِنَّ","но",7,131]],[["أَكۡثَرَهُمۡ","большинство их",7,131],["لَا","не",7,131],["يَعۡلَمُونَ","знают",7,131],[131],["وَقَالُواْ","и сказали они",7,132],["مَهۡمَا","какое бы ни",7,132],["تَأۡتِنَا","ты принёс нам",7,132],["بِهِۦ","его",7,132],["مِنۡ","из",7,132],["ءَايَةٖ","знамений",7,132]],[["لِّتَسۡحَرَنَا","чтобы околдовать нас",7,132],["بِهَا","им",7,132],["فَمَا","то не",7,132],["نَحۡنُ","мы",7,132],["لَكَ","тебе",7,132],["بِمُؤۡمِنِينَ","верующие",7,132],[132],["فَأَرۡسَلۡنَا","и наслали Мы",7,133],["عَلَيۡهِمُ","на них",7,133]],[["ٱلطُّوفَانَ","потоп",7,133],["وَٱلۡجَرَادَ","и саранчу",7,133],["وَٱلۡقُمَّلَ","и вшей",7,133],["وَٱلضَّفَادِعَ","и жаб",7,133],["وَٱلدَّمَ","и кровь",7,133],["ءَايَٰتٖ","знамениями",7,133],["مُّفَصَّلَٰتٖ","разъяснёнными",7,133]],[["فَٱسۡتَكۡبَرُواْ","но возгордились они",7,133],["وَكَانُواْ","и были они",7,133],["قَوۡمٗا","народом",7,133],["مُّجۡرِمِينَ","преступным",7,133],[133],["وَلَمَّا","и когда",7,134],["وَقَعَ","пало",7,134],["عَلَيۡهِمُ","на них",7,134]],[["ٱلرِّجۡزُ","наказание",7,134],["قَالُواْ","они сказали",7,134],["يَٰمُوسَى","о Муса",7,134],["ٱدۡعُ","помолись",7,134],["لَنَا","за нас",7,134],["رَبَّكَ","Господу твоему",7,134],["بِمَا","ради того, что",7,134],["عَهِدَ","Он завещал",7,134],["عِندَكَۖ","тебе",7,134],["لَئِن","если",7,134]],[["كَشَفۡتَ","ты снимешь",7,134],["عَنَّا","с нас",7,134],["ٱلرِّجۡزَ","наказание",7,134],["لَنُؤۡمِنَنَّ","непременно уверуем мы",7,134],["لَكَ","тебе",7,134],["وَلَنُرۡسِلَنَّ","и непременно отпустим",7,134],["مَعَكَ","с тобой",7,134],["بَنِيٓ","сынов",7,134]],[["إِسۡرَٰٓءِيلَ","Исраила",7,134],[134],["فَلَمَّا","но когда",7,135],["كَشَفۡنَا","Мы сняли",7,135],["عَنۡهُمُ","с них",7,135],["ٱلرِّجۡزَ","наказание",7,135],["إِلَىٰٓ","до",7,135],["أَجَلٍ","срока",7,135]],[["هُم","они",7,135],["بَٰلِغُوهُ","достигающие его",7,135],["إِذَا","вот",7,135],["هُمۡ","они",7,135],["يَنكُثُونَ","нарушают (обещание)",7,135],[135],["فَٱنتَقَمۡنَا","и отомстили Мы",7,136],["مِنۡهُمۡ","им",7,136],["فَأَغۡرَقۡنَٰهُمۡ","и потопили Мы их",7,136]],[["فِي","в",7,136],["ٱلۡيَمِّ","море",7,136],["بِأَنَّهُمۡ","за то, что они",7,136],["كَذَّبُواْ","сочли ложью",7,136],["بِـَٔايَٰتِنَا","Наши знамения",7,136],["وَكَانُواْ","и были они",7,136],["عَنۡهَا","к ним",7,136],["غَٰفِلِينَ","беспечны",7,136],[136]],[["وَأَوۡرَثۡنَا","и дали Мы в наследие",7,137],["ٱلۡقَوۡمَ","людям",7,137],["ٱلَّذِينَ","тем, которые",7,137],["كَانُواْ","были",7,137],["يُسۡتَضۡعَفُونَ","притесняемы",7,137],["مَشَٰرِقَ","восточные части",7,137]],[["ٱلۡأَرۡضِ","земли",7,137],["وَمَغَٰرِبَهَا","и западные её",7,137],["ٱلَّتِي","которые",7,137],["بَٰرَكۡنَا","Мы благословили",7,137],["فِيهَاۖ","в ней",7,137],["وَتَمَّتۡ","и исполнилось",7,137],["كَلِمَتُ","слово",7,137],["رَبِّكَ","Господа твоего",7,137]],[["ٱلۡحُسۡنَىٰ","прекрасное",7,137],["عَلَىٰ","о",7,137],["بَنِيٓ","сынах",7,137],["إِسۡرَٰٓءِيلَ","Исраила",7,137],["بِمَا","за то, что",7,137],["صَبَرُواْۖ","они терпели",7,137],["وَدَمَّرۡنَا","и разрушили Мы",7,137],["مَا","то, что",7,137],["كَانَ","обычно",7,137]],[["يَصۡنَعُ","делал",7,137],["فِرۡعَوۡنُ","Фараон",7,137],["وَقَوۡمُهُۥ","и народ его",7,137],["وَمَا","и то, что",7,137],["كَانُواْ","они",7,137],["يَعۡرِشُونَ","воздвигали",7,137],[137]]]}