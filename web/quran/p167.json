{"p":167,"j":9,"a":[[7,138,["وَجَٰوَزۡنَا","بِبَنِيٓ","إِسۡرَٰٓءِيلَ","ٱلۡبَحۡرَ","فَأَتَوۡاْ","عَلَىٰ","قَوۡمٖ","يَعۡكُفُونَ","عَلَىٰٓ","أَصۡنَامٖ","لَّهُمۡۚ","قَالُواْ","يَٰمُوسَى","ٱجۡعَل","لَّنَآ","إِلَٰهٗا","كَمَا","لَهُمۡ","ءَالِهَةٞۚ","قَالَ","إِنَّكُمۡ","قَوۡمٞ","تَجۡهَلُونَ"],"важавазна бибании исраиилал бахра фа'атау `ала ḳаумин йа`куфууна `ала аснамил лахум ḳалуу йамуусаж`ал ллана илахан кама лахум алихатун ḳала иннакум ḳаумун тажхалуун","Мы переправили сынов Исраила (Израиля) через море, и они прибыли к народу, который был предан своим идолам. Они сказали: «О Муса (Моисей)! Сделай нам божество, такое же, как у них». Он сказал: «Воистину, вы - невежественные люди.",["и переправили Мы","сынов","Исраила","через море","и пришли они","к","народу","преданно служившему","(при)","идолах","своих","они сказали","о Муса","сделай","для нас","божество","как","у них","боги","он сказал","поистине, вы","народ","невежественный"]],[7,139,["إِنَّ","هَٰٓؤُلَآءِ","مُتَبَّرٞ","مَّا","هُمۡ","فِيهِ","وَبَٰطِلٞ","مَّا","كَانُواْ","يَعۡمَلُونَ"],"инна ха'улаи мутаббарум ма хум фиихи вабатилум ма кануу йа`малуун","У этих людей погублено будет то, что они исповедуют, и тщетно будет то, что они совершают».",["поистине","эти","погублено","то, что","они","пребывают в нём","и тщетно","то, что","они","делали"]],[7,140,["قَالَ","أَغَيۡرَ","ٱللَّهِ","أَبۡغِيكُمۡ","إِلَٰهٗا","وَهُوَ","فَضَّلَكُمۡ","عَلَى","ٱلۡعَٰلَمِينَ"],"ḳала агайраллахи абгиикум илахан вахуа фаддалакум `алал `аламиин","Он сказал: «Неужели я стану искать для вас другое божество, кроме Аллаха, который возвысил вас над мирами».",["он сказал","неужели помимо","Аллаха","я буду искать вам","божество","в то время как Он","предпочёл вас","над","мирами"]],[7,141,["وَإِذۡ","أَنجَيۡنَٰكُم","مِّنۡ","ءَالِ","فِرۡعَوۡنَ","يَسُومُونَكُمۡ","سُوٓءَ","ٱلۡعَذَابِ","يُقَتِّلُونَ","أَبۡنَآءَكُمۡ","وَيَسۡتَحۡيُونَ","نِسَآءَكُمۡۚ","وَفِي","ذَٰلِكُم","بَلَآءٞ","مِّن","رَّبِّكُمۡ","عَظِيمٞ"],"ва'из анжайнакум мин али фир`ауна йасуумуунакум сууал `азаби йуḳаттилууна абнаакум вайастахйууна нисаакум вафии заликум балаум мир раббикум `азиим","Вот Мы спасли вас от рода Фараона. Они подвергали вас ужасным мучениям, убивали ваших сыновей и оставляли в живых ваших женщин. Это было для вас великим испытанием (или великой милостью) от вашего Господа.",["и вот","Мы спасли вас","от","рода","Фараона","они подвергали вас","худшему","мучению","они убивали","сыновей ваших","и оставляли в живых","женщин ваших","и в","этом","испытание","от","Господа вашего","великое"]],[7,142,["وَوَٰعَدۡنَا","مُوسَىٰ","ثَلَٰثِينَ","لَيۡلَةٗ","وَأَتۡمَمۡنَٰهَا","بِعَشۡرٖ","فَتَمَّ","مِيقَٰتُ","رَبِّهِۦٓ","أَرۡبَعِينَ","لَيۡلَةٗۚ","وَقَالَ","مُوسَىٰ","لِأَخِيهِ","هَٰرُونَ","ٱخۡلُفۡنِي","فِي","قَوۡمِي","وَأَصۡلِحۡ","وَلَا","تَتَّبِعۡ","سَبِيلَ","ٱلۡمُفۡسِدِينَ"],"вава`адна мууса саласиина лайлатан ва'атмамнаха би`ашрин фатамма мииḳату раббихии арба`иина лайлатан ваḳала мууса ли'ахиихи харуунахлуфнии фии ḳаумии ва'аслих вала таттаби` сабиилал муфсидиин","Мы определили Мусе (Моисею) тридцать ночей и добавили к ним еще десять, и поэтому срок его Господа составил сорок ночей. Муса (Моисей) сказал своему брату Харуну (Аарону): «Оставайся вместо меня среди моего народа, поступай праведно и не следуй путем распространяющих нечестие».",["и назначили Мы","Мусе","тридцать","ночей","и дополнили Мы их","десятью","и завершился","срок","Господа его","в сорок","ночей","и сказал","Муса","брату своему","Харуну","замени меня","среди","народа моего","и поступай праведно","и не","следуй","путём","распространяющих нечестие"]],[7,143,["وَلَمَّا","جَآءَ","مُوسَىٰ","لِمِيقَٰتِنَا","وَكَلَّمَهُۥ","رَبُّهُۥ","قَالَ","رَبِّ","أَرِنِيٓ","أَنظُرۡ","إِلَيۡكَۚ","قَالَ","لَن","تَرَىٰنِي","وَلَٰكِنِ","ٱنظُرۡ","إِلَى","ٱلۡجَبَلِ","فَإِنِ","ٱسۡتَقَرَّ","مَكَانَهُۥ","فَسَوۡفَ","تَرَىٰنِيۚ","فَلَمَّا","تَجَلَّىٰ","رَبُّهُۥ","لِلۡجَبَلِ","جَعَلَهُۥ","دَكّٗا","وَخَرَّ","مُوسَىٰ","صَعِقٗاۚ","فَلَمَّآ","أَفَاقَ","قَالَ","سُبۡحَٰنَكَ","تُبۡتُ","إِلَيۡكَ","وَأَنَا۠","أَوَّلُ","ٱلۡمُؤۡمِنِينَ"],"валамма жаа мууса лимииḳатина вакалламахуу раббухуу ḳала рабби аринии анзур илайка ḳала лан тарании валакининзур илал жабали фа'инистаḳарра маканахуу фасауфа тарании фаламма тажалла раббухуу лилжабали жа`алахуу даккан вахарра мууса са`иḳан фаламма афаḳа ḳала субханака тубту илайка ва'ана аввалул му'миниин","Когда же Муса (Моисей) пришел к назначенному Нами сроку и месту, Господь его заговорил с ним. Он сказал: «Господи! Покажись мне, чтобы я взглянул на Тебя». Он сказал: «Ты не увидишь Меня, но взгляни на гору. Если она удержится на своем месте, то ты увидишь Меня». Когда же Господь его показался горе, то разбил ее и превратил в песок, а Муса (Моисей) упал без сознания. Придя в себя, он сказал: «Пречист Ты! Я раскаиваюсь перед Тобой, и я - первый из верующих».",["и когда","пришёл","Муса","к Нашему сроку","и заговорил с ним","Господь его","он сказал","Господи","покажи мне","я взгляну","на Тебя","Он сказал","никогда не","увидишь Меня","но","взгляни","на","гору","и если","устоит","на месте своём","то","увидишь Меня","и когда","явил Себя","Господь его","горе","Он сделал её","прахом","и упал","Муса","без сознания","и когда","он очнулся","он сказал","пречист Ты","я каюсь","перед Тобой","и я","первый","из верующих"]]],"m":[[["وَجَٰوَزۡنَا","и переправили Мы",7,138],["بِبَنِيٓ","сынов",7,138],["إِسۡرَٰٓءِيلَ","Исраила",7,138],["ٱلۡبَحۡرَ","через море",7,138],["فَأَتَوۡاْ","и пришли они",7,138],["عَلَىٰ","к",7,138],["قَوۡمٖ","народу",7,138],["يَعۡكُفُونَ","преданно служившему",7,138],["عَلَىٰٓ","(при)",7,138]],[["أَصۡنَامٖ","идолах",7,138],["لَّهُمۡۚ","своих",7,138],["قَالُواْ","они сказали",7,138],["يَٰمُوسَى","о Муса",7,138],["ٱجۡعَل","сделай",7,138],["لَّنَآ","для нас",7,138],["إِلَٰهٗا","божество",7,138],["كَمَا","как",7,138],["لَهُمۡ","у них",7,138],["ءَالِهَةٞۚ","боги",7,138]],[["قَالَ","он сказал",7,138],["إِنَّكُمۡ","поистине, вы",7,138],["قَوۡمٞ","народ",7,138],["تَجۡهَلُونَ","невежественный",7,138],[138],["إِنَّ","поистине",7,139],["هَٰٓؤُلَآءِ"