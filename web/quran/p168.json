{"p":168,"j":9,"a":[[7,144,["قَالَ","يَٰمُوسَىٰٓ","إِنِّي","ٱصۡطَفَيۡتُكَ","عَلَى","ٱلنَّاسِ","بِرِسَٰلَٰتِي","وَبِكَلَٰمِي","فَخُذۡ","مَآ","ءَاتَيۡتُكَ","وَكُن","مِّنَ","ٱلشَّٰكِرِينَ"],"ḳала йамууса иннистафайтука `алан наси бирисалатии вабикаламии фахуз ма атайтука вакум минаш шакириин","Он сказал: «О Муса (Моисей)! Я возвысил тебя над людьми благодаря Моему посланию и Моей беседе. Посему возьми то, что Я даровал тебе, и будь одним из благодарных».",["Он сказал","о Муса","поистине, Я","избрал тебя","над","людьми","посланиями Моими","и речью Моей","так возьми","то, что","Я дал тебе","и будь","из","благодарных"]],[7,145,["وَكَتَبۡنَا","لَهُۥ","فِي","ٱلۡأَلۡوَاحِ","مِن","كُلِّ","شَيۡءٖ","مَّوۡعِظَةٗ","وَتَفۡصِيلٗا","لِّكُلِّ","شَيۡءٖ","فَخُذۡهَا","بِقُوَّةٖ","وَأۡمُرۡ","قَوۡمَكَ","يَأۡخُذُواْ","بِأَحۡسَنِهَاۚ","سَأُوْرِيكُمۡ","دَارَ","ٱلۡفَٰسِقِينَ"],"вакатабна лахуу фил алвахи мин кулли шай'им мау`изатан ватафсиилал ликулли шай'ин фахузха биḳувватин ва'мур ḳаумака йа'хузуу би'ахсаниха са'уриикум дарал фасиḳиин","Мы написали для него на скрижалях увещевание о всякой вещи и разъяснение всего сущего: «Держи их крепко и вели твоему народу следовать наилучшему из этого. Я покажу вам Обитель нечестивцев.",["и написали Мы","для него","на","скрижалях","из","всякой","вещи","увещевание","и разъяснение","для всякой","вещи","так держи их","крепко","и вели","народу своему","пусть держатся","наилучшего в них","Я покажу вам","обитель","нечестивцев"]],[7,146,["سَأَصۡرِفُ","عَنۡ","ءَايَٰتِيَ","ٱلَّذِينَ","يَتَكَبَّرُونَ","فِي","ٱلۡأَرۡضِ","بِغَيۡرِ","ٱلۡحَقِّ","وَإِن","يَرَوۡاْ","كُلَّ","ءَايَةٖ","لَّا","يُؤۡمِنُواْ","بِهَا","وَإِن","يَرَوۡاْ","سَبِيلَ","ٱلرُّشۡدِ","لَا","يَتَّخِذُوهُ","سَبِيلٗا","وَإِن","يَرَوۡاْ","سَبِيلَ","ٱلۡغَيِّ","يَتَّخِذُوهُ","سَبِيلٗاۚ","ذَٰلِكَ","بِأَنَّهُمۡ","كَذَّبُواْ","بِـَٔايَٰتِنَا","وَكَانُواْ","عَنۡهَا","غَٰفِلِينَ"],"са'асрифу `ан айатийал лазиина йатакаббарууна фил арди бигайрил хаḳḳи ва'ин йарау кулла айатил ла йу'минуу биха ва'ин йарау сабиилар рушди ла йаттахизууху сабиилан ва'ин йарау сабиилал гаййи йаттахизууху сабиилан залика би'аннахум каззабуу би'айатина вакануу `анха гафилиин","Я отвращу от Моих знамений тех, которые возгордились на земле без всякого права на то. Какое бы знамение они ни увидели, они не уверуют в него. Если они увидят правый путь, то не последуют этим путем, а если они увидят путь заблуждения, то последуют им. Это потому, что они сочли ложью Наши знамения и пренебрегли ими».",["Я отвращу","от","знамений Моих","тех, которые","превозносятся","на","земле","без","права","и если","они увидят","всякое","знамение","не","уверуют они","в него","и если","увидят они","путь","прямоты","не","возьмут его","путём","а если","увидят они","путь","заблуждения","возьмут его","путём","это","за то, что они","сочли ложью","Наши знамения","и были они","к ним","беспечны"]],[7,147,["وَٱلَّذِينَ","كَذَّبُواْ","بِـَٔايَٰتِنَا","وَلِقَآءِ","ٱلۡأٓخِرَةِ","حَبِطَتۡ","أَعۡمَٰلُهُمۡۚ","هَلۡ","يُجۡزَوۡنَ","إِلَّا","مَا","كَانُواْ","يَعۡمَلُونَ"],"валлазиина каззабуу би'айатина валиḳаил ахирати хабитат а`малухум хал йужзауна илла ма кануу йа`малуун","Деяния тех, которые сочли ложью Наши знамения и встречу в Последней жизни, окажутся тщетными. Разве им не воздастся только за то, что они совершали?",["а те, которые","сочли ложью","Наши знамения","и встречу","Последней жизни","тщетны","деяния их","разве","им воздастся","кроме как","за то, что","они","делали"]],[7,148,["وَٱتَّخَذَ","قَوۡمُ","مُوسَىٰ","مِنۢ","بَعۡدِهِۦ","مِنۡ","حُلِيِّهِمۡ","عِجۡلٗا","جَسَدٗا","لَّهُۥ","خُوَارٌۚ","أَلَمۡ","يَرَوۡاْ","أَنَّهُۥ","لَا","يُكَلِّمُهُمۡ","وَلَا","يَهۡدِيهِمۡ","سَبِيلًاۘ","ٱتَّخَذُوهُ","وَكَانُواْ","ظَٰلِمِينَ"],"ваттахаза ḳауму мууса мим ба`дихии мин хулиййихим `ижлан жасадал лахуу хуарун алам йарау аннахуу ла йукаллимухум вала йахдиихим сабииланиттахазууху вакануу залимиин","В отсутствие Мусы (Моисея) его народ сделал из своих украшений изваяние тельца, который мычал. Разве они не видели, что он не разговаривал с ними и не наставлял их на прямой путь? Они стали поклоняться ему - они были несправедливы.",["и сделал","народ","Мусы","вслед","за ним","из","украшений своих","тельца","тело","у которого","мычание","разве не","видели они","что он","не","говорит с ними","и не","ведёт их","путём","они взяли его (богом)","и были они","несправедливыми"]],[7,149,["وَلَمَّا","سُقِطَ","فِيٓ","أَيۡدِيهِمۡ","وَرَأَوۡاْ","أَنَّهُمۡ","قَدۡ","ضَلُّواْ","قَالُواْ","لَئِن","لَّمۡ","يَرۡحَمۡنَا","رَبُّنَا","وَيَغۡفِرۡ","لَنَا","لَنَكُونَنَّ","مِنَ","ٱلۡخَٰسِرِينَ"],"валамма суḳита фии айдиихим вараау аннахум ḳад даллуу ḳалуу ла'ил лам йархамна раббуна вайагфир лана ланакуунанна минал хасириин","Когда же они пожалели о содеянном и увидели, что впали в заблуждение, то сказали: «Если наш Господь не смилостивится над нами и не простит нас, то мы непременно окажемся в числе потерпевших убыток».",["и когда","выпало (раскаяние)","в","руки их","и увидели они","что они","уже","сбились","они сказали","если","не","помилует нас","Господь наш","и (не) простит","нам","непременно будем мы","из","потерпевших убыток"]]],"m":[[["قَالَ","Он сказал",7,144],["يَٰمُوسَىٰٓ","о Муса",7,144],["إِنِّي","поистине, Я",7,144],["ٱصۡطَفَيۡتُكَ","избрал тебя",7,144],["عَلَى","над",7,144],["ٱلنَّاسِ","людьми",7,144],["بِرِسَٰلَٰتِي","посланиями Моими",7,144],["وَبِكَلَٰمِي","и речью Моей",7,144]],[["فَخُذۡ","так возьми",7,144],["مَآ","то, что",7,144],["ءَاتَيۡتُكَ","Я дал тебе",7,144],["وَكُن","и будь",7,144],["مِّنَ","из",7,144],["ٱلشَّٰكِرِينَ","благодарных",7,144],[144],["وَكَتَبۡنَا","и написали Мы",7,145]],[["لَهُۥ","для него",7,145],["فِي","на",7,145],["ٱلۡأَلۡوَاحِ","скрижалях",7,145],["مِن","из",7,145],["كُلِّ","всякой",7,145],["شَيۡءٖ","вещи",7,145],["مَّوۡعِظَةٗ","увещевание",7,145],["وَتَفۡصِيلٗا","и разъяснение",7,145],["لِّكُلِّ","для всякой",7,145]],[["شَيۡءٖ","вещи",7,145],["فَخُذۡهَا","так держи их",7,145],["بِقُوَّةٖ","крепко",7,145],["وَأۡمُرۡ","и вели",7,145],["قَوۡمَكَ","народу своему",7,145],["يَأۡخُذُواْ","пусть дер