ве не",7,148],["يَرَوۡاْ","видели они",7,148],["أَنَّهُۥ","что он",7,148],["لَا","не",7,148],["يُكَلِّمُهُمۡ","говорит с ними",7,148],["وَلَا","и не",7,148],["يَهۡدِيهِمۡ","ведёт их",7,148]],[["سَبِيلًاۘ","путём",7,148],["ٱتَّخَذُوهُ","они взяли его (богом)",7,148],["وَكَانُواْ","и были они",7,148],["ظَٰلِمِينَ","несправедливыми",7,148],[148],["وَلَمَّا","и когда",7,149],["سُقِطَ","выпало (раскаяние)",7,149]],[["فِيٓ","в",7,149],["أَيۡدِيهِمۡ","руки их",7,149],["وَرَأَوۡاْ","и увидели они",7,149],["أَنَّهُمۡ","что они",7,149],["قَدۡ","уже",7,149],["ضَلُّواْ","сбились",7,149],["قَالُواْ","они сказали",7,149],["لَئِن","если",7,149],["لَّمۡ","не",7,149],["يَرۡحَمۡنَا","помилует нас",7,149]],[["رَبُّنَا","Господь наш",7,149],["وَيَغۡفِرۡ","и (не) простит",7,149],["لَنَا","нам",7,149],["لَنَكُونَنَّ","непременно будем мы",7,149],["مِنَ","из",7,149],["ٱلۡخَٰسِرِينَ","потерпевших убыток",7,149],[149]]]}