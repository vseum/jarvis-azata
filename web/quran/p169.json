{"p":169,"j":9,"a":[[7,150,["وَلَمَّا","رَجَعَ","مُوسَىٰٓ","إِلَىٰ","قَوۡمِهِۦ","غَضۡبَٰنَ","أَسِفٗا","قَالَ","بِئۡسَمَا","خَلَفۡتُمُونِي","مِنۢ","بَعۡدِيٓۖ","أَعَجِلۡتُمۡ","أَمۡرَ","رَبِّكُمۡۖ","وَأَلۡقَى","ٱلۡأَلۡوَاحَ","وَأَخَذَ","بِرَأۡسِ","أَخِيهِ","يَجُرُّهُۥٓ","إِلَيۡهِۚ","قَالَ","ٱبۡنَ","أُمَّ","إِنَّ","ٱلۡقَوۡمَ","ٱسۡتَضۡعَفُونِي","وَكَادُواْ","يَقۡتُلُونَنِي","فَلَا","تُشۡمِتۡ","بِيَ","ٱلۡأَعۡدَآءَ","وَلَا","تَجۡعَلۡنِي","مَعَ","ٱلۡقَوۡمِ","ٱلظَّٰلِمِينَ"],"валамма ража`а мууса ила ḳаумихии гадбана асифан ḳала би'сама халафтумуунии мим ба`дии а`ажилтум амра раббикум ва'алḳал алваха ва'ахаза бира'си ахиихи йажуррухуу илайхи ḳалабна умма иннал ḳаумастад`афуунии вакадуу йаḳтулуунании фала тушмит бийал а`даа вала таж`алнии ма`ал ḳаумиз залимиин","Когда Муса (Моисей) вернулся к своему народу, он разгневался и опечалился. Он сказал: «Скверно то, что вы совершили в мое отсутствие. Неужели вы хотели опередить повеление вашего Господа?». Он бросил скрижали, схватил своего брата за голову и потянул его к себе. Тот сказал: «О сын моей матери! Воистину, люди сочли меня слабым и готовы были убить меня. Не давай врагам повода злорадствовать и не причисляй меня к несправедливым людям».",["и когда","вернулся","Муса","к","народу своему","гневный","опечаленный","он сказал","скверно то, что","вы творили вместо меня","после","меня","неужели поторопили вы","повеление","Господа вашего","и бросил он","скрижали","и схватил","за голову","брата своего","таща его","к себе","он сказал","о сын","матери (моей)","поистине","люди","сочли меня слабым","и едва не","убили меня","так не","дай злорадствовать","надо мной","врагам","и не","помещай меня","с","людьми","несправедливыми"]],[7,151,["قَالَ","رَبِّ","ٱغۡفِرۡ","لِي","وَلِأَخِي","وَأَدۡخِلۡنَا","فِي","رَحۡمَتِكَۖ","وَأَنتَ","أَرۡحَمُ","ٱلرَّٰحِمِينَ"],"ḳала раббигфир лии валиахии ва'адхилна фии рахматика ва'анта архамур рахимиин","Он сказал: «Господи! Прости меня и моего брата и введи нас в Свою милость, ибо Ты - Милосерднейший из милосердных».",["Он сказал","Господи","прости","мне","и моему брату","и введи нас","в","Твою милость","и Ты","Милосерднейший","из милосердных"]],[7,152,["إِنَّ","ٱلَّذِينَ","ٱتَّخَذُواْ","ٱلۡعِجۡلَ","سَيَنَالُهُمۡ","غَضَبٞ","مِّن","رَّبِّهِمۡ","وَذِلَّةٞ","فِي","ٱلۡحَيَوٰةِ","ٱلدُّنۡيَاۚ","وَكَذَٰلِكَ","نَجۡزِي","ٱلۡمُفۡتَرِينَ"],"иннал лазиинаттахазул `ижла сайаналухум гадабум мир раббихим вазиллатун фил хайаватид дунйа ваказалика нажзил муфтариин","На тех, которые стали поклоняться тельцу, падут гнев их Господа и унижение в мирской жизни. Так Мы воздаем тем, кто измышляет ложь.",["поистине","те, которые","взяли (себе)","тельца","постигнет их","гнев","от","их Господа","и унижение","в","жизни","ближней","и так","Мы воздаём","измышляющим (ложь)"]],[7,153,["وَٱلَّذِينَ","عَمِلُواْ","ٱلسَّيِّـَٔاتِ","ثُمَّ","تَابُواْ","مِنۢ","بَعۡدِهَا","وَءَامَنُوٓاْ","إِنَّ","رَبَّكَ","مِنۢ","بَعۡدِهَا","لَغَفُورٞ","رَّحِيمٞ"],"валлазиина `амилус саййиати сумма табуу мим ба`диха ва'амануу инна раббака мим ба`диха лагафуурур рахиим","А если кто совершил злодеяния, а затем раскаялся и уверовал, то ведь твой Господь после всего этого - Прощающий, Милосердный.",["а те, которые","совершили","злые дела","затем","покаялись","от","после этого","и уверовали","поистине","твой Господь","от","после этого","непременно Прощающий","Милосердный"]],[7,154,["وَلَمَّا","سَكَتَ","عَن","مُّوسَى","ٱلۡغَضَبُ","أَخَذَ","ٱلۡأَلۡوَاحَۖ","وَفِي","نُسۡخَتِهَا","هُدٗى","وَرَحۡمَةٞ","لِّلَّذِينَ","هُمۡ","لِرَبِّهِمۡ","يَرۡهَبُونَ"],"валамма саката `ам муусал гадабу ахазал алваха вафии нусхатиха худан варахматул лиллазиина хум лираббихим йархабуун","Когда гнев Мусы (Моисея) спал, он взял скрижали, на которых были начертаны верное руководство и милость для тех, кто боится своего Господа.",["и когда","утих","у","Мусы","гнев","он взял","скрижали","и в","их записи","руководство","и милость","для тех, которые","они","своего Господа","боятся"]],[7,155,["وَٱخۡتَارَ","مُوسَىٰ","قَوۡمَهُۥ","سَبۡعِينَ","رَجُلٗا","لِّمِيقَٰتِنَاۖ","فَلَمَّآ","أَخَذَتۡهُمُ","ٱلرَّجۡفَةُ","قَالَ","رَبِّ","لَوۡ","شِئۡتَ","أَهۡلَكۡتَهُم","مِّن","قَبۡلُ","وَإِيَّٰيَۖ","أَتُهۡلِكُنَا","بِمَا","فَعَلَ","ٱلسُّفَهَآءُ","مِنَّآۖ","إِنۡ","هِيَ","إِلَّا","فِتۡنَتُكَ","تُضِلُّ","بِهَا","مَن","تَشَآءُ","وَتَهۡدِي","مَن","تَشَآءُۖ","أَنتَ","وَلِيُّنَا","فَٱغۡفِرۡ","لَنَا","وَٱرۡحَمۡنَاۖ","وَأَنتَ","خَيۡرُ","ٱلۡغَٰفِرِينَ"],"вахтара мууса ḳаумахуу саб`иина ражулал лимииḳатина фаламма ахазатхумур ражфату ḳала рабби лау ши'та ахлактахум мин ḳаблу ва'иййайа атухликуна бима фа`алас суфахау минна ин хийа илла фитнатука тудиллу биха ман ташау ватахдии ман ташау анта валиййуна фагфир лана вархамна ва'анта хайрул гафириин","Муса (Моисей) отобрал из своего народа семьдесят мужей для назначенного Нами срока и места. Когда же их поразило землетрясение, он сказал: «Господи! Если бы Ты пожелал, то погубил бы их прежде вместе со мной. Неужели Ты погубишь нас за то, что совершили глупцы из нас? Воистину, это является всего лишь Твоим искушением, посредством которого Ты вводишь в заблуждение, кого пожелаешь, и ведешь прямым путем, кого пожелаешь. Ты - наш Покровитель, прости же нас и помилуй, ибо Ты - Наилучший из прощающих!",["и избрал","Муса","(из) своего народа","семьдесят","мужей","для Нашего срока","и когда","постигло их","сотрясение","он сказал","Господи","если бы","Ты пожелал","Ты погубил бы их","от","прежде","и меня","неужели Ты погубишь нас","за то, что","совершили","глупцы","из нас","не","это","кроме","Твоё испытание","Ты сбиваешь","им","кого","Ты пожелаешь","и Ты ведёшь прямо","кого","Ты пожелаешь","Ты","наш Покровитель","так прости","нам","и помилуй нас","и Ты","лучший","из прощающих"]]],"m":[[["وَلَمَّا","и когда",7,150],["رَجَعَ","вернулся",7,150],["مُوسَىٰٓ","Муса",7,150],["إِلَىٰ","к",7,150],["قَوۡمِهِۦ","народу своему",7,150],["غَضۡبَٰنَ","гневный",7,150],["أَسِفٗا","опечаленный",7,150],["قَالَ","он сказал",7,150],["بِئۡسَمَا","скверно то, что",7,150],["خَلَفۡتُمُونِي","вы творили вместо меня",7,150]],[["مِنۢ","после",7,150],["بَعۡدِيٓۖ","меня",7,150],["أَعَجِلۡتُمۡ","неужели поторопили вы",7,150],["أَمۡرَ","повеление",7,150],["رَبِّكُمۡۖ","Господа вашего",7,150],["وَأَلۡقَى","и бросил он",7,150],["ٱلۡأَلۡوَاحَ","скрижали",7,150],["وَأَخَذَ","и схватил",7,150],["بِرَأۡسِ","за голову",7,150]],[["أَخِيهِ","брата своего",7,150],["يَجُرُّهُۥٓ","таща его",7,150],["إِلَيۡهِۚ","к себе",7,150],["قَالَ","он сказал",7,150],["ٱبۡنَ","о сын",7,150],["أُمَّ","матери (моей)",7,150],["إِنَّ","поистине",7,150],["ٱلۡقَوۡمَ","люди",7,150],["ٱسۡتَضۡعَفُونِي","сочли меня слабым",7,150],["وَكَادُواْ","и едва не",7,150]],[["يَقۡتُلُونَنِي","убили меня",7,150],["فَلَا","так не",7,150],["تُشۡمِتۡ","дай злорадствовать",7,150],["بِيَ","надо мной",7,150],["ٱلۡأَعۡدَآءَ","врагам",7,150],["وَلَا","и не",7,150],["تَجۡعَلۡنِي","помещай меня",7,150],["مَعَ","с",7,150],["ٱلۡقَوۡمِ","людьми",7,150]],[["ٱلظَّٰلِمِينَ","несправедливыми",7,150],[150],["قَالَ","Он сказал",7,151],["رَبِّ","Господи",7,151],["ٱغۡفِرۡ","прости",7,151],["لِي","мне",7,151],["وَلِأَخِي","и моему брату",7,151],["وَأَدۡخِلۡنَا","и введи нас",7,151],["فِي","в",7,151]],[["رَحۡمَتِكَۖ","Твою милость",7,151],["وَأَنتَ","и Ты",7,151],["أَرۡحَمُ","Милосерднейший",7,151],["ٱلرَّٰحِمِينَ","из милосердных",7,151],[151],["إِنَّ","поистине",7,152],["ٱلَّذِينَ","те, которые",7,152],["ٱتَّخَذُواْ","взяли (себе)",7,152]],[["ٱلۡعِجۡلَ","тельца",7,152],["سَيَنَالُهُمۡ","постигнет их",7,152],["غَضَبٞ","гнев",7,152],["مِّن","от",7,152],["رَّبِّهِمۡ","их Господа",7,152],["وَذِلَّةٞ","и унижение",7,152],["فِي","в",7,152],["ٱلۡحَيَوٰةِ","жизни",7,152],["ٱلدُّنۡيَاۚ","ближней",7,152]],[["وَكَذَٰلِكَ","и так",7,152],["نَجۡزِي","Мы воздаём",7,152],["ٱلۡمُفۡتَرِينَ","измышляющим (ложь)",7,152],[152],["وَٱلَّذِينَ","а те, которые",7,153],["عَمِلُواْ","совершили",7,153],["ٱلسَّيِّـَٔاتِ","злые дела",7,153],["ثُمَّ","затем",7,153]],[["تَابُواْ","покаялись",7,153],["مِنۢ","от",7,153],["بَعۡدِهَا","после этого",7,153],["وَءَامَنُوٓاْ","и уверовали",7,153],["إِنَّ","по