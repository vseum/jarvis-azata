{"p":170,"j":9,"a":[[7,156,["وَٱكۡتُبۡ","لَنَا","فِي","هَٰذِهِ","ٱلدُّنۡيَا","حَسَنَةٗ","وَفِي","ٱلۡأٓخِرَةِ","إِنَّا","هُدۡنَآ","إِلَيۡكَۚ","قَالَ","عَذَابِيٓ","أُصِيبُ","بِهِۦ","مَنۡ","أَشَآءُۖ","وَرَحۡمَتِي","وَسِعَتۡ","كُلَّ","شَيۡءٖۚ","فَسَأَكۡتُبُهَا","لِلَّذِينَ","يَتَّقُونَ","وَيُؤۡتُونَ","ٱلزَّكَوٰةَ","وَٱلَّذِينَ","هُم","بِـَٔايَٰتِنَا","يُؤۡمِنُونَ"],"вактуб лана фии хазихид дунйа хасанатан вафил ахирати инна худна илайка ḳала `азабии усиибу бихии ман ашау варахматии васи`ат кулла шай'ин фасаактубуха лиллазиина йаттаḳууна вайу'тууназ закавата валлазиина хум би'айатина йу'минуун","Предпиши для нас добро в этом мире и в Последней жизни, ибо мы возвращаемся к Тебе (каемся перед Тобой). Он сказал: «Я поражаю Своим наказанием, кого пожелаю, а Моя милость объемлет всякую вещь. Я предпишу ее для тех, которые будут богобоязненны, станут выплачивать закят и уверуют в Наши знамения,",["и предпиши","нам","в","этом","мире","добро","и в","последней жизни","поистине, мы","мы обратились","к Тебе","Он сказал","Моё наказание","Я поражаю","им","кого","Я пожелаю","а Моя милость","объяла","всякую","вещь","и Я предпишу её","для тех, которые","богобоязненны","и дают","закят","и тех, которые","они","в Наши знамения","веруют"]],[7,157,["ٱلَّذِينَ","يَتَّبِعُونَ","ٱلرَّسُولَ","ٱلنَّبِيَّ","ٱلۡأُمِّيَّ","ٱلَّذِي","يَجِدُونَهُۥ","مَكۡتُوبًا","عِندَهُمۡ","فِي","ٱلتَّوۡرَىٰةِ","وَٱلۡإِنجِيلِ","يَأۡمُرُهُم","بِٱلۡمَعۡرُوفِ","وَيَنۡهَىٰهُمۡ","عَنِ","ٱلۡمُنكَرِ","وَيُحِلُّ","لَهُمُ","ٱلطَّيِّبَٰتِ","وَيُحَرِّمُ","عَلَيۡهِمُ","ٱلۡخَبَٰٓئِثَ","وَيَضَعُ","عَنۡهُمۡ","إِصۡرَهُمۡ","وَٱلۡأَغۡلَٰلَ","ٱلَّتِي","كَانَتۡ","عَلَيۡهِمۡۚ","فَٱلَّذِينَ","ءَامَنُواْ","بِهِۦ","وَعَزَّرُوهُ","وَنَصَرُوهُ","وَٱتَّبَعُواْ","ٱلنُّورَ","ٱلَّذِيٓ","أُنزِلَ","مَعَهُۥٓ","أُوْلَٰٓئِكَ","هُمُ","ٱلۡمُفۡلِحُونَ"],"аллазиина йаттаби`уунар расуулан набиййал уммиййал лазии йажидуунахуу мактуубан `индахум фит таурати вал'инжиили йа'мурухум билма`рууфи вайанхахум `анил мункари вайухиллу лахумут таййибати вайухарриму `алайхимул хабаиса вайада`у `анхум исрахум вал'аглалал латии канат `алайхим фаллазиина амануу бихии ва`аззарууху ванасарууху ваттаба`ун нуурал лазии унзила ма`ахуу улаика хумул муфлихуун","которые последуют за посланником, неграмотным (не умеющим читать и писать) пророком, запись о котором они найдут в Таурате (Торе) и Инджиле (Евангелии). Он повелит им совершать одобряемое и запретит им совершать предосудительное, объявит дозволенным благое и запрещенным скверное, освободит их от бремени и оков. Те, которые уверуют в него, станут почитать его, окажут ему поддержку и последуют за ниспосланным вместе с ним светом, непременно преуспеют».",["те, которые","следуют","за посланником","пророком","неграмотным","которого","они находят","записанным","у них","в","Таурате","и Инджиле","он велит им","одобряемое","и запрещает им","от","порицаемого","и разрешает","им","благое","и запрещает","им","скверное","и снимает","с них","их бремя","и оковы","которые","были","на них","и те, которые","уверовали","в него","и почитали его","и помогали ему","и последовали","за светом","который","ниспослан","с ним","те","они","преуспевшие"]],[7,158,["قُلۡ","يَٰٓأَيُّهَا","ٱلنَّاسُ","إِنِّي","رَسُولُ","ٱللَّهِ","إِلَيۡكُمۡ","جَمِيعًا","ٱلَّذِي","لَهُۥ","مُلۡكُ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِۖ","لَآ","إِلَٰهَ","إِلَّا","هُوَ","يُحۡيِۦ","وَيُمِيتُۖ","فَـَٔامِنُواْ","بِٱللَّهِ","وَرَسُولِهِ","ٱلنَّبِيِّ","ٱلۡأُمِّيِّ","ٱلَّذِي","يُؤۡمِنُ","بِٱللَّهِ","وَكَلِمَٰتِهِۦ","وَٱتَّبِعُوهُ","لَعَلَّكُمۡ","تَهۡتَدُونَ"],"ḳул йа'аййухан насу иннии расуулуллахи илайкум жамии`анил лазии лахуу мулкус самавати вал'арди ла илаха илла хуа йухйии вайумииту фа'аминуу биллахи варасуулихин набиййил уммиййил лазии йу'мину биллахи вакалиматихии ваттаби`ууху ла`аллакум тахтадуун","Скажи: «О люди! Я - Посланник Аллаха ко всем вам. Ему принадлежит власть над небесами и землей. Нет божества, кроме Него. Он воскрешает и умерщвляет. Уверуйте же в Аллаха и в Его Посланника, неграмотного (не умеющего читать и писать) Пророка, который уверовал в Аллаха и Его Слова. Последуйте за ним, дабы вы последовали прямым путем».",["скажи","о","люди","поистине, я","посланник","Аллаха","к вам","всем","Тот, Который","Ему (принадлежит)","власть","небес","и земли","нет","божества","кроме","Него","Он оживляет","и умерщвляет","так уверуйте","в Аллаха","и Его посланника","пророка","неграмотного","который","верует","в Аллаха","и Его слова","и следуйте за ним","чтобы вы","шли прямым путём"]],[7,159,["وَمِن","قَوۡمِ","مُوسَىٰٓ","أُمَّةٞ","يَهۡدُونَ","بِٱلۡحَقِّ","وَبِهِۦ","يَعۡدِلُونَ"],"вамин ḳауми мууса умматун йахдууна билхаḳḳи вабихии йа`дилуун","Среди народа Мусы (Моисея) есть люди, которые истинно указывают путь и устанавливают справедливость.",["и среди","народа","Мусы","община","ведут","истиной","и по ней","поступают справедливо"]]],"m":[[["۞ وَٱكۡتُبۡ","и предпиши",7,156],["لَنَا","нам",7,156],["فِي","в",7,156],["هَٰذِهِ","этом",7,156],["ٱلدُّنۡيَا","мире",7,156],["حَسَنَةٗ","добро",7,156],["وَفِي","и в",7,156],["ٱلۡأٓخِرَةِ","последней жизни",7,156],["إِنَّا","поистине, мы",7,156]],[["هُدۡنَآ","мы обратились",7,156],["إِلَيۡكَۚ","к Тебе",7,156],["قَالَ","Он сказал",7,156],["عَذَابِيٓ","Моё наказание",7,156],["أُصِيبُ","Я поражаю",7,156],["بِهِۦ","им",7,156],["مَنۡ","кого",7,156],["أَشَآءُۖ","Я пожелаю",7,156],["وَرَحۡمَتِي","а Моя милость",7,156]],[["وَسِعَتۡ","объяла",7,156],["كُلَّ","всякую",7,156],["شَيۡءٖۚ","вещь",7,156],["فَسَأَكۡتُبُهَا","и Я предпишу её",7,156],["لِلَّذِينَ","для тех, которые",7,156],["يَتَّقُونَ","богобоязненны",7,156],["وَيُؤۡتُونَ","и дают",7,156]],[["ٱلزَّكَوٰةَ","закят",7,156],["وَٱلَّذِينَ","и тех, которые",7,156],["هُم","они",7,156],["بِـَٔايَٰتِنَا","в Наши знамения",7,156],["يُؤۡمِنُونَ","веруют",7,156],[156],["ٱلَّذِينَ","те, которые",7,157],["يَتَّبِعُونَ","следуют",7,157]],[["ٱلرَّسُولَ","за посланником",7,157],["ٱلنَّبِيَّ","пророком",7,157],["ٱلۡأُمِّيَّ","неграмотным",7,157],["ٱلَّذِي","которого",7,157],["يَجِدُونَهُۥ","они находят",7,157],["مَكۡتُوبًا","записанным",7,157],["عِندَهُمۡ","у них",7,157]],[["فِي","в",7,157],["ٱلتَّوۡرَىٰةِ","Таурате",7,157],["وَٱلۡإِنجِيلِ","и Инджиле",7,157],["يَأۡمُرُهُم","он велит им",7,157],["بِٱلۡمَعۡرُوفِ","одобряемое",7,157],["وَيَنۡهَىٰهُمۡ","и запрещает им",7,157]],[["عَنِ","от",7,157],["ٱلۡمُنكَرِ","порицаемого",7,157],["وَيُحِلُّ","и разрешает",7,157],["لَهُمُ","им",7,157],["ٱلطَّيِّبَٰتِ","благое",7,157],["وَيُحَرِّمُ","и запрещает",7,157],["عَلَيۡهِمُ","им",7,157]],[["ٱلۡخَبَٰٓئِثَ","скверное",7,157],["وَيَضَعُ","и снимает",7,157],["عَنۡهُمۡ","с них",7,157],["إِصۡرَهُمۡ","их бремя",7,157],["وَٱلۡأَغۡلَٰلَ","и оковы",7,157],["ٱلَّتِي","которые",7,157],["كَانَتۡ","были",7,157]],[["عَلَيۡهِمۡۚ","на них",7,157],["فَٱلَّذِينَ","и те, которые",7,157],["ءَامَنُواْ","уверовали",7,157],["بِهِۦ","в него",7,157],["وَعَزَّرُوهُ","и почитали его",7,157],["وَنَصَرُوهُ","и помогали ему",7,157],["وَٱتَّبَعُواْ","и последовали",7,157]],[["ٱلنُّورَ","за светом",7,157],["ٱلَّذِيٓ","который",7,157],["أُنزِلَ","ниспослан",7,157],["مَعَهُۥٓ","с ним",7,157],["أُوْلَٰٓئِكَ","те",7,157],["هُمُ","они",7,157],["ٱلۡمُفۡلِحُونَ","преуспевшие",7,157],[157],["قُلۡ","скажи",7,158]],[["يَٰٓأَيُّهَا","о",7,158],["ٱلنَّاسُ","люди",7,158],["إِنِّي","поистине, я",7,158],["رَسُولُ","посланник",7,158],["ٱللَّهِ","Аллаха",7,158],["إِلَيۡكُمۡ","к вам",7,158],["جَمِيعًا","всем",7,158],["ٱلَّذِي","Тот, Который",7,158]],[["لَهُۥ","Ему (принадлежит)",7,158],["مُلۡكُ","власть",7,158],["ٱلسَّمَٰوَٰتِ","небес",7,158],["وَٱلۡأَرۡضِۖ","и земли",7,158],["لَآ","нет",7,158],["إِلَٰهَ","божества",7,158],["إِلَّا","кроме",7,158],["هُوَ","Него",7,158],["يُحۡيِۦ","Он оживляет",7,158],["وَيُمِيتُۖ","и умерщвляет",7,158]],[["فَـَٔامِنُواْ","так уверуйте",7,158],["بِٱللَّهِ","в Аллаха",7,158],["وَرَسُولِهِ","и Его посланника",7,158],["ٱلنَّبِيِّ","пророка",7,158],["ٱلۡأُمِّيِّ","неграмотного",7,158],["ٱلَّذِي","который",7,158],["يُؤۡمِنُ","верует",7,158],["بِٱللَّهِ","в Аллаха",7,158]],[["وَكَلِمَٰتِهِۦ","и Его слова",7,158],["وَٱتَّبِعُوهُ",