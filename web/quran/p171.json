{"p":171,"j":9,"a":[[7,160,["وَقَطَّعۡنَٰهُمُ","ٱثۡنَتَيۡ","عَشۡرَةَ","أَسۡبَاطًا","أُمَمٗاۚ","وَأَوۡحَيۡنَآ","إِلَىٰ","مُوسَىٰٓ","إِذِ","ٱسۡتَسۡقَىٰهُ","قَوۡمُهُۥٓ","أَنِ","ٱضۡرِب","بِّعَصَاكَ","ٱلۡحَجَرَۖ","فَٱنۢبَجَسَتۡ","مِنۡهُ","ٱثۡنَتَا","عَشۡرَةَ","عَيۡنٗاۖ","قَدۡ","عَلِمَ","كُلُّ","أُنَاسٖ","مَّشۡرَبَهُمۡۚ","وَظَلَّلۡنَا","عَلَيۡهِمُ","ٱلۡغَمَٰمَ","وَأَنزَلۡنَا","عَلَيۡهِمُ","ٱلۡمَنَّ","وَٱلسَّلۡوَىٰۖ","كُلُواْ","مِن","طَيِّبَٰتِ","مَا","رَزَقۡنَٰكُمۡۚ","وَمَا","ظَلَمُونَا","وَلَٰكِن","كَانُوٓاْ","أَنفُسَهُمۡ","يَظۡلِمُونَ"],"ваḳатта`нахумуснатай `ашрата асбатан умаман ва'аухайна ила мууса изистасḳаху ḳаумухуу анидриб бби`асакал хажара фамбажасат минхусната `ашрата `айнан ḳад `алима куллу унасим машрабахум вазаллална `алайхимул гамама ва'анзална `алайхимул манна вассалва кулуу мин таййибати ма разаḳнакум вама заламууна валакин кануу анфусахум йазлимуун","Мы разделили их на двенадцать колен - родов. Когда же его народ попросил его напоить их, Мы внушили Мусе (Моисею): «Ударь своим посохом по камню». Из него забило двенадцать ключей, и все люди узнали, где им надлежит пить. Мы осенили их облаками и ниспослали им манну и перепелов: «Вкушайте блага, которыми Мы наделили вас». Они не были несправедливы по отношению к Нам - они поступали несправедливо лишь по отношению к себе.",["и Мы разделили их","(на) двена-","-дцать","колен","общинами","и Мы внушили","к","Мусе","когда","попросил у него воды","его народ","что","ударь","своим посохом","камень","и забили","из него","двена-","-дцать","источников","уже","узнали","каждые","люди","своё место питья","и Мы осенили","над ними","облака","и Мы ниспослали","на них","манну","и перепелов","ешьте","из","благ","которыми","Мы наделили вас","и не","они обидели Нас","но","они были","самих себя","обижающими"]],[7,161,["وَإِذۡ","قِيلَ","لَهُمُ","ٱسۡكُنُواْ","هَٰذِهِ","ٱلۡقَرۡيَةَ","وَكُلُواْ","مِنۡهَا","حَيۡثُ","شِئۡتُمۡ","وَقُولُواْ","حِطَّةٞ","وَٱدۡخُلُواْ","ٱلۡبَابَ","سُجَّدٗا","نَّغۡفِرۡ","لَكُمۡ","خَطِيٓـَٰٔتِكُمۡۚ","سَنَزِيدُ","ٱلۡمُحۡسِنِينَ"],"ва'из ḳиила лахумускунуу хазихил ḳарйата вакулуу минха хайсу ши'тум ваḳуулуу хиттатун вадхулул баба сужжадан нагфир лакум хатииатикум саназиидул мухсиниин","Вот им было сказано: «Поселитесь в этом городе и ешьте там, где пожелаете. Скажите: «Прости нас», - и войдите во врата, поклонившись. Мы простим ваши прегрешения и приумножим награду творящим добро».",["и вот","было сказано","им","поселитесь","(в) этом","селении","и ешьте","из него","где","пожелаете","и говорите","прости (нас)","и входите","(в) ворота","поклонившись","Мы простим","вам","ваши прегрешения","Мы приумножим","творящим добро"]],[7,162,["فَبَدَّلَ","ٱلَّذِينَ","ظَلَمُواْ","مِنۡهُمۡ","قَوۡلًا","غَيۡرَ","ٱلَّذِي","قِيلَ","لَهُمۡ","فَأَرۡسَلۡنَا","عَلَيۡهِمۡ","رِجۡزٗا","مِّنَ","ٱلسَّمَآءِ","بِمَا","كَانُواْ","يَظۡلِمُونَ"],"фабаддалал лазиина заламуу минхум ḳаулан гайрал лазии ḳиила лахум фа'арсална `алайхим рижзам минас самаи бима кануу йазлимуун","Несправедливые из них заменили сказанное им слово другим, и Мы ниспослали на них наказание с небес за то, что они поступали несправедливо.",["и заменили","те, которые","были несправедливы","из них","слово","иное, чем","то, которое","было сказано","им","и Мы наслали","на них","кару","с","неба","за то, что","они были","несправедливы"]],[7,163,["وَسۡـَٔلۡهُمۡ","عَنِ","ٱلۡقَرۡيَةِ","ٱلَّتِي","كَانَتۡ","حَاضِرَةَ","ٱلۡبَحۡرِ","إِذۡ","يَعۡدُونَ","فِي","ٱلسَّبۡتِ","إِذۡ","تَأۡتِيهِمۡ","حِيتَانُهُمۡ","يَوۡمَ","سَبۡتِهِمۡ","شُرَّعٗا","وَيَوۡمَ","لَا","يَسۡبِتُونَ","لَا","تَأۡتِيهِمۡۚ","كَذَٰلِكَ","نَبۡلُوهُم","بِمَا","كَانُواْ","يَفۡسُقُونَ"],"вас'алхум `анил ḳарйатил латии канат хадиратал бахри из йа`дууна фис сабти из та'тиихим хиитанухум йаума сабтихим шурра`ан вайаума ла йасбитууна ла та'тиихим казалика наблуухум бима кануу йафсуḳуун","Спроси их о селении на берегу моря. Они нарушили субботу, поскольку рыбы приплывали к ним открыто по субботам и не приплывали в не субботние дни. Так Мы подвергли их испытанию за то, что они отказались повиноваться.",["и спроси их","о","селении","которое","было","на берегу","моря","когда","они преступали","в","субботу","когда","приходили к ним","их рыбы","(в) день","их субботы","открыто","а в день","не","они соблюдали субботу","не","приходили к ним","так","Мы испытываем их","за то, что","они были","нечестивы"]]],"m":[[["وَقَطَّعۡنَٰهُمُ","и Мы разделили их",7,160],["ٱثۡنَتَيۡ","(на) двена-",7,160],["عَشۡرَةَ","-дцать",7,160],["أَسۡبَاطًا","колен",7,160],["أُمَمٗاۚ","общинами",7,160],["وَأَوۡحَيۡنَآ","и Мы внушили",7,160],["إِلَىٰ","к",7,160],["مُوسَىٰٓ","Мусе",7,160]],[["إِذِ","когда",7,160],["ٱسۡتَسۡقَىٰهُ","попросил у него воды",7,160],["قَوۡمُهُۥٓ","его народ",7,160],["أَنِ","что",7,160],["ٱضۡرِب","ударь",7,160],["بِّعَصَاكَ","своим посохом",7,160],["ٱلۡحَجَرَۖ","камень",7,160]],[["فَٱنۢبَجَسَتۡ","и забили",7,160],["مِنۡهُ","из него",7,160],["ٱثۡنَتَا","двена-",7,160],["عَشۡرَةَ","-дцать",7,160],["عَيۡنٗاۖ","источников",7,160],["قَدۡ","уже",7,160],["عَلِمَ","узнали",7,160],["كُلُّ","каждые",7,160],["أُنَاسٖ","люди",7,160]],[["مَّشۡرَبَهُمۡۚ","своё место питья",7,160],["وَظَلَّلۡنَا","и Мы осенили",7,160],["عَلَيۡهِمُ","над ними",7,160],["ٱلۡغَمَٰمَ","облака",7,160],["وَأَنزَلۡنَا","и Мы ниспослали",7,160],["عَلَيۡهِمُ","на них",7,160],["ٱلۡمَنَّ","манну",7,160]],[["وَٱلسَّلۡوَىٰۖ","и перепелов",7,160],["كُلُواْ","ешьте",7,160],["مِن","из",7,160],["طَيِّبَٰتِ","благ",7,160],["مَا","которыми",7,160],["رَزَقۡنَٰكُمۡۚ","Мы наделили вас",7,160],["وَمَا","и не",7,160]],[["ظَلَمُونَا","они обидели Нас",7,160],["وَلَٰكِن","но",7,160],["كَانُوٓاْ","они были",7,160],["أَنفُسَهُمۡ","самих себя",7,160],["يَظۡلِمُونَ","обижающими",7,160],[160],["وَإِذۡ","и вот",7,161]],[["قِيلَ","было сказано",7,161],["لَهُمُ","им",7,161],["ٱسۡكُنُواْ","поселитесь",7,161],["هَٰذِهِ","(в) этом",7,161],["ٱلۡقَرۡيَةَ","селении",7,161],["وَكُلُواْ","и ешьте",7,161],["مِنۡهَا","из него",7,161],["حَيۡثُ","где",7,161]],[["شِئۡتُمۡ","пожелаете",7,161],["وَقُولُواْ","и говорите",7,161],["حِطَّةٞ","прости (