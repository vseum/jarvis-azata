{"p":172,"j":9,"a":[[7,164,["وَإِذۡ","قَالَتۡ","أُمَّةٞ","مِّنۡهُمۡ","لِمَ","تَعِظُونَ","قَوۡمًا","ٱللَّهُ","مُهۡلِكُهُمۡ","أَوۡ","مُعَذِّبُهُمۡ","عَذَابٗا","شَدِيدٗاۖ","قَالُواْ","مَعۡذِرَةً","إِلَىٰ","رَبِّكُمۡ","وَلَعَلَّهُمۡ","يَتَّقُونَ"],"ва'из ḳалат умматум минхум лима та`изууна ḳауманиллаху мухликухум ау му`аззибухум `азабан шадиидан ḳалуу ма`зиратан ила раббикум вала`аллахум йаттаḳуун","Вот некоторые из них сказали: «Зачем вам увещевать людей, которых Аллах погубит или подвергнет тяжким мучениям?». Они сказали: «Чтобы оправдаться перед вашим Господом. Быть может, они устрашатся».",["и вот","сказала","община","из них","зачем","вы увещеваете","людей","Аллах","погубит их","или","накажет их","наказанием","суровым","они сказали","(ради) оправдания","перед","вашим Господом","и, может быть, они","устрашатся"]],[7,165,["فَلَمَّا","نَسُواْ","مَا","ذُكِّرُواْ","بِهِۦٓ","أَنجَيۡنَا","ٱلَّذِينَ","يَنۡهَوۡنَ","عَنِ","ٱلسُّوٓءِ","وَأَخَذۡنَا","ٱلَّذِينَ","ظَلَمُواْ","بِعَذَابِۭ","بَـِٔيسِۭ","بِمَا","كَانُواْ","يَفۡسُقُونَ"],"фаламма насуу ма зуккируу бихии анжайнал лазиина йанхауна `анис сууи ва'ахазнал лазиина заламуу би`азаби ба'ииси бима кануу йафсуḳуун","Когда они забыли о том, что им напоминали, Мы спасли тех, которые запрещали творить злодеяния, и подвергли ужасным мучениям беззаконников за то, что они поступали нечестиво.",["и когда","они забыли","то, что","им напоминали","о нём","Мы спасли","тех, которые","удерживали","от","зла","и Мы схватили","тех, которые","были несправедливы","наказанием","тяжким","за то, что","они были","нечестивы"]],[7,166,["فَلَمَّا","عَتَوۡاْ","عَن","مَّا","نُهُواْ","عَنۡهُ","قُلۡنَا","لَهُمۡ","كُونُواْ","قِرَدَةً","خَٰسِـِٔينَ"],"фаламма `атау `ам ма нухуу `анху ḳулна лахум куунуу ḳирадатан хаси'иин","Когда они ослушались того, что им было запрещено, Мы сказали им: «Будьте обезьянами презренными!».",["и когда","они дерзко преступили","против","того, что","им запретили","от этого","Мы сказали","им","станьте","обезьянами","презренными"]],[7,167,["وَإِذۡ","تَأَذَّنَ","رَبُّكَ","لَيَبۡعَثَنَّ","عَلَيۡهِمۡ","إِلَىٰ","يَوۡمِ","ٱلۡقِيَٰمَةِ","مَن","يَسُومُهُمۡ","سُوٓءَ","ٱلۡعَذَابِۗ","إِنَّ","رَبَّكَ","لَسَرِيعُ","ٱلۡعِقَابِ","وَإِنَّهُۥ","لَغَفُورٞ","رَّحِيمٞ"],"ва'из та'аззана раббука лайаб`асанна `алайхим ила йаумил ḳийамати ман йасуумухум сууал `азаби инна раббака ласарии`ул `иḳаби ва'иннахуу лагафуурур рахиим","Вот твой Господь возвестил, что Он непременно будет насылать на них до Дня воскресения тех, кто будет подвергать их ужасным мучениям. Воистину, твой Господь скор в наказании. Воистину, Он - Прощающий, Милосердный.",["и вот","возвестил","твой Господь","непременно Он пошлёт","на них","до","Дня","воскресения","тех, кто","будет подвергать их","злому","наказанию","поистине","твой Господь","непременно скор","в наказании","и поистине, Он","непременно Прощающий","Милосердный"]],[7,168,["وَقَطَّعۡنَٰهُمۡ","فِي","ٱلۡأَرۡضِ","أُمَمٗاۖ","مِّنۡهُمُ","ٱلصَّٰلِحُونَ","وَمِنۡهُمۡ","دُونَ","ذَٰلِكَۖ","وَبَلَوۡنَٰهُم","بِٱلۡحَسَنَٰتِ","وَٱلسَّيِّـَٔاتِ","لَعَلَّهُمۡ","يَرۡجِعُونَ"],"ваḳатта`нахум фил арди умамам минхумус салихууна ваминхум дууна залика вабалаунахум билхасанати вассаййиати ла`аллахум йаржи`уун","Мы разбросали их по земле общинами. Среди них есть и праведные, и не только праведные. Мы подвергли их испытанию злом и добром, - быть может, они вернутся на прямой путь.",["и Мы разделили их","на","земле","общинами","из них","праведные","и из них","ниже","этого","и Мы испытали их","благами","и злом","может быть, они","вернутся"]],[7,169,["فَخَلَفَ","مِنۢ","بَعۡدِهِمۡ","خَلۡفٞ","وَرِثُواْ","ٱلۡكِتَٰبَ","يَأۡخُذُونَ","عَرَضَ","هَٰذَا","ٱلۡأَدۡنَىٰ","وَيَقُولُونَ","سَيُغۡفَرُ","لَنَا","وَإِن","يَأۡتِهِمۡ","عَرَضٞ","مِّثۡلُهُۥ","يَأۡخُذُوهُۚ","أَلَمۡ","يُؤۡخَذۡ","عَلَيۡهِم","مِّيثَٰقُ","ٱلۡكِتَٰبِ","أَن","لَّا","يَقُولُواْ","عَلَى","ٱللَّهِ","إِلَّا","ٱلۡحَقَّ","وَدَرَسُواْ","مَا","فِيهِۗ","وَٱلدَّارُ","ٱلۡأٓخِرَةُ","خَيۡرٞ","لِّلَّذِينَ","يَتَّقُونَۚ","أَفَلَا","تَعۡقِلُونَ"],"фахалафа мим ба`дихим халфун варисул китаба йа'хузууна `арада хазал адна вайаḳуулууна сайугфару лана ва'ин йа'тихим `арадум мислухуу йа'хузууху алам йу'хаз `алайхим миисаḳул китаби ал ла йаḳуулуу `алаллахи иллал хаḳḳа вадарасуу ма фиихи ваддарул ахирату хайрул лиллазиина йаттаḳууна афала та`ḳилуун","Их преемниками стало поколение, которое унаследовало Писание. Они схватились за блага этой жалкой жизни и сказали: «Мы будем прощены». Если бы им снова встретились подобные блага, они снова схватились бы за них. Разве с них не был взят завет Писания о том, что они будут говорить об Аллахе только правду? Они изучили то, что было в нем (Писании). Обитель Последней жизни лучше для тех, кто богобоязнен. Неужели вы не понимаете?",["и пришли на смену","от","после них","преемники","унаследовали","Писание","берут","блага","этой","низшей (жизни)","и говорят","будет прощено","нам","и если","придут к ним","блага","подобные им","они возьмут их","разве не","был взят","с них","завет","Писания","что","не","будут говорить","об","Аллахе","кроме","истины","и изучили","то, что","в нём","а обитель","последняя","лучше","для тех, которые","богобоязненны","неужели не","вы разумеете"]],[7,170,["وَٱلَّذِينَ","يُمَسِّكُونَ","بِٱلۡكِتَٰبِ","وَأَقَامُواْ","ٱلصَّلَوٰةَ","إِنَّا","لَا","نُضِيعُ","أَجۡرَ","ٱلۡمُصۡلِحِينَ"],"валлазиина йумассикууна билкитаби ва'аḳамус салавата инна ла нудии`у ажрал муслихиин","Если кто придерживается Писания и совершает намаз, то ведь Мы не теряем вознаграждения тех, кто наводит порядок.",["и те, которые","держатся","за Писание","и выстаивали","намаз","поистине, Мы","не","Мы губим","награды","исправляющих"]]],"m":[[["وَإِذۡ","и вот",7,164],["قَالَتۡ","сказала",7,164],["أُمَّةٞ","община",7,164],["مِّنۡهُمۡ","из них",7,164],["لِمَ","зачем",7,164],["تَعِظُونَ","вы увещеваете",7,164],["قَوۡمًا","людей",7,164],["ٱللَّهُ","Аллах",7,164],["مُهۡلِكُهُمۡ","погубит их",7,164],["أَوۡ","или",7,164],["مُعَذِّبُهُمۡ","накажет их",7,164]],[["عَذَابٗا","наказанием",7,164],["شَدِيدٗاۖ","суровым",7,164],["قَالُواْ"