{"p":173,"j":9,"a":[[7,171,["وَإِذۡ","نَتَقۡنَا","ٱلۡجَبَلَ","فَوۡقَهُمۡ","كَأَنَّهُۥ","ظُلَّةٞ","وَظَنُّوٓاْ","أَنَّهُۥ","وَاقِعُۢ","بِهِمۡ","خُذُواْ","مَآ","ءَاتَيۡنَٰكُم","بِقُوَّةٖ","وَٱذۡكُرُواْ","مَا","فِيهِ","لَعَلَّكُمۡ","تَتَّقُونَ"],"ва'из натаḳнал жабала фауḳахум ка'аннахуу зуллатун вазаннуу аннахуу ваḳи`у бихим хузуу ма атайнакум биḳувватин вазкуруу ма фиихи ла`аллакум таттаḳуун","Вот Мы подняли над ними гору, словно тучу, и они подумали, что она упадет на них. Крепко держитесь того, что Мы даровали вам, и помните то, что содержится в нем, - быть может, вы устрашитесь.",["и вот","Мы подняли","гору","над ними","будто она","навес","и они подумали","что она","упадёт","на них","возьмите","то, что","Мы дали вам","с силой","и помните","то, что","в нём","может быть, вы","устрашитесь"]],[7,172,["وَإِذۡ","أَخَذَ","رَبُّكَ","مِنۢ","بَنِيٓ","ءَادَمَ","مِن","ظُهُورِهِمۡ","ذُرِّيَّتَهُمۡ","وَأَشۡهَدَهُمۡ","عَلَىٰٓ","أَنفُسِهِمۡ","أَلَسۡتُ","بِرَبِّكُمۡۖ","قَالُواْ","بَلَىٰ","شَهِدۡنَآۚ","أَن","تَقُولُواْ","يَوۡمَ","ٱلۡقِيَٰمَةِ","إِنَّا","كُنَّا","عَنۡ","هَٰذَا","غَٰفِلِينَ"],"ва'из ахаза раббука мим бании адама мин зухуурихим зурриййатахум ва'ашхадахум `ала анфусихим аласту бираббикум ḳалуу бала шахидна ан таḳуулуу йаумал ḳийамати инна кунна `ан хаза гафилиин","Вот твой Господь вынул из чресл сынов Адама их потомство и заставил их засвидетельствовать против самих себя: «Разве Я - не ваш Господь?». Они сказали: «Да, мы свидетельствуем». Это - для того, чтобы в День воскресения вы не говорили: «Мы не знали этого».",["и вот","взял","твой Господь","от","сынов","Адама","из","их чресл","их потомство","и заставил их свидетельствовать","против","самих себя","разве Я не","ваш Господь","они сказали","да","мы засвидетельствовали","чтобы не","вы сказали","(в) День","воскресения","поистине, мы","мы были","об","этом","не ведающими"]],[7,173,["أَوۡ","تَقُولُوٓاْ","إِنَّمَآ","أَشۡرَكَ","ءَابَآؤُنَا","مِن","قَبۡلُ","وَكُنَّا","ذُرِّيَّةٗ","مِّنۢ","بَعۡدِهِمۡۖ","أَفَتُهۡلِكُنَا","بِمَا","فَعَلَ","ٱلۡمُبۡطِلُونَ"],"ау таḳуулуу иннама ашрака абауна мин ḳаблу вакунна зурриййатам мим ба`дихим афатухликуна бима фа`алал мубтилуун","Или же не говорили: «Наши отцы были многобожниками раньше нас, а мы были всего лишь потомками, которые пришли после них. Неужели Ты погубишь нас за то, что совершили приверженцы лжи?».",["или","вы скажете","лишь","придавали сотоварищей","наши отцы","от","прежде","а мы были","потомством","от","после них","неужели Ты погубишь нас","за то, что","совершили","приверженцы лжи"]],[7,174,["وَكَذَٰلِكَ","نُفَصِّلُ","ٱلۡأٓيَٰتِ","وَلَعَلَّهُمۡ","يَرۡجِعُونَ"],"ваказалика нуфассилул айати вала`аллахум йаржи`уун","Так Мы разъясняем знамения, - быть может, они вернутся на прямой путь.",["и так","Мы разъясняем","знамения","и, может быть, они","вернутся"]],[7,175,["وَٱتۡلُ","عَلَيۡهِمۡ","نَبَأَ","ٱلَّذِيٓ","ءَاتَيۡنَٰهُ","ءَايَٰتِنَا","فَٱنسَلَخَ","مِنۡهَا","فَأَتۡبَعَهُ","ٱلشَّيۡطَٰنُ","فَكَانَ","مِنَ","ٱلۡغَاوِينَ"],"ватлу `алайхим набаал лазии атайнаху айатина фансалаха минха фа'атба`ахуш шайтану факана минал гавиин","Прочти им историю о том, кому Мы даровали Наши знамения, а он отбросил их. Дьявол последовал за ним, и он стал заблудшим.",["и прочти","им","весть","(о) том, кому","Мы дали","Наши знамения","но он отрешился","от них","и последовал за ним","шайтан","и стал он","из","заблудших"]],[7,176,["وَلَوۡ","شِئۡنَا","لَرَفَعۡنَٰهُ","بِهَا","وَلَٰكِنَّهُۥٓ","أَخۡلَدَ","إِلَى","ٱلۡأَرۡضِ","وَٱتَّبَعَ","هَوَىٰهُۚ","فَمَثَلُهُۥ","كَمَثَلِ","ٱلۡكَلۡبِ","إِن","تَحۡمِلۡ","عَلَيۡهِ","يَلۡهَثۡ","أَوۡ","تَتۡرُكۡهُ","يَلۡهَثۚ","ذَّٰلِكَ","مَثَلُ","ٱلۡقَوۡمِ","ٱلَّذِينَ","كَذَّبُواْ","بِـَٔايَٰتِنَاۚ","فَٱقۡصُصِ","ٱلۡقَصَصَ","لَعَلَّهُمۡ","يَتَفَكَّرُونَ"],"валау ши'на ларафа`наху биха валакиннахуу ахлада илал арди ваттаба`а хаваху фамасалухуу камасалил калби ин тахмил `алайхи йалхас ау татрукху йалхас ззалика масалул ḳаумил лазиина каззабуу би'айатина фаḳсусил ḳасаса ла`аллахум йатафаккаруун","Если бы Мы пожелали, то возвысили бы его посредством этого. Однако он приник к земле и стал потакать своим желаниям. Он подобен собаке: если ты прогоняешь ее, она высовывает язык, и если ты оставишь ее в покое, она тоже высовывает язык. Такова притча о тех, которые считают ложью Наши знамения. Рассказывай эти истории, - быть может, они призадумаются.",["и если бы","Мы пожелали","непременно Мы возвысили бы его","ими","но он","приник","к","земле","и последовал","своей прихоти","и пример его","как пример","собаки","если","ты нападёшь","на неё","она высовывает язык","или","оставишь её","высовывает язык","это","пример","людей","которые","сочли ложью","Наши знамения","так рассказывай","рассказ","может быть, они","задумаются"]],[7,177,["سَآءَ","مَثَلًا","ٱلۡقَوۡمُ","ٱلَّذِينَ","كَذَّبُواْ","بِـَٔايَٰتِنَا","وَأَنفُسَهُمۡ","كَانُواْ","يَظۡلِمُونَ"],"саа масаланил ḳаумул лазиина каззабуу би'айатина ва'анфусахум кануу йазлимуун","Скверна притча о тех, которые считают ложью Наши знамения и поступают несправедливо по отношению к себе.",["скверен","примером","люди","которые","сочли ложью","Наши знамения","и самих себя","они были","обижающими"]],[7,178,["مَن","يَهۡدِ","ٱللَّهُ","فَهُوَ","ٱلۡمُهۡتَدِيۖ","وَمَن","يُضۡلِلۡ","فَأُوْلَٰٓئِكَ","هُمُ","ٱلۡخَٰسِرُونَ"],"ман йахдиллаху фахуал мухтадии ваман йудлил фа'улаика хумул хасируун","Кого Аллах наставляет на прямой путь, тот идет им. А кого Аллах вводит в заблуждение, те становятся потерпевшими убыток.",["кого","ведёт прямым путём","Аллах","то он","идущий прямо","а кого","Он сбивает","то те","они","потерпевшие убыток"]]],"m":[[["۞ وَإِذۡ","и вот",7,171],["نَتَقۡنَا","Мы подняли",7,171],["ٱلۡجَبَلَ","гору",7,171],["فَوۡقَهُمۡ","над ними",7,171],["كَأَنَّهُۥ","будто она",7,171],["ظُلَّةٞ","навес",7,171],["وَظَنُّوٓاْ","и они подумали",7,171],["أَنَّهُۥ","что она",7,171],["وَاقِعُۢ","упадёт",7,171],["بِهِمۡ","на них",7,171]],[["خُذُواْ","возьмите",7,171],["مَآ","то, что",7,171],["ءَاتَيۡنَٰكُم","Мы дали вам",7,171],["بِقُوَّةٖ","с силой",7,171],["وَٱذۡكُرُواْ","и помните",7,171