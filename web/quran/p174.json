{"p":174,"j":9,"a":[[7,179,["وَلَقَدۡ","ذَرَأۡنَا","لِجَهَنَّمَ","كَثِيرٗا","مِّنَ","ٱلۡجِنِّ","وَٱلۡإِنسِۖ","لَهُمۡ","قُلُوبٞ","لَّا","يَفۡقَهُونَ","بِهَا","وَلَهُمۡ","أَعۡيُنٞ","لَّا","يُبۡصِرُونَ","بِهَا","وَلَهُمۡ","ءَاذَانٞ","لَّا","يَسۡمَعُونَ","بِهَآۚ","أُوْلَٰٓئِكَ","كَٱلۡأَنۡعَٰمِ","بَلۡ","هُمۡ","أَضَلُّۚ","أُوْلَٰٓئِكَ","هُمُ","ٱلۡغَٰفِلُونَ"],"валаḳад зара'на лижаханнама касиирам минал жинни вал'инси лахум ḳулуубул ла йафḳахууна биха валахум а`йунул ла йубсирууна биха валахум азанул ла йасма`ууна биха улаика кал'ан`ами бал хум адаллу улаика хумул гафилуун","Мы сотворили для Геенны много джиннов и людей. У них есть сердца, которые не разумеют, и глаза, которые не видят, и уши, которые не слышат. Они подобны скотине, но являются еще более заблудшими. Именно они являются беспечными невеждами.",["и уже","Мы сотворили","для Геенны","многих","из","джиннов","и людей","у них","сердца","не","они понимают","ими","и у них","глаза","не","они видят","ими","и у них","уши","не","они слышат","ими","те","как скот","нет","они","более заблудшие","те","они","беспечные"]],[7,180,["وَلِلَّهِ","ٱلۡأَسۡمَآءُ","ٱلۡحُسۡنَىٰ","فَٱدۡعُوهُ","بِهَاۖ","وَذَرُواْ","ٱلَّذِينَ","يُلۡحِدُونَ","فِيٓ","أَسۡمَٰٓئِهِۦۚ","سَيُجۡزَوۡنَ","مَا","كَانُواْ","يَعۡمَلُونَ"],"валиллахил асмаул хусна фад`ууху биха вазарул лазиина йулхидууна фии асмаихии сайужзауна ма кануу йа`малуун","У Аллаха - самые прекрасные имена. Посему взывайте к Нему посредством их и оставьте тех, которые уклоняются от истины в отношении Его имен. Они непременно получат воздаяние за то, что совершали.",["и у Аллаха","имена","прекраснейшие","так взывайте к Нему","ими","и оставьте","тех, которые","уклоняются","в отношении","Его имён","им воздастся","за то, что","они были","делающими"]],[7,181,["وَمِمَّنۡ","خَلَقۡنَآ","أُمَّةٞ","يَهۡدُونَ","بِٱلۡحَقِّ","وَبِهِۦ","يَعۡدِلُونَ"],"вамимман халаḳна умматун йахдууна билхаḳḳи вабихии йа`дилуун","Среди Наших творений есть община, которая истинно указывает путь и устанавливает справедливость.",["и из тех, кого","Мы сотворили","община","ведут","истиной","и по ней","поступают справедливо"]],[7,182,["وَٱلَّذِينَ","كَذَّبُواْ","بِـَٔايَٰتِنَا","سَنَسۡتَدۡرِجُهُم","مِّنۡ","حَيۡثُ","لَا","يَعۡلَمُونَ"],"валлазиина каззабуу би'айатина санастадрижухум мин хайсу ла йа`ламуун","А тех, которые считают ложью Наши знамения, Мы завлечем так, что они даже не узнают этого.",["а те, которые","сочли ложью","Наши знамения","Мы постепенно поведём их","оттуда","где","не","они знают"]],[7,183,["وَأُمۡلِي","لَهُمۡۚ","إِنَّ","كَيۡدِي","مَتِينٌ"],"ва'умлии лахум инна кайдии матиин","Я дам им отсрочку, ведь хитрость Моя несокрушима.",["и Я даю отсрочку","им","поистине","Моя хитрость","крепка"]],[7,184,["أَوَلَمۡ","يَتَفَكَّرُواْۗ","مَا","بِصَاحِبِهِم","مِّن","جِنَّةٍۚ","إِنۡ","هُوَ","إِلَّا","نَذِيرٞ","مُّبِينٌ"],"авалам йатафаккаруу ма бисахибихим мин жиннатин ин хуа илла назиирум мубиин","Неужели они не размышляют? Их товарищ не является бесноватым. Он не кто иной, как разъясняющий и предостерегающий увещеватель.",["разве не","размышляют они","нет","в их товарище","никакого","безумия","не","он","кроме","увещеватель","ясный"]],[7,185,["أَوَلَمۡ","يَنظُرُواْ","فِي","مَلَكُوتِ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِ","وَمَا","خَلَقَ","ٱللَّهُ","مِن","شَيۡءٖ","وَأَنۡ","عَسَىٰٓ","أَن","يَكُونَ","قَدِ","ٱقۡتَرَبَ","أَجَلُهُمۡۖ","فَبِأَيِّ","حَدِيثِۭ","بَعۡدَهُۥ","يُؤۡمِنُونَ"],"авалам йанзуруу фии малакуутис самавати вал'арди вама халаḳаллаху мин шай'ин ва'ан `аса ан йакууна ḳадиḳтараба ажалухум фабиаййи хадииси ба`дахуу йу'минуун","Неужели они не вглядываются в царствие небес и земли, а также всего, что сотворил Аллах? Быть может, их срок уже близок. В какой же рассказ после этого они уверуют?",["разве не","смотрят они","на","царство","небес","и земли","и то, что","сотворил","Аллах","из","вещей","и что","может быть","что","будет","уже","приблизился","их срок","так в какой же","рассказ","после этого","они уверуют"]],[7,186,["مَن","يُضۡلِلِ","ٱللَّهُ","فَلَا","هَادِيَ","لَهُۥۚ","وَيَذَرُهُمۡ","فِي","طُغۡيَٰنِهِمۡ","يَعۡمَهُونَ"],"ман йудлилиллаху фала хадийа лахуу вайазарухум фии тугйанихим йа`махуун","Кого Аллах ввел в заблуждение, того никто не наставит на прямой путь. Он бросает их скитаться вслепую в их собственном беззаконии.",["кого","сбивает","Аллах","то нет","наставляющего","ему","и Он оставляет их","в","их беззаконии","скитаться вслепую"]],[7,187,["يَسۡـَٔلُونَكَ","عَنِ","ٱلسَّاعَةِ","أَيَّانَ","مُرۡسَىٰهَاۖ","قُلۡ","إِنَّمَا","عِلۡمُهَا","عِندَ","رَبِّيۖ","لَا","يُجَلِّيهَا","لِوَقۡتِهَآ","إِلَّا","هُوَۚ","ثَقُلَتۡ","فِي","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِۚ","لَا","تَأۡتِيكُمۡ","إِلَّا","بَغۡتَةٗۗ","يَسۡـَٔلُونَكَ","كَأَنَّكَ","حَفِيٌّ","عَنۡهَاۖ","قُلۡ","إِنَّمَا","عِلۡمُهَا","عِندَ","ٱللَّهِ","وَلَٰكِنَّ","أَكۡثَرَ","ٱلنَّاسِ","لَا","يَعۡلَمُونَ"],"йас'алуунака `анис са`ати аййана мурсаха ḳул иннама `илмуха `инда раббии ла йужаллииха ливаḳтиха илла хуа саḳулат фис самавати вал'арди ла та'тиикум илла багтатан йас'алуунака ка'аннака хафиййун `анха ḳул иннама `илмуха `индаллахи валакинна аксаран наси ла йа`ламуун","Они спрашивают тебя о Часе: «Когда он наступит?». Скажи: «Воистину, знание об этом принадлежит только моему Господу. Никто, кроме Него, не способен открыть время его наступления. Это знание тяжко для небес и земли. Он настанет внезапно». Они спрашивают тебя, словно тебе известно об этом. Скажи: «Воистину, знание об этом принадлежит одному Аллаху, но большая часть людей не знает этого».",["они спрашивают тебя","о","Часе","когда","его наступление","скажи","лишь","знание о нём","у","моего Господа","не","откроет его","в его время","кроме","Него","тяжек он","на","небесах","и земле","не","придёт к вам","кроме как","внезапно","они спрашивают тебя","будто ты","осведомлён","о нём","скажи","лишь","знание о нём","у","Аллаха","но","большинство","людей","не","знают"]]],"m":[[["وَلَقَدۡ","и уже",7,179],["ذَرَأۡنَا","Мы сотворили",7,179],["لِجَهَنَّمَ","для Геенны",7,179],["كَثِيرٗا","многих",7,179],["مِّنَ","из",7,179],["ٱلۡجِنِّ","джиннов",7,179]