{"p":175,"j":9,"a":[[7,188,["قُل","لَّآ","أَمۡلِكُ","لِنَفۡسِي","نَفۡعٗا","وَلَا","ضَرًّا","إِلَّا","مَا","شَآءَ","ٱللَّهُۚ","وَلَوۡ","كُنتُ","أَعۡلَمُ","ٱلۡغَيۡبَ","لَٱسۡتَكۡثَرۡتُ","مِنَ","ٱلۡخَيۡرِ","وَمَا","مَسَّنِيَ","ٱلسُّوٓءُۚ","إِنۡ","أَنَا۠","إِلَّا","نَذِيرٞ","وَبَشِيرٞ","لِّقَوۡمٖ","يُؤۡمِنُونَ"],"ḳул ла амлику линафсии наф`ан вала дарран илла ма шааллаху валау кунту а`ламул гайба ластаксарту минал хайри вама массанийас су'уу ин ана илла назиирун вабашиирул лиḳаумин йу'минуун","Скажи: «Я не властен принести себе пользу или причинить себе вред, если того не пожелает Аллах. Если бы я знал сокровенное, то приумножил бы для себя добро, и зло не коснулось бы меня. Однако я - всего лишь предостерегающий увещеватель и добрый вестник для верующих людей».",["скажи","не","я властен","для себя","пользы","и не","вреда","кроме","того, что","пожелал","Аллах","и если бы","я","знал","сокровенное","непременно я приумножил бы","из","блага","и не","коснулось бы меня","зло","не","я","кроме","увещеватель","и добрый вестник","для людей","верующих"]],[7,189,["هُوَ","ٱلَّذِي","خَلَقَكُم","مِّن","نَّفۡسٖ","وَٰحِدَةٖ","وَجَعَلَ","مِنۡهَا","زَوۡجَهَا","لِيَسۡكُنَ","إِلَيۡهَاۖ","فَلَمَّا","تَغَشَّىٰهَا","حَمَلَتۡ","حَمۡلًا","خَفِيفٗا","فَمَرَّتۡ","بِهِۦۖ","فَلَمَّآ","أَثۡقَلَت","دَّعَوَا","ٱللَّهَ","رَبَّهُمَا","لَئِنۡ","ءَاتَيۡتَنَا","صَٰلِحٗا","لَّنَكُونَنَّ","مِنَ","ٱلشَّٰكِرِينَ"],"хуал лазии халаḳакум мин нафсин вахидатин важа`ала минха заужаха лийаскуна илайха фаламма тагашшаха хамалат хамлан хафиифан фамаррат бихии фаламма асḳалат дда`аваллаха раббахума ла'ин атайтана салихал ланакуунанна минаш шакириин","Он - Тот, Кто сотворил вас из одного человека. Он создал из него супругу, чтобы он нашел в ней покой. Когда же он вступил с ней в близость, она понесла легкое бремя и ходила с ним. Когда же она отяжелела от бремени, они вдвоем воззвали к Аллаху, своему Господу: «Если Ты даруешь нам праведного ребенка, то мы непременно будем в числе благодарных».",["Он","Тот, Который","сотворил вас","из","души","единой","и сделал","из неё","её пару","чтобы он обрёл покой","с ней","и когда","он покрыл её","она понесла","ношу","лёгкую","и ходила","с ней","а когда","она отяжелела","воззвали они оба","к Аллаху","своему Господу","если","Ты даруешь нам","праведного (ребёнка)","непременно мы будем","из","благодарных"]],[7,190,["فَلَمَّآ","ءَاتَىٰهُمَا","صَٰلِحٗا","جَعَلَا","لَهُۥ","شُرَكَآءَ","فِيمَآ","ءَاتَىٰهُمَاۚ","فَتَعَٰلَى","ٱللَّهُ","عَمَّا","يُشۡرِكُونَ"],"фаламма атахума салихан жа`ала лахуу шуракаа фиима атахума фата`алаллаху `амма йушрикуун","Когда же Он даровал им обоим праведного ребенка, они стали приобщать к Нему сотоварищей в том, чем Он одарил их. Аллах превыше того, что они приобщают в сотоварищи.",["а когда","Он даровал им обоим","праведного (ребёнка)","они сделали","Ему","сотоварищей","в том, что","Он даровал им обоим","превыше же","Аллах","того, что","они придают в сотоварищи"]],[7,191,["أَيُشۡرِكُونَ","مَا","لَا","يَخۡلُقُ","شَيۡـٔٗا","وَهُمۡ","يُخۡلَقُونَ"],"айушрикууна ма ла йахлуḳу шай'ан вахум йухлаḳуун","Неужели они приобщают в сотоварищи к Аллаху тех, которые ничего не творят, тогда как сами были сотворены,",["неужели они придают в сотоварищи","то, что","не","творит","ничего","а они (сами)","сотворены"]],[7,192,["وَلَا","يَسۡتَطِيعُونَ","لَهُمۡ","نَصۡرٗا","وَلَآ","أَنفُسَهُمۡ","يَنصُرُونَ"],"вала йастатии`ууна лахум насран вала анфусахум йансуруун","которые не способны оказать им поддержку и не способны помочь даже самим себе?",["и не","они могут","им","помощь (оказать)","и не","самим себе","они помогают"]],[7,193,["وَإِن","تَدۡعُوهُمۡ","إِلَى","ٱلۡهُدَىٰ","لَا","يَتَّبِعُوكُمۡۚ","سَوَآءٌ","عَلَيۡكُمۡ","أَدَعَوۡتُمُوهُمۡ","أَمۡ","أَنتُمۡ","صَٰمِتُونَ"],"ва'ин тад`уухум илал худа ла йаттаби`уукум саваун `алайкум ада`аутумуухум ам антум самитуун","Если вы призовете их на прямой путь, они не последуют за вами. Для вас все равно, будете вы их призывать или будете молчать.",["и если","вы призовёте их","к","прямому пути","не","последуют они за вами","одинаково","для вас","призвали ли вы их","или","вы","молчите"]],[7,194,["إِنَّ","ٱلَّذِينَ","تَدۡعُونَ","مِن","دُونِ","ٱللَّهِ","عِبَادٌ","أَمۡثَالُكُمۡۖ","فَٱدۡعُوهُمۡ","فَلۡيَسۡتَجِيبُواْ","لَكُمۡ","إِن","كُنتُمۡ","صَٰدِقِينَ"],"иннал лазиина тад`ууна мин дууниллахи `ибадун амсалукум фад`уухум фалйастажиибуу лакум ин кунтум садиḳиин","Те, к кому вы взываете наряду с Аллахом, являются рабами, подобными вам самим. Взывайте к ним, и пусть они ответят вам, если вы говорите правду.",["поистине","те, которых","вы призываете","из","помимо","Аллаха","рабы","подобные вам","так призовите их","и пусть ответят","вам","если","вы есть","правдивые"]],[7,195,["أَلَهُمۡ","أَرۡجُلٞ","يَمۡشُونَ","بِهَآۖ","أَمۡ","لَهُمۡ","أَيۡدٖ","يَبۡطِشُونَ","بِهَآۖ","أَمۡ","لَهُمۡ","أَعۡيُنٞ","يُبۡصِرُونَ","بِهَآۖ","أَمۡ","لَهُمۡ","ءَاذَانٞ","يَسۡمَعُونَ","بِهَاۗ","قُلِ","ٱدۡعُواْ","شُرَكَآءَكُمۡ","ثُمَّ","كِيدُونِ","فَلَا","تُنظِرُونِ"],"алахум аржулун йамшууна биха ам лахум айдин йабтишууна биха ам лахум а`йунун йубсирууна биха ам лахум азанун йасма`ууна биха ḳулид`уу шуракаакум сумма киидууни фала тунзируун","Есть ли у них ноги, на которых они ходят? Или у них есть руки, которыми они хватают? Или у них есть глаза, которыми они видят? Или у них есть уши, которыми они слышат? Скажи: «Призовите этих сотоварищей, а затем ухитритесь против меня и не предоставляйте мне отсрочки.",["разве у них","ноги","ходят они","ими","или","у них","руки","хватают они","ими","или","у них","глаза","видят они","ими","или","у них","уши","слышат они","ими","скажи","призовите","ваших сотоварищей","затем","ухитритесь против меня","и не","давайте мне отсрочки"]]],"m":[[["قُل","скажи",7,188],["لَّآ","не",7,188],["أَمۡلِكُ","я властен",7,188],["لِنَفۡسِي","для себя",7,188],["نَفۡعٗا","пользы",7,188],["وَلَا","и не",7,188],["ضَرًّا","вреда",7,188],["إِلَّا","кроме",7,188],["مَا","того, что",7,188],["شَآءَ","пожелал",7,188],["ٱللَّهُۚ","Аллах",7,188],["وَلَوۡ","и если бы",7,188],["كُنتُ","я",7,188]],