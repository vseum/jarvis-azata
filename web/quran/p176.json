{"p":176,"j":9,"a":[[7,196,["إِنَّ","وَلِـِّۧيَ","ٱللَّهُ","ٱلَّذِي","نَزَّلَ","ٱلۡكِتَٰبَۖ","وَهُوَ","يَتَوَلَّى","ٱلصَّٰلِحِينَ"],"инна валлиийаллахул лазии наззалал китаба вахуа йатаваллас салихиин","Воистину, моим Покровителем является Аллах, Который ниспослал Писание. Он покровительствует праведникам.",["поистине","мой Покровитель","Аллах","Который","ниспослал","Писание","и Он","покровительствует","праведникам"]],[7,197,["وَٱلَّذِينَ","تَدۡعُونَ","مِن","دُونِهِۦ","لَا","يَسۡتَطِيعُونَ","نَصۡرَكُمۡ","وَلَآ","أَنفُسَهُمۡ","يَنصُرُونَ"],"валлазиина тад`ууна мин дуунихии ла йастатии`ууна насракум вала анфусахум йансуруун","А те, к кому вы взываете вместо Него, не способны оказать вам поддержку и не способны помочь даже самим себе».",["и те, которых","вы призываете","из","помимо Него","не","способны они","помочь вам","и не","самим себе","помогают они"]],[7,198,["وَإِن","تَدۡعُوهُمۡ","إِلَى","ٱلۡهُدَىٰ","لَا","يَسۡمَعُواْۖ","وَتَرَىٰهُمۡ","يَنظُرُونَ","إِلَيۡكَ","وَهُمۡ","لَا","يُبۡصِرُونَ"],"ва'ин тад`уухум илал худа ла йасма`уу ватарахум йанзурууна илайка вахум ла йубсируун","Если ты призовешь их на прямой путь, они не услышат этого. Ты видишь, как они смотрят на тебя, но они ничего не видят.",["и если","вы призовёте их","к","прямому пути","не","услышат они","и ты видишь их","смотрящими","на тебя","но они","не","видят"]],[7,199,["خُذِ","ٱلۡعَفۡوَ","وَأۡمُرۡ","بِٱلۡعُرۡفِ","وَأَعۡرِضۡ","عَنِ","ٱلۡجَٰهِلِينَ"],"хузил `афва ва'мур бил`урфи ва'а`рид `анил жахилиин","Будь снисходителен (или отдавай излишек; или принимай пожертвования, которые приносят тебе), вели творить добро и отвернись от невежд.",["держись","снисходительности","и повелевай","благим","и отвернись","от","невежд"]],[7,200,["وَإِمَّا","يَنزَغَنَّكَ","مِنَ","ٱلشَّيۡطَٰنِ","نَزۡغٞ","فَٱسۡتَعِذۡ","بِٱللَّهِۚ","إِنَّهُۥ","سَمِيعٌ","عَلِيمٌ"],"ва'имма йанзаганнака минаш шайтани назгун фаста`из биллахи иннахуу самии`ун `алиим","А если дьявол станет наущать тебя, то прибеги к защите Аллаха, ведь Он - Слышащий, Знающий.",["и если же","станет наущать тебя","от","дьявола","наущение","то ищи защиты","у Аллаха","поистине, Он","Слышащий","Знающий"]],[7,201,["إِنَّ","ٱلَّذِينَ","ٱتَّقَوۡاْ","إِذَا","مَسَّهُمۡ","طَٰٓئِفٞ","مِّنَ","ٱلشَّيۡطَٰنِ","تَذَكَّرُواْ","فَإِذَا","هُم","مُّبۡصِرُونَ"],"иннал лазиинаттаḳау иза массахум та'ифум минаш шайтани тазаккаруу фа'иза хум мубсируун","Воистину, если богобоязненных людей коснется наваждение от дьявола, то они поминают назидание и прозревают.",["поистине","те, которые","богобоязненны","когда","коснётся их","наваждение","от","дьявола","они вспоминают","и вот","они","прозревают"]],[7,202,["وَإِخۡوَٰنُهُمۡ","يَمُدُّونَهُمۡ","فِي","ٱلۡغَيِّ","ثُمَّ","لَا","يُقۡصِرُونَ"],"ва'ихванухум йамуддуунахум фил гаййи сумма ла йуḳсируун","А в своих братьях они (дьяволы) усиливают заблуждение, после чего они не останавливаются.",["а братьев их","они увлекают","в","заблуждение","затем","не","прекращают они"]],[7,203,["وَإِذَا","لَمۡ","تَأۡتِهِم","بِـَٔايَةٖ","قَالُواْ","لَوۡلَا","ٱجۡتَبَيۡتَهَاۚ","قُلۡ","إِنَّمَآ","أَتَّبِعُ","مَا","يُوحَىٰٓ","إِلَيَّ","مِن","رَّبِّيۚ","هَٰذَا","بَصَآئِرُ","مِن","رَّبِّكُمۡ","وَهُدٗى","وَرَحۡمَةٞ","لِّقَوۡمٖ","يُؤۡمِنُونَ"],"ва'иза лам та'тихим би'айатин ḳалуу лаулажтабайтаха ḳул иннама аттаби`у ма йууха илаййа мир раббии хаза басаиру мир раббикум вахудан варахматул лиḳаумин йу'минуун","Если ты не явишь им знамения, они скажут: «Почему ты не выбрал (не показал) его?». Скажи: «Я следую только за тем, что внушается мне в откровении от моего Господа. Это - очевидное знамение от Господа вашего, верное руководство и милость для верующих».",["и когда","не","ты приносишь им","знамения","они говорят","почему не","выбрал ты его","скажи","лишь","я следую","тому, что","внушается","мне","от","моего Господа","это","прозрения","от","вашего Господа","и руководство","и милость","для людей","которые веруют"]],[7,204,["وَإِذَا","قُرِئَ","ٱلۡقُرۡءَانُ","فَٱسۡتَمِعُواْ","لَهُۥ","وَأَنصِتُواْ","لَعَلَّكُمۡ","تُرۡحَمُونَ"],"ва'иза ḳуриал ḳур'ану фастами`уу лахуу ва'анситуу ла`аллакум турхамуун","Когда читается Коран, то слушайте его и храните молчание, - быть может, вас помилуют.",["и когда","читается","Коран","то слушайте","его","и молчите","быть может, вы","будете помилованы"]],[7,205,["وَٱذۡكُر","رَّبَّكَ","فِي","نَفۡسِكَ","تَضَرُّعٗا","وَخِيفَةٗ","وَدُونَ","ٱلۡجَهۡرِ","مِنَ","ٱلۡقَوۡلِ","بِٱلۡغُدُوِّ","وَٱلۡأٓصَالِ","وَلَا","تَكُن","مِّنَ","ٱلۡغَٰفِلِينَ"],"вазкур раббака фии нафсика тадарру`ан вахиифатан вадуунал жахри минал ḳаули билгудувви вал'асали вала такум минал гафилиин","Поминай Аллаха с покорностью и страхом про себя и не громко по утрам и перед закатом и не будь одним из беспечных невежд.",["и поминай","твоего Господа","в","душе твоей","смиренно","и со страхом","и без","громкости","из","речи","по утрам","и вечерам","и не","будь","из","беспечных"]],[7,206,["إِنَّ","ٱلَّذِينَ","عِندَ","رَبِّكَ","لَا","يَسۡتَكۡبِرُونَ","عَنۡ","عِبَادَتِهِۦ","وَيُسَبِّحُونَهُۥ","وَلَهُۥ","يَسۡجُدُونَۤ۩"],"иннал лазиина `инда раббика ла йастакбирууна `ан `ибадатихии вайусаббихуунахуу валахуу йасжудуун","Те, которые находятся возле твоего Господа, не превозносятся над поклонением Ему, славословят Ему и падают перед Ним ниц.",["поистине","те, которые","у","твоего Господа","не","превозносятся","от","поклонения Ему","и славят Его","и Ему","падают ниц"]]],"m":[[["إِنَّ","поистине",7,196],["وَلِـِّۧيَ","мой Покровитель",7,196],["ٱللَّهُ","Аллах",7,196],["ٱلَّذِي","Который",7,196],["نَزَّلَ","ниспослал",7,196],["ٱلۡكِتَٰبَۖ","Писание",7,196],["وَهُوَ","и Он",7,196],["يَتَوَلَّى","покровительствует",7,196],["ٱلصَّٰلِحِينَ","праведникам",7,196],[196]],[["وَٱلَّذِينَ","и те, которых",7,197],["تَدۡعُونَ","вы призываете",7,197],["مِن","из",7,197],["دُونِهِۦ","помимо Него",7,197],["لَا","не",7,197],["يَسۡتَطِيعُونَ","способны они",7,197],["نَصۡرَكُمۡ","помочь вам",7,197],["وَلَآ","и не",7,197]],[["أَنفُسَهُمۡ","самим себе",7,197],["يَنصُرُونَ","помогают они",7,197],[197],["وَإِن","и если",7,198],["تَدۡعُوهُمۡ","вы при