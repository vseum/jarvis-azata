{"p":177,"j":9,"a":[[8,1,["يَسۡـَٔلُونَكَ","عَنِ","ٱلۡأَنفَالِۖ","قُلِ","ٱلۡأَنفَالُ","لِلَّهِ","وَٱلرَّسُولِۖ","فَٱتَّقُواْ","ٱللَّهَ","وَأَصۡلِحُواْ","ذَاتَ","بَيۡنِكُمۡۖ","وَأَطِيعُواْ","ٱللَّهَ","وَرَسُولَهُۥٓ","إِن","كُنتُم","مُّؤۡمِنِينَ"],"йас'алуунака `анил анфали ḳулил анфалу лиллахи варрасуули фаттаḳуллаха ва'аслихуу зата байникум ва'атии`уллаха варасуулахуу ин кунтум му'миниин","Они спрашивают тебя о трофеях. Скажи: «Трофеи принадлежат Аллаху и Посланнику». Побойтесь же Аллаха и урегулируйте разногласия между собой. Повинуйтесь Аллаху и Его Посланнику, если вы являетесь верующими.",["спрашивают тебя","о","трофеях","скажи","трофеи","Аллаху","и Посланнику","бойтесь же","Аллаха","и улаживайте","то, что","между вами","и повинуйтесь","Аллаху","и Его Посланнику","если","вы есть","верующие"]],[8,2,["إِنَّمَا","ٱلۡمُؤۡمِنُونَ","ٱلَّذِينَ","إِذَا","ذُكِرَ","ٱللَّهُ","وَجِلَتۡ","قُلُوبُهُمۡ","وَإِذَا","تُلِيَتۡ","عَلَيۡهِمۡ","ءَايَٰتُهُۥ","زَادَتۡهُمۡ","إِيمَٰنٗا","وَعَلَىٰ","رَبِّهِمۡ","يَتَوَكَّلُونَ"],"иннамал му'минуунал лазиина иза зукираллаху важилат ḳулуубухум ва'иза тулийат `алайхим айатухуу задатхум ииманан ва`ала раббихим йатаваккалуун","Верующими являются только те, сердца которых испытывают страх при упоминании Аллаха, вера которых усиливается, когда им читают Его аяты, которые уповают на своего Господа,",["лишь","верующие","те, которые","когда","упоминается","Аллах","трепещут","сердца их","и когда","читаются","им","Его аяты","увеличивают им","веру","и на","Господа их","уповают"]],[8,3,["ٱلَّذِينَ","يُقِيمُونَ","ٱلصَّلَوٰةَ","وَمِمَّا","رَزَقۡنَٰهُمۡ","يُنفِقُونَ"],"аллазиина йуḳиимуунас салавата вамимма разаḳнахум йунфиḳуун","которые совершают намаз и расходуют из того, чем Мы их наделили.",["те, которые","совершают","намаз","и из того, что","Мы наделили их","расходуют"]],[8,4,["أُوْلَٰٓئِكَ","هُمُ","ٱلۡمُؤۡمِنُونَ","حَقّٗاۚ","لَّهُمۡ","دَرَجَٰتٌ","عِندَ","رَبِّهِمۡ","وَمَغۡفِرَةٞ","وَرِزۡقٞ","كَرِيمٞ"],"улаика хумул му'минууна хаḳḳал лахум даражатун `инда раббихим вамагфиратун варизḳун кариим","Они являются истинно верующими. Им уготованы высокое положение у их Господа, прощение и щедрый удел.",["те","они","верующие","истинно","им","ступени","у","Господа их","и прощение","и удел","щедрый"]],[8,5,["كَمَآ","أَخۡرَجَكَ","رَبُّكَ","مِنۢ","بَيۡتِكَ","بِٱلۡحَقِّ","وَإِنَّ","فَرِيقٗا","مِّنَ","ٱلۡمُؤۡمِنِينَ","لَكَٰرِهُونَ"],"кама ахражака раббука мим байтика билхаḳḳи ва'инна фарииḳам минал му'миниина лакарихуун","Таким же образом твой Господь побудил тебя выйти из дома (в направлении Бадра) ради истины, хотя некоторые из верующих не хотели этого.",["как","вывел тебя","твой Господь","из","дома твоего","с истиной","и поистине","часть","из","верующих","непременно противились"]],[8,6,["يُجَٰدِلُونَكَ","فِي","ٱلۡحَقِّ","بَعۡدَ مَا","تَبَيَّنَ","كَأَنَّمَا","يُسَاقُونَ","إِلَى","ٱلۡمَوۡتِ","وَهُمۡ","يَنظُرُونَ"],"йужадилуунака фил хаḳḳи ба`дама табаййана ка'аннама йусаḳууна илал маути вахум йанзуруун","Они препирались с тобой относительно истины после того, как она стала очевидна, словно их вели на смерть, и они наблюдали за этим.",["препираются с тобой","об","истине","после того как","прояснилась","словно","их гонят","к","смерти","и они","видят"]],[8,7,["وَإِذۡ","يَعِدُكُمُ","ٱللَّهُ","إِحۡدَى","ٱلطَّآئِفَتَيۡنِ","أَنَّهَا","لَكُمۡ","وَتَوَدُّونَ","أَنَّ","غَيۡرَ","ذَاتِ","ٱلشَّوۡكَةِ","تَكُونُ","لَكُمۡ","وَيُرِيدُ","ٱللَّهُ","أَن","يُحِقَّ","ٱلۡحَقَّ","بِكَلِمَٰتِهِۦ","وَيَقۡطَعَ","دَابِرَ","ٱلۡكَٰفِرِينَ"],"ва'из йа`идукумуллаху ихдат таифатайни аннаха лакум ватаваддууна анна гайра затиш шаукати такууну лакум вайуриидуллаху ан йухиḳḳал хаḳḳа бикалиматихии вайаḳта`а дабирал кафириин","Вот Аллах обещал вам, что вам достанется один из двух отрядов (торговый караван или вооруженный отряд мекканцев). Вы пожелали, чтобы вам достался невооруженный отряд. Но Аллах желает подтвердить истину своими словами и искоренить неверующих,",["и вот","обещал вам","Аллах","один","из двух отрядов","что он","вам","и желали вы","чтобы","иной, чем","обладающий","оружием","был","вам","но желает","Аллах","чтобы","утвердить","истину","Своими словами","и отсечь","корни","неверующих"]],[8,8,["لِيُحِقَّ","ٱلۡحَقَّ","وَيُبۡطِلَ","ٱلۡبَٰطِلَ","وَلَوۡ","كَرِهَ","ٱلۡمُجۡرِمُونَ"],"лийухиḳḳал хаḳḳа вайубтилал батила валау карихал мужримуун","чтобы восторжествовала истина и исчезла ложь, даже если это ненавистно грешникам.",["чтобы утвердить","истину","и упразднить","ложь","и даже если","ненавистно","грешникам"]]],"m":[["h",8],["b"],[["يَسۡـَٔلُونَكَ","спрашивают тебя",8,1],["عَنِ","о",8,1],["ٱلۡأَنفَالِۖ","трофеях",8,1],["قُلِ","скажи",8,1],["ٱلۡأَنفَالُ","трофеи",8,1],["لِلَّهِ","Аллаху",8,1],["وَٱلرَّسُولِۖ","и Посланнику",8,1],["فَٱتَّقُواْ","бойтесь же",8,1],["ٱللَّهَ","Аллаха",8,1]],[["وَأَصۡلِحُواْ","и улаживайте",8,1],["ذَاتَ","то, что",8,1],["بَيۡنِكُمۡۖ","между вами",8,1],["وَأَطِيعُواْ","и повинуйтесь",8,1],["ٱللَّهَ","Аллаху",8,1],["وَرَسُولَهُۥٓ","и Его Посланнику",8,1],["إِن","если",8,1],["كُنتُم","вы есть",8,1]],[["مُّؤۡمِنِينَ","верующие",8,1],[1],["إِنَّمَا","лишь",8,2],["ٱلۡمُؤۡمِنُونَ","верующие",8,2],["ٱلَّذِينَ","те, которые",8,2],["إِذَا","когда",8,2],["ذُكِرَ","упоминается",8,2],["ٱللَّهُ","Аллах",8,2],["وَجِلَتۡ","трепещут",8,2]],[["قُلُوبُهُمۡ","сердца их",8,2],["وَإِذَا","и когда",8,2],["تُلِيَتۡ","читаются",8,2],["عَلَيۡهِمۡ","им",8,2],["ءَايَٰتُهُۥ","Его аяты",8,2],["زَادَتۡهُمۡ","увеличивают им",8,2],["إِيمَٰنٗا","веру",8,2],["وَعَلَىٰ","и на",8,2],["رَبِّهِمۡ","Господа их",8,2]],[["يَتَوَكَّلُونَ","уповают",8,2],[2],["ٱلَّذِينَ","те, которые",8,3],["يُقِيمُونَ","совершают",8,3],["ٱلصَّلَوٰةَ","намаз",8,3],["وَمِمَّا","и из того, что",8,3],["رَزَقۡنَٰهُمۡ","Мы наделили их",8,3]],[["يُنفِقُونَ","расходуют",8,3],[3],["أُوْلَٰٓئِكَ","те",8,4],["هُمُ","они",8,4],["ٱلۡمُؤۡمِنُونَ","верующие",8,4],["حَقّٗاۚ","истинно",8,4],["لَّهُمۡ","им",8,4],["دَرَجَٰتٌ","ступени",8,4],["عِندَ","у",8,4]],[["رَبِّهِمۡ","Господа их",8,4],["وَمَغۡفِرَةٞ","и прощение",8,4],["وَرِزۡقٞ","и удел",8,4],["كَرِيمٞ","щедрый",8,4],[4],["كَمَآ","как",8,5],["أَخۡرَجَكَ","вывел тебя",8,5],["رَبُّكَ","твой Господь",8,5]],[["مِنۢ","из",8,5],["بَيۡتِكَ","дома твоего",8,5],["بِٱلۡحَقِّ","с истиной",8,5],["وَإِنَّ","и поистине",8,5],["فَرِيقٗا","часть",8,5],["مِّنَ","из",8,5],["ٱلۡمُؤۡمِنِينَ","верующих",8,5],["لَكَٰرِهُونَ","непременно противились",8,5],[5]],[["يُجَٰدِلُونَكَ","препираются с тобой",8,6],["فِي","об",8,6],["ٱلۡحَقِّ","истине",8,6],["بَعۡدَ مَا","после того как",8,6],["تَبَيَّنَ","прояснилась",8,6],["كَأَنَّمَا","словно",8,6],["يُسَاقُونَ","их гонят",8,6],["إِلَى","к",8,6],["ٱلۡمَوۡتِ","смерти",8,6],["وَهُمۡ","и они",8,6]],[["يَنظُرُونَ","видят",8,6],[6],["وَإِذۡ","и вот",8,7],["يَعِدُكُمُ","обещал вам",8,7],["ٱللَّهُ","Аллах",8,7],["إِحۡدَى","один",8,7],["ٱلطَّآئِفَتَيۡنِ","из двух отрядов",8,7],["أَنَّهَا","что он",8,7]],[["لَكُمۡ","вам",8,7],["وَتَوَدُّونَ","и желали вы",8,7],["أَنَّ","чтобы",8,7],["غَيۡرَ","иной, чем",8,7],["ذَاتِ","обладающий",8,7],["ٱلشَّوۡكَةِ","оружием",8,7],["تَكُونُ","был",8,7],["لَكُمۡ","вам",8,7]],[["وَيُرِيدُ","но желает",8,7],["ٱللَّهُ","Аллах",8,7],["أَن","чтобы",8,7],["يُحِقَّ","утвердить",8,7],["ٱلۡحَقَّ","истину",8,7],["بِكَلِمَٰتِهِۦ","Своими словами",8,7],["وَيَقۡطَعَ","и отсечь",8,7],["دَابِرَ","корни",8,7],["ٱلۡكَٰفِرِينَ","неверующих",8,7]],[[7],["لِيُحِقَّ","чтобы утвердить",8,8],["ٱلۡحَقَّ","истину",8,8],["وَيُبۡطِلَ","и упразднить",8,8],["ٱلۡبَٰطِلَ","ложь",8,8],["وَلَوۡ","и даже если",8,8],["كَرِهَ","ненавистно",8,8],["ٱلۡمُجۡرِمُونَ","грешникам",8,8],[8]]]}