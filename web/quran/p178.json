{"p":178,"j":9,"a":[[8,9,["إِذۡ","تَسۡتَغِيثُونَ","رَبَّكُمۡ","فَٱسۡتَجَابَ","لَكُمۡ","أَنِّي","مُمِدُّكُم","بِأَلۡفٖ","مِّنَ","ٱلۡمَلَٰٓئِكَةِ","مُرۡدِفِينَ"],"из тастагиисууна раббакум фастажаба лакум аннии мумиддукум би'алфим минал малаикати мурдифиин","Вот вы попросили своего Господа о помощи, и Он ответил вам: «Я помогу вам тысячью ангелов, следующих друг за другом».",["вот","вы просили помощи","у вашего Господа","и Он ответил","вам","что Я","подкреплю вас","тысячей","из","ангелов","следующих друг за другом"]],[8,10,["وَمَا","جَعَلَهُ","ٱللَّهُ","إِلَّا","بُشۡرَىٰ","وَلِتَطۡمَئِنَّ","بِهِۦ","قُلُوبُكُمۡۚ","وَمَا","ٱلنَّصۡرُ","إِلَّا","مِنۡ","عِندِ","ٱللَّهِۚ","إِنَّ","ٱللَّهَ","عَزِيزٌ","حَكِيمٌ"],"вама жа`алахуллаху илла бушра валитатмаинна бихии ḳулуубукум ваман насру илла мин `индиллахи инналлаха `азиизун хакиим","Аллах сделал это доброй вестью, дабы ваши сердца обрели покой. Победа может быть только от Аллаха. Воистину, Аллах - Могущественный, Мудрый.",["и не","сделал это","Аллах","кроме как","благой вестью","и чтобы успокоились","этим","ваши сердца","и нет","победы","кроме как","от","у","Аллаха","поистине","Аллах","Могущественный","Мудрый"]],[8,11,["إِذۡ","يُغَشِّيكُمُ","ٱلنُّعَاسَ","أَمَنَةٗ","مِّنۡهُ","وَيُنَزِّلُ","عَلَيۡكُم","مِّنَ","ٱلسَّمَآءِ","مَآءٗ","لِّيُطَهِّرَكُم","بِهِۦ","وَيُذۡهِبَ","عَنكُمۡ","رِجۡزَ","ٱلشَّيۡطَٰنِ","وَلِيَرۡبِطَ","عَلَىٰ","قُلُوبِكُمۡ","وَيُثَبِّتَ","بِهِ","ٱلۡأَقۡدَامَ"],"из йугашшиикумун ну`аса аманатам минху вайуназзилу `алайкум минас самаи маал лийутаххиракум бихии вайузхиба `анкум рижзаш шайтани валийарбита `ала ḳулуубикум вайусаббита бихил аḳдам","Вот Он наслал на вас дремоту, чтобы вы почувствовали себя в безопасности, и ниспослал вам с неба воду, чтобы очистить вас ею и удалить c вас скверну дьявола, чтобы сделать ваши сердца стойкими и утвердить этим ваши стопы.",["вот","Он окутал вас","дремотой","в безопасность","от Него","и ниспослал","на вас","с","неба","воду","чтобы очистить вас","ею","и удалить","с вас","скверну","дьявола","и чтобы укрепить","(на)","ваши сердца","и утвердить","этим","стопы"]],[8,12,["إِذۡ","يُوحِي","رَبُّكَ","إِلَى","ٱلۡمَلَٰٓئِكَةِ","أَنِّي","مَعَكُمۡ","فَثَبِّتُواْ","ٱلَّذِينَ","ءَامَنُواْۚ","سَأُلۡقِي","فِي","قُلُوبِ","ٱلَّذِينَ","كَفَرُواْ","ٱلرُّعۡبَ","فَٱضۡرِبُواْ","فَوۡقَ","ٱلۡأَعۡنَاقِ","وَٱضۡرِبُواْ","مِنۡهُمۡ","كُلَّ","بَنَانٖ"],"из йуухии раббука илал малаикати аннии ма`акум фасаббитул лазиина амануу са'улḳии фии ḳулуубил лазиина кафарур ру`ба фадрибуу фауḳал а`наḳи вадрибуу минхум кулла банан","Вот твой Господь внушил ангелам: «Я - с вами. Укрепите тех, которые уверовали! Я же вселю ужас в сердца тех, которые не веруют. Рубите им головы и рубите им все пальцы».",["вот","внушил","твой Господь","к","ангелам","что Я","с вами","укрепите же","тех, которые","уверовали","Я брошу","в","сердца","тех, которые","не уверовали","ужас","так бейте","выше","шей","и бейте","у них","каждый","палец"]],[8,13,["ذَٰلِكَ","بِأَنَّهُمۡ","شَآقُّواْ","ٱللَّهَ","وَرَسُولَهُۥۚ","وَمَن","يُشَاقِقِ","ٱللَّهَ","وَرَسُولَهُۥ","فَإِنَّ","ٱللَّهَ","شَدِيدُ","ٱلۡعِقَابِ"],"залика би'аннахум шаḳḳуллаха варасуулахуу ваман йушаḳиḳиллаха варасуулахуу фа'инналлаха шадиидул `иḳаб","Это потому, что они воспротивились Аллаху и Его Посланнику. А если кто противится Аллаху и Его Посланнику, то ведь Аллах суров в наказании.",["это","потому что они","воспротивились","Аллаху","и Его Посланнику","а кто","противится","Аллаху","и Его Посланнику","то поистине","Аллах","суров","в наказании"]],[8,14,["ذَٰلِكُمۡ","فَذُوقُوهُ","وَأَنَّ","لِلۡكَٰفِرِينَ","عَذَابَ","ٱلنَّارِ"],"заликум фазууḳууху ва'анна лилкафириина `азабан нар","Вот так! Вкусите же его! Воистину, неверующим уготованы мучения в Огне.",["это вам","так вкусите его","и что","неверующим","наказание","Огня"]],[8,15,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُوٓاْ","إِذَا","لَقِيتُمُ","ٱلَّذِينَ","كَفَرُواْ","زَحۡفٗا","فَلَا","تُوَلُّوهُمُ","ٱلۡأَدۡبَارَ"],"йа'аййухал лазиина амануу иза лаḳиитумул лазиина кафаруу захфан фала туаллуухумул адбар","О те, которые уверовали! Когда вы встретитесь с неверующими на поле битвы, то не поворачивайтесь к ним спиной.",["о вы","которые","уверовали","когда","встретите","тех, которые","не уверовали","наступающими","то не","поворачивайтесь к ним","спинами"]],[8,16,["وَمَن","يُوَلِّهِمۡ","يَوۡمَئِذٖ","دُبُرَهُۥٓ","إِلَّا","مُتَحَرِّفٗا","لِّقِتَالٍ","أَوۡ","مُتَحَيِّزًا","إِلَىٰ","فِئَةٖ","فَقَدۡ","بَآءَ","بِغَضَبٖ","مِّنَ","ٱللَّهِ","وَمَأۡوَىٰهُ","جَهَنَّمُۖ","وَبِئۡسَ","ٱلۡمَصِيرُ"],"ваман йуаллихим йаумаизин дубурахуу илла мутахаррифал лиḳиталин ау мутахаййизан ила фи'атин фаḳад баа бигадабим миналлахи вама'ваху жаханнаму ваби'сал масиир","Те, которые в такой день повернутся спиной к неверующим, кроме тех, кто разворачивается для боя или для присоединения с отрядом, навлекут на себя гнев Аллаха. Их пристанищем будет Геенна. Как же скверно это место прибытия!",["а кто","повернётся к ним","в тот день","спиной своей","кроме как","отходящего","для сражения","или","присоединяющегося","к","отряду","то уже","навлёк он","гнев","от","Аллаха","и пристанище его","Геенна","и скверно","место прибытия"]]],"m":[[["إِذۡ","вот",8,9],["تَسۡتَغِيثُونَ","вы просили помощи",8,9],["رَبَّكُمۡ","у вашего Господа",8,9],["فَٱسۡتَجَابَ","и Он ответил",8,9],["لَكُمۡ","вам",8,9],["أَنِّي","что Я",8,9],["مُمِدُّكُم","подкреплю вас",8,9],["بِأَلۡفٖ","тысячей",8,9]],[["مِّنَ","из",8,9],["ٱلۡمَلَٰٓئِكَةِ","ангелов",8,9],["مُرۡدِفِينَ","следующих друг за другом",8,9],[9],["وَمَا","и не",8,10],["جَعَلَهُ","сделал это",8,10],["ٱللَّهُ","Аллах",8,10],["إِلَّا","кроме как",8,10],["بُشۡرَىٰ","благой вестью",8,10]],[["وَلِتَطۡمَئِنَّ","и чтобы успокоились",8,10],["بِهِۦ","этим",8,10],["قُلُوبُكُمۡۚ","ваши сердца",8,10],["وَمَا","и нет",8,10],["ٱلنَّصۡرُ","победы",8,10],["إِلَّا","кроме как",8,10],["مِنۡ","от",8,10],["عِندِ","у",8,10],["ٱللَّهِۚ","Аллаха",8,10],["إِنَّ","поистине",8,10],["ٱللَّهَ","Аллах",8,10]],[["عَزِيزٌ","Могущественный",8,10],["حَكِيمٌ","Мудрый",8,10],[10],["إِذۡ","вот",8,11],["يُغَشِّيكُمُ","Он окутал вас",8,11],["ٱلنُّعَاسَ","дремотой",8,11],["أَمَنَةٗ","в безопасность",8,11],["مِّنۡهُ","от Него",8,11],["وَيُنَزِّلُ","и ниспослал",8,11]],[["عَلَيۡكُم","на вас",8,11],["مِّنَ","с",8,11],["ٱلسَّمَآءِ","неба",8,11],["مَآءٗ","воду",8,11],["لِّيُطَهِّرَكُم","чтобы очистить вас",8,11],["بِهِۦ","ею",8,11],["وَيُذۡهِبَ","и удалить",8,11],["عَنكُمۡ","с вас",8,11],["رِجۡزَ","скверну",8,11]],[["ٱلشَّيۡطَٰنِ","дьявола",8,11],["وَلِيَرۡبِطَ","и чтобы укрепить",8,11],["عَلَىٰ","(на)",8,11],["قُلُوبِكُمۡ","ваши сердца",8,11],["وَيُثَبِّتَ","и утвердить",8,11],["بِهِ","этим",8,11],["ٱلۡأَقۡدَامَ","стопы",8,11],[11]],[["إِذۡ","вот",8,12],["يُوحِي","внушил",8,12],["رَبُّكَ","твой Господь",8,12],["إِلَى","к",8,12],["ٱلۡمَلَٰٓئِكَةِ","ангелам",8,12],["أَنِّي","что Я",8,12],["مَعَكُمۡ","с вами",8,12],["فَثَبِّتُواْ","укрепите же",8,12],["ٱلَّذِينَ","тех, которые",8,12],["ءَامَنُواْۚ","уверовали",8,12]],[["سَأُلۡقِي","Я брошу",8,12],["فِي","в",8,12],["قُلُوبِ","сердца",8,12],["ٱلَّذِينَ","тех, которые",8,12],["كَفَرُواْ","не уверовали",8,12],["ٱلرُّعۡبَ","ужас",8,12],["فَٱضۡرِبُواْ","так бейте",8,12],["فَوۡقَ","выше",8,12]],[["ٱلۡأَعۡنَاقِ","шей",8,12],["وَٱضۡرِبُواْ","и бейте",8,12],["مِنۡهُمۡ","у них",8,12],["كُلَّ","каждый",8,12],["بَنَانٖ","палец",8,12],[12],["ذَٰلِكَ","это",8,13],["بِأَنَّهُمۡ","потому что они",8,13]],[["شَآقُّواْ","воспротивились",8,13],["ٱللَّهَ","Аллаху",8,13],["وَرَسُولَهُۥۚ","и Его Посланнику",8,13],["وَمَن","а кто",8,13],["يُشَاقِقِ","противится",8,13],["ٱللَّهَ","Аллаху",8,13],["وَرَسُولَهُۥ","и Его Посланнику",8,13],["فَإِنَّ","то поистине",8,13],["ٱللَّهَ","Аллах",8,13]],[["شَدِيدُ","суров",8,13],["ٱلۡعِقَابِ","в наказании",8,13],[13],["ذَٰلِكُمۡ","это вам",8,14],["فَذُوقُوهُ","так вкусите его",8,14],["وَأَنَّ","и что",8,14],["لِلۡكَٰفِرِينَ","неверующим",8,14]],[["عَذَابَ","наказание",8,14],["ٱلنَّارِ","Огня",8,14],[14],["يَٰٓأَيُّهَا","о вы",8,15],["ٱلَّذِينَ","которые",8,15],["ءَامَنُوٓاْ","уверовали",8,15],["إِذَا","когда",8,15],["