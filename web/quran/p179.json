{"p":179,"j":9,"a":[[8,17,["فَلَمۡ","تَقۡتُلُوهُمۡ","وَلَٰكِنَّ","ٱللَّهَ","قَتَلَهُمۡۚ","وَمَا","رَمَيۡتَ","إِذۡ","رَمَيۡتَ","وَلَٰكِنَّ","ٱللَّهَ","رَمَىٰ","وَلِيُبۡلِيَ","ٱلۡمُؤۡمِنِينَ","مِنۡهُ","بَلَآءً","حَسَنًاۚ","إِنَّ","ٱللَّهَ","سَمِيعٌ","عَلِيمٞ"],"фалам таḳтулуухум валакинналлаха ḳаталахум вама рамайта из рамайта валакинналлаха рама валийублийал му'миниина минху балаан хасанан инналлаха самии`ун `алиим","Не вы убили их, а Аллах убил их. Не ты бросил горсть песку, когда бросал, а Аллах бросил, дабы подвергнуть верующих прекрасному испытанию от Себя. Воистину, Аллах - Слышащий, Знающий.",["и не","вы убили их","но","Аллах","убил их","и не","ты бросил","когда","ты бросил","но","Аллах","бросил","и чтобы испытать","верующих","от Него","испытанием","прекрасным","поистине","Аллах","Слышащий","Знающий"]],[8,18,["ذَٰلِكُمۡ","وَأَنَّ","ٱللَّهَ","مُوهِنُ","كَيۡدِ","ٱلۡكَٰفِرِينَ"],"заликум ва'анналлаха муухину кайдил кафириин","Вот так! Воистину, Аллах ослабляет козни неверующих.",["это вам","и что","Аллах","ослабляющий","козни","неверующих"]],[8,19,["إِن","تَسۡتَفۡتِحُواْ","فَقَدۡ","جَآءَكُمُ","ٱلۡفَتۡحُۖ","وَإِن","تَنتَهُواْ","فَهُوَ","خَيۡرٞ","لَّكُمۡۖ","وَإِن","تَعُودُواْ","نَعُدۡ","وَلَن","تُغۡنِيَ","عَنكُمۡ","فِئَتُكُمۡ","شَيۡـٔٗا","وَلَوۡ","كَثُرَتۡ","وَأَنَّ","ٱللَّهَ","مَعَ","ٱلۡمُؤۡمِنِينَ"],"ин тастафтихуу фаḳад жаакумул фатху ва'ин тантахуу фахуа хайрул лакум ва'ин та`уудуу на`уд валан тугнийа `анкум фи'атукум шай'ан валау касурат ва'анналлаха ма`ал му'миниин","Если вы (неверующие) просили вынести приговор, то приговор уже явился к вам. Если вы прекратите, то так будет лучше для вас. Но если вы возобновите, то и Мы возобновим (если вы вновь станете сражаться против верующих, то Мы вновь нанесем вам поражение), и ваш отряд не принесет вам никакой пользы, даже если будет многочисленным. Воистину, Аллах - с верующими.",["если","вы просите победы","то уже","пришла к вам","победа","и если","вы прекратите","то это","лучше","для вас","и если","вы вернётесь","Мы вернёмся","и никогда не","избавит","вас","ваш отряд","ничуть","даже если","многочислен","и что","Аллах","с","верующими"]],[8,20,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُوٓاْ","أَطِيعُواْ","ٱللَّهَ","وَرَسُولَهُۥ","وَلَا","تَوَلَّوۡاْ","عَنۡهُ","وَأَنتُمۡ","تَسۡمَعُونَ"],"йа'аййухал лазиина амануу атии`уллаха варасуулахуу вала таваллау `анху ва'антум тасма`уун","О те, которые уверовали! Повинуйтесь Аллаху и Его Посланнику и не отворачивайтесь от него, пока вы слышите.",["о вы","которые","уверовали","повинуйтесь","Аллаху","и Его Посланнику","и не","отворачивайтесь","от него","в то время как вы","слышите"]],[8,21,["وَلَا","تَكُونُواْ","كَٱلَّذِينَ","قَالُواْ","سَمِعۡنَا","وَهُمۡ","لَا","يَسۡمَعُونَ"],"вала такуунуу каллазиина ḳалуу сами`на вахум ла йасма`уун","Не уподобляйтесь тем, которые говорят: «Мы слышали», - а сами не слушают.",["и не","будьте","как те, которые","сказали","мы услышали","но они","не","слышат"]],[8,22,["إِنَّ","شَرَّ","ٱلدَّوَآبِّ","عِندَ","ٱللَّهِ","ٱلصُّمُّ","ٱلۡبُكۡمُ","ٱلَّذِينَ","لَا","يَعۡقِلُونَ"],"инна шаррад давабби `индаллахис суммул букмул лазиина ла йа`ḳилуун","Воистину, наихудшими из живых существ перед Аллахом являются глухие и немые, которые не способны понимать.",["поистине","худшие","из живых существ","у","Аллаха","глухие","немые","которые","не","разумеют"]],[8,23,["وَلَوۡ","عَلِمَ","ٱللَّهُ","فِيهِمۡ","خَيۡرٗا","لَّأَسۡمَعَهُمۡۖ","وَلَوۡ","أَسۡمَعَهُمۡ","لَتَوَلَّواْ","وَّهُم","مُّعۡرِضُونَ"],"валау `алималлаху фиихим хайрал ла'асма`ахум валау асма`ахум латаваллав вахум му`ридуун","Если бы Аллах знал, что в них есть добро, Он непременно наделил бы их слухом. Но даже если бы Он наделил их слухом, они все равно бы отвернулись с отвращением.",["и если бы","знал","Аллах","в них","добро","непременно дал бы им услышать","и если бы","Он дал им услышать","непременно отвернулись бы","и они","отвращающиеся"]],[8,24,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُواْ","ٱسۡتَجِيبُواْ","لِلَّهِ","وَلِلرَّسُولِ","إِذَا","دَعَاكُمۡ","لِمَا","يُحۡيِيكُمۡۖ","وَٱعۡلَمُوٓاْ","أَنَّ","ٱللَّهَ","يَحُولُ","بَيۡنَ","ٱلۡمَرۡءِ","وَقَلۡبِهِۦ","وَأَنَّهُۥٓ","إِلَيۡهِ","تُحۡشَرُونَ"],"йа'аййухал лазиина аманустажиибуу лиллахи валиррасуули иза да`акум лима йухйиикум ва`ламуу анналлаха йахуулу байнал мар'и ваḳалбихии ва'аннахуу илайхи тухшаруун","О те, которые уверовали! Отвечайте Аллаху и Посланнику, когда он призывает вас к тому, что дарует вам жизнь. Знайте, что Аллах - между человеком и его сердцем (может помешать человеку добиться того, что он желает), и что вы будете собраны к Нему.",["о вы","которые","уверовали","отвечайте","Аллаху","и Посланнику","когда","он призывает вас","к тому, что","оживляет вас","и знайте","что","Аллах","встаёт","между","человеком","и его сердцем","и что","к Нему","вы будете собраны"]],[8,25,["وَٱتَّقُواْ","فِتۡنَةٗ","لَّا","تُصِيبَنَّ","ٱلَّذِينَ","ظَلَمُواْ","مِنكُمۡ","خَآصَّةٗۖ","وَٱعۡلَمُوٓاْ","أَنَّ","ٱللَّهَ","شَدِيدُ","ٱلۡعِقَابِ"],"ваттаḳуу фитнатал ла тусиибаннал лазиина заламуу минкум хассатан ва`ламуу анналлаха шадиидул `иḳаб","Бойтесь искушения, которое поразит не только тех из вас, кто был несправедлив. И знайте, что Аллах суров в наказании.",["и бойтесь","искушения","не","постигнет непременно","тех, которые","были несправедливы","из вас","только","и знайте","что","Аллах","суров","в наказании"]]],"m":[[["فَلَمۡ","и не",8,17],["تَقۡتُلُوهُمۡ","вы убили их",8,17],["وَلَٰكِنَّ","но",8,17],["ٱللَّهَ","Аллах",8,17],["قَتَلَهُمۡۚ","убил их",8,17],["وَمَا","и не",8,17],["رَمَيۡتَ","ты бросил",8,17],["إِذۡ","когда",8,17],["رَمَيۡتَ","ты бросил",8,17]],[["وَلَٰكِنَّ","но",8,17],["ٱللَّهَ","Аллах",8,17],["رَمَىٰ","бросил",8,17],["وَلِيُبۡلِيَ","и чтобы испытать",8,17],["ٱلۡمُؤۡمِنِينَ","верующих",8,17],["مِنۡهُ","от Него",8,17],["بَلَآءً","испытанием",8,17],["حَسَنًاۚ","прекрасным",8,17]],[["إِنَّ","поистине",8,17],["ٱللَّهَ","Аллах",8,17],["سَمِيعٌ","Слышащий",8,17],["عَلِيمٞ","Знающий",8,17],[17],["ذَٰلِكُمۡ","это вам",8,18],["وَأَنَّ","и что",8,18],["ٱللَّهَ","Аллах",8,18],["مُوهِنُ","ослабляющий",8,18],["كَيۡدِ","козни",8,18]],[["ٱلۡكَٰفِرِينَ","неверующих",8,18],[18],["إِن","если",8,19],["تَسۡتَفۡتِحُواْ","вы просите победы",8,19],["فَقَدۡ","то уже",8,19],["جَآءَكُمُ","пришла к вам",8,19],["ٱلۡفَتۡحُۖ","победа",8,19]],[["وَإِن","и если",8,19],["تَنتَهُواْ","вы прекратите",8,19],["فَهُوَ","то это",8,19],["خَيۡرٞ","лучше",8,19],["لَّكُمۡۖ","для вас",8,19],["وَإِن","и если",8,19],["تَعُودُواْ","вы вернётесь",8,19],["نَعُدۡ","Мы вернёмся",8,19],["وَلَن","и никогда не",8,19],["تُغۡنِيَ","избавит",8,19],["عَنكُمۡ","вас",8,19]],[["فِئَتُكُمۡ","ваш отряд",8,19],["شَيۡـٔٗا","ничуть",8,19],["وَلَوۡ","даже если",8,19],["كَثُرَتۡ","многочислен",8,19],["وَأَنَّ","и что",8,19],["ٱللَّهَ","Аллах",8,19],["مَعَ","с",8,19],["ٱلۡمُؤۡمِنِينَ","верующими",8,19],[19],["يَٰٓأَيُّهَا","о вы",8,20]],[["ٱلَّذِينَ","которые",8,20],["ءَامَنُوٓاْ","уверовали",8,20],["أَطِيعُواْ","повинуйтесь",8,20],["ٱللَّهَ","Аллаху",8,20],["وَرَسُولَهُۥ","и Его Посланнику",8,20],["وَلَا","и не",8,20],["تَوَلَّوۡاْ","отворачивайтесь",8,20],["عَنۡهُ","от него",8,20],["وَأَنتُمۡ","в то время как вы",8,20]],[["تَسۡمَعُونَ","слышите",8,20],[20],["وَلَا","и не",8,21],["تَكُونُواْ","будьте",8,21],["كَٱلَّذِينَ","как те, которые",8,21],["قَالُواْ","сказали",8,21],["سَمِعۡنَا","мы услышали",8,21],["وَهُمۡ","но они",8,21]],[["لَا","не",8,21],["يَسۡمَعُونَ","слышат",8,21],[21],["۞ إِنَّ","поистине",8,22],["شَرَّ","худшие",8,22],["ٱلدَّوَآبِّ","из живых существ",8,22],["عِندَ","у",8,22],["ٱللَّهِ","Аллаха",8,22],["ٱلصُّمُّ","глухие",8,22],["ٱلۡبُكۡمُ","немые",8,22]],[["ٱلَّذِينَ","которые",8,22],["لَا","не",8,22],["يَعۡقِلُونَ","разумеют",8,22],[22],["وَلَوۡ","и если бы",8,23],["عَلِمَ","знал",8,23],["ٱللَّهُ","Аллах",8,23],["فِيهِمۡ","в них",8,23],["خَيۡرٗا","добро",8,23],["لَّأَسۡمَعَهُمۡۖ","непременно дал бы им услышать",8,23]],[["وَلَوۡ","и если бы",8,23],["أَسۡمَعَهُمۡ","Он дал им услышать",8,23],["لَتَوَلَّواْ","непременно отвернулись бы",8,23],["وَّهُم","и они",8,23],["مُّعۡرِضُونَ","отвращающиеся",8,23],[23],["يَٰٓأَيُّهَا","о вы",8,24],["ٱلَّذِينَ","которые",8,24]],[["ءَامَنُواْ","уверовали",8,24],["ٱسۡتَجِيبُواْ","отвечайте",8,24],["لِلَّهِ","Аллаху",8,24],["وَلِلرَّسُولِ","и Посланнику",8,24],["إِذَا","когда",8,24],["دَعَاكُمۡ","он призывает вас",8,24],["لِمَا","к тому, что",8,24],["يُحۡيِيكُمۡۖ","оживляет вас",8,24]],[["وَٱعۡلَمُوٓاْ","и знайте",8,24],["أَنَّ","что",8,24],["ٱللَّهَ","Аллах",8,24],["يَحُولُ","встаёт",8,24],["بَيۡنَ","между",8,24],["ٱلۡمَرۡءِ","человеком",8,24],["وَقَلۡبِهِۦ","и его сердцем",8,24],["وَأَنَّهُۥٓ","и что",8,24],["إِلَيۡهِ","к Нему",8,24]],[["تُحۡشَرُونَ","вы будете собраны",8,24],[24],["وَٱتَّقُواْ","и бойтесь",8,25],["فِتۡنَةٗ","искушения",8,25],["لَّا","не",8,25],["تُصِيبَنَّ","постигнет непременно",8,25],["ٱلَّذِينَ","тех, которые",8,25],["ظَلَمُواْ","были несправедливы",8,25]],[["مِنكُمۡ","из вас",8,25],["خَآصَّةٗۖ","только",8,25],["وَٱعۡلَمُوٓاْ","и знайте",8,25],["أَنَّ","что",8,25],["ٱللَّهَ","Аллах",8,25],["شَدِيدُ","суров",8,25],["ٱلۡعِقَابِ","в наказании",8,25],[25]]]}