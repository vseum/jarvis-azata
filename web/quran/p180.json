{"p":180,"j":9,"a":[[8,26,["وَٱذۡكُرُوٓاْ","إِذۡ","أَنتُمۡ","قَلِيلٞ","مُّسۡتَضۡعَفُونَ","فِي","ٱلۡأَرۡضِ","تَخَافُونَ","أَن","يَتَخَطَّفَكُمُ","ٱلنَّاسُ","فَـَٔاوَىٰكُمۡ","وَأَيَّدَكُم","بِنَصۡرِهِۦ","وَرَزَقَكُم","مِّنَ","ٱلطَّيِّبَٰتِ","لَعَلَّكُمۡ","تَشۡكُرُونَ"],"вазкуруу из антум ḳалиилум мустад`афууна фил арди тахафууна ан йатахаттафакумун насу фа'авакум ва'аййадакум бинасрихии варазаḳакум минат таййибати ла`аллакум ташкуруун","Помните, что вы были малочисленны и считались слабыми на земле. Вы опасались, что люди схватят вас, но Он дал вам убежище, подкрепил вас Своей помощью и наделил вас благами, чтобы вы были благодарны.",["и помните","когда","вы","немногочисленные","считаемые слабыми","на","земле","боялись вы","что","похитят вас","люди","и Он приютил вас","и подкрепил вас","Своей помощью","и наделил вас","из","благ","быть может, вы","будете благодарны"]],[8,27,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُواْ","لَا","تَخُونُواْ","ٱللَّهَ","وَٱلرَّسُولَ","وَتَخُونُوٓاْ","أَمَٰنَٰتِكُمۡ","وَأَنتُمۡ","تَعۡلَمُونَ"],"йа'аййухал лазиина амануу ла тахуунуллаха варрасуула ватахуунуу аманатикум ва'антум та`ламуун","О те, которые уверовали! Не предавайте Аллаха и Посланника и не покушайтесь на то, что вверено вам, сознательно.",["о вы","которые","уверовали","не","предавайте","Аллаха","и Посланника","и не предавайте","доверенного вам","в то время как вы","знаете"]],[8,28,["وَٱعۡلَمُوٓاْ","أَنَّمَآ","أَمۡوَٰلُكُمۡ","وَأَوۡلَٰدُكُمۡ","فِتۡنَةٞ","وَأَنَّ","ٱللَّهَ","عِندَهُۥٓ","أَجۡرٌ","عَظِيمٞ"],"ва`ламуу аннама амвалукум ва'ауладукум фитнатун ва'анналлаха `индахуу ажрун `азиим","Знайте, что ваше имущество и ваши дети являются искушением и что у Аллаха - великая награда.",["и знайте","что лишь","ваше имущество","и ваши дети","искушение","и что","Аллах","у Него","награда","великая"]],[8,29,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُوٓاْ","إِن","تَتَّقُواْ","ٱللَّهَ","يَجۡعَل","لَّكُمۡ","فُرۡقَانٗا","وَيُكَفِّرۡ","عَنكُمۡ","سَيِّـَٔاتِكُمۡ","وَيَغۡفِرۡ","لَكُمۡۗ","وَٱللَّهُ","ذُو","ٱلۡفَضۡلِ","ٱلۡعَظِيمِ"],"йа'аййухал лазиина амануу ин таттаḳуллаха йаж`ал лакум фурḳанан вайукаффир `анкум саййиатикум вайагфир лакум валлаху зул фадлил `азиим","О те, которые уверовали! Если вы будете бояться Аллаха, то Он одарит вас способностью различать истину и ложь, отпустит вам ваши прегрешения и простит вас. Воистину, Аллах обладает великой милостью.",["о вы","которые","уверовали","если","будете бояться","Аллаха","Он сделает","вам","различение","и покроет","с вас","ваши злодеяния","и простит","вам","и Аллах","обладатель","милости","великой"]],[8,30,["وَإِذۡ","يَمۡكُرُ","بِكَ","ٱلَّذِينَ","كَفَرُواْ","لِيُثۡبِتُوكَ","أَوۡ","يَقۡتُلُوكَ","أَوۡ","يُخۡرِجُوكَۚ","وَيَمۡكُرُونَ","وَيَمۡكُرُ","ٱللَّهُۖ","وَٱللَّهُ","خَيۡرُ","ٱلۡمَٰكِرِينَ"],"ва'из йамкуру бикал лазиина кафаруу лийусбитуука ау йаḳтулуука ау йухрижуука вайамкурууна вайамкуруллаху валлаху хайрул макириин","Вот неверующие ухищрялись, чтобы заточить, убить или изгнать тебя. Они хитрили, и Аллах хитрил, а ведь Аллах - Наилучший из хитрецов.",["и вот","хитрили","против тебя","те, которые","не уверовали","чтобы заточить тебя","или","убить тебя","или","изгнать тебя","и хитрили они","и хитрил","Аллах","и Аллах","лучший","из хитрецов"]],[8,31,["وَإِذَا","تُتۡلَىٰ","عَلَيۡهِمۡ","ءَايَٰتُنَا","قَالُواْ","قَدۡ","سَمِعۡنَا","لَوۡ","نَشَآءُ","لَقُلۡنَا","مِثۡلَ","هَٰذَآ","إِنۡ","هَٰذَآ","إِلَّآ","أَسَٰطِيرُ","ٱلۡأَوَّلِينَ"],"ва'иза тутла `алайхим айатуна ḳалуу ḳад сами`на лау нашау лаḳулна мисла хаза ин хаза илла асатиирул аввалиин","Когда им читают Наши аяты, они говорят: «Мы уже слышали это. Если мы захотим, то сочиним нечто подобное. Ведь это - всего лишь легенды древних народов».",["и когда","читаются","им","Наши аяты","они говорят","уже","мы слышали","если бы","мы пожелали","непременно сказали бы мы","подобное","этому","не","это","кроме как","сказки","древних"]],[8,32,["وَإِذۡ","قَالُواْ","ٱللَّهُمَّ","إِن","كَانَ","هَٰذَا","هُوَ","ٱلۡحَقَّ","مِنۡ","عِندِكَ","فَأَمۡطِرۡ","عَلَيۡنَا","حِجَارَةٗ","مِّنَ","ٱلسَّمَآءِ","أَوِ","ٱئۡتِنَا","بِعَذَابٍ","أَلِيمٖ"],"ва'из ḳалуллахумма ин кана хаза хуал хаḳḳа мин `индика фа'амтир `алайна хижаратам минас самаи авитина би`азабин алиим","Вот они сказали: «О Аллах! Если это является истиной от Тебя, то обрушь на нас камни с неба или же подвергни нас мучительным страданиям».",["и вот","они сказали","о Аллах","если","является","это","именно","истиной","от","Тебя","то пролей дождём","на нас","камни","с","неба","или","наведи на нас","наказание","мучительное"]],[8,33,["وَمَا","كَانَ","ٱللَّهُ","لِيُعَذِّبَهُمۡ","وَأَنتَ","فِيهِمۡۚ","وَمَا","كَانَ","ٱللَّهُ","مُعَذِّبَهُمۡ","وَهُمۡ","يَسۡتَغۡفِرُونَ"],"вама каналлаху лийу`аззибахум ва'анта фиихим вама каналлаху му`аззибахум вахум йастагфируун","Аллах не стал подвергать их мучениям, пока ты находился среди них, и Аллах не стал подвергать их мучениям, пока они молили о прощении.",["и не","стал","Аллах","наказывать их","в то время как ты","среди них","и не","стал","Аллах","наказывающим их","в то время как они","просят прощения"]]],"m":[[["وَٱذۡكُرُوٓاْ","и помните",8,26],["إِذۡ","когда",8,26],["أَنتُمۡ","вы",8,26],["قَلِيلٞ","немногочисленные",8,26],["مُّسۡتَضۡعَفُونَ","считаемые слабыми",8,26],["فِي","на",8,26],["ٱلۡأَرۡضِ","земле",8,26],["تَخَافُونَ","боялись вы",8,26]],[["أَن","что",8,26],["يَتَخَطَّفَكُمُ","похитят вас",8,26],["ٱلنَّاسُ","люди",8,26],["فَـَٔاوَىٰكُمۡ","и Он приютил вас",8,26],["وَأَيَّدَكُم","и подкрепил вас",8,26],["بِنَصۡرِهِۦ","Своей помощью",8,26],["وَرَزَقَكُم","и наделил вас",8,26]],[["مِّنَ","из",8,26],["ٱلطَّيِّبَٰتِ","благ",8,26],["لَعَلَّكُمۡ","быть может, вы",8,26],["تَشۡكُرُونَ","будете благодарны",8,26],[26],["يَٰٓأَيُّهَا","о вы",8,27],["ٱلَّذِينَ","которые",8,27],["ءَامَنُواْ","уверовали",8,27]],[["لَا","не",8,27],["تَخُونُواْ","предавайте",8,27],["ٱللَّهَ","Аллаха",8,27],["وَٱلرَّسُولَ","и Посланника",8,27],["وَتَخُونُوٓاْ","и не предавайте",8,27],["أَمَٰنَٰتِكُمۡ","доверенного вам",8,27],["وَأَنتُمۡ","в то время как вы",8,27],["تَعۡلَمُونَ","знаете",8,27]],[[27],["وَٱعۡلَمُوٓاْ","и знайте",8,28],["أَنَّمَآ","что лишь",8,28],["أَمۡوَٰلُكُمۡ","ваше имущество",8,28],["وَأَوۡلَٰدُكُمۡ","и ваши дети",8,28],["فِتۡنَةٞ","искушение",8,28],["وَأَنَّ","и что",8,28],["ٱللَّهَ","Аллах",8,28]],[["عِندَهُۥٓ","у Него",8,28],["أَجۡرٌ","награда",8,28],["عَظِيمٞ","великая",8,28],[28],["يَٰٓأَيُّهَا","о вы",8,29],["ٱلَّذِينَ","которые",8,29],["ءَامَنُوٓاْ","уверовали",8,29],["إِن","если",8,29],["تَتَّقُواْ","будете бояться",8,29]],[["ٱللَّهَ","Аллаха",8,29],["يَجۡعَل","Он сделает",8,29],["لَّكُمۡ","вам",8,29],["فُرۡقَانٗا","различение",8,29],["وَيُكَفِّرۡ","и покроет",8,29],["عَنكُمۡ","с вас",8,29],["سَيِّـَٔاتِكُمۡ","ваши злодеяния",8,29],["وَيَغۡفِرۡ","и простит",8,29]],[["لَكُمۡۗ","вам",8,29],["وَٱللَّهُ","и Аллах",8,29],["ذُو","обладатель",8,29],["ٱلۡفَضۡلِ","милости",8,29],["ٱلۡعَظِيمِ","великой",8,29],[29],["وَإِذۡ","и вот",8,30],["يَمۡكُرُ","хитрили",8,30],["بِكَ","против тебя",8,30],["ٱلَّذِينَ","те, которые",8,30]],[["كَفَرُواْ","не уверовали",8,30],["لِيُثۡبِتُوكَ","чтобы заточить тебя",8,30],["أَوۡ","или",8,30],["يَقۡتُلُوكَ","убить тебя",8,30],["أَوۡ","или",8,30],["يُخۡرِجُوكَۚ","изгнать тебя",8,30],["وَيَمۡكُرُونَ","и хитрили они",8,30],["وَيَمۡكُرُ","и хитрил",8,30]],[["ٱللَّهُۖ","Аллах",8,30],["وَٱللَّهُ","и Аллах",8,30],["خَيۡرُ","лучший",8,30],["ٱلۡمَٰكِرِينَ","из хитрецов",8,30],[30],["وَإِذَا","и когда",8,31],["تُتۡلَىٰ","читаются",8,31],["عَلَيۡهِمۡ","им",8,31],["ءَايَٰتُنَا","Наши аяты",8,31]],[["قَالُواْ","они говорят",8,31],["قَدۡ","уже",8,31],["سَمِعۡنَا","мы слышали",8,31],["لَوۡ","если бы",8,31],["نَشَآءُ","мы пожелали",8,31],["لَقُلۡنَا","непременно сказали бы мы",8,31],["مِثۡلَ","подобное",8,31],["هَٰذَآ","этому",8,31],["إِنۡ","не",8,31],["هَٰذَآ","это",8,31],["إِلَّآ","кроме как",8,31]],[["أَسَٰطِيرُ","сказки",8,31],["ٱلۡأَوَّلِينَ","древних",8,31],[31],["وَإِذۡ","и вот",8,32],["قَالُواْ","они сказали",8,32],["ٱللَّهُمَّ","о Аллах",8,32],["إِن","если",8,32],["كَانَ","является",8,32],["هَٰذَا","это",8,32]],[["هُوَ","именно",8,32],["ٱلۡحَقَّ","истиной",8,32],["مِنۡ","от",8,32],["عِندِكَ","Тебя",8,32],["فَأَمۡطِرۡ","то пролей дождём",8,32],["عَلَيۡنَا","на нас",8,32],["حِجَارَةٗ","камни",8,32],["مِّنَ","с",8,32],["ٱلسَّمَآءِ","неба",8,32]],[["أَوِ","или",8,32],["ٱئۡتِنَا","наведи на нас",8,32],["بِعَذَابٍ","наказание",8,32],["أَلِيمٖ","мучительное",8,32],[32],["وَمَا","и не",8,33],["كَانَ","стал",8,33],["ٱللَّهُ","Аллах",8,33],["لِيُعَذِّبَهُمۡ","наказывать их",8,33]],[["وَأَنتَ","в то время как ты",8,33],["فِيهِمۡۚ","среди них",8,33],["وَمَا","и не",8,33],["كَانَ","стал",8,33],["ٱللَّهُ","Аллах",8,33],["مُعَذِّبَهُمۡ","наказывающим их",8,33],["وَهُمۡ","в то время как они",8,33],["يَسۡتَغۡفِرُونَ","просят прощения",8,33],[33]]]}