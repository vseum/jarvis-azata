{"p":181,"j":9,"a":[[8,34,["وَمَا","لَهُمۡ","أَلَّا","يُعَذِّبَهُمُ","ٱللَّهُ","وَهُمۡ","يَصُدُّونَ","عَنِ","ٱلۡمَسۡجِدِ","ٱلۡحَرَامِ","وَمَا","كَانُوٓاْ","أَوۡلِيَآءَهُۥٓۚ","إِنۡ","أَوۡلِيَآؤُهُۥٓ","إِلَّا","ٱلۡمُتَّقُونَ","وَلَٰكِنَّ","أَكۡثَرَهُمۡ","لَا","يَعۡلَمُونَ"],"вама лахум алла йу`аззибахумуллаху вахум йасуддууна `анил масжидил харами вама кануу аулийаахуу ин аулийаухуу иллал муттаḳууна валакинна аксарахум ла йа`ламуун","Но как же Аллаху не подвергнуть их мучениям, если они не допускают мусульман к Заповедной мечети, не будучи Его угодниками? Его угодниками являются только богобоязненные, но большинство их не ведает об этом.",["и что","им (мешает)","чтобы не","наказал их","Аллах","в то время как они","отвращают","от","Мечети","Заповедной","и не","были они","её покровителями","не","её покровители","кроме","богобоязненные","но","большинство их","не","знают"]],[8,35,["وَمَا","كَانَ","صَلَاتُهُمۡ","عِندَ","ٱلۡبَيۡتِ","إِلَّا","مُكَآءٗ","وَتَصۡدِيَةٗۚ","فَذُوقُواْ","ٱلۡعَذَابَ","بِمَا","كُنتُمۡ","تَكۡفُرُونَ"],"вама кана салатухум `индал байти илла мукаан ватасдийатан фазууḳул `азаба бима кунтум такфуруун","Их молитва возле мечети была всего лишь свистом и хлопаньем в ладоши. Вкусите же мучения за то, что вы не верили.",["и не","была","их молитва","у","Дома","кроме как","свистом","и хлопаньем","вкусите же","наказание","за то, что","вы","не веровали"]],[8,36,["إِنَّ","ٱلَّذِينَ","كَفَرُواْ","يُنفِقُونَ","أَمۡوَٰلَهُمۡ","لِيَصُدُّواْ","عَن","سَبِيلِ","ٱللَّهِۚ","فَسَيُنفِقُونَهَا","ثُمَّ","تَكُونُ","عَلَيۡهِمۡ","حَسۡرَةٗ","ثُمَّ","يُغۡلَبُونَۗ","وَٱلَّذِينَ","كَفَرُوٓاْ","إِلَىٰ","جَهَنَّمَ","يُحۡشَرُونَ"],"иннал лазиина кафаруу йунфиḳууна амвалахум лийасуддуу `ан сабиилиллахи фасайунфиḳуунаха сумма такууну `алайхим хасратан сумма йуглабууна валлазиина кафаруу ила жаханнама йухшаруун","Воистину, неверующие расходуют свое имущество для того, чтобы сбить других с пути Аллаха. Они будут расходовать его, а затем будут сожалеть об этом, а вслед за тем они будут повержены. Неверующие будут собраны в Геенне,",["поистине","те, которые","не уверовали","расходуют","своё имущество","чтобы отвращать","от","пути","Аллаха","и будут расходовать его","затем","станет","для них","сожалением","затем","они будут побеждены","и те, которые","не уверовали","в","Геенну","будут собраны"]],[8,37,["لِيَمِيزَ","ٱللَّهُ","ٱلۡخَبِيثَ","مِنَ","ٱلطَّيِّبِ","وَيَجۡعَلَ","ٱلۡخَبِيثَ","بَعۡضَهُۥ","عَلَىٰ","بَعۡضٖ","فَيَرۡكُمَهُۥ","جَمِيعٗا","فَيَجۡعَلَهُۥ","فِي","جَهَنَّمَۚ","أُوْلَٰٓئِكَ","هُمُ","ٱلۡخَٰسِرُونَ"],"лийамиизаллахул хабииса минат таййиби вайаж`алал хабииса ба`дахуу `ала ба`дин файаркумахуу жамии`ан файаж`алахуу фии жаханнама улаика хумул хасируун","чтобы Аллах отделил скверного человека от доброго, бросил скверных одного на другого, собрал их всех вместе и поместил в Геенне. Они будут потерпевшими убыток.",["чтобы отделил","Аллах","скверное","от","доброго","и положил","скверное","одно его","на","другое","и сгрёб его","всё вместе","и поместил его","в","Геенну","те","они","потерпевшие убыток"]],[8,38,["قُل","لِّلَّذِينَ","كَفَرُوٓاْ","إِن","يَنتَهُواْ","يُغۡفَرۡ","لَهُم","مَّا","قَدۡ","سَلَفَ","وَإِن","يَعُودُواْ","فَقَدۡ","مَضَتۡ","سُنَّتُ","ٱلۡأَوَّلِينَ"],"ḳул лиллазиина кафаруу ин йантахуу йугфар лахум ма ḳад салафа ва'ин йа`уудуу фаḳад мадат суннатул аввалиин","Скажи неверующим, что если они прекратят, то им будет прощено то, что было в прошлом. Но если они возвратятся к неверию, то ведь уже были примеры первых поколений.",["скажи","тем, которые","не уверовали","если","они прекратят","будет прощено","им","то, что","уже","прошло","а если","они вернутся","то уже","прошёл","обычай","древних"]],[8,39,["وَقَٰتِلُوهُمۡ","حَتَّىٰ","لَا","تَكُونَ","فِتۡنَةٞ","وَيَكُونَ","ٱلدِّينُ","كُلُّهُۥ","لِلَّهِۚ","فَإِنِ","ٱنتَهَوۡاْ","فَإِنَّ","ٱللَّهَ","بِمَا","يَعۡمَلُونَ","بَصِيرٞ"],"ваḳатилуухум хатта ла такууна фитнатун вайакуунад диину куллухуу лиллахи фа'ининтахау фа'инналлаха бима йа`малууна басиир","Сражайтесь с ними, пока не исчезнет искушение и пока религия (поклонение) не будет полностью посвящена Аллаху. Если же они прекратят, то ведь Аллах видит то, что они совершают.",["и сражайтесь с ними","пока","не","будет","искушения","и будет","религия","вся она","Аллаху","а если","они прекратят","то поистине","Аллах","тем, что","они делают","Видящий"]],[8,40,["وَإِن","تَوَلَّوۡاْ","فَٱعۡلَمُوٓاْ","أَنَّ","ٱللَّهَ","مَوۡلَىٰكُمۡۚ","نِعۡمَ","ٱلۡمَوۡلَىٰ","وَنِعۡمَ","ٱلنَّصِيرُ"],"ва'ин таваллау фа`ламуу анналлаха маулакум ни`мал маула вани`ман насиир","Но если они отвернутся, то да будет вам известно, что Аллах является вашим Покровителем. Как прекрасен этот Покровитель! Как прекрасен этот Помощник!",["и если","они отвернутся","то знайте","что","Аллах","ваш Покровитель","прекрасен","Покровитель","и прекрасен","Помощник"]]],"m":[[["وَمَا","и что",8,34],["لَهُمۡ","им (мешает)",8,34],["أَلَّا","чтобы не",8,34],["يُعَذِّبَهُمُ","наказал их",8,34],["ٱللَّهُ","Аллах",8,34],["وَهُمۡ","в то время как они",8,34],["يَصُدُّونَ","отвращают",8,34],["عَنِ","от",8,34],["ٱلۡمَسۡجِدِ","Мечети",8,34]],[["ٱلۡحَرَامِ","Заповедной",8,34],["وَمَا","и не",8,34],["كَانُوٓاْ","были они",8,34],["أَوۡلِيَآءَهُۥٓۚ","её покровителями",8,34],["إِنۡ","не",8,34],["أَوۡلِيَآؤُهُۥٓ","её покровители",8,34],["إِلَّا","кроме",8,34],["ٱلۡمُتَّقُونَ","богобоязненные",8,34]],[["وَلَٰكِنَّ","но",8,34],["أَكۡثَرَهُمۡ","большинство их",8,34],["لَا","не",8,34],["يَعۡلَمُونَ","знают",8,34],[34],["وَمَا","и не",8,35],["كَانَ","была",8,35],["صَلَاتُهُمۡ","их молитва",8,35]],[["عِندَ","у",8,35],["ٱلۡبَيۡتِ","Дома",8,35],["إِلَّا","кроме как",8,35],["مُكَآءٗ","свистом",8,35],["وَتَصۡدِيَةٗۚ","и хлопаньем",8,35],["فَذُوقُواْ","вкусите же",8,35],["ٱلۡعَذَابَ","наказание",8,35]],[["بِمَا","за то, что",8,35],["كُنتُمۡ","вы",8,35],["تَكۡفُرُونَ","не веровали",8,35],[35],["إِنَّ","поистине",8,36],["ٱلَّذِينَ","те, которые",8,36],["كَفَرُواْ","не уверовали",8,36],["يُنفِقُونَ","расходуют",8,36]],[["أَمۡوَٰلَهُمۡ","своё имущество",8,36],["لِيَصُدُّواْ","чтобы отвращать",8,36],["عَن","от",8,36],["سَبِيلِ","пути",8,36],["ٱللَّهِۚ","Аллаха",8,36],["فَسَيُنفِقُونَهَا","и будут расходовать его",8,36],["ثُمَّ","затем",8,36],["تَكُونُ","станет",8,36]],[["عَلَيۡهِمۡ","для них",8,36],["حَسۡرَةٗ","сожалением",8,36],["ثُمَّ","затем",8,36],["يُغۡلَبُونَۗ","они будут побеждены",8,36],["وَٱلَّذِينَ","и те, которые",8,36],["كَفَرُوٓاْ","не уверовали",8,36],["إِلَىٰ","в",8,36],["جَهَنَّمَ","Геенну",8,36]],[["يُحۡشَرُونَ","будут собраны",8,36],[36],["لِيَمِيزَ","чтобы отделил",8,37],["ٱللَّهُ","Аллах",8,37],["ٱلۡخَبِيثَ","скверное",8,37],["مِنَ","от",8,37],["ٱلطَّيِّبِ","доброго",8,37],["وَيَجۡعَلَ","и положил",8,37]],[["ٱلۡخَبِيثَ","скверное",8,37],["بَعۡضَهُۥ","одно его",8,37],["عَلَىٰ","на",8,37],["بَعۡضٖ","другое",8,37],["فَيَرۡكُمَهُۥ","и сгрёб его",8,37],["جَمِيعٗا","всё вместе",8,37],["فَيَجۡعَلَهُۥ","и поместил его",8,37]],[["فِي","в",8,37],["جَهَنَّمَۚ","Геенну",8,37],["أُوْلَٰٓئِكَ","те",8,37],["هُمُ","они",8,37],["ٱلۡخَٰسِرُونَ","потерпевшие убыток",8,37],[37],["قُل","скажи",8,38],["لِّلَّذِينَ","тем, которые",8,38]],[["كَفَرُوٓاْ","не уверовали",8,38],["إِن","если",8,38],["يَنتَهُواْ","они прекратят",8,38],["يُغۡفَرۡ","будет прощено",8,38],["لَهُم","им",8,38],["مَّا","то, что",8,38],["قَدۡ","уже",8,38],["سَلَفَ","прошло",8,38],["وَإِن","а если",8,38],["يَعُودُواْ","они вернутся",8,38]],[["فَقَدۡ","то уже",8,38],["مَضَتۡ","прошёл",8,38],["سُنَّتُ","обычай",8,38],["ٱلۡأَوَّلِينَ","древних",8,38],[38],["وَقَٰتِلُوهُمۡ","и сражайтесь с ними",8,39],["حَتَّىٰ","пока",8,39]],[["لَا","не",8,39],["تَكُونَ","будет",8,39],["فِتۡنَةٞ","искушения",8,39],["وَيَكُونَ","и будет",8,39],["ٱلدِّينُ","религия",8,39],["كُلُّهُۥ","вся она",8,39],["لِلَّهِۚ","Аллаху",8,39],["فَإِنِ","а если",8,39]],[["ٱنتَهَوۡاْ","они прекратят",8,39],["فَإِنَّ","то поистине",8,39],["ٱللَّهَ","Аллах",8,39],["بِمَا","тем, что",8,39],["يَعۡمَلُونَ","они делают",8,39],["بَصِيرٞ","Видящий",8,39],[39],["وَإِن","и если",8,40],["تَوَلَّوۡاْ","они отвернутся",8,40]],[["فَٱعۡلَمُو