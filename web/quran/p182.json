{"p":182,"j":10,"a":[[8,41,["وَٱعۡلَمُوٓاْ","أَنَّمَا","غَنِمۡتُم","مِّن","شَيۡءٖ","فَأَنَّ","لِلَّهِ","خُمُسَهُۥ","وَلِلرَّسُولِ","وَلِذِي","ٱلۡقُرۡبَىٰ","وَٱلۡيَتَٰمَىٰ","وَٱلۡمَسَٰكِينِ","وَٱبۡنِ","ٱلسَّبِيلِ","إِن","كُنتُمۡ","ءَامَنتُم","بِٱللَّهِ","وَمَآ","أَنزَلۡنَا","عَلَىٰ","عَبۡدِنَا","يَوۡمَ","ٱلۡفُرۡقَانِ","يَوۡمَ","ٱلۡتَقَى","ٱلۡجَمۡعَانِۗ","وَٱللَّهُ","عَلَىٰ","كُلِّ","شَيۡءٖ","قَدِيرٌ"],"ва`ламуу аннама ганимтум мин шай'ин фа'анна лиллахи хумусахуу валиррасуули вализил ḳурба валйатама валмасакиини вабнис сабиили ин кунтум амантум биллахи вама анзална `ала `абдина йаумал фурḳани йаумал таḳал жам`ани валлаху `ала кулли шай'ин ḳадиир","Знайте, что если вы захватили трофеи, то пятая часть их принадлежит Аллаху, Посланнику, близким родственникам Посланника, сиротам, беднякам и путникам, если вы уверовали в Аллаха и в то, что Мы ниспослали Нашему рабу в день различения, в день, когда встретились две армии при Бадре. Воистину, Аллах способен на всякую вещь.",["и знайте","что то, что","вы взяли трофеем","из","чего-либо","то","Аллаху","пятая часть его","и Посланнику","и обладающим","родством","и сиротам","и беднякам","и сыну","пути","если","вы","уверовали","в Аллаха","и в то, что","Мы ниспослали","на","Нашего раба","в день","различения","в день","встретились","два войска","и Аллах","над","всякой","вещью","властен"]],[8,42,["إِذۡ","أَنتُم","بِٱلۡعُدۡوَةِ","ٱلدُّنۡيَا","وَهُم","بِٱلۡعُدۡوَةِ","ٱلۡقُصۡوَىٰ","وَٱلرَّكۡبُ","أَسۡفَلَ","مِنكُمۡۚ","وَلَوۡ","تَوَاعَدتُّمۡ","لَٱخۡتَلَفۡتُمۡ","فِي","ٱلۡمِيعَٰدِ","وَلَٰكِن","لِّيَقۡضِيَ","ٱللَّهُ","أَمۡرٗا","كَانَ","مَفۡعُولٗا","لِّيَهۡلِكَ","مَنۡ","هَلَكَ","عَنۢ","بَيِّنَةٖ","وَيَحۡيَىٰ","مَنۡ","حَيَّ","عَنۢ","بَيِّنَةٖۗ","وَإِنَّ","ٱللَّهَ","لَسَمِيعٌ","عَلِيمٌ"],"из антум бил`удватид дунйа вахум бил`удватил ḳусва варракбу асфала минкум валау тава`адттум лахталафтум фил мии`ади валакил лийаḳдийаллаху амран кана маф`уулал лийахлика ман халака `ам баййинатин вайахйа ман хаййа `ам баййинатин ва'инналлаха ласамии`ун `алиим","Вот вы находились на ближней стороне долины, они - на дальней стороне, а караван был ниже вас. Если бы вы условились, то разошлись бы во времени и месте. Однако все произошло так, чтобы Аллах довел до конца дело, которое уже было свершившимся, дабы погиб тот, кто погиб при полной ясности, и дабы выжил тот, кто выжил при полной ясности. Воистину, Аллах - Слышащий, Знающий.",["вот","вы","на склоне","ближнем","а они","на склоне","дальнем","а караван","ниже","вас","и если бы","вы условились","непременно разошлись бы вы","в","уговоре","но","чтобы завершил","Аллах","дело","которое было","свершившимся","чтобы погиб","тот, кто","погиб","по","ясному доводу","и жил","тот, кто","жив","по","ясному доводу","и поистине","Аллах","непременно Слышащий","Знающий"]],[8,43,["إِذۡ","يُرِيكَهُمُ","ٱللَّهُ","فِي","مَنَامِكَ","قَلِيلٗاۖ","وَلَوۡ","أَرَىٰكَهُمۡ","كَثِيرٗا","لَّفَشِلۡتُمۡ","وَلَتَنَٰزَعۡتُمۡ","فِي","ٱلۡأَمۡرِ","وَلَٰكِنَّ","ٱللَّهَ","سَلَّمَۚ","إِنَّهُۥ","عَلِيمُۢ","بِذَاتِ","ٱلصُّدُورِ"],"из йуриикахумуллаху фии манамика ḳалиилан валау аракахум касиирал лафашилтум валатаназа`тум фил амри валакинналлаха саллама иннахуу `алииму бизатис судуур","Вот Аллах показал их тебе во сне малочисленными. Если бы Он показал тебе их многочисленными, то вы пали бы духом и стали бы препираться при принятии решения. Однако Аллах уберег вас, ибо Он знает о том, что в груди.",["вот","показал тебе их","Аллах","в","твоём сне","малочисленными","а если бы","Он показал тебе их","многочисленными","непременно вы пали бы духом","и непременно препирались бы","в","деле","но","Аллах","уберёг","поистине, Он","Знающий","о том, что в","груди"]],[8,44,["وَإِذۡ","يُرِيكُمُوهُمۡ","إِذِ","ٱلۡتَقَيۡتُمۡ","فِيٓ","أَعۡيُنِكُمۡ","قَلِيلٗا","وَيُقَلِّلُكُمۡ","فِيٓ","أَعۡيُنِهِمۡ","لِيَقۡضِيَ","ٱللَّهُ","أَمۡرٗا","كَانَ","مَفۡعُولٗاۗ","وَإِلَى","ٱللَّهِ","تُرۡجَعُ","ٱلۡأُمُورُ"],"ва'из йуриикумуухум изил таḳайтум фии а`йуникум ḳалиилан вайуḳаллилукум фии а`йунихим лийаḳдийаллаху амран кана маф`уулан ва'илаллахи туржа`ул умуур","Вот Аллах, когда вы встретились, показал их вашим глазам малочисленными, и вас показал их глазам малочисленными, чтобы довести до конца дело, которое уже было свершившимся. Воистину, дела возвращаются к Аллаху.",["и вот","Он показал вам их","когда","вы встретились","в","ваших глазах","малочисленными","и уменьшил вас","в","их глазах","чтобы завершил","Аллах","дело","которое было","свершённым","и к","Аллаху","возвращаются","дела"]],[8,45,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُوٓاْ","إِذَا","لَقِيتُمۡ","فِئَةٗ","فَٱثۡبُتُواْ","وَٱذۡكُرُواْ","ٱللَّهَ","كَثِيرٗا","لَّعَلَّكُمۡ","تُفۡلِحُونَ"],"йа'аййухал лазиина амануу иза лаḳиитум фи'атан фасбутуу вазкуруллаха касиирал ла`аллакум туфлихуун","О те, которые уверовали! Когда вы сталкиваетесь с отрядом, то будьте стойки и многократно поминайте Аллаха, - быть может, вы преуспеете.",["о","те, которые","уверовали","когда","вы встретите","отряд","то будьте стойки","и поминайте","Аллаха","много","чтобы вы","преуспели"]]],"m":[[["۞ وَٱعۡلَمُوٓاْ","и знайте",8,41],["أَنَّمَا","что то, что",8,41],["غَنِمۡتُم","вы взяли трофеем",8,41],["مِّن","из",8,41],["شَيۡءٖ","чего-либо",8,41],["فَأَنَّ","то",8,41],["لِلَّهِ","Аллаху",8,41],["خُمُسَهُۥ","пятая часть его",8,41],["وَلِلرَّسُولِ","и Посланнику",8,41]],[["وَلِذِي","и обладающим",8,41],["ٱلۡقُرۡبَىٰ","родством",8,41],["وَٱلۡيَتَٰمَىٰ","и сиротам",8,41],["وَٱلۡمَسَٰكِينِ","и беднякам",8,41],["وَٱبۡنِ","и сыну",8,41],["ٱلسَّبِيلِ","пути",8,41],["إِن","если",8,41]],[["كُنتُمۡ","вы",8,41],["ءَامَنتُم","уверовали",8,41],["بِٱللَّهِ","в Аллаха",8,41],["وَمَآ","и в то, что",8,41],["أَنزَلۡنَا","Мы ниспослали",8,41],["عَلَىٰ","на",8,41],["عَبۡدِنَا","Нашего раба",8,41],["يَوۡمَ","в день",8,41],["ٱلۡفُرۡقَانِ","различения",8,41]],[["يَوۡمَ","в день",8,41],["ٱلۡتَقَى","встретились",8,41],["ٱلۡجَمۡعَانِۗ","два войска",8,41],["وَٱللَّهُ","и Аллах",8,41],["عَلَىٰ","над",8,41],["كُلِّ","всякой",8,41],["شَيۡءٖ","вещью",8,41],["قَدِيرٌ","властен",8,41],[41],["إِذۡ","вот",8,42]],[["أَنتُم","вы",8,42],["بِٱلۡعُدۡوَةِ","на склоне",8,42],["ٱلدُّنۡيَا","ближнем",8,42],["وَهُم","а они",8,42],["بِٱلۡعُدۡوَةِ","на склоне",8,42],["ٱلۡقُصۡوَىٰ","дальнем",8,42],["وَٱلرَّكۡبُ","а караван",8,42]],[["أَسۡفَلَ","ниже",8,42],["مِنكُمۡۚ","вас",8,42],["وَلَوۡ","и если бы",8,42],["تَوَاعَدتُّمۡ","вы условились",8,42],["لَٱخۡتَلَفۡتُمۡ","непременно разошлись бы вы",8,42],["فِي","в",8,42],["ٱلۡمِيعَٰدِ","уговоре",8,42]],[["وَلَٰكِن","но",8,42],["لِّيَقۡضِيَ","чтобы завершил",8,42],["ٱللَّهُ","Аллах",8,42],["أَمۡرٗا","дело",8,42],["كَانَ","которое было",8,42],["مَفۡعُولٗا","свершившимся",8,42],["لِّيَهۡلِكَ","чтобы погиб",8,42],["مَنۡ","тот, кто",8,42]],[["هَلَكَ","погиб",8,42],["عَنۢ","по",8,42],["بَيِّنَةٖ","ясному доводу",8,42],["وَيَحۡيَىٰ","и жил",8,42],["مَنۡ","тот, кто",8,42],["حَيَّ","жив",8,42],["عَنۢ","по",8,42],["بَيِّنَةٖۗ","ясному доводу",8,42],["وَإِنَّ","и поистине",8,42],["ٱللَّهَ","Аллах",8,42]],[["لَسَمِيعٌ","непременно Слышащий",8,42],["عَلِيمٌ","Знающий",8,42],[42],["إِذۡ","вот",8,43],["يُرِيكَهُمُ","показал тебе их",8,43],["ٱللَّهُ","Аллах",8,43],["فِي","в",8,43],["مَنَامِكَ","твоём сне",8,43],["قَلِيلٗاۖ","малочисленными",8,43]],[["وَلَوۡ","а если бы",8,43],["أَرَىٰكَهُمۡ","Он показал тебе их",8,43],["كَثِيرٗا","многочисленными",8,43],["لَّفَشِلۡتُمۡ","непременно вы пали бы духом",8,43],["وَلَتَنَٰزَعۡتُمۡ","и непременно препирались бы",8,43],["فِي","в",8,43],["ٱلۡأَمۡرِ","деле",8,43]],[["وَلَٰكِنَّ","но",8,43],["ٱللَّهَ","Аллах",8,43],["سَلَّمَۚ","уберёг",8,43],["إِنَّهُۥ","поистине, Он",8,43],["عَلِيمُۢ","Знающий",8,43],["بِذَاتِ","о том, что в",8,43],["ٱلصُّدُورِ","груди",8,43],[43],["وَإِذۡ","и вот",8,44]],[["يُرِيكُمُوهُمۡ","Он показал вам их",8,44],["إِذِ","когда",8,44],["ٱلۡتَقَيۡتُمۡ","вы встретились",8,44],["فِيٓ","в",8,44],["أَعۡيُنِكُمۡ","ваших глазах",8,44],["قَلِيلٗا","малочисленными",8,44],["وَيُقَلِّلُكُمۡ","и уменьшил вас",8,44]],[["فِيٓ","в",8,44],["أَعۡيُنِهِمۡ","их глазах",8,44],["لِيَقۡضِيَ","чтобы завершил",8,44],["ٱللَّهُ","Аллах",8,44],["أَمۡرٗا","дело",8,44],["كَانَ","которое было",8,44],["مَفۡعُولٗاۗ","свершённым",8,44],["وَإِلَى","и к",8,44],["ٱللَّهِ","Аллаху",8,44]],[["تُرۡجَعُ","возвращаются",8,44],["ٱلۡأُمُورُ","дела",8,44],[44],["يَٰٓأَيُّهَا","о",8,45],["ٱلَّذِينَ","те, которые",8,45],["ءَامَنُوٓاْ","уверовали",8,45],["إِذَا","когда",8,45],["لَقِيتُمۡ","вы встретите",8,45],["فِئَةٗ","отряд",8,45]],[["فَٱثۡبُتُواْ","то будьте стойки",8,45],["وَٱذۡكُرُواْ","и поминайте",8,45],["ٱللَّهَ","Аллаха",8,45],["كَثِيرٗا","много",8,45],["لَّعَلَّكُمۡ","чтобы вы",8,45],["تُفۡلِحُونَ","преуспели",8,45],[45]]]}