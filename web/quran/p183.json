{"p":183,"j":10,"a":[[8,46,["وَأَطِيعُواْ","ٱللَّهَ","وَرَسُولَهُۥ","وَلَا","تَنَٰزَعُواْ","فَتَفۡشَلُواْ","وَتَذۡهَبَ","رِيحُكُمۡۖ","وَٱصۡبِرُوٓاْۚ","إِنَّ","ٱللَّهَ","مَعَ","ٱلصَّٰبِرِينَ"],"ва'атии`уллаха варасуулахуу вала таназа`уу фатафшалуу ватазхаба риихукум васбируу инналлаха ма`ас сабириин","Повинуйтесь Аллаху и Его Посланнику и не препирайтесь, а не то вы падете духом и лишитесь сил. Будьте терпеливы, ибо Аллах - с терпеливыми.",["и повинуйтесь","Аллаху","и Его Посланнику","и не","препирайтесь","а то падёте духом","и уйдёт","ваша сила","и терпите","поистине","Аллах","с","терпеливыми"]],[8,47,["وَلَا","تَكُونُواْ","كَٱلَّذِينَ","خَرَجُواْ","مِن","دِيَٰرِهِم","بَطَرٗا","وَرِئَآءَ","ٱلنَّاسِ","وَيَصُدُّونَ","عَن","سَبِيلِ","ٱللَّهِۚ","وَٱللَّهُ","بِمَا","يَعۡمَلُونَ","مُحِيطٞ"],"вала такуунуу каллазиина харажуу мин дийарихим батаран вариаан наси вайасуддууна `ан сабиилиллахи валлаху бима йа`малууна мухиит","Не уподобляйтесь тем, которые горделиво вышли из своих домов, показывая себя перед людьми, и сбивали других с пути Аллаха. Аллах объемлет все, что они совершают.",["и не","будьте","как те, которые","вышли","из","своих жилищ","горделиво","и напоказ","людям","и отвращают","от","пути","Аллаха","а Аллах","то, что","они делают","объемлет"]],[8,48,["وَإِذۡ","زَيَّنَ","لَهُمُ","ٱلشَّيۡطَٰنُ","أَعۡمَٰلَهُمۡ","وَقَالَ","لَا","غَالِبَ","لَكُمُ","ٱلۡيَوۡمَ","مِنَ","ٱلنَّاسِ","وَإِنِّي","جَارٞ","لَّكُمۡۖ","فَلَمَّا","تَرَآءَتِ","ٱلۡفِئَتَانِ","نَكَصَ","عَلَىٰ","عَقِبَيۡهِ","وَقَالَ","إِنِّي","بَرِيٓءٞ","مِّنكُمۡ","إِنِّيٓ","أَرَىٰ","مَا","لَا","تَرَوۡنَ","إِنِّيٓ","أَخَافُ","ٱللَّهَۚ","وَٱللَّهُ","شَدِيدُ","ٱلۡعِقَابِ"],"ва'из заййана лахумуш шайтану а`малахум ваḳала ла галиба лакумул йаума минан наси ва'иннии жарул лакум фаламма тараатил фиатани накаса `ала `аḳибайхи ваḳала иннии барииум минкум иннии ара ма ла тарауна иннии ахафуллаха валлаху шадиидул `иḳаб","Вот дьявол приукрасил для них их деяния и сказал: «Сегодня никто из людей не одолеет вас. Воистину, я буду по соседству». Но когда два отряда увидели друг друга, он повернул вспять и сказал: «Я не причастен к вам. Воистину, я вижу то, чего вы не видите. Я боюсь Аллаха, ведь Аллах суров в наказании».",["и вот","приукрасил","для них","шайтан","их деяния","и сказал","нет","одолевающего","вас","сегодня","из","людей","и поистине, я","защитник","вам","когда же","увидели друг друга","два отряда","он повернул назад","на","своих пятках","и сказал","поистине, я","непричастен","к вам","поистине, я","вижу","то, что","не","вы видите","поистине, я","боюсь","Аллаха","а Аллах","суров","в наказании"]],[8,49,["إِذۡ","يَقُولُ","ٱلۡمُنَٰفِقُونَ","وَٱلَّذِينَ","فِي","قُلُوبِهِم","مَّرَضٌ","غَرَّ","هَٰٓؤُلَآءِ","دِينُهُمۡۗ","وَمَن","يَتَوَكَّلۡ","عَلَى","ٱللَّهِ","فَإِنَّ","ٱللَّهَ","عَزِيزٌ","حَكِيمٞ"],"из йаḳуулул мунафиḳууна валлазиина фии ḳулуубихим марадун гарра ха'улаи диинухум ваман йатаваккал `алаллахи фа'инналлаха `азиизун хакиим","Вот лицемеры и те, чьи сердца были поражены недугом, сказали: «Эти люди обмануты своей религией». Но если кто уповает на Аллаха, то ведь Аллах - Могущественный, Мудрый.",["вот","говорят","лицемеры","и те, которые","в","их сердцах","болезнь","обманула","этих","их религия","а кто","уповает","на","Аллаха","то поистине","Аллах","Могущественный","Мудрый"]],[8,50,["وَلَوۡ","تَرَىٰٓ","إِذۡ","يَتَوَفَّى","ٱلَّذِينَ","كَفَرُواْ","ٱلۡمَلَٰٓئِكَةُ","يَضۡرِبُونَ","وُجُوهَهُمۡ","وَأَدۡبَٰرَهُمۡ","وَذُوقُواْ","عَذَابَ","ٱلۡحَرِيقِ"],"валау тара из йатаваффал лазиина кафарул малаикату йадрибууна вужуухахум ва'адбарахум вазууḳуу `азабал харииḳ","Если бы ты видел, как ангелы умерщвляют неверующих. Они бьют их по лицу и по спинам со словами: «Вкусите мучения от обжигающего Огня!",["и если бы","ты видел","как","умерщвляют","тех, которые","не уверовали","ангелы","бьют","их лица","и их спины","и вкусите","наказание","обжигающего Огня"]],[8,51,["ذَٰلِكَ","بِمَا","قَدَّمَتۡ","أَيۡدِيكُمۡ","وَأَنَّ","ٱللَّهَ","لَيۡسَ","بِظَلَّٰمٖ","لِّلۡعَبِيدِ"],"залика бима ḳаддамат айдиикум ва'анналлаха лайса бизалламил лил`абиид","Это - за то, что приготовили ваши руки. Воистину, Аллах не поступает несправедливо с рабами».",["это","за то, что","приготовили","ваши руки","и что","Аллах","не","несправедлив","к рабам"]],[8,52,["كَدَأۡبِ","ءَالِ","فِرۡعَوۡنَ","وَٱلَّذِينَ","مِن","قَبۡلِهِمۡۚ","كَفَرُواْ","بِـَٔايَٰتِ","ٱللَّهِ","فَأَخَذَهُمُ","ٱللَّهُ","بِذُنُوبِهِمۡۚ","إِنَّ","ٱللَّهَ","قَوِيّٞ","شَدِيدُ","ٱلۡعِقَابِ"],"када'би али фир`ауна валлазиина мин ḳаблихим кафаруу би'айатиллахи фа'ахазахумуллаху бизунуубихим инналлаха ḳавиййун шадиидул `иḳаб","Так же поступали род Фараона и те, которые жили до них. Они не уверовали в знамения Аллаха, и Аллах схватил их за грехи. Воистину, Аллах силен и суров в наказании.",["подобно обычаю","рода","Фараона","и тех, которые","из","до них","не уверовали","в знамения","Аллаха","и схватил их","Аллах","за их грехи","поистине","Аллах","Сильный","суров","в наказании"]]],"m":[[["وَأَطِيعُواْ","и повинуйтесь",8,46],["ٱللَّهَ","Аллаху",8,46],["وَرَسُولَهُۥ","и Его Посланнику",8,46],["وَلَا","и не",8,46],["تَنَٰزَعُواْ","препирайтесь",8,46],["فَتَفۡشَلُواْ","а то падёте духом",8,46],["وَتَذۡهَبَ","и уйдёт",8,46],["رِيحُكُمۡۖ","ваша сила",8,46]],[["وَٱصۡبِرُوٓاْۚ","и терпите",8,46],["إِنَّ","поистине",8,46],["ٱللَّهَ","Аллах",8,46],["مَعَ","с",8,46],["ٱلصَّٰبِرِينَ","терпеливыми",8,46],[46],["وَلَا","и не",8,47],["تَكُونُواْ","будьте",8,47],["كَٱلَّذِينَ","как те, которые",8,47]],[["خَرَجُواْ","вышли",8,47],["مِن","из",8,47],["دِيَٰرِهِم","своих жилищ",8,47],["بَطَرٗا","горделиво",8,47],["وَرِئَآءَ","и напоказ",8,47],["ٱلنَّاسِ","людям",8,47],["وَيَصُدُّونَ","и отвращают",8,47]],[["عَن","от",8,47],["سَبِيلِ","пути",8,47],["ٱللَّهِۚ","Аллаха",8,47],["وَٱللَّهُ","а Аллах",8,47],["بِمَا","то, что",8,47],["يَعۡمَلُونَ","они делают",8,47],["مُحِيطٞ","объемлет",8,47],[47],["وَإِذۡ","и вот",8,48],["زَيَّنَ","приукрасил",8,48],["لَهُمُ","для них",8,48]],[["ٱلشَّيۡطَٰنُ","шайтан",8,48],["أَعۡمَٰلَهُمۡ","их деяния",8,48],["وَقَالَ","и сказал",8,48],["لَا","нет",8,48],["غَالِبَ","одолевающего",8,48],["لَكُمُ","вас",8,48],["ٱلۡيَوۡمَ","сегодня",8,48],["مِنَ","из",8,48]],[["ٱلنَّاسِ","людей",8,48],["وَإِنِّي","и поистине, я",8,48],["جَارٞ","защитник",8,48],["لَّكُمۡۖ","вам",8,48],["فَلَمَّا","когда же",8,48],["تَرَآءَتِ","увидели друг друга",8,48],["ٱلۡفِئَتَانِ","два отряда",8,48],["نَكَصَ","он повернул назад",8,48]],[["عَلَىٰ","на",8,48],["عَقِبَيۡهِ","своих пятках",8,48],["وَقَالَ","и сказал",8,48],["إِنِّي","поистине, я",8,48],["بَرِيٓءٞ","непричастен",8,48],["مِّنكُمۡ","к вам",8,48],["إِنِّيٓ","поистине, я",8,48],["أَرَىٰ","вижу",8,48],["مَا","то, что",8,48],["لَا","не",8,48],["تَرَوۡنَ","вы видите",8,48]],[["إِنِّيٓ","поистине, я",8,48],["أَخَافُ","боюсь",8,48],["ٱللَّهَۚ","Аллаха",8,48],["وَٱللَّهُ","а Аллах",8,48],["شَدِيدُ","суров",8,48],["ٱلۡعِقَابِ","в наказании",8,48],[48],["إِذۡ","вот",8,49],["يَقُولُ","говорят",8,49]],[["ٱلۡمُنَٰفِقُونَ","лицемеры",8,49],["وَٱلَّذِينَ","и те, которые",8,49],["فِي","в",8,49],["قُلُوبِهِم","их сердцах",8,49],["مَّرَضٌ","болезнь",8,49],["غَرَّ","обманула",8,49],["هَٰٓؤُلَآءِ","этих",8,49],["دِينُهُمۡۗ","их религия",8,49]],[["وَمَن","а кто",8,49],["يَتَوَكَّلۡ","уповает",8,49],["عَلَى","на",8,49],["ٱللَّهِ","Аллаха",8,49],["فَإِنَّ","то поистине",8,49],["ٱللَّهَ","Аллах",8,49],["عَزِيزٌ","Могущественный",8,49],["حَكِيمٞ","Мудрый",8,49],[49]],[["وَلَوۡ","и если бы",8,50],["تَرَىٰٓ","ты видел",8,50],["إِذۡ","как",8,50],["يَتَوَفَّى","умерщвляют",8,50],["ٱلَّذِينَ","тех, которые",8,50],["كَفَرُواْ","не уверовали",8,50],["ٱلۡمَلَٰٓئِكَةُ","ангелы",8,50],["يَضۡرِبُونَ","бьют",8,50]],[["وُجُوهَهُمۡ","их лица",8,50],["وَأَدۡبَٰرَهُمۡ","и их спины",8,50],["وَذُوقُواْ","и вкусите",8,50],["عَذَابَ","наказание",8,50],["ٱلۡحَرِيقِ","обжигающего Огня",8,50],[50],["ذَٰلِكَ","это",8,51]],[["بِمَا","за то, что",8,51],["قَدَّمَتۡ","приготовили",8,51],["أَيۡدِيكُمۡ","ваши руки",8,51],["وَأَنَّ","и что",8,51],["ٱللَّهَ","Аллах",8,51],["لَيۡسَ","не",8,51],["بِظَلَّٰمٖ","несп