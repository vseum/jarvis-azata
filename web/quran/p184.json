{"p":184,"j":10,"a":[[8,53,["ذَٰلِكَ","بِأَنَّ","ٱللَّهَ","لَمۡ","يَكُ","مُغَيِّرٗا","نِّعۡمَةً","أَنۡعَمَهَا","عَلَىٰ","قَوۡمٍ","حَتَّىٰ","يُغَيِّرُواْ","مَا","بِأَنفُسِهِمۡ","وَأَنَّ","ٱللَّهَ","سَمِيعٌ","عَلِيمٞ"],"залика би'анналлаха лам йаку мугаййиран ни`матан ан`амаха `ала ḳаумин хатта йугаййируу ма би'анфусихим ва'анналлаха самии`ун `алиим","Это произошло потому, что Аллах не отменяет милость, которую Он оказал людям, пока они сами не изменяют того, что в их душах. Воистину, Аллах - Слышащий, Знающий.",["это","потому что","Аллах","не","был","изменяющим","милость","которую Он оказал","к","народу","пока","(не) изменят","то, что","в них самих","и что","Аллах","Слышащий","Знающий"]],[8,54,["كَدَأۡبِ","ءَالِ","فِرۡعَوۡنَ","وَٱلَّذِينَ","مِن","قَبۡلِهِمۡۚ","كَذَّبُواْ","بِـَٔايَٰتِ","رَبِّهِمۡ","فَأَهۡلَكۡنَٰهُم","بِذُنُوبِهِمۡ","وَأَغۡرَقۡنَآ","ءَالَ","فِرۡعَوۡنَۚ","وَكُلّٞ","كَانُواْ","ظَٰلِمِينَ"],"када'би али фир`ауна валлазиина мин ḳаблихим каззабуу би'айати раббихим фа'ахлакнахум бизунуубихим ва'аграḳна ала фир`ауна вакуллун кануу залимиин","Таким же образом поступали род Фараона и те, которые жили до них. Они не уверовали в знамения своего Господа, и Мы погубили их за грехи и потопили род Фараона. Все они были беззаконниками.",["подобно обычаю","рода","Фараона","и тех, которые","из","до них","сочли ложью","знамения","их Господа","и Мы погубили их","за их грехи","и Мы потопили","род","Фараона","и все","были","беззаконниками"]],[8,55,["إِنَّ","شَرَّ","ٱلدَّوَآبِّ","عِندَ","ٱللَّهِ","ٱلَّذِينَ","كَفَرُواْ","فَهُمۡ","لَا","يُؤۡمِنُونَ"],"инна шаррад давабби `индаллахил лазиина кафаруу фахум ла йу'минуун","Воистину, наихудшими из живых существ перед Аллахом являются те, которые не уверовали и не уверуют.",["поистине","худшие","из тварей","у","Аллаха","те, которые","не уверовали","и они","не","уверуют"]],[8,56,["ٱلَّذِينَ","عَٰهَدتَّ","مِنۡهُمۡ","ثُمَّ","يَنقُضُونَ","عَهۡدَهُمۡ","فِي","كُلِّ","مَرَّةٖ","وَهُمۡ","لَا","يَتَّقُونَ"],"аллазиина `ахадтта минхум сумма йанḳудууна `ахдахум фии кулли марратин вахум ла йаттаḳуун","Ты заключаешь с ними договор, но всякий раз они нарушают этот договор и не страшатся.",["те, с которыми","ты заключил договор","из них","затем","нарушают","свой договор","в","каждый","раз","и они","не","боятся (Аллаха)"]],[8,57,["فَإِمَّا","تَثۡقَفَنَّهُمۡ","فِي","ٱلۡحَرۡبِ","فَشَرِّدۡ","بِهِم","مَّنۡ","خَلۡفَهُمۡ","لَعَلَّهُمۡ","يَذَّكَّرُونَ"],"фа'имма тасḳафаннахум фил харби фашаррид бихим ман халфахум ла`аллахум йаззаккаруун","Если ты встретишься с ними в битве, то покарай их сурово, дабы рассеять тех, кто позади них, - быть может, они помянут назидание.",["и если","ты настигнешь их","на","войне","то рассей","ими","тех, кто","позади них","чтобы они","помянули (назидание)"]],[8,58,["وَإِمَّا","تَخَافَنَّ","مِن","قَوۡمٍ","خِيَانَةٗ","فَٱنۢبِذۡ","إِلَيۡهِمۡ","عَلَىٰ","سَوَآءٍۚ","إِنَّ","ٱللَّهَ","لَا","يُحِبُّ","ٱلۡخَآئِنِينَ"],"ва'имма тахафанна мин ḳаумин хийанатан фамбиз илайхим `ала саваин инналлаха ла йухиббул хаиниин","А если ты опасаешься измены со стороны людей, то отбрось договорные обязательства, чтобы все оказались равны. Воистину, Аллах не любит изменников.",["а если","ты опасаешься","со стороны","людей","измены","то отбрось","им","на","равных (условиях)","поистине","Аллах","не","любит","изменников"]],[8,59,["وَلَا","يَحۡسَبَنَّ","ٱلَّذِينَ","كَفَرُواْ","سَبَقُوٓاْۚ","إِنَّهُمۡ","لَا","يُعۡجِزُونَ"],"вала йахсабаннал лазиина кафаруу сабаḳуу иннахум ла йу`жизуун","Пусть не думают неверующие, что они опередят других. Воистину, им не сбежать.",["и пусть не","думают","те, которые","не уверовали","что опередили","поистине, они","не","ускользнут (от Аллаха)"]],[8,60,["وَأَعِدُّواْ","لَهُم","مَّا","ٱسۡتَطَعۡتُم","مِّن","قُوَّةٖ","وَمِن","رِّبَاطِ","ٱلۡخَيۡلِ","تُرۡهِبُونَ","بِهِۦ","عَدُوَّ","ٱللَّهِ","وَعَدُوَّكُمۡ","وَءَاخَرِينَ","مِن","دُونِهِمۡ","لَا","تَعۡلَمُونَهُمُ","ٱللَّهُ","يَعۡلَمُهُمۡۚ","وَمَا","تُنفِقُواْ","مِن","شَيۡءٖ","فِي","سَبِيلِ","ٱللَّهِ","يُوَفَّ","إِلَيۡكُمۡ","وَأَنتُمۡ","لَا","تُظۡلَمُونَ"],"ва'а`иддуу лахум мастата`тум ммин ḳувватин вамир рибатил хайли турхибууна бихии `адувваллахи ва`адуввакум ва'ахариина мин дуунихим ла та`ламуунахумуллаху йа`ламухум вама тунфиḳуу мин шай'ин фии сабиилиллахи йуаффа илайкум ва'антум ла тузламуун","Приготовьте против них сколько можете силы и боевых коней, чтобы устрашить врага Аллаха и вашего врага, а также тех, которых вы не знаете, но которых знает Аллах. Что бы вы ни израсходовали на пути Аллаха, вам будет возвращено сполна, и с вами не поступят несправедливо.",["и приготовьте","против них","сколько","вы можете","из","силы","и из","привязанных","коней","устрашая","этим","врага","Аллаха","и вашего врага","и других","из","помимо них","не","вы знаете их","Аллах","знает их","и что бы","вы ни израсходовали","из","чего-либо","на","пути","Аллаха","будет возмещено сполна","вам","и вы","не","будете обижены"]],[8,61,["وَإِن","جَنَحُواْ","لِلسَّلۡمِ","فَٱجۡنَحۡ","لَهَا","وَتَوَكَّلۡ","عَلَى","ٱللَّهِۚ","إِنَّهُۥ","هُوَ","ٱلسَّمِيعُ","ٱلۡعَلِيمُ"],"ва'ин жанахуу лиссалми фажнах лаха ватаваккал `алаллахи иннахуу хуас самии`ул `алиим","Если они склоняются к миру, ты тоже склоняйся к миру и уповай на Аллаха. Воистину, Он - Слышащий, Знающий.",["и если","они склонятся","к миру","то склонись","к нему","и уповай","на","Аллаха","поистине, Он","Он","Слышащий","Знающий"]]],"m":[[["ذَٰلِكَ","это",8,53],["بِأَنَّ","потому что",8,53],["ٱللَّهَ","Аллах",8,53],["لَمۡ","не",8,53],["يَكُ","был",8,53],["مُغَيِّرٗا","изменяющим",8,53],["نِّعۡمَةً","милость",8,53],["أَنۡعَمَهَا","которую Он оказал",8,53],["عَلَىٰ","к",8,53],["قَوۡمٍ","народу",8,53],["حَتَّىٰ","пока",8,53],["يُغَيِّرُواْ","(не) изменят",8,53]],[["مَا","то, что",8,53],["بِأَنفُسِهِمۡ","в них самих",8,53],["وَأَنَّ","и что",8,53],["ٱللَّهَ","Аллах",8,53],["سَمِيعٌ","Слышащий",8,53],["عَلِيمٞ","Знающий",8,53],[53],["كَدَأۡبِ","подобно обычаю",8,54],["ءَالِ","рода",8,54]],[["فِرۡعَوۡنَ","Фараона",8,54],["وَٱلَّذِينَ","и тех, которые",8,54],["مِن","из",8,54],["قَبۡلِهِمۡۚ","до них",8,54],["كَذَّبُواْ","сочли ложью",8,54],["بِـَٔايَٰتِ","знамения",8,54],["رَبِّهِمۡ","их Господа",8,54],["فَأَهۡلَكۡنَٰهُم","и Мы погубили их",8,54]],[["بِذُنُوبِهِمۡ","за их грехи",8,54],["وَأَغۡرَقۡنَآ","и Мы потопили",8,54],["ءَالَ","род",8,54],["فِرۡعَوۡنَۚ","Фараона",8,54],["وَكُلّٞ","и все",8,54],["كَانُواْ","были",8,54],["ظَٰلِمِينَ","беззаконниками",8,54],[54]],[["إِنَّ","поистине",8,55],["شَرَّ","худшие",8,55],["ٱلدَّوَآبِّ","из тварей",8,55],["عِندَ","у",8,55],["ٱللَّهِ","Аллаха",8,55],["ٱلَّذِينَ","те, которые",8,55],["كَفَرُواْ","не уверовали",8,55],["فَهُمۡ","и они",8,55],["لَا","не",8,55],["يُؤۡمِنُونَ","уверуют",8,55],[55]],[["ٱلَّذِينَ","те, с которыми",8,56],["عَٰهَدتَّ","ты заключил договор",8,56],["مِنۡهُمۡ","из них",8,56],["ثُمَّ","затем",8,56],["يَنقُضُونَ","нарушают",8,56],["عَهۡدَهُمۡ","свой договор",8,56],["فِي","в",8,56],["كُلِّ","каждый",8,56],["مَرَّةٖ","раз",8,56]],[["وَهُمۡ","и они",8,56],["لَا","не",8,56],["يَتَّقُونَ","боятся (Аллаха)",8,56],[56],["فَإِمَّا","и если",8,57],["تَثۡقَفَنَّهُمۡ","ты настигнешь их",8,57],["فِي","на",8,57],["ٱلۡحَرۡبِ","войне",8,57],["فَشَرِّدۡ","то рассей",8,57],["بِهِم","ими",8,57]],[["مَّنۡ","тех, кто",8,57],["خَلۡفَهُمۡ","позади них",8,57],["لَعَلَّهُمۡ","чтобы они",8,57],["يَذَّكَّرُونَ","помянули (назидание)",8,57],[57],["وَإِمَّا","а если",8,58],["تَخَافَنَّ","ты опасаешься",8,58],["مِن","со стороны",8,58]],[["قَوۡمٍ","людей",8,58],["خِيَانَةٗ","измены",8,58],["فَٱنۢبِذۡ","то отбрось",8,58],["إِلَيۡهِمۡ","им",8,58],["عَلَىٰ","на",8,58],["سَوَآءٍۚ","равных (условиях)",8,58],["إِنَّ","поистине",8,58],["ٱللَّهَ","Аллах",8,58],["لَا","не",8,58],["يُحِبُّ","любит",8,58],["ٱلۡخَآئِنِينَ","изменников",8,58]],[[58],["وَلَا","и пусть не",8,59],["يَحۡسَبَنَّ","думают",8,59],["ٱلَّذِينَ","те, которые",8,59],["كَفَرُواْ","не уверовали",8,59],["سَبَقُوٓاْۚ","что опередили",8,59],["إِنَّهُمۡ","поистине, они",8,59],["لَا","не",8,59],["يُعۡجِزُونَ","ускользнут (от Аллаха)",8,59],[59]],[["وَأَعِدُّواْ","и приготовьте",8,60],["لَهُم","против них",8,60],["مَّا","сколько",8,60],["ٱسۡتَطَعۡتُم","вы можете",8,60],["مِّن","из",8,60],["قُوَّةٖ","силы",8,60],["وَمِن","и из",8,60],["رِّبَاطِ","привязанных",8,60],["ٱلۡخَيۡلِ","коней",8,60]],[["تُرۡهِبُونَ","устрашая",8,60],["بِهِۦ","этим",8,60],["عَدُوَّ","врага",8,60],["ٱللَّهِ","Аллаха",8,60],["وَعَدُوَّكُمۡ","и вашего врага",8,60],["وَءَاخَرِينَ","и других",8,60],["مِن","из",8,60],["دُونِهِمۡ","помимо них",8,60]],[["لَا","не",8,60],["تَعۡلَمُونَهُمُ","вы знаете их",8,60],["ٱللَّهُ","Аллах",8,60],["يَعۡلَمُهُمۡۚ","знает их",8,60],["وَمَا","и что бы",8,60],["تُنفِقُواْ","вы ни израсходовали",8,60],["مِن","из",8,60],["شَيۡءٖ","чего-либо",8,60],["فِي","на",8,60],["سَبِيلِ","пути",8,60]],[["ٱللَّهِ","Аллаха",8,60],["يُوَفَّ","будет возмещено сполна",8,60],["إِلَيۡكُمۡ","вам",8,60],["وَأَنتُمۡ","и вы",8,60],["لَا","не",8,60],["تُظۡلَمُونَ","будете обижены",8,60],[60],["۞ وَإِن","и если",8,61],["جَنَحُواْ","они склонятся",8,61]],[["لِلسَّلۡمِ","к миру",8,61],["فَٱجۡنَحۡ","то склонись",8,61],["لَهَا","к нему",8,61],["وَتَوَكَّلۡ","и уповай",8,61],["عَلَى","на",8,61],["ٱللَّهِۚ","Аллаха",8,61],["إِنَّهُۥ","поистине, Он",8,61],["هُوَ","Он",8,61],["ٱلسَّمِيعُ","Слышащий",8,61],["ٱلۡعَلِيمُ","Знающий",8,61],[61]]]}