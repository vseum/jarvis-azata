{"p":185,"j":10,"a":[[8,62,["وَإِن","يُرِيدُوٓاْ","أَن","يَخۡدَعُوكَ","فَإِنَّ","حَسۡبَكَ","ٱللَّهُۚ","هُوَ","ٱلَّذِيٓ","أَيَّدَكَ","بِنَصۡرِهِۦ","وَبِٱلۡمُؤۡمِنِينَ"],"ва'ин йуриидуу ан йахда`уука фа'инна хасбакаллаху хуал лазии аййадака бинасрихии вабилму'миниин","Если же они захотят обмануть тебя, то тебе достаточно Аллаха. Он поддержал тебя Своей помощью и верующими.",["а если","они захотят","(чтобы)","обмануть тебя","то поистине","достаточно тебе","Аллаха","Он","Тот, который","поддержал тебя","Своей помощью","и верующими"]],[8,63,["وَأَلَّفَ","بَيۡنَ","قُلُوبِهِمۡۚ","لَوۡ","أَنفَقۡتَ","مَا","فِي","ٱلۡأَرۡضِ","جَمِيعٗا","مَّآ","أَلَّفۡتَ","بَيۡنَ","قُلُوبِهِمۡ","وَلَٰكِنَّ","ٱللَّهَ","أَلَّفَ","بَيۡنَهُمۡۚ","إِنَّهُۥ","عَزِيزٌ","حَكِيمٞ"],"ва'аллафа байна ḳулуубихим лау анфаḳта ма фил арди жамии`ам ма аллафта байна ḳулуубихим валакинналлаха аллафа байнахум иннахуу `азиизун хакиим","Он сплотил их сердца. Если бы ты израсходовал все, что есть на земле, то не смог бы сплотить их сердца, однако Аллах сплотил их. Воистину, Он - Могущественный, Мудрый.",["и Он сплотил","между","их сердцами","если бы","ты израсходовал","то, что","на","земле","всё","не","сплотил бы ты","между","их сердцами","но","Аллах","сплотил","между ними","поистине, Он","Могущественный","Мудрый"]],[8,64,["يَٰٓأَيُّهَا","ٱلنَّبِيُّ","حَسۡبُكَ","ٱللَّهُ","وَمَنِ","ٱتَّبَعَكَ","مِنَ","ٱلۡمُؤۡمِنِينَ"],"йа'аййухан набиййу хасбукаллаху ваманиттаба`ака минал му'миниин","О Пророк! Тебе и твоим верующим последователям довольно Аллаха.",["о","Пророк","достаточно тебе","Аллаха","и тем, кто","последовал за тобой","из","верующих"]],[8,65,["يَٰٓأَيُّهَا","ٱلنَّبِيُّ","حَرِّضِ","ٱلۡمُؤۡمِنِينَ","عَلَى","ٱلۡقِتَالِۚ","إِن","يَكُن","مِّنكُمۡ","عِشۡرُونَ","صَٰبِرُونَ","يَغۡلِبُواْ","مِاْئَتَيۡنِۚ","وَإِن","يَكُن","مِّنكُم","مِّاْئَةٞ","يَغۡلِبُوٓاْ","أَلۡفٗا","مِّنَ","ٱلَّذِينَ","كَفَرُواْ","بِأَنَّهُمۡ","قَوۡمٞ","لَّا","يَفۡقَهُونَ"],"йа'аййухан набиййу харридил му'миниина `алал ḳитали ин йакум минкум `ишрууна сабирууна йаглибуу миатайни ва'ин йакум минкум миатун йаглибуу алфам минал лазиина кафаруу би'аннахум ḳаумул ла йафḳахуун","О Пророк! Вдохновляй верующих на сражение. Если будет среди вас двадцать терпеливых, то они одолеют две сотни; если же их среди вас будет сотня, то они одолеют тысячу неверующих, потому что они - люди неразумные.",["о","Пророк","побуждай","верующих","к","сражению","если","будет","среди вас","двадцать","терпеливых","они одолеют","двести","и если","будет","среди вас","сотня","они одолеют","тысячу","из","тех, которые","не уверовали","потому что они","люди","не","понимают"]],[8,66,["ٱلۡـَٰٔنَ","خَفَّفَ","ٱللَّهُ","عَنكُمۡ","وَعَلِمَ","أَنَّ","فِيكُمۡ","ضَعۡفٗاۚ","فَإِن","يَكُن","مِّنكُم","مِّاْئَةٞ","صَابِرَةٞ","يَغۡلِبُواْ","مِاْئَتَيۡنِۚ","وَإِن","يَكُن","مِّنكُمۡ","أَلۡفٞ","يَغۡلِبُوٓاْ","أَلۡفَيۡنِ","بِإِذۡنِ","ٱللَّهِۗ","وَٱللَّهُ","مَعَ","ٱلصَّٰبِرِينَ"],"ал'ана хаффафаллаху `анкум ва`алима анна фиикум да`фан фа'ин йакум минкум миатун сабиратун йаглибуу миатайни ва'ин йакум минкум алфун йаглибуу алфайни би'изниллахи валлаху ма`ас сабириин","Теперь Аллах облегчил ваше бремя, ибо Ему известно, что вы слабы. Если среди вас будет сто терпеливых, то они одолеют две сотни; если же их среди вас будет тысяча, то с позволения Аллаха они одолеют две тысячи. Воистину, Аллах - с терпеливыми.",["теперь","облегчил","Аллах","вам","и Он знает","что","в вас","слабость","и если","будет","среди вас","сотня","терпеливых","они одолеют","двести","и если","будет","среди вас","тысяча","они одолеют","две тысячи","с позволения","Аллаха","и Аллах","с","терпеливыми"]],[8,67,["مَا","كَانَ","لِنَبِيٍّ","أَن","يَكُونَ","لَهُۥٓ","أَسۡرَىٰ","حَتَّىٰ","يُثۡخِنَ","فِي","ٱلۡأَرۡضِۚ","تُرِيدُونَ","عَرَضَ","ٱلدُّنۡيَا","وَٱللَّهُ","يُرِيدُ","ٱلۡأٓخِرَةَۗ","وَٱللَّهُ","عَزِيزٌ","حَكِيمٞ"],"ма кана линабиййин ан йакууна лахуу асра хатта йусхина фил арди туриидууна `арадад дунйа валлаху йуриидул ахирата валлаху `азиизун хакиим","Не подобало Пророку брать пленных, пока он не пролил кровь на земле. Вы желаете мирских благ, но Аллах желает Последней жизни. Аллах - Могущественный, Мудрый.",["не","подобало","пророку","чтобы","были","у него","пленные","пока","он не разгромит (врага)","на","земле","вы желаете","благ","мирской жизни","а Аллах","желает","Последней жизни","и Аллах","Могущественный","Мудрый"]],[8,68,["لَّوۡلَا","كِتَٰبٞ","مِّنَ","ٱللَّهِ","سَبَقَ","لَمَسَّكُمۡ","فِيمَآ","أَخَذۡتُمۡ","عَذَابٌ","عَظِيمٞ"],"ллаула китабум миналлахи сабаḳа ламассакум фиима ахазтум `азабун `азиим","Если бы не было предварительного предписания от Аллаха, то вас постигли бы великие мучения за то, что вы взяли.",["если бы не","предписание","от","Аллаха","предшествовавшее","непременно постигло бы вас","за то, что","вы взяли","наказание","великое"]],[8,69,["فَكُلُواْ","مِمَّا","غَنِمۡتُمۡ","حَلَٰلٗا","طَيِّبٗاۚ","وَٱتَّقُواْ","ٱللَّهَۚ","إِنَّ","ٱللَّهَ","غَفُورٞ","رَّحِيمٞ"],"факулуу мимма ганимтум халалан таййибан ваттаḳуллаха инналлаха гафуурур рахиим","Вкушайте то, что вы захватили дозволенным и честным путем, и бойтесь Аллаха. Воистину, Аллах - Прощающий, Милосердный.",["так ешьте","из того, что","вы взяли в добычу","дозволенным","благим","и бойтесь","Аллаха","поистине","Аллах","Прощающий","Милосердный"]]],"m":[[["وَإِن","а если",8,62],["يُرِيدُوٓاْ","они захотят",8,62],["أَن","(чтобы)",8,62],["يَخۡدَعُوكَ","обмануть тебя",8,62],["فَإِنَّ","то поистине",8,62],["حَسۡبَكَ","достаточно тебе",8,62],["ٱللَّهُۚ","Аллаха",8,62],["هُوَ","Он",8,62],["ٱلَّذِيٓ","Тот, который",8,62],["أَيَّدَكَ","поддержал тебя",8,62]],[["بِنَصۡرِهِۦ","Своей помощью",8,62],["وَبِٱلۡمُؤۡمِنِينَ","и верующими",8,62],[62],["وَأَلَّفَ","и Он сплотил",8,63],["بَيۡنَ","между",8,63],["قُلُوبِهِمۡۚ","их сердцами",8,63],["لَوۡ","если бы",8,63],["أَنفَقۡتَ","ты израсходовал",8,63]],[["مَا","то, что",8,63],["فِي","на",8,63],["ٱلۡأَرۡضِ","земле",8,63],["جَمِيعٗا","всё",8,63],["مَّآ","не",8,63],["أَلَّفۡتَ","сплотил бы ты",8,63],["بَيۡنَ","между",8,63],["قُلُوبِهِمۡ","их сердцами",8,63],["وَلَٰكِنَّ"