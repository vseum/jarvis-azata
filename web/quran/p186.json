{"p":186,"j":10,"a":[[8,70,["يَٰٓأَيُّهَا","ٱلنَّبِيُّ","قُل","لِّمَن","فِيٓ","أَيۡدِيكُم","مِّنَ","ٱلۡأَسۡرَىٰٓ","إِن","يَعۡلَمِ","ٱللَّهُ","فِي","قُلُوبِكُمۡ","خَيۡرٗا","يُؤۡتِكُمۡ","خَيۡرٗا","مِّمَّآ","أُخِذَ","مِنكُمۡ","وَيَغۡفِرۡ","لَكُمۡۚ","وَٱللَّهُ","غَفُورٞ","رَّحِيمٞ"],"йа'аййухан набиййу ḳул лиман фии айдиикум минал асра ин йа`ламиллаху фии ḳулуубикум хайран йу'тикум хайрам мимма ухиза минкум вайагфир лакум валлаху гафуурур рахиим","О Пророк! Скажи пленникам, которые находятся в ваших руках: «Если Аллаху известно, что в ваших сердцах есть добро, то Он дарует вам нечто лучшее, чем отобранное у вас, и простит вас. Воистину, Аллах - Прощающий, Милосердный.",["о","Пророк","скажи","тем, кто","в","ваших руках","из","пленных","если","знает","Аллах","в","ваших сердцах","добро","Он даст вам","лучшее","чем то, что","было взято","у вас","и Он простит","вам","и Аллах","Прощающий","Милосердный"]],[8,71,["وَإِن","يُرِيدُواْ","خِيَانَتَكَ","فَقَدۡ","خَانُواْ","ٱللَّهَ","مِن","قَبۡلُ","فَأَمۡكَنَ","مِنۡهُمۡۗ","وَٱللَّهُ","عَلِيمٌ","حَكِيمٌ"],"ва'ин йуриидуу хийанатака фаḳад хануллаха мин ḳаблу фа'амкана минхум валлаху `алиимун хакиим","Но если они захотят предать тебя, то ведь еще раньше они предали Аллаха, и Он отдал их во власть мусульманам. Аллах - Знающий, Мудрый.",["а если","они захотят","предать тебя","то уже","они предали","Аллаха","ещё","прежде","и Он дал власть","над ними","и Аллах","Знающий","Мудрый"]],[8,72,["إِنَّ","ٱلَّذِينَ","ءَامَنُواْ","وَهَاجَرُواْ","وَجَٰهَدُواْ","بِأَمۡوَٰلِهِمۡ","وَأَنفُسِهِمۡ","فِي","سَبِيلِ","ٱللَّهِ","وَٱلَّذِينَ","ءَاوَواْ","وَّنَصَرُوٓاْ","أُوْلَٰٓئِكَ","بَعۡضُهُمۡ","أَوۡلِيَآءُ","بَعۡضٖۚ","وَٱلَّذِينَ","ءَامَنُواْ","وَلَمۡ","يُهَاجِرُواْ","مَا","لَكُم","مِّن","وَلَٰيَتِهِم","مِّن","شَيۡءٍ","حَتَّىٰ","يُهَاجِرُواْۚ","وَإِنِ","ٱسۡتَنصَرُوكُمۡ","فِي","ٱلدِّينِ","فَعَلَيۡكُمُ","ٱلنَّصۡرُ","إِلَّا","عَلَىٰ","قَوۡمِۭ","بَيۡنَكُمۡ","وَبَيۡنَهُم","مِّيثَٰقٞۗ","وَٱللَّهُ","بِمَا","تَعۡمَلُونَ","بَصِيرٞ"],"иннал лазиина амануу вахажаруу важахадуу би'амвалихим ва'анфусихим фии сабиилиллахи валлазиина авав ванасаруу улаика ба`духум аулийау ба`дин валлазиина амануу валам йухажируу ма лакум мин валайатихим мин шай'ин хатта йухажируу ва'инистансаруукум фид диини фа`алайкумун насру илла `ала ḳауми байнакум вабайнахум миисаḳун валлаху бима та`малууна басиир","Воистину, те, которые уверовали, совершили переселение и сражались своим имуществом и своими жизнями на пути Аллаха, а также те, которые дали убежище мухаджирам и оказали помощь, являются помощниками и друзьями друг другу. Если же люди уверовали, но не совершили переселения, то вы не обязаны защищать их, пока они не совершат переселения. Если они попросят вас о помощи в делах религии, то вы должны помочь, если только эта помощь не направлена против народа, с которым вы заключили договор. Аллах видит то, что вы совершаете.",["поистине","те, которые","уверовали","и переселились","и сражались","своим имуществом","и своими душами","на","пути","Аллаха","и те, которые","дали убежище","и помогли","те","одни из них","союзники","других","а те, которые","уверовали","и не","переселились","нет","у вас","(никакого)","покровительства им","ни в","чём","пока","не переселятся","а если","они попросят у вас помощи","в","религии","то на вас","помощь","кроме как","против","людей","между вами","и между ними","договор","и Аллах","то, что","вы делаете","Видящий"]],[8,73,["وَٱلَّذِينَ","كَفَرُواْ","بَعۡضُهُمۡ","أَوۡلِيَآءُ","بَعۡضٍۚ","إِلَّا","تَفۡعَلُوهُ","تَكُن","فِتۡنَةٞ","فِي","ٱلۡأَرۡضِ","وَفَسَادٞ","كَبِيرٞ"],"валлазиина кафаруу ба`духум аулийау ба`дин илла таф`алууху такун фитнатун фил арди вафасадун кабиир","Неверующие являются помощниками и друзьями друг другу. И если вы не будете поступать таким образом (если верующие не будут помощниками и друзьями друг другу), то на земле возникнут смута и великое беззаконие.",["и те, которые","не уверовали","одни из них","союзники","других","если не","вы сделаете это","будет","смута","на","земле","и порча","великая"]],[8,74,["وَٱلَّذِينَ","ءَامَنُواْ","وَهَاجَرُواْ","وَجَٰهَدُواْ","فِي","سَبِيلِ","ٱللَّهِ","وَٱلَّذِينَ","ءَاوَواْ","وَّنَصَرُوٓاْ","أُوْلَٰٓئِكَ","هُمُ","ٱلۡمُؤۡمِنُونَ","حَقّٗاۚ","لَّهُم","مَّغۡفِرَةٞ","وَرِزۡقٞ","كَرِيمٞ"],"валлазиина амануу вахажаруу важахадуу фии сабиилиллахи валлазиина авав ванасаруу улаика хумул му'минууна хаḳḳал лахум магфиратун варизḳун кариим","Те, которые уверовали, совершили переселение и сражались на пути Аллаха, а также те, которые дали убежище и оказали им помощь, являются истинно верующими. Им уготованы прощение и щедрый удел.",["и те, которые","уверовали","и переселились","и сражались","на","пути","Аллаха","и те, которые","дали убежище","и помогли","те","они","верующие","истинно","для них","прощение","и удел","щедрый"]],[8,75,["وَٱلَّذِينَ","ءَامَنُواْ","مِنۢ","بَعۡدُ","وَهَاجَرُواْ","وَجَٰهَدُواْ","مَعَكُمۡ","فَأُوْلَٰٓئِكَ","مِنكُمۡۚ","وَأُوْلُواْ","ٱلۡأَرۡحَامِ","بَعۡضُهُمۡ","أَوۡلَىٰ","بِبَعۡضٖ","فِي","كِتَٰبِ","ٱللَّهِۚ","إِنَّ","ٱللَّهَ","بِكُلِّ","شَيۡءٍ","عَلِيمُۢ"],"валлазиина амануу мим ба`ду вахажаруу важахадуу ма`акум фа'улаика минкум ва'улул архами ба`духум аула биба`дин фии китабиллахи инналлаха бикулли шай'ин `алиим","Те, которые уверовали впоследствии, совершили переселение и сражались вместе с вами, являются одними из вас. Однако родственники ближе друг к другу. Таково предписание Аллаха. Воистину, Аллах ведает о всякой вещи.",["и те, которые","уверовали","после","(этого)","и переселились","и сражались","вместе с вами","то те","из вас","а обладающие","родством","одни из них","ближе","к другим","в","Писании","Аллаха","поистине","Аллах","о всякой","вещи","Знающий"]]],"m":[[["يَٰٓأَيُّهَا","о",8,70],["ٱلنَّبِيُّ","Пророк",8,70],["قُل","скажи",8,70],["لِّمَن","тем, кто",8,70],["فِيٓ","в",8,70],["أَيۡدِيكُم","ваших руках",8,70],["مِّنَ","из",8,70],["ٱلۡأَسۡرَىٰٓ","пленных",8,70],["إِن","если",8,70],["يَعۡلَمِ","знает",8,70],["ٱللَّهُ","Аллах",8,70]],[["فِي","в",8,70],["قُلُوبِكُمۡ","ваших сердцах",8,70],["خَيۡرٗا","добро",8,70],[