{"p":187,"j":10,"a":[[9,1,["بَرَآءَةٞ","مِّنَ","ٱللَّهِ","وَرَسُولِهِۦٓ","إِلَى","ٱلَّذِينَ","عَٰهَدتُّم","مِّنَ","ٱلۡمُشۡرِكِينَ"],"бараатум миналлахи варасуулихии илал лазиина `ахадттум минал мушрикиин","Аллах и Его Посланник освобождены от договоров, которые вы заключили с многобожниками.",["непричастность","от","Аллаха","и Его Посланника","к","тем, с которыми","вы заключили договор","из","многобожников"]],[9,2,["فَسِيحُواْ","فِي","ٱلۡأَرۡضِ","أَرۡبَعَةَ","أَشۡهُرٖ","وَٱعۡلَمُوٓاْ","أَنَّكُمۡ","غَيۡرُ","مُعۡجِزِي","ٱللَّهِ","وَأَنَّ","ٱللَّهَ","مُخۡزِي","ٱلۡكَٰفِرِينَ"],"фасиихуу фил арди арба`ата ашхурин ва`ламуу аннакум гайру му`жизиллахи ва'анналлаха мухзил кафириин","Посему странствуйте по земле в течение четырех месяцев и знайте, что вам (многобожникам) не сбежать от Аллаха и что Аллах опозорит неверующих.",["так странствуйте","по","земле","четыре","месяца","и знайте","что вы","не","ускользнёте от","Аллаха","и что","Аллах","опозорит","неверующих"]],[9,3,["وَأَذَٰنٞ","مِّنَ","ٱللَّهِ","وَرَسُولِهِۦٓ","إِلَى","ٱلنَّاسِ","يَوۡمَ","ٱلۡحَجِّ","ٱلۡأَكۡبَرِ","أَنَّ","ٱللَّهَ","بَرِيٓءٞ","مِّنَ","ٱلۡمُشۡرِكِينَ","وَرَسُولُهُۥۚ","فَإِن","تُبۡتُمۡ","فَهُوَ","خَيۡرٞ","لَّكُمۡۖ","وَإِن","تَوَلَّيۡتُمۡ","فَٱعۡلَمُوٓاْ","أَنَّكُمۡ","غَيۡرُ","مُعۡجِزِي","ٱللَّهِۗ","وَبَشِّرِ","ٱلَّذِينَ","كَفَرُواْ","بِعَذَابٍ","أَلِيمٍ"],"ва'азанум миналлахи варасуулихии илан наси йаумал хажжил акбари анналлаха барииум минал мушрикиина варасуулухуу фа'ин тубтум фахуа хайрул лакум ва'ин таваллайтум фа`ламуу аннакум гайру му`жизиллахи вабашширил лазиина кафаруу би`азабин алиим","В день великого паломничества Аллах и Его Посланник объявят людям о том, что Аллах и Его Посланник отрекаются от многобожников. Если вы раскаетесь, то тем лучше для вас. Если же вы отвернетесь, то знайте, что вам не сбежать от Аллаха. Обрадуй же вестью о мучительных страданиях неверующих.",["и объявление","от","Аллаха","и Его Посланника","к","людям","в день","паломничества","великого","что","Аллах","непричастен","к","многобожникам","и Его Посланник","и если","вы покаетесь","то это","лучше","для вас","а если","вы отвернётесь","то знайте","что вы","не","ускользнёте от","Аллаха","и обрадуй","тех, которые","не уверовали","наказанием","мучительным"]],[9,4,["إِلَّا","ٱلَّذِينَ","عَٰهَدتُّم","مِّنَ","ٱلۡمُشۡرِكِينَ","ثُمَّ","لَمۡ","يَنقُصُوكُمۡ","شَيۡـٔٗا","وَلَمۡ","يُظَٰهِرُواْ","عَلَيۡكُمۡ","أَحَدٗا","فَأَتِمُّوٓاْ","إِلَيۡهِمۡ","عَهۡدَهُمۡ","إِلَىٰ","مُدَّتِهِمۡۚ","إِنَّ","ٱللَّهَ","يُحِبُّ","ٱلۡمُتَّقِينَ"],"иллал лазиина `ахадттум минал мушрикиина сумма лам йанḳусуукум шай'ан валам йузахируу `алайкум ахадан фа'атиммуу илайхим `ахдахум ила муддатихим инналлаха йухиббул муттаḳиин","Это не относится к тем многобожникам, с которыми вы заключили договор и которые после этого ни в чем его не нарушили и никому не помогали против вас. Соблюдайте же договор с ними до истечения его срока. Воистину, Аллах любит богобоязненных.",["кроме","тех, с которыми","вы заключили договор","из","многобожников","затем","не","ущемили вас","ни в чём","и не","помогали","против вас","никому","то соблюдайте сполна","с ними","их договор","до","их срока","поистине","Аллах","любит","богобоязненных"]],[9,5,["فَإِذَا","ٱنسَلَخَ","ٱلۡأَشۡهُرُ","ٱلۡحُرُمُ","فَٱقۡتُلُواْ","ٱلۡمُشۡرِكِينَ","حَيۡثُ","وَجَدتُّمُوهُمۡ","وَخُذُوهُمۡ","وَٱحۡصُرُوهُمۡ","وَٱقۡعُدُواْ","لَهُمۡ","كُلَّ","مَرۡصَدٖۚ","فَإِن","تَابُواْ","وَأَقَامُواْ","ٱلصَّلَوٰةَ","وَءَاتَوُاْ","ٱلزَّكَوٰةَ","فَخَلُّواْ","سَبِيلَهُمۡۚ","إِنَّ","ٱللَّهَ","غَفُورٞ","رَّحِيمٞ"],"фа'изансалахал ашхурул хуруму фаḳтулул мушрикиина хайсу важадттумуухум вахузуухум вахсуруухум ваḳ`удуу лахум кулла марсадин фа'ин табуу ва'аḳамус салавата ва'атавуз закавата фахаллуу сабиилахум инналлаха гафуурур рахиим","Когда же завершатся запретные месяцы, то убивайте многобожников, где бы вы их ни обнаружили, берите их в плен, осаждайте их и устраивайте для них любую засаду. Если же они раскаются и станут совершать намаз и выплачивать закят, то отпустите их, ибо Аллах - Прощающий, Милосердный.",["а когда","завершатся","месяцы","запретные","то убивайте","многобожников","где бы","вы ни нашли их","и хватайте их","и осаждайте их","и сидите (в засаде)","на них","у каждой","засады","но если","они покаются","и установят","намаз","и дадут","закят","то освободите","им путь","поистине","Аллах","Прощающий","Милосердный"]],[9,6,["وَإِنۡ","أَحَدٞ","مِّنَ","ٱلۡمُشۡرِكِينَ","ٱسۡتَجَارَكَ","فَأَجِرۡهُ","حَتَّىٰ","يَسۡمَعَ","كَلَٰمَ","ٱللَّهِ","ثُمَّ","أَبۡلِغۡهُ","مَأۡمَنَهُۥۚ","ذَٰلِكَ","بِأَنَّهُمۡ","قَوۡمٞ","لَّا","يَعۡلَمُونَ"],"ва'ин ахадум минал мушрикиинастажарака фа'ажирху хатта йасма`а каламаллахи сумма аблигху ма'манахуу залика би'аннахум ḳаумул ла йа`ламуун","Если же какой-либо многобожник попросит у тебя убежища, то предоставь ему убежище, чтобы он мог услышать Слово Аллаха. Затем доставь его в безопасное место, потому что они - невежественные люди.",["и если","кто-либо","из","многобожников","попросит у тебя защиты","то защити его","чтобы","он услышал","слово","Аллаха","затем","доставь его","в его безопасное место","это","потому что они","люди","не","знают"]]],"m":[["h",9],[["بَرَآءَةٞ","непричастность",9,1],["مِّنَ","от",9,1],["ٱللَّهِ","Аллаха",9,1],["وَرَسُولِهِۦٓ","и Его Посланника",9,1],["إِلَى","к",9,1],["ٱلَّذِينَ","тем, с которыми",9,1],["عَٰهَدتُّم","вы заключили договор",9,1],["مِّنَ","из",9,1],["ٱلۡمُشۡرِكِينَ","многобожников",9,1],[1]],[["فَسِيحُواْ","так странствуйте",9,2],["فِي","по",9,2],["ٱلۡأَرۡضِ","земле",9,2],["أَرۡبَعَةَ","четыре",9,2],["أَشۡهُرٖ","месяца",9,2],["وَٱعۡلَمُوٓاْ","и знайте",9,2],["أَنَّكُمۡ","что вы",9,2],["غَيۡرُ","не",9,2],["مُعۡجِزِي","ускользнёте от",9,2]],[["ٱللَّهِ","Аллаха",9,2],["وَأَنَّ","и что",9,2],["ٱللَّهَ","Аллах",9,2],["مُخۡزِي","опозорит",9,2],["ٱلۡكَٰفِرِينَ","неверующих",9,2],[2],["وَأَذَٰنٞ","и объявление",9,3],["مِّنَ","от",9,3],["ٱللَّهِ","Аллаха",9,3],["وَرَسُولِهِۦٓ","и Его Посланника",9,3]],[["إِلَى","к",9,3],["ٱلنَّاسِ","людям",9,3],["يَوۡمَ","в день",9,3],["ٱلۡحَجِّ","паломничества",9,3],["ٱلۡأَكۡبَرِ","великого",9,3],["أَنَّ","что",9,3],["ٱللَّهَ","Аллах",9,3],["بَرِيٓءٞ","непричастен",9,3],["مِّنَ","к",9,3],["ٱلۡمُشۡرِكِينَ","многобожникам",9,3]],[["وَرَسُولُهُۥۚ","и Его Посланник",9,3],["فَإِن","и если",9,3],["تُبۡتُمۡ","вы покаетесь",9,3],["فَهُوَ","то это",9,3],["خَيۡرٞ","лучше",9,3],["لَّكُمۡۖ","для вас",9,3],["وَإِن","а если",9,3],["تَوَلَّيۡتُمۡ","вы отвернётесь",9,3],["فَٱعۡلَمُوٓاْ","то знайте",9,3]],[["أَنَّكُمۡ","что вы",9,3],["غَيۡرُ","не",9,3],["مُعۡجِزِي","ускользнёте от",9,3],["ٱللَّهِۗ","Аллаха",9,3],["وَبَشِّرِ","и обрадуй",9,3],["ٱلَّذِينَ","тех, которые",9,3],["كَفَرُواْ","не уверовали",9,3],["بِعَذَابٍ","наказанием",9,3],["أَلِيمٍ","мучительным",9,3]],[[3],["إِلَّا","кроме",9,4],["ٱلَّذِينَ","тех, с которыми",9,4],["عَٰهَدتُّم","вы заключили договор",9,4],["مِّنَ","из",9,4],["ٱلۡمُشۡرِكِينَ","многобожников",9,4],["ثُمَّ","затем",9,4],["لَمۡ","не",9,4],["يَنقُصُوكُمۡ","ущемили вас",9,4]],[["شَيۡـٔٗا","ни в чём",9,4],["وَلَمۡ","и не",9,4],["يُظَٰهِرُواْ","помогали",9,4],["عَلَيۡكُمۡ","против вас",9,4],["أَحَدٗا","никому",9,4],["فَأَتِمُّوٓاْ","то соблюдайте сполна",9,4],["إِلَيۡهِمۡ","с ними",9,4],["عَهۡدَهُمۡ","их договор",9,4],["إِلَىٰ","до",9,4]],[["مُدَّتِهِمۡۚ","их срока",9,4],["إِنَّ","поистине",9,4],["ٱللَّهَ","Аллах",9,4],["يُحِبُّ","любит",9,4],["ٱلۡمُتَّقِينَ","богобоязненных",9,4],[4],["فَإِذَا","а когда",9,5],["ٱنسَلَخَ","завершатся",9,5],["ٱلۡأَشۡهُرُ","месяцы",9,5],["ٱلۡحُرُمُ","запретные",9,5]],[["فَٱقۡتُلُواْ","то убивайте",9,5],["ٱلۡمُشۡرِكِينَ","многобожников",9,5],["حَيۡثُ","где бы",9,5],["وَجَدتُّمُوهُمۡ","вы ни нашли их",9,5],["وَخُذُوهُمۡ","и хватайте их",9,5],["وَٱحۡصُرُوهُمۡ","и осаждайте их",9,5]],[["وَٱقۡعُدُواْ","и сидите (в засаде)",9,5],["لَهُمۡ","на них",9,5],["كُلَّ","у каждой",9,5],["مَرۡصَدٖۚ","засады",9,5],["فَإِن","но если",9,5],["تَابُواْ","они покаются",9,5],["وَأَقَامُواْ","и установят",9,5],["ٱلصَّلَوٰةَ","намаз",9,5]],[["وَءَاتَوُاْ","и дадут",9,5],["ٱلزَّكَوٰةَ","закят",9,5],["فَخَلُّواْ","то освободите",9,5],["سَبِيلَهُمۡۚ","им путь",9,5],["إِنَّ","поистине",9,5],["ٱللَّهَ","Аллах",9,5],["غَفُورٞ","Прощающий",9,5],["رَّحِيمٞ","Милосердный",9,5],[5]],[["وَإِنۡ","и если",9,6],["أَحَدٞ","кто-либо",9,6],["مِّنَ","из",9,6],["ٱلۡمُشۡرِكِينَ","многобожников",9,6],["ٱسۡتَجَارَكَ","попросит у тебя защиты",9,6],["فَأَجِرۡهُ","то защити его",9,6],["حَتَّىٰ","чтобы",9,6],["يَسۡمَعَ","он услышал",9,6]],[["كَلَٰمَ","слово",9,6],["ٱللَّهِ","Аллаха",9,6],["ثُمَّ","затем",9,6],["أَبۡلِغۡهُ","доставь его",9,6],["مَأۡمَنَهُۥۚ","в его безопасное место",9,6],["ذَٰلِكَ","это",9,6],["بِأَنَّهُمۡ","потому что они",9,6],["قَوۡمٞ","люди",9,6],["لَّا","не",9,6],["يَعۡلَمُونَ","знают",9,6],[6]]]}