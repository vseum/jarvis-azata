{"p":188,"j":10,"a":[[9,7,["كَيۡفَ","يَكُونُ","لِلۡمُشۡرِكِينَ","عَهۡدٌ","عِندَ","ٱللَّهِ","وَعِندَ","رَسُولِهِۦٓ","إِلَّا","ٱلَّذِينَ","عَٰهَدتُّمۡ","عِندَ","ٱلۡمَسۡجِدِ","ٱلۡحَرَامِۖ","فَمَا","ٱسۡتَقَٰمُواْ","لَكُمۡ","فَٱسۡتَقِيمُواْ","لَهُمۡۚ","إِنَّ","ٱللَّهَ","يُحِبُّ","ٱلۡمُتَّقِينَ"],"кайфа йакууну лилмушрикиина `ахдун `индаллахи ва`инда расуулихии иллал лазиина `ахадттум `индал масжидил харами фамастаḳамуу лакум фастаḳиимуу лахум инналлаха йухиббул муттаḳиин","Может ли быть у многобожников договор с Аллахом и Его Посланником, не считая тех, с которыми вы заключили договор у Заповедной мечети? Пока они верны вам, вы также будьте верны им. Воистину, Аллах любит богобоязненных.",["как","может быть","у многобожников","договор","у","Аллаха","и у","Его Посланника","кроме","тех, с которыми","вы заключили договор","у","мечети","Заповедной","и пока","они верны","вам","то будьте верны","им","поистине","Аллах","любит","богобоязненных"]],[9,8,["كَيۡفَ","وَإِن","يَظۡهَرُواْ","عَلَيۡكُمۡ","لَا","يَرۡقُبُواْ","فِيكُمۡ","إِلّٗا","وَلَا","ذِمَّةٗۚ","يُرۡضُونَكُم","بِأَفۡوَٰهِهِمۡ","وَتَأۡبَىٰ","قُلُوبُهُمۡ","وَأَكۡثَرُهُمۡ","فَٰسِقُونَ"],"кайфа ва'ин йазхаруу `алайкум ла йарḳубуу фиикум иллан вала зимматан йурдуунакум би'афвахихим вата'ба ḳулуубухум ва'аксарухум фасиḳуун","Какой там (какой договор может быть с многобожниками)? Если они одолеют вас, то не станут соблюдать перед вами ни родственных, ни договорных обязательств. На словах они пытаются угодить вам, но в сердцах они питают к вам отвращение, ведь большинство их являются нечестивцами.",["как (же)","а если","они одолеют","вас","не","соблюдут","в отношении вас","ни родства","и ни","договора","они угождают вам","своими устами","но отказываются","их сердца","и большинство их","нечестивцы"]],[9,9,["ٱشۡتَرَوۡاْ","بِـَٔايَٰتِ","ٱللَّهِ","ثَمَنٗا","قَلِيلٗا","فَصَدُّواْ","عَن","سَبِيلِهِۦٓۚ","إِنَّهُمۡ","سَآءَ","مَا","كَانُواْ","يَعۡمَلُونَ"],"иштарау би'айатиллахи саманан ḳалиилан фасаддуу `ан сабиилихии иннахум саа ма кануу йа`малуун","Они продавали знамения Аллаха за ничтожную цену и сбивали других с Его пути. Как же отвратительны их деяния!",["они променяли","знамения","Аллаха","на цену","малую","и отвратили","от","Его пути","поистине, они","скверно","то, что","они","делали"]],[9,10,["لَا","يَرۡقُبُونَ","فِي","مُؤۡمِنٍ","إِلّٗا","وَلَا","ذِمَّةٗۚ","وَأُوْلَٰٓئِكَ","هُمُ","ٱلۡمُعۡتَدُونَ"],"ла йарḳубууна фии му'минин иллан вала зимматан ва'улаика хумул му`тадуун","Они не соблюдают по отношению к верующим ни родственных, ни договорных обязательств. Они - преступники!",["не","соблюдают","в отношении","верующего","ни родства","и ни","договора","и те","они","преступники"]],[9,11,["فَإِن","تَابُواْ","وَأَقَامُواْ","ٱلصَّلَوٰةَ","وَءَاتَوُاْ","ٱلزَّكَوٰةَ","فَإِخۡوَٰنُكُمۡ","فِي","ٱلدِّينِۗ","وَنُفَصِّلُ","ٱلۡأٓيَٰتِ","لِقَوۡمٖ","يَعۡلَمُونَ"],"фа'ин табуу ва'аḳамус салавата ва'атавуз закавата фа'ихванукум фид диини вануфассилул айати лиḳаумин йа`ламуун","Но если они раскаются и будут совершать намаз и выплачивать закят, то они станут вашими братьями по вере. Мы разъясняем Наши знамения для людей знающих.",["но если","они покаются","и установят","намаз","и дадут","закят","то они ваши братья","в","религии","и Мы разъясняем","знамения","для людей","которые знают"]],[9,12,["وَإِن","نَّكَثُوٓاْ","أَيۡمَٰنَهُم","مِّنۢ","بَعۡدِ","عَهۡدِهِمۡ","وَطَعَنُواْ","فِي","دِينِكُمۡ","فَقَٰتِلُوٓاْ","أَئِمَّةَ","ٱلۡكُفۡرِ","إِنَّهُمۡ","لَآ","أَيۡمَٰنَ","لَهُمۡ","لَعَلَّهُمۡ","يَنتَهُونَ"],"ва'ин накасуу айманахум мим ба`ди `ахдихим вата`ануу фии дииникум фаḳатилуу а'имматал куфри иннахум ла аймана лахум ла`аллахум йантахуун","Если же они нарушат свои клятвы после заключения договора и станут посягать на вашу религию, то сражайтесь с предводителями неверия, ибо для них нет клятв. Быть может, тогда они прекратят.",["а если","они нарушат","свои клятвы","после","(заключения)","их договора","и станут посягать","на","вашу религию","то сражайтесь с","предводителями","неверия","поистине, они","нет","клятв","у них","чтобы они","прекратили"]],[9,13,["أَلَا","تُقَٰتِلُونَ","قَوۡمٗا","نَّكَثُوٓاْ","أَيۡمَٰنَهُمۡ","وَهَمُّواْ","بِإِخۡرَاجِ","ٱلرَّسُولِ","وَهُم","بَدَءُوكُمۡ","أَوَّلَ","مَرَّةٍۚ","أَتَخۡشَوۡنَهُمۡۚ","فَٱللَّهُ","أَحَقُّ","أَن","تَخۡشَوۡهُ","إِن","كُنتُم","مُّؤۡمِنِينَ"],"ала туḳатилууна ḳауман накасуу айманахум вахаммуу би'ихражир расуули вахум бадауукум аввала марратин атахшаунахум фаллаху ахаḳḳу ан тахшауху ин кунтум му'миниин","Неужели вы не сразитесь с людьми, которые нарушили свои клятвы и вознамерились изгнать Посланника? Они начали первыми. Неужели вы боитесь их? Вам надлежит больше бояться Аллаха, если вы являетесь верующими.",["неужели не","вы сразитесь","с людьми","которые нарушили","свои клятвы","и вознамерились","изгнать","Посланника","и они","начали с вами","в первый","раз","неужели вы боитесь их","ведь Аллах","более достоин","чтобы","вы боялись Его","если","вы","верующие"]]],"m":[[["كَيۡفَ","как",9,7],["يَكُونُ","может быть",9,7],["لِلۡمُشۡرِكِينَ","у многобожников",9,7],["عَهۡدٌ","договор",9,7],["عِندَ","у",9,7],["ٱللَّهِ","Аллаха",9,7],["وَعِندَ","и у",9,7]],[["رَسُولِهِۦٓ","Его Посланника",9,7],["إِلَّا","кроме",9,7],["ٱلَّذِينَ","тех, с которыми",9,7],["عَٰهَدتُّمۡ","вы заключили договор",9,7],["عِندَ","у",9,7],["ٱلۡمَسۡجِدِ","мечети",9,7],["ٱلۡحَرَامِۖ","Заповедной",9,7],["فَمَا","и пока",9,7]],[["ٱسۡتَقَٰمُواْ","они верны",9,7],["لَكُمۡ","вам",9,7],["فَٱسۡتَقِيمُواْ","то будьте верны",9,7],["لَهُمۡۚ","им",9,7],["إِنَّ","поистине",9,7],["ٱللَّهَ","Аллах",9,7],["يُحِبُّ","любит",9,7],["ٱلۡمُتَّقِينَ","богобоязненных",9,7]],[[7],["كَيۡفَ","как (же)",9,8],["وَإِن","а если",9,8],["يَظۡهَرُواْ","они одолеют",9,8],["عَلَيۡكُمۡ","вас",9,8],["لَا","не",9,8],["يَرۡقُبُواْ","соблюдут",9,8],["فِيكُمۡ","в отношении вас",9,8],["إِلّٗا","ни родства",9,8]],[["وَلَا","и ни",9,8],["ذِمَّةٗۚ","договора",9,8],["يُرۡضُونَكُم","они угождают вам",9,8],["بِأَفۡوَٰهِهِمۡ","своими устами",9,8],["وَتَأۡبَىٰ","но отказываются",9,8],["قُلُوبُهُمۡ","их сердца",9,8],["وَأَكۡثَرُهُمۡ","и большинство их",9,8]],[["فَٰسِقُونَ","нечестивцы",9,8],[8],["ٱشۡتَرَوۡاْ","они променяли",9,9],["بِـَٔايَٰتِ","знамения",9,9],["ٱللَّهِ","Аллаха",9,9],["ثَمَنٗا","на цену",9,9],["قَلِيلٗا","малую",9,9],["فَصَدُّواْ","и отвратили",9,9]],[["عَن","от",9,9],["سَبِيلِهِۦٓۚ","Его пути",9,9],["إِنَّهُمۡ","поистине, они",9,9],["سَآءَ","скверно",9,9],["مَا","то, что",9,9],["كَانُواْ","они",9,9],["يَعۡمَلُونَ","делали",9,9],[9],["لَا","не",9,10],["يَرۡقُبُونَ","соблюдают",9,10]],[["فِي","в отношении",9,10],["مُؤۡمِنٍ","верующего",9,10],["إِلّٗا","ни родства",9,10],["وَلَا","и ни",9,10],["ذِمَّةٗۚ","договора",9,10],["وَأُوْلَٰٓئِكَ","и те",9,10],["هُمُ","они",9,10],["ٱلۡمُعۡتَدُونَ","преступники",9,10],[10]],[["فَإِن","но если",9,11],["تَابُواْ","они покаются",9,11],["وَأَقَامُواْ","и установят",9,11],["ٱلصَّلَوٰةَ","намаз",9,11],["وَءَاتَوُاْ","и дадут",9,11],["ٱلزَّكَوٰةَ","закят",9,11],["فَإِخۡوَٰنُكُمۡ","то они ваши братья",9,11]],[["فِي","в",9,11],["ٱلدِّينِۗ","религии",9,11],["وَنُفَصِّلُ","и Мы разъясняем",9,11],["ٱلۡأٓيَٰتِ","знамения",9,11],["لِقَوۡمٖ","для людей",9,11],["يَعۡلَمُونَ","которые знают",9,11],[11],["وَإِن","а если",9,12],["نَّكَثُوٓاْ","они нарушат",9,12]],[["أَيۡمَٰنَهُم","свои клятвы",9,12],["مِّنۢ","после",9,12],["بَعۡدِ","(заключения)",9,12],["عَهۡدِهِمۡ","их договора",9,12],["وَطَعَنُواْ","и станут посягать",9,12],["فِي","на",9,12],["دِينِكُمۡ","вашу религию",9,12],["فَقَٰتِلُوٓاْ","то сражайтесь с",9,12]],[["أَئِمَّةَ","предводителями",9,12],["ٱلۡكُفۡرِ","неверия",9,12],["إِنَّهُمۡ","поистине, они",9,12],["لَآ","нет",9,12],["أَيۡمَٰنَ","клятв",9,12],["لَهُمۡ","у них",9,12],["لَعَلَّهُمۡ","чтобы они",9,12],["يَنتَهُونَ","прекратили",9,12]],[[12],["أَلَا","неужели не",9,13],["تُقَٰتِلُونَ","вы сразитесь",9,13],["قَوۡمٗا","с людьми",9,13],["نَّكَثُوٓاْ","которые нарушили",9,13],["أَيۡمَٰنَهُمۡ","свои клятвы",9,13],["وَهَمُّواْ","и вознамерились",9,13]],[["بِإِخۡرَاجِ","изгнать",9,13],["ٱلرَّسُولِ","Посланника",9,13],["وَهُم","и они",9,13],["بَدَءُوكُمۡ","начали с вами",9,13],["أَوَّلَ","в первый",9,13],["مَرَّةٍۚ","раз",9,13]],[["أَتَخۡشَوۡنَهُمۡۚ","неужели вы боитесь их",9,13],["فَٱللَّهُ","ведь Аллах",9,13],["أَحَقُّ","более достоин",9,13],["أَن","чтобы",9,13],["تَخۡشَوۡهُ","вы боялись Его",9,13],["إِن","если",9,13],["كُنتُم","вы",9,13],["مُّؤۡمِنِينَ","верующие",9,13],[13]]]}