{"p":190,"j":10,"a":[[9,21,["يُبَشِّرُهُمۡ","رَبُّهُم","بِرَحۡمَةٖ","مِّنۡهُ","وَرِضۡوَٰنٖ","وَجَنَّٰتٖ","لَّهُمۡ","فِيهَا","نَعِيمٞ","مُّقِيمٌ"],"йубашширухум раббухум бирахматим минху варидванин важаннатил лахум фииха на`иимум муḳиим","Господь обрадует их вестью о Своей милости, Своем довольстве и Райских садах, в которых им уготовано вечное блаженство.",["Радует их вестью","их Господь","о милости","от Него","и довольстве","и садах","для них","в них","блаженство","постоянное"]],[9,22,["خَٰلِدِينَ","فِيهَآ","أَبَدًاۚ","إِنَّ","ٱللَّهَ","عِندَهُۥٓ","أَجۡرٌ","عَظِيمٞ"],"халидиина фииха абадан инналлаха `индахуу ажрун `азиим","Они пребудут в них вечно. Воистину, Аллах вознаграждает великой наградой.",["Вечно пребывающие","в них","навсегда","Поистине","Аллах","у Него","награда","великая"]],[9,23,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُواْ","لَا","تَتَّخِذُوٓاْ","ءَابَآءَكُمۡ","وَإِخۡوَٰنَكُمۡ","أَوۡلِيَآءَ","إِنِ","ٱسۡتَحَبُّواْ","ٱلۡكُفۡرَ","عَلَى","ٱلۡإِيمَٰنِۚ","وَمَن","يَتَوَلَّهُم","مِّنكُمۡ","فَأُوْلَٰٓئِكَ","هُمُ","ٱلظَّٰلِمُونَ"],"йа'аййухал лазиина амануу ла таттахизуу абаакум ва'ихванакум аулийаа инистахаббул куфра `алал иимани ваман йатаваллахум минкум фа'улаика хумуз залимуун","О те, которые уверовали! Не берите своих отцов и братьев себе в помощники и друзья, если они предпочли вере неверие. А те из вас, которые берут их себе в помощники и друзья, являются беззаконниками.",["О","те, которые","уверовали","не","берите","своих отцов","и своих братьев","покровителями","если","они предпочли","неверие","над","верой","А кто","возьмёт их в покровители","из вас","то те","они","несправедливые"]],[9,24,["قُلۡ","إِن","كَانَ","ءَابَآؤُكُمۡ","وَأَبۡنَآؤُكُمۡ","وَإِخۡوَٰنُكُمۡ","وَأَزۡوَٰجُكُمۡ","وَعَشِيرَتُكُمۡ","وَأَمۡوَٰلٌ","ٱقۡتَرَفۡتُمُوهَا","وَتِجَٰرَةٞ","تَخۡشَوۡنَ","كَسَادَهَا","وَمَسَٰكِنُ","تَرۡضَوۡنَهَآ","أَحَبَّ","إِلَيۡكُم","مِّنَ","ٱللَّهِ","وَرَسُولِهِۦ","وَجِهَادٖ","فِي","سَبِيلِهِۦ","فَتَرَبَّصُواْ","حَتَّىٰ","يَأۡتِيَ","ٱللَّهُ","بِأَمۡرِهِۦۗ","وَٱللَّهُ","لَا","يَهۡدِي","ٱلۡقَوۡمَ","ٱلۡفَٰسِقِينَ"],"ḳул ин кана абаукум ва'абнаукум ва'ихванукум ва'азважукум ва`ашииратукум ва'амвалуниḳтарафтумууха ватижаратун тахшауна касадаха вамасакину тардаунаха ахабба илайкум миналлахи варасуулихии важихадин фии сабиилихии фатараббасуу хатта йа'тийаллаху би'амрихии валлаху ла йахдил ḳаумал фасиḳиин","Скажи: «Если ваши отцы, ваши сыновья, ваши братья, ваши супруги, ваши семьи, приобретенное вами имущество, торговля, застоя в которой вы опасаетесь, и жилища, которые вы облюбовали, милее вам, чем Аллах, Его Посланник и борьба на Его пути, то ждите, пока Аллах не придет со Своим велением. Аллах не наставляет на прямой путь нечестивых людей».",["Скажи","если","окажутся","ваши отцы","и ваши сыновья","и ваши братья","и ваши супруги","и ваш род","и имущество","которое вы приобрели","и торговля","вы боитесь","застоя её","и жилища","вы довольны ими","милее","вам","чем","Аллах","и Его Посланник","и борьба","на","Его пути","то ждите","пока","придёт","Аллах","со Своим велением","И Аллах","не","ведёт прямым путём","людей","нечестивых"]],[9,25,["لَقَدۡ","نَصَرَكُمُ","ٱللَّهُ","فِي","مَوَاطِنَ","كَثِيرَةٖ","وَيَوۡمَ","حُنَيۡنٍ","إِذۡ","أَعۡجَبَتۡكُمۡ","كَثۡرَتُكُمۡ","فَلَمۡ","تُغۡنِ","عَنكُمۡ","شَيۡـٔٗا","وَضَاقَتۡ","عَلَيۡكُمُ","ٱلۡأَرۡضُ","بِمَا","رَحُبَتۡ","ثُمَّ","وَلَّيۡتُم","مُّدۡبِرِينَ"],"лаḳад насаракумуллаху фии маватина касииратин вайаума хунайнин из а`жабаткум касратукум фалам тугни `анкум шай'ан вадаḳат `алайкумул арду бима рахубат сумма валлайтум мудбириин","Аллах одарил вас победой во многих местах и в день Хунейна, когда вы радовались своей многочисленности, которая ничем вам не помогла. Земля стала тесной для вас, несмотря на ее просторы, и вы повернули вспять.",["Ведь уже","помог вам","Аллах","в","местах","многих","и в день","Хунайна","когда","восхитило вас","ваше множество","но не","избавило","вас","ни от чего","и стала тесной","для вас","земля","при том, что","была просторна","затем","вы повернули","отступая"]],[9,26,["ثُمَّ","أَنزَلَ","ٱللَّهُ","سَكِينَتَهُۥ","عَلَىٰ","رَسُولِهِۦ","وَعَلَى","ٱلۡمُؤۡمِنِينَ","وَأَنزَلَ","جُنُودٗا","لَّمۡ","تَرَوۡهَا","وَعَذَّبَ","ٱلَّذِينَ","كَفَرُواْۚ","وَذَٰلِكَ","جَزَآءُ","ٱلۡكَٰفِرِينَ"],"сумма анзалаллаху сакиинатахуу `ала расуулихии ва`алал му'миниина ва'анзала жунуудал лам тарауха ва`аззабал лазиина кафаруу вазалика жазаул кафириин","Потом Аллах ниспослал спокойствие Своему Посланнику и верующим, ниспослал воинов, которых вы не видите, и подверг мучениям тех, кто не верует. Таково возмездие неверующим!",["Затем","ниспослал","Аллах","Своё спокойствие","на","Своего Посланника","и на","верующих","и ниспослал","воинов","не","видели вы их","и наказал","тех, которые","не уверовали","И это","воздаяние","неверующих"]]],"m":[[["يُبَشِّرُهُمۡ","Радует их вестью",9,21],["رَبُّهُم","их Господь",9,21],["بِرَحۡمَةٖ","о милости",9,21],["مِّنۡهُ","от Него",9,21],["وَرِضۡوَٰنٖ","и довольстве",9,21],["وَجَنَّٰتٖ","и садах",9,21],["لَّهُمۡ","для них",9,21],["فِيهَا","в них",9,21]],[["نَعِيمٞ","блаженство",9,21],["مُّقِيمٌ","постоянное",9,21],[21],["خَٰلِدِينَ","Вечно пребывающие",9,22],["فِيهَآ","в них",9,22],["أَبَدًاۚ","навсегда",9,22],["إِنَّ","Поистине",9,22],["ٱللَّهَ","Аллах",9,22],["عِندَهُۥٓ","у Него",9,22],["أَجۡرٌ","награда",9,22]],[["عَظِيمٞ","великая",9,22],[22],["يَٰٓأَيُّهَا","О",9,23],["ٱلَّذِينَ","те, которые",9,23],["ءَامَنُواْ","уверовали",9,23],["لَا","не",9,23],["تَتَّخِذُوٓاْ","берите",9,23],["ءَابَآءَكُمۡ","своих отцов",9,23]],[["وَإِخۡوَٰنَكُمۡ","и своих братьев",9,23],["أَوۡلِيَآءَ","покровителями",9,23],["إِنِ","если",9,23],["ٱسۡتَحَبُّواْ","они предпочли",9,23],["ٱلۡكُفۡرَ","неверие",9,23],["عَلَى","над",9,23],["ٱلۡإِيمَٰنِۚ","верой",9,23]],[["وَمَن","А кто",9,23],["يَتَوَلَّهُم","возьмёт их в покровители",9,23],["مِّنكُمۡ","из вас",9,23],["فَأُوْلَٰٓئِكَ","то те",9,23],["هُمُ","они",9,23],["ٱلظَّٰلِمُونَ","несправедливые",9,23],[23],["قُلۡ","Скажи",9,24],["إِن","если",9,24]],[["كَانَ","окажутся",9,24],["ءَابَآؤُكُمۡ","ваши отцы",9,24],["وَأَبۡنَآؤُكُمۡ","и ваши сыновья",9,24],["وَإِخۡوَٰنُكُمۡ","и ваши братья",9,24],["وَأَزۡوَٰجُكُمۡ","и ваши супруги",9,24],["وَعَشِيرَتُكُمۡ","и ваш род",9,24]],[["وَأَمۡوَٰلٌ","и имущество",9,24],["ٱقۡتَرَفۡتُمُوهَا","которое вы приобрели",9,24],["وَتِجَٰرَةٞ","и торговля",9,24],["تَخۡشَوۡنَ","вы боитесь",9,24],["كَسَادَهَا","застоя её",9,24],["وَمَسَٰكِنُ","и жилища",9,24]],[["تَرۡضَوۡنَهَآ","вы довольны ими",9,24],["أَحَبَّ","милее",9,24],["إِلَيۡكُم","вам",9,24],["مِّنَ","чем",9,24],["ٱللَّهِ","Аллах",9,24],["وَرَسُولِهِۦ","и Его Посланник",9,24],["وَجِهَادٖ","и борьба",9,24]],[["فِي","на",9,24],["سَبِيلِهِۦ","Его пути",9,24],["فَتَرَبَّصُواْ","то ждите",9,24],["حَتَّىٰ","пока",9,24],["يَأۡتِيَ","придёт",9,24],["ٱللَّهُ","Аллах",9,24],["بِأَمۡرِهِۦۗ","со Своим велением",9,24],["وَٱللَّهُ","И Аллах",9,24],["لَا","не",9,24],["يَهۡدِي","ведёт прямым путём",9,24]],[["ٱلۡقَوۡمَ","людей",9,24],["ٱلۡفَٰسِقِينَ","нечестивых",9,24],[24],["لَقَدۡ","Ведь уже",9,25],["نَصَرَكُمُ","помог вам",9,25],["ٱللَّهُ","Аллах",9,25],["فِي","в",9,25],["مَوَاطِنَ","местах",9,25]],[["كَثِيرَةٖ","многих",9,25],["وَيَوۡمَ","и в день",9,25],["حُنَيۡنٍ","Хунайна",9,25],["إِذۡ","когда",9,25],["أَعۡجَبَتۡكُمۡ","восхитило вас",9,25],["كَثۡرَتُكُمۡ","ваше множество",9,25],["فَلَمۡ","но не",9,25]],[["تُغۡنِ","избавило",9,25],["عَنكُمۡ","вас",9,25],["شَيۡـٔٗا","ни от чего",9,25],["وَضَاقَتۡ","и стала тесной",9,25],["عَلَيۡكُمُ","для вас",9,25],["ٱلۡأَرۡضُ","земля",9,25]],[["بِمَا","при том, что",9,25],["رَحُبَتۡ","была просторна",9,25],["ثُمَّ","затем",9,25],["وَلَّيۡتُم","вы повернули",9,25],["مُّدۡبِرِينَ","отступая",9,25],[25],["ثُمَّ","Затем",9,26],["أَنزَلَ","ниспослал",9,26],["ٱللَّهُ","Аллах",9,26],["سَكِينَتَهُۥ","Своё спокойствие",9,26]],[["عَلَىٰ","на",9,26],["رَسُولِهِۦ","Своего Посланника",9,26],["وَعَلَى","и на",9,26],["ٱلۡمُؤۡمِنِينَ","верующих",9,26],["وَأَنزَلَ","и ниспослал",9,26],["جُنُودٗا","воинов",9,26],["لَّمۡ","не",9,26],["تَرَوۡهَا","видели вы их",9,26]],[["وَعَذّ