{"p":191,"j":10,"a":[[9,27,["ثُمَّ","يَتُوبُ","ٱللَّهُ","مِنۢ","بَعۡدِ","ذَٰلِكَ","عَلَىٰ","مَن","يَشَآءُۗ","وَٱللَّهُ","غَفُورٞ","رَّحِيمٞ"],"сумма йатуубуллаху мим ба`ди залика `ала ман йашау валлаху гафуурур рахиим","А после этого Аллах примет покаяния тех, кого пожелает, ибо Аллах - Прощающий, Милосердный.",["Затем","обратится с прощением","Аллах","вслед","за","этим","к","тому, кого","Он пожелает","И Аллах","Прощающий","Милосердный"]],[9,28,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُوٓاْ","إِنَّمَا","ٱلۡمُشۡرِكُونَ","نَجَسٞ","فَلَا","يَقۡرَبُواْ","ٱلۡمَسۡجِدَ","ٱلۡحَرَامَ","بَعۡدَ","عَامِهِمۡ","هَٰذَاۚ","وَإِنۡ","خِفۡتُمۡ","عَيۡلَةٗ","فَسَوۡفَ","يُغۡنِيكُمُ","ٱللَّهُ","مِن","فَضۡلِهِۦٓ","إِن","شَآءَۚ","إِنَّ","ٱللَّهَ","عَلِيمٌ","حَكِيمٞ"],"йа'аййухал лазиина амануу иннамал мушрикууна нажасун фала йаḳрабул масжидал харама ба`да `амихим хаза ва'ин хифтум `айлатан фасауфа йугниикумуллаху мин фадлихии ин шаа инналлаха `алиимун хакиим","О те, которые уверовали! Воистину, многобожники являются нечистыми. И пусть они после этого их года не приближаются к Заповедной мечети. Если же вы боитесь бедности, то Аллах обеспечит вас богатством из Своей милости, если пожелает. Воистину, Аллах - Знающий, Мудрый.",["О","те, которые","уверовали","поистине","многобожники","нечистота","так пусть не","приближаются они","к мечети","Заповедной","после","их года","этого","А если","вы боитесь","бедности","то скоро","обогатит вас","Аллах","из","Своей милости","если","Он пожелает","Поистине","Аллах","Знающий","Мудрый"]],[9,29,["قَٰتِلُواْ","ٱلَّذِينَ","لَا","يُؤۡمِنُونَ","بِٱللَّهِ","وَلَا","بِٱلۡيَوۡمِ","ٱلۡأٓخِرِ","وَلَا","يُحَرِّمُونَ","مَا","حَرَّمَ","ٱللَّهُ","وَرَسُولُهُۥ","وَلَا","يَدِينُونَ","دِينَ","ٱلۡحَقِّ","مِنَ","ٱلَّذِينَ","أُوتُواْ","ٱلۡكِتَٰبَ","حَتَّىٰ","يُعۡطُواْ","ٱلۡجِزۡيَةَ","عَن","يَدٖ","وَهُمۡ","صَٰغِرُونَ"],"ḳатилул лазиина ла йу'минууна биллахи вала билйаумил ахири вала йухарримууна ма харрамаллаху варасуулухуу вала йадиинууна диинал хаḳḳи минал лазиина уутул китаба хатта йу`тул жизйата `ан йадин вахум сагируун","Сражайтесь с теми из людей Писания, которые не веруют ни в Аллаха, ни в Последний день, которые не считают запретным то, что запретили Аллах и Его Посланник, которые не исповедуют истинную религию, пока они не станут собственноручно платить дань, оставаясь униженными.",["Сражайтесь","с теми, которые","не","веруют","в Аллаха","и не","в День","Последний","и не","запрещают","то, что","запретил","Аллах","и Его Посланник","и не","исповедуют","религию","истины","из","тех, кому","было дано","Писание","пока не","дадут","джизью","из","рук","и они","униженные"]],[9,30,["وَقَالَتِ","ٱلۡيَهُودُ","عُزَيۡرٌ","ٱبۡنُ","ٱللَّهِ","وَقَالَتِ","ٱلنَّصَٰرَى","ٱلۡمَسِيحُ","ٱبۡنُ","ٱللَّهِۖ","ذَٰلِكَ","قَوۡلُهُم","بِأَفۡوَٰهِهِمۡۖ","يُضَٰهِـُٔونَ","قَوۡلَ","ٱلَّذِينَ","كَفَرُواْ","مِن","قَبۡلُۚ","قَٰتَلَهُمُ","ٱللَّهُۖ","أَنَّىٰ","يُؤۡفَكُونَ"],"ваḳалатил йахууду `узайрунибнуллахи ваḳалатин насарал масиихубнуллахи залика ḳаулухум би'афвахихим йудахиууна ḳаулал лазиина кафаруу мин ḳаблу ḳаталахумуллаху анна йу'факуун","Иудеи сказали: «Узейр (Ездра) - сын Аллаха». Христиане сказали: «Мессия - сын Аллаха». Они произносят своими устами слова, похожие на слова прежних неверующих. Да погубит их Аллах! До чего же они отвращены от истины!",["И сказали","иудеи","Узайр","сын","Аллаха","И сказали","христиане","Мессия","сын","Аллаха","Это","их слова","их устами","они уподобляются","словам","тех, которые","не уверовали","из","прежних","Да погубит их","Аллах","как же","они отвращены"]],[9,31,["ٱتَّخَذُوٓاْ","أَحۡبَارَهُمۡ","وَرُهۡبَٰنَهُمۡ","أَرۡبَابٗا","مِّن","دُونِ","ٱللَّهِ","وَٱلۡمَسِيحَ","ٱبۡنَ","مَرۡيَمَ","وَمَآ","أُمِرُوٓاْ","إِلَّا","لِيَعۡبُدُوٓاْ","إِلَٰهٗا","وَٰحِدٗاۖ","لَّآ","إِلَٰهَ","إِلَّا","هُوَۚ","سُبۡحَٰنَهُۥ","عَمَّا","يُشۡرِكُونَ"],"иттахазуу ахбарахум варухбанахум арбабам мин дууниллахи валмасиихабна марйама вама умируу илла лийа`будуу илахан вахидал ла илаха илла хуа субханахуу `амма йушрикуун","Они признали господами помимо Аллаха своих первосвященников и монахов, а также Мессию, сына Марьям (Марии). А ведь им было велено поклоняться только одному Богу, кроме которого нет иного божества. Он превыше того, что они приобщают в сотоварищи!",["Они взяли","своих первосвященников","и своих монахов","господами","из","помимо","Аллаха","и Мессию","сына","Марьям","А не","было велено им","кроме как","чтобы поклонялись они","Богу","Единому","нет","божества","кроме","Него","Пречист Он","от того, что","они приобщают"]]],"m":[[["ثُمَّ","Затем",9,27],["يَتُوبُ","обратится с прощением",9,27],["ٱللَّهُ","Аллах",9,27],["مِنۢ","вслед",9,27],["بَعۡدِ","за",9,27],["ذَٰلِكَ","этим",9,27],["عَلَىٰ","к",9,27],["مَن","тому, кого",9,27],["يَشَآءُۗ","Он пожелает",9,27],["وَٱللَّهُ","И Аллах",9,27],["غَفُورٞ","Прощающий",9,27]],[["رَّحِيمٞ","Милосердный",9,27],[27],["يَٰٓأَيُّهَا","О",9,28],["ٱلَّذِينَ","те, которые",9,28],["ءَامَنُوٓاْ","уверовали",9,28],["إِنَّمَا","поистине",9,28],["ٱلۡمُشۡرِكُونَ","многобожники",9,28]],[["نَجَسٞ","нечистота",9,28],["فَلَا","так пусть не",9,28],["يَقۡرَبُواْ","приближаются они",9,28],["ٱلۡمَسۡجِدَ","к мечети",9,28],["ٱلۡحَرَامَ","Заповедной",9,28],["بَعۡدَ","после",9,28],["عَامِهِمۡ","их года",9,28],["هَٰذَاۚ","этого",9,28]],[["وَإِنۡ","А если",9,28],["خِفۡتُمۡ","вы боитесь",9,28],["عَيۡلَةٗ","бедности",9,28],["فَسَوۡفَ","то скоро",9,28],["يُغۡنِيكُمُ","обогатит вас",9,28],["ٱللَّهُ","Аллах",9,28],["مِن","из",9,28],["فَضۡلِهِۦٓ","Своей милости",9,28],["إِن","если",9,28]],[["شَآءَۚ","Он пожелает",9,28],["إِنَّ","Поистине",9,28],["ٱللَّهَ","Аллах",9,28],["عَلِيمٌ","Знающий",9,28],["حَكِيمٞ","Мудрый",9,28],[28],["قَٰتِلُواْ","Сражайтесь",9,29],["ٱلَّذِينَ","с теми, которые",9,29]],[["لَا","не",9,29],["يُؤۡمِنُونَ","веруют",9,29],["بِٱللَّهِ","в Аллаха",9,29],["وَلَا","и не",9,29],["بِٱلۡيَوۡمِ","в День",9,29],["ٱلۡأٓخِرِ","Последний",9,29],["وَلَا","и не",9,29],["يُحَرِّمُونَ","запрещают",9,29],["مَا","то, что",9,29],["حَرَّمَ","запретил",9,29]],[["ٱللَّهُ","Аллах",9,29],["وَرَسُولُهُۥ","и Его Посланник",9,29],["وَلَا","и не",9,29],["يَدِينُونَ","исповедуют",9,29],["دِينَ","религию",9,29],["ٱلۡحَقِّ","истины",9,29],["مِنَ","из",9,29],["ٱلَّذِينَ","тех, кому",9,29],["أُوتُواْ","было дано",9,29]],[["ٱلۡكِتَٰبَ","Писание",9,29],["حَتَّىٰ","пока не",9,29],["يُعۡطُواْ","дадут",9,29],["ٱلۡجِزۡيَةَ","джизью",9,29],["عَن","из",9,29],["يَدٖ","рук",9,29],["وَهُمۡ","и они",9,29],["صَٰغِرُونَ","униженные",9,29]],[[29],["وَقَالَتِ","И сказали",9,30],["ٱلۡيَهُودُ","иудеи",9,30],["عُزَيۡرٌ","Узайр",9,30],["ٱبۡنُ","сын",9,30],["ٱللَّهِ","Аллаха",9,30],["وَقَالَتِ","И сказали",9,30],["ٱلنَّصَٰرَى","христиане",9,30]],[["ٱلۡمَسِيحُ","Мессия",9,30],["ٱبۡنُ","сын",9,30],["ٱللَّهِۖ","Аллаха",9,30],["ذَٰلِكَ","Это",9,30],["قَوۡلُهُم","их слова",9,30],["بِأَفۡوَٰهِهِمۡۖ","их устами",9,30]],[["يُضَٰهِـُٔونَ","они уподобляются",9,30],["قَوۡلَ","словам",9,30],["ٱلَّذِينَ","тех, которые",9,30],["كَفَرُواْ","не уверовали",9,30],["مِن","из",9,30],["قَبۡلُۚ","прежних",9,30],["قَٰتَلَهُمُ","Да погубит их",9,30]],[["ٱللَّهُۖ","Аллах",9,30],["أَنَّىٰ","как же",9,30],["يُؤۡفَكُونَ","они отвращены",9,30],[30],["ٱتَّخَذُوٓاْ","Они взяли",9,31],["أَحۡبَارَهُمۡ","своих первосвященников",9,31]],[["وَرُهۡبَٰنَهُمۡ","и своих монахов",9,31],["أَرۡبَابٗا","господами",9,31],["مِّن","из",9,31],["دُونِ","помимо",9,31],["ٱللَّهِ","Аллаха",9,31],["وَٱلۡمَسِيحَ","и Мессию",9,31],["ٱبۡنَ","сына",9,31]],[["مَرۡيَمَ","Марьям",9,31],["وَمَآ","А не",9,31],["أُمِرُوٓاْ","было велено им",9,31],["إِلَّا","кроме как",9,31],["لِيَعۡبُدُوٓاْ","чтобы поклонялись они",9,31],["إِلَٰهٗا","Богу",9,31],["وَٰحِدٗاۖ","Единому",9,31]],[["لَّآ","нет",9,31],["إِلَٰهَ","божества",9,31],["إِلَّا","кроме",9,31],["هُوَۚ","Него",9,31],["سُبۡحَٰنَهُۥ","Пречист Он",9,31],["عَمَّا","от того, что",9,31],["يُشۡرِكُونَ","они приобщают",9,31],[31]]]}