{"p":192,"j":10,"a":[[9,32,["يُرِيدُونَ","أَن","يُطۡفِـُٔواْ","نُورَ","ٱللَّهِ","بِأَفۡوَٰهِهِمۡ","وَيَأۡبَى","ٱللَّهُ","إِلَّآ","أَن","يُتِمَّ","نُورَهُۥ","وَلَوۡ","كَرِهَ","ٱلۡكَٰفِرُونَ"],"йуриидууна ан йутфиуу нуураллахи би'афвахихим вайа'баллаху илла ан йутимма нуурахуу валау карихал кафируун","Они хотят потушить свет Аллаха своими устами. Но Аллах не допустит этого и завершит распространение Своего света, даже если это ненавистно неверующим.",["Они хотят","чтобы","погасить","свет","Аллаха","своими устами","но не допускает","Аллах","иначе","как","завершить","Свой свет","и даже если","ненавистно","неверующим"]],[9,33,["هُوَ","ٱلَّذِيٓ","أَرۡسَلَ","رَسُولَهُۥ","بِٱلۡهُدَىٰ","وَدِينِ","ٱلۡحَقِّ","لِيُظۡهِرَهُۥ","عَلَى","ٱلدِّينِ","كُلِّهِۦ","وَلَوۡ","كَرِهَ","ٱلۡمُشۡرِكُونَ"],"хуал лазии арсала расуулахуу билхуда вадиинил хаḳḳи лийузхирахуу `алад диини куллихии валау карихал мушрикуун","Он - Тот, Кто отправил Своего Посланника с верным руководством и истинной религией, чтобы превознести ее над всеми остальными религиями, даже если это ненавистно многобожникам.",["Он","Тот, Который","отправил","Своего Посланника","с руководством","и религией","истины","чтобы превознести её","над","религиями","всеми","и даже если","ненавистно","многобожникам"]],[9,34,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُوٓاْ","إِنَّ","كَثِيرٗا","مِّنَ","ٱلۡأَحۡبَارِ","وَٱلرُّهۡبَانِ","لَيَأۡكُلُونَ","أَمۡوَٰلَ","ٱلنَّاسِ","بِٱلۡبَٰطِلِ","وَيَصُدُّونَ","عَن","سَبِيلِ","ٱللَّهِۗ","وَٱلَّذِينَ","يَكۡنِزُونَ","ٱلذَّهَبَ","وَٱلۡفِضَّةَ","وَلَا","يُنفِقُونَهَا","فِي","سَبِيلِ","ٱللَّهِ","فَبَشِّرۡهُم","بِعَذَابٍ","أَلِيمٖ"],"йа'аййухал лазиина амануу инна касиирам минал ахбари варрухбани лайа'кулууна амвалан наси билбатили вайасуддууна `ан сабиилиллахи валлазиина йакнизууназ захаба валфиддата вала йунфиḳуунаха фии сабиилиллахи фабашширхум би`азабин алиим","О те, которые уверовали! Воистину, многие из первосвященников и монахов незаконно пожирают имущество людей и сбивают их с пути Аллаха. Обрадуй же тех, которые накапливают золото и серебро и не расходуют их на пути Аллаха, мучительными страданиями.",["О","те, которые","уверовали","поистине","многие","из","первосвященников","и монахов","непременно пожирают","имущество","людей","неправедно","и отвращают","от","пути","Аллаха","А те, которые","копят","золото","и серебро","и не","расходуют их","на","пути","Аллаха","обрадуй же их","мучением","болезненным"]],[9,35,["يَوۡمَ","يُحۡمَىٰ","عَلَيۡهَا","فِي","نَارِ","جَهَنَّمَ","فَتُكۡوَىٰ","بِهَا","جِبَاهُهُمۡ","وَجُنُوبُهُمۡ","وَظُهُورُهُمۡۖ","هَٰذَا","مَا","كَنَزۡتُمۡ","لِأَنفُسِكُمۡ","فَذُوقُواْ","مَا","كُنتُمۡ","تَكۡنِزُونَ"],"йаума йухма `алайха фии нари жаханнама фатуква биха жибахухум важунуубухум вазухуурухум хаза ма каназтум ли'анфусикум фазууḳуу ма кунтум такнизуун","В тот день они (накопленные ими сокровища) будут раскалены в огне Геенны, и ими будут заклеймены их лбы, бока и спины. Им будет сказано: «Вот то, что вы копили для себя. Вкусите же то, что вы копили!».",["В день","будет раскалено","оно (накопленное)","в","огне","Геенны","и будут заклеймены","им","их лбы","и их бока","и их спины","Это","то, что","вы копили","для себя","Вкусите же","то, что","вы","копили"]],[9,36,["إِنَّ","عِدَّةَ","ٱلشُّهُورِ","عِندَ","ٱللَّهِ","ٱثۡنَا","عَشَرَ","شَهۡرٗا","فِي","كِتَٰبِ","ٱللَّهِ","يَوۡمَ","خَلَقَ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضَ","مِنۡهَآ","أَرۡبَعَةٌ","حُرُمٞۚ","ذَٰلِكَ","ٱلدِّينُ","ٱلۡقَيِّمُۚ","فَلَا","تَظۡلِمُواْ","فِيهِنَّ","أَنفُسَكُمۡۚ","وَقَٰتِلُواْ","ٱلۡمُشۡرِكِينَ","كَآفَّةٗ","كَمَا","يُقَٰتِلُونَكُمۡ","كَآفَّةٗۚ","وَٱعۡلَمُوٓاْ","أَنَّ","ٱللَّهَ","مَعَ","ٱلۡمُتَّقِينَ"],"инна `иддаташ шухуури `индаллахисна `ашара шахран фии китабиллахи йаума халаḳас самавати вал'арда минха арба`атун хурумун заликад диинул ḳаййиму фала тазлимуу фиихинна анфусакум ваḳатилул мушрикиина каффатан кама йуḳатилуунакум каффатан ва`ламуу анналлаха ма`ал муттаḳиин","Воистину, число месяцев у Аллаха - двенадцать. Так было записано в Писании в тот день, когда Аллах сотворил небеса и землю. Четыре месяца из них - запретные. Такова правая религия, и посему не поступайте в них несправедливо по отношению к себе. Сражайтесь с многобожниками всеми вместе (или все вместе), подобно тому, как они сражаются с вами всеми вместе (или все вместе). Знайте, что Аллах - с богобоязненными.",["Поистине","число","месяцев","у","Аллаха","двенадцать","(двенадцать)","месяцев","в","Писании","Аллаха","в день, когда","Он сотворил","небеса","и землю","из них","четыре","запретные","Это","религия","правая","так не","притесняйте","в них","самих себя","И сражайтесь","с многобожниками","все вместе","как","они сражаются с вами","все вместе","И знайте","что","Аллах","с","богобоязненными"]]],"m":[[["يُرِيدُونَ","Они хотят",9,32],["أَن","чтобы",9,32],["يُطۡفِـُٔواْ","погасить",9,32],["نُورَ","свет",9,32],["ٱللَّهِ","Аллаха",9,32],["بِأَفۡوَٰهِهِمۡ","своими устами",9,32],["وَيَأۡبَى","но не допускает",9,32],["ٱللَّهُ","Аллах",9,32],["إِلَّآ","иначе",9,32]],[["أَن","как",9,32],["يُتِمَّ","завершить",9,32],["نُورَهُۥ","Свой свет",9,32],["وَلَوۡ","и даже если",9,32],["كَرِهَ","ненавистно",9,32],["ٱلۡكَٰفِرُونَ","неверующим",9,32],[32],["هُوَ","Он",9,33],["ٱلَّذِيٓ","Тот, Который",9,33]],[["أَرۡسَلَ","отправил",9,33],["رَسُولَهُۥ","Своего Посланника",9,33],["بِٱلۡهُدَىٰ","с руководством",9,33],["وَدِينِ","и религией",9,33],["ٱلۡحَقِّ","истины",9,33],["لِيُظۡهِرَهُۥ","чтобы превознести её",9,33],["عَلَى","над",9,33],["ٱلدِّينِ","религиями",9,33]],[["كُلِّهِۦ","всеми",9,33],["وَلَوۡ","и даже если",9,33],["كَرِهَ","ненавистно",9,33],["ٱلۡمُشۡرِكُونَ","многобожникам",9,33],[33],["۞ يَٰٓأَيُّهَا","О",9,34],["ٱلَّذِينَ","те, которые",9,34]],[["ءَامَنُوٓاْ","уверовали",9,34],["إِنَّ","поистине",9,34],["كَثِيرٗا","многие",9,34],["مِّنَ","из",9,34],["ٱلۡأَحۡبَارِ","первосвященников",9,34],["وَٱلرُّهۡبَانِ","и монахов",9,34],["لَيَأۡكُلُونَ","непременно пожирают",9,34]],[["أَمۡوَٰلَ","имущество",9,34],["ٱلنَّاسِ","людей",9,34],["بِٱلۡبَٰطِلِ","неправедно",9,34],["وَيَصُدُّونَ","и отвращают",9,34],[