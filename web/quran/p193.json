{"p":193,"j":10,"a":[[9,37,["إِنَّمَا","ٱلنَّسِيٓءُ","زِيَادَةٞ","فِي","ٱلۡكُفۡرِۖ","يُضَلُّ","بِهِ","ٱلَّذِينَ","كَفَرُواْ","يُحِلُّونَهُۥ","عَامٗا","وَيُحَرِّمُونَهُۥ","عَامٗا","لِّيُوَاطِـُٔواْ","عِدَّةَ","مَا","حَرَّمَ","ٱللَّهُ","فَيُحِلُّواْ","مَا","حَرَّمَ","ٱللَّهُۚ","زُيِّنَ","لَهُمۡ","سُوٓءُ","أَعۡمَٰلِهِمۡۗ","وَٱللَّهُ","لَا","يَهۡدِي","ٱلۡقَوۡمَ","ٱلۡكَٰفِرِينَ"],"иннаман насииу зийадатун фил куфри йудаллу бихил лазиина кафаруу йухиллуунахуу `аман вайухарримуунахуу `амал лийуатиуу `иддата ма харрамаллаху файухиллуу ма харрамаллаху зуййина лахум су'уу а`малихим валлаху ла йахдил ḳаумал кафириин","Откладывание запретного месяца только увеличивает неверие. От этого неверующие впадают в заблуждение. В один год они объявляют его дозволенным, а в другой год объявляют его запретным, чтобы уравнять количество месяцев, которые Аллах сделал запретными. Они объявляют дозволенным то, что запретил Аллах, и их злодеяния кажутся им прекрасными. Аллах не ведет прямым путем неверующих людей.",["Поистине","перенос (месяцев)","увеличение","в","неверии","вводятся в заблуждение","им","те, которые","не уверовали","они объявляют его дозволенным","в один год","и объявляют его запретным","в другой год","чтобы согласовать","число","того, что","запретил","Аллах","и объявляют дозволенным","то, что","запретил","Аллах","Приукрашено","для них","зло","их деяний","И Аллах","не","ведёт прямым путём","людей","неверующих"]],[9,38,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُواْ","مَا","لَكُمۡ","إِذَا","قِيلَ","لَكُمُ","ٱنفِرُواْ","فِي","سَبِيلِ","ٱللَّهِ","ٱثَّاقَلۡتُمۡ","إِلَى","ٱلۡأَرۡضِۚ","أَرَضِيتُم","بِٱلۡحَيَوٰةِ","ٱلدُّنۡيَا","مِنَ","ٱلۡأٓخِرَةِۚ","فَمَا","مَتَٰعُ","ٱلۡحَيَوٰةِ","ٱلدُّنۡيَا","فِي","ٱلۡأٓخِرَةِ","إِلَّا","قَلِيلٌ"],"йа'аййухал лазиина амануу ма лакум иза ḳиила лакумунфируу фии сабиилиллахиссаḳалтум илал арди арадиитум билхайаватид дунйа минал ахирати фама мата`ул хайаватид дунйа фил ахирати илла ḳалиил","О те, которые уверовали! Почему, когда вас призывают выступить в поход на пути Аллаха, вы тяжело припадаете к земле? Неужели вы довольствуетесь мирской жизнью больше, чем Последней жизнью? Но преходящее удовольствие мирской жизни по сравнению с Последней жизнью ничтожно.",["О","те, которые","уверовали","что","с вами","когда","сказано","вам","выступайте","на","пути","Аллаха","вы отяжелели","к","земле","Неужели вы довольны","жизнью","мирской","вместо","Последней жизни","Но не","наслаждение","жизни","мирской","по сравнению с","Последней жизнью","кроме как","малое"]],[9,39,["إِلَّا","تَنفِرُواْ","يُعَذِّبۡكُمۡ","عَذَابًا","أَلِيمٗا","وَيَسۡتَبۡدِلۡ","قَوۡمًا","غَيۡرَكُمۡ","وَلَا","تَضُرُّوهُ","شَيۡـٔٗاۗ","وَٱللَّهُ","عَلَىٰ","كُلِّ","شَيۡءٖ","قَدِيرٌ"],"илла танфируу йу`аззибкум `азабан алииман вайастабдил ḳауман гайракум вала тадуррууху шай'ан валлаху `ала кулли шай'ин ḳадиир","Если вы не выступите в поход, то Он подвергнет вас мучительным страданиям и заменит вас другим народом. Вы ничем не навредите Ему, ибо Аллах способен на всякую вещь.",["Если не","выступите","Он накажет вас","мучением","болезненным","и заменит","народом","другим, чем вы","и не","навредите Ему","ничем","И Аллах","над","всякой","вещью","Всемогущ"]],[9,40,["إِلَّا","تَنصُرُوهُ","فَقَدۡ","نَصَرَهُ","ٱللَّهُ","إِذۡ","أَخۡرَجَهُ","ٱلَّذِينَ","كَفَرُواْ","ثَانِيَ","ٱثۡنَيۡنِ","إِذۡ","هُمَا","فِي","ٱلۡغَارِ","إِذۡ","يَقُولُ","لِصَٰحِبِهِۦ","لَا","تَحۡزَنۡ","إِنَّ","ٱللَّهَ","مَعَنَاۖ","فَأَنزَلَ","ٱللَّهُ","سَكِينَتَهُۥ","عَلَيۡهِ","وَأَيَّدَهُۥ","بِجُنُودٖ","لَّمۡ","تَرَوۡهَا","وَجَعَلَ","كَلِمَةَ","ٱلَّذِينَ","كَفَرُواْ","ٱلسُّفۡلَىٰۗ","وَكَلِمَةُ","ٱللَّهِ","هِيَ","ٱلۡعُلۡيَاۗ","وَٱللَّهُ","عَزِيزٌ","حَكِيمٌ"],"илла тансурууху фаḳад насарахуллаху из ахражахул лазиина кафаруу санийаснайни из хума фил гари из йаḳуулу лисахибихии ла тахзан инналлаха ма`ана фа'анзалаллаху сакиинатахуу `алайхи ва'аййадахуу бижунуудил лам тарауха важа`ала калиматал лазиина кафарус суфла вакалиматуллахи хийал `улйа валлаху `азиизун хакиим","Если вы не окажете ему (Мухаммаду) поддержки, то ведь Аллах уже оказал ему поддержку, когда неверующие изгнали его. Он был одним из тех двоих, которые находились в пещере, и сказал своему спутнику (Абу Бакру): «Не скорби, ибо Аллах - с нами». Тогда Аллах ниспослал ему спокойствие и поддержал его воинами, которых вы не видели. Аллах сделал слово неверующих нижайшим, тогда как Слово Аллаха превыше всего. Аллах - Могущественный, Мудрый.",["Если не","поможете ему","то уже","помог ему","Аллах","когда","изгнали его","те, которые","не уверовали","вторым","из двух","когда","они оба","в","пещере","когда","он говорит","своему спутнику","не","печалься","поистине","Аллах","с нами","И ниспослал","Аллах","Своё спокойствие","на него","и поддержал его","воинами","не","видели вы их","и сделал","слово","тех, которые","не уверовали","низшим","а Слово","Аллаха","оно","высшее","И Аллах","Могущественный","Мудрый"]]],"m":[[["إِنَّمَا","Поистине",9,37],["ٱلنَّسِيٓءُ","перенос (месяцев)",9,37],["زِيَادَةٞ","увеличение",9,37],["فِي","в",9,37],["ٱلۡكُفۡرِۖ","неверии",9,37],["يُضَلُّ","вводятся в заблуждение",9,37],["بِهِ","им",9,37],["ٱلَّذِينَ","те, которые",9,37],["كَفَرُواْ","не уверовали",9,37]],[["يُحِلُّونَهُۥ","они объявляют его дозволенным",9,37],["عَامٗا","в один год",9,37],["وَيُحَرِّمُونَهُۥ","и объявляют его запретным",9,37],["عَامٗا","в другой год",9,37],["لِّيُوَاطِـُٔواْ","чтобы согласовать",9,37],["عِدَّةَ","число",9,37],["مَا","того, что",9,37],["حَرَّمَ","запретил",9,37],["ٱللَّهُ","Аллах",9,37]],[["فَيُحِلُّواْ","и объявляют дозволенным",9,37],["مَا","то, что",9,37],["حَرَّمَ","запретил",9,37],["ٱللَّهُۚ","Аллах",9,37],["زُيِّنَ","Приукрашено",9,37],["لَهُمۡ","для них",9,37],["سُوٓءُ","зло",9,37],["أَعۡمَٰلِهِمۡۗ","их деяний",9,37],["وَٱللَّهُ","И Аллах",9,37]],[["لَا","не",9,37],["يَهۡدِي","ведёт прямым путём",9,37],["ٱلۡقَوۡمَ","людей",9,37],["ٱلۡكَٰفِرِينَ","неверующих",9,37],[37],["يَٰٓأَيُّهَا","О",9,38],["ٱلَّذِينَ","те, которые",9,38]],[["ءَامَنُواْ","уверовали",9,38],["مَا","что",9,38],["لَكُمۡ","с вами",9,38],["إِذَا",