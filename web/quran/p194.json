{"p":194,"j":10,"a":[[9,41,["ٱنفِرُواْ","خِفَافٗا","وَثِقَالٗا","وَجَٰهِدُواْ","بِأَمۡوَٰلِكُمۡ","وَأَنفُسِكُمۡ","فِي","سَبِيلِ","ٱللَّهِۚ","ذَٰلِكُمۡ","خَيۡرٞ","لَّكُمۡ","إِن","كُنتُمۡ","تَعۡلَمُونَ"],"инфируу хифафан васиḳалан важахидуу би'амваликум ва'анфусикум фии сабиилиллахи заликум хайрул лакум ин кунтум та`ламуун","Выступайте в поход, легко ли это вам будет или обременительно, и сражайтесь на пути Аллаха своим имуществом и своими душами. Так будет лучше для вас, если бы вы только знали.",["Выступайте","налегке","и обременёнными","и сражайтесь","своим имуществом","и своими душами","на","пути","Аллаха","Это","лучше","для вас","если","вы","знаете"]],[9,42,["لَوۡ","كَانَ","عَرَضٗا","قَرِيبٗا","وَسَفَرٗا","قَاصِدٗا","لَّٱتَّبَعُوكَ","وَلَٰكِنۢ","بَعُدَتۡ","عَلَيۡهِمُ","ٱلشُّقَّةُۚ","وَسَيَحۡلِفُونَ","بِٱللَّهِ","لَوِ","ٱسۡتَطَعۡنَا","لَخَرَجۡنَا","مَعَكُمۡ","يُهۡلِكُونَ","أَنفُسَهُمۡ","وَٱللَّهُ","يَعۡلَمُ","إِنَّهُمۡ","لَكَٰذِبُونَ"],"лау кана `арадан ḳариибан васафаран ḳасидал латтаба`уука валаким ба`удат `алайхимуш шуḳḳату васайахлифууна биллахи лавистата`на лахаражна ма`акум йухликууна анфусахум валлаху йа`ламу иннахум лаказибуун","Если бы их ожидали близкая нажива и легкая дорога, то они последовали бы за тобой. Но расстояние показалось им дальним, и они будут клясться Аллахом: «Если бы мы могли, то непременно отправились бы с вами». Они губят себя, и Аллах знает, что они являются лжецами.",["Если бы","было","добыча","близкая","и путь","лёгкий","непременно последовали бы за тобой","но","далёким оказалось","для них","расстояние","И будут клясться","Аллахом","если бы","мы могли","непременно вышли бы мы","с вами","Они губят","самих себя","А Аллах","знает","что они","непременно лжецы"]],[9,43,["عَفَا","ٱللَّهُ","عَنكَ","لِمَ","أَذِنتَ","لَهُمۡ","حَتَّىٰ","يَتَبَيَّنَ","لَكَ","ٱلَّذِينَ","صَدَقُواْ","وَتَعۡلَمَ","ٱلۡكَٰذِبِينَ"],"`афаллаху `анка лима азинта лахум хатта йатабаййана лакал лазиина садаḳуу вата`ламал казибиин","Да простит тебя Аллах! Почему ты разрешил им остаться дома, пока тебе не стало ясно, кто говорит правду, а кто является лжецом?",["Простил","Аллах","тебя","почему","ты позволил","им","пока не","стало ясно","тебе","те, которые","сказали правду","и узнал ты","лжецов"]],[9,44,["لَا","يَسۡتَـٔۡذِنُكَ","ٱلَّذِينَ","يُؤۡمِنُونَ","بِٱللَّهِ","وَٱلۡيَوۡمِ","ٱلۡأٓخِرِ","أَن","يُجَٰهِدُواْ","بِأَمۡوَٰلِهِمۡ","وَأَنفُسِهِمۡۗ","وَٱللَّهُ","عَلِيمُۢ","بِٱلۡمُتَّقِينَ"],"ла йаста'зинукал лазиина йу'минууна биллахи валйаумил ахири ан йужахидуу би'амвалихим ва'анфусихим валлаху `алииму билмуттаḳиин","Те, которые веруют в Аллаха и в Последний день, не спрашивают у тебя дозволения на то, чтобы сражаться своим имуществом и своими душами. Ведь Аллах знает богобоязненных.",["Не","просят у тебя позволения","те, которые","веруют","в Аллаха","и в День","Последний","чтобы","сражаться","своим имуществом","и своими душами","И Аллах","Знающий","о богобоязненных"]],[9,45,["إِنَّمَا","يَسۡتَـٔۡذِنُكَ","ٱلَّذِينَ","لَا","يُؤۡمِنُونَ","بِٱللَّهِ","وَٱلۡيَوۡمِ","ٱلۡأٓخِرِ","وَٱرۡتَابَتۡ","قُلُوبُهُمۡ","فَهُمۡ","فِي","رَيۡبِهِمۡ","يَتَرَدَّدُونَ"],"иннама йаста'зинукал лазиина ла йу'минууна биллахи валйаумил ахири вартабат ḳулуубухум фахум фии райбихим йатараддадуун","У тебя просят дозволения остаться дома только те, которые не веруют в Аллаха и в Последний день, сердца которых испытывают сомнение. И по причине своего сомнения они пребывают в замешательстве.",["Только","просят у тебя позволения","те, которые","не","веруют","в Аллаха","и в День","Последний","и усомнились","их сердца","и они","в","своём сомнении","колеблются"]],[9,46,["وَلَوۡ","أَرَادُواْ","ٱلۡخُرُوجَ","لَأَعَدُّواْ","لَهُۥ","عُدَّةٗ","وَلَٰكِن","كَرِهَ","ٱللَّهُ","ٱنۢبِعَاثَهُمۡ","فَثَبَّطَهُمۡ","وَقِيلَ","ٱقۡعُدُواْ","مَعَ","ٱلۡقَٰعِدِينَ"],"валау арадул хуруужа ла'а`аддуу лахуу `уддатан валакин карихаллахумби`асахум фасаббатахум ваḳиилаḳ`удуу ма`ал ḳа`идиин","Если бы они желали выступить в поход, то приготовились бы к этому. Однако Аллах не пожелал, чтобы они отправились в поход, и задержал их. Им было сказано: «Отсиживайтесь вместе с теми, кто остался отсиживаться».",["И если бы","они желали","выступления","непременно подготовили бы","для него","снаряжение","но","счёл неугодным","Аллах","их выступление","и Он задержал их","и было сказано","сидите","с","сидящими"]],[9,47,["لَوۡ","خَرَجُواْ","فِيكُم","مَّا","زَادُوكُمۡ","إِلَّا","خَبَالٗا","وَلَأَوۡضَعُواْ","خِلَٰلَكُمۡ","يَبۡغُونَكُمُ","ٱلۡفِتۡنَةَ","وَفِيكُمۡ","سَمَّٰعُونَ","لَهُمۡۗ","وَٱللَّهُ","عَلِيمُۢ","بِٱلظَّٰلِمِينَ"],"лау харажуу фиикум ма задуукум илла хабалан валаауда`уу хилалакум йабгуунакумул фитната вафиикум самма`ууна лахум валлаху `алииму биззалимиин","Если бы они выступили в поход вместе с вами, то не прибавили бы вам ничего, кроме беспорядка, торопливо ходили бы между вами и сеяли бы между вами смуту. Среди вас найдутся такие, которые станут прислушиваться к ним. Аллах знает беззаконников.",["Если бы","они вышли","среди вас","не","прибавили бы вам","кроме","смятения","и непременно сновали бы","между вами","желая вам","смуты","А среди вас","охотно слушающие","их","И Аллах","Знающий","о несправедливых"]]],"m":[[["ٱنفِرُواْ","Выступайте",9,41],["خِفَافٗا","налегке",9,41],["وَثِقَالٗا","и обременёнными",9,41],["وَجَٰهِدُواْ","и сражайтесь",9,41],["بِأَمۡوَٰلِكُمۡ","своим имуществом",9,41],["وَأَنفُسِكُمۡ","и своими душами",9,41]],[["فِي","на",9,41],["سَبِيلِ","пути",9,41],["ٱللَّهِۚ","Аллаха",9,41],["ذَٰلِكُمۡ","Это",9,41],["خَيۡرٞ","лучше",9,41],["لَّكُمۡ","для вас",9,41],["إِن","если",9,41],["كُنتُمۡ","вы",9,41],["تَعۡلَمُونَ","знаете",9,41],[41]],[["لَوۡ","Если бы",9,42],["كَانَ","было",9,42],["عَرَضٗا","добыча",9,42],["قَرِيبٗا","близкая",9,42],["وَسَفَرٗا","и путь",9,42],["قَاصِدٗا","лёгкий",9,42],["لَّٱتَّبَعُوكَ","непременно последовали бы за тобой",9,42],["وَلَٰكِنۢ","но",9,42],["بَعُدَتۡ","далёким оказалось",9,42]],[["عَلَيۡهِمُ","для них",9,42],["ٱلشُّقَّةُۚ","расстояние",9,42],["وَسَيَحۡلِفُونَ","И будут клясться",9,42],["بِٱللَّهِ","Аллахом",9,42],["لَوِ","если бы",9,42],["ٱسۡتَطَعۡنَا","мы могли",9,42],["لَخَرَجۡنَا","непременно вышли бы мы",9,42]],[["مَعَكُمۡ","с вами",9,42],["يُهۡلِكُونَ","Они губят",9,42],["أَنفُسَهُمۡ","самих себя",9,42],["وَٱللَّهُ","А Аллах",9,42],["يَعۡلَمُ","знает",9,42],["إِنَّهُمۡ","что они",9,42],["لَكَٰذِبُونَ","непременно лжецы",9,42],[42]],[["عَفَا","Простил",9,43],["ٱللَّهُ","Аллах",9,43],["عَنكَ","тебя",9,43],["لِمَ","почему",9,43],["أَذِنتَ","ты позволил",9,43],["لَهُمۡ","им",9,43],["حَتَّىٰ","пока не",9,43],["يَتَبَيَّنَ","стало ясно",9,43],["لَكَ","тебе",9,43],["ٱلَّذِينَ","те, которые",9,43]],[["صَدَقُواْ","сказали правду",9,43],["وَتَعۡلَمَ","и узнал ты",9,43],["ٱلۡكَٰذِبِينَ","лжецов",9,43],[43],["لَا","Не",9,44],["يَسۡتَـٔۡذِنُكَ","просят у тебя позволения",9,44],["ٱلَّذِينَ","те, которые",9,44]],[["يُؤۡمِنُونَ","веруют",9,44],["بِٱللَّهِ","в Аллаха",9,44],["وَٱلۡيَوۡمِ","и в День",9,44],["ٱلۡأٓخِرِ","Последний",9,44],["أَن","чтобы",9,44],["يُجَٰهِدُواْ","сражаться",9,44],["بِأَمۡوَٰلِهِمۡ","своим имуществом",9,44]],[["وَأَنفُسِهِمۡۗ","и своими душами",9,44],["وَٱللَّهُ","И Аллах",9,44],["عَلِيمُۢ","Знающий",9,44],["بِٱلۡمُتَّقِينَ","о богобоязненных",9,44],[44],["إِنَّمَا","Только",9,45],["يَسۡتَـٔۡذِنُكَ","просят у тебя позволения",9,45],["ٱلَّذِينَ","те, которые",9,45]],[["لَا","не",9,45],["يُؤۡمِنُونَ","веруют",9,45],["بِٱللَّهِ","в Аллаха",9,45],["وَٱلۡيَوۡمِ","и в День",9,45],["ٱلۡأٓخِرِ","Последний",9,45],["وَٱرۡتَابَتۡ","и усомнились",9,45],["قُلُوبُهُمۡ","их сердца",9,45],["فَهُمۡ","и они",9,45]],[["فِي","в",9,45],["رَيۡبِهِمۡ","своём сомнении",9,45],["يَتَرَدَّدُونَ","колеблются",9,45],[45],["۞ وَلَوۡ","И если бы",9,46],["أَرَادُواْ","они желали",9,46],["ٱلۡخُرُوجَ","выступления",9,46]],[["لَأَعَدُّواْ","непременно подготовили бы",9,46],["لَهُۥ","для него",9,46],["عُدَّةٗ","снаряжение",9,46],["وَلَٰكِن","но",9,46],["كَرِهَ","счёл неугодным",9,46],["ٱللَّهُ","Аллах",9,46],["ٱنۢبِعَاثَهُمۡ","их выступление",9,46],["فَثَبَّطَهُمۡ","и Он задержал их",9,46]],[["وَقِيلَ","и было сказано",9,46],["ٱقۡعُدُواْ","сидите",9,46],["مَعَ","с",9,46],["ٱلۡقَٰعِدِينَ","сидящими",9,46],[46],["لَوۡ","Если бы",9,47],["خَرَجُواْ","они вышли",9,47],["فِيكُم","среди вас",9,47]],[["مَّا","не",9,47],["زَادُوكُمۡ","прибавили бы вам",9,47],["إِلَّا","кроме",9,47],["خَبَالٗا","смятения",9,47],["وَلَأَوۡضَعُواْ","и непременно сновали бы",9,47],["خِلَٰلَكُمۡ","между вами",9,47],["يَبۡغُونَكُمُ","желая вам",9,47]],[["ٱلۡفِتۡنَةَ","смуты",9,47],["وَفِيكُمۡ","А среди вас",9,47],["سَمَّٰعُونَ","охотно слушающие",9,47],["لَهُمۡۗ","их",9,47],["وَٱللَّهُ","И Аллах",9,47],["عَلِيمُۢ","Знающий",9,47],["بِٱلظَّٰلِمِينَ","о несправедливых",9,47],[47]]]}