{"p":195,"j":10,"a":[[9,48,["لَقَدِ","ٱبۡتَغَوُاْ","ٱلۡفِتۡنَةَ","مِن","قَبۡلُ","وَقَلَّبُواْ","لَكَ","ٱلۡأُمُورَ","حَتَّىٰ","جَآءَ","ٱلۡحَقُّ","وَظَهَرَ","أَمۡرُ","ٱللَّهِ","وَهُمۡ","كَٰرِهُونَ"],"лаḳадибтагавул фитната мин ḳаблу ваḳаллабуу лакал умуура хатта жаал хаḳḳу вазахара амруллахи вахум карихуун","Они и раньше домогались смуты и замышляли против тебя козни, пока не явилась истина и не проявилось веление Аллаха, хотя это и было им ненавистно.",["Уже","они домогались","смуты","ещё","раньше","и запутывали","тебе","дела","пока не","пришла","истина","и проявилось","веление","Аллаха","а они","ненавидящие (это)"]],[9,49,["وَمِنۡهُم","مَّن","يَقُولُ","ٱئۡذَن","لِّي","وَلَا","تَفۡتِنِّيٓۚ","أَلَا","فِي","ٱلۡفِتۡنَةِ","سَقَطُواْۗ","وَإِنَّ","جَهَنَّمَ","لَمُحِيطَةُۢ","بِٱلۡكَٰفِرِينَ"],"ваминхум ман йаḳуулузал лии вала тафтиннии ала фил фитнати саḳатуу ва'инна жаханнама ламухиитату билкафириин","Среди них есть и такой, который говорит: «Позволь мне остаться дома и не искушай меня!». Безусловно, они уже впали в искушение. Воистину, Геенна объемлет неверующих.",["И среди них","тот, кто","говорит","позволь","мне","и не","искушай меня","Знайте же","в","искушение","они впали","И поистине","Геенна","непременно объемлет","неверующих"]],[9,50,["إِن","تُصِبۡكَ","حَسَنَةٞ","تَسُؤۡهُمۡۖ","وَإِن","تُصِبۡكَ","مُصِيبَةٞ","يَقُولُواْ","قَدۡ","أَخَذۡنَآ","أَمۡرَنَا","مِن","قَبۡلُ","وَيَتَوَلَّواْ","وَّهُمۡ","فَرِحُونَ"],"ин тусибка хасанатун тасу'хум ва'ин тусибка мусиибатун йаḳуулуу ḳад ахазна амрана мин ḳаблу вайатаваллав вахум фарихуун","Если тебе достается благо, это огорчает их. Если же тебя постигает беда, они говорят: «Мы заранее приняли меры предосторожности для себя». И они уходят, забавляясь.",["Если","постигнет тебя","благо","огорчит их","а если","постигнет тебя","беда","скажут они","уже","мы приняли","наши меры","ещё","раньше","и отвернутся","а они","радующиеся"]],[9,51,["قُل","لَّن","يُصِيبَنَآ","إِلَّا","مَا","كَتَبَ","ٱللَّهُ","لَنَا","هُوَ","مَوۡلَىٰنَاۚ","وَعَلَى","ٱللَّهِ","فَلۡيَتَوَكَّلِ","ٱلۡمُؤۡمِنُونَ"],"ḳул лан йусиибана илла ма катабаллаху лана хуа маулана ва`алаллахи фалйатаваккалил му'минуун","Скажи: «Нас постигнет только то, что предписано нам Аллахом. Он - наш Покровитель. И пусть верующие уповают на одного Аллаха».",["Скажи","никогда не","постигнет нас","кроме","того, что","предписал","Аллах","нам","Он","наш Покровитель","И на","Аллаха","пусть уповают","верующие"]],[9,52,["قُلۡ","هَلۡ","تَرَبَّصُونَ","بِنَآ","إِلَّآ","إِحۡدَى","ٱلۡحُسۡنَيَيۡنِۖ","وَنَحۡنُ","نَتَرَبَّصُ","بِكُمۡ","أَن","يُصِيبَكُمُ","ٱللَّهُ","بِعَذَابٖ","مِّنۡ","عِندِهِۦٓ","أَوۡ","بِأَيۡدِينَاۖ","فَتَرَبَّصُوٓاْ","إِنَّا","مَعَكُم","مُّتَرَبِّصُونَ"],"ḳул хал тараббасууна бина илла ихдал хуснайайни ванахну натараббасу бикум ан йусиибакумуллаху би`азабим мин `индихии ау би'айдиина фатараббасуу инна ма`акум мутараббисуун","Скажи: «Неужели вы ожидаете, что нам выпадет что-либо, кроме одного из двух благ? Мы тоже ждем, что Аллах поразит вас мучениями от Себя или же накажет вас нашими руками. Ждите, и мы подождем вместе с вами».",["Скажи","разве","вы ожидаете","для нас","кроме","одного","из двух благ","а мы","ожидаем","для вас","что","поразит вас","Аллах","наказанием","от","Него","или","нашими руками","Так ждите","поистине, мы","с вами","ожидающие"]],[9,53,["قُلۡ","أَنفِقُواْ","طَوۡعًا","أَوۡ","كَرۡهٗا","لَّن","يُتَقَبَّلَ","مِنكُمۡ","إِنَّكُمۡ","كُنتُمۡ","قَوۡمٗا","فَٰسِقِينَ"],"ḳул анфиḳуу тау`ан ау кархал лан йутаḳаббала минкум иннакум кунтум ḳауман фасиḳиин","Скажи: «Станете ли вы делать пожертвования по доброй воле или по принуждению - от вас все равно не будет принято, поскольку вы являетесь людьми нечестивыми».",["Скажи","расходуйте","добровольно","или","по принуждению","никогда не","будет принято","от вас","поистине, вы","были","людьми","нечестивыми"]],[9,54,["وَمَا","مَنَعَهُمۡ","أَن","تُقۡبَلَ","مِنۡهُمۡ","نَفَقَٰتُهُمۡ","إِلَّآ","أَنَّهُمۡ","كَفَرُواْ","بِٱللَّهِ","وَبِرَسُولِهِۦ","وَلَا","يَأۡتُونَ","ٱلصَّلَوٰةَ","إِلَّا","وَهُمۡ","كُسَالَىٰ","وَلَا","يُنفِقُونَ","إِلَّا","وَهُمۡ","كَٰرِهُونَ"],"вама мана`ахум ан туḳбала минхум нафаḳатухум илла аннахум кафаруу биллахи вабирасуулихии вала йа'туунас салавата илла вахум кусала вала йунфиḳууна илла вахум карихуун","Тому, чтобы их пожертвования были приняты, мешает только то, что они не веруют в Аллаха и Его Посланника, лениво совершают намаз и нехотя делают пожертвования.",["И не","помешало им","чтобы","были приняты","от них","их пожертвования","кроме","того, что они","не уверовали","в Аллаха","и в Его Посланника","и не","приходят","к намазу","иначе как","будучи","ленивыми","и не","расходуют","иначе как","будучи","недовольными"]]],"m":[[["لَقَدِ","Уже",9,48],["ٱبۡتَغَوُاْ","они домогались",9,48],["ٱلۡفِتۡنَةَ","смуты",9,48],["مِن","ещё",9,48],["قَبۡلُ","раньше",9,48],["وَقَلَّبُواْ","и запутывали",9,48],["لَكَ","тебе",9,48],["ٱلۡأُمُورَ","дела",9,48],["حَتَّىٰ","пока не",9,48]],[["جَآءَ","пришла",9,48],["ٱلۡحَقُّ","истина",9,48],["وَظَهَرَ","и проявилось",9,48],["أَمۡرُ","веление",9,48],["ٱللَّهِ","Аллаха",9,48],["وَهُمۡ","а они",9,48],["كَٰرِهُونَ","ненавидящие (это)",9,48],[48]],[["وَمِنۡهُم","И среди них",9,49],["مَّن","тот, кто",9,49],["يَقُولُ","говорит",9,49],["ٱئۡذَن","позволь",9,49],["لِّي","мне",9,49],["وَلَا","и не",9,49],["تَفۡتِنِّيٓۚ","искушай меня",9,49],["أَلَا","Знайте же",9,49],["فِي","в",9,49],["ٱلۡفِتۡنَةِ","искушение",9,49]],[["سَقَطُواْۗ","они впали",9,49],["وَإِنَّ","И поистине",9,49],["جَهَنَّمَ","Геенна",9,49],["لَمُحِيطَةُۢ","непременно объемлет",9,49],["بِٱلۡكَٰفِرِينَ","неверующих",9,49]],[[49],["إِن","Если",9,50],["تُصِبۡكَ","постигнет тебя",9,50],["حَسَنَةٞ","благо",9,50],["تَسُؤۡهُمۡۖ","огорчит их",9,50],["وَإِن","а если",9,50],["تُصِبۡكَ","постигнет тебя",9,50]],[["مُصِيبَةٞ","беда",9,50],["يَقُولُواْ","скажут они",9,50],["قَدۡ","уже",9,50],["أَخَذۡنَآ","мы приняли",9,50],["أَمۡرَنَا","наши меры",9,50],["مِن","ещё",9,50],["قَبۡلُ","раньше",9,50],["وَيَتَوَلَّواْ","и отвернутся",9,50]],[["وَّهُمۡ","а они",9,50],["فَرِحُونَ","радующиеся",9,50],[50],["قُل","Скажи",9,51],["لَّن","никогда не",9,51],["يُصِيبَنَآ","постигнет нас",9,51],["إِلَّا","кроме",9,51],["مَا","того, что",9,51],["كَتَبَ","предписал",9,51]],[["ٱللَّهُ","Аллах",9,51],["لَنَا","нам",9,51],["هُوَ","Он",9,51],["مَوۡلَىٰنَاۚ","наш Покровитель",9,51],["وَعَلَى","И на",9,51],["ٱللَّهِ","Аллаха",9,51],["فَلۡيَتَوَكَّلِ","пусть уповают",9,51],["ٱلۡمُؤۡمِنُونَ","верующие",9,51]],[[51],["قُلۡ","Скажи",9,52],["هَلۡ","разве",9,52],["تَرَبَّصُونَ","вы ожидаете",9,52],["بِنَآ","для нас",9,52],["إِلَّآ","кроме",9,52],["إِحۡدَى","одного",9,52],["ٱلۡحُسۡنَيَيۡنِۖ","из двух благ",9,52],["وَنَحۡنُ","а мы",9,52]],[["نَتَرَبَّصُ","ожидаем",9,52],["بِكُمۡ","для вас",9,52],["أَن","что",9,52],["يُصِيبَكُمُ","поразит вас",9,52],["ٱللَّهُ","Аллах",9,52],["بِعَذَابٖ","наказанием",9,52],["مِّنۡ","от",9,52],["عِندِهِۦٓ","Него",9,52]],[["أَوۡ","или",9,52],["بِأَيۡدِينَاۖ","нашими руками",9,52],["فَتَرَبَّصُوٓاْ","Так ждите",9,52],["إِنَّا","поистине, мы",9,52],["مَعَكُم","с вами",9,52],["مُّتَرَبِّصُونَ","ожидающие",9,52],[52],["قُلۡ","Скажи",9,53]],[["أَنفِقُواْ","расходуйте",9,53],["طَوۡعًا","добровольно",9,53],["أَوۡ","или",9,53],["كَرۡهٗا","по принуждению",9,53],["لَّن","никогда не",9,53],["يُتَقَبَّلَ","будет принято",9,53],["مِنكُمۡ","от вас",9,53],["إِنَّكُمۡ","поистине, вы",9,53],["كُنتُمۡ","были",9,53]],[["قَوۡمٗا","людьми",9,53],["فَٰسِقِينَ","нечестивыми",9,53],[53],["وَمَا","И не",9,54],["مَنَعَهُمۡ","помешало им",9,54],["أَن","чтобы",9,54],["تُقۡبَلَ","были приняты",9,54],["مِنۡهُمۡ","от них",9,54],["نَفَقَٰتُهُمۡ","их пожертвования",9,54]],[["إِلَّآ","кроме",9,54],["أَنَّهُمۡ","того, что они",9,54],["كَفَرُواْ","не уверовали",9,54],["بِٱللَّهِ","в Аллаха",9,54],["وَبِرَسُولِهِۦ","и в Его Посланника",9,54],["وَلَا","и не",9,54],["يَأۡتُونَ","приходят",9,54],["ٱلصَّلَوٰةَ","к намазу",9,54]],[["إِلَّا","иначе как",9,54],["وَهُمۡ","будучи",9,54],["كُسَالَىٰ","ленивыми",9,54],["وَلَا","и не",9,54],["يُنفِقُونَ","расходуют",9,54],["إِلَّا","иначе как",9,54],["وَهُمۡ","будучи",9,54],["كَٰرِهُونَ","недовольными",9,54],[54]]]}