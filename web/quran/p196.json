{"p":196,"j":10,"a":[[9,55,["فَلَا","تُعۡجِبۡكَ","أَمۡوَٰلُهُمۡ","وَلَآ","أَوۡلَٰدُهُمۡۚ","إِنَّمَا","يُرِيدُ","ٱللَّهُ","لِيُعَذِّبَهُم","بِهَا","فِي","ٱلۡحَيَوٰةِ","ٱلدُّنۡيَا","وَتَزۡهَقَ","أَنفُسُهُمۡ","وَهُمۡ","كَٰفِرُونَ"],"фала ту`жибка амвалухум вала ауладухум иннама йуриидуллаху лийу`аззибахум биха фил хайаватид дунйа ватазхаḳа анфусухум вахум кафируун","Пусть не восхищают тебя их имущество и дети. Аллах желает только наказать их детьми и имуществом в мирской жизни, дабы они расстались со своими душами неверующими.",["пусть же не","восхищают тебя","их имущество","и не","их дети","лишь","желает","Аллах","чтобы наказать их","этим","в","жизни","мирской","и (чтобы) вышли","их души","когда они","неверующие"]],[9,56,["وَيَحۡلِفُونَ","بِٱللَّهِ","إِنَّهُمۡ","لَمِنكُمۡ","وَمَا","هُم","مِّنكُمۡ","وَلَٰكِنَّهُمۡ","قَوۡمٞ","يَفۡرَقُونَ"],"вайахлифууна биллахи иннахум ламинкум вама хум минкум валакиннахум ḳаумун йафраḳуун","Они клянутся Аллахом, что принадлежат к вам. Однако они не принадлежат к вам. Напротив, они - боязливые люди.",["и они клянутся","Аллахом","что они","поистине из вас","но не","они","из вас","но они","люди","(которые) боятся"]],[9,57,["لَوۡ","يَجِدُونَ","مَلۡجَـًٔا","أَوۡ","مَغَٰرَٰتٍ","أَوۡ","مُدَّخَلٗا","لَّوَلَّوۡاْ","إِلَيۡهِ","وَهُمۡ","يَجۡمَحُونَ"],"лау йажидууна малжаан ау магаратин ау муддахалал лаваллау илайхи вахум йажмахуун","Если бы они нашли убежище, пещеру или укрытие, то они поспешно направились бы туда.",["если бы","они нашли","убежище","или","пещеры","или","укрытие","непременно повернули бы","к нему","и они","устремляются (поспешно)"]],[9,58,["وَمِنۡهُم","مَّن","يَلۡمِزُكَ","فِي","ٱلصَّدَقَٰتِ","فَإِنۡ","أُعۡطُواْ","مِنۡهَا","رَضُواْ","وَإِن","لَّمۡ","يُعۡطَوۡاْ","مِنۡهَآ","إِذَا","هُمۡ","يَسۡخَطُونَ"],"ваминхум ман йалмизука фис садаḳати фа'ин у`туу минха радуу ва'ил лам йу`тау минха иза хум йасхатуун","Среди них есть такие, которые обвиняют тебя из-за милостыни. Если им достается что-либо из милостыни, то они остаются довольными, если же им ничего не достается, то они приходят в ярость.",["и среди них","(есть) тот, кто","порицает тебя","относительно","милостынь","и если","им даётся","из них","они довольны","а если","не","им даётся","из них","тогда","они","гневаются"]],[9,59,["وَلَوۡ","أَنَّهُمۡ","رَضُواْ","مَآ","ءَاتَىٰهُمُ","ٱللَّهُ","وَرَسُولُهُۥ","وَقَالُواْ","حَسۡبُنَا","ٱللَّهُ","سَيُؤۡتِينَا","ٱللَّهُ","مِن","فَضۡلِهِۦ","وَرَسُولُهُۥٓ","إِنَّآ","إِلَى","ٱللَّهِ","رَٰغِبُونَ"],"валау аннахум радуу ма атахумуллаху варасуулухуу ваḳалуу хасбуналлаху сайу'тииналлаху мин фадлихии варасуулухуу инна илаллахи рагибуун","Лучше бы они довольствовались тем, что дали им Аллах и Его Посланник, и сказали: «Нам достаточно Аллаха. Аллах одарит нас из Своей милости, а также Его Посланник. Воистину, мы устремляемся к Аллаху!»",["и если бы","что они","довольствовались","тем, что","дал им","Аллах","и Его Посланник","и сказали","достаточно нам","Аллаха","даст нам","Аллах","из","Своей милости","и Его Посланник","поистине, мы","к","Аллаху","устремляемся"]],[9,60,["إِنَّمَا","ٱلصَّدَقَٰتُ","لِلۡفُقَرَآءِ","وَٱلۡمَسَٰكِينِ","وَٱلۡعَٰمِلِينَ","عَلَيۡهَا","وَٱلۡمُؤَلَّفَةِ","قُلُوبُهُمۡ","وَفِي","ٱلرِّقَابِ","وَٱلۡغَٰرِمِينَ","وَفِي","سَبِيلِ","ٱللَّهِ","وَٱبۡنِ","ٱلسَّبِيلِۖ","فَرِيضَةٗ","مِّنَ","ٱللَّهِۗ","وَٱللَّهُ","عَلِيمٌ","حَكِيمٞ"],"иннамас садаḳату лилфуḳараи валмасакиини вал`амилиина `алайха валмуаллафати ḳулуубухум вафир риḳаби валгаримиина вафии сабиилиллахи вабнис сабиили фариидатам миналлахи валлаху `алиимун хакиим","Пожертвования предназначены для неимущих и бедных, для тех, кто занимается их сбором и распределением, и для тех, чьи сердца хотят завоевать, для выкупа рабов, для должников, для расходов на пути Аллаха и для путников. Таково предписание Аллаха. Воистину, Аллах - Знающий, Мудрый.",["лишь","милостыни","для бедных","и неимущих","и занятых","ими (сбором)","и (тех, чьи) расположены","сердца их","и на","(освобождение) рабов","и должников","и на","пути","Аллаха","и сына","пути (путника)","предписание","от","Аллаха","и Аллах","Знающий","Мудрый"]],[9,61,["وَمِنۡهُمُ","ٱلَّذِينَ","يُؤۡذُونَ","ٱلنَّبِيَّ","وَيَقُولُونَ","هُوَ","أُذُنٞۚ","قُلۡ","أُذُنُ","خَيۡرٖ","لَّكُمۡ","يُؤۡمِنُ","بِٱللَّهِ","وَيُؤۡمِنُ","لِلۡمُؤۡمِنِينَ","وَرَحۡمَةٞ","لِّلَّذِينَ","ءَامَنُواْ","مِنكُمۡۚ","وَٱلَّذِينَ","يُؤۡذُونَ","رَسُولَ","ٱللَّهِ","لَهُمۡ","عَذَابٌ","أَلِيمٞ"],"ваминхумул лазиина йу'зуунан набиййа вайаḳуулууна хуа узунун ḳул узуну хайрил лакум йу'мину биллахи вайу'мину лилму'миниина варахматул лиллазиина амануу минкум валлазиина йу'зууна расуулаллахи лахум `азабун алиим","Среди них есть такие, которые обижают Пророка и говорят: «Он есть ухо (выслушивает любые новости)». Скажи: «Он слушает только то, что лучше для вас. Он верует в Аллаха и доверяет верующим. Он является милостью для тех, которые уверовали». Тем же, которые обижают Посланника Аллаха, уготованы мучительные страдания.",["и среди них","те, которые","обижают","Пророка","и говорят","он","ухо","скажи","ухо","добра","для вас","он верует","в Аллаха","и доверяет","верующим","и милость","для тех, которые","уверовали","из вас","а те, которые","обижают","Посланника","Аллаха","им","наказание","мучительное"]]],"m":[[["فَلَا","пусть же не",9,55],["تُعۡجِبۡكَ","восхищают тебя",9,55],["أَمۡوَٰلُهُمۡ","их имущество",9,55],["وَلَآ","и не",9,55],["أَوۡلَٰدُهُمۡۚ","их дети",9,55],["إِنَّمَا","лишь",9,55],["يُرِيدُ","желает",9,55],["ٱللَّهُ","Аллах",9,55],["لِيُعَذِّبَهُم","чтобы наказать их",9,55]],[["بِهَا","этим",9,55],["فِي","в",9,55],["ٱلۡحَيَوٰةِ","жизни",9,55],["ٱلدُّنۡيَا","мирской",9,55],["وَتَزۡهَقَ","и (чтобы) вышли",9,55],["أَنفُسُهُمۡ","их души",9,55],["وَهُمۡ","когда они",9,55],["كَٰفِرُونَ","неверующие",9,55],[55]],[["وَيَحۡلِفُونَ","и они клянутся",9,56],["بِٱللَّهِ","Аллахом",9,56],["إِنَّهُمۡ","что они",9,56],["لَمِنكُمۡ","поистине из вас",9,56],["وَمَا","но не",9,56],["هُم","они",9,56],["مِّنكُمۡ","из вас",9,56],["وَلَٰكِنَّهُمۡ","но они",9,56]],[["قَوۡمٞ","люди",9,56],["يَفۡرَقُونَ","(которые) боятся",9,56],[56],["لَوۡ","если бы",9,57],["يَجِدُونَ","они нашли",9,57],["مَلۡجَـًٔا","убежище",9,57],["أَوۡ","или",9,57],["مَغَٰرَٰتٍ","пещеры",9,57]],[["أَوۡ","или",9,57],["مُدَّخَلٗا","укрытие",9,57],["لَّوَلَّوۡاْ","непременно повернули бы",9,57],["إِلَيۡهِ","к нему",9,57],["وَهُمۡ","и они",9,57],["يَجۡمَحُونَ","устремляются (поспешно)",9,57],[57],["وَمِنۡهُم","и среди них",9,58],["مَّن","(есть) тот, кто",9,58],["يَلۡمِزُكَ","порицает тебя",9,58]],[["فِي","относительно",9,58],["ٱلصَّدَقَٰتِ","милостынь",9,58],["فَإِنۡ","и если",9,58],["أُعۡطُواْ","им даётся",9,58],["مِنۡهَا","из них",9,58],["رَضُواْ","они довольны",9,58],["وَإِن","а если",9,58],["لَّمۡ","не",9,58],["يُعۡطَوۡاْ","им даётся",9,58],["مِنۡهَآ","из них",9,58],["إِذَا","тогда",9,58]],[["هُمۡ","они",9,58],["يَسۡخَطُونَ","гневаются",9,58],[58],["وَلَوۡ","и если бы",9,59],["أَنَّهُمۡ","что они",9,59],["رَضُواْ","довольствовались",9,59],["مَآ","тем, что",9,59],["ءَاتَىٰهُمُ","дал им",9,59],["ٱللَّهُ","Аллах",9,59]],[["وَرَسُولُهُۥ","и Его Посланник",9,59],["وَقَالُواْ","и сказали",9,59],["حَسۡبُنَا","достаточно нам",9,59],["ٱللَّهُ","Аллаха",9,59],["سَيُؤۡتِينَا","даст нам",9,59],["ٱللَّهُ","Аллах",9,59],["مِن","из",9,59],["فَضۡلِهِۦ","Своей милости",9,59]],[["وَرَسُولُهُۥٓ","и Его Посланник",9,59],["إِنَّآ","поистине, мы",9,59],["إِلَى","к",9,59],["ٱللَّهِ","Аллаху",9,59],["رَٰغِبُونَ","устремляемся",9,59],[59],["۞ إِنَّمَا","лишь",9,60],["ٱلصَّدَقَٰتُ","милостыни",9,60]],[["لِلۡفُقَرَآءِ","для бедных",9,60],["وَٱلۡمَسَٰكِينِ","и неимущих",9,60],["وَٱلۡعَٰمِلِينَ","и занятых",9,60],["عَلَيۡهَا","ими (сбором)",9,60],["وَٱلۡمُؤَلَّفَةِ","и (тех, чьи) расположены",9,60],["قُلُوبُهُمۡ","сердца их",9,60]],[["وَفِي","и на",9,60],["ٱلرِّقَابِ","(освобождение) рабов",9,60],["وَٱلۡغَٰرِمِينَ","и должников",9,60],["وَفِي","и на",9,60],["سَبِيلِ","пути",9,60],["ٱللَّهِ","Аллаха",9,60],["وَٱبۡنِ","и сына",9,60],["ٱلسَّبِيلِۖ","пути (путника)",9,60]],[["فَرِيضَةٗ","предписание",9,60],["مِّنَ","от",9,60],["ٱللَّهِۗ","Аллаха",9,60],["وَٱللَّهُ","и Аллах",9,60],["عَلِيمٌ","Знающий",9,60],["حَكِيمٞ","Мудрый",9,60],[60],["وَمِنۡهُمُ","и среди них",9,61]],[["ٱلَّذِينَ","те, которые",9,61],["يُؤۡذُونَ","обижают",9,61],["ٱلنَّبِيَّ","Пророка",9,61],["وَيَقُولُونَ","и говорят",9,61],["هُوَ","он",9,61],["أُذُنٞۚ","ухо",9,61],["قُلۡ","скажи",9,61],["أُذُنُ","ухо",9,61],["خَيۡرٖ","добра",9,61]],[["لَّكُمۡ","для вас",9,61],["يُؤۡمِنُ","он верует",9,61],["بِٱللَّهِ","в Аллаха",9,61],["وَيُؤۡمِنُ","и доверяет",9,61],["لِلۡمُؤۡمِنِينَ","верующим",9,61],["وَرَحۡمَةٞ","и милость",9,61],["لِّلَّذِينَ","для тех, которые",9,61]],[["ءَامَنُواْ","уверовали",9,61],["مِنكُمۡۚ","из вас",9,61],["وَٱلَّذِينَ","а те, которые",9,61],["يُؤۡذُونَ","обижают",9,61],["رَسُولَ","Посланника",9,61],["ٱللَّهِ","Аллаха",9,61],["لَهُمۡ","им",9,61],["عَذَابٌ","наказание",9,61],["أَلِيمٞ","мучительное",9,61],[61]]]}