{"p":197,"j":10,"a":[[9,62,["يَحۡلِفُونَ","بِٱللَّهِ","لَكُمۡ","لِيُرۡضُوكُمۡ","وَٱللَّهُ","وَرَسُولُهُۥٓ","أَحَقُّ","أَن","يُرۡضُوهُ","إِن","كَانُواْ","مُؤۡمِنِينَ"],"йахлифууна биллахи лакум лийурдуукум валлаху варасуулухуу ахаḳḳу ан йурдууху ин кануу му'миниин","Они клянутся Аллахом, чтобы угодить вам. Но для них было бы лучше, если только они являются верующими, угождать Аллаху и Его Посланнику.",["они клянутся","Аллахом","вам","чтобы угодить вам","а Аллах","и Его Посланник","достойнее","чтобы","угождали Ему","если","они","верующие"]],[9,63,["أَلَمۡ","يَعۡلَمُوٓاْ","أَنَّهُۥ","مَن","يُحَادِدِ","ٱللَّهَ","وَرَسُولَهُۥ","فَأَنَّ","لَهُۥ","نَارَ","جَهَنَّمَ","خَٰلِدٗا","فِيهَاۚ","ذَٰلِكَ","ٱلۡخِزۡيُ","ٱلۡعَظِيمُ"],"алам йа`ламуу аннахуу ман йухадидиллаха варасуулахуу фа'анна лахуу нара жаханнама халидан фииха заликал хизйул `азиим","Разве они не знали, что тому, кто проявляет враждебность к Аллаху и Его Посланнику, навеки уготован огонь Геенны? Это - великое бесчестие.",["разве не","знали они","что он","кто","противится","Аллаху","и Его Посланнику","то ведь","ему","огонь","Геенны","вечно пребывающим","в нём","это","позор","великий"]],[9,64,["يَحۡذَرُ","ٱلۡمُنَٰفِقُونَ","أَن","تُنَزَّلَ","عَلَيۡهِمۡ","سُورَةٞ","تُنَبِّئُهُم","بِمَا","فِي","قُلُوبِهِمۡۚ","قُلِ","ٱسۡتَهۡزِءُوٓاْ","إِنَّ","ٱللَّهَ","مُخۡرِجٞ","مَّا","تَحۡذَرُونَ"],"йахзарул мунафиḳууна ан туназзала `алайхим сууратун тунаббиухум бима фии ḳулуубихим ḳулистахзиуу инналлаха мухрижум ма тахзаруун","Лицемеры опасаются, что им будет ниспослана сура, которая поведает о том, что в их сердцах. Скажи: «Насмехайтесь! Аллах непременно выведет наружу то, чего вы опасаетесь».",["опасаются","лицемеры","что","будет ниспослана","о них","сура","сообщающая им","о том, что","в","их сердцах","скажи","насмехайтесь","поистине","Аллах","выводящий наружу","то, что","вы опасаетесь"]],[9,65,["وَلَئِن","سَأَلۡتَهُمۡ","لَيَقُولُنَّ","إِنَّمَا","كُنَّا","نَخُوضُ","وَنَلۡعَبُۚ","قُلۡ","أَبِٱللَّهِ","وَءَايَٰتِهِۦ","وَرَسُولِهِۦ","كُنتُمۡ","تَسۡتَهۡزِءُونَ"],"валаин са'алтахум лайаḳуулунна иннама кунна нахууду ванал`абу ḳул абиллахи ва'айатихии варасуулихии кунтум тастахзиуун","Если ты их спросишь, они непременно скажут: «Мы только болтали и забавлялись». Скажи: «Неужели вы насмехались над Аллахом, Его аятами и Его Посланником?",["и если","ты спросишь их","непременно скажут","лишь","мы были","болтаем","и забавляемся","скажи","неужели над Аллахом","и Его аятами","и Его Посланником","вы были","насмехаетесь"]],[9,66,["لَا","تَعۡتَذِرُواْ","قَدۡ","كَفَرۡتُم","بَعۡدَ","إِيمَٰنِكُمۡۚ","إِن","نَّعۡفُ","عَن","طَآئِفَةٖ","مِّنكُمۡ","نُعَذِّبۡ","طَآئِفَةَۢ","بِأَنَّهُمۡ","كَانُواْ","مُجۡرِمِينَ"],"ла та`тазируу ḳад кафартум ба`да ииманикум ин на`фу `ан таифатим минкум ну`аззиб таифата би'аннахум кануу мужримиин","Не извиняйтесь. Вы стали неверующими после того, как уверовали». Если Мы простим некоторых из вас, то непременно подвергнем мучениям остальных за то, что они стали грешниками.",["не","извиняйтесь","уже","вы стали неверующими","после","вашей веры","если","Мы простим","(с) от","часть","из вас","Мы накажем","(другую) часть","за то, что они","были","грешниками"]],[9,67,["ٱلۡمُنَٰفِقُونَ","وَٱلۡمُنَٰفِقَٰتُ","بَعۡضُهُم","مِّنۢ","بَعۡضٖۚ","يَأۡمُرُونَ","بِٱلۡمُنكَرِ","وَيَنۡهَوۡنَ","عَنِ","ٱلۡمَعۡرُوفِ","وَيَقۡبِضُونَ","أَيۡدِيَهُمۡۚ","نَسُواْ","ٱللَّهَ","فَنَسِيَهُمۡۚ","إِنَّ","ٱلۡمُنَٰفِقِينَ","هُمُ","ٱلۡفَٰسِقُونَ"],"алмунафиḳууна валмунафиḳату ба`духум мим ба`дин йа'мурууна билмункари вайанхауна `анил ма`рууфи вайаḳбидууна айдийахум насуллаха фанасийахум иннал мунафиḳиина хумул фасиḳуун","Лицемеры и лицемерки подобны друг другу. Они велят совершать предосудительное, запрещают одобряемое и сжимают свои руки (скупятся делать пожертвования). Они предали забвению Аллаха, и Он предал их забвению. Воистину, лицемеры являются нечестивцами!",["лицемеры","и лицемерки","одни из них","от","других","они велят","предосудительное","и удерживают","от","одобряемого","и сжимают","свои руки","они забыли","Аллаха","и Он забыл их","поистине","лицемеры","они","нечестивцы"]],[9,68,["وَعَدَ","ٱللَّهُ","ٱلۡمُنَٰفِقِينَ","وَٱلۡمُنَٰفِقَٰتِ","وَٱلۡكُفَّارَ","نَارَ","جَهَنَّمَ","خَٰلِدِينَ","فِيهَاۚ","هِيَ","حَسۡبُهُمۡۚ","وَلَعَنَهُمُ","ٱللَّهُۖ","وَلَهُمۡ","عَذَابٞ","مُّقِيمٞ"],"ва`адаллахул мунафиḳиина валмунафиḳати валкуффара нара жаханнама халидиина фииха хийа хасбухум вала`анахумуллаху валахум `азабум муḳиим","Лицемерам, лицемеркам и неверующим Аллах обещал огонь Геенны, в котором они пребудут вечно. Довольно с них этого! Аллах проклял их, и им уготованы вечные мучения.",["обещал","Аллах","лицемерам","и лицемеркам","и неверующим","огонь","Геенны","вечно пребывающими","в нём","он","достаточен им","и проклял их","Аллах","и им","наказание","постоянное"]]],"m":[[["يَحۡلِفُونَ","они клянутся",9,62],["بِٱللَّهِ","Аллахом",9,62],["لَكُمۡ","вам",9,62],["لِيُرۡضُوكُمۡ","чтобы угодить вам",9,62],["وَٱللَّهُ","а Аллах",9,62],["وَرَسُولُهُۥٓ","и Его Посланник",9,62],["أَحَقُّ","достойнее",9,62]],[["أَن","чтобы",9,62],["يُرۡضُوهُ","угождали Ему",9,62],["إِن","если",9,62],["كَانُواْ","они",9,62],["مُؤۡمِنِينَ","верующие",9,62],[62],["أَلَمۡ","разве не",9,63],["يَعۡلَمُوٓاْ","знали они",9,63],["أَنَّهُۥ","что он",9,63]],[["مَن","кто",9,63],["يُحَادِدِ","противится",9,63],["ٱللَّهَ","Аллаху",9,63],["وَرَسُولَهُۥ","и Его Посланнику",9,63],["فَأَنَّ","то ведь",9,63],["لَهُۥ","ему",9,63],["نَارَ","огонь",9,63],["جَهَنَّمَ","Геенны",9,63],["خَٰلِدٗا","вечно пребывающим",9,63],["فِيهَاۚ","в нём",9,63]],[["ذَٰلِكَ","это",9,63],["ٱلۡخِزۡيُ","позор",9,63],["ٱلۡعَظِيمُ","великий",9,63],[63],["يَحۡذَرُ","опасаются",9,64],["ٱلۡمُنَٰفِقُونَ","лицемеры",9,64]],[["أَن","что",9,64],["تُنَزَّلَ","будет ниспослана",9,64],["عَلَيۡهِمۡ","о них",9,64],["سُورَةٞ","сура",9,64],["تُنَبِّئُهُم","сообщающая им",9,64],["بِمَا","о том, что",9,64],["فِي","в",9,64],["قُلُوبِهِمۡۚ","их сердцах",9,64],["قُلِ","скажи",9,64],["ٱسۡتَهۡزِءُوٓاْ","насмехайтесь",9,64]],[["إِنَّ","поистине",9,64],["ٱللَّهَ","Аллах",9,64],["مُخۡرِجٞ","выводящий наружу",9,64],["مَّا","то, что",9,64],["تَحۡذَرُونَ","вы опасаетесь",9,64],[64],["وَلَئِن","и если",9,65],["سَأَلۡتَهُمۡ","ты спросишь их",9,65]],[["لَيَقُولُنَّ","непременно скажут",9,65],["إِنَّمَا","лишь",9,65],["كُنَّا","мы были",9,65],["نَخُوضُ","болтаем",9,65],["وَنَلۡعَبُۚ","и забавляемся",9,65],["قُلۡ","скажи",9,65],["أَبِٱللَّهِ","неужели над Аллахом",9,65],["وَءَايَٰتِهِۦ","и Его аятами",9,65]],[["وَرَسُولِهِۦ","и Его Посланником",9,65],["كُنتُمۡ","вы были",9,65],["تَسۡتَهۡزِءُونَ","насмехаетесь",9,65],[65],["لَا","не",9,66],["تَعۡتَذِرُواْ","извиняйтесь",9,66],["قَدۡ","уже",9,66],["كَفَرۡتُم","вы стали неверующими",9,66]],[["بَعۡدَ","после",9,66],["إِيمَٰنِكُمۡۚ","вашей веры",9,66],["إِن","если",9,66],["نَّعۡفُ","Мы простим",9,66],["عَن","(с) от",9,66],["طَآئِفَةٖ","часть",9,66],["مِّنكُمۡ","из вас",9,66],["نُعَذِّبۡ","Мы накажем",9,66],["طَآئِفَةَۢ","(другую) часть",9,66]],[["بِأَنَّهُمۡ","за то, что они",9,66],["كَانُواْ","были",9,66],["مُجۡرِمِينَ","грешниками",9,66],[66],["ٱلۡمُنَٰفِقُونَ","лицемеры",9,67],["وَٱلۡمُنَٰفِقَٰتُ","и лицемерки",9,67]],[["بَعۡضُهُم","одни из них",9,67],["مِّنۢ","от",9,67],["بَعۡضٖۚ","других",9,67],["يَأۡمُرُونَ","они велят",9,67],["بِٱلۡمُنكَرِ","предосудительное",9,67],["وَيَنۡهَوۡنَ","и удерживают",9,67]],[["عَنِ","от",9,67],["ٱلۡمَعۡرُوفِ","одобряемого",9,67],["وَيَقۡبِضُونَ","и сжимают",9,67],["أَيۡدِيَهُمۡۚ","свои руки",9,67],["نَسُواْ","они забыли",9,67],["ٱللَّهَ","Аллаха",9,67],["فَنَسِيَهُمۡۚ","и Он забыл их",9,67]],[["إِنَّ","поистине",9,67],["ٱلۡمُنَٰفِقِينَ","лицемеры",9,67],["هُمُ","они",9,67],["ٱلۡفَٰسِقُونَ","нечестивцы",9,67],[67],["وَعَدَ","обещал",9,68],["ٱللَّهُ","Аллах",9,68]],[["ٱلۡمُنَٰفِقِينَ","лицемерам",9,68],["وَٱلۡمُنَٰفِقَٰتِ","и лицемеркам",9,68],["وَٱلۡكُفَّارَ","и неверующим",9,68],["نَارَ","огонь",9,68],["جَهَنَّمَ","Геенны",9,68],["خَٰلِدِينَ","вечно пребывающими",9,68]],[["فِيهَاۚ","в нём",9,68],["هِيَ","он",9,68],["حَسۡبُهُمۡۚ","достаточен им",9,68],["وَلَعَنَهُمُ","и проклял их",9,68],["ٱللَّهُۖ","Аллах",9,68],["وَلَهُمۡ","и им",9,68],["عَذَابٞ","наказание",9,68],["مُّقِيمٞ","постоянное",9,68],[68]]]}