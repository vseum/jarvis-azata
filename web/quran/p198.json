{"p":198,"j":10,"a":[[9,69,["كَٱلَّذِينَ","مِن","قَبۡلِكُمۡ","كَانُوٓاْ","أَشَدَّ","مِنكُمۡ","قُوَّةٗ","وَأَكۡثَرَ","أَمۡوَٰلٗا","وَأَوۡلَٰدٗا","فَٱسۡتَمۡتَعُواْ","بِخَلَٰقِهِمۡ","فَٱسۡتَمۡتَعۡتُم","بِخَلَٰقِكُمۡ","كَمَا","ٱسۡتَمۡتَعَ","ٱلَّذِينَ","مِن","قَبۡلِكُم","بِخَلَٰقِهِمۡ","وَخُضۡتُمۡ","كَٱلَّذِي","خَاضُوٓاْۚ","أُوْلَٰٓئِكَ","حَبِطَتۡ","أَعۡمَٰلُهُمۡ","فِي","ٱلدُّنۡيَا","وَٱلۡأٓخِرَةِۖ","وَأُوْلَٰٓئِكَ","هُمُ","ٱلۡخَٰسِرُونَ"],"каллазиина мин ḳабликум кануу ашадда минкум ḳувватан ва'аксара амвалан ва'ауладан фастамта`уу бихалаḳихим фастамта`тум бихалаḳикум камастамта`ал лазиина мин ḳабликум бихалаḳихим вахудтум каллазии хадуу улаика хабитат а`малухум фид дунйа вал'ахирати ва'улаика хумул хасируун","Они подобны тем, которые жили до вас. Они превосходили вас силой, и у них было больше имущества и детей. Они насладились своей долей. Вы тоже насладились своей долей, подобно вашим предшественникам. Вы погружались в словоблудие, подобно им. Их деяния тщетны как в этом мире, так и в Последней жизни. Они являются потерпевшими убыток.",["как те, которые","до","вас","были они","сильнее","вас","мощью","и больше","имуществом","и детьми","и насладились они","своей долей","и насладились вы","своей долей","как","насладились","те, которые","до","вас","своей долей","и вы погрузились (в пустое)","как те, что","погрузились","те","тщетны","их деяния","в","мире (этом)","и в Последней жизни","и те","они","потерпевшие убыток"]],[9,70,["أَلَمۡ","يَأۡتِهِمۡ","نَبَأُ","ٱلَّذِينَ","مِن","قَبۡلِهِمۡ","قَوۡمِ","نُوحٖ","وَعَادٖ","وَثَمُودَ","وَقَوۡمِ","إِبۡرَٰهِيمَ","وَأَصۡحَٰبِ","مَدۡيَنَ","وَٱلۡمُؤۡتَفِكَٰتِۚ","أَتَتۡهُمۡ","رُسُلُهُم","بِٱلۡبَيِّنَٰتِۖ","فَمَا","كَانَ","ٱللَّهُ","لِيَظۡلِمَهُمۡ","وَلَٰكِن","كَانُوٓاْ","أَنفُسَهُمۡ","يَظۡلِمُونَ"],"алам йа'тихим набаул лазиина мин ḳаблихим ḳауми нуухин ва`адин васамууда ваḳауми ибрахиима ва'асхаби мадйана валму'тафикати ататхум русулухум билбаййинати фама каналлаху лийазлимахум валакин кануу анфусахум йазлимуун","Разве до них не дошли рассказы о тех, кто жил до них: народе Нуха (Ноя), адитах, самудянах, народе Ибрахима (Авраама), жителях Мадьяна и опрокинутых селений (селений народа Лута)? Посланники приходили к ним с ясными знамениями. Аллах не был несправедлив к ним - они сами поступали несправедливо по отношению к себе.",["разве не","пришло к ним","известие","о тех, которые","до","них","народа","Нуха","и адитов","и самудян","и народа","Ибрахима","и жителей","Мадьяна","и опрокинутых (селений)","пришли к ним","их посланники","с ясными знамениями","и не","был","Аллах","(таков), чтобы обидеть их","но","были они","самих себя","обижающими"]],[9,71,["وَٱلۡمُؤۡمِنُونَ","وَٱلۡمُؤۡمِنَٰتُ","بَعۡضُهُمۡ","أَوۡلِيَآءُ","بَعۡضٖۚ","يَأۡمُرُونَ","بِٱلۡمَعۡرُوفِ","وَيَنۡهَوۡنَ","عَنِ","ٱلۡمُنكَرِ","وَيُقِيمُونَ","ٱلصَّلَوٰةَ","وَيُؤۡتُونَ","ٱلزَّكَوٰةَ","وَيُطِيعُونَ","ٱللَّهَ","وَرَسُولَهُۥٓۚ","أُوْلَٰٓئِكَ","سَيَرۡحَمُهُمُ","ٱللَّهُۗ","إِنَّ","ٱللَّهَ","عَزِيزٌ","حَكِيمٞ"],"валму'минууна валму'минату ба`духум аулийау ба`дин йа'мурууна билма`рууфи вайанхауна `анил мункари вайуḳиимуунас салавата вайу'тууназ закавата вайутии`ууналлаха варасуулахуу улаика сайархамухумуллаху инналлаха `азиизун хакиим","Верующие мужчины и женщины являются помощниками и друзьями друг другу. Они велят совершать одобряемое и запрещают предосудительное, совершают намаз, выплачивают закят, повинуются Аллаху и Его Посланнику. Аллах смилостивится над ними. Воистину, Аллах - Могущественный, Мудрый.",["и верующие","и верующие женщины","одни из них","помощники","других","они велят","одобряемое","и удерживают","от","предосудительного","и выстаивают","намаз","и дают","закят","и повинуются","Аллаху","и Его Посланнику","те","помилует их","Аллах","поистине","Аллах","Могущественный","Мудрый"]],[9,72,["وَعَدَ","ٱللَّهُ","ٱلۡمُؤۡمِنِينَ","وَٱلۡمُؤۡمِنَٰتِ","جَنَّٰتٖ","تَجۡرِي","مِن","تَحۡتِهَا","ٱلۡأَنۡهَٰرُ","خَٰلِدِينَ","فِيهَا","وَمَسَٰكِنَ","طَيِّبَةٗ","فِي","جَنَّٰتِ","عَدۡنٖۚ","وَرِضۡوَٰنٞ","مِّنَ","ٱللَّهِ","أَكۡبَرُۚ","ذَٰلِكَ","هُوَ","ٱلۡفَوۡزُ","ٱلۡعَظِيمُ"],"ва`адаллахул му'миниина валму'минати жаннатин тажрии мин тахтихал анхару халидиина фииха вамасакина таййибатан фии жаннати `аднин варидванум миналлахи акбару залика хуал фаузул `азиим","Аллах обещал верующим мужчинам и женщинам Райские сады, в которых текут реки и в которых они пребудут вечно, а также прекрасные жилища в садах Эдема. Но довольство Аллаха будет превыше этого. Это и есть великое преуспеяние.",["обещал","Аллах","верующим","и верующим женщинам","сады","текут","из-под","них","реки","вечно пребывающими","в них","и жилища","прекрасные","в","садах","Эдема","и довольство","от","Аллаха","больше","это","оно","успех","великий"]]],"m":[[["كَٱلَّذِينَ","как те, которые",9,69],["مِن","до",9,69],["قَبۡلِكُمۡ","вас",9,69],["كَانُوٓاْ","были они",9,69],["أَشَدَّ","сильнее",9,69],["مِنكُمۡ","вас",9,69],["قُوَّةٗ","мощью",9,69],["وَأَكۡثَرَ","и больше",9,69]],[["أَمۡوَٰلٗا","имуществом",9,69],["وَأَوۡلَٰدٗا","и детьми",9,69],["فَٱسۡتَمۡتَعُواْ","и насладились они",9,69],["بِخَلَٰقِهِمۡ","своей долей",9,69],["فَٱسۡتَمۡتَعۡتُم","и насладились вы",9,69],["بِخَلَٰقِكُمۡ","своей долей",9,69]],[["كَمَا","как",9,69],["ٱسۡتَمۡتَعَ","насладились",9,69],["ٱلَّذِينَ","те, которые",9,69],["مِن","до",9,69],["قَبۡلِكُم","вас",9,69],["بِخَلَٰقِهِمۡ","своей долей",9,69],["وَخُضۡتُمۡ","и вы погрузились (в пустое)",9,69]],[["كَٱلَّذِي","как те, что",9,69],["خَاضُوٓاْۚ","погрузились",9,69],["أُوْلَٰٓئِكَ","те",9,69],["حَبِطَتۡ","тщетны",9,69],["أَعۡمَٰلُهُمۡ","их деяния",9,69],["فِي","в",9,69],["ٱلدُّنۡيَا","мире (этом)",9,69]],[["وَٱلۡأٓخِرَةِۖ","и в Последней жизни",9,69],["وَأُوْلَٰٓئِكَ","и те",9,69],["هُمُ","они",9,69],["ٱلۡخَٰسِرُونَ","потерпевшие убыток",9,69],[69],["أَلَمۡ","разве не",9,70],["يَأۡتِهِمۡ","пришло к ним",9,70]],[["نَبَأُ","известие",9,70],["ٱلَّذِينَ","о тех, которые",9,70],["مِن","до",9,70],["قَبۡلِهِمۡ","них",9,70],["قَوۡمِ","народа",9,70],["نُوحٖ","Нуха",9,70],["وَعَادٖ","и адитов",9,70],["وَثَمُودَ","и самудян",9,70],["وَقَوۡمِ","и народа",9,70]],[["إِبۡرَٰهِيمَ","Ибрахима",9,70],["وَأَصۡحَٰبِ","и жителей",9,70],["مَدۡيَنَ","Мадьяна",9,70],["وَٱلۡمُؤۡتَفِكَٰتِۚ","и опрокинутых (селений)",9,70],["أَتَتۡهُمۡ","пришли к ним",9,70]],[["رُسُلُهُم","их посланники",9,70],["بِٱلۡبَيِّنَٰتِۖ","с ясными знамениями",9,70],["فَمَا","и не",9,70],["كَانَ","был",9,70],["ٱللَّهُ","Аллах",9,70],["لِيَظۡلِمَهُمۡ","(таков), чтобы обидеть их",9,70],["وَلَٰكِن","но",9,70]],[["كَانُوٓاْ","были они",9,70],["أَنفُسَهُمۡ","самих себя",9,70],["يَظۡلِمُونَ","обижающими",9,70],[70],["وَٱلۡمُؤۡمِنُونَ","и верующие",9,71],["وَٱلۡمُؤۡمِنَٰتُ","и верующие женщины",9,71],["بَعۡضُهُمۡ","одни из них",9,71]],[["أَوۡلِيَآءُ","помощники",9,71],["بَعۡضٖۚ","других",9,71],["يَأۡمُرُونَ","они велят",9,71],["بِٱلۡمَعۡرُوفِ","одобряемое",9,71],["وَيَنۡهَوۡنَ","и удерживают",9,71],["عَنِ","от",9,71],["ٱلۡمُنكَرِ","предосудительного",9,71]],[["وَيُقِيمُونَ","и выстаивают",9,71],["ٱلصَّلَوٰةَ","намаз",9,71],["وَيُؤۡتُونَ","и дают",9,71],["ٱلزَّكَوٰةَ","закят",9,71],["وَيُطِيعُونَ","и повинуются",9,71],["ٱللَّهَ","Аллаху",9,71]],[["وَرَسُولَهُۥٓۚ","и Его Посланнику",9,71],["أُوْلَٰٓئِكَ","те",9,71],["سَيَرۡحَمُهُمُ","помилует их",9,71],["ٱللَّهُۗ","Аллах",9,71],["إِنَّ","поистине",9,71],["ٱللَّهَ","Аллах",9,71],["عَزِيزٌ","Могущественный",9,71],["حَكِيمٞ","Мудрый",9,71],[71]],[["وَعَدَ","обещал",9,72],["ٱللَّهُ","Аллах",9,72],["ٱلۡمُؤۡمِنِينَ","верующим",9,72],["وَٱلۡمُؤۡمِنَٰتِ","и верующим женщинам",9,72],["جَنَّٰتٖ","сады",9,72],["تَجۡرِي","текут",9,72],["مِن","из-под",9,72],["تَحۡتِهَا","них",9,72]],[["ٱلۡأَنۡهَٰرُ","реки",9,72],["خَٰلِدِينَ","вечно пребывающими",9,72],["فِيهَا","в них",9,72],["وَمَسَٰكِنَ","и жилища",9,72],["طَيِّبَةٗ","прекрасные",9,72],["فِي","в",9,72],["جَنَّٰتِ","садах",9,72],["عَدۡنٖۚ","Эдема",9,72]],[["وَرِضۡوَٰنٞ","и довольство",9,72],["مِّنَ","от",9,72],["ٱللَّهِ","Аллаха",9,72],["أَكۡبَرُۚ","больше",9,72],["ذَٰلِكَ","это",9,72],["هُوَ","оно",9,72],["ٱلۡفَوۡزُ","успех",9,72],["ٱلۡعَظِيمُ","великий",9,72],[72]]]}