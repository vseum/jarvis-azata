{"p":199,"j":10,"a":[[9,73,["يَٰٓأَيُّهَا","ٱلنَّبِيُّ","جَٰهِدِ","ٱلۡكُفَّارَ","وَٱلۡمُنَٰفِقِينَ","وَٱغۡلُظۡ","عَلَيۡهِمۡۚ","وَمَأۡوَىٰهُمۡ","جَهَنَّمُۖ","وَبِئۡسَ","ٱلۡمَصِيرُ"],"йа'аййухан набиййу жахидил куффара валмунафиḳиина ваглуз `алайхим вама'вахум жаханнаму ваби'сал масиир","О Пророк! Борись с неверующими и лицемерами и будь суров к ним. Их пристанищем будет Геенна. Как же скверно это место прибытия!",["о","Пророк","борись (с)","неверующими","и лицемерами","и будь суров","к ним","и их пристанище","Геенна","и скверно","место прибытия"]],[9,74,["يَحۡلِفُونَ","بِٱللَّهِ","مَا","قَالُواْ","وَلَقَدۡ","قَالُواْ","كَلِمَةَ","ٱلۡكُفۡرِ","وَكَفَرُواْ","بَعۡدَ","إِسۡلَٰمِهِمۡ","وَهَمُّواْ","بِمَا","لَمۡ","يَنَالُواْۚ","وَمَا","نَقَمُوٓاْ","إِلَّآ","أَنۡ","أَغۡنَىٰهُمُ","ٱللَّهُ","وَرَسُولُهُۥ","مِن","فَضۡلِهِۦۚ","فَإِن","يَتُوبُواْ","يَكُ","خَيۡرٗا","لَّهُمۡۖ","وَإِن","يَتَوَلَّوۡاْ","يُعَذِّبۡهُمُ","ٱللَّهُ","عَذَابًا","أَلِيمٗا","فِي","ٱلدُّنۡيَا","وَٱلۡأٓخِرَةِۚ","وَمَا","لَهُمۡ","فِي","ٱلۡأَرۡضِ","مِن","وَلِيّٖ","وَلَا","نَصِيرٖ"],"йахлифууна биллахи ма ḳалуу валаḳад ḳалуу калиматал куфри вакафаруу ба`да исламихим вахаммуу бима лам йаналуу вама наḳамуу илла ан агнахумуллаху варасуулухуу мин фадлихии фа'ин йатуубуу йаку хайрал лахум ва'ин йатаваллау йу`аззибхумуллаху `азабан алииман фид дунйа вал'ахирати вама лахум фил арди мин валиййин вала насиир","Они клянутся Аллахом, что ничего не говорили, а ведь они произнесли слово неверия и стали неверующими после того, как обратились в ислам. Они задумали совершить то, что им не удалось совершить. Они мстят только за то, что Аллах и Его Посланник обогатили их из Его щедрот. Если они раскаются, то так будет лучше для них. А если они отвернутся, то Аллах подвергнет их мучительным страданиям в этом мире и в Последней жизни. Нет у них на земле ни покровителя, ни помощника.",["они клянутся","Аллахом","не","говорили они","а ведь уже","сказали они","слово","неверия","и стали неверующими","после","их ислама","и замыслили","то, что","не","достигли они","и не","мстили они","кроме","того, что","обогатил их","Аллах","и Его Посланник","из","Своей милости","и если","они покаются","будет","лучше","для них","а если","они отвернутся","накажет их","Аллах","наказанием","мучительным","в","мире (этом)","и в Последней жизни","и нет","у них","на","земле","никакого","покровителя","и ни","помощника"]],[9,75,["وَمِنۡهُم","مَّنۡ","عَٰهَدَ","ٱللَّهَ","لَئِنۡ","ءَاتَىٰنَا","مِن","فَضۡلِهِۦ","لَنَصَّدَّقَنَّ","وَلَنَكُونَنَّ","مِنَ","ٱلصَّٰلِحِينَ"],"ваминхум ман `ахадаллаха ла'ин атана мин фадлихии ланассаддаḳанна валанакуунанна минас салихиин","Среди них есть такие, которые обещали Аллаху: «Если Он одарит нас из Своих щедрот, то мы непременно станем раздавать милостыню и будем одними из праведников».",["и среди них","(есть) тот, кто","обещал","Аллаху","если","Он даст нам","из","Своей милости","непременно мы будем раздавать милостыню","и непременно будем","из","праведников"]],[9,76,["فَلَمَّآ","ءَاتَىٰهُم","مِّن","فَضۡلِهِۦ","بَخِلُواْ","بِهِۦ","وَتَوَلَّواْ","وَّهُم","مُّعۡرِضُونَ"],"фаламма атахум мин фадлихии бахилуу бихии ватаваллав вахум му`ридуун","Когда же Он одарил их из Своих щедрот, они стали скупиться и отвернулись с отвращением.",["когда же","Он дал им","из","Своей милости","они поскупились","им","и отвернулись","и они","уклоняющиеся"]],[9,77,["فَأَعۡقَبَهُمۡ","نِفَاقٗا","فِي","قُلُوبِهِمۡ","إِلَىٰ","يَوۡمِ","يَلۡقَوۡنَهُۥ","بِمَآ","أَخۡلَفُواْ","ٱللَّهَ","مَا","وَعَدُوهُ","وَبِمَا","كَانُواْ","يَكۡذِبُونَ"],"фа'а`ḳабахум нифаḳан фии ḳулуубихим ила йауми йалḳаунахуу бима ахлафуллаха ма ва`адууху вабима кануу йакзибуун","Он наказал их, вселив в их сердца лицемерие до того дня, когда они встретятся с Ним, за то, что они нарушили данное Аллаху обещание, и за то, что они лгали.",["и Он вверг их (в)","лицемерие","в","их сердцах","до","дня","(когда) они встретят Его","за то, что","они нарушили (обещание)","Аллаху","то, что","обещали Ему","и за то, что","они были","лгут"]],[9,78,["أَلَمۡ","يَعۡلَمُوٓاْ","أَنَّ","ٱللَّهَ","يَعۡلَمُ","سِرَّهُمۡ","وَنَجۡوَىٰهُمۡ","وَأَنَّ","ٱللَّهَ","عَلَّٰمُ","ٱلۡغُيُوبِ"],"алам йа`ламуу анналлаха йа`ламу сиррахум ванажвахум ва'анналлаха `алламул гуйууб","Разве они не знали, что Аллаху известны их секреты и тайные беседы и что Аллах является Ведающим сокровенное?",["разве не","знали они","что","Аллах","знает","их тайну","и их тайные беседы","и что","Аллах","Знающий","сокровенное"]],[9,79,["ٱلَّذِينَ","يَلۡمِزُونَ","ٱلۡمُطَّوِّعِينَ","مِنَ","ٱلۡمُؤۡمِنِينَ","فِي","ٱلصَّدَقَٰتِ","وَٱلَّذِينَ","لَا","يَجِدُونَ","إِلَّا","جُهۡدَهُمۡ","فَيَسۡخَرُونَ","مِنۡهُمۡ","سَخِرَ","ٱللَّهُ","مِنۡهُمۡ","وَلَهُمۡ","عَذَابٌ","أَلِيمٌ"],"аллазиина йалмизуунал муттавви`иина минал му'миниина фис садаḳати валлазиина ла йажидууна илла жухдахум файасхарууна минхум сахираллаху минхум валахум `азабун алиим","Они поносят тех, кто раздает добровольные пожертвования, и тех, кто с трудом находит средства для пожертвований. Они глумятся над ними, а Аллах поглумится над ними. Им уготованы мучительные страдания.",["те, которые","порицают","добровольно жертвующих","из","верующих","относительно","милостынь","и тех, которые","не","находят","кроме","своих усилий","и насмехаются","над ними","посмеялся","Аллах","над ними","и им","наказание","мучительное"]]],"m":[[["يَٰٓأَيُّهَا","о",9,73],["ٱلنَّبِيُّ","Пророк",9,73],["جَٰهِدِ","борись (с)",9,73],["ٱلۡكُفَّارَ","неверующими",9,73],["وَٱلۡمُنَٰفِقِينَ","и лицемерами",9,73],["وَٱغۡلُظۡ","и будь суров",9,73],["عَلَيۡهِمۡۚ","к ним",9,73]],[["وَمَأۡوَىٰهُمۡ","и их пристанище",9,73],["جَهَنَّمُۖ","Геенна",9,73],["وَبِئۡسَ","и скверно",9,73],["ٱلۡمَصِيرُ","место прибытия",9,73],[73],["يَحۡلِفُونَ","они клянутся",9,74],["بِٱللَّهِ","Аллахом",9,74]],[["مَا","не",9,74],["قَالُواْ","говорили они",9,74],["وَلَقَدۡ","а ведь уже",9,74],["قَالُواْ","сказали они",9,74],["كَلِمَةَ","слово",9,74],["ٱلۡكُفۡرِ","неверия",9,74],["وَكَفَرُواْ","и стали неверующими",9,74],["بَعۡدَ","после",9,74],["إِسۡلَٰمِهِمۡ","их ислама",9,74]],[["وَهَمُّواْ","и замыслили",9,74],["بِمَا","то, что",9,74],["لَمۡ","не",9,74],["يَنَالُواْۚ","достигли они",9,74],["وَمَا","и не",9,74],["نَقَمُوٓاْ","мстили они",9,74],["إِلَّآ","кроме",9,74],["أَنۡ","того, что",9,74],["أَغۡنَىٰهُمُ","обогатил их",9,74],["ٱللَّهُ","Аллах",9,74],["وَرَسُولُهُۥ","и Его Посланник",9,74]],[["مِن","из",9,74],["فَضۡلِهِۦۚ","Своей милости",9,74],["فَإِن","и если",9,74],["يَتُوبُواْ","они покаются",9,74],["يَكُ","будет",9,74],["خَيۡرٗا","лучше",9,74],["لَّهُمۡۖ","для них",9,74],["وَإِن","а если",9,74],["يَتَوَلَّوۡاْ","они отвернутся",9,74],["يُعَذِّبۡهُمُ","накажет их",9,74]],[["ٱللَّهُ","Аллах",9,74],["عَذَابًا","наказанием",9,74],["أَلِيمٗا","мучительным",9,74],["فِي","в",9,74],["ٱلدُّنۡيَا","мире (этом)",9,74],["وَٱلۡأٓخِرَةِۚ","и в Последней жизни",9,74],["وَمَا","и нет",9,74],["لَهُمۡ","у них",9,74],["فِي","на",9,74],["ٱلۡأَرۡضِ","земле",9,74]],[["مِن","никакого",9,74],["وَلِيّٖ","покровителя",9,74],["وَلَا","и ни",9,74],["نَصِيرٖ","помощника",9,74],[74],["۞ وَمِنۡهُم","и среди них",9,75],["مَّنۡ","(есть) тот, кто",9,75],["عَٰهَدَ","обещал",9,75],["ٱللَّهَ","Аллаху",9,75],["لَئِنۡ","если",9,75]],[["ءَاتَىٰنَا","Он даст нам",9,75],["مِن","из",9,75],["فَضۡلِهِۦ","Своей милости",9,75],["لَنَصَّدَّقَنَّ","непременно мы будем раздавать милостыню",9,75],["وَلَنَكُونَنَّ","и непременно будем",9,75],["مِنَ","из",9,75],["ٱلصَّٰلِحِينَ","праведников",9,75],[75]],[["فَلَمَّآ","когда же",9,76],["ءَاتَىٰهُم","Он дал им",9,76],["مِّن","из",9,76],["فَضۡلِهِۦ","Своей милости",9,76],["بَخِلُواْ","они поскупились",9,76],["بِهِۦ","им",9,76],["وَتَوَلَّواْ","и отвернулись",9,76],["وَّهُم","и они",9,76],["مُّعۡرِضُونَ","уклоняющиеся",9,76]],[[76],["فَأَعۡقَبَهُمۡ","и Он вверг их (в)",9,77],["نِفَاقٗا","лицемерие",9,77],["فِي","в",9,77],["قُلُوبِهِمۡ","их сердцах",9,77],["إِلَىٰ","до",9,77],["يَوۡمِ","дня",9,77],["يَلۡقَوۡنَهُۥ","(когда) они встретят Его",9,77],["بِمَآ","за то, что",9,77],["أَخۡلَفُواْ","они нарушили (обещание)",9,77]],[["ٱللَّهَ","Аллаху",9,77],["مَا","то, что",9,77],["وَعَدُوهُ","обещали Ему",9,77],["وَبِمَا","и за то, что",9,77],["كَانُواْ","они были",9,77],["يَكۡذِبُونَ","лгут",9,77],[77],["أَلَمۡ","разве не",9,78],["يَعۡلَمُوٓاْ","знали они",9,78]],[["أَنَّ","что",9,78],["ٱللَّهَ","Аллах",9,78],["يَعۡلَمُ","знает",9,78],["سِرَّهُمۡ","их тайну",9,78],["وَنَجۡوَىٰهُمۡ","и их тайные беседы",9,78],["وَأَنَّ","и что",9,78],["ٱللَّهَ","Аллах",9,78],["عَلَّٰمُ","Знающий",9,78]],[["ٱلۡغُيُوبِ","сокровенное",9,78],[78],["ٱلَّذِينَ","те, которые",9,79],["يَلۡمِزُونَ","порицают",9,79],["ٱلۡمُطَّوِّعِينَ","добровольно жертвующих",9,79],["مِنَ","из",9,79]],[["ٱلۡمُؤۡمِنِينَ","верующих",9,79],["فِي","относительно",9,79],["ٱلصَّدَقَٰتِ","милостынь",9,79],["وَٱلَّذِينَ","и тех, которые",9,79],["لَا","не",9,79],["يَجِدُونَ","находят",9,79],["إِلَّا","кроме",9,79]],[["جُهۡدَهُمۡ","своих усилий",9,79],["فَيَسۡخَرُونَ","и насмехаются",9,79],["مِنۡهُمۡ","над ними",9,79],["سَخِرَ","посмеялся",9,79],["ٱللَّهُ","Аллах",9,79],["مِنۡهُمۡ","над ними",9,79],["وَلَهُمۡ","и им",9,79],["عَذَابٌ","наказание",9,79],["أَلِيمٌ","мучительное",9,79],[79]]]}