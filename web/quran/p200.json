{"p":200,"j":10,"a":[[9,80,["ٱسۡتَغۡفِرۡ","لَهُمۡ","أَوۡ","لَا","تَسۡتَغۡفِرۡ","لَهُمۡ","إِن","تَسۡتَغۡفِرۡ","لَهُمۡ","سَبۡعِينَ","مَرَّةٗ","فَلَن","يَغۡفِرَ","ٱللَّهُ","لَهُمۡۚ","ذَٰلِكَ","بِأَنَّهُمۡ","كَفَرُواْ","بِٱللَّهِ","وَرَسُولِهِۦۗ","وَٱللَّهُ","لَا","يَهۡدِي","ٱلۡقَوۡمَ","ٱلۡفَٰسِقِينَ"],"истагфир лахум ау ла тастагфир лахум ин тастагфир лахум саб`иина марратан фалан йагфираллаху лахум залика би'аннахум кафаруу биллахи варасуулихии валлаху ла йахдил ḳаумал фасиḳиин","Будешь ли ты просить прощения для них или не будешь делать этого, Аллах все равно не простит их, даже если ты попросишь для них прощения семьдесят раз, ибо они не уверовали в Аллаха и Его Посланника. Аллах не ведет прямым путем нечестивых людей.",["проси прощения","для них","или","не","проси прощения","для них","если","ты попросишь прощения","для них","семьдесят","раз","то никогда не","простит","Аллах","их","это","потому что они","не уверовали","в Аллаха","и Его Посланника","и Аллах","не","ведёт прямым путём","людей","нечестивых"]],[9,81,["فَرِحَ","ٱلۡمُخَلَّفُونَ","بِمَقۡعَدِهِمۡ","خِلَٰفَ","رَسُولِ","ٱللَّهِ","وَكَرِهُوٓاْ","أَن","يُجَٰهِدُواْ","بِأَمۡوَٰلِهِمۡ","وَأَنفُسِهِمۡ","فِي","سَبِيلِ","ٱللَّهِ","وَقَالُواْ","لَا","تَنفِرُواْ","فِي","ٱلۡحَرِّۗ","قُلۡ","نَارُ","جَهَنَّمَ","أَشَدُّ","حَرّٗاۚ","لَّوۡ","كَانُواْ","يَفۡقَهُونَ"],"фарихал мухаллафууна бимаḳ`адихим хилафа расуулиллахи вакарихуу ан йужахидуу би'амвалихим ва'анфусихим фии сабиилиллахи ваḳалуу ла танфируу фил харри ḳул нару жаханнама ашадду харрал лау кануу йафḳахуун","Оставшиеся позади (не принявшиеся участие в походе на Табук) радовались тому, что они остались позади Посланника Аллаха. Им было ненавистно сражаться своим имуществом и своими душами на пути Аллаха, и они говорили: «Не отправляйтесь в поход в такую жару». Скажи: «Огонь Геенны еще жарче!». Если бы они только понимали!",["обрадовались","оставшиеся позади","своему сидению","вопреки","Посланнику","Аллаха","и сочли неприятным","чтобы","бороться","своим имуществом","и своими душами","на","пути","Аллаха","и сказали","не","выступайте","в","жару","скажи","огонь","Геенны","сильнее","жаром","если бы","они","понимали"]],[9,82,["فَلۡيَضۡحَكُواْ","قَلِيلٗا","وَلۡيَبۡكُواْ","كَثِيرٗا","جَزَآءَۢ","بِمَا","كَانُواْ","يَكۡسِبُونَ"],"фалйадхакуу ḳалиилан валйабкуу касииран жазаа бима кануу йаксибуун","Пусть они мало смеются и много плачут в воздаяние за то, что они приобретали!",["пусть же смеются","мало","и пусть плачут","много","в воздаяние","за то, что","они были","приобретают"]],[9,83,["فَإِن","رَّجَعَكَ","ٱللَّهُ","إِلَىٰ","طَآئِفَةٖ","مِّنۡهُمۡ","فَٱسۡتَـٔۡذَنُوكَ","لِلۡخُرُوجِ","فَقُل","لَّن","تَخۡرُجُواْ","مَعِيَ","أَبَدٗا","وَلَن","تُقَٰتِلُواْ","مَعِيَ","عَدُوًّاۖ","إِنَّكُمۡ","رَضِيتُم","بِٱلۡقُعُودِ","أَوَّلَ","مَرَّةٖ","فَٱقۡعُدُواْ","مَعَ","ٱلۡخَٰلِفِينَ"],"фа'ир ража`акаллаху ила таифатим минхум фаста'зануука лилхуруужи фаḳул лан тахружуу ма`ийа абадан валан туḳатилуу ма`ийа `адувван иннакум радиитум билḳу`ууди аввала марратин фаḳ`удуу ма`ал халифиин","Если Аллах возвратит тебя к некоторым из них, и они попросят у тебя дозволения отправиться в поход, то скажи: «Вы никогда не отправитесь со мной в поход и никогда не будете сражаться вместе со мной против врага. Вы были довольны тем, что отсиделись в первый раз. Посему отсиживайтесь вместе с теми, кто остается».",["и если","вернёт тебя","Аллах","к","группе","из них","и попросят у тебя позволения","на выступление","то скажи","никогда не","выступите вы","со мной","никогда","и никогда не","будете сражаться","со мной","(с) врагом","поистине, вы","довольствовались","сидением","(в) первый","раз","так сидите же","с","остающимися позади"]],[9,84,["وَلَا","تُصَلِّ","عَلَىٰٓ","أَحَدٖ","مِّنۡهُم","مَّاتَ","أَبَدٗا","وَلَا","تَقُمۡ","عَلَىٰ","قَبۡرِهِۦٓۖ","إِنَّهُمۡ","كَفَرُواْ","بِٱللَّهِ","وَرَسُولِهِۦ","وَمَاتُواْ","وَهُمۡ","فَٰسِقُونَ"],"вала тусалли `ала ахадим минхум мата абадан вала таḳум `ала ḳабрихии иннахум кафаруу биллахи варасуулихии ваматуу вахум фасиḳуун","Никогда не совершай намаз по кому-либо из них и не стой над его могилой, ведь они не уверовали в Аллаха и Его Посланника и умерли нечестивцами.",["и не","совершай молитву","над","кем-либо","из них","(кто) умер","никогда","и не","стой","над","его могилой","поистине, они","не уверовали","в Аллаха","и Его Посланника","и умерли","будучи","нечестивцами"]],[9,85,["وَلَا","تُعۡجِبۡكَ","أَمۡوَٰلُهُمۡ","وَأَوۡلَٰدُهُمۡۚ","إِنَّمَا","يُرِيدُ","ٱللَّهُ","أَن","يُعَذِّبَهُم","بِهَا","فِي","ٱلدُّنۡيَا","وَتَزۡهَقَ","أَنفُسُهُمۡ","وَهُمۡ","كَٰفِرُونَ"],"вала ту`жибка амвалухум ва'ауладухум иннама йуриидуллаху ан йу`аззибахум биха фид дунйа ватазхаḳа анфусухум вахум кафируун","Пусть не восхищают тебя их имущество и дети. Аллах желает только подвергнуть их мучениям имуществом и детьми в этом мире, дабы они расстались со своими душами неверующими.",["и пусть не","восхищают тебя","их имущество","и их дети","лишь","желает","Аллах","чтобы","наказать их","этим","в","мире (этом)","и (чтобы) вышли","их души","когда они","неверующие"]],[9,86,["وَإِذَآ","أُنزِلَتۡ","سُورَةٌ","أَنۡ","ءَامِنُواْ","بِٱللَّهِ","وَجَٰهِدُواْ","مَعَ","رَسُولِهِ","ٱسۡتَـٔۡذَنَكَ","أُوْلُواْ","ٱلطَّوۡلِ","مِنۡهُمۡ","وَقَالُواْ","ذَرۡنَا","نَكُن","مَّعَ","ٱلۡقَٰعِدِينَ"],"ва'иза унзилат сууратун ан аминуу биллахи важахидуу ма`а расуулихиста'занака улут таули минхум ваḳалуу зарна накум ма`ал ḳа`идиин","Когда была ниспослана сура с повелением уверовать в Аллаха и сражаться вместе с Его Посланником, обладающие богатством среди них стали просить тебя позволить им остаться и сказали: «Оставь нас, мы будем в числе тех, кто остался сидеть».",["и когда","ниспослана","сура","что","уверуйте","в Аллаха","и боритесь","вместе с","Его Посланником","просят у тебя позволения","обладающие","достатком","из них","и говорят","оставь нас","будем","с","сидящими"]]],"m":[[["ٱسۡتَغۡفِرۡ","проси прощения",9,80],["لَهُمۡ","для них",9,80],["أَوۡ","или",9,80],["لَا","не",9,80],["تَسۡتَغۡفِرۡ","проси прощения",9,80],["لَهُمۡ","для них",9,80],["إِن","если",9,80