{"p":201,"j":11,"a":[[9,87,["رَضُواْ","بِأَن","يَكُونُواْ","مَعَ","ٱلۡخَوَالِفِ","وَطُبِعَ","عَلَىٰ","قُلُوبِهِمۡ","فَهُمۡ","لَا","يَفۡقَهُونَ"],"радуу би'ан йакуунуу ма`ал хавалифи ватуби`а `ала ḳулуубихим фахум ла йафḳахуун","Они были довольны тем, что оказались среди тех, кто остался позади. Их сердца запечатаны, и они не понимают истины.",["они довольствовались","тем, что","будут","с","остающимися позади","и запечатаны","(на)","их сердца","и они","не","понимают"]],[9,88,["لَٰكِنِ","ٱلرَّسُولُ","وَٱلَّذِينَ","ءَامَنُواْ","مَعَهُۥ","جَٰهَدُواْ","بِأَمۡوَٰلِهِمۡ","وَأَنفُسِهِمۡۚ","وَأُوْلَٰٓئِكَ","لَهُمُ","ٱلۡخَيۡرَٰتُۖ","وَأُوْلَٰٓئِكَ","هُمُ","ٱلۡمُفۡلِحُونَ"],"лакинир расуулу валлазиина амануу ма`ахуу жахадуу би'амвалихим ва'анфусихим ва'улаика лахумул хайрату ва'улаика хумул муфлихуун","Однако Посланник и те, которые уверовали вместе с ним, сражались своим имуществом и своими душами. Им уготованы блага. Именно они являются преуспевшими.",["однако","Посланник","и те, которые","уверовали","с ним","боролись","своим имуществом","и своими душами","и те","им","блага","и те","они","преуспевшие"]],[9,89,["أَعَدَّ","ٱللَّهُ","لَهُمۡ","جَنَّٰتٖ","تَجۡرِي","مِن","تَحۡتِهَا","ٱلۡأَنۡهَٰرُ","خَٰلِدِينَ","فِيهَاۚ","ذَٰلِكَ","ٱلۡفَوۡزُ","ٱلۡعَظِيمُ"],"а`аддаллаху лахум жаннатин тажрии мин тахтихал анхару халидиина фииха заликал фаузул `азиим","Аллах приготовил для них Райские сады, в которых текут реки. Они пребудут в них вечно. Это - великое преуспеяние.",["приготовил","Аллах","для них","сады","текут","из-под","них","реки","вечно пребывающими","в них","это","успех","великий"]],[9,90,["وَجَآءَ","ٱلۡمُعَذِّرُونَ","مِنَ","ٱلۡأَعۡرَابِ","لِيُؤۡذَنَ","لَهُمۡ","وَقَعَدَ","ٱلَّذِينَ","كَذَبُواْ","ٱللَّهَ","وَرَسُولَهُۥۚ","سَيُصِيبُ","ٱلَّذِينَ","كَفَرُواْ","مِنۡهُمۡ","عَذَابٌ","أَلِيمٞ"],"важаал му`аззирууна минал а`раби лийу'зана лахум ваḳа`адал лазиина казабуллаха варасуулахуу сайусиибул лазиина кафаруу минхум `азабун алиим","Бедуины, которые уклонялись под благовидным предлогом, пришли для того, чтобы он позволил им остаться, и те из них, которые солгали Аллаху и Его Посланнику, остались сидеть. Тех из них, которые не уверовали, постигнут мучительные страдания.",["и пришли","извиняющиеся","из","бедуинов","чтобы позволено было","им","и остались сидеть","те, которые","солгали","Аллаху","и Его Посланнику","постигнет","тех, которые","не уверовали","из них","наказание","мучительное"]],[9,91,["لَّيۡسَ","عَلَى","ٱلضُّعَفَآءِ","وَلَا","عَلَى","ٱلۡمَرۡضَىٰ","وَلَا","عَلَى","ٱلَّذِينَ","لَا","يَجِدُونَ","مَا","يُنفِقُونَ","حَرَجٌ","إِذَا","نَصَحُواْ","لِلَّهِ","وَرَسُولِهِۦۚ","مَا","عَلَى","ٱلۡمُحۡسِنِينَ","مِن","سَبِيلٖۚ","وَٱللَّهُ","غَفُورٞ","رَّحِيمٞ"],"ллайса `алад ду`афаи вала `алал марда вала `алал лазиина ла йажидууна ма йунфиḳууна харажун иза насахуу лиллахи варасуулихии ма `алал мухсиниина мин сабиилин валлаху гафуурур рахиим","Нет греха на немощных, больных и тех, которые не находят средств на пожертвования, если они искренни перед Аллахом и Его Посланником. Нет оснований укорять творящих добро. Воистину, Аллах - Прощающий, Милосердный.",["нет","на","слабых","и ни","на","больных","и ни","на","тех, которые","не","находят","того, что","расходовать","греха","если","они искренни","перед Аллахом","и Его Посланником","нет","на","добродеющих","никакого","пути (для упрёка)","и Аллах","Прощающий","Милосердный"]],[9,92,["وَلَا","عَلَى","ٱلَّذِينَ","إِذَا","مَآ","أَتَوۡكَ","لِتَحۡمِلَهُمۡ","قُلۡتَ","لَآ","أَجِدُ","مَآ","أَحۡمِلُكُمۡ","عَلَيۡهِ","تَوَلَّواْ","وَّأَعۡيُنُهُمۡ","تَفِيضُ","مِنَ","ٱلدَّمۡعِ","حَزَنًا","أَلَّا","يَجِدُواْ","مَا","يُنفِقُونَ"],"вала `алал лазиина иза ма атаука литахмилахум ḳулта ла ажиду ма ахмилукум `алайхи таваллав ва'а`йунухум тафииду минад дам`и хазанан алла йажидуу ма йунфиḳуун","Также нет греха на тех, которым, когда они пришли к тебе, чтобы ты обеспечил их верховыми животными, ты сказал: «Я не могу найти животных для вас». Они вернулись с глазами, полными слез от огорчения тем, что они не нашли средств на пожертвования.",["и не","на","тех, которые","когда","лишь","пришли к тебе","чтобы ты дал им верховых","ты сказал","не","нахожу я","того, на что","посадить вас","на это","они вернулись","а их глаза","переполняются","(от)","слезами","от печали","что не","находят","того, что","расходовать"]],[9,93,["إِنَّمَا","ٱلسَّبِيلُ","عَلَى","ٱلَّذِينَ","يَسۡتَـٔۡذِنُونَكَ","وَهُمۡ","أَغۡنِيَآءُۚ","رَضُواْ","بِأَن","يَكُونُواْ","مَعَ","ٱلۡخَوَالِفِ","وَطَبَعَ","ٱللَّهُ","عَلَىٰ","قُلُوبِهِمۡ","فَهُمۡ","لَا","يَعۡلَمُونَ"],"иннамас сабиилу `алал лазиина йаста'зинуунака вахум агнийау радуу би'ан йакуунуу ма`ал хавалифи ватаба`аллаху `ала ḳулуубихим фахум ла йа`ламуун","Укора заслуживают только те, которые попросили тебя остаться дома, будучи богатыми. Они были рады оказаться среди тех, кто остался позади. Аллах запечатал их сердца, и они не знают истины.",["лишь","путь (упрёка)","на","тех, которые","просят у тебя позволения","а они","богаты","они довольствовались","тем, что","будут","с","остающимися позади","и запечатал","Аллах","(на)","их сердца","и они","не","знают"]]],"m":[[["رَضُواْ","они довольствовались",9,87],["بِأَن","тем, что",9,87],["يَكُونُواْ","будут",9,87],["مَعَ","с",9,87],["ٱلۡخَوَالِفِ","остающимися позади",9,87],["وَطُبِعَ","и запечатаны",9,87],["عَلَىٰ","(на)",9,87],["قُلُوبِهِمۡ","их сердца",9,87],["فَهُمۡ","и они",9,87]],[["لَا","не",9,87],["يَفۡقَهُونَ","понимают",9,87],[87],["لَٰكِنِ","однако",9,88],["ٱلرَّسُولُ","Посланник",9,88],["وَٱلَّذِينَ","и те, которые",9,88],["ءَامَنُواْ","уверовали",9,88],["مَعَهُۥ","с ним",9,88]],[["جَٰهَدُواْ","боролись",9,88],["بِأَمۡوَٰلِهِمۡ","своим имуществом",9,88],["وَأَنفُسِهِمۡۚ","и своими душами",9,88],["وَأُوْلَٰٓئِكَ","и те",9,88],["لَهُمُ","им",9,88],["ٱلۡخَيۡرَٰتُۖ","блага",9,88]],[["وَأُوْلَٰٓئِكَ","и те",9,88],["هُمُ","они",9,88],["ٱلۡمُفۡلِحُونَ","преуспевшие",9,88],[88],["أَعَدَّ","приготовил",9,89],["ٱللَّهُ","Аллах",9,89],["لَهُمۡ","для них",9,89],["جَنَّٰتٖ","сады",9,89],["تَجۡرِي","текут",9,89]],[["مِن","из-под",9,8