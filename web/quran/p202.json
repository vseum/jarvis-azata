{"p":202,"j":11,"a":[[9,94,["يَعۡتَذِرُونَ","إِلَيۡكُمۡ","إِذَا","رَجَعۡتُمۡ","إِلَيۡهِمۡۚ","قُل","لَّا","تَعۡتَذِرُواْ","لَن","نُّؤۡمِنَ","لَكُمۡ","قَدۡ","نَبَّأَنَا","ٱللَّهُ","مِنۡ","أَخۡبَارِكُمۡۚ","وَسَيَرَى","ٱللَّهُ","عَمَلَكُمۡ","وَرَسُولُهُۥ","ثُمَّ","تُرَدُّونَ","إِلَىٰ","عَٰلِمِ","ٱلۡغَيۡبِ","وَٱلشَّهَٰدَةِ","فَيُنَبِّئُكُم","بِمَا","كُنتُمۡ","تَعۡمَلُونَ"],"йа`тазирууна илайкум иза ража`тум илайхим ḳул ла та`тазируу лан ну'мина лакум ḳад наббааналлаху мин ахбарикум васайараллаху `амалакум варасуулухуу сумма тураддууна ила `алимил гайби вашшахадати файунаббиукум бима кунтум та`малуун","Когда вы возвратитесь к ним, они станут оправдываться. Скажи: «Не оправдывайтесь, мы все равно не поверим вам. Аллах уже сообщил нам вести о вас. Аллах и Его Посланник увидят ваши деяния. А потом вы будете возвращены к Ведающему сокровенное и явное, и Он сообщит вам о том, что вы совершали».",["они будут оправдываться","перед вами","когда","вы вернётесь","к ним","скажи","не","оправдывайтесь","никогда не","поверим мы","вам","уже","сообщил нам","Аллах","из","вестей о вас","и увидит","Аллах","ваше деяние","и Его Посланник","затем","вы будете возвращены","к","Знающему","сокровенное","и явное","и Он сообщит вам","о том, что","вы были","делаете"]],[9,95,["سَيَحۡلِفُونَ","بِٱللَّهِ","لَكُمۡ","إِذَا","ٱنقَلَبۡتُمۡ","إِلَيۡهِمۡ","لِتُعۡرِضُواْ","عَنۡهُمۡۖ","فَأَعۡرِضُواْ","عَنۡهُمۡۖ","إِنَّهُمۡ","رِجۡسٞۖ","وَمَأۡوَىٰهُمۡ","جَهَنَّمُ","جَزَآءَۢ","بِمَا","كَانُواْ","يَكۡسِبُونَ"],"сайахлифууна биллахи лакум изанḳалабтум илайхим литу`ридуу `анхум фа'а`ридуу `анхум иннахум рижсун вама'вахум жаханнаму жазаа бима кануу йаксибуун","Когда вы вернетесь к ним, они будут клясться Аллахом, чтобы вы отвернулись от них. Отвернитесь же от них, ибо они - нечисть. Их пристанищем будет Геенна. Таково воздаяние за то, что они приобретали.",["они будут клясться","Аллахом","вам","когда","вы вернётесь","к ним","чтобы вы отвернулись","от них","так отвернитесь","от них","поистине, они","нечисть","и их пристанище","Геенна","в воздаяние","за то, что","они были","приобретают"]],[9,96,["يَحۡلِفُونَ","لَكُمۡ","لِتَرۡضَوۡاْ","عَنۡهُمۡۖ","فَإِن","تَرۡضَوۡاْ","عَنۡهُمۡ","فَإِنَّ","ٱللَّهَ","لَا","يَرۡضَىٰ","عَنِ","ٱلۡقَوۡمِ","ٱلۡفَٰسِقِينَ"],"йахлифууна лакум литардау `анхум фа'ин тардау `анхум фа'инналлаха ла йарда `анил ḳаумил фасиḳиин","Они станут вам клясться, чтобы вы остались довольны ими. Но даже если вы останетесь довольны ими, Аллах все равно не будет доволен людьми нечестивыми.",["они клянутся","вам","чтобы вы были довольны","ими","но если","вы будете довольны","ими","то ведь","Аллах","не","доволен","(от)","людьми","нечестивыми"]],[9,97,["ٱلۡأَعۡرَابُ","أَشَدُّ","كُفۡرٗا","وَنِفَاقٗا","وَأَجۡدَرُ","أَلَّا","يَعۡلَمُواْ","حُدُودَ","مَآ","أَنزَلَ","ٱللَّهُ","عَلَىٰ","رَسُولِهِۦۗ","وَٱللَّهُ","عَلِيمٌ","حَكِيمٞ"],"ал'а`рабу ашадду куфран ванифаḳан ва'аждару алла йа`ламуу худууда ма анзалаллаху `ала расуулихии валлаху `алиимун хакиим","Бедуины оказываются самыми упорными в неверии и лицемерии. Они больше других не признают ограничений, которые Аллах ниспослал Своему Посланнику. Воистину, Аллах - Знающий, Мудрый.",["бедуины","сильнее","неверием","и лицемерием","и более склонны","чтобы не","знать","границ","того, что","ниспослал","Аллах","на","Своего Посланника","и Аллах","Знающий","Мудрый"]],[9,98,["وَمِنَ","ٱلۡأَعۡرَابِ","مَن","يَتَّخِذُ","مَا","يُنفِقُ","مَغۡرَمٗا","وَيَتَرَبَّصُ","بِكُمُ","ٱلدَّوَآئِرَۚ","عَلَيۡهِمۡ","دَآئِرَةُ","ٱلسَّوۡءِۗ","وَٱللَّهُ","سَمِيعٌ","عَلِيمٞ"],"ваминал а`раби ман йаттахизу ма йунфиḳу маграман вайатараббасу бикумуд даваира `алайхим даиратус сауи валлаху самии`ун `алиим","Среди бедуинов есть и такие, которые считают свои пожертвования убытком и выжидают, когда вас постигнут превратности судьбы. Их самих постигнут превратности судьбы. Воистину, Аллах - Слышащий, Знающий.",["и среди","бедуинов","(есть) тот, кто","считает","то, что","он расходует","убытком","и выжидает","для вас","превратностей","на них","превратность","зла","и Аллах","Слышащий","Знающий"]],[9,99,["وَمِنَ","ٱلۡأَعۡرَابِ","مَن","يُؤۡمِنُ","بِٱللَّهِ","وَٱلۡيَوۡمِ","ٱلۡأٓخِرِ","وَيَتَّخِذُ","مَا","يُنفِقُ","قُرُبَٰتٍ","عِندَ","ٱللَّهِ","وَصَلَوَٰتِ","ٱلرَّسُولِۚ","أَلَآ","إِنَّهَا","قُرۡبَةٞ","لَّهُمۡۚ","سَيُدۡخِلُهُمُ","ٱللَّهُ","فِي","رَحۡمَتِهِۦٓۚ","إِنَّ","ٱللَّهَ","غَفُورٞ","رَّحِيمٞ"],"ваминал а`раби ман йу'мину биллахи валйаумил ахири вайаттахизу ма йунфиḳу ḳурубатин `индаллахи васалаватир расуули ала иннаха ḳурбатул лахум сайудхилухумуллаху фии рахматихии инналлаха гафуурур рахиим","Среди бедуинов есть и такие, которые веруют в Аллаха и Последний день и считают, что их пожертвования приблизят их к Аллаху и помогут заслужить молитвы Посланника. Воистину, они (пожертвования) действительно являются средством приближения. Аллах введет их в Свою милость, ведь Аллах - Прощающий, Милосердный.",["и среди","бедуинов","(есть) тот, кто","верует","в Аллаха","и в день","последний","и считает","то, что","он расходует","приближением","к","Аллаху","и (средством) молитв","Посланника","о да!","поистине, это","приближение","для них","введёт их","Аллах","в","Свою милость","поистине","Аллах","Прощающий","Милосердный"]]],"m":[[["يَعۡتَذِرُونَ","они будут оправдываться",9,94],["إِلَيۡكُمۡ","перед вами",9,94],["إِذَا","когда",9,94],["رَجَعۡتُمۡ","вы вернётесь",9,94],["إِلَيۡهِمۡۚ","к ним",9,94],["قُل","скажи",9,94],["لَّا","не",9,94],["تَعۡتَذِرُواْ","оправдывайтесь",9,94],["لَن","никогда не",9,94]],[["نُّؤۡمِنَ","поверим мы",9,94],["لَكُمۡ","вам",9,94],["قَدۡ","уже",9,94],["نَبَّأَنَا","сообщил нам",9,94],["ٱللَّهُ","Аллах",9,94],["مِنۡ","из",9,94],["أَخۡبَارِكُمۡۚ","вестей о вас",9,94],["وَسَيَرَى","и увидит",9,94]],[["ٱللَّهُ","Аллах",9,94],["عَمَلَكُمۡ","ваше деяние",9,94],["وَرَسُولُهُۥ","и Его Посланник",9,94],["ثُمَّ","затем",9,94],["تُرَدُّونَ","вы будете возвращены",9,94],["إِلَىٰ","к",9,94],["عَٰلِمِ","Знающему",9,94],["ٱلۡغَيۡبِ","сокровенное",9,94]],[["وَٱلشَّهَٰدَةِ","и явное",9,94],["فَيُنَبِّئُكُم","и Он сообщит вам",9,94],["بِمَا","о том, что",9,94],["كُنتُمۡ","вы были",9,94],["تَعۡمَلُونَ","делаете",9,94],[94],["سَيَحۡلِفُونَ","они будут клясться",9,95]],[["بِٱللَّهِ","Аллахом",9,95],["لَكُمۡ","вам",9,95],["إِذَا","когда",9,95],["ٱنقَلَبۡتُمۡ","вы вернётесь",9,95],["إِلَيۡهِمۡ","к ним",9,95],["لِتُعۡرِضُواْ","чтобы вы отвернулись",9,95],["عَنۡهُمۡۖ","от них",9,95],["فَأَعۡرِضُواْ","так отвернитесь",9,95]],[["عَنۡهُمۡۖ","от них",9,95],["إِنَّهُمۡ","поистине, они",9,95],["رِجۡسٞۖ","нечисть",9,95],["وَمَأۡوَىٰهُمۡ","и их пристанище",9,95],["جَهَنَّمُ","Геенна",9,95],["جَزَآءَۢ","в воздаяние",9,95],["بِمَا","за то, что",9,95],["كَانُواْ","они были",9,95]],[["يَكۡسِبُونَ","приобретают",9,95],[95],["يَحۡلِفُونَ","они клянутся",9,96],["لَكُمۡ","вам",9,96],["لِتَرۡضَوۡاْ","чтобы вы были довольны",9,96],["عَنۡهُمۡۖ","ими",9,96],["فَإِن","но если",9,96]],[["تَرۡضَوۡاْ","вы будете довольны",9,96],["عَنۡهُمۡ","ими",9,96],["فَإِنَّ","то ведь",9,96],["ٱللَّهَ","Аллах",9,96],["لَا","не",9,96],["يَرۡضَىٰ","доволен",9,96],["عَنِ","(от)",9,96],["ٱلۡقَوۡمِ","людьми",9,96],["ٱلۡفَٰسِقِينَ","нечестивыми",9,96]],[[96],["ٱلۡأَعۡرَابُ","бедуины",9,97],["أَشَدُّ","сильнее",9,97],["كُفۡرٗا","неверием",9,97],["وَنِفَاقٗا","и лицемерием",9,97],["وَأَجۡدَرُ","и более склонны",9,97],["أَلَّا","чтобы не",9,97],["يَعۡلَمُواْ","знать",9,97]],[["حُدُودَ","границ",9,97],["مَآ","того, что",9,97],["أَنزَلَ","ниспослал",9,97],["ٱللَّهُ","Аллах",9,97],["عَلَىٰ","на",9,97],["رَسُولِهِۦۗ","Своего Посланника",9,97],["وَٱللَّهُ","и Аллах",9,97],["عَلِيمٌ","Знающий",9,97],["حَكِيمٞ","Мудрый",9,97],[97],["وَمِنَ","и среди",9,98]],[["ٱلۡأَعۡرَابِ","бедуинов",9,98],["مَن","(есть) тот, кто",9,98],["يَتَّخِذُ","считает",9,98],["مَا","то, что",9,98],["يُنفِقُ","он расходует",9,98],["مَغۡرَمٗا","убытком",9,98],["وَيَتَرَبَّصُ","и выжидает",9,98],["بِكُمُ","для вас",9,98],["ٱلدَّوَآئِرَۚ","превратностей",9,98]],[["عَلَيۡهِمۡ","на них",9,98],["دَآئِرَةُ","превратность",9,98],["ٱلسَّوۡءِۗ","зла",9,98],["وَٱللَّهُ","и Аллах",9,98],["سَمِيعٌ",