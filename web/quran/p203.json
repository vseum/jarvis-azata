{"p":203,"j":11,"a":[[9,100,["وَٱلسَّٰبِقُونَ","ٱلۡأَوَّلُونَ","مِنَ","ٱلۡمُهَٰجِرِينَ","وَٱلۡأَنصَارِ","وَٱلَّذِينَ","ٱتَّبَعُوهُم","بِإِحۡسَٰنٖ","رَّضِيَ","ٱللَّهُ","عَنۡهُمۡ","وَرَضُواْ","عَنۡهُ","وَأَعَدَّ","لَهُمۡ","جَنَّٰتٖ","تَجۡرِي","تَحۡتَهَا","ٱلۡأَنۡهَٰرُ","خَٰلِدِينَ","فِيهَآ","أَبَدٗاۚ","ذَٰلِكَ","ٱلۡفَوۡزُ","ٱلۡعَظِيمُ"],"вассабиḳуунал аввалууна минал мухажириина вал'ансари валлазиинаттаба`уухум би'ихсанир радийаллаху `анхум варадуу `анху ва'а`адда лахум жаннатин тажрии тахтахал анхару халидиина фииха абадан заликал фаузул `азиим","Аллах доволен первыми из мухаджиров и ансаров, которые опередили остальных, и теми, которые последовали строго за ними. Они также довольны Аллахом. Он приготовил для них Райские сады, в которых текут реки. Они пребудут там вечно. Это - великое преуспеяние.",["и опередившие","первые","из","мухаджиров","и ансаров","и те, которые","последовали за ними","в добре","доволен","Аллах","ими","и они довольны","Им","и Он приготовил","для них","сады","текут","под ними","реки","пребывающие вечно","в них","навеки","это","успех","великий"]],[9,101,["وَمِمَّنۡ","حَوۡلَكُم","مِّنَ","ٱلۡأَعۡرَابِ","مُنَٰفِقُونَۖ","وَمِنۡ","أَهۡلِ","ٱلۡمَدِينَةِ","مَرَدُواْ","عَلَى","ٱلنِّفَاقِ","لَا","تَعۡلَمُهُمۡۖ","نَحۡنُ","نَعۡلَمُهُمۡۚ","سَنُعَذِّبُهُم","مَّرَّتَيۡنِ","ثُمَّ","يُرَدُّونَ","إِلَىٰ","عَذَابٍ","عَظِيمٖ"],"вамимман хаулакум минал а`раби мунафиḳууна вамин ахлил мадиинати марадуу `алан нифаḳи ла та`ламухум нахну на`ламухум сану`аззибухум марратайни сумма йураддууна ила `азабин `азиим","Среди бедуинов, которые живут вокруг вас, а также среди жителей Медины есть лицемеры. Они упорствуют в лицемерии, но ты не знаешь их. Мы же знаем их и подвергнем их мучениям дважды. А затем они будут возвращены в великие мучения.",["и среди тех, кто","вокруг вас","из","бедуинов","лицемеры","и из","жителей","Медины","упорствуют","в","лицемерии","не","ты знаешь их","Мы","знаем их","Мы накажем их","дважды","затем","они будут возвращены","к","наказанию","великому"]],[9,102,["وَءَاخَرُونَ","ٱعۡتَرَفُواْ","بِذُنُوبِهِمۡ","خَلَطُواْ","عَمَلٗا","صَٰلِحٗا","وَءَاخَرَ","سَيِّئًا","عَسَى","ٱللَّهُ","أَن","يَتُوبَ","عَلَيۡهِمۡۚ","إِنَّ","ٱللَّهَ","غَفُورٞ","رَّحِيمٌ"],"ва'ахарууна`тарафуу бизунуубихим халатуу `амалан салихан ва'ахара саййиан `асаллаху ан йатууба `алайхим инналлаха гафуурур рахиим","Есть и другие люди, которые признались в своих грехах. Они смешали праведные поступки со злыми. Возможно, Аллах примет их покаяния. Воистину, Аллах - Прощающий, Милосердный.",["и другие","признали","свои грехи","смешали они","дело","праведное","и другое","дурное","быть может","Аллах","что","примет покаяние","их","поистине","Аллах","Прощающий","Милосердный"]],[9,103,["خُذۡ","مِنۡ","أَمۡوَٰلِهِمۡ","صَدَقَةٗ","تُطَهِّرُهُمۡ","وَتُزَكِّيهِم","بِهَا","وَصَلِّ","عَلَيۡهِمۡۖ","إِنَّ","صَلَوٰتَكَ","سَكَنٞ","لَّهُمۡۗ","وَٱللَّهُ","سَمِيعٌ","عَلِيمٌ"],"хуз мин амвалихим садаḳатан тутаххирухум ватузаккиихим биха васалли `алайхим инна салаватака саканул лахум валлаху самии`ун `алиим","Бери из их имущества пожертвования, чтобы ими очистить и возвысить их. Молись за них, ибо твои молитвы - успокоение для них. Воистину, Аллах - Слышащий, Знающий.",["возьми","из","их имущества","милостыню","ты очищаешь их","и возвышаешь их","ею","и молись","за них","поистине","твоя молитва","успокоение","для них","и Аллах","Слышащий","Знающий"]],[9,104,["أَلَمۡ","يَعۡلَمُوٓاْ","أَنَّ","ٱللَّهَ","هُوَ","يَقۡبَلُ","ٱلتَّوۡبَةَ","عَنۡ","عِبَادِهِۦ","وَيَأۡخُذُ","ٱلصَّدَقَٰتِ","وَأَنَّ","ٱللَّهَ","هُوَ","ٱلتَّوَّابُ","ٱلرَّحِيمُ"],"алам йа`ламуу анналлаха хуа йаḳбалут таубата `ан `ибадихии вайа'хузус садаḳати ва'анналлаха хуат таввабур рахиим","Неужели они не знают, что Аллах принимает покаяния от Своих рабов и принимает пожертвования, что Аллах - Принимающий покаяния, Милосердный?",["разве не","знают они","что","Аллах","Он","принимает","покаяние","от","Своих рабов","и берёт","милостыни","и что","Аллах","Он","Принимающий покаяния","Милосердный"]],[9,105,["وَقُلِ","ٱعۡمَلُواْ","فَسَيَرَى","ٱللَّهُ","عَمَلَكُمۡ","وَرَسُولُهُۥ","وَٱلۡمُؤۡمِنُونَۖ","وَسَتُرَدُّونَ","إِلَىٰ","عَٰلِمِ","ٱلۡغَيۡبِ","وَٱلشَّهَٰدَةِ","فَيُنَبِّئُكُم","بِمَا","كُنتُمۡ","تَعۡمَلُونَ"],"ваḳули`малуу фасайараллаху `амалакум варасуулухуу валму'минууна васатураддууна ила `алимил гайби вашшахадати файунаббиукум бима кунтум та`малуун","Скажи: «Трудитесь, и увидят ваши деяния Аллах, Его Посланник и верующие. Вы предстанете перед Ведающим сокровенное и явное, и Он поведает вам о том, что вы совершали».",["и скажи","трудитесь","и увидит","Аллах","ваше дело","и Его Посланник","и верующие","и вы будете возвращены","к","Знающему","сокровенное","и явное","и Он сообщит вам","о том, что","вы были","делали"]],[9,106,["وَءَاخَرُونَ","مُرۡجَوۡنَ","لِأَمۡرِ","ٱللَّهِ","إِمَّا","يُعَذِّبُهُمۡ","وَإِمَّا","يَتُوبُ","عَلَيۡهِمۡۗ","وَٱللَّهُ","عَلِيمٌ","حَكِيمٞ"],"ва'ахарууна муржауна ли'амриллахи имма йу`аззибухум ва'имма йатуубу `алайхим валлаху `алиимун хакиим","Есть и такие, которые выжидают веления Аллаха. Он либо накажет их, либо примет их покаяния. Аллах - Знающий, Мудрый.",["и другие","отложены","до решения","Аллаха","либо","Он накажет их","либо","Он примет покаяние","их","и Аллах","Знающий","Мудрый"]]],"m":[[["وَٱلسَّٰبِقُونَ","и опередившие",9,100],["ٱلۡأَوَّلُونَ","первые",9,100],["مِنَ","из",9,100],["ٱلۡمُهَٰجِرِينَ","мухаджиров",9,100],["وَٱلۡأَنصَارِ","и ансаров",9,100],["وَٱلَّذِينَ","и те, которые",9,100]],[["ٱتَّبَعُوهُم","последовали за ними",9,100],["بِإِحۡسَٰنٖ","в добре",9,100],["رَّضِيَ","доволен",9,100],["ٱللَّهُ","Аллах",9,100],["عَنۡهُمۡ","ими",9,100],["وَرَضُواْ","и они довольны",9,100],["عَنۡهُ","Им",9,100],["وَأَعَدَّ","и Он приготовил",9,100]],[["لَهُمۡ","для них",9,100],["جَنَّٰتٖ","сады",9,100],["تَجۡرِي","текут",9,100],["تَحۡتَهَا","под ними",9,100],["ٱلۡأَنۡهَٰرُ","реки",9,100],["خَٰلِدِينَ","пребывающие вечно",9,100],["فِيهَآ","в них",9,100],["أَبَدٗاۚ","навеки",9,100]],[["ذَٰلِكَ","это",9,100],["ٱلۡفَوۡزُ","успех",9,100],["ٱلۡعَظِيمُ","великий",9,100],