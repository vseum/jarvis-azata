{"p":204,"j":11,"a":[[9,107,["وَٱلَّذِينَ","ٱتَّخَذُواْ","مَسۡجِدٗا","ضِرَارٗا","وَكُفۡرٗا","وَتَفۡرِيقَۢا","بَيۡنَ","ٱلۡمُؤۡمِنِينَ","وَإِرۡصَادٗا","لِّمَنۡ","حَارَبَ","ٱللَّهَ","وَرَسُولَهُۥ","مِن","قَبۡلُۚ","وَلَيَحۡلِفُنَّ","إِنۡ","أَرَدۡنَآ","إِلَّا","ٱلۡحُسۡنَىٰۖ","وَٱللَّهُ","يَشۡهَدُ","إِنَّهُمۡ","لَكَٰذِبُونَ"],"валлазиинаттахазуу масжидан дираран вакуфран ватафрииḳа байнал му'миниина ва'ирсадал лиман харабаллаха варасуулахуу мин ḳаблу валайахлифунна ин арадна иллал хусна валлаху йашхаду иннахум лаказибуун","Те, которые построили мечеть для нанесения вреда, поддержания неверия, внесения раскола в ряды мусульман и создания заставы для тех, кто издавна сражается против Аллаха и Его Посланника, непременно будут клясться: «Мы не хотели ничего, кроме добра». Аллах свидетельствует, что они являются лжецами.",["и те, которые","устроили","мечеть","во вред","и для неверия","и для раскола","между","верующими","и как засаду","для того, кто","воевал (против)","Аллаха","и Его Посланника","с","прежних пор","и непременно поклянутся","не","хотели мы","кроме","лучшего","и Аллах","свидетельствует","поистине, они","непременно лжецы"]],[9,108,["لَا","تَقُمۡ","فِيهِ","أَبَدٗاۚ","لَّمَسۡجِدٌ","أُسِّسَ","عَلَى","ٱلتَّقۡوَىٰ","مِنۡ","أَوَّلِ","يَوۡمٍ","أَحَقُّ","أَن","تَقُومَ","فِيهِۚ","فِيهِ","رِجَالٞ","يُحِبُّونَ","أَن","يَتَطَهَّرُواْۚ","وَٱللَّهُ","يُحِبُّ","ٱلۡمُطَّهِّرِينَ"],"ла таḳум фиихи абадал ламасжидун уссиса `алат таḳва мин аввали йаумин ахаḳḳу ан таḳуума фиихи фиихи рижалун йухиббууна ан йататаххаруу валлаху йухиббул муттаххириин","Никогда не совершай в ней намаз. Мечеть, которая с первого дня была основана на богобоязненности, больше заслуживает того, чтобы ты выстаивал в ней. В ней есть мужи, которые любят очищаться. Воистину, Аллах любит очищающихся.",["не","стой","в ней","никогда","воистину, мечеть","основанная","на","богобоязненности","с","первого","дня","более достойна","чтобы","ты стоял","в ней","в ней","мужи","любят","чтобы","очищаться","и Аллах","любит","очищающихся"]],[9,109,["أَفَمَنۡ","أَسَّسَ","بُنۡيَٰنَهُۥ","عَلَىٰ","تَقۡوَىٰ","مِنَ","ٱللَّهِ","وَرِضۡوَٰنٍ","خَيۡرٌ","أَم","مَّنۡ","أَسَّسَ","بُنۡيَٰنَهُۥ","عَلَىٰ","شَفَا","جُرُفٍ","هَارٖ","فَٱنۡهَارَ","بِهِۦ","فِي","نَارِ","جَهَنَّمَۗ","وَٱللَّهُ","لَا","يَهۡدِي","ٱلۡقَوۡمَ","ٱلظَّٰلِمِينَ"],"афаман ассаса бунйанахуу `ала таḳва миналлахи варидванин хайрун ам ман ассаса бунйанахуу `ала шафа журуфин харин фанхара бихии фии нари жаханнама валлаху ла йахдил ḳаумаз залимиин","Тот ли, кто заложил основание своего строения на страхе перед Аллахом и стремлении к Его довольству, лучше или же тот, кто заложил его на самом краю обрыва, готового обвалиться, так что он обвалился вместе с ним в огонь Геенны? Воистину, Аллах не ведет прямым путем несправедливых людей.",["разве же тот, кто","заложил","своё строение","на","богобоязненности","перед","Аллахом","и (Его) довольстве","лучше","или","тот, кто","заложил","своё строение","на","краю","обрыва","осыпающегося","и оно обрушилось","с ним","в","огонь","Геенны","и Аллах","не","ведёт прямым путём","людей","несправедливых"]],[9,110,["لَا","يَزَالُ","بُنۡيَٰنُهُمُ","ٱلَّذِي","بَنَوۡاْ","رِيبَةٗ","فِي","قُلُوبِهِمۡ","إِلَّآ","أَن","تَقَطَّعَ","قُلُوبُهُمۡۗ","وَٱللَّهُ","عَلِيمٌ","حَكِيمٌ"],"ла йазалу бунйанухумул лазии банау риибатан фии ḳулуубихим илла ан таḳатта`а ḳулуубухум валлаху `алиимун хакиим","Строение, которое они построили, всегда будет порождать сомнения в их сердцах, пока их сердца не разорвутся. Аллах - Знающий, Мудрый.",["не","перестанет","их строение","которое","они построили","(быть) сомнением","в","их сердцах","разве только","(когда)","разорвутся","их сердца","и Аллах","Знающий","Мудрый"]],[9,111,["إِنَّ","ٱللَّهَ","ٱشۡتَرَىٰ","مِنَ","ٱلۡمُؤۡمِنِينَ","أَنفُسَهُمۡ","وَأَمۡوَٰلَهُم","بِأَنَّ","لَهُمُ","ٱلۡجَنَّةَۚ","يُقَٰتِلُونَ","فِي","سَبِيلِ","ٱللَّهِ","فَيَقۡتُلُونَ","وَيُقۡتَلُونَۖ","وَعۡدًا","عَلَيۡهِ","حَقّٗا","فِي","ٱلتَّوۡرَىٰةِ","وَٱلۡإِنجِيلِ","وَٱلۡقُرۡءَانِۚ","وَمَنۡ","أَوۡفَىٰ","بِعَهۡدِهِۦ","مِنَ","ٱللَّهِۚ","فَٱسۡتَبۡشِرُواْ","بِبَيۡعِكُمُ","ٱلَّذِي","بَايَعۡتُم","بِهِۦۚ","وَذَٰلِكَ","هُوَ","ٱلۡفَوۡزُ","ٱلۡعَظِيمُ"],"инналлахаштара минал му'миниина анфусахум ва'амвалахум би'анна лахумул жанната йуḳатилууна фии сабиилиллахи файаḳтулууна вайуḳталууна ва`дан `алайхи хаḳḳан фит таурати вал'инжиили валḳур'ани ваман ауфа би`ахдихии миналлахи фастабшируу бибай`икумул лазии байа`тум бихии вазалика хуал фаузул `азиим","Воистину, Аллах купил у верующих их души и имущество в обмен на Рай. Они сражаются на пути Аллаха, убивая и погибая. Таково Его обещание и обязательство в Таурате (Торе), Инджиле (Евангелии) и Коране. Кто выполняет свои обещания лучше Аллаха? Возрадуйтесь же сделке, которую вы заключили. Это и есть великое преуспеяние.",["поистине","Аллах","купил","у","верующих","их души","и их имущество","за то, что","для них","Рай","они сражаются","на","пути","Аллаха","и убивают","и бывают убиты","обещание","на Нём","истинное","в","Таурате","и Инджиле","и Коране","и кто","вернее","своему договору","чем","Аллах","радуйтесь же","вашей сделке","которую","вы заключили","ею","и это","оно","успех","великий"]]],"m":[[["وَٱلَّذِينَ","и те, которые",9,107],["ٱتَّخَذُواْ","устроили",9,107],["مَسۡجِدٗا","мечеть",9,107],["ضِرَارٗا","во вред",9,107],["وَكُفۡرٗا","и для неверия",9,107],["وَتَفۡرِيقَۢا","и для раскола",9,107],["بَيۡنَ","между",9,107]],[["ٱلۡمُؤۡمِنِينَ","верующими",9,107],["وَإِرۡصَادٗا","и как засаду",9,107],["لِّمَنۡ","для того, кто",9,107],["حَارَبَ","воевал (против)",9,107],["ٱللَّهَ","Аллаха",9,107],["وَرَسُولَهُۥ","и Его Посланника",9,107],["مِن","с",9,107],["قَبۡلُۚ","прежних пор",9,107]],[["وَلَيَحۡلِفُنَّ","и непременно поклянутся",9,107],["إِنۡ","не",9,107],["أَرَدۡنَآ","хотели мы",9,107],["إِلَّا","кроме",9,107],["ٱلۡحُسۡنَىٰۖ","лучшего",9,107],["وَٱللَّهُ","и Аллах",9,107],["يَشۡهَدُ","свидетельствует",9,107],["إِنَّهُمۡ","поистине, они",9,107],["لَكَٰذِبُونَ","непременно лжецы",9,107]],[[107],["لَا","не",9,108],["تَقُمۡ","стой",9,108],["فِيهِ","в ней",9,108],["أَبَدٗاۚ","никогда",9,108],["لَّمَسۡجِدٌ","воистину, мечеть",9,108],["أُسِّسَ","основанная",9,108],["عَلَى","на",9,108],["ٱلتَّقۡوَىٰ","богобоязненности",9,108],["مِنۡ","с",9,108],["أَوَّلِ","первого",9,108]],[["يَوۡمٍ","дня",9,108],["أَحَقُّ","более достойна",9,108],["أَن","чтобы",9,108],["تَقُومَ","ты стоял",9,108],["فِيهِۚ","в ней",9,108],["فِيهِ","в ней",9,108],["رِجَالٞ","мужи",9,108],["يُحِبُّونَ","любят",9,108],["أَن","чтобы",9,108],["يَتَطَهَّرُواْۚ","очищаться",9,108]],[["وَٱللَّهُ","и Аллах",9,108],["يُحِبُّ","любит",9,108],["ٱلۡمُطَّهِّرِينَ","очищающихся",9,108],[108],["أَفَمَنۡ","разве же тот, кто",9,109],["أَسَّسَ","заложил",9,109],["بُنۡيَٰنَهُۥ","своё строение",9,109]],[["عَلَىٰ","на",9,109],["تَقۡوَىٰ","богобоязненности",9,109],["مِنَ","перед",9,109],["ٱللَّهِ","Аллахом",9,109],["وَرِضۡوَٰنٍ","и (Его) довольстве",9,109],["خَيۡرٌ","лучше",9,109],["أَم","или",9,109],["مَّنۡ","тот, кто",9,109],["أَسَّسَ","заложил",9,109],["بُنۡيَٰنَهُۥ","своё строение",9,109]],[["عَلَىٰ","на",9,109],["شَفَا","краю",9,109],["جُرُفٍ","обрыва",9,109],["هَارٖ","осыпающегося",9,109],["فَٱنۡهَارَ","и оно обрушилось",9,109],["بِهِۦ","с ним",9,109],["فِي","в",9,109],["نَارِ","огонь",9,109],["جَهَنَّمَۗ","Геенны",9,109],["وَٱللَّهُ","и Аллах",9,109],["لَا","не",9,109],["يَهۡدِي","ведёт прямым путём",9,109]],[["ٱلۡقَوۡمَ","людей",9,109],["ٱلظَّٰلِمِينَ","несправедливых",9,109],[109],["لَا","не",9,110],["يَزَالُ","перестанет",9,110],["بُنۡيَٰنُهُمُ","их строение",9,110],["ٱلَّذِي","которое",9,110],["بَنَوۡاْ","они построили",9,110],["رِيبَةٗ","(быть) сомнением",9,110]],[["فِي","в",9,110],["قُلُوبِهِمۡ","их сердцах",9,110],["إِلَّآ","разве только",9,110],["أَن","(когда)",9,110],["تَقَطَّعَ","разорвутся",9,110],["قُلُوبُهُمۡۗ","их сердца",9,110],["وَٱللَّهُ","и Аллах",9,110],["عَلِيمٌ","Знающий",9,110],["حَكِيمٌ","Мудрый",9,110],[110]],[["۞ إِنَّ","поистине",9,111],["ٱللَّهَ","Аллах",9,111],["ٱشۡتَرَىٰ","купил",9,111],["مِنَ","у",9,111],["ٱلۡمُؤۡمِنِينَ","верующих",9,111],["أَنفُسَهُمۡ","их души",9,111],["وَأَمۡوَٰلَهُم","и их имущество",9,111]],[["بِأَنَّ","за то, что",9,111],["لَهُمُ","для них",9,111],["ٱلۡجَنَّةَۚ","Рай",9,111],["يُقَٰتِلُونَ","они сражаются",9,111],["فِي","на",9,111],["سَبِيلِ","пути",9,111],["ٱللَّهِ","Аллаха",9,111],["فَيَقۡتُلُونَ","и убивают",9,111]],[["وَيُقۡتَلُونَۖ","и бывают убиты",9,111],["وَعۡدًا","обещание",9,111],["عَلَيۡهِ","на Нём",9,111],["حَقّٗا","истинное",9,111],["فِي","в",9,111],["ٱلتَّوۡرَىٰةِ","Таурате",9,111],["وَٱلۡإِنجِيلِ","и Инджиле",9,111]],[["وَٱلۡقُرۡءَانِۚ","и Коране",9,111],["وَمَنۡ","и кто",9,111],["أَوۡفَىٰ","вернее",9,111],["بِعَهۡدِهِۦ","своему договору",9,111],["مِنَ","чем",9,111],["ٱللَّهِۚ","Аллах",9,111],["فَٱسۡتَبۡشِرُواْ","радуйтесь же",9,111]],[["بِبَيۡعِكُمُ","вашей сделке",9,111],["ٱلَّذِي","которую",9,111],["بَايَعۡتُم","вы заключили",9,111],["بِهِۦۚ","ею",9,111],["وَذَٰلِكَ","и это",9,111],["هُوَ","оно",9,111],["ٱلۡفَوۡزُ","успех",9,111],["ٱلۡعَظِيمُ","великий",9,111],[111]]]}