{"p":205,"j":11,"a":[[9,112,["ٱلتَّٰٓئِبُونَ","ٱلۡعَٰبِدُونَ","ٱلۡحَٰمِدُونَ","ٱلسَّٰٓئِحُونَ","ٱلرَّٰكِعُونَ","ٱلسَّٰجِدُونَ","ٱلۡأٓمِرُونَ","بِٱلۡمَعۡرُوفِ","وَٱلنَّاهُونَ","عَنِ","ٱلۡمُنكَرِ","وَٱلۡحَٰفِظُونَ","لِحُدُودِ","ٱللَّهِۗ","وَبَشِّرِ","ٱلۡمُؤۡمِنِينَ"],"аттаибуунал `абидуунал хамидуунас саихуунар раки`уунас сажидуунал амирууна билма`рууфи ваннахууна `анил мункари валхафизууна лихудуудиллахи вабашширил му'миниин","Обрадуй верующих, которые каются и поклоняются, восхваляют и постятся (или путешествуют), кланяются и падают ниц, повелевают совершать одобряемое и запрещают предосудительное, и соблюдают ограничения Аллаха.",["кающиеся","поклоняющиеся","восхваляющие","постящиеся (странствующие)","кланяющиеся","падающие ниц","повелевающие","одобряемое","и удерживающие","от","предосудительного","и соблюдающие","границы","Аллаха","и обрадуй","верующих"]],[9,113,["مَا","كَانَ","لِلنَّبِيِّ","وَٱلَّذِينَ","ءَامَنُوٓاْ","أَن","يَسۡتَغۡفِرُواْ","لِلۡمُشۡرِكِينَ","وَلَوۡ","كَانُوٓاْ","أُوْلِي","قُرۡبَىٰ","مِنۢ","بَعۡدِ","مَا","تَبَيَّنَ","لَهُمۡ","أَنَّهُمۡ","أَصۡحَٰبُ","ٱلۡجَحِيمِ"],"ма кана линнабиййи валлазиина амануу ан йастагфируу лилмушрикиина валау кануу улии ḳурба мим ба`ди ма табаййана лахум аннахум асхабул жахиим","Пророку и верующим не подобает просить прощения для многобожников, даже если они являются родственниками, после того, как им стало ясно, что они будут обитателями Ада.",["не","подобало","Пророку","и тем, которые","уверовали","чтобы","они просили прощения","для многобожников","и даже если","были они","обладателями","родства","(из)","после","того как","стало ясно","им","что они","обитатели","Ада"]],[9,114,["وَمَا","كَانَ","ٱسۡتِغۡفَارُ","إِبۡرَٰهِيمَ","لِأَبِيهِ","إِلَّا","عَن","مَّوۡعِدَةٖ","وَعَدَهَآ","إِيَّاهُ","فَلَمَّا","تَبَيَّنَ","لَهُۥٓ","أَنَّهُۥ","عَدُوّٞ","لِّلَّهِ","تَبَرَّأَ","مِنۡهُۚ","إِنَّ","إِبۡرَٰهِيمَ","لَأَوَّٰهٌ","حَلِيمٞ"],"вама канастигфару ибрахиима ли'абиихи илла `ам мау`идатин ва`адаха иййаху фаламма табаййана лахуу аннахуу `адуввул лиллахи табарраа минху инна ибрахиима ла'аввахун халиим","А молитва Ибрахима (Авраама) о прощении для его отца была всего лишь исполнением обещания, которое он ему дал. Когда же ему стало ясно, что его отец является врагом Аллаха, он отрекся от него. Воистину, Ибрахим (Авраам) был смиренным, выдержанным.",["и не","было","прошение прощения","Ибрахима","для его отца","кроме как","из-за","обещания","он обещал его","ему","когда же","стало ясно","ему","что он","враг","Аллаху","он отрёкся","от него","поистине","Ибрахим","непременно смиренный","выдержанный"]],[9,115,["وَمَا","كَانَ","ٱللَّهُ","لِيُضِلَّ","قَوۡمَۢا","بَعۡدَ","إِذۡ","هَدَىٰهُمۡ","حَتَّىٰ","يُبَيِّنَ","لَهُم","مَّا","يَتَّقُونَۚ","إِنَّ","ٱللَّهَ","بِكُلِّ","شَيۡءٍ","عَلِيمٌ"],"вама каналлаху лийудилла ḳаума ба`да из хадахум хатта йубаййина лахум ма йаттаḳууна инналлаха бикулли шай'ин `алиим","Аллах не вводит в заблуждение людей, которым Он указал прямой путь, пока Он не разъяснит им, чего они должны опасаться. Воистину, Аллах знает о всякой вещи.",["и не","было (таково)","Аллаху","чтобы сбивать с пути","людей","после","того как","Он наставил их","пока не","разъяснит","им","то, чего","им остерегаться","поистине","Аллах","о всякой","вещи","Знающий"]],[9,116,["إِنَّ","ٱللَّهَ","لَهُۥ","مُلۡكُ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِۖ","يُحۡيِۦ","وَيُمِيتُۚ","وَمَا","لَكُم","مِّن","دُونِ","ٱللَّهِ","مِن","وَلِيّٖ","وَلَا","نَصِيرٖ"],"инналлаха лахуу мулкус самавати вал'арди йухйии вайумииту вама лакум мин дууниллахи мин валиййин вала насиир","Воистину, Аллаху принадлежит власть над небесами и землей. Он дарует жизнь и умерщвляет. Нет у вас, кроме Аллаха, ни покровителя, ни помощника.",["поистине","Аллах","Ему (принадлежит)","власть","небес","и земли","Он оживляет","и умерщвляет","и нет","у вас","(из)","помимо","Аллаха","никакого","покровителя","и не","помощника"]],[9,117,["لَّقَد","تَّابَ","ٱللَّهُ","عَلَى","ٱلنَّبِيِّ","وَٱلۡمُهَٰجِرِينَ","وَٱلۡأَنصَارِ","ٱلَّذِينَ","ٱتَّبَعُوهُ","فِي","سَاعَةِ","ٱلۡعُسۡرَةِ","مِنۢ","بَعۡدِ","مَا","كَادَ","يَزِيغُ","قُلُوبُ","فَرِيقٖ","مِّنۡهُمۡ","ثُمَّ","تَابَ","عَلَيۡهِمۡۚ","إِنَّهُۥ","بِهِمۡ","رَءُوفٞ","رَّحِيمٞ"],"ллаḳад ттабаллаху `алан набиййи валмухажириина вал'ансарил лазиинаттаба`ууху фии са`атил `усрати мим ба`ди ма када йазиигу ḳулуубу фарииḳим минхум сумма таба `алайхим иннахуу бихим ра'ууфур рахиим","Аллах принял покаяния Пророка, мухаджиров и ансаров, которые последовали за ним в трудный час, после того, как сердца некоторых из них чуть было не уклонились в сторону. Он принял их покаяния, ибо Он - Сострадательный, Милосердный.",["действительно","принял покаяние","Аллах","(у)","Пророка","и мухаджиров","и ансаров","которые","последовали за ним","в","час","тяготы","(из)","после","того как","чуть было","не уклонились","сердца","группы","из них","затем","Он принял покаяние","их","поистине, Он","к ним","Сострадательный","Милосердный"]]],"m":[[["ٱلتَّٰٓئِبُونَ","кающиеся",9,112],["ٱلۡعَٰبِدُونَ","поклоняющиеся",9,112],["ٱلۡحَٰمِدُونَ","восхваляющие",9,112],["ٱلسَّٰٓئِحُونَ","постящиеся (странствующие)",9,112]],[["ٱلرَّٰكِعُونَ","кланяющиеся",9,112],["ٱلسَّٰجِدُونَ","падающие ниц",9,112],["ٱلۡأٓمِرُونَ","повелевающие",9,112],["بِٱلۡمَعۡرُوفِ","одобряемое",9,112]],[["وَٱلنَّاهُونَ","и удерживающие",9,112],["عَنِ","от",9,112],["ٱلۡمُنكَرِ","предосудительного",9,112],["وَٱلۡحَٰفِظُونَ","и соблюдающие",9,112],["لِحُدُودِ","границы",9,112],["ٱللَّهِۗ","Аллаха",9,112]],[["وَبَشِّرِ","и обрадуй",9,112],["ٱلۡمُؤۡمِنِينَ","верующих",9,112],[112],["مَا","не",9,113],["كَانَ","подобало",9,113],["لِلنَّبِيِّ","Пророку",9,113],["وَٱلَّذِينَ","и тем, которые",9,113],["ءَامَنُوٓاْ","уверовали",9,113],["أَن","чтобы",9,113]],[["يَسۡتَغۡفِرُواْ","они просили прощения",9,113],["لِلۡمُشۡرِكِينَ","для многобожников",9,113],["وَلَوۡ","и даже если",9,113],["كَانُوٓاْ","были они",9,113],["أُوْلِي","обладателями",9,113],["قُرۡبَىٰ","родства",9,113],["مِنۢ","(из)",9,113],["بَعۡدِ","после",9,113]],[["مَا","того как",9,113],["تَبَيَّنَ","стало ясно",9,113],["لَ