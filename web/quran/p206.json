{"p":206,"j":11,"a":[[9,118,["وَعَلَى","ٱلثَّلَٰثَةِ","ٱلَّذِينَ","خُلِّفُواْ","حَتَّىٰٓ","إِذَا","ضَاقَتۡ","عَلَيۡهِمُ","ٱلۡأَرۡضُ","بِمَا","رَحُبَتۡ","وَضَاقَتۡ","عَلَيۡهِمۡ","أَنفُسُهُمۡ","وَظَنُّوٓاْ","أَن","لَّا","مَلۡجَأَ","مِنَ","ٱللَّهِ","إِلَّآ","إِلَيۡهِ","ثُمَّ","تَابَ","عَلَيۡهِمۡ","لِيَتُوبُوٓاْۚ","إِنَّ","ٱللَّهَ","هُوَ","ٱلتَّوَّابُ","ٱلرَّحِيمُ"],"ва`алас саласатил лазиина хуллифуу хатта иза даḳат `алайхимул арду бима рахубат вадаḳат `алайхим анфусухум вазаннуу ал ла малжаа миналлахи илла илайхи сумма таба `алайхим лийатуубуу инналлаха хуат таввабур рахиим","Аллах простил и тех троих, которым было отсрочено до тех пор, пока земля не стала тесной для них, несмотря на ее просторы. Их души сжались, и они поняли, что им негде укрыться от Аллаха, кроме как у Него. Затем Он простил их, чтобы они могли раскаяться. Воистину, Аллах - Принимающий покаяния, Милосердный.",["и (у)","троих","которые","были оставлены","так что","когда","стала тесной","для них","земля","при том, что","она просторна","и стали тесны","для них","их души","и поняли они","что","нет","убежища","от","Аллаха","кроме как","к Нему","затем","Он принял покаяние","их","чтобы они каялись","поистине","Аллах","Он","Принимающий покаяния","Милосердный"]],[9,119,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُواْ","ٱتَّقُواْ","ٱللَّهَ","وَكُونُواْ","مَعَ","ٱلصَّٰدِقِينَ"],"йа'аййухал лазиина амануттаḳуллаха вакуунуу ма`ас садиḳиин","О те, которые уверовали! Бойтесь Аллаха и будьте с правдивыми.",["о","те, которые","уверовали","бойтесь","Аллаха","и будьте","с","правдивыми"]],[9,120,["مَا","كَانَ","لِأَهۡلِ","ٱلۡمَدِينَةِ","وَمَنۡ","حَوۡلَهُم","مِّنَ","ٱلۡأَعۡرَابِ","أَن","يَتَخَلَّفُواْ","عَن","رَّسُولِ","ٱللَّهِ","وَلَا","يَرۡغَبُواْ","بِأَنفُسِهِمۡ","عَن","نَّفۡسِهِۦۚ","ذَٰلِكَ","بِأَنَّهُمۡ","لَا","يُصِيبُهُمۡ","ظَمَأٞ","وَلَا","نَصَبٞ","وَلَا","مَخۡمَصَةٞ","فِي","سَبِيلِ","ٱللَّهِ","وَلَا","يَطَـُٔونَ","مَوۡطِئٗا","يَغِيظُ","ٱلۡكُفَّارَ","وَلَا","يَنَالُونَ","مِنۡ","عَدُوّٖ","نَّيۡلًا","إِلَّا","كُتِبَ","لَهُم","بِهِۦ","عَمَلٞ","صَٰلِحٌۚ","إِنَّ","ٱللَّهَ","لَا","يُضِيعُ","أَجۡرَ","ٱلۡمُحۡسِنِينَ"],"ма кана ли'ахлил мадиинати ваман хаулахум минал а`раби ан йатахаллафуу `ар расуулиллахи вала йаргабуу би'анфусихим `ан нафсихии залика би'аннахум ла йусиибухум замаун вала насабун вала махмасатун фии сабиилиллахи вала йатаууна маутиан йагиизул куффара вала йаналууна мин `адуввин найлан илла кутиба лахум бихии `амалун салихун инналлаха ла йудии`у ажрал мухсиниин","Не следовало жителям Медины и бедуинам из окрестностей оставаться позади Посланника Аллаха и отдавать предпочтение собственным жизням перед его жизнью. Это потому, что жажда, усталость и голод, постигающие их на пути Аллаха, и каждый шаг, вызывающий гнев неверующих, и каждое поражение, нанесенное врагу, непременно запишутся им как добрые дела. Воистину, Аллах не теряет вознаграждения творящих добро.",["не","подобало","жителям","Медины","и тем, кто","вокруг них","из","бедуинов","чтобы","они оставались позади","от","Посланника","Аллаха","и не","предпочитали","свои жизни","перед","его жизнью","это","потому что они","не","постигает их","жажда","и не","усталость","и не","голод","на","пути","Аллаха","и не","ступают они","на место","гневящее","неверующих","и не","наносят они","по","врагу","удара","кроме как","записано","им","за это","дело","праведное","поистине","Аллах","не","губит","награду","творящих добро"]],[9,121,["وَلَا","يُنفِقُونَ","نَفَقَةٗ","صَغِيرَةٗ","وَلَا","كَبِيرَةٗ","وَلَا","يَقۡطَعُونَ","وَادِيًا","إِلَّا","كُتِبَ","لَهُمۡ","لِيَجۡزِيَهُمُ","ٱللَّهُ","أَحۡسَنَ","مَا","كَانُواْ","يَعۡمَلُونَ"],"вала йунфиḳууна нафаḳатан сагииратан вала кабииратан вала йаḳта`ууна вадийан илла кутиба лахум лийажзийахумуллаху ахсана ма кануу йа`малуун","Какое бы большое или скудное пожертвование они ни делали, какую бы долину они ни пересекали, это записывается им, дабы Аллах воздал им большим, чем то, что они совершили.",["и не","расходуют они","пожертвования","малого","и не","большого","и не","пересекают они","долину","кроме как","записано","им","чтобы воздал им","Аллах","лучшим","из того, что","они были","делали"]],[9,122,["وَمَا","كَانَ","ٱلۡمُؤۡمِنُونَ","لِيَنفِرُواْ","كَآفَّةٗۚ","فَلَوۡلَا","نَفَرَ","مِن","كُلِّ","فِرۡقَةٖ","مِّنۡهُمۡ","طَآئِفَةٞ","لِّيَتَفَقَّهُواْ","فِي","ٱلدِّينِ","وَلِيُنذِرُواْ","قَوۡمَهُمۡ","إِذَا","رَجَعُوٓاْ","إِلَيۡهِمۡ","لَعَلَّهُمۡ","يَحۡذَرُونَ"],"вама канал му'минууна лийанфируу каффатан фалаула нафара мин кулли фирḳатим минхум таифатул лийатафаḳḳахуу фид диини валийунзируу ḳаумахум иза ража`уу илайхим ла`аллахум йахзаруун","Верующим не следует выступать в поход всем вместе. Почему бы не отправить из каждой группы по отряду, чтобы они могли изучить религию и увещевать людей, когда они вернутся к ним? Быть может, они будут остерегаться.",["и не","подобает","верующим","выступать","всем вместе","почему бы не","выступил","из","каждой","группы","из них","отряд","чтобы постигать","в","религии","и чтобы предостерегали","свой народ","когда","вернутся","к ним","может быть, они","остерегутся"]]],"m":[[["وَعَلَى","и (у)",9,118],["ٱلثَّلَٰثَةِ","троих",9,118],["ٱلَّذِينَ","которые",9,118],["خُلِّفُواْ","были оставлены",9,118],["حَتَّىٰٓ","так что",9,118],["إِذَا","когда",9,118],["ضَاقَتۡ","стала тесной",9,118],["عَلَيۡهِمُ","для них",9,118],["ٱلۡأَرۡضُ","земля",9,118]],[["بِمَا","при том, что",9,118],["رَحُبَتۡ","она просторна",9,118],["وَضَاقَتۡ","и стали тесны",9,118],["عَلَيۡهِمۡ","для них",9,118],["أَنفُسُهُمۡ","их души",9,118],["وَظَنُّوٓاْ","и поняли они",9,118],["أَن","что",9,118],["لَّا","нет",9,118],["مَلۡجَأَ","убежища",9,118]],[["مِنَ","от",9,118],["ٱللَّهِ","Аллаха",9,118],["إِلَّآ","кроме как",9,118],["إِلَيۡهِ","к Нему",9,118],["ثُمَّ","затем",9,118],["تَابَ","Он принял покаяние",9,118],["عَلَيۡهِمۡ","их",9,118],["لِيَتُوبُوٓاْۚ","чтобы они каялись",9,118],["إِنَّ","поистине",9,118],["ٱللَّهَ","Аллах",9,118],["هُوَ","Он",9,118],["ٱلتَّوَّابُ","Принимающий покаяния",9,118]],[["ٱلرَّحِيمُ","Милосердный",9,118],[118],["يَٰٓأَيُّهَا","о",9,119],["ٱلَّ