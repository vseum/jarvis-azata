{"p":207,"j":11,"a":[[9,123,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُواْ","قَٰتِلُواْ","ٱلَّذِينَ","يَلُونَكُم","مِّنَ","ٱلۡكُفَّارِ","وَلۡيَجِدُواْ","فِيكُمۡ","غِلۡظَةٗۚ","وَٱعۡلَمُوٓاْ","أَنَّ","ٱللَّهَ","مَعَ","ٱلۡمُتَّقِينَ"],"йа'аййухал лазиина амануу ḳатилул лазиина йалуунакум минал куффари валйажидуу фиикум гилзатан ва`ламуу анналлаха ма`ал муттаḳиин","О те, которые уверовали! Сражайтесь с неверующими, которые находятся вблизи вас. И пусть они убедятся в вашей суровости. И знайте, что Аллах - с богобоязненными.",["о","те, которые","уверовали","сражайтесь (с)","теми, которые","близки к вам","из","неверующих","и пусть найдут","в вас","суровость","и знайте","что","Аллах","с","богобоязненными"]],[9,124,["وَإِذَا","مَآ","أُنزِلَتۡ","سُورَةٞ","فَمِنۡهُم","مَّن","يَقُولُ","أَيُّكُمۡ","زَادَتۡهُ","هَٰذِهِۦٓ","إِيمَٰنٗاۚ","فَأَمَّا","ٱلَّذِينَ","ءَامَنُواْ","فَزَادَتۡهُمۡ","إِيمَٰنٗا","وَهُمۡ","يَسۡتَبۡشِرُونَ"],"ва'иза ма унзилат сууратун фаминхум ман йаḳуулу аййукум задатху хазихии ииманан фа'аммал лазиина амануу фазадатхум ииманан вахум йастабшируун","Когда ниспосылается сура, то среди них находится такой, который говорит: «Чья вера от этого стала сильнее?». Что касается тех, кто уверовал, то их вера от этого усиливается, и они радуются.",["и когда","бы ни","ниспослана","сура","то среди них","тот, кто","говорит","кому из вас","прибавила (ему)","эта","веры","что же до","тех, которые","уверовали","то прибавила им","веры","и они","радуются"]],[9,125,["وَأَمَّا","ٱلَّذِينَ","فِي","قُلُوبِهِم","مَّرَضٞ","فَزَادَتۡهُمۡ","رِجۡسًا","إِلَىٰ","رِجۡسِهِمۡ","وَمَاتُواْ","وَهُمۡ","كَٰفِرُونَ"],"ва'аммал лазиина фии ḳулуубихим марадун фазадатхум рижсан ила рижсихим ваматуу вахум кафируун","А что касается тех, чьи сердца поражены недугом, то это добавляет сомнение к их сомнению, и поэтому они умрут неверующими.",["а что до","тех, у которых","в","их сердцах","болезнь","то прибавила им","скверны","к","их скверне","и умерли они","и они","неверующие"]],[9,126,["أَوَلَا","يَرَوۡنَ","أَنَّهُمۡ","يُفۡتَنُونَ","فِي","كُلِّ","عَامٖ","مَّرَّةً","أَوۡ","مَرَّتَيۡنِ","ثُمَّ","لَا","يَتُوبُونَ","وَلَا","هُمۡ","يَذَّكَّرُونَ"],"авала йарауна аннахум йуфтанууна фии кулли `амим марратан ау марратайни сумма ла йатуубууна вала хум йаззаккаруун","Неужели они не видят, что каждый год они подвергаются испытанию один или два раза? Они не раскаиваются после этого и не поминают назидание.",["разве не","видят они","что они","подвергаются испытанию","в","каждый","год","раз","или","два раза","затем","не","каются они","и не","они","внемлют назиданию"]],[9,127,["وَإِذَا","مَآ","أُنزِلَتۡ","سُورَةٞ","نَّظَرَ","بَعۡضُهُمۡ","إِلَىٰ","بَعۡضٍ","هَلۡ","يَرَىٰكُم","مِّنۡ","أَحَدٖ","ثُمَّ","ٱنصَرَفُواْۚ","صَرَفَ","ٱللَّهُ","قُلُوبَهُم","بِأَنَّهُمۡ","قَوۡمٞ","لَّا","يَفۡقَهُونَ"],"ва'иза ма унзилат сууратун назара ба`духум ила ба`дин хал йаракум мин ахадин суммансарафуу сарафаллаху ḳулуубахум би'аннахум ḳаумул ла йафḳахуун","Когда ниспосылается сура, они смотрят друг на друга: «Видит ли вас кто-нибудь?». А затем они отворачиваются. Аллах отвратил их сердца, потому что они - люди неразумные.",["и когда","бы ни","ниспослана","сура","смотрят","одни из них","на","других","разве","видит вас","(из)","кто-нибудь","затем","они отворачиваются","отвратил","Аллах","их сердца","потому что они","люди","не","понимают"]],[9,128,["لَقَدۡ","جَآءَكُمۡ","رَسُولٞ","مِّنۡ","أَنفُسِكُمۡ","عَزِيزٌ","عَلَيۡهِ","مَا","عَنِتُّمۡ","حَرِيصٌ","عَلَيۡكُم","بِٱلۡمُؤۡمِنِينَ","رَءُوفٞ","رَّحِيمٞ"],"лаḳад жаакум расуулум мин анфусикум `азиизун `алайхи ма `аниттум хариисун `алайкум билму'миниина ра'ууфур рахиим","К вам явился Посланник из вашей среды. Тяжко для него то, что вы страдаете. Он старается для вас. Он сострадателен и милосерден к верующим.",["действительно","пришёл к вам","посланник","из","вас самих","тяжко","для него","то, что","вы страдаете","заботлив","о вас","к верующим","сострадателен","милосерден"]],[9,129,["فَإِن","تَوَلَّوۡاْ","فَقُلۡ","حَسۡبِيَ","ٱللَّهُ","لَآ","إِلَٰهَ","إِلَّا","هُوَۖ","عَلَيۡهِ","تَوَكَّلۡتُۖ","وَهُوَ","رَبُّ","ٱلۡعَرۡشِ","ٱلۡعَظِيمِ"],"фа'ин таваллау фаḳул хасбийаллаху ла илаха илла хуа `алайхи таваккалту вахуа раббул `аршил `азиим","А если они отвернутся, то скажи: «Мне достаточно Аллаха! Нет божества, кроме Него. Я уповаю только на Него, ибо Он - Господь великого Трона».",["а если","отвернутся они","то скажи","достаточно мне","Аллаха","нет","божества","кроме","Него","на Него","я уповаю","и Он","Господь","Трона","великого"]]],"m":[[["يَٰٓأَيُّهَا","о",9,123],["ٱلَّذِينَ","те, которые",9,123],["ءَامَنُواْ","уверовали",9,123],["قَٰتِلُواْ","сражайтесь (с)",9,123],["ٱلَّذِينَ","теми, которые",9,123],["يَلُونَكُم","близки к вам",9,123],["مِّنَ","из",9,123],["ٱلۡكُفَّارِ","неверующих",9,123]],[["وَلۡيَجِدُواْ","и пусть найдут",9,123],["فِيكُمۡ","в вас",9,123],["غِلۡظَةٗۚ","суровость",9,123],["وَٱعۡلَمُوٓاْ","и знайте",9,123],["أَنَّ","что",9,123],["ٱللَّهَ","Аллах",9,123],["مَعَ","с",9,123],["ٱلۡمُتَّقِينَ","богобоязненными",9,123],[123]],[["وَإِذَا","и когда",9,124],["مَآ","бы ни",9,124],["أُنزِلَتۡ","ниспослана",9,124],["سُورَةٞ","сура",9,124],["فَمِنۡهُم","то среди них",9,124],["مَّن","тот, кто",9,124],["يَقُولُ","говорит",9,124],["أَيُّكُمۡ","кому из вас",9,124],["زَادَتۡهُ","прибавила (ему)",9,124],["هَٰذِهِۦٓ","эта",9,124]],[["إِيمَٰنٗاۚ","веры",9,124],["فَأَمَّا","что же до",9,124],["ٱلَّذِينَ","тех, которые",9,124],["ءَامَنُواْ","уверовали",9,124],["فَزَادَتۡهُمۡ","то прибавила им",9,124],["إِيمَٰنٗا","веры",9,124],["وَهُمۡ","и они",9,124],["يَسۡتَبۡشِرُونَ","радуются",9,124]],[[124],["وَأَمَّا","а что до",9,125],["ٱلَّذِينَ","тех, у которых",9,125],["فِي","в",9,125],["قُلُوبِهِم","их сердцах",9,125],["مَّرَضٞ","болезнь",9,125],["فَزَادَتۡهُمۡ","то прибавила им",9,125],["رِجۡسًا","скверны",9,125]],[["إِلَىٰ","к",9,125],["رِجۡسِهِمۡ","их скверне",9,125],["وَمَاتُواْ","и умерли они",9,125],["وَهُمۡ","и они",9,125],["كَٰفِرُونَ","неверующие",9,125],[125],["أَوَلَا","разве не",9,126],["يَرَوۡنَ","видят они",9,126]],[["أَنَّهُمۡ","что они",9,126],["يُفۡتَنُونَ","подвергаются испытанию",9,126],["فِي","в",9,126],["كُلِّ","каждый",9,126],["عَامٖ","год",9,126],["مَّرَّةً","раз",9,126],["أَوۡ","или",9,126],["مَرَّتَيۡنِ","два раза",9,126],["ثُمَّ","затем",9,126]],[["لَا","не",9,126],["يَتُوبُونَ","каются они",9,126],["وَلَا","и не",9,126],["هُمۡ","они",9,126],["يَذَّكَّرُونَ","внемлют назиданию",9,126],[126],["وَإِذَا","и когда",9,127],["مَآ","бы ни",9,127],["أُنزِلَتۡ","ниспослана",9,127]],[["سُورَةٞ","сура",9,127],["نَّظَرَ","смотрят",9,127],["بَعۡضُهُمۡ","одни из них",9,127],["إِلَىٰ","на",9,127],["بَعۡضٍ","других",9,127],["هَلۡ","разве",9,127],["يَرَىٰكُم","видит вас",9,127],["مِّنۡ","(из)",9,127],["أَحَدٖ","кто-нибудь",9,127]],[["ثُمَّ","затем",9,127],["ٱنصَرَفُواْۚ","они отворачиваются",9,127],["صَرَفَ","отвратил",9,127],["ٱللَّهُ","Аллах",9,127],["قُلُوبَهُم","их сердца",9,127],["بِأَنَّهُمۡ","потому что они",9,127],["قَوۡمٞ","люди",9,127],["لَّا","не",9,127],["يَفۡقَهُونَ","понимают",9,127]],[[127],["لَقَدۡ","действительно",9,128],["جَآءَكُمۡ","пришёл к вам",9,128],["رَسُولٞ","посланник",9,128],["مِّنۡ","из",9,128],["أَنفُسِكُمۡ","вас самих",9,128],["عَزِيزٌ","тяжко",9,128]],[["عَلَيۡهِ","для него",9,128],["مَا","то, что",9,128],["عَنِتُّمۡ","вы страдаете",9,128],["حَرِيصٌ","заботлив",9,128],["عَلَيۡكُم","о вас",9,128],["بِٱلۡمُؤۡمِنِينَ","к верующим",9,128]],[["رَءُوفٞ","сострадателен",9,128],["رَّحِيمٞ","милосерден",9,128],[128],["فَإِن","а если",9,129],["تَوَلَّوۡاْ","отвернутся они",9,129],["فَقُلۡ","то скажи",9,129],["حَسۡبِيَ","достаточно мне",9,129],["ٱللَّهُ","Аллаха",9,129],["لَآ","нет",9,129],["إِلَٰهَ","божества",9,129]],[["إِلَّا","кроме",9,129],["هُوَۖ","Него",9,129],["عَلَيۡهِ","на Него",9,129],["تَوَكَّلۡتُۖ","я уповаю",9,129],["وَهُوَ","и Он",9,129],["رَبُّ","Господь",9,129],["ٱلۡعَرۡشِ","Трона",9,129],["ٱلۡعَظِيمِ","великого",9,129],[129]],["h",10]]}