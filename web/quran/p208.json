{"p":208,"j":11,"a":[[10,1,["الٓرۚ","تِلۡكَ","ءَايَٰتُ","ٱلۡكِتَٰبِ","ٱلۡحَكِيمِ"],"лр тилка айатул китабил хакиим","Алиф. Лам. Ра. Это - аяты мудрого Писания.",["Алиф Лам Ра","это","аяты","Писания","мудрого"]],[10,2,["أَكَانَ","لِلنَّاسِ","عَجَبًا","أَنۡ","أَوۡحَيۡنَآ","إِلَىٰ","رَجُلٖ","مِّنۡهُمۡ","أَنۡ","أَنذِرِ","ٱلنَّاسَ","وَبَشِّرِ","ٱلَّذِينَ","ءَامَنُوٓاْ","أَنَّ","لَهُمۡ","قَدَمَ","صِدۡقٍ","عِندَ","رَبِّهِمۡۗ","قَالَ","ٱلۡكَٰفِرُونَ","إِنَّ","هَٰذَا","لَسَٰحِرٞ","مُّبِينٌ"],"акана линнаси `ажабан ан аухайна ила ражулим минхум ан анзирин наса вабашширил лазиина амануу анна лахум ḳадама сидḳин `инда раббихим ḳалал кафирууна инна хаза ласахирум мубиин","Неужели люди удивлены тем, что Мы внушили человеку из их среды предостеречь людей и обрадовать уверовавших вестью о том, что они получат от их Господа воздаяние за свои благодеяния? Неверующие сказали: «Безусловно, это - явный колдун».",["разве было","для людей","удивительным","что","Мы внушили","к","человеку","из них","что","предостерегай","людей","и обрадуй","тех, которые","уверовали","что","для них","положение","истинное","у","их Господа","сказали","неверующие","поистине","этот","непременно колдун","явный"]],[10,3,["إِنَّ","رَبَّكُمُ","ٱللَّهُ","ٱلَّذِي","خَلَقَ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضَ","فِي","سِتَّةِ","أَيَّامٖ","ثُمَّ","ٱسۡتَوَىٰ","عَلَى","ٱلۡعَرۡشِۖ","يُدَبِّرُ","ٱلۡأَمۡرَۖ","مَا","مِن","شَفِيعٍ","إِلَّا","مِنۢ","بَعۡدِ","إِذۡنِهِۦۚ","ذَٰلِكُمُ","ٱللَّهُ","رَبُّكُمۡ","فَٱعۡبُدُوهُۚ","أَفَلَا","تَذَكَّرُونَ"],"инна раббакумуллахул лазии халаḳас самавати вал'арда фии ситтати аййамин суммастава `алал `арши йудаббирул амра ма мин шафии`ин илла мим ба`ди изнихии заликумуллаху раббукум фа`будууху афала тазаккаруун","Воистину, ваш Господь - Аллах, Который создал небеса и землю за шесть дней, а потом вознесся на Трон (или утвердился на Троне). Он управляет делами. Никто не будет заступаться, кроме как после Его дозволения. Таков Аллах, ваш Господь. Поклоняйтесь же Ему. Неужели вы не помяните назидание?",["поистине","ваш Господь","Аллах","Который","создал","небеса","и землю","за","шесть","дней","затем","вознёсся","на","Трон","управляет","делами","нет","никакого","заступника","кроме как","(из)","после","Его дозволения","таков","Аллах","ваш Господь","поклоняйтесь же Ему","неужели же не","вы помяните назидание"]],[10,4,["إِلَيۡهِ","مَرۡجِعُكُمۡ","جَمِيعٗاۖ","وَعۡدَ","ٱللَّهِ","حَقًّاۚ","إِنَّهُۥ","يَبۡدَؤُاْ","ٱلۡخَلۡقَ","ثُمَّ","يُعِيدُهُۥ","لِيَجۡزِيَ","ٱلَّذِينَ","ءَامَنُواْ","وَعَمِلُواْ","ٱلصَّٰلِحَٰتِ","بِٱلۡقِسۡطِۚ","وَٱلَّذِينَ","كَفَرُواْ","لَهُمۡ","شَرَابٞ","مِّنۡ","حَمِيمٖ","وَعَذَابٌ","أَلِيمُۢ","بِمَا","كَانُواْ","يَكۡفُرُونَ"],"илайхи маржи`укум жамии`ан ва`даллахи хаḳḳан иннахуу йабдаул халḳа сумма йу`иидухуу лийажзийал лазиина амануу ва`амилус салихати билḳисти валлазиина кафаруу лахум шарабум мин хамиимин ва`азабун алииму бима кануу йакфуруун","Все вы возвратитесь к Нему, согласно истинному обещанию Аллаха. Он создает творение в первый раз, а затем воссоздает его, чтобы по справедливости вознаградить тех, которые уверовали и совершали праведные деяния. Тем же, которые не уверовали, уготованы напиток из кипятка и мучительные страдания за то, что они не уверовали.",["к Нему","ваше возвращение","всех вместе","обещание","Аллаха","истинно","поистине, Он","начинает","творение","затем","повторяет его","чтобы воздать","тем, которые","уверовали","и совершали","праведные деяния","по справедливости","а те, которые","не уверовали","для них","питьё","из","кипятка","и наказание","мучительное","за то, что","они были","не веровали"]],[10,5,["هُوَ","ٱلَّذِي","جَعَلَ","ٱلشَّمۡسَ","ضِيَآءٗ","وَٱلۡقَمَرَ","نُورٗا","وَقَدَّرَهُۥ","مَنَازِلَ","لِتَعۡلَمُواْ","عَدَدَ","ٱلسِّنِينَ","وَٱلۡحِسَابَۚ","مَا","خَلَقَ","ٱللَّهُ","ذَٰلِكَ","إِلَّا","بِٱلۡحَقِّۚ","يُفَصِّلُ","ٱلۡأٓيَٰتِ","لِقَوۡمٖ","يَعۡلَمُونَ"],"хуал лазии жа`алаш шамса дийаан валḳамара нууран ваḳаддарахуу маназила лита`ламуу `ададас синиина валхисаба ма халаḳаллаху залика илла билхаḳḳи йуфассилул айати лиḳаумин йа`ламуун","Он - Тот, Кто даровал солнцу сияние, а луне - свет. Он установил для нее фазы, чтобы вы могли вести летосчисление и знали счет. Все это Аллах сотворил только ради истины. Он разъясняет Свои знамения для людей знающих.",["Он","Тот, Кто","сделал","солнце","сиянием","и луну","светом","и определил ей","стоянки","чтобы вы знали","число","лет","и счёт","не","создал","Аллах","это","кроме как","с истиной","Он разъясняет","знамения","для людей","знающих"]],[10,6,["إِنَّ","فِي","ٱخۡتِلَٰفِ","ٱلَّيۡلِ","وَٱلنَّهَارِ","وَمَا","خَلَقَ","ٱللَّهُ","فِي","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِ","لَأٓيَٰتٖ","لِّقَوۡمٖ","يَتَّقُونَ"],"инна фихтилафил лайли ваннахари вама халаḳаллаху фис самавати вал'арди ла'айатил лиḳаумин йаттаḳуун","Воистину, в смене ночи и дня, а также том, что Аллах сотворил на небесах и на земле, заключены знамения для людей богобоязненных.",["поистине","в","смене","ночи","и дня","и (в) том, что","создал","Аллах","на","небесах","и земле","непременно знамения","для людей","богобоязненных"]]],"m":[["b"],[["الٓرۚ","Алиф Лам Ра",10,1],["تِلۡكَ","это",10,1],["ءَايَٰتُ","аяты",10,1],["ٱلۡكِتَٰبِ","Писания",10,1],["ٱلۡحَكِيمِ","мудрого",10,1],[1],["أَكَانَ","разве было",10,2],["لِلنَّاسِ","для людей",10,2],["عَجَبًا","удивительным",10,2]],[["أَنۡ","что",10,2],["أَوۡحَيۡنَآ","Мы внушили",10,2],["إِلَىٰ","к",10,2],["رَجُلٖ","человеку",10,2],["مِّنۡهُمۡ","из них",10,2],["أَنۡ","что",10,2],["أَنذِرِ","предостерегай",10,2],["ٱلنَّاسَ","людей",10,2],["وَبَشِّرِ","и обрадуй",10,2],["ٱلَّذِينَ","тех, которые",10,2],["ءَامَنُوٓاْ","уверовали",10,2]],[["أَنَّ","что",10,2],["لَهُمۡ","для них",10,2],["قَدَمَ","положение",10,2],["صِدۡقٍ","истинное",10,2],["عِندَ","у",10,2],["رَبِّهِمۡۗ","их Господа",10,2],["قَالَ","сказали",10,2],["ٱلۡكَٰفِرُونَ","неверующие",10,2],["إِنَّ","поистине",10,2],["هَٰذَا","этот",10,2]],[["لَسَٰحِرٞ","непременно колдун",10,2],["مُّبِينٌ","явный",10,2],[2],["إِنَّ","поистине",10,3],["رَبَّكُمُ","ваш Господь",10,3],["ٱللَّهُ","Аллах",10,3],["ٱلَّذِي","Которы