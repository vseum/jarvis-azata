هُۥۚ","коснувшейся его",10,12],["كَذَٰلِكَ","так",10,12],["زُيِّنَ","приукрашено",10,12]],[["لِلۡمُسۡرِفِينَ","для излишествующих",10,12],["مَا","то, что",10,12],["كَانُواْ","они были",10,12],["يَعۡمَلُونَ","совершали",10,12],[12],["وَلَقَدۡ","И уже",10,13],["أَهۡلَكۡنَا","Мы погубили",10,13],["ٱلۡقُرُونَ","поколения",10,13]],[["مِن","из",10,13],["قَبۡلِكُمۡ","до вас",10,13],["لَمَّا","когда",10,13],["ظَلَمُواْ","они поступили несправедливо",10,13],["وَجَآءَتۡهُمۡ","и пришли к ним",10,13],["رُسُلُهُم","их посланники",10,13],["بِٱلۡبَيِّنَٰتِ","с ясными знамениями",10,13],["وَمَا","но не",10,13],["كَانُواْ","были они",10,13]],[["لِيُؤۡمِنُواْۚ","чтобы уверовать",10,13],["كَذَٰلِكَ","так",10,13],["نَجۡزِي","Мы воздаём",10,13],["ٱلۡقَوۡمَ","людям",10,13],["ٱلۡمُجۡرِمِينَ","грешным",10,13],[13],["ثُمَّ","Затем",10,14],["جَعَلۡنَٰكُمۡ","Мы сделали вас",10,14]],[["خَلَٰٓئِفَ","преемниками",10,14],["فِي","на",10,14],["ٱلۡأَرۡضِ","земле",10,14],["مِنۢ","из",10,14],["بَعۡدِهِمۡ","после них",10,14],["لِنَنظُرَ","чтобы Нам посмотреть",10,14],["كَيۡفَ","как",10,14],["تَعۡمَلُونَ","вы поступаете",10,14],[14]]]}