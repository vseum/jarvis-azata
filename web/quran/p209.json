{"p":209,"j":11,"a":[[10,7,["إِنَّ","ٱلَّذِينَ","لَا","يَرۡجُونَ","لِقَآءَنَا","وَرَضُواْ","بِٱلۡحَيَوٰةِ","ٱلدُّنۡيَا","وَٱطۡمَأَنُّواْ","بِهَا","وَٱلَّذِينَ","هُمۡ","عَنۡ","ءَايَٰتِنَا","غَٰفِلُونَ"],"иннал лазиина ла йаржууна лиḳаана варадуу билхайаватид дунйа ватмааннуу биха валлазиина хум `ан айатина гафилуун","Воистину, тем, которые не надеются на встречу с Нами, довольствуются мирской жизнью и удовлетворяются ею, а также тем, которые пренебрегают Нашими знамениями,",["поистине","те, которые","не","надеются на","встречу с Нами","и довольны","жизнью","мирской","и успокоились","ею","и те, которые","они","к","Нашим знамениям","небрежны"]],[10,8,["أُوْلَٰٓئِكَ","مَأۡوَىٰهُمُ","ٱلنَّارُ","بِمَا","كَانُواْ","يَكۡسِبُونَ"],"улаика ма'вахумун нару бима кануу йаксибуун","пристанищем будет Огонь за то, что они приобретали.",["те","их пристанище","Огонь","за то, что","они были","приобретали"]],[10,9,["إِنَّ","ٱلَّذِينَ","ءَامَنُواْ","وَعَمِلُواْ","ٱلصَّٰلِحَٰتِ","يَهۡدِيهِمۡ","رَبُّهُم","بِإِيمَٰنِهِمۡۖ","تَجۡرِي","مِن","تَحۡتِهِمُ","ٱلۡأَنۡهَٰرُ","فِي","جَنَّٰتِ","ٱلنَّعِيمِ"],"иннал лазиина амануу ва`амилус салихати йахдиихим раббухум би'ииманихим тажрии мин тахтихимул анхару фии жаннатин на`иим","Воистину, тех, которые уверовали и совершали праведные деяния, Господь поведет верным путем за их веру. В Садах блаженства под ними будут течь реки.",["поистине","те, которые","уверовали","и совершали","праведные деяния","поведёт их","их Господь","благодаря их вере","текут","из","под ними","реки","в","садах","блаженства"]],[10,10,["دَعۡوَىٰهُمۡ","فِيهَا","سُبۡحَٰنَكَ","ٱللَّهُمَّ","وَتَحِيَّتُهُمۡ","فِيهَا","سَلَٰمٞۚ","وَءَاخِرُ","دَعۡوَىٰهُمۡ","أَنِ","ٱلۡحَمۡدُ","لِلَّهِ","رَبِّ","ٱلۡعَٰلَمِينَ"],"да`вахум фииха субханакаллахумма ватахиййатухум фииха саламун ва'ахиру да`вахум анил хамду лиллахи раббил `аламиин","Там они будут взывать: «Пречист Ты, Аллах!». Там их приветствием будет слово: «Мир!». А их молитвы будут завершатся словами: «Хвала Аллаху, Господу миров!».",["Их мольба","там","Пречист Ты","о Аллах","и их приветствие","там","мир","и последняя","их мольбы","что","хвала","Аллаху","Господу","миров"]],[10,11,["وَلَوۡ","يُعَجِّلُ","ٱللَّهُ","لِلنَّاسِ","ٱلشَّرَّ","ٱسۡتِعۡجَالَهُم","بِٱلۡخَيۡرِ","لَقُضِيَ","إِلَيۡهِمۡ","أَجَلُهُمۡۖ","فَنَذَرُ","ٱلَّذِينَ","لَا","يَرۡجُونَ","لِقَآءَنَا","فِي","طُغۡيَٰنِهِمۡ","يَعۡمَهُونَ"],"валау йу`ажжилуллаху линнасиш шаррасти`жалахум билхайри лаḳудийа илайхим ажалухум фаназарул лазиина ла йаржууна лиḳаана фии тугйанихим йа`махуун","Если бы Аллах ускорил для людей наступление зла, которое они призывают в своих проклятиях, подобно тому, как Он ускорил для них наступление добра, о котором они просят в молитвах, то они непременно погибли бы. Но Мы оставляем тех, которые не надеются на встречу с Нами, слепо скитаться в своем беззаконии.",["И если бы","ускорял","Аллах","для людей","зло","как их торопление","к добру","непременно был бы завершён","для них","их срок","но Мы оставляем","тех, которые","не","надеются на","встречу с Нами","в","их беззаконии","скитаться вслепую"]],[10,12,["وَإِذَا","مَسَّ","ٱلۡإِنسَٰنَ","ٱلضُّرُّ","دَعَانَا","لِجَنۢبِهِۦٓ","أَوۡ","قَاعِدًا","أَوۡ","قَآئِمٗا","فَلَمَّا","كَشَفۡنَا","عَنۡهُ","ضُرَّهُۥ","مَرَّ","كَأَن","لَّمۡ","يَدۡعُنَآ","إِلَىٰ","ضُرّٖ","مَّسَّهُۥۚ","كَذَٰلِكَ","زُيِّنَ","لِلۡمُسۡرِفِينَ","مَا","كَانُواْ","يَعۡمَلُونَ"],"ва'иза массал инсанад дурру да`ана лижамбихии ау ḳа`идан ау ḳаиман фаламма кашафна `анху дуррахуу марра ка'ал лам йад`уна ила дуррим массахуу казалика зуййина лилмусрифиина ма кануу йа`малуун","Когда человека поражает горе, он взывает к Нам и лежа на боку, и сидя, и стоя. Когда же Мы избавляем его от напасти, он проходит, словно никогда не взывал к Нам по поводу постигшего его несчастья. Вот как приукрашено для тех, кто излишествует, то, что они совершают.",["И когда","касается","человека","беда","он взывает к Нам","лёжа на боку","или","сидя","или","стоя","но когда","Мы устранили","от него","его беду","он проходит","словно","не","взывал к Нам","к","беде","коснувшейся его","так","приукрашено","для излишествующих","то, что","они были","совершали"]],[10,13,["وَلَقَدۡ","أَهۡلَكۡنَا","ٱلۡقُرُونَ","مِن","قَبۡلِكُمۡ","لَمَّا","ظَلَمُواْ","وَجَآءَتۡهُمۡ","رُسُلُهُم","بِٱلۡبَيِّنَٰتِ","وَمَا","كَانُواْ","لِيُؤۡمِنُواْۚ","كَذَٰلِكَ","نَجۡزِي","ٱلۡقَوۡمَ","ٱلۡمُجۡرِمِينَ"],"валаḳад ахлакнал ḳурууна мин ḳабликум ламма заламуу важаатхум русулухум билбаййинати вама кануу лийу'минуу казалика нажзил ḳаумал мужримиин","Мы погубили поколения, жившие до вас, поскольку они поступали несправедливо и не уверовали в Наших посланников, явившихся к ним с ясными знамениями. Так Мы наказываем грешных людей.",["И уже","Мы погубили","поколения","из","до вас","когда","они поступили несправедливо","и пришли к ним","их посланники","с ясными знамениями","но не","были они","чтобы уверовать","так","Мы воздаём","людям","грешным"]],[10,14,["ثُمَّ","جَعَلۡنَٰكُمۡ","خَلَٰٓئِفَ","فِي","ٱلۡأَرۡضِ","مِنۢ","بَعۡدِهِمۡ","لِنَنظُرَ","كَيۡفَ","تَعۡمَلُونَ"],"сумма жа`алнакум халаифа фил арди мим ба`дихим линанзура кайфа та`малуун","Потом Мы сделали вас их преемниками на земле, чтобы посмотреть, как вы будете поступать.",["Затем","Мы сделали вас","преемниками","на","земле","из","после них","чтобы Нам посмотреть","как","вы поступаете"]]],"m":[[["إِنَّ","поистине",10,7],["ٱلَّذِينَ","те, которые",10,7],["لَا","не",10,7],["يَرۡجُونَ","надеются на",10,7],["لِقَآءَنَا","встречу с Нами",10,7],["وَرَضُواْ","и довольны",10,7],["بِٱلۡحَيَوٰةِ","жизнью",10,7],["ٱلدُّنۡيَا","мирской",10,7],["وَٱطۡمَأَنُّواْ","и успокоились",10,7]],[["بِهَا","ею",10,7],["وَٱلَّذِينَ","и те, которые",10,7],["هُمۡ","они",10,7],["عَنۡ","к",10,7],["ءَايَٰتِنَا","Нашим знамениям",10,7],["غَٰفِلُونَ","небрежны",10,7],[7],["أُوْلَٰٓئِكَ","те",10,8],["مَأۡوَىٰهُمُ","их пристанище",10,8]],[["ٱلنَّارُ","Огонь",10,8],["بِمَا","за то, что",10,8],["كَانُواْ","они были",10,8],["يَكۡسِبُونَ","приобретали",10,8],[8],["إِنَّ","поистине",10,9],["ٱلَّذِينَ","те, которые",10,9],["ءَامَنُواْ","у