{"p":210,"j":11,"a":[[10,15,["وَإِذَا","تُتۡلَىٰ","عَلَيۡهِمۡ","ءَايَاتُنَا","بَيِّنَٰتٖ","قَالَ","ٱلَّذِينَ","لَا","يَرۡجُونَ","لِقَآءَنَا","ٱئۡتِ","بِقُرۡءَانٍ","غَيۡرِ","هَٰذَآ","أَوۡ","بَدِّلۡهُۚ","قُلۡ","مَا","يَكُونُ","لِيٓ","أَنۡ","أُبَدِّلَهُۥ","مِن","تِلۡقَآيِٕ","نَفۡسِيٓۖ","إِنۡ","أَتَّبِعُ","إِلَّا","مَا","يُوحَىٰٓ","إِلَيَّۖ","إِنِّيٓ","أَخَافُ","إِنۡ","عَصَيۡتُ","رَبِّي","عَذَابَ","يَوۡمٍ","عَظِيمٖ"],"ва'иза тутла `алайхим айатуна баййинатин ḳалал лазиина ла йаржууна лиḳаанати биḳур'анин гайри хаза ау баддилху ḳул ма йакууну лии ан убаддилахуу мин тилḳайи нафсии ин аттаби`у илла ма йууха илаййа иннии ахафу ин `асайту раббии `азаба йаумин `азиим","Когда Наши ясные аяты читают тем, которые не надеются на встречу с Нами, они говорят: «Принеси нам другой Коран или замени его!». Скажи: «Не подобает мне заменять его по своему желанию. Я лишь следую тому, что внушается мне в откровении, и боюсь, что если я ослушаюсь Господа моего, то меня постигнут мучения в Великий день».",["И когда","читаются","им","Наши аяты","ясными","сказали","те, которые","не","надеются на","встречу с Нами","принеси","Коран","иной, чем","этот","или","замени его","скажи","не","подобает","мне","чтобы","я заменил его","по","побуждению","моей души","не","я следую","кроме","того, что","внушается","мне","поистине, я","боюсь","если","я ослушаюсь","моего Господа","мучения","дня","великого"]],[10,16,["قُل","لَّوۡ","شَآءَ","ٱللَّهُ","مَا","تَلَوۡتُهُۥ","عَلَيۡكُمۡ","وَلَآ","أَدۡرَىٰكُم","بِهِۦۖ","فَقَدۡ","لَبِثۡتُ","فِيكُمۡ","عُمُرٗا","مِّن","قَبۡلِهِۦٓۚ","أَفَلَا","تَعۡقِلُونَ"],"ḳул лау шааллаху ма талаутухуу `алайкум вала адракум бихии фаḳад лабисту фиикум `умурам мин ḳаблихии афала та`ḳилуун","Скажи: «Если бы Аллах пожелал, то я не стал бы читать его вам, и Он не стал бы обучать вас ему. Прежде я прожил с вами целую жизнь. Неужели вы не разумеете?».",["Скажи","если бы","пожелал","Аллах","не","я читал бы его","вам","и не","дал бы Он знать вам","о нём","ведь уже","я пробыл","среди вас","целую жизнь","из","до него","неужели не","вы разумеете"]],[10,17,["فَمَنۡ","أَظۡلَمُ","مِمَّنِ","ٱفۡتَرَىٰ","عَلَى","ٱللَّهِ","كَذِبًا","أَوۡ","كَذَّبَ","بِـَٔايَٰتِهِۦٓۚ","إِنَّهُۥ","لَا","يُفۡلِحُ","ٱلۡمُجۡرِمُونَ"],"фаман азламу мимманифтара `алаллахи казибан ау каззаба би'айатихии иннахуу ла йуфлихул мужримуун","Кто может быть несправедливее того, кто возвел на Аллаха навет или отверг Его знамения? Воистину, грешники не преуспеют.",["И кто","несправедливее","того, кто","измыслил","на","Аллаха","ложь","или","счёл ложью","Его знамения","поистине","не","преуспеют","грешники"]],[10,18,["وَيَعۡبُدُونَ","مِن","دُونِ","ٱللَّهِ","مَا","لَا","يَضُرُّهُمۡ","وَلَا","يَنفَعُهُمۡ","وَيَقُولُونَ","هَٰٓؤُلَآءِ","شُفَعَٰٓؤُنَا","عِندَ","ٱللَّهِۚ","قُلۡ","أَتُنَبِّـُٔونَ","ٱللَّهَ","بِمَا","لَا","يَعۡلَمُ","فِي","ٱلسَّمَٰوَٰتِ","وَلَا","فِي","ٱلۡأَرۡضِۚ","سُبۡحَٰنَهُۥ","وَتَعَٰلَىٰ","عَمَّا","يُشۡرِكُونَ"],"вайа`будууна мин дууниллахи ма ла йадуррухум вала йанфа`ухум вайаḳуулууна ха'улаи шуфа`ауна `индаллахи ḳул атунаббиууналлаха бима ла йа`ламу фис самавати вала фил арди субханахуу вата`ала `амма йушрикуун","Они поклоняются наряду с Аллахом тому, что не причиняет им вреда и не приносит им пользы. Они говорят: «Они - наши заступники перед Аллахом». Скажи: «Разве вы можете поведать Аллаху такое на небесах и на земле, чего бы Он не знал?». Пречист Он и превыше тех, кого вы приобщаете в сотоварищи.",["И они поклоняются","из","помимо","Аллаха","тому, что","не","вредит им","и не","приносит пользы им","и они говорят","эти","наши заступники","перед","Аллахом","скажи","разве вы сообщаете","Аллаху","о том, что","не","Он знает","на","небесах","и не","на","земле","Пречист Он","и превыше","того, что","они придают в сотоварищи"]],[10,19,["وَمَا","كَانَ","ٱلنَّاسُ","إِلَّآ","أُمَّةٗ","وَٰحِدَةٗ","فَٱخۡتَلَفُواْۚ","وَلَوۡلَا","كَلِمَةٞ","سَبَقَتۡ","مِن","رَّبِّكَ","لَقُضِيَ","بَيۡنَهُمۡ","فِيمَا","فِيهِ","يَخۡتَلِفُونَ"],"вама канан насу илла умматан вахидатан фахталафуу валаула калиматун сабаḳат мир раббика лаḳудийа байнахум фиима фиихи йахталифуун","Люди были единой общиной верующих, но впали в разногласия. И если бы прежде не было Слова твоего Господа, то их разногласия были бы разрешены.",["И не","были","люди","кроме","общиной","единой","и они разошлись","и если бы не","слово","предшествовавшее","от","твоего Господа","непременно было бы решено","между ними","в том, что","в нём","они расходятся"]],[10,20,["وَيَقُولُونَ","لَوۡلَآ","أُنزِلَ","عَلَيۡهِ","ءَايَةٞ","مِّن","رَّبِّهِۦۖ","فَقُلۡ","إِنَّمَا","ٱلۡغَيۡبُ","لِلَّهِ","فَٱنتَظِرُوٓاْ","إِنِّي","مَعَكُم","مِّنَ","ٱلۡمُنتَظِرِينَ"],"вайаḳуулууна лаула унзила `алайхи айатум мир раббихии фаḳул иннамал гайбу лиллахи фантазируу иннии ма`акум минал мунтазириин","Неверующие говорят: «Почему ему не ниспослано знамение от его Господа?». Скажи: «Сокровенное принадлежит одному Аллаху. Ждите, и я подожду вместе с вами».",["И они говорят","почему не","ниспослано","ему","знамение","от","его Господа","скажи же","лишь","сокровенное","у Аллаха","ждите же","поистине, я","с вами","из","ожидающих"]]],"m":[[["وَإِذَا","И когда",10,15],["تُتۡلَىٰ","читаются",10,15],["عَلَيۡهِمۡ","им",10,15],["ءَايَاتُنَا","Наши аяты",10,15],["بَيِّنَٰتٖ","ясными",10,15],["قَالَ","сказали",10,15],["ٱلَّذِينَ","те, которые",10,15],["لَا","не",10,15],["يَرۡجُونَ","надеются на",10,15]],[["لِقَآءَنَا","встречу с Нами",10,15],["ٱئۡتِ","принеси",10,15],["بِقُرۡءَانٍ","Коран",10,15],["غَيۡرِ","иной, чем",10,15],["هَٰذَآ","этот",10,15],["أَوۡ","или",10,15],["بَدِّلۡهُۚ","замени его",10,15],["قُلۡ","скажи",10,15],["مَا","не",10,15],["يَكُونُ","подобает",10,15],["لِيٓ","мне",10,15]],[["أَنۡ","чтобы",10,15],["أُبَدِّلَهُۥ","я заменил его",10,15],["مِن","по",10,15],["تِلۡقَآيِٕ","побуждению",10,15],["نَفۡسِيٓۖ","моей души",10,15],["إِنۡ","не",10,15],["أَتَّبِعُ","я следую",10,15],["إِلَّا","кроме",10,15],["مَا","того, что",10,15],["يُوحَىٰٓ","внушается",10,15],["إِلَيَّۖ","мне",10,15],["إِنِّيٓ","поистине, я",10,15]],[["أَخَافُ","боюсь",10,15],["إِنۡ","если",10,15],["عَصَيۡتُ","я ослушаюсь",10,15],["رَبِّي","моего Господа",10,15],["عَذَابَ","мучения",10,15],["يَوۡمٍ","дня",10,15],["عَظِيمٖ","великого",10,15],[15],["قُل","Скажи",10,16],["لَّوۡ","если бы",10,16],["شَآءَ","пожелал",10,16]],[["ٱللَّهُ","Аллах",10,16],["مَا","не",10,16],["تَلَوۡتُهُۥ","я читал бы его",10,16],["عَلَيۡكُمۡ","вам",10,16],["وَلَآ","и не",10,16],["أَدۡرَىٰكُم","дал бы Он знать вам",10,16],["بِهِۦۖ","о нём",10,16],["فَقَدۡ","ведь уже",10,16],["لَبِثۡتُ","я пробыл",10,16]],[["فِيكُمۡ","среди вас",10,16],["عُمُرٗا","целую жизнь",10,16],["مِّن","из",10,16],["قَبۡلِهِۦٓۚ","до него",10,16],["أَفَلَا","неужели не",10,16],["تَعۡقِلُونَ","вы разумеете",10,16],[16],["فَمَنۡ","И кто",10,17],["أَظۡلَمُ","несправедливее",10,17]],[["مِمَّنِ","того, кто",10,17],["ٱفۡتَرَىٰ","измыслил",10,17],["عَلَى","на",10,17],["ٱللَّهِ","Аллаха",10,17],["كَذِبًا","ложь",10,17],["أَوۡ","или",10,17],["كَذَّبَ","счёл ложью",10,17],["بِـَٔايَٰتِهِۦٓۚ","Его знамения",10,17],["إِنَّهُۥ","поистине",10,17]],[["لَا","не",10,17],["يُفۡلِحُ","преуспеют",10,17],["ٱلۡمُجۡرِمُونَ","грешники",10,17],[17],["وَيَعۡبُدُونَ","И они поклоняются",10,18],["مِن","из",10,18],["دُونِ","помимо",10,18],["ٱللَّهِ","Аллаха",10,18]],[["مَا","тому, что",10,18],["لَا","не",10,18],["يَضُرُّهُمۡ","вредит им",10,18],["وَلَا","и не",10,18],["يَنفَعُهُمۡ","приносит пользы им",10,18],["وَيَقُولُونَ","и они говорят",10,18],["هَٰٓؤُلَآءِ","эти",10,18],["شُفَعَٰٓؤُنَا","наши заступники",10,18]],[["عِندَ","перед",10,18],["ٱللَّهِۚ","Аллахом",10,18],["قُلۡ","скажи",10,18],["أَتُنَبِّـُٔونَ","разве вы сообщаете",10,18],["ٱللَّهَ","Аллаху",10,18],["بِمَا","о том, что",10,18],["لَا","не",10,18],["يَعۡلَمُ","Он знает",10,18],["فِي","на",10,18],["ٱلسَّمَٰوَٰتِ","небесах",10,18],["وَلَا","и не",10,18]],[["فِي","на",10,18],["ٱلۡأَرۡضِۚ","земле",10,18],["سُبۡحَٰنَهُۥ","Пречист Он",10,18],["وَتَعَٰلَىٰ","и превыше",10,18],["عَمَّا","того, что",10,18],["يُشۡرِكُونَ","они придают в сотоварищи",10,18],[18],["وَمَا","И не",10,19],["كَانَ","были",10,19]],[["ٱلنَّاسُ","люди",10,19],["إِلَّآ","кроме",10,19],["أُمَّةٗ","общиной",10,19],["وَٰحِدَةٗ","единой",10,19],["فَٱخۡتَلَفُواْۚ","и они разошлись",10,19],["وَلَوۡلَا","и если бы не",10,19],["كَلِمَةٞ","слово",10,19]],[["سَبَقَتۡ","предшествовавшее",10,19],["مِن","от",10,19],["رَّبِّكَ","твоего Господа",10,19],["لَقُضِيَ","непременно было бы решено",10,19],["بَيۡنَهُمۡ","между ними",10,19],["فِيمَا","в том, что",10,19],["فِيهِ","в нём",10,19],["يَخۡتَلِفُونَ","они расходятся",10,19]],[[19],["وَيَقُولُونَ","И они говорят",10,20],["لَوۡلَآ","почему не",10,20],["أُنزِلَ","ниспослано",10,20],["عَلَيۡهِ","ему",10,20],["ءَايَةٞ","знамение",10,20],["مِّن","от",10,20],["رَّبِّهِۦۖ","его Господа",10,20],["فَقُلۡ","скажи же",10,20],["إِنَّمَا","лишь",10,20]],[["ٱلۡغَيۡبُ","сокровенное",10,20],["لِلَّهِ","у Аллаха",10,20],["فَٱنتَظِرُوٓاْ","ждите же",10,20],["إِنِّي","поистине, я",10,20],["مَعَكُم","с вами",10,20],["مِّنَ","из",10,20],["ٱلۡمُنتَظِرِينَ","ожидающих",10,20],[20]]]}