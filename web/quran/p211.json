,23],["إِلَيۡنَا","к Нам",10,23],["مَرۡجِعُكُمۡ","ваше возвращение",10,23],["فَنُنَبِّئُكُم","и Мы сообщим вам",10,23],["بِمَا","о том, что",10,23],["كُنتُمۡ","вы были",10,23],["تَعۡمَلُونَ","делали",10,23],[23]],[["إِنَّمَا","Лишь",10,24],["مَثَلُ","пример",10,24],["ٱلۡحَيَوٰةِ","жизни",10,24],["ٱلدُّنۡيَا","мирской",10,24],["كَمَآءٍ","как вода",10,24],["أَنزَلۡنَٰهُ","Мы ниспослали её",10,24],["مِنَ","с",10,24],["ٱلسَّمَآءِ","неба",10,24],["فَٱخۡتَلَطَ","и смешались",10,24],["بِهِۦ","с ней",10,24]],[["نَبَاتُ","растения",10,24],["ٱلۡأَرۡضِ","земли",10,24],["مِمَّا","из того, что",10,24],["يَأۡكُلُ","едят",10,24],["ٱلنَّاسُ","люди",10,24],["وَٱلۡأَنۡعَٰمُ","и скот",10,24],["حَتَّىٰٓ","пока не",10,24],["إِذَآ","когда",10,24],["أَخَذَتِ","взяла",10,24],["ٱلۡأَرۡضُ","земля",10,24]],[["زُخۡرُفَهَا","своё убранство",10,24],["وَٱزَّيَّنَتۡ","и украсилась",10,24],["وَظَنَّ","и подумали",10,24],["أَهۡلُهَآ","её жители",10,24],["أَنَّهُمۡ","что они",10,24],["قَٰدِرُونَ","властны",10,24],["عَلَيۡهَآ","над ней",10,24]],[["أَتَىٰهَآ","пришло к ней",10,24],["أَمۡرُنَا","Наше повеление",10,24],["لَيۡلًا","ночью",10,24],["أَوۡ","или",10,24],["نَهَارٗا","днём",10,24],["فَجَعَلۡنَٰهَا","и Мы сделали её",10,24],["حَصِيدٗا","скошенной",10,24],["كَأَن","словно",10,24],["لَّمۡ","не",10,24],["تَغۡنَ","она изобиловала",10,24]],[["بِٱلۡأَمۡسِۚ","вчера",10,24],["كَذَٰلِكَ","так",10,24],["نُفَصِّلُ","Мы разъясняем",10,24],["ٱلۡأٓيَٰتِ","знамения",10,24],["لِقَوۡمٖ","для людей",10,24],["يَتَفَكَّرُونَ","размышляющих",10,24],[24],["وَٱللَّهُ","И Аллах",10,25]],[["يَدۡعُوٓاْ","призывает",10,25],["إِلَىٰ","к",10,25],["دَارِ","обители",10,25],["ٱلسَّلَٰمِ","мира",10,25],["وَيَهۡدِي","и ведёт",10,25],["مَن","кого",10,25],["يَشَآءُ","Он пожелает",10,25],["إِلَىٰ","к",10,25],["صِرَٰطٖ","пути",10,25],["مُّسۡتَقِيمٖ","прямому",10,25],[25]]]}