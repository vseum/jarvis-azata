{"p":211,"j":11,"a":[[10,21,["وَإِذَآ","أَذَقۡنَا","ٱلنَّاسَ","رَحۡمَةٗ","مِّنۢ","بَعۡدِ","ضَرَّآءَ","مَسَّتۡهُمۡ","إِذَا","لَهُم","مَّكۡرٞ","فِيٓ","ءَايَاتِنَاۚ","قُلِ","ٱللَّهُ","أَسۡرَعُ","مَكۡرًاۚ","إِنَّ","رُسُلَنَا","يَكۡتُبُونَ","مَا","تَمۡكُرُونَ"],"ва'иза азаḳнан наса рахматам мим ба`ди дарраа массатхум иза лахум макрун фии айатина ḳулиллаху асра`у макран инна русулана йактубууна ма тамкуруун","Когда Мы дали людям вкусить милость после того, как их постигло бедствие, они тотчас начали ухищряться против Наших знамений. Скажи: «Аллах быстрее в ухищрениях!». Воистину, Наши посланцы записывают ваши козни.",["И когда","Мы дали вкусить","людям","милость","из","после","бедствия","коснувшегося их","вот","у них","хитрость","против","Наших знамений","скажи","Аллах","быстрее","в хитрости","поистине","Наши посланцы","записывают","то, что","вы замышляете"]],[10,22,["هُوَ","ٱلَّذِي","يُسَيِّرُكُمۡ","فِي","ٱلۡبَرِّ","وَٱلۡبَحۡرِۖ","حَتَّىٰٓ","إِذَا","كُنتُمۡ","فِي","ٱلۡفُلۡكِ","وَجَرَيۡنَ","بِهِم","بِرِيحٖ","طَيِّبَةٖ","وَفَرِحُواْ","بِهَا","جَآءَتۡهَا","رِيحٌ","عَاصِفٞ","وَجَآءَهُمُ","ٱلۡمَوۡجُ","مِن","كُلِّ","مَكَانٖ","وَظَنُّوٓاْ","أَنَّهُمۡ","أُحِيطَ","بِهِمۡ","دَعَوُاْ","ٱللَّهَ","مُخۡلِصِينَ","لَهُ","ٱلدِّينَ","لَئِنۡ","أَنجَيۡتَنَا","مِنۡ","هَٰذِهِۦ","لَنَكُونَنَّ","مِنَ","ٱلشَّٰكِرِينَ"],"хуал лазии йусаййирукум фил барри валбахри хатта иза кунтум фил фулки важарайна бихим бириихин таййибатин вафарихуу биха жаатха риихун `асифун важаахумул маужу мин кулли маканин вазаннуу аннахум ухиита бихим да`авуллаха мухлисиина лахуд диина ла'ин анжайтана мин хазихии ланакуунанна минаш шакириин","Он - Тот, Кто предоставил вам возможность путешествовать по суше и по морю. Вы путешествуете на кораблях, плывущих вместе с ними при благоприятном ветре, которому они рады. Но вдруг подует ураганный ветер, и волны подступят к ним со всех сторон. Они решат, что они окружены, и станут взывать к Аллаху, очищая перед Ним веру: «Если Ты спасешь нас отсюда, то мы будем одними из благодарных!».",["Он","Тот, Кто","даёт вам передвигаться","по","суше","и морю","пока не","когда","вы","на","кораблях","и поплыли они","с ними","при ветре","благоприятном","и обрадовались они","ему","пришёл к нему","ветер","ураганный","и пришли к ним","волны","с","каждого","места","и решили они","что они","окружены","они","воззвали","к Аллаху","искренне посвящая","Ему","веру","если же","Ты спасёшь нас","от","этого","непременно будем мы","из","благодарных"]],[10,23,["فَلَمَّآ","أَنجَىٰهُمۡ","إِذَا","هُمۡ","يَبۡغُونَ","فِي","ٱلۡأَرۡضِ","بِغَيۡرِ","ٱلۡحَقِّۗ","يَٰٓأَيُّهَا","ٱلنَّاسُ","إِنَّمَا","بَغۡيُكُمۡ","عَلَىٰٓ","أَنفُسِكُمۖ","مَّتَٰعَ","ٱلۡحَيَوٰةِ","ٱلدُّنۡيَاۖ","ثُمَّ","إِلَيۡنَا","مَرۡجِعُكُمۡ","فَنُنَبِّئُكُم","بِمَا","كُنتُمۡ","تَعۡمَلُونَ"],"фаламма анжахум иза хум йабгууна фил арди бигайрил хаḳḳи йа'аййухан насу иннама багйукум `ала анфусикум мата`ал хайаватид дунйа сумма илайна маржи`укум фанунаббиукум бима кунтум та`малуун","Когда же Он спасает их, они бесчинствуют на земле без всякого права на то. О люди! Ваши бесчинства обернутся против вас самих. Это - преходящее наслаждение мирской жизнью. Потом Вы возвратитесь к Нам, и Мы поведаем вам о том, что вы совершали.",["Но когда","Он спас их","вот","они","бесчинствуют","на","земле","без","права","о","люди","лишь","ваше бесчинство","против","вас самих","пользование","жизнью","мирской","затем","к Нам","ваше возвращение","и Мы сообщим вам","о том, что","вы были","делали"]],[10,24,["إِنَّمَا","مَثَلُ","ٱلۡحَيَوٰةِ","ٱلدُّنۡيَا","كَمَآءٍ","أَنزَلۡنَٰهُ","مِنَ","ٱلسَّمَآءِ","فَٱخۡتَلَطَ","بِهِۦ","نَبَاتُ","ٱلۡأَرۡضِ","مِمَّا","يَأۡكُلُ","ٱلنَّاسُ","وَٱلۡأَنۡعَٰمُ","حَتَّىٰٓ","إِذَآ","أَخَذَتِ","ٱلۡأَرۡضُ","زُخۡرُفَهَا","وَٱزَّيَّنَتۡ","وَظَنَّ","أَهۡلُهَآ","أَنَّهُمۡ","قَٰدِرُونَ","عَلَيۡهَآ","أَتَىٰهَآ","أَمۡرُنَا","لَيۡلًا","أَوۡ","نَهَارٗا","فَجَعَلۡنَٰهَا","حَصِيدٗا","كَأَن","لَّمۡ","تَغۡنَ","بِٱلۡأَمۡسِۚ","كَذَٰلِكَ","نُفَصِّلُ","ٱلۡأٓيَٰتِ","لِقَوۡمٖ","يَتَفَكَّرُونَ"],"иннама масалул хайаватид дунйа камаин анзалнаху минас самаи фахталата бихии набатул арди мимма йа'кулун насу вал'ан`аму хатта иза ахазатил арду зухруфаха ваззаййанат вазанна ахлуха аннахум ḳадирууна `алайха атаха амруна лайлан ау нахаран фажа`алнаха хасиидан ка'ал лам тагна бил'амси казалика нуфассилул айати лиḳаумин йатафаккаруун","Мирская жизнь подобна воде, которую Мы ниспосылаем с неба и благодаря которой (или с которой) смешиваются земные растения, идущие в пищу людям и животным. Когда же земля покрывается убранством и приукрашается, а ее жители полагают, что они властны над ней, Наше повеление постигает ее ночью или днем. Мы превращаем ее в жнивье, словно еще вчера она не изобиловала. Так Мы разъясняем знамения для людей размышляющих.",["Лишь","пример","жизни","мирской","как вода","Мы ниспослали её","с","неба","и смешались","с ней","растения","земли","из того, что","едят","люди","и скот","пока не","когда","взяла","земля","своё убранство","и украсилась","и подумали","её жители","что они","властны","над ней","пришло к ней","Наше повеление","ночью","или","днём","и Мы сделали её","скошенной","словно","не","она изобиловала","вчера","так","Мы разъясняем","знамения","для людей","размышляющих"]],[10,25,["وَٱللَّهُ","يَدۡعُوٓاْ","إِلَىٰ","دَارِ","ٱلسَّلَٰمِ","وَيَهۡدِي","مَن","يَشَآءُ","إِلَىٰ","صِرَٰطٖ","مُّسۡتَقِيمٖ"],"валлаху йад`уу ила дарис салами вайахдии ман йашау ила сиратим мустаḳиим","Аллах призывает к Обители мира и благополучия и наставляет на прямой путь тех, кого пожелает.",["И Аллах","призывает","к","обители","мира","и ведёт","кого","Он пожелает","к","пути","прямому"]]],"m":[[["وَإِذَآ","И когда",10,21],["أَذَقۡنَا","Мы дали вкусить",10,21],["ٱلنَّاسَ","людям",10,21],["رَحۡمَةٗ","милость",10,21],["مِّنۢ","из",10,21],["بَعۡدِ","после",10,21],["ضَرَّآءَ","бедствия",10,21],["مَسَّتۡهُمۡ","коснувшегося их",10,21],["إِذَا","вот",10,21],["لَهُم","у них",10,21],["مَّكۡرٞ","хитрость",10,21],["فِيٓ","против",10,21]],[["ءَايَاتِنَاۚ","Наших знамений",10,21],["قُلِ","скажи",10,21],["ٱللَّهُ","Аллах