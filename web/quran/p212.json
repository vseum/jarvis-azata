{"p":212,"j":11,"a":[[10,26,["لِّلَّذِينَ","أَحۡسَنُواْ","ٱلۡحُسۡنَىٰ","وَزِيَادَةٞۖ","وَلَا","يَرۡهَقُ","وُجُوهَهُمۡ","قَتَرٞ","وَلَا","ذِلَّةٌۚ","أُوْلَٰٓئِكَ","أَصۡحَٰبُ","ٱلۡجَنَّةِۖ","هُمۡ","فِيهَا","خَٰلِدُونَ"],"ллиллазиина ахсанул хусна вазийадатун вала йархаḳу вужуухахум ḳатарун вала зиллатун улаика асхабул жаннати хум фииха халидуун","Тем, которые творили добро, уготовано Наилучшее (Рай), и им будет добавлено еще (они получат возможность взглянуть на Лик Аллаха). Не будет на их лицах ни праха, ни унижения. Они - обитатели Рая, в котором они пребудут вечно.",["Для тех, которые","творили добро","наилучшее","и добавка","и не","покроет","их лица","мрак","и не","унижение","те","обитатели","Рая","они","в нём","вечно пребывающие"]],[10,27,["وَٱلَّذِينَ","كَسَبُواْ","ٱلسَّيِّـَٔاتِ","جَزَآءُ","سَيِّئَةِۭ","بِمِثۡلِهَا","وَتَرۡهَقُهُمۡ","ذِلَّةٞۖ","مَّا","لَهُم","مِّنَ","ٱللَّهِ","مِنۡ","عَاصِمٖۖ","كَأَنَّمَآ","أُغۡشِيَتۡ","وُجُوهُهُمۡ","قِطَعٗا","مِّنَ","ٱلَّيۡلِ","مُظۡلِمًاۚ","أُوْلَٰٓئِكَ","أَصۡحَٰبُ","ٱلنَّارِۖ","هُمۡ","فِيهَا","خَٰلِدُونَ"],"валлазиина касабус саййиати жазау саййиати бимислиха ватархаḳухум зиллатум ма лахум миналлахи мин `асимин ка'аннама угшийат вужуухухум ḳита`ам минал лайли музлиман улаика асхабун нари хум фииха халидуун","А воздаянием тех, кто приобрел зло, будет равноценное зло. Их постигнет унижение, и никто не защитит их от Аллаха. Их лица словно покроются клочьями ночного мрака. Они - обитатели Огня, в котором они пребудут вечно.",["А те, которые","приобрели","злые деяния","воздаяние","за зло","подобным ему","и покроет их","унижение","не","у них","от","Аллаха","никакого","защитника","словно","покрыты","их лица","клочьями","из","ночи","тёмной","те","обитатели","Огня","они","в нём","вечно пребывающие"]],[10,28,["وَيَوۡمَ","نَحۡشُرُهُمۡ","جَمِيعٗا","ثُمَّ","نَقُولُ","لِلَّذِينَ","أَشۡرَكُواْ","مَكَانَكُمۡ","أَنتُمۡ","وَشُرَكَآؤُكُمۡۚ","فَزَيَّلۡنَا","بَيۡنَهُمۡۖ","وَقَالَ","شُرَكَآؤُهُم","مَّا","كُنتُمۡ","إِيَّانَا","تَعۡبُدُونَ"],"вайаума нахшурухум жамии`ан сумма наḳуулу лиллазиина ашракуу маканакум антум вашуракаукум фазаййална байнахум ваḳала шуракаухум ма кунтум иййана та`будуун","В тот день Мы соберем их вместе, а потом скажем многобожникам: «Оставайтесь на своих местах вместе со своими сотоварищами». Потом Мы разделим их, и сотоварищи скажут им: «Вы вовсе не поклонялись нам.",["И в день","Мы соберём их","всех","затем","Мы скажем","тем, которые","придавали сотоварищей","на своих местах","вы","и ваши сотоварищи","и Мы разделили","между ними","и сказали","их сотоварищи","не","вы были","нам","поклонялись"]],[10,29,["فَكَفَىٰ","بِٱللَّهِ","شَهِيدَۢا","بَيۡنَنَا","وَبَيۡنَكُمۡ","إِن","كُنَّا","عَنۡ","عِبَادَتِكُمۡ","لَغَٰفِلِينَ"],"факафа биллахи шахиида байнана вабайнакум ин кунна `ан `ибадатикум лагафилиин","Довольно того, что Аллах является Свидетелем между нами и вами. Мы не ведали о вашем поклонении».",["И довольно","Аллаха","свидетелем","между нами","и между вами","поистине","мы были","о","вашем поклонении","непременно неведающими"]],[10,30,["هُنَالِكَ","تَبۡلُواْ","كُلُّ","نَفۡسٖ","مَّآ","أَسۡلَفَتۡۚ","وَرُدُّوٓاْ","إِلَى","ٱللَّهِ","مَوۡلَىٰهُمُ","ٱلۡحَقِّۖ","وَضَلَّ","عَنۡهُم","مَّا","كَانُواْ","يَفۡتَرُونَ"],"хуналика таблуу куллу нафсим ма аслафат варуддуу илаллахи маулахумул хаḳḳи вадалла `анхум ма кануу йафтаруун","Там каждый человек испытает то, что он совершил прежде. Они будут возвращены к Аллаху, их Истинному Покровителю, и покинет их (или исчезнет) то, что они измышляли.",["Там","испытает","каждая","душа","то, что","она совершила прежде","и возвращены","к","Аллаху","их Покровителю","истинному","и исчезло","от них","то, что","они были","измышляли"]],[10,31,["قُلۡ","مَن","يَرۡزُقُكُم","مِّنَ","ٱلسَّمَآءِ","وَٱلۡأَرۡضِ","أَمَّن","يَمۡلِكُ","ٱلسَّمۡعَ","وَٱلۡأَبۡصَٰرَ","وَمَن","يُخۡرِجُ","ٱلۡحَيَّ","مِنَ","ٱلۡمَيِّتِ","وَيُخۡرِجُ","ٱلۡمَيِّتَ","مِنَ","ٱلۡحَيِّ","وَمَن","يُدَبِّرُ","ٱلۡأَمۡرَۚ","فَسَيَقُولُونَ","ٱللَّهُۚ","فَقُلۡ","أَفَلَا","تَتَّقُونَ"],"ḳул ман йарзуḳукум минас самаи вал'арди амман йамликус сам`а вал'абсара ваман йухрижул хаййа минал маййити вайухрижул маййита минал хаййи ваман йудаббирул амра фасайаḳуулууналлаху фаḳул афала таттаḳуун","Скажи: «Кто одаряет вас уделом с неба и земли? Кто властен над слухом и зрением? Кто мертвое превращает в живое, а живое превращает в мертвое? Кто управляет делами?». Они скажут: «Аллах». Скажи: «Неужели вы не устрашитесь?».",["Скажи","кто","наделяет вас уделом","с","неба","и земли","или кто","владеет","слухом","и зрением","и кто","выводит","живое","из","мёртвого","и выводит","мёртвое","из","живого","и кто","управляет","делом","и скажут они","Аллах","скажи же","неужели не","вы побоитесь"]],[10,32,["فَذَٰلِكُمُ","ٱللَّهُ","رَبُّكُمُ","ٱلۡحَقُّۖ","فَمَاذَا","بَعۡدَ","ٱلۡحَقِّ","إِلَّا","ٱلضَّلَٰلُۖ","فَأَنَّىٰ","تُصۡرَفُونَ"],"фазаликумуллаху раббукумул хаḳḳу фамаза ба`дал хаḳḳи иллад далалу фа'анна тусрафуун","Таков Аллах, ваш Истинный Господь! Что может быть за истиной, кроме заблуждения? До чего же вы отвращены от истины!",["Таков же","Аллах","ваш Господь","истинный","и что же","после","истины","кроме","заблуждения","так как же","вы отвращаетесь"]],[10,33,["كَذَٰلِكَ","حَقَّتۡ","كَلِمَتُ","رَبِّكَ","عَلَى","ٱلَّذِينَ","فَسَقُوٓاْ","أَنَّهُمۡ","لَا","يُؤۡمِنُونَ"],"казалика хаḳḳат калимату раббика `алал лазиина фасаḳуу аннахум ла йу'минуун","Так подтвердилось Слово твоего Господа о том, что нечестивцы не уверуют.",["Так","подтвердилось","слово","твоего Господа","о","тех, которые","нечествовали","что они","не","уверуют"]]],"m":[[["۞ لِّلَّذِينَ","Для тех, которые",10,26],["أَحۡسَنُواْ","творили добро",10,26],["ٱلۡحُسۡنَىٰ","наилучшее",10,26],["وَزِيَادَةٞۖ","и добавка",10,26],["وَلَا","и не",10,26],["يَرۡهَقُ","покроет",10,26],["وُجُوهَهُمۡ","их лица",10,26],["قَتَرٞ","мрак",10,26]],[["وَلَا","и не",10,26],["ذِلَّةٌۚ","унижение",10,26],["أُوْلَٰٓئِكَ","те",10,26],["أَصۡحَٰبُ","обитатели",10,26],["ٱلۡجَنَّةِۖ","Рая",10,26],["هُمۡ","они",10,26],["فِيهَا","в нём",10,26],["خَٰلِدُونَ","вечно пребывающие",10,26],[26],["وَٱلَّذِينَ","А те, которые",10,27]],[["كَسَبُواْ","приобрели",10,27],["ٱلسَّيِّـَٔاتِ","злые деяния",10,27],["جَزَآءُ","воздаяние",10,27],["سَيِّئَةِۭ","за зло",10,27],["بِمِثۡلِهَا","подобным ему",10,27],["وَتَرۡهَقُهُمۡ","и покроет их",10,27],["ذِلَّةٞۖ","унижение",10,27],["مَّا","не",10,27],["لَهُم","у них",10,27],["مِّنَ","от",10,27]],[["ٱللَّهِ","Аллаха",10,27],["مِنۡ","никакого",10,27],["عَاصِمٖۖ","защитника",10,27],["كَأَنَّمَآ","словно",10,27],["أُغۡشِيَتۡ","покрыты",10,27],["وُجُوهُهُمۡ","их лица",10,27],["قِطَعٗا","клочьями",10,27],["مِّنَ","из",10,27],["ٱلَّيۡلِ","ночи",10,27],["مُظۡلِمًاۚ","тёмной",10,27]],[["أُوْلَٰٓئِكَ","те",10,27],["أَصۡحَٰبُ","обитатели",10,27],["ٱلنَّارِۖ","Огня",10,27],["هُمۡ","они",10,27],["فِيهَا","в нём",10,27],["خَٰلِدُونَ","вечно пребывающие",10,27],[27],["وَيَوۡمَ","И в день",10,28],["نَحۡشُرُهُمۡ","Мы соберём их",10,28]],[["جَمِيعٗا","всех",10,28],["ثُمَّ","затем",10,28],["نَقُولُ","Мы скажем",10,28],["لِلَّذِينَ","тем, которые",10,28],["أَشۡرَكُواْ","придавали сотоварищей",10,28],["مَكَانَكُمۡ","на своих местах",10,28],["أَنتُمۡ","вы",10,28],["وَشُرَكَآؤُكُمۡۚ","и ваши сотоварищи",10,28],["فَزَيَّلۡنَا","и Мы разделили",10,28]],[["بَيۡنَهُمۡۖ","между ними",10,28],["وَقَالَ","и сказали",10,28],["شُرَكَآؤُهُم","их сотоварищи",10,28],["مَّا","не",10,28],["كُنتُمۡ","вы были",10,28],["إِيَّانَا","нам",10,28],["تَعۡبُدُونَ","поклонялись",10,28],[28],["فَكَفَىٰ","И довольно",10,29],["بِٱللَّهِ","Аллаха",10,29]],[["شَهِيدَۢا","свидетелем",10,29],["بَيۡنَنَا","между нами",10,29],["وَبَيۡنَكُمۡ","и между вами",10,29],["إِن","поистине",10,29],["كُنَّا","мы были",10,29],["عَنۡ","о",10,29],["عِبَادَتِكُمۡ","вашем поклонении",10,29],["لَغَٰفِلِينَ","непременно неведающими",10,29],[29]],[["هُنَالِكَ","Там",10,30],["تَبۡلُواْ","испытает",10,30],["كُلُّ","каждая",10,30],["نَفۡسٖ","душа",10,30],["مَّآ","то, что",10,30],["أَسۡلَفَتۡۚ","она совершила прежде",10,30],["وَرُدُّوٓاْ","и возвращены",10,30],["إِلَى","к",10,30],["ٱللَّهِ","Аллаху",10,30],["مَوۡلَىٰهُمُ","их Покровителю",10,30]],[["ٱلۡحَقِّۖ","истинному",10,30],["وَضَلَّ","и исчезло",10,30],["عَنۡهُم","от них",10,30],["مَّا","то, что",10,30],["كَانُواْ","они были",10,30],["يَفۡتَرُونَ","измышляли",10,30],[30],["قُلۡ","Скажи",10,31],["مَن","кто",10,31],["يَرۡزُقُكُم","наделяет вас уделом",10,31]],[["مِّنَ","с",10,31],["ٱلسَّمَآءِ","неба",10,31],["وَٱلۡأَرۡضِ","и земли",10,31],["أَمَّن","или кто",10,31],["يَمۡلِكُ","владеет",10,31],["ٱلسَّمۡعَ","слухом",10,31],["وَٱلۡأَبۡصَٰرَ","и зрением",10,31],["وَمَن","и кто",10,31],["يُخۡرِجُ","выводит",10,31]],[["ٱلۡحَيَّ","живое",10,31],["مِنَ","из",10,31],["ٱلۡمَيِّتِ","мёртвого",10,31],["وَيُخۡرِجُ","и выводит",10,31],["ٱلۡمَيِّتَ","мёртвое",10,31],["مِنَ","из",10,31],["ٱلۡحَيِّ","живого",10,31],["وَمَن","и кто",10,31],["يُدَبِّرُ","управляет",10,31],["ٱلۡأَمۡرَۚ","делом",10,31]],[["فَسَيَقُولُونَ","и скажут они",10,31],["ٱللَّهُۚ","Аллах",10,31],["فَقُلۡ","скажи же",10,31],["أَفَلَا","неужели не",10,31],["تَتَّقُونَ","вы побоитесь",10,31],[31],["فَذَٰلِكُمُ","Таков же",10,32],["ٱللَّهُ","Аллах",10,32],["رَبُّكُمُ","ваш Господь",10,32],["ٱلۡحَقُّۖ","истинный",10,32]],[["فَمَاذَا","и что же",10,32],["بَعۡدَ","после",10,32],["ٱلۡحَقِّ","истины",10,32],["إِلَّا","кроме",10,32],["ٱلضَّلَٰلُۖ","заблуждения",10,32],["فَأَنَّىٰ","так как же",10,32],["تُصۡرَفُونَ","вы отвращаетесь",10,32],[32],["كَذَٰلِكَ","Так",10,33]],[["حَقَّتۡ","подтвердилось",10,33],["كَلِمَتُ","слово",10,33],["رَبِّكَ","твоего Господа",10,33],["عَلَى","о",10,33],["ٱلَّذِينَ","тех, которые",10,33],["فَسَقُوٓاْ","нечествовали",10,33],["أَنَّهُمۡ","что они",10,33],["لَا","не",10,33],["يُؤۡمِنُونَ","уверуют",10,33],[33]]]}