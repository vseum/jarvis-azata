{"p":213,"j":11,"a":[[10,34,["قُلۡ","هَلۡ","مِن","شُرَكَآئِكُم","مَّن","يَبۡدَؤُاْ","ٱلۡخَلۡقَ","ثُمَّ","يُعِيدُهُۥۚ","قُلِ","ٱللَّهُ","يَبۡدَؤُاْ","ٱلۡخَلۡقَ","ثُمَّ","يُعِيدُهُۥۖ","فَأَنَّىٰ","تُؤۡفَكُونَ"],"ḳул хал мин шуракаикум ман йабдаул халḳа сумма йу`иидухуу ḳулиллаху йабдаул халḳа сумма йу`иидухуу фа'анна ту'факуун","Скажи: «Есть ли среди тех, кого вы придаете в сотоварищи к Аллаху, такой, который создает творение, а затем воссоздает его?». Скажи: «Аллах создает творение, а затем воссоздает его. До чего же вы отвращены от истины!».",["Скажи","есть ли","из","ваших сотоварищей","кто","начинает","творение","затем","повторяет его","скажи","Аллах","начинает","творение","затем","повторяет его","так как же","вы отвращаетесь"]],[10,35,["قُلۡ","هَلۡ","مِن","شُرَكَآئِكُم","مَّن","يَهۡدِيٓ","إِلَى","ٱلۡحَقِّۚ","قُلِ","ٱللَّهُ","يَهۡدِي","لِلۡحَقِّۗ","أَفَمَن","يَهۡدِيٓ","إِلَى","ٱلۡحَقِّ","أَحَقُّ","أَن","يُتَّبَعَ","أَمَّن","لَّا","يَهِدِّيٓ","إِلَّآ","أَن","يُهۡدَىٰۖ","فَمَا","لَكُمۡ","كَيۡفَ","تَحۡكُمُونَ"],"ḳул хал мин шуракаикум ман йахдии илал хаḳḳи ḳулиллаху йахдии лилхаḳḳи афаман йахдии илал хаḳḳи ахаḳḳу ан йуттаба`а аммал ла йахиддии илла ан йухда фама лакум кайфа тахкумуун","Спроси: «Есть ли среди тех, кого вы придаете в сотоварищи к Аллаху, такой, который указывает путь к истине?». Скажи: «Аллах указывает путь к истине. Кто более достоин того, чтобы за ним следовали: тот, кто сам указывает путь к истине, или же тот, кто не может найти верного пути, пока ему не укажут на него? Что с вами? Как вы судите?».",["Скажи","есть ли","из","ваших сотоварищей","кто","ведёт","к","истине","скажи","Аллах","ведёт","к истине","разве тот, кто","ведёт","к","истине","достойнее","чтобы","за ним следовали","или тот, кто","не","находит пути","кроме","как","его поведут","что же","с вами","как","вы судите"]],[10,36,["وَمَا","يَتَّبِعُ","أَكۡثَرُهُمۡ","إِلَّا","ظَنًّاۚ","إِنَّ","ٱلظَّنَّ","لَا","يُغۡنِي","مِنَ","ٱلۡحَقِّ","شَيۡـًٔاۚ","إِنَّ","ٱللَّهَ","عَلِيمُۢ","بِمَا","يَفۡعَلُونَ"],"вама йаттаби`у аксарухум илла заннан инназ занна ла йугнии минал хаḳḳи шай'ан инналлаха `алииму бима йаф`алуун","Большинство их следует своим предположениям, но ведь предположения никак не могут заменить истину. Воистину, Аллаху известно о том, что они совершают.",["И не","следует","большинство их","кроме","предположения","поистине","предположение","не","избавляет","от","истины","ничуть","поистине","Аллах","знающий","о том, что","они делают"]],[10,37,["وَمَا","كَانَ","هَٰذَا","ٱلۡقُرۡءَانُ","أَن","يُفۡتَرَىٰ","مِن","دُونِ","ٱللَّهِ","وَلَٰكِن","تَصۡدِيقَ","ٱلَّذِي","بَيۡنَ","يَدَيۡهِ","وَتَفۡصِيلَ","ٱلۡكِتَٰبِ","لَا","رَيۡبَ","فِيهِ","مِن","رَّبِّ","ٱلۡعَٰلَمِينَ"],"вама кана хазал ḳур'ану ан йуфтара мин дууниллахи валакин тасдииḳал лазии байна йадайхи ватафсиилал китаби ла райба фиихи мир раббил `аламиин","Этот Коран не может быть сочинением кого-либо, кроме Аллаха. Он является подтверждением того, что было до него, и разъяснением Писания от Господа миров, в котором нет сомнения.",["И не","был","этот","Коран","чтобы","быть измышленным","из","помимо","Аллаха","но","подтверждение","того, что","между","его руками (до него)","и разъяснение","Писания","нет","сомнения","в нём","от","Господа","миров"]],[10,38,["أَمۡ","يَقُولُونَ","ٱفۡتَرَىٰهُۖ","قُلۡ","فَأۡتُواْ","بِسُورَةٖ","مِّثۡلِهِۦ","وَٱدۡعُواْ","مَنِ","ٱسۡتَطَعۡتُم","مِّن","دُونِ","ٱللَّهِ","إِن","كُنتُمۡ","صَٰدِقِينَ"],"ам йаḳуулуунафтараху ḳул фа'туу бисууратим мислихии вад`уу манистата`тум ммин дууниллахи ин кунтум садиḳиин","Или же они говорят: «Он выдумал его». Скажи: «Сочините хотя бы одну суру, подобную этим, и призовите, кого сможете, кроме Аллаха, если вы говорите правду».",["Или","они говорят","он измыслил его","скажи","приведите же","суру","подобную ему","и призовите","кого","вы сможете","из","помимо","Аллаха","если","вы","правдивы"]],[10,39,["بَلۡ","كَذَّبُواْ","بِمَا","لَمۡ","يُحِيطُواْ","بِعِلۡمِهِۦ","وَلَمَّا","يَأۡتِهِمۡ","تَأۡوِيلُهُۥۚ","كَذَٰلِكَ","كَذَّبَ","ٱلَّذِينَ","مِن","قَبۡلِهِمۡۖ","فَٱنظُرۡ","كَيۡفَ","كَانَ","عَٰقِبَةُ","ٱلظَّٰلِمِينَ"],"бал каззабуу бима лам йухиитуу би`илмихии валамма йа'тихим та'виилухуу казалика каззабал лазиина мин ḳаблихим фанзур кайфа кана `аḳибатуз залимиин","Так нет же, они объявляют ложью знание, которое не способны постичь и толкование которого еще не свершилось. Таким же образом его отвергали их предшественники. Погляди же, каким был конец беззаконников!",["Нет же","они сочли ложью","то, что","не","они объяли","его знанием","и ещё не","пришло к ним","его толкование","так","сочли ложью","те, которые","из","до них","посмотри же","каким","был","конец","несправедливых"]],[10,40,["وَمِنۡهُم","مَّن","يُؤۡمِنُ","بِهِۦ","وَمِنۡهُم","مَّن","لَّا","يُؤۡمِنُ","بِهِۦۚ","وَرَبُّكَ","أَعۡلَمُ","بِٱلۡمُفۡسِدِينَ"],"ваминхум ман йу'мину бихии ваминхум мал ла йу'мину бихии вараббука а`ламу билмуфсидиин","Среди них есть такие, которые уверуют в него, и такие, которые не уверуют в него. Твой Господь лучше осведомлен о распространяющих нечестие.",["И из них","кто","верует","в него","и из них","кто","не","верует","в него","и твой Господь","лучше знает","о нечестивцах"]],[10,41,["وَإِن","كَذَّبُوكَ","فَقُل","لِّي","عَمَلِي","وَلَكُمۡ","عَمَلُكُمۡۖ","أَنتُم","بَرِيٓـُٔونَ","مِمَّآ","أَعۡمَلُ","وَأَنَا۠","بَرِيٓءٞ","مِّمَّا","تَعۡمَلُونَ"],"ва'ин каззабуука фаḳул лии `амалии валакум `амалукум антум барииууна мимма а`малу ва'ана барииум мимма та`малуун","Если тебя сочтут лжецом, то скажи: «Мне достанутся мои деяния, а вам - ваши деяния. Вы не причастны к тому, что я совершаю, а я не причастен к тому, что совершаете вы».",["И если","они сочли тебя лжецом","то скажи","мне","моё деяние","и вам","ваше деяние","вы","непричастны","к тому, что","я делаю","и я","непричастен","к тому, что","вы делаете"]],[10,42,["وَمِنۡهُم","مَّن","يَسۡتَمِعُونَ","إِلَيۡكَۚ","أَفَأَنتَ","تُسۡمِعُ","ٱلصُّمَّ","وَلَوۡ","كَانُواْ","لَا","يَعۡقِلُونَ"],"ваминхум ман йастами`ууна илайка афаанта тусми`ус сумма валау кануу ла йа`ḳилуун","Среди них есть и такие, которые выслушивают тебя. Разве ты можешь заставить слышать глухих, если они к тому же не разумеют?",["И из них","кто","прислушиваются","к тебе","разве ты","заставишь слышать","глухих","и даже если","они были","не","разумеют"]]],"m":[[["قُلۡ","Скажи",10,34],["هَلۡ","есть ли",10,34],["مِن","из",10,34],["شُرَكَآئِكُم","ваших сотоварищей",10,34],["مَّن","кто",10,34],["يَبۡدَؤُاْ","начинает",10,34],["ٱلۡخَلۡقَ","творение",10,34],["ثُمَّ","затем",10,34],["يُعِيدُهُۥۚ","повторяет его",10,34],["قُلِ","скажи",10,34],["ٱللَّهُ","Аллах",10,34],["يَبۡدَؤُاْ","начинает",10,34]],[["ٱلۡخَلۡقَ","творение",10,34],["ثُمَّ","затем",10,34],["يُعِيدُهُۥۖ","повторяет его",10,34],["فَأَنَّىٰ","так как же",10,34],["تُؤۡفَكُونَ","вы отвращаетесь",10,34],[34],["قُلۡ","Скажи",10,35],["هَلۡ","есть ли",10,35],["مِن","из",10,35],["شُرَكَآئِكُم","ваших сотоварищей",10,35],["مَّن","кто",10,35],["يَهۡدِيٓ","ведёт",10,35]],[["إِلَى","к",10,35],["ٱلۡحَقِّۚ","истине",10,35],["قُلِ","скажи",10,35],["ٱللَّهُ","Аллах",10,35],["يَهۡدِي","ведёт",10,35],["لِلۡحَقِّۗ","к истине",10,35],["أَفَمَن","разве тот, кто",10,35],["يَهۡدِيٓ","ведёт",10,35],["إِلَى","к",10,35],["ٱلۡحَقِّ","истине",10,35],["أَحَقُّ","достойнее",10,35],["أَن","чтобы",10,35]],[["يُتَّبَعَ","за ним следовали",10,35],["أَمَّن","или тот, кто",10,35],["لَّا","не",10,35],["يَهِدِّيٓ","находит пути",10,35],["إِلَّآ","кроме",10,35],["أَن","как",10,35],["يُهۡدَىٰۖ","его поведут",10,35],["فَمَا","что же",10,35],["لَكُمۡ","с вами",10,35],["كَيۡفَ","как",10,35],["تَحۡكُمُونَ","вы судите",10,35],[35]],[["وَمَا","И не",10,36],["يَتَّبِعُ","следует",10,36],["أَكۡثَرُهُمۡ","большинство их",10,36],["إِلَّا","кроме",10,36],["ظَنًّاۚ","предположения",10,36],["إِنَّ","поистине",10,36],["ٱلظَّنَّ","предположение",10,36],["لَا","не",10,36],["يُغۡنِي","избавляет",10,36],["مِنَ","от",10,36],["ٱلۡحَقِّ","истины",10,36],["شَيۡـًٔاۚ","ничуть",10,36],["إِنَّ","поистине",10,36],["ٱللَّهَ","Аллах",10,36]],[["عَلِيمُۢ","знающий",10,36],["بِمَا","о том, что",10,36],["يَفۡعَ