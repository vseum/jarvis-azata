{"p":214,"j":11,"a":[[10,43,["وَمِنۡهُم","مَّن","يَنظُرُ","إِلَيۡكَۚ","أَفَأَنتَ","تَهۡدِي","ٱلۡعُمۡيَ","وَلَوۡ","كَانُواْ","لَا","يُبۡصِرُونَ"],"ваминхум ман йанзуру илайка афаанта тахдил `умйа валау кануу ла йубсируун","Среди них есть и такие, которые смотрят на тебя. Разве ты можешь наставить на прямой путь слепых, если они к тому же не видят?",["И из них","кто","смотрит","на тебя","разве ты","поведёшь","слепых","и даже если","они были","не","видят"]],[10,44,["إِنَّ","ٱللَّهَ","لَا","يَظۡلِمُ","ٱلنَّاسَ","شَيۡـٔٗا","وَلَٰكِنَّ","ٱلنَّاسَ","أَنفُسَهُمۡ","يَظۡلِمُونَ"],"инналлаха ла йазлимун наса шай'ан валакиннан наса анфусахум йазлимуун","Воистину, Аллах ни в чем не проявляет несправедливости к людям, но люди сами поступают несправедливо по отношению к себе.",["Поистине","Аллах","не","обижает","людей","ни в чём","но","люди","самих себя","обижают"]],[10,45,["وَيَوۡمَ","يَحۡشُرُهُمۡ","كَأَن","لَّمۡ","يَلۡبَثُوٓاْ","إِلَّا","سَاعَةٗ","مِّنَ","ٱلنَّهَارِ","يَتَعَارَفُونَ","بَيۡنَهُمۡۚ","قَدۡ","خَسِرَ","ٱلَّذِينَ","كَذَّبُواْ","بِلِقَآءِ","ٱللَّهِ","وَمَا","كَانُواْ","مُهۡتَدِينَ"],"вайаума йахшурухум ка'ал лам йалбасуу илла са`атам минан нахари йата`арафууна байнахум ḳад хасирал лазиина каззабуу билиḳаиллахи вама кануу мухтадиин","В тот день Аллах соберет их, словно они пробыли на земле или в могилах всего лишь один дневной час, и они узнают друг друга. Воистину, убыток потерпят те, которые считали ложью встречу с Аллахом и не следовали прямым путем.",["И в день","Он соберёт их","словно","не","они пробыли","кроме","часа","из","дня","они узнают друг друга","между собой","уже","потерпели убыток","те, которые","сочли ложью","встречу","с Аллахом","и не","были они","идущими прямо"]],[10,46,["وَإِمَّا","نُرِيَنَّكَ","بَعۡضَ","ٱلَّذِي","نَعِدُهُمۡ","أَوۡ","نَتَوَفَّيَنَّكَ","فَإِلَيۡنَا","مَرۡجِعُهُمۡ","ثُمَّ","ٱللَّهُ","شَهِيدٌ","عَلَىٰ","مَا","يَفۡعَلُونَ"],"ва'имма нурийаннака ба`дал лазии на`идухум ау натаваффайаннака фа'илайна маржи`ухум суммаллаху шахиидун `ала ма йаф`алуун","Мы покажем тебе часть того, что Мы обещали им, или же умертвим тебя, но они все равно вернутся к Нам. Кроме того, Аллах является Свидетелем того, что они совершают.",["И либо","Мы непременно покажем тебе","часть","того, что","Мы обещаем им","или","Мы непременно упокоим тебя","то к Нам","их возвращение","затем","Аллах","свидетель","над","тем, что","они делают"]],[10,47,["وَلِكُلِّ","أُمَّةٖ","رَّسُولٞۖ","فَإِذَا","جَآءَ","رَسُولُهُمۡ","قُضِيَ","بَيۡنَهُم","بِٱلۡقِسۡطِ","وَهُمۡ","لَا","يُظۡلَمُونَ"],"валикулли умматир расуулун фа'иза жаа расуулухум ḳудийа байнахум билḳисти вахум ла йузламуун","У каждой общины есть посланник. Когда же приходил посланник, между ними все решалось по справедливости, и с ними не поступали несправедливо.",["И у каждой","общины","посланник","и когда","пришёл","их посланник","решено","между ними","по справедливости","и они","не","обижены"]],[10,48,["وَيَقُولُونَ","مَتَىٰ","هَٰذَا","ٱلۡوَعۡدُ","إِن","كُنتُمۡ","صَٰدِقِينَ"],"вайаḳуулууна мата хазал ва`ду ин кунтум садиḳиин","Они говорят: «Когда же исполнится это обещание, если вы говорите правду?».",["И они говорят","когда","это","обещание","если","вы","правдивы"]],[10,49,["قُل","لَّآ","أَمۡلِكُ","لِنَفۡسِي","ضَرّٗا","وَلَا","نَفۡعًا","إِلَّا","مَا","شَآءَ","ٱللَّهُۗ","لِكُلِّ","أُمَّةٍ","أَجَلٌۚ","إِذَا","جَآءَ","أَجَلُهُمۡ","فَلَا","يَسۡتَـٔۡخِرُونَ","سَاعَةٗ","وَلَا","يَسۡتَقۡدِمُونَ"],"ḳул ла амлику линафсии дарран вала наф`ан илла ма шааллаху ликулли умматин ажалун иза жаа ажалухум фала йаста'хирууна са`атан вала йастаḳдимуун","Скажи: «Я не способен причинить себе зло или принести себе пользу, если того не пожелает Аллах. Для каждой общины установлен срок. Когда же наступает их срок, они не могут отдалить или приблизить его даже на час».",["Скажи","не","я властен","для себя","над вредом","и не","над пользой","кроме","того, что","пожелал","Аллах","у каждой","общины","срок","когда","пришёл","их срок","то не","отсрочат они","на час","и не","ускорят"]],[10,50,["قُلۡ","أَرَءَيۡتُمۡ","إِنۡ","أَتَىٰكُمۡ","عَذَابُهُۥ","بَيَٰتًا","أَوۡ","نَهَارٗا","مَّاذَا","يَسۡتَعۡجِلُ","مِنۡهُ","ٱلۡمُجۡرِمُونَ"],"ḳул араайтум ин атакум `азабухуу байатан ау нахарам маза йаста`жилу минхул мужримуун","Скажи: «Как вы думаете, какую часть мучений от Аллаха будут торопить грешники, если они постигнут вас ночью или днем».",["Скажи","видели ли вы","если","придёт к вам","Его наказание","ночью","или","днём","что","торопят","из него","грешники"]],[10,51,["أَثُمَّ","إِذَا","مَا","وَقَعَ","ءَامَنتُم","بِهِۦٓۚ","ءَآلۡـَٰٔنَ","وَقَدۡ","كُنتُم","بِهِۦ","تَسۡتَعۡجِلُونَ"],"асумма иза ма ваḳа`а амантум бихии ал'ана ваḳад кунтум бихии таста`жилуун","Неужели вы уверуете в них только тогда, когда они постигнут вас? Неужели теперь, после того, как вы торопили их?",["Неужели затем","когда","же","произошло","вы уверовали","в него","неужели теперь","а ведь уже","вы были","его","торопите"]],[10,52,["ثُمَّ","قِيلَ","لِلَّذِينَ","ظَلَمُواْ","ذُوقُواْ","عَذَابَ","ٱلۡخُلۡدِ","هَلۡ","تُجۡزَوۡنَ","إِلَّا","بِمَا","كُنتُمۡ","تَكۡسِبُونَ"],"сумма ḳиила лиллазиина заламуу зууḳуу `азабал хулди хал тужзауна илла бима кунтум таксибуун","Потом будет сказано тем, кто поступал несправедливо: «Вкусите вечные мучения! Разве вам не воздается только за то, что вы совершали?».",["Затем","сказано","тем, которые","поступали несправедливо","вкусите","наказание","вечности","разве","вам воздаётся","кроме как","за то, что","вы были","приобретали"]],[10,53,["وَيَسۡتَنۢبِـُٔونَكَ","أَحَقٌّ","هُوَۖ","قُلۡ","إِي","وَرَبِّيٓ","إِنَّهُۥ","لَحَقّٞۖ","وَمَآ","أَنتُم","بِمُعۡجِزِينَ"],"вайастамбиуунака ахаḳḳун хуа ḳул ии вараббии иннахуу лахаḳḳун вама антум биму`жизиин","Они спрашивают тебя: «Неужели это правда?». Скажи: «Конечно, клянусь моим Господом! Воистину, это - подлинная правда, и вам не избежать этого».",["И они просят тебя сообщить","разве правда","это","скажи","да","клянусь моим Господом","поистине, это","непременно правда","и не","вы","способны избежать"]]],"m":[[["وَمِنۡهُم","И из них",10,43],["مَّن","кто",10,43],["يَنظُرُ","смотрит",10,43],["إِلَيۡكَۚ","на тебя",10,43],["أَفَأَنتَ","разве ты",10,43],["تَهۡدِي","поведёшь",10,43],["ٱلۡعُمۡيَ","слепых",10,43],["وَلَوۡ","и даже если",10,43],["كَانُواْ","они были",10,43]],[["لَا","не",10,43],["يُبۡصِرُونَ","видят",10,43],[43],["إِنَّ","Поистине",10,44],["ٱللَّهَ","Аллах",10,44],["لَا","не",10,44],["يَظۡلِمُ","обижает",10,44],["ٱلنَّاسَ","людей",10,44],["شَيۡـٔٗا","ни в чём",10,44],["وَلَٰكِنَّ","но",10,44]],[["ٱلنَّاسَ","люди",10,44],["أَنفُسَهُمۡ","самих себя",10,44],["يَظۡلِمُونَ","обижают",10,44],[44],["وَيَوۡمَ","И в день",10,45],["يَحۡشُرُهُمۡ","Он соберёт их",10,45],["كَأَن","словно",10,45],["لَّمۡ","не",10,45],["يَلۡبَثُوٓاْ","они пробыли",10,45],["إِلَّا","кроме",10,45]],[["سَاعَةٗ","часа",10,45],["مِّنَ","из",10,45],["ٱلنَّهَارِ","дня",10,45],["يَتَعَارَفُونَ","они узнают друг друга",10,45],["بَيۡنَهُمۡۚ","между собой",10,45],["قَدۡ","уже",10,45],["خَسِرَ","потерпели убыток",10,45],["ٱلَّذِينَ","те, которые",10,45],["كَذَّبُواْ","сочли ложью",10,45],["بِلِقَآءِ","встречу",10,45],["ٱللَّهِ","с Аллахом",10,45]],[["وَمَا","и не",10,45],["كَانُواْ","были они",10,45],["مُهۡتَدِينَ","идущими прямо",10,45],[45],["وَإِمَّا","И либо",10,46],["نُرِيَنَّكَ","Мы непременно покажем тебе",10,46],["بَعۡضَ","часть",10,46],["ٱلَّذِي","того, что",10,46],["نَعِدُهُمۡ","Мы обещаем им",10,46],["أَوۡ","или",10,46],["نَتَوَفَّيَنَّكَ","Мы непременно упокоим тебя",10,46]],[["فَإِلَيۡنَا","то к Нам",10,46],["مَرۡجِعُهُمۡ","их возвращение",10,46],["ثُمَّ","затем",10,46],["ٱللَّهُ","Аллах",10,46],["شَهِيدٌ","свидетель",10,46],["عَلَىٰ","над",10,46],["مَا","тем, что",10,46],["يَفۡعَلُونَ","они делают",10,46],[46],["وَلِكُلِّ","И у каждой",10,47]],[["أُمَّةٖ","общины",10,47],["رَّسُولٞۖ","посланник",10,47],["فَإِذَا","и когда",10,47],["جَآءَ","пришёл",10,47],["رَسُولُهُمۡ","их посланник",10,47],["قُضِيَ","решено",10,47],["بَيۡنَهُم","между ними",10,47],["بِٱلۡقِسۡطِ","по справедливости",10,47],["وَهُمۡ","и они",10,47]],[["لَا","не",10,47],["يُظۡلَمُونَ","обижены",10,47],[47],["وَيَقُولُونَ","И они говорят",10,48],["مَتَىٰ","когда",10,48],["هَٰذَا","это",10,48],["ٱلۡوَعۡدُ","обещание",10,48],["إِن","если",10,48],["كُنتُمۡ","вы",10,48],["صَٰدِقِينَ","правдивы",10,48]],[[48],["قُل","Скажи",10,49],["لَّآ","не",10,49],["أَمۡلِكُ","я властен",10,49],["لِنَفۡسِي","для себя",10,49],["ضَرّٗا","над вредом",10,49],["وَلَا","и не",10,49],["نَفۡعًا","над пользой",10,49],["إِلَّا","кроме",10,49],["مَا","того, что",10,49],["شَآءَ","пожелал",10,49],["ٱللَّهُۗ","Аллах",10,49],["لِكُلِّ","у каждой",10,49],["أُمَّةٍ","общины",10,49]],[["أَجَلٌۚ","срок",10,49],["إِذَا","когда",10,49],["جَآءَ","пришёл",10,49],["أَجَلُهُمۡ","их срок",10,49],["فَلَا","то не",10,49],["يَسۡتَـٔۡخِرُونَ","отсрочат они",10,49],["سَاعَةٗ","на час",10,49],["وَلَا","и не",10,49],["يَسۡتَقۡدِمُونَ","ускорят",10,49],[49]],[["قُلۡ","Скажи",10,50],["أَرَءَيۡتُمۡ","видели ли вы",10,50],["إِنۡ","если",10,50],["أَتَىٰكُمۡ","придёт к вам",10,50],["عَذَابُهُۥ","Его наказание",10,50],["بَيَٰتًا","ночью",10,50],["أَوۡ","или",10,50],["نَهَارٗا","днём",10,50],["مَّاذَا","что",10,50],["يَسۡتَعۡجِلُ","торопят",10,50],["مِنۡهُ","из него",10,50]],[["ٱلۡمُجۡرِمُونَ","грешники",10,50],[50],["أَثُمَّ","Неужели затем",10,51],["إِذَا","когда",10,51],["مَا","же",10,51],["وَقَعَ","произошло",10,51],["ءَامَنتُم","вы уверовали",10,51],["بِهِۦٓۚ","в него",10,51],["ءَآلۡـَٰٔنَ","неужели теперь",10,51],["وَقَدۡ","а ведь уже",10,51],["كُنتُم","вы были",10,51],["بِهِۦ","его",10,51]],[["تَسۡتَعۡجِلُونَ","торопите",10,51],[51],["ثُمَّ","Затем",10,52],["قِيلَ","сказано",10,52],["لِلَّذِينَ","тем, которые",10,52],["ظَلَمُواْ","поступали несправедливо",10,52],["ذُوقُواْ","вкусите",10,52],["عَذَابَ","наказание",10,52],["ٱلۡخُلۡدِ","вечности",10,52]],[["هَلۡ","разве",10,52],["تُجۡزَوۡنَ","вам воздаётся",10,52],["إِلَّا","кроме как",10,52],["بِمَا","за то, что",10,52],["كُنتُمۡ","вы были",10,52],["تَكۡسِبُونَ","приобретали",10,52],[52],["۞ وَيَسۡتَنۢبِـُٔونَكَ","И они просят тебя сообщить",10,53]],[["أَحَقٌّ","разве правда",10,53],["هُوَۖ","это",10,53],["قُلۡ","скажи",10,53],["إِي","да",10,53],["وَرَبِّيٓ","клянусь моим Господом",10,53],["إِنَّهُۥ","поистине, это",10,53],["لَحَقّٞۖ","непременно правда",10,53],["وَمَآ","и не",10,53],["أَنتُم","вы",10,53],["بِمُعۡجِزِينَ","способны избежать",10,53],[53]]]}