{"p":216,"j":11,"a":[[10,62,["أَلَآ","إِنَّ","أَوۡلِيَآءَ","ٱللَّهِ","لَا","خَوۡفٌ","عَلَيۡهِمۡ","وَلَا","هُمۡ","يَحۡزَنُونَ"],"ала инна аулийааллахи ла хауфун `алайхим вала хум йахзануун","Воистину, угодники Аллаха не познают страха и не будут опечалены.",["Несомненно","поистине","угодники","Аллаха","нет","страха","над ними","и не","они","будут опечалены"]],[10,63,["ٱلَّذِينَ","ءَامَنُواْ","وَكَانُواْ","يَتَّقُونَ"],"аллазиина амануу вакануу йаттаḳуун","Они уверовали и были богобоязненны.",["те, которые","уверовали","и были","богобоязненны"]],[10,64,["لَهُمُ","ٱلۡبُشۡرَىٰ","فِي","ٱلۡحَيَوٰةِ","ٱلدُّنۡيَا","وَفِي","ٱلۡأٓخِرَةِۚ","لَا","تَبۡدِيلَ","لِكَلِمَٰتِ","ٱللَّهِۚ","ذَٰلِكَ","هُوَ","ٱلۡفَوۡزُ","ٱلۡعَظِيمُ"],"лахумул бушра фил хайаватид дунйа вафил ахирати ла табдиила ликалиматиллахи залика хуал фаузул `азиим","Им предназначена радостная весть в этом мире и в Последней жизни. Слова Аллаха не подлежат отмене. Это - великое преуспеяние.",["Им","радостная весть","в","жизни","ближней","и в","Последней жизни","нет","изменения","словам","Аллаха","это","оно","успех","великий"]],[10,65,["وَلَا","يَحۡزُنكَ","قَوۡلُهُمۡۘ","إِنَّ","ٱلۡعِزَّةَ","لِلَّهِ","جَمِيعًاۚ","هُوَ","ٱلسَّمِيعُ","ٱلۡعَلِيمُ"],"вала йахзунка ḳаулухум иннал `иззата лиллахи жамии`ан хуас самии`ул `алиим","Пусть тебя не печалит то, что они говорят, ибо могущество целиком принадлежит Аллаху. Он - Слышащий, Знающий.",["И пусть не","печалят тебя","речи их","поистине","могущество","Аллаху","целиком","Он","Слышащий","Знающий"]],[10,66,["أَلَآ","إِنَّ","لِلَّهِ","مَن","فِي","ٱلسَّمَٰوَٰتِ","وَمَن","فِي","ٱلۡأَرۡضِۗ","وَمَا","يَتَّبِعُ","ٱلَّذِينَ","يَدۡعُونَ","مِن","دُونِ","ٱللَّهِ","شُرَكَآءَۚ","إِن","يَتَّبِعُونَ","إِلَّا","ٱلظَّنَّ","وَإِنۡ","هُمۡ","إِلَّا","يَخۡرُصُونَ"],"ала инна лиллахи ман фис самавати ваман фил арди вама йаттаби`ул лазиина йад`ууна мин дууниллахи шуракаа ин йаттаби`ууна иллаз занна ва'ин хум илла йахрусуун","Воистину, Аллаху принадлежат те, кто на небесах, и те, кто на земле. Чему же следуют те, которые поклоняются помимо Аллаха другим божествам. Они следуют лишь предположениям и только измышляют.",["Несомненно","поистине","Аллаху","кто","в","небесах","и кто","на","земле","И не","следуют","те, которые","взывают","(из)","помимо","Аллаха","к сотоварищам","не","следуют они","кроме","предположения","и не","они","кроме как","домысливают"]],[10,67,["هُوَ","ٱلَّذِي","جَعَلَ","لَكُمُ","ٱلَّيۡلَ","لِتَسۡكُنُواْ","فِيهِ","وَٱلنَّهَارَ","مُبۡصِرًاۚ","إِنَّ","فِي","ذَٰلِكَ","لَأٓيَٰتٖ","لِّقَوۡمٖ","يَسۡمَعُونَ"],"хуал лазии жа`ала лакумул лайла литаскунуу фиихи ваннахара мубсиран инна фии залика ла'айатил лиḳаумин йасма`уун","Он - Тот, Кто сотворил для вас ночь, чтобы вы отдыхали в течение нее, и день для освещения. Воистину, в этом - знамения для тех, кто внимает.",["Он","Тот, Который","сделал","для вас","ночь","чтобы вы отдыхали","в ней","и день","освещающим","поистине","в","этом","непременно знамения","для людей","которые слушают"]],[10,68,["قَالُواْ","ٱتَّخَذَ","ٱللَّهُ","وَلَدٗاۗ","سُبۡحَٰنَهُۥۖ","هُوَ","ٱلۡغَنِيُّۖ","لَهُۥ","مَا","فِي","ٱلسَّمَٰوَٰتِ","وَمَا","فِي","ٱلۡأَرۡضِۚ","إِنۡ","عِندَكُم","مِّن","سُلۡطَٰنِۭ","بِهَٰذَآۚ","أَتَقُولُونَ","عَلَى","ٱللَّهِ","مَا","لَا","تَعۡلَمُونَ"],"ḳалуттахазаллаху валадан субханахуу хуал ганиййу лахуу ма фис самавати вама фил арди ин `индакум мин султани бихаза атаḳуулууна `алаллахи ма ла та`ламуун","Они говорят: «Аллах взял себе сына». Пречист Он! Он богат, и Ему принадлежит то, что на небесах, и то, что на земле. Нет у вас никакого доказательства этому. Неужели вы наговариваете на Аллаха то, чего вы не знаете?",["Сказали они","взял","Аллах","сына","Пречист Он","Он","Богатый","Ему","то, что","в","небесах","и то, что","на","земле","нет","у вас","никакого","доказательства","этому","разве говорите вы","на","Аллаха","то, что","не","знаете вы"]],[10,69,["قُلۡ","إِنَّ","ٱلَّذِينَ","يَفۡتَرُونَ","عَلَى","ٱللَّهِ","ٱلۡكَذِبَ","لَا","يُفۡلِحُونَ"],"ḳул иннал лазиина йафтарууна `алаллахил казиба ла йуфлихуун","Скажи: «Воистину, те, которые возводят навет на Аллаха, не преуспеют!».",["скажи","поистине","те, которые","измышляют","на","Аллаха","ложь","не","преуспеют"]],[10,70,["مَتَٰعٞ","فِي","ٱلدُّنۡيَا","ثُمَّ","إِلَيۡنَا","مَرۡجِعُهُمۡ","ثُمَّ","نُذِيقُهُمُ","ٱلۡعَذَابَ","ٱلشَّدِيدَ","بِمَا","كَانُواْ","يَكۡفُرُونَ"],"мата`ун фид дунйа сумма илайна маржи`ухум сумма нузииḳухумул `азабаш шадиида бима кануу йакфуруун","Они попользуются мирскими благами, а затем вернутся к Нам. И тогда Мы дадим им вкусить тяжкие мучения за то, что они не уверовали.",["Пользование","в","ближнем мире","затем","к Нам","их возвращение","затем","дадим Мы вкусить им","наказание","суровое","за то, что","были они","не веруют"]]],"m":[[["أَلَآ","Несомненно",10,62],["إِنَّ","поистине",10,62],["أَوۡلِيَآءَ","угодники",10,62],["ٱللَّهِ","Аллаха",10,62],["لَا","нет",10,62],["خَوۡفٌ","страха",10,62],["عَلَيۡهِمۡ","над ними",10,62],["وَلَا","и не",10,62],["هُمۡ","они",10,62],["يَحۡزَنُونَ","будут опечалены",10,62]],[[62],["ٱلَّذِينَ","те, которые",10,63],["ءَامَنُواْ","уверовали",10,63],["وَكَانُواْ","и были",10,63],["يَتَّقُونَ","богобоязненны",10,63],[63],["لَهُمُ","Им",10,64],["ٱلۡبُشۡرَىٰ","радостная весть",10,64]],[["فِي","в",10,64],["ٱلۡحَيَوٰةِ","жизни",10,64],["ٱلدُّنۡيَا","ближней",10,64],["وَفِي","и в",10,64],["ٱلۡأٓخِرَةِۚ","Последней жизни",10,64],["لَا","нет",10,64],["تَبۡدِيلَ","изменения",10,64],["لِكَلِمَٰتِ","словам",10,64],["ٱللَّهِۚ","Аллаха",10,64]],[["ذَٰلِكَ","это",10,64],["هُوَ","оно",10,64],["ٱلۡفَوۡزُ","успех",10,64],["ٱلۡعَظِيمُ","великий",10,64],[64],["وَلَا","И пусть не",10,65],["يَحۡزُنكَ","печалят тебя",10,65],["قَوۡلُهُمۡۘ","речи их",10,65],["إِنَّ","поистине",10,65]],[["ٱلۡعِزَّةَ","могущество",10,65],["لِلَّهِ","Аллаху",10,65],["جَمِيعًاۚ","целиком",10,65],["هُوَ","Он",10,65],["ٱلسَّمِيعُ","Слышащий",10,65],["ٱلۡعَلِيمُ","Знающий",10,65],[65],["أَلَآ","Несомненно",10,66],["إِنَّ","поистине",10,66],["لِلَّهِ","Аллаху",10,66]],[["مَن","кто",10,66],["فِي","в",10,66],["ٱلسَّمَٰوَٰ