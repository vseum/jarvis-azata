{"p":217,"j":11,"a":[[10,71,["وَٱتۡلُ","عَلَيۡهِمۡ","نَبَأَ","نُوحٍ","إِذۡ","قَالَ","لِقَوۡمِهِۦ","يَٰقَوۡمِ","إِن","كَانَ","كَبُرَ","عَلَيۡكُم","مَّقَامِي","وَتَذۡكِيرِي","بِـَٔايَٰتِ","ٱللَّهِ","فَعَلَى","ٱللَّهِ","تَوَكَّلۡتُ","فَأَجۡمِعُوٓاْ","أَمۡرَكُمۡ","وَشُرَكَآءَكُمۡ","ثُمَّ","لَا","يَكُنۡ","أَمۡرُكُمۡ","عَلَيۡكُمۡ","غُمَّةٗ","ثُمَّ","ٱقۡضُوٓاْ","إِلَيَّ","وَلَا","تُنظِرُونِ"],"ватлу `алайхим набаа нуухин из ḳала лиḳаумихии йаḳауми ин кана кабура `алайкум маḳамии ватазкиирии би'айатиллахи фа`алаллахи таваккалту фа'ажми`уу амракум вашуракаакум сумма ла йакун амрукум `алайкум гумматан суммаḳдуу илаййа вала тунзируун","Прочти им рассказ о Нухе (Ное). Вот он сказал своему народу: «О народ мой! Если вам тяжко от того, что я нахожусь среди вас и напоминаю о знамениях Аллаха, то я уповаю на Него. Объединитесь со своими идолами и действуйте открыто, а затем возьмитесь за меня и не предоставляйте мне отсрочки.",["И прочти","им","весть","о Нухе","когда","сказал он","своему народу","о народ мой","если","было","тяжко","вам","моё пребывание","и моё напоминание","знамениями","Аллаха","то на","Аллаха","я уповаю","так соберите","ваше дело","и ваших сотоварищей","затем","пусть не","будет","дело ваше","для вас","скрытым","затем","решите","со мной","и не","давайте мне отсрочки"]],[10,72,["فَإِن","تَوَلَّيۡتُمۡ","فَمَا","سَأَلۡتُكُم","مِّنۡ","أَجۡرٍۖ","إِنۡ","أَجۡرِيَ","إِلَّا","عَلَى","ٱللَّهِۖ","وَأُمِرۡتُ","أَنۡ","أَكُونَ","مِنَ","ٱلۡمُسۡلِمِينَ"],"фа'ин таваллайтум фама са'алтукум мин ажрин ин ажрийа илла `алаллахи ва'умирту ан акууна минал муслимиин","Но если вы отвернетесь, то ведь я не просил у вас награды. Меня вознаградит только Аллах, и мне велено быть одним из мусульман».",["А если","отвернётесь вы","то не","просил я у вас","никакой","награды","не","награда моя","кроме как","на","Аллахе","и мне велено","чтобы","был я","из","мусульман"]],[10,73,["فَكَذَّبُوهُ","فَنَجَّيۡنَٰهُ","وَمَن","مَّعَهُۥ","فِي","ٱلۡفُلۡكِ","وَجَعَلۡنَٰهُمۡ","خَلَٰٓئِفَ","وَأَغۡرَقۡنَا","ٱلَّذِينَ","كَذَّبُواْ","بِـَٔايَٰتِنَاۖ","فَٱنظُرۡ","كَيۡفَ","كَانَ","عَٰقِبَةُ","ٱلۡمُنذَرِينَ"],"факаззабууху фанажжайнаху вамам ма`ахуу фил фулки важа`алнахум халаифа ва'аграḳнал лазиина каззабуу би'айатина фанзур кайфа кана `аḳибатул мунзариин","Они сочли его лжецом, и Мы спасли его и тех, кто был с ним, в ковчеге. Мы сделали их преемниками и потопили тех, кто отвергал Наши знамения. Посмотри же, каким был конец увещеваемых!",["И сочли они его лжецом","и спасли Мы его","и тех, кто","с ним","в","ковчеге","и сделали Мы их","преемниками","и потопили Мы","тех, которые","сочли ложью","Наши знамения","так посмотри","каким","был","конец","увещеваемых"]],[10,74,["ثُمَّ","بَعَثۡنَا","مِنۢ","بَعۡدِهِۦ","رُسُلًا","إِلَىٰ","قَوۡمِهِمۡ","فَجَآءُوهُم","بِٱلۡبَيِّنَٰتِ","فَمَا","كَانُواْ","لِيُؤۡمِنُواْ","بِمَا","كَذَّبُواْ","بِهِۦ","مِن","قَبۡلُۚ","كَذَٰلِكَ","نَطۡبَعُ","عَلَىٰ","قُلُوبِ","ٱلۡمُعۡتَدِينَ"],"сумма ба`асна мим ба`дихии русулан ила ḳаумихим фажауухум билбаййинати фама кануу лийу'минуу бима каззабуу бихии мин ḳаблу казалика натба`у `ала ḳулуубил му`тадиин","После него Мы отправили посланников к их народам. Они приносили им ясные знамения, но те не желали уверовать в то, что отвергали прежде. Так Мы запечатываем сердца преступников.",["Затем","отправили Мы","вслед","за ним","посланников","к","народам их","и пришли они к ним","с ясными знамениями","но не","были они","чтобы уверовать","в то, что","сочли ложью они","его","ещё","прежде","так","запечатываем Мы","(на)","сердца","преступников"]],[10,75,["ثُمَّ","بَعَثۡنَا","مِنۢ","بَعۡدِهِم","مُّوسَىٰ","وَهَٰرُونَ","إِلَىٰ","فِرۡعَوۡنَ","وَمَلَإِيْهِۦ","بِـَٔايَٰتِنَا","فَٱسۡتَكۡبَرُواْ","وَكَانُواْ","قَوۡمٗا","مُّجۡرِمِينَ"],"сумма ба`асна мим ба`дихим мууса вахарууна ила фир`ауна вамалаихии би'айатина фастакбаруу вакануу ḳаумам мужримиин","После них Мы послали Мусу (Моисея) и Харуна (Аарона) с Нашими знамениями к Фараону и его знати, но они возгордились. Они были грешным народом.",["Затем","отправили Мы","вслед","за ними","Мусу","и Харуна","к","Фараону","и его знати","с Нашими знамениями","но возгордились они","и были они","народом","грешным"]],[10,76,["فَلَمَّا","جَآءَهُمُ","ٱلۡحَقُّ","مِنۡ","عِندِنَا","قَالُوٓاْ","إِنَّ","هَٰذَا","لَسِحۡرٞ","مُّبِينٞ"],"фаламма жаахумул хаḳḳу мин `индина ḳалуу инна хаза ласихрум мубиин","Когда к ним явилась истина от Нас, они сказали: «Воистину, это - очевидное колдовство».",["И когда","пришла к ним","истина","от","Нас","сказали они","поистине","это","непременно колдовство","очевидное"]],[10,77,["قَالَ","مُوسَىٰٓ","أَتَقُولُونَ","لِلۡحَقِّ","لَمَّا","جَآءَكُمۡۖ","أَسِحۡرٌ","هَٰذَا","وَلَا","يُفۡلِحُ","ٱلسَّٰحِرُونَ"],"ḳала мууса атаḳуулууна лилхаḳḳи ламма жаакум асихрун хаза вала йуфлихус сахируун","Муса (Моисей) сказал: «Неужели, когда истина явилась к вам, вы говорите: «Колдовство ли это?». Воистину, колдуны не преуспеют».",["Сказал","Муса","разве говорите вы","об истине","когда","пришла она к вам","разве колдовство","это","но не","преуспеют","колдуны"]],[10,78,["قَالُوٓاْ","أَجِئۡتَنَا","لِتَلۡفِتَنَا","عَمَّا","وَجَدۡنَا","عَلَيۡهِ","ءَابَآءَنَا","وَتَكُونَ","لَكُمَا","ٱلۡكِبۡرِيَآءُ","فِي","ٱلۡأَرۡضِ","وَمَا","نَحۡنُ","لَكُمَا","بِمُؤۡمِنِينَ"],"ḳалуу ажи'тана литалфитана `амма важадна `алайхи абаана ватакууна лакумал кибрийау фил арди вама нахну лакума биму'миниин","Они сказали: «Неужели ты пришел для того, чтобы сбить нас с пути, по которому шли наши отцы, и чтобы вам обоим досталось величие на земле? Мы не уверуем в вас».",["Сказали они","пришёл ли ты к нам","чтобы отвратить нас","от того, что","нашли мы","на нём","отцов наших","и было","вам обоим","величие","на","земле","и не","мы","вам обоим","верующие"]]],"m":[[["۞ وَٱتۡلُ","И прочти",10,71],["عَلَيۡهِمۡ","им",10,71],["نَبَأَ","весть",10,71],["نُوحٍ","о Нухе",10,71],["إِذۡ","когда",10,71],["قَالَ","сказал он",10,71],["لِقَوۡمِهِۦ","своему народу",10,71],["يَٰقَوۡمِ","о народ мой",10,71],["إِن","если",10,71],["كَانَ","было",10,71],["كَبُرَ","тяжко",10,71],["عَلَيۡكُم","вам",10,71]],[["مَّقَامِي","моё пребывание",10,71],["وَتَذۡكِيرِي","и моё напоминание",10,71],["بِـَٔايَٰتِ","знамениями",10,71],["ٱللَّهِ","Аллаха",10,71],["فَعَلَى","то на",10,71],["ٱللَّهِ","Аллаха",10,71],["تَوَكَّلۡتُ","я уповаю",10,71],["فَأَجۡمِعُوٓاْ","так соберите",10,71]],[["أَمۡرَكُمۡ","ваше дело",10,71],["وَشُرَكَآءَكُمۡ","и ваших сотоварищей",10,71],["ثُمَّ","затем",10,71],["لَا","пусть не",10,71],["يَكُنۡ","будет",10,71],["أَمۡرُكُمۡ","дело ваше",10,71],["عَلَيۡكُمۡ","для вас",10,71],["غُمَّةٗ","скрытым",10,71],["ثُمَّ","затем",10,71],["ٱقۡضُوٓاْ","решите",10,71]],[["إِلَيَّ","со мной",10,71],["وَلَا","и не",10,71],["تُنظِرُونِ","давайте мне отсрочки",10,71],[71],["فَإِن","А если",10,72],["تَوَلَّيۡتُمۡ","отвернётесь вы",10,72],["فَمَا","то не",10,72],["سَأَلۡتُكُم","просил я у вас",10,72],["مِّنۡ","никакой",10,72],["أَجۡرٍۖ","награды",10,72],["إِنۡ","не",10,72]],[["أَجۡرِيَ","награда моя",10,72],["إِلَّا","кроме как",10,72],["عَلَى","на",10,72],["ٱللَّهِۖ","Аллахе",10,72],["وَأُمِرۡتُ","и мне велено",10,72],["أَنۡ","чтобы",10,72],["أَكُونَ","был я",10,72],["مِنَ","из",10,72],["ٱلۡمُسۡلِمِينَ","мусульман",10,72],[72]],[["فَكَذَّبُوهُ","И сочли они его лжецом",10,73],["فَنَجَّيۡنَٰهُ","и спасли Мы его",10,73],["وَمَن","и тех, кто",10,73],["مَّعَهُۥ","с ним",10,73],["فِي","в",10,73],["ٱلۡفُلۡكِ","ковчеге",10,73],["وَجَعَلۡنَٰهُمۡ","и сделали Мы их",10,73],["خَلَٰٓئِفَ","преемниками",10,73]],[["وَأَغۡرَقۡنَا","и потопили Мы",10,73],["ٱلَّذِينَ","тех, которые",10,73],["كَذَّبُواْ","сочли ложью",10,73],["بِـَٔايَٰتِنَاۖ","Наши знамения",10,73],["فَٱنظُرۡ","так посмотри",10,73],["كَيۡفَ","каким",10,73],["كَانَ","был",10,73],["عَٰقِبَةُ","конец",10,73],["ٱلۡمُنذَرِينَ","увещеваемых",10,73]],[[73],["ثُمَّ","Затем",10,74],["بَعَثۡنَا","отправили Мы",10,74],["مِنۢ","вслед",10,74],["بَعۡدِهِۦ","за ним",10,74],["رُسُلًا","посланников",10,74],["إِلَىٰ","к",10,74],["قَوۡمِهِمۡ","народам их",10,74],["فَجَآءُوهُم","и пришли они к ним",10,74],["بِٱلۡبَيِّنَٰتِ","с ясными знамениями",10,74]],[["فَمَا","но не",10,74],["كَانُواْ","были они",10,74],["لِيُؤۡمِنُواْ","чтобы уверовать",10,74],["بِمَا","в то, что",10,74],["كَذَّبُواْ","сочли ложью они",10,74],["بِهِۦ","его",10,74],["مِن","ещё",10,74],["قَبۡلُۚ","прежде",10,74],["كَذَٰلِكَ","так",10,74],["نَطۡبَعُ","запечатываем Мы",10,74],["عَلَىٰ","(на)",10,74],["قُلُوبِ","сердца",10,74]],[["ٱلۡمُعۡتَدِينَ","преступников",10,74],[74],["ثُمَّ","Затем",10,75],["بَعَثۡنَا","отправили Мы",10,75],["مِنۢ","вслед",10,75],["بَعۡدِهِم","за ними",10,75],["مُّوسَىٰ","Мусу",10,75],["وَهَٰرُونَ","и Харуна",10,75],["إِلَىٰ","к",10,75]],[["فِرۡعَوۡنَ","Фараону",10,75],["وَمَلَإِيْهِۦ","и его знати",10,75],["بِـَٔايَٰتِنَا","с Нашими знамениями",10,75],["فَٱسۡتَكۡبَرُواْ","но возгордились они",10,75],["وَكَانُواْ","и были они",10,75],["قَوۡمٗا","народом",10,75],["مُّجۡرِمِينَ","грешным",10,75],[75]],[["فَلَمَّا","И когда",10,76],["جَآءَهُمُ","пришла к ним",10,76],["ٱلۡحَقُّ","истина",10,76],["مِنۡ","от",10,76],["عِندِنَا","Нас",10,76],["قَالُوٓاْ","сказали они",10,76],["إِنَّ","поистине",10,76],["هَٰذَا","это",10,76],["لَسِحۡرٞ","непременно колдовство",10,76],["مُّبِينٞ","очевидное",10,76],[76]],[["قَالَ","Сказал",10,77],["مُوسَىٰٓ","Муса",10,77],["أَتَقُولُونَ","разве говорите вы",10,77],["لِلۡحَقِّ","об истине",10,77],["لَمَّا","когда",10,77],["جَآءَكُمۡۖ","пришла она к вам",10,77],["أَسِحۡرٌ","разве колдовство",10,77],["هَٰذَا","это",10,77],["وَلَا","но не",10,77],["يُفۡلِحُ","преуспеют",10,77]],[["ٱلسَّٰحِرُونَ","колдуны",10,77],[77],["قَالُوٓاْ","Сказали они",10,78],["أَجِئۡتَنَا","пришёл ли ты к нам",10,78],["لِتَلۡفِتَنَا","чтобы отвратить нас",10,78],["عَمَّا","от того, что",10,78],["وَجَدۡنَا","нашли мы",10,78],["عَلَيۡهِ","на нём",10,78],["ءَابَآءَنَا","отцов наших",10,78]],[["وَتَكُونَ","и было",10,78],["لَكُمَا","вам обоим",10,78],["ٱلۡكِبۡرِيَآءُ","величие",10,78],["فِي","на",10,78],["ٱلۡأَرۡضِ","земле",10,78],["وَمَا","и не",10,78],["نَحۡنُ","мы",10,78],["لَكُمَا","вам обоим",10,78],["بِمُؤۡمِنِي