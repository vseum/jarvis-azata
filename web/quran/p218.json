{"p":218,"j":11,"a":[[10,79,["وَقَالَ","فِرۡعَوۡنُ","ٱئۡتُونِي","بِكُلِّ","سَٰحِرٍ","عَلِيمٖ"],"ваḳала фир`аунутуунии бикулли сахирин `алиим","Фараон сказал: «Приведите ко мне всех знающих колдунов».",["и сказал","Фараон","приведите ко мне","всякого","колдуна","знающего"]],[10,80,["فَلَمَّا","جَآءَ","ٱلسَّحَرَةُ","قَالَ","لَهُم","مُّوسَىٰٓ","أَلۡقُواْ","مَآ","أَنتُم","مُّلۡقُونَ"],"фаламма жаас сахарату ḳала лахум мууса алḳуу ма антум мулḳуун","Когда колдуны явились, Муса (Моисей) сказал им: «Бросайте то, что вы хотите бросить!».",["И когда","пришли","колдуны","сказал","им","Муса","бросайте","то, что","вы","бросаете"]],[10,81,["فَلَمَّآ","أَلۡقَوۡاْ","قَالَ","مُوسَىٰ","مَا","جِئۡتُم","بِهِ","ٱلسِّحۡرُۖ","إِنَّ","ٱللَّهَ","سَيُبۡطِلُهُۥٓ","إِنَّ","ٱللَّهَ","لَا","يُصۡلِحُ","عَمَلَ","ٱلۡمُفۡسِدِينَ"],"фаламма алḳау ḳала мууса ма жи'тум бихис сихру инналлаха сайубтилухуу инналлаха ла йуслиху `амалал муфсидиин","Когда они бросили, Муса (Моисей) сказал: «Вы явили колдовство. Воистину, Аллах сделает его тщетным. Аллах не исправляет деяний распространяющих нечестие.",["И когда","бросили они","сказал","Муса","то, что","принесли вы","с ним","колдовство","поистине","Аллах","сделает тщетным его","поистине","Аллах","не","исправляет","дело","распространяющих нечестие"]],[10,82,["وَيُحِقُّ","ٱللَّهُ","ٱلۡحَقَّ","بِكَلِمَٰتِهِۦ","وَلَوۡ","كَرِهَ","ٱلۡمُجۡرِمُونَ"],"вайухиḳḳуллахул хаḳḳа бикалиматихии валау карихал мужримуун","Аллах утвердит истину Своими Словами, даже если это ненавистно грешникам».",["и утверждает","Аллах","истину","Своими словами","и даже если","ненавидят","грешники"]],[10,83,["فَمَآ","ءَامَنَ","لِمُوسَىٰٓ","إِلَّا","ذُرِّيَّةٞ","مِّن","قَوۡمِهِۦ","عَلَىٰ","خَوۡفٖ","مِّن","فِرۡعَوۡنَ","وَمَلَإِيْهِمۡ","أَن","يَفۡتِنَهُمۡۚ","وَإِنَّ","فِرۡعَوۡنَ","لَعَالٖ","فِي","ٱلۡأَرۡضِ","وَإِنَّهُۥ","لَمِنَ","ٱلۡمُسۡرِفِينَ"],"фама амана лимууса илла зурриййатум мин ḳаумихии `ала хауфим мин фир`ауна вамалаихим ан йафтинахум ва'инна фир`ауна ла`алин фил арди ва'иннахуу ламинал мусрифиин","Из-за страха перед тем, что Фараон и его знать будут преследовать их, Мусе (Моисею) поверили лишь немногие потомки из его народа. Воистину, Фараон был деспотичным тираном на земле. Воистину, он был одним из тех, кто излишествует.",["И не","уверовал","Мусе","кроме","потомков","из","его народа","при","страхе","перед","Фараоном","и их знатью","что","станет преследовать их","и поистине","Фараон","непременно надменный","на","земле","и поистине он","непременно из","излишествующих"]],[10,84,["وَقَالَ","مُوسَىٰ","يَٰقَوۡمِ","إِن","كُنتُمۡ","ءَامَنتُم","بِٱللَّهِ","فَعَلَيۡهِ","تَوَكَّلُوٓاْ","إِن","كُنتُم","مُّسۡلِمِينَ"],"ваḳала мууса йаḳауми ин кунтум амантум биллахи фа`алайхи таваккалуу ин кунтум муслимиин","Муса (Моисей) сказал: «О мой народ! Если вы уверовали в Аллаха и стали мусульманами, то уповайте на Него».",["И сказал","Муса","о народ мой","если","вы","уверовали","в Аллаха","то на Него","уповайте","если","вы","мусульмане"]],[10,85,["فَقَالُواْ","عَلَى","ٱللَّهِ","تَوَكَّلۡنَا","رَبَّنَا","لَا","تَجۡعَلۡنَا","فِتۡنَةٗ","لِّلۡقَوۡمِ","ٱلظَّٰلِمِينَ"],"фаḳалуу `алаллахи таваккална раббана ла таж`ална фитнатал лилḳаумиз залимиин","Они сказали: «Мы уповаем на одного Аллаха. Господь наш, не делай нас искушением для людей несправедливых!",["И сказали они","на","Аллаха","уповаем мы","Господь наш","не","делай нас","искушением","для людей","несправедливых"]],[10,86,["وَنَجِّنَا","بِرَحۡمَتِكَ","مِنَ","ٱلۡقَوۡمِ","ٱلۡكَٰفِرِينَ"],"ванажжина бирахматика минал ḳаумил кафириин","По Своей милости спаси нас от людей неверующих».",["И спаси нас","Твоей милостью","от","людей","неверующих"]],[10,87,["وَأَوۡحَيۡنَآ","إِلَىٰ","مُوسَىٰ","وَأَخِيهِ","أَن","تَبَوَّءَا","لِقَوۡمِكُمَا","بِمِصۡرَ","بُيُوتٗا","وَٱجۡعَلُواْ","بُيُوتَكُمۡ","قِبۡلَةٗ","وَأَقِيمُواْ","ٱلصَّلَوٰةَۗ","وَبَشِّرِ","ٱلۡمُؤۡمِنِينَ"],"ва'аухайна ила мууса ва'ахиихи ан табавваа лиḳаумикума бимисра буйуутан важ`алуу буйуутакум ḳиблатан ва'аḳиимус салавата вабашширил му'миниин","Мы ниспослали откровение Мусе (Моисею) и его брату: «Обеспечьте свой народ жилищами в Египте, превратите свои жилища в места для поклонения и совершайте намаз. Обрадуй же верующих!».",["И внушили Мы","(к)","Мусе","и брату его","что","поселите","для народа вашего","в Египте","дома","и сделайте","дома ваши","местом молитвы","и совершайте","намаз","и обрадуй","верующих"]],[10,88,["وَقَالَ","مُوسَىٰ","رَبَّنَآ","إِنَّكَ","ءَاتَيۡتَ","فِرۡعَوۡنَ","وَمَلَأَهُۥ","زِينَةٗ","وَأَمۡوَٰلٗا","فِي","ٱلۡحَيَوٰةِ","ٱلدُّنۡيَا","رَبَّنَا","لِيُضِلُّواْ","عَن","سَبِيلِكَۖ","رَبَّنَا","ٱطۡمِسۡ","عَلَىٰٓ","أَمۡوَٰلِهِمۡ","وَٱشۡدُدۡ","عَلَىٰ","قُلُوبِهِمۡ","فَلَا","يُؤۡمِنُواْ","حَتَّىٰ","يَرَوُاْ","ٱلۡعَذَابَ","ٱلۡأَلِيمَ"],"ваḳала мууса раббана иннака атайта фир`ауна вамалаахуу зиинатан ва'амвалан фил хайаватид дунйа раббана лийудиллуу `ан сабиилика раббанатмис `ала амвалихим вашдуд `ала ḳулуубихим фала йу'минуу хатта йаравул `азабал алиим","Муса (Моисей) сказал: «Господь наш! Ты даровал Фараону и его знати в мирской жизни украшения и богатства. Господь наш! Они сбили других с Твоего пути. Господь наш! Уничтожь их богатство и ожесточи их сердца, чтобы они не могли уверовать, пока не увидят мучительные страдания».",["И сказал","Муса","Господь наш","поистине Ты","даровал","Фараону","и его знати","украшения","и богатства","в","жизни","ближней","Господь наш","чтобы сбивали они","с","Твоего пути","Господь наш","уничтожь","(на)","их богатства","и ожесточи","(на)","их сердца","чтобы не","уверовали они","пока не","увидят они","наказание","мучительное"]]],"m":[[["وَقَالَ","и сказал",10,79],["فِرۡعَوۡنُ","Фараон",10,79],["ٱئۡتُونِي","приведите ко мне",10,79],["بِكُلِّ","всякого",10,79],["سَٰحِرٍ","колдуна",10,79],["عَلِيمٖ","знающего",10,79],[79],["فَلَمَّا","И когда",10,80],["جَآءَ","пришли",10,80],["ٱلسَّحَرَةُ","колдуны",10,80]],[["قَالَ","сказал",10,80],["لَهُم","им",10,80],["مُّوسَىٰٓ","Муса",10,80],["أَلۡقُواْ","бросайте",10,80],["مَآ","то, что",10,80],["أَنتُم","вы",10,80],["مُّلۡقُونَ","бросаете",10,80],[80],["فَلَمَّآ","И когда",10,81],["أَلۡقَوۡاْ","бросили они",10,81],["قَالَ","сказал",10,81]],[["مُوسَىٰ","Муса",10,81],["مَا","то, что",10,81],["جِئۡتُم","принесли вы",10,81],["بِهِ","с ним",10,81],["ٱلسِّحۡرُۖ","колдовство",10,81],["إِنَّ","поистине",10,81],["ٱللَّهَ","Аллах",10,81],["سَيُبۡطِلُهُۥٓ","сделает тщетным его",10,81],["إِنَّ","поистине",10,81],["ٱللَّهَ","Аллах",10,81],["لَا","не",10,81],["يُصۡلِحُ","исправляет",10,81]],[["عَمَلَ","дело",10,81],["ٱلۡمُفۡسِدِينَ","распространяющих нечестие",10,81],[81],["وَيُحِقُّ","и утверждает",10,82],["ٱللَّهُ","Аллах",10,82],["ٱلۡحَقَّ","истину",10,82],["بِكَلِمَٰتِهِۦ","Своими словами",10,82],["وَلَوۡ","и даже если",10,82],["كَرِهَ","ненавидят",10,82]],[["ٱلۡمُجۡرِمُونَ","грешники",10,82],[82],["فَمَآ","И не",10,83],["ءَامَنَ","уверовал",10,83],["لِمُوسَىٰٓ","Мусе",10,83],["إِلَّا","кроме",10,83],["ذُرِّيَّةٞ","потомков",10,83],["مِّن","из",10,83],["قَوۡمِهِۦ","его народа",10,83],["عَلَىٰ","при",10,83]],[["خَوۡفٖ","страхе",10,83],["مِّن","перед",10,83],["فِرۡعَوۡنَ","Фараоном",10,83],["وَمَلَإِيْهِمۡ","и их знатью",10,83],["أَن","что",10,83],["يَفۡتِنَهُمۡۚ","станет преследовать их",10,83],["وَإِنَّ","и поистине",10,83],["فِرۡعَوۡنَ","Фараон",10,83],["لَعَالٖ","непременно надменный",10,83]],[["فِي","на",10,83],["ٱلۡأَرۡضِ","земле",10,83],["وَإِنَّهُۥ","и поистине он",10,83],["لَمِنَ","непременно из",10,83],["ٱلۡمُسۡرِفِينَ","излишествующих",10,83],[83],["وَقَالَ","И сказал",10,84],["مُوسَىٰ","Муса",10,84],["يَٰقَوۡمِ","о народ мой",10,84],["إِن","если",10,84],["كُنتُمۡ","вы",10,84]],[["ءَامَنتُم","уверовали",10,84],["بِٱللَّهِ","в Аллаха",10,84],["فَعَلَيۡهِ","то на Него",10,84],["تَوَكَّلُوٓاْ","уповайте",10,84],["إِن","если",10,84],["كُنتُم","вы",10,84],["مُّسۡلِمِينَ","мусульмане",10,84],[84],["فَقَالُواْ","И сказали они",10,85],["عَلَى","на",10,85],["ٱللَّهِ","Аллаха",10,85]],[["تَوَكَّلۡنَا","уповаем мы",10,85],["رَبَّنَا","Господь наш",10,85],["لَا","не",10,85],["تَجۡعَلۡنَا","делай нас",10,85],["فِتۡنَةٗ",