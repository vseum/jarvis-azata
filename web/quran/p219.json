{"p":219,"j":11,"a":[[10,89,["قَالَ","قَدۡ","أُجِيبَت","دَّعۡوَتُكُمَا","فَٱسۡتَقِيمَا","وَلَا","تَتَّبِعَآنِّ","سَبِيلَ","ٱلَّذِينَ","لَا","يَعۡلَمُونَ"],"ḳала ḳад ужиибат дда`ватукума фастаḳиима вала таттаби`анни сабиилал лазиина ла йа`ламуун","Он сказал: «Ваша молитва принята. Ступайте прямым путем и не следуйте за теми, кто не обладает знанием».",["Сказал Он","уже","принята","мольба ваша","так будьте стойки","и не","следуйте","путём","тех, которые","не","знают"]],[10,90,["وَجَٰوَزۡنَا","بِبَنِيٓ","إِسۡرَٰٓءِيلَ","ٱلۡبَحۡرَ","فَأَتۡبَعَهُمۡ","فِرۡعَوۡنُ","وَجُنُودُهُۥ","بَغۡيٗا","وَعَدۡوًاۖ","حَتَّىٰٓ","إِذَآ","أَدۡرَكَهُ","ٱلۡغَرَقُ","قَالَ","ءَامَنتُ","أَنَّهُۥ","لَآ","إِلَٰهَ","إِلَّا","ٱلَّذِيٓ","ءَامَنَتۡ","بِهِۦ","بَنُوٓاْ","إِسۡرَٰٓءِيلَ","وَأَنَا۠","مِنَ","ٱلۡمُسۡلِمِينَ"],"важавазна бибании исраиилал бахра фа'атба`ахум фир`ауну важунуудухуу багйан ва`адван хатта иза адракахул гараḳу ḳала аманту аннахуу ла илаха иллал лазии аманат бихии бануу исраиила ва'ана минал муслимиин","Мы переправили сынов Исраила (Израиля) через море, а Фараон и его войско последовали за ними, бесчинствуя и поступая враждебно. Когда же Фараон стал тонуть, он сказал: «Я уверовал в то, что нет Бога, кроме Того, в Кого уверовали сыны Исраила (Израиля). Я стал одним из мусульман».",["И переправили Мы","сынов","Исраила","через море","и последовал за ними","Фараон","и войска его","бесчинствуя","и враждуя","пока наконец","когда","настигло его","потопление","сказал он","уверовал я","что","нет","бога","кроме","Того","уверовали","в Него","сыны","Исраила","и я","из","мусульман"]],[10,91,["ءَآلۡـَٰٔنَ","وَقَدۡ","عَصَيۡتَ","قَبۡلُ","وَكُنتَ","مِنَ","ٱلۡمُفۡسِدِينَ"],"ал'ана ваḳад `асайта ḳаблу вакунта минал муфсидиин","Аллах сказал: «Только сейчас! А ведь раньше ты ослушался и был одним из распространяющих нечестие.",["Только теперь","а уже","ослушался ты","прежде","и был ты","из","распространяющих нечестие"]],[10,92,["فَٱلۡيَوۡمَ","نُنَجِّيكَ","بِبَدَنِكَ","لِتَكُونَ","لِمَنۡ","خَلۡفَكَ","ءَايَةٗۚ","وَإِنَّ","كَثِيرٗا","مِّنَ","ٱلنَّاسِ","عَنۡ","ءَايَٰتِنَا","لَغَٰفِلُونَ"],"фалйаума нунажжиика бибаданика литакууна лиман халфака айатан ва'инна касиирам минан наси `ан айатина лагафилуун","Сегодня Мы спасем твое тело, чтобы ты стал знамением для тех, кто будет после тебя». Воистину, многие люди пренебрегают Нашими знамениями.",["И сегодня","спасём Мы тебя","твоим телом","чтобы был ты","для тех, кто","после тебя","знамением","и поистине","многие","из","людей","к","Нашим знамениям","непременно беспечны"]],[10,93,["وَلَقَدۡ","بَوَّأۡنَا","بَنِيٓ","إِسۡرَٰٓءِيلَ","مُبَوَّأَ","صِدۡقٖ","وَرَزَقۡنَٰهُم","مِّنَ","ٱلطَّيِّبَٰتِ","فَمَا","ٱخۡتَلَفُواْ","حَتَّىٰ","جَآءَهُمُ","ٱلۡعِلۡمُۚ","إِنَّ","رَبَّكَ","يَقۡضِي","بَيۡنَهُمۡ","يَوۡمَ","ٱلۡقِيَٰمَةِ","فِيمَا","كَانُواْ","فِيهِ","يَخۡتَلِفُونَ"],"валаḳад бавва'на бании исраиила мубавваа сидḳин варазаḳнахум минат таййибати фамахталафуу хатта жаахумул `илму инна раббака йаḳдии байнахум йаумал ḳийамати фиима кануу фиихи йахталифуун","Мы поселили сынов Исраила (Израиля) в славной стране и одарили их благами. Между ними не было разногласий, пока к ним не явилось знание. Воистину, в День воскресения твой Господь рассудит между ними в том, в чем они расходились во мнениях.",["И воистину","поселили Мы","сынов","Исраила","в поселении","достойном","и наделили Мы их","из","благ","и не","разошлись они","пока не","пришло к ним","знание","поистине","Господь твой","рассудит","между ними","в День","воскресения","в том, в чём","они","(в нём)","расходились"]],[10,94,["فَإِن","كُنتَ","فِي","شَكّٖ","مِّمَّآ","أَنزَلۡنَآ","إِلَيۡكَ","فَسۡـَٔلِ","ٱلَّذِينَ","يَقۡرَءُونَ","ٱلۡكِتَٰبَ","مِن","قَبۡلِكَۚ","لَقَدۡ","جَآءَكَ","ٱلۡحَقُّ","مِن","رَّبِّكَ","فَلَا","تَكُونَنَّ","مِنَ","ٱلۡمُمۡتَرِينَ"],"фа'ин кунта фии шакким мимма анзална илайка фас'алил лазиина йаḳрауунал китаба мин ḳаблика лаḳад жаакал хаḳḳу мир раббика фала такуунанна минал мумтариин","Если ты сомневаешься в том, что Мы ниспослали тебе, то спроси тех, кто начал читать Писание раньше тебя. Воистину, к тебе явилась истина от твоего Господа. Не будь же в числе тех, кто сомневается.",["И если","ты","в","сомнении","в том, что","ниспослали Мы","тебе","то спроси","тех, которые","читают","Писание","ещё","до тебя","воистину","пришла к тебе","истина","от","Господа твоего","так не","будь же","из","сомневающихся"]],[10,95,["وَلَا","تَكُونَنَّ","مِنَ","ٱلَّذِينَ","كَذَّبُواْ","بِـَٔايَٰتِ","ٱللَّهِ","فَتَكُونَ","مِنَ","ٱلۡخَٰسِرِينَ"],"вала такуунанна минал лазиина каззабуу би'айатиллахи фатакууна минал хасириин","Не будь в числе тех, которые считают ложью знамения Аллаха, а не то окажешься одним из потерпевших убыток.",["И не","будь же","из","тех, которые","сочли ложью","знамения","Аллаха","а то будешь","из","потерпевших убыток"]],[10,96,["إِنَّ","ٱلَّذِينَ","حَقَّتۡ","عَلَيۡهِمۡ","كَلِمَتُ","رَبِّكَ","لَا","يُؤۡمِنُونَ"],"иннал лазиина хаḳḳат `алайхим калимату раббика ла йу'минуун","Воистину, те, о которых подтвердилось Слово Аллаха, не уверуют,",["Поистине","те, которые","подтвердилось","о них","слово","Господа твоего","не","уверуют"]],[10,97,["وَلَوۡ","جَآءَتۡهُمۡ","كُلُّ","ءَايَةٍ","حَتَّىٰ","يَرَوُاْ","ٱلۡعَذَابَ","ٱلۡأَلِيمَ"],"валау жаатхум куллу айатин хатта йаравул `азабал алиим","пока их не постигнут мучительные страдания, даже если им явятся любые знамения.",["И даже если","придёт к ним","всякое","знамение","пока не","увидят","наказание","мучительное"]]],"m":[[["قَالَ","Сказал Он",10,89],["قَدۡ","уже",10,89],["أُجِيبَت","принята",10,89],["دَّعۡوَتُكُمَا","мольба ваша",10,89],["فَٱسۡتَقِيمَا","так будьте стойки",10,89],["وَلَا","и не",10,89],["تَتَّبِعَآنِّ","следуйте",10,89],["سَبِيلَ","путём",10,89]],[["ٱلَّذِينَ","тех, которые",10,89],["لَا","не",10,89],["يَعۡلَمُونَ","знают",10,89],[89],["۞ وَجَٰوَزۡنَا","И переправили Мы",10,90],["بِبَنِيٓ","сынов",10,90],["إِسۡرَٰٓءِيلَ","Исраила",10,90],["ٱلۡبَحۡرَ","через море",10,90]],[["فَأَتۡبَعَهُمۡ","и последовал за ними",10,90],["فِرۡعَوۡنُ","Фараон",10,90],["وَجُنُودُهُۥ","и войска его",10,90],["بَغۡيٗا","бесчинствуя",10,90],["وَعَدۡوًاۖ","и враждуя",10,90],["حَتَّىٰٓ","пока наконец",10,90],["إِذَآ","когда",10,90],["أَدۡرَكَهُ","настигло его",10,90]],[["ٱلۡغَرَقُ","потопление",10,90],["قَالَ","сказал он",10,90],["ءَامَنتُ","уверовал я",10,90],["أَنَّهُۥ","что",10,90],["لَآ","нет",10,90],["إِلَٰهَ","бога",10,90],["إِلَّا","кроме",10,90],["ٱلَّذِيٓ","Того",10,90],["ءَامَنَتۡ","уверовали",10,90],["بِهِۦ","в Него",10,90],["بَنُوٓاْ","сыны",10,90],["إِسۡرَٰٓءِيلَ","Исраила",10,90]],[["وَأَنَا۠","и я",10,90],["مِنَ","из",10,90],["ٱلۡمُسۡلِمِينَ","мусульман",10,90],[90],["ءَآلۡـَٰٔنَ","Только теперь",10,91],["وَقَدۡ","а уже",10,91],["عَصَيۡتَ","ослушался ты",10,91],["قَبۡلُ","прежде",10,91],["وَكُنتَ","и был ты",10,91]],[["مِنَ","из",10,91],["ٱلۡمُفۡسِدِينَ","распространяющих нечестие",10,91],[91],["فَٱلۡيَوۡمَ","И сегодня",10,92],["نُنَجِّيكَ","спасём Мы тебя",10,92],["بِبَدَنِكَ","твоим телом",10,92],["لِتَكُونَ","чтобы был ты",10,92],["لِمَنۡ","для тех, кто",10,92]],[["خَلۡفَكَ","после тебя",10,92],["ءَايَةٗۚ","знамением",10,92],["وَإِنَّ","и поистине",10,92],["كَثِيرٗا","многие",10,92],["مِّنَ","из",10,92],["ٱلنَّاسِ","людей",10,92],["عَنۡ","к",10,92],["ءَايَٰتِنَا","Нашим знамениям",10,92],["لَغَٰفِلُونَ","непременно беспечны",10,92],[92]],[["وَلَقَدۡ","И воистину",10,93],["بَوَّأۡنَا","поселили Мы",10,93],["بَنِيٓ","сынов",10,93],["إِسۡرَٰٓءِيلَ","Исраила",10,93],["مُبَوَّأَ","в поселении",10,93],["صِدۡقٖ","достойном",10,93],["وَرَزَقۡنَٰهُم","и наделили Мы их",10,93],["مِّنَ","из",10,93],["ٱلطَّيِّبَٰتِ","благ",10,93]],[["فَمَا","и не",10,93],["ٱخۡتَلَفُواْ","разошлись они",10,93],["حَتَّىٰ","пока не",10,93],["جَآءَهُمُ","пришло к ним",10,93],["ٱلۡعِلۡمُۚ","знание",10,93],["إِنَّ","поистине",10,93],["رَبَّكَ","Господь твой",10,93],["يَقۡضِي","рассудит",10,93],["بَيۡنَهُمۡ","между ними",10,93],["يَوۡمَ","в День",10,93],["ٱلۡقِيَٰمَةِ","воскресения",10,93]],[["فِيمَا","в том, в чём",10,93],["كَانُواْ","они",10,93],["فِيهِ","(в нём)",10,93],