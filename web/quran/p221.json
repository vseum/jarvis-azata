{"p":221,"j":11,"a":[[10,107,["وَإِن","يَمۡسَسۡكَ","ٱللَّهُ","بِضُرّٖ","فَلَا","كَاشِفَ","لَهُۥٓ","إِلَّا","هُوَۖ","وَإِن","يُرِدۡكَ","بِخَيۡرٖ","فَلَا","رَآدَّ","لِفَضۡلِهِۦۚ","يُصِيبُ","بِهِۦ","مَن","يَشَآءُ","مِنۡ","عِبَادِهِۦۚ","وَهُوَ","ٱلۡغَفُورُ","ٱلرَّحِيمُ"],"ва'ин йамсаскаллаху бидуррин фала кашифа лахуу илла хуа ва'ин йуридка бихайрин фала радда лифадлихии йусиибу бихии ман йашау мин `ибадихии вахуал гафуурур рахиим","Если Аллах коснется тебя вредом, то никто, кроме Него, не избавит тебя от него. Если Он пожелает одарить тебя добром, то никто не отвратит Его милости. Он одаряет ею того из Своих рабов, кого пожелает. Он - Прощающий, Милосердный.",["И если","коснётся тебя","Аллах","вредом","то нет","избавителя","от него","кроме","Него","и если","пожелает Он тебе","добра","то нет","отвращающего","Его милость","постигает Он","ею","кого","пожелает Он","из","Своих рабов","и Он","Прощающий","Милосердный"]],[10,108,["قُلۡ","يَٰٓأَيُّهَا","ٱلنَّاسُ","قَدۡ","جَآءَكُمُ","ٱلۡحَقُّ","مِن","رَّبِّكُمۡۖ","فَمَنِ","ٱهۡتَدَىٰ","فَإِنَّمَا","يَهۡتَدِي","لِنَفۡسِهِۦۖ","وَمَن","ضَلَّ","فَإِنَّمَا","يَضِلُّ","عَلَيۡهَاۖ","وَمَآ","أَنَا۠","عَلَيۡكُم","بِوَكِيلٖ"],"ḳул йа'аййухан насу ḳад жаакумул хаḳḳу мир раббикум фаманихтада фа'иннама йахтадии линафсихии ваман далла фа'иннама йадиллу `алайха вама ана `алайкум бивакиил","Скажи: «О люди! К вам явилась истина от вашего Господа. Кто следует прямым путем, тот поступает во благо себе, а кто впадает в заблуждение, тот поступает во вред себе. Я не являюсь вашим попечителем и хранителем».",["Скажи","о","люди","уже","пришла к вам","истина","от","Господа вашего","и кто","последовал прямым путём","то лишь","следует прямым путём","для своей души","а кто","заблудился","то лишь","заблуждается","во вред ей","и не","я","над вами","попечитель"]],[10,109,["وَٱتَّبِعۡ","مَا","يُوحَىٰٓ","إِلَيۡكَ","وَٱصۡبِرۡ","حَتَّىٰ","يَحۡكُمَ","ٱللَّهُۚ","وَهُوَ","خَيۡرُ","ٱلۡحَٰكِمِينَ"],"ваттаби` ма йууха илайка васбир хатта йахкумаллаху вахуа хайрул хакимиин","Следуй тому, что внушается тебе в откровении, и терпи, пока Аллах не вынесет приговор, ведь Он - Наилучший из судей.",["И следуй","тому, что","внушается","тебе","и терпи","пока не","рассудит","Аллах","и Он","Лучший","из судей"]],[11,1,["الٓرۚ","كِتَٰبٌ","أُحۡكِمَتۡ","ءَايَٰتُهُۥ","ثُمَّ","فُصِّلَتۡ","مِن","لَّدُنۡ","حَكِيمٍ","خَبِيرٍ"],"лр китабун ухкимат айатухуу сумма фуссилат мил ладун хакиимин хабиир","Алиф. Лам. Ра. Это - Писание, аяты которого ясно изложены, а затем разъяснены Мудрым, Ведающим.",["Алиф Лам Ра","Писание","ясно изложены","аяты его","затем","разъяснены","от","(Того, Кто) у","Мудрого","Ведающего"]],[11,2,["أَلَّا","تَعۡبُدُوٓاْ","إِلَّا","ٱللَّهَۚ","إِنَّنِي","لَكُم","مِّنۡهُ","نَذِيرٞ","وَبَشِيرٞ"],"алла та`будуу иллаллаха иннании лакум минху назиирун вабашиир","Не поклоняйтесь никому, кроме Аллаха. Воистину, я для вас - предостерегающий увещеватель и добрый вестник от Него.",["чтобы не","поклонялись вы","кроме","Аллаха","поистине, я","вам","от Него","предостерегающий","и благовеститель"]],[11,3,["وَأَنِ","ٱسۡتَغۡفِرُواْ","رَبَّكُمۡ","ثُمَّ","تُوبُوٓاْ","إِلَيۡهِ","يُمَتِّعۡكُم","مَّتَٰعًا","حَسَنًا","إِلَىٰٓ","أَجَلٖ","مُّسَمّٗى","وَيُؤۡتِ","كُلَّ","ذِي","فَضۡلٖ","فَضۡلَهُۥۖ","وَإِن","تَوَلَّوۡاْ","فَإِنِّيٓ","أَخَافُ","عَلَيۡكُمۡ","عَذَابَ","يَوۡمٖ","كَبِيرٍ"],"ва'анистагфируу раббакум сумма туубуу илайхи йуматти`кум мата`ан хасанан ила ажалим мусамман вайу'ти кулла зии фадлин фадлахуу ва'ин таваллау фа'иннии ахафу `алайкум `азаба йаумин кабиир","Просите прощения у вашего Господа и раскаивайтесь перед Ним, чтобы Он наделил вас прекрасными благами до определенного срока и одарил Своей милостью каждого милостивого. Если же вы отвернетесь, то я боюсь, что вас постигнут мучения в Великий день.",["и чтобы","просите прощения у","Господа вашего","затем","раскаивайтесь","перед Ним","Он наделит вас","благами","прекрасными","до","срока","назначенного","и дарует","каждому","обладателю","достоинства","Свою милость","а если","отвернётесь","то поистине, я","боюсь","за вас","наказания","дня","великого"]],[11,4,["إِلَى","ٱللَّهِ","مَرۡجِعُكُمۡۖ","وَهُوَ","عَلَىٰ","كُلِّ","شَيۡءٖ","قَدِيرٌ"],"илаллахи маржи`укум вахуа `ала кулли шай'ин ḳадиир","Вы вернетесь к Аллаху, а ведь Он способен на всякую вещь.",["к","Аллаху","ваше возвращение","и Он","на","всякую","вещь","способен"]],[11,5,["أَلَآ","إِنَّهُمۡ","يَثۡنُونَ","صُدُورَهُمۡ","لِيَسۡتَخۡفُواْ","مِنۡهُۚ","أَلَا","حِينَ","يَسۡتَغۡشُونَ","ثِيَابَهُمۡ","يَعۡلَمُ","مَا","يُسِرُّونَ","وَمَا","يُعۡلِنُونَۚ","إِنَّهُۥ","عَلِيمُۢ","بِذَاتِ","ٱلصُّدُورِ"],"ала иннахум йаснууна судуурахум лийастахфуу минху ала хиина йастагшууна сийабахум йа`ламу ма йусиррууна вама йу`линууна иннахуу `алииму бизатис судуур","Воистину, они сворачивают свои сердца (отворачиваются от Аллаха или скрывают в своих сердцах неверие), чтобы спрятаться от Него. Воистину, даже когда они закутываются в одежду, Он знает то, что они утаивают и обнародуют. Он ведает о том, что в груди.",["О да!","поистине, они","сворачивают","груди свои","чтобы скрыться","от Него","О да!","когда","покрываются","одеждами своими","Он знает","то, что","они скрывают","и что","они обнаруживают","поистине, Он","Знающий","о том, что в","груди"]]],"m":[[["وَإِن","И если",10,107],["يَمۡسَسۡكَ","коснётся тебя",10,107],["ٱللَّهُ","Аллах",10,107],["بِضُرّٖ","вредом",10,107],["فَلَا","то нет",10,107],["كَاشِفَ","избавителя",10,107],["لَهُۥٓ","от него",10,107],["إِلَّا","кроме",10,107],["هُوَۖ","Него",10,107],["وَإِن","и если",10,107]],[["يُرِدۡكَ","пожелает Он тебе",10,107],["بِخَيۡرٖ","добра",10,107],["فَلَا","то нет",10,107],["رَآدَّ","отвращающего",10,107],["لِفَضۡلِهِۦۚ","Его милость",10,107],["يُصِيبُ","постигает Он",10,107],["بِهِۦ","ею",10,107],["مَن","кого",10,107],["يَشَآءُ","пожелает Он",10,107],["مِنۡ","из",10,107],["عِبَادِهِۦۚ","Своих рабов",10,107]],[["وَهُوَ","и Он",10,107],["ٱلۡغَفُورُ","Прощающий",10,107],["ٱلرَّحِيمُ","Милосердный",10,107],[107],["قُلۡ","Скажи",10,108],["يَٰٓأَيُّهَا","о",10,108],["ٱلنَّاسُ","люди",10,108],["قَدۡ","уже",10,108],["جَآءَكُمُ","пришла к вам",10,108]],[["ٱلۡحَقُّ","истина",10,108],["مِن","от",10,108],["رَّبِّكُمۡۖ","Господа вашего",10,108],["فَمَنِ","и кто",10,108],["ٱهۡتَدَىٰ","последовал прямым путём",10,108],["فَإِنَّمَا","то лишь",10,108],["يَهۡتَدِي","следует прямым путём",10,108],["لِنَفۡسِهِۦۖ","для своей души",10,108],["وَمَن","а кто",10,108]],[["ضَلَّ","заблудился",10,108],["فَإِنَّمَا","то лишь",10,108],["يَضِلُّ","заблуждается",10,108],["عَلَيۡهَاۖ","во вред ей",10,108],["وَمَآ","и не",10,108],["أَنَا۠","я",10,108],["عَلَيۡكُم","над вами",10,108],["بِوَكِيلٖ","попечитель",10,108],[108],["وَٱتَّبِعۡ","И следуй",10,109]],[["مَا","тому, что",10,109],["يُوحَىٰٓ","внушается",10,109],["إِلَيۡكَ","тебе",10,109],["وَٱصۡبِرۡ","и терпи",10,109],["حَتَّىٰ","пока не",10,109],["يَحۡكُمَ","рассудит",10,109],["ٱللَّهُۚ","Аллах",10,109],["وَهُوَ","и Он",10,109],["خَيۡرُ","Лучший",10,109],["ٱلۡحَٰكِمِينَ","из судей",10,109],[109]],["h",11],["b"],[["الٓرۚ","Алиф Лам Ра",11,1],["كِتَٰبٌ","Писание",11,1],["أُحۡكِمَتۡ","ясно изложены",11,1],["ءَايَٰتُهُۥ","аяты его",11,1],["ثُمَّ","затем",11,1],["فُصِّلَتۡ","разъяснены",11,1],["مِن","от",11,1],["لَّدُنۡ","(Того, Кто) у",11,1],["حَكِيمٍ","Мудрого",11,1],["خَبِيرٍ","Ведающего",11,1],[1]],[["أَلَّا","чтобы не",11,2],["تَعۡبُدُوٓاْ","поклонялись вы",11,2],["إِلَّا","кроме",11,2],["ٱللَّهَۚ","Аллаха",11,2],["إِنَّنِي","поистине, я",11,2],["لَكُم","вам",11,2],["مِّنۡهُ","от Него",11,2],["نَذِيرٞ","предостерегающий",11,2],["وَبَشِيرٞ","и благовеститель",11,2],[2],["وَأَنِ","и чтобы",11,3],["ٱسۡتَغۡفِرُواْ","просите прощения у",11,3]],[["رَبَّكُمۡ","Господа вашего",11,3],["ثُمَّ","затем",11,3],["تُوبُوٓاْ","раскаивайтесь",11,3],["إِلَيۡهِ","перед Ним",11,3],["يُمَتِّعۡكُم","Он наделит вас",11,3],["مَّتَٰعًا","благами",11,3],["حَسَنًا","прекрасными",11,3],["إِلَىٰٓ","до",11,3],["أَجَلٖ","срока",11,3],["مُّسَمّٗى","назначенного",11,3],["وَيُؤۡتِ","и дарует",11,3]],[["كُلَّ","каждому",11,3],["ذِي","обладателю",11,3],["فَضۡلٖ","достоинства",11,3],["فَضۡلَهُۥۖ","Свою милость",11,3],["وَإِن","а если",11,3],["تَوَلَّوۡاْ","отвернётесь",11,3],["فَإِنِّيٓ","то поистине, я",11,3],["أَخَافُ","боюсь",11,3],["عَلَيۡكُمۡ","за вас",11,3],["عَذَابَ","наказания",11,3],["يَوۡمٖ","дня",11,3]],[["كَبِيرٍ","великого",11,3],[3],["إِلَى","к",11,4],["ٱللَّهِ","Аллаху",11,4],["مَرۡجِعُكُمۡۖ","ваше возвращение",11,4],["وَهُوَ","и Он",11,4],["عَلَىٰ","на",11,4],["كُلِّ","всякую",11,4],["شَيۡءٖ","вещь",11,4],["قَدِيرٌ","способен",11,4],[4],["أَلَآ","О да!",11,5],["إِنَّهُمۡ","поистине, они",11,5]],[["يَثۡنُونَ","сворачивают",11,5],["صُدُورَهُمۡ","груди свои",11,5],["لِيَسۡتَخۡفُواْ","чтобы скрыться",11,5],["مِنۡهُۚ","от Него",11,5],["أَلَا","О да!",11,5],["حِينَ","когда",11,5],["يَسۡتَغۡشُونَ","покрываются",11,5],["ثِيَابَهُمۡ","одеждами своими",11,5]],[["يَعۡلَمُ","Он знает",11,5],["مَا","то, что",11,5],["يُسِرُّونَ","они скрывают",11,5],["وَمَا","и что",11,5],["يُعۡلِنُونَۚ","они обнаруживают",11,5],["إِنَّهُۥ","поистине, Он",11,5],["عَلِيمُۢ","Знающий",11,5],["بِذَاتِ","о том, что в",11,5],["ٱلصُّدُورِ","груди",11,5],[5]]]}