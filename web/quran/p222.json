{"p":222,"j":12,"a":[[11,6,["وَمَا","مِن","دَآبَّةٖ","فِي","ٱلۡأَرۡضِ","إِلَّا","عَلَى","ٱللَّهِ","رِزۡقُهَا","وَيَعۡلَمُ","مُسۡتَقَرَّهَا","وَمُسۡتَوۡدَعَهَاۚ","كُلّٞ","فِي","كِتَٰبٖ","مُّبِينٖ"],"вама мин даббатин фил арди илла `алаллахи ризḳуха вайа`ламу мустаḳарраха вамустауда`аха куллун фии китабим мубиин","Нет на земле ни единого живого существа, которого Аллах не обеспечивал бы пропитанием. Аллах знает их место пребывания и место хранения (утробы матерей или могилы). Все это записано в ясном Писании.",["и нет","никакого","живого существа","на","земле","кроме как","на","Аллахе","пропитание его","и Он знает","место пребывания его","и место хранения его","всё","в","Писании","ясном"]],[11,7,["وَهُوَ","ٱلَّذِي","خَلَقَ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضَ","فِي","سِتَّةِ","أَيَّامٖ","وَكَانَ","عَرۡشُهُۥ","عَلَى","ٱلۡمَآءِ","لِيَبۡلُوَكُمۡ","أَيُّكُمۡ","أَحۡسَنُ","عَمَلٗاۗ","وَلَئِن","قُلۡتَ","إِنَّكُم","مَّبۡعُوثُونَ","مِنۢ","بَعۡدِ","ٱلۡمَوۡتِ","لَيَقُولَنَّ","ٱلَّذِينَ","كَفَرُوٓاْ","إِنۡ","هَٰذَآ","إِلَّا","سِحۡرٞ","مُّبِينٞ"],"вахуал лазии халаḳас самавати вал'арда фии ситтати аййамин вакана `аршухуу `алал маи лийаблуакум аййукум ахсану `амалан валаин ḳулта иннакум маб`уусууна мим ба`дил маути лайаḳууланнал лазиина кафаруу ин хаза илла сихрум мубиин","Он - Тот, Кто создал небеса и землю за шесть дней, когда Его Трон находился на воде, дабы испытать, чьи деяния будут лучше. Если ты скажешь: «Вы будете воскрешены после смерти», - то неверующие скажут: «Это - не что иное, как очевидное колдовство!».",["и Он","Тот, Который","создал","небеса","и землю","за","шесть","дней","и был","Трон Его","на","воде","чтобы испытать вас","кто из вас","лучше","делами","и если","скажешь ты","поистине, вы","воскрешены будете","после","(наступления)","смерти","непременно скажут","те, которые","не уверовали","не","это","кроме","колдовство","явное"]],[11,8,["وَلَئِنۡ","أَخَّرۡنَا","عَنۡهُمُ","ٱلۡعَذَابَ","إِلَىٰٓ","أُمَّةٖ","مَّعۡدُودَةٖ","لَّيَقُولُنَّ","مَا","يَحۡبِسُهُۥٓۗ","أَلَا","يَوۡمَ","يَأۡتِيهِمۡ","لَيۡسَ","مَصۡرُوفًا","عَنۡهُمۡ","وَحَاقَ","بِهِم","مَّا","كَانُواْ","بِهِۦ","يَسۡتَهۡزِءُونَ"],"валаин аххарна `анхумул `азаба ила умматим ма`дуудатил лайаḳуулунна ма йахбисухуу ала йаума йа'тиихим лайса масрууфан `анхум вахаḳа бихим ма кануу бихии йастахзиуун","Если Мы отложим наказание их до определенного срока, то они скажут: «Что же удерживает его?». Воистину, в тот день, когда оно постигнет их, ничто не отвратит его, и окружит (или поразит) их то, над чем они насмехались.",["и если","отсрочим Мы","от них","наказание","до","срока","исчисленного","непременно скажут они","что","удерживает его","О да!","в день, когда","придёт оно к ним","не будет","отвращено","от них","и окружит","их","то, что","они","над ним","насмехались"]],[11,9,["وَلَئِنۡ","أَذَقۡنَا","ٱلۡإِنسَٰنَ","مِنَّا","رَحۡمَةٗ","ثُمَّ","نَزَعۡنَٰهَا","مِنۡهُ","إِنَّهُۥ","لَيَـُٔوسٞ","كَفُورٞ"],"валаин азаḳнал инсана минна рахматан сумма наза`наха минху иннахуу лайауусун кафуур","Если Мы дадим человеку вкусить милость, а потом отберем это, то он отчаивается и становится неблагодарным.",["и если","дадим Мы вкусить","человеку","от Нас","милость","затем","отнимем её","у него","поистине, он","отчаивающийся","неблагодарный"]],[11,10,["وَلَئِنۡ","أَذَقۡنَٰهُ","نَعۡمَآءَ","بَعۡدَ","ضَرَّآءَ","مَسَّتۡهُ","لَيَقُولَنَّ","ذَهَبَ","ٱلسَّيِّـَٔاتُ","عَنِّيٓۚ","إِنَّهُۥ","لَفَرِحٞ","فَخُورٌ"],"валаин азаḳнаху на`маа ба`да дарраа массатху лайаḳууланна захабас саййиату `аннии иннахуу лафарихун фахуур","Если же Мы дадим ему вкусить милость после постигшей его беды, то он говорит: «Напасти оставили меня в покое». Он начинает ликовать и бахвалиться.",["и если","дадим Мы вкусить ему","благо","после","беды","коснувшейся его","непременно скажет он","ушли","беды","от меня","поистине, он","ликующий","хвастливый"]],[11,11,["إِلَّا","ٱلَّذِينَ","صَبَرُواْ","وَعَمِلُواْ","ٱلصَّٰلِحَٰتِ","أُوْلَٰٓئِكَ","لَهُم","مَّغۡفِرَةٞ","وَأَجۡرٞ","كَبِيرٞ"],"иллал лазиина сабаруу ва`амилус салихати улаика лахум магфиратун ва'ажрун кабиир","И только тем, которые терпели и совершали праведные деяния, уготованы прощение и великая награда.",["кроме","тех, которые","терпели","и совершали","праведные деяния","те","им","прощение","и награда","великая"]],[11,12,["فَلَعَلَّكَ","تَارِكُۢ","بَعۡضَ","مَا","يُوحَىٰٓ","إِلَيۡكَ","وَضَآئِقُۢ","بِهِۦ","صَدۡرُكَ","أَن","يَقُولُواْ","لَوۡلَآ","أُنزِلَ","عَلَيۡهِ","كَنزٌ","أَوۡ","جَآءَ","مَعَهُۥ","مَلَكٌۚ","إِنَّمَآ","أَنتَ","نَذِيرٞۚ","وَٱللَّهُ","عَلَىٰ","كُلِّ","شَيۡءٖ","وَكِيلٌ"],"фала`аллака тарику ба`да ма йууха илайка вадаиḳу бихии садрука ан йаḳуулуу лаула унзила `алайхи канзун ау жаа ма`ахуу малакун иннама анта назиирун валлаху `ала кулли шай'ин вакиил","Быть может, ты отбросишь часть ниспосланного тебе в откровении, и твое сердце сожмется от этого, потому что они говорят: «Почему ему не ниспосланы сокровища или ангел не явился вместе с ним?». Но ведь ты - всего лишь предостерегающий увещеватель, а Аллах - Попечитель и Хранитель всякой вещи.",["и, быть может, ты","оставляешь","часть","того, что","внушается","тебе","и стеснена","этим","грудь твоя","оттого что","говорят они","почему не","ниспослан","ему","клад","или","не пришёл","с ним","ангел","лишь","ты","предостерегающий","а Аллах","над","всякой","вещью","Попечитель"]]],"m":[[["۞ وَمَا","и нет",11,6],["مِن","никакого",11,6],["دَآبَّةٖ","живого существа",11,6],["فِي","на",11,6],["ٱلۡأَرۡضِ","земле",11,6],["إِلَّا","кроме как",11,6],["عَلَى","на",11,6],["ٱللَّهِ","Аллахе",11,6],["رِزۡقُهَا","пропитание его",11,6],["وَيَعۡلَمُ","и Он знает",11,6],["مُسۡتَقَرَّهَا","место пребывания его",11,6]],[["وَمُسۡتَوۡدَعَهَاۚ","и место хранения его",11,6],["كُلّٞ","всё",11,6],["فِي","в",11,6],["كِتَٰبٖ","Писании",11,6],["مُّبِينٖ","ясном",11,6],[6],["وَهُوَ","и Он",11,7],["ٱلَّذِي","Тот, Который",11,7],["خَلَقَ","создал",11,7]],[["ٱلسَّمَٰوَٰتِ","небеса",11,7],["وَٱلۡأَرۡضَ","и землю",11,7],["فِي","за",11,7],["سِتَّةِ","шесть",11,7],["أَيَّامٖ","дней",11,7],["وَكَانَ","и был",11,7],["عَرۡشُهُۥ","Трон 