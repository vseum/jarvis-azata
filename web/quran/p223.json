{"p":223,"j":12,"a":[[11,13,["أَمۡ","يَقُولُونَ","ٱفۡتَرَىٰهُۖ","قُلۡ","فَأۡتُواْ","بِعَشۡرِ","سُوَرٖ","مِّثۡلِهِۦ","مُفۡتَرَيَٰتٖ","وَٱدۡعُواْ","مَنِ","ٱسۡتَطَعۡتُم","مِّن","دُونِ","ٱللَّهِ","إِن","كُنتُمۡ","صَٰدِقِينَ"],"ам йаḳуулуунафтараху ḳул фа'туу би`ашри суарим мислихии муфтарайатин вад`уу манистата`тум ммин дууниллахи ин кунтум садиḳиин","Или же они говорят: «Он измыслил Коран». Скажи: «Принесите десять вымышленных сур, подобных этим, и призовите, кого сумеете, помимо Аллаха, если вы говорите правду».",["или","говорят они","измыслил он его","скажи","так принесите","десять","сур","подобных ему","измышленных","и призовите","кого","сможете","(кроме)","помимо","Аллаха","если","вы","правдивы"]],[11,14,["فَإِلَّمۡ","يَسۡتَجِيبُواْ","لَكُمۡ","فَٱعۡلَمُوٓاْ","أَنَّمَآ","أُنزِلَ","بِعِلۡمِ","ٱللَّهِ","وَأَن","لَّآ","إِلَٰهَ","إِلَّا","هُوَۖ","فَهَلۡ","أَنتُم","مُّسۡلِمُونَ"],"фа'иллам йастажиибуу лакум фа`ламуу аннама унзила би`илмиллахи ва'ал ла илаха илла хуа фахал антум муслимуун","Если они не ответят вам, то знайте, что он ниспослан с ведома Аллаха и что нет божества, кроме Него. Неужели вы не станете мусульманами?",["а если не","ответят они","вам","то знайте","что","ниспослан он","со знанием","Аллаха","и что","нет","божества","кроме","Него","так разве","вы","покорные (мусульмане)"]],[11,15,["مَن","كَانَ","يُرِيدُ","ٱلۡحَيَوٰةَ","ٱلدُّنۡيَا","وَزِينَتَهَا","نُوَفِّ","إِلَيۡهِمۡ","أَعۡمَٰلَهُمۡ","فِيهَا","وَهُمۡ","فِيهَا","لَا","يُبۡخَسُونَ"],"ман кана йуриидул хайаватад дунйа вазиинатаха нуаффи илайхим а`малахум фииха вахум фииха ла йубхасуун","Тем, кто желает жизни в этом мире и ее украшений, Мы сполна воздадим за их поступки в этом мире, и они не будут обделены.",["кто","являлся","желает","жизни","ближней","и украшений её","сполна воздадим Мы","им","за деяния их","в ней","и они","в ней","не","будут обделены"]],[11,16,["أُوْلَٰٓئِكَ","ٱلَّذِينَ","لَيۡسَ","لَهُمۡ","فِي","ٱلۡأٓخِرَةِ","إِلَّا","ٱلنَّارُۖ","وَحَبِطَ","مَا","صَنَعُواْ","فِيهَا","وَبَٰطِلٞ","مَّا","كَانُواْ","يَعۡمَلُونَ"],"улаикал лазиина лайса лахум фил ахирати иллан нару вахабита ма сана`уу фииха вабатилум ма кануу йа`малуун","Они - те, которые в Последней жизни не получат ничего, кроме Огня. Тщетны их усилия в этом мире, и бесполезны их деяния.",["те","те, которым","нет","им","в","Последней жизни","кроме","Огня","и пропало","то, что","сотворили они","в ней","и тщетно","то, что","были они","делали"]],[11,17,["أَفَمَن","كَانَ","عَلَىٰ","بَيِّنَةٖ","مِّن","رَّبِّهِۦ","وَيَتۡلُوهُ","شَاهِدٞ","مِّنۡهُ","وَمِن","قَبۡلِهِۦ","كِتَٰبُ","مُوسَىٰٓ","إِمَامٗا","وَرَحۡمَةًۚ","أُوْلَٰٓئِكَ","يُؤۡمِنُونَ","بِهِۦۚ","وَمَن","يَكۡفُرۡ","بِهِۦ","مِنَ","ٱلۡأَحۡزَابِ","فَٱلنَّارُ","مَوۡعِدُهُۥۚ","فَلَا","تَكُ","فِي","مِرۡيَةٖ","مِّنۡهُۚ","إِنَّهُ","ٱلۡحَقُّ","مِن","رَّبِّكَ","وَلَٰكِنَّ","أَكۡثَرَ","ٱلنَّاسِ","لَا","يُؤۡمِنُونَ"],"афаман кана `ала баййинатим мир раббихии вайатлууху шахидум минху вамин ḳаблихии китабу мууса имаман варахматан улаика йу'минууна бихии ваман йакфур бихии минал ахзаби фаннару мау`идухуу фала таку фии мирйатим минху иннахул хаḳḳу мир раббика валакинна аксаран наси ла йу'минуун","Разве тот, кто опирается на ясное доказательство от своего Господа, за которым следует свидетель от Него (Джибрил) и до которого руководством и милостью было Писание Мусы (Моисея), подобен неверующему? Они уверовали в него (Коран). А сектам, которые не уверовали в него, обещан Огонь. Не сомневайся в этом, ибо это - истина от твоего Господа, хотя большая часть людей не верует.",["разве тот, кто","пребывает","на","ясном доказательстве","от","Господа своего","и следует за ним","свидетель","от Него","и до","него","Писание","Мусы","руководством","и милостью","те","веруют","в него","а кто","не уверует","в него","из","партий","то Огонь","место обещанное ему","так не","будь","в","сомнении","о нём","поистине, это","истина","от","Господа твоего","но","большинство","людей","не","веруют"]],[11,18,["وَمَنۡ","أَظۡلَمُ","مِمَّنِ","ٱفۡتَرَىٰ","عَلَى","ٱللَّهِ","كَذِبًاۚ","أُوْلَٰٓئِكَ","يُعۡرَضُونَ","عَلَىٰ","رَبِّهِمۡ","وَيَقُولُ","ٱلۡأَشۡهَٰدُ","هَٰٓؤُلَآءِ","ٱلَّذِينَ","كَذَبُواْ","عَلَىٰ","رَبِّهِمۡۚ","أَلَا","لَعۡنَةُ","ٱللَّهِ","عَلَى","ٱلظَّٰلِمِينَ"],"ваман азламу мимманифтара `алаллахи казибан улаика йу`радууна `ала раббихим вайаḳуулул ашхаду ха'улаил лазиина казабуу `ала раббихим ала ла`натуллахи `алаз залимиин","Кто может быть несправедливее того, кто возвел навет на Аллаха? Когда они предстанут перед Господом, свидетели скажут: «Это они оболгали своего Господа». Да будет проклятие Аллаха над беззаконниками,",["и кто","несправедливее","того, кто","измыслил","на","Аллаха","ложь","те","будут представлены","перед","Господом их","и скажут","свидетели","эти","те, которые","солгали","на","Господа своего","О да!","проклятие","Аллаха","на","несправедливых"]],[11,19,["ٱلَّذِينَ","يَصُدُّونَ","عَن","سَبِيلِ","ٱللَّهِ","وَيَبۡغُونَهَا","عِوَجٗا","وَهُم","بِٱلۡأٓخِرَةِ","هُمۡ","كَٰفِرُونَ"],"аллазиина йасуддууна `ан сабиилиллахи вайабгуунаха `иважан вахум бил'ахирати хум кафируун","которые сбивают других с пути Аллаха, стремясь исказить его, и не веруют в Последнюю жизнь.",["те, которые","отвращают","от","пути","Аллаха","и ищут его","кривым","и они","в Последнюю жизнь","они","не веруют"]]],"m":[[["أَمۡ","или",11,13],["يَقُولُونَ","говорят они",11,13],["ٱفۡتَرَىٰهُۖ","измыслил он его",11,13],["قُلۡ","скажи",11,13],["فَأۡتُواْ","так принесите",11,13],["بِعَشۡرِ","десять",11,13],["سُوَرٖ","сур",11,13],["مِّثۡلِهِۦ","подобных ему",11,13],["مُفۡتَرَيَٰتٖ","измышленных",11,13]],[["وَٱدۡعُواْ","и призовите",11,13],["مَنِ","кого",11,13],["ٱسۡتَطَعۡتُم","сможете",11,13],["مِّن","(кроме)",11,13],["دُونِ","помимо",11,13],["ٱللَّهِ","Аллаха",11,13],["إِن","если",11,13],["كُنتُمۡ","вы",11,13],["صَٰدِقِينَ","правдивы",11,13],[13]],[["فَإِلَّمۡ","а если не",11,14],["يَسۡتَجِيبُواْ","ответят они",11,14],["لَكُمۡ","вам",11,14],["فَٱعۡلَمُوٓاْ","то знайте",11,14],["أَنَّمَآ","что",11,14],["أُنزِلَ","ниспослан он",11,14],["بِعِلۡمِ","со знанием",11,14],["ٱللَّهِ","Алл