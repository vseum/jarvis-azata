عَذَابَ","наказания",11,26],["يَوۡمٍ","дня",11,26],["أَلِيمٖ","мучительного",11,26]],[[26],["فَقَالَ","и сказала",11,27],["ٱلۡمَلَأُ","знать",11,27],["ٱلَّذِينَ","тех, которые",11,27],["كَفَرُواْ","не уверовали",11,27],["مِن","из",11,27],["قَوۡمِهِۦ","народа его",11,27],["مَا","не",11,27],["نَرَىٰكَ","видим мы тебя",11,27],["إِلَّا","кроме как",11,27],["بَشَرٗا","человеком",11,27]],[["مِّثۡلَنَا","подобным нам",11,27],["وَمَا","и не",11,27],["نَرَىٰكَ","видим мы тебя",11,27],["ٱتَّبَعَكَ","(чтобы) последовали за тобой",11,27],["إِلَّا","кроме",11,27],["ٱلَّذِينَ","тех, которые",11,27],["هُمۡ","они",11,27],["أَرَاذِلُنَا","низшие из нас",11,27],["بَادِيَ","необдуманно",11,27]],[["ٱلرَّأۡيِ","по мнению",11,27],["وَمَا","и не",11,27],["نَرَىٰ","видим мы",11,27],["لَكُمۡ","у вас",11,27],["عَلَيۡنَا","над нами",11,27],["مِن","никакого",11,27],["فَضۡلِۭ","превосходства",11,27],["بَلۡ","напротив",11,27],["نَظُنُّكُمۡ","считаем мы вас",11,27],["كَٰذِبِينَ","лжецами",11,27]],[[27],["قَالَ","сказал он",11,28],["يَٰقَوۡمِ","о народ мой",11,28],["أَرَءَيۡتُمۡ","видели ли вы",11,28],["إِن","если",11,28],["كُنتُ","я",11,28],["عَلَىٰ","на",11,28],["بَيِّنَةٖ","ясном доказательстве",11,28],["مِّن","от",11,28],["رَّبِّي","Господа моего",11,28],["وَءَاتَىٰنِي","и даровал Он мне",11,28],["رَحۡمَةٗ","милость",11,28]],[["مِّنۡ","от",11,28],["عِندِهِۦ","Себя",11,28],["فَعُمِّيَتۡ","и скрыта она",11,28],["عَلَيۡكُمۡ","от вас",11,28],["أَنُلۡزِمُكُمُوهَا","разве принуждаем мы вас к ней",11,28],["وَأَنتُمۡ","а вы",11,28],["لَهَا","к ней",11,28],["كَٰرِهُونَ","питаете отвращение",11,28],[28]]]}