{"p":224,"j":12,"a":[[11,20,["أُوْلَٰٓئِكَ","لَمۡ","يَكُونُواْ","مُعۡجِزِينَ","فِي","ٱلۡأَرۡضِ","وَمَا","كَانَ","لَهُم","مِّن","دُونِ","ٱللَّهِ","مِنۡ","أَوۡلِيَآءَۘ","يُضَٰعَفُ","لَهُمُ","ٱلۡعَذَابُۚ","مَا","كَانُواْ","يَسۡتَطِيعُونَ","ٱلسَّمۡعَ","وَمَا","كَانُواْ","يُبۡصِرُونَ"],"улаика лам йакуунуу му`жизиина фил арди вама кана лахум мин дууниллахи мин аулийаа йуда`афу лахумул `азабу ма кануу йастатии`уунас сам`а вама кануу йубсируун","Они не смогут спастись на земле, и не будет у них покровителей и помощников вместо Аллаха. Их мучения будут приумножены, ведь они не могли слышать и не видели.",["те","не","были","способными ускользнуть","на","земле","и не","было","у них","(кроме)","помимо","Аллаха","никаких","покровителей","будет удвоено","им","наказание","не","были они","способны","слышать","и не","были они","видели"]],[11,21,["أُوْلَٰٓئِكَ","ٱلَّذِينَ","خَسِرُوٓاْ","أَنفُسَهُمۡ","وَضَلَّ","عَنۡهُم","مَّا","كَانُواْ","يَفۡتَرُونَ"],"улаикал лазиина хасируу анфусахум вадалла `анхум ма кануу йафтаруун","Они потеряют самих себя, и покинет их (или исчезнет) то, что они измышляли.",["те","те, которые","потеряли","самих себя","и исчезло","от них","то, что","они","измышляли"]],[11,22,["لَا","جَرَمَ","أَنَّهُمۡ","فِي","ٱلۡأٓخِرَةِ","هُمُ","ٱلۡأَخۡسَرُونَ"],"ла жарама аннахум фил ахирати хумул ахсаруун","Нет сомнения в том, что в Последней жизни они понесут самый большой урон.",["нет","сомнения","что они","в","Последней жизни","они","самые потерпевшие убыток"]],[11,23,["إِنَّ","ٱلَّذِينَ","ءَامَنُواْ","وَعَمِلُواْ","ٱلصَّٰلِحَٰتِ","وَأَخۡبَتُوٓاْ","إِلَىٰ","رَبِّهِمۡ","أُوْلَٰٓئِكَ","أَصۡحَٰبُ","ٱلۡجَنَّةِۖ","هُمۡ","فِيهَا","خَٰلِدُونَ"],"иннал лазиина амануу ва`амилус салихати ва'ахбатуу ила раббихим улаика асхабул жаннати хум фииха халидуун","Воистину, те, которые уверовали, совершали праведные деяния и были смиренны пред своим Господом, будут обитателями Рая и пребудут там вечно.",["поистине","те, которые","уверовали","и совершали","праведные деяния","и смирились","перед","Господом своим","те","обитатели","Рая","они","в нём","вечно пребывают"]],[11,24,["مَثَلُ","ٱلۡفَرِيقَيۡنِ","كَٱلۡأَعۡمَىٰ","وَٱلۡأَصَمِّ","وَٱلۡبَصِيرِ","وَٱلسَّمِيعِۚ","هَلۡ","يَسۡتَوِيَانِ","مَثَلًاۚ","أَفَلَا","تَذَكَّرُونَ"],"масалул фарииḳайни кал'а`ма вал'асамми валбасиири вассамии`и хал йаставийани масалан афала тазаккаруун","Эти две группы подобны слепому и глухому и зрячему и слышащему. Разве можно их сравнить друг с другом? Неужели вы не помяните назидание?",["пример","двух групп","как слепой","и глухой","и зрячий","и слышащий","разве","равны они","по примеру","разве же не","помянете вы"]],[11,25,["وَلَقَدۡ","أَرۡسَلۡنَا","نُوحًا","إِلَىٰ","قَوۡمِهِۦٓ","إِنِّي","لَكُمۡ","نَذِيرٞ","مُّبِينٌ"],"валаḳад арсална нуухан ила ḳаумихии иннии лакум назиирум мубиин","Мы отправили Нуха (Ноя) к его народу: «Воистину, я для вас - разъясняющий и предостерегающий увещеватель.",["и действительно","отправили Мы","Нуха","к","народу его","поистине, я","вам","предостерегающий","ясный"]],[11,26,["أَن","لَّا","تَعۡبُدُوٓاْ","إِلَّا","ٱللَّهَۖ","إِنِّيٓ","أَخَافُ","عَلَيۡكُمۡ","عَذَابَ","يَوۡمٍ","أَلِيمٖ"],"ал ла та`будуу иллаллаха иннии ахафу `алайкум `азаба йаумин алиим","Не поклоняйтесь никому, кроме Аллаха, ибо я боюсь, что вас подвергнут страданиям в Мучительный день».",["чтобы","не","поклонялись вы","кроме","Аллаха","поистине, я","боюсь","за вас","наказания","дня","мучительного"]],[11,27,["فَقَالَ","ٱلۡمَلَأُ","ٱلَّذِينَ","كَفَرُواْ","مِن","قَوۡمِهِۦ","مَا","نَرَىٰكَ","إِلَّا","بَشَرٗا","مِّثۡلَنَا","وَمَا","نَرَىٰكَ","ٱتَّبَعَكَ","إِلَّا","ٱلَّذِينَ","هُمۡ","أَرَاذِلُنَا","بَادِيَ","ٱلرَّأۡيِ","وَمَا","نَرَىٰ","لَكُمۡ","عَلَيۡنَا","مِن","فَضۡلِۭ","بَلۡ","نَظُنُّكُمۡ","كَٰذِبِينَ"],"фаḳалал малаул лазиина кафаруу мин ḳаумихии ма нарака илла башарам мислана вама наракаттаба`ака иллал лазиина хум аразилуна бадийар ра'йи вама нара лакум `алайна мин фадли бал назуннукум казибиин","Знатные люди его народа, которые не уверовали, сказали: «Мы видим, что ты - такой же человек, как и мы. Мы также видим, что за тобой пошли только самые ничтожные из нас, но даже они последовали за тобой, не поразмыслив. Мы не видим, чтобы вы чем-либо превосходили нас. Напротив, мы считаем вас лжецами».",["и сказала","знать","тех, которые","не уверовали","из","народа его","не","видим мы тебя","кроме как","человеком","подобным нам","и не","видим мы тебя","(чтобы) последовали за тобой","кроме","тех, которые","они","низшие из нас","необдуманно","по мнению","и не","видим мы","у вас","над нами","никакого","превосходства","напротив","считаем мы вас","лжецами"]],[11,28,["قَالَ","يَٰقَوۡمِ","أَرَءَيۡتُمۡ","إِن","كُنتُ","عَلَىٰ","بَيِّنَةٖ","مِّن","رَّبِّي","وَءَاتَىٰنِي","رَحۡمَةٗ","مِّنۡ","عِندِهِۦ","فَعُمِّيَتۡ","عَلَيۡكُمۡ","أَنُلۡزِمُكُمُوهَا","وَأَنتُمۡ","لَهَا","كَٰرِهُونَ"],"ḳала йаḳауми араайтум ин кунту `ала баййинатим мир раббии ва'атании рахматам мин `индихии фа`уммийат `алайкум анулзимукумууха ва'антум лаха карихуун","Он сказал: «О мой народ! А что, если я опираюсь на доказательство от моего Господа, и Он даровал мне милость от Себя (пророчество и послание), которая недоступна вашим взорам? Неужели вы полагаете, что тогда мы стали бы принуждать вас к ней (к этой милости), несмотря на то, что вам она ненавистна?",["сказал он","о народ мой","видели ли вы","если","я","на","ясном доказательстве","от","Господа моего","и даровал Он мне","милость","от","Себя","и скрыта она","от вас","разве принуждаем мы вас к ней","а вы","к ней","питаете отвращение"]]],"m":[[["أُوْلَٰٓئِكَ","те",11,20],["لَمۡ","не",11,20],["يَكُونُواْ","были",11,20],["مُعۡجِزِينَ","способными ускользнуть",11,20],["فِي","на",11,20],["ٱلۡأَرۡضِ","земле",11,20],["وَمَا","и не",11,20],["كَانَ","было",11,20],["لَهُم","у них",11,20],["مِّن","(кроме)",11,20]],[["دُونِ","помимо",11,20],["ٱللَّهِ","Аллаха",11,20],["مِنۡ","никаких",11,20],["أَوۡلِيَآءَۘ","покровителей",11,20],["يُضَٰعَفُ","будет удвоено",11,20],["لَهُمُ","им",11,20],["ٱلۡعَذَابُۚ","наказание",11,20],["مَا","не",11,20],["كَانُواْ","был