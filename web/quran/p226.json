{"p":226,"j":12,"a":[[11,38,["وَيَصۡنَعُ","ٱلۡفُلۡكَ","وَكُلَّمَا","مَرَّ","عَلَيۡهِ","مَلَأٞ","مِّن","قَوۡمِهِۦ","سَخِرُواْ","مِنۡهُۚ","قَالَ","إِن","تَسۡخَرُواْ","مِنَّا","فَإِنَّا","نَسۡخَرُ","مِنكُمۡ","كَمَا","تَسۡخَرُونَ"],"вайасна`ул фулка вакуллама марра `алайхи малаум мин ḳаумихии сахируу минху ḳала ин тасхаруу минна фа'инна насхару минкум кама тасхаруун","Он сооружал ковчег, и каждый раз, когда мимо него проходили знатные люди из его народа, они глумились над ним, а он говорил: «Если вы глумитесь над нами, то и мы будем глумиться над вами, подобно тому, как глумитесь вы.",["и сооружает он","ковчег","и всякий раз, как","проходила","мимо него","знать","из","народа его","насмехались они","над ним","сказал он","если","насмехаетесь вы","над нами","то поистине, мы","насмехаемся","над вами","как","насмехаетесь вы"]],[11,39,["فَسَوۡفَ","تَعۡلَمُونَ","مَن","يَأۡتِيهِ","عَذَابٞ","يُخۡزِيهِ","وَيَحِلُّ","عَلَيۡهِ","عَذَابٞ","مُّقِيمٌ"],"фасауфа та`ламууна ман йа'тиихи `азабун йухзиихи вайахиллу `алайхи `азабум муḳиим","Вы непременно узнаете, кого поразит унизительная кара, кого постигнут вечные мучения».",["и скоро","узнаете вы","к кому","придёт","наказание","позорящее его","и падёт","на него","наказание","вечное"]],[11,40,["حَتَّىٰٓ","إِذَا","جَآءَ","أَمۡرُنَا","وَفَارَ","ٱلتَّنُّورُ","قُلۡنَا","ٱحۡمِلۡ","فِيهَا","مِن","كُلّٖ","زَوۡجَيۡنِ","ٱثۡنَيۡنِ","وَأَهۡلَكَ","إِلَّا","مَن","سَبَقَ","عَلَيۡهِ","ٱلۡقَوۡلُ","وَمَنۡ","ءَامَنَۚ","وَمَآ","ءَامَنَ","مَعَهُۥٓ","إِلَّا","قَلِيلٞ"],"хатта иза жаа амруна вафарат таннууру ḳулнахмил фииха мин куллин заужайниснайни ва'ахлака илла ман сабаḳа `алайхил ḳаулу ваман амана вама амана ма`ахуу илла ḳалиил","А когда явилось Наше веление и разразилась потоком печь, Мы сказали: «Погрузи на него от каждого вида по паре и свою семью, за исключением тех, о которых уже было сказано Слово, а также тех, кто уверовал». Но уверовали вместе с ним лишь немногие.",["пока","когда","пришло","веление Наше","и забила","печь","сказали Мы","погрузи","в него","из","всех","по паре","двух","и семью твою","кроме","тех, о ком","предшествовало","о нём","слово","и тех, кто","уверовал","и не","уверовали","с ним","кроме","немногие"]],[11,41,["وَقَالَ","ٱرۡكَبُواْ","فِيهَا","بِسۡمِ","ٱللَّهِ","مَجۡر۪ىٰهَا","وَمُرۡسَىٰهَآۚ","إِنَّ","رَبِّي","لَغَفُورٞ","رَّحِيمٞ"],"ваḳаларкабуу фииха бисмиллахи мажраха вамурсаха инна раббии лагафуурур рахиим","Он сказал: «Садитесь на него! С именем Аллаха он будет плыть и останавливаться. Воистину, Господь мой - Прощающий, Милосердный».",["и сказал он","садитесь","в него","с именем","Аллаха","плавание его","и стоянка его","поистине","Господь мой","непременно Прощающий","Милосердный"]],[11,42,["وَهِيَ","تَجۡرِي","بِهِمۡ","فِي","مَوۡجٖ","كَٱلۡجِبَالِ","وَنَادَىٰ","نُوحٌ","ٱبۡنَهُۥ","وَكَانَ","فِي","مَعۡزِلٖ","يَٰبُنَيَّ","ٱرۡكَب","مَّعَنَا","وَلَا","تَكُن","مَّعَ","ٱلۡكَٰفِرِينَ"],"вахийа тажрии бихим фии маужин калжибали ванада нуухунибнахуу вакана фии ма`зилин йабунаййаркаб мма`ана вала такум ма`ал кафириин","Ковчег поплыл с ними по волнам, подобным горам, и Нух (Ной) воззвал к своему сыну, который одиноко стоял в стороне: «Сын мой! Садись с нами и не оставайся с неверующими».",["и он","плыл","с ними","среди","волн","подобных горам","и воззвал","Нух","к сыну своему","а был он","в","в стороне","о сынок мой","садись","с нами","и не","будь","с","неверующими"]],[11,43,["قَالَ","سَـَٔاوِيٓ","إِلَىٰ","جَبَلٖ","يَعۡصِمُنِي","مِنَ","ٱلۡمَآءِۚ","قَالَ","لَا","عَاصِمَ","ٱلۡيَوۡمَ","مِنۡ","أَمۡرِ","ٱللَّهِ","إِلَّا","مَن","رَّحِمَۚ","وَحَالَ","بَيۡنَهُمَا","ٱلۡمَوۡجُ","فَكَانَ","مِنَ","ٱلۡمُغۡرَقِينَ"],"ḳала са'авии ила жабалин йа`симунии минал маи ḳала ла `асимал йаума мин амриллахи илла мар рахима вахала байнахумал маужу факана минал муграḳиин","Он сказал: «Я укроюсь на горе, которая спасет меня от воды». Он сказал: «Сегодня никто не спасет от воли Аллаха, если только Он не смилостивится». Тут волна разлучила их, и он оказался в числе потопленных.",["сказал он","укроюсь я","на","горе","которая защитит меня","от","воды","сказал он","нет","защитника","сегодня","от","веления","Аллаха","кроме","тех, кого","помиловал Он","и встала","между ними","волна","и оказался он","из","потопленных"]],[11,44,["وَقِيلَ","يَٰٓأَرۡضُ","ٱبۡلَعِي","مَآءَكِ","وَيَٰسَمَآءُ","أَقۡلِعِي","وَغِيضَ","ٱلۡمَآءُ","وَقُضِيَ","ٱلۡأَمۡرُ","وَٱسۡتَوَتۡ","عَلَى","ٱلۡجُودِيِّۖ","وَقِيلَ","بُعۡدٗا","لِّلۡقَوۡمِ","ٱلظَّٰلِمِينَ"],"ваḳиила йа'ардубла`ии мааки вайасамау аḳли`ии вагиидал мау ваḳудийал амру вастават `алал жуудиййи ваḳиила бу`дал лилḳаумиз залимиин","И было сказано: «О земля, поглоти свою воду! О небо, перестань!». Вода спала, и свершилось веление. Ковчег пристал к аль-Джуди, и было сказано: «Да сгинут люди несправедливые!».",["и было сказано","о земля","поглоти","воду свою","и о небо","перестань","и спала","вода","и решено","дело","и встал он","на","аль-Джуди","и было сказано","прочь","людям","несправедливым"]],[11,45,["وَنَادَىٰ","نُوحٞ","رَّبَّهُۥ","فَقَالَ","رَبِّ","إِنَّ","ٱبۡنِي","مِنۡ","أَهۡلِي","وَإِنَّ","وَعۡدَكَ","ٱلۡحَقُّ","وَأَنتَ","أَحۡكَمُ","ٱلۡحَٰكِمِينَ"],"ванада нуухур раббахуу фаḳала рабби иннабнии мин ахлии ва'инна ва`дакал хаḳḳу ва'анта ахкамул хакимиин","Нух (Ной) воззвал к своему Господу: «Господи! Ведь сын мой - частица моей семьи. Твое обещание правдиво, и Ты - Наимудрейший из судей».",["и воззвал","Нух","к Господу своему","и сказал","Господи","поистине","сын мой","из","семьи моей","и поистине","обещание Твоё","истина","и Ты","Справедливейший","из судей"]]],"m":[[["وَيَصۡنَعُ","и сооружает он",11,38],["ٱلۡفُلۡكَ","ковчег",11,38],["وَكُلَّمَا","и всякий раз, как",11,38],["مَرَّ","проходила",11,38],["عَلَيۡهِ","мимо него",11,38],["مَلَأٞ","знать",11,38],["مِّن","из",11,38],["قَوۡمِهِۦ","народа его",11,38],["سَخِرُواْ","насмехались они",11,38]],[["مِنۡهُۚ","над ним",11,38],["قَالَ","сказал он",11,38],["إِن","если",11,38],["تَسۡخَرُواْ","насмехаетесь вы",11,38],["مِنَّا","над нами",11,38],["فَإِنَّا","то поистине, мы",11,38],["نَسۡخَرُ","насмехаемся",11,38],["مِنكُمۡ","над вами",11,38],["كَمَا","как",11,38],["تَسۡخَرُونَ","насмехаетесь вы",11,38],[38]],[["فَسَوۡفَ","и скоро",11,39],["تَعۡلَمُونَ","узнаете вы",11,39],["مَن","к кому",11,39],["يَأۡتِيهِ","придёт",11,39],["عَذَابٞ","наказание",11,39],["يُخۡزِيهِ","позорящее его",11,39],["وَيَحِلُّ","и падёт",11,39],["عَلَيۡهِ","на него",11,39],["عَذَابٞ","наказание",11,39]],[["مُّقِيمٌ","вечное",11,39],[39],["حَتَّىٰٓ","пока",11,40],["إِذَا","когда",11,40],["جَآءَ","пришло",11,40],["أَمۡرُنَا","веление Наше",11,40],["وَفَارَ","и забила",11,40],["ٱلتَّنُّورُ","печь",11,40],["قُلۡنَا","сказали Мы",11,40],["ٱحۡمِلۡ","погрузи",11,40],["فِيهَا","в него",11,40]],[["مِن","из",11,40],["كُلّٖ","всех",11,40],["زَوۡجَيۡنِ","по паре",11,40],["ٱثۡنَيۡنِ","двух",11,40],["وَأَهۡلَكَ","и семью твою",11,40],["إِلَّا","кроме",11,40],["مَن","тех, о ком",11,40],["سَبَقَ","предшествовало",11,40],["عَلَيۡهِ","о нём",11,40],["ٱلۡقَوۡلُ","слово",11,40]],[["وَمَنۡ","и тех, кто",11,40],["ءَامَنَۚ","уверовал",11,40],["وَمَآ","и не",11,40],["ءَامَنَ","уверовали",11,40],["مَعَهُۥٓ","с ним",11,40],["إِلَّا","кроме",11,40],["قَلِيلٞ","немногие",11,40],[40],["۞ وَقَالَ","и сказал он",11,41],["ٱرۡكَبُواْ","садитесь",11,41]],[["فِيهَا","в него",11,41],["بِسۡمِ","с именем",11,41],["ٱللَّهِ","Аллаха",11,41],["مَجۡر۪ىٰهَا","плавание его",11,41],["وَمُرۡسَىٰهَآۚ","и стоянка его",11,41],["إِنَّ","поистине",11,41],["رَبِّي","Господь мой",11,41],["لَغَفُورٞ","непременно Прощающий",11,41],["رَّحِيمٞ","Милосердный",11,41],[41],["وَهِيَ","и он",11,42]],[["تَجۡرِي","плыл",11,42],["بِهِمۡ","с ними",11,42],["فِي","среди",11,42],["مَوۡجٖ","волн",11,42],["كَٱلۡجِبَالِ","подобных горам",11,42],["وَنَادَىٰ","и воззвал",11,42],["نُوحٌ","Нух",11,42],["ٱبۡنَهُۥ","к сыну своему",11,42],["وَكَانَ","а был он",11,42]],[["فِي","в",11,42],["مَعۡزِلٖ","в стороне",11,42],["يَٰبُنَيَّ","о сынок мой",11,42],["ٱرۡكَب","садись",11,42],["مَّعَنَا","с нами",11,42],["وَلَا","и не",11,42],["تَكُن","будь",11,42],["مَّعَ","с",11,42],["ٱلۡكَٰفِرِينَ","неверующими",11,42],[42]],[["قَالَ","сказал он",11,43],["سَـَٔاوِيٓ","укроюсь я",11,43],["إِلَىٰ","на",11,43],["جَبَلٖ","горе",11,43],["يَعۡصِمُنِي","которая защитит меня",11,43],["مِنَ","от",11,43],["ٱلۡمَآءِۚ","воды",11,43],["قَالَ","сказал он",11,43],["لَا","нет",11,43],["عَاصِمَ","защитника",11,43]],[["ٱلۡيَوۡمَ","сегодня",11,43],["مِنۡ","от",11,43],["أَمۡرِ","веления",11,43],["ٱللَّهِ","Аллаха",11,43],["إِلَّا","кроме",11,43],["مَن","тех, кого",11,43],["رَّحِمَۚ","помиловал Он",11,43],["وَحَالَ","и встала",11,43],["بَيۡنَهُمَا","между ними",11,43],["ٱلۡمَوۡجُ","волна",11,43],["فَكَانَ","и оказался он",11,43]],[["مِنَ","из",11,43],["ٱلۡمُغۡرَقِينَ","потопленных",11,43],[43],["وَقِيلَ","и было сказано",11,44],["يَٰٓأَرۡضُ","о земля",11,44],["ٱبۡلَعِي","поглоти",11,44],["مَآءَكِ","воду свою",11,44],["وَيَٰسَمَآءُ","и о небо",11,44]],[["أَقۡلِعِي","перестань",11,44],["وَغِيضَ","и спала",11,44],["ٱلۡمَآءُ","вода",11,44],["وَقُضِيَ","и решено",11,44],["ٱلۡأَمۡرُ","дело",11,44],["وَٱسۡتَوَتۡ","и встал он",11,44],["عَلَى","на",11,44],["ٱلۡجُودِيِّۖ","аль-Джуди",11,44],["وَقِيلَ","и было сказано",11,44]],[["بُعۡدٗا","прочь",11,44],["لِّلۡقَوۡمِ","людям",11,44],["ٱلظَّٰلِمِينَ","несправедливым",11,44],[44],["وَنَادَىٰ","и воззвал",11,45],["نُوحٞ","Нух",11,45],["رَّبَّهُۥ","к Господу своему",11,45],["فَقَالَ","и сказал",11,45],["رَبِّ","Господи",11,45],["إِنَّ","поистине",11,45]],[["ٱبۡنِي","сын мой",11,45],["مِنۡ","из",11,45],["أَهۡلِي","семьи моей",11,45],["وَإِنَّ","и поистине",11,45],["وَعۡدَكَ","обещание Твоё",11,45],["ٱلۡحَقُّ","истина",11,45],["وَأَنتَ","и Ты",11,45],["أَحۡكَمُ","Справедливейший",11,45],["ٱلۡحَٰكِمِينَ","из судей",11,45],[45]]]}