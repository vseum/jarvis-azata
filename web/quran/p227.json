{"p":227,"j":12,"a":[[11,46,["قَالَ","يَٰنُوحُ","إِنَّهُۥ","لَيۡسَ","مِنۡ","أَهۡلِكَۖ","إِنَّهُۥ","عَمَلٌ","غَيۡرُ","صَٰلِحٖۖ","فَلَا","تَسۡـَٔلۡنِ","مَا","لَيۡسَ","لَكَ","بِهِۦ","عِلۡمٌۖ","إِنِّيٓ","أَعِظُكَ","أَن","تَكُونَ","مِنَ","ٱلۡجَٰهِلِينَ"],"ḳала йанууху иннахуу лайса мин ахлика иннахуу `амалун гайру салихин фала тас'ални ма лайса лака бихии `илмун иннии а`изука ан такууна минал жахилиин","Он сказал: «О Нух (Ной)! Он - не частица твоей семьи, и такой поступок не является праведным. Не проси Меня о том, чего не ведаешь. Воистину, Я призываю тебя не быть одним из невежд».",["сказал Он","о Нух","поистине, он","не","из","семьи твоей","поистине, это","деяние","не","праведное","так не","проси Меня","о том, чего","нет","у тебя","о нём","знания","поистине, Я","увещеваю тебя","чтобы не","стал ты","из","невежд"]],[11,47,["قَالَ","رَبِّ","إِنِّيٓ","أَعُوذُ","بِكَ","أَنۡ","أَسۡـَٔلَكَ","مَا","لَيۡسَ","لِي","بِهِۦ","عِلۡمٞۖ","وَإِلَّا","تَغۡفِرۡ","لِي","وَتَرۡحَمۡنِيٓ","أَكُن","مِّنَ","ٱلۡخَٰسِرِينَ"],"ḳала рабби иннии а`уузу бика ан ас'алака ма лайса лии бихии `илмун ва'илла тагфир лии ватархамнии акум минал хасириин","Он сказал: «Господи! Я прибегаю к Тебе, дабы не просить о том, чего не ведаю. И если Ты не простишь меня и не помилуешь, то я окажусь среди потерпевших убыток».",["сказал он","Господи","поистине, я","прибегаю","к Тебе","от того, чтобы","просить Тебя","о том, чего","нет","у меня","о нём","знания","и если не","простишь Ты","мне","и не помилуешь меня","буду я","из","потерпевших убыток"]],[11,48,["قِيلَ","يَٰنُوحُ","ٱهۡبِطۡ","بِسَلَٰمٖ","مِّنَّا","وَبَرَكَٰتٍ","عَلَيۡكَ","وَعَلَىٰٓ","أُمَمٖ","مِّمَّن","مَّعَكَۚ","وَأُمَمٞ","سَنُمَتِّعُهُمۡ","ثُمَّ","يَمَسُّهُم","مِّنَّا","عَذَابٌ","أَلِيمٞ"],"ḳиила йануухухбит бисаламим минна вабаракатин `алайка ва`ала умамим миммам ма`ака ва'умамун сануматти`ухум сумма йамассухум минна `азабун алиим","И было сказано: «О Нух (Ной)! Сходи на землю с миром от Нас, и да пребудет благословение над тобой и теми народами, которые с тобой! Но будут народы, которых Мы облагодетельствуем, после чего их постигнут мучительные страдания от Нас».",["было сказано","о Нух","сходи","с миром","от Нас","и благословениями","на тебя","и на","общины","из тех, кто","с тобой","и общины","Мы дадим им пользоваться","затем","коснётся их","от Нас","наказание","мучительное"]],[11,49,["تِلۡكَ","مِنۡ","أَنۢبَآءِ","ٱلۡغَيۡبِ","نُوحِيهَآ","إِلَيۡكَۖ","مَا","كُنتَ","تَعۡلَمُهَآ","أَنتَ","وَلَا","قَوۡمُكَ","مِن","قَبۡلِ","هَٰذَاۖ","فَٱصۡبِرۡۖ","إِنَّ","ٱلۡعَٰقِبَةَ","لِلۡمُتَّقِينَ"],"тилка мин амбаил гайби нуухииха илайка ма кунта та`ламуха анта вала ḳаумука мин ḳабли хаза фасбир иннал `аḳибата лилмуттаḳиин","Все это - повествования о сокровенном, которые Мы ниспосылаем тебе в откровении. Ни ты, ни твой народ не ведали о них прежде. Будь же терпелив, ибо добрый исход уготован богобоязненным.",["это","из","вестей","о сокровенном","Мы внушаем их","тебе","не","был ты","знающим их","ты","и не","народ твой","с","прежде","этого","так терпи же","поистине","исход","для богобоязненных"]],[11,50,["وَإِلَىٰ","عَادٍ","أَخَاهُمۡ","هُودٗاۚ","قَالَ","يَٰقَوۡمِ","ٱعۡبُدُواْ","ٱللَّهَ","مَا","لَكُم","مِّنۡ","إِلَٰهٍ","غَيۡرُهُۥٓۖ","إِنۡ","أَنتُمۡ","إِلَّا","مُفۡتَرُونَ"],"ва'ила `адин ахахум хуудан ḳала йаḳауми`будуллаха ма лакум мин илахин гайрухуу ин антум илла муфтаруун","Мы отправили к адитам их брата Худа. Он сказал: «О мой народ! Поклоняйтесь Аллаху, ибо нет у вас иного божества, кроме Него. Вы же измышляете ложь.",["и к","адитам","брата их","Худа","сказал он","о народ мой","поклоняйтесь","Аллаху","нет","у вас","никакого","божества","кроме Него","не","вы","кроме как","измышляющие"]],[11,51,["يَٰقَوۡمِ","لَآ","أَسۡـَٔلُكُمۡ","عَلَيۡهِ","أَجۡرًاۖ","إِنۡ","أَجۡرِيَ","إِلَّا","عَلَى","ٱلَّذِي","فَطَرَنِيٓۚ","أَفَلَا","تَعۡقِلُونَ"],"йаḳауми ла ас'алукум `алайхи ажран ин ажрийа илла `алал лазии фатарании афала та`ḳилуун","О мой народ! Я не прошу у вас за это награды, ибо вознаградит меня Тот, Кто создал меня. Неужели вы не разумеете?",["о народ мой","не","прошу я у вас","за это","награды","не","награда моя","кроме как","на","Том, Кто","сотворил меня","неужели не","разумеете вы"]],[11,52,["وَيَٰقَوۡمِ","ٱسۡتَغۡفِرُواْ","رَبَّكُمۡ","ثُمَّ","تُوبُوٓاْ","إِلَيۡهِ","يُرۡسِلِ","ٱلسَّمَآءَ","عَلَيۡكُم","مِّدۡرَارٗا","وَيَزِدۡكُمۡ","قُوَّةً","إِلَىٰ","قُوَّتِكُمۡ","وَلَا","تَتَوَلَّوۡاْ","مُجۡرِمِينَ"],"вайаḳаумистагфируу раббакум сумма туубуу илайхи йурсилис самаа `алайкум мидраран вайазидкум ḳувватан ила ḳувватикум вала татаваллау мужримиин","О мой народ! Просите прощения у вашего Господа, а затем покайтесь перед Ним. Он ниспошлет вам с неба обильный дождь и приумножит вашу силу. Посему не отворачивайтесь, будучи грешниками».",["и о народ мой","просите прощения","у Господа вашего","затем","кайтесь","Ему","Он пошлёт","небо (дождь)","на вас","обильным","и прибавит вам","силы","к","силе вашей","и не","отворачивайтесь","будучи грешниками"]],[11,53,["قَالُواْ","يَٰهُودُ","مَا","جِئۡتَنَا","بِبَيِّنَةٖ","وَمَا","نَحۡنُ","بِتَارِكِيٓ","ءَالِهَتِنَا","عَن","قَوۡلِكَ","وَمَا","نَحۡنُ","لَكَ","بِمُؤۡمِنِينَ"],"ḳалуу йахууду ма жи'тана бибаййинатин вама нахну битарикии алихатина `ан ḳаулика вама нахну лака биму'миниин","Они сказали: «О Худ! Ты не показал нам ясного знамения, и мы не станем отрекаться от наших богов ради твоих слов. Мы не уверуем в тебя.",["сказали они","о Худ","не","пришёл ты к нам","с ясным знамением","и не","мы","оставляющие","богов наших","по","слову твоему","и не","мы","тебе","верующие"]]],"m":[[["قَالَ","сказал Он",11,46],["يَٰنُوحُ","о Нух",11,46],["إِنَّهُۥ","поистине, он",11,46],["لَيۡسَ","не",11,46],["مِنۡ","из",11,46],["أَهۡلِكَۖ","семьи твоей",11,46],["إِنَّهُۥ","поистине, это",11,46],["عَمَلٌ","деяние",11,46],["غَيۡرُ","не",11,46],["صَٰلِحٖۖ","праведное",11,46],["فَلَا","так не",11,46],["تَسۡـَٔلۡنِ","проси Меня",11,46]],[["مَا","о том, чего",11,46],["لَيۡسَ","нет",11,46],["لَكَ","у тебя",11,46],["بِهِۦ","о нём",11,46],["عِلۡمٌۖ","знания",11,46],["إِنِّيٓ","поистине, Я",11,46],["أَعِظُكَ","увещеваю тебя",11,46],["أَن","чтобы не",11,46],["تَكُونَ","стал ты",11,46],["مِنَ","из",11,46],["ٱلۡجَٰهِلِينَ","невежд",11,46],[46]],[["قَالَ","сказал он",11,47],["رَبِّ","Господи",11,47],["إِنِّيٓ","поистине, я",11,47],["أَعُوذُ","прибегаю",11,47],["بِكَ","к Тебе",11,47],["أَنۡ","от того, чтобы",11,47],["أَسۡـَٔلَكَ","просить Тебя",11,47],["مَا","о том, чего",11,47],["لَيۡسَ","нет",11,47],["لِي","у меня",11,47],["بِهِۦ","о нём",11,47],["عِلۡمٞۖ","знания",11,47],["وَإِلَّا","и если не",11,47]],[["تَغۡفِرۡ","простишь Ты",11,47],["لِي","мне",11,47],["وَتَرۡحَمۡنِيٓ","и не помилуешь меня",11,47],["أَكُن","буду я",11,47],["مِّنَ","из",11,47],["ٱلۡخَٰسِرِينَ","потерпевших убыток",11,47],[47],["قِيلَ","было сказано",11,48],["يَٰنُوحُ","о Нух",11,48]],[["ٱهۡبِطۡ","сходи",11,48],["بِسَلَٰمٖ","с миром",11,48],["مِّنَّا","от Нас",11,48],["وَبَرَكَٰتٍ","и благословениями",11,48],["عَلَيۡكَ","на тебя",11,48],["وَعَلَىٰٓ","и на",11,48],["أُمَمٖ","общины",11,48],["مِّمَّن","из тех, кто",11,48],["مَّعَكَۚ","с тобой",11,48]],[["وَأُمَمٞ","и общины",11,48],["سَنُمَتِّعُهُمۡ","Мы дадим им пользоваться",11,48],["ثُمَّ","затем",11,48],["يَمَسُّهُم","коснётся их",11,48],["مِّنَّا","от Нас",11,48],["عَذَابٌ","наказание",11,48],["أَلِيمٞ","мучительное",11,48],[48],["تِلۡكَ","это",11,49]],[["مِنۡ","из",11,49],["أَنۢبَآءِ","вестей",11,49],["ٱلۡغَيۡبِ","о сокровенном",11,49],["نُوحِيهَآ","Мы внушаем их",11,49],["إِلَيۡكَۖ","тебе",11,49],["مَا","не",11,49],["كُنتَ","был ты",11,49],["تَعۡلَمُهَآ","знающим их",11,49],["أَنتَ","ты",11,49],["وَلَا","и не",11,49],["قَوۡمُكَ","народ твой",11,49]],[["مِن","с",11,49],["قَبۡلِ","прежде",11,49],["هَٰذَاۖ","этого",11,49],["فَٱصۡبِرۡۖ","так терпи же",11,49],["إِنَّ","поистине",11,49],["ٱلۡعَٰقِبَةَ","исход",11,49],["لِلۡمُتَّقِينَ","для богобоязненных",11,49],[49],["وَإِلَىٰ","и к",11,50],["عَادٍ","адитам",11,50]],[["أَخَاهُمۡ","брата их",11,50],["هُودٗاۚ","Худа",11,50],["قَالَ","сказал он",11,50],["يَٰقَوۡمِ","о народ мой",11,50],["ٱعۡبُدُواْ","поклоняйтесь",11,50],["ٱللَّهَ","Аллаху",11,50],["مَا","нет",11,50],["لَكُم","у вас",11,50],["مِّنۡ","никакого",11,50],["إِلَٰهٍ","божества",11,50]],[["غَيۡرُهُۥٓۖ","кроме Него",11,50],["إِنۡ","не",11,50],["أَنتُمۡ","вы",11,50],["إِلَّا","кроме как",11,50],["مُفۡتَرُونَ","измышляющие",11,50],[50],["يَٰقَوۡمِ","о народ мой",11,51],["لَآ","не",11,51],["أَسۡـَٔلُكُمۡ","прошу я у вас",11,51],["عَلَيۡهِ","за это",11,51]],[["أَجۡرًاۖ","награды",11,51],["إِنۡ","не",11,51],["أَجۡرِيَ","награда моя",11,51],["إِلَّا","кроме как",11,51],["عَلَى","на",11,51],["ٱلَّذِي","Том, Кто",11,51],["فَطَرَنِيٓۚ","сотворил меня",11,51],["أَفَلَا","неужели не",11,51],["تَعۡقِلُونَ","разумеете вы",11,51],[51]],[["وَيَٰقَوۡمِ","и о народ мой",11,52],["ٱسۡتَغۡفِرُواْ","просите прощения",11,52],["رَبَّكُمۡ","у Господа вашего",11,52],["ثُمَّ","затем",11,52],["تُوبُوٓاْ","кайтесь",11,52],["إِلَيۡهِ","Ему",11,52],["يُرۡسِلِ","Он пошлёт",11,52],["ٱلسَّمَآءَ","небо (дождь)",11,52]],[["عَلَيۡكُم","на вас",11,52],["مِّدۡرَارٗا","обильным",11,52],["وَيَزِدۡكُمۡ","и прибавит вам",11,52],["قُوَّةً","силы",11,52],["إِلَىٰ","к",11,52],["قُوَّتِكُمۡ","силе вашей",11,52],["وَلَا","и не",11,52],["تَتَوَلَّوۡاْ","отворачивайтесь",11,52]],[["مُجۡرِمِينَ","будучи грешниками",11,52],[52],["قَالُواْ","сказали они",11,53],["يَٰهُودُ","о Худ",11,53],["مَا","не",11,53],["جِئۡتَنَا","пришёл ты к нам",11,53],["بِبَيِّنَةٖ","с ясным знамением",11,53],["وَمَا","и не",11,53],["نَحۡنُ","мы",11,53]],[["بِتَارِكِيٓ","оставляющие",11,53],["ءَالِهَتِنَا","богов наших",11,53],["عَن","по",11,53],["قَوۡلِكَ","слову твоему",11,53],["وَمَا","и не",11,53],["نَحۡنُ","мы",11,53],["لَكَ","тебе",11,53],["بِمُؤۡمِنِينَ","верующие",11,53],[53]]]}