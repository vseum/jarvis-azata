{"p":228,"j":12,"a":[[11,54,["إِن","نَّقُولُ","إِلَّا","ٱعۡتَرَىٰكَ","بَعۡضُ","ءَالِهَتِنَا","بِسُوٓءٖۗ","قَالَ","إِنِّيٓ","أُشۡهِدُ","ٱللَّهَ","وَٱشۡهَدُوٓاْ","أَنِّي","بَرِيٓءٞ","مِّمَّا","تُشۡرِكُونَ"],"ин наḳуулу илла`тарака ба`ду алихатина бисууин ḳала иннии ушхидуллаха вашхадуу аннии барииум мимма тушрикуун","Мы лишь можем сказать, что один из наших богов причинил тебе зло». Он сказал: «Воистину, я призываю Аллаха в свидетели и прошу вас засвидетельствовать, что я непричастен к тем, кому вы поклоняетесь",["не","говорим мы","кроме как","поразил тебя","кто-то из","богов наших","злом","сказал он","поистине, я","призываю в свидетели","Аллаха","и свидетельствуйте","что я","непричастен","к тому, что","придаёте в сотоварищи"]],[11,55,["مِن","دُونِهِۦۖ","فَكِيدُونِي","جَمِيعٗا","ثُمَّ","لَا","تُنظِرُونِ"],"мин дуунихии факиидуунии жамии`ан сумма ла тунзируун","вместо Него. Стройте свои козни против меня все вместе и не предоставляйте мне отсрочки.",["помимо","Него","так ухищряйтесь против меня","все вместе","затем","не","давайте мне отсрочки"]],[11,56,["إِنِّي","تَوَكَّلۡتُ","عَلَى","ٱللَّهِ","رَبِّي","وَرَبِّكُمۚ","مَّا","مِن","دَآبَّةٍ","إِلَّا","هُوَ","ءَاخِذُۢ","بِنَاصِيَتِهَآۚ","إِنَّ","رَبِّي","عَلَىٰ","صِرَٰطٖ","مُّسۡتَقِيمٖ"],"иннии таваккалту `алаллахи раббии вараббикум ма мин даббатин илла хуа ахизу бинасийатиха инна раббии `ала сиратим мустаḳиим","Воистину, я уповаю на Аллаха, моего Господа и вашего Господа. Нет ни одного живого существа, которого бы Он не держал за хохол. Воистину, мой Господь - на прямом пути.",["поистине, я","уповаю","на","Аллаха","Господа моего","и Господа вашего","нет","ни","живого существа","кроме как","Он","держащий","за хохол его","поистине","Господь мой","на","пути","прямом"]],[11,57,["فَإِن","تَوَلَّوۡاْ","فَقَدۡ","أَبۡلَغۡتُكُم","مَّآ","أُرۡسِلۡتُ","بِهِۦٓ","إِلَيۡكُمۡۚ","وَيَسۡتَخۡلِفُ","رَبِّي","قَوۡمًا","غَيۡرَكُمۡ","وَلَا","تَضُرُّونَهُۥ","شَيۡـًٔاۚ","إِنَّ","رَبِّي","عَلَىٰ","كُلِّ","شَيۡءٍ","حَفِيظٞ"],"фа'ин таваллау фаḳад аблагтукум ма урсилту бихии илайкум вайастахлифу раббии ḳауман гайракум вала тадурруунахуу шай'ан инна раббии `ала кулли шай'ин хафииз","Если же вы отвернетесь, то ведь я довел до вашего сведения то, с чем я к вам отправлен. Мой Господь заменит вас другим народом, и вы ничем не навредите Ему. Воистину, Господь мой - Хранитель всякой вещи».",["и если","отвернётесь вы","то уже","я довёл до вас","то, что","я послан","с ним","к вам","и заменит","Господь мой","народом","другим, чем вы","и не","навредите вы Ему","ничем","поистине","Господь мой","над","всякой","вещью","Хранитель"]],[11,58,["وَلَمَّا","جَآءَ","أَمۡرُنَا","نَجَّيۡنَا","هُودٗا","وَٱلَّذِينَ","ءَامَنُواْ","مَعَهُۥ","بِرَحۡمَةٖ","مِّنَّا","وَنَجَّيۡنَٰهُم","مِّنۡ","عَذَابٍ","غَلِيظٖ"],"валамма жаа амруна нажжайна хуудан валлазиина амануу ма`ахуу бирахматим минна ванажжайнахум мин `азабин галииз","Когда же явилось Наше веление, Мы по Своей милости спасли Худа и тех, кто уверовал вместе с ним. Мы избавили их от лютой кары.",["и когда","пришло","веление Наше","Мы спасли","Худа","и тех, которые","уверовали","с ним","по милости","от Нас","и Мы спасли их","от","наказания","сурового"]],[11,59,["وَتِلۡكَ","عَادٞۖ","جَحَدُواْ","بِـَٔايَٰتِ","رَبِّهِمۡ","وَعَصَوۡاْ","رُسُلَهُۥ","وَٱتَّبَعُوٓاْ","أَمۡرَ","كُلِّ","جَبَّارٍ","عَنِيدٖ"],"ватилка `адун жахадуу би'айати раббихим ва`асау русулахуу ваттаба`уу амра кулли жаббарин `аниид","Такими были адиты! Они отвергли знамения своего Господа, ослушались Его посланников и последовали за всяким горделивым упрямцем.",["и это","адиты","отвергли они","знамения","Господа их","и ослушались","посланников Его","и последовали","приказу","всякого","тирана","упрямого"]],[11,60,["وَأُتۡبِعُواْ","فِي","هَٰذِهِ","ٱلدُّنۡيَا","لَعۡنَةٗ","وَيَوۡمَ","ٱلۡقِيَٰمَةِۗ","أَلَآ","إِنَّ","عَادٗا","كَفَرُواْ","رَبَّهُمۡۗ","أَلَا","بُعۡدٗا","لِّعَادٖ","قَوۡمِ","هُودٖ"],"ва'утби`уу фии хазихид дунйа ла`натан вайаумал ḳийамати ала инна `адан кафаруу раббахум ала бу`дал ли`адин ḳауми хууд","Проклятие будет преследовать их как в этом мире, так и в День воскресения. Воистину, адиты не уверовали в своего Господа. Да сгинут адиты, народ Худа!",["и были преследуемы они","в","этом","мире","проклятием","и в День","воскресения","о да","поистине","адиты","не уверовали","в Господа своего","о да","да сгинут же","адиты","народ","Худа"]],[11,61,["وَإِلَىٰ","ثَمُودَ","أَخَاهُمۡ","صَٰلِحٗاۚ","قَالَ","يَٰقَوۡمِ","ٱعۡبُدُواْ","ٱللَّهَ","مَا","لَكُم","مِّنۡ","إِلَٰهٍ","غَيۡرُهُۥۖ","هُوَ","أَنشَأَكُم","مِّنَ","ٱلۡأَرۡضِ","وَٱسۡتَعۡمَرَكُمۡ","فِيهَا","فَٱسۡتَغۡفِرُوهُ","ثُمَّ","تُوبُوٓاْ","إِلَيۡهِۚ","إِنَّ","رَبِّي","قَرِيبٞ","مُّجِيبٞ"],"ва'ила самууда ахахум салихан ḳала йаḳауми`будуллаха ма лакум мин илахин гайрухуу хуа аншаакум минал арди васта`маракум фииха фастагфирууху сумма туубуу илайхи инна раббии ḳариибум мужииб","Мы отправили к самудянам их брата Салиха. Он сказал: «О мой народ! Поклоняйтесь Аллаху, ибо нет у вас иного божества, кроме Него. Он сотворил вас из земли и поселил вас на ней. Просите прощения у Него, а затем покайтесь перед Ним. Воистину, мой Господь - Близкий, Отзывчивый».",["и к","самудянам","брата их","Салиха","сказал он","о народ мой","поклоняйтесь","Аллаху","нет","у вас","никакого","божества","кроме Него","Он","произвёл вас","из","земли","и поселил вас","на ней","так просите прощения у Него","затем","кайтесь","Ему","поистине","Господь мой","Близок","Отзывчив"]],[11,62,["قَالُواْ","يَٰصَٰلِحُ","قَدۡ","كُنتَ","فِينَا","مَرۡجُوّٗا","قَبۡلَ","هَٰذَآۖ","أَتَنۡهَىٰنَآ","أَن","نَّعۡبُدَ","مَا","يَعۡبُدُ","ءَابَآؤُنَا","وَإِنَّنَا","لَفِي","شَكّٖ","مِّمَّا","تَدۡعُونَآ","إِلَيۡهِ","مُرِيبٖ"],"ḳалуу йасалиху ḳад кунта фиина маржувван ḳабла хаза атанхана ан на`буда ма йа`буду абауна ва'иннана лафии шакким мимма тад`ууна илайхи мурииб","Они сказали: «О Салих! Прежде ты был нашей надеждой. Неужели ты запрещаешь нам поклоняться тому, кому поклонялись наши отцы? Воистину, нас терзают смутные сомнения относительно того, к чему ты нас призываешь».",["сказали они","о Салих","уже","был ты","среди нас","надеждой","до","этого","неужели запрещаешь нам","чтобы","поклонялись мы","тому, чему","поклонялись","отцы наши","и поистине, мы","непременно в","сомнении","относительно того, к чему","зовёшь нас","к нему","тревожном"]]],"m":[[["إِن","не",11,54],["نَّقُولُ","говорим мы",11,54],["إِلَّا","кроме как",11,54],["ٱعۡتَرَىٰكَ","поразил тебя",11,54],["بَعۡضُ","кто-то из",11,54],["ءَالِهَتِنَا","богов наших",11,54],["بِسُوٓءٖۗ","злом",11,54],["قَالَ","сказал он",11,54],["إِنِّيٓ","поистине, я",11,54],["أُشۡهِدُ","призываю в свидетели",11,54],["ٱللَّهَ","Аллаха",11,54]],[["وَٱشۡهَدُوٓاْ","и свидетельствуйте",11,54],["أَنِّي","что я",11,54],["بَرِيٓءٞ","непричастен",11,54],["مِّمَّا","к тому, что",11,54],["تُشۡرِكُونَ","придаёте в сотоварищи",11,54],[54],["مِن","помимо",11,55],["دُونِهِۦۖ","Него",11,55],["فَكِيدُونِي","так ухищряйтесь против меня",11,55]],[["جَمِيعٗا","все вместе",11,55],["ثُمَّ","затем",11,55],["لَا","не",11,55],["تُنظِرُونِ","давайте мне отсрочки",11,55],[55],["إِنِّي","поистине, я",11,56],["تَوَكَّلۡتُ","уповаю",11,56],["عَلَى","на",11,56],["ٱللَّهِ","Аллаха",11,56],["رَبِّي","Господа моего",11,56],["وَرَبِّكُمۚ","и Господа вашего",11,56],["مَّا","нет",11,56]],[["مِن","ни",11,56],["دَآبَّةٍ","живого существа",11,56],["إِلَّا","кроме как",11,56],["هُوَ","Он",11,56],["ءَاخِذُۢ","держащий",11,56],["بِنَاصِيَتِهَآۚ","за хохол его",11,56],["إِنَّ","поистине",11,56],["رَبِّي","Господь мой",11,56],["عَلَىٰ","на",11,56],["صِرَٰطٖ","пути",11,56],["مُّسۡتَقِيمٖ","прямом",11,56]],[[56],["فَإِن","и если",11,57],["تَوَلَّوۡاْ","отвернётесь вы",11,57],["فَقَدۡ","то уже",11,57],["أَبۡلَغۡتُكُم","я довёл до вас",11,57],["مَّآ","то, что",11,57],["أُرۡسِلۡتُ","я послан",11,57],["بِهِۦٓ","с ним",11,57],["إِلَيۡكُمۡۚ","к вам",11,57],["وَيَسۡتَخۡلِفُ","и заменит",11,57]],[["رَبِّي","Господь мой",11,57],["قَوۡمًا","народом",11,57],["غَيۡرَكُمۡ","другим, чем вы",11,57],["وَلَا","и не",11,57],["تَضُرُّونَهُۥ","навредите вы Ему",11,57],["شَيۡـٔ