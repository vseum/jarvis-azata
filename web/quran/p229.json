{"p":229,"j":12,"a":[[11,63,["قَالَ","يَٰقَوۡمِ","أَرَءَيۡتُمۡ","إِن","كُنتُ","عَلَىٰ","بَيِّنَةٖ","مِّن","رَّبِّي","وَءَاتَىٰنِي","مِنۡهُ","رَحۡمَةٗ","فَمَن","يَنصُرُنِي","مِنَ","ٱللَّهِ","إِنۡ","عَصَيۡتُهُۥۖ","فَمَا","تَزِيدُونَنِي","غَيۡرَ","تَخۡسِيرٖ"],"ḳала йаḳауми араайтум ин кунту `ала баййинатим мир раббии ва'атании минху рахматан фаман йансурунии миналлахи ин `асайтухуу фама тазиидуунании гайра тахсиир","Он сказал: «О мой народ! А что, если я опираюсь на доказательство от моего Господа, и Он даровал мне милость от Себя? Кто тогда защитит меня от Аллаха, если я ослушаюсь Его? Вы же не можете приумножить для меня ничего, кроме убытка.",["сказал он","о народ мой","видели ли вы","если","я","на","ясном доказательстве","от","Господа моего","и даровал Он мне","от Себя","милость","то кто","поможет мне","против","Аллаха","если","я ослушаюсь Его","и не","прибавите вы мне","кроме","убытка"]],[11,64,["وَيَٰقَوۡمِ","هَٰذِهِۦ","نَاقَةُ","ٱللَّهِ","لَكُمۡ","ءَايَةٗۖ","فَذَرُوهَا","تَأۡكُلۡ","فِيٓ","أَرۡضِ","ٱللَّهِۖ","وَلَا","تَمَسُّوهَا","بِسُوٓءٖ","فَيَأۡخُذَكُمۡ","عَذَابٞ","قَرِيبٞ"],"вайаḳауми хазихии наḳатуллахи лакум айатан фазарууха та'кул фии ардиллахи вала тамассууха бисууин файа'хузакум `азабун ḳарииб","О мой народ! Вот эта верблюдица Аллаха - знамение для вас. Пусть она пасется на земле Аллаха, и вы не причиняйте ей зла, а не то вас постигнут близкие мучения».",["и о народ мой","это","верблюдица","Аллаха","для вас","знамение","оставьте же её","пусть ест","на","земле","Аллаха","и не","касайтесь её","злом","а то постигнет вас","наказание","близкое"]],[11,65,["فَعَقَرُوهَا","فَقَالَ","تَمَتَّعُواْ","فِي","دَارِكُمۡ","ثَلَٰثَةَ","أَيَّامٖۖ","ذَٰلِكَ","وَعۡدٌ","غَيۡرُ","مَكۡذُوبٖ"],"фа`аḳарууха фаḳала таматта`уу фии дарикум саласата аййамин залика ва`дун гайру макзууб","Но они подрезали ей поджилки, и Салих сказал: «Наслаждайтесь в своих жилищах еще три дня. Это обещание не окажется лживым».",["но они подрезали её","и сказал он","наслаждайтесь","в","жилищах ваших","три","дня","это","обещание","не","ложное"]],[11,66,["فَلَمَّا","جَآءَ","أَمۡرُنَا","نَجَّيۡنَا","صَٰلِحٗا","وَٱلَّذِينَ","ءَامَنُواْ","مَعَهُۥ","بِرَحۡمَةٖ","مِّنَّا","وَمِنۡ","خِزۡيِ","يَوۡمِئِذٍۚ","إِنَّ","رَبَّكَ","هُوَ","ٱلۡقَوِيُّ","ٱلۡعَزِيزُ"],"фаламма жаа амруна нажжайна салихан валлазиина амануу ма`ахуу бирахматим минна вамин хизйи йаумиизин инна раббака хуал ḳавиййул `азииз","Когда же явилось Наше веление, Мы по милости Своей спасли Салиха и тех, кто уверовал вместе с ним. Мы избавили их от позора в тот день. Воистину, твой Господь - Всесильный, Могущественный!",["и когда","пришло","веление Наше","Мы спасли","Салиха","и тех, которые","уверовали","с ним","по милости","от Нас","и от","позора","того дня","поистине","Господь твой","Он","Сильный","Могущественный"]],[11,67,["وَأَخَذَ","ٱلَّذِينَ","ظَلَمُواْ","ٱلصَّيۡحَةُ","فَأَصۡبَحُواْ","فِي","دِيَٰرِهِمۡ","جَٰثِمِينَ"],"ва'ахазал лазиина заламус сайхату фа'асбахуу фии дийарихим жасимиин","А беззаконников поразил ужасный вопль, и они оказались повергнуты ниц в своих домах,",["и постиг","тех, которые","поступали несправедливо","вопль","и стали они","в","жилищах своих","повергнутыми ниц"]],[11,68,["كَأَن","لَّمۡ","يَغۡنَوۡاْ","فِيهَآۗ","أَلَآ","إِنَّ","ثَمُودَاْ","كَفَرُواْ","رَبَّهُمۡۗ","أَلَا","بُعۡدٗا","لِّثَمُودَ"],"ка'ал лам йагнау фииха ала инна самууда кафаруу раббахум ала бу`дал лисамууд","словно они никогда не жили там. Воистину, самудяне не уверовали в своего Господа. Да сгинут самудяне!",["словно","не","жили они","там","о да","поистине","самудяне","не уверовали","в Господа своего","о да","да сгинут же","самудяне"]],[11,69,["وَلَقَدۡ","جَآءَتۡ","رُسُلُنَآ","إِبۡرَٰهِيمَ","بِٱلۡبُشۡرَىٰ","قَالُواْ","سَلَٰمٗاۖ","قَالَ","سَلَٰمٞۖ","فَمَا","لَبِثَ","أَن","جَآءَ","بِعِجۡلٍ","حَنِيذٖ"],"валаḳад жаат русулуна ибрахиима билбушра ḳалуу саламан ḳала саламун фама лабиса ан жаа би`ижлин ханииз","Наши посланцы принесли Ибрахиму (Аврааму) радостную весть и сказали: «Мир!». Он сказал: «И вам мир!». - и поторопился, чтобы принести жареного теленка.",["и уже","пришли","посланцы Наши","к Ибрахиму","с радостной вестью","сказали они","мир","сказал он","мир","и не","медлил он","чтобы","принести","телёнка","жареного"]],[11,70,["فَلَمَّا","رَءَآ","أَيۡدِيَهُمۡ","لَا","تَصِلُ","إِلَيۡهِ","نَكِرَهُمۡ","وَأَوۡجَسَ","مِنۡهُمۡ","خِيفَةٗۚ","قَالُواْ","لَا","تَخَفۡ","إِنَّآ","أُرۡسِلۡنَآ","إِلَىٰ","قَوۡمِ","لُوطٖ"],"фаламма ра'а айдийахум ла тасилу илайхи накирахум ва'аужаса минхум хиифатан ḳалуу ла тахаф инна урсилна ила ḳауми луут","Увидев, что они не дотрагиваются до еды, он усомнился в них и почувствовал страх перед ними. Посланцы сказали: «Не бойся! Воистину, мы посланы к народу Лута (Лота)».",["и когда","увидел он","руки их","не","тянутся","к нему","счёл он их чужими","и ощутил","от них","страх","сказали они","не","бойся","поистине, мы","посланы","к","народу","Лута"]],[11,71,["وَٱمۡرَأَتُهُۥ","قَآئِمَةٞ","فَضَحِكَتۡ","فَبَشَّرۡنَٰهَا","بِإِسۡحَٰقَ","وَمِن","وَرَآءِ","إِسۡحَٰقَ","يَعۡقُوبَ"],"вамраатухуу ḳаиматун фадахикат фабашшарнаха би'исхаḳа вамин вараи исхаḳа йа`ḳууб","Жена его, стоявшая за завесой, рассмеялась. Тогда Мы сообщили ей радостную весть об Исхаке (Исааке), а вслед за Исхаком (Исааком) - о Йакубе (Иакове).",["и жена его","стояла","и рассмеялась она","и Мы обрадовали её","Исхаком","и от","после","Исхака","Йакубом"]]],"m":[[["قَالَ","сказал он",11,63],["يَٰقَوۡمِ","о народ мой",11,63],["أَرَءَيۡتُمۡ","видели ли вы",11,63],["إِن","если",11,63],["كُنتُ","я",11,63],["عَلَىٰ","на",11,63],["بَيِّنَةٖ","ясном доказательстве",11,63],["مِّن","от",11,63],["رَّبِّي","Господа моего",11,63],["وَءَاتَىٰنِي","и даровал Он мне",11,63]],[["مِنۡهُ","от Себя",11,63],["رَحۡمَةٗ","милость",11,63],["فَمَن","то кто",11,63],["يَنصُرُنِي","поможет мне",11,63],["مِنَ","против",11,63],["ٱللَّهِ","Аллаха",11,63],["إِنۡ","если",11,63],["عَصَيۡتُهُۥۖ","я ослушаюсь Его",11,63],["فَمَا","и не",11,63],["تَزِيدُونَنِي","прибавите вы мне",11,63]],[["غَيۡرَ","кроме",11,63],["تَخۡسِيرٖ","убытка",11,