же",11,68]],[["لِّثَمُودَ","самудяне",11,68],[68],["وَلَقَدۡ","и уже",11,69],["جَآءَتۡ","пришли",11,69],["رُسُلُنَآ","посланцы Наши",11,69],["إِبۡرَٰهِيمَ","к Ибрахиму",11,69],["بِٱلۡبُشۡرَىٰ","с радостной вестью",11,69],["قَالُواْ","сказали они",11,69]],[["سَلَٰمٗاۖ","мир",11,69],["قَالَ","сказал он",11,69],["سَلَٰمٞۖ","мир",11,69],["فَمَا","и не",11,69],["لَبِثَ","медлил он",11,69],["أَن","чтобы",11,69],["جَآءَ","принести",11,69],["بِعِجۡلٍ","телёнка",11,69],["حَنِيذٖ","жареного",11,69],[69],["فَلَمَّا","и когда",11,70]],[["رَءَآ","увидел он",11,70],["أَيۡدِيَهُمۡ","руки их",11,70],["لَا","не",11,70],["تَصِلُ","тянутся",11,70],["إِلَيۡهِ","к нему",11,70],["نَكِرَهُمۡ","счёл он их чужими",11,70],["وَأَوۡجَسَ","и ощутил",11,70],["مِنۡهُمۡ","от них",11,70],["خِيفَةٗۚ","страх",11,70]],[["قَالُواْ","сказали они",11,70],["لَا","не",11,70],["تَخَفۡ","бойся",11,70],["إِنَّآ","поистине, мы",11,70],["أُرۡسِلۡنَآ","посланы",11,70],["إِلَىٰ","к",11,70],["قَوۡمِ","народу",11,70],["لُوطٖ","Лута",11,70],[70],["وَٱمۡرَأَتُهُۥ","и жена его",11,71],["قَآئِمَةٞ","стояла",11,71]],[["فَضَحِكَتۡ","и рассмеялась она",11,71],["فَبَشَّرۡنَٰهَا","и Мы обрадовали её",11,71],["بِإِسۡحَٰقَ","Исхаком",11,71],["وَمِن","и от",11,71],["وَرَآءِ","после",11,71],["إِسۡحَٰقَ","Исхака",11,71],["يَعۡقُوبَ","Йакубом",11,71],[71]]]}