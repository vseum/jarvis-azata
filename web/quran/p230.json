{"p":230,"j":12,"a":[[11,72,["قَالَتۡ","يَٰوَيۡلَتَىٰٓ","ءَأَلِدُ","وَأَنَا۠","عَجُوزٞ","وَهَٰذَا","بَعۡلِي","شَيۡخًاۖ","إِنَّ","هَٰذَا","لَشَيۡءٌ","عَجِيبٞ"],"ḳалат йавайлата а'алиду ва'ана `ажуузун вахаза ба`лии шайхан инна хаза лашай'ун `ажииб","Она сказала: «Горе мне! Неужели я рожу? Ведь я - старуха, и мой муж - старик. Воистину, это - нечто удивительное!».",["сказала она","горе мне","неужели я рожу","когда я","старуха","а этот","муж мой","старик","поистине","это","непременно нечто","удивительное"]],[11,73,["قَالُوٓاْ","أَتَعۡجَبِينَ","مِنۡ","أَمۡرِ","ٱللَّهِۖ","رَحۡمَتُ","ٱللَّهِ","وَبَرَكَٰتُهُۥ","عَلَيۡكُمۡ","أَهۡلَ","ٱلۡبَيۡتِۚ","إِنَّهُۥ","حَمِيدٞ","مَّجِيدٞ"],"ḳалуу ата`жабиина мин амриллахи рахматуллахи вабаракатухуу `алайкум ахлал байти иннахуу хамиидум мажиид","Они сказали: «Неужели ты удивляешься повелению Аллаха? Да пребудут над вами милость и благословение Аллаха, о обитатели дома! Воистину, Он - Достохвальный, Славный».",["сказали они","неужели удивляешься ты","по поводу","повеления","Аллаха","милость","Аллаха","и благословения Его","над вами","о обитатели","дома","поистине, Он","Достохвальный","Славный"]],[11,74,["فَلَمَّا","ذَهَبَ","عَنۡ","إِبۡرَٰهِيمَ","ٱلرَّوۡعُ","وَجَآءَتۡهُ","ٱلۡبُشۡرَىٰ","يُجَٰدِلُنَا","فِي","قَوۡمِ","لُوطٍ"],"фаламма захаба `ан ибрахиимар рау`у важаатхул бушра йужадилуна фии ḳауми луут","Когда страх Ибрахима (Авраама) прошел и он услышал радостную весть, он стал препираться с Нами за народ Лута (Лота).",["и когда","ушёл","от","Ибрахима","страх","и пришла к нему","радостная весть","он стал препираться с Нами","о","народе","Лута"]],[11,75,["إِنَّ","إِبۡرَٰهِيمَ","لَحَلِيمٌ","أَوَّٰهٞ","مُّنِيبٞ"],"инна ибрахиима лахалиимун аввахум мунииб","Воистину, Ибрахим (Авраам) был выдержанным, смиренным и кающимся.",["поистине","Ибрахим","непременно выдержанный","смиренно-вздыхающий","обращающийся (к Аллаху)"]],[11,76,["يَٰٓإِبۡرَٰهِيمُ","أَعۡرِضۡ","عَنۡ","هَٰذَآۖ","إِنَّهُۥ","قَدۡ","جَآءَ","أَمۡرُ","رَبِّكَۖ","وَإِنَّهُمۡ","ءَاتِيهِمۡ","عَذَابٌ","غَيۡرُ","مَرۡدُودٖ"],"йа'ибрахииму а`рид `ан хаза иннахуу ḳад жаа амру раббика ва'иннахум атиихим `азабун гайру мардууд","Ангелы сказали: «О Ибрахим (Авраам)! Оставь споры, ибо твой Господь уже отдал приказ, и их постигнут неотвратимые мучения».",["о Ибрахим","отвернись","от","этого","поистине, оно","уже","пришло","веление","Господа твоего","и поистине, они","постигнет их","наказание","не","отвратимое"]],[11,77,["وَلَمَّا","جَآءَتۡ","رُسُلُنَا","لُوطٗا","سِيٓءَ","بِهِمۡ","وَضَاقَ","بِهِمۡ","ذَرۡعٗا","وَقَالَ","هَٰذَا","يَوۡمٌ","عَصِيبٞ"],"валамма жаат русулуна луутан сииа бихим вадаḳа бихим зар`ан ваḳала хаза йаумун `асииб","Когда Наши посланцы явились к Луту (Лоту), он огорчился из-за них, почувствовал себя стесненным и сказал: «Это - тяжкий день».",["и когда","пришли","посланцы Наши","к Луту","он огорчился","из-за них","и стеснился","из-за них","душой","и сказал","это","день","тяжкий"]],[11,78,["وَجَآءَهُۥ","قَوۡمُهُۥ","يُهۡرَعُونَ","إِلَيۡهِ","وَمِن","قَبۡلُ","كَانُواْ","يَعۡمَلُونَ","ٱلسَّيِّـَٔاتِۚ","قَالَ","يَٰقَوۡمِ","هَٰٓؤُلَآءِ","بَنَاتِي","هُنَّ","أَطۡهَرُ","لَكُمۡۖ","فَٱتَّقُواْ","ٱللَّهَ","وَلَا","تُخۡزُونِ","فِي","ضَيۡفِيٓۖ","أَلَيۡسَ","مِنكُمۡ","رَجُلٞ","رَّشِيدٞ"],"важаахуу ḳаумухуу йухра`ууна илайхи вамин ḳаблу кануу йа`малуунас саййиати ḳала йаḳауми ха'улаи банатии хунна атхару лакум фаттаḳуллаха вала тухзууни фии дайфии алайса минкум ражулур рашиид","К нему сбежались его соплеменники, которые уже давно совершали преступления. Он сказал: «О мой народ! Вот мои дочери. Они для вас чище. Побойтесь Аллаха и не позорьте меня перед моими гостями. Неужели среди вас нет благоразумного мужчины?».",["и пришёл к нему","народ его","сбегаясь","к нему","и","прежде","были они","совершающими","злодеяния","сказал он","о народ мой","эти","дочери мои","они","чище","для вас","бойтесь же","Аллаха","и не","позорьте меня","перед","гостями моими","неужели нет","среди вас","мужчины","благоразумного"]],[11,79,["قَالُواْ","لَقَدۡ","عَلِمۡتَ","مَا","لَنَا","فِي","بَنَاتِكَ","مِنۡ","حَقّٖ","وَإِنَّكَ","لَتَعۡلَمُ","مَا","نُرِيدُ"],"ḳалуу лаḳад `алимта ма лана фии банатика мин хаḳḳин ва'иннака лата`ламу ма нуриид","Они сказали: «Ты знаешь, что нам не нужны твои дочери. Тебе известно, чего мы хотим».",["сказали они","уже","ты знаешь","что нет","у нас","на","дочерей твоих","никакого","права","и поистине, ты","непременно знаешь","что","хотим мы"]],[11,80,["قَالَ","لَوۡ","أَنَّ","لِي","بِكُمۡ","قُوَّةً","أَوۡ","ءَاوِيٓ","إِلَىٰ","رُكۡنٖ","شَدِيدٖ"],"ḳала лау анна лии бикум ḳувватан ау авии ила рукнин шадиид","Он сказал: «Если бы у меня была сила, чтобы одолеть вас! Если бы у меня была мощная опора!».",["сказал он","если бы","что","у меня","против вас","сила","или","прибегнуть бы мне","к","опоре","крепкой"]],[11,81,["قَالُواْ","يَٰلُوطُ","إِنَّا","رُسُلُ","رَبِّكَ","لَن","يَصِلُوٓاْ","إِلَيۡكَۖ","فَأَسۡرِ","بِأَهۡلِكَ","بِقِطۡعٖ","مِّنَ","ٱلَّيۡلِ","وَلَا","يَلۡتَفِتۡ","مِنكُمۡ","أَحَدٌ","إِلَّا","ٱمۡرَأَتَكَۖ","إِنَّهُۥ","مُصِيبُهَا","مَآ","أَصَابَهُمۡۚ","إِنَّ","مَوۡعِدَهُمُ","ٱلصُّبۡحُۚ","أَلَيۡسَ","ٱلصُّبۡحُ","بِقَرِيبٖ"],"ḳалуу йалууту инна русулу раббика лан йасилуу илайка фа'асри би'ахлика биḳит`им минал лайли вала йалтафит минкум ахадун илламраатака иннахуу мусиибуха ма асабахум инна мау`идахумус субху алайсас субху биḳарииб","Они сказали: «О Лут (Лот)! Мы - посланцы твоего Господа, и они не причинят тебе зла. Отправляйся в путь вместе со своей семьей среди ночи, и пусть никто из вас не оглядывается. И только твою жену поразит то, что поразит остальных. Их срок выйдет утром. Разве утро не близко?».",["сказали они","о Лут","поистине, мы","посланцы","Господа твоего","никогда не","доберутся они","до тебя","так выведи в ночь","семью твою","в части","из","ночи","и пусть не","оборачивается","из вас","никто","кроме","жены твоей","поистине, это","постигнет её","то, что","постигнет их","поистине","срок их","утро","разве не","утро","близко"]]],"m":[[["قَالَتۡ","сказала она",11,72],["يَٰوَيۡلَتَىٰٓ","горе мне",11,72],["ءَأَلِدُ"