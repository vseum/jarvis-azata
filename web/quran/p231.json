{"p":231,"j":12,"a":[[11,82,["فَلَمَّا","جَآءَ","أَمۡرُنَا","جَعَلۡنَا","عَٰلِيَهَا","سَافِلَهَا","وَأَمۡطَرۡنَا","عَلَيۡهَا","حِجَارَةٗ","مِّن","سِجِّيلٖ","مَّنضُودٖ"],"фаламма жаа амруна жа`ална `алийаха сафилаха ва'амтарна `алайха хижаратам мин сижжиилим мандууд","Когда же явилось Наше веление, Мы перевернули вверх дном их селения и последовательно обрушили на них каменья из обожженной глины,",["и когда","пришло","веление Наше","Мы сделали","верх его","низом его","и Мы пролили дождём","на него","камни","из","обожжённой глины","слой за слоем"]],[11,83,["مُّسَوَّمَةً","عِندَ","رَبِّكَۖ","وَمَا","هِيَ","مِنَ","ٱلظَّٰلِمِينَ","بِبَعِيدٖ"],"ммусавваматан `инда раббика вама хийа миназ залимиина биба`иид","помеченные у твоего Господа. Воистину, они недалеки от беззаконников.",["помеченные","у","Господа твоего","и не","они","от","беззаконников","далеки"]],[11,84,["وَإِلَىٰ","مَدۡيَنَ","أَخَاهُمۡ","شُعَيۡبٗاۚ","قَالَ","يَٰقَوۡمِ","ٱعۡبُدُواْ","ٱللَّهَ","مَا","لَكُم","مِّنۡ","إِلَٰهٍ","غَيۡرُهُۥۖ","وَلَا","تَنقُصُواْ","ٱلۡمِكۡيَالَ","وَٱلۡمِيزَانَۖ","إِنِّيٓ","أَرَىٰكُم","بِخَيۡرٖ","وَإِنِّيٓ","أَخَافُ","عَلَيۡكُمۡ","عَذَابَ","يَوۡمٖ","مُّحِيطٖ"],"ва'ила мадйана ахахум шу`айбан ḳала йаḳауми`будуллаха ма лакум мин илахин гайрухуу вала танḳусул микйала валмиизана иннии аракум бихайрин ва'иннии ахафу `алайкум `азаба йаумим мухиит","Мы отправили к мадьянитам их брата Шуейба. Он сказал: «О мой народ! Поклоняйтесь Аллаху, ибо нет у вас иного божества, кроме Него. Не обмеривайте и не обвешивайте. Я вижу, как вы благоденствуете, и боюсь, что вас постигнут мучения в Объемлющий день.",["и к","мадьянитам","брата их","Шуайба","сказал он","о народ мой","поклоняйтесь","Аллаху","нет","у вас","никакого","божества","кроме Него","и не","уменьшайте","меру","и вес","поистине, я","вижу вас","в благе","и поистине, я","боюсь","за вас","наказания","дня","объемлющего"]],[11,85,["وَيَٰقَوۡمِ","أَوۡفُواْ","ٱلۡمِكۡيَالَ","وَٱلۡمِيزَانَ","بِٱلۡقِسۡطِۖ","وَلَا","تَبۡخَسُواْ","ٱلنَّاسَ","أَشۡيَآءَهُمۡ","وَلَا","تَعۡثَوۡاْ","فِي","ٱلۡأَرۡضِ","مُفۡسِدِينَ"],"вайаḳауми ауфул микйала валмиизана билḳисти вала табхасун наса ашйаахум вала та`сау фил арди муфсидиин","О мой народ! Наполняйте меру и весы по справедливости, не придерживайте имущество людей и не творите на земле зла, распространяя нечестие.",["и о народ мой","наполняйте","меру","и вес","по справедливости","и не","обделяйте","людей","в вещах их","и не","бесчинствуйте","на","земле","распространяя нечестие"]],[11,86,["بَقِيَّتُ","ٱللَّهِ","خَيۡرٞ","لَّكُمۡ","إِن","كُنتُم","مُّؤۡمِنِينَۚ","وَمَآ","أَنَا۠","عَلَيۡكُم","بِحَفِيظٖ"],"баḳиййатуллахи хайрул лакум ин кунтум му'миниина вама ана `алайкум бихафииз","Оставленное вам Аллахом лучше для вас, если только вы веруете, и я не являюсь вашим хранителем».",["оставленное","Аллахом","лучше","для вас","если","вы","верующие","и не","я","над вами","хранитель"]],[11,87,["قَالُواْ","يَٰشُعَيۡبُ","أَصَلَوٰتُكَ","تَأۡمُرُكَ","أَن","نَّتۡرُكَ","مَا","يَعۡبُدُ","ءَابَآؤُنَآ","أَوۡ","أَن","نَّفۡعَلَ","فِيٓ","أَمۡوَٰلِنَا","مَا","نَشَٰٓؤُاْۖ","إِنَّكَ","لَأَنتَ","ٱلۡحَلِيمُ","ٱلرَّشِيدُ"],"ḳалуу йашу`айбу асалаватука та'мурука ан натрука ма йа`буду абауна ау ан наф`ала фии амвалина ма нашау иннака ла'антал халиимур рашиид","Они сказали: «О Шуейб! Неужели твой намаз повелевает нам отречься от того, чему поклонялись наши отцы, или распоряжаться нашим имуществом не так, как мы того хотим? Ведь ты же - выдержанный, благоразумный».",["сказали они","о Шуайб","неужели молитва твоя","велит тебе","чтобы","мы оставили","то, чему","поклоняются","отцы наши","или","чтобы","мы делали","с","имуществом нашим","то, что","пожелаем","поистине, ты","непременно ты","выдержанный","благоразумный"]],[11,88,["قَالَ","يَٰقَوۡمِ","أَرَءَيۡتُمۡ","إِن","كُنتُ","عَلَىٰ","بَيِّنَةٖ","مِّن","رَّبِّي","وَرَزَقَنِي","مِنۡهُ","رِزۡقًا","حَسَنٗاۚ","وَمَآ","أُرِيدُ","أَنۡ","أُخَالِفَكُمۡ","إِلَىٰ","مَآ","أَنۡهَىٰكُمۡ","عَنۡهُۚ","إِنۡ","أُرِيدُ","إِلَّا","ٱلۡإِصۡلَٰحَ","مَا","ٱسۡتَطَعۡتُۚ","وَمَا","تَوۡفِيقِيٓ","إِلَّا","بِٱللَّهِۚ","عَلَيۡهِ","تَوَكَّلۡتُ","وَإِلَيۡهِ","أُنِيبُ"],"ḳала йаḳауми араайтум ин кунту `ала баййинатим мир раббии варазаḳании минху ризḳан хасанан вама урииду ан ухалифакум ила ма анхакум `анху ин урииду иллал ислаха мастата`ту вама тауфииḳии илла биллахи `алайхи таваккалту ва'илайхи унииб","Он сказал: «О мой народ! А что, если я опираюсь на доказательство от моего Господа, и Он даровал мне прекрасную долю? Я не хочу отличаться от вас и совершать то, что я запрещаю совершать вам, а хочу лишь исправить то, что в моих силах. Помогает мне только Аллах. На Него одного я уповаю, к Нему одному обращаюсь.",["сказал он","о народ мой","видели ли вы","если","я","на","ясном доказательстве","от","Господа моего","и наделил Он меня","от Себя","уделом","прекрасным","и не","хочу я","чтобы","поступать вопреки вам","в","том, что","я запрещаю вам","это","не","хочу я","кроме как","исправления","насколько","я смог","и не","успех мой","кроме как","от Аллаха","на Него","я уповаю","и к Нему","обращаюсь"]]],"m":[[["فَلَمَّا","и когда",11,82],["جَآءَ","пришло",11,82],["أَمۡرُنَا","веление Наше",11,82],["جَعَلۡنَا","Мы сделали",11,82],["عَٰلِيَهَا","верх его",11,82],["سَافِلَهَا","низом его",11,82],["وَأَمۡطَرۡنَا","и Мы пролили дождём",11,82],["عَلَيۡهَا","на него",11,82]],[["حِجَارَةٗ","камни",11,82],["مِّن","из",11,82],["سِجِّيلٖ","обожжённой глины",11,82],["مَّنضُودٖ","слой за слоем",11,82],[82],["مُّسَوَّمَةً","помеченные",11,83],["عِندَ","у",11,83],["رَبِّكَۖ","Господа твоего",11,83]],[["وَمَا","и не",11,83],["هِيَ","они",11,83],["مِنَ","от",11,83],["ٱلظَّٰلِمِينَ","беззаконников",11,83],["بِبَعِيدٖ","далеки",11,83],[83],["۞ وَإِلَىٰ","и к",11,84],["مَدۡيَنَ","мадьянитам",11,84],["أَخَاهُمۡ","брата их",11,84]],[["شُعَيۡبٗاۚ","Шуайба",11,84],["قَالَ","сказал он",11,84],["يَٰقَوۡمِ","о народ мой",11,84],["ٱعۡبُدُواْ","поклоняйтесь",11,84],["ٱللَّهَ","Аллаху",11,84],["مَا","нет",11,84],["لَكُم","у вас",11,84],["مِّنۡ","никакого",11,84],["إِلَٰهٍ","божества",11,84],["غَيۡرُهُۥۖ","кроме Него",11,84]],[["وَلَا","и не",11,84],["تَنقُصُواْ","уменьшайте",11,84],["ٱلۡمِكۡيَالَ","меру",11,84],["وَٱلۡمِيزَانَۖ","и вес",11,84],["إِنِّيٓ","поистине, я",11,84],["أَرَىٰكُم","вижу вас",11,84],["بِخَيۡرٖ","в благе",11,84]],[["وَإِنِّيٓ","и поистине, я",11,84],["أَخَافُ","боюсь",11,84],["عَلَيۡكُمۡ","за вас",11,84],["عَذَابَ","наказания",11,84],["يَوۡمٖ","дня",11,84],["مُّحِيطٖ","объемлющего",11,84],[84],["وَيَٰقَوۡمِ","и о народ мой",11,85]],[["أَوۡفُواْ","наполняйте",11,85],["ٱلۡمِكۡيَالَ","меру",11,85],["وَٱلۡمِيزَانَ","и вес",11,85],["بِٱلۡقِسۡطِۖ","по справедливости",11,85],["وَلَا","и не",11,85],["تَبۡخَسُواْ","обделяйте",11,85]],[["ٱلنَّاسَ","людей",11,85],["أَشۡيَآءَهُمۡ","в вещах их",11,85],["وَلَا","и не",11,85],["تَعۡثَوۡاْ","бесчинствуйте",11,85],["فِي","на",11,85],["ٱلۡأَرۡضِ","земле",11,85],["مُفۡسِدِينَ","распространяя нечестие",11,85],[85]],[["بَقِيَّتُ","оставленное",11,86],["ٱللَّهِ","Аллахом",11,86],["خَيۡرٞ","лучше",11,86],["لَّكُمۡ","для вас",11,86],["إِن","если",11,86],["كُنتُم","вы",11,86],["مُّؤۡمِنِينَۚ","верующие",11,86],["وَمَآ","и не",11,86],["أَنَا۠","я",11,86],["عَلَيۡكُم","над вами",11,86]],[["بِحَفِيظٖ","хранитель",11,86],[86],["قَالُواْ","сказали они",11,87],["يَٰشُعَيۡبُ","о Шуайб",11,87],["أَصَلَوٰتُكَ","неужели молитва твоя",11,87],["تَأۡمُرُكَ","велит тебе",11,87],["أَن","чтобы",11,87]],[["نَّتۡرُكَ","мы оставили",11,87],["مَا","то, чему",11,87],["يَعۡبُدُ","поклоняются",11,87],["ءَابَآؤُنَآ","отцы наши",11,87],["أَوۡ","или",11,87],["أَن","чтобы",11,87],["نَّفۡعَلَ","мы делали",11,87],["فِيٓ","с",11,87],["أَمۡوَٰلِنَا","имуществом нашим",11,87],["مَا","то, что",11,87],["نَشَٰٓؤُاْۖ","пожелаем",11,87]],[["إِنَّكَ","поистине, ты",11,87],["لَأَنتَ","непременно ты",11,87],["ٱلۡحَلِيمُ","выдержанный",11,87],["ٱلرَّشِيدُ","благоразумный",11,87],[87],["قَالَ","сказал он",11,88],["يَٰقَوۡمِ","о народ мой",11,88],["أَرَءَيۡتُمۡ","видели ли вы",11,88],["إِن","если",11,88]],[["كُنتُ","я",11,88],["عَلَىٰ","на",11,88],["بَيِّنَةٖ","ясном доказательстве",11,88],["مِّن","от",11,88],["رَّبِّي","Господа моего",11,88],["وَرَزَقَنِي","и наделил Он меня",11,88],["مِنۡهُ","от Себя",11,88],["رِزۡقًا","уделом",11,88],["حَسَنٗاۚ","прекрасным",11,88],["وَمَآ","и не",11,88],["أُرِيدُ","хочу я",11,88],["أَنۡ","чтобы",11,88]],[["أُخَالِفَكُمۡ","поступать вопреки вам",11,88],["إِلَىٰ","в",11,88],["مَآ","том, что",11,88],["أَنۡهَىٰكُمۡ","я запрещаю вам",11,88],["عَنۡهُۚ","это",11,88],["إِنۡ","не",11,88],["أُرِيدُ","хочу я",11,88],["إِلَّا","кроме как",11,88],["ٱلۡإِصۡلَٰحَ","исправления",11,88]],[["مَا","насколько",11,88],["ٱسۡتَطَعۡتُۚ","я смог",11,88],["وَمَا","и не",11,88],["تَوۡفِيقِيٓ","успех мой",11,88],["إِلَّا","кроме как",11,88],["بِٱللَّهِۚ","от Аллаха",11,88],["عَلَيۡهِ","на Него",11,88],["تَوَكَّلۡتُ","я уповаю",11,88],["وَإِلَيۡهِ","и к Нему",11,88],["أُنِيبُ","обращаюсь",11,88],[88]]]}