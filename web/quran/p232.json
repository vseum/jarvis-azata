{"p":232,"j":12,"a":[[11,89,["وَيَٰقَوۡمِ","لَا","يَجۡرِمَنَّكُمۡ","شِقَاقِيٓ","أَن","يُصِيبَكُم","مِّثۡلُ","مَآ","أَصَابَ","قَوۡمَ","نُوحٍ","أَوۡ","قَوۡمَ","هُودٍ","أَوۡ","قَوۡمَ","صَٰلِحٖۚ","وَمَا","قَوۡمُ","لُوطٖ","مِّنكُم","بِبَعِيدٖ"],"вайаḳауми ла йажриманнакум шиḳаḳии ан йусиибакум мислу ма асаба ḳаума нуухин ау ḳаума хуудин ау ḳаума салихин вама ḳауму луутим минкум биба`иид","О мой народ! Пусть ваши разногласия со мной не обрекут вас на то, что постигло народ Нуха (Ноя), или народ Худа, или народ Салиха. Народ Лута (Лота) также недалек от вас.",["и о народ мой","пусть не","ввергнет вас","разлад со мной","в то, что","постигнет вас","подобное","тому, что","постигло","народ","Нуха","или","народ","Худа","или","народ","Салиха","и не","народ","Лута","от вас","далёк"]],[11,90,["وَٱسۡتَغۡفِرُواْ","رَبَّكُمۡ","ثُمَّ","تُوبُوٓاْ","إِلَيۡهِۚ","إِنَّ","رَبِّي","رَحِيمٞ","وَدُودٞ"],"вастагфируу раббакум сумма туубуу илайхи инна раббии рахиимун вадууд","Попросите прощения у своего Господа, а затем раскайтесь перед Ним. Воистину, мой Господь - Милосердный, Любящий (или Любимый)».",["и просите прощения","у Господа вашего","затем","кайтесь","Ему","поистине","Господь мой","Милосерден","Любящий"]],[11,91,["قَالُواْ","يَٰشُعَيۡبُ","مَا","نَفۡقَهُ","كَثِيرٗا","مِّمَّا","تَقُولُ","وَإِنَّا","لَنَرَىٰكَ","فِينَا","ضَعِيفٗاۖ","وَلَوۡلَا","رَهۡطُكَ","لَرَجَمۡنَٰكَۖ","وَمَآ","أَنتَ","عَلَيۡنَا","بِعَزِيزٖ"],"ḳалуу йашу`айбу ма нафḳаху касиирам мимма таḳуулу ва'инна ланарака фиина да`иифан валаула рахтука ларажамнака вама анта `алайна би`азииз","Они сказали: «О Шуейб! Многое из того, что ты говоришь, нам непонятно. Мы считаем тебя слабым среди нас. Если бы не твой род, мы побили бы тебя камнями. Ты нисколько не дорог нам».",["сказали они","о Шуайб","не","понимаем мы","многого","из того, что","говоришь ты","и поистине, мы","непременно видим тебя","среди нас","слабым","и если бы не","род твой","непременно побили бы мы тебя камнями","и не","ты","для нас","дорог"]],[11,92,["قَالَ","يَٰقَوۡمِ","أَرَهۡطِيٓ","أَعَزُّ","عَلَيۡكُم","مِّنَ","ٱللَّهِ","وَٱتَّخَذۡتُمُوهُ","وَرَآءَكُمۡ","ظِهۡرِيًّاۖ","إِنَّ","رَبِّي","بِمَا","تَعۡمَلُونَ","مُحِيطٞ"],"ḳала йаḳауми арахтии а`аззу `алайкум миналлахи ваттахазтумууху вараакум зихриййан инна раббии бима та`малууна мухиит","Он сказал: «О мой народ! Неужели мой род дороже для вас, чем Аллах? Вы оставили Его за спиной, а ведь мой Господь объемлет то, что вы совершаете.",["сказал он","о народ мой","неужели род мой","дороже","для вас","чем","Аллах","и взяли вы Его","позади вас","отброшенным за спину","поистине","Господь мой","то, что","делаете вы","объемлет"]],[11,93,["وَيَٰقَوۡمِ","ٱعۡمَلُواْ","عَلَىٰ","مَكَانَتِكُمۡ","إِنِّي","عَٰمِلٞۖ","سَوۡفَ","تَعۡلَمُونَ","مَن","يَأۡتِيهِ","عَذَابٞ","يُخۡزِيهِ","وَمَنۡ","هُوَ","كَٰذِبٞۖ","وَٱرۡتَقِبُوٓاْ","إِنِّي","مَعَكُمۡ","رَقِيبٞ"],"вайаḳауми`малуу `ала маканатикум иннии `амилун сауфа та`ламууна ман йа'тиихи `азабун йухзиихи ваман хуа казибун вартаḳибуу иннии ма`акум раḳииб","О мой народ! Действуйте по своему усмотрению, и я тоже буду действовать. Вы скоро узнаете, кого постигнут унизительные мучения и кто является лжецом. Ждите, и я подожду вместе с вами».",["и о народ мой","действуйте","по","положению вашему","поистине, я","действующий","скоро","узнаете вы","кого","постигнет","наказание","позорящее его","и кто","он","лжец","и ждите","поистине, я","с вами","ожидающий"]],[11,94,["وَلَمَّا","جَآءَ","أَمۡرُنَا","نَجَّيۡنَا","شُعَيۡبٗا","وَٱلَّذِينَ","ءَامَنُواْ","مَعَهُۥ","بِرَحۡمَةٖ","مِّنَّا","وَأَخَذَتِ","ٱلَّذِينَ","ظَلَمُواْ","ٱلصَّيۡحَةُ","فَأَصۡبَحُواْ","فِي","دِيَٰرِهِمۡ","جَٰثِمِينَ"],"валамма жаа амруна нажжайна шу`айбан валлазиина амануу ма`ахуу бирахматим минна ва'ахазатил лазиина заламус сайхату фа'асбахуу фии дийарихим жасимиин","Когда же явилось Наше веление, Мы по Своей милости спасли Шуейба и тех, кто уверовал вместе с ним. А беззаконников поразил ужасный вопль, и они оказались повергнуты ниц в своих домах,",["и когда","пришло","веление Наше","Мы спасли","Шуайба","и тех, которые","уверовали","с ним","по милости","от Нас","и постиг","тех, которые","поступали несправедливо","вопль","и стали они","в","жилищах своих","повергнутыми ниц"]],[11,95,["كَأَن","لَّمۡ","يَغۡنَوۡاْ","فِيهَآۗ","أَلَا","بُعۡدٗا","لِّمَدۡيَنَ","كَمَا","بَعِدَتۡ","ثَمُودُ"],"ка'ал лам йагнау фииха ала бу`дал лимадйана кама ба`идат самууд","словно они никогда не жили там. Да сгинут мадьяниты, как сгинули самудяне!",["словно","не","жили они","там","о да","да сгинут же","мадьяниты","как","сгинули","самудяне"]],[11,96,["وَلَقَدۡ","أَرۡسَلۡنَا","مُوسَىٰ","بِـَٔايَٰتِنَا","وَسُلۡطَٰنٖ","مُّبِينٍ"],"валаḳад арсална мууса би'айатина васултаним мубиин","Мы отправили Мусу (Моисея) с Нашими знамениями и явным доказательством",["и уже","Мы послали","Мусу","с знамениями Нашими","и властью","явной"]],[11,97,["إِلَىٰ","فِرۡعَوۡنَ","وَمَلَإِيْهِۦ","فَٱتَّبَعُوٓاْ","أَمۡرَ","فِرۡعَوۡنَۖ","وَمَآ","أَمۡرُ","فِرۡعَوۡنَ","بِرَشِيدٖ"],"ила фир`ауна вамалаихии фаттаба`уу амра фир`ауна вама амру фир`ауна бирашиид","к Фараону и его знати. Но они последовали повелению Фараона, хотя повеление Фараона было неразумным.",["к","Фараону","и знати его","но последовали они","приказу","Фараона","и не","приказ","Фараона","верный"]]],"m":[[["وَيَٰقَوۡمِ","и о народ мой",11,89],["لَا","пусть не",11,89],["يَجۡرِمَنَّكُمۡ","ввергнет вас",11,89],["شِقَاقِيٓ","разлад со мной",11,89],["أَن","в то, что",11,89],["يُصِيبَكُم","постигнет вас",11,89],["مِّثۡلُ","подобное",11,89],["مَآ","тому, что",11,89],["أَصَابَ","постигло",11,89]],[["قَوۡمَ","народ",11,89],["نُوحٍ","Нуха",11,89],["أَوۡ","или",11,89],["قَوۡمَ","народ",11,89],["هُودٍ","Худа",11,89],["أَوۡ","или",11,89],["قَوۡمَ","народ",11,89],["صَٰلِحٖۚ","Салиха",11,89],["وَمَا","и не",11,89],["قَوۡمُ","народ",11,89],["لُوطٖ","Лута",11,89],["مِّنكُم","от вас",11,89]],[["بِبَعِيدٖ","далёк",11,89],[89],["وَٱسۡتَغۡفِرُواْ","и просите прощения",11,90],["رَبَّكُمۡ","у Господа вашего",11,90],["ثُمَّ","затем",11,90],["تُوبُوٓاْ","кайтесь",11,90],["إِلَيۡهِۚ","Ему",11,90],["إِنَّ","поистине",11,90],["رَبِّي","Господь мой",11,90]],[["رَحِيمٞ","Милосерден",11,90],["وَدُودٞ","Любящий",11,90],[90],["قَالُواْ","сказали они",11,91],["يَٰشُعَيۡبُ","о Шуайб",11,91],["مَا","не",11,91],["نَفۡقَهُ","понимаем мы",11,91],["كَثِيرٗا","многого",11,91],["مِّمَّا","из того, что",11,91],["تَقُولُ","говоришь ты",11,91]],[["وَإِنَّا","и поистине, мы",11,91],["لَنَرَىٰكَ","непременно видим тебя",11,91],["فِينَا","среди нас",11,91],["ضَعِيفٗاۖ","слабым",11,91],["وَلَوۡلَا","и если бы не",11,91],["رَهۡطُكَ","род твой",11,91],["لَرَجَمۡنَٰكَۖ","непременно побили бы мы тебя камнями",11,91],["وَمَآ","и не",11,91],["أَنتَ","ты",11,91]],[["عَلَيۡنَا","для нас",11,91],["بِعَزِيزٖ","дорог",11,91],[91],["قَالَ","сказал он",11,92],["يَٰقَوۡمِ","о народ мой",11,92],["أَرَهۡطِيٓ","неужели род мой",11,92],["أَعَزُّ","дороже",11,92],["عَلَيۡكُم","для вас",11,92],["مِّنَ","чем",11,92]],[["ٱللَّهِ","Аллах",11,92],["وَٱتَّخَذۡتُمُوهُ","и взяли вы Его",11,92],["وَرَآءَكُمۡ","позади вас",11,92],["ظِهۡرِيًّاۖ","отброшенным за спину",11,92],["إِنَّ","поистине",11,92],["رَبِّي","Господь мой",11,92],["بِمَا","то, что",11,92],["تَعۡمَلُونَ","делаете вы",11,92]],[["مُحِيطٞ","объемлет",11,92],[92],["وَيَٰقَوۡمِ","и о народ мой",11,93],["ٱعۡمَلُواْ","действуйте",11,93],["عَلَىٰ","по",11,93],["مَكَانَتِكُمۡ","положению вашему",11,93],["إِنِّي","поистине, я",11,93],["عَٰمِلٞۖ","действующий",11,93]],[["سَوۡفَ","скоро",11,93],["تَعۡلَمُونَ","узнаете вы",11,93],["مَن","кого",11,93],["يَأۡتِيهِ","постигнет",11,93],["عَذَابٞ","наказание",11,93],["يُخۡزِيهِ","позорящее его",11,93],["وَمَنۡ","и кто",11,93],["هُوَ","он",11,93]],[["كَٰذِبٞۖ","лжец",11,93],["وَٱرۡتَقِبُوٓاْ","и ждите",11,93],["إِنِّي","поистине, я",11,93],["مَعَكُمۡ","с вами",11,93],["رَقِيبٞ","ожидающий",11,93],[93],["وَلَمَّا","и когда",11,94],["جَآءَ","пришло",11,94]],[["أَمۡرُنَا","веление Наше",11,94],["نَجَّيۡنَا","Мы спасли",11,94],["شُعَيۡبٗا","Шуайба",11,94],["وَٱلَّذِينَ","и тех, которые",11,94],["ءَامَنُواْ","уверовали",11,94],["مَعَهُۥ","с ним",11,94],["بِرَحۡمَةٖ","по милости",11,94],["مِّنَّا","от Нас",11,94],["وَأَخَذَتِ","и постиг",11,94]],[["ٱلَّذِينَ","тех, которые",11,94],["ظَلَمُواْ","поступали несправедливо",11,94],["ٱلصَّيۡحَةُ","вопль",11,94],["فَأَصۡبَحُواْ","и стали они",11,94],["فِي","в",11,94],["دِيَٰرِهِمۡ","жилищах своих",11,94],["جَٰثِمِينَ","повергнутыми ниц",11,94],[94]],[["كَأَن","словно",11,95],["لَّمۡ","не",11,95],["يَغۡنَوۡاْ","жили они",11,95],["فِيهَآۗ","там",11,95],["أَلَا","о да",11,95],["بُعۡدٗا","да сгинут же",11,95],["لِّمَدۡيَنَ","мадьяниты",11,95],["كَمَا","как",11,95],["بَعِدَتۡ","сгинули",11,95],["ثَمُودُ","самудяне",11,95],[95],["وَلَقَدۡ","и уже",11,96]],[["أَرۡسَلۡنَا","Мы послали",11,96],["مُوسَىٰ","Мусу",11,96],["بِـَٔايَٰتِنَا","с знамениями Нашими",11,96],["وَسُلۡطَٰنٖ","и властью",11,96],["مُّبِينٍ","явной",11,96],[96],["إِلَىٰ","к",11,97],["فِرۡعَوۡنَ","Фараону",11,97]],[["وَمَلَإِيْهِۦ","и знати его",11,97],["فَٱتَّبَعُوٓاْ","но последовали они",11,97],["أَمۡرَ","приказу",11,97],["فِرۡعَوۡنَۖ","Фараона",11,97],["وَمَآ","и не",11,97],["أَمۡرُ","приказ",11,97],["فِرۡعَوۡنَ","Фараона",11,97],["بِرَشِيدٖ","верный",11,97],[97]]]}