{"p":233,"j":12,"a":[[11,98,["يَقۡدُمُ","قَوۡمَهُۥ","يَوۡمَ","ٱلۡقِيَٰمَةِ","فَأَوۡرَدَهُمُ","ٱلنَّارَۖ","وَبِئۡسَ","ٱلۡوِرۡدُ","ٱلۡمَوۡرُودُ"],"йаḳдуму ḳаумахуу йаумал ḳийамати фа'аурадахумун нара ваби'сал вирдул маурууд","В День воскресения Фараон возглавит свой народ и поведет их в Огонь. Отвратительно то место, куда их поведут!",["возглавит он","народ свой","в День","воскресения","и привёл их","в Огонь","и скверно","водопой","к которому приводят"]],[11,99,["وَأُتۡبِعُواْ","فِي","هَٰذِهِۦ","لَعۡنَةٗ","وَيَوۡمَ","ٱلۡقِيَٰمَةِۚ","بِئۡسَ","ٱلرِّفۡدُ","ٱلۡمَرۡفُودُ"],"ва'утби`уу фии хазихии ла`натан вайаумал ḳийамати би'сар рифдул марфууд","Проклятия будут преследовать их здесь и в День воскресения. Отвратителен дар, которым их одарили!",["и были преследуемы они","в","этом (мире)","проклятием","и в День","воскресения","скверен","дар","дарованный"]],[11,100,["ذَٰلِكَ","مِنۡ","أَنۢبَآءِ","ٱلۡقُرَىٰ","نَقُصُّهُۥ","عَلَيۡكَۖ","مِنۡهَا","قَآئِمٞ","وَحَصِيدٞ"],"залика мин амбаил ḳура наḳуссухуу `алайка минха ḳаимун вахасиид","Это - некоторые из повествований о селениях, которые Мы рассказываем тебе. Одни из них все еще существуют, а другие уже скошены.",["это","из","вестей","о селениях","Мы рассказываем это","тебе","из них","стоящие","и скошенные"]],[11,101,["وَمَا","ظَلَمۡنَٰهُمۡ","وَلَٰكِن","ظَلَمُوٓاْ","أَنفُسَهُمۡۖ","فَمَآ","أَغۡنَتۡ","عَنۡهُمۡ","ءَالِهَتُهُمُ","ٱلَّتِي","يَدۡعُونَ","مِن","دُونِ","ٱللَّهِ","مِن","شَيۡءٖ","لَّمَّا","جَآءَ","أَمۡرُ","رَبِّكَۖ","وَمَا","زَادُوهُمۡ","غَيۡرَ","تَتۡبِيبٖ"],"вама заламнахум валакин заламуу анфусахум фама агнат `анхум алихатухумул латии йад`ууна мин дууниллахи мин шай'ил ламма жаа амру раббика вама задуухум гайра татбииб","Мы не были к ним несправедливы, однако они сами поступили несправедливо по отношению к себе. Когда явилось веление твоего Господа, божества, к которым они взывали вместо Аллаха, ничем не помогли им. Они не приумножили им ничего, кроме погибели.",["и не","Мы обидели их","но","обидели они","самих себя","и не","помогли","им","боги их","которых","призывали они","из","помимо","Аллаха","ни в","чём","когда","пришло","веление","Господа твоего","и не","прибавили они им","кроме","погибели"]],[11,102,["وَكَذَٰلِكَ","أَخۡذُ","رَبِّكَ","إِذَآ","أَخَذَ","ٱلۡقُرَىٰ","وَهِيَ","ظَٰلِمَةٌۚ","إِنَّ","أَخۡذَهُۥٓ","أَلِيمٞ","شَدِيدٌ"],"ваказалика ахзу раббика иза ахазал ḳура вахийа залиматун инна ахзахуу алиимун шадиид","Такой была Хватка твоего Господа, когда Он схватил селения, жители которых были несправедливы. Воистину, Хватка Его мучительна, сурова.",["и так","хватка","Господа твоего","когда","Он схватил","селения","а они","несправедливы","поистине","хватка Его","мучительна","сурова"]],[11,103,["إِنَّ","فِي","ذَٰلِكَ","لَأٓيَةٗ","لِّمَنۡ","خَافَ","عَذَابَ","ٱلۡأٓخِرَةِۚ","ذَٰلِكَ","يَوۡمٞ","مَّجۡمُوعٞ","لَّهُ","ٱلنَّاسُ","وَذَٰلِكَ","يَوۡمٞ","مَّشۡهُودٞ"],"инна фии залика ла'айатал лиман хафа `азабал ахирати залика йаумум мажмуу`ул лахун насу вазалика йаумум машхууд","Воистину, в этом - знамение для тех, кто страшится мучений в Последней жизни. Это будет день, когда будут собраны люди. Это будет день, когда все будут присутствовать.",["поистине","в","этом","непременно знамение","для того, кто","боялся","наказания","Последней жизни","это","день","соберутся","ради него","люди","и это","день","засвидетельствованный"]],[11,104,["وَمَا","نُؤَخِّرُهُۥٓ","إِلَّا","لِأَجَلٖ","مَّعۡدُودٖ"],"вама ну'аххирухуу илла ли'ажалим ма`дууд","Мы отсрочим его лишь до определенного срока.",["и не","Мы отсрочиваем его","кроме как","до срока","исчисленного"]],[11,105,["يَوۡمَ","يَأۡتِ","لَا","تَكَلَّمُ","نَفۡسٌ","إِلَّا","بِإِذۡنِهِۦۚ","فَمِنۡهُمۡ","شَقِيّٞ","وَسَعِيدٞ"],"йаума йа'ти ла такалламу нафсун илла би'изнихии фаминхум шаḳиййун васа`иид","Когда этот день наступит, ни один человек не заговорит без Его соизволения. И среди них будут несчастные и счастливые.",["в день (когда)","придёт он","не","заговорит","душа","кроме как","с дозволения Его","и из них","несчастный","и счастливый"]],[11,106,["فَأَمَّا","ٱلَّذِينَ","شَقُواْ","فَفِي","ٱلنَّارِ","لَهُمۡ","فِيهَا","زَفِيرٞ","وَشَهِيقٌ"],"фа'аммал лазиина шаḳуу фафин нари лахум фииха зафиирун вашахииḳ","Несчастные пребудут в Огне, где они будут хрипеть и реветь.",["что же до","тех, которые","были несчастны","то в","Огне","им","в нём","хрип","и рёв"]],[11,107,["خَٰلِدِينَ","فِيهَا","مَا","دَامَتِ","ٱلسَّمَٰوَٰتُ","وَٱلۡأَرۡضُ","إِلَّا","مَا","شَآءَ","رَبُّكَۚ","إِنَّ","رَبَّكَ","فَعَّالٞ","لِّمَا","يُرِيدُ"],"халидиина фииха ма даматис самавату вал'арду илла ма шаа раббука инна раббака фа``алул лима йуриид","Они пребудут там вечно, пока существуют небеса и земля, если только твой Господь не пожелает иного. Воистину, твой Господь вершит то, что пожелает.",["вечно пребывая","в нём","пока","существуют","небеса","и земля","кроме","того, что","пожелал","Господь твой","поистине","Господь твой","вершитель","того, что","Он желает"]],[11,108,["وَأَمَّا","ٱلَّذِينَ","سُعِدُواْ","فَفِي","ٱلۡجَنَّةِ","خَٰلِدِينَ","فِيهَا","مَا","دَامَتِ","ٱلسَّمَٰوَٰتُ","وَٱلۡأَرۡضُ","إِلَّا","مَا","شَآءَ","رَبُّكَۖ","عَطَآءً","غَيۡرَ","مَجۡذُوذٖ"],"ва'аммал лазиина су`идуу фафил жаннати халидиина фииха ма даматис самавату вал'арду илла ма шаа раббука `атаан гайра мажзууз","Счастливые же пребудут в Раю. Они пребудут там вечно, пока существуют небеса и земля, если только твой Господь не пожелает иного. Это будет неиссякаемый дар.",["а что до","тех, которые","были счастливы","то в","Раю","вечно пребывая","в нём","пока","существуют","небеса","и земля","кроме","того, что","пожелал","Господь твой","даром","не","прерываемым"]]],"m":[[["يَقۡدُمُ","возглавит он",11,98],["قَوۡمَهُۥ","народ свой",11,98],["يَوۡمَ","в День",11,98],["ٱلۡقِيَٰمَةِ","воскресения",11,98],["فَأَوۡرَدَهُمُ","и привёл их",11,98],["ٱلنَّارَۖ","в Огонь",11,98],["وَبِئۡسَ","и скверно",11,98],["ٱلۡوِرۡدُ","водопой",11,98]],[["ٱلۡمَوۡرُودُ","к которому приводят",11,98],[98],["وَأُتۡبِعُواْ","и были преследуемы они",11,99],["فِي","в",11,99],["هَٰذِهِۦ","этом (мире)",11,99],["لَعۡ