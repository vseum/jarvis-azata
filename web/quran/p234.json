{"p":234,"j":12,"a":[[11,109,["فَلَا","تَكُ","فِي","مِرۡيَةٖ","مِّمَّا","يَعۡبُدُ","هَٰٓؤُلَآءِۚ","مَا","يَعۡبُدُونَ","إِلَّا","كَمَا","يَعۡبُدُ","ءَابَآؤُهُم","مِّن","قَبۡلُۚ","وَإِنَّا","لَمُوَفُّوهُمۡ","نَصِيبَهُمۡ","غَيۡرَ","مَنقُوصٖ"],"фала таку фии мирйатим мимма йа`буду ха'улаи ма йа`будууна илла кама йа`буду абаухум мин ḳаблу ва'инна ламуаффуухум насиибахум гайра манḳуус","Не сомневайся в том, чему они поклоняются. Они поклоняются тем, кому прежде поклонялись их отцы. Воистину, Мы воздадим им сполна, без убавления.",["так не","будь","в","сомнении","относительно того, чему","поклоняются","эти","не","поклоняются они","кроме как","так же, как","поклонялись","отцы их","ещё","прежде","и поистине Мы","непременно воздадим им сполна","долю их","не","уменьшенную"]],[11,110,["وَلَقَدۡ","ءَاتَيۡنَا","مُوسَى","ٱلۡكِتَٰبَ","فَٱخۡتُلِفَ","فِيهِۚ","وَلَوۡلَا","كَلِمَةٞ","سَبَقَتۡ","مِن","رَّبِّكَ","لَقُضِيَ","بَيۡنَهُمۡۚ","وَإِنَّهُمۡ","لَفِي","شَكّٖ","مِّنۡهُ","مُرِيبٖ"],"валаḳад атайна муусал китаба фахтулифа фиихи валаула калиматун сабаḳат мир раббика лаḳудийа байнахум ва'иннахум лафии шакким минху мурииб","Мы даровали Мусе (Моисею) Писание, но по его поводу возникли разногласия. И если бы не было прежде Слова от твоего Господа, то спор их был бы решен. Воистину, они испытывают смутные сомнения относительно него (Корана).",["и уже","Мы дали","Мусе","Писание","и возникли разногласия","о нём","и если бы не","слово","опередившее","от","Господа твоего","непременно было бы решено","между ними","и поистине они","непременно в","сомнении","о нём","смутном"]],[11,111,["وَإِنَّ","كُلّٗا","لَّمَّا","لَيُوَفِّيَنَّهُمۡ","رَبُّكَ","أَعۡمَٰلَهُمۡۚ","إِنَّهُۥ","بِمَا","يَعۡمَلُونَ","خَبِيرٞ"],"ва'инна куллал ламма лайуаффийаннахум раббука а`малахум иннахуу бима йа`малууна хабиир","Воистину, твой Господь воздаст сполна каждому из них за его деяния, ведь Он знает о том, что они совершают.",["и поистине","каждому (из них)","непременно","непременно воздаст им сполна","Господь твой","за деяния их","поистине Он","о том, что","они делают","Сведущ"]],[11,112,["فَٱسۡتَقِمۡ","كَمَآ","أُمِرۡتَ","وَمَن","تَابَ","مَعَكَ","وَلَا","تَطۡغَوۡاْۚ","إِنَّهُۥ","بِمَا","تَعۡمَلُونَ","بَصِيرٞ"],"фастаḳим кама умирта ваман таба ма`ака вала татгау иннахуу бима та`малууна басиир","Будь же тверд на прямом пути, как тебе велено, вместе с теми, кто покаялся наряду с тобой. И не преступайте границ дозволенного, ибо Он видит то, что вы совершаете.",["так будь твёрд","как","тебе велено","и тот, кто","покаялся","с тобой","и не","преступайте","поистине Он","то, что","вы делаете","Видящий"]],[11,113,["وَلَا","تَرۡكَنُوٓاْ","إِلَى","ٱلَّذِينَ","ظَلَمُواْ","فَتَمَسَّكُمُ","ٱلنَّارُ","وَمَا","لَكُم","مِّن","دُونِ","ٱللَّهِ","مِنۡ","أَوۡلِيَآءَ","ثُمَّ","لَا","تُنصَرُونَ"],"вала таркануу илал лазиина заламуу фатамассакумун нару вама лакум мин дууниллахи мин аулийаа сумма ла тунсаруун","Не склоняйтесь на сторону беззаконников, дабы вас не коснулся Огонь. Нет у вас покровителей и помощников, кроме Аллаха, и тогда никто вам не окажет поддержки.",["и не","склоняйтесь","к","тем, которые","были несправедливы","и коснётся вас","Огонь","и нет","у вас","из","помимо","Аллаха","никаких","покровителей","затем","не","получите вы помощи"]],[11,114,["وَأَقِمِ","ٱلصَّلَوٰةَ","طَرَفَيِ","ٱلنَّهَارِ","وَزُلَفٗا","مِّنَ","ٱلَّيۡلِۚ","إِنَّ","ٱلۡحَسَنَٰتِ","يُذۡهِبۡنَ","ٱلسَّيِّـَٔاتِۚ","ذَٰلِكَ","ذِكۡرَىٰ","لِلذَّٰكِرِينَ"],"ва'аḳимис салавата тарафайин нахари вазулафам минал лайли иннал хасанати йузхибнас саййиати залика зикра лиззакириин","Совершай намаз в начале и конце дня и в некоторые часы ночи. Воистину, добрые деяния удаляют злодеяния. Это - Напоминание для поминающих.",["и совершай","намаз","на обоих концах","дня","и в часы","из","ночи","поистине","добрые дела","удаляют","злые дела","это","напоминание","для поминающих"]],[11,115,["وَٱصۡبِرۡ","فَإِنَّ","ٱللَّهَ","لَا","يُضِيعُ","أَجۡرَ","ٱلۡمُحۡسِنِينَ"],"васбир фа'инналлаха ла йудии`у ажрал мухсиниин","Терпи, ибо Аллах не теряет вознаграждения творящих добро.",["и терпи","ведь поистине","Аллах","не","теряет","награду","творящих добро"]],[11,116,["فَلَوۡلَا","كَانَ","مِنَ","ٱلۡقُرُونِ","مِن","قَبۡلِكُمۡ","أُوْلُواْ","بَقِيَّةٖ","يَنۡهَوۡنَ","عَنِ","ٱلۡفَسَادِ","فِي","ٱلۡأَرۡضِ","إِلَّا","قَلِيلٗا","مِّمَّنۡ","أَنجَيۡنَا","مِنۡهُمۡۗ","وَٱتَّبَعَ","ٱلَّذِينَ","ظَلَمُواْ","مَآ","أُتۡرِفُواْ","فِيهِ","وَكَانُواْ","مُجۡرِمِينَ"],"фалаула кана минал ḳурууни мин ḳабликум улуу баḳиййатин йанхауна `анил фасади фил арди илла ḳалиилам мимман анжайна минхум ваттаба`ал лазиина заламуу ма утрифуу фиихи вакануу мужримиин","Если бы только среди поколений, живших до вас, были мудрые люди, которые выступали бы против нечестия на земле. Такими были лишь немногие из числа тех, кого Мы спасли. А беззаконники последовали за тем, что было даровано им, и стали грешниками.",["так почему не","было","из","поколений","из","до вас","обладателей","благоразумия","удерживающих","от","нечестия","на","земле","кроме","немногих","из тех, кого","Мы спасли","из них","и последовали","те, которые","были несправедливы","за тем, что","им дана роскошь","в нём","и были они","грешниками"]],[11,117,["وَمَا","كَانَ","رَبُّكَ","لِيُهۡلِكَ","ٱلۡقُرَىٰ","بِظُلۡمٖ","وَأَهۡلُهَا","مُصۡلِحُونَ"],"вама кана раббука лийухликал ḳура бизулмин ва'ахлуха муслихуун","Твой Господь не станет губить города по несправедливости, если они праведны.",["и не","был","Господь твой","чтобы губить","селения","несправедливо","когда жители их","творят благо"]]],"m":[[["فَلَا","так не",11,109],["تَكُ","будь",11,109],["فِي","в",11,109],["مِرۡيَةٖ","сомнении",11,109],["مِّمَّا","относительно того, чему",11,109],["يَعۡبُدُ","поклоняются",11,109],["هَٰٓؤُلَآءِۚ","эти",11,109],["مَا","не",11,109],["يَعۡبُدُونَ","поклоняются они",11,109],["إِلَّا","кроме как",11,109],["كَمَا","так же, как",11,109],["يَعۡبُدُ","поклонялись",11,109]],[["ءَابَآؤُهُم","отцы их",11,109],["مِّن","ещё",11,109],["قَبۡلُۚ","прежде",11,109],["وَإِنَّا","и поистине Мы",11,109],["لَمُوَفُّوهُمۡ","непременно воздадим им сполна",11,109],["نَصِيبَهُمۡ","долю их",11,109],["غَيۡرَ","не",11,109],["مَنقُوصٖ","уменьшенную",11,109],[109]],[["وَلَقَدۡ","и уже",11,110],["ءَاتَيۡنَا","Мы дали",11,110],["مُوسَى","Мусе",11,110],["ٱلۡكِتَٰبَ","Писание",11,110],["فَٱخۡتُلِفَ","и возникли разногласия",11,110],["فِيهِۚ","о нём",11,110],["وَلَوۡلَا","и если бы не",11,110],["كَلِمَةٞ","слово",11,110]],[["سَبَقَتۡ","опередившее",11,110],["مِن","от",11,110],["رَّبِّكَ","Господа твоего",11,110],["لَقُضِيَ","непременно было бы решено",11,110],["بَيۡنَهُمۡۚ","между ними",11,110],["وَإِنَّهُمۡ","и поистине они",11,110],["لَفِي","непременно в",11,110],["شَكّٖ","сомнении",11,110],["مِّنۡهُ","о нём",11,110],["مُرِيبٖ","смутном",11,110]],[[110],["وَإِنَّ","и поистине",11,111],["كُلّٗا","каждому (из них)",11,111],["لَّمَّا","непременно",11,111],["لَيُوَفِّيَنَّهُمۡ","непременно воздаст им сполна",11,111],["رَبُّكَ","Господь твой",11,111],["أَعۡمَٰلَهُمۡۚ","за деяния их",11,111],["إِنَّهُۥ","поистине Он",11,111],["بِمَا","о том, что",11,111],["يَعۡمَلُونَ","они делают",11,111]],[["خَبِيرٞ","Сведущ",11,111],[111],["فَٱسۡتَقِمۡ","так будь твёрд",11,112],["كَمَآ","как",11,112],["أُمِرۡتَ","тебе велено",11,112],["وَمَن","и тот, кто",11,112],["تَابَ","покаялся",11,112],["مَعَكَ","с тобой",11,112],["وَلَا","и не",11,112],["تَطۡغَوۡاْۚ","преступайте",11,112]],[["إِنَّهُۥ","поистине Он",11,112],["بِمَا","то, что",11,112],["تَعۡمَلُونَ","вы делаете",11,112],["بَصِيرٞ","Видящий",11,112],[112],["وَلَا","и не",11,113],["تَرۡكَنُوٓاْ","склоняйтесь",11,113],["إِلَى","к",11,113],["ٱلَّذِينَ","тем, которые",11,113],["ظَلَمُواْ","были несправедливы",11,113]],[["فَتَمَسَّكُمُ","и коснётся вас",11,113],["ٱلنَّارُ","Огонь",11,113],["وَمَا","и нет",11,113],["لَكُم","у вас",11,113],["مِّن","из",11,113],["دُونِ","помимо",11,113],["ٱللَّهِ","Аллаха",11,113],["مِنۡ","никаких",11,113],["أَوۡلِيَآءَ","покровителей",11,113],["ثُمَّ","затем",11,113]],[["لَا","не",11,113],["تُنصَرُونَ","получите вы помощи",11,113],[113],["وَأَقِمِ","и совершай",11,114],["ٱلصَّلَوٰةَ","намаз",11,114],["طَرَفَيِ","на обоих концах",11,114],["ٱلنَّهَارِ","дня",11,114],["وَزُلَفٗا","и в часы",11,114],["مِّنَ","из",11,114]],[["ٱلَّيۡلِۚ","ночи",11,114],["إِنَّ","поистине",11,114],["ٱلۡحَسَنَٰتِ","добрые дела",11,114],["يُذۡهِبۡنَ","удаляют",11,114],["ٱلسَّيِّـَٔاتِۚ","злые дела",11,114],["ذَٰلِكَ","это",11,114],["ذِكۡرَىٰ","напоминание",11,114],["لِلذَّٰكِرِينَ","для поминающих",11,114]],[[114],["وَٱصۡبِرۡ","и терпи",11,115],["فَإِنَّ","ведь поистине",11,115],["ٱللَّهَ","Аллах",11,115],["لَا","не",11,115],["يُضِيعُ","теряет",11,115],["أَجۡرَ","награду",11,115],["ٱلۡمُحۡسِنِينَ","творящих добро",11,115],[115],["فَلَوۡلَا","так почему не",11,116]],[["كَانَ","было",11,116],["مِنَ","из",11,116],["ٱلۡقُرُونِ","поколений",11,116],["مِن","из",11,116],["قَبۡلِكُمۡ","до вас",11,116],["أُوْلُواْ","обладателей",11,116],["بَقِيَّةٖ","благоразумия",11,116],["يَنۡهَوۡنَ","удерживающих",11,116],["عَنِ","от",11,116],["ٱلۡفَسَادِ","нечестия",11,116]],[["فِي","на",11,116],["ٱلۡأَرۡضِ","земле",11,116],["إِلَّا","кроме",11,116],["قَلِيلٗا","немногих",11,116],["مِّمَّنۡ","из тех, кого",11,116],["أَنجَيۡنَا","Мы спасли",11,116],["مِنۡهُمۡۗ","из них",11,116],["وَٱتَّبَعَ","и последовали",11,116],["ٱلَّذِينَ","те, которые",11,116]],[["ظَلَمُواْ","были несправедливы",11,116],["مَآ","за тем, что",11,116],["أُتۡرِفُواْ","им дана роскошь",11,116],["فِيهِ","в нём",11,116],["وَكَانُواْ","и были они",11,116],["مُجۡرِمِينَ","грешниками",11,116],[116],["وَمَا","и не",11,117],["كَانَ","был",11,117]],[["رَبُّكَ","Господь твой",11,117],["لِيُهۡلِكَ","чтобы губить",11,117],["ٱلۡقُرَىٰ","селения",11,117],["بِظُلۡمٖ","несправедливо",11,117],["وَأَهۡلُهَا","когда жители их",11,117],["مُصۡلِحُونَ","творят благо",11,117],[117]]]}