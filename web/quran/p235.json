{"p":235,"j":12,"a":[[11,118,["وَلَوۡ","شَآءَ","رَبُّكَ","لَجَعَلَ","ٱلنَّاسَ","أُمَّةٗ","وَٰحِدَةٗۖ","وَلَا","يَزَالُونَ","مُخۡتَلِفِينَ"],"валау шаа раббука лажа`алан наса умматан вахидатан вала йазалууна мухталифиин","Если бы твой Господь захотел, то Он сделал бы человечество единой общиной верующих. Однако они не перестают вступать в противоречия,",["и если бы","пожелал","Господь твой","непременно сделал бы","людей","общиной","единой","но не","перестают они","расходиться"]],[11,119,["إِلَّا","مَن","رَّحِمَ","رَبُّكَۚ","وَلِذَٰلِكَ","خَلَقَهُمۡۗ","وَتَمَّتۡ","كَلِمَةُ","رَبِّكَ","لَأَمۡلَأَنَّ","جَهَنَّمَ","مِنَ","ٱلۡجِنَّةِ","وَٱلنَّاسِ","أَجۡمَعِينَ"],"илла мар рахима раббука вализалика халаḳахум ватаммат калимату раббика ла'амлаанна жаханнама минал жиннати ваннаси ажма`иин","за исключением тех, над кем смилостивился твой Господь. Он сотворил их для этого. Исполнится Слово твоего Господа: «Я непременно заполню Геенну джиннами и людьми - всеми вместе».",["кроме","тех, кого","помиловал","Господь твой","и для этого","Он сотворил их","и исполнилось","слово","Господа твоего","непременно Я заполню","Геенну","из","джиннов","и людей","всех вместе"]],[11,120,["وَكُلّٗا","نَّقُصُّ","عَلَيۡكَ","مِنۡ","أَنۢبَآءِ","ٱلرُّسُلِ","مَا","نُثَبِّتُ","بِهِۦ","فُؤَادَكَۚ","وَجَآءَكَ","فِي","هَٰذِهِ","ٱلۡحَقُّ","وَمَوۡعِظَةٞ","وَذِكۡرَىٰ","لِلۡمُؤۡمِنِينَ"],"вакуллан наḳуссу `алайка мин амбаир русули ма нусаббиту бихии фу'адака важаака фии хазихил хаḳḳу вамау`изатун вазикра лилму'миниин","Мы рассказываем тебе повествования о посланниках для того, чтобы укрепить ими твое сердце. В этой суре к тебе явились истина, увещевание и напоминание для верующих.",["и всё","Мы рассказываем","тебе","из","вестей","о посланниках","то, чем","Мы укрепляем","им","сердце твоё","и пришла к тебе","в","этой","истина","и увещевание","и напоминание","для верующих"]],[11,121,["وَقُل","لِّلَّذِينَ","لَا","يُؤۡمِنُونَ","ٱعۡمَلُواْ","عَلَىٰ","مَكَانَتِكُمۡ","إِنَّا","عَٰمِلُونَ"],"ваḳул лиллазиина ла йу'минууна`малуу `ала маканатикум инна `амилуун","Скажи тем, которые не веруют: «Действуйте по своему усмотрению, и мы тоже будем действовать.",["и скажи","тем, которые","не","веруют","действуйте","по","положению вашему","поистине мы","действующие"]],[11,122,["وَٱنتَظِرُوٓاْ","إِنَّا","مُنتَظِرُونَ"],"вантазируу инна мунтазируун","Выжидайте, и мы тоже будем выжидать».",["и ждите","поистине мы","ожидающие"]],[11,123,["وَلِلَّهِ","غَيۡبُ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِ","وَإِلَيۡهِ","يُرۡجَعُ","ٱلۡأَمۡرُ","كُلُّهُۥ","فَٱعۡبُدۡهُ","وَتَوَكَّلۡ","عَلَيۡهِۚ","وَمَا","رَبُّكَ","بِغَٰفِلٍ","عَمَّا","تَعۡمَلُونَ"],"валиллахи гайбус самавати вал'арди ва'илайхи йуржа`ул амру куллухуу фа`будху ватаваккал `алайхи вама раббука бигафилин `амма та`малуун","Аллаху ведомо сокровенное на небесах и на земле, и к Нему возвращаются дела. Посему поклоняйся Ему и уповай на Него, ибо Господь твой не находится в неведении о том, что вы совершаете.",["и Аллаху (принадлежит)","сокровенное","небес","и земли","и к Нему","возвращается","дело","всё оно","так поклоняйся Ему","и уповай","на Него","и не","Господь твой","беспечен","о том, что","вы делаете"]],[12,1,["الٓرۚ","تِلۡكَ","ءَايَٰتُ","ٱلۡكِتَٰبِ","ٱلۡمُبِينِ"],"лр тилка айатул китабил мубиин","Алиф. Лам. Ра. Это - аяты ясного Писания.",["Алиф Лям Ра","это","аяты","Писания","ясного"]],[12,2,["إِنَّآ","أَنزَلۡنَٰهُ","قُرۡءَٰنًا","عَرَبِيّٗا","لَّعَلَّكُمۡ","تَعۡقِلُونَ"],"инна анзалнаху ḳур'анан `арабиййал ла`аллакум та`ḳилуун","Воистину, Мы ниспослали его в виде Корана на арабском языке, чтобы вы могли понять его.",["поистине Мы","Мы ниспослали его","Кораном","арабским","чтобы вы","разумели"]],[12,3,["نَحۡنُ","نَقُصُّ","عَلَيۡكَ","أَحۡسَنَ","ٱلۡقَصَصِ","بِمَآ","أَوۡحَيۡنَآ","إِلَيۡكَ","هَٰذَا","ٱلۡقُرۡءَانَ","وَإِن","كُنتَ","مِن","قَبۡلِهِۦ","لَمِنَ","ٱلۡغَٰفِلِينَ"],"нахну наḳуссу `алайка ахсанал ḳасаси бима аухайна илайка хазал ḳур'ана ва'ин кунта мин ḳаблихии ламинал гафилиин","Мы рассказываем тебе самый прекрасный рассказ, внушая тебе в откровении этот Коран, хотя прежде ты был одним из тех, кто ничего не ведал об этом.",["Мы","рассказываем","тебе","лучший","из рассказов","тем, что","Мы внушили","тебе","этот","Коран","и хотя","ты был","до","него","непременно из","не ведающих"]],[12,4,["إِذۡ","قَالَ","يُوسُفُ","لِأَبِيهِ","يَٰٓأَبَتِ","إِنِّي","رَأَيۡتُ","أَحَدَ","عَشَرَ","كَوۡكَبٗا","وَٱلشَّمۡسَ","وَٱلۡقَمَرَ","رَأَيۡتُهُمۡ","لِي","سَٰجِدِينَ"],"из ḳала йуусуфу ли'абиихи йа'абати иннии ра'айту ахада `ашара каукабан вашшамса валḳамара ра'айтухум лии сажидиин","Вот Йусуф (Иосиф) сказал своему отцу: «О мой отец! Я видел одиннадцать звезд, солнце и луну. Я видел, как они поклонились мне».",["вот","сказал","Йусуф","отцу своему","о отец мой","поистине я","я видел","один-","-надцать","звёзд","и солнце","и луну","я видел их","мне","поклоняющимися"]]],"m":[[["وَلَوۡ","и если бы",11,118],["شَآءَ","пожелал",11,118],["رَبُّكَ","Господь твой",11,118],["لَجَعَلَ","непременно сделал бы",11,118],["ٱلنَّاسَ","людей",11,118],["أُمَّةٗ","общиной",11,118],["وَٰحِدَةٗۖ","единой",11,118],["وَلَا","но не",11,118],["يَزَالُونَ","перестают они",11,118],["مُخۡتَلِفِينَ","расходиться",11,118]],[[118],["إِلَّا","кроме",11,119],["مَن","тех, кого",11,119],["رَّحِمَ","помиловал",11,119],["رَبُّكَۚ","Господь твой",11,119],["وَلِذَٰلِكَ","и для этого",11,119],["خَلَقَهُمۡۗ","Он сотворил их",11,119],["وَتَمَّتۡ","и исполнилось",11,119],["كَلِمَةُ","слово",11,119],["رَبِّكَ","Господа твоего",11,119]],[["لَأَمۡلَأَنَّ","непременно Я заполню",11,119],["جَهَنَّمَ","Геенну",11,119],["مِنَ","из",11,119],["ٱلۡجِنَّةِ","джиннов",11,119],["وَٱلنَّاسِ","и людей",11,119],["أَجۡمَعِينَ","всех вместе",11,119],[119],["وَكُلّٗا","и всё",11,120],["نَّقُصُّ","Мы рассказываем",11,120]],[["عَلَيۡكَ","тебе",11,120],["مِنۡ","из",11,120],["أَنۢبَآءِ","вестей",11,120],["ٱلرُّسُلِ","о посланниках",11,120],["مَا","то, чем",11,120],["نُثَبِّتُ","Мы укрепляем",11,120],["بِهِۦ","им",11,120],["فُؤَادَكَۚ","сердце твоё",11,120],["وَجَآءَكَ","и пришла к тебе",11,120