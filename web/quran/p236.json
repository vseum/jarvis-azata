{"p":236,"j":12,"a":[[12,5,["قَالَ","يَٰبُنَيَّ","لَا","تَقۡصُصۡ","رُءۡيَاكَ","عَلَىٰٓ","إِخۡوَتِكَ","فَيَكِيدُواْ","لَكَ","كَيۡدًاۖ","إِنَّ","ٱلشَّيۡطَٰنَ","لِلۡإِنسَٰنِ","عَدُوّٞ","مُّبِينٞ"],"ḳала йабунаййа ла таḳсус ру'йака `ала ихватика файакиидуу лака кайдан иннаш шайтана лил'инсани `адуввум мубиин","Он сказал: «О сын мой! Не рассказывай этот сон своим братьям, а не то они замыслят против тебя дурное. Воистину, дьявол - явный враг человеку.",["он сказал","о сынок мой","не","рассказывай","сон твой","перед","братьями твоими","и замыслят они","против тебя","козни","поистине","шайтан","для человека","враг","явный"]],[12,6,["وَكَذَٰلِكَ","يَجۡتَبِيكَ","رَبُّكَ","وَيُعَلِّمُكَ","مِن","تَأۡوِيلِ","ٱلۡأَحَادِيثِ","وَيُتِمُّ","نِعۡمَتَهُۥ","عَلَيۡكَ","وَعَلَىٰٓ","ءَالِ","يَعۡقُوبَ","كَمَآ","أَتَمَّهَا","عَلَىٰٓ","أَبَوَيۡكَ","مِن","قَبۡلُ","إِبۡرَٰهِيمَ","وَإِسۡحَٰقَۚ","إِنَّ","رَبَّكَ","عَلِيمٌ","حَكِيمٞ"],"ваказалика йажтабиика раббука вайу`аллимука мин та'виилил ахадииси вайутимму ни`матахуу `алайка ва`ала али йа`ḳууба кама атаммаха `ала абавайка мин ḳаблу ибрахиима ва'исхаḳа инна раббака `алиимун хакиим","Твой Господь изберет тебя, научит тебя толковать сны и одарит совершенной милостью тебя и род Йакуба (Иакова), подобно тому, как еще раньше Он одарил совершенной милостью твоих отцов Ибрахима (Авраама) и Исхака (Исаака). Воистину, твой Господь - Знающий, Мудрый».",["и так","изберёт тебя","Господь твой","и научит тебя","из","толкования","рассказов","и завершит","милость Свою","над тобой","и над","родом","Йакуба","как","Он завершил её","над","двумя отцами твоими","ещё","прежде","Ибрахимом","и Исхаком","поистине","Господь твой","Знающий","Мудрый"]],[12,7,["لَّقَدۡ","كَانَ","فِي","يُوسُفَ","وَإِخۡوَتِهِۦٓ","ءَايَٰتٞ","لِّلسَّآئِلِينَ"],"ллаḳад кана фии йуусуфа ва'ихватихии айатул лиссаилиин","Безусловно, Йусуф (Иосиф) и его братья стали знамениями для тех, кто спрашивает.",["непременно уже","было","в","Йусуфе","и братьях его","знамения","для спрашивающих"]],[12,8,["إِذۡ","قَالُواْ","لَيُوسُفُ","وَأَخُوهُ","أَحَبُّ","إِلَىٰٓ","أَبِينَا","مِنَّا","وَنَحۡنُ","عُصۡبَةٌ","إِنَّ","أَبَانَا","لَفِي","ضَلَٰلٖ","مُّبِينٍ"],"из ḳалуу лайуусуфу ва'ахууху ахаббу ила абиина минна ванахну `усбатун инна абана лафии далалим мубиин","Вот они сказали: «Отец любит Йусуфа (Иосифа) и его брата больше, чем нас, хотя нас - целая группа. Воистину, наш отец пребывает в очевидном заблуждении.",["вот","они сказали","непременно Йусуф","и брат его","дороже","для","отца нашего","чем мы","а мы","группа","поистине","отец наш","непременно в","заблуждении","явном"]],[12,9,["ٱقۡتُلُواْ","يُوسُفَ","أَوِ","ٱطۡرَحُوهُ","أَرۡضٗا","يَخۡلُ","لَكُمۡ","وَجۡهُ","أَبِيكُمۡ","وَتَكُونُواْ","مِنۢ","بَعۡدِهِۦ","قَوۡمٗا","صَٰلِحِينَ"],"иḳтулуу йуусуфа авитрахууху ардан йахлу лакум важху абиикум ватакуунуу мим ба`дихии ḳауман салихиин","Убейте Йусуфа (Иосифа) или бросьте его на другой земле. Тогда лицо вашего отца целиком будет обращено к вам, а после этого вы будете праведными людьми».",["убейте","Йусуфа","или","бросьте его","в (какую-то) землю","освободится","для вас","лицо","отца вашего","и будете вы","после","этого","людьми","праведными"]],[12,10,["قَالَ","قَآئِلٞ","مِّنۡهُمۡ","لَا","تَقۡتُلُواْ","يُوسُفَ","وَأَلۡقُوهُ","فِي","غَيَٰبَتِ","ٱلۡجُبِّ","يَلۡتَقِطۡهُ","بَعۡضُ","ٱلسَّيَّارَةِ","إِن","كُنتُمۡ","فَٰعِلِينَ"],"ḳала ḳаилум минхум ла таḳтулуу йуусуфа ва'алḳууху фии гайабатил жубби йалтаḳитху ба`дус саййарати ин кунтум фа`илиин","Один из них сказал: «Не убивайте Йусуфа (Иосифа), а бросьте его на дно колодца, если вы решили действовать. Один из караванов вытащит его».",["сказал","говорящий","из них","не","убивайте","Йусуфа","и бросьте его","в","глубину","колодца","подберёт его","кто-то из","путников","если","вы","делающие"]],[12,11,["قَالُواْ","يَٰٓأَبَانَا","مَا","لَكَ","لَا","تَأۡمَ۬نَّا","عَلَىٰ","يُوسُفَ","وَإِنَّا","لَهُۥ","لَنَٰصِحُونَ"],"ḳалуу йа'абана ма лака ла та'манна `ала йуусуфа ва'инна лахуу ланасихуун","Они сказали: «О отец наш! Почему ты не доверяешь нам Йусуфа (Иосифа)? Воистину, мы желаем ему добра.",["они сказали","о отец наш","что","с тобой","не","доверяешь нам","насчёт","Йусуфа","а поистине мы","ему","непременно доброжелатели"]],[12,12,["أَرۡسِلۡهُ","مَعَنَا","غَدٗا","يَرۡتَعۡ","وَيَلۡعَبۡ","وَإِنَّا","لَهُۥ","لَحَٰفِظُونَ"],"арсилху ма`ана гадан йарта` вайал`аб ва'инна лахуу лахафизуун","Отпусти его завтра с нами, пусть он насладится и поиграет, а мы будем оберегать его».",["отпусти его","с нами","завтра","пусть порезвится","и поиграет","и поистине мы","его","непременно оберегающие"]],[12,13,["قَالَ","إِنِّي","لَيَحۡزُنُنِيٓ","أَن","تَذۡهَبُواْ","بِهِۦ","وَأَخَافُ","أَن","يَأۡكُلَهُ","ٱلذِّئۡبُ","وَأَنتُمۡ","عَنۡهُ","غَٰفِلُونَ"],"ḳала иннии лайахзунунии ан тазхабуу бихии ва'ахафу ан йа'кулахуз зи'бу ва'антум `анху гафилуун","Он сказал: «Мне грустно от того, что вы уведете его. Я боюсь, что волк растерзает его, когда вы оставите его без присмотра».",["он сказал","поистине я","непременно печалит меня","что","уведёте вы","его","и я боюсь","что","съест его","волк","а вы","о нём","невнимательны"]],[12,14,["قَالُواْ","لَئِنۡ","أَكَلَهُ","ٱلذِّئۡبُ","وَنَحۡنُ","عُصۡبَةٌ","إِنَّآ","إِذٗا","لَّخَٰسِرُونَ"],"ḳалуу ла'ин акалахуз зи'бу ванахну `усбатун инна изал лахасируун","Они сказали: «Если волк растерзает его, тогда как нас - целая группа, то мы действительно окажемся потерпевшими убыток».",["они сказали","если","съест его","волк","а мы","группа","поистине мы","тогда","непременно потерпевшие убыток"]]],"m":[[["قَالَ","он сказал",12,5],["يَٰبُنَيَّ","о сынок мой",12,5],["لَا","не",12,5],["تَقۡصُصۡ","рассказывай",12,5],["رُءۡيَاكَ","сон твой",12,5],["عَلَىٰٓ","перед",12,5],["إِخۡوَتِكَ","братьями твоими",12,5],["فَيَكِيدُواْ","и замыслят они",12,5],["لَكَ","против тебя",12,5],["كَيۡدًاۖ","козни",12,5]],[["إِنَّ","поистине",12,5],["ٱلشَّيۡطَٰنَ","шайтан",12,5],["لِلۡإِنسَٰنِ","для человека",12,5],["عَدُوّٞ","враг",12,5],["مُّبِينٞ","явный",12,5],[5],["وَكَذَٰلِكَ","и так",12,6],["يَجۡتَبِيكَ","изберёт тебя",12,6]],[["رَبُّكَ","Господь твой",12,6],["وَيُعَلِّمُكَ","и научит тебя",12,6],["مِن","из",12,6],["تَأۡوِيلِ","толкования",12,6],["ٱلۡأَحَادِيثِ","рассказов",12,6],["وَيُتِمُّ","и завершит",12,6],["نِعۡمَتَهُۥ","милость Свою",12,6],["عَلَيۡكَ","над тобой",12,6]],[["وَعَلَىٰٓ","и над",12,6],["ءَالِ","родом",12,6],["يَعۡقُوبَ","Йакуба",12,6],["كَمَآ","как",12,6],["أَتَمَّهَا","Он завершил её",12,6],["عَلَىٰٓ","над",12,6],["أَبَوَيۡكَ","двумя отцами твоими",12,6],["مِن","ещё",12,6],["قَبۡلُ","прежде",12,6],["إِبۡرَٰهِيمَ","Ибрахимом",12,6],["وَإِسۡحَٰقَۚ","и Исхаком",12,6]],[["إِنَّ","поистине",12,6],["رَبَّكَ","Господь твой",12,6],["عَلِيمٌ","Знающий",12,6],["حَكِيمٞ","Мудрый",12,6],[6],["۞ لَّقَدۡ","непременно уже",12,7],["كَانَ","было",12,7],["فِي","в",12,7],["يُوسُفَ","Йусуфе",12,7],["وَإِخۡوَتِهِۦٓ","и братьях его",12,7]],[["ءَايَٰتٞ","знамения",12,7],["لِّلسَّآئِلِينَ","для спрашивающих",12,7],[7],["إِذۡ","вот",12,8],["قَالُواْ","они сказали",12,8],["لَيُوسُفُ","непременно Йусуф",12,8],["وَأَخُوهُ","и брат его",12,8],["أَحَبُّ","дороже",12,8],["إِلَىٰٓ","для",12,8]],[["أَبِينَا","отца нашего",12,8],["مِنَّا","чем мы",12,8],["وَنَحۡنُ","а мы",12,8],["عُصۡبَةٌ","группа",12,8],["إِنَّ","поистине",12,8],["أَبَانَا","отец наш",12,8],["لَفِي","непременно в",12,8],["ضَلَٰلٖ","заблуждении",12,8],["مُّبِينٍ","явном",12,8],[8],["ٱقۡتُلُواْ","убейте",12,9]],[["يُوسُفَ","Йусуфа",12,9],["أَوِ","или",12,9],["ٱطۡرَحُوهُ","бросьте его",12,9],["أَرۡضٗا","в (какую-то) землю",12,9],["يَخۡلُ","освободится",12,9],["لَكُمۡ","для вас",12,9],["وَجۡهُ","лицо",12,9],["أَبِيكُمۡ","отца вашего",12,9],["وَتَكُونُواْ","и будете вы",12,9],["مِنۢ","после",12,9]],[["بَعۡدِهِۦ","этого",12,9],["قَوۡمٗا","людьми",12,9],["صَٰلِحِينَ","праведными",12,9],[9],["قَالَ","сказал",12,10],["قَآئِلٞ","говорящий",12,10],["مِّنۡهُمۡ","из них",12,10],["لَا","не",12,10],["تَقۡتُلُواْ","убивайте",12,10],["يُوسُفَ","Йусуфа",12,10]],[["وَأَلۡقُوهُ","и бросьте его",12,10],["فِي","в",12,10],["غَيَٰبَتِ","глубину",12,10]