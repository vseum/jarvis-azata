{"p":237,"j":12,"a":[[12,15,["فَلَمَّا","ذَهَبُواْ","بِهِۦ","وَأَجۡمَعُوٓاْ","أَن","يَجۡعَلُوهُ","فِي","غَيَٰبَتِ","ٱلۡجُبِّۚ","وَأَوۡحَيۡنَآ","إِلَيۡهِ","لَتُنَبِّئَنَّهُم","بِأَمۡرِهِمۡ","هَٰذَا","وَهُمۡ","لَا","يَشۡعُرُونَ"],"фаламма захабуу бихии ва'ажма`уу ан йаж`алууху фии гайабатил жубби ва'аухайна илайхи латунаббианнахум би'амрихим хаза вахум ла йаш`уруун","Когда они увели его и бросили на дно колодца, Мы внушили ему: «Ты непременно напомнишь им об этом поступке, когда они даже не узнают тебя».",["и когда","они ушли","с ним","и решили сообща","что","поместят его","в","глубину","колодца","и Мы внушили","ему","непременно ты сообщишь им","о деле их","этом","а они","не","сознают"]],[12,16,["وَجَآءُوٓ","أَبَاهُمۡ","عِشَآءٗ","يَبۡكُونَ"],"важауу абахум `ишаан йабкуун","Вечером они вернулись к своему отцу с плачем",["и пришли они","к отцу своему","вечером","плача"]],[12,17,["قَالُواْ","يَٰٓأَبَانَآ","إِنَّا","ذَهَبۡنَا","نَسۡتَبِقُ","وَتَرَكۡنَا","يُوسُفَ","عِندَ","مَتَٰعِنَا","فَأَكَلَهُ","ٱلذِّئۡبُۖ","وَمَآ","أَنتَ","بِمُؤۡمِنٖ","لَّنَا","وَلَوۡ","كُنَّا","صَٰدِقِينَ"],"ḳалуу йа'абана инна захабна настабиḳу ватаракна йуусуфа `инда мата`ина фа'акалахуз зи'бу вама анта биму'минил лана валау кунна садиḳиин","и сказали: «О отец наш! Мы соревновались, а Йусуфа (Иосифа) оставили стеречь наши вещи, и волк съел его. Ты все равно не поверишь нам, хотя мы говорим правду».",["они сказали","о отец наш","поистине мы","мы ушли","состязаясь","и оставили","Йусуфа","у","вещей наших","и съел его","волк","и не","ты","верящий","нам","даже если","мы были","правдивыми"]],[12,18,["وَجَآءُو","عَلَىٰ","قَمِيصِهِۦ","بِدَمٖ","كَذِبٖۚ","قَالَ","بَلۡ","سَوَّلَتۡ","لَكُمۡ","أَنفُسُكُمۡ","أَمۡرٗاۖ","فَصَبۡرٞ","جَمِيلٞۖ","وَٱللَّهُ","ٱلۡمُسۡتَعَانُ","عَلَىٰ","مَا","تَصِفُونَ"],"важауу `ала ḳамиисихии бидамин казибин ḳала бал саввалат лакум анфусукум амран фасабрун жамиилун валлахул муста`ану `ала ма тасифуун","Они показали лживую кровь на его рубашке, и он сказал: «О нет! Это ваши души ввели вас в соблазн, и лучше проявить терпение. Только Аллаха следует просить о помощи против того, что вы рассказали».",["и пришли они","на","рубашке его","с кровью","ложной","он сказал","нет","разукрасили","вам","души ваши","дело","так терпение","прекрасное","и Аллах","Тот, у Кого просят помощи","против","того, что","вы описываете"]],[12,19,["وَجَآءَتۡ","سَيَّارَةٞ","فَأَرۡسَلُواْ","وَارِدَهُمۡ","فَأَدۡلَىٰ","دَلۡوَهُۥۖ","قَالَ","يَٰبُشۡرَىٰ","هَٰذَا","غُلَٰمٞۚ","وَأَسَرُّوهُ","بِضَٰعَةٗۚ","وَٱللَّهُ","عَلِيمُۢ","بِمَا","يَعۡمَلُونَ"],"важаат саййаратун фа'арсалуу варидахум фа'адла далвахуу ḳала йабушра хаза гуламун ва'асаррууху бида`атан валлаху `алииму бима йа`малуун","Когда прибыл караван, они послали водоноса принести воды. Он опустил свое ведро и сказал: «Вот радость! Это же - мальчик!». Они спрятали его, чтобы продать. Но Аллах ведал о том, что они совершали.",["и пришёл","караван","и послали они","водоноса своего","и он опустил","ведро своё","он сказал","о радость","это","мальчик","и скрыли они его","как товар","и Аллах","Знающий","о том, что","они делают"]],[12,20,["وَشَرَوۡهُ","بِثَمَنِۭ","بَخۡسٖ","دَرَٰهِمَ","مَعۡدُودَةٖ","وَكَانُواْ","فِيهِ","مِنَ","ٱلزَّٰهِدِينَ"],"вашарауху бисамани бахсин дарахима ма`дуудатин вакануу фиихи миназ захидиин","Они (братья Йусуфа) продали его за ничтожную цену - всего за несколько дирхемов. Они не высоко оценили его.",["и продали его","за цену","ничтожную","дирхемов","считанных","и были они","в отношении него","из","не дорожащих"]],[12,21,["وَقَالَ","ٱلَّذِي","ٱشۡتَرَىٰهُ","مِن","مِّصۡرَ","لِٱمۡرَأَتِهِۦٓ","أَكۡرِمِي","مَثۡوَىٰهُ","عَسَىٰٓ","أَن","يَنفَعَنَآ","أَوۡ","نَتَّخِذَهُۥ","وَلَدٗاۚ","وَكَذَٰلِكَ","مَكَّنَّا","لِيُوسُفَ","فِي","ٱلۡأَرۡضِ","وَلِنُعَلِّمَهُۥ","مِن","تَأۡوِيلِ","ٱلۡأَحَادِيثِۚ","وَٱللَّهُ","غَالِبٌ","عَلَىٰٓ","أَمۡرِهِۦ","وَلَٰكِنَّ","أَكۡثَرَ","ٱلنَّاسِ","لَا","يَعۡلَمُونَ"],"ваḳалал лазиштараху мим мисра лимраатихии акримии масваху `аса ан йанфа`ана ау наттахизахуу валадан ваказалика макканна лийуусуфа фил арди валину`аллимахуу мин та'виилил ахадииси валлаху галибун `ала амрихии валакинна аксаран наси ла йа`ламуун","Тот житель Египта, который купил Йусуфа (Иосифа), сказал своей жене: «Относись к нему хорошо. Быть может, он принесет нам пользу, или же мы усыновим его». Так Мы утвердили Йусуфа (Иосифа) на земле и научили его толкованию снов. Аллах властен вершить Свои дела, однако большинство людей не ведает об этом.",["и сказал","тот, который","купил его","из","Египта","жене своей","окажи почёт","пребыванию его","может быть","что","принесёт пользу нам","или","возьмём его","сыном","и так","Мы утвердили","Йусуфа","на","земле","и чтобы Мы научили его","из","толкования","событий","и Аллах","одолевающий","над","делом Своим","но","большинство","людей","не","знают"]],[12,22,["وَلَمَّا","بَلَغَ","أَشُدَّهُۥٓ","ءَاتَيۡنَٰهُ","حُكۡمٗا","وَعِلۡمٗاۚ","وَكَذَٰلِكَ","نَجۡزِي","ٱلۡمُحۡسِنِينَ"],"валамма балага ашуддахуу атайнаху хукман ва`илман ваказалика нажзил мухсиниин","Когда Йусуф (Иосиф) достиг зрелого возраста, Мы даровали ему умение принимать решения и знание. Так Мы вознаграждаем творящих добро.",["и когда","он достиг","своей зрелости","Мы даровали ему","мудрость","и знание","и так","Мы вознаграждаем","творящих добро"]]],"m":[[["فَلَمَّا","и когда",12,15],["ذَهَبُواْ","они ушли",12,15],["بِهِۦ","с ним",12,15],["وَأَجۡمَعُوٓاْ","и решили сообща",12,15],["أَن","что",12,15],["يَجۡعَلُوهُ","поместят его",12,15],["فِي","в",12,15],["غَيَٰبَتِ","глубину",12,15],["ٱلۡجُبِّۚ","колодца",12,15],["وَأَوۡحَيۡنَآ","и Мы внушили",12,15]],[["إِلَيۡهِ","ему",12,15],["لَتُنَبِّئَنَّهُم","непременно ты сообщишь им",12,15],["بِأَمۡرِهِمۡ","о деле их",12,15],["هَٰذَا","этом",12,15],["وَهُمۡ","а они",12,15],["لَا","не",12,15],["يَشۡعُرُونَ","сознают",12,15],[15],["وَجَآءُوٓ","и пришли они",12,16]],[["أَبَاهُمۡ","к отцу своему",12,16],["عِشَآءٗ","вечером",12,16],["يَبۡكُونَ","плача",12,16],[16],["قَالُواْ","они сказали",12,17],["يَٰٓأَبَانَآ","о отец наш",12,17],["إِنَّا","поистине мы",12,17],["ذَهَبۡنَا","мы ушли",12,17],["نَسۡتَبِقُ","состязаясь",12,17]],[["وَتَرَكۡنَا","и оставили",12,17],["يُوسُفَ","Йусуфа",12,17],["عِندَ","у",12,17],["مَتَٰعِنَا","вещей наших",12,17],["فَأَكَلَهُ","и съел его",12,17],["ٱلذِّئۡبُۖ","волк",12,17],["وَمَآ","и не",12,17],["أَنتَ","ты",12,17]],[["بِمُؤۡمِنٖ","верящий",12,17],["لَّنَا","нам",12,17],["وَلَوۡ","даже если",12,17],["كُنَّا","мы были",12,17],["صَٰدِقِينَ","правдивыми",12,17],[17],["وَجَآءُو","и пришли они",12,18],["عَلَىٰ","на",12,18],["قَمِيصِهِۦ","рубашке его",12,18]],[["بِدَمٖ","с кровью",12,18],["كَذِبٖۚ","ложной",12,18],["قَالَ","он сказал",12,18],["بَلۡ","нет",12,18],["سَوَّلَتۡ","разукрасили",12,18],["لَكُمۡ","вам",12,18],["أَنفُسُكُمۡ","души ваши",12,18],["أَمۡرٗاۖ","дело",12,18],["فَصَبۡرٞ","так терпение",12,18],["جَمِيلٞۖ","прекрасное",12,18]],[["وَٱللَّهُ","и Аллах",12,18],["ٱلۡمُسۡتَعَانُ","Тот, у Кого просят помощи",12,18],["عَلَىٰ","против",12,18],["مَا","того, что",12,18],["تَصِفُونَ","вы описываете",12,18],[18],["وَجَآءَتۡ","и пришёл",12,19],["سَيَّارَةٞ","караван",12,19],["فَأَرۡسَلُواْ","и послали они",12,19]],[["وَارِدَهُمۡ","водоноса своего",12,19],["فَأَدۡلَىٰ","и он опустил",12,19],["دَلۡوَهُۥۖ","ведро своё",12,19],["قَالَ","он сказал",12,19],["يَٰبُشۡرَىٰ","о радость",12,19],["هَٰذَا","это",12,19],["غُلَٰمٞۚ","мальчик",12,19],["وَأَسَرُّوهُ","и скрыли они его",12,19],["بِضَٰعَةٗۚ","как товар",12,19]],[["وَٱللَّهُ","и Аллах",12,19],["عَلِيمُۢ","Знающий",12,19],["بِمَا","о том, что",12,19],["يَعۡمَلُونَ","они делают",12,19],[19],["وَشَرَوۡهُ","и продали его",12,20],["بِثَمَنِۭ","за цену",12,20],["بَخۡسٖ","ничтожную",12,20]],[["دَرَٰهِمَ","дирхемов",12,20],["مَعۡدُودَةٖ","считанных",12,20],["وَكَانُواْ","и были они",12,20],["فِيهِ","в отношении него",12,20],["مِنَ","из",12,20],["ٱلزَّٰهِدِينَ","не дорожащих",12,20],[20],["وَقَالَ","и сказал",12,21]],[["ٱلَّذِي","тот, который",12,21],["ٱشۡتَرَىٰهُ","купил его",12,21],["مِن","из",12,21],["مِّصۡرَ","Египта",12,21],["لِٱمۡرَأَتِهِۦٓ","жене своей",12,21],["أَكۡرِمِي","окажи почёт",12,21],["مَثۡوَىٰهُ","пребыванию его",12,21],["عَسَىٰٓ","может быть",12,21]],[["أَن","что",12,21],["يَنفَعَنَآ","принесёт пользу нам",12,21],["أَوۡ","или",12,21],["نَتَّخِذَهُۥ","возьмём его",12,21],["وَلَدٗاۚ","сыном",12,21],["وَكَذَٰلِكَ","и так",12,21],["مَكَّنَّا","Мы утвердили",12,21],["لِيُوسُفَ","Йусуфа",12,21],["فِي","на",12,21]],[["ٱلۡأَرۡضِ","земле",12,21],["وَلِنُعَلِّمَهُۥ","и чтобы Мы научили его",12,21],["مِن","из",12,21],["تَأۡوِيلِ","толкования",12,21],["ٱلۡأَحَادِيثِۚ","событий",12,21],["وَٱللَّهُ","и Аллах",12,21],["غَالِبٌ","одолевающий",12,21],["عَلَىٰٓ","над",12,21]],[["أَمۡرِهِۦ","делом Своим",12,21],["وَلَٰكِنَّ","но",12,21],["أَكۡثَرَ","большинство",12,21],["ٱلنَّاسِ","людей",12,21],["لَا","не",12,21],["يَعۡلَمُونَ","знают",12,21],[21],["وَلَمَّا","и когда",12,22],["بَلَغَ","он достиг",12,22]],[["أَشُدَّهُۥٓ","своей зрелости",12,22],["ءَاتَيۡنَٰهُ","Мы даровали ему",12,22],["حُكۡمٗا","мудрость",12,22],["وَعِلۡمٗاۚ","и знание",12,22],["وَكَذَٰلِكَ","и так",12,22],["نَجۡزِي","Мы вознаграждаем",12,22],["ٱلۡمُحۡسِنِينَ","творящих добро",12,22],[22]]]}