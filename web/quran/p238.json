{"p":238,"j":12,"a":[[12,23,["وَرَٰوَدَتۡهُ","ٱلَّتِي","هُوَ","فِي","بَيۡتِهَا","عَن","نَّفۡسِهِۦ","وَغَلَّقَتِ","ٱلۡأَبۡوَٰبَ","وَقَالَتۡ","هَيۡتَ","لَكَۚ","قَالَ","مَعَاذَ","ٱللَّهِۖ","إِنَّهُۥ","رَبِّيٓ","أَحۡسَنَ","مَثۡوَايَۖ","إِنَّهُۥ","لَا","يُفۡلِحُ","ٱلظَّٰلِمُونَ"],"варавадатхул латии хуа фии байтиха `ан нафсихии вагаллаḳатил абваба ваḳалат хайта лака ḳала ма`азаллахи иннахуу раббии ахсана масвайа иннахуу ла йуфлихуз залимуун","Женщина, в доме которой он жил, стала соблазнять его, заперла двери и сказала: «Иди ко мне». Он сказал: «Упаси Аллах! Ведь он - мой господин, обеспечивший мне прекрасную жизнь. Воистину, беззаконники не преуспеют».",["и соблазняла его","та, которая","он","в","доме её","насчёт","его самого","и заперла","двери","и сказала","иди же","тебе (говорю)","он сказал","убежище у","Аллаха","поистине он","господин мой","он сделал прекрасным","пребывание моё","поистине","не","преуспеют","несправедливые"]],[12,24,["وَلَقَدۡ","هَمَّتۡ","بِهِۦۖ","وَهَمَّ","بِهَا","لَوۡلَآ","أَن","رَّءَا","بُرۡهَٰنَ","رَبِّهِۦۚ","كَذَٰلِكَ","لِنَصۡرِفَ","عَنۡهُ","ٱلسُّوٓءَ","وَٱلۡفَحۡشَآءَۚ","إِنَّهُۥ","مِنۡ","عِبَادِنَا","ٱلۡمُخۡلَصِينَ"],"валаḳад хаммат бихии вахамма биха лаула ар ра'а бурхана раббихии казалика линасрифа `анхус сууа валфахшаа иннахуу мин `ибадинал мухласиин","Она возжелала его, и он возжелал бы ее, если бы не увидел знамение своего Господа. Так Мы отвратили от него зло и мерзость. Воистину, он был из числа Наших избранных (или искренних) рабов.",["и уже","она возжелала","его","и он возжелал бы","её","если бы не","то, что","он увидел","довод","Господа своего","так","чтобы Мы отвратили","от него","зло","и мерзость","поистине он","из","рабов Наших","избранных"]],[12,25,["وَٱسۡتَبَقَا","ٱلۡبَابَ","وَقَدَّتۡ","قَمِيصَهُۥ","مِن","دُبُرٖ","وَأَلۡفَيَا","سَيِّدَهَا","لَدَا","ٱلۡبَابِۚ","قَالَتۡ","مَا","جَزَآءُ","مَنۡ","أَرَادَ","بِأَهۡلِكَ","سُوٓءًا","إِلَّآ","أَن","يُسۡجَنَ","أَوۡ","عَذَابٌ","أَلِيمٞ"],"вастабаḳал баба ваḳаддат ḳамиисахуу мин дубурин ва'алфайа саййидаха ладал баби ḳалат ма жазау ман арада би'ахлика сууан илла ан йусжана ау `азабун алиим","Они бросились к двери, пытаясь опередить друг друга, и она порвала его рубаху со спины. У двери они встретили ее господина. Она сказала: «Как иначе можно покарать того, кто хотел причинить зло твоей жене, если не заточить его в темницу или не подвергнуть мучительным страданиям?!».",["и устремились оба наперегонки","к двери","и разорвала она","рубашку его","со","спины","и застали оба","господина её","у","двери","она сказала","каково","воздаяние","того, кто","пожелал","твоей семье","зла","кроме","того, что","будет заточён","или","наказание","мучительное"]],[12,26,["قَالَ","هِيَ","رَٰوَدَتۡنِي","عَن","نَّفۡسِيۚ","وَشَهِدَ","شَاهِدٞ","مِّنۡ","أَهۡلِهَآ","إِن","كَانَ","قَمِيصُهُۥ","قُدَّ","مِن","قُبُلٖ","فَصَدَقَتۡ","وَهُوَ","مِنَ","ٱلۡكَٰذِبِينَ"],"ḳала хийа равадатнии `ан нафсии вашахида шахидум мин ахлиха ин кана ḳамиисухуу ḳудда мин ḳубулин фасадаḳат вахуа минал казибиин","Он сказал: «Это она пыталась соблазнить меня». А свидетель из ее семьи сказал: «Если его рубаха разорвана спереди, то она говорит правду, а он - один из тех, кто лжет.",["он сказал","она","соблазняла меня","насчёт","меня самого","и засвидетельствовал","свидетель","из","семьи её","если","была","рубашка его","разорвана","с","переда","то правду сказала она","а он","из","лжецов"]],[12,27,["وَإِن","كَانَ","قَمِيصُهُۥ","قُدَّ","مِن","دُبُرٖ","فَكَذَبَتۡ","وَهُوَ","مِنَ","ٱلصَّٰدِقِينَ"],"ва'ин кана ḳамиисухуу ḳудда мин дубурин факазабат вахуа минас садиḳиин","А если его рубаха разорвана со спины, то она лжет, а он - один из тех, кто говорит правду».",["а если","была","рубашка его","разорвана","со","спины","то солгала она","а он","из","правдивых"]],[12,28,["فَلَمَّا","رَءَا","قَمِيصَهُۥ","قُدَّ","مِن","دُبُرٖ","قَالَ","إِنَّهُۥ","مِن","كَيۡدِكُنَّۖ","إِنَّ","كَيۡدَكُنَّ","عَظِيمٞ"],"фаламма ра'а ḳамиисахуу ḳудда мин дубурин ḳала иннахуу мин кайдикунна инна кайдакунна `азиим","Увидев, что его рубаха разорвана со спины, он сказал: «Воистину, все это - ваши женские козни. Воистину, ваши козни велики!",["и когда","он увидел","рубашку его","разорванной","со","спины","он сказал","поистине это","из","ваших козней","поистине","козни ваши","велики"]],[12,29,["يُوسُفُ","أَعۡرِضۡ","عَنۡ","هَٰذَاۚ","وَٱسۡتَغۡفِرِي","لِذَنۢبِكِۖ","إِنَّكِ","كُنتِ","مِنَ","ٱلۡخَاطِـِٔينَ"],"йуусуфу а`рид `ан хаза вастагфирии лизамбики иннаки кунти минал хати'иин","Йусуф (Иосиф), забудь об этом! А ты проси прощения за свое прегрешение, ибо ты совершила грех».",["Йусуф","отвернись","от","этого","а ты проси прощения","за грех свой","поистине ты","была","из","согрешивших"]],[12,30,["وَقَالَ","نِسۡوَةٞ","فِي","ٱلۡمَدِينَةِ","ٱمۡرَأَتُ","ٱلۡعَزِيزِ","تُرَٰوِدُ","فَتَىٰهَا","عَن","نَّفۡسِهِۦۖ","قَدۡ","شَغَفَهَا","حُبًّاۖ","إِنَّا","لَنَرَىٰهَا","فِي","ضَلَٰلٖ","مُّبِينٖ"],"ваḳала нисватун фил мадиинатимраатул `азиизи туравиду фатаха `ан нафсихии ḳад шагафаха хуббан инна ланараха фии далалим мубиин","Женщины в городе стали говорить: «Жена знатного мужа пыталась соблазнить своего юного раба! Она страстно возлюбила его, и мы полагаем, что она впала в очевидное заблуждение».",["и сказали","женщины","в","городе","жена","знатного","соблазняет","юношу своего","насчёт","его самого","уже","пленил он её","любовью","поистине мы","непременно видим её","в","заблуждении","явном"]]],"m":[[["وَرَٰوَدَتۡهُ","и соблазняла его",12,23],["ٱلَّتِي","та, которая",12,23],["هُوَ","он",12,23],["فِي","в",12,23],["بَيۡتِهَا","доме её",12,23],["عَن","насчёт",12,23],["نَّفۡسِهِۦ","его самого",12,23],["وَغَلَّقَتِ","и заперла",12,23],["ٱلۡأَبۡوَٰبَ","двери",12,23]],[["وَقَالَتۡ","и сказала",12,23],["هَيۡتَ","иди же",12,23],["لَكَۚ","тебе (говорю)",12,23],["قَالَ","он сказал",12,23],["مَعَاذَ","убежище у",12,23],["ٱللَّهِۖ","Аллаха",12,23],["إِنَّهُۥ","поистине он",12,23],["رَبِّيٓ","господин мой",12,23],["أَحۡسَنَ","он сделал прекрасным",12,23],["مَثۡوَايَۖ","пребывание моё",12,23]],[["إِنَّهُۥ","поистине",12,23],["لَا","не",12