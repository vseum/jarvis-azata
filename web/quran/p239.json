{"p":239,"j":12,"a":[[12,31,["فَلَمَّا","سَمِعَتۡ","بِمَكۡرِهِنَّ","أَرۡسَلَتۡ","إِلَيۡهِنَّ","وَأَعۡتَدَتۡ","لَهُنَّ","مُتَّكَـٔٗا","وَءَاتَتۡ","كُلَّ","وَٰحِدَةٖ","مِّنۡهُنَّ","سِكِّينٗا","وَقَالَتِ","ٱخۡرُجۡ","عَلَيۡهِنَّۖ","فَلَمَّا","رَأَيۡنَهُۥٓ","أَكۡبَرۡنَهُۥ","وَقَطَّعۡنَ","أَيۡدِيَهُنَّ","وَقُلۡنَ","حَٰشَ","لِلَّهِ","مَا","هَٰذَا","بَشَرًا","إِنۡ","هَٰذَآ","إِلَّا","مَلَكٞ","كَرِيمٞ"],"фаламма сами`ат бимакрихинна арсалат илайхинна ва'а`тадат лахунна муттакаан ва'атат кулла вахидатим минхунна сиккиинан ваḳалатихруж `алайхинна фаламма ра'айнахуу акбарнахуу ваḳатта`на айдийахунна ваḳулна хаша лиллахи ма хаза башаран ин хаза илла малакун кариим","Когда она услышала про их хитрость, то пригласила их, велела приготовить им подушки, дала каждой по ножу для фруктов и сказала: «Выйди к ним». Когда они увидели его, то так превознесли его, что порезали ножами себе руки и сказали: «Упаси Аллах! Да ведь это - не человек. Он - не кто иной, как благородный ангел».",["и когда","она услышала","о хитрости их","она послала","к ним","и приготовила","для них","ложа для трапезы","и дала","каждой","одной","из них","нож","и сказала","выйди","к ним","и когда","они увидели его","они возвеличили его","и порезали","руки свои","и сказали","упаси","Аллах","не","этот","человек","не","этот","кроме как","ангел","благородный"]],[12,32,["قَالَتۡ","فَذَٰلِكُنَّ","ٱلَّذِي","لُمۡتُنَّنِي","فِيهِۖ","وَلَقَدۡ","رَٰوَدتُّهُۥ","عَن","نَّفۡسِهِۦ","فَٱسۡتَعۡصَمَۖ","وَلَئِن","لَّمۡ","يَفۡعَلۡ","مَآ","ءَامُرُهُۥ","لَيُسۡجَنَنَّ","وَلَيَكُونٗا","مِّنَ","ٱلصَّٰغِرِينَ"],"ḳалат фазаликуннал лазии лумтуннании фиихи валаḳад равадттухуу `ан нафсихии фаста`сама валаил лам йаф`ал ма амурухуу лайусжананна валайакуунам минас сагириин","Она сказала: «Перед вами тот, из-за которого вы меня порицали. Я действительно пыталась его соблазнить, но он отказался. Но если он не выполнит мой приказ, то будет заточен в темницу и окажется в числе презренных».",["она сказала","вот это","тот, который","вы порицали меня","за него","и уже","я соблазняла его","насчёт","его самого","но он воздержался","и если","не","сделает он","то, что","я велю ему","непременно будет заточён","и непременно будет","из","униженных"]],[12,33,["قَالَ","رَبِّ","ٱلسِّجۡنُ","أَحَبُّ","إِلَيَّ","مِمَّا","يَدۡعُونَنِيٓ","إِلَيۡهِۖ","وَإِلَّا","تَصۡرِفۡ","عَنِّي","كَيۡدَهُنَّ","أَصۡبُ","إِلَيۡهِنَّ","وَأَكُن","مِّنَ","ٱلۡجَٰهِلِينَ"],"ḳала раббис сижну ахаббу илаййа мимма йад`уунании илайхи ва'илла тасриф `аннии кайдахунна асбу илайхинна ва'акум минал жахилиин","Он сказал: «Господи! Темница мне милее того, к чему меня призывают. Если Ты не отвратишь от меня их козни, то я уступлю им и окажусь в числе невежд».",["он сказал","Господи","темница","милее","мне","чем то, что","они зовут меня","к нему","и если не","отвратишь Ты","от меня","козни их","я склонюсь","к ним","и буду","из","невежд"]],[12,34,["فَٱسۡتَجَابَ","لَهُۥ","رَبُّهُۥ","فَصَرَفَ","عَنۡهُ","كَيۡدَهُنَّۚ","إِنَّهُۥ","هُوَ","ٱلسَّمِيعُ","ٱلۡعَلِيمُ"],"фастажаба лахуу раббухуу фасарафа `анху кайдахунна иннахуу хуас самии`ул `алиим","Господь ответил на его мольбу и отвратил от него их козни. Воистину, Он - Слышащий, Знающий.",["и ответил","ему","Господь его","и отвратил","от него","козни их","поистине Он","Он","Слышащий","Знающий"]],[12,35,["ثُمَّ","بَدَا","لَهُم","مِّنۢ","بَعۡدِ","مَا","رَأَوُاْ","ٱلۡأٓيَٰتِ","لَيَسۡجُنُنَّهُۥ","حَتَّىٰ","حِينٖ"],"сумма бада лахум мим ба`ди ма ра'авул айати лайасжунуннахуу хатта хиин","Они увидели его доказательства, но после этого все равно решили заточить его на некоторое время.",["затем","представилось","им","после","того","как","они увидели","знамения","непременно заточат его","до","(некоторого) времени"]],[12,36,["وَدَخَلَ","مَعَهُ","ٱلسِّجۡنَ","فَتَيَانِۖ","قَالَ","أَحَدُهُمَآ","إِنِّيٓ","أَرَىٰنِيٓ","أَعۡصِرُ","خَمۡرٗاۖ","وَقَالَ","ٱلۡأٓخَرُ","إِنِّيٓ","أَرَىٰنِيٓ","أَحۡمِلُ","فَوۡقَ","رَأۡسِي","خُبۡزٗا","تَأۡكُلُ","ٱلطَّيۡرُ","مِنۡهُۖ","نَبِّئۡنَا","بِتَأۡوِيلِهِۦٓۖ","إِنَّا","نَرَىٰكَ","مِنَ","ٱلۡمُحۡسِنِينَ"],"вадахала ма`ахус сижна фатайани ḳала ахадухума иннии арании а`сиру хамран ваḳалал ахару иннии арании ахмилу фауḳа ра'сии хубзан та'кулут тайру минху набби'на бита'виилихии инна нарака минал мухсиниин","Вместе с ним в темницу попали двое юношей. Один из них сказал: «Я видел, что выжимаю виноград». Другой сказал: «Я видел, что несу на голове хлеб, который клюют птицы. Поведай нам толкование этого, ибо мы считаем тебя одним из праведников».",["и вошли","с ним","в темницу","двое юношей","сказал","один из них","поистине я","вижу себя","выжимаю","вино","и сказал","другой","поистине я","вижу себя","несу","над","головой моей","хлеб","клюют","птицы","из него","сообщи нам","о толковании его","поистине мы","видим тебя","из","творящих добро"]],[12,37,["قَالَ","لَا","يَأۡتِيكُمَا","طَعَامٞ","تُرۡزَقَانِهِۦٓ","إِلَّا","نَبَّأۡتُكُمَا","بِتَأۡوِيلِهِۦ","قَبۡلَ","أَن","يَأۡتِيَكُمَاۚ","ذَٰلِكُمَا","مِمَّا","عَلَّمَنِي","رَبِّيٓۚ","إِنِّي","تَرَكۡتُ","مِلَّةَ","قَوۡمٖ","لَّا","يُؤۡمِنُونَ","بِٱللَّهِ","وَهُم","بِٱلۡأٓخِرَةِ","هُمۡ","كَٰفِرُونَ"],"ḳала ла йа'тиикума та`амун турзаḳанихии илла набба'тукума бита'виилихии ḳабла ан йа'тийакума заликума мимма `алламании раббии иннии таракту миллата ḳаумил ла йу'минууна биллахи вахум бил'ахирати хум кафируун","Он сказал: «Не успеют принести еду, которой вас кормят, как еще раньше я растолкую ваши сновидения. Это - часть того, чему научил меня мой Господь. Воистину, я отрекся от религии людей, которые не веруют в Аллаха и не признают Последнюю жизнь.",["он сказал","не","придёт к вам двоим","еда","которой вас кормят","как","я сообщу вам двоим","его толкование","прежде","чем","она придёт к вам","это","из того, что","научил меня","мой Господь","поистине, я","оставил","религию","людей","не","веруют","в Аллаха","и они","в Последнюю жизнь","они","неверующие"]]],"m":[[["فَلَمَّا","и когда",12,31],["سَمِعَتۡ","она услышала",12,31],["بِمَكۡرِهِنَّ","о хитрости их",12,31],["أَرۡسَلَتۡ","она послала",12,31],["إِلَيۡهِنَّ","к ним",12,31],["وَأَعۡتَدَتۡ","и приготовила",12,31],["لَهُنَّ","для них",12,31],["مُتَّكَـٔٗا","ложа для трапезы",12,31],["وَءَاتَتۡ","и дала",12,31]],[["كُلَّ","каждой",12,31],["وَٰحِدَةٖ","одной",12,31],["مِّنۡهُنَّ","из них",12,31],["سِكِّينٗا","нож",12,31],["وَقَالَتِ","и сказала",12,31],["ٱخۡرُجۡ","выйди",12,31],["عَلَيۡهِنَّۖ","к ним",12,31],["فَلَمَّا","и когда",12,31],["رَأَيۡنَهُۥٓ","они увидели его",12,31],["أَكۡبَرۡنَهُۥ","они возвеличили его",12,31]],[["وَقَطَّعۡنَ","и порезали",12,31],["أَيۡدِيَهُنَّ","руки свои",12,31],["وَقُلۡنَ","и сказали",12,31],["حَٰشَ","упаси",12,31],["لِلَّهِ","Аллах",12,31],["مَا","не",12,31],["هَٰذَا","этот",12,31],["بَشَرًا","человек",12,31],["إِنۡ","не",12,31],["هَٰذَآ","этот",12,31],["إِلَّا","кроме как",12,31],["مَلَكٞ","ангел",12,31]],[["كَرِيمٞ","благородный",12,31],[31],["قَالَتۡ","она сказала",12,32],["فَذَٰلِكُنَّ","вот это",12,32],["ٱلَّذِي","тот, который",12,32],["لُمۡتُنَّنِي","вы порицали меня",12,32],["فِيهِۖ","за него",12,32],["وَلَقَدۡ","и уже",12,32],["رَٰوَدتُّهُۥ","я соблазняла его",12,32],["عَن","насчёт",12,32]],[["نَّفۡسِهِۦ","его самого",12,32],["فَٱسۡتَعۡصَمَۖ","но он воздержался",12,32],["وَلَئِن","и если",12,32],["لَّمۡ","не",12,32],["يَفۡعَلۡ","сделает он",12,32],["مَآ","то, что",12,32],["ءَامُرُهُۥ","я велю ему",12,32],["لَيُسۡجَنَنَّ","непременно будет заточён",12,32],["وَلَيَكُونٗا","и непременно будет",12,32]],[["مِّنَ","из",12,32],["ٱلصَّٰغِرِينَ","униженных",12,32],[32],["قَالَ","он сказал",12,33],["رَبِّ","Господи",12,33],["ٱلسِّجۡنُ","темница",12,33],["أَحَبُّ","милее",12,33],["إِلَيَّ","мне",12,33],["مِمَّا","чем то, что",12,33],["يَدۡعُونَنِيٓ","они зовут меня",12,33]],[["إِلَيۡهِۖ","к нему",12,33],["وَإِلَّا","и если не",12,33],["تَصۡرِفۡ","отвратишь Ты",12,33],["عَنِّي","от меня",12,33],["كَيۡدَهُنَّ","козни их",12,33],["أَصۡبُ","я склонюсь",12,33],["إِلَيۡهِنَّ","к ним",12,33],["وَأَكُن","и буду",12,33],["مِّنَ","из",12,33],["ٱلۡجَٰهِلِينَ","невежд",12,33]],[[33],["فَٱسۡتَجَابَ","и ответил",12,34],["لَهُۥ","ему",12,34],["رَبُّهُۥ","Господь его",12,34],["فَصَرَفَ","и отвратил",12,34],["عَنۡهُ","от него",12,34],["كَيۡدَهُنَّۚ","козни их",12,34],["إِنَّهُۥ","поистине Он",12,34],["هُوَ","Он",12,34],["ٱلسَّمِيعُ","Слышащий",12,34]],[["ٱلۡعَلِيمُ","Знающий",12,34],[34],["ثُمَّ","затем",12,35],["بَدَا","представилось",12,35],["لَهُم","им",12,35],["مِّنۢ","после",12,35],["بَعۡدِ","того",12,35],["مَا","как",12,35],["رَأَوُاْ","они увидели",12,35],["ٱلۡأٓيَٰتِ","знамения",12,35],["لَيَسۡجُنُنَّهُۥ","непременно заточат его",12,35]],[["حَتَّىٰ","до",12,35],["حِينٖ","(некоторого) времени",12,35],[35],["وَدَخَلَ","и вошли",12,36],["مَعَهُ","с ним",12,36],["ٱلسِّجۡنَ","в темницу",12,36],["فَتَيَانِۖ","двое юношей",12,36],["قَالَ","сказал",12,36],["أَحَدُهُمَآ","один из них",12,36]],[["إِنِّيٓ","поистине я",12,36],["أَرَىٰنِيٓ","вижу себя",12,36],["أَعۡصِرُ","выжимаю",12,36],["خَمۡرٗاۖ","вино",12,36],["وَقَالَ","и сказал",12,36],["ٱلۡأٓخَرُ","другой",12,36],["إِنِّيٓ","поистине я",12,36],["أَرَىٰنِيٓ","вижу себя",12,36],["أَحۡمِلُ","несу",12,36],["فَوۡقَ","над",12,36]],[["رَأۡسِي","головой моей",12,36],["خُبۡزٗا","хлеб",12,36],["تَأۡكُلُ","клюют",12,36],["ٱلطَّيۡرُ","птицы",12,36],["مِنۡهُۖ","из него",12,36],["نَبِّئۡنَا","сообщи нам",12,36],["بِتَأۡوِيلِهِۦٓۖ","о толковании его",12,36],["إِنَّا","поистине мы",12,36],["نَرَىٰكَ","видим тебя",12,36],["مِنَ","из",12,36]],[["ٱلۡمُحۡسِنِينَ","творящих добро",12,36],[36],["قَالَ","он сказал",12,37],["لَا","не",12,37],["يَأۡتِيكُمَا","придёт к вам двоим",12,37],["طَعَامٞ","еда",12,37],["تُرۡزَقَانِهِۦٓ","которой вас кормят",12,37],["إِلَّا","как",12,37],["نَبَّأۡتُكُمَا","я сообщу вам двоим",12,37]],[["بِتَأۡوِيلِهِۦ","его толкование",12,37],["قَبۡلَ","прежде",12,37],["أَن","чем",12,37],["يَأۡتِيَكُمَاۚ","она придёт к вам",12,37],["ذَٰلِكُمَا","это",12,37],["مِمَّا","из того, что",12,37],["عَلَّمَنِي","научил меня",12,37],["رَبِّيٓۚ","мой Господь",12,37],["إِنِّي","поистине, я",12,37],["تَرَكۡتُ","оставил",12,37]],[["مِلَّةَ","религию",12,37],["قَ