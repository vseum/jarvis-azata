{"p":241,"j":12,"a":[[12,44,["قَالُوٓاْ","أَضۡغَٰثُ","أَحۡلَٰمٖۖ","وَمَا","نَحۡنُ","بِتَأۡوِيلِ","ٱلۡأَحۡلَٰمِ","بِعَٰلِمِينَ"],"ḳалуу адгасу ахламин вама нахну бита'виилил ахлами би`алимиин","Они сказали: «Это - бессвязные сны! Мы не умеем толковать такие сновидения».",["они сказали","спутанные","сны","и не","мы","в толковании","снов","знающие"]],[12,45,["وَقَالَ","ٱلَّذِي","نَجَا","مِنۡهُمَا","وَٱدَّكَرَ","بَعۡدَ","أُمَّةٍ","أَنَا۠","أُنَبِّئُكُم","بِتَأۡوِيلِهِۦ","فَأَرۡسِلُونِ"],"ваḳалал лазии нажа минхума ваддакара ба`да умматин ана унаббиукум бита'виилихии фа'арсилуун","Но тот из двух людей, который спасся, вдруг вспомнил его спустя много времени и сказал: «Я расскажу вам его толкование, только пошлите меня».",["и сказал","тот, который","спасся","из них двоих","и вспомнил","спустя","время","я","сообщу вам","его толкование","отправьте же меня"]],[12,46,["يُوسُفُ","أَيُّهَا","ٱلصِّدِّيقُ","أَفۡتِنَا","فِي","سَبۡعِ","بَقَرَٰتٖ","سِمَانٖ","يَأۡكُلُهُنَّ","سَبۡعٌ","عِجَافٞ","وَسَبۡعِ","سُنۢبُلَٰتٍ","خُضۡرٖ","وَأُخَرَ","يَابِسَٰتٖ","لَّعَلِّيٓ","أَرۡجِعُ","إِلَى","ٱلنَّاسِ","لَعَلَّهُمۡ","يَعۡلَمُونَ"],"йуусуфу аййухас сиддииḳу афтина фии саб`и баḳаратин симанин йа'кулухунна саб`ун `ижафун васаб`и сумбулатин худрин ва'ухара йабисатил ла`аллии аржи`у илан наси ла`аллахум йа`ламуун","Он сказал: «О Йусуф (Иосиф)! О правдивый муж! Поведай нам о семи тучных коровах, которых пожирают семь тощих, а также о семи зеленых колосьях и семи высохших, чтобы я вернулся к людям. Быть может, они уразумеют».",["Йусуф","о","правдивейший","разъясни нам","о","семи","коровах","тучных","поедают их","семь","тощих","и семи","колосьях","зелёных","и других","сухих","чтобы я","вернулся","к","людям","чтобы они","узнали"]],[12,47,["قَالَ","تَزۡرَعُونَ","سَبۡعَ","سِنِينَ","دَأَبٗا","فَمَا","حَصَدتُّمۡ","فَذَرُوهُ","فِي","سُنۢبُلِهِۦٓ","إِلَّا","قَلِيلٗا","مِّمَّا","تَأۡكُلُونَ"],"ḳала тазра`ууна саб`а синиина да'абан фама хасадттум фазарууху фии сумбулихии илла ḳалиилам мимма та'кулуун","Он сказал: «Семь лет подряд вы будете усердно сеять. То, что вы пожнете, оставляйте в колосьях, за исключением небольшого количества, которое вы будете есть.",["он сказал","вы будете сеять","семь","лет","подряд","а то, что","вы пожнёте","оставляйте его","в","его колосьях","кроме","немногого","из того, что","вы съедите"]],[12,48,["ثُمَّ","يَأۡتِي","مِنۢ","بَعۡدِ","ذَٰلِكَ","سَبۡعٞ","شِدَادٞ","يَأۡكُلۡنَ","مَا","قَدَّمۡتُمۡ","لَهُنَّ","إِلَّا","قَلِيلٗا","مِّمَّا","تُحۡصِنُونَ"],"сумма йа'тии мим ба`ди залика саб`ун шидадун йа'кулна ма ḳаддамтум лахунна илла ḳалиилам мимма тухсинуун","Затем наступят семь тяжелых лет, которые поедят то, что вы приготовите для них, кроме небольшого количества, которое вы сбережете.",["затем","придут","вслед","за","этим","семь","тяжёлых (лет)","съедят","то, что","вы запасли","для них","кроме","немногого","из того, что","вы сбережёте"]],[12,49,["ثُمَّ","يَأۡتِي","مِنۢ","بَعۡدِ","ذَٰلِكَ","عَامٞ","فِيهِ","يُغَاثُ","ٱلنَّاسُ","وَفِيهِ","يَعۡصِرُونَ"],"сумма йа'тии мим ба`ди залика `амун фиихи йугасун насу вафиихи йа`сируун","Вслед за ними наступит год, когда люди получат обильные дожди и будут выжимать плоды».",["затем","придёт","вслед","за","этим","год","в который","будут одарены дождём","люди","и в который","они будут выжимать"]],[12,50,["وَقَالَ","ٱلۡمَلِكُ","ٱئۡتُونِي","بِهِۦۖ","فَلَمَّا","جَآءَهُ","ٱلرَّسُولُ","قَالَ","ٱرۡجِعۡ","إِلَىٰ","رَبِّكَ","فَسۡـَٔلۡهُ","مَا","بَالُ","ٱلنِّسۡوَةِ","ٱلَّٰتِي","قَطَّعۡنَ","أَيۡدِيَهُنَّۚ","إِنَّ","رَبِّي","بِكَيۡدِهِنَّ","عَلِيمٞ"],"ваḳалал маликутуунии бихии фаламма жаахур расуулу ḳаларжи` ила раббика фас'алху ма балун нисватил латии ḳатта`на айдийахунна инна раббии бикайдихинна `алиим","Царь сказал: «Приведите его ко мне!». Когда к нему пришел посланец, он сказал: «Возвращайся к своему господину и спроси его, что стало с женщинами, которые порезали себе руки. Воистину, моему Господу известно об их кознях».",["и сказал","царь","приведите ко мне","его","когда же","пришёл к нему","посланец","он сказал","вернись","к","твоему господину","и спроси его","каково","положение","женщин","которые","порезали","свои руки","поистине","мой Господь","об их кознях","знающий"]],[12,51,["قَالَ","مَا","خَطۡبُكُنَّ","إِذۡ","رَٰوَدتُّنَّ","يُوسُفَ","عَن","نَّفۡسِهِۦۚ","قُلۡنَ","حَٰشَ","لِلَّهِ","مَا","عَلِمۡنَا","عَلَيۡهِ","مِن","سُوٓءٖۚ","قَالَتِ","ٱمۡرَأَتُ","ٱلۡعَزِيزِ","ٱلۡـَٰٔنَ","حَصۡحَصَ","ٱلۡحَقُّ","أَنَا۠","رَٰوَدتُّهُۥ","عَن","نَّفۡسِهِۦ","وَإِنَّهُۥ","لَمِنَ","ٱلصَّٰدِقِينَ"],"ḳала ма хатбукунна из равадттунна йуусуфа `ан нафсихии ḳулна хаша лиллахи ма `алимна `алайхи мин сууин ḳалатимраатул `азиизил ана хасхасал хаḳḳу ана равадттухуу `ан нафсихии ва'иннахуу ламинас садиḳиин","Он сказал: «Что вы скажете о том, как вы пытались соблазнить Йусуфа (Иосифа)?». Они ответили: «Упаси Аллах! Мы не знаем о нем ничего плохого». Жена знатного мужа сказала: «Теперь истина прояснилась. Это я пыталась соблазнить его, а он - один из тех, кто говорит правду.",["он сказал","каково","ваше дело","когда","вы склоняли","Йусуфа","от","его самого","они сказали","упаси","Аллах","не","мы знаем","за ним","никакого","зла","сказала","жена","вельможи","теперь","обнаружилась","истина","я","склоняла его","от","его самого","и поистине, он","непременно из","правдивых"]],[12,52,["ذَٰلِكَ","لِيَعۡلَمَ","أَنِّي","لَمۡ","أَخُنۡهُ","بِٱلۡغَيۡبِ","وَأَنَّ","ٱللَّهَ","لَا","يَهۡدِي","كَيۡدَ","ٱلۡخَآئِنِينَ"],"залика лийа`лама аннии лам ахунху билгайби ва'анналлаха ла йахдии кайдал хаиниин","Я признаюсь в этом для того, чтобы мой муж знал, что я не изменила ему в его отсутствие, и что Аллах не помогает козням изменников.",["это","чтобы он знал","что я","не","изменила ему","заочно","и что","Аллах","не","направляет","козни","изменников"]]],"m":[[["قَالُوٓاْ","они сказали",12,44],["أَضۡغَٰثُ","спутанные",12,44],["أَحۡلَٰمٖۖ","сны",12,44],["وَمَا","и не",12,44],["نَحۡنُ","мы",12,44],["بِتَأۡوِيلِ","в толковании",12,44],["ٱلۡأَحۡلَٰمِ","снов",12,44],["بِعَٰلِمِينَ","знающие",12,44],[44]],[["وَقَالَ","и сказал",12,45],["ٱلَّذِي","тот, который",12,45],["نَجَا","спасся",12,45],["مِنۡهُمَا","из них двоих",12,45],["وَٱدَّكَرَ","и вспомнил",12,45],["بَعۡدَ","спустя",12,45],["أُمَّةٍ","время",12,45],["أَنَا۠","я",12,45],["أُنَبِّئُكُم","сообщу вам",12,45],["بِتَأۡوِيلِهِۦ","его толкование",12,45]],[["فَأَرۡسِلُونِ","отправьте же меня",12,45],[45],["يُوسُفُ","Йусуф",12,46],["أَيُّهَا","о",12,46],["ٱلصِّدِّيقُ","правдивейший",12,46],["أَفۡتِنَا","разъясни нам",12,46],["فِي","о",12,46],["سَبۡعِ","семи",12,46],["بَقَرَٰتٖ","коровах",12,46]],[["سِمَانٖ","тучных",12,46],["يَأۡكُلُهُنَّ","поедают их",12,46],["سَبۡعٌ","семь",12,46],["عِجَافٞ","тощих",12,46],["وَسَبۡعِ","и семи",12,46],["سُنۢبُلَٰتٍ","колосьях",12,46],["خُضۡرٖ","зелёных",12,46]],[["وَأُخَرَ","и других",12,46],["يَابِسَٰتٖ","сухих",12,46],["لَّعَلِّيٓ","чтобы я",12,46],["أَرۡجِعُ","вернулся",12,46],["إِلَى","к",12,46],["ٱلنَّاسِ","людям",12,46],["لَعَلَّهُمۡ","чтобы они",12,46],["يَعۡلَمُونَ","узнали",12,46],[46],["قَالَ","он сказал",12,47]],[["تَزۡرَعُونَ","вы будете сеять",12,47],["سَبۡعَ","семь",12,47],["سِنِينَ","лет",12,47],["دَأَبٗا","подряд",12,47],["فَمَا","а то, что",12,47],["حَصَدتُّمۡ","вы пожнёте",12,47],["فَذَرُوهُ","оставляйте его",12,47],["فِي","в",12,47],["سُنۢبُلِهِۦٓ","его колосьях",12,47],["إِلَّا","кроме",12,47]],[["قَلِيلٗا","немногого",12,47],["مِّمَّا","из того, что",12,47],["تَأۡكُلُونَ","вы съедите",12,47],[47],["ثُمَّ","затем",12,48],["يَأۡتِي","придут",12,48],["مِنۢ","вслед",12,48],["بَعۡدِ","за",12,48],["ذَٰلِكَ","этим",12,48],["سَبۡعٞ","семь",12,48],["شِدَادٞ","тяжёлых (лет)",12,48],["يَأۡكُلۡنَ","съедят",12,48]],[["مَا","то, что",12,48],["قَدَّمۡتُمۡ","вы запасли",12,48],["لَهُنَّ","для них",12,48],["إِلَّا","кроме",12,48],["قَلِيلٗا","немногого",12,48],["مِّمَّا","из того, что",12,48],["تُحۡصِنُونَ","вы сбережёте",12,48],[48],["ثُمَّ","затем",12,49],["يَأۡتِي","придёт",12,49],["مِنۢ","вслед",12,49],["بَعۡدِ","за",12,49],["ذَٰلِكَ","этим",12,49]],[["عَامٞ","год",12,49],["فِيهِ","в который",12,49],["يُغَاثُ","будут одарены дождём",12,49],["ٱلنَّاسُ","люди",12,49],["وَفِيهِ","и в который",12,49],["يَعۡصِرُونَ","они будут выжимать",12,49],[49],["وَقَالَ","и сказал",12,50],["ٱلۡمَلِكُ","царь",12,50],["ٱئۡتُونِي","приведите ко мне",12,50]],[["بِهِۦۖ","его",12,50],["فَلَمَّا","когда же",12,50],["جَآءَهُ","пришёл к нему",12,50],["ٱلرَّسُولُ","посланец",12,50],["قَالَ","он сказал",12,50],["ٱرۡجِعۡ","вернись",12,50],["إِلَىٰ","к",12,50],["رَبِّكَ","твоему господину",12,50],["فَسۡـَٔلۡهُ","и спроси его",12,50],["مَا","каково",12,50],["بَالُ","положение",12,50]],[["ٱلنِّسۡوَةِ","женщин",12,50],["ٱلَّٰتِي","которые",12,50],["قَطَّعۡنَ","порезали",12,50],["أَيۡدِيَهُنَّۚ","свои руки",12,50],["إِنَّ","поистине",12,50],["رَبِّي","мой Господь",12,50],["بِكَيۡدِهِنَّ","об их кознях",12,50],["عَلِيمٞ","знающий",12,50],[50],["قَالَ","он сказал",12,51]],[["مَا","каково",12,51],["خَطۡبُكُنَّ","ваше дело",12,51],["إِذۡ","когда",12,51],["رَٰوَدتُّنَّ","вы склоняли",12,51],["يُوسُفَ","Йусуфа",12,51],["عَن","от",12,51],["نَّفۡسِهِۦۚ","его самого",12,51],["قُلۡنَ","они сказали",12,51],["حَٰشَ","упаси",12,51],["لِلَّهِ","Аллах",12,51]],[["مَا","не",12,51],["عَلِمۡنَا","мы знаем",12,51],["عَلَيۡهِ","за ним",12,51],["مِن","никакого",12,51],["سُوٓءٖۚ","зла",12,51],["قَالَتِ","сказала",12,51],["ٱمۡرَأَتُ","жена",12,51],["ٱلۡعَزِيزِ","вельможи",12,51],["ٱلۡـَٰٔنَ","теперь",12,51],["حَصۡحَصَ","обнаружилась",12,51]],[["ٱلۡحَقُّ","истина",12,51],["أَنَا۠","я",12,51],["رَٰوَدتُّهُۥ","склоняла его",12,51],["عَن","от",12,51],["نَّفۡسِهِۦ","его самого",12,51],["وَإِنَّهُۥ","и поистине, он",12,51],["لَمِنَ","непременно из",12,51],["ٱلصَّٰدِقِينَ","правдивых",12,51],[51],["ذَٰلِكَ","это",12,52]],[["لِيَعۡلَمَ","чтобы он знал",12,52],["أَنِّي","что я",12,52],["لَمۡ","не",12,52],["أَخُنۡهُ","изменила ему",12,52],["بِٱلۡغَيۡبِ","заочно",12,52],["وَأَنَّ","и что",12,52],["ٱللَّهَ","Аллах",12,52],["لَا","не",12,52],["يَهۡدِي","направляет",12,52],["كَيۡدَ","козни",12,52],["ٱلۡخَآئِنِينَ","изменников",12,52],[52]]]}