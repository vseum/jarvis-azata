{"p":242,"j":13,"a":[[12,53,["وَمَآ","أُبَرِّئُ","نَفۡسِيٓۚ","إِنَّ","ٱلنَّفۡسَ","لَأَمَّارَةُۢ","بِٱلسُّوٓءِ","إِلَّا","مَا","رَحِمَ","رَبِّيٓۚ","إِنَّ","رَبِّي","غَفُورٞ","رَّحِيمٞ"],"вама убарриу нафсии иннан нафса ла'аммарату биссууи илла ма рахима раббии инна раббии гафуурур рахиим","Я не оправдываю себя, ведь душа человека повелевает зло, если только мой Господь не проявит к ней милосердия. Воистину, мой Господь - Прощающий, Милосердный».",["и не","оправдываю","себя","поистине","душа","непременно побуждает","ко злу","кроме","того, что","помиловал","мой Господь","поистине","мой Господь","Прощающий","Милосердный"]],[12,54,["وَقَالَ","ٱلۡمَلِكُ","ٱئۡتُونِي","بِهِۦٓ","أَسۡتَخۡلِصۡهُ","لِنَفۡسِيۖ","فَلَمَّا","كَلَّمَهُۥ","قَالَ","إِنَّكَ","ٱلۡيَوۡمَ","لَدَيۡنَا","مَكِينٌ","أَمِينٞ"],"ваḳалал маликутуунии бихии астахлисху линафсии фаламма калламахуу ḳала иннакал йаума ладайна макиинун амиин","Царь сказал: «Приведите его ко мне. Я сделаю его своим приближенным». Побеседовав с ним, он сказал: «Сегодня при нас ты обрел положение и доверие».",["и сказал","царь","приведите ко мне","его","я приближу его","к себе","когда же","он поговорил с ним","он сказал","поистине, ты","сегодня","у нас","в почёте","доверенный"]],[12,55,["قَالَ","ٱجۡعَلۡنِي","عَلَىٰ","خَزَآئِنِ","ٱلۡأَرۡضِۖ","إِنِّي","حَفِيظٌ","عَلِيمٞ"],"ḳалаж`алнии `ала хазаинил арди иннии хафиизун `алиим","Он сказал: «Назначь меня управлять хранилищами земли, ибо я - знающий хранитель».",["он сказал","поставь меня","над","хранилищами","земли","поистине, я","хранитель","знающий"]],[12,56,["وَكَذَٰلِكَ","مَكَّنَّا","لِيُوسُفَ","فِي","ٱلۡأَرۡضِ","يَتَبَوَّأُ","مِنۡهَا","حَيۡثُ","يَشَآءُۚ","نُصِيبُ","بِرَحۡمَتِنَا","مَن","نَّشَآءُۖ","وَلَا","نُضِيعُ","أَجۡرَ","ٱلۡمُحۡسِنِينَ"],"ваказалика макканна лийуусуфа фил арди йатабаввау минха хайсу йашау нусиибу бирахматина ман нашау вала нудии`у ажрал мухсиниин","Так Мы наделили Йусуфа (Иосифа) властью на земле. Он мог поселиться там, где желал. Мы одаряем Своей милостью, кого пожелаем, и не теряем вознаграждения творящих добро.",["и так","Мы утвердили","Йусуфа","на","земле","он селился","в ней","где","пожелает","Мы наделяем","Нашей милостью","кого","Мы пожелаем","и не","Мы губим","награды","творящих добро"]],[12,57,["وَلَأَجۡرُ","ٱلۡأٓخِرَةِ","خَيۡرٞ","لِّلَّذِينَ","ءَامَنُواْ","وَكَانُواْ","يَتَّقُونَ"],"валаажрул ахирати хайрул лиллазиина амануу вакануу йаттаḳуун","Воистину, вознаграждение в Последней жизни лучше для тех, которые уверовали и были богобоязненны.",["и награда же","Последней жизни","лучше","для тех, которые","уверовали","и были","богобоязненны"]],[12,58,["وَجَآءَ","إِخۡوَةُ","يُوسُفَ","فَدَخَلُواْ","عَلَيۡهِ","فَعَرَفَهُمۡ","وَهُمۡ","لَهُۥ","مُنكِرُونَ"],"важаа ихвату йуусуфа фадахалуу `алайхи фа`арафахум вахум лахуу мункируун","Братья Йусуфа (Иосифа) прибыли в Египет и явились к нему. Он узнал их, а они его не узнали.",["и пришли","братья","Йусуфа","и вошли они","к нему","и он узнал их","а они","его","не узнали"]],[12,59,["وَلَمَّا","جَهَّزَهُم","بِجَهَازِهِمۡ","قَالَ","ٱئۡتُونِي","بِأَخٖ","لَّكُم","مِّنۡ","أَبِيكُمۡۚ","أَلَا","تَرَوۡنَ","أَنِّيٓ","أُوفِي","ٱلۡكَيۡلَ","وَأَنَا۠","خَيۡرُ","ٱلۡمُنزِلِينَ"],"валамма жаххазахум бижахазихим ḳалатуунии би'ахил лакум мин абиикум ала тарауна аннии ууфил кайла ва'ана хайрул мунзилиин","Снабдив их провизией, он сказал: «Привезите ко мне вашего брата по отцу. Разве вы не убедились, что я сполна наполняю меру и что я - самый гостеприимный из хозяев?",["и когда","он снарядил их","их припасами","он сказал","приведите ко мне","брата","вашего","от","вашего отца","разве не","видите вы","что я","полностью отмеряю","меру","и я","лучший","из гостеприимцев"]],[12,60,["فَإِن","لَّمۡ","تَأۡتُونِي","بِهِۦ","فَلَا","كَيۡلَ","لَكُمۡ","عِندِي","وَلَا","تَقۡرَبُونِ"],"фа'ил лам та'туунии бихии фала кайла лакум `индии вала таḳрабуун","Если же вы не привезете его ко мне, то я не стану отмеривать вам. И тогда даже не приближайтесь ко мне».",["а если","не","приведёте ко мне","его","то не будет","меры","для вас","у меня","и не","приблизитесь ко мне"]],[12,61,["قَالُواْ","سَنُرَٰوِدُ","عَنۡهُ","أَبَاهُ","وَإِنَّا","لَفَٰعِلُونَ"],"ḳалуу сануравиду `анху абаху ва'инна лафа`илуун","Они сказали: «Мы постараемся уговорить его отца. Мы непременно сделаем это».",["они сказали","мы будем уговаривать","о нём","его отца","и поистине, мы","непременно сделаем"]],[12,62,["وَقَالَ","لِفِتۡيَٰنِهِ","ٱجۡعَلُواْ","بِضَٰعَتَهُمۡ","فِي","رِحَالِهِمۡ","لَعَلَّهُمۡ","يَعۡرِفُونَهَآ","إِذَا","ٱنقَلَبُوٓاْ","إِلَىٰٓ","أَهۡلِهِمۡ","لَعَلَّهُمۡ","يَرۡجِعُونَ"],"ваḳала лифитйанихиж`алуу бида`атахум фии рихалихим ла`аллахум йа`рифуунаха изанḳалабуу ила ахлихим ла`аллахум йаржи`уун","Он велел своим слугам: «Положите их деньги во вьюки, чтобы они узнали о них, когда возвратятся к своим семьям. Быть может, они вернутся».",["и он сказал","своим слугам","положите","их товар","в","их вьюки","быть может, они","узнают его","когда","вернутся","к","своей семье","быть может, они","вернутся"]],[12,63,["فَلَمَّا","رَجَعُوٓاْ","إِلَىٰٓ","أَبِيهِمۡ","قَالُواْ","يَٰٓأَبَانَا","مُنِعَ","مِنَّا","ٱلۡكَيۡلُ","فَأَرۡسِلۡ","مَعَنَآ","أَخَانَا","نَكۡتَلۡ","وَإِنَّا","لَهُۥ","لَحَٰفِظُونَ"],"фаламма ража`уу ила абиихим ḳалуу йа'абана муни`а миннал кайлу фа'арсил ма`ана ахана нактал ва'инна лахуу лахафизуун","Вернувшись к отцу, они сказали: «Отец наш! Нам не будут больше отмеривать зерно. Отпусти с нами нашего брата, и мы получим свою меру. Воистину, мы будем оберегать его».",["и когда","они вернулись","к","своему отцу","они сказали","о наш отец","отказано","нам","в мере","так отправь","с нами","нашего брата","мы получим меру","и поистине, мы","его","непременно сбережём"]]],"m":[[["۞ وَمَآ","и не",12,53],["أُبَرِّئُ","оправдываю",12,53],["نَفۡسِيٓۚ","себя",12,53],["إِنَّ","поистине",12,53],["ٱلنَّفۡسَ","душа",12,53],["لَأَمَّارَةُۢ","непременно побуждает",12,53],["بِٱلسُّوٓءِ","ко злу",12,53],["إِلَّا","кроме",12,53],["مَا","того, что",12,53],["رَحِمَ","помиловал",12,53]],[["رَبِّيٓۚ","мой Господь",12,53],["إِنَّ","поистине",12,53],["رَبِّي","мой Господь",12,53],["غَفُورٞ","Прощающий",12,53],["رَّحِيمٞ","Милосердный",12,53],[53],["وَقَالَ","и сказал",12,54],["ٱلۡمَلِكُ","царь",12,54],["ٱئۡتُونِي","приведите ко мне",12,54],["بِهِۦٓ","его",12,54],["أَسۡتَخۡلِصۡهُ","я приближу его",12,54]],[["لِنَفۡسِيۖ","к себе",12,54],["فَلَمَّا","когда же",12,54],["كَلَّمَهُۥ","он поговорил с ним",12,54],["قَالَ","он сказал",12,54],["إِنَّكَ","поистине, ты",12,54],["ٱلۡيَوۡمَ","сегодня",12,54],["لَدَيۡنَا","у нас",12,54],["مَكِينٌ","в почёте",12,54],["أَمِينٞ","доверенный",12,54],[54],["قَالَ","он сказал",12,55]],[["ٱجۡعَلۡنِي","поставь меня",12,55],["عَلَىٰ","над",12,55],["خَزَآئِنِ","хранилищами",12,55],["ٱلۡأَرۡضِۖ","земли",12,55],["إِنِّي","поистине, я",12,55],["حَفِيظٌ","хранитель",12,55],["عَلِيمٞ","знающий",12,55],[55],["وَكَذَٰلِكَ","и так",12,56]],[["مَكَّنَّا","Мы утвердили",12,56],["لِيُوسُفَ","Йусуфа",12,56],["فِي","на",12,56],["ٱلۡأَرۡضِ","земле",12,56],["يَتَبَوَّأُ","он селился",12,56],["مِنۡهَا","в ней",12,56],["حَيۡثُ","где",12,56],["يَشَآءُۚ","пожелает",12,56],["نُصِيبُ","Мы наделяем",12,56]],[["بِرَحۡمَتِنَا","Нашей милостью",12,56],["مَن","кого",12,56],["نَّشَآءُۖ","Мы пожелаем",12,56],["وَلَا","и не",12,56],["نُضِيعُ","Мы губим",12,56],["أَجۡرَ","награды",12,56],["ٱلۡمُحۡسِنِينَ","творящих добро",12,56],[56],["وَلَأَجۡرُ","и награда же",12,57]],[["ٱلۡأٓخِرَةِ","Последней жизни",12,57],["خَيۡرٞ","лучше",12,57],["لِّلَّذِينَ","для тех, которые",12,57],["ءَامَنُواْ","уверовали",12,57],["وَكَانُواْ","и были",12,57],["يَتَّقُونَ","богобоязненны",12,57],[57],["وَجَآءَ","и пришли",12,58],["إِخۡوَةُ","братья",12,58]],[["يُوسُفَ","Йусуфа",12,58],["فَدَخَلُواْ","и вошли они",12,58],["عَلَيۡهِ","к нему",12,58],["فَعَرَفَهُمۡ","и он узнал их",12,58],["وَهُمۡ","а они",12,58],["لَهُۥ","его",12,58],["مُنكِرُونَ","не узнали",12,58],[58],["وَلَمَّا","и когда",12,59]],[["جَهَّزَهُم","он снарядил их",12,59],["بِجَهَازِهِمۡ","их припасами",12,59],["قَالَ","он сказал",12,59],["ٱئۡتُ