{"p":243,"j":13,"a":[[12,64,["قَالَ","هَلۡ","ءَامَنُكُمۡ","عَلَيۡهِ","إِلَّا","كَمَآ","أَمِنتُكُمۡ","عَلَىٰٓ","أَخِيهِ","مِن","قَبۡلُ","فَٱللَّهُ","خَيۡرٌ","حَٰفِظٗاۖ","وَهُوَ","أَرۡحَمُ","ٱلرَّٰحِمِينَ"],"ḳала хал аманукум `алайхи илла кама аминтукум `ала ахиихи мин ḳаблу фаллаху хайрун хафизан вахуа архамур рахимиин","Он сказал: «Неужели я доверю его вам так, как доверил прежде его брата? Аллах охраняет лучше. Он - Милосерднейший из милосердных».",["он сказал","разве","доверю я вам","его","иначе","как","я доверил вам","насчёт","его брата","ещё","прежде","но Аллах","лучший","Хранитель","и Он","Милосерднейший","из милостивых"]],[12,65,["وَلَمَّا","فَتَحُواْ","مَتَٰعَهُمۡ","وَجَدُواْ","بِضَٰعَتَهُمۡ","رُدَّتۡ","إِلَيۡهِمۡۖ","قَالُواْ","يَٰٓأَبَانَا","مَا","نَبۡغِيۖ","هَٰذِهِۦ","بِضَٰعَتُنَا","رُدَّتۡ","إِلَيۡنَاۖ","وَنَمِيرُ","أَهۡلَنَا","وَنَحۡفَظُ","أَخَانَا","وَنَزۡدَادُ","كَيۡلَ","بَعِيرٖۖ","ذَٰلِكَ","كَيۡلٞ","يَسِيرٞ"],"валамма фатахуу мата`ахум важадуу бида`атахум руддат илайхим ḳалуу йа'абана ма набгии хазихии бида`атуна руддат илайна ванамииру ахлана ванахфазу ахана ваназдаду кайла ба`иирин залика кайлун йасиир","Когда они развязали свои вьюки, то обнаружили, что их деньги были возвращены им. Они сказали: «Отец наш! Что еще можно пожелать? Нам вернули наши деньги. Мы обеспечим пропитанием наши семьи, сбережем нашего брата и получим вдобавок верблюжий вьюк. Эта мера не будет обременительной».",["и когда","они открыли","свою поклажу","они нашли","свой товар","возвращённым","им","они сказали","о наш отец","чего","мы желаем","вот","наш товар","возвращён","нам","и мы доставим провизию","нашей семье","и сбережём","нашего брата","и прибавим","меру","верблюда","это","мера","лёгкая"]],[12,66,["قَالَ","لَنۡ","أُرۡسِلَهُۥ","مَعَكُمۡ","حَتَّىٰ","تُؤۡتُونِ","مَوۡثِقٗا","مِّنَ","ٱللَّهِ","لَتَأۡتُنَّنِي","بِهِۦٓ","إِلَّآ","أَن","يُحَاطَ","بِكُمۡۖ","فَلَمَّآ","ءَاتَوۡهُ","مَوۡثِقَهُمۡ","قَالَ","ٱللَّهُ","عَلَىٰ","مَا","نَقُولُ","وَكِيلٞ"],"ḳала лан урсилахуу ма`акум хатта ту'тууни маусиḳам миналлахи лата'туннании бихии илла ан йухата бикум фаламма атауху маусиḳахум ḳалаллаху `ала ма наḳуулу вакиил","Он сказал: «Я не отпущу его с вами, пока вы не поклянетесь Аллахом, что непременно вернетесь с ним, если только вы не попадете в окружение». Когда же они поклялись ему, он сказал: «Аллах является Попечителем и Хранителем того, что мы сказали».",["он сказал","ни за что не","отправлю его","с вами","пока не","вы дадите мне","клятву","перед","Аллахом","что непременно приведёте ко мне","его","если только не","что","окружат","вас","когда же","дали они ему","свою клятву","он сказал","Аллах","над","тем, что","мы говорим","Попечитель"]],[12,67,["وَقَالَ","يَٰبَنِيَّ","لَا","تَدۡخُلُواْ","مِنۢ","بَابٖ","وَٰحِدٖ","وَٱدۡخُلُواْ","مِنۡ","أَبۡوَٰبٖ","مُّتَفَرِّقَةٖۖ","وَمَآ","أُغۡنِي","عَنكُم","مِّنَ","ٱللَّهِ","مِن","شَيۡءٍۖ","إِنِ","ٱلۡحُكۡمُ","إِلَّا","لِلَّهِۖ","عَلَيۡهِ","تَوَكَّلۡتُۖ","وَعَلَيۡهِ","فَلۡيَتَوَكَّلِ","ٱلۡمُتَوَكِّلُونَ"],"ваḳала йабаниййа ла тадхулуу мим бабин вахидин вадхулуу мин абвабим мутафарриḳатин вама угнии `анкум миналлахи мин шай'ин инил хукму илла лиллахи `алайхи таваккалту ва`алайхи фалйатаваккалил мутаваккилуун","Он сказал: «Сыновья мои! Не входите через одни ворота, а войдите через разные. Я ничем не смогу помочь вам вопреки воле Аллаха. Решение принимает только Аллах. На Него одного я уповаю, и пусть только на Него уповают уповающие».",["и он сказал","о мои сыновья","не","входите","через","ворота","одни","а входите","через","ворота","разные","и не","помогу","вам","против","Аллаха","ни в","чём","не","решение","кроме как","у Аллаха","на Него","я уповаю","и на Него","пусть уповают","уповающие"]],[12,68,["وَلَمَّا","دَخَلُواْ","مِنۡ","حَيۡثُ","أَمَرَهُمۡ","أَبُوهُم","مَّا","كَانَ","يُغۡنِي","عَنۡهُم","مِّنَ","ٱللَّهِ","مِن","شَيۡءٍ","إِلَّا","حَاجَةٗ","فِي","نَفۡسِ","يَعۡقُوبَ","قَضَىٰهَاۚ","وَإِنَّهُۥ","لَذُو","عِلۡمٖ","لِّمَا","عَلَّمۡنَٰهُ","وَلَٰكِنَّ","أَكۡثَرَ","ٱلنَّاسِ","لَا","يَعۡلَمُونَ"],"валамма дахалуу мин хайсу амарахум абуухум ма кана йугнии `анхум миналлахи мин шай'ин илла хажатан фии нафси йа`ḳууба ḳадаха ва'иннахуу лазуу `илмил лима `алламнаху валакинна аксаран наси ла йа`ламуун","Они вошли так, как им велел отец. Он ничем не мог помочь им вопреки воле Аллаха, но таким было желание души Йакуба (Иакова), которое он удовлетворил (или которое было удовлетворено). Воистину, он обладал знанием, поскольку Мы научили его, но большая часть людей не знает этого.",["и когда","они вошли","так","как","велел им","их отец","не","было","помогало","им","против","Аллаха","ни в","чём","лишь","желание","в","душе","Йакуба","он исполнил его","и поистине, он","непременно обладатель","знания","благодаря тому, что","Мы научили его","но","большинство","людей","не","знают"]],[12,69,["وَلَمَّا","دَخَلُواْ","عَلَىٰ","يُوسُفَ","ءَاوَىٰٓ","إِلَيۡهِ","أَخَاهُۖ","قَالَ","إِنِّيٓ","أَنَا۠","أَخُوكَ","فَلَا","تَبۡتَئِسۡ","بِمَا","كَانُواْ","يَعۡمَلُونَ"],"валамма дахалуу `ала йуусуфа ава илайхи ахаху ḳала иннии ана ахуука фала табтаис бима кануу йа`малуун","Когда они вошли к Йусуфу (Иосифу), он прижал к себе своего брата и сказал: «Воистину, я - твой брат. Пусть не печалит тебя то, что они совершали».",["и когда","они вошли","к","Йусуфу","он приютил","у себя","своего брата","он сказал","поистине, я","я","твой брат","так не","печалься","из-за того, что","они","делали"]]],"m":[[["قَالَ","он сказал",12,64],["هَلۡ","разве",12,64],["ءَامَنُكُمۡ","доверю я вам",12,64],["عَلَيۡهِ","его",12,64],["إِلَّا","иначе",12,64],["كَمَآ","как",12,64],["أَمِنتُكُمۡ","я доверил вам",12,64],["عَلَىٰٓ","насчёт",12,64],["أَخِيهِ","его брата",12,64],["مِن","ещё",12,64]],[["قَبۡلُ","прежде",12,64],["فَٱللَّهُ","но Аллах",12,64],["خَيۡرٌ","лучший",12,64],["حَٰفِظٗاۖ","Хранитель",12,64],["وَهُوَ","и Он",12,64],["أَرۡحَمُ","Милосерднейший",12,64],["ٱلرَّٰحِمِينَ","из милостивых",12,64],[64],["وَلَمَّا","и когда",12,65],["فَتَحُواْ","они открыли",12,65]],[["مَتَٰعَهُمۡ","свою поклажу",12,65],["وَجَدُواْ","они нашли",12,65],["بِضَٰعَتَهُمۡ","свой товар",12,65],["رُدَّتۡ","возвращённым",12,65],["إِلَيۡهِمۡۖ","им",12,65],["قَالُواْ","они сказали",12,65],["يَٰٓأَبَانَا","о наш отец",12,65]],[["مَا","чего",12,65],["نَبۡغِيۖ","мы желаем",12,65],["هَٰذِهِۦ","вот",12,65],["بِضَٰعَتُنَا","наш товар",12,65],["رُدَّتۡ","возвращён",12,65],["إِلَيۡنَاۖ","нам",12,65],["وَنَمِيرُ","и мы доставим провизию",12,65],["أَهۡلَنَا","нашей семье",12,65],["وَنَحۡفَظُ","и сбережём",12,65]],[["أَخَانَا","нашего брата",12,65],["وَنَزۡدَادُ","и прибавим",12,65],["كَيۡلَ","меру",12,65],["بَعِيرٖۖ","верблюда",12,65],["ذَٰلِكَ","это",12,65],["كَيۡلٞ","мера",12,65],["يَسِيرٞ","лёгкая",12,65],[65],["قَالَ","он сказал",12,66],["لَنۡ","ни за что не",12,66]],[["أُرۡسِلَهُۥ","отправлю его",12,66],["مَعَكُمۡ","с вами",12,66],["حَتَّىٰ","пока не",12,66],["تُؤۡتُونِ","вы дадите мне",12,66],["مَوۡثِقٗا","клятву",12,66],["مِّنَ","перед",12,66],["ٱللَّهِ","Аллахом",12,66],["لَتَأۡتُنَّنِي","что непременно приведёте ко мне",12,66],["بِهِۦٓ","его",12,66],["إِلَّآ","если только не",12,66]],[["أَن","что",12,66],["يُحَاطَ","окружат",12,66],["بِكُمۡۖ","вас",12,66],["فَلَمَّآ","когда же",12,66],["ءَاتَوۡهُ","дали они ему",12,66],["مَوۡثِقَهُمۡ","свою клятву",12,66],["قَالَ","он сказал",12,66],["ٱللَّهُ","Аллах",12,66],["عَلَىٰ","над",12,66],["مَا","тем, что",12,66],["نَقُولُ","мы говорим",12,66],["وَكِيلٞ","Попечитель",12,66]],[[66],["وَقَالَ","и он сказал",12,67],["يَٰبَنِيَّ","о мои сыновья",12,67],["لَا","не",12,67],["تَدۡخُلُواْ","входите",12,67],["مِنۢ","через",12,67],["بَابٖ","ворота",12,67],["وَٰحِدٖ","одни",12,67],["وَٱدۡخُلُواْ","а входите",12,67],["مِنۡ","через",12,67],["أَبۡوَٰبٖ","ворота",12,67]],[["مُّتَفَرِّقَةٖۖ","разные",12,67],["وَمَآ","и не",12,67],["أُغۡنِي","помогу",12,67],["عَنكُم","вам",12,67],["مِّنَ","против",12,67],["ٱللَّهِ","Аллаха",12,67],["مِن","ни в",12,67],["شَيۡءٍۖ","чём",12,67],["إِنِ","не",12,67],["ٱلۡحُكۡمُ","решение",12,67],["إِلَّا","кроме как",12,67]],[["لِلَّهِۖ","у Аллаха",12,67],["عَلَيۡهِ