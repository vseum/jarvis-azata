{"p":244,"j":13,"a":[[12,70,["فَلَمَّا","جَهَّزَهُم","بِجَهَازِهِمۡ","جَعَلَ","ٱلسِّقَايَةَ","فِي","رَحۡلِ","أَخِيهِ","ثُمَّ","أَذَّنَ","مُؤَذِّنٌ","أَيَّتُهَا","ٱلۡعِيرُ","إِنَّكُمۡ","لَسَٰرِقُونَ"],"фаламма жаххазахум бижахазихим жа`алас сиḳайата фии рахли ахиихи сумма аззана му'аззинун аййатухал `ииру иннакум ласариḳуун","Снабдив их провизией, он положил чашу в мешок своего брата. А затем глашатай закричал: «О караванщики! Вы - воры».",["и когда","он снарядил их","их припасами","он положил","чашу","в","вьюк","его брата","затем","возгласил","глашатай","о","караван","поистине, вы","непременно воры"]],[12,71,["قَالُواْ","وَأَقۡبَلُواْ","عَلَيۡهِم","مَّاذَا","تَفۡقِدُونَ"],"ḳалуу ва'аḳбалуу `алайхим маза тафḳидуун","Повернувшись к ним лицом, братья сказали: «Что вы потеряли?».",["они сказали","повернувшись","к ним","что","вы потеряли"]],[12,72,["قَالُواْ","نَفۡقِدُ","صُوَاعَ","ٱلۡمَلِكِ","وَلِمَن","جَآءَ","بِهِۦ","حِمۡلُ","بَعِيرٖ","وَأَنَا۠","بِهِۦ","زَعِيمٞ"],"ḳалуу нафḳиду суа`ал малики валиман жаа бихии химлу ба`иирин ва'ана бихии за`иим","Они сказали: «Мы потеряли чашу царя. Кто принесет ее, получит верблюжий вьюк. Я отвечаю за это».",["они сказали","мы потеряли","чашу","царя","и тому, кто","принесёт","её","груз","верблюда","и я","за это","поручитель"]],[12,73,["قَالُواْ","تَٱللَّهِ","لَقَدۡ","عَلِمۡتُم","مَّا","جِئۡنَا","لِنُفۡسِدَ","فِي","ٱلۡأَرۡضِ","وَمَا","كُنَّا","سَٰرِقِينَ"],"ḳалуу таллахи лаḳад `алимтум ма жи'на линуфсида фил арди вама кунна сариḳиин","Братья сказали: «Клянемся Аллахом! Вы знаете, что мы не прибыли для того, чтобы распространять нечестие. Мы не являемся ворами».",["они сказали","клянёмся Аллахом","ведь уже","вы знаете","не","мы пришли","чтобы распространять нечестие","на","земле","и не","были мы","ворами"]],[12,74,["قَالُواْ","فَمَا","جَزَٰٓؤُهُۥٓ","إِن","كُنتُمۡ","كَٰذِبِينَ"],"ḳалуу фама жазаухуу ин кунтум казибиин","Они сказали: «Каким же будет возмездие ему, если вы лжете?».",["они сказали","так какое","воздаяние ему","если","вы были","лжецами"]],[12,75,["قَالُواْ","جَزَٰٓؤُهُۥ","مَن","وُجِدَ","فِي","رَحۡلِهِۦ","فَهُوَ","جَزَٰٓؤُهُۥۚ","كَذَٰلِكَ","نَجۡزِي","ٱلظَّٰلِمِينَ"],"ḳалуу жазаухуу ман вужида фии рахлихии фахуа жазаухуу казалика нажзиз залимиин","Братья сказали: «Тот, в чьем вьюке она будет найдена, будет задержан в наказание. Так мы воздаем беззаконникам».",["они сказали","воздаяние за это","тот, у кого","будет найдено","в","его вьюке","то он сам","воздаяние за это","так","мы воздаём","беззаконникам"]],[12,76,["فَبَدَأَ","بِأَوۡعِيَتِهِمۡ","قَبۡلَ","وِعَآءِ","أَخِيهِ","ثُمَّ","ٱسۡتَخۡرَجَهَا","مِن","وِعَآءِ","أَخِيهِۚ","كَذَٰلِكَ","كِدۡنَا","لِيُوسُفَۖ","مَا","كَانَ","لِيَأۡخُذَ","أَخَاهُ","فِي","دِينِ","ٱلۡمَلِكِ","إِلَّآ","أَن","يَشَآءَ","ٱللَّهُۚ","نَرۡفَعُ","دَرَجَٰتٖ","مَّن","نَّشَآءُۗ","وَفَوۡقَ","كُلِّ","ذِي","عِلۡمٍ","عَلِيمٞ"],"фабадаа би'ау`ийатихим ḳабла ви`аи ахиихи суммастахражаха мин ви`аи ахиихи казалика кидна лийуусуфа ма кана лийа'хуза ахаху фии диинил малики илла ан йашааллаху нарфа`у даражатим ман нашау вафауḳа кулли зии `илмин `алиим","Он начал с их мешков до того, как обыскал мешок своего брата, а затем вытащил чашу из мешка своего брата. Мы научили Йусуфа этой хитрости, ибо по законам царя он не мог задержать своего брата, если бы того не захотел Аллах. Мы возносим по степеням тех, кого пожелаем, и выше любого обладающего знанием есть более знающий.",["и он начал","с их мешков","прежде","мешка","его брата","затем","извлёк её","из","мешка","его брата","так","Мы устроили хитрость","для Йусуфа","не","было (ему)","чтобы взять","своего брата","по","закону","царя","если только не","что","пожелает","Аллах","Мы возвышаем","степенями","кого","Мы пожелаем","и над","всяким","обладающим","знанием","знающий"]],[12,77,["قَالُوٓاْ","إِن","يَسۡرِقۡ","فَقَدۡ","سَرَقَ","أَخٞ","لَّهُۥ","مِن","قَبۡلُۚ","فَأَسَرَّهَا","يُوسُفُ","فِي","نَفۡسِهِۦ","وَلَمۡ","يُبۡدِهَا","لَهُمۡۚ","قَالَ","أَنتُمۡ","شَرّٞ","مَّكَانٗاۖ","وَٱللَّهُ","أَعۡلَمُ","بِمَا","تَصِفُونَ"],"ḳалуу ин йасриḳ фаḳад сараḳа ахул лахуу мин ḳаблу фа'асарраха йуусуфу фии нафсихии валам йубдиха лахум ḳала антум шаррум маканан валлаху а`ламу бима тасифуун","Они сказали: «Если он украл, то ведь еще раньше воровал его брат». Йусуф (Иосиф) утаил это в своей душе и не открылся им, а только подумал: «Ваше положение еще более отвратительно, и Аллаху лучше знать о том, что вы измышляете».",["они сказали","если","он украл","то уже","крал","брат","его","ещё","прежде","но скрыл это","Йусуф","в","душе","и не","открыл это","им","он сказал","вы","хуже","положением","и Аллах","лучше знает","о том, что","вы приписываете"]],[12,78,["قَالُواْ","يَٰٓأَيُّهَا","ٱلۡعَزِيزُ","إِنَّ","لَهُۥٓ","أَبٗا","شَيۡخٗا","كَبِيرٗا","فَخُذۡ","أَحَدَنَا","مَكَانَهُۥٓۖ","إِنَّا","نَرَىٰكَ","مِنَ","ٱلۡمُحۡسِنِينَ"],"ḳалуу йа'аййухал `азиизу инна лахуу абан шайхан кабииран фахуз ахадана маканахуу инна нарака минал мухсиниин","Они сказали: «О повелитель! Его отец - многолетний старик. Задержи вместо него кого-либо из нас. Мы видим, что ты - один из творящих добро».",["они сказали","о","вельможа","поистине","у него","отец","старец","престарелый","так возьми","одного из нас","вместо него","поистине, мы","видим тебя","из","творящих добро"]]],"m":[[["فَلَمَّا","и когда",12,70],["جَهَّزَهُم","он снарядил их",12,70],["بِجَهَازِهِمۡ","их припасами",12,70],["جَعَلَ","он положил",12,70],["ٱلسِّقَايَةَ","чашу",12,70],["فِي","в",12,70],["رَحۡلِ","вьюк",12,70],["أَخِيهِ","его брата",12,70],["ثُمَّ","затем",12,70]],[["أَذَّنَ","возгласил",12,70],["مُؤَذِّنٌ","глашатай",12,70],["أَيَّتُهَا","о",12,70],["ٱلۡعِيرُ","караван",12,70],["إِنَّكُمۡ","поистине, вы",12,70],["لَسَٰرِقُونَ","непременно воры",12,70],[70],["قَالُواْ","они сказали",12,71],["وَأَقۡبَلُواْ","повернувшись",12,71]],[["عَلَيۡهِم","к ним",12,71],["مَّاذَا","что",12,71],["تَفۡقِدُونَ","вы потеряли",12,71],[71],["قَالُواْ","они сказали",12,72],["نَفۡقِدُ","мы потеряли",12,72],["صُوَاعَ","чашу",12,72],["ٱلۡمَلِكِ","царя",12,72]],[["وَلِمَن","и тому, кто",12,72],["جَآءَ","п