{"p":245,"j":13,"a":[[12,79,["قَالَ","مَعَاذَ","ٱللَّهِ","أَن","نَّأۡخُذَ","إِلَّا","مَن","وَجَدۡنَا","مَتَٰعَنَا","عِندَهُۥٓ","إِنَّآ","إِذٗا","لَّظَٰلِمُونَ"],"ḳала ма`азаллахи ан на'хуза илла ман важадна мата`ана `индахуу инна изал лазалимуун","Он сказал: «Упаси нас Аллах задержать кого-нибудь вместо того, у которого мы нашли нашу вещь. Поступив так, мы стали бы одними из беззаконников».",["он сказал","упаси","Аллах","чтобы","мы взяли","кроме","того, кого","мы нашли","нашу вещь","у него","поистине, мы","тогда","непременно беззаконники"]],[12,80,["فَلَمَّا","ٱسۡتَيۡـَٔسُواْ","مِنۡهُ","خَلَصُواْ","نَجِيّٗاۖ","قَالَ","كَبِيرُهُمۡ","أَلَمۡ","تَعۡلَمُوٓاْ","أَنَّ","أَبَاكُمۡ","قَدۡ","أَخَذَ","عَلَيۡكُم","مَّوۡثِقٗا","مِّنَ","ٱللَّهِ","وَمِن","قَبۡلُ","مَا","فَرَّطتُمۡ","فِي","يُوسُفَۖ","فَلَنۡ","أَبۡرَحَ","ٱلۡأَرۡضَ","حَتَّىٰ","يَأۡذَنَ","لِيٓ","أَبِيٓ","أَوۡ","يَحۡكُمَ","ٱللَّهُ","لِيۖ","وَهُوَ","خَيۡرُ","ٱلۡحَٰكِمِينَ"],"фаламмастай'асуу минху халасуу нажиййан ḳала кабиирухум алам та`ламуу анна абакум ḳад ахаза `алайкум маусиḳам миналлахи вамин ḳаблу ма фарраттум фии йуусуфа фалан абрахал арда хатта йа'зана лии абии ау йахкумаллаху лии вахуа хайрул хакимиин","Отчаявшись, они уединились для совета, и старший из них сказал: «Помните ли вы о том, что отец заставил нас поклясться Аллахом и что раньше вы неправедно поступили с Йусуфом (Иосифом)? Я ни за что не покину этой страны, пока отец не разрешит мне или пока Аллах не примет Свое решение относительно меня. Воистину, Он - Наилучший из судий.",["и когда","они отчаялись","в нём","они уединились","для совещания","сказал","старший из них","разве не","знаете вы","что","ваш отец","уже","взял","с вас","клятву","перед","Аллахом","а ещё","прежде","то, что","вы упустили","в отношении","Йусуфа","и ни за что не","покину","земли","пока не","позволит","мне","мой отец","или","рассудит","Аллах","мне","и Он","лучший","из судей"]],[12,81,["ٱرۡجِعُوٓاْ","إِلَىٰٓ","أَبِيكُمۡ","فَقُولُواْ","يَٰٓأَبَانَآ","إِنَّ","ٱبۡنَكَ","سَرَقَ","وَمَا","شَهِدۡنَآ","إِلَّا","بِمَا","عَلِمۡنَا","وَمَا","كُنَّا","لِلۡغَيۡبِ","حَٰفِظِينَ"],"иржи`уу ила абиикум фаḳуулуу йа'абана иннабнака сараḳа вама шахидна илла бима `алимна вама кунна лилгайби хафизиин","Возвращайтесь к отцу и скажите: \"Отец наш! Твой сын украл. Мы свидетельствуем только о том, что знаем, и не ведаем о сокровенном.",["возвращайтесь","к","вашему отцу","и скажите","о наш отец","поистине","твой сын","украл","и не","свидетельствуем мы","кроме как","о том, что","мы знаем","и не","были мы","сокровенного","стражами"]],[12,82,["وَسۡـَٔلِ","ٱلۡقَرۡيَةَ","ٱلَّتِي","كُنَّا","فِيهَا","وَٱلۡعِيرَ","ٱلَّتِيٓ","أَقۡبَلۡنَا","فِيهَاۖ","وَإِنَّا","لَصَٰدِقُونَ"],"вас'алил ḳарйатал латии кунна фииха вал`иирал латии аḳбална фииха ва'инна ласадиḳуун","Спроси жителей селения, в котором мы были, и караванщиков, с которыми мы вернулись. Воистину, мы говорим правду\"».",["и спроси","селение","которое","мы были","в нём","и караван","который","мы прибыли","с ним","и поистине, мы","непременно правдивы"]],[12,83,["قَالَ","بَلۡ","سَوَّلَتۡ","لَكُمۡ","أَنفُسُكُمۡ","أَمۡرٗاۖ","فَصَبۡرٞ","جَمِيلٌۖ","عَسَى","ٱللَّهُ","أَن","يَأۡتِيَنِي","بِهِمۡ","جَمِيعًاۚ","إِنَّهُۥ","هُوَ","ٱلۡعَلِيمُ","ٱلۡحَكِيمُ"],"ḳала бал саввалат лакум анфусукум амран фасабрун жамиилун `асаллаху ан йа'тийании бихим жамии`ан иннахуу хуал `алиимул хакиим","Он сказал: «О нет! Это ваши души ввели вас в соблазн, и лучше проявить терпение. Возможно, Аллах возвратит мне всех вместе. Воистину, Он - Знающий, Мудрый».",["он сказал","нет","разукрасили","вам","ваши души","дело","терпение же","прекрасно","быть может","Аллах","что","приведёт ко мне","их","всех","поистине, Он","Он","Знающий","Мудрый"]],[12,84,["وَتَوَلَّىٰ","عَنۡهُمۡ","وَقَالَ","يَٰٓأَسَفَىٰ","عَلَىٰ","يُوسُفَ","وَٱبۡيَضَّتۡ","عَيۡنَاهُ","مِنَ","ٱلۡحُزۡنِ","فَهُوَ","كَظِيمٞ"],"ватавалла `анхум ваḳала йа'асафа `ала йуусуфа вабйаддат `айнаху минал хузни фахуа казиим","Он отвернулся от них и сказал: «Как жаль Йусуфа (Иосифа)!». И его глаза покрылись бельмами от печали, которую он сдерживал.",["и он отвернулся","от них","и сказал","о моя печаль","по","Йусуфу","и побелели","его глаза","от","горя","и он","сдерживал (скорбь)"]],[12,85,["قَالُواْ","تَٱللَّهِ","تَفۡتَؤُاْ","تَذۡكُرُ","يُوسُفَ","حَتَّىٰ","تَكُونَ","حَرَضًا","أَوۡ","تَكُونَ","مِنَ","ٱلۡهَٰلِكِينَ"],"ḳалуу таллахи тафтау тазкуру йуусуфа хатта такууна харадан ау такууна минал халикиин","Они сказали: «Клянемся Аллахом, ты не перестанешь поминать Йусуфа (Иосифа), пока не ослабеешь или не умрешь».",["Они сказали","клянёмся Аллахом","ты не перестанешь","поминать","Йусуфа","пока не","станешь","изнурённым","или","станешь","из","погибших"]],[12,86,["قَالَ","إِنَّمَآ","أَشۡكُواْ","بَثِّي","وَحُزۡنِيٓ","إِلَى","ٱللَّهِ","وَأَعۡلَمُ","مِنَ","ٱللَّهِ","مَا","لَا","تَعۡلَمُونَ"],"ḳала иннама ашкуу бассии вахузнии илаллахи ва'а`ламу миналлахи ма ла та`ламуун","Он сказал: «Мои жалобы и печаль обращены только к Аллаху, и я узнаю от Аллаха то, чего вы не знаете.",["Он сказал","только лишь","я жалуюсь","на мою скорбь","и мою печаль","к","Аллаху","и я знаю","от","Аллаха","то, что","не","вы знаете"]]],"m":[[["قَالَ","он сказал",12,79],["مَعَاذَ","упаси",12,79],["ٱللَّهِ","Аллах",12,79],["أَن","чтобы",12,79],["نَّأۡخُذَ","мы взяли",12,79],["إِلَّا","кроме",12,79],["مَن","того, кого",12,79],["وَجَدۡنَا","мы нашли",12,79],["مَتَٰعَنَا","нашу вещь",12,79],["عِندَهُۥٓ","у него",12,79],["إِنَّآ","поистине, мы",12,79]],[["إِذٗا","тогда",12,79],["لَّظَٰلِمُونَ","непременно беззаконники",12,79],[79],["فَلَمَّا","и когда",12,80],["ٱسۡتَيۡـَٔسُواْ","они отчаялись",12,80],["مِنۡهُ","в нём",12,80],["خَلَصُواْ","они уединились",12,80],["نَجِيّٗاۖ","для совещания",12,80]],[["قَالَ","сказал",12,80],["كَبِيرُهُمۡ","старший из них",12,80],["أَلَمۡ","разве не",12,80],["تَعۡلَمُوٓاْ","знаете вы",12,80],["أَنَّ","что",12,80],["أَبَاكُمۡ","ваш отец",12,80],["قَدۡ","уже",12,80],["أَخَذَ","взял",12,80],["عَلَيۡكُم","с вас",12,80]],[["مَّوۡثِقٗا","клятву",12,80],["مِّنَ","перед",12,80],["ٱللَّهِ","А