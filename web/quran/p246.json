{"p":246,"j":13,"a":[[12,87,["يَٰبَنِيَّ","ٱذۡهَبُواْ","فَتَحَسَّسُواْ","مِن","يُوسُفَ","وَأَخِيهِ","وَلَا","تَاْيۡـَٔسُواْ","مِن","رَّوۡحِ","ٱللَّهِۖ","إِنَّهُۥ","لَا","يَاْيۡـَٔسُ","مِن","رَّوۡحِ","ٱللَّهِ","إِلَّا","ٱلۡقَوۡمُ","ٱلۡكَٰفِرُونَ"],"йабаниййазхабуу фатахассасуу мин йуусуфа ва'ахиихи вала тай'асуу мир раухиллахи иннахуу ла йай'асу мир раухиллахи иллал ḳаумул кафируун","О сыновья мои! Ступайте и разыщите Йусуфа (Иосифа) и его брата и не теряйте надежды на милость Аллаха, ибо отчаиваются в милости Аллаха только люди неверующие».",["О сыновья мои","ступайте","и разузнайте","о","Йусуфе","и его брате","и не","отчаивайтесь","в","милости","Аллаха","поистине","не","отчаивается","в","милости","Аллаха","кроме","люди","неверующие"]],[12,88,["فَلَمَّا","دَخَلُواْ","عَلَيۡهِ","قَالُواْ","يَٰٓأَيُّهَا","ٱلۡعَزِيزُ","مَسَّنَا","وَأَهۡلَنَا","ٱلضُّرُّ","وَجِئۡنَا","بِبِضَٰعَةٖ","مُّزۡجَىٰةٖ","فَأَوۡفِ","لَنَا","ٱلۡكَيۡلَ","وَتَصَدَّقۡ","عَلَيۡنَآۖ","إِنَّ","ٱللَّهَ","يَجۡزِي","ٱلۡمُتَصَدِّقِينَ"],"фаламма дахалуу `алайхи ḳалуу йа'аййухал `азиизу массана ва'ахланад дурру важи'на бибида`атим музжатин фа'ауфи ланал кайла ватасаддаḳ `алайна инналлаха йажзил мутасаддиḳиин","Войдя к нему, они сказали: «О повелитель! Нас и наш род поразила беда. Мы прибыли с небольшим товаром. Отмерь нам меру сполна и окажи нам милость. Воистину, Аллах вознаграждает творящих добро».",["И когда","они вошли","к нему","они сказали","о","Азиз (правитель)","постигла нас","и нашу семью","беда","и мы пришли","с товаром","скудным","так отмерь сполна","нам","меру","и окажи милость","нам","поистине","Аллах","вознаграждает","оказывающих милость"]],[12,89,["قَالَ","هَلۡ","عَلِمۡتُم","مَّا","فَعَلۡتُم","بِيُوسُفَ","وَأَخِيهِ","إِذۡ","أَنتُمۡ","جَٰهِلُونَ"],"ḳала хал `алимтум ма фа`алтум бийуусуфа ва'ахиихи из антум жахилуун","Он сказал: «Поняли ли вы, как вы поступили с Йусуфом (Иосифом) и его братом, когда были невежественны?».",["Он сказал","разве","знали вы","что","вы сделали","с Йусуфом","и его братом","когда","вы","невежды"]],[12,90,["قَالُوٓاْ","أَءِنَّكَ","لَأَنتَ","يُوسُفُۖ","قَالَ","أَنَا۠","يُوسُفُ","وَهَٰذَآ","أَخِيۖ","قَدۡ","مَنَّ","ٱللَّهُ","عَلَيۡنَآۖ","إِنَّهُۥ","مَن","يَتَّقِ","وَيَصۡبِرۡ","فَإِنَّ","ٱللَّهَ","لَا","يُضِيعُ","أَجۡرَ","ٱلۡمُحۡسِنِينَ"],"ḳалуу а'иннака ла'анта йуусуфу ḳала ана йуусуфу вахаза ахии ḳад манналлаху `алайна иннахуу ман йаттаḳи вайасбир фа'инналлаха ла йудии`у ажрал мухсиниин","Они сказали: «Неужели ты - Йусуф (Иосиф)?». Он сказал: «Я - Йусуф, а это - мой брат. Аллах облагодетельствовал нас. Воистину, если кто богобоязнен и терпелив, то ведь Аллах не теряет вознаграждения творящих добро».",["Они сказали","неужели ты","непременно ты","Йусуф","Он сказал","я","Йусуф","а это","мой брат","уже","оказал милость","Аллах","нам","поистине","кто","боится (Аллаха)","и терпит","то поистине","Аллах","не","теряет","награду","творящих добро"]],[12,91,["قَالُواْ","تَٱللَّهِ","لَقَدۡ","ءَاثَرَكَ","ٱللَّهُ","عَلَيۡنَا","وَإِن","كُنَّا","لَخَٰطِـِٔينَ"],"ḳалуу таллахи лаḳад асаракаллаху `алайна ва'ин кунна лахати'иин","Они сказали: «Клянемся Аллахом! Аллах предпочел тебя нам. Мы же были грешниками».",["Они сказали","клянёмся Аллахом","действительно уже","предпочёл тебя","Аллах","над нами","и ведь","мы были","непременно грешны"]],[12,92,["قَالَ","لَا","تَثۡرِيبَ","عَلَيۡكُمُ","ٱلۡيَوۡمَۖ","يَغۡفِرُ","ٱللَّهُ","لَكُمۡۖ","وَهُوَ","أَرۡحَمُ","ٱلرَّٰحِمِينَ"],"ḳала ла тасрииба `алайкумул йаума йагфируллаху лакум вахуа архамур рахимиин","Он сказал: «Сегодня я не стану укорять вас. Да простит вас Аллах, ибо Он - Милосерднейший из милосердных.",["Он сказал","нет","упрёка","на вас","сегодня","простит","Аллах","вам","и Он","Милосерднейший","из милосердных"]],[12,93,["ٱذۡهَبُواْ","بِقَمِيصِي","هَٰذَا","فَأَلۡقُوهُ","عَلَىٰ","وَجۡهِ","أَبِي","يَأۡتِ","بَصِيرٗا","وَأۡتُونِي","بِأَهۡلِكُمۡ","أَجۡمَعِينَ"],"изхабуу биḳамиисии хаза фа'алḳууху `ала важхи абии йа'ти басииран ва'туунии би'ахликум ажма`иин","Ступайте с моей рубахой и накиньте ее на лицо моего отца, и тогда он прозреет, а потом привезите ко мне всю свою семью».",["Ступайте","с моей рубахой","этой","и наденьте её","на","лицо","моего отца","он станет","зрячим","и приведите ко мне","вашу семью","всех вместе"]],[12,94,["وَلَمَّا","فَصَلَتِ","ٱلۡعِيرُ","قَالَ","أَبُوهُمۡ","إِنِّي","لَأَجِدُ","رِيحَ","يُوسُفَۖ","لَوۡلَآ","أَن","تُفَنِّدُونِ"],"валамма фасалатил `ииру ḳала абуухум иннии ла'ажиду рииха йуусуфа лаула ан туфаннидуун","Как только караван покинул Египет, их отец сказал: «Воистину, я чувствую запах Йусуфа (Иосифа), если только вы не считаете меня выжившим из ума стариком».",["И когда","покинул (Египет)","караван","сказал","их отец","поистине я","непременно чувствую","запах","Йусуфа","если бы не","что","вы сочтёте меня слабоумным"]],[12,95,["قَالُواْ","تَٱللَّهِ","إِنَّكَ","لَفِي","ضَلَٰلِكَ","ٱلۡقَدِيمِ"],"ḳалуу таллахи иннака лафии далаликал ḳадиим","Они сказали: «Клянемся Аллахом, ты пребываешь в своем старом заблуждении».",["Они сказали","клянёмся Аллахом","поистине ты","непременно в","твоём заблуждении","давнем"]]],"m":[[["يَٰبَنِيَّ","О сыновья мои",12,87],["ٱذۡهَبُواْ","ступайте",12,87],["فَتَحَسَّسُواْ","и разузнайте",12,87],["مِن","о",12,87],["يُوسُفَ","Йусуфе",12,87],["وَأَخِيهِ","и его брате",12,87],["وَلَا","и не",12,87],["تَاْيۡـَٔسُواْ","отчаивайтесь",12,87]],[["مِن","в",12,87],["رَّوۡحِ","милости",12,87],["ٱللَّهِۖ","Аллаха",12,87],["إِنَّهُۥ","поистине",12,87],["لَا","не",12,87],["يَاْيۡـَٔسُ","отчаивается",12,87],["مِن","в",12,87],["رَّوۡحِ","милости",12,87],["ٱللَّهِ","Аллаха",12,87],["إِلَّا","кроме",12,87],["ٱلۡقَوۡمُ","люди",12,87],["ٱلۡكَٰفِرُونَ","неверующие",12,87]],[[87],["فَلَمَّا","И когда",12,88],["دَخَلُواْ","они вошли",12,88],["عَلَيۡهِ","к нему",12,88],["قَالُواْ","они сказали",12,88],["يَٰٓأَيُّهَا","о",12,88],["ٱلۡعَزِيزُ","Азиз (правитель)",12,88],["مَسَّنَا","постигла нас",12,88],["وَأَهۡلَنَا","и нашу семью",12,88],["ٱلضُّرُّ","беда",12,88]],[["وَجِئۡنَا","и мы пришли",12,88],["بِبِضَٰعَةٖ","с товаром",12,88],["مُّزۡجَىٰةٖ","скудным",12,88],["فَأَوۡفِ","так отмерь сполна",12,88],["لَنَا","нам",12,88],["ٱلۡكَيۡلَ","меру",12,88],["وَتَصَدَّقۡ","и окажи милость",12,88],["عَلَيۡنَآۖ","нам",12,88]],[["إِنَّ","поистине",12,88],["ٱللَّهَ","Аллах",12,88],["يَجۡزِي","вознаграждает",12,88],["ٱلۡمُتَصَدِّقِينَ","оказывающих милость",12,88],[88],["قَالَ","Он сказал",12,89],["هَلۡ","разве",12,89],["عَلِمۡتُم","знали вы",12,89],["مَّا","что",12,89],["فَعَلۡتُم","вы сделали",12,89]],[["بِيُوسُفَ","с Йусуфом",12,89],["وَأَخِيهِ","и его братом",12,89],["إِذۡ","когда",12,89],["أَنتُمۡ","вы",12,89],["جَٰهِلُونَ","невежды",12,89],[89],["قَالُوٓاْ","Они сказали",12,90],["أَءِنَّكَ","неужели ты",12,90]],[["لَأَنتَ","непременно ты",12,90],["يُوسُفُۖ","Йусуф",12,90],["قَالَ","Он сказал",12,90],["أَنَا۠","я",12,90],["يُوسُفُ","Йусуф",12,90],["وَهَٰذَآ","а это",12,90],["أَخِيۖ","мой брат",12,90],["قَدۡ","уже",12,90],["مَنَّ","оказал милость",12,90],["ٱللَّهُ","Аллах",12,90]],[["عَلَيۡنَآۖ","нам",12,90],["إِنَّهُۥ","поистине",12,90],["مَن","кто",12,90],["يَتَّقِ","боится (Аллаха)",12,90],["وَيَصۡبِرۡ","и терпит",12,90],["فَإِنَّ","то поистине",12,90],["ٱللَّهَ","Аллах",12,90],["لَا","не",12,90],["يُضِيعُ","теряет",12,90],["أَجۡرَ","награду",12,90]],[["ٱلۡمُحۡسِنِينَ","творящих добро",12,90],[90],["قَالُواْ","Они сказали",12,91],["تَٱللَّهِ","клянёмся Аллахом",12,91],["لَقَدۡ","действительно уже",12,91],["ءَاثَرَكَ","предпочёл тебя",12,91],["ٱللَّهُ","Аллах",12,91],["عَلَيۡنَا","над нами",12,91]],[["وَإِن","и ведь",12,91],["كُنَّا","мы были",12,91],["لَخَٰطِـِٔينَ","непременно грешны",12,91],[91],["قَالَ","Он сказал",12,92],["لَا","нет",12,92],["تَثۡرِيبَ","упрёка",12,92],["عَلَيۡكُمُ","на вас",12,92]],[["ٱلۡيَوۡمَۖ","сегодня",12,92],["يَغۡفِرُ","простит",12,92],["ٱللَّهُ","Аллах",12,92],["لَكُمۡۖ","вам",12,92],["وَهُوَ","и Он",12,92],["أَرۡحَمُ","Милосерднейший",12,92],["ٱلرَّٰحِمِينَ","из милосердных",12,92],[92]],[["ٱذۡهَبُواْ","Ступайте",12,93],["بِقَمِيصِي","с моей рубахой",12,93],["هَٰذَا","этой",12,93],["فَأَلۡقُوهُ","и наденьте её",12,93],["عَلَىٰ","на",12,93],["وَجۡهِ","лицо",12,93],["أَبِي","моего отца",12,93],["يَأۡتِ","он станет",12,93],["بَصِيرٗا","зрячим",12,93]],[["وَأۡتُونِي","и приведите ко мне",12,93],["بِأَهۡلِكُمۡ","вашу семью",12,93],["أَجۡمَعِينَ","всех вместе",12,93],[93],["وَلَمَّا","И когда",12,94],["فَصَلَتِ","покинул (Египет)",12,94]],[["ٱلۡعِيرُ","караван",12,94],["قَالَ","сказал",12,94],["أَبُوهُمۡ","их отец",12,94],["إِنِّي","поистине я",12,94],["لَأَجِدُ","непременно чувствую",12,94],["رِيحَ","запах",12,94],["يُوسُفَۖ","Йусуфа",12,94],["لَوۡلَآ","если бы не",12,94],["أَن","что",12,94]],[["تُفَنِّدُونِ","вы сочтёте меня слабоумным",12,94],[94],["قَالُواْ","Они сказали",12,95],["تَٱللَّهِ","клянёмся Аллахом",12,95],["إِنَّكَ","поистине ты",12,95],["لَفِي","непременно в",12,95],["ضَلَٰلِكَ","твоём заблуждении",12,95],["ٱلۡقَدِيمِ","давнем",12,95],[95]]]}