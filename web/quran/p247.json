{"p":247,"j":13,"a":[[12,96,["فَلَمَّآ","أَن","جَآءَ","ٱلۡبَشِيرُ","أَلۡقَىٰهُ","عَلَىٰ","وَجۡهِهِۦ","فَٱرۡتَدَّ","بَصِيرٗاۖ","قَالَ","أَلَمۡ","أَقُل","لَّكُمۡ","إِنِّيٓ","أَعۡلَمُ","مِنَ","ٱللَّهِ","مَا","لَا","تَعۡلَمُونَ"],"фаламма ан жаал башииру алḳаху `ала важхихии фартадда басииран ḳала алам аḳул лакум иннии а`ламу миналлахи ма ла та`ламуун","Когда же прибыл добрый вестник, накинул рубаху на его лицо и тот прозрел, он сказал: «Разве я не говорил вам, что мне известно от Аллаха то, чего вы не знаете?».",["И когда","же","пришёл","вестник радости","он набросил её","на","его лицо","и тот снова стал","зрячим","он сказал","разве не","я говорил","вам","поистине я","знаю","от","Аллаха","то, что","не","вы знаете"]],[12,97,["قَالُواْ","يَٰٓأَبَانَا","ٱسۡتَغۡفِرۡ","لَنَا","ذُنُوبَنَآ","إِنَّا","كُنَّا","خَٰطِـِٔينَ"],"ḳалуу йа'абанастагфир лана зунуубана инна кунна хати'иин","Они сказали: «Отец наш! Попроси прощения нашим грехам. Воистину, мы были грешниками».",["Они сказали","о отец наш","попроси прощения","для нас","за наши грехи","поистине мы","были","грешниками"]],[12,98,["قَالَ","سَوۡفَ","أَسۡتَغۡفِرُ","لَكُمۡ","رَبِّيٓۖ","إِنَّهُۥ","هُوَ","ٱلۡغَفُورُ","ٱلرَّحِيمُ"],"ḳала сауфа астагфиру лакум раббии иннахуу хуал гафуурур рахиим","Он сказал: «Я попрошу моего Господа простить вас, ведь Он - Прощающий, Милосердный».",["Он сказал","вскоре","я попрошу прощения","для вас","у моего Господа","поистине Он","Он","Прощающий","Милосердный"]],[12,99,["فَلَمَّا","دَخَلُواْ","عَلَىٰ","يُوسُفَ","ءَاوَىٰٓ","إِلَيۡهِ","أَبَوَيۡهِ","وَقَالَ","ٱدۡخُلُواْ","مِصۡرَ","إِن","شَآءَ","ٱللَّهُ","ءَامِنِينَ"],"фаламма дахалуу `ала йуусуфа ава илайхи абавайхи ваḳаладхулуу мисра ин шааллаху аминиин","Когда они вошли к Йусуфу (Иосифу), он прижал к себе родителей и сказал: «Входите в Египет без опаски, если этого пожелает Аллах».",["И когда","они вошли","к","Йусуфу","он приютил","к себе","своих родителей","и сказал","входите","в Египет","если","пожелает","Аллах","в безопасности"]],[12,100,["وَرَفَعَ","أَبَوَيۡهِ","عَلَى","ٱلۡعَرۡشِ","وَخَرُّواْ","لَهُۥ","سُجَّدٗاۖ","وَقَالَ","يَٰٓأَبَتِ","هَٰذَا","تَأۡوِيلُ","رُءۡيَٰيَ","مِن","قَبۡلُ","قَدۡ","جَعَلَهَا","رَبِّي","حَقّٗاۖ","وَقَدۡ","أَحۡسَنَ","بِيٓ","إِذۡ","أَخۡرَجَنِي","مِنَ","ٱلسِّجۡنِ","وَجَآءَ","بِكُم","مِّنَ","ٱلۡبَدۡوِ","مِنۢ","بَعۡدِ","أَن","نَّزَغَ","ٱلشَّيۡطَٰنُ","بَيۡنِي","وَبَيۡنَ","إِخۡوَتِيٓۚ","إِنَّ","رَبِّي","لَطِيفٞ","لِّمَا","يَشَآءُۚ","إِنَّهُۥ","هُوَ","ٱلۡعَلِيمُ","ٱلۡحَكِيمُ"],"варафа`а абавайхи `алал `арши вахарруу лахуу сужжадан ваḳала йа'абати хаза та'виилу ру'йайа мин ḳаблу ḳад жа`алаха раббии хаḳḳан ваḳад ахсана бии из ахражании минас сижни важаа бикум минал бадви мим ба`ди ан назагаш шайтану байнии вабайна ихватии инна раббии латиифул лима йашау иннахуу хуал `алиимул хакиим","Он поднял своих родителей на трон, и они вместе с братьями пали ниц перед ним. Он сказал: «Отец мой! Это - толкование моего давнего сна. Господь мой сделал его явью. Он облагодетельствовал меня, освободив из темницы, и привел вас из пустыни после того, как дьявол посеял вражду между мною и моими братьями. Воистину, мой Господь добр, к кому пожелает. Воистину, Он - Знающий, Мудрый.",["И он поднял","своих родителей","на","трон","и они пали","перед ним","в земном поклоне","и он сказал","о отец мой","это","толкование","моего сна","из","прежде","уже","сделал его","мой Господь","истиной","и уже","Он сделал добро","мне","когда","Он вывел меня","из","темницы","и привёл","вас","из","пустыни","из","после","того как","посеял раздор","сатана","между мной","и между","моими братьями","поистине","мой Господь","Добрый","к тому, чему","Он пожелает","поистине Он","Он","Знающий","Мудрый"]],[12,101,["رَبِّ","قَدۡ","ءَاتَيۡتَنِي","مِنَ","ٱلۡمُلۡكِ","وَعَلَّمۡتَنِي","مِن","تَأۡوِيلِ","ٱلۡأَحَادِيثِۚ","فَاطِرَ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِ","أَنتَ","وَلِيِّۦ","فِي","ٱلدُّنۡيَا","وَٱلۡأٓخِرَةِۖ","تَوَفَّنِي","مُسۡلِمٗا","وَأَلۡحِقۡنِي","بِٱلصَّٰلِحِينَ"],"рабби ḳад атайтании минал мулки ва`алламтании мин та'виилил ахадииси фатирас самавати вал'арди анта валиййии фид дунйа вал'ахирати таваффании муслиман ва'алхиḳнии биссалихиин","Господи! Ты даровал мне власть и научил толковать сновидения. Творец небес и земли! Ты - мой Покровитель в этом мире и в Последней жизни. Умертви меня мусульманином и присоедини меня к праведникам».",["Господи","уже","Ты дал мне","из","власти","и научил меня","из","толкования","событий (снов)","Творец","небес","и земли","Ты","мой Покровитель","в","этом мире","и в Последней жизни","упокой меня","мусульманином","и присоедини меня","к праведникам"]],[12,102,["ذَٰلِكَ","مِنۡ","أَنۢبَآءِ","ٱلۡغَيۡبِ","نُوحِيهِ","إِلَيۡكَۖ","وَمَا","كُنتَ","لَدَيۡهِمۡ","إِذۡ","أَجۡمَعُوٓاْ","أَمۡرَهُمۡ","وَهُمۡ","يَمۡكُرُونَ"],"залика мин амбаил гайби нуухиихи илайка вама кунта ладайхим из ажма`уу амрахум вахум йамкуруун","Все это - часть повествований о сокровенном, которые Мы ниспосылаем тебе в откровении. Ты не был с ними, когда они вместе принимали решение и строили козни.",["Это","из","вестей","о сокровенном","Мы внушаем это","тебе","и не","ты был","при них","когда","они сговорились","о своём деле","а они","строили козни"]],[12,103,["وَمَآ","أَكۡثَرُ","ٱلنَّاسِ","وَلَوۡ","حَرَصۡتَ","بِمُؤۡمِنِينَ"],"вама аксарун наси валау хараста биму'миниин","Большая часть людей не уверует, даже если ты страстно будешь желать этого.",["И не","большинство","людей","и даже если","ты жаждешь","верующие"]]],"m":[[["فَلَمَّآ","И когда",12,96],["أَن","же",12,96],["جَآءَ","пришёл",12,96],["ٱلۡبَشِيرُ","вестник радости",12,96],["أَلۡقَىٰهُ","он набросил её",12,96],["عَلَىٰ","на",12,96],["وَجۡهِهِۦ","его лицо",12,96],["فَٱرۡتَدَّ","и тот снова стал",12,96],["بَصِيرٗاۖ","зрячим",12,96],["قَالَ","он сказал",12,96]],[["أَلَمۡ","разве не",12,96],["أَقُل","я говорил",12,96],["لَّكُمۡ","вам",12,96],["إِنِّيٓ","поистине я",12,96],["أَعۡلَمُ","знаю",12,96],["مِنَ","от",12,96],["ٱللَّهِ","Аллаха",12,96],["مَا","то, что",12,96],["لَا","не",12,96],["تَعۡلَمُونَ","вы знаете",12,96],[96],["قَالُواْ","Они сказали",