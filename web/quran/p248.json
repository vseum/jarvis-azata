{"p":248,"j":13,"a":[[12,104,["وَمَا","تَسۡـَٔلُهُمۡ","عَلَيۡهِ","مِنۡ","أَجۡرٍۚ","إِنۡ","هُوَ","إِلَّا","ذِكۡرٞ","لِّلۡعَٰلَمِينَ"],"вама тас'алухум `алайхи мин ажрин ин хуа илла зикрул лил`аламиин","Ты не просишь у них вознаграждения за это, ведь это - только Напоминание для миров.",["И не","ты просишь у них","за это","никакой","награды","не","это","кроме","напоминание","для миров"]],[12,105,["وَكَأَيِّن","مِّنۡ","ءَايَةٖ","فِي","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِ","يَمُرُّونَ","عَلَيۡهَا","وَهُمۡ","عَنۡهَا","مُعۡرِضُونَ"],"вакааййим мин айатин фис самавати вал'арди йамуррууна `алайха вахум `анха му`ридуун","Как же много на небесах и на земле знамений, мимо которых они проходят и отворачиваются.",["И сколько же","из","знамений","на","небесах","и земле","они проходят","мимо них","а они","от них","отворачиваются"]],[12,106,["وَمَا","يُؤۡمِنُ","أَكۡثَرُهُم","بِٱللَّهِ","إِلَّا","وَهُم","مُّشۡرِكُونَ"],"вама йу'мину аксарухум биллахи илла вахум мушрикуун","Большая часть их верует в Аллаха, приобщая к Нему сотоварищей.",["и не","верует","большинство их","в Аллаха","кроме как","при этом они","многобожники"]],[12,107,["أَفَأَمِنُوٓاْ","أَن","تَأۡتِيَهُمۡ","غَٰشِيَةٞ","مِّنۡ","عَذَابِ","ٱللَّهِ","أَوۡ","تَأۡتِيَهُمُ","ٱلسَّاعَةُ","بَغۡتَةٗ","وَهُمۡ","لَا","يَشۡعُرُونَ"],"афааминуу ан та'тийахум гашийатум мин `азабиллахи ау та'тийахумус са`ату багтатан вахум ла йаш`уруун","Неужели они не опасаются того, что покрывало наказания Аллаха окутает их или что Час настанет внезапно, когда они об этом и думать не будут?",["Неужели они в безопасности","что","придёт к ним","покрывающее","из","наказания","Аллаха","или","придёт к ним","Час","внезапно","а они","не","осознают"]],[12,108,["قُلۡ","هَٰذِهِۦ","سَبِيلِيٓ","أَدۡعُوٓاْ","إِلَى","ٱللَّهِۚ","عَلَىٰ","بَصِيرَةٍ","أَنَا۠","وَمَنِ","ٱتَّبَعَنِيۖ","وَسُبۡحَٰنَ","ٱللَّهِ","وَمَآ","أَنَا۠","مِنَ","ٱلۡمُشۡرِكِينَ"],"ḳул хазихии сабиилии ад`уу илаллахи `ала басииратин ана ваманиттаба`ании васубханаллахи вама ана минал мушрикиин","Скажи: «Таков мой путь. Я и мои последователи призываем к Аллаху согласно убеждению. Пречист Аллах, и я не являюсь одним из многобожников».",["Скажи","это","мой путь","я призываю","к","Аллаху","с","ясным знанием","я","и тот, кто","последовал за мной","и пречист","Аллах","и не","я","из","многобожников"]],[12,109,["وَمَآ","أَرۡسَلۡنَا","مِن","قَبۡلِكَ","إِلَّا","رِجَالٗا","نُّوحِيٓ","إِلَيۡهِم","مِّنۡ","أَهۡلِ","ٱلۡقُرَىٰٓۗ","أَفَلَمۡ","يَسِيرُواْ","فِي","ٱلۡأَرۡضِ","فَيَنظُرُواْ","كَيۡفَ","كَانَ","عَٰقِبَةُ","ٱلَّذِينَ","مِن","قَبۡلِهِمۡۗ","وَلَدَارُ","ٱلۡأٓخِرَةِ","خَيۡرٞ","لِّلَّذِينَ","ٱتَّقَوۡاْۚ","أَفَلَا","تَعۡقِلُونَ"],"вама арсална мин ḳаблика илла рижалан нуухии илайхим мин ахлил ḳура афалам йасиируу фил арди файанзуруу кайфа кана `аḳибатул лазиина мин ḳаблихим валадарул ахирати хайрул лиллазиинаттаḳау афала та`ḳилуун","До тебя Мы направляли посланниками только мужей из селений, которым мы внушали откровение. Разве они не странствовали по земле и не видели, каким был конец тех, которые жили до них? Воистину, обитель в Последней жизни лучше для богобоязненных. Неужели они не разумеют?",["И не","Мы посылали","до","тебя","кроме","мужей","Мы внушали","им","из","жителей","селений","разве не","они странствовали","по","земле","и посмотрели бы","каким","был","конец","тех, которые","до","них","и непременно обитель","Последней жизни","лучше","для тех, которые","боялись (Аллаха)","разве не","вы разумеете"]],[12,110,["حَتَّىٰٓ","إِذَا","ٱسۡتَيۡـَٔسَ","ٱلرُّسُلُ","وَظَنُّوٓاْ","أَنَّهُمۡ","قَدۡ","كُذِبُواْ","جَآءَهُمۡ","نَصۡرُنَا","فَنُجِّيَ","مَن","نَّشَآءُۖ","وَلَا","يُرَدُّ","بَأۡسُنَا","عَنِ","ٱلۡقَوۡمِ","ٱلۡمُجۡرِمِينَ"],"хатта изастай'асар русулу вазаннуу аннахум ḳад кузибуу жаахум насруна фанужжийа ман нашау вала йурадду ба'суна `анил ḳаумил мужримиин","Когда же посланники приходили в отчаяние и понимали, что их сочли лжецами, к ним приходила Наша помощь, и спасались те, кого Мы хотели спасти. Наше наказание нельзя отвратить от грешных людей!",["Пока наконец","когда","отчаялись","посланники","и подумали","что они","уже","сочтены лжецами","пришла к ним","Наша помощь","и были спасены","те, кого","Мы пожелаем","и не","отвращается","Наша кара","от","людей","грешных"]],[12,111,["لَقَدۡ","كَانَ","فِي","قَصَصِهِمۡ","عِبۡرَةٞ","لِّأُوْلِي","ٱلۡأَلۡبَٰبِۗ","مَا","كَانَ","حَدِيثٗا","يُفۡتَرَىٰ","وَلَٰكِن","تَصۡدِيقَ","ٱلَّذِي","بَيۡنَ","يَدَيۡهِ","وَتَفۡصِيلَ","كُلِّ","شَيۡءٖ","وَهُدٗى","وَرَحۡمَةٗ","لِّقَوۡمٖ","يُؤۡمِنُونَ"],"лаḳад кана фии ḳасасихим `ибратул ли'улил албаби ма кана хадиисан йуфтара валакин тасдииḳал лазии байна йадайхи ватафсиила кулли шай'ин вахудан варахматал лиḳаумин йу'минуун","В повествовании о них содержится назидание для обладающих разумом. Это - не вымышленный рассказ, а подтверждение тому, что было до него, разъяснение всякой вещи, верное руководство и милость для верующих людей.",["Действительно","было","в","их историях","назидание","для обладающих","разумом","не","было","рассказом","выдуманным","но","подтверждением","того, что","между","его руками (до него)","и разъяснением","всякой","вещи","и руководством","и милостью","для людей","которые веруют"]]],"m":[[["وَمَا","И не",12,104],["تَسۡـَٔلُهُمۡ","ты просишь у них",12,104],["عَلَيۡهِ","за это",12,104],["مِنۡ","никакой",12,104],["أَجۡرٍۚ","награды",12,104],["إِنۡ","не",12,104],["هُوَ","это",12,104],["إِلَّا","кроме",12,104],["ذِكۡرٞ","напоминание",12,104],["لِّلۡعَٰلَمِينَ","для миров",12,104],[104]],[["وَكَأَيِّن","И сколько же",12,105],["مِّنۡ","из",12,105],["ءَايَةٖ","знамений",12,105],["فِي","на",12,105],["ٱلسَّمَٰوَٰتِ","небесах",12,105],["وَٱلۡأَرۡضِ","и земле",12,105],["يَمُرُّونَ","они проходят",12,105],["عَلَيۡهَا","мимо них",12,105]],[["وَهُمۡ","а они",12,105],["عَنۡهَا","от них",12,105],["مُعۡرِضُونَ","отворачиваются",12,105],[105],["وَمَا","и не",12,106],["يُؤۡمِنُ","верует",12,106],["أَكۡثَرُهُم","большинство их",12,106],["بِٱللَّهِ","в Аллаха",12,106],["إِلَّا","кроме как",12,106]],[["وَهُم","при этом они",12,106],["مُّشۡرِكُونَ","многобожники",12,106],[106],["أَفَأَمِنُوٓاْ","Неужели они в безопасности",12,107],["أَن","что",12,107],["تَأۡتِيَهُمۡ","придёт к ним",12,107],["غَٰشِيَةٞ","покрывающее",12,107],["مِّنۡ","из",12,107],["عَذَابِ","наказания",12,107],["ٱللَّهِ","Аллаха",12,107]],[["أَوۡ","или",12,107],["تَأۡتِيَهُمُ","придёт к ним",12,107],["ٱلسَّاعَةُ","Час",12,107],["بَغۡتَةٗ","внезапно",12,107],["وَهُمۡ","а они",12,107],["لَا","не",12,107],["يَشۡعُرُونَ","осознают",12,107],[107],["قُلۡ","Скажи",12,108],["هَٰذِهِۦ","это",12,108]],[["سَبِيلِيٓ","мой путь",12,108],["أَدۡعُوٓاْ","я призываю",12,108],["إِلَى","к",12,108],["ٱللَّهِۚ","Аллаху",12,108],["عَلَىٰ","с",12,108],["بَصِيرَةٍ","ясным знанием",12,108],["أَنَا۠","я",12,108],["وَمَنِ","и тот, кто",12,108],["ٱتَّبَعَنِيۖ","последовал за мной",12,108],["وَسُبۡحَٰنَ","и пречист",12,108]],[["ٱللَّهِ","Аллах",12,108],["وَمَآ","и не",12,108],["أَنَا۠","я",12,108],["مِنَ","из",12,108],["ٱلۡمُشۡرِكِينَ","многобожников",12,108],[108],["وَمَآ","И не",12,109],["أَرۡسَلۡنَا","Мы посылали",12,109],["مِن","до",12,109],["قَبۡلِكَ","тебя",12,109]],[["إِلَّا","кроме",12,109],["رِجَالٗا","мужей",12,109],["نُّوحِيٓ","Мы внушали",12,109],["إِلَيۡهِم","им",12,109],["مِّنۡ","из",12,109],["أَهۡلِ","жителей",12,109],["ٱلۡقُرَىٰٓۗ","селений",12,109],["أَفَلَمۡ","разве не",12,109],["يَسِيرُواْ","они странствовали",12,109],["فِي","по",12,109]],[["ٱلۡأَرۡضِ","земле",12,109],["فَيَنظُرُواْ","и посмотрели бы",12,109],["كَيۡفَ","каким",12,109],["كَانَ","был",12,109],["عَٰقِبَةُ","конец",12,109],["ٱلَّذِينَ","тех, которые",12,109],["مِن","до",12,109],["قَبۡلِهِمۡۗ","них",12,109]],[["وَلَدَارُ","и непременно обитель",12,109],["ٱلۡأٓخِرَةِ","Последней жизни",12,109],["خَيۡرٞ","лучше",12,109],["لِّلَّذِينَ","для тех, которые",12,109],["ٱتَّقَوۡاْۚ","боялись (Аллаха)",12,109],["أَفَلَا","разве не",12,109],["تَعۡقِلُونَ","вы разумеете",12,109],[109],["حَتَّىٰٓ","Пока наконец",12,110]],[["إِذَا","когда",12,110],["ٱسۡتَيۡـَٔسَ","отчаялись",12,110],["ٱلرُّسُلُ","посланники",12,110],["وَظَنُّوٓاْ","и подумали",12,110],["أَنَّهُمۡ","что они",12,110],["قَدۡ","уже",12,110],["كُذِبُواْ","сочтены лжецами",12,110],["جَآءَهُمۡ","пришла к ним",12,110]],[["نَصۡرُنَا","Наша помощь",12,110],["فَنُجِّيَ","и были спасены",12,110],["مَن","те, кого",12,110],["نَّشَآءُۖ","Мы пожелаем",12,110],["وَلَا","и не",12,110],["يُرَدُّ","отвращается",12,110],["بَأۡسُنَا","Наша кара",12,110],["عَنِ","от",12,110],["ٱلۡقَوۡمِ","людей",12,110],["ٱلۡمُجۡرِمِينَ","грешных",12,110]],[[110],["لَقَدۡ","Действительно",12,111],["كَانَ","было",12,111],["فِي","в",12,111],["قَصَصِهِمۡ","их историях",12,111],["عِبۡرَةٞ","назидание",12,111],["لِّأُوْلِي","для обладающих",12,111],["ٱلۡأَلۡبَٰبِۗ","разумом",12,111],["مَا","не",12,111],["كَانَ","было",12,111]],[["حَدِيثٗا","рассказом",12,111],["يُفۡتَرَىٰ","выдуманным",12,111],["وَلَٰكِن","но",12,111],["تَصۡدِيقَ","подтверждением",12,111],["ٱلَّذِي","того, что",12,111],["بَيۡنَ","между",12,111],["يَدَيۡهِ","его руками (до него)",12,111]],[["وَتَفۡصِيلَ","и разъяснением",12,111],["كُلِّ","всякой",12,111],["شَيۡءٖ","вещи",12,111],["وَهُدٗى","и руководством",12,111],["وَرَحۡمَةٗ","и милостью",12,111],["لِّقَوۡمٖ","для людей",12,111],["يُؤۡمِنُونَ","которые веруют",12,111],[111]]]}