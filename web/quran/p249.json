{"p":249,"j":13,"a":[[13,1,["الٓمٓرۚ","تِلۡكَ","ءَايَٰتُ","ٱلۡكِتَٰبِۗ","وَٱلَّذِيٓ","أُنزِلَ","إِلَيۡكَ","مِن","رَّبِّكَ","ٱلۡحَقُّ","وَلَٰكِنَّ","أَكۡثَرَ","ٱلنَّاسِ","لَا","يُؤۡمِنُونَ"],"лмр тилка айатул китаби валлазии унзила илайка мир раббикал хаḳḳу валакинна аксаран наси ла йу'минуун","Алиф. Лам. Мим. Ра. Это - аяты Писания. Ниспосланное тебе от твоего Господа является истиной, однако большинство людей не верует.",["Алиф Лям Мим Ра","это","аяты","Писания","и то, что","ниспослано","тебе","от","твоего Господа","истина","но","большинство","людей","не","веруют"]],[13,2,["ٱللَّهُ","ٱلَّذِي","رَفَعَ","ٱلسَّمَٰوَٰتِ","بِغَيۡرِ","عَمَدٖ","تَرَوۡنَهَاۖ","ثُمَّ","ٱسۡتَوَىٰ","عَلَى","ٱلۡعَرۡشِۖ","وَسَخَّرَ","ٱلشَّمۡسَ","وَٱلۡقَمَرَۖ","كُلّٞ","يَجۡرِي","لِأَجَلٖ","مُّسَمّٗىۚ","يُدَبِّرُ","ٱلۡأَمۡرَ","يُفَصِّلُ","ٱلۡأٓيَٰتِ","لَعَلَّكُم","بِلِقَآءِ","رَبِّكُمۡ","تُوقِنُونَ"],"аллахул лазии рафа`ас самавати бигайри `амадин тараунаха суммастава `алал `арши васаххараш шамса валḳамара куллун йажрии ли'ажалим мусамман йудаббирул амра йуфассилул айати ла`аллакум билиḳаи раббикум тууḳинуун","Аллах вознес небеса без опор, которые вы могли бы увидеть, а затем вознесся на Трон (или утвердился на Троне). Он подчинил солнце и луну, и они движутся к назначенному сроку. Он управляет делами и разъясняет знамения, - быть может, вы будете убеждены во встрече со своим Господом.",["Аллах","Тот, который","поднял","небеса","без","опор","которые вы видите","затем","Он утвердился","на","Троне","и подчинил","солнце","и луну","каждый","движется","к сроку","назначенному","Он управляет","делом","Он разъясняет","знамения","чтобы вы","во встречу","с вашим Господом","уверовали твёрдо"]],[13,3,["وَهُوَ","ٱلَّذِي","مَدَّ","ٱلۡأَرۡضَ","وَجَعَلَ","فِيهَا","رَوَٰسِيَ","وَأَنۡهَٰرٗاۖ","وَمِن","كُلِّ","ٱلثَّمَرَٰتِ","جَعَلَ","فِيهَا","زَوۡجَيۡنِ","ٱثۡنَيۡنِۖ","يُغۡشِي","ٱلَّيۡلَ","ٱلنَّهَارَۚ","إِنَّ","فِي","ذَٰلِكَ","لَأٓيَٰتٖ","لِّقَوۡمٖ","يَتَفَكَّرُونَ"],"вахуал лазии маддал арда важа`ала фииха равасийа ва'анхаран вамин куллис самарати жа`ала фииха заужайниснайни йугшил лайлан нахара инна фии залика ла'айатил лиḳаумин йатафаккаруун","Он - Тот, Кто распростер землю, установил на ней незыблемые горы и реки, взрастил на ней из разных плодов по паре. Он покрывает день ночью. Воистину, в этом - знамения для людей размышляющих.",["И Он","Тот, который","простёр","землю","и сделал","на ней","прочные горы","и реки","и из","всех","плодов","Он сделал","на ней","пары","по два","Он покрывает","ночью","день","поистине","в","этом","непременно знамения","для людей","которые размышляют"]],[13,4,["وَفِي","ٱلۡأَرۡضِ","قِطَعٞ","مُّتَجَٰوِرَٰتٞ","وَجَنَّٰتٞ","مِّنۡ","أَعۡنَٰبٖ","وَزَرۡعٞ","وَنَخِيلٞ","صِنۡوَانٞ","وَغَيۡرُ","صِنۡوَانٖ","يُسۡقَىٰ","بِمَآءٖ","وَٰحِدٖ","وَنُفَضِّلُ","بَعۡضَهَا","عَلَىٰ","بَعۡضٖ","فِي","ٱلۡأُكُلِۚ","إِنَّ","فِي","ذَٰلِكَ","لَأٓيَٰتٖ","لِّقَوۡمٖ","يَعۡقِلُونَ"],"вафил арди ḳита`ум мутажавиратун важаннатум мин а`набин вазар`ун ванахиилун синванун вагайру синванин йусḳа бимаин вахидин вануфаддилу ба`даха `ала ба`дин фил укули инна фии залика ла'айатил лиḳаумин йа`ḳилуун","На земле есть сопредельные участки, виноградные сады, посевы, финиковые пальмы, растущие из одного корня или из разных корней. Их орошают одной водой, но одни из них Мы создаем более вкусными, чем другие. Воистину, в этом - знамения для людей разумеющих.",["И на","земле","участки","соседние","и сады","из","виноградных лоз","и посевы","и пальмы","из одного корня","и не","из одного корня","орошаемые","водой","одной","и Мы даём превосходство","одним из них","над","другими","в","плодах","поистине","в","этом","непременно знамения","для людей","которые разумеют"]],[13,5,["وَإِن","تَعۡجَبۡ","فَعَجَبٞ","قَوۡلُهُمۡ","أَءِذَا","كُنَّا","تُرَٰبًا","أَءِنَّا","لَفِي","خَلۡقٖ","جَدِيدٍۗ","أُوْلَٰٓئِكَ","ٱلَّذِينَ","كَفَرُواْ","بِرَبِّهِمۡۖ","وَأُوْلَٰٓئِكَ","ٱلۡأَغۡلَٰلُ","فِيٓ","أَعۡنَاقِهِمۡۖ","وَأُوْلَٰٓئِكَ","أَصۡحَٰبُ","ٱلنَّارِۖ","هُمۡ","فِيهَا","خَٰلِدُونَ"],"ва'ин та`жаб фа`ажабун ḳаулухум а'иза кунна турабан а'инна лафии халḳин жадиидин улаикал лазиина кафаруу бираббихим ва'улаикал аглалу фии а`наḳихим ва'улаика асхабун нари хум фииха халидуун","Если ты удивляешься, то удивляйся их словам: «Неужели после того, как мы станем прахом, мы возродимся в новом творении?». Они - те, которые не уверовали в своего Господа. Они - те, у кого на шеях оковы. Они - обитатели Огня, которые пребудут в нем вечно.",["И если","ты удивляешься","то удивительны","их слова","неужели когда","мы станем","прахом","неужели мы","непременно в","творении","новом","те","те, которые","не уверовали","в своего Господа","и те","оковы","на","их шеях","и те","обитатели","Огня","они","в нём","вечно пребывающие"]]],"m":[["h",13],["b"],[["الٓمٓرۚ","Алиф Лям Мим Ра",13,1],["تِلۡكَ","это",13,1],["ءَايَٰتُ","аяты",13,1],["ٱلۡكِتَٰبِۗ","Писания",13,1],["وَٱلَّذِيٓ","и то, что",13,1],["أُنزِلَ","ниспослано",13,1],["إِلَيۡكَ","тебе",13,1],["مِن","от",13,1],["رَّبِّكَ","твоего Господа",13,1],["ٱلۡحَقُّ","истина",13,1]],[["وَلَٰكِنَّ","но",13,1],["أَكۡثَرَ","большинство",13,1],["ٱلنَّاسِ","людей",13,1],["لَا","не",13,1],["يُؤۡمِنُونَ","веруют",13,1],[1],["ٱللَّهُ","Аллах",13,2],["ٱلَّذِي","Тот, который",13,2],["رَفَعَ","поднял",13,2],["ٱلسَّمَٰوَٰتِ","небеса",13,2],["بِغَيۡرِ","без",13,2]],[["عَمَدٖ","опор",13,2],["تَرَوۡنَهَاۖ","которые вы видите",13,2],["ثُمَّ","затем",13,2],["ٱسۡتَوَىٰ","Он утвердился",13,2],["عَلَى","на",13,2],["ٱلۡعَرۡشِۖ","Троне",13,2],["وَسَخَّرَ","и подчинил",13,2],["ٱلشَّمۡسَ","солнце",13,2],["وَٱلۡقَمَرَۖ","и луну",13,2],["كُلّٞ","каждый",13,2]],[["يَجۡرِي","движется",13,2],["لِأَجَلٖ","к сроку",13,2],["مُّسَمّٗىۚ","назначенному",13,2],["يُدَبِّرُ","Он управляет",13,2],["ٱلۡأَمۡرَ","делом",13,2],["يُفَصِّلُ","Он разъясняет",13,2],["ٱلۡأٓيَٰتِ","знамения",13,2],["لَعَلَّكُم","чтобы вы",13,2],["بِلِقَآءِ","во встречу",13,2]],[["رَبِّكُمۡ","с вашим Господом",13,2],["تُوقِنُونَ","уверовали твёрдо",13,2],[2],["وَهُوَ","И Он",13,3],["ٱلَّذِي","Тот, который",13,3],["مَدَّ","простёр",13,3],["ٱلۡأَرۡضَ","землю",13,3],["وَجَعَلَ","и сделал",13,3],["فِيهَا","на ней",13,3],["رَوَٰسِيَ","прочные горы",13,3]],[["وَأَنۡهَٰرٗاۖ","и реки",13,3],["وَمِن","и из",13,3],["كُلِّ","всех",13,3],["ٱلثَّمَرَٰتِ","плодов",13,3],["جَعَلَ","Он сделал",13,3],["فِيهَا","на ней",13,3],["زَوۡجَيۡنِ","пары",13,3],["ٱثۡنَيۡنِۖ","по два",13,3],["يُغۡشِي","Он покрывает",13,3],["ٱلَّيۡلَ","ночью",13,3]],[["ٱلنَّهَارَۚ","день",13,3],["إِنَّ","поистине",13,3],["فِي","в",13,3],["ذَٰلِكَ","этом",13,3],["لَأٓيَٰتٖ","непременно знамения",13,3],["لِّقَوۡمٖ","для людей",13,3],["يَتَفَكَّرُونَ","которые размышляют",13,3],[3],["وَفِي","И на",13,4],["ٱلۡأَرۡضِ","земле",13,4]],[["قِطَعٞ","участки",13,4],["مُّتَجَٰوِرَٰتٞ","соседние",13,4],["وَجَنَّٰتٞ","и сады",13,4],["مِّنۡ","из",13,4],["أَعۡنَٰبٖ","виноградных лоз",13,4],["وَزَرۡعٞ","и посевы",13,4],["وَنَخِيلٞ","и пальмы",13,4],["صِنۡوَانٞ","из одного корня",13,4]],[["وَغَيۡرُ","и не",13,4],["صِنۡوَانٖ","из одного корня",13,4],["يُسۡقَىٰ","орошаемые",13,4],["بِمَآءٖ","водой",13,4],["وَٰحِدٖ","одной",13,4],["وَنُفَضِّلُ","и Мы даём превосходство",13,4],["بَعۡضَهَا","одним из них",13,4],["عَلَىٰ","над",13,4],["بَعۡضٖ","другими",13,4]],[["فِي","в",13,4],["ٱلۡأُكُلِۚ","плодах",13,4],["إِنَّ","поистине",13,4],["فِي","в",13,4],["ذَٰلِكَ","этом",13,4],["لَأٓيَٰتٖ","непременно знамения",13,4],["لِّقَوۡمٖ","для людей",13,4],["يَعۡقِلُونَ","которые разумеют",13,4],[4]],[["۞ وَإِن","И если",13,5],["تَعۡجَبۡ","ты удивляешься",13,5],["فَعَجَبٞ","то удивительны",13,5],["قَوۡلُهُمۡ","их слова",13,5],["أَءِذَا","неужели когда",13,5],["كُنَّا","мы станем",13,5],["تُرَٰبًا","прахом",13,5],["أَءِنَّا","неужели мы",13,5],["لَفِي","непременно в",13,5],["خَلۡقٖ","творении",13,5]],[["جَدِيدٍۗ","новом",13,5],["أُوْلَٰٓئِكَ","те",13,5],["ٱلَّذِينَ","те, которые",13,5],["كَفَرُواْ","не уверовали",13,5],["بِرَبِّهِمۡۖ","в своего Господа",13,5],["وَأُوْلَٰٓئِكَ","и те",13,5],["ٱلۡأَغۡلَٰلُ","оковы",13,5]],[["فِيٓ","на",13,5],["أَعۡنَاقِهِمۡۖ","их шеях",13,5],["وَأُوْلَٰٓئِكَ","и те",13,5],["أَصۡحَٰبُ","обитатели",13,5],["ٱلنَّارِۖ","Огня",13,5],["هُمۡ","они",13,5],["فِيهَا","в нём",13,5],["خَٰلِدُونَ","вечно пребывающие",13,5],[5]]]}