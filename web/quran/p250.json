{"p":250,"j":13,"a":[[13,6,["وَيَسۡتَعۡجِلُونَكَ","بِٱلسَّيِّئَةِ","قَبۡلَ","ٱلۡحَسَنَةِ","وَقَدۡ","خَلَتۡ","مِن","قَبۡلِهِمُ","ٱلۡمَثُلَٰتُۗ","وَإِنَّ","رَبَّكَ","لَذُو","مَغۡفِرَةٖ","لِّلنَّاسِ","عَلَىٰ","ظُلۡمِهِمۡۖ","وَإِنَّ","رَبَّكَ","لَشَدِيدُ","ٱلۡعِقَابِ"],"вайаста`жилуунака биссаййиати ḳаблал хасанати ваḳад халат мин ḳаблихимул масулату ва'инна раббака лазуу магфиратил линнаси `ала зулмихим ва'инна раббака лашадиидул `иḳаб","Они торопят тебя со злом прежде добра, но ведь до них уже были примеры поучительного наказания. Воистину, твой Господь прощает людей, несмотря на их несправедливость. Воистину, твой Господь суров в наказании.",["И они торопят тебя","со злом","прежде","добра","и уже","прошли","до","них","примерные кары","и поистине","твой Господь","непременно обладатель","прощения","для людей","несмотря на","их несправедливость","и поистине","твой Господь","непременно суров","в наказании"]],[13,7,["وَيَقُولُ","ٱلَّذِينَ","كَفَرُواْ","لَوۡلَآ","أُنزِلَ","عَلَيۡهِ","ءَايَةٞ","مِّن","رَّبِّهِۦٓۗ","إِنَّمَآ","أَنتَ","مُنذِرٞۖ","وَلِكُلِّ","قَوۡمٍ","هَادٍ"],"вайаḳуулул лазиина кафаруу лаула унзила `алайхи айатум мир раббихии иннама анта мунзирун валикулли ḳаумин хад","Неверующие говорят: «Почему ему не ниспослано знамение от его Господа?». Воистину, ты - всего лишь предостерегающий увещеватель, и у каждого народа есть наставник.",["И говорят","те, которые","не уверовали","почему не","ниспослано","ему","знамение","от","его Господа","только лишь","ты","увещеватель","и у каждого","народа","наставник"]],[13,8,["ٱللَّهُ","يَعۡلَمُ","مَا","تَحۡمِلُ","كُلُّ","أُنثَىٰ","وَمَا","تَغِيضُ","ٱلۡأَرۡحَامُ","وَمَا","تَزۡدَادُۚ","وَكُلُّ","شَيۡءٍ","عِندَهُۥ","بِمِقۡدَارٍ"],"аллаху йа`ламу ма тахмилу куллу унса вама тагиидул архаму вама таздаду вакуллу шай'ин `индахуу бимиḳдар","Аллаху известно, что носит каждая самка, насколько сжимается или расширяется каждая утроба. Всякая вещь у Него имеет меру.",["Аллах","знает","что","носит","каждая","самка","и что","убавляют","утробы","и что","они прибавляют","и всякая","вещь","у Него","по мере"]],[13,9,["عَٰلِمُ","ٱلۡغَيۡبِ","وَٱلشَّهَٰدَةِ","ٱلۡكَبِيرُ","ٱلۡمُتَعَالِ"],"`алимул гайби вашшахадатил кабиирул мута`ал","Он - Ведающий сокровенное и явное, Большой, Превознесшийся.",["Знающий","сокровенное","и явное","Великий","Превознесённый"]],[13,10,["سَوَآءٞ","مِّنكُم","مَّنۡ","أَسَرَّ","ٱلۡقَوۡلَ","وَمَن","جَهَرَ","بِهِۦ","وَمَنۡ","هُوَ","مُسۡتَخۡفِۭ","بِٱلَّيۡلِ","وَسَارِبُۢ","بِٱلنَّهَارِ"],"саваум минкум ман асаррал ḳаула ваман жахара бихии ваман хуа мустахфи биллайли васарибу биннахар","Скрываете вы свои речи или произносите их вслух, прячетесь вы ночью или открыто передвигаетесь днем - все вы равны перед Аллахом.",["Равны","из вас","тот, кто","скрыл","слово","и тот, кто","произнёс вслух","его","и тот, кто","он","скрывается","ночью","и выходит открыто","днём"]],[13,11,["لَهُۥ","مُعَقِّبَٰتٞ","مِّنۢ","بَيۡنِ","يَدَيۡهِ","وَمِنۡ","خَلۡفِهِۦ","يَحۡفَظُونَهُۥ","مِنۡ","أَمۡرِ","ٱللَّهِۗ","إِنَّ","ٱللَّهَ","لَا","يُغَيِّرُ","مَا","بِقَوۡمٍ","حَتَّىٰ","يُغَيِّرُواْ","مَا","بِأَنفُسِهِمۡۗ","وَإِذَآ","أَرَادَ","ٱللَّهُ","بِقَوۡمٖ","سُوٓءٗا","فَلَا","مَرَدَّ","لَهُۥۚ","وَمَا","لَهُم","مِّن","دُونِهِۦ","مِن","وَالٍ"],"лахуу му`аḳḳибатум мим байни йадайхи вамин халфихии йахфазуунахуу мин амриллахи инналлаха ла йугаййиру ма биḳаумин хатта йугаййируу ма би'анфусихим ва'иза арадаллаху биḳаумин сууан фала марадда лахуу вама лахум мин дуунихии мин вал","Есть у него (человека) ангелы, следующие впереди него и позади него и охраняющие его по повелению Аллаха. Воистину, Аллах не меняет положения людей, пока они не изменят самих себя. Если же Аллах пожелает людям зла, то ничто не предотвратит этого. Нет у них властелина, кроме Него.",["У него","сменяющие друг друга","из","между","его руками (впереди)","и из","позади него","оберегают его","по","повелению","Аллаха","поистине","Аллах","не","меняет","то, что","с людьми","пока не","они изменят","то, что","в них самих","и когда","пожелал","Аллах","людям","зла","то нет","отвращения","ему","и нет","у них","из","помимо Него","никакого","покровителя"]],[13,12,["هُوَ","ٱلَّذِي","يُرِيكُمُ","ٱلۡبَرۡقَ","خَوۡفٗا","وَطَمَعٗا","وَيُنشِئُ","ٱلسَّحَابَ","ٱلثِّقَالَ"],"хуал лазии йуриикумул барḳа хауфан ватама`ан вайуншиус сахабас сиḳал","Он - Тот, Кто показывает вам молнию, чтобы вы боялись и надеялись, и создает тяжелые тучи.",["Он","Тот, который","показывает вам","молнию","на страх","и надежду","и создаёт","облака","тяжёлые"]],[13,13,["وَيُسَبِّحُ","ٱلرَّعۡدُ","بِحَمۡدِهِۦ","وَٱلۡمَلَٰٓئِكَةُ","مِنۡ","خِيفَتِهِۦ","وَيُرۡسِلُ","ٱلصَّوَٰعِقَ","فَيُصِيبُ","بِهَا","مَن","يَشَآءُ","وَهُمۡ","يُجَٰدِلُونَ","فِي","ٱللَّهِ","وَهُوَ","شَدِيدُ","ٱلۡمِحَالِ"],"вайусаббихур ра`ду бихамдихии валмалаикату мин хиифатихии вайурсилус сава`иḳа файусиибу биха ман йашау вахум йужадилууна филлахи вахуа шадиидул михал","Гром прославляет Его хвалой, а также ангелы от страха перед Ним. Он мечет молнии и поражает ими, кого пожелает. Они спорят об Аллахе, а ведь Он силен и суров в наказании.",["И прославляет","гром","хвалой Ему","и ангелы","от","страха перед Ним","и Он посылает","молнии-разряды","и поражает","ими","кого","Он пожелает","а они","препираются","об","Аллахе","а Он","суров","в мощи"]]],"m":[[["وَيَسۡتَعۡجِلُونَكَ","И они торопят тебя",13,6],["بِٱلسَّيِّئَةِ","со злом",13,6],["قَبۡلَ","прежде",13,6],["ٱلۡحَسَنَةِ","добра",13,6],["وَقَدۡ","и уже",13,6],["خَلَتۡ","прошли",13,6],["مِن","до",13,6]],[["قَبۡلِهِمُ","них",13,6],["ٱلۡمَثُلَٰتُۗ","примерные кары",13,6],["وَإِنَّ","и поистине",13,6],["رَبَّكَ","твой Господь",13,6],["لَذُو","непременно обладатель",13,6],["مَغۡفِرَةٖ","прощения",13,6],["لِّلنَّاسِ","для людей",13,6],["عَلَىٰ","несмотря на",13,6],["ظُلۡمِهِمۡۖ","их несправедливость",13,6]],[["وَإِنَّ","и поистине",13,6],["رَبَّكَ","твой Господь",13,6],["لَشَدِيدُ","непременно суров",13,6],["ٱلۡعِقَابِ","в наказании",13,6],[6],["وَيَقُولُ","И говорят",13,7],["ٱلَّذِينَ","те, которые",13,7],["كَفَرُواْ","не уверовали",13,7],["لَوۡلَآ","почему не",13,7]],[["أُنزِلَ","ниспослано",13,7],["عَلَيۡهِ","ему",13,7],["ءَايَةٞ","знамение",13,7],["مِّن","от",13,7],["رَّبِّهِۦٓۗ","его Господа",13,7],["إِنَّمَآ","только лишь",13,7],["أَنتَ","ты",13,7],["مُنذِرٞۖ","увещеватель",13,7],["وَلِكُلِّ","и у каждого",13,7],["قَوۡمٍ","народа",13,7],["هَادٍ","наставник",13,7]],[[7],["ٱللَّهُ","Аллах",13,8],["يَعۡلَمُ","знает",13,8],["مَا","что",13,8],["تَحۡمِلُ","носит",13,8],["كُلُّ","каждая",13,8],["أُنثَىٰ","самка",13,8],["وَمَا","и что",13,8],["تَغِيضُ","убавляют",13,8],["ٱلۡأَرۡحَامُ","утробы",13,8]],[["وَمَا","и что",13,8],["تَزۡدَادُۚ","они прибавляют",13,8],["وَكُلُّ","и всякая",13,8],["شَيۡءٍ","вещь",13,8],["عِندَهُۥ","у Него",13,8],["بِمِقۡدَارٍ","по мере",13,8],[8],["عَٰلِمُ","Знающий",13,9],["ٱلۡغَيۡبِ","сокровенное",13,9]],[["وَٱلشَّهَٰدَةِ","и явное",13,9],["ٱلۡكَبِيرُ","Великий",13,9],["ٱلۡمُتَعَالِ","Превознесённый",13,9],[9],["سَوَآءٞ","Равны",13,10],["مِّنكُم","из вас",13,10],["مَّنۡ","тот, кто",13,10],["أَسَرَّ","скрыл",13,10]],[["ٱلۡقَوۡلَ","слово",13,10],["وَمَن","и тот, кто",13,10],["جَهَرَ","произнёс вслух",13,10],["بِهِۦ","его",13,10],["وَمَنۡ","и тот, кто",13,10],["هُوَ","он",13,10],["مُسۡتَخۡفِۭ","скрывается",13,10],["بِٱلَّيۡلِ","ночью",13,10],["وَسَارِبُۢ","и выходит открыто",13,10]],[["بِٱلنَّهَارِ","днём",13,10],[10],["لَهُۥ","У него",13,11],["مُعَقِّبَٰتٞ","сменяющие друг друга",13,11],["مِّنۢ","из",13,11],["بَيۡنِ","между",13,11],["يَدَيۡهِ","его руками (впереди)",13,11],["وَمِنۡ","и из",13,11],["خَلۡفِهِۦ","позади него",13,11],["يَحۡفَظُونَهُۥ","оберегают его",13,11]],[["مِنۡ","по",13,11],["أَمۡرِ","повелению",13,11],["ٱللَّهِۗ","Аллаха",13,11],["إِنَّ","поистине",13,11],["ٱللَّهَ","Аллах",13,11],["لَا","не",13,11],["يُغَيِّرُ","меняет",13,11],["مَا","то, что",13,11],["بِقَوۡمٍ","с людьми",13,11],["حَتَّىٰ","пока не",13,11],["يُغَيِّرُواْ","они изменят",13,11],["مَا","то, что",13,11],["بِأَنفُسِهِمۡۗ","в них самих",13,11]],[["وَإِذَآ","и когда",13,11],["أَرَادَ","пожелал",13,11],["ٱللَّهُ","Аллах",13,11],["بِقَوۡمٖ","людям",13,11],["سُوٓءٗا","зла",13,11],["فَلَا","то нет",13,11],["مَرَدَّ","отвращения",13,11],["لَهُۥۚ","ему",13,11],["وَمَا","и нет",13,11],["لَهُم","у них",13,11],["مِّن","из",13,11],["دُونِهِۦ","помимо Него",13,11],["مِن","никакого",13,11]],[["وَالٍ","покровителя",13,11],[11],["هُوَ","Он",13,12],["ٱلَّذِي","Тот, который",13,12],["يُرِيكُمُ","показывает вам",13,12],["ٱلۡبَرۡقَ","молнию",13,12],["خَوۡفٗا","на страх",13,12],["وَطَمَعٗا","и надежду",13,12]],[["وَيُنشِئُ","и создаёт",13,12],["ٱلسَّحَابَ","облака",13,12],["ٱلثِّقَالَ","тяжёлые",13,12],[12],["وَيُسَبِّحُ","И прославляет",13,13],["ٱلرَّعۡدُ","гром",13,13],["بِحَمۡدِهِۦ","хвалой Ему",13,13]],[["وَٱلۡمَلَٰٓئِكَةُ","и ангелы",13,13],["مِنۡ","от",13,13],["خِيفَتِهِۦ","страха перед Ним",13,13],["وَيُرۡسِلُ","и Он посылает",13,13],["ٱلصَّوَٰعِقَ","молнии-разряды",13,13],["فَيُصِيبُ","и поражает",13,13],["بِهَا","ими",13,13]],[["مَن","кого",13,13],["يَشَآءُ","Он пожелает",13,13],["وَهُمۡ","а они",13,13],["يُجَٰدِلُونَ","препираются",13,13],["فِي","об",13,13],["ٱللَّهِ","Аллахе",13,13],["وَهُوَ","а Он",13,13],["شَدِيدُ","суров",13,13],["ٱلۡمِحَالِ","в мощи",13,13],[13]]]}