{"p":252,"j":13,"a":[[13,19,["أَفَمَن","يَعۡلَمُ","أَنَّمَآ","أُنزِلَ","إِلَيۡكَ","مِن","رَّبِّكَ","ٱلۡحَقُّ","كَمَنۡ","هُوَ","أَعۡمَىٰٓۚ","إِنَّمَا","يَتَذَكَّرُ","أُوْلُواْ","ٱلۡأَلۡبَٰبِ"],"афаман йа`ламу аннама унзила илайка мир раббикал хаḳḳу каман хуа а`ма иннама йатазаккару улул албаб","Разве тот, кто знает, что ниспосланное тебе является истиной, может быть подобен слепцу? Воистину, поминают это только обладающие разумом,",["Разве же тот, кто","знает","что то, что","ниспослано","тебе","от","твоего Господа","истина","как тот, кто","он","слеп","лишь","внемлют назиданию","обладающие","разумом"]],[13,20,["ٱلَّذِينَ","يُوفُونَ","بِعَهۡدِ","ٱللَّهِ","وَلَا","يَنقُضُونَ","ٱلۡمِيثَٰقَ"],"аллазиина йууфууна би`ахдиллахи вала йанḳудуунал миисаḳ","которые верны завету с Аллахом и не нарушают обязательств,",["те, которые","соблюдают","завет","Аллаха","и не","нарушают","договор"]],[13,21,["وَٱلَّذِينَ","يَصِلُونَ","مَآ","أَمَرَ","ٱللَّهُ","بِهِۦٓ","أَن","يُوصَلَ","وَيَخۡشَوۡنَ","رَبَّهُمۡ","وَيَخَافُونَ","سُوٓءَ","ٱلۡحِسَابِ"],"валлазиина йасилууна ма амараллаху бихии ан йуусала вайахшауна раббахум вайахафууна сууал хисаб","которые поддерживают то, что Аллах велел поддерживать, страшатся своего Господа и боятся ужасного расчета,",["и те, которые","поддерживают","то, что","велел","Аллах","о нём","чтобы","поддерживалось","и страшатся","своего Господа","и боятся","скверного","расчёта"]],[13,22,["وَٱلَّذِينَ","صَبَرُواْ","ٱبۡتِغَآءَ","وَجۡهِ","رَبِّهِمۡ","وَأَقَامُواْ","ٱلصَّلَوٰةَ","وَأَنفَقُواْ","مِمَّا","رَزَقۡنَٰهُمۡ","سِرّٗا","وَعَلَانِيَةٗ","وَيَدۡرَءُونَ","بِٱلۡحَسَنَةِ","ٱلسَّيِّئَةَ","أُوْلَٰٓئِكَ","لَهُمۡ","عُقۡبَى","ٱلدَّارِ"],"валлазиина сабарубтигаа важхи раббихим ва'аḳамус салавата ва'анфаḳуу мимма разаḳнахум сирран ва`аланийатан вайадраууна билхасанатис саййиата улаика лахум `уḳбад дар","которые проявляют терпение, стремясь к Лику своего Господа, совершают намаз, расходуют тайно и открыто из того, чем Мы их наделили, и добром отталкивают зло. Им уготована Последняя обитель -",["и те, которые","терпели","стремясь к","Лику","их Господа","и выстаивали","намаз","и расходовали","из того, что","Мы наделили их","тайно","и открыто","и отталкивают","добром","зло","они","им","исход","обители"]],[13,23,["جَنَّٰتُ","عَدۡنٖ","يَدۡخُلُونَهَا","وَمَن","صَلَحَ","مِنۡ","ءَابَآئِهِمۡ","وَأَزۡوَٰجِهِمۡ","وَذُرِّيَّٰتِهِمۡۖ","وَٱلۡمَلَٰٓئِكَةُ","يَدۡخُلُونَ","عَلَيۡهِم","مِّن","كُلِّ","بَابٖ"],"жаннату `аднин йадхулуунаха ваман салаха мин абаихим ва'азважихим вазурриййатихим валмалаикату йадхулууна `алайхим мин кулли баб","сады Эдема, в которые они войдут вместе со своими праведными отцами, супругами и потомками. Ангелы будут входить к ним через любые врата.",["сады","Эдема","войдут они в них","и тот, кто","был праведен","из","их отцов","и их супруг","и их потомков","и ангелы","будут входить","к ним","из","всяких","врат"]],[13,24,["سَلَٰمٌ","عَلَيۡكُم","بِمَا","صَبَرۡتُمۡۚ","فَنِعۡمَ","عُقۡبَى","ٱلدَّارِ"],"саламун `алайкум бима сабартум фани`ма `уḳбад дар","Мир вам за то, что вы проявили терпение! Как же прекрасна Последняя обитель!",["мир","вам","за то, что","вы терпели","и как прекрасен","исход","обители"]],[13,25,["وَٱلَّذِينَ","يَنقُضُونَ","عَهۡدَ","ٱللَّهِ","مِنۢ","بَعۡدِ","مِيثَٰقِهِۦ","وَيَقۡطَعُونَ","مَآ","أَمَرَ","ٱللَّهُ","بِهِۦٓ","أَن","يُوصَلَ","وَيُفۡسِدُونَ","فِي","ٱلۡأَرۡضِ","أُوْلَٰٓئِكَ","لَهُمُ","ٱللَّعۡنَةُ","وَلَهُمۡ","سُوٓءُ","ٱلدَّارِ"],"валлазиина йанḳудууна `ахдаллахи мим ба`ди миисаḳихии вайаḳта`ууна ма амараллаху бихии ан йуусала вайуфсидууна фил арди улаика лахумул ла`нату валахум сууд дар","А тем, которые нарушают завет с Аллахом после того, как они заключили его, разрывают то, что Аллах велел поддерживать, и распространяют нечестие на земле, уготованы проклятие и Скверная обитель.",["и те, которые","нарушают","завет","Аллаха","из","после","его заключения","и разрывают","то, что","велел","Аллах","о нём","чтобы","поддерживалось","и сеют порчу","на","земле","они","им","проклятие","и им","скверная","обитель"]],[13,26,["ٱللَّهُ","يَبۡسُطُ","ٱلرِّزۡقَ","لِمَن","يَشَآءُ","وَيَقۡدِرُۚ","وَفَرِحُواْ","بِٱلۡحَيَوٰةِ","ٱلدُّنۡيَا","وَمَا","ٱلۡحَيَوٰةُ","ٱلدُّنۡيَا","فِي","ٱلۡأٓخِرَةِ","إِلَّا","مَتَٰعٞ"],"аллаху йабсутур ризḳа лиман йашау вайаḳдиру вафарихуу билхайаватид дунйа вамал хайаватуд дунйа фил ахирати илла мата`","Аллах увеличивает или ограничивает удел тому, кому пожелает. Они радуются мирской жизни, но ведь мирская жизнь по сравнению с Последней жизнью - всего лишь преходящее удовольствие.",["Аллах","расширяет","удел","тому, кому","Он пожелает","и ограничивает","и обрадовались они","жизни","мирской","и не (есть)","жизнь","мирская","по сравнению с","Последней жизнью","кроме","пользования"]],[13,27,["وَيَقُولُ","ٱلَّذِينَ","كَفَرُواْ","لَوۡلَآ","أُنزِلَ","عَلَيۡهِ","ءَايَةٞ","مِّن","رَّبِّهِۦۚ","قُلۡ","إِنَّ","ٱللَّهَ","يُضِلُّ","مَن","يَشَآءُ","وَيَهۡدِيٓ","إِلَيۡهِ","مَنۡ","أَنَابَ"],"вайаḳуулул лазиина кафаруу лаула унзила `алайхи айатум мир раббихии ḳул инналлаха йудиллу ман йашау вайахдии илайхи ман анаб","Неверующие говорят: «Почему ему не ниспослано знамение от его Господа?». Скажи: «Аллах вводит в заблуждение того, кого пожелает, и ведет прямым путем тех, кто обратился к Нему с покаянием».",["и говорят","те, которые","не уверовали","почему не","ниспослано","ему","знамение","от","его Господа","скажи","поистине","Аллах","вводит в заблуждение","кого","Он пожелает","и ведёт","к Себе","того, кто","обратился"]],[13,28,["ٱلَّذِينَ","ءَامَنُواْ","وَتَطۡمَئِنُّ","قُلُوبُهُم","بِذِكۡرِ","ٱللَّهِۗ","أَلَا","بِذِكۡرِ","ٱللَّهِ","تَطۡمَئِنُّ","ٱلۡقُلُوبُ"],"аллазиина амануу вататмаинну ḳулуубухум бизикриллахи ала бизикриллахи татмаиннул ḳулууб","Они уверовали, и их сердца утешаются поминанием Аллаха. Разве не поминанием Аллаха утешаются сердца?",["те, которые","уверовали","и успокаиваются","их сердца","поминанием","Аллаха","разве не","поминанием","Аллаха","успокаиваются","сердца"]]],"m":[[["۞ أَفَمَن","Разве же тот, кто",13,19],["يَعۡلَمُ","знает",13,19],["أَنَّمَآ","чт