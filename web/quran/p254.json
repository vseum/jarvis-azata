{"p":254,"j":13,"a":[[13,35,["مَّثَلُ","ٱلۡجَنَّةِ","ٱلَّتِي","وُعِدَ","ٱلۡمُتَّقُونَۖ","تَجۡرِي","مِن","تَحۡتِهَا","ٱلۡأَنۡهَٰرُۖ","أُكُلُهَا","دَآئِمٞ","وَظِلُّهَاۚ","تِلۡكَ","عُقۡبَى","ٱلَّذِينَ","ٱتَّقَواْۚ","وَّعُقۡبَى","ٱلۡكَٰفِرِينَ","ٱلنَّارُ"],"ммасалул жаннатил латии ву`идал муттаḳууна тажрии мин тахтихал анхару укулуха даимун вазиллуха тилка `уḳбал лазиинаттаḳав вва`уḳбал кафириинан нар","Вот описание Рая, обещанного богобоязненным. Там текут реки, не иссякают яства, и не исчезает тень. Таков конец богобоязненных, а концом неверующих будет Огонь.",["подобие","Рая","который","обещан","богобоязненным","текут","из","под ним","реки","его пища","постоянна","и его тень","это","исход","тех, которые","были богобоязненны","а исход","неверующих","Огонь"]],[13,36,["وَٱلَّذِينَ","ءَاتَيۡنَٰهُمُ","ٱلۡكِتَٰبَ","يَفۡرَحُونَ","بِمَآ","أُنزِلَ","إِلَيۡكَۖ","وَمِنَ","ٱلۡأَحۡزَابِ","مَن","يُنكِرُ","بَعۡضَهُۥۚ","قُلۡ","إِنَّمَآ","أُمِرۡتُ","أَنۡ","أَعۡبُدَ","ٱللَّهَ","وَلَآ","أُشۡرِكَ","بِهِۦٓۚ","إِلَيۡهِ","أَدۡعُواْ","وَإِلَيۡهِ","مَـَٔابِ"],"валлазиина атайнахумул китаба йафрахууна бима унзила илайка ваминал ахзаби ман йункиру ба`дахуу ḳул иннама умирту ан а`будаллаха вала ушрика бихии илайхи ад`уу ва'илайхи ма'аб","Те, кому Мы даровали Писание, радуются тому, что ниспослано тебе. Но среди союзников (иудеев и язычников) есть такие, которые отрицают часть этого. Скажи: «Мне велено лишь поклоняться Аллаху и не приобщать к Нему сотоварищей. К Нему я призываю, и к Нему предстоит возвращение».",["и те, которым","Мы дали им","Писание","радуются","тому, что","ниспослано","тебе","а среди","союзников","есть те, кто","отрицает","часть его","скажи","лишь","мне велено","чтобы","я поклонялся","Аллаху","и не","приобщал сотоварищей","к Нему","к Нему","я призываю","и к Нему","моё возвращение"]],[13,37,["وَكَذَٰلِكَ","أَنزَلۡنَٰهُ","حُكۡمًا","عَرَبِيّٗاۚ","وَلَئِنِ","ٱتَّبَعۡتَ","أَهۡوَآءَهُم","بَعۡدَ مَا","جَآءَكَ","مِنَ","ٱلۡعِلۡمِ","مَا","لَكَ","مِنَ","ٱللَّهِ","مِن","وَلِيّٖ","وَلَا","وَاقٖ"],"ваказалика анзалнаху хукман `арабиййан валаиниттаба`та ахваахум ба`дама жаака минал `илми ма лака миналлахи мин валиййин вала ваḳ","Таким образом Мы ниспослали Коран законом на арабском языке. Если ты станешь потакать их желаниям после того, как к тебе явилось знание, то никто вместо Аллаха не станет твоим покровителем и защитником.",["и так","Мы ниспослали его","законом","арабским","и если же","ты последуешь","их желаниям","после того как","пришло к тебе","из","знания","не","тебе","от","Аллаха","никакого","покровителя","и не","защитника"]],[13,38,["وَلَقَدۡ","أَرۡسَلۡنَا","رُسُلٗا","مِّن","قَبۡلِكَ","وَجَعَلۡنَا","لَهُمۡ","أَزۡوَٰجٗا","وَذُرِّيَّةٗۚ","وَمَا","كَانَ","لِرَسُولٍ","أَن","يَأۡتِيَ","بِـَٔايَةٍ","إِلَّا","بِإِذۡنِ","ٱللَّهِۗ","لِكُلِّ","أَجَلٖ","كِتَابٞ"],"валаḳад арсална русулам мин ḳаблика важа`ална лахум азважан вазурриййатан вама кана лирасуулин ан йа'тийа би'айатин илла би'изниллахи ликулли ажалин китаб","Мы посылали до тебя посланников и даровали им супруг и потомство. Ни один посланник не мог явить знамение без соизволения Аллаха. Для каждого срока есть предписание.",["и уже","Мы отправили","посланников","из","до тебя","и Мы сделали","им","жён","и потомство","и не","было","посланнику","чтобы","он явил","знамение","кроме как","с дозволения","Аллаха","для каждого","срока","предписание"]],[13,39,["يَمۡحُواْ","ٱللَّهُ","مَا","يَشَآءُ","وَيُثۡبِتُۖ","وَعِندَهُۥٓ","أُمُّ","ٱلۡكِتَٰبِ"],"йамхуллаху ма йашау вайусбиту ва`индахуу уммул китаб","Аллах стирает и утверждает то, что пожелает, и у Него - Мать Писания.",["стирает","Аллах","что","Он пожелает","и утверждает","и у Него","мать","Писания"]],[13,40,["وَإِن","مَّا","نُرِيَنَّكَ","بَعۡضَ","ٱلَّذِي","نَعِدُهُمۡ","أَوۡ","نَتَوَفَّيَنَّكَ","فَإِنَّمَا","عَلَيۡكَ","ٱلۡبَلَٰغُ","وَعَلَيۡنَا","ٱلۡحِسَابُ"],"ва'им ма нурийаннака ба`дал лазии на`идухум ау натаваффайаннака фа'иннама `алайкал балагу ва`алайнал хисаб","Покажем Мы тебе часть того, что Мы обещаем им, или умертвим тебя, на тебя возложена только передача откровения, а Нам надлежит предъявлять счет.",["и если","же","Мы покажем тебе","часть","того, что","Мы обещаем им","или","Мы упокоим тебя","то лишь","на тебе","передача","а на Нас","расчёт"]],[13,41,["أَوَلَمۡ","يَرَوۡاْ","أَنَّا","نَأۡتِي","ٱلۡأَرۡضَ","نَنقُصُهَا","مِنۡ","أَطۡرَافِهَاۚ","وَٱللَّهُ","يَحۡكُمُ","لَا","مُعَقِّبَ","لِحُكۡمِهِۦۚ","وَهُوَ","سَرِيعُ","ٱلۡحِسَابِ"],"авалам йарау анна на'тил арда нанḳусуха мин атрафиха валлаху йахкуму ла му`аḳḳиба лихукмихии вахуа сарии`ул хисаб","Разве они (неверующие) не видят, как Мы постепенно уменьшаем землю по краям (отдаем ее во владение верующим)? Аллах принимает решения, и никто не отменит Его решения. Он скор в расчете.",["разве же не","видели они","что Мы","приходим","к земле","уменьшаем её","с","её краёв","и Аллах","судит","нет","отменяющего","Его решение","и Он","скор","в расчёте"]],[13,42,["وَقَدۡ","مَكَرَ","ٱلَّذِينَ","مِن","قَبۡلِهِمۡ","فَلِلَّهِ","ٱلۡمَكۡرُ","جَمِيعٗاۖ","يَعۡلَمُ","مَا","تَكۡسِبُ","كُلُّ","نَفۡسٖۗ","وَسَيَعۡلَمُ","ٱلۡكُفَّٰرُ","لِمَنۡ","عُقۡبَى","ٱلدَّارِ"],"ваḳад макарал лазиина мин ḳаблихим фалиллахил макру жамии`ан йа`ламу ма таксибу куллу нафсин васайа`ламул куффару лиман `уḳбад дар","Их предшественники тоже замышляли козни, но все козни - у Аллаха. Ему ведомо то, что приобретает каждая душа, и неверующие узнают, кому достанется Последняя обитель.",["и уже","замышляли козни","те, которые","из","до них","но Аллаху","замысел","весь","Он знает","что","приобретает","каждая","душа","и узнают","неверующие","кому","исход","обители"]]],"m":[[["۞ مَّثَلُ","подобие",13,35],["ٱلۡجَنَّةِ","Рая",13,35],["ٱلَّتِي","который",13,35],["وُعِدَ","обещан",13,35],["ٱلۡمُتَّقُونَۖ","богобоязненным",13,35],["تَجۡرِي","текут",13,35],["مِن","из",13,35],["تَحۡتِهَا","под ним",13,35],["ٱلۡأَنۡهَٰرُۖ","реки",13,35]],[["أُكُلُهَا","его пища",13,35],["دَآئِمٞ","постоянна",13,35],["وَظِلُّهَاۚ","и его тень",13,35],["تِلۡكَ","это",13,35],["عُقۡبَى","исход",13,35],["ٱلَّذِينَ","тех, которые",13,35],["ٱتَّقَواْۚ","были богобоязненны",13,35],["وَّعُقۡبَى","а исход",13,35]],[["ٱلۡكَٰفِرِينَ","неверующих",13,35],["ٱلنَّارُ","Огонь",13,35],[35],["وَٱلَّذِينَ","и те, которым",13,36],["ءَاتَيۡنَٰهُمُ","Мы дали им",13,36],["ٱلۡكِتَٰبَ","Писание",13,36],["يَفۡرَحُونَ","радуются",13,36]],[["بِمَآ","тому, что",13,36],["أُنزِلَ","ниспослано",13,36],["إِلَيۡكَۖ","тебе",13,36],["وَمِنَ","а среди",13,36],["ٱلۡأَحۡزَابِ","союзников",13,36],["مَن","есть те, кто",13,36],["يُنكِرُ","отрицает",13,36],["بَعۡضَهُۥۚ","часть его",13,36],["قُلۡ","скажи",13,36],["إِنَّمَآ","лишь",13,36],["أُمِرۡتُ","мне велено",13,36]],[["أَنۡ","чтобы",13,36],["أَعۡبُدَ","я поклонялся",13,36],["ٱللَّهَ","Аллаху",13,36],["وَلَآ","и не",13,36],["أُشۡرِكَ","приобщал сотоварищей",13,36],["بِهِۦٓۚ","к Нему",13,36],["إِلَيۡهِ","к Нему",13,36],["أَدۡعُواْ","я призываю",13,36],["وَإِلَيۡهِ","и к Нему",13,36],["مَـَٔابِ","моё возвращение",13,36],[36]],[["وَكَذَٰلِكَ","и так",13,37],["أَنزَلۡنَٰهُ","Мы ниспослали его",13,37],["حُكۡمًا","законом",13,37],["عَرَبِيّٗاۚ","арабским",13,37],["وَلَئِنِ","и если же",13,37],["ٱتَّبَعۡتَ","ты последуешь",13,37],["أَهۡوَآءَهُم","их желаниям",13,37],["بَعۡدَ مَا","после того как",13,37]],[["جَآءَكَ","пришло к тебе",13,37],["مِنَ","из",13,37],["ٱلۡعِلۡمِ","знания",13,37],["مَا","не",13,37],["لَكَ","тебе",13,37],["مِنَ","от",13,37],["ٱللَّهِ","Аллаха",13,37],["مِن","никакого",13,37],["وَلِيّٖ","покровителя",13,37],["وَلَا","и не",13,37],["وَاقٖ","защитника",13,37],[37],["وَلَقَدۡ","и уже",13,38]],[["أَرۡسَلۡنَا","Мы отправили",13,38],["رُسُلٗا","посланников",13,38],["مِّن","из",13,38],["قَبۡلِكَ","до тебя",13,38],["وَجَعَلۡنَا","и Мы сделали",13,38],["لَهُمۡ","им",13,38],["أَزۡوَٰجٗا","жён",13,38],["وَذُرِّيَّةٗۚ","и потомство",13,38],["وَمَا","и не",13,38],["كَانَ","было",13,38]],[["لِرَسُولٍ","посланнику",13,38],["أَن","чтобы",13,38],["يَأۡتِيَ","он явил",13,38],["بِـَٔايَةٍ","знамение",13,38],["إِلَّا","кроме как",13,38],["بِإِذۡنِ","с дозволения",13,38],["ٱللَّهِۗ","Аллаха",13,38],["لِكُلِّ","для каждого",13,38],["أَجَلٖ","срока",13,38],["كِتَابٞ","предписание",13,38],[38]],[["يَمۡحُواْ","стирает",13,39],["ٱللَّهُ","Аллах",13,39],["مَا","что",13,39],["يَشَآءُ","Он пожелает",13,39],["وَيُثۡبِتُۖ","и утверждает",13,39],["وَعِندَهُۥٓ","и у Него",13,39],["أُمُّ","мать",13,39],["ٱلۡكِتَٰبِ","Писания",13,39],[39]],[["وَإِن","и если",13,40],["مَّا","же",13,40],["نُرِيَنَّكَ","Мы покажем тебе",13,40],["بَعۡضَ","часть",13,40],["ٱلَّذِي","того, что",13,40],["نَعِدُهُمۡ","Мы обещаем им",13,40],["أَوۡ","или",13,40],["نَتَوَفَّيَنَّكَ","Мы упокоим тебя",13,40],["فَإِنَّمَا","то лишь",13,40],["عَلَيۡكَ","на тебе",13,40]],[["ٱلۡبَلَٰغُ","передача",13,40],["وَعَلَيۡنَا","а на Нас",13,40],["ٱلۡحِسَابُ","расчёт",13,40],[40],["أَوَلَمۡ","разве же не",13,41],["يَرَوۡاْ","видели они",13,41],["أَنَّا","что Мы",13,41],["نَأۡتِي","приходим",13,41],["ٱلۡأَرۡضَ","к земле",13,41],["نَنقُصُهَا","уменьшаем её",13,41]],[["مِنۡ","с",13,41],["أَطۡرَافِهَاۚ","её краёв",13,41],["وَٱللَّهُ","и Аллах",13,41],["يَحۡكُمُ","судит",13,41],["لَا","нет",13,41],["مُعَقِّبَ","отменяющего",13,41],["لِحُكۡمِهِۦۚ","Его решение",13,41],["وَهُوَ","и Он",13,41],["سَرِيعُ","скор",13,41]],[["ٱلۡحِسَابِ","в расчёте",13,41],[41],["وَقَدۡ","и уже",13,42],["مَكَرَ","замышляли козни",13,42],["ٱلَّذِينَ","те, которые",13,42],["مِن","из",13,42],["قَبۡلِهِمۡ","до них",13,42],["فَلِلَّهِ","но Аллаху",13,42],["ٱلۡمَكۡرُ","замысел",13,42],["جَمِيعٗاۖ","весь",13,42]],[["يَعۡلَمُ","Он знает",13,42],["مَا","что",13,42],["تَكۡسِبُ","приобретает",13,42],["كُلُّ","каждая",13,42],["نَفۡسٖۗ","душа",13,42],["وَسَيَعۡلَمُ","и узнают",13,42],["ٱلۡكُفَّٰرُ","неверующие",13,42],["لِمَنۡ","кому",13,42],["عُقۡبَى","исход",13,42],["ٱلدَّارِ","обители",13,42],[42]]]}