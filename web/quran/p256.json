{"p":256,"j":13,"a":[[14,6,["وَإِذۡ","قَالَ","مُوسَىٰ","لِقَوۡمِهِ","ٱذۡكُرُواْ","نِعۡمَةَ","ٱللَّهِ","عَلَيۡكُمۡ","إِذۡ","أَنجَىٰكُم","مِّنۡ","ءَالِ","فِرۡعَوۡنَ","يَسُومُونَكُمۡ","سُوٓءَ","ٱلۡعَذَابِ","وَيُذَبِّحُونَ","أَبۡنَآءَكُمۡ","وَيَسۡتَحۡيُونَ","نِسَآءَكُمۡۚ","وَفِي","ذَٰلِكُم","بَلَآءٞ","مِّن","رَّبِّكُمۡ","عَظِيمٞ"],"ва'из ḳала мууса лиḳаумихизкуруу ни`маталлахи `алайкум из анжакум мин али фир`ауна йасуумуунакум сууал `азаби вайузаббихууна абнаакум вайастахйууна нисаакум вафии заликум балаум мир раббикум `азиим","Вот Муса (Моисей) сказал своему народу: «Помните милость, которую Аллах оказал вам, когда спас вас от народа Фараона. Они подвергали вас ужасным мучениям, резали ваших сыновей и оставляли в живых ваших женщин. Это было для вас великим испытанием (или великой милостью) от вашего Господа».",["и вот","сказал","Муса","своему народу","помните","милость","Аллаха","к вам","когда","Он спас вас","от","рода","Фараона","они подвергали вас","дурному","мучению","и закалывали","ваших сыновей","и оставляли в живых","ваших женщин","и в","этом","испытание","от","вашего Господа","великое"]],[14,7,["وَإِذۡ","تَأَذَّنَ","رَبُّكُمۡ","لَئِن","شَكَرۡتُمۡ","لَأَزِيدَنَّكُمۡۖ","وَلَئِن","كَفَرۡتُمۡ","إِنَّ","عَذَابِي","لَشَدِيدٞ"],"ва'из та'аззана раббукум ла'ин шакартум ла'азииданнакум валаин кафартум инна `азабии лашадиид","Вот ваш Господь возвестил: «Если вы будете благодарны, то Я одарю вас еще большим. А если вы будете неблагодарны, то ведь мучения от Меня тяжки».",["и вот","возвестил","ваш Господь","если","вы возблагодарите","непременно Я приумножу вам","а если","вы будете неблагодарны","поистине","Моё наказание","непременно сурово"]],[14,8,["وَقَالَ","مُوسَىٰٓ","إِن","تَكۡفُرُوٓاْ","أَنتُمۡ","وَمَن","فِي","ٱلۡأَرۡضِ","جَمِيعٗا","فَإِنَّ","ٱللَّهَ","لَغَنِيٌّ","حَمِيدٌ"],"ваḳала мууса ин такфуруу антум ваман фил арди жамии`ан фа'инналлаха лаганиййун хамиид","Муса (Моисей) сказал: «Если вы и все обитатели земли станете неверующими, то ведь Аллах - Богатый, Достохвальный».",["и сказал","Муса","если","станете неверующими","вы","и тот, кто","на","земле","все","то поистине","Аллах","непременно Богатый","Достохвальный"]],[14,9,["أَلَمۡ","يَأۡتِكُمۡ","نَبَؤُاْ","ٱلَّذِينَ","مِن","قَبۡلِكُمۡ","قَوۡمِ","نُوحٖ","وَعَادٖ","وَثَمُودَ","وَٱلَّذِينَ","مِنۢ","بَعۡدِهِمۡ","لَا","يَعۡلَمُهُمۡ","إِلَّا","ٱللَّهُۚ","جَآءَتۡهُمۡ","رُسُلُهُم","بِٱلۡبَيِّنَٰتِ","فَرَدُّوٓاْ","أَيۡدِيَهُمۡ","فِيٓ","أَفۡوَٰهِهِمۡ","وَقَالُوٓاْ","إِنَّا","كَفَرۡنَا","بِمَآ","أُرۡسِلۡتُم","بِهِۦ","وَإِنَّا","لَفِي","شَكّٖ","مِّمَّا","تَدۡعُونَنَآ","إِلَيۡهِ","مُرِيبٖ"],"алам йа'тикум набаул лазиина мин ḳабликум ḳауми нуухин ва`адин васамууда валлазиина мим ба`дихим ла йа`ламухум иллаллаху жаатхум русулухум билбаййинати фараддуу айдийахум фии афвахихим ваḳалуу инна кафарна бима урсилтум бихии ва'инна лафии шакким мимма тад`уунана илайхи мурииб","Разве до вас не дошли вести о народе Нуха (Ноя), адитах и самудянах? И тех, кто жил после них? Никто, кроме Аллаха, не ведает о них. К ним приходили посланники с ясными знамениями, но они клали пальцы в рот и говорили: «Мы не веруем в то, с чем вы посланы, и нас терзают смутные сомнения относительно того, к чему вы призываете».",["разве не","приходила к вам","весть","тех, которые","из","до вас","народа","Нуха","и адитов","и самудян","и тех, которые","из","после них","не","знает их","кроме","Аллах","пришли к ним","их посланники","с ясными знамениями","и вернули они","свои руки","в","свои рты","и сказали","поистине, мы","не уверовали","в то, с чем","вы посланы","с ним","и поистине, мы","непременно в","сомнении","в том, к чему","вы зовёте нас","к нему","тревожном"]],[14,10,["قَالَتۡ","رُسُلُهُمۡ","أَفِي","ٱللَّهِ","شَكّٞ","فَاطِرِ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِۖ","يَدۡعُوكُمۡ","لِيَغۡفِرَ","لَكُم","مِّن","ذُنُوبِكُمۡ","وَيُؤَخِّرَكُمۡ","إِلَىٰٓ","أَجَلٖ","مُّسَمّٗىۚ","قَالُوٓاْ","إِنۡ","أَنتُمۡ","إِلَّا","بَشَرٞ","مِّثۡلُنَا","تُرِيدُونَ","أَن","تَصُدُّونَا","عَمَّا","كَانَ","يَعۡبُدُ","ءَابَآؤُنَا","فَأۡتُونَا","بِسُلۡطَٰنٖ","مُّبِينٖ"],"ḳалат русулухум афиллахи шаккун фатирис самавати вал'арди йад`уукум лийагфира лакум мин зунуубикум вайуаххиракум ила ажалим мусамман ḳалуу ин антум илла башарум мислуна туриидууна ан тасуддууна `амма кана йа`буду абауна фа'тууна бисултаним мубиин","Посланники говорили им: «Неужели вы сомневаетесь в Аллахе - Творце небес и земли? Он призывает вас, чтобы простить ваши грехи и предоставить вам отсрочку до назначенного времени». Они говорили: «Вы - такие же люди, как и мы. Вы хотите увести нас от того, чему поклонялись наши отцы. Приведите же нам ясное доказательство».",["сказали","их посланники","разве в","Аллахе","сомнение","Творце","небес","и земли","Он зовёт вас","чтобы Он простил","вам","из","ваших грехов","и отсрочил вам","до","срока","назначенного","сказали они","не","вы","кроме","люди","подобные нам","вы хотите","чтобы","отвратить нас","от того, чему","бывало","поклонялись","наши отцы","так приведите нам","доказательство","ясное"]]],"m":[[["وَإِذۡ","и вот",14,6],["قَالَ","сказал",14,6],["مُوسَىٰ","Муса",14,6],["لِقَوۡمِهِ","своему народу",14,6],["ٱذۡكُرُواْ","помните",14,6],["نِعۡمَةَ","милость",14,6],["ٱللَّهِ","Аллаха",14,6],["عَلَيۡكُمۡ","к вам",14,6]],[["إِذۡ","когда",14,6],["أَنجَىٰكُم","Он спас вас",14,6],["مِّنۡ","от",14,6],["ءَالِ","рода",14,6],["فِرۡعَوۡنَ","Фараона",14,6],["يَسُومُونَكُمۡ","они подвергали вас",14,6],["سُوٓءَ","дурному",14,6],["ٱلۡعَذَابِ","мучению",14,6]],[["وَيُذَبِّحُونَ","и закалывали",14,6],["أَبۡنَآءَكُمۡ","ваших сыновей",14,6],["وَيَسۡتَحۡيُونَ","и оставляли в живых",14,6],["نِسَآءَكُمۡۚ","ваших женщин",14,6],["وَفِي","и в",14,6]],[["ذَٰلِكُم","этом",14,6],["بَلَآءٞ","испытание",14,6],["مِّن","от",14,6],["رَّبِّكُمۡ","вашего Господа",14,6],["عَظِيمٞ","великое",14,6],[6],["وَإِذۡ","и вот",14,7],["تَأَذَّنَ","возвестил",14,7]],[["رَبُّكُمۡ","ваш Господь",14,7],["لَئِن","если",14,7],["شَكَرۡتُمۡ","вы возблагодарите",14,7],["لَأَزِيدَنَّكُمۡۖ","непременно Я приумножу вам",14,7],["وَلَئِن","а если",14,7],["كَفَرۡتُمۡ","вы будете неблагодарны",14,7],["إِنَّ","поистине",14,7]],[["عَذَابِي","Моё наказание",14,7],["لَشَدِيدٞ","непременно сурово",14,7],[7],["وَقَالَ","и сказал",14,8],["مُوسَىٰٓ","Муса",14,8],["إِن","если",14,8],["تَكۡفُرُوٓاْ","станете неверующими",14,8],["أَنتُمۡ","вы",14,8],["وَمَن","и тот, кто",14,8],["فِي","на",14,8],["ٱلۡأَرۡضِ","земле",14,8]],[["جَمِيعٗا","все",14,8],["فَإِنَّ","то поистине",14,8],["ٱللَّهَ","Аллах",14,8],["لَغَنِيٌّ","непременно Богатый",14,8],["حَمِيدٌ","Достохвальный",14,8],[8],["أَلَمۡ","разве не",14,9],["يَأۡتِكُمۡ","приходила к вам",14,9],["نَبَؤُاْ","весть",14,9],["ٱلَّذِينَ","тех, которые",14,9]],[["مِن","из",14,9],["قَبۡلِكُمۡ","до вас",14,9],["قَوۡمِ","народа",14,9],["نُوحٖ","Нуха",14,9],["وَعَادٖ","и адитов",14,9],["وَثَمُودَ","и самудян",14,9],["وَٱلَّذِينَ","и тех, которые",14,9],["مِنۢ","из",14,9]],[["بَعۡدِهِمۡ","после них",14,9],["لَا","не",14,9],["يَعۡلَمُهُمۡ","знает их",14,9],["إِلَّا","кроме",14,9],["ٱللَّهُۚ","Аллах",14,9],["جَآءَتۡهُمۡ","пришли к ним",14,9],["رُسُلُهُم","их посланники",14,9],["بِٱلۡبَيِّنَٰتِ","с ясными знамениями",14,9]],[["فَرَدُّوٓاْ","и вернули они",14,9],["أَيۡدِيَهُمۡ","свои руки",14,9],["فِيٓ","в",14,9],["أَفۡوَٰهِهِمۡ","свои рты",14,9],["وَقَالُوٓاْ","и сказали",14,9],["إِنَّا","поистине, мы",14,9],["كَفَرۡنَا","не уверовали",14,9],["بِمَآ","в то, с чем",14,9],["أُرۡسِلۡتُم","вы посланы",14,9]],[["بِهِۦ","с ним",14,9],["وَإِنَّا","и поистине, мы",14,9],["لَفِي","непременно в",14,9],["شَكّٖ","сомнении",14,9],["مِّمَّا","в том, к чему",14,9],["تَدۡعُونَنَآ","вы зовёте нас",14,9],["إِلَيۡهِ","к нему",14,9],["مُرِيبٖ","тревожном",14,9],[9],["۞ قَالَتۡ","сказали",14,10]],[["رُسُلُهُمۡ","их посланники",14,10],["أَفِي","разве в",14,10],["ٱللَّهِ","Аллахе",14,10],["شَكّٞ","сомнение",14,10],["فَاطِرِ","Творце",14,10],["ٱلسَّمَٰوَٰتِ","небес",14,10],["وَٱلۡأَرۡضِۖ","и земли",14,10],["يَدۡعُوكُمۡ","Он зовёт вас",14,10]],[["لِيَغۡفِرَ","чтобы Он простил",14,10],["لَكُم","вам",14,10],["مِّن","из",14,10],["ذ