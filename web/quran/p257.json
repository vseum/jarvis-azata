{"p":257,"j":13,"a":[[14,11,["قَالَتۡ","لَهُمۡ","رُسُلُهُمۡ","إِن","نَّحۡنُ","إِلَّا","بَشَرٞ","مِّثۡلُكُمۡ","وَلَٰكِنَّ","ٱللَّهَ","يَمُنُّ","عَلَىٰ","مَن","يَشَآءُ","مِنۡ","عِبَادِهِۦۖ","وَمَا","كَانَ","لَنَآ","أَن","نَّأۡتِيَكُم","بِسُلۡطَٰنٍ","إِلَّا","بِإِذۡنِ","ٱللَّهِۚ","وَعَلَى","ٱللَّهِ","فَلۡيَتَوَكَّلِ","ٱلۡمُؤۡمِنُونَ"],"ḳалат лахум русулухум ин нахну илла башарум мислукум валакинналлаха йамунну `ала ман йашау мин `ибадихии вама кана лана ан на'тийакум бисултанин илла би'изниллахи ва`алаллахи фалйатаваккалил му'минуун","Посланники говорили им: «Мы - такие же люди, как и вы. Однако Аллах одаряет Своей милостью того из Своих рабов, кого пожелает. Мы не можем явить вам знамение без соизволения Аллаха. Пусть же верующие уповают только на Аллаха!",["сказали","им","их посланники","не","мы","кроме","люди","подобные вам","но","Аллах","оказывает милость","к","тому, кого","Он пожелает","из","Своих рабов","и не","было","нам","чтобы","мы явили вам","доказательство","кроме как","с дозволения","Аллаха","и на","Аллаха","пусть уповают","верующие"]],[14,12,["وَمَا","لَنَآ","أَلَّا","نَتَوَكَّلَ","عَلَى","ٱللَّهِ","وَقَدۡ","هَدَىٰنَا","سُبُلَنَاۚ","وَلَنَصۡبِرَنَّ","عَلَىٰ","مَآ","ءَاذَيۡتُمُونَاۚ","وَعَلَى","ٱللَّهِ","فَلۡيَتَوَكَّلِ","ٱلۡمُتَوَكِّلُونَ"],"вама лана алла натаваккала `алаллахи ваḳад хадана субулана валанасбиранна `ала ма азайтумууна ва`алаллахи фалйатаваккалил мутаваккилуун","Отчего же нам не уповать на Аллаха, если Он повел нас нашими путями? Мы непременно стерпим причиняемые вами мучения. Пусть же уповающие уповают только на Аллаха!».",["и что","нам","чтобы не","мы уповали","на","Аллаха","а уже","Он повёл нас","нашими путями","и непременно мы стерпим","на","то, что","вы причинили нам","и на","Аллаха","пусть уповают","уповающие"]],[14,13,["وَقَالَ","ٱلَّذِينَ","كَفَرُواْ","لِرُسُلِهِمۡ","لَنُخۡرِجَنَّكُم","مِّنۡ","أَرۡضِنَآ","أَوۡ","لَتَعُودُنَّ","فِي","مِلَّتِنَاۖ","فَأَوۡحَىٰٓ","إِلَيۡهِمۡ","رَبُّهُمۡ","لَنُهۡلِكَنَّ","ٱلظَّٰلِمِينَ"],"ваḳалал лазиина кафаруу лирусулихим ланухрижаннакум мин ардина ау лата`уудунна фии миллатина фа'ауха илайхим раббухум ланухликанназ залимиин","Неверующие говорили своим посланникам: «Мы изгоним вас с нашей земли, или же вы вернетесь в нашу религию». Тогда Господь внушал им: «Мы непременно погубим беззаконников",["и сказали","те, которые","не уверовали","своим посланникам","непременно мы изгоним вас","из","нашей земли","или","непременно вы вернётесь","в","нашу веру","и внушил","им","их Господь","непременно Мы погубим","беззаконников"]],[14,14,["وَلَنُسۡكِنَنَّكُمُ","ٱلۡأَرۡضَ","مِنۢ","بَعۡدِهِمۡۚ","ذَٰلِكَ","لِمَنۡ","خَافَ","مَقَامِي","وَخَافَ","وَعِيدِ"],"валанускинаннакумул арда мим ба`дихим залика лиман хафа маḳамии вахафа ва`иид","и поселим вас на земле после них. Так будет с теми, кто боится предстать предо Мной и боится Моей угрозы».",["и непременно Мы поселим вас","на земле","из","после них","это","для того, кто","боялся","стояния предо Мной","и боялся","Моей угрозы"]],[14,15,["وَٱسۡتَفۡتَحُواْ","وَخَابَ","كُلُّ","جَبَّارٍ","عَنِيدٖ"],"вастафтахуу вахаба куллу жаббарин `аниид","Они молили о победе, и каждый упорный притеснитель оказывался в убытке.",["и они просили победы","и потерпел неудачу","каждый","тиран","упрямый"]],[14,16,["مِّن","وَرَآئِهِۦ","جَهَنَّمُ","وَيُسۡقَىٰ","مِن","مَّآءٖ","صَدِيدٖ"],"ммин вараихии жаханнаму вайусḳа мим маин садиид","А впереди его ожидает Геенна, и поить его будут гнойной водой.",["из","впереди него","Геенна","и будет напоен","из","воды","гнойной"]],[14,17,["يَتَجَرَّعُهُۥ","وَلَا","يَكَادُ","يُسِيغُهُۥ","وَيَأۡتِيهِ","ٱلۡمَوۡتُ","مِن","كُلِّ","مَكَانٖ","وَمَا","هُوَ","بِمَيِّتٖۖ","وَمِن","وَرَآئِهِۦ","عَذَابٌ","غَلِيظٞ"],"йатажарра`ухуу вала йакаду йусиигухуу вайа'тиихил мауту мин кулли маканин вама хуа бимаййитин вамин вараихии `азабун галииз","Он будет пить ее глотками, но едва ли сможет проглотить ее. Смерть будет подступать к нему со всех сторон, однако он не умрет, ибо перед ним будут тяжкие мучения.",["он глотает её","и не","почти","проглатывает её","и приходит к нему","смерть","с","каждого","места","и не","он","умерший","и","перед ним","мучение","суровое"]],[14,18,["مَّثَلُ","ٱلَّذِينَ","كَفَرُواْ","بِرَبِّهِمۡۖ","أَعۡمَٰلُهُمۡ","كَرَمَادٍ","ٱشۡتَدَّتۡ","بِهِ","ٱلرِّيحُ","فِي","يَوۡمٍ","عَاصِفٖۖ","لَّا","يَقۡدِرُونَ","مِمَّا","كَسَبُواْ","عَلَىٰ","شَيۡءٖۚ","ذَٰلِكَ","هُوَ","ٱلضَّلَٰلُ","ٱلۡبَعِيدُ"],"ммасалул лазиина кафаруу бираббихим а`малухум карамадиништаддат бихир рииху фии йаумин `асифил ла йаḳдирууна мимма касабуу `ала шай'ин залика хуад далалул ба`иид","Деяния тех, кто не уверовал в своего Господа, подобны пеплу, над которым пронесся сильный ветер в ветреный день. Они не смогут распоряжаться ничем из того, что приобрели. Это и есть глубокое заблуждение.",["подобие","тех, которые","не уверовали","в своего Господа","их деяния","как пепел","усилился","над ним","ветер","в","день","бурный","не","они властны","из того, что","они приобрели","над","чем-либо","это","оно","заблуждение","далёкое"]]],"m":[[["قَالَتۡ","сказали",14,11],["لَهُمۡ","им",14,11],["رُسُلُهُمۡ","их посланники",14,11],["إِن","не",14,11],["نَّحۡنُ","мы",14,11],["إِلَّا","кроме",14,11],["بَشَرٞ","люди",14,11],["مِّثۡلُكُمۡ","подобные вам",14,11],["وَلَٰكِنَّ","но",14,11],["ٱللَّهَ","Аллах",14,11]],[["يَمُنُّ","оказывает милость",14,11],["عَلَىٰ","к",14,11],["مَن","тому, кого",14,11],["يَشَآءُ","Он пожелает",14,11],["مِنۡ","из",14,11],["عِبَادِهِۦۖ","Своих рабов",14,11],["وَمَا","и не",14,11],["كَانَ","было",14,11],["لَنَآ","нам",14,11],["أَن","чтобы",14,11],["نَّأۡتِيَكُم","мы явили вам",14,11]],[["بِسُلۡطَٰنٍ","доказательство",14,11],["إِلَّا","кроме как",14,11],["بِإِذۡنِ","с дозволения",14,11],["ٱللَّهِۚ","Аллаха",14,11],["وَعَلَى","и на",14,11],["ٱللَّهِ","Аллаха",14,11],["فَلۡيَتَوَكَّلِ","пусть уповают",14,11],["ٱلۡمُؤۡمِنُونَ","верующие",14,11]],[[11],["وَمَا","и что",14,12],["لَنَآ","нам",14,12],["أَلَّا","чтобы не",14,12],["نَتَوَكَّلَ","мы уповали",14,12],["عَلَى","на",14,12],["ٱللَّهِ","Аллаха",14,12],["وَقَدۡ","а уже",14,12],["هَدَىٰنَا","Он повёл нас",14,12],["سُبُلَنَاۚ","нашими путями",14,12]],[["وَلَنَصۡبِرَنَّ","и непременно мы стерпим",14,12],["عَلَىٰ","на",14,12],["مَآ","то, что",14,12],["ءَاذَيۡتُمُونَاۚ","вы причинили нам",14,12],["وَعَلَى","и на",14,12],["ٱللَّهِ","Аллаха",14,12],["فَلۡيَتَوَكَّلِ","пусть уповают",14,12],["ٱلۡمُتَوَكِّلُونَ","уповающие",14,12]],[[12],["وَقَالَ","и сказали",14,13],["ٱلَّذِينَ","те, которые",14,13],["كَفَرُواْ","не уверовали",14,13],["لِرُسُلِهِمۡ","своим посланникам",14,13],["لَنُخۡرِجَنَّكُم","непременно мы изгоним вас",14,13],["مِّنۡ","из",14,13]],[["أَرۡضِنَآ","нашей земли",14,13],["أَوۡ","или",14,13],["لَتَعُودُنَّ","непременно вы вернётесь",14,13],["فِي","в",14,13],["مِلَّتِنَاۖ","нашу веру",14,13],["فَأَوۡحَىٰٓ","и внушил",14,13],["إِلَيۡهِمۡ","им",14,13],["رَبُّهُمۡ","их Господь",14,13],["لَنُهۡلِكَنَّ","непременно Мы погубим",14,13]],[["ٱلظَّٰلِمِينَ","беззаконников",14,13],[13],["وَلَنُسۡكِنَنَّكُمُ","и непременно Мы поселим вас",14,14],["ٱلۡأَرۡضَ","на земле",14,14],["مِنۢ","из",14,14],["بَعۡدِهِمۡۚ","после них",14,14]],[["ذَٰلِكَ","это",14,14],["لِمَنۡ","для того, кто",14,14],["خَافَ","боялся",14,14],["مَقَامِي","стояния предо Мной",14,14],["وَخَافَ","и боялся",14,14],["وَعِيدِ","Моей угрозы",14,14],[14],["وَٱسۡتَفۡتَحُواْ","и они просили победы",14,15]],[["وَخَابَ","и потерпел неудачу",14,15],["كُلُّ","каждый",14,15],["جَبَّارٍ","тиран",14,15],["عَنِيدٖ","упрямый",14,15],[15],["مِّن","из",14,16],["وَرَآئِهِۦ","впереди него",14,16],["جَهَنَّمُ","Геенна",14,16],["وَيُسۡقَىٰ","и будет напоен",14,16]],[["مِن","из",14,16],["مَّآءٖ","воды",14,16],["صَدِيدٖ","гнойной",14,16],[16],["يَتَجَرَّعُهُۥ","он глотает её",14,17],["وَلَا","и не",14,17],["يَكَادُ","почти",14,17],["يُسِيغُهُۥ","проглатывает её",14,17]],[["وَيَأۡتِيهِ","и приходит к нему",14,17],["ٱلۡمَوۡتُ","смерть",14,17],["مِن","с",14,17],["كُلِّ","каждого",14,17],["مَكَانٖ","места",14,17],["وَمَا","и не",14,17],["هُوَ","он",14,17],["بِمَيِّتٖۖ","умерший",14,17],["وَمِن","и",14,17]],[["وَرَآئِهِۦ","перед ним",14,17],["عَذَابٌ","мучение",14,17],["غَلِيظٞ","суровое",14,17],[17],["مَّثَلُ","подобие",14,18],["ٱلَّذِينَ","тех, которые",14,18],["كَفَرُواْ","не уверовали",14,18],["بِرَبِّهِمۡۖ","в своего Господа",14,18]],[["أَعۡمَٰلُهُمۡ","их деяния",14,18],["كَرَمَادٍ","как пепел",14,18],["ٱشۡتَدَّتۡ","усилился",14,18],["بِهِ","над ним",14,18],["ٱلرِّيحُ","ветер",14,18],["فِي","в",14,18],["يَوۡمٍ","день",14,18],["عَاصِفٖۖ","бурный",14,18],["لَّا","не",14,18],["يَقۡدِرُونَ","они властны",14,18]],[["مِمَّا","из того, что",14,18],["كَسَبُواْ","они приобрели",14,18],["عَلَىٰ","над",14,18],["شَيۡءٖۚ","чем-либо",14,18],["ذَٰلِكَ","это",14,18],["هُوَ","оно",14,18],["ٱلضَّلَٰلُ","заблуждение",14,18],["ٱلۡبَعِيدُ","далёкое",14,18],[18]]]}