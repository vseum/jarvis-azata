{"p":258,"j":13,"a":[[14,19,["أَلَمۡ","تَرَ","أَنَّ","ٱللَّهَ","خَلَقَ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضَ","بِٱلۡحَقِّۚ","إِن","يَشَأۡ","يُذۡهِبۡكُمۡ","وَيَأۡتِ","بِخَلۡقٖ","جَدِيدٖ"],"алам тара анналлаха халаḳас самавати вал'арда билхаḳḳи ин йаша' йузхибкум вайа'ти бихалḳин жадиид","Разве ты не видишь, что Аллах сотворил небеса и землю ради истины? Если Он пожелает, то уведет вас и приведет другие творения.",["разве не","видишь ты","что","Аллах","сотворил","небеса","и землю","истиной","если","Он пожелает","Он уведёт вас","и приведёт","творение","новое"]],[14,20,["وَمَا","ذَٰلِكَ","عَلَى","ٱللَّهِ","بِعَزِيزٖ"],"вама залика `алаллахи би`азииз","Это для Аллаха не составляет труда.",["и не","это","для","Аллаха","трудно"]],[14,21,["وَبَرَزُواْ","لِلَّهِ","جَمِيعٗا","فَقَالَ","ٱلضُّعَفَٰٓؤُاْ","لِلَّذِينَ","ٱسۡتَكۡبَرُوٓاْ","إِنَّا","كُنَّا","لَكُمۡ","تَبَعٗا","فَهَلۡ","أَنتُم","مُّغۡنُونَ","عَنَّا","مِنۡ","عَذَابِ","ٱللَّهِ","مِن","شَيۡءٖۚ","قَالُواْ","لَوۡ","هَدَىٰنَا","ٱللَّهُ","لَهَدَيۡنَٰكُمۡۖ","سَوَآءٌ","عَلَيۡنَآ","أَجَزِعۡنَآ","أَمۡ","صَبَرۡنَا","مَا","لَنَا","مِن","مَّحِيصٖ"],"вабаразуу лиллахи жамии`ан фаḳалад ду`афау лиллазиинастакбаруу инна кунна лакум таба`ан фахал антум мугнууна `анна мин `азабиллахи мин шай'ин ḳалуу лау хаданаллаху лахадайнакум саваун `алайна ажази`на ам сабарна ма лана мим махиис","Все окажутся перед Аллахом, и тогда слабые скажут тем, которые превозносились: «Воистину, мы следовали за вами. Можете ли вы хоть отчасти избавить нас от наказания Аллаха?». Они скажут: «Если бы Аллах наставил нас на прямой путь, то мы указали бы вам на него. Но теперь нам все равно: будем ли мы горевать или будем терпеть - нам негде укрыться».",["и предстали","пред Аллахом","все","и сказали","слабые","тем, которые","превозносились","поистине, мы","были","вам","последователями","так можете ли","вы","избавляющие","от нас","от","наказания","Аллаха","хоть","что-нибудь","сказали они","если бы","наставил нас","Аллах","непременно мы наставили бы вас","одинаково","нам","горевали ли мы","или","терпели мы","нет","нам","никакого","убежища"]],[14,22,["وَقَالَ","ٱلشَّيۡطَٰنُ","لَمَّا","قُضِيَ","ٱلۡأَمۡرُ","إِنَّ","ٱللَّهَ","وَعَدَكُمۡ","وَعۡدَ","ٱلۡحَقِّ","وَوَعَدتُّكُمۡ","فَأَخۡلَفۡتُكُمۡۖ","وَمَا","كَانَ","لِيَ","عَلَيۡكُم","مِّن","سُلۡطَٰنٍ","إِلَّآ","أَن","دَعَوۡتُكُمۡ","فَٱسۡتَجَبۡتُمۡ","لِيۖ","فَلَا","تَلُومُونِي","وَلُومُوٓاْ","أَنفُسَكُمۖ","مَّآ","أَنَا۠","بِمُصۡرِخِكُمۡ","وَمَآ","أَنتُم","بِمُصۡرِخِيَّ","إِنِّي","كَفَرۡتُ","بِمَآ","أَشۡرَكۡتُمُونِ","مِن","قَبۡلُۗ","إِنَّ","ٱلظَّٰلِمِينَ","لَهُمۡ","عَذَابٌ","أَلِيمٞ"],"ваḳалаш шайтану ламма ḳудийал амру инналлаха ва`адакум ва`дал хаḳḳи вава`адттукум фа'ахлафтукум вама кана лийа `алайкум мин султанин илла ан да`аутукум фастажабтум лии фала талуумуунии валуумуу анфусакум ма ана бимусрихикум вама антум бимусрихиййа иннии кафарту бима ашрактумууни мин ḳаблу инназ залимиина лахум `азабун алиим","Когда дело свершится, дьявол скажет: «Воистину, обещание Аллаха было правдиво, а я обещал вам, но не сдержал данного вам слова. У меня не было над вами никакой власти. Я звал вас, и вы послушались меня. Посему не порицайте меня, а порицайте самих себя. Я не могу помочь вам, а вы не можете помочь мне. Я не причастен к тому, что ранее вы поклонялись мне». Воистину, беззаконникам уготованы мучительные страдания.",["И скажет","сатана","когда","решено","дело","поистине","Аллах","обещал вам","обещанием","истинным","и я обещал вам","но обманул вас","и не","было","у меня","над вами","никакой","власти","кроме","того что","я позвал вас","и вы откликнулись","мне","так не","порицайте меня","и порицайте","самих себя","не","я","помощник вам","и не","вы","помощники мне","поистине, я","отрёкся","от того, что","вы приобщали меня","ранее","прежде","поистине","беззаконникам","для них","наказание","мучительное"]],[14,23,["وَأُدۡخِلَ","ٱلَّذِينَ","ءَامَنُواْ","وَعَمِلُواْ","ٱلصَّٰلِحَٰتِ","جَنَّٰتٖ","تَجۡرِي","مِن","تَحۡتِهَا","ٱلۡأَنۡهَٰرُ","خَٰلِدِينَ","فِيهَا","بِإِذۡنِ","رَبِّهِمۡۖ","تَحِيَّتُهُمۡ","فِيهَا","سَلَٰمٌ"],"ва'удхилал лазиина амануу ва`амилус салихати жаннатин тажрии мин тахтихал анхару халидиина фииха би'изни раббихим тахиййатухум фииха салам","Те, которые уверовали и совершали праведные деяния, будут введены в Райские сады, в которых текут реки. Они пребудут там вечно с дозволения своего Господа. Их приветствием там будет слово: «Мир!».",["И введены будут","те, которые","уверовали","и совершали","праведные деяния","в сады","течёт","из","под ними","реки","вечно пребывая","в них","с дозволения","их Господа","их приветствие","там","мир"]],[14,24,["أَلَمۡ","تَرَ","كَيۡفَ","ضَرَبَ","ٱللَّهُ","مَثَلٗا","كَلِمَةٗ","طَيِّبَةٗ","كَشَجَرَةٖ","طَيِّبَةٍ","أَصۡلُهَا","ثَابِتٞ","وَفَرۡعُهَا","فِي","ٱلسَّمَآءِ"],"алам тара кайфа дарабаллаху масалан калиматан таййибатан кашажаратин таййибатин аслуха сабитун вафар`уха фис сама","Разве ты не видишь, как Аллах приводит притчи? Прекрасное слово подобно прекрасному дереву, корни которого прочны, а ветви восходят к небу.",["Разве не","видел ты","как","привёл","Аллах","притчу","слово","благое","подобно дереву","благому","корень его","прочен","и ветви его","в","небе"]]],"m":[[["أَلَمۡ","разве не",14,19],["تَرَ","видишь ты",14,19],["أَنَّ","что",14,19],["ٱللَّهَ","Аллах",14,19],["خَلَقَ","сотворил",14,19],["ٱلسَّمَٰوَٰتِ","небеса",14,19],["وَٱلۡأَرۡضَ","и землю",14,19],["بِٱلۡحَقِّۚ","истиной",14,19],["إِن","если",14,19],["يَشَأۡ","Он пожелает",14,19]],[["يُذۡهِبۡكُمۡ","Он уведёт вас",14,19],["وَيَأۡتِ","и приведёт",14,19],["بِخَلۡقٖ","творение",14,19],["جَدِيدٖ","новое",14,19],[19],["وَمَا","и не",14,20],["ذَٰلِكَ","это",14,20],["عَلَى","для",14,20],["ٱللَّهِ","Аллаха",14,20],["بِعَزِيزٖ","трудно",14,20]],[[20],["وَبَرَزُواْ","и предстали",14,21],["لِلَّهِ","пред Аллахом",14,21],["جَمِيعٗا","все",14,21],["فَقَالَ","и сказали",14,21],["ٱلضُّعَفَٰٓؤُاْ","слабые",14,21],["لِلَّذِينَ","тем, которые",14,21],["ٱسۡتَكۡبَرُوٓاْ","превозносились",14,21]],[["إِنَّا","поистине, мы",14,21],["كُنَّا","были",14,21],["لَكُمۡ","вам",14,2