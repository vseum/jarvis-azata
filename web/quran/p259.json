{"p":259,"j":13,"a":[[14,25,["تُؤۡتِيٓ","أُكُلَهَا","كُلَّ","حِينِۭ","بِإِذۡنِ","رَبِّهَاۗ","وَيَضۡرِبُ","ٱللَّهُ","ٱلۡأَمۡثَالَ","لِلنَّاسِ","لَعَلَّهُمۡ","يَتَذَكَّرُونَ"],"ту'тии укулаха кулла хиини би'изни раббиха вайадрибуллахул амсала линнаси ла`аллахум йатазаккаруун","Оно плодоносит каждый миг с дозволения своего Господа. Аллах приводит людям притчи, - быть может, они помянут назидание.",["Приносит","плоды свои","всякое","время","с дозволения","его Господа","и приводит","Аллах","притчи","людям","чтобы они","помянули"]],[14,26,["وَمَثَلُ","كَلِمَةٍ","خَبِيثَةٖ","كَشَجَرَةٍ","خَبِيثَةٍ","ٱجۡتُثَّتۡ","مِن","فَوۡقِ","ٱلۡأَرۡضِ","مَا","لَهَا","مِن","قَرَارٖ"],"вамасалу калиматин хабиисатин кашажаратин хабиисатинижтуссат мин фауḳил арди ма лаха мин ḳарар","А скверное слово подобно скверному дереву, которое можно вырвать с поверхности земли, ибо нет у него прочности.",["А пример","слова","скверного","подобен дереву","скверному","вырванному","с","поверхности","земли","нет","у него","никакой","устойчивости"]],[14,27,["يُثَبِّتُ","ٱللَّهُ","ٱلَّذِينَ","ءَامَنُواْ","بِٱلۡقَوۡلِ","ٱلثَّابِتِ","فِي","ٱلۡحَيَوٰةِ","ٱلدُّنۡيَا","وَفِي","ٱلۡأٓخِرَةِۖ","وَيُضِلُّ","ٱللَّهُ","ٱلظَّٰلِمِينَۚ","وَيَفۡعَلُ","ٱللَّهُ","مَا","يَشَآءُ"],"йусаббитуллахул лазиина амануу билḳаулис сабити фил хайаватид дунйа вафил ахирати вайудиллуллахуз залимиина вайаф`алуллаху ма йаша","Аллах поддерживает верующих твердым словом в мирской жизни и Последней жизни. А беззаконников Аллах вводит в заблуждение - Аллах вершит то, что пожелает.",["Укрепляет","Аллах","тех, которые","уверовали","словом","твёрдым","в","жизни","ближней","и в","Последней","и вводит в заблуждение","Аллах","беззаконников","и делает","Аллах","что","пожелает"]],[14,28,["أَلَمۡ","تَرَ","إِلَى","ٱلَّذِينَ","بَدَّلُواْ","نِعۡمَتَ","ٱللَّهِ","كُفۡرٗا","وَأَحَلُّواْ","قَوۡمَهُمۡ","دَارَ","ٱلۡبَوَارِ"],"алам тара илал лазиина баддалуу ни`маталлахи куфран ва'ахаллуу ḳаумахум дарал бавар","Разве ты не видел тех, которые обменяли милость Аллаха на неверие и ввергли свой народ в Обитель погибели -",["Разве не","видел ты","на","тех, которые","заменили","милость","Аллаха","неверием","и поселили","свой народ","в обитель","погибели"]],[14,29,["جَهَنَّمَ","يَصۡلَوۡنَهَاۖ","وَبِئۡسَ","ٱلۡقَرَارُ"],"жаханнама йаслаунаха ваби'сал ḳарар","Геенну, в которой они будут гореть? Как же скверно это местопребывание!",["Геенна","будут гореть в ней","и скверно","пристанище"]],[14,30,["وَجَعَلُواْ","لِلَّهِ","أَندَادٗا","لِّيُضِلُّواْ","عَن","سَبِيلِهِۦۗ","قُلۡ","تَمَتَّعُواْ","فَإِنَّ","مَصِيرَكُمۡ","إِلَى","ٱلنَّارِ"],"важа`алуу лиллахи андадал лийудиллуу `ан сабиилихии ḳул таматта`уу фа'инна масииракум илан нар","Они признавали равных Аллаху, чтобы сбить других с Его пути. Скажи: «Пользуйтесь благами, но ваш путь лежит в Огонь».",["И сделали они","Аллаху","равных","чтобы сбить","с","пути Его","скажи","наслаждайтесь","ибо поистине","ваш путь","к","Огню"]],[14,31,["قُل","لِّعِبَادِيَ","ٱلَّذِينَ","ءَامَنُواْ","يُقِيمُواْ","ٱلصَّلَوٰةَ","وَيُنفِقُواْ","مِمَّا","رَزَقۡنَٰهُمۡ","سِرّٗا","وَعَلَانِيَةٗ","مِّن","قَبۡلِ","أَن","يَأۡتِيَ","يَوۡمٞ","لَّا","بَيۡعٞ","فِيهِ","وَلَا","خِلَٰلٌ"],"ḳул ли`ибадийал лазиина амануу йуḳиимус салавата вайунфиḳуу мимма разаḳнахум сирран ва`аланийатам мин ḳабли ан йа'тийа йаумул ла бай`ун фиихи вала хилал","Скажи тем из Моих рабов, которые уверовали, чтобы они совершали намаз и расходовали явно и тайно из того, чем Мы их наделили, пока не наступит день, когда не будет ни торга, ни дружбы.",["Скажи","рабам Моим","которые","уверовали","пусть совершают","намаз","и расходуют","из того, что","Мы наделили их","тайно","и явно","до","того","как","придёт","день","не","торговли","в нём","и не","дружбы"]],[14,32,["ٱللَّهُ","ٱلَّذِي","خَلَقَ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضَ","وَأَنزَلَ","مِنَ","ٱلسَّمَآءِ","مَآءٗ","فَأَخۡرَجَ","بِهِۦ","مِنَ","ٱلثَّمَرَٰتِ","رِزۡقٗا","لَّكُمۡۖ","وَسَخَّرَ","لَكُمُ","ٱلۡفُلۡكَ","لِتَجۡرِيَ","فِي","ٱلۡبَحۡرِ","بِأَمۡرِهِۦۖ","وَسَخَّرَ","لَكُمُ","ٱلۡأَنۡهَٰرَ"],"аллахул лазии халаḳас самавати вал'арда ва'анзала минас самаи маан фа'ахража бихии минас самарати ризḳал лакум васаххара лакумул фулка литажрийа фил бахри би'амрихии васаххара лакумул анхар","Аллах - Тот, Кто создал небеса и землю, ниспослал с неба воду и взрастил ею плоды для вашего пропитания, подчинил вам корабли, которые плывут по морям по Его воле, подчинил вам реки,",["Аллах","Тот, Который","сотворил","небеса","и землю","и ниспослал","с","неба","воду","и вывел","ею","из","плодов","пропитание","вам","и подчинил","вам","корабли","чтобы плыли","по","морю","по велению Его","и подчинил","вам","реки"]],[14,33,["وَسَخَّرَ","لَكُمُ","ٱلشَّمۡسَ","وَٱلۡقَمَرَ","دَآئِبَيۡنِۖ","وَسَخَّرَ","لَكُمُ","ٱلَّيۡلَ","وَٱلنَّهَارَ"],"васаххара лакумуш шамса валḳамара даибайни васаххара лакумул лайла ваннахар","подчинил вам солнце и луну, непрестанно движущиеся по своим орбитам, подчинил вам ночь и день.",["И подчинил","вам","солнце","и луну","непрестанно движущихся","и подчинил","вам","ночь","и день"]]],"m":[[["تُؤۡتِيٓ","Приносит",14,25],["أُكُلَهَا","плоды свои",14,25],["كُلَّ","всякое",14,25],["حِينِۭ","время",14,25],["بِإِذۡنِ","с дозволения",14,25],["رَبِّهَاۗ","его Господа",14,25],["وَيَضۡرِبُ","и приводит",14,25],["ٱللَّهُ","Аллах",14,25],["ٱلۡأَمۡثَالَ","притчи",14,25]],[["لِلنَّاسِ","людям",14,25],["لَعَلَّهُمۡ","чтобы они",14,25],["يَتَذَكَّرُونَ","помянули",14,25],[25],["وَمَثَلُ","А пример",14,26],["كَلِمَةٍ","слова",14,26],["خَبِيثَةٖ","скверного",14,26]],[["كَشَجَرَةٍ","подобен дереву",14,26],["خَبِيثَةٍ","скверному",14,26],["ٱجۡتُثَّتۡ","вырванному",14,26],["مِن","с",14,26],["فَوۡقِ","поверхности",14,26],["ٱلۡأَرۡضِ","земли",14,26],["مَا","нет",14,26],["لَهَا","у него",14,26],["مِن","никакой",14,26],["قَرَارٖ","устойчивости",14,26]],[[26],["يُثَبِّتُ","Укрепляет",14,27],["ٱللَّهُ","Аллах",14,27],["ٱلَّذِينَ","тех, которые",14,27],["ءَامَنُواْ","уверовали",14,27],["بِٱلۡقَوۡلِ","словом",14,27],["ٱلثَّابِتِ","твёрдым",14,27],["فِي","в",14,27],["ٱلۡحَيَوٰةِ","жизни",14,27]],[["ٱلدُّنۡيَا","ближней",14,27],["وَفِي","и в",14,27],["ٱلۡأٓخِرَةِۖ","Последней",14,27],["وَيُضِلُّ","и вводит в заблуждение",14,27],["ٱللَّهُ","Аллах",14,27],["ٱلظَّٰلِمِينَۚ","беззаконников",14,27],["وَيَفۡعَلُ","и делает",14,27]],[["ٱللَّهُ","Аллах",14,27],["مَا","что",14,27],["يَشَآءُ","пожелает",14,27],[27],["۞ أَلَمۡ","Разве не",14,28],["تَرَ","видел ты",14,28],["إِلَى","на",14,28],["ٱلَّذِينَ","тех, которые",14,28],["بَدَّلُواْ","заменили",14,28],["نِعۡمَتَ","милость",14,28],["ٱللَّهِ","Аллаха",14,28],["كُفۡرٗا","неверием",14,28]],[["وَأَحَلُّواْ","и поселили",14,28],["قَوۡمَهُمۡ","свой народ",14,28],["دَارَ","в обитель",14,28],["ٱلۡبَوَارِ","погибели",14,28],[28],["جَهَنَّمَ","Геенна",14,29],["يَصۡلَوۡنَهَاۖ","будут гореть в ней",14,29],["وَبِئۡسَ","и скверно",14,29]],[["ٱلۡقَرَارُ","пристанище",14,29],[29],["وَجَعَلُواْ","И сделали они",14,30],["لِلَّهِ","Аллаху",14,30],["أَندَادٗا","равных",14,30],["لِّيُضِلُّواْ","чтобы сбить",14,30],["عَن","с",14,30],["سَبِيلِهِۦۗ","пути Его",14,30],["قُلۡ","скажи",14,30]],[["تَمَتَّعُواْ","наслаждайтесь",14,30],["فَإِنَّ","ибо поистине",14,30],["مَصِيرَكُمۡ","ваш путь",14,30],["إِلَى","к",14,30],["ٱلنَّارِ","Огню",14,30],[30],["قُل","Скажи",14,31],["لِّعِبَادِيَ","рабам Моим",14,31],["ٱلَّذِينَ","которые",14,31]],[["ءَامَنُواْ","уверовали",14,31],["يُقِيمُواْ","пусть совершают",14,31],["ٱلصَّلَوٰةَ","намаз",14,31],["وَيُنفِقُواْ","и расходуют",14,31],["مِمَّا","из того, что",14,31],["رَزَقۡنَٰهُمۡ","Мы наделили их",14,31],["سِرّٗا","тайно",14,31],["وَعَلَانِيَةٗ","и явно",14,31]],[["مِّن","до",14,31],["قَبۡلِ","того",14,31],["أَن","как",14,31],["يَأۡتِيَ","придёт",14,31],["يَوۡمٞ","день",14,31],["لَّا","не",14,31],["بَيۡعٞ","торговли",14,31],["فِيهِ","в нём",14,31],["وَلَا","и не",14,31],["خِلَٰلٌ","дружбы",14,31],[31],["ٱللَّهُ","Аллах",14,32],["ٱلَّذِي","Тот, Который",14,32],["خَلَقَ","сотворил",14,32]],[["ٱلسَّمَٰوَٰتِ","небеса",14,32],["وَٱلۡأَرۡضَ","и землю",14,32],["وَأَنزَلَ","и ниспослал",14,32],["مِنَ","с",14,32],[