{"p":260,"j":13,"a":[[14,34,["وَءَاتَىٰكُم","مِّن","كُلِّ","مَا","سَأَلۡتُمُوهُۚ","وَإِن","تَعُدُّواْ","نِعۡمَتَ","ٱللَّهِ","لَا","تُحۡصُوهَآۗ","إِنَّ","ٱلۡإِنسَٰنَ","لَظَلُومٞ","كَفَّارٞ"],"ва'атакум мин кулли ма са'алтумууху ва'ин та`уддуу ни`маталлахи ла тухсууха иннал инсана лазалуумун каффар","Он даровал вам все, о чем вы просили. Если вы станете считать милости Аллаха, то не сможете сосчитать их. Воистину, человек несправедлив и неблагодарен.",["И дал Он вам","из","всего","что","вы просили у Него","и если","станете считать","милость","Аллаха","не","сосчитаете её","поистине","человек","непременно несправедлив","неблагодарен"]],[14,35,["وَإِذۡ","قَالَ","إِبۡرَٰهِيمُ","رَبِّ","ٱجۡعَلۡ","هَٰذَا","ٱلۡبَلَدَ","ءَامِنٗا","وَٱجۡنُبۡنِي","وَبَنِيَّ","أَن","نَّعۡبُدَ","ٱلۡأَصۡنَامَ"],"ва'из ḳала ибрахииму раббиж`ал хазал балада аминан важнубнии вабаниййа ан на`будал аснам","Вот Ибрахим (Авраам) сказал: «Господи! Сделай этот город безопасным и убереги меня и моих сыновей от поклонения идолам.",["И вот","сказал","Ибрахим","Господи","сделай","этот","город","безопасным","и удали меня","и сыновей моих","от того чтобы","мы поклонялись","идолам"]],[14,36,["رَبِّ","إِنَّهُنَّ","أَضۡلَلۡنَ","كَثِيرٗا","مِّنَ","ٱلنَّاسِۖ","فَمَن","تَبِعَنِي","فَإِنَّهُۥ","مِنِّيۖ","وَمَنۡ","عَصَانِي","فَإِنَّكَ","غَفُورٞ","رَّحِيمٞ"],"рабби иннахунна адлална касиирам минан наси фаман таби`ании фа'иннахуу миннии ваман `асании фа'иннака гафуурур рахиим","Господи! Воистину, они ввели в заблуждение многих людей. Тот, кто последует за мной, относится ко мне. А если кто ослушается меня, то ведь Ты - Прощающий, Милосердный.",["Господи","поистине, они","сбили с пути","многих","из","людей","и кто","последует за мной","то поистине, он","от меня","а кто","ослушается меня","то поистине, Ты","Прощающий","Милосердный"]],[14,37,["رَّبَّنَآ","إِنِّيٓ","أَسۡكَنتُ","مِن","ذُرِّيَّتِي","بِوَادٍ","غَيۡرِ","ذِي","زَرۡعٍ","عِندَ","بَيۡتِكَ","ٱلۡمُحَرَّمِ","رَبَّنَا","لِيُقِيمُواْ","ٱلصَّلَوٰةَ","فَٱجۡعَلۡ","أَفۡـِٔدَةٗ","مِّنَ","ٱلنَّاسِ","تَهۡوِيٓ","إِلَيۡهِمۡ","وَٱرۡزُقۡهُم","مِّنَ","ٱلثَّمَرَٰتِ","لَعَلَّهُمۡ","يَشۡكُرُونَ"],"рраббана иннии асканту мин зурриййатии бивадин гайри зии зар`ин `инда байтикал мухаррами раббана лийуḳиимус салавата фаж`ал аф'идатам минан наси тахвии илайхим варзуḳхум минас самарати ла`аллахум йашкуруун","Господь наш! Я поселил часть моего потомства в долине, где нет злаков, у Твоего Заповедного дома. Господь наш! Пусть они совершают намаз. Наполни сердца некоторых людей любовью к ним и надели их плодами, - быть может, они будут благодарны.",["Господь наш","поистине, я","поселил","часть","потомства моего","в долине","не","имеющей","посевов","у","дома Твоего","заповедного","Господь наш","чтобы совершали","намаз","так сделай","сердца","из","людей","стремящимися","к ним","и надели их","из","плодов","чтобы они","благодарили"]],[14,38,["رَبَّنَآ","إِنَّكَ","تَعۡلَمُ","مَا","نُخۡفِي","وَمَا","نُعۡلِنُۗ","وَمَا","يَخۡفَىٰ","عَلَى","ٱللَّهِ","مِن","شَيۡءٖ","فِي","ٱلۡأَرۡضِ","وَلَا","فِي","ٱلسَّمَآءِ"],"раббана иннака та`ламу ма нухфии вама ну`лину вама йахфа `алаллахи мин шай'ин фил арди вала фис сама","Господь наш! Тебе ведомо то, что мы утаиваем, и то, что мы обнародуем. Ничто не скроется от Аллаха ни на земле, ни на небесах.",["Господь наш","поистине, Ты","знаешь","что","мы скрываем","и что","мы обнаруживаем","и не","скрыто","от","Аллаха","ни одной","вещи","на","земле","и ни","на","небе"]],[14,39,["ٱلۡحَمۡدُ","لِلَّهِ","ٱلَّذِي","وَهَبَ","لِي","عَلَى","ٱلۡكِبَرِ","إِسۡمَٰعِيلَ","وَإِسۡحَٰقَۚ","إِنَّ","رَبِّي","لَسَمِيعُ","ٱلدُّعَآءِ"],"алхамду лиллахил лазии вахаба лии `алал кибари исма`иила ва'исхаḳа инна раббии ласамии`уд ду`а","Хвала Аллаху, который даровал мне на старости лет Исмаила (Измаила) и Исхака (Исаака). Воистину, мой Господь внимает мольбе.",["Хвала","Аллаху","Который","даровал","мне","в","старости","Исмаила","и Исхака","поистине","Господь мой","непременно Слышащий","мольбу"]],[14,40,["رَبِّ","ٱجۡعَلۡنِي","مُقِيمَ","ٱلصَّلَوٰةِ","وَمِن","ذُرِّيَّتِيۚ","رَبَّنَا","وَتَقَبَّلۡ","دُعَآءِ"],"раббиж`алнии муḳиимас салавати вамин зурриййатии раббана ватаḳаббал ду`а","Господи! Включи меня и часть моего потомства в число тех, кто совершает намаз. Господь наш! Прими мою мольбу.",["Господи","сделай меня","совершающим","намаз","и из","потомства моего","Господь наш","и прими","мольбу мою"]],[14,41,["رَبَّنَا","ٱغۡفِرۡ","لِي","وَلِوَٰلِدَيَّ","وَلِلۡمُؤۡمِنِينَ","يَوۡمَ","يَقُومُ","ٱلۡحِسَابُ"],"раббанагфир лии валивалидаййа валилму'миниина йаума йаḳуумул хисаб","Господь наш! Прости меня, моих родителей и верующих в тот день, когда будет представлен счет».",["Господь наш","прости","мне","и родителям моим","и верующим","в день","когда наступит","расчёт"]],[14,42,["وَلَا","تَحۡسَبَنَّ","ٱللَّهَ","غَٰفِلًا","عَمَّا","يَعۡمَلُ","ٱلظَّٰلِمُونَۚ","إِنَّمَا","يُؤَخِّرُهُمۡ","لِيَوۡمٖ","تَشۡخَصُ","فِيهِ","ٱلۡأَبۡصَٰرُ"],"вала тахсабанналлаха гафилан `амма йа`малуз залимууна иннама йу'аххирухум лийаумин ташхасу фиихил абсар","Не думай, что Аллах не ведает о том, что творят беззаконники. Он лишь дает им отсрочку до того дня, когда закатятся взоры.",["И не","думай","что Аллах","небрежен","к тому, что","делают","беззаконники","лишь","Он откладывает им","до дня","застынут","в нём","взоры"]]],"m":[[["وَءَاتَىٰكُم","И дал Он вам",14,34],["مِّن","из",14,34],["كُلِّ","всего",14,34],["مَا","что",14,34],["سَأَلۡتُمُوهُۚ","вы просили у Него",14,34],["وَإِن","и если",14,34],["تَعُدُّواْ","станете считать",14,34],["نِعۡمَتَ","милость",14,34],["ٱللَّهِ","Аллаха",14,34]],[["لَا","не",14,34],["تُحۡصُوهَآۗ","сосчитаете её",14,34],["إِنَّ","поистине",14,34],["ٱلۡإِنسَٰنَ","человек",14,34],["لَظَلُومٞ","непременно несправедлив",14,34],["كَفَّارٞ","неблагодарен",14,34],[34],["وَإِذۡ","И вот",14,35]],[["قَالَ","сказал",14,35],["إِبۡرَٰهِيمُ","Ибрахим",14,35],["رَبِّ","Господи",14,35],["ٱجۡعَلۡ","сделай",14,35],["هَٰذَا","этот",14,35],["ٱلۡبَلَدَ","город",14,35],["ءَامِنٗا","безопасным",14,35],["وَٱجۡنُبۡنِي","и удали меня",14,35],["وَبَنِي