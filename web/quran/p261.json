{"p":261,"j":13,"a":[[14,43,["مُهۡطِعِينَ","مُقۡنِعِي","رُءُوسِهِمۡ","لَا","يَرۡتَدُّ","إِلَيۡهِمۡ","طَرۡفُهُمۡۖ","وَأَفۡـِٔدَتُهُمۡ","هَوَآءٞ"],"мухти`иина муḳни`ии ру'уусихим ла йартадду илайхим тарфухум ва'аф'идатухум хава","Они будут спешить с запрокинутыми головами. Взоры не будут возвращаться к ним, а их сердца будут опустошены (переполнены страхом и лишены всех иных чувств).",["Спешащими","задравшими","головы свои","не","возвращается","к ним","их взгляд","и сердца их","пусты"]],[14,44,["وَأَنذِرِ","ٱلنَّاسَ","يَوۡمَ","يَأۡتِيهِمُ","ٱلۡعَذَابُ","فَيَقُولُ","ٱلَّذِينَ","ظَلَمُواْ","رَبَّنَآ","أَخِّرۡنَآ","إِلَىٰٓ","أَجَلٖ","قَرِيبٖ","نُّجِبۡ","دَعۡوَتَكَ","وَنَتَّبِعِ","ٱلرُّسُلَۗ","أَوَلَمۡ","تَكُونُوٓاْ","أَقۡسَمۡتُم","مِّن","قَبۡلُ","مَا","لَكُم","مِّن","زَوَالٖ"],"ва'анзирин наса йаума йа'тиихимул `азабу файаḳуулул лазиина заламуу раббана аххирна ила ажалин ḳариибин нужиб да`ватака ванаттаби`ир русула авалам такуунуу аḳсамтум мин ḳаблу ма лакум мин завал","Предостерегай людей от того дня, когда к ним явятся мучения. Тогда те, которые поступали несправедливо, скажут: «Господь наш! Дай нам отсрочку на маленький срок, и мы ответим на Твой призыв и последуем за посланниками». Им будет сказано: «Разве раньше вы не клялись, что не покинете земной мир?",["И предостереги","людей","о дне","придёт к ним","наказание","и скажут","те, которые","были несправедливы","Господь наш","отсрочь нам","до","срока","близкого","мы ответим","на Твой призыв","и последуем","за посланниками","разве не","были вы","клялись","до","этого","нет","у вас","никакого","исчезновения"]],[14,45,["وَسَكَنتُمۡ","فِي","مَسَٰكِنِ","ٱلَّذِينَ","ظَلَمُوٓاْ","أَنفُسَهُمۡ","وَتَبَيَّنَ","لَكُمۡ","كَيۡفَ","فَعَلۡنَا","بِهِمۡ","وَضَرَبۡنَا","لَكُمُ","ٱلۡأَمۡثَالَ"],"васакантум фии масакинил лазиина заламуу анфусахум ватабаййана лакум кайфа фа`ална бихим вадарабна лакумул амсал","Вы обитали в жилищах тех, которые были несправедливы к себе. Вам было ясно, как Мы поступили с ними, и Мы приводили вам притчи».",["И жили вы","в","жилищах","тех, которые","были несправедливы","к самим себе","и стало ясно","вам","как","Мы поступили","с ними","и Мы привели","вам","притчи"]],[14,46,["وَقَدۡ","مَكَرُواْ","مَكۡرَهُمۡ","وَعِندَ","ٱللَّهِ","مَكۡرُهُمۡ","وَإِن","كَانَ","مَكۡرُهُمۡ","لِتَزُولَ","مِنۡهُ","ٱلۡجِبَالُ"],"ваḳад макаруу макрахум ва`индаллахи макрухум ва'ин кана макрухум литазуула минхул жибал","Они строили свои козни, но их козни были у Аллаха. А ведь козни эти могли сдвинуть горы (или не могли сдвинуть горы).",["И уже","хитрили они","своей хитростью","но у","Аллаха","их хитрость","и хотя","была","их хитрость","чтобы сдвинулись","от неё","горы"]],[14,47,["فَلَا","تَحۡسَبَنَّ","ٱللَّهَ","مُخۡلِفَ","وَعۡدِهِۦ","رُسُلَهُۥٓۚ","إِنَّ","ٱللَّهَ","عَزِيزٞ","ذُو","ٱنتِقَامٖ"],"фала тахсабанналлаха мухлифа ва`дихии русулахуу инналлаха `азиизун зунтиḳам","Не думай, что Аллах нарушает обещания, данные Своим посланникам. Воистину, Аллах - Могущественный, Способный на возмездие.",["Так не","думай","что Аллах","нарушающий","обещание Своё","посланникам Своим","поистине","Аллах","Могущественный","Обладатель","возмездия"]],[14,48,["يَوۡمَ","تُبَدَّلُ","ٱلۡأَرۡضُ","غَيۡرَ","ٱلۡأَرۡضِ","وَٱلسَّمَٰوَٰتُۖ","وَبَرَزُواْ","لِلَّهِ","ٱلۡوَٰحِدِ","ٱلۡقَهَّارِ"],"йаума тубаддалул арду гайрал арди вассамавату вабаразуу лиллахил вахидил ḳаххар","В тот день земля будет заменена другой, равно как и небеса, и они предстанут перед Аллахом, Единственным, Могущественным.",["В день","будет заменена","земля","другой","землёй","и небеса","и предстанут","пред Аллахом","Единым","Покоряющим"]],[14,49,["وَتَرَى","ٱلۡمُجۡرِمِينَ","يَوۡمَئِذٖ","مُّقَرَّنِينَ","فِي","ٱلۡأَصۡفَادِ"],"ватарал мужримиина йаумаизим муḳарраниина фил асфад","В тот день ты увидишь грешников, закованных в цепи.",["и ты увидишь","грешников","в тот день","скованных","в","цепи"]],[14,50,["سَرَابِيلُهُم","مِّن","قَطِرَانٖ","وَتَغۡشَىٰ","وُجُوهَهُمُ","ٱلنَّارُ"],"сарабиилухум мин ḳатиранин ватагша вужуухахумун нар","Их одеяние будет из смолы, а их лица будут покрыты Огнем.",["Одеяния их","из","смолы","и покроет","их лица","Огонь"]],[14,51,["لِيَجۡزِيَ","ٱللَّهُ","كُلَّ","نَفۡسٖ","مَّا","كَسَبَتۡۚ","إِنَّ","ٱللَّهَ","سَرِيعُ","ٱلۡحِسَابِ"],"лийажзийаллаху кулла нафсим ма касабат инналлаха сарии`ул хисаб","Аллах воздаст каждой душе то, что она приобрела. Воистину, Аллах скор в расчете.",["Чтобы воздал","Аллах","каждой","душе","что","она приобрела","поистине","Аллах","скор","в расчёте"]],[14,52,["هَٰذَا","بَلَٰغٞ","لِّلنَّاسِ","وَلِيُنذَرُواْ","بِهِۦ","وَلِيَعۡلَمُوٓاْ","أَنَّمَا","هُوَ","إِلَٰهٞ","وَٰحِدٞ","وَلِيَذَّكَّرَ","أُوْلُواْ","ٱلۡأَلۡبَٰبِ"],"хаза балагул линнаси валийунзаруу бихии валийа`ламуу аннама хуа илахун вахидун валийаззаккара улул албаб","Это - послание к человечеству. Пусть их увещевают им, и пусть они знают, что Он - Единственный Бог, и пусть задумаются обладающие разумом.",["Это","послание","людям","и чтобы их предостерегли","им","и чтобы знали они","что лишь","Он","Бог","Единый","и чтобы помянули","обладающие","разумом"]]],"m":[[["مُهۡطِعِينَ","Спешащими",14,43],["مُقۡنِعِي","задравшими",14,43],["رُءُوسِهِمۡ","головы свои",14,43],["لَا","не",14,43],["يَرۡتَدُّ","возвращается",14,43],["إِلَيۡهِمۡ","к ним",14,43],["طَرۡفُهُمۡۖ","их взгляд",14,43],["وَأَفۡـِٔدَتُهُمۡ","и сердца их",14,43]],[["هَوَآءٞ","пусты",14,43],[43],["وَأَنذِرِ","И предостереги",14,44],["ٱلنَّاسَ","людей",14,44],["يَوۡمَ","о дне",14,44],["يَأۡتِيهِمُ","придёт к ним",14,44],["ٱلۡعَذَابُ","наказание",14,44],["فَيَقُولُ","и скажут",14,44],["ٱلَّذِينَ","те, которые",14,44]],[["ظَلَمُواْ","были несправедливы",14,44],["رَبَّنَآ","Господь наш",14,44],["أَخِّرۡنَآ","отсрочь нам",14,44],["إِلَىٰٓ","до",14,44],["أَجَلٖ","срока",14,44],["قَرِيبٖ","близкого",14,44],["نُّجِبۡ","мы ответим",14,44],["دَعۡوَتَكَ","на Твой призыв",14,44],["وَنَتَّبِعِ","и последуем",14,44]],[["ٱلرُّسُلَۗ","за посланниками",14,44],["أَوَلَمۡ","разве не",14,44],["تَكُونُوٓاْ","были вы",14,44],["أَقۡسَمۡتُم","клялись",14,44],["مِّن","до",14,44],["قَبۡلُ","этого",14,44],["مَا","нет",14,44],["لَكُم","у вас",14,44]],[["مِّن","никакого",14,44],["زَوَالٖ","исчезновения",14,44],[44],["وَسَكَنتُمۡ","И жили вы",14,45],["فِي","в",14,45],["مَسَٰكِنِ","жилищах",14,45],["ٱلَّذِينَ","тех, которые",14,45],["ظَلَمُوٓاْ","были несправедливы",14,45]],[["أَنفُسَهُمۡ","к самим себе",14,45],["وَتَبَيَّنَ","и стало ясно",14,45],["لَكُمۡ","вам",14,45],["كَيۡفَ","как",14,45],["فَعَلۡنَا","Мы поступили",14,45],["بِهِمۡ","с ними",14,45],["وَضَرَبۡنَا","и Мы привели",14,45]],[["لَكُمُ","вам",14,45],["ٱلۡأَمۡثَالَ","притчи",14,45],[45],["وَقَدۡ","И уже",14,46],["مَكَرُواْ","хитрили они",14,46],["مَكۡرَهُمۡ","своей хитростью",14,46],["وَعِندَ","но у",14,46],["ٱللَّهِ","Аллаха",14,46]],[["مَكۡرُهُمۡ","их хитрость",14,46],["وَإِن","и хотя",14,46],["كَانَ","была",14,46],["مَكۡرُهُمۡ","их хитрость",14,46],["لِتَزُولَ","чтобы сдвинулись",14,46],["مِنۡهُ","от неё",14,46],["ٱلۡجِبَالُ","горы",14,46]],[[46],["فَلَا","Так не",14,47],["تَحۡسَبَنَّ","думай",14,47],["ٱللَّهَ","что Аллах",14,47],["مُخۡلِفَ","нарушающий",14,47],["وَعۡدِهِۦ","обещание Своё",14,47],["رُسُلَهُۥٓۚ","посланникам Своим",14,47],["إِنَّ","поистине",14,47],["ٱللَّهَ","Аллах",14,47],["عَزِيزٞ","Могущественный",14,47]],[["ذُو","Обладатель",14,47],["ٱنتِقَامٖ","возмездия",14,47],[47],["يَوۡمَ","В день",14,48],["تُبَدَّلُ","будет заменена",14,48],["ٱلۡأَرۡضُ","земля",14,48],["غَيۡرَ","другой",14,48],["ٱلۡأَرۡضِ","землёй",14,48],["وَٱلسَّمَٰوَٰتُۖ","и небеса",14,48]],[["وَبَرَزُواْ","и предстанут",14,48],["لِلَّهِ","пред Аллахом",14,48],["ٱلۡوَٰحِدِ","Единым",14,48],["ٱلۡقَهَّارِ","Покоряющим",14,48],[48],["وَتَرَى","и ты увидишь",14,49],["ٱلۡمُجۡرِمِينَ","грешников",14,49],["يَوۡمَئِذٖ","в тот день",14,49]],[["مُّقَرَّنِينَ","скованных",14,49],["فِي","в",14,49],["ٱلۡأَصۡفَادِ","цепи",14,49],[49],["سَرَابِيلُهُم","Одеяния их",14,50],["مِّن","из",14,50],["قَطِرَانٖ","смолы",14,50],["وَتَغۡشَىٰ","и покроет",14,50]],[["وُجُوهَهُمُ","их лица",14,50],["ٱلنَّارُ","Огонь",14,50],[50],["لِيَجۡزِيَ","Чтобы воздал",14,51],["ٱللَّهُ","Аллах",14,51],["كُلَّ","каждой",14,51],["نَفۡسٖ","душе",14,51],["مَّا","что",14,51],["كَسَبَتۡۚ","она приобрела",14,51]],[["إِنَّ","поистине",14,51],["ٱللَّهَ","Аллах",14,51],["سَرِيعُ","скор",14,51],["ٱلۡحِسَابِ","в расчёте",14,51],[51],["هَٰذَا","Это",14,52],["بَلَٰغٞ","послание",14,52],["لِّلنَّاسِ","людям",14,52],["وَلِيُنذَرُواْ","и чтобы их предостерегли",14,52]],[["بِهِۦ","им",14,52],["وَلِيَعۡلَمُوٓاْ","и чтобы знали они",14,52],["أَنَّمَا","что лишь",14,52],["هُوَ","Он",14,52],["إِلَٰهٞ","Бог",14,52],["وَٰحِدٞ","Единый",14,52],["وَلِيَذَّكَّرَ","и чтобы помянули",14,52],["أُوْلُواْ","обладающие",14,52],["ٱلۡأَلۡبَٰبِ","разумом",14,52],[52]]]}