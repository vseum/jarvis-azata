{"p":262,"j":14,"a":[[15,1,["الٓرۚ","تِلۡكَ","ءَايَٰتُ","ٱلۡكِتَٰبِ","وَقُرۡءَانٖ","مُّبِينٖ"],"лр тилка айатул китаби ваḳур'аним мубиин","Алиф. Лам. Ра. Это - аяты Писания и ясного Корана.",["Алиф Лям Ра","это","аяты","Писания","и Корана","ясного"]],[15,2,["رُّبَمَا","يَوَدُّ","ٱلَّذِينَ","كَفَرُواْ","لَوۡ","كَانُواْ","مُسۡلِمِينَ"],"ррубама йаваддул лазиина кафаруу лау кануу муслимиин","Неверующие непременно пожелают оказаться мусульманами.",["Быть может","пожелают","те, которые","не уверовали","если бы","были они","мусульманами"]],[15,3,["ذَرۡهُمۡ","يَأۡكُلُواْ","وَيَتَمَتَّعُواْ","وَيُلۡهِهِمُ","ٱلۡأَمَلُۖ","فَسَوۡفَ","يَعۡلَمُونَ"],"зархум йа'кулуу вайатаматта`уу вайулхихимул амалу фасауфа йа`ламуун","Оставь их - пусть они едят, пользуются благами и увлекаются чаяниями. Скоро они узнают.",["Оставь их","пусть едят","и наслаждаются","и отвлекает их","надежда","и скоро","узнают они"]],[15,4,["وَمَآ","أَهۡلَكۡنَا","مِن","قَرۡيَةٍ","إِلَّا","وَلَهَا","كِتَابٞ","مَّعۡلُومٞ"],"вама ахлакна мин ḳарйатин илла валаха китабум ма`луум","Все селения, которые Мы погубили, имели известное предписание.",["И не","погубили Мы","ни одного","селения","без того чтобы","и у него было","предписание","известное"]],[15,5,["مَّا","تَسۡبِقُ","مِنۡ","أُمَّةٍ","أَجَلَهَا","وَمَا","يَسۡتَـٔۡخِرُونَ"],"мма тасбиḳу мин умматин ажалаха вама йаста'хируун","Ни одна община не может опередить свой срок или отложить его.",["не","опережает","ни одна","община","свой срок","и не","отстают"]],[15,6,["وَقَالُواْ","يَٰٓأَيُّهَا","ٱلَّذِي","نُزِّلَ","عَلَيۡهِ","ٱلذِّكۡرُ","إِنَّكَ","لَمَجۡنُونٞ"],"ваḳалуу йа'аййухал лазии нуззила `алайхиз зикру иннака ламажнуун","Они сказали: «О тот, кому ниспослано откровение! Воистину, ты - одержимый.",["И сказали они","о ты","который","ниспослано","ему","Напоминание","поистине, ты","непременно одержимый"]],[15,7,["لَّوۡ","مَا","تَأۡتِينَا","بِٱلۡمَلَٰٓئِكَةِ","إِن","كُنتَ","مِنَ","ٱلصَّٰدِقِينَ"],"ллау ма та'тиина билмалаикати ин кунта минас садиḳиин","Почему ты не привел к нам ангелов, если ты - один из тех, кто говорит правду?».",["Почему бы","не","приводишь ты нам","ангелов","если","ты","из","правдивых"]],[15,8,["مَا","نُنَزِّلُ","ٱلۡمَلَٰٓئِكَةَ","إِلَّا","بِٱلۡحَقِّ","وَمَا","كَانُوٓاْ","إِذٗا","مُّنظَرِينَ"],"ма нуназзилул малаиката илла билхаḳḳи вама кануу изам мунзариин","Мы ниспосылаем ангелов только с истиной, и тогда никому не предоставляется отсрочка.",["Не","ниспосылаем Мы","ангелов","кроме как","с истиной","и не","были бы они","тогда","получившими отсрочку"]],[15,9,["إِنَّا","نَحۡنُ","نَزَّلۡنَا","ٱلذِّكۡرَ","وَإِنَّا","لَهُۥ","لَحَٰفِظُونَ"],"инна нахну наззалназ зикра ва'инна лахуу лахафизуун","Воистину, Мы ниспослали Напоминание, и Мы оберегаем его.",["поистине, Мы","Мы","ниспослали","Напоминание","и поистине, Мы","его","непременно хранители"]],[15,10,["وَلَقَدۡ","أَرۡسَلۡنَا","مِن","قَبۡلِكَ","فِي","شِيَعِ","ٱلۡأَوَّلِينَ"],"валаḳад арсална мин ḳаблика фии шийа`ил аввалиин","Мы уже отправляли до тебя посланников к прежним общинам.",["И уже","послали Мы","до","тебя","к","общинам","первых"]],[15,11,["وَمَا","يَأۡتِيهِم","مِّن","رَّسُولٍ","إِلَّا","كَانُواْ","بِهِۦ","يَسۡتَهۡزِءُونَ"],"вама йа'тиихим мир расуулин илла кануу бихии йастахзиуун","Какой бы посланник ни приходил к ним, они издевались над ним.",["И не","приходил к ним","ни один","посланник","без того чтобы","они","над ним","издевались"]],[15,12,["كَذَٰلِكَ","نَسۡلُكُهُۥ","فِي","قُلُوبِ","ٱلۡمُجۡرِمِينَ"],"казалика наслукухуу фии ḳулуубил мужримиин","Таким же образом Мы насаждаем его (неверие) в сердцах грешников.",["Так","вводим Мы его","в","сердца","грешников"]],[15,13,["لَا","يُؤۡمِنُونَ","بِهِۦ","وَقَدۡ","خَلَتۡ","سُنَّةُ","ٱلۡأَوَّلِينَ"],"ла йу'минууна бихии ваḳад халат суннатул аввалиин","Они не веруют в него (Коран), хотя уже были примеры первых поколений.",["Не","веруют они","в него","и уже","прошёл","обычай","первых"]],[15,14,["وَلَوۡ","فَتَحۡنَا","عَلَيۡهِم","بَابٗا","مِّنَ","ٱلسَّمَآءِ","فَظَلُّواْ","فِيهِ","يَعۡرُجُونَ"],"валау фатахна `алайхим бабам минас самаи фазаллуу фиихи йа`ружуун","И даже если бы Мы разверзли для них врата небесные, чтобы они поднялись туда,",["И если бы","открыли Мы","им","врата","из","неба","и они продолжали","в них","подниматься"]],[15,15,["لَقَالُوٓاْ","إِنَّمَا","سُكِّرَتۡ","أَبۡصَٰرُنَا","بَلۡ","نَحۡنُ","قَوۡمٞ","مَّسۡحُورُونَ"],"лаḳалуу иннама суккират абсаруна бал нахну ḳаумум масхууруун","они непременно сказали бы: «Наши взоры затуманены, а сами мы околдованы».",["Непременно сказали бы они","лишь","затуманены","взоры наши","нет","мы","люди","околдованные"]]],"m":[["h",15],["b"],[["الٓرۚ","Алиф Лям Ра",15,1],["تِلۡكَ","это",15,1],["ءَايَٰتُ","аяты",15,1],["ٱلۡكِتَٰبِ","Писания",15,1],["وَقُرۡءَانٖ","и Корана",15,1],["مُّبِينٖ","ясного",15,1],[1],["رُّبَمَا","Быть может",15,2],["يَوَدُّ","пожелают",15,2]],[["ٱلَّذِينَ","те, которые",15,2],["كَفَرُواْ","не уверовали",15,2],["لَوۡ","если бы",15,2],["كَانُواْ","были они",15,2],["مُسۡلِمِينَ","мусульманами",15,2],[2],["ذَرۡهُمۡ","Оставь их",15,3],["يَأۡكُلُواْ","пусть едят",15,3]],[["وَيَتَمَتَّعُواْ","и наслаждаются",15,3],["وَيُلۡهِهِمُ","и отвлекает их",15,3],["ٱلۡأَمَلُۖ","надежда",15,3],["فَسَوۡفَ","и скоро",15,3],["يَعۡلَمُونَ","узнают они",15,3],[3],["وَمَآ","И не",15,4],["أَهۡلَكۡنَا","погубили Мы",15,4]],[["مِن","ни одного",15,4],["قَرۡيَةٍ","селения",15,4],["إِلَّا","без того чтобы",15,4],["وَلَهَا","и у него было",15,4],["كِتَابٞ","предписание",15,4],["مَّعۡلُومٞ","известное",15,4],[4],["مَّا","не",15,5],["تَسۡبِقُ","опережает",15,5],["مِنۡ","ни одна",15,5],["أُمَّةٍ","община",15,5]],[["أَجَلَهَا","свой срок",15,5],["وَمَا","и не",15,5],["يَسۡتَـٔۡخِرُونَ","отстают",15,5],[5],["وَقَالُواْ","И сказали они",15,6],["يَٰٓأَيُّهَا","о ты",15,6],["ٱلَّذِي","который",15,6],["نُزِّلَ","ниспослано",15,6],["عَلَيۡهِ","ему",15,6]],[["ٱلذِّكۡرُ","Напоминание",15,6],["إِنَّكَ","поистине, ты",15,6],["لَمَجۡنُونٞ","непременно одержимый",15,6],[6],["لَّوۡ","Почему бы",15,7],["مَا","не",15,7],["تَأۡتِينَا","приводишь ты нам",15,7],["بِٱلۡمَلَٰٓئِكَةِ","ангелов",15,7],["إِن","если",15,7],["كُنتَ","ты",15,7]],[["مِنَ","из",15,7],["ٱلصَّٰدِقِينَ","правдивых",15,7],[7],["مَا","Не",15,8],["نُنَزِّلُ","ниспосылаем Мы",15,8],["ٱلۡمَلَٰٓئِكَةَ","ангелов",15,8],["إِلَّا","кроме как",15,8],["بِٱلۡحَقِّ","с истиной",15,8],["وَمَا","и не",15,8],["كَانُوٓاْ","были бы они",15,8]],[["إِذٗا","тогда",15,8],["مُّنظَرِينَ","получившими отсрочку",15,8],[8],["إِنَّا","поистине, Мы",15,9],["نَحۡنُ","Мы",15,9],["نَزَّلۡنَا","ниспослали",15,9],["ٱلذِّكۡرَ","Напоминание",15,9],["وَإِنَّا","и поистине, Мы",15,9],["لَهُۥ","его",15,9],["لَحَٰفِظُونَ","непременно хранители",15,9],[9]],[["وَلَقَدۡ","И уже",15,10],["أَرۡسَلۡنَا","послали Мы",15,10],["مِن","до",15,10],["قَبۡلِكَ","тебя",15,10],["فِي","к",15,10],["شِيَعِ","общинам",15,10],["ٱلۡأَوَّلِينَ","первых",15,10],[10],["وَمَا","И не",15,11],["يَأۡتِيهِم","приходил к ним",15,11],["مِّن","ни один",15,11]],[["رَّسُولٍ","посланник",15,11],["إِلَّا","без того чтобы",15,11],["كَانُواْ","они",15,11],["بِهِۦ","над ним",15,11],["يَسۡتَهۡزِءُونَ","издевались",15,11],[11],["كَذَٰلِكَ","Так",15,12],["نَسۡلُكُهُۥ","вводим Мы его",15,12],["فِي","в",15,12]],[["قُلُوبِ","сердца",15,12],["ٱلۡمُجۡرِمِينَ","грешников",15,12],[12],["لَا","Не",15,13],["يُؤۡمِنُونَ","веруют они",15,13],["بِهِۦ","в него",15,13],["وَقَدۡ","и уже",15,13],["خَلَتۡ","прошёл",15,13],["سُنَّةُ","обычай",15,13],["ٱلۡأَوَّلِينَ","первых",15,13]],[[13],["وَلَوۡ","И если бы",15,14],["فَتَحۡنَا","открыли Мы",15,14],["عَلَيۡهِم","им",15,14],["بَابٗا","врата",15,14],["مِّنَ","из",15,14],["ٱلسَّمَآءِ","неба",15,14],["فَظَلُّواْ","и они продолжали",15,14],["فِيهِ","в них",15,14],["يَعۡرُجُونَ","подниматься",15,14]],[[14],["لَقَالُوٓاْ","Непременно сказали бы они",15,15],["إِنَّمَا","лишь",15,15],["سُكِّرَتۡ","затуманены",15,15],["أَبۡصَٰرُنَا","взоры наши",15,15],["بَلۡ","нет",15,15],["نَحۡنُ","мы",15,15],["قَوۡمٞ","люди",15,15],["مَّسۡحُورُونَ","околдованные",15,15],[15]]]}