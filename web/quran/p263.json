{"p":263,"j":14,"a":[[15,16,["وَلَقَدۡ","جَعَلۡنَا","فِي","ٱلسَّمَآءِ","بُرُوجٗا","وَزَيَّنَّٰهَا","لِلنَّٰظِرِينَ"],"валаḳад жа`ална фис самаи буруужан вазаййаннаха линназириин","Воистину, Мы воздвигли на небе созвездия и украсили его для тех, кто смотрит.",["И уже","поместили Мы","на","небе","созвездия","и украсили его","для смотрящих"]],[15,17,["وَحَفِظۡنَٰهَا","مِن","كُلِّ","شَيۡطَٰنٖ","رَّجِيمٍ"],"вахафизнаха мин кулли шайтанир ражиим","Мы предохранили его от всякого дьявола изгнанного, побиваемого.",["И оберегли Мы его","от","всякого","дьявола","побиваемого"]],[15,18,["إِلَّا","مَنِ","ٱسۡتَرَقَ","ٱلسَّمۡعَ","فَأَتۡبَعَهُۥ","شِهَابٞ","مُّبِينٞ"],"илла манистараḳас сам`а фа'атба`ахуу шихабум мубиин","А если он станет подслушивать украдкой, то за ним последует яркий светоч.",["Кроме","того, кто","украдкой подслушал","слышимое","и последует за ним","светоч","явный"]],[15,19,["وَٱلۡأَرۡضَ","مَدَدۡنَٰهَا","وَأَلۡقَيۡنَا","فِيهَا","رَوَٰسِيَ","وَأَنۢبَتۡنَا","فِيهَا","مِن","كُلِّ","شَيۡءٖ","مَّوۡزُونٖ"],"вал'арда мададнаха ва'алḳайна фииха равасийа ва'амбатна фииха мин кулли шай'им маузуун","Мы простерли землю, поместили на ней незыблемые горы и взрастили на ней в меру всякие вещи.",["И землю","простёрли Мы её","и бросили Мы","на ней","незыблемые горы","и взрастили Мы","на ней","из","всякой","вещи","соразмерной"]],[15,20,["وَجَعَلۡنَا","لَكُمۡ","فِيهَا","مَعَٰيِشَ","وَمَن","لَّسۡتُمۡ","لَهُۥ","بِرَٰزِقِينَ"],"важа`ална лакум фииха ма`айиша вамал ластум лахуу биразиḳиин","Мы предоставили на земле пропитание вам и тем, кого вы не кормите.",["И сделали Мы","вам","на ней","средства к жизни","и тех, кого","не являетесь вы","ему","кормильцами"]],[15,21,["وَإِن","مِّن","شَيۡءٍ","إِلَّا","عِندَنَا","خَزَآئِنُهُۥ","وَمَا","نُنَزِّلُهُۥٓ","إِلَّا","بِقَدَرٖ","مَّعۡلُومٖ"],"ва'им мин шай'ин илла `индана хазаинухуу вама нуназзилухуу илла биḳадарим ма`луум","Нет таких вещей, хранилищ которых не было бы у Нас, и ниспосылаем Мы их только в известной мере.",["И нет","никакой","вещи","без того чтобы","у Нас","её сокровищницы","и не","ниспосылаем Мы её","иначе как","в меру","известную"]],[15,22,["وَأَرۡسَلۡنَا","ٱلرِّيَٰحَ","لَوَٰقِحَ","فَأَنزَلۡنَا","مِنَ","ٱلسَّمَآءِ","مَآءٗ","فَأَسۡقَيۡنَٰكُمُوهُ","وَمَآ","أَنتُمۡ","لَهُۥ","بِخَٰزِنِينَ"],"ва'арсалнар рийаха лаваḳиха фа'анзална минас самаи маан фа'асḳайнакумууху вама антум лахуу бихазиниин","Мы послали ветры, оплодотворяющие облака водой, а потом низвели с неба воду и напоили вас ею, но не вам ее сберегать.",["И послали Мы","ветры","оплодотворяющие","и ниспослали Мы","с","неба","воду","и напоили вас ею","и не","вы","её","хранители"]],[15,23,["وَإِنَّا","لَنَحۡنُ","نُحۡيِۦ","وَنُمِيتُ","وَنَحۡنُ","ٱلۡوَٰرِثُونَ"],"ва'инна ланахну нухйии ванумииту ванахнул варисуун","Воистину, Мы даруем жизнь и умерщвляем, и Мы наследуем.",["и поистине, Мы","непременно Мы","даруем жизнь","и умерщвляем","и Мы","наследники"]],[15,24,["وَلَقَدۡ","عَلِمۡنَا","ٱلۡمُسۡتَقۡدِمِينَ","مِنكُمۡ","وَلَقَدۡ","عَلِمۡنَا","ٱلۡمُسۡتَـٔۡخِرِينَ"],"валаḳад `алимнал мустаḳдимиина минкум валаḳад `алимнал муста'хириин","Воистину, Мы знаем тех, кто жил прежде, и тех, кому суждено жить после них.",["И уже","знаем Мы","прежних","из вас","и уже","знаем Мы","последующих"]],[15,25,["وَإِنَّ","رَبَّكَ","هُوَ","يَحۡشُرُهُمۡۚ","إِنَّهُۥ","حَكِيمٌ","عَلِيمٞ"],"ва'инна раббака хуа йахшурухум иннахуу хакиимун `алиим","Воистину, твой Господь соберет их всех, ведь Он - Мудрый, Знающий.",["И поистине","Господь твой","Он","соберёт их","поистине, Он","Мудрый","Знающий"]],[15,26,["وَلَقَدۡ","خَلَقۡنَا","ٱلۡإِنسَٰنَ","مِن","صَلۡصَٰلٖ","مِّنۡ","حَمَإٖ","مَّسۡنُونٖ"],"валаḳад халаḳнал инсана мин салсалим мин хамаим маснуун","Мы сотворили человека из сухой звонкой глины, полученной из видоизмененной грязи.",["И уже","сотворили Мы","человека","из","звонкой глины","из","ила","изменённого"]],[15,27,["وَٱلۡجَآنَّ","خَلَقۡنَٰهُ","مِن","قَبۡلُ","مِن","نَّارِ","ٱلسَّمُومِ"],"валжанна халаḳнаху мин ḳаблу мин нарис самуум","А еще раньше Мы сотворили джиннов из палящего пламени.",["И джиннов","сотворили Мы их","прежде","до того","из","огня","палящего"]],[15,28,["وَإِذۡ","قَالَ","رَبُّكَ","لِلۡمَلَٰٓئِكَةِ","إِنِّي","خَٰلِقُۢ","بَشَرٗا","مِّن","صَلۡصَٰلٖ","مِّنۡ","حَمَإٖ","مَّسۡنُونٖ"],"ва'из ḳала раббука лилмалаикати иннии халиḳу башарам мин салсалим мин хамаим маснуун","Вот твой Господь сказал ангелам: «Воистину, я сотворю человека из сухой звонкой глины, полученной из видоизмененной грязи.",["И вот","сказал","Господь твой","ангелам","поистине, Я","творящий","человека","из","звонкой глины","из","ила","изменённого"]],[15,29,["فَإِذَا","سَوَّيۡتُهُۥ","وَنَفَخۡتُ","فِيهِ","مِن","رُّوحِي","فَقَعُواْ","لَهُۥ","سَٰجِدِينَ"],"фа'иза саввайтухуу ванафахту фиихи мир руухии фаḳа`уу лахуу сажидиин","Когда же Я придам ему соразмерный облик и вдохну в него от Моего духа, то падите перед ним ниц».",["И когда","придам Я ему облик","и вдохну","в него","от","духа Моего","то падите","пред ним","ниц"]],[15,30,["فَسَجَدَ","ٱلۡمَلَٰٓئِكَةُ","كُلُّهُمۡ","أَجۡمَعُونَ"],"фасажадал малаикату куллухум ажма`уун","Все ангелы до единого пали ниц,",["И пали ниц","ангелы","все они","вместе"]],[15,31,["إِلَّآ","إِبۡلِيسَ","أَبَىٰٓ","أَن","يَكُونَ","مَعَ","ٱلسَّٰجِدِينَ"],"илла иблииса аба ан йакууна ма`ас сажидиин","за исключением Иблиса, который отказался быть в числе павших ниц.",["Кроме","Иблиса","отказался он","чтобы","быть","с","падающими ниц"]]],"m":[[["وَلَقَدۡ","И уже",15,16],["جَعَلۡنَا","поместили Мы",15,16],["فِي","на",15,16],["ٱلسَّمَآءِ","небе",15,16],["بُرُوجٗا","созвездия",15,16],["وَزَيَّنَّٰهَا","и украсили его",15,16],["لِلنَّٰظِرِينَ","для смотрящих",15,16],[16]],[["وَحَفِظۡنَٰهَا","И оберегли Мы его",15,17],["مِن","от",15,17],["كُلِّ","всякого",15,17],["شَيۡطَٰنٖ","дьявола",15,17],["رَّجِيمٍ","побиваемого",15,17],[17],["إِلَّا","Кроме",15,18],["مَنِ","того, кто",15,18],["ٱسۡتَرَقَ","украдкой подслушал",15,18],["ٱلسَّمۡعَ","слышимое",15,18]],[["فَأَتۡبَعَهُۥ","и последует за ним",15,18],["شِهَابٞ","светоч",15,18],["مُّبِينٞ","я