{"p":264,"j":14,"a":[[15,32,["قَالَ","يَٰٓإِبۡلِيسُ","مَا","لَكَ","أَلَّا","تَكُونَ","مَعَ","ٱلسَّٰجِدِينَ"],"ḳала йа'иблиису ма лака алла такууна ма`ас сажидиин","Аллах сказал: «О Иблис! Почему ты не в числе павших ниц?».",["Сказал Он","о Иблис","что","с тобой","что не","ты","с","падающими ниц"]],[15,33,["قَالَ","لَمۡ","أَكُن","لِّأَسۡجُدَ","لِبَشَرٍ","خَلَقۡتَهُۥ","مِن","صَلۡصَٰلٖ","مِّنۡ","حَمَإٖ","مَّسۡنُونٖ"],"ḳала лам акул ли'асжуда либашарин халаḳтахуу мин салсалим мин хамаим маснуун","Иблис сказал: «Не подобает мне падать ниц перед человеком, которого Ты сотворил из сухой звонкой глины, полученной из видоизмененной грязи».",["Сказал он","не","был я","чтобы пасть ниц","перед человеком","сотворённым Тобой","из","звонкой глины","из","ила","изменённого"]],[15,34,["قَالَ","فَٱخۡرُجۡ","مِنۡهَا","فَإِنَّكَ","رَجِيمٞ"],"ḳала фахруж минха фа'иннака ражиим","Аллах сказал: «Изыди, и отныне ты будешь изгнан и побит.",["Сказал Он","так выйди","из него","ибо поистине, ты","побиваемый"]],[15,35,["وَإِنَّ","عَلَيۡكَ","ٱللَّعۡنَةَ","إِلَىٰ","يَوۡمِ","ٱلدِّينِ"],"ва'инна `алайкал ла`ната ила йаумид диин","И проклятие пребудет над тобой до Дня воздаяния».",["И поистине","на тебе","проклятие","до","дня","воздаяния"]],[15,36,["قَالَ","رَبِّ","فَأَنظِرۡنِيٓ","إِلَىٰ","يَوۡمِ","يُبۡعَثُونَ"],"ḳала рабби фа'анзирнии ила йауми йуб`асуун","Иблис сказал: «Господи! Предоставь мне отсрочку до того дня, когда они будут воскрешены».",["сказал он","Господи","так отсрочь мне","до","дня","они будут воскрешены"]],[15,37,["قَالَ","فَإِنَّكَ","مِنَ","ٱلۡمُنظَرِينَ"],"ḳала фа'иннака минал мунзариин","Аллах сказал: «Воистину, ты - один из тех, кому предоставлена отсрочка",["Сказал Он","так поистине, ты","из","получивших отсрочку"]],[15,38,["إِلَىٰ","يَوۡمِ","ٱلۡوَقۡتِ","ٱلۡمَعۡلُومِ"],"ила йаумил ваḳтил ма`луум","до дня, срок которого определен».",["До","дня","времени","известного"]],[15,39,["قَالَ","رَبِّ","بِمَآ","أَغۡوَيۡتَنِي","لَأُزَيِّنَنَّ","لَهُمۡ","فِي","ٱلۡأَرۡضِ","وَلَأُغۡوِيَنَّهُمۡ","أَجۡمَعِينَ"],"ḳала рабби бима агвайтании ла'узаййинанна лахум фил арди валаугвийаннахум ажма`иин","Иблис сказал: «Господи! За то, что Ты ввел меня в заблуждение, я приукрашу для них земное и непременно совращу их всех,",["Сказал он","Господи","за то, что","Ты сбил меня","непременно приукрашу","для них","на","земле","и непременно собью их","всех"]],[15,40,["إِلَّا","عِبَادَكَ","مِنۡهُمُ","ٱلۡمُخۡلَصِينَ"],"илла `ибадака минхумул мухласиин","кроме Твоих избранных (или искренних) рабов».",["Кроме","рабов Твоих","из них","искренних"]],[15,41,["قَالَ","هَٰذَا","صِرَٰطٌ","عَلَيَّ","مُسۡتَقِيمٌ"],"ḳала хаза сиратун `алаййа мустаḳиим","Аллах сказал: «Это - путь, ведущий прямо ко Мне.",["Сказал Он","это","путь","ко Мне","прямой"]],[15,42,["إِنَّ","عِبَادِي","لَيۡسَ","لَكَ","عَلَيۡهِمۡ","سُلۡطَٰنٌ","إِلَّا","مَنِ","ٱتَّبَعَكَ","مِنَ","ٱلۡغَاوِينَ"],"инна `ибадии лайса лака `алайхим султанун илла маниттаба`ака минал гавиин","Воистину, ты не властен над Моими рабами, за исключением заблудших, которые последуют за тобой».",["Поистине","рабы Мои","нет","у тебя","над ними","власти","кроме","тех, кто","последовал за тобой","из","заблудших"]],[15,43,["وَإِنَّ","جَهَنَّمَ","لَمَوۡعِدُهُمۡ","أَجۡمَعِينَ"],"ва'инна жаханнама ламау`идухум ажма`иин","Воистину, Геенна - это место, обещанное всем им.",["И поистине","Геенна","непременно обещанное место их","всех"]],[15,44,["لَهَا","سَبۡعَةُ","أَبۡوَٰبٖ","لِّكُلِّ","بَابٖ","مِّنۡهُمۡ","جُزۡءٞ","مَّقۡسُومٌ"],"лаха саб`ату абвабил ликулли бабим минхум жуз'ум маḳсуум","Там - семь врат, и для каждых врат предназначена определенная их часть.",["У неё","семь","врат","для каждых","врат","из них","часть","отделённая"]],[15,45,["إِنَّ","ٱلۡمُتَّقِينَ","فِي","جَنَّٰتٖ","وَعُيُونٍ"],"иннал муттаḳиина фии жаннатин ва`уйуун","Воистину, богобоязненные пребудут в Райских садах и среди источников.",["Поистине","богобоязненные","в","садах","и источниках"]],[15,46,["ٱدۡخُلُوهَا","بِسَلَٰمٍ","ءَامِنِينَ"],"идхулууха бисаламин аминиин","Входите сюда с миром, будучи в безопасности.",["Входите в них","с миром","будучи в безопасности"]],[15,47,["وَنَزَعۡنَا","مَا","فِي","صُدُورِهِم","مِّنۡ","غِلٍّ","إِخۡوَٰنًا","عَلَىٰ","سُرُرٖ","مُّتَقَٰبِلِينَ"],"ваназа`на ма фии судуурихим мин гиллин ихванан `ала сурурим мутаḳабилиин","Мы исторгнем из их сердец злобу, и они, как братья, будут лежать на ложах, обратившись лицом друг к другу.",["И удалим Мы","что","в","их груди","из","злобы","братьями","на","ложах","друг напротив друга"]],[15,48,["لَا","يَمَسُّهُمۡ","فِيهَا","نَصَبٞ","وَمَا","هُم","مِّنۡهَا","بِمُخۡرَجِينَ"],"ла йамассухум фииха насабун вама хум минха бимухражиин","Там их не коснется усталость, и их не изгонят оттуда.",["Не","коснётся их","там","усталость","и не","они","оттуда","будут изгнаны"]],[15,49,["نَبِّئۡ","عِبَادِيٓ","أَنِّيٓ","أَنَا","ٱلۡغَفُورُ","ٱلرَّحِيمُ"],"набби' `ибадии аннии анал гафуурур рахиим","Сообщи Моим рабам, что Я - Прощающий, Милосердный,",["Сообщи","рабам Моим","что Я","Я","Прощающий","Милосердный"]],[15,50,["وَأَنَّ","عَذَابِي","هُوَ","ٱلۡعَذَابُ","ٱلۡأَلِيمُ"],"ва'анна `азабии хуал `азабул алиим","но наказание Мое - наказание мучительное.",["И что","наказание Моё","оно","наказание","мучительное"]],[15,51,["وَنَبِّئۡهُمۡ","عَن","ضَيۡفِ","إِبۡرَٰهِيمَ"],"ванабби'хум `ан дайфи ибрахиим","Сообщи им также о гостях Ибрахима (Авраама).",["И сообщи им","о","гостях","Ибрахима"]]],"m":[[["قَالَ","Сказал Он",15,32],["يَٰٓإِبۡلِيسُ","о Иблис",15,32],["مَا","что",15,32],["لَكَ","с тобой",15,32],["أَلَّا","что не",15,32],["تَكُونَ","ты",15,32],["مَعَ","с",15,32],["ٱلسَّٰجِدِينَ","падающими ниц",15,32],[32],["قَالَ","Сказал он",15,33],["لَمۡ","не",15,33],["أَكُن","был я",15,33]],[["لِّأَسۡجُدَ","чтобы пасть ниц",15,33],["لِبَشَرٍ","перед человеком",15,33],["خَلَقۡتَهُۥ","сотворённым Тобой",15,33],["مِن","из",15,33],["صَلۡصَٰلٖ","звонкой глины",15,33],["مِّنۡ","из",15,33],["حَمَإٖ","ила",15,33],["مَّسۡنُونٖ","изменённого",15,33],[33],["قَالَ","Сказал Он",15,34]],[["فَٱخۡرُجۡ","так выйди",15,34],["مِنۡهَا","из