{"p":265,"j":14,"a":[[15,52,["إِذۡ","دَخَلُواْ","عَلَيۡهِ","فَقَالُواْ","سَلَٰمٗا","قَالَ","إِنَّا","مِنكُمۡ","وَجِلُونَ"],"из дахалуу `алайхи фаḳалуу саламан ḳала инна минкум важилуун","Они вошли к нему и сказали: «Мир!». Он сказал: «Воистину, мы опасаемся вас».",["вот","они вошли","к нему","и сказали","мир","он сказал","поистине, мы","вас","боящиеся"]],[15,53,["قَالُواْ","لَا","تَوۡجَلۡ","إِنَّا","نُبَشِّرُكَ","بِغُلَٰمٍ","عَلِيمٖ"],"ḳалуу ла таужал инна нубашширука бигуламин `алиим","Они сказали: «Не бойся! Воистину, мы принесли тебе благую весть об умном мальчике».",["Сказали они","не","бойся","поистине, мы","радуем тебя вестью","о мальчике","знающем"]],[15,54,["قَالَ","أَبَشَّرۡتُمُونِي","عَلَىٰٓ","أَن","مَّسَّنِيَ","ٱلۡكِبَرُ","فَبِمَ","تُبَشِّرُونَ"],"ḳала абашшартумуунии `ала ам массанийал кибару фабима тубашшируун","Он сказал: «Неужели вы сообщаете мне такую благую весть, когда старость уже одолела меня? Чем же вы меня радуете?».",["Сказал он","радуете ли вы меня","при том","что","коснулась меня","старость","так чем же","вы радуете"]],[15,55,["قَالُواْ","بَشَّرۡنَٰكَ","بِٱلۡحَقِّ","فَلَا","تَكُن","مِّنَ","ٱلۡقَٰنِطِينَ"],"ḳалуу башшарнака билхаḳḳи фала такум минал ḳанитиин","Они сказали: «Мы сообщаем тебе истинную весть, и не будь в числе тех, кто отчаивается».",["Сказали они","обрадовали мы тебя","истиной","так не","будь","из","отчаявшихся"]],[15,56,["قَالَ","وَمَن","يَقۡنَطُ","مِن","رَّحۡمَةِ","رَبِّهِۦٓ","إِلَّا","ٱلضَّآلُّونَ"],"ḳала ваман йаḳнату мир рахмати раббихии иллад даллуун","Он сказал: «Кто же отчаивается в милости своего Господа, кроме заблудших?!».",["Сказал он","и кто","отчаивается","в","милости","Господа своего","кроме","заблудших"]],[15,57,["قَالَ","فَمَا","خَطۡبُكُمۡ","أَيُّهَا","ٱلۡمُرۡسَلُونَ"],"ḳала фама хатбукум аййухал мурсалуун","Он сказал: «Какова же ваша миссия, о посланцы?».",["сказал","так в чём же","ваше дело","о","посланцы"]],[15,58,["قَالُوٓاْ","إِنَّآ","أُرۡسِلۡنَآ","إِلَىٰ","قَوۡمٖ","مُّجۡرِمِينَ"],"ḳалуу инна урсилна ила ḳаумим мужримиин","Они сказали: «Мы посланы к грешным людям.",["сказали","поистине, мы","мы посланы","к","народу","грешному"]],[15,59,["إِلَّآ","ءَالَ","لُوطٍ","إِنَّا","لَمُنَجُّوهُمۡ","أَجۡمَعِينَ"],"илла ала луутин инна ламунажжуухум ажма`иин","И только семью Лута (Лота) мы спасем целиком,",["кроме","семьи","Лута","поистине, мы","непременно спасём их","всех"]],[15,60,["إِلَّا","ٱمۡرَأَتَهُۥ","قَدَّرۡنَآ","إِنَّهَا","لَمِنَ","ٱلۡغَٰبِرِينَ"],"илламраатахуу ḳаддарна иннаха ламинал габириин","кроме его жены. Мы решили, что она останется позади».",["кроме","его жены","мы определили","что она","непременно из","оставшихся позади"]],[15,61,["فَلَمَّا","جَآءَ","ءَالَ","لُوطٍ","ٱلۡمُرۡسَلُونَ"],"фаламма жаа ала луутинил мурсалуун","Когда посланцы пришли к Луту (Лоту),",["и когда","пришли","к семье","Лута","посланцы"]],[15,62,["قَالَ","إِنَّكُمۡ","قَوۡمٞ","مُّنكَرُونَ"],"ḳала иннакум ḳаумум мункаруун","он сказал: «Воистину, вы - люди незнакомые».",["он сказал","поистине, вы","люди","незнакомые"]],[15,63,["قَالُواْ","بَلۡ","جِئۡنَٰكَ","بِمَا","كَانُواْ","فِيهِ","يَمۡتَرُونَ"],"ḳалуу бал жи'нака бима кануу фиихи йамтаруун","Они сказали: «Но мы явились к тебе с тем, по поводу чего они препирались.",["они сказали","нет же","мы пришли к тебе","с тем","были они","в чём","сомневались"]],[15,64,["وَأَتَيۡنَٰكَ","بِٱلۡحَقِّ","وَإِنَّا","لَصَٰدِقُونَ"],"ва'атайнака билхаḳḳи ва'инна ласадиḳуун","Мы принесли тебе истину, и мы говорим правду.",["и мы пришли к тебе","с истиной","и поистине, мы","непременно правдивы"]],[15,65,["فَأَسۡرِ","بِأَهۡلِكَ","بِقِطۡعٖ","مِّنَ","ٱلَّيۡلِ","وَٱتَّبِعۡ","أَدۡبَٰرَهُمۡ","وَلَا","يَلۡتَفِتۡ","مِنكُمۡ","أَحَدٞ","وَٱمۡضُواْ","حَيۡثُ","تُؤۡمَرُونَ"],"фа'асри би'ахлика биḳит`им минал лайли ваттаби` адбарахум вала йалтафит минкум ахадун вамдуу хайсу ту'маруун","Среди ночи выведи свою семью и сам иди вслед за ними. И пусть никто из вас не оборачивается. Ступайте туда, куда вам приказано».",["выведи же ночью","свою семью","в часть","из","ночи","и следуй","позади них","и пусть не","оборачивается","из вас","никто","и идите","куда","вам велено"]],[15,66,["وَقَضَيۡنَآ","إِلَيۡهِ","ذَٰلِكَ","ٱلۡأَمۡرَ","أَنَّ","دَابِرَ","هَٰٓؤُلَآءِ","مَقۡطُوعٞ","مُّصۡبِحِينَ"],"ваḳадайна илайхи заликал амра анна дабира ха'улаи маḳтуу`ум мусбихиин","Мы объявили ему приговор о том, что к утру все они будут уничтожены.",["и Мы возвестили","ему","это","решение","что","корень","этих","будет отсечён","к утру"]],[15,67,["وَجَآءَ","أَهۡلُ","ٱلۡمَدِينَةِ","يَسۡتَبۡشِرُونَ"],"важаа ахлул мадиинати йастабшируун","Жители города пришли, ликуя.",["и пришли","жители","города","радуясь"]],[15,68,["قَالَ","إِنَّ","هَٰٓؤُلَآءِ","ضَيۡفِي","فَلَا","تَفۡضَحُونِ"],"ḳала инна ха'улаи дайфии фала тафдахуун","Он сказал им: «Это - мои гости, не позорьте же меня.",["он сказал","поистине","эти","мои гости","так не","позорьте меня"]],[15,69,["وَٱتَّقُواْ","ٱللَّهَ","وَلَا","تُخۡزُونِ"],"ваттаḳуллаха вала тухзуун","Побойтесь Аллаха и не унижайте меня».",["и бойтесь","Аллаха","и не","унижайте меня"]],[15,70,["قَالُوٓاْ","أَوَلَمۡ","نَنۡهَكَ","عَنِ","ٱلۡعَٰلَمِينَ"],"ḳалуу авалам нанхака `анил `аламиин","Они сказали: «Разве мы не запрещали тебе укрывать людей?».",["они сказали","разве не","запретили мы тебе","от (заступничества за)","людей"]]],"m":[[["إِذۡ","вот",15,52],["دَخَلُواْ","они вошли",15,52],["عَلَيۡهِ","к нему",15,52],["فَقَالُواْ","и сказали",15,52],["سَلَٰمٗا","мир",15,52],["قَالَ","он сказал",15,52],["إِنَّا","поистине, мы",15,52],["مِنكُمۡ","вас",15,52],["وَجِلُونَ","боящиеся",15,52],[52],["قَالُواْ","Сказали они",15,53]],[["لَا","не",15,53],["تَوۡجَلۡ","бойся",15,53],["إِنَّا","поистине, мы",15,53],["نُبَشِّرُكَ","радуем тебя вестью",15,53],["بِغُلَٰمٍ","о мальчике",15,53],["عَلِيمٖ","знающем",15,53],[53],["قَالَ","Сказал он",15,54],["أَبَشَّرۡتُمُونِي","радуете ли вы меня",15,54],["عَلَىٰٓ","при том",15,54],["أَن","что",15,54]],[["مَّسَّنِيَ","коснулась меня",15,54],["ٱلۡكِبَرُ","старость",15,54],["فَبِمَ","так чем же",15,54],["تُبَشِّرُونَ","в