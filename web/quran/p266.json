{"p":266,"j":14,"a":[[15,71,["قَالَ","هَٰٓؤُلَآءِ","بَنَاتِيٓ","إِن","كُنتُمۡ","فَٰعِلِينَ"],"ḳала ха'улаи банатии ин кунтум фа`илиин","Он сказал: «Вот мои дочери, если вы хотите этого».",["он сказал","вот","мои дочери","если","вы","делающие (это)"]],[15,72,["لَعَمۡرُكَ","إِنَّهُمۡ","لَفِي","سَكۡرَتِهِمۡ","يَعۡمَهُونَ"],"ла`амрука иннахум лафии сакратихим йа`махуун","Клянусь твоей жизнью! Они слепо блуждали, опьяненные.",["клянусь твоей жизнью","поистине, они","непременно в","своём опьянении","слепо блуждали"]],[15,73,["فَأَخَذَتۡهُمُ","ٱلصَّيۡحَةُ","مُشۡرِقِينَ"],"фа'ахазатхумус сайхату мушриḳиин","А на восходе солнца их поразил вопль.",["и постиг их","вопль","на восходе"]],[15,74,["فَجَعَلۡنَا","عَٰلِيَهَا","سَافِلَهَا","وَأَمۡطَرۡنَا","عَلَيۡهِمۡ","حِجَارَةٗ","مِّن","سِجِّيلٍ"],"фажа`ална `алийаха сафилаха ва'амтарна `алайхим хижаратам мин сижжиил","Мы перевернули город вверх дном и обрушили на них каменья из обожженной глины.",["и Мы сделали","его верх","его низом","и Мы пролили дождём","на них","камни","из","обожжённой глины"]],[15,75,["إِنَّ","فِي","ذَٰلِكَ","لَأٓيَٰتٖ","لِّلۡمُتَوَسِّمِينَ"],"инна фии залика ла'айатил лилмутавассимиин","Воистину, в этом - знамения для зрячих.",["поистине","в","этом","непременно знамения","для проницательных"]],[15,76,["وَإِنَّهَا","لَبِسَبِيلٖ","مُّقِيمٍ"],"ва'иннаха лабисабиилим муḳиим","Воистину, они жили прямо на дороге из Мекки в Сирию.",["и поистине, оно","непременно на дороге","существующей"]],[15,77,["إِنَّ","فِي","ذَٰلِكَ","لَأٓيَةٗ","لِّلۡمُؤۡمِنِينَ"],"инна фии залика ла'айатал лилму'миниин","Воистину, в этом - знамение для верующих.",["поистине","в","этом","непременно знамение","для верующих"]],[15,78,["وَإِن","كَانَ","أَصۡحَٰبُ","ٱلۡأَيۡكَةِ","لَظَٰلِمِينَ"],"ва'ин кана асхабул айкати лазалимиин","Жители Айки также были беззаконниками.",["и поистине","были","обитатели","Айки (рощи)","непременно беззаконниками"]],[15,79,["فَٱنتَقَمۡنَا","مِنۡهُمۡ","وَإِنَّهُمَا","لَبِإِمَامٖ","مُّبِينٖ"],"фантаḳамна минхум ва'иннахума лабиимамим мубиин","Мы отомстили им. Воистину, оба эти поселения находились на ясной дороге.",["и Мы отомстили","им","и поистине, оба они","непременно на дороге","ясной"]],[15,80,["وَلَقَدۡ","كَذَّبَ","أَصۡحَٰبُ","ٱلۡحِجۡرِ","ٱلۡمُرۡسَلِينَ"],"валаḳад каззаба асхабул хижрил мурсалиин","Жители Хиджра тоже сочли лжецами посланников.",["и уже","сочли лжецами","обитатели","Хиджра","посланников"]],[15,81,["وَءَاتَيۡنَٰهُمۡ","ءَايَٰتِنَا","فَكَانُواْ","عَنۡهَا","مُعۡرِضِينَ"],"ва'атайнахум айатина факануу `анха му`ридиин","Мы даровали им Наши знамения, но они отвернулись от них.",["и Мы дали им","Наши знамения","но были они","от них","отворачивающимися"]],[15,82,["وَكَانُواْ","يَنۡحِتُونَ","مِنَ","ٱلۡجِبَالِ","بُيُوتًا","ءَامِنِينَ"],"вакануу йанхитууна минал жибали буйуутан аминиин","Они высекали в горах безопасные жилища.",["и они были","высекают","из","гор","дома","в безопасности"]],[15,83,["فَأَخَذَتۡهُمُ","ٱلصَّيۡحَةُ","مُصۡبِحِينَ"],"фа'ахазатхумус сайхату мусбихиин","А на заре их поразил вопль,",["и постиг их","вопль","на рассвете"]],[15,84,["فَمَآ","أَغۡنَىٰ","عَنۡهُم","مَّا","كَانُواْ","يَكۡسِبُونَ"],"фама агна `анхум ма кануу йаксибуун","и не помогло им то, что они приобретали.",["и не","помогло","им","то, что","они","приобретали"]],[15,85,["وَمَا","خَلَقۡنَا","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضَ","وَمَا","بَيۡنَهُمَآ","إِلَّا","بِٱلۡحَقِّۗ","وَإِنَّ","ٱلسَّاعَةَ","لَأٓتِيَةٞۖ","فَٱصۡفَحِ","ٱلصَّفۡحَ","ٱلۡجَمِيلَ"],"вама халаḳнас самавати вал'арда вама байнахума илла билхаḳḳи ва'иннас са`ата ла'атийатун фасфахис сафхал жамиил","Мы сотворили небеса, землю и все, что между ними, только ради истины. Час непременно настанет. Посему прощай их красиво.",["и не","Мы сотворили","небеса","и землю","и то, что","между ними","кроме как","с истиной","и поистине","Час","непременно наступит","так прощай","прощением","прекрасным"]],[15,86,["إِنَّ","رَبَّكَ","هُوَ","ٱلۡخَلَّٰقُ","ٱلۡعَلِيمُ"],"инна раббака хуал халлаḳул `алиим","Воистину, твой Господь - Творец, Знающий.",["поистине","твой Господь","Он","Творец","Знающий"]],[15,87,["وَلَقَدۡ","ءَاتَيۡنَٰكَ","سَبۡعٗا","مِّنَ","ٱلۡمَثَانِي","وَٱلۡقُرۡءَانَ","ٱلۡعَظِيمَ"],"валаḳад атайнака саб`ам минал масании валḳур'анал `азиим","Мы даровали тебе семь часто повторяемых сур или аятов и великий Коран.",["и уже","Мы дали тебе","семь","из","повторяемых","и Коран","великий"]],[15,88,["لَا","تَمُدَّنَّ","عَيۡنَيۡكَ","إِلَىٰ","مَا","مَتَّعۡنَا","بِهِۦٓ","أَزۡوَٰجٗا","مِّنۡهُمۡ","وَلَا","تَحۡزَنۡ","عَلَيۡهِمۡ","وَٱخۡفِضۡ","جَنَاحَكَ","لِلۡمُؤۡمِنِينَ"],"ла тамудданна `айнайка ила ма матта`на бихии азважам минхум вала тахзан `алайхим вахфид жанахака лилму'миниин","Не заглядывайся на блага, которыми Мы наделили некоторых из них, и не печалься о них. Склони свои крылья перед верующими (будь добр и милосерден к ним)",["не","простирай","свои глаза","на","то, чем","Мы дали насладиться","этим","разным группам","из них","и не","печалься","о них","и склони","своё крыло","перед верующими"]],[15,89,["وَقُلۡ","إِنِّيٓ","أَنَا","ٱلنَّذِيرُ","ٱلۡمُبِينُ"],"ваḳул иннии анан назиирул мубиин","и говори: «Воистину, я - всего лишь предостерегающий и разъясняющий увещеватель».",["и скажи","поистине, я","я","увещеватель","ясный"]],[15,90,["كَمَآ","أَنزَلۡنَا","عَلَى","ٱلۡمُقۡتَسِمِينَ"],"кама анзална `алал муḳтасимиин","Мы также ниспослали его (наказание) разделяющим,",["так же как","Мы ниспослали","на","разделяющих"]]],"m":[[["قَالَ","он сказал",15,71],["هَٰٓؤُلَآءِ","вот",15,71],["بَنَاتِيٓ","мои дочери",15,71],["إِن","если",15,71],["كُنتُمۡ","вы",15,71],["فَٰعِلِينَ","делающие (это)",15,71],[71],["لَعَمۡرُكَ","клянусь твоей жизнью",15,72],["إِنَّهُمۡ","поистине, они",15,72],["لَفِي","непременно в",15,72],["سَكۡرَتِهِمۡ","своём опьянении",15,72]],[["يَعۡمَهُونَ","слепо блуждали",15,72],[72],["فَأَخَذَتۡهُمُ","и постиг их",15,73],["ٱلصَّيۡحَةُ","вопль",15,73],["مُشۡرِقِينَ","на восходе",15,73],[73],["فَجَعَلۡنَا","и Мы сделали",15,74],["عَٰلِيَهَا","его верх",15,74]],[["سَافِلَهَا","его низом",15,74],["وَأَمۡطَرۡنَا","