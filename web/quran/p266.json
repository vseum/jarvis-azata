5,85],["بِٱلۡحَقِّۗ","с истиной",15,85],["وَإِنَّ","и поистине",15,85]],[["ٱلسَّاعَةَ","Час",15,85],["لَأٓتِيَةٞۖ","непременно наступит",15,85],["فَٱصۡفَحِ","так прощай",15,85],["ٱلصَّفۡحَ","прощением",15,85],["ٱلۡجَمِيلَ","прекрасным",15,85],[85],["إِنَّ","поистине",15,86],["رَبَّكَ","твой Господь",15,86],["هُوَ","Он",15,86]],[["ٱلۡخَلَّٰقُ","Творец",15,86],["ٱلۡعَلِيمُ","Знающий",15,86],[86],["وَلَقَدۡ","и уже",15,87],["ءَاتَيۡنَٰكَ","Мы дали тебе",15,87],["سَبۡعٗا","семь",15,87],["مِّنَ","из",15,87],["ٱلۡمَثَانِي","повторяемых",15,87],["وَٱلۡقُرۡءَانَ","и Коран",15,87]],[["ٱلۡعَظِيمَ","великий",15,87],[87],["لَا","не",15,88],["تَمُدَّنَّ","простирай",15,88],["عَيۡنَيۡكَ","свои глаза",15,88],["إِلَىٰ","на",15,88],["مَا","то, чем",15,88],["مَتَّعۡنَا","Мы дали насладиться",15,88],["بِهِۦٓ","этим",15,88],["أَزۡوَٰجٗا","разным группам",15,88],["مِّنۡهُمۡ","из них",15,88]],[["وَلَا","и не",15,88],["تَحۡزَنۡ","печалься",15,88],["عَلَيۡهِمۡ","о них",15,88],["وَٱخۡفِضۡ","и склони",15,88],["جَنَاحَكَ","своё крыло",15,88],["لِلۡمُؤۡمِنِينَ","перед верующими",15,88],[88],["وَقُلۡ","и скажи",15,89],["إِنِّيٓ","поистине, я",15,89]],[["أَنَا","я",15,89],["ٱلنَّذِيرُ","увещеватель",15,89],["ٱلۡمُبِينُ","ясный",15,89],[89],["كَمَآ","так же как",15,90],["أَنزَلۡنَا","Мы ниспослали",15,90],["عَلَى","на",15,90],["ٱلۡمُقۡتَسِمِينَ","разделяющих",15,90],[90]]]}