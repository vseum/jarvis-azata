{"p":267,"j":14,"a":[[15,91,["ٱلَّذِينَ","جَعَلُواْ","ٱلۡقُرۡءَانَ","عِضِينَ"],"аллазиина жа`алул ḳур'ана `идиин","которые поделили Коран на части (уверовали в одну часть Корана и отвергли другую).",["те, которые","сделали","Коран","частями"]],[15,92,["فَوَرَبِّكَ","لَنَسۡـَٔلَنَّهُمۡ","أَجۡمَعِينَ"],"фавараббика ланас'аланнахум ажма`иин","Клянусь твоим Господом! Мы непременно всех их спросим",["клянусь же твоим Господом","непременно Мы спросим их","всех"]],[15,93,["عَمَّا","كَانُواْ","يَعۡمَلُونَ"],"`амма кануу йа`малуун","о том, что они совершали.",["о том, что","они","совершали"]],[15,94,["فَٱصۡدَعۡ","بِمَا","تُؤۡمَرُ","وَأَعۡرِضۡ","عَنِ","ٱلۡمُشۡرِكِينَ"],"фасда` бима ту'мару ва'а`рид `анил мушрикиин","Провозгласи же то, что тебе велено, и отвернись от многобожников.",["так возвещай","о том, что","тебе велено","и отвернись","от","многобожников"]],[15,95,["إِنَّا","كَفَيۡنَٰكَ","ٱلۡمُسۡتَهۡزِءِينَ"],"инна кафайнакал мустахзи'иин","Воистину, Мы избавили тебя от тех, кто насмехается,",["поистине, Мы","избавили тебя","от насмешников"]],[15,96,["ٱلَّذِينَ","يَجۡعَلُونَ","مَعَ","ٱللَّهِ","إِلَٰهًا","ءَاخَرَۚ","فَسَوۡفَ","يَعۡلَمُونَ"],"аллазиина йаж`алууна ма`аллахи илахан ахара фасауфа йа`ламуун","кто признает других богов помимо Аллаха, и скоро они узнают.",["те, которые","делают","наряду с","Аллахом","бога","другого","и скоро","они узнают"]],[15,97,["وَلَقَدۡ","نَعۡلَمُ","أَنَّكَ","يَضِيقُ","صَدۡرُكَ","بِمَا","يَقُولُونَ"],"валаḳад на`ламу аннака йадииḳу садрука бима йаḳуулуун","Мы знаем, что твоя грудь сжимается от того, что они говорят.",["и уже","Мы знаем","что у тебя","сжимается","твоя грудь","от того, что","они говорят"]],[15,98,["فَسَبِّحۡ","بِحَمۡدِ","رَبِّكَ","وَكُن","مِّنَ","ٱلسَّٰجِدِينَ"],"фасаббих бихамди раббика вакум минас сажидиин","Так восславь же Господа твоего хвалой и будь в числе тех, кто падает ниц.",["так славь","хвалой","Господа твоего","и будь","из числа","падающих ниц"]],[15,99,["وَٱعۡبُدۡ","رَبَّكَ","حَتَّىٰ","يَأۡتِيَكَ","ٱلۡيَقِينُ"],"ва`буд раббака хатта йа'тийакал йаḳиин","Поклоняйся Господу твоему, пока убежденность (смерть) не явится к тебе.",["и поклоняйся","своему Господу","пока не","придёт к тебе","убеждённость (смерть)"]],[16,1,["أَتَىٰٓ","أَمۡرُ","ٱللَّهِ","فَلَا","تَسۡتَعۡجِلُوهُۚ","سُبۡحَٰنَهُۥ","وَتَعَٰلَىٰ","عَمَّا","يُشۡرِكُونَ"],"ата амруллахи фала таста`жилууху субханахуу вата`ала `амма йушрикуун","Веление Аллаха придет, и не пытайтесь это ускорить. Преславен Он и превыше того, что они приобщают в сотоварищи!",["пришло","веление","Аллаха","так не","торопите его","пречист Он","и превыше","того, что","они придают в сотоварищи"]],[16,2,["يُنَزِّلُ","ٱلۡمَلَٰٓئِكَةَ","بِٱلرُّوحِ","مِنۡ","أَمۡرِهِۦ","عَلَىٰ","مَن","يَشَآءُ","مِنۡ","عِبَادِهِۦٓ","أَنۡ","أَنذِرُوٓاْ","أَنَّهُۥ","لَآ","إِلَٰهَ","إِلَّآ","أَنَا۠","فَٱتَّقُونِ"],"йуназзилул малаиката бирруухи мин амрихии `ала ман йашау мин `ибадихии ан анзируу аннахуу ла илаха илла ана фаттаḳуун","Он ниспосылает ангелов с духом (откровением) по Своему велению тому из Своих рабов, кому пожелает: «Предостерегайте тем, что нет божества, кроме Меня. Бойтесь же Меня».",["Он ниспосылает","ангелов","с духом","по","Его велению","на","кого","Он пожелает","из","Его рабов","что","предостерегайте","что","нет","божества","кроме","Меня","бойтесь же Меня"]],[16,3,["خَلَقَ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضَ","بِٱلۡحَقِّۚ","تَعَٰلَىٰ","عَمَّا","يُشۡرِكُونَ"],"халаḳас самавати вал'арда билхаḳḳи та`ала `амма йушрикуун","Он сотворил небеса и землю ради истины. Он превыше тех, кого они приобщают в сотоварищи!",["Он сотворил","небеса","и землю","с истиной","превыше Он","того, что","они придают в сотоварищи"]],[16,4,["خَلَقَ","ٱلۡإِنسَٰنَ","مِن","نُّطۡفَةٖ","فَإِذَا","هُوَ","خَصِيمٞ","مُّبِينٞ"],"халаḳал инсана мин нутфатин фа'иза хуа хасиимум мубиин","Он сотворил человека из капли, и после этого тот открыто пререкается.",["Он сотворил","человека","из","капли","и вот","он","спорщик","явный"]],[16,5,["وَٱلۡأَنۡعَٰمَ","خَلَقَهَاۖ","لَكُمۡ","فِيهَا","دِفۡءٞ","وَمَنَٰفِعُ","وَمِنۡهَا","تَأۡكُلُونَ"],"вал'ан`ама халаḳаха лакум фииха диф'ун ваманафи`у ваминха та'кулуун","Он также сотворил скот, который приносит вам тепло и пользу. Вы также употребляете его в пищу.",["и скот","Он сотворил его","для вас","в нём","тепло","и польза","и из него","вы едите"]],[16,6,["وَلَكُمۡ","فِيهَا","جَمَالٌ","حِينَ","تُرِيحُونَ","وَحِينَ","تَسۡرَحُونَ"],"валакум фииха жамалун хиина туриихууна вахиина тасрахуун","Они украшают вас, когда вы пригоняете их обратно вечерами и выводите на пастбище по утрам.",["и для вас","в нём","красота","когда","вы пригоняете вечером","и когда","выгоняете утром"]]],"m":[[["ٱلَّذِينَ","те, которые",15,91],["جَعَلُواْ","сделали",15,91],["ٱلۡقُرۡءَانَ","Коран",15,91],["عِضِينَ","частями",15,91],[91],["فَوَرَبِّكَ","клянусь же твоим Господом",15,92],["لَنَسۡـَٔلَنَّهُمۡ","непременно Мы спросим их",15,92]],[["أَجۡمَعِينَ","всех",15,92],[92],["عَمَّا","о том, что",15,93],["كَانُواْ","они",15,93],["يَعۡمَلُونَ","совершали",15,93],[93],["فَٱصۡدَعۡ","так возвещай",15,94],["بِمَا","о том, что",15,94],["تُؤۡمَرُ","тебе велено",15,94],["وَأَعۡرِضۡ","и отвернись",15,94]],[["عَنِ","от",15,94],["ٱلۡمُشۡرِكِينَ","многобожников",15,94],[94],["إِنَّا","поистине, Мы",15,95],["كَفَيۡنَٰكَ","избавили тебя",15,95],["ٱلۡمُسۡتَهۡزِءِينَ","от насмешников",15,95],[95],["ٱلَّذِينَ","те, которые",15,96]],[["يَجۡعَلُونَ","делают",15,96],["مَعَ","наряду с",15,96],["ٱللَّهِ","Аллахом",15,96],["إِلَٰهًا","бога",15,96],["ءَاخَرَۚ","другого",15,96],["فَسَوۡفَ","и скоро",15,96],["يَعۡلَمُونَ","они узнают",15,96],[96],["وَلَقَدۡ","и уже",15,97],["نَعۡلَمُ","Мы знаем",15,97]],[["أَنَّكَ","что у тебя",15,97],["يَضِيقُ","сжимается",15,97],["صَدۡرُكَ","твоя грудь",15,97],["بِمَا","от того, что",15,97],["يَقُولُونَ","они говорят",15,97],[97],["فَسَبِّحۡ","так славь",15,98],["بِحَمۡدِ","хвалой",15,98],["رَبِّكَ","Господа твоего",15,98],["وَكُن","и будь",15,98]],[["مِّنَ","из числа",15,98],["ٱلسَّٰجِدِينَ","падающих ниц",15,98],[98],["وَٱعۡبُدۡ","и поклоняйся",15,9