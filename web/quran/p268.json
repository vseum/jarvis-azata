{"p":268,"j":14,"a":[[16,7,["وَتَحۡمِلُ","أَثۡقَالَكُمۡ","إِلَىٰ","بَلَدٖ","لَّمۡ","تَكُونُواْ","بَٰلِغِيهِ","إِلَّا","بِشِقِّ","ٱلۡأَنفُسِۚ","إِنَّ","رَبَّكُمۡ","لَرَءُوفٞ","رَّحِيمٞ"],"ватахмилу асḳалакум ила баладил лам такуунуу балигиихи илла бишиḳḳил анфуси инна раббакум лараууфур рахиим","Они перевозят ваши грузы в края, достичь которых вы могли бы только ценой больших усилий. Воистину, Господь ваш - Сострадательный, Милосердный.",["и он несёт","ваши грузы","в","край","не","вы были бы","достигающими его","кроме как","с тяжким трудом","для душ","поистине","ваш Господь","непременно Сострадательный","Милосердный"]],[16,8,["وَٱلۡخَيۡلَ","وَٱلۡبِغَالَ","وَٱلۡحَمِيرَ","لِتَرۡكَبُوهَا","وَزِينَةٗۚ","وَيَخۡلُقُ","مَا","لَا","تَعۡلَمُونَ"],"валхайла валбигала валхамиира литаркабууха вазиинатан вайахлуḳу ма ла та`ламуун","Он сотворил коней, мулов и ослов, чтобы вы ездили на них верхом и для украшения. Он творит также то, о чем вы не ведаете.",["и коней","и мулов","и ослов","чтобы вы ездили на них","и для украшения","и Он творит","то, что","не","вы знаете"]],[16,9,["وَعَلَى","ٱللَّهِ","قَصۡدُ","ٱلسَّبِيلِ","وَمِنۡهَا","جَآئِرٞۚ","وَلَوۡ","شَآءَ","لَهَدَىٰكُمۡ","أَجۡمَعِينَ"],"ва`алаллахи ḳасдус сабиили ваминха жаирун валау шаа лахадакум ажма`иин","Аллах указывает на прямой путь, но есть дороги, которые уводят в сторону. Если бы Аллах пожелал, то Он вас всех наставил бы на прямой путь.",["и на","Аллахе","указание прямого","пути","и из них","уклоняющийся","и если бы","Он пожелал","непременно Он наставил бы вас","всех"]],[16,10,["هُوَ","ٱلَّذِيٓ","أَنزَلَ","مِنَ","ٱلسَّمَآءِ","مَآءٗۖ","لَّكُم","مِّنۡهُ","شَرَابٞ","وَمِنۡهُ","شَجَرٞ","فِيهِ","تُسِيمُونَ"],"хуал лазии анзала минас самаи маал лакум минху шарабун ваминху шажарун фиихи тусиимуун","Он - Тот, Кто ниспосылает с неба воду. Она служит для вас питьем, и благодаря ей произрастают растения, среди которых вы пасете скот.",["Он","Тот, Который","ниспослал","с","неба","воду","для вас","из неё","питьё","и из неё","растения","на которых","вы пасёте скот"]],[16,11,["يُنۢبِتُ","لَكُم","بِهِ","ٱلزَّرۡعَ","وَٱلزَّيۡتُونَ","وَٱلنَّخِيلَ","وَٱلۡأَعۡنَٰبَ","وَمِن","كُلِّ","ٱلثَّمَرَٰتِۚ","إِنَّ","فِي","ذَٰلِكَ","لَأٓيَةٗ","لِّقَوۡمٖ","يَتَفَكَّرُونَ"],"йумбиту лакум бихиз зар`а ваззайтууна ваннахиила вал'а`наба вамин куллис самарати инна фии залика ла'айатал лиḳаумин йатафаккаруун","Он взращивает для вас злаки, маслины, финики, виноград и всевозможные плоды. Воистину, в этом - знамение для людей размышляющих.",["Он выращивает","для вас","ею","посевы","и маслины","и пальмы","и виноград","и из","всех","плодов","поистине","в","этом","непременно знамение","для людей","размышляющих"]],[16,12,["وَسَخَّرَ","لَكُمُ","ٱلَّيۡلَ","وَٱلنَّهَارَ","وَٱلشَّمۡسَ","وَٱلۡقَمَرَۖ","وَٱلنُّجُومُ","مُسَخَّرَٰتُۢ","بِأَمۡرِهِۦٓۚ","إِنَّ","فِي","ذَٰلِكَ","لَأٓيَٰتٖ","لِّقَوۡمٖ","يَعۡقِلُونَ"],"васаххара лакумул лайла ваннахара вашшамса валḳамара ваннужууму мусаххарату би'амрихии инна фии залика ла'айатил лиḳаумин йа`ḳилуун","Он покорил вам ночь и день, солнце и луну. Звезды также покорны по Его воле. Воистину, в этом - знамения для людей разумеющих.",["и Он подчинил","вам","ночь","и день","и солнце","и луну","и звёзды","подчинены","Его велением","поистине","в","этом","непременно знамения","для людей","разумеющих"]],[16,13,["وَمَا","ذَرَأَ","لَكُمۡ","فِي","ٱلۡأَرۡضِ","مُخۡتَلِفًا","أَلۡوَٰنُهُۥٓۚ","إِنَّ","فِي","ذَٰلِكَ","لَأٓيَةٗ","لِّقَوۡمٖ","يَذَّكَّرُونَ"],"вама зараа лакум фил арди мухталифан алванухуу инна фии залика ла'айатал лиḳаумин йаззаккаруун","Он сотворил для вас на земле разнообразие цветов. Воистину, в этом - знамение для людей поминающих.",["и то, что","Он расселил","для вас","на","земле","различны","его цвета","поистине","в","этом","непременно знамение","для людей","поминающих"]],[16,14,["وَهُوَ","ٱلَّذِي","سَخَّرَ","ٱلۡبَحۡرَ","لِتَأۡكُلُواْ","مِنۡهُ","لَحۡمٗا","طَرِيّٗا","وَتَسۡتَخۡرِجُواْ","مِنۡهُ","حِلۡيَةٗ","تَلۡبَسُونَهَاۖ","وَتَرَى","ٱلۡفُلۡكَ","مَوَاخِرَ","فِيهِ","وَلِتَبۡتَغُواْ","مِن","فَضۡلِهِۦ","وَلَعَلَّكُمۡ","تَشۡكُرُونَ"],"вахуал лазии саххарал бахра лита'кулуу минху лахман тариййан ватастахрижуу минху хилйатан талбасуунаха ватарал фулка мавахира фиихи валитабтагуу мин фадлихии вала`аллакум ташкуруун","Он - Тот, Кто подчинил море, чтобы вы вкушали из него свежее мясо и добывали в нем украшения, которые вы носите. Ты видишь корабли, которые бороздят его для того, чтобы вы могли снискать Его милость, - быть может, вы будете благодарны.",["и Он","Тот, Который","подчинил","море","чтобы вы ели","из него","мясо","свежее","и добывали","из него","украшения","которые вы носите","и ты видишь","корабли","рассекающими","его","и чтобы вы искали","из","Его милости","и, может быть, вы","будете благодарны"]]],"m":[[["وَتَحۡمِلُ","и он несёт",16,7],["أَثۡقَالَكُمۡ","ваши грузы",16,7],["إِلَىٰ","в",16,7],["بَلَدٖ","край",16,7],["لَّمۡ","не",16,7],["تَكُونُواْ","вы были бы",16,7],["بَٰلِغِيهِ","достигающими его",16,7],["إِلَّا","кроме как",16,7],["بِشِقِّ","с тяжким трудом",16,7]],[["ٱلۡأَنفُسِۚ","для душ",16,7],["إِنَّ","поистине",16,7],["رَبَّكُمۡ","ваш Господь",16,7],["لَرَءُوفٞ","непременно Сострадательный",16,7],["رَّحِيمٞ","Милосердный",16,7],[7],["وَٱلۡخَيۡلَ","и коней",16,8],["وَٱلۡبِغَالَ","и мулов",16,8]],[["وَٱلۡحَمِيرَ","и ослов",16,8],["لِتَرۡكَبُوهَا","чтобы вы ездили на них",16,8],["وَزِينَةٗۚ","и для украшения",16,8],["وَيَخۡلُقُ","и Он творит",16,8],["مَا","то, что",16,8],["لَا","не",16,8],["تَعۡلَمُونَ","вы знаете",16,8],[8]],[["وَعَلَى","и на",16,9],["ٱللَّهِ","Аллахе",16,9],["قَصۡدُ","указание прямого",16,9],["ٱلسَّبِيلِ","пути",16,9],["وَمِنۡهَا","и из них",16,9],["جَآئِرٞۚ","уклоняющийся",16,9],["وَلَوۡ","и если бы",16,9],["شَآءَ","Он пожелал",16,9],["لَهَدَىٰكُمۡ","непременно Он наставил бы вас",16,9]],[["أَجۡمَعِينَ","всех",16,9],[9],["هُوَ","Он",16,10],["ٱلَّذِيٓ","Тот, Который",16,10],["أَنزَلَ","ниспослал",16,10],["مِنَ","с",16,10],["ٱلسَّمَآءِ","неба",16,10],["مَآءٗۖ","воду",16,10],["لَّكُم","для вас",16,10],["مِّنۡهُ","из неё",1