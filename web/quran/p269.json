{"p":269,"j":14,"a":[[16,15,["وَأَلۡقَىٰ","فِي","ٱلۡأَرۡضِ","رَوَٰسِيَ","أَن","تَمِيدَ","بِكُمۡ","وَأَنۡهَٰرٗا","وَسُبُلٗا","لَّعَلَّكُمۡ","تَهۡتَدُونَ"],"ва'алḳа фил арди равасийа ан тамиида бикум ва'анхаран васубулал ла`аллакум тахтадуун","Он поместил на земле незыблемые горы, дабы она не колебалась вместе с вами, а также реки и дороги, дабы вы могли идти верным путем.",["и Он воздвиг","на","земле","прочные горы","чтобы не","колебалась она","с вами","и реки","и дороги","чтобы вы","шли прямым путём"]],[16,16,["وَعَلَٰمَٰتٖۚ","وَبِٱلنَّجۡمِ","هُمۡ","يَهۡتَدُونَ"],"ва`аламатин вабиннажми хум йахтадуун","Он создал знаки. А по звездам они находят правильную дорогу.",["и знаки","и по звезде","они","находят путь"]],[16,17,["أَفَمَن","يَخۡلُقُ","كَمَن","لَّا","يَخۡلُقُۚ","أَفَلَا","تَذَكَّرُونَ"],"афаман йахлуḳу камал ла йахлуḳу афала тазаккаруун","Разве Тот, Кто творит, подобен тому, кто не творит? Неужели вы не помяните назидание?",["разве же Тот, Кто","творит","как тот, кто","не","творит","разве же не","опомнитесь вы"]],[16,18,["وَإِن","تَعُدُّواْ","نِعۡمَةَ","ٱللَّهِ","لَا","تُحۡصُوهَآۗ","إِنَّ","ٱللَّهَ","لَغَفُورٞ","رَّحِيمٞ"],"ва'ин та`уддуу ни`маталлахи ла тухсууха инналлаха лагафуурур рахиим","Если вы станете считать милости Аллаха, то не пересчитаете их! Воистину, Аллах - Прощающий, Милосердный.",["и если","вы станете считать","милость","Аллаха","не","исчислите её","поистине","Аллах","непременно Прощающий","Милосердный"]],[16,19,["وَٱللَّهُ","يَعۡلَمُ","مَا","تُسِرُّونَ","وَمَا","تُعۡلِنُونَ"],"валлаху йа`ламу ма тусиррууна вама ту`линуун","Аллах ведает то, что вы утаиваете, и то, что вы совершаете открыто.",["и Аллах","знает","то, что","вы скрываете","и то, что","вы обнаруживаете"]],[16,20,["وَٱلَّذِينَ","يَدۡعُونَ","مِن","دُونِ","ٱللَّهِ","لَا","يَخۡلُقُونَ","شَيۡـٔٗا","وَهُمۡ","يُخۡلَقُونَ"],"валлазиина йад`ууна мин дууниллахи ла йахлуḳууна шай'ан вахум йухлаḳуун","А те, к кому они обращаются с молитвами вместо Аллаха, не могут ничего сотворить, тогда как сами они были сотворены.",["и те, которых","они призывают","(из)","помимо","Аллаха","не","творят","ничего","а они сами","сотворены"]],[16,21,["أَمۡوَٰتٌ","غَيۡرُ","أَحۡيَآءٖۖ","وَمَا","يَشۡعُرُونَ","أَيَّانَ","يُبۡعَثُونَ"],"амватун гайру ахйаин вама йаш`урууна аййана йуб`асуун","Они мертвы, а не живы, и не знают они, когда будут воскрешены.",["мёртвые","не","живые","и не","осознают они","когда","они будут воскрешены"]],[16,22,["إِلَٰهُكُمۡ","إِلَٰهٞ","وَٰحِدٞۚ","فَٱلَّذِينَ","لَا","يُؤۡمِنُونَ","بِٱلۡأٓخِرَةِ","قُلُوبُهُم","مُّنكِرَةٞ","وَهُم","مُّسۡتَكۡبِرُونَ"],"илахукум илахун вахидун фаллазиина ла йу'минууна бил'ахирати ḳулуубухум мункиратун вахум мустакбируун","Ваш Бог - Бог Единственный. Но сердца тех, которые не верует в Последнюю жизнь, отрицают истину, а сами они - высокомерные гордецы.",["ваш Бог","Бог","Единый","а те, которые","не","веруют","в Последнюю жизнь","их сердца","отрицают","и они","высокомерны"]],[16,23,["لَا","جَرَمَ","أَنَّ","ٱللَّهَ","يَعۡلَمُ","مَا","يُسِرُّونَ","وَمَا","يُعۡلِنُونَۚ","إِنَّهُۥ","لَا","يُحِبُّ","ٱلۡمُسۡتَكۡبِرِينَ"],"ла жарама анналлаха йа`ламу ма йусиррууна вама йу`линууна иннахуу ла йухиббул мустакбириин","Несомненно, Аллах знает то, что вы утаиваете, и то, что вы обнародуете. Воистину, Он не любит высокомерных.",["нет","сомнения","что","Аллах","знает","то, что","они скрывают","и то, что","они обнаруживают","поистине, Он","не","любит","высокомерных"]],[16,24,["وَإِذَا","قِيلَ","لَهُم","مَّاذَآ","أَنزَلَ","رَبُّكُمۡ","قَالُوٓاْ","أَسَٰطِيرُ","ٱلۡأَوَّلِينَ"],"ва'иза ḳиила лахум маза анзала раббукум ḳалуу асатиирул аввалиин","Когда им говорят: «Что ниспослал вам Господь?». - они говорят: «Это - легенды древних народов!».",["и когда","сказано","им","что","ниспослал","ваш Господь","говорят они","сказки","древних"]],[16,25,["لِيَحۡمِلُوٓاْ","أَوۡزَارَهُمۡ","كَامِلَةٗ","يَوۡمَ","ٱلۡقِيَٰمَةِ","وَمِنۡ","أَوۡزَارِ","ٱلَّذِينَ","يُضِلُّونَهُم","بِغَيۡرِ","عِلۡمٍۗ","أَلَا","سَآءَ","مَا","يَزِرُونَ"],"лийахмилуу аузарахум камилатан йаумал ḳийамати вамин аузарил лазиина йудиллуунахум бигайри `илмин ала саа ма йазируун","Пусть они понесут свою ношу целиком в Последний день, а также ношу тех невежд, которых они ввели в заблуждение. Как же отвратительна их ноша!",["чтобы они понесли","свои ноши","полностью","в День","воскресения","и из","нош","тех, которых","они сбивают с пути","без","знания","о да!","скверно","то, что","они несут"]],[16,26,["قَدۡ","مَكَرَ","ٱلَّذِينَ","مِن","قَبۡلِهِمۡ","فَأَتَى","ٱللَّهُ","بُنۡيَٰنَهُم","مِّنَ","ٱلۡقَوَاعِدِ","فَخَرَّ","عَلَيۡهِمُ","ٱلسَّقۡفُ","مِن","فَوۡقِهِمۡ","وَأَتَىٰهُمُ","ٱلۡعَذَابُ","مِنۡ","حَيۡثُ","لَا","يَشۡعُرُونَ"],"ḳад макарал лазиина мин ḳаблихим фа'аталлаху бунйанахум минал ḳава`иди фахарра `алайхимус саḳфу мин фауḳихим ва'атахумул `азабу мин хайсу ла йаш`уруун","Козни строили еще те, которые жили до них, но Аллах разрушил основание их строения. Крыша обрушилась на них сверху, и мучения постигли их оттуда, откуда они их не ожидали.",["уже","строили козни","те, которые","(из)","до них","и пришёл","Аллах","к их строению","от","оснований","и обрушилась","на них","крыша","сверху","над ними","и пришло к ним","наказание","оттуда","откуда","не","они чувствовали"]]],"m":[[["وَأَلۡقَىٰ","и Он воздвиг",16,15],["فِي","на",16,15],["ٱلۡأَرۡضِ","земле",16,15],["رَوَٰسِيَ","прочные горы",16,15],["أَن","чтобы не",16,15],["تَمِيدَ","колебалась она",16,15],["بِكُمۡ","с вами",16,15],["وَأَنۡهَٰرٗا","и реки",16,15],["وَسُبُلٗا","и дороги",16,15]],[["لَّعَلَّكُمۡ","чтобы вы",16,15],["تَهۡتَدُونَ","шли прямым путём",16,15],[15],["وَعَلَٰمَٰتٖۚ","и знаки",16,16],["وَبِٱلنَّجۡمِ","и по звезде",16,16],["هُمۡ","они",16,16],["يَهۡتَدُونَ","находят путь",16,16]],[[16],["أَفَمَن","разве же Тот, Кто",16,17],["يَخۡلُقُ","творит",16,17],["كَمَن","как тот, кто",16,17],["لَّا","не",16,17],["يَخۡلُقُۚ","творит",16,17],["أَفَلَا","разве же не",16,17],["تَذَكَّرُونَ","опомнитесь вы",16,17],[17],["وَإِن","и если",16,18]],[["تَعُدُّواْ","вы станете считать",16,18],["نِعۡمَةَ","милость",16,18],["ٱللَّهِ","Аллаха",16,18],["لَا","не",16,18],["تُحۡصُوهَآۗ","исчислите её",16,18],["إِنَّ","поистине",16,18],["ٱللَّهَ","Аллах",16,18],["لَغَفُورٞ","непременно Прощающий",16,18],["رَّحِيمٞ","Милосердный",16,18],[18]],[["وَٱللَّهُ","и Аллах",16,19],["يَعۡلَمُ","знает",16,19],["مَا","то, что",16,19],["تُسِرُّونَ","вы скрываете",16,19],["وَمَا","и то, что",16,19],["تُعۡلِنُونَ","вы обнаруживаете",16,19],[19],["وَٱلَّذِينَ","и те, которых",16,20],["يَدۡعُونَ","они призывают",16,20]],[["مِن","(из)",16,20],["دُونِ","помимо",16,20],["ٱللَّهِ","Аллаха",16,20],["لَا","не",16,20],["يَخۡلُقُونَ","творят",16,20],["شَيۡـٔٗا","ничего",16,20],["وَهُمۡ","а они сами",16,20],["يُخۡلَقُونَ","сотворены",16,20],[20],["أَمۡوَٰتٌ","мёртвые",16,21],["غَيۡرُ","не",16,21]],[["أَحۡيَآءٖۖ","живые",16,21],["وَمَا","и не",16,21],["يَشۡعُرُونَ","осознают они",16,21],["أَيَّانَ","когда",16,21],["يُبۡعَثُونَ","они будут воскрешены",16,21],[21],["إِلَٰهُكُمۡ","ваш Бог",16,22],["إِلَٰهٞ","Бог",16,22],["وَٰحِدٞۚ","Единый",16,22]],[["فَٱلَّذِينَ","а те, которые",16,22],["لَا","не",16,22],["يُؤۡمِنُونَ","веруют",16,22],["بِٱلۡأٓخِرَةِ","в Последнюю жизнь",16,22],["قُلُوبُهُم","их сердца",16,22],["مُّنكِرَةٞ","отрицают",16,22],["وَهُم","и они",16,22],["مُّسۡتَكۡبِرُونَ","высокомерны",16,22]],[[22],["لَا","нет",16,23],["جَرَمَ","сомнения",16,23],["أَنَّ","что",16,23],["ٱللَّهَ","Аллах",16,23],["يَعۡلَمُ","знает",16,23],["مَا","то, что",16,23],["يُسِرُّونَ","они скрывают",16,23],["وَمَا","и то, что",16,23],["يُعۡلِنُونَۚ","они обнаруживают",16,23],["إِنَّهُۥ","поистине, Он",16,23]],[["لَا","не",16,23],["يُحِبُّ","любит",16,23],["ٱلۡمُسۡتَكۡبِرِينَ","высокомерных",16,23],[23],["وَإِذَا","и когда",16,24],["قِيلَ","сказано",16,24],["لَهُم","им",16,24],["مَّاذَآ","что",16,24],["أَنزَلَ","ниспослал",16,24],["رَبُّكُمۡ","ваш Господь",16,24]],[["قَالُوٓاْ","говорят они",16,24],["أَسَٰطِيرُ","сказки",16,24],["ٱلۡأَوَّلِينَ","древних",16,24],[24],["لِيَحۡمِلُوٓاْ","чтобы они понесли",16,25],["أَوۡزَارَهُمۡ","свои ноши",16,25],["كَامِلَةٗ","полностью",16,25]],[["يَوۡمَ","в День",16,25],["ٱلۡقِيَٰمَةِ","воскресения",16,25],["وَمِنۡ","и из",16,25],["أَوۡزَارِ","нош",16,25],["ٱلَّذِينَ","тех, которых",16,25],["يُضِلُّونَهُم","они сбивают с пути",16,25],["بِغَيۡرِ","без",16,25],["عِلۡمٍۗ","знания",16,25],["أَلَا","о да!",16,25]],[["سَآءَ","скверно",16,25],["مَا","то, что",16,25],["يَزِرُونَ","они несут",16,25],[25],["قَدۡ","уже",16,26],["مَكَرَ","строили козни",16,26],["ٱلَّذِينَ","те, которые",16,26],["مِن","(из)",16,26],["قَبۡلِهِمۡ","до них",16,26]],[["فَأَتَى","и пришёл",16,26],["ٱللَّهُ","Аллах",16,26],["بُنۡيَٰنَهُم","к их строению",16,26],["مِّنَ","от",16,26],["ٱلۡقَوَاعِدِ","оснований",16,26],["فَخَرَّ","и обрушилась",16,26],["عَلَيۡهِمُ","на них",16,26],["ٱلسَّقۡفُ","крыша",16,26]],[["مِن","сверху",16,26],["فَوۡقِهِمۡ","над ними",16,26],["وَأَتَىٰهُمُ","и пришло к ним",16,26],["ٱلۡعَذَابُ","наказание",16,26],["مِنۡ","оттуда",16,26],["حَيۡثُ","откуда",16,26],["لَا","не",16,26],["يَشۡعُرُونَ","они чувствовали",16,26],[26]]]}