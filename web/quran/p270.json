{"p":270,"j":14,"a":[[16,27,["ثُمَّ","يَوۡمَ","ٱلۡقِيَٰمَةِ","يُخۡزِيهِمۡ","وَيَقُولُ","أَيۡنَ","شُرَكَآءِيَ","ٱلَّذِينَ","كُنتُمۡ","تُشَٰٓقُّونَ","فِيهِمۡۚ","قَالَ","ٱلَّذِينَ","أُوتُواْ","ٱلۡعِلۡمَ","إِنَّ","ٱلۡخِزۡيَ","ٱلۡيَوۡمَ","وَٱلسُّوٓءَ","عَلَى","ٱلۡكَٰفِرِينَ"],"сумма йаумал ḳийамати йухзиихим вайаḳуулу айна шуракаийал лазиина кунтум тушаḳḳууна фиихим ḳалал лазиина уутул `илма иннал хизйал йаума вассууа `алал кафириин","А потом, в День воскресения, Он опозорит их и скажет: «Где же Мои сотоварищи, о которых вы спорили?». Те, которым было даровано знание, скажут: «Воистину, сегодня неверующих постигнут позор и зло».",["затем","в День","воскресения","Он опозорит их","и скажет","где","Мои сотоварищи","те, которые","вы","враждовали","из-за них","скажут","те, которым","было дано","знание","поистине","позор","сегодня","и зло","на","неверующих"]],[16,28,["ٱلَّذِينَ","تَتَوَفَّىٰهُمُ","ٱلۡمَلَٰٓئِكَةُ","ظَالِمِيٓ","أَنفُسِهِمۡۖ","فَأَلۡقَوُاْ","ٱلسَّلَمَ","مَا","كُنَّا","نَعۡمَلُ","مِن","سُوٓءِۭۚ","بَلَىٰٓۚ","إِنَّ","ٱللَّهَ","عَلِيمُۢ","بِمَا","كُنتُمۡ","تَعۡمَلُونَ"],"аллазиина татаваффахумул малаикату залимии анфусихим фа'алḳавус салама ма кунна на`малу мин сууи бала инналлаха `алииму бима кунтум та`малуун","Те, кого ангелы умертвили, когда они грешили во вред себе, изъявят покорность и скажут: «Мы не совершили никакого зла». Им ответят: «О нет! Воистину, Аллаху известно о том, что вы совершали.",["те, которых","умерщвляют","ангелы","несправедливыми к","самим себе","и изъявили они","покорность","не","мы","делали","никакого","зла","напротив","поистине","Аллах","знает","о том, что","вы","делали"]],[16,29,["فَٱدۡخُلُوٓاْ","أَبۡوَٰبَ","جَهَنَّمَ","خَٰلِدِينَ","فِيهَاۖ","فَلَبِئۡسَ","مَثۡوَى","ٱلۡمُتَكَبِّرِينَ"],"фадхулуу абваба жаханнама халидиина фииха фалаби'са масвал мутакаббириин","Войдите во врата Геенны и пребудьте там вечно. Как же скверна обитель возгордившихся!».",["входите же","во врата","Геенны","вечно пребывая","в ней","и как скверна","обитель","высокомерных"]],[16,30,["وَقِيلَ","لِلَّذِينَ","ٱتَّقَوۡاْ","مَاذَآ","أَنزَلَ","رَبُّكُمۡۚ","قَالُواْ","خَيۡرٗاۗ","لِّلَّذِينَ","أَحۡسَنُواْ","فِي","هَٰذِهِ","ٱلدُّنۡيَا","حَسَنَةٞۚ","وَلَدَارُ","ٱلۡأٓخِرَةِ","خَيۡرٞۚ","وَلَنِعۡمَ","دَارُ","ٱلۡمُتَّقِينَ"],"ваḳиила лиллазиинаттаḳау маза анзала раббукум ḳалуу хайрал лиллазиина ахсануу фии хазихид дунйа хасанатун валадарул ахирати хайрун валани`ма дарул муттаḳиин","Когда богобоязненных спрашивают: «Что ниспослал вам Господь?». - они говорят: «Благо». Тем, кто творил в этом мире добро, будет воздано добром. А Последняя обитель будет еще лучше. Как же прекрасна Обитель богобоязненных!",["и сказано","тем, которые","были богобоязненны","что","ниспослал","ваш Господь","они сказали","благо","тем, которые","творили добро","в","этом","мире","благо","и непременно обитель","Последней жизни","лучше","и как прекрасна","обитель","богобоязненных"]],[16,31,["جَنَّٰتُ","عَدۡنٖ","يَدۡخُلُونَهَا","تَجۡرِي","مِن","تَحۡتِهَا","ٱلۡأَنۡهَٰرُۖ","لَهُمۡ","فِيهَا","مَا","يَشَآءُونَۚ","كَذَٰلِكَ","يَجۡزِي","ٱللَّهُ","ٱلۡمُتَّقِينَ"],"жаннату `аднин йадхулуунаха тажрии мин тахтихал анхару лахум фииха ма йашаууна казалика йажзиллахул муттаḳиин","Они войдут в сады Эдема, в которых текут реки. Они получат там все, чего пожелают. Так Аллах воздает богобоязненным,",["сады","Эдема","они войдут в них","текут","(из)","под ними","реки","для них","там","то, что","они пожелают","так","воздаёт","Аллах","богобоязненным"]],[16,32,["ٱلَّذِينَ","تَتَوَفَّىٰهُمُ","ٱلۡمَلَٰٓئِكَةُ","طَيِّبِينَ","يَقُولُونَ","سَلَٰمٌ","عَلَيۡكُمُ","ٱدۡخُلُواْ","ٱلۡجَنَّةَ","بِمَا","كُنتُمۡ","تَعۡمَلُونَ"],"аллазиина татаваффахумул малаикату таййибиина йаḳуулууна саламун `алайкумудхулул жанната бима кунтум та`малуун","которых ангелы умерщвляют праведниками. Они говорят: «Мир вам! Войдите в Рай благодаря тому, что вы совершали».",["те, которых","умерщвляют","ангелы","чистыми","говоря","мир","вам","входите","в Рай","за то, что","вы","делали"]],[16,33,["هَلۡ","يَنظُرُونَ","إِلَّآ","أَن","تَأۡتِيَهُمُ","ٱلۡمَلَٰٓئِكَةُ","أَوۡ","يَأۡتِيَ","أَمۡرُ","رَبِّكَۚ","كَذَٰلِكَ","فَعَلَ","ٱلَّذِينَ","مِن","قَبۡلِهِمۡۚ","وَمَا","ظَلَمَهُمُ","ٱللَّهُ","وَلَٰكِن","كَانُوٓاْ","أَنفُسَهُمۡ","يَظۡلِمُونَ"],"хал йанзурууна илла ан та'тийахумул малаикату ау йа'тийа амру раббика казалика фа`алал лазиина мин ḳаблихим вама заламахумуллаху валакин кануу анфусахум йазлимуун","Неужели они ждут чего-либо иного, кроме ангелов или веления твоего Господа? Так же поступали те, которые жили прежде. Аллах не был несправедлив к ним - они сами поступали несправедливо по отношению к себе.",["разве","ждут они","чего-либо, кроме","того, что","придут к ним","ангелы","или","придёт","веление","твоего Господа","так","поступали","те, которые","(из)","до них","и не","обидел их","Аллах","но","были они","к самим себе","несправедливы"]],[16,34,["فَأَصَابَهُمۡ","سَيِّـَٔاتُ","مَا","عَمِلُواْ","وَحَاقَ","بِهِم","مَّا","كَانُواْ","بِهِۦ","يَسۡتَهۡزِءُونَ"],"фа'асабахум саййиату ма `амилуу вахаḳа бихим ма кануу бихии йастахзиуун","Злое возмездие постигло их за то, что они творили, и окружило (или поразило) их то, над чем они издевались.",["и постигли их","злые последствия","того, что","они делали","и окружило","их","то, что","они","над ним","насмехались"]]],"m":[[["ثُمَّ","затем",16,27],["يَوۡمَ","в День",16,27],["ٱلۡقِيَٰمَةِ","воскресения",16,27],["يُخۡزِيهِمۡ","Он опозорит их",16,27],["وَيَقُولُ","и скажет",16,27],["أَيۡنَ","где",16,27],["شُرَكَآءِيَ","Мои сотоварищи",16,27],["ٱلَّذِينَ","те, которые",16,27]],[["كُنتُمۡ","вы",16,27],["تُشَٰٓقُّونَ","враждовали",16,27],["فِيهِمۡۚ","из-за них",16,27],["قَالَ","скажут",16,27],["ٱلَّذِينَ","те, которым",16,27],["أُوتُواْ","было дано",16,27],["ٱلۡعِلۡمَ","знание",16,27],["إِنَّ","поистине",16,27],["ٱلۡخِزۡيَ","позор",16,27]],[["ٱلۡيَوۡمَ","сегодня",16,27],["وَٱلسُّوٓءَ","и зло",16,27],["عَلَى","на",16,27],["ٱلۡكَٰفِرِينَ","неверующих",16,27],[27],["ٱلَّذِينَ","те, которых",16,28],["تَتَوَفَّىٰهُمُ","умерщвляют",16,28],["ٱلۡمَلَٰٓئِكَةُ","ангелы",1