{"p":271,"j":14,"a":[[16,35,["وَقَالَ","ٱلَّذِينَ","أَشۡرَكُواْ","لَوۡ","شَآءَ","ٱللَّهُ","مَا","عَبَدۡنَا","مِن","دُونِهِۦ","مِن","شَيۡءٖ","نَّحۡنُ","وَلَآ","ءَابَآؤُنَا","وَلَا","حَرَّمۡنَا","مِن","دُونِهِۦ","مِن","شَيۡءٖۚ","كَذَٰلِكَ","فَعَلَ","ٱلَّذِينَ","مِن","قَبۡلِهِمۡۚ","فَهَلۡ","عَلَى","ٱلرُّسُلِ","إِلَّا","ٱلۡبَلَٰغُ","ٱلۡمُبِينُ"],"ваḳалал лазиина ашракуу лау шааллаху ма `абадна мин дуунихии мин шай'ин нахну вала абауна вала харрамна мин дуунихии мин шай'ин казалика фа`алал лазиина мин ḳаблихим фахал `алар русули иллал балагул мубиин","Многобожники говорят: «Если бы Аллах захотел, то ни мы, ни наши отцы не стали бы поклоняться ничему, кроме Него, и мы не стали бы запрещать чтолибо вопреки Ему». Так же поступали те, которые жили прежде. Разве на посланников было возложено что-либо, кроме ясной передачи откровения?",["и сказали","те, которые","придавали сотоварищей","если бы","пожелал","Аллах","не","поклонялись бы мы","(из)","помимо Него","ни","чему-либо","мы","и не","наши отцы","и не","запрещали бы мы","(из)","помимо Него","ни","чего-либо","так","поступали","те, которые","(из)","до них","разве же","на","посланниках","кроме","передачи","ясной"]],[16,36,["وَلَقَدۡ","بَعَثۡنَا","فِي","كُلِّ","أُمَّةٖ","رَّسُولًا","أَنِ","ٱعۡبُدُواْ","ٱللَّهَ","وَٱجۡتَنِبُواْ","ٱلطَّٰغُوتَۖ","فَمِنۡهُم","مَّنۡ","هَدَى","ٱللَّهُ","وَمِنۡهُم","مَّنۡ","حَقَّتۡ","عَلَيۡهِ","ٱلضَّلَٰلَةُۚ","فَسِيرُواْ","فِي","ٱلۡأَرۡضِ","فَٱنظُرُواْ","كَيۡفَ","كَانَ","عَٰقِبَةُ","ٱلۡمُكَذِّبِينَ"],"валаḳад ба`асна фии кулли умматир расуулан ани`будуллаха важтанибут тагуута фаминхум ман хадаллаху ваминхум ман хаḳḳат `алайхид далалату фасиируу фил арди фанзуруу кайфа кана `аḳибатул муказзибиин","Мы отправили к каждой общине посланника: «Поклоняйтесь Аллаху и избегайте тагута!». Среди них есть такие, которых Аллах наставил на прямой путь, и такие, которым было справедливо предначертано заблуждение. Ступайте же по земле и посмотрите, каким был конец неверующих.",["и уже","Мы отправили","в","каждую","общину","посланника","чтобы","поклоняйтесь","Аллаху","и сторонитесь","тагута","и среди них","кого","наставил","Аллах","и среди них","кого","заслуженно постигло","его","заблуждение","так ходите","по","земле","и посмотрите","каким","был","конец","отвергавших"]],[16,37,["إِن","تَحۡرِصۡ","عَلَىٰ","هُدَىٰهُمۡ","فَإِنَّ","ٱللَّهَ","لَا","يَهۡدِي","مَن","يُضِلُّۖ","وَمَا","لَهُم","مِّن","نَّٰصِرِينَ"],"ин тахрис `ала худахум фа'инналлаха ла йахдии ман йудиллу вама лахум мин насириин","Как бы ты ни хотел наставить их на прямой путь, Аллах не наставляет на прямой путь тех, кого Он вводит в заблуждение, и не будет у них помощников.",["если","ты стремишься","к","их наставлению","то поистине","Аллах","не","наставляет","того, кого","Он вводит в заблуждение","и нет","у них","никаких","помощников"]],[16,38,["وَأَقۡسَمُواْ","بِٱللَّهِ","جَهۡدَ","أَيۡمَٰنِهِمۡ","لَا","يَبۡعَثُ","ٱللَّهُ","مَن","يَمُوتُۚ","بَلَىٰ","وَعۡدًا","عَلَيۡهِ","حَقّٗا","وَلَٰكِنَّ","أَكۡثَرَ","ٱلنَّاسِ","لَا","يَعۡلَمُونَ"],"ва'аḳсамуу биллахи жахда айманихим ла йаб`асуллаху ман йамууту бала ва`дан `алайхи хаḳḳан валакинна аксаран наси ла йа`ламуун","Именем Аллаха они принесли величайшие клятвы о том, что Аллах не воскресит мертвецов. О нет! Это произойдет согласно истинному обещанию, но большинство людей не знает этого.",["и они клялись","Аллахом","сильнейшими","своими клятвами","не","воскресит","Аллах","того, кто","умирает","напротив","обещание","на Нём","истинное","но","большинство","людей","не","знают"]],[16,39,["لِيُبَيِّنَ","لَهُمُ","ٱلَّذِي","يَخۡتَلِفُونَ","فِيهِ","وَلِيَعۡلَمَ","ٱلَّذِينَ","كَفَرُوٓاْ","أَنَّهُمۡ","كَانُواْ","كَٰذِبِينَ"],"лийубаййина лахумул лазии йахталифууна фиихи валийа`ламал лазиина кафаруу аннахум кануу казибиин","Он разъяснит им то, в чем они расходились во мнениях, и неверующие узнают, что они были лжецами.",["чтобы Он разъяснил","им","то, что","они расходятся","в чём","и чтобы узнали","те, которые","не уверовали","что они","были","лжецами"]],[16,40,["إِنَّمَا","قَوۡلُنَا","لِشَيۡءٍ","إِذَآ","أَرَدۡنَٰهُ","أَن","نَّقُولَ","لَهُۥ","كُن","فَيَكُونُ"],"иннама ḳаулуна лишай'ин иза араднаху ан наḳуула лахуу кун файакуун","Когда Мы хотим чего-либо, то стоит Нам сказать: «Будь!». - как это сбывается.",["лишь","Наше слово","вещи","когда","Мы пожелали её","что","Мы говорим","ей","будь","и она бывает"]],[16,41,["وَٱلَّذِينَ","هَاجَرُواْ","فِي","ٱللَّهِ","مِنۢ","بَعۡدِ","مَا","ظُلِمُواْ","لَنُبَوِّئَنَّهُمۡ","فِي","ٱلدُّنۡيَا","حَسَنَةٗۖ","وَلَأَجۡرُ","ٱلۡأٓخِرَةِ","أَكۡبَرُۚ","لَوۡ","كَانُواْ","يَعۡلَمُونَ"],"валлазиина хажаруу филлахи мим ба`ди ма зулимуу ланубаввианнахум фид дунйа хасанатан валаажрул ахирати акбару лау кануу йа`ламуун","Тех, которые переселились ради Аллаха после того, как подверглись притеснениям, Мы одарим прекрасным жилищем в этом мире, а вознаграждение в Последней жизни будет еще больше. Если бы они только знали!",["и те, которые","переселились","ради","Аллаха","(из)","после","того, как","их притесняли","непременно Мы поселим их","в","этом мире","хорошо","но непременно награда","Последней жизни","больше","если бы","они","знали"]],[16,42,["ٱلَّذِينَ","صَبَرُواْ","وَعَلَىٰ","رَبِّهِمۡ","يَتَوَكَّلُونَ"],"аллазиина сабаруу ва`ала раббихим йатаваккалуун","Это - те, которые проявляют терпение и уповают только на своего Господа.",["те, которые","проявили терпение","и на","своего Господа","уповают"]]],"m":[[["وَقَالَ","и сказали",16,35],["ٱلَّذِينَ","те, которые",16,35],["أَشۡرَكُواْ","придавали сотоварищей",16,35],["لَوۡ","если бы",16,35],["شَآءَ","пожелал",16,35],["ٱللَّهُ","Аллах",16,35],["مَا","не",16,35],["عَبَدۡنَا","поклонялись бы мы",16,35],["مِن","(из)",16,35],["دُونِهِۦ","помимо Него",16,35],["مِن","ни",16,35]],[["شَيۡءٖ","чему-либо",16,35],["نَّحۡنُ","мы",16,35],["وَلَآ","и не",16,35],["ءَابَآؤُنَا","наши отцы",16,35],["وَلَا","и не",16,35],["حَرَّمۡنَا","запрещали бы мы",16,35],["مِن","(из)",16,35],["دُونِهِۦ","помимо Него",16,35],["مِن","ни",16,35],["شَيۡءٖۚ","чего-либо",16,35],["كَذَٰلِكَ","так",16,35]],[["فَعَل