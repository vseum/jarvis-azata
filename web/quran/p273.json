{"p":273,"j":14,"a":[[16,55,["لِيَكۡفُرُواْ","بِمَآ","ءَاتَيۡنَٰهُمۡۚ","فَتَمَتَّعُواْ","فَسَوۡفَ","تَعۡلَمُونَ"],"лийакфуруу бима атайнахум фатаматта`уу фасауфа та`ламуун","чтобы не уверовать в то, что Мы даровали им. Пользуйтесь благами, и скоро вы узнаете.",["чтобы отвергнуть","то, что","Мы даровали им","Так наслаждайтесь же","и скоро","узнаете вы"]],[16,56,["وَيَجۡعَلُونَ","لِمَا","لَا","يَعۡلَمُونَ","نَصِيبٗا","مِّمَّا","رَزَقۡنَٰهُمۡۗ","تَٱللَّهِ","لَتُسۡـَٔلُنَّ","عَمَّا","كُنتُمۡ","تَفۡتَرُونَ"],"вайаж`алууна лима ла йа`ламууна насиибам мимма разаḳнахум таллахи латус'алунна `амма кунтум тафтаруун","Они отдают долю из того, чем Мы их наделили, ради того, что им неизвестно. Клянусь Аллахом, вы будете спрошены обо всем, что измышляете!",["И отводят они","тому, что","не","знают они","долю","из того, чем","Мы наделили их","Клянусь Аллахом","непременно вы будете спрошены","о том, что","вы (прежде)","измышляли"]],[16,57,["وَيَجۡعَلُونَ","لِلَّهِ","ٱلۡبَنَٰتِ","سُبۡحَٰنَهُۥ","وَلَهُم","مَّا","يَشۡتَهُونَ"],"вайаж`алууна лиллахил банати субханахуу валахум ма йаштахуун","Они приписывают Аллаху дочерей. Пречист Он! Себе же они оставляют тех, кого хотят.",["И приписывают они","Аллаху","дочерей","Пречист Он","а себе","то, что","желают они"]],[16,58,["وَإِذَا","بُشِّرَ","أَحَدُهُم","بِٱلۡأُنثَىٰ","ظَلَّ","وَجۡهُهُۥ","مُسۡوَدّٗا","وَهُوَ","كَظِيمٞ"],"ва'иза бушшира ахадухум бил'унса залла важхухуу мусваддан вахуа казиим","Когда кому-либо из них сообщают весть о девочке, лицо его чернеет, и он сдерживает свой гнев.",["И когда","обрадуют вестью","одного из них","о девочке","становится","лицо его","почерневшим","и он","сдерживает скорбь"]],[16,59,["يَتَوَٰرَىٰ","مِنَ","ٱلۡقَوۡمِ","مِن","سُوٓءِ","مَا","بُشِّرَ","بِهِۦٓۚ","أَيُمۡسِكُهُۥ","عَلَىٰ","هُونٍ","أَمۡ","يَدُسُّهُۥ","فِي","ٱلتُّرَابِۗ","أَلَا","سَآءَ","مَا","يَحۡكُمُونَ"],"йатавара минал ḳауми мин сууи ма бушшира бихии айумсикухуу `ала хуунин ам йадуссухуу фит тураби ала саа ма йахкумуун","Он прячется от людей из-за дурной вести. Оставит ли он себе ребенка с позором или же закопает ее в землю? Воистину, скверны их решения!",["Прячется он","от","людей","из-за","скверны","того, что","ему возвещено","о нём","Удержит ли он его","при","унижении","или","зароет его","в","прах","Знайте же","скверно","то, что","решают они"]],[16,60,["لِلَّذِينَ","لَا","يُؤۡمِنُونَ","بِٱلۡأٓخِرَةِ","مَثَلُ","ٱلسَّوۡءِۖ","وَلِلَّهِ","ٱلۡمَثَلُ","ٱلۡأَعۡلَىٰۚ","وَهُوَ","ٱلۡعَزِيزُ","ٱلۡحَكِيمُ"],"лиллазиина ла йу'минууна бил'ахирати масалус сауи валиллахил масалул а`ла вахуал `азиизул хакиим","Скверно описание тех, кто не верует в Последнюю жизнь, а описание Аллаха - самое возвышенное, ведь Он - Могущественный, Мудрый.",["У тех, которые","не","веруют","в Последнюю жизнь","описание","скверное","а у Аллаха","описание","высочайшее","и Он","Могущественный","Мудрый"]],[16,61,["وَلَوۡ","يُؤَاخِذُ","ٱللَّهُ","ٱلنَّاسَ","بِظُلۡمِهِم","مَّا","تَرَكَ","عَلَيۡهَا","مِن","دَآبَّةٖ","وَلَٰكِن","يُؤَخِّرُهُمۡ","إِلَىٰٓ","أَجَلٖ","مُّسَمّٗىۖ","فَإِذَا","جَآءَ","أَجَلُهُمۡ","لَا","يَسۡتَـٔۡخِرُونَ","سَاعَةٗ","وَلَا","يَسۡتَقۡدِمُونَ"],"валау йу'ахизуллахун наса бизулмихим ма тарака `алайха мин даббатин валакин йу'аххирухум ила ажалим мусамман фа'иза жаа ажалухум ла йаста'хирууна са`атан вала йастаḳдимуун","Если бы Аллах стал наказывать людей за их несправедливость, то не оставил бы на земле ни одного живого существа. Однако Он предоставляет им отсрочку до назначенного срока. Когда же наступит их срок, они не смогут отдалить или приблизить его даже на час.",["И если бы","наказывал","Аллах","людей","за их несправедливость","не","оставил бы Он","на ней","ни одного","живого существа","но","Он отсрочивает им","до","срока","назначенного","А когда","придёт","их срок","не","отсрочат они","на час","и не","ускорят они"]],[16,62,["وَيَجۡعَلُونَ","لِلَّهِ","مَا","يَكۡرَهُونَۚ","وَتَصِفُ","أَلۡسِنَتُهُمُ","ٱلۡكَذِبَ","أَنَّ","لَهُمُ","ٱلۡحُسۡنَىٰۚ","لَا","جَرَمَ","أَنَّ","لَهُمُ","ٱلنَّارَ","وَأَنَّهُم","مُّفۡرَطُونَ"],"вайаж`алууна лиллахи ма йакрахууна ватасифу алсинатухумул казиба анна лахумул хусна ла жарама анна лахумун нара ва'аннахум муфратуун","Они приписывают Аллаху то, что им самим неприятно. Их языки лживо возвещают о том, что им уготовано наилучшее. Несомненно, им уготован Огонь, и они будут покинуты.",["И приписывают они","Аллаху","то, что","ненавидят они","и описывают","их языки","ложь","что","им","наилучшее","Нет","сомнения","что","им","Огонь","и что они","будут покинуты"]],[16,63,["تَٱللَّهِ","لَقَدۡ","أَرۡسَلۡنَآ","إِلَىٰٓ","أُمَمٖ","مِّن","قَبۡلِكَ","فَزَيَّنَ","لَهُمُ","ٱلشَّيۡطَٰنُ","أَعۡمَٰلَهُمۡ","فَهُوَ","وَلِيُّهُمُ","ٱلۡيَوۡمَ","وَلَهُمۡ","عَذَابٌ","أَلِيمٞ"],"таллахи лаḳад арсална ила умамим мин ḳаблика фазаййана лахумуш шайтану а`малахум фахуа валиййухумул йаума валахум `азабун алиим","Клянусь Аллахом, Мы до тебя направляли посланников к народам, но дьявол приукрасил для них их деяния. Сегодня он является их покровителем и помощником, и им уготованы мучительные страдания.",["Клянусь Аллахом","уже","Мы отправили","к","общинам","ещё","до тебя","но разукрасил","им","шайтан","их деяния","и он","их покровитель","сегодня","и им","наказание","мучительное"]],[16,64,["وَمَآ","أَنزَلۡنَا","عَلَيۡكَ","ٱلۡكِتَٰبَ","إِلَّا","لِتُبَيِّنَ","لَهُمُ","ٱلَّذِي","ٱخۡتَلَفُواْ","فِيهِ","وَهُدٗى","وَرَحۡمَةٗ","لِّقَوۡمٖ","يُؤۡمِنُونَ"],"вама анзална `алайкал китаба илла литубаййина лахумул лазихталафуу фиихи вахудан варахматал лиḳаумин йу'минуун","Мы ниспослали тебе Писание, дабы ты разъяснил им то, в чем они разошлись во мнениях, а также как руководство к прямому пути и милость для верующих людей.",["И не","ниспослали Мы","тебе","Писание","кроме как","чтобы ты разъяснил","им","то, в чём","разошлись они","в этом","и руководством","и милостью","для людей","которые веруют"]]],"m":[[["لِيَكۡفُرُواْ","чтобы отвергнуть",16,55],["بِمَآ","то, что",16,55],["ءَاتَيۡنَٰهُمۡۚ","Мы даровали им",16,55],["فَتَمَتَّعُواْ","Так наслаждайтесь же",16,55],["فَسَوۡفَ","и скоро",16,55],["تَعۡلَمُونَ","узнаете вы",16,55],[55],["وَيَجۡعَلُونَ","И отводят они",16,56]],[["لِمَا","тому, что",16,56],["لَا","не",16,56],["يَعۡلَمُونَ","знают они",16,56],["نَصِيبٗا","долю",16,56],["مِّمَّا","из того, чем",16,56],["رَزَقۡنَٰهُمۡۗ","Мы наделили их",16,56],["تَٱللَّهِ","Клянусь Аллахом",16,56],["لَتُسۡـَٔلُنَّ","непременно вы будете спрошены",16,56],["عَمَّا","о том, что",16,56],["كُنتُمۡ","вы (прежде)",16,56]],[["تَفۡتَرُونَ","измышляли",16,56],[56],["وَيَجۡعَلُونَ","И приписывают они",16,57],["لِلَّهِ","Аллаху",16,57],["ٱلۡبَنَٰتِ","дочерей",16,57],["سُبۡحَٰنَهُۥ","Пречист Он",16,57],["وَلَهُم","а себе",16,57],["مَّا","то, что",16,57],["يَشۡتَهُونَ","желают они",16,57]],[[57],["وَإِذَا","И когда",16,58],["بُشِّرَ","обрадуют вестью",16,58],["أَحَدُهُم","одного из них",16,58],["بِٱلۡأُنثَىٰ","о девочке",16,58],["ظَلَّ","становится",16,58],["وَجۡهُهُۥ","лицо его",16,58],["مُسۡوَدّٗا","почерневшим",16,58],["وَهُوَ","и он",16,58],["كَظِيمٞ","сдерживает скорбь",16,58]],[[58],["يَتَوَٰرَىٰ","Прячется он",16,59],["مِنَ","от",16,59],["ٱلۡقَوۡمِ","людей",16,59],["مِن","из-за",16,59],["سُوٓءِ","скверны",16,59],["مَا","того, что",16,59],["بُشِّرَ","ему возвещено",16,59],["بِهِۦٓۚ","о нём",16,59],["أَيُمۡسِكُهُۥ","Удержит ли он его",16,59],["عَلَىٰ","при",16,59],["هُونٍ","унижении",16,59]],[["أَمۡ","или",16,59],["يَدُسُّهُۥ","зароет его",16,59],["فِي","в",16,59],["ٱلتُّرَابِۗ","прах",16,59],["أَلَا","Знайте же",16,59],["سَآءَ","скверно",16,59],["مَا","то, что",16,59],["يَحۡكُمُونَ","решают они",16,59],[59],["لِلَّذِينَ","У тех, которые",16,60],["لَا","не",16,60],["يُؤۡمِنُونَ","веруют",16,60]],[["بِٱلۡأٓخِرَةِ","в Последнюю жизнь",16,60],["مَثَلُ","описание",16,60],["ٱلسَّوۡءِۖ","скверное",16,60],["وَلِلَّهِ","а у Аллаха",16,60],["ٱلۡمَثَلُ","описание",16,60],["ٱلۡأَعۡلَىٰۚ","высочайшее",16,60],["وَهُوَ","и Он",16,60],["ٱلۡعَزِيزُ","Могущественный",16,60],["ٱلۡحَكِيمُ","Мудрый",16,60]],[[60],["وَلَوۡ","И если бы",16,61],["يُؤَاخِذُ","наказывал",16,61],["ٱللَّهُ","Аллах",16,61],["ٱلنَّاسَ","людей",16,61],["بِظُلۡمِهِم","за их несправедливость",16,61],["مَّا","не",16,61],["تَرَكَ","оставил бы Он",16,61],["عَلَيۡهَا","на ней",16,61],["مِن","ни одного",16,61],["دَآبَّةٖ","живого существа",16,61],["وَلَٰكِن","но",16,61]],[["يُؤَخِّرُهُمۡ","Он отсрочивает им",16,61],["إِلَىٰٓ","до",16,61],["أَجَلٖ","срока",16,61],["مُّسَمّٗىۖ","назначенного",16,61],["فَإِذَا","А когда",16,61],["جَآءَ","придёт",16,61],["أَجَلُهُمۡ","их срок",16,61],["لَا","не",16,61],["يَسۡتَـٔۡخِرُونَ","отсрочат они",16,61]],[["سَاعَةٗ","на час",16,61],["وَلَا","и не",16,61],["يَسۡتَقۡدِمُونَ","ускорят они",16,61],[61],["وَيَجۡعَلُونَ","И приписывают они",16,62],["لِلَّهِ","Аллаху",16,62],["مَا","то, что",16,62],["يَكۡرَهُونَۚ","ненавидят они",16,62]],[["وَتَصِفُ","и описывают",16,62],["أَلۡسِنَتُهُمُ","их языки",16,62],["ٱلۡكَذِبَ","ложь",16,62],["أَنَّ","что",16,62],["لَهُمُ","им",16,62],["ٱلۡحُسۡنَىٰۚ","наилучшее",16,62],["لَا","Нет",16,62],["جَرَمَ","сомнения",16,62],["أَنَّ","что",16,62]],[["لَهُمُ","им",16,62],["ٱلنَّارَ","Огонь",16,62],["وَأَنَّهُم","и что они",16,62],["مُّفۡرَطُونَ","будут покинуты",16,62],[62],["تَٱللَّهِ","Клянусь Аллахом",16,63],["لَقَدۡ","уже",16,63],["أَرۡسَلۡنَآ","Мы отправили",16,63],["إِلَىٰٓ","к",16,63],["أُمَمٖ","общинам",16,63],["مِّن","ещё",16,63]],[["قَبۡلِكَ","до тебя",16,63],["فَزَيَّنَ","но разукрасил",16,63],["لَهُمُ","им",16,63],["ٱلشَّيۡطَٰنُ","шайтан",16,63],["أَعۡمَٰلَهُمۡ","их деяния",16,63],["فَهُوَ","и он",16,63],["وَلِيُّهُمُ","их покровитель",16,63],["ٱلۡيَوۡمَ","сегодня",16,63],["وَلَهُمۡ","и им",16,63]],[["عَذَابٌ","наказание",16,63],["أَلِيمٞ","мучительное",16,63],[63],["وَمَآ","И не",16,64],["أَنزَلۡنَا","ниспослали Мы",16,64],["عَلَيۡكَ","тебе",16,64],["ٱلۡكِتَٰبَ","Писание",16,64],["إِلَّا","кроме как",16,64],["لِتُبَيِّنَ","чтобы ты разъяснил",16,64],["لَهُمُ","им",16,64]],[["ٱلَّذِي","то, в чём",16,64],["ٱخۡتَلَفُواْ","разошлись они",16,64],["فِيهِ","в этом",16,64],["وَهُدٗى","и руководством",16,64],["وَرَحۡمَةٗ","и милостью",