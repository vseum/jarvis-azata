{"p":274,"j":14,"a":[[16,65,["وَٱللَّهُ","أَنزَلَ","مِنَ","ٱلسَّمَآءِ","مَآءٗ","فَأَحۡيَا","بِهِ","ٱلۡأَرۡضَ","بَعۡدَ","مَوۡتِهَآۚ","إِنَّ","فِي","ذَٰلِكَ","لَأٓيَةٗ","لِّقَوۡمٖ","يَسۡمَعُونَ"],"валлаху анзала минас самаи маан фа'ахйа бихил арда ба`да маутиха инна фии залика ла'айатал лиḳаумин йасма`уун","Аллах ниспослал с неба воду и оживил ею мертвую землю. Воистину, в этом - знамение для людей внимающих.",["И Аллах","ниспослал","с","неба","воду","и оживил","ею","землю","после","её смерти","Поистине","в","этом","непременно знамение","для людей","которые слышат"]],[16,66,["وَإِنَّ","لَكُمۡ","فِي","ٱلۡأَنۡعَٰمِ","لَعِبۡرَةٗۖ","نُّسۡقِيكُم","مِّمَّا","فِي","بُطُونِهِۦ","مِنۢ","بَيۡنِ","فَرۡثٖ","وَدَمٖ","لَّبَنًا","خَالِصٗا","سَآئِغٗا","لِّلشَّٰرِبِينَ"],"ва'инна лакум фил ан`ами ла`ибратан нусḳиикум мимма фии бутуунихии мим байни фарсин вадамил лабанан халисан саигал лишшарибиин","Воистину, в домашней скотине для вас - назидание. Мы поим вас тем, что образуется в их животах между пометом и кровью, - чистым молоком, приятным для пьющих.",["И поистине","для вас","в","скоте","непременно назидание","Мы поим вас","из того, что","в","их чревах","из","между","содержимым кишок","и кровью","молоком","чистым","приятным","для пьющих"]],[16,67,["وَمِن","ثَمَرَٰتِ","ٱلنَّخِيلِ","وَٱلۡأَعۡنَٰبِ","تَتَّخِذُونَ","مِنۡهُ","سَكَرٗا","وَرِزۡقًا","حَسَنًاۚ","إِنَّ","فِي","ذَٰلِكَ","لَأٓيَةٗ","لِّقَوۡمٖ","يَعۡقِلُونَ"],"вамин самаратин нахиили вал'а`наби таттахизууна минху сакаран варизḳан хасанан инна фии залика ла'айатал лиḳаумин йа`ḳилуун","Из плодов финиковых пальм и виноградников вы получаете опьяняющий напиток и добрый удел. Воистину, в этом - знамение для людей размышляющих.",["И из","плодов","пальм","и виноградных лоз","получаете вы","из них","опьяняющее","и удел","прекрасный","Поистине","в","этом","непременно знамение","для людей","которые разумеют"]],[16,68,["وَأَوۡحَىٰ","رَبُّكَ","إِلَى","ٱلنَّحۡلِ","أَنِ","ٱتَّخِذِي","مِنَ","ٱلۡجِبَالِ","بُيُوتٗا","وَمِنَ","ٱلشَّجَرِ","وَمِمَّا","يَعۡرِشُونَ"],"ва'ауха раббука илан нахли аниттахизии минал жибали буйуутан ваминаш шажари вамимма йа`ришуун","Твой Господь внушил пчеле: «Воздвигай жилища в горах, на деревьях и в строениях.",["И внушил","твой Господь","к","пчеле","что","устраивай","в","горах","жилища","и в","деревьях","и в том, что","сооружают они"]],[16,69,["ثُمَّ","كُلِي","مِن","كُلِّ","ٱلثَّمَرَٰتِ","فَٱسۡلُكِي","سُبُلَ","رَبِّكِ","ذُلُلٗاۚ","يَخۡرُجُ","مِنۢ","بُطُونِهَا","شَرَابٞ","مُّخۡتَلِفٌ","أَلۡوَٰنُهُۥ","فِيهِ","شِفَآءٞ","لِّلنَّاسِۚ","إِنَّ","فِي","ذَٰلِكَ","لَأٓيَةٗ","لِّقَوۡمٖ","يَتَفَكَّرُونَ"],"сумма кулии мин куллис самарати фаслукии субула раббики зулулан йахружу мим бутууниха шарабум мухталифун алванухуу фиихи шифаул линнаси инна фии залика ла'айатал лиḳаумин йатафаккаруун","А потом питайся всевозможными плодами и следуй по путям твоего Господа, которые доступны тебе». Из брюшков пчел исходит питье разных цветов, которое приносит людям исцеление. Воистину, в этом - знамение для людей размышляющих.",["Затем","питайся","из","всех","плодов","и следуй","путями","твоего Господа","облегчёнными","Выходит","из","их чрев","питьё","различны","его цвета","в нём","исцеление","для людей","Поистине","в","этом","непременно знамение","для людей","которые размышляют"]],[16,70,["وَٱللَّهُ","خَلَقَكُمۡ","ثُمَّ","يَتَوَفَّىٰكُمۡۚ","وَمِنكُم","مَّن","يُرَدُّ","إِلَىٰٓ","أَرۡذَلِ","ٱلۡعُمُرِ","لِكَيۡ","لَا","يَعۡلَمَ","بَعۡدَ","عِلۡمٖ","شَيۡـًٔاۚ","إِنَّ","ٱللَّهَ","عَلِيمٞ","قَدِيرٞ"],"валлаху халаḳакум сумма йатаваффакум ваминкум ман йурадду ила арзалил `умури ликай ла йа`лама ба`да `илмин шай'ан инналлаха `алиимун ḳадиир","Аллах сотворил вас, а затем Он умертвит вас. Среди вас есть такие, которые превращаются в дряхлых стариков и забывают все то, что знали. Воистину, Аллах - Знающий, Могущественный.",["И Аллах","сотворил вас","затем","умертвит вас","И среди вас","тот, кто","возвращается","к","наихудшему","возрасту","чтобы","не","знал он","после","знания","ничего","Поистине","Аллах","Знающий","Всемогущий"]],[16,71,["وَٱللَّهُ","فَضَّلَ","بَعۡضَكُمۡ","عَلَىٰ","بَعۡضٖ","فِي","ٱلرِّزۡقِۚ","فَمَا","ٱلَّذِينَ","فُضِّلُواْ","بِرَآدِّي","رِزۡقِهِمۡ","عَلَىٰ","مَا","مَلَكَتۡ","أَيۡمَٰنُهُمۡ","فَهُمۡ","فِيهِ","سَوَآءٌۚ","أَفَبِنِعۡمَةِ","ٱللَّهِ","يَجۡحَدُونَ"],"валлаху фаддала ба`дакум `ала ба`дин фир ризḳи фамал лазиина фуддилуу бираддии ризḳихим `ала ма малакат айманухум фахум фиихи саваун афабини`матиллахи йажхадуун","Аллах возвысил одних из вас над другими посредством богатства и удела. Но те, которым дарован больший удел, не хотят отдавать его своим рабам, чтобы они не уравнялись с ними. Неужели они отвергают милость Аллаха?",["И Аллах","дал превосходство","одним из вас","над","другими","в","уделе","Но не","те, которым","дано превосходство","отдающие","свой удел","тем,","кем","владеют","их десницы","чтобы они","в нём","были равны","Неужели же милость","Аллаха","они отвергают"]],[16,72,["وَٱللَّهُ","جَعَلَ","لَكُم","مِّنۡ","أَنفُسِكُمۡ","أَزۡوَٰجٗا","وَجَعَلَ","لَكُم","مِّنۡ","أَزۡوَٰجِكُم","بَنِينَ","وَحَفَدَةٗ","وَرَزَقَكُم","مِّنَ","ٱلطَّيِّبَٰتِۚ","أَفَبِٱلۡبَٰطِلِ","يُؤۡمِنُونَ","وَبِنِعۡمَتِ","ٱللَّهِ","هُمۡ","يَكۡفُرُونَ"],"валлаху жа`ала лакум мин анфусикум азважан важа`ала лакум мин азважикум баниина вахафадатан варазаḳакум минат таййибати афабилбатили йу'минууна вабини`матиллахи хум йакфуруун","Аллах сделал для вас супруг из вас самих, даровал вам от них детей, внуков и наделил вас благами. Неужели они веруют в ложь и не веруют в милость Аллаха?",["И Аллах","сделал","для вас","из","вас самих","супруг","и сделал","для вас","от","ваших супруг","сыновей","и внуков","и наделил вас","из","благ","Неужели же в ложь","веруют они","а в милость","Аллаха","они","не веруют"]]],"m":[[["وَٱللَّهُ","И Аллах",16,65],["أَنزَلَ","ниспослал",16,65],["مِنَ","с",16,65],["ٱلسَّمَآءِ","неба",16,65],["مَآءٗ","воду",16,65],["فَأَحۡيَا","и оживил",16,65],["بِهِ","ею",16,65],["ٱلۡأَرۡضَ","землю",16,65],["بَعۡدَ","после",16,65],["مَوۡتِهَآۚ","её смерти",16,65],["إِنَّ","Поистине",16,65],["فِي","в",16,65],["ذَٰلِكَ","этом",16,65]],[["لَأٓيَةٗ","непременно знамение",16,65],["لِّقَوۡمٖ","для людей",16,65],["يَسۡمَعُونَ","которые слышат",16,65],[65],["وَإِنَّ","И поистине",16,66],["لَكُمۡ","для вас",16,66],["فِي","в",16,66],["ٱلۡأَنۡعَٰمِ","скоте",16,66],["لَعِبۡرَةٗۖ","непременно назидание",16,66],["نُّسۡقِيكُم","Мы поим вас",16,66],["مِّمَّا","из того, что",16,66]],[["فِي","в",16,66],["بُطُونِهِۦ","их чревах",16,66],["مِنۢ","из",16,66],["بَيۡنِ","между",16,66],["فَرۡثٖ","содержимым кишок",16,66],["وَدَمٖ","и кровью",16,66],["لَّبَنًا","молоком",16,66],["خَالِصٗا","чистым",16,66],["سَآئِغٗا","приятным",16,66],["لِّلشَّٰرِبِينَ","для пьющих",16,66],[66]],[["وَمِن","И из",16,67],["ثَمَرَٰتِ","плодов",16,67],["ٱلنَّخِيلِ","пальм",16,67],["وَٱلۡأَعۡنَٰبِ","и виноградных лоз",16,67],["تَتَّخِذُونَ","получаете вы",16,67],["مِنۡهُ","из них",16,67],["سَكَرٗا","опьяняющее",16,67],["وَرِزۡقًا","и удел",16,67]],[["حَسَنًاۚ","прекрасный",16,67],["إِنَّ","Поистине",16,67],["فِي","в",16,67],["ذَٰلِكَ","этом",16,67],["لَأٓيَةٗ","непременно знамение",16,67],["لِّقَوۡمٖ","для людей",16,67],["يَعۡقِلُونَ","которые разумеют",16,67],[67],["وَأَوۡحَىٰ","И внушил",16,68],["رَبُّكَ","твой Господь",16,68],["إِلَى","к",16,68],["ٱلنَّحۡلِ","пчеле",16,68]],[["أَنِ","что",16,68],["ٱتَّخِذِي","устраивай",16,68],["مِنَ","в",16,68],["ٱلۡجِبَالِ","горах",16,68],["بُيُوتٗا","жилища",16,68],["وَمِنَ","и в",16,68],["ٱلشَّجَرِ","деревьях",16,68],["وَمِمَّا","и в том, что",16,68],["يَعۡرِشُونَ","сооружают они",16,68],[68],["ثُمَّ","Затем",16,69],["كُلِي","питайся",16,69]],[["مِن","из",16,69],["كُلِّ","всех",16,69],["ٱلثَّمَرَٰتِ","плодов",16,69],["فَٱسۡلُكِي","и следуй",16,69],["سُبُلَ","путями",16,69],["رَبِّكِ","твоего Господа",16,69],["ذُلُلٗاۚ","облегчёнными",16,69],["يَخۡرُجُ","Выходит",16,69],["مِنۢ","из",16,69],["بُطُونِهَا","их чрев",16,69]],[["شَرَابٞ","питьё",16,69],["مُّخۡتَلِفٌ","различны",16,69],["أَلۡوَٰنُهُۥ","его цвета",16,69],["فِيهِ","в нём",16,69]