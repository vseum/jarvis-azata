{"p":275,"j":14,"a":[[16,73,["وَيَعۡبُدُونَ","مِن","دُونِ","ٱللَّهِ","مَا","لَا","يَمۡلِكُ","لَهُمۡ","رِزۡقٗا","مِّنَ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِ","شَيۡـٔٗا","وَلَا","يَسۡتَطِيعُونَ"],"вайа`будууна мин дууниллахи ма ла йамлику лахум ризḳам минас самавати вал'арди шай'ан вала йастатии`уун","Они поклоняются помимо Аллаха тому, что не имеет и не может иметь для них удел на небесах и на земле.",["И поклоняются они","помимо","помимо","Аллаха","тому, что","не","владеет","для них","уделом","из","небес","и земли","ничем","и не","способны они"]],[16,74,["فَلَا","تَضۡرِبُواْ","لِلَّهِ","ٱلۡأَمۡثَالَۚ","إِنَّ","ٱللَّهَ","يَعۡلَمُ","وَأَنتُمۡ","لَا","تَعۡلَمُونَ"],"фала тадрибуу лиллахил амсала инналлаха йа`ламу ва'антум ла та`ламуун","Никого не сравнивайте с Аллахом! Воистину, Аллах знает, а вы не знаете.",["Так не","приводите","Аллаху","подобий","Поистине","Аллах","знает","а вы","не","знаете"]],[16,75,["ضَرَبَ","ٱللَّهُ","مَثَلًا","عَبۡدٗا","مَّمۡلُوكٗا","لَّا","يَقۡدِرُ","عَلَىٰ","شَيۡءٖ","وَمَن","رَّزَقۡنَٰهُ","مِنَّا","رِزۡقًا","حَسَنٗا","فَهُوَ","يُنفِقُ","مِنۡهُ","سِرّٗا","وَجَهۡرًاۖ","هَلۡ","يَسۡتَوُۥنَۚ","ٱلۡحَمۡدُ","لِلَّهِۚ","بَلۡ","أَكۡثَرُهُمۡ","لَا","يَعۡلَمُونَ"],"дарабаллаху масалан `абдам мамлуукал ла йаḳдиру `ала шай'ин вамар разаḳнаху минна ризḳан хасанан фахуа йунфиḳу минху сирран важахран хал йаставуунал хамду лиллахи бал аксарухум ла йа`ламуун","Аллах привел притчу о рабе, который принадлежит другому и ни на что не способен, и человеке, которому Мы даровали прекрасный удел и который расходует его тайно и открыто. Равны ли они? Хвала Аллаху! Но большая часть людей не знает этого.",["Приводит","Аллах","притчу","раба","принадлежащего (другому)","не","способен он","на","что-либо","и того, кого","Мы наделили","от Нас","уделом","прекрасным","и он","расходует","из него","тайно","и открыто","Разве","равны они","Хвала","Аллаху","Но","большинство их","не","знают"]],[16,76,["وَضَرَبَ","ٱللَّهُ","مَثَلٗا","رَّجُلَيۡنِ","أَحَدُهُمَآ","أَبۡكَمُ","لَا","يَقۡدِرُ","عَلَىٰ","شَيۡءٖ","وَهُوَ","كَلٌّ","عَلَىٰ","مَوۡلَىٰهُ","أَيۡنَمَا","يُوَجِّههُّ","لَا","يَأۡتِ","بِخَيۡرٍ","هَلۡ","يَسۡتَوِي","هُوَ","وَمَن","يَأۡمُرُ","بِٱلۡعَدۡلِ","وَهُوَ","عَلَىٰ","صِرَٰطٖ","مُّسۡتَقِيمٖ"],"вадарабаллаху масалар ражулайни ахадухума абкаму ла йаḳдиру `ала шай'ин вахуа каллун `ала маулаху айнама йуажжихху ла йа'ти бихайрин хал йаставии хуа ваман йа'муру бил`адли вахуа `ала сиратим мустаḳиим","Аллах также привел притчу о двух мужах, один из которых - немой, ни на что не способен и обременяет своего господина. Куда бы его ни послали, он не приносит добра. Разве он равен тому, кто отдает справедливые приказы и следует прямым путем?",["И привёл","Аллах","притчу","двух мужей","один из них","немой","не","способен он","на","что-либо","и он","бремя","для","своего господина","куда бы ни","направил тот его","не","приносит он","добра","Разве","равен","он","и тот, кто","велит","справедливое","и он","на","пути","прямом"]],[16,77,["وَلِلَّهِ","غَيۡبُ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِۚ","وَمَآ","أَمۡرُ","ٱلسَّاعَةِ","إِلَّا","كَلَمۡحِ","ٱلۡبَصَرِ","أَوۡ","هُوَ","أَقۡرَبُۚ","إِنَّ","ٱللَّهَ","عَلَىٰ","كُلِّ","شَيۡءٖ","قَدِيرٞ"],"валиллахи гайбус самавати вал'арди вама амрус са`ати илла каламхил басари ау хуа аḳрабу инналлаха `ала кулли шай'ин ḳадиир","Аллаху принадлежит сокровенное на небесах и на земле. Наступление Часа подобно мгновению ока или даже быстрее. Воистину, Аллах способен на всякую вещь!",["И Аллаху","сокровенное","небес","и земли","И не","дело","Часа","кроме как","как мгновение","ока","или","оно","ближе","Поистине","Аллах","над","всякой","вещью","Всемогущ"]],[16,78,["وَٱللَّهُ","أَخۡرَجَكُم","مِّنۢ","بُطُونِ","أُمَّهَٰتِكُمۡ","لَا","تَعۡلَمُونَ","شَيۡـٔٗا","وَجَعَلَ","لَكُمُ","ٱلسَّمۡعَ","وَٱلۡأَبۡصَٰرَ","وَٱلۡأَفۡـِٔدَةَ","لَعَلَّكُمۡ","تَشۡكُرُونَ"],"валлаху ахражакум мим бутууни уммахатикум ла та`ламууна шай'ан важа`ала лакумус сам`а вал'абсара вал'аф'идата ла`аллакум ташкуруун","Аллах вывел вас из чрева ваших матерей, когда вы ничего не знали. Он наделил вас слухом, зрением и сердцами, - быть может, вы будете благодарны.",["И Аллах","вывел вас","из","чрев","ваших матерей","не","знали вы","ничего","и сделал","вам","слух","и зрение","и сердца","быть может, вы","возблагодарите"]],[16,79,["أَلَمۡ","يَرَوۡاْ","إِلَى","ٱلطَّيۡرِ","مُسَخَّرَٰتٖ","فِي","جَوِّ","ٱلسَّمَآءِ","مَا","يُمۡسِكُهُنَّ","إِلَّا","ٱللَّهُۚ","إِنَّ","فِي","ذَٰلِكَ","لَأٓيَٰتٖ","لِّقَوۡمٖ","يُؤۡمِنُونَ"],"алам йарау илат тайри мусаххаратин фии жаввис самаи ма йумсикухунна иллаллаху инна фии залика ла'айатил лиḳаумин йу'минуун","Неужели они не видели птиц, покорно летающих в небе? Никто не удерживает их, кроме Аллаха. Воистину, в этом - знамения для людей верующих.",["Разве не","видели они","на","птиц","подчинённых","в","пространстве","неба","никто не","удерживает их","кроме","Аллаха","Поистине","в","этом","непременно знамения","для людей","которые веруют"]]],"m":[[["وَيَعۡبُدُونَ","И поклоняются они",16,73],["مِن","помимо",16,73],["دُونِ","помимо",16,73],["ٱللَّهِ","Аллаха",16,73],["مَا","тому, что",16,73],["لَا","не",16,73],["يَمۡلِكُ","владеет",16,73],["لَهُمۡ","для них",16,73],["رِزۡقٗا","уделом",16,73],["مِّنَ","из",16,73],["ٱلسَّمَٰوَٰتِ","небес",16,73]],[["وَٱلۡأَرۡضِ","и земли",16,73],["شَيۡـٔٗا","ничем",16,73],["وَلَا","и не",16,73],["يَسۡتَطِيعُونَ","способны они",16,73],[73],["فَلَا","Так не",16,74],["تَضۡرِبُواْ","приводите",16,74],["لِلَّهِ","Аллаху",16,74],["ٱلۡأَمۡثَالَۚ","подобий",16,74]],[["إِنَّ","Поистине",16,74],["ٱللَّهَ","Аллах",16,74],["يَعۡلَمُ","знает",16,74],["وَأَنتُمۡ","а вы",16,74],["لَا","не",16,74],["تَعۡلَمُونَ","знаете",16,74],[74],["۞ ضَرَبَ","Приводит",16,75],["ٱللَّهُ","Аллах",16,75],["مَثَلًا","притчу",16,75],["عَبۡدٗا","раба",16,75]],[["مَّمۡلُوكٗا","принадлежащего (другому)",16,75],["لَّا","не",16,75],["يَقۡدِرُ","способен он",16,75],["عَلَىٰ","на",16,75],["شَيۡءٖ","что-либо",16,75],["وَمَن","и того, кого",16,75],["رَّزَقۡنَٰهُ","Мы наделили",16,75],["مِنَّا","от Нас",16,75],["رِزۡقًا","уделом",16,75],["حَسَن