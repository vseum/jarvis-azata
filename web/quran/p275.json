",16,78]],[["لَكُمُ","вам",16,78],["ٱلسَّمۡعَ","слух",16,78],["وَٱلۡأَبۡصَٰرَ","и зрение",16,78],["وَٱلۡأَفۡـِٔدَةَ","и сердца",16,78],["لَعَلَّكُمۡ","быть может, вы",16,78],["تَشۡكُرُونَ","возблагодарите",16,78]],[[78],["أَلَمۡ","Разве не",16,79],["يَرَوۡاْ","видели они",16,79],["إِلَى","на",16,79],["ٱلطَّيۡرِ","птиц",16,79],["مُسَخَّرَٰتٖ","подчинённых",16,79],["فِي","в",16,79],["جَوِّ","пространстве",16,79],["ٱلسَّمَآءِ","неба",16,79]],[["مَا","никто не",16,79],["يُمۡسِكُهُنَّ","удерживает их",16,79],["إِلَّا","кроме",16,79],["ٱللَّهُۚ","Аллаха",16,79],["إِنَّ","Поистине",16,79],["فِي","в",16,79],["ذَٰلِكَ","этом",16,79],["لَأٓيَٰتٖ","непременно знамения",16,79],["لِّقَوۡمٖ","для людей",16,79],["يُؤۡمِنُونَ","которые веруют",16,79],[79]]]}