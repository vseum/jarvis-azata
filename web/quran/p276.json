{"p":276,"j":14,"a":[[16,80,["وَٱللَّهُ","جَعَلَ","لَكُم","مِّنۢ","بُيُوتِكُمۡ","سَكَنٗا","وَجَعَلَ","لَكُم","مِّن","جُلُودِ","ٱلۡأَنۡعَٰمِ","بُيُوتٗا","تَسۡتَخِفُّونَهَا","يَوۡمَ","ظَعۡنِكُمۡ","وَيَوۡمَ","إِقَامَتِكُمۡ","وَمِنۡ","أَصۡوَافِهَا","وَأَوۡبَارِهَا","وَأَشۡعَارِهَآ","أَثَٰثٗا","وَمَتَٰعًا","إِلَىٰ","حِينٖ"],"валлаху жа`ала лакум мим буйуутикум саканан важа`ала лакум мин жулуудил ан`ами буйуутан тастахиффуунаха йаума за`никум вайаума иḳаматикум вамин асвафиха ва'аубариха ва'аш`ариха асасан вамата`ан ила хиин","Аллах сделал для вас дома жилищами. Он также сделал для вас жилища из шкур домашнего скота, которые не обременяют вас, когда вы отправляетесь в путь или делаете привал. Он даровал вам утварь и всякие предметы из шерсти, пуха и волоса, чтобы вы пользовались ими до определенного времени.",["И Аллах","сделал","для вас","из","ваших домов","местом покоя","и сделал","для вас","из","шкур","скота","жилища (шатры)","которые лёгки вам","в день","вашего переезда","и в день","вашей стоянки","и из","их шерсти","и их пуха","и их волос","утварь","и предметы пользования","до","времени"]],[16,81,["وَٱللَّهُ","جَعَلَ","لَكُم","مِّمَّا","خَلَقَ","ظِلَٰلٗا","وَجَعَلَ","لَكُم","مِّنَ","ٱلۡجِبَالِ","أَكۡنَٰنٗا","وَجَعَلَ","لَكُمۡ","سَرَٰبِيلَ","تَقِيكُمُ","ٱلۡحَرَّ","وَسَرَٰبِيلَ","تَقِيكُم","بَأۡسَكُمۡۚ","كَذَٰلِكَ","يُتِمُّ","نِعۡمَتَهُۥ","عَلَيۡكُمۡ","لَعَلَّكُمۡ","تُسۡلِمُونَ"],"валлаху жа`ала лакум мимма халаḳа зилалан важа`ала лакум минал жибали акнанан важа`ала лакум сарабиила таḳиикумул харра васарабиила таḳиикум ба'сакум казалика йутимму ни`матахуу `алайкум ла`аллакум туслимуун","Аллах даровал вам тень от того, что Он сотворил. Он устроил для вас убежища в горах, сотворил для вас одеяния, которые оберегают вас от жары, и доспехи, которые защищают вас от причиняемого вами вреда. Так Он доводит до конца Свою милость к вам, - быть может, вы станете мусульманами.",["И Аллах","сделал","для вас","из того, что","сотворил Он","тени","и сделал","для вас","в","горах","убежища","и сделал","для вас","одеяния","защищающие вас","от жары","и одеяния (доспехи)","защищающие вас","от вашей ярости (в бою)","Так","завершает Он","Свою милость","к вам","быть может, вы","покоритесь"]],[16,82,["فَإِن","تَوَلَّوۡاْ","فَإِنَّمَا","عَلَيۡكَ","ٱلۡبَلَٰغُ","ٱلۡمُبِينُ"],"фа'ин таваллау фа'иннама `алайкал балагул мубиин","Если же они отвернутся, то ведь на тебя возложена только ясная передача откровения.",["А если","отвернутся они","то лишь","на тебе","передача","ясная"]],[16,83,["يَعۡرِفُونَ","نِعۡمَتَ","ٱللَّهِ","ثُمَّ","يُنكِرُونَهَا","وَأَكۡثَرُهُمُ","ٱلۡكَٰفِرُونَ"],"йа`рифууна ни`маталлахи сумма йункируунаха ва'аксарухумул кафируун","Они узнают милость Аллаха, а затем отрицают ее, поскольку большинство из них - неверующие.",["Узнают они","милость","Аллаха","затем","отрицают её","и большинство их","неверующие"]],[16,84,["وَيَوۡمَ","نَبۡعَثُ","مِن","كُلِّ","أُمَّةٖ","شَهِيدٗا","ثُمَّ","لَا","يُؤۡذَنُ","لِلَّذِينَ","كَفَرُواْ","وَلَا","هُمۡ","يُسۡتَعۡتَبُونَ"],"вайаума наб`асу мин кулли умматин шахиидан сумма ла йу'зану лиллазиина кафаруу вала хум йуста`табуун","В тот день, когда Мы выставим из каждой общины свидетеля, неверующим не позволят оправдываться, и от них не потребуют покаяния.",["И в день","Мы воскресим","из","каждой","общины","свидетеля","затем","не","будет позволено","тем, которые","не уверовали","и не","они","будут призваны к покаянию"]],[16,85,["وَإِذَا","رَءَا","ٱلَّذِينَ","ظَلَمُواْ","ٱلۡعَذَابَ","فَلَا","يُخَفَّفُ","عَنۡهُمۡ","وَلَا","هُمۡ","يُنظَرُونَ"],"ва'иза ра'ал лазиина заламул `азаба фала йухаффафу `анхум вала хум йунзаруун","Когда же беззаконники увидят мучения, то не будет им ни облегчения, ни отсрочки.",["И когда","увидят","те, которые","поступали несправедливо","наказание","то не","будет облегчено","им","и не","они","получат отсрочку"]],[16,86,["وَإِذَا","رَءَا","ٱلَّذِينَ","أَشۡرَكُواْ","شُرَكَآءَهُمۡ","قَالُواْ","رَبَّنَا","هَٰٓؤُلَآءِ","شُرَكَآؤُنَا","ٱلَّذِينَ","كُنَّا","نَدۡعُواْ","مِن","دُونِكَۖ","فَأَلۡقَوۡاْ","إِلَيۡهِمُ","ٱلۡقَوۡلَ","إِنَّكُمۡ","لَكَٰذِبُونَ"],"ва'иза ра'ал лазиина ашракуу шуракаахум ḳалуу раббана ха'улаи шуракаунал лазиина кунна над`уу мин дууника фа'алḳау илайхимул ḳаула иннакум лаказибуун","Когда многобожники увидят своих сотоварищей, они скажут: «Господь наш! Вот сотоварищи, к которым мы взывали вместо Тебя». Но они отбросят их слова и скажут: «Воистину, вы - лжецы!».",["И когда","увидят","те, которые","приобщали сотоварищей","своих сотоварищей","скажут они","Господь наш","эти","наши сотоварищи","которых","мы (прежде)","призывали","помимо","Тебя","Но бросят они","им","слово","поистине вы","непременно лжецы"]],[16,87,["وَأَلۡقَوۡاْ","إِلَى","ٱللَّهِ","يَوۡمَئِذٍ","ٱلسَّلَمَۖ","وَضَلَّ","عَنۡهُم","مَّا","كَانُواْ","يَفۡتَرُونَ"],"ва'алḳау илаллахи йаумаизинис салама вадалла `анхум ма кануу йафтаруун","В тот день они изъявят Аллаху покорность, и покинет их (или исчезнет) то, что они измышляли.",["И предложат они","к","Аллаху","в тот день","покорность","и исчезнет","от них","то, что","они (прежде)","измышляли"]]],"m":[[["وَٱللَّهُ","И Аллах",16,80],["جَعَلَ","сделал",16,80],["لَكُم","для вас",16,80],["مِّنۢ","из",16,80],["بُيُوتِكُمۡ","ваших домов",16,80],["سَكَنٗا","местом покоя",16,80],["وَجَعَلَ","и сделал",16,80],["لَكُم","для вас",16,80],["مِّن","из",16,80],["جُلُودِ","шкур",16,80]],[["ٱلۡأَنۡعَٰمِ","скота",16,80],["بُيُوتٗا","жилища (шатры)",16,80],["تَسۡتَخِفُّونَهَا","которые лёгки вам",16,80],["يَوۡمَ","в день",16,80],["ظَعۡنِكُمۡ","вашего переезда",16,80],["وَيَوۡمَ","и в день",16,80],["إِقَامَتِكُمۡ","вашей стоянки",16,80]],[["وَمِنۡ","и из",16,80],["أَصۡوَافِهَا","их шерсти",16,80],["وَأَوۡبَارِهَا","и их пуха",16,80],["وَأَشۡعَارِهَآ","и их волос",16,80],["أَثَٰثٗا","утварь",16,80],["وَمَتَٰعًا","и предметы пользования",16,80],["إِلَىٰ","до",16,80],["حِينٖ","времени",16,80]],[[80],["وَٱللَّهُ","И Аллах",16,81],["جَعَلَ","сделал",16,81],["لَكُم","для вас",16,81],["مِّمَّا","из того, что",16,81],["خَلَقَ","сотворил Он",16,81],["ظِلَٰلٗا","тени",16,81],["وَجَعَلَ","и сделал",16,81],["لَكُم","для вас",16,81]],[["مِّنَ","в",16,81],["ٱلۡجِبَالِ","горах",16,81],["أَكۡنَٰنٗا","убежища",16,81],["وَجَعَلَ","и сделал",16,81],["لَكُمۡ","для вас",16,81],["سَرَٰبِيلَ","одеяния",16,81],["تَقِيكُمُ","защищающие вас",16,81]],[["ٱلۡحَرَّ","от жары",16,81],["وَسَرَٰبِيلَ","и одеяния (доспехи)",16,81],["تَقِيكُم","защищающие вас",16,81],["بَأۡسَكُمۡۚ","от вашей ярости (в бою)",16,81],["كَذَٰلِكَ","Так",16,81],["يُتِمُّ","завершает Он",16,81],["نِعۡمَتَهُۥ","Свою милость",16,81]],[["عَلَيۡكُمۡ","к вам",16,81],["لَعَلَّكُمۡ","быть может, вы",16,81],["تُسۡلِمُونَ","покоритесь",16,81],[81],["فَإِن","А если",16,82],["تَوَلَّوۡاْ","отвернутся они",16,82],["فَإِنَّمَا","то лишь",16,82],["عَلَيۡكَ","на тебе",16,82]],[["ٱلۡبَلَٰغُ","передача",16,82],["ٱلۡمُبِينُ","ясная",16,82],[82],["يَعۡرِفُونَ","Узнают они",16,83],["نِعۡمَتَ","милость",16,83],["ٱللَّهِ","Аллаха",16,83],["ثُمَّ","затем",16,83],["يُنكِرُونَهَا","отрицают её",16,83]],[["وَأَكۡثَرُهُمُ","и большинство их",16,83],["ٱلۡكَٰفِرُونَ","неверующие",16,83],[83],["وَيَوۡمَ","И в день",16,84],["نَبۡعَثُ","Мы воскресим",16,84],["مِن","из",16,84],["كُلِّ","каждой",16,84],["أُمَّةٖ","общины",16,84]],[["شَهِيدٗا","свидетеля",16,84],["ثُمَّ","затем",16,84],["لَا","не",16,84],["يُؤۡذَنُ","будет позволено",16,84],["لِلَّذِينَ","тем, которые",16,84],["كَفَرُواْ","не уверовали",16,84],["وَلَا","и не",16,84],["هُمۡ","они",16,84],["يُسۡتَعۡتَبُونَ","будут призваны к покаянию",16,84]],[[84],["وَإِذَا","И когда",16,85],["رَءَا","увидят",16,85],["ٱلَّذِينَ","те, которые",16,85],["ظَلَمُواْ","поступали несправедливо",16,85],["ٱلۡعَذَابَ","наказание",16,85],["فَلَا","то не",16,85],["يُخَفَّفُ","будет облегчено",16,85],["عَنۡهُمۡ","им",16,85],["وَلَا","и не",16,85],["هُمۡ","они",16,85]],[["يُنظَرُونَ","получат отсрочку",16,85],[85],["وَإِذَا","И когда",16,86],["رَءَا","увидят",16,86],["ٱلَّذِينَ","те, которые",16,86],["أَشۡرَكُواْ","приобщали сотоварищей",16,86],["شُرَكَآءَهُمۡ","своих сотоварищей",16,86]],[["قَالُواْ","скажут они",16,86],["رَبَّنَا","Господь наш",16,86],["هَٰٓؤُلَآءِ","эти",16,86],["شُرَكَآؤُنَا","наши сотоварищи",16,86],["ٱلَّذِينَ","которых",16,86],["كُنَّا","мы (прежде)",16,86],["نَدۡعُواْ","призывали",16,86],["مِن","помимо",16,86],["دُونِكَۖ","Тебя",16,86]],[["فَأَلۡقَوۡاْ","Но бросят они",16,86],["إِلَيۡهِمُ","им",16,86],["ٱلۡقَوۡلَ","слово",16,86],["إِنَّكُمۡ","поистине вы",16,86],["لَكَٰذِبُونَ","непременно лжецы",16,86],[86],["وَأَلۡقَوۡاْ","И предложат они",16,87]],[["إِلَى","к",16,87],["ٱللَّهِ","Аллаху",16,87],["يَوۡمَئِذٍ","в тот день",16,87],["ٱلسَّلَمَۖ","покорность",16,87],["وَضَلَّ","и исчезнет",16,87],["عَنۡهُم","от них",16,87],["مَّا","то, что",16,87],["كَانُواْ","они (прежде)",16,87],["يَفۡتَرُونَ","измышляли",16,87],[87]]]}