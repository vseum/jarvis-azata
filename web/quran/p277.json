{"p":277,"j":14,"a":[[16,88,["ٱلَّذِينَ","كَفَرُواْ","وَصَدُّواْ","عَن","سَبِيلِ","ٱللَّهِ","زِدۡنَٰهُمۡ","عَذَابٗا","فَوۡقَ","ٱلۡعَذَابِ","بِمَا","كَانُواْ","يُفۡسِدُونَ"],"аллазиина кафаруу васаддуу `ан сабиилиллахи зиднахум `азабан фауḳал `азаби бима кануу йуфсидуун","Для тех, которые не уверовали и сбивали других с пути Аллаха, Мы будем прибавлять мучения к мучениям за то, что они распространяли нечестие.",["Тем, которые","не уверовали","и отвращали","от","пути","Аллаха","Мы прибавим им","наказание","поверх","наказания","за то, что","они (прежде)","распространяли нечестие"]],[16,89,["وَيَوۡمَ","نَبۡعَثُ","فِي","كُلِّ","أُمَّةٖ","شَهِيدًا","عَلَيۡهِم","مِّنۡ","أَنفُسِهِمۡۖ","وَجِئۡنَا","بِكَ","شَهِيدًا","عَلَىٰ","هَٰٓؤُلَآءِۚ","وَنَزَّلۡنَا","عَلَيۡكَ","ٱلۡكِتَٰبَ","تِبۡيَٰنٗا","لِّكُلِّ","شَيۡءٖ","وَهُدٗى","وَرَحۡمَةٗ","وَبُشۡرَىٰ","لِلۡمُسۡلِمِينَ"],"вайаума наб`асу фии кулли умматин шахиидан `алайхим мин анфусихим важи'на бика шахиидан `ала ха'улаи ваназзална `алайкал китаба тибйанал ликулли шай'ин вахудан варахматан вабушра лилмуслимиин","В тот день Мы выставим против каждой общины свидетеля из их числа, а тебя выставим свидетелем против этих. Мы ниспослали тебе Писание для разъяснения всякой вещи, как руководство к прямому пути, милость и благую весть для мусульман.",["И в день","Мы воскресим","в","каждой","общине","свидетеля","против них","из","них самих","и приведём Мы","тебя","свидетелем","против","этих","И ниспослали Мы","тебе","Писание","разъяснением","для всякой","вещи","и руководством","и милостью","и благой вестью","для мусульман"]],[16,90,["إِنَّ","ٱللَّهَ","يَأۡمُرُ","بِٱلۡعَدۡلِ","وَٱلۡإِحۡسَٰنِ","وَإِيتَآيِٕ","ذِي","ٱلۡقُرۡبَىٰ","وَيَنۡهَىٰ","عَنِ","ٱلۡفَحۡشَآءِ","وَٱلۡمُنكَرِ","وَٱلۡبَغۡيِۚ","يَعِظُكُمۡ","لَعَلَّكُمۡ","تَذَكَّرُونَ"],"инналлаха йа'муру бил`адли вал'ихсани ва'иитайи зил ḳурба вайанха `анил фахшаи валмункари валбагйи йа`изукум ла`аллакум тазаккаруун","Воистину, Аллах повелевает блюсти справедливость, делать добро и одаривать родственников. Он запрещает мерзости, предосудительные деяния и бесчинства. Он увещевает вас, - быть может, вы помяните назидание.",["Поистине","Аллах","велит","(блюсти) справедливость","и благодеяние","и одаривать","обладателей","родства","и удерживает","от","мерзости","и порицаемого","и бесчинства","Он увещевает вас","быть может, вы","внемлете назиданию"]],[16,91,["وَأَوۡفُواْ","بِعَهۡدِ","ٱللَّهِ","إِذَا","عَٰهَدتُّمۡ","وَلَا","تَنقُضُواْ","ٱلۡأَيۡمَٰنَ","بَعۡدَ","تَوۡكِيدِهَا","وَقَدۡ","جَعَلۡتُمُ","ٱللَّهَ","عَلَيۡكُمۡ","كَفِيلًاۚ","إِنَّ","ٱللَّهَ","يَعۡلَمُ","مَا","تَفۡعَلُونَ"],"ва'ауфуу би`ахдиллахи иза `ахадттум вала танḳудул аймана ба`да таукиидиха ваḳад жа`алтумуллаха `алайкум кафиилан инналлаха йа`ламу ма таф`алуун","Будьте верны завету с Аллахом, который вы заключили; не нарушайте клятв после того, как вы их скрепите, ведь вы сделали Аллаха своим Поручителем. Воистину, Аллах ведает о том, что вы совершаете.",["И соблюдайте","завет","Аллаха","когда","заключили вы завет","и не","нарушайте","клятв","после","их скрепления","ведь уже","сделали вы","Аллаха","над вами","Поручителем","Поистине","Аллах","знает","то, что","вы делаете"]],[16,92,["وَلَا","تَكُونُواْ","كَٱلَّتِي","نَقَضَتۡ","غَزۡلَهَا","مِنۢ","بَعۡدِ","قُوَّةٍ","أَنكَٰثٗا","تَتَّخِذُونَ","أَيۡمَٰنَكُمۡ","دَخَلَۢا","بَيۡنَكُمۡ","أَن","تَكُونَ","أُمَّةٌ","هِيَ","أَرۡبَىٰ","مِنۡ","أُمَّةٍۚ","إِنَّمَا","يَبۡلُوكُمُ","ٱللَّهُ","بِهِۦۚ","وَلَيُبَيِّنَنَّ","لَكُمۡ","يَوۡمَ","ٱلۡقِيَٰمَةِ","مَا","كُنتُمۡ","فِيهِ","تَخۡتَلِفُونَ"],"вала такуунуу каллатии наḳадат газлаха мим ба`ди ḳувватин анкасан таттахизууна айманакум дахала байнакум ан такууна умматун хийа арба мин умматин иннама йаблуукумуллаху бихии валайубаййинанна лакум йаумал ḳийамати ма кунтум фиихи тахталифуун","Не уподобляйтесь той женщине, которая распустила свою пряжу после того, как скрепила нити. Вы обращаете свои клятвы в средство обмана, когда одни из вас оказываются сильнее и многочисленнее других. Так Аллах подвергает вас испытанию. А в День воскресения Он непременно разъяснит вам то, в чем вы расходились во мнениях.",["И не","будьте","подобны той, которая","распустила","свою пряжу","после","после","крепости","на распущенные нити","обращая","свои клятвы","обманом","между вами","потому что","будет","община","она","многочисленнее","чем","(другая) община","Лишь","испытывает вас","Аллах","этим","и непременно разъяснит Он","вам","в день","воскресения","то, что","вы (прежде)","в этом","расходились"]],[16,93,["وَلَوۡ","شَآءَ","ٱللَّهُ","لَجَعَلَكُمۡ","أُمَّةٗ","وَٰحِدَةٗ","وَلَٰكِن","يُضِلُّ","مَن","يَشَآءُ","وَيَهۡدِي","مَن","يَشَآءُۚ","وَلَتُسۡـَٔلُنَّ","عَمَّا","كُنتُمۡ","تَعۡمَلُونَ"],"валау шааллаху лажа`алакум умматан вахидатан валакин йудиллу ман йашау вайахдии ман йашау валатус'алунна `амма кунтум та`малуун","Если бы Аллах пожелал, то Он сделал бы вас единой общиной. Однако Он вводит в заблуждение, кого пожелает, и ведет прямым путем, кого пожелает, и вы непременно будете спрошены о том, что вы совершали.",["И если бы","пожелал","Аллах","непременно сделал бы Он вас","общиной","единой","но","вводит Он в заблуждение","кого","пожелает","и ведёт прямо","кого","пожелает","и непременно вы будете спрошены","о том, что","вы (прежде)","делали"]]],"m":[[["ٱلَّذِينَ","Тем, которые",16,88],["كَفَرُواْ","не уверовали",16,88],["وَصَدُّواْ","и отвращали",16,88],["عَن","от",16,88],["سَبِيلِ","пути",16,88],["ٱللَّهِ","Аллаха",16,88],["زِدۡنَٰهُمۡ","Мы прибавим им",16,88],["عَذَابٗا","наказание",16,88],["فَوۡقَ","поверх",16,88]],[["ٱلۡعَذَابِ","наказания",16,88],["بِمَا","за то, что",16,88],["كَانُواْ","они (прежде)",16,88],["يُفۡسِدُونَ","распространяли нечестие",16,88],[88],["وَيَوۡمَ","И в день",16,89],["نَبۡعَثُ","Мы воскресим",16,89],["فِي","в",16,89],["كُلِّ","каждой",16,89]],[["أُمَّةٖ","общине",16,89],["شَهِيدًا","свидетеля",16,89],["عَلَيۡهِم","против них",16,89],["مِّنۡ","из",16,89],["أَنفُسِهِمۡۖ","них самих",16,89],["وَجِئۡنَا","и приведём Мы",16,89],["بِكَ","тебя",16,89],["شَهِيدًا","свидетелем",16,89],["عَلَىٰ","против",16,89]],[["هَٰٓؤُلَآءِۚ","этих",16,89],["وَنَزَّلۡنَا","И ниспослали Мы",16,89],["عَلَيۡكَ","тебе",16,89],["ٱلۡكِتَٰبَ","Писание",16,89],["تِبۡيَٰنٗا","разъяснением",16,89],["لِّكُلِّ","для всякой",16,89],["شَيۡءٖ","вещи",16,89],["وَهُدٗى","и руководством",16,89]],[["وَرَحۡمَةٗ","и милостью",16,89],["وَبُشۡرَىٰ","и благой вестью",16,89],["لِلۡمُسۡلِمِينَ","для мусульман",16,89],[89],["۞ إِنَّ","Поистине",16,90],["ٱللَّهَ","Аллах",16,90],["يَأۡمُرُ","велит",16,90],["بِٱلۡعَدۡلِ","(блюсти) справедливость",16,90]],[["وَٱلۡإِحۡسَٰنِ","и благодеяние",16,90],["وَإِيتَآيِٕ","и одаривать",16,90],["ذِي","обладателей",16,90],["ٱلۡقُرۡبَىٰ","родства",16,90],["وَيَنۡهَىٰ","и удерживает",16,90],["عَنِ","от",16,90],["ٱلۡفَحۡشَآءِ","мерзости",16,90]],[["وَٱلۡمُنكَرِ","и порицаемого",16,90],["وَٱلۡبَغۡيِۚ","и бесчинства",16,90],["يَعِظُكُمۡ","Он увещевает вас",16,90],["لَعَلَّكُمۡ","быть может, вы",16,90],["تَذَكَّرُونَ","внемлете назиданию",16,90]],[[90],["وَأَوۡفُواْ","И соблюдайте",16,91],["بِعَهۡدِ","завет",16,91],["ٱللَّهِ","Аллаха",16,91],["إِذَا","когда",16,91],["عَٰهَدتُّمۡ","заключили вы завет",16,91],["وَلَا","и не",16,91],["تَنقُضُواْ","нарушайте",16,91],["ٱلۡأَيۡمَٰنَ","клятв",16,91]],[["بَعۡدَ","после",16,91],["تَوۡكِيدِهَا","их скрепления",16,91],["وَقَدۡ","ведь уже",16,91],["جَعَلۡتُمُ","сделали вы",16,91],["ٱللَّهَ","Аллаха",16,91],["عَلَيۡكُمۡ","над вами",16,91],["كَفِيلًاۚ","Поручителем",16,91],["إِنَّ","Поистине",16,91]],[["ٱللَّهَ","Аллах",16,91],["يَعۡلَمُ","знает",16,91],["مَا","то, что",16,91],["تَفۡعَلُونَ","вы делаете",16,91],[91],["وَلَا","И не",16,92],["تَكُونُواْ","будьте",16,92],["كَٱلَّتِي","подобны той, которая",16,92],["نَقَضَتۡ","распустила",16,92]],[["غَزۡلَهَا","свою пряжу",16,92],["مِنۢ","после",16,92],["بَعۡدِ","после",16,92],["قُوَّةٍ","крепости",16,92],["أَنكَٰثٗا","на распущенные нити",16,92],["تَتَّخِذُونَ","обращая",16,92],["أَيۡمَٰنَكُمۡ","свои клятвы",16,92],["دَخَلَۢا","обманом",16,92]],[["بَيۡنَكُمۡ","между вами",16,92],["أَن","потому что",16,92],["تَكُونَ","будет",16,92],["أُمَّةٌ","община",16,92],["هِيَ","она",16,92],["أَرۡبَىٰ","многочисленнее",16,92],["مِنۡ","чем",16,92],["أُمَّةٍۚ","(другая) община",16,92],["إِنَّمَا","Лишь",16,92],["يَبۡلُوكُمُ","испытывает вас",16,92]],[["ٱللَّهُ","Аллах",16,92],["بِهِۦۚ","этим",16,92],["وَلَيُبَيِّنَنَّ","и непременно разъяснит Он",16,92],["لَكُمۡ","вам",16,92],["يَوۡمَ","в день",16,92],["ٱلۡقِيَٰمَةِ","воскресения",16,92],["مَا","то, что",16,92],["كُنتُمۡ","вы (прежде)",16,92],["فِيهِ","в этом",16,92],["تَخۡتَلِفُونَ","расходились",16,92],[92]],[["وَلَوۡ","И если бы",16,93],["شَآءَ","пожелал",16,93],["ٱللَّهُ","Аллах",16,93],["لَجَعَلَكُمۡ","непременно сделал бы Он вас",16,93],["أُمَّةٗ","общиной",16,93],["وَٰحِدَةٗ","единой",16,93],["وَلَٰكِن","но",16,93],["يُضِلُّ","вводит Он в заблуждение",16,93],["مَن","кого",16,93]],[["يَشَآءُ","пожелает",16,93],["وَيَهۡدِي","и ведёт прямо",16,93],["مَن","кого",16,93],["يَشَآءُۚ","пожелает",16,93],["وَلَتُسۡـَٔلُنَّ","и непременно вы будете спрошены",16,93],["عَمَّا","о том, что",16,93],["كُنتُمۡ","вы (прежде)",16,93],["تَعۡمَلُونَ","делали",16,93],[93]]]}