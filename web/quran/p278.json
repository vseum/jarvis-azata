{"p":278,"j":14,"a":[[16,94,["وَلَا","تَتَّخِذُوٓاْ","أَيۡمَٰنَكُمۡ","دَخَلَۢا","بَيۡنَكُمۡ","فَتَزِلَّ","قَدَمُۢ","بَعۡدَ","ثُبُوتِهَا","وَتَذُوقُواْ","ٱلسُّوٓءَ","بِمَا","صَدَدتُّمۡ","عَن","سَبِيلِ","ٱللَّهِ","وَلَكُمۡ","عَذَابٌ","عَظِيمٞ"],"вала таттахизуу айманакум дахала байнакум фатазилла ḳадаму ба`да субуутиха ватазууḳус сууа бима сададттум `ан сабиилиллахи валакум `азабун `азиим","Не обращайте свои клятвы в средство обмана, чтобы ваша стопа не поскользнулась после того, как она твердо стояла, а не то вы вкусите зло за то, что сбивали других с пути Аллаха, и вам будут уготованы великие мучения.",["И не","обращайте","свои клятвы","обманом","между вами","а то поскользнётся","стопа","после","её твёрдости","и вкусите вы","зло","за то, что","отвращали вы","от","пути","Аллаха","и вам","наказание","великое"]],[16,95,["وَلَا","تَشۡتَرُواْ","بِعَهۡدِ","ٱللَّهِ","ثَمَنٗا","قَلِيلًاۚ","إِنَّمَا","عِندَ","ٱللَّهِ","هُوَ","خَيۡرٞ","لَّكُمۡ","إِن","كُنتُمۡ","تَعۡلَمُونَ"],"вала таштаруу би`ахдиллахи саманан ḳалиилан иннама `индаллахи хуа хайрул лакум ин кунтум та`ламуун","Не продавайте данные Аллаху обеты за ничтожную цену, ибо для вас лучше то, что у Аллаха, если бы вы только знали!",["И не","продавайте","завет","Аллаха","за цену","малую","поистине, то, что","у","Аллаха","оно","лучше","для вас","если","вы (бы)","знали"]],[16,96,["مَا","عِندَكُمۡ","يَنفَدُ","وَمَا","عِندَ","ٱللَّهِ","بَاقٖۗ","وَلَنَجۡزِيَنَّ","ٱلَّذِينَ","صَبَرُوٓاْ","أَجۡرَهُم","بِأَحۡسَنِ","مَا","كَانُواْ","يَعۡمَلُونَ"],"ма `индакум йанфаду вама `индаллахи баḳин валанажзийаннал лазиина сабаруу ажрахум би'ахсани ма кануу йа`малуун","То, что есть у вас, иссякнет, а то, что есть у Аллаха, останется навсегда. А тем, которые проявляли терпение, Мы непременно воздадим наградой за лучшее из того, что они совершали.",["то, что","у вас","иссякнет","а то, что","у","Аллаха","останется","и непременно Мы воздадим","тем, которые","терпели","их награду","по лучшему","из того, что","они","делали"]],[16,97,["مَنۡ","عَمِلَ","صَٰلِحٗا","مِّن","ذَكَرٍ","أَوۡ","أُنثَىٰ","وَهُوَ","مُؤۡمِنٞ","فَلَنُحۡيِيَنَّهُۥ","حَيَوٰةٗ","طَيِّبَةٗۖ","وَلَنَجۡزِيَنَّهُمۡ","أَجۡرَهُم","بِأَحۡسَنِ","مَا","كَانُواْ","يَعۡمَلُونَ"],"ман `амила салихам мин закарин ау унса вахуа му'минун фаланухйийаннахуу хайаватан таййибатан валанажзийаннахум ажрахум би'ахсани ма кануу йа`малуун","Верующих мужчин и женщин, которые поступали праведно, Мы непременно одарим прекрасной жизнью и вознаградим за лучшее из того, что они совершали.",["кто","совершил","праведное","будь то","мужчина","или","женщина","и он","верующий","то непременно Мы оживим его","жизнью","благой","и непременно воздадим им","их награду","по лучшему","из того, что","они","делали"]],[16,98,["فَإِذَا","قَرَأۡتَ","ٱلۡقُرۡءَانَ","فَٱسۡتَعِذۡ","بِٱللَّهِ","مِنَ","ٱلشَّيۡطَٰنِ","ٱلرَّجِيمِ"],"фа'иза ḳара'тал ḳур'ана фаста`из биллахи минаш шайтанир ражиим","Когда ты читаешь Коран, то ищи у Аллаха защиты от дьявола изгнанного, побиваемого.",["и когда","ты читаешь","Коран","то ищи защиты","у Аллаха","от","шайтана","изгнанного"]],[16,99,["إِنَّهُۥ","لَيۡسَ","لَهُۥ","سُلۡطَٰنٌ","عَلَى","ٱلَّذِينَ","ءَامَنُواْ","وَعَلَىٰ","رَبِّهِمۡ","يَتَوَكَّلُونَ"],"иннахуу лайса лахуу султанун `алал лазиина амануу ва`ала раббихим йатаваккалуун","Воистину, он не властен над теми, которые уверовали и уповают только на своего Господа.",["поистине, он","нет","у него","власти","над","теми, которые","уверовали","и на","своего Господа","уповают"]],[16,100,["إِنَّمَا","سُلۡطَٰنُهُۥ","عَلَى","ٱلَّذِينَ","يَتَوَلَّوۡنَهُۥ","وَٱلَّذِينَ","هُم","بِهِۦ","مُشۡرِكُونَ"],"иннама султанухуу `алал лазиина йатаваллаунахуу валлазиина хум бихии мушрикуун","Ему подвластны только те, которые считают его (дьявола) своим помощником и покровителем и которые приобщают к Нему сотоварищей.",["лишь","его власть","над","теми, которые","берут его в покровители","и теми, которые","они","к Нему","приобщают сотоварищей"]],[16,101,["وَإِذَا","بَدَّلۡنَآ","ءَايَةٗ","مَّكَانَ","ءَايَةٖ","وَٱللَّهُ","أَعۡلَمُ","بِمَا","يُنَزِّلُ","قَالُوٓاْ","إِنَّمَآ","أَنتَ","مُفۡتَرِۭۚ","بَلۡ","أَكۡثَرُهُمۡ","لَا","يَعۡلَمُونَ"],"ва'иза баддална айатам макана айатин валлаху а`ламу бима йуназзилу ḳалуу иннама анта муфтари бал аксарухум ла йа`ламуун","Когда Мы заменяем один аят другим, они говорят: «Воистину, ты - лжец». Аллаху лучше знать то, что Он ниспосылает. Но большая часть их не знает этого.",["и когда","Мы заменяем","аят","на месте","аята","а Аллах","лучше знает","то, что","Он ниспосылает","они говорят","лишь","ты","измышляющий","нет же","большинство их","не","знают"]],[16,102,["قُلۡ","نَزَّلَهُۥ","رُوحُ","ٱلۡقُدُسِ","مِن","رَّبِّكَ","بِٱلۡحَقِّ","لِيُثَبِّتَ","ٱلَّذِينَ","ءَامَنُواْ","وَهُدٗى","وَبُشۡرَىٰ","لِلۡمُسۡلِمِينَ"],"ḳул наззалахуу руухул ḳудуси мир раббика билхаḳḳи лийусаббитал лазиина амануу вахудан вабушра лилмуслимиин","Скажи, что Святой Дух (Джибрил) спустил его (Коран) от твоего Господа с истиной, чтобы укрепить верующих, а также как верное руководство и благую весть для мусульман.",["скажи","ниспослал его","Дух","Святой","от","твоего Господа","с истиной","чтобы укрепить","тех, которые","уверовали","и как руководство","и благую весть","для мусульман"]]],"m":[[["وَلَا","И не",16,94],["تَتَّخِذُوٓاْ","обращайте",16,94],["أَيۡمَٰنَكُمۡ","свои клятвы",16,94],["دَخَلَۢا","обманом",16,94],["بَيۡنَكُمۡ","между вами",16,94],["فَتَزِلَّ","а то поскользнётся",16,94],["قَدَمُۢ","стопа",16,94],["بَعۡدَ","после",16,94],["ثُبُوتِهَا","её твёрдости",16,94]],[["وَتَذُوقُواْ","и вкусите вы",16,94],["ٱلسُّوٓءَ","зло",16,94],["بِمَا","за то, что",16,94],["صَدَدتُّمۡ","отвращали вы",16,94],["عَن","от",16,94],["سَبِيلِ","пути",16,94],["ٱللَّهِ","Аллаха",16,94],["وَلَكُمۡ","и вам",16,94],["عَذَابٌ","наказание",16,94]],[["عَظِيمٞ","великое",16,94],[94],["وَلَا","И не",16,95],["تَشۡتَرُواْ","продавайте",16,95],["بِعَهۡدِ","завет",16,95],["ٱللَّهِ","Аллаха",16,95],["ثَمَنٗا","за цену",16,95],["قَلِيلًاۚ","малую",16,95],["إِنَّمَا","поистине, то, что",16,95],["عِندَ","у",16,95],["ٱللَّهِ","Аллаха",16,95]],[["هُوَ","оно",16,95],["خَيۡرٞ","лучше",16,95],["لَّكُمۡ","для вас",16,95],["إِن","если",16,95],["كُنتُمۡ","вы (бы)",16,95],["تَعۡلَمُونَ","знали",16,95],[95],["مَا","то, что",16,96],["عِندَكُمۡ","у вас",16,96],["يَنفَدُ","иссякнет",16,96]],[["وَمَا","а то, что",16,96],["عِندَ","у",16,96],["ٱللَّهِ","Аллаха",16,96],["بَاقٖۗ","останется",16,96],["وَلَنَجۡزِيَنَّ","и непременно Мы воздадим",16,96],["ٱلَّذِينَ","тем, которые",16,96],["صَبَرُوٓاْ","терпели",16,96],["أَجۡرَهُم","их награду",16,96],["بِأَحۡسَنِ","по лучшему",16,96]],[["مَا","из того, что",16,96],["كَانُواْ","они",16,96],["يَعۡمَلُونَ","делали",16,96],[96],["مَنۡ","кто",16,97],["عَمِلَ","совершил",16,97],["صَٰلِحٗا","праведное",16,97],["مِّن","будь то",16,97],["ذَكَرٍ","мужчина",16,97]],[["أَوۡ","или",16,97],["أُنثَىٰ","женщина",16,97],["وَهُوَ","и он",16,97],["مُؤۡمِنٞ","верующий",16,97],["فَلَنُحۡيِيَنَّهُۥ","то непременно Мы оживим его",16,97],["حَيَوٰةٗ","жизнью",16,97],["طَيِّبَةٗۖ","благой",16,97],["وَلَنَجۡزِيَنَّهُمۡ","и непременно воздадим им",16,97]],[["أَجۡرَهُم","их награду",16,97],["بِأَحۡسَنِ","по лучшему",16,97],["مَا","из того, что",16,97],["كَانُواْ","они",16,97],["يَعۡمَلُونَ","делали",16,97],[97],["فَإِذَا","и когда",16,98],["قَرَأۡتَ","ты читаешь",16,98],["ٱلۡقُرۡءَانَ","Коран",16,98]],[["فَٱسۡتَعِذۡ","то ищи защиты",16,98],["بِٱللَّهِ","у Аллаха",16,98],["مِنَ","от",16,98],["ٱلشَّيۡطَٰنِ","шайтана",16,98],["ٱلرَّجِيمِ","изгнанного",16,98],[98],["إِنَّهُۥ","поистине, он",16,99],["لَيۡسَ","нет",16,99],["لَهُۥ","у него",16,99],["سُلۡطَٰنٌ","власти",16,99]],[["عَلَى","над",16,99],["ٱلَّذِينَ","теми, которые",16,99],["ءَامَنُواْ","уверовали",16,99],["وَعَلَىٰ","и на",16,99],["رَبِّهِمۡ","своего Господа",16,99],["يَتَوَكَّلُونَ","уповают",16,99],[99],["إِنَّمَا","лишь",16,100]],[["سُلۡطَٰنُهُۥ","его власть",16,100],["عَلَى","над",16,100],["ٱلَّذِينَ","теми, которые",16,100],["يَتَوَلَّوۡنَهُۥ","берут его в покровители",16,100],["وَٱلَّذِينَ","и теми, которые",16,100],["هُم","они",16,100],["بِهِۦ","к Нему",16,100],["مُشۡرِكُونَ","приобщают сотоварищей",16,100]],[[100],["وَإِذَا","и когда",16,101],["بَدَّلۡنَآ","Мы заменяем",16,101],["ءَايَةٗ","аят",16,101],["مَّكَانَ","на месте",16,101],["ءَايَةٖ","аята",16,101],["وَٱللَّهُ","а Аллах",16,101],["أَعۡلَمُ","лучше знает",16,101]],[["بِمَا","то, что",16,101],["يُنَزِّلُ","Он ниспосылает",16,101],["قَالُوٓاْ","они говорят",16,101],["إِنَّمَآ","лишь",16,101],["أَنتَ","ты",16,101],["مُفۡتَرِۭۚ","измышляющий",16,101],["بَلۡ","нет же",16,101],["أَكۡثَرُهُمۡ","большинство их",16,101],["لَا","не",16,101],["يَعۡلَمُونَ","знают",16,101]],[[101],["قُلۡ","скажи",16,102],["نَزَّلَهُۥ","ниспослал его",16,102],["رُوحُ","Дух",16,102],["ٱلۡقُدُسِ","Святой",16,102],["مِن","от",16,102],["رَّبِّكَ","твоего Господа",16,102],["بِٱلۡحَقِّ","с истиной",16,102],["لِيُثَبِّتَ","чтобы укрепить",16,102]],[["ٱلَّذِينَ","тех, которые",16,102],["ءَامَنُواْ","уверовали",16,102],["وَهُدٗى","и как руководство",16,102],["وَبُشۡرَىٰ","и благую весть",16,102],["لِلۡمُسۡلِمِينَ","для мусульман",16,102],[102]]]}