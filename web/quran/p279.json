{"p":279,"j":14,"a":[[16,103,["وَلَقَدۡ","نَعۡلَمُ","أَنَّهُمۡ","يَقُولُونَ","إِنَّمَا","يُعَلِّمُهُۥ","بَشَرٞۗ","لِّسَانُ","ٱلَّذِي","يُلۡحِدُونَ","إِلَيۡهِ","أَعۡجَمِيّٞ","وَهَٰذَا","لِسَانٌ","عَرَبِيّٞ","مُّبِينٌ"],"валаḳад на`ламу аннахум йаḳуулууна иннама йу`аллимухуу башарул лисанул лазии йулхидууна илайхи а`жамиййун вахаза лисанун `арабиййум мубиин","Мы знаем, что они говорят: «Воистину, его обучает человек». Язык того, на кого они указывают, является иноземным, тогда как это - ясный арабский язык.",["и действительно","Мы знаем","что они","говорят","лишь","обучает его","человек","язык","того, на","кого они указывают","него","иноземный","а это","язык","арабский","ясный"]],[16,104,["إِنَّ","ٱلَّذِينَ","لَا","يُؤۡمِنُونَ","بِـَٔايَٰتِ","ٱللَّهِ","لَا","يَهۡدِيهِمُ","ٱللَّهُ","وَلَهُمۡ","عَذَابٌ","أَلِيمٌ"],"иннал лазиина ла йу'минууна би'айатиллахи ла йахдиихимуллаху валахум `азабун алиим","Воистину, Аллах не ведет прямым путем тех, кто не уверовал в знамения Аллаха, и им уготованы мучительные страдания.",["поистине","те, которые","не","веруют","в знамения","Аллаха","не","наставит их","Аллах","и им","наказание","мучительное"]],[16,105,["إِنَّمَا","يَفۡتَرِي","ٱلۡكَذِبَ","ٱلَّذِينَ","لَا","يُؤۡمِنُونَ","بِـَٔايَٰتِ","ٱللَّهِۖ","وَأُوْلَٰٓئِكَ","هُمُ","ٱلۡكَٰذِبُونَ"],"иннама йафтарил казибал лазиина ла йу'минууна би'айатиллахи ва'улаика хумул казибуун","Воистину, ложь измышляют те, которые не веруют в знамения Аллаха. Они и есть лжецы.",["лишь","измышляют","ложь","те, которые","не","веруют","в знамения","Аллаха","и те","они","лжецы"]],[16,106,["مَن","كَفَرَ","بِٱللَّهِ","مِنۢ","بَعۡدِ","إِيمَٰنِهِۦٓ","إِلَّا","مَنۡ","أُكۡرِهَ","وَقَلۡبُهُۥ","مُطۡمَئِنُّۢ","بِٱلۡإِيمَٰنِ","وَلَٰكِن","مَّن","شَرَحَ","بِٱلۡكُفۡرِ","صَدۡرٗا","فَعَلَيۡهِمۡ","غَضَبٞ","مِّنَ","ٱللَّهِ","وَلَهُمۡ","عَذَابٌ","عَظِيمٞ"],"ман кафара биллахи мим ба`ди ииманихии илла ман укриха ваḳалбухуу мутмаинну бил'иимани валаким ман шараха билкуфри садран фа`алайхим гадабум миналлахи валахум `азабун `азиим","Гнев Аллаха падет на тех, кто отрекся от Аллаха после того, как уверовал, - не на тех, кто был принужден к этому, тогда как в его сердце покоилась твердая вера, а на тех, кто сам раскрыл грудь для неверия. Им уготованы великие мучения.",["кто","не уверовал","в Аллаха","уже","после","своей веры","кроме","того, кто","был принуждён","а сердце его","спокойно","верой","но","кто","раскрыл","для неверия","грудь","то на них","гнев","от","Аллаха","и им","наказание","великое"]],[16,107,["ذَٰلِكَ","بِأَنَّهُمُ","ٱسۡتَحَبُّواْ","ٱلۡحَيَوٰةَ","ٱلدُّنۡيَا","عَلَى","ٱلۡأٓخِرَةِ","وَأَنَّ","ٱللَّهَ","لَا","يَهۡدِي","ٱلۡقَوۡمَ","ٱلۡكَٰفِرِينَ"],"залика би'аннахумустахаббул хайаватад дунйа `алал ахирати ва'анналлаха ла йахдил ḳаумал кафириин","Это потому, что они предпочли мирскую жизнь Последней жизни. Воистину, Аллах не ведет прямым путем неверующих людей.",["это","потому, что они","предпочли","жизнь","мирскую","перед","Последней жизнью","и потому, что","Аллах","не","ведёт прямым путём","людей","неверующих"]],[16,108,["أُوْلَٰٓئِكَ","ٱلَّذِينَ","طَبَعَ","ٱللَّهُ","عَلَىٰ","قُلُوبِهِمۡ","وَسَمۡعِهِمۡ","وَأَبۡصَٰرِهِمۡۖ","وَأُوْلَٰٓئِكَ","هُمُ","ٱلۡغَٰفِلُونَ"],"улаикал лазиина таба`аллаху `ала ḳулуубихим васам`ихим ва'абсарихим ва'улаика хумул гафилуун","Аллах запечатал их сердца, слух и зрение. Они и есть беспечные невежды.",["они —","те, которые","наложил печать","Аллах","на","их сердца","и их слух","и их зрение","и те","они","беспечные"]],[16,109,["لَا","جَرَمَ","أَنَّهُمۡ","فِي","ٱلۡأٓخِرَةِ","هُمُ","ٱلۡخَٰسِرُونَ"],"ла жарама аннахум фил ахирати хумул хасируун","Несомненно, в Последней жизни они окажутся потерпевшими убыток.",["нет","сомнения","что они","в","Последней жизни","они","потерпевшие убыток"]],[16,110,["ثُمَّ","إِنَّ","رَبَّكَ","لِلَّذِينَ","هَاجَرُواْ","مِنۢ","بَعۡدِ","مَا","فُتِنُواْ","ثُمَّ","جَٰهَدُواْ","وَصَبَرُوٓاْ","إِنَّ","رَبَّكَ","مِنۢ","بَعۡدِهَا","لَغَفُورٞ","رَّحِيمٞ"],"сумма инна раббака лиллазиина хажаруу мим ба`ди ма футинуу сумма жахадуу васабаруу инна раббака мим ба`диха лагафуурур рахиим","Воистину, твой Господь после всего этого прощает и милует тех, которые переселились после того, как были подвергнуты искушению, а затем сражались и проявляли терпение.",["затем","поистине","твой Господь","для тех, которые","переселились","уже","после","того, как","подверглись искушению","затем","сражались","и терпели","поистине","твой Господь","уже","после этого","непременно Прощающий","Милосердный"]]],"m":[[["وَلَقَدۡ","и действительно",16,103],["نَعۡلَمُ","Мы знаем",16,103],["أَنَّهُمۡ","что они",16,103],["يَقُولُونَ","говорят",16,103],["إِنَّمَا","лишь",16,103],["يُعَلِّمُهُۥ","обучает его",16,103],["بَشَرٞۗ","человек",16,103],["لِّسَانُ","язык",16,103]],[["ٱلَّذِي","того, на",16,103],["يُلۡحِدُونَ","кого они указывают",16,103],["إِلَيۡهِ","него",16,103],["أَعۡجَمِيّٞ","иноземный",16,103],["وَهَٰذَا","а это",16,103],["لِسَانٌ","язык",16,103],["عَرَبِيّٞ","арабский",16,103]],[["مُّبِينٌ","ясный",16,103],[103],["إِنَّ","поистине",16,104],["ٱلَّذِينَ","те, которые",16,104],["لَا","не",16,104],["يُؤۡمِنُونَ","веруют",16,104],["بِـَٔايَٰتِ","в знамения",16,104],["ٱللَّهِ","Аллаха",16,104],["لَا","не",16,104],["يَهۡدِيهِمُ","наставит их",16,104]],[["ٱللَّهُ","Аллах",16,104],["وَلَهُمۡ","и им",16,104],["عَذَابٌ","наказание",16,104],["أَلِيمٌ","мучительное",16,104],[104],["إِنَّمَا","лишь",16,105],["يَفۡتَرِي","измышляют",16,105],["ٱلۡكَذِبَ","ложь",16,105],["ٱلَّذِينَ","те, которые",16,105]],[["لَا","не",16,105],["يُؤۡمِنُونَ","веруют",16,105],["بِـَٔايَٰتِ","в знамения",16,105],["ٱللَّهِۖ","Аллаха",16,105],["وَأُوْلَٰٓئِكَ","и те",16,105],["هُمُ","они",16,105],["ٱلۡكَٰذِبُونَ","лжецы",16,105]],[[105],["مَن","кто",16,106],["كَفَرَ","не уверовал",16,106],["بِٱللَّهِ","в Аллаха",16,106],["مِنۢ","уже",16,106],["بَعۡدِ","после",16,106],["إِيمَٰنِهِۦٓ","своей веры",16,106],["إِلَّا","кроме",16,106],["مَنۡ","того, кто",16,106],["أُكۡرِهَ","был принуждён",16,106]],[["وَقَلۡبُهُۥ","а сердце его",16,106],["مُطۡمَئِنُّۢ","спокойно",1