{"p":280,"j":14,"a":[[16,111,["يَوۡمَ","تَأۡتِي","كُلُّ","نَفۡسٖ","تُجَٰدِلُ","عَن","نَّفۡسِهَا","وَتُوَفَّىٰ","كُلُّ","نَفۡسٖ","مَّا","عَمِلَتۡ","وَهُمۡ","لَا","يُظۡلَمُونَ"],"йаума та'тии куллу нафсин тужадилу `ан нафсиха ватуаффа куллу нафсим ма `амилат вахум ла йузламуун","В тот день каждый человек придет и будет препираться за себя. Каждому человеку сполна воздастся за то, что он совершил, и с ними не поступят несправедливо.",["в день, когда","придёт","каждая","душа","препираясь","за","саму себя","и сполна воздастся","каждой","душе","за то, что","она совершила","и они","не","будут обижены"]],[16,112,["وَضَرَبَ","ٱللَّهُ","مَثَلٗا","قَرۡيَةٗ","كَانَتۡ","ءَامِنَةٗ","مُّطۡمَئِنَّةٗ","يَأۡتِيهَا","رِزۡقُهَا","رَغَدٗا","مِّن","كُلِّ","مَكَانٖ","فَكَفَرَتۡ","بِأَنۡعُمِ","ٱللَّهِ","فَأَذَٰقَهَا","ٱللَّهُ","لِبَاسَ","ٱلۡجُوعِ","وَٱلۡخَوۡفِ","بِمَا","كَانُواْ","يَصۡنَعُونَ"],"вадарабаллаху масалан ḳарйатан канат аминатам мутмаиннатан йа'тииха ризḳуха рагадам мин кулли маканин факафарат би'ан`умиллахи фа'азаḳахаллаху либасал жуу`и валхауфи бима кануу йасна`уун","Аллах привел в качестве притчи селение, которое пребывало в безопасности и покое (Мекку). Они обретали свой удел в изобилии отовсюду, но не благодарили Аллаха за эти блага, и тогда Аллах облек их в одеяние голода и страха за то, что они творили.",["и привёл","Аллах","притчу","селение","было","безопасным","спокойным","приходил к нему","его удел","обильно","из","всякого","места","но оно отвергло","милости","Аллаха","и дал вкусить ему","Аллах","одеяние","голода","и страха","за то, что","они","творили"]],[16,113,["وَلَقَدۡ","جَآءَهُمۡ","رَسُولٞ","مِّنۡهُمۡ","فَكَذَّبُوهُ","فَأَخَذَهُمُ","ٱلۡعَذَابُ","وَهُمۡ","ظَٰلِمُونَ"],"валаḳад жаахум расуулум минхум факаззабууху фа'ахазахумул `азабу вахум залимуун","К ним явился посланник из их среды, но они не признали его, и мучения постигли их, пока они поступали несправедливо.",["и действительно","пришёл к ним","посланник","из них","но они сочли его лжецом","и постигло их","наказание","когда они","несправедливы"]],[16,114,["فَكُلُواْ","مِمَّا","رَزَقَكُمُ","ٱللَّهُ","حَلَٰلٗا","طَيِّبٗا","وَٱشۡكُرُواْ","نِعۡمَتَ","ٱللَّهِ","إِن","كُنتُمۡ","إِيَّاهُ","تَعۡبُدُونَ"],"факулуу мимма разаḳакумуллаху халалан таййибан вашкуруу ни`маталлахи ин кунтум иййаху та`будуун","Питайтесь дозволенным и благим из того, что Аллах дал вам в удел, и будьте благодарны за милости Аллаха, если вы поклоняетесь Ему.",["так ешьте","из того, что","дал вам в удел","Аллах","дозволенное","благое","и благодарите за","милость","Аллаха","если","вы","Ему одному","поклоняетесь"]],[16,115,["إِنَّمَا","حَرَّمَ","عَلَيۡكُمُ","ٱلۡمَيۡتَةَ","وَٱلدَّمَ","وَلَحۡمَ","ٱلۡخِنزِيرِ","وَمَآ","أُهِلَّ","لِغَيۡرِ","ٱللَّهِ","بِهِۦۖ","فَمَنِ","ٱضۡطُرَّ","غَيۡرَ","بَاغٖ","وَلَا","عَادٖ","فَإِنَّ","ٱللَّهَ","غَفُورٞ","رَّحِيمٞ"],"иннама харрама `алайкумул майтата ваддама валахмал хинзиири вама ухилла лигайриллахи бихии фаманидтурра гайра багин вала `адин фа'инналлаха гафуурур рахиим","Он запретил вам мертвечину, кровь, мясо свиньи, а также то, что не заколото во имя Аллаха. Если же кто-либо вынужден пойти на это, не домагаясь запретного и не преступая пределы необходимого, то ведь Аллах - Прощающий, Милосердный.",["лишь","Он запретил","вам","мертвечину","и кровь","и мясо","свиньи","и то, что","посвящено","не ради","Аллаха","им","а кто","вынужден","не будучи","домогающимся","и не","преступающим","то поистине","Аллах","Прощающий","Милосердный"]],[16,116,["وَلَا","تَقُولُواْ","لِمَا","تَصِفُ","أَلۡسِنَتُكُمُ","ٱلۡكَذِبَ","هَٰذَا","حَلَٰلٞ","وَهَٰذَا","حَرَامٞ","لِّتَفۡتَرُواْ","عَلَى","ٱللَّهِ","ٱلۡكَذِبَۚ","إِنَّ","ٱلَّذِينَ","يَفۡتَرُونَ","عَلَى","ٱللَّهِ","ٱلۡكَذِبَ","لَا","يُفۡلِحُونَ"],"вала таḳуулуу лима тасифу алсинатукумул казиба хаза халалун вахаза харамул литафтаруу `алаллахил казиба иннал лазиина йафтарууна `алаллахил казиба ла йуфлихуун","Не изрекайте своими устами ложь, утверждая, что это - дозволено, а то - запретно, и не возводите навет на Аллаха. Воистину, не преуспеют те, которые возводят навет на Аллаха.",["и не","говорите","о том, что","описывают","ваши языки","ложно","это","дозволено","а это","запретно","чтобы возводить","на","Аллаха","ложь","поистине","те, которые","возводят","на","Аллаха","ложь","не","преуспеют"]],[16,117,["مَتَٰعٞ","قَلِيلٞ","وَلَهُمۡ","عَذَابٌ","أَلِيمٞ"],"мата`ун ḳалиилун валахум `азабун алиим","Недолго им пользоваться благами, ведь им уготованы мучительные страдания.",["пользование","малое","и им","наказание","мучительное"]],[16,118,["وَعَلَى","ٱلَّذِينَ","هَادُواْ","حَرَّمۡنَا","مَا","قَصَصۡنَا","عَلَيۡكَ","مِن","قَبۡلُۖ","وَمَا","ظَلَمۡنَٰهُمۡ","وَلَٰكِن","كَانُوٓاْ","أَنفُسَهُمۡ","يَظۡلِمُونَ"],"ва`алал лазиина хадуу харрамна ма ḳасасна `алайка мин ḳаблу вама заламнахум валакин кануу анфусахум йазлимуун","А иудеям Мы запретили то, о чем Мы рассказали тебе раньше. Мы не были несправедливы к ним - они сами поступали несправедливо по отношению к себе.",["и для","тех, которые","исповедуют иудаизм","Мы запретили","то, о чём","Мы рассказали","тебе","уже","раньше","и не","Мы обидели их","но","они","самих себя","обижали"]]],"m":[[["۞ يَوۡمَ","в день, когда",16,111],["تَأۡتِي","придёт",16,111],["كُلُّ","каждая",16,111],["نَفۡسٖ","душа",16,111],["تُجَٰدِلُ","препираясь",16,111],["عَن","за",16,111],["نَّفۡسِهَا","саму себя",16,111],["وَتُوَفَّىٰ","и сполна воздастся",16,111],["كُلُّ","каждой",16,111]],[["نَفۡسٖ","душе",16,111],["مَّا","за то, что",16,111],["عَمِلَتۡ","она совершила",16,111],["وَهُمۡ","и они",16,111],["لَا","не",16,111],["يُظۡلَمُونَ","будут обижены",16,111],[111],["وَضَرَبَ","и привёл",16,112],["ٱللَّهُ","Аллах",16,112],["مَثَلٗا","притчу",16,112]],[["قَرۡيَةٗ","селение",16,112],["كَانَتۡ","было",16,112],["ءَامِنَةٗ","безопасным",16,112],["مُّطۡمَئِنَّةٗ","спокойным",16,112],["يَأۡتِيهَا","приходил к нему",16,112],["رِزۡقُهَا","его удел",16,112],["رَغَدٗا","обильно",16,112]],[["مِّن","из",16,112],["كُلِّ","всякого",16,112],["مَكَانٖ","места",16,112],["فَكَفَرَتۡ","но оно отвергло",16,112],["بِأَنۡعُمِ","милости",16,112],["ٱللَّهِ","Аллаха",16,112],["فَأَذَٰقَهَا","и дал вкусить ему",16,112],["ٱللَّهُ","Аллах",16,112],["لِبَاسَ","одеяние",16,112]],[["ٱلۡجُوعِ","голода",16,112],["وَٱلۡخَوۡفِ","и страха",16,112],["بِمَا","за то, что",16,112],["كَانُواْ","они",16,112],["يَصۡنَعُونَ","творили",16,112],[112],["وَلَقَدۡ","и действительно",16,113]],[["جَآءَهُمۡ","пришёл к ним",16,113],["رَسُولٞ","посланник",16,113],["مِّنۡهُمۡ","из них",16,113],["فَكَذَّبُوهُ","но они сочли его лжецом",16,113],["فَأَخَذَهُمُ","и постигло их",16,113],["ٱلۡعَذَابُ","наказание",16,113],["وَهُمۡ","когда они",16,113]],[["ظَٰلِمُونَ","несправедливы",16,113],[113],["فَكُلُواْ","так ешьте",16,114],["مِمَّا","из того, что",16,114],["رَزَقَكُمُ","дал вам в удел",16,114],["ٱللَّهُ","Аллах",16,114],["حَلَٰلٗا","дозволенное",16,114],["طَيِّبٗا","благое",16,114]],[["وَٱشۡكُرُواْ","и благодарите за",16,114],["نِعۡمَتَ","милость",16,114],["ٱللَّهِ","Аллаха",16,114],["إِن","если",16,114],["كُنتُمۡ","вы",16,114],["إِيَّاهُ","Ему одному",16,114],["تَعۡبُدُونَ","поклоняетесь",16,114],[114]],[["إِنَّمَا","лишь",16,115],["حَرَّمَ","Он запретил",16,115],["عَلَيۡكُمُ","вам",16,115],["ٱلۡمَيۡتَةَ","мертвечину",16,115],["وَٱلدَّمَ","и кровь",16,115],["وَلَحۡمَ","и мясо",16,115],["ٱلۡخِنزِيرِ","свиньи",16,115],["وَمَآ","и то, что",16,115]],[["أُهِلَّ","посвящено",16,115],["لِغَيۡرِ","не ради",16,115],["ٱللَّهِ","Аллаха",16,115],["بِهِۦۖ","им",16,115],["فَمَنِ","а кто",16,115],["ٱضۡطُرَّ","вынужден",16,115],["غَيۡرَ","не будучи",16,115],["بَاغٖ","домогающимся",16,115],["وَلَا","и не",16,115],["عَادٖ","преступающим",16,115],["فَإِنَّ","то поистине",16,115]],[["ٱللَّهَ","Аллах",16,115],["غَفُورٞ","Прощающий",16,115],["رَّحِيمٞ","Милосердный",16,115],[115],["وَلَا","и не",16,116],["تَقُولُواْ","говорите",16,116],["لِمَا","о том, что",16,116],["تَصِفُ","описывают",16,116],["أَلۡسِنَتُكُمُ","ваши языки",16,116]],[["ٱلۡكَذِبَ","ложно",16,116],["هَٰذَا","это",16,116],["حَلَٰلٞ","дозволено",16,116],["وَهَٰذَا","а это",16,116],["حَرَامٞ","запретно",16,116],["لِّتَفۡتَرُواْ","чтобы возводить",16,116],["عَلَى","на",16,116],["ٱللَّهِ","Аллаха",16,116],["ٱلۡكَذِبَۚ","ложь",16,116]],[["إِنَّ","поистине",16,116],["ٱلَّذِينَ","те, которые",16,116],["يَفۡتَرُونَ","возводят",16,116],["عَلَى","на",16,116],["ٱللَّهِ","Аллаха",16,116],["ٱلۡكَذِبَ","ложь",16,116],["لَا","не",16,116],["يُفۡلِحُونَ","преуспеют",16,116],[116],["مَتَٰعٞ","пользование",16,117],["قَلِيلٞ","малое",16,117]],[["وَلَهُمۡ","и им",16,117],["عَذَابٌ","наказание",16,117],["أَلِيمٞ","мучительное",16,117],[117],["وَعَلَى","и для",16,118],["ٱلَّذِينَ","тех, которые",16,118],["هَادُواْ","исповедуют иудаизм",16,118],["حَرَّمۡنَا","Мы запретили",16,118],["مَا","то, о чём",16,118],["قَصَصۡنَا","Мы рассказали",16,118],["عَلَيۡكَ","тебе",16,118]],[["مِن","уже",16,118],["قَبۡلُۖ","раньше",16,118],["وَمَا","и не",16,118],["ظَلَمۡنَٰهُمۡ","Мы обидели их",16,118],["وَلَٰكِن","но",16,118],["كَانُوٓاْ","они",16,118],["أَنفُسَهُمۡ","самих себя",16,118],["يَظۡلِمُونَ","обижали",16,118],[118]]]}