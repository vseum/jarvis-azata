مَا","عُوقِبۡتُم","بِهِۦۖ","وَلَئِن","صَبَرۡتُمۡ","لَهُوَ","خَيۡرٞ","لِّلصَّٰبِرِينَ"],"ва'ин `аḳабтум фа`аḳибуу бимисли ма `ууḳибтум бихии валаин сабартум лахуа хайрул лиссабириин","Если вы подвергните их наказанию, то наказывайте их так, как они наказывали вас. Но если вы проявите терпение, то так будет лучше для терпеливых.",["и если","вы наказываете","то наказывайте","подобным","тому, чем","вы были наказаны","им","но если","вы потерпите","то непременно это","лучше","для терпеливых"]],[16,127,["وَٱصۡبِرۡ","وَمَا","صَبۡرُكَ","إِلَّا","بِٱللَّهِۚ","وَلَا","تَحۡزَنۡ","عَلَيۡهِمۡ","وَلَا","تَكُ","فِي","ضَيۡقٖ","مِّمَّا","يَمۡكُرُونَ"],"васбир вама сабрука илла биллахи вала тахзан `алайхим вала таку фии дайḳим мимма йамкуруун","Посему терпи, ибо твое терпение - только от Аллаха. Не скорби по ним и не печалься оттого, что они ухищряются.",["и терпи","и не","твоё терпение","кроме как","от Аллаха","и не","печалься","о них","и не","будь","в","стеснении","от того, что","они хитрят"]],[16,128,["إِنَّ","ٱللَّهَ","مَعَ","ٱلَّذِينَ","ٱتَّقَواْ","وَّٱلَّذِينَ","هُم","مُّحۡسِنُونَ"],"инналлаха ма`ал лазиинаттаḳав вваллазиина хум мухсинуун","Воистину, Аллах - с теми, кто богобоязнен и кто творит добро.",["поистине","Аллах","с","теми, которые","богобоязненны","и теми, которые","они","творят добро"]]],"m":[[["ثُمَّ","затем",16,119],["إِنَّ","поистине",16,119],["رَبَّكَ","твой Господь",16,119],["لِلَّذِينَ","для тех, которые",16,119],["عَمِلُواْ","совершили",16,119],["ٱلسُّوٓءَ","зло",16,119],["بِجَهَٰلَةٖ","по невежеству",16,119],["ثُمَّ","затем",16,119],["تَابُواْ","раскаялись",16,119],["مِنۢ","уже",16,119]],[["بَعۡدِ","после",16,119],["ذَٰلِكَ","этого",16,119],["وَأَصۡلَحُوٓاْ","и исправились",16,119],["إِنَّ","поистине",16,119],["رَبَّكَ","твой Господь",16,119],["مِنۢ","уже",16,119],["بَعۡدِهَا","после этого",16,119],["لَغَفُورٞ","непременно Прощающий",16,119],["رَّحِيمٌ","Милосердный",16,119],[119]],[["إِنَّ","поистине",16,120],["إِبۡرَٰهِيمَ","Ибрахим",16,120],["كَانَ","был",1