{"p":281,"j":14,"a":[[16,119,["ثُمَّ","إِنَّ","رَبَّكَ","لِلَّذِينَ","عَمِلُواْ","ٱلسُّوٓءَ","بِجَهَٰلَةٖ","ثُمَّ","تَابُواْ","مِنۢ","بَعۡدِ","ذَٰلِكَ","وَأَصۡلَحُوٓاْ","إِنَّ","رَبَّكَ","مِنۢ","بَعۡدِهَا","لَغَفُورٞ","رَّحِيمٌ"],"сумма инна раббака лиллазиина `амилус сууа бижахалатин сумма табуу мим ба`ди залика ва'аслахуу инна раббака мим ба`диха лагафуурур рахиим","Воистину, твой Господь прощает и милует тех, кто совершил злодеяние по незнанию, но после этого раскаялся и исправил содеянное.",["затем","поистине","твой Господь","для тех, которые","совершили","зло","по невежеству","затем","раскаялись","уже","после","этого","и исправились","поистине","твой Господь","уже","после этого","непременно Прощающий","Милосердный"]],[16,120,["إِنَّ","إِبۡرَٰهِيمَ","كَانَ","أُمَّةٗ","قَانِتٗا","لِّلَّهِ","حَنِيفٗا","وَلَمۡ","يَكُ","مِنَ","ٱلۡمُشۡرِكِينَ"],"инна ибрахиима кана умматан ḳанитал лиллахи ханиифан валам йаку минал мушрикиин","Воистину, Ибрахим (Авраам) был вождем, покорным Аллаху и ханифом. Он не был одним из многобожников.",["поистине","Ибрахим","был","вождём","покорным","Аллаху","ханифом","и не","был он","из","многобожников"]],[16,121,["شَاكِرٗا","لِّأَنۡعُمِهِۚ","ٱجۡتَبَىٰهُ","وَهَدَىٰهُ","إِلَىٰ","صِرَٰطٖ","مُّسۡتَقِيمٖ"],"шакирал ли'ан`умихижтабаху вахадаху ила сиратим мустаḳиим","Он был благодарен Аллаху за благодеяния, и Он избрал его и повел прямым путем.",["благодарным","за Его милости","Он избрал его","и повёл его","к","пути","прямому"]],[16,122,["وَءَاتَيۡنَٰهُ","فِي","ٱلدُّنۡيَا","حَسَنَةٗۖ","وَإِنَّهُۥ","فِي","ٱلۡأٓخِرَةِ","لَمِنَ","ٱلصَّٰلِحِينَ"],"ва'атайнаху фид дунйа хасанатан ва'иннахуу фил ахирати ламинас салихиин","Мы даровали ему добро в мирской жизни, а в Последней жизни он будет в числе праведников.",["и Мы даровали ему","в","мирской жизни","благо","и поистине, он","в","Последней жизни","непременно среди","праведников"]],[16,123,["ثُمَّ","أَوۡحَيۡنَآ","إِلَيۡكَ","أَنِ","ٱتَّبِعۡ","مِلَّةَ","إِبۡرَٰهِيمَ","حَنِيفٗاۖ","وَمَا","كَانَ","مِنَ","ٱلۡ