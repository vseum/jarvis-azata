{"p":282,"j":15,"a":[[17,1,["سُبۡحَٰنَ","ٱلَّذِيٓ","أَسۡرَىٰ","بِعَبۡدِهِۦ","لَيۡلٗا","مِّنَ","ٱلۡمَسۡجِدِ","ٱلۡحَرَامِ","إِلَى","ٱلۡمَسۡجِدِ","ٱلۡأَقۡصَا","ٱلَّذِي","بَٰرَكۡنَا","حَوۡلَهُۥ","لِنُرِيَهُۥ","مِنۡ","ءَايَٰتِنَآۚ","إِنَّهُۥ","هُوَ","ٱلسَّمِيعُ","ٱلۡبَصِيرُ"],"субханал лазии асра би`абдихии лайлам минал масжидил харами илал масжидил аḳсал лазии баракна хаулахуу линурийахуу мин айатина иннахуу хуас самии`ул басиир","Пречист Тот, Кто перенес ночью Своего раба, чтобы показать ему некоторые из Наших знамений, из Заповедной мечети в мечеть аль-Акса, окрестностям которой Мы даровали благословение. Воистину, Он - Слышащий, Видящий.",["Пречист","Тот, Кто","перенёс","Своего раба","ночью","из","Мечети","Заповедной","к","Мечети","Отдалённой","которой","Мы благословили","окрестности","чтобы показать ему","из","Наших знамений","поистине, Он","Он","Слышащий","Видящий"]],[17,2,["وَءَاتَيۡنَا","مُوسَى","ٱلۡكِتَٰبَ","وَجَعَلۡنَٰهُ","هُدٗى","لِّبَنِيٓ","إِسۡرَٰٓءِيلَ","أَلَّا","تَتَّخِذُواْ","مِن","دُونِي","وَكِيلٗا"],"ва'атайна муусал китаба важа`алнаху худал либании исраиила алла таттахизуу мин дуунии вакиила","Мы даровали Мусе (Моисею) Писание и сделали его верным руководством для сынов Исраила (Израиля): «Не берите в покровители никого, кроме Меня!",["и Мы дали","Мусе","Писание","и сделали его","руководством","для сынов","Исраила","чтобы не","брали вы","помимо","Меня","покровителя"]],[17,3,["ذُرِّيَّةَ","مَنۡ","حَمَلۡنَا","مَعَ","نُوحٍۚ","إِنَّهُۥ","كَانَ","عَبۡدٗا","شَكُورٗا"],"зурриййата ман хамална ма`а нуухин иннахуу кана `абдан шакуура","О потомки тех, кого Мы перенесли вместе с Нухом (Ноем)! Воистину, он был благодарным рабом».",["о потомки","тех, кого","Мы несли","с","Нухом","поистине, он","был","рабом","благодарным"]],[17,4,["وَقَضَيۡنَآ","إِلَىٰ","بَنِيٓ","إِسۡرَٰٓءِيلَ","فِي","ٱلۡكِتَٰبِ","لَتُفۡسِدُنَّ","فِي","ٱلۡأَرۡضِ","مَرَّتَيۡنِ","وَلَتَعۡلُنَّ","عُلُوّٗا","كَبِيرٗا"],"ваḳадайна ила бании исраиила фил китаби латуфсидунна фил арди марратайни валата`лунна `улувван кабиира","Мы предопределили сынам Исраила (Израиля) в Писании: «Вы дважды будете бесчинствовать на земле и будете чрезмерно высокомерными».",["и Мы предопределили","для","сынов","Исраила","в","Писании","непременно вы будете бесчинствовать","на","земле","дважды","и непременно возвыситесь","превознесением","великим"]],[17,5,["فَإِذَا","جَآءَ","وَعۡدُ","أُولَىٰهُمَا","بَعَثۡنَا","عَلَيۡكُمۡ","عِبَادٗا","لَّنَآ","أُوْلِي","بَأۡسٖ","شَدِيدٖ","فَجَاسُواْ","خِلَٰلَ","ٱلدِّيَارِۚ","وَكَانَ","وَعۡدٗا","مَّفۡعُولٗا"],"фа'иза жаа ва`ду уулахума ба`асна `алайкум `ибадал лана улии ба'син шадиидин фажасуу хилалад дийари вакана ва`дам маф`уула","Когда настала пора первого из двух бесчинств, Мы наслали на вас Наших могущественных рабов, которые прошлись по землям. Так обещание было исполнено.",["и когда","пришло","обещание","первого из двух","Мы послали","на вас","рабов","Наших","обладающих","мощью","сильной","и они прошлись","среди","жилищ","и было","обещание","исполненным"]],[17,6,["ثُمَّ","رَدَدۡنَا","لَكُمُ","ٱلۡكَرَّةَ","عَلَيۡهِمۡ","وَأَمۡدَدۡنَٰكُم","بِأَمۡوَٰلٖ","وَبَنِينَ","وَجَعَلۡنَٰكُمۡ","أَكۡثَرَ","نَفِيرًا"],"сумма рададна лакумул каррата `алайхим ва'амдаднакум би'амвалин вабаниина важа`алнакум аксара нафиира","Затем Мы вновь даровали вам победу над ними. Мы поддержали вас богатством и сыновьями и сделали вас более многочисленными.",["затем","Мы вернули","вам","перевес","над ними","и Мы поддержали вас","имуществом","и сыновьями","и сделали вас","более","многочисленными"]],[17,7,["إِنۡ","أَحۡسَنتُمۡ","أَحۡسَنتُمۡ","لِأَنفُسِكُمۡۖ","وَإِنۡ","أَسَأۡتُمۡ","فَلَهَاۚ","فَإِذَا","جَآءَ","وَعۡدُ","ٱلۡأٓخِرَةِ","لِيَسُـُٔواْ","وُجُوهَكُمۡ","وَلِيَدۡخُلُواْ","ٱلۡمَسۡجِدَ","كَمَا","دَخَلُوهُ","أَوَّلَ","مَرَّةٖ","وَلِيُتَبِّرُواْ","مَا","عَلَوۡاْ","تَتۡبِيرًا"],"ин ахсантум ахсантум ли'анфусикум ва'ин аса'тум фалаха фа'иза жаа ва`дул ахирати лийасу'уу вужуухакум валийадхулул масжида кама дахалууху аввала марратин валийутаббируу ма `алау татбиира","Мы сказали: «Если вы творите добро, то поступаете во благо себе. А если вы вершите зло, то поступаете во вред себе». Когда же наступил срок последнего обещания, Мы позволили вашим врагам опечалить ваши лица, войти в Иерусалимскую мечеть подобно тому, как они вошли туда в первый раз, и до основания разрушить все, что попадало им в руки.",["если","вы творите добро","вы творите добро","для самих себя","а если","вы творите зло","то против себя","и когда","пришло","обещание","последнего","чтобы опечалили","ваши лица","и чтобы вошли","в Мечеть","как","вошли в неё","в первый","раз","и чтобы разрушили","то, что","захватили","полностью"]]],"m":[["h",17],["b"],[["سُبۡحَٰنَ","Пречист",17,1],["ٱلَّذِيٓ","Тот, Кто",17,1],["أَسۡرَىٰ","перенёс",17,1],["بِعَبۡدِهِۦ","Своего раба",17,1],["لَيۡلٗا","ночью",17,1],["مِّنَ","из",17,1],["ٱلۡمَسۡجِدِ","Мечети",17,1],["ٱلۡحَرَامِ","Заповедной",17,1]],[["إِلَى","к",17,1],["ٱلۡمَسۡجِدِ","Мечети",17,1],["ٱلۡأَقۡصَا","Отдалённой",17,1],["ٱلَّذِي","которой",17,1],["بَٰرَكۡنَا","Мы благословили",17,1],["حَوۡلَهُۥ","окрестности",17,1],["لِنُرِيَهُۥ","чтобы показать ему",17,1],["مِنۡ","из",17,1],["ءَايَٰتِنَآۚ","Наших знамений",17,1],["إِنَّهُۥ","поистине, Он",17,1]],[["هُوَ","Он",17,1],["ٱلسَّمِيعُ","Слышащий",17,1],["ٱلۡبَصِيرُ","Видящий",17,1],[1],["وَءَاتَيۡنَا","и Мы дали",17,2],["مُوسَى","Мусе",17,2],["ٱلۡكِتَٰبَ","Писание",17,2],["وَجَعَلۡنَٰهُ","и сделали его",17,2]],[["هُدٗى","руководством",17,2],["لِّبَنِيٓ","для сынов",17,2],["إِسۡرَٰٓءِيلَ","Исраила",17,2],["أَلَّا","чтобы не",17,2],["تَتَّخِذُواْ","брали вы",17,2],["مِن","помимо",17,2],["دُونِي","Меня",17,2],["وَكِيلٗا","покровителя",17,2],[2]],[["ذُرِّيَّةَ","о потомки",17,3],["مَنۡ","тех, кого",17,3],["حَمَلۡنَا","Мы несли",17,3],["مَعَ","с",17,3],["نُوحٍۚ","Нухом",17,3],["إِنَّهُۥ","поистине, он",17,3],["كَانَ","был",17,3],["عَبۡدٗا","рабом",17,3],["شَكُورٗا","благодарным",17,3],[3]],[["وَقَضَيۡنَآ","и Мы предопределили",17,4],["إِلَىٰ","для",17,4],["بَنِيٓ","сынов",17,4],["إِسۡرَٰٓءِيلَ","Исра