{"p":283,"j":15,"a":[[17,8,["عَسَىٰ","رَبُّكُمۡ","أَن","يَرۡحَمَكُمۡۚ","وَإِنۡ","عُدتُّمۡ","عُدۡنَاۚ","وَجَعَلۡنَا","جَهَنَّمَ","لِلۡكَٰفِرِينَ","حَصِيرًا"],"`аса раббукум ан йархамакум ва'ин `удттум `удна важа`ална жаханнама лилкафириина хасиира","Быть может, ваш Господь помилует вас. Но если вы вернетесь к бесчинству, то Мы также вернемся к наказанию. Мы сделали Геенну местом заточения для неверующих.",["может быть","ваш Господь","что","помилует вас","а если","вы вернётесь","Мы вернёмся","и Мы сделали","Геенну","для неверующих","темницей"]],[17,9,["إِنَّ","هَٰذَا","ٱلۡقُرۡءَانَ","يَهۡدِي","لِلَّتِي","هِيَ","أَقۡوَمُ","وَيُبَشِّرُ","ٱلۡمُؤۡمِنِينَ","ٱلَّذِينَ","يَعۡمَلُونَ","ٱلصَّٰلِحَٰتِ","أَنَّ","لَهُمۡ","أَجۡرٗا","كَبِيرٗا"],"инна хазал ḳур'ана йахдии лиллатии хийа аḳваму вайубашширул му'миниинал лазиина йа`малуунас салихати анна лахум ажран кабиира","Воистину, этот Коран указывает на самый правильный путь и возвещает верующим, которые совершают праведные деяния, благую весть о том, что им уготована великая награда.",["поистине","этот","Коран","ведёт","к тому, что","есть","самое прямое","и радует","верующих","тех, которые","совершают","праведные дела","что","им","награда","великая"]],[17,10,["وَأَنَّ","ٱلَّذِينَ","لَا","يُؤۡمِنُونَ","بِٱلۡأٓخِرَةِ","أَعۡتَدۡنَا","لَهُمۡ","عَذَابًا","أَلِيمٗا"],"ва'аннал лазиина ла йу'минууна бил'ахирати а`тадна лахум `азабан алиима","А тем, которые не веруют в Последнюю жизнь, Мы приготовили мучительные страдания.",["и что","те, которые","не","веруют","в Последнюю жизнь","Мы приготовили","для них","наказание","мучительное"]],[17,11,["وَيَدۡعُ","ٱلۡإِنسَٰنُ","بِٱلشَّرِّ","دُعَآءَهُۥ","بِٱلۡخَيۡرِۖ","وَكَانَ","ٱلۡإِنسَٰنُ","عَجُولٗا"],"вайад`ул инсану бишшарри ду`аахуу билхайри ваканал инсану `ажуула","Человек молит о зле подобно тому, как он молит о добре. Воистину, человек тороплив.",["и молит","человек","о зле","как он молит","о добре","и является","человек","торопливым"]],[17,12,["وَجَعَلۡنَا","ٱلَّيۡلَ","وَٱلنَّهَارَ","ءَايَتَيۡنِۖ","فَمَحَوۡنَآ","ءَايَةَ","ٱلَّيۡلِ","وَجَعَلۡنَآ","ءَايَةَ","ٱلنَّهَارِ","مُبۡصِرَةٗ","لِّتَبۡتَغُواْ","فَضۡلٗا","مِّن","رَّبِّكُمۡ","وَلِتَعۡلَمُواْ","عَدَدَ","ٱلسِّنِينَ","وَٱلۡحِسَابَۚ","وَكُلَّ","شَيۡءٖ","فَصَّلۡنَٰهُ","تَفۡصِيلٗا"],"важа`алнал лайла ваннахара айатайни фамахауна айатал лайли важа`ална айатан нахари мубсиратал литабтагуу фадлам мир раббикум валита`ламуу `ададас синиина валхисаба вакулла шай'ин фассалнаху тафсиила","Мы сделали ночь и день двумя знамениями. Мы погрузили во мрак знамение ночи, а знамение дня сделали светящимся, чтобы вы стремились к милости вашего Господа, могли вести летоисчисление и знали счет. Всякой вещи Мы дали исчерпывающее разъяснение.",["и Мы сделали","ночь","и день","двумя знамениями","и Мы стёрли","знамение","ночи","и сделали","знамение","дня","светлым","чтобы вы искали","милость","от","вашего Господа","и чтобы знали","число","лет","и счёт","и всякую","вещь","Мы разъяснили её","подробно"]],[17,13,["وَكُلَّ","إِنسَٰنٍ","أَلۡزَمۡنَٰهُ","طَٰٓئِرَهُۥ","فِي","عُنُقِهِۦۖ","وَنُخۡرِجُ","لَهُۥ","يَوۡمَ","ٱلۡقِيَٰمَةِ","كِتَٰبٗا","يَلۡقَىٰهُ","مَنشُورًا"],"вакулла инсанин алзамнаху та'ирахуу фии `унуḳихии ванухрижу лахуу йаумал ḳийамати китабан йалḳаху маншуура","Каждому человеку Мы повесили на шею его деяния (сделали их неразлучными с ним). А в День воскресения Мы представим ему книгу, которую он увидит развернутой.",["и всякому","человеку","Мы прикрепили","его участь","на","его шее","и Мы выведем","для него","в День","воскресения","книгу","которую он встретит","раскрытой"]],[17,14,["ٱقۡرَأۡ","كِتَٰبَكَ","كَفَىٰ","بِنَفۡسِكَ","ٱلۡيَوۡمَ","عَلَيۡكَ","حَسِيبٗا"],"иḳра' китабака кафа бинафсикал йаума `алайка хасииба","Читай свою книгу! Сегодня достаточно того, что ты сам сосчитаешь свои деяния против самого себя.",["читай","свою книгу","достаточно","тебя самого","сегодня","против тебя","счётчиком"]],[17,15,["مَّنِ","ٱهۡتَدَىٰ","فَإِنَّمَا","يَهۡتَدِي","لِنَفۡسِهِۦۖ","وَمَن","ضَلَّ","فَإِنَّمَا","يَضِلُّ","عَلَيۡهَاۚ","وَلَا","تَزِرُ","وَازِرَةٞ","وِزۡرَ","أُخۡرَىٰۗ","وَمَا","كُنَّا","مُعَذِّبِينَ","حَتَّىٰ","نَبۡعَثَ","رَسُولٗا"],"мманихтада фа'иннама йахтадии линафсихии ваман далла фа'иннама йадиллу `алайха вала тазиру вазиратун визра ухра вама кунна му`аззибиина хатта наб`аса расуула","Кто следует прямым путем, тот поступает во благо себе. А кто впадает в заблуждение, тот поступает во вред себе. Ни одна душа не понесет чужого бремени. Мы никогда не наказывали людей, не отправив к ним посланника.",["кто","последовал прямым путём","то лишь","он следует прямым путём","для себя","а кто","заблудился","то лишь","он заблуждается","во вред себе","и не","понесёт","несущая бремя","бремени","другой","и не","были Мы","наказывающими","пока не","Мы пошлём","посланника"]],[17,16,["وَإِذَآ","أَرَدۡنَآ","أَن","نُّهۡلِكَ","قَرۡيَةً","أَمَرۡنَا","مُتۡرَفِيهَا","فَفَسَقُواْ","فِيهَا","فَحَقَّ","عَلَيۡهَا","ٱلۡقَوۡلُ","فَدَمَّرۡنَٰهَا","تَدۡمِيرٗا"],"ва'иза арадна ан нухлика ḳарйатан амарна мутрафииха фафасаḳуу фииха фахаḳḳа `алайхал ḳаулу фадаммарнаха тадмиира","Когда Мы хотели погубить какое-либо селение, то повелевали его изнеженным роскошью жителям покориться Аллаху. Когда же они предавались нечестию, то относительно него сбывалось Слово, и Мы уничтожали его полностью.",["и когда","Мы пожелали","чтобы","Мы погубили","селение","Мы повелели","его роскошествующим","но они нечествовали","в нём","и сбылось","над ним","Слово","и Мы разрушили его","полностью"]],[17,17,["وَكَمۡ","أَهۡلَكۡنَا","مِنَ","ٱلۡقُرُونِ","مِنۢ","بَعۡدِ","نُوحٖۗ","وَكَفَىٰ","بِرَبِّكَ","بِذُنُوبِ","عِبَادِهِۦ","خَبِيرَۢا","بَصِيرٗا"],"вакам ахлакна минал ḳурууни мим ба`ди нуухин вакафа бираббика бизунууби `ибадихии хабиира басиира","Сколько же поколений мы погубили после Нуха (Ноя)! Достаточно того, что Аллах знает и видит грехи Своих рабов.",["и сколько","Мы погубили","из","поколений","уже","после","Нуха","и достаточно","твоего Господа","о грехах","Своих рабов","Ведающим","Видящим"]]],"m":[[["عَسَىٰ","может быть",17,8],["رَبُّكُمۡ