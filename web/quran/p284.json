{"p":284,"j":15,"a":[[17,18,["مَّن","كَانَ","يُرِيدُ","ٱلۡعَاجِلَةَ","عَجَّلۡنَا","لَهُۥ","فِيهَا","مَا","نَشَآءُ","لِمَن","نُّرِيدُ","ثُمَّ","جَعَلۡنَا","لَهُۥ","جَهَنَّمَ","يَصۡلَىٰهَا","مَذۡمُومٗا","مَّدۡحُورٗا"],"мман кана йуриидул `ажилата `ажжална лахуу фииха ма нашау лиман нурииду сумма жа`ална лахуу жаханнама йаслаха мазмуумам мадхуура","Если кто возжелает преходящей жизни, то Мы тотчас одарим тем, что пожелаем, того, кого пожелаем. А потом Мы предоставим ему Геенну, где он будет гореть презренным и отверженным.",["кто","будет","желать","скоротечного","Мы ускорим","ему","в нём","то, что","Мы пожелаем","тому, кому","Мы хотим","затем","Мы уготовили","ему","Геенну","он будет гореть в ней","порицаемым","отверженным"]],[17,19,["وَمَنۡ","أَرَادَ","ٱلۡأٓخِرَةَ","وَسَعَىٰ","لَهَا","سَعۡيَهَا","وَهُوَ","مُؤۡمِنٞ","فَأُوْلَٰٓئِكَ","كَانَ","سَعۡيُهُم","مَّشۡكُورٗا"],"ваман арадал ахирата васа`а лаха са`йаха вахуа му'минун фа'улаика кана са`йухум машкуура","А если кто возлюбит Последнюю жизнь и устремится к ней надлежащим образом, будучи верующим, то его старания будут отблагодарены.",["а кто","пожелал","Последней жизни","и стремился","к ней","должным стремлением","и он","верующий","то те","будет","их стремление","отблагодарённым"]],[17,20,["كُلّٗا","نُّمِدُّ","هَٰٓؤُلَآءِ","وَهَٰٓؤُلَآءِ","مِنۡ","عَطَآءِ","رَبِّكَۚ","وَمَا","كَانَ","عَطَآءُ","رَبِّكَ","مَحۡظُورًا"],"куллан нумидду ха'улаи вахаулаи мин `атаи раббика вама кана `атау раббика махзуура","Каждого из тех и других Мы наделяем дарами твоего Господа, и дары Его не являются запрещенными.",["каждому","Мы подаём","этим","и этим","из","даров","твоего Господа","и не","были","дары","твоего Господа","запретными"]],[17,21,["ٱنظُرۡ","كَيۡفَ","فَضَّلۡنَا","بَعۡضَهُمۡ","عَلَىٰ","بَعۡضٖۚ","وَلَلۡأٓخِرَةُ","أَكۡبَرُ","دَرَجَٰتٖ","وَأَكۡبَرُ","تَفۡضِيلٗا"],"инзур кайфа фаддална ба`дахум `ала ба`дин валал'ахирату акбару даражатин ва'акбару тафдиила","Посмотри, как одним из них Мы отдали предпочтение перед другими. Но Последняя жизнь, несомненно, выше по достоинству и преимуществу.",["смотри","как","Мы дали превосходство","одним из них","над","другими","а Последняя жизнь непременно","больше","степенями","и больше","превосходством"]],[17,22,["لَّا","تَجۡعَلۡ","مَعَ","ٱللَّهِ","إِلَٰهًا","ءَاخَرَ","فَتَقۡعُدَ","مَذۡمُومٗا","مَّخۡذُولٗا"],"лла таж`ал ма`аллахи илахан ахара фатаḳ`уда мазмуумам махзуула","Не поклоняйся наряду с Аллахом никакому другому богу, а не то сядешь униженным и покинутым.",["не","делай","с","Аллахом","бога","другого","а то сядешь","порицаемым","покинутым"]],[17,23,["وَقَضَىٰ","رَبُّكَ","أَلَّا","تَعۡبُدُوٓاْ","إِلَّآ","إِيَّاهُ","وَبِٱلۡوَٰلِدَيۡنِ","إِحۡسَٰنًاۚ","إِمَّا","يَبۡلُغَنَّ","عِندَكَ","ٱلۡكِبَرَ","أَحَدُهُمَآ","أَوۡ","كِلَاهُمَا","فَلَا","تَقُل","لَّهُمَآ","أُفّٖ","وَلَا","تَنۡهَرۡهُمَا","وَقُل","لَّهُمَا","قَوۡلٗا","كَرِيمٗا"],"ваḳада раббука алла та`будуу илла иййаху вабилвалидайни ихсанан имма йаблуганна `индакал кибара ахадухума ау килахума фала таḳул лахума уффин вала танхархума ваḳул лахума ḳаулан кариима","Твой Господь предписал вам не поклоняться никому, кроме Него, и делать добро родителям. Если один из родителей или оба достигнут старости, то не говори им: «Тьфу!». - не кричи на них и обращайся к ним почтительно.",["и предписал","твой Господь","чтобы не","поклонялись вы","кроме","Него одного","и к родителям","доброта","если","достигнет","при тебе","старости","один из них","или","оба они","то не","говори","им двоим","тьфу","и не","кричи на них","и говори","им","слово","почтительное"]],[17,24,["وَٱخۡفِضۡ","لَهُمَا","جَنَاحَ","ٱلذُّلِّ","مِنَ","ٱلرَّحۡمَةِ","وَقُل","رَّبِّ","ٱرۡحَمۡهُمَا","كَمَا","رَبَّيَانِي","صَغِيرٗا"],"вахфид лахума жанахаз зулли минар рахмати ваḳул рраббирхамхума кама раббайании сагиира","Склони пред ними крыло смирения по милосердию своему и говори: «Господи! Помилуй их, ведь они растили меня ребенком».",["и склони","перед ними","крыло","смирения","по","милосердию","и говори","Господи","помилуй их","как","они растили меня","маленьким"]],[17,25,["رَّبُّكُمۡ","أَعۡلَمُ","بِمَا","فِي","نُفُوسِكُمۡۚ","إِن","تَكُونُواْ","صَٰلِحِينَ","فَإِنَّهُۥ","كَانَ","لِلۡأَوَّٰبِينَ","غَفُورٗا"],"рраббукум а`ламу бима фии нуфуусикум ин такуунуу салихиина фа'иннахуу кана лил'аввабиина гафуура","Ваш Господь лучше всех знает то, что в ваших душах. И если вы будете праведниками, то ведь Он прощает тех, кто обращается к Нему с раскаянием.",["ваш Господь","лучше знает","то, что","в","ваших душах","если","вы будете","праведными","то поистине, Он","есть","к обращающимся","Прощающий"]],[17,26,["وَءَاتِ","ذَا","ٱلۡقُرۡبَىٰ","حَقَّهُۥ","وَٱلۡمِسۡكِينَ","وَٱبۡنَ","ٱلسَّبِيلِ","وَلَا","تُبَذِّرۡ","تَبۡذِيرًا"],"ва'ати зал ḳурба хаḳḳахуу валмискиина вабнас сабиили вала тубаззир табзиира","Отдавай должное родственнику, бедняку и путнику, но не расточай чрезмерно.",["и давай","обладателю","родства","его право","и бедняку","и сыну","пути","и не","расточай","расточительно"]],[17,27,["إِنَّ","ٱلۡمُبَذِّرِينَ","كَانُوٓاْ","إِخۡوَٰنَ","ٱلشَّيَٰطِينِۖ","وَكَانَ","ٱلشَّيۡطَٰنُ","لِرَبِّهِۦ","كَفُورٗا"],"иннал мубаззириина кануу ихванаш шайатиини ваканаш шайтану лираббихии кафуура","Воистину, расточители - братья дьяволов, а ведь дьявол неблагодарен своему Господу.",["поистине","расточители","являются","братьями","дьяволов","и является","дьявол","своему Господу","неблагодарным"]]],"m":[[["مَّن","кто",17,18],["كَانَ","будет",17,18],["يُرِيدُ","желать",17,18],["ٱلۡعَاجِلَةَ","скоротечного",17,18],["عَجَّلۡنَا","Мы ускорим",17,18],["لَهُۥ","ему",17,18],["فِيهَا","в нём",17,18],["مَا","то, что",17,18],["نَشَآءُ","Мы пожелаем",17,18],["لِمَن","тому, кому",17,18],["نُّرِيدُ","Мы хотим",17,18],["ثُمَّ","затем",17,18]],[["جَعَلۡنَا","Мы уготовили",17,18],["لَهُۥ","ему",17,18],["جَهَنَّمَ","Геенну",17,18],["يَصۡلَىٰهَا","он будет гореть в ней",17,18],["مَذۡمُومٗا","порицаемым",17,18],["مَّدۡحُورٗا","отверженным",17,18],[18],["وَمَنۡ","а кто",17,19],["أَرَادَ","пожелал",17,19]],[["ٱلۡأٓخِرَةَ","Последней жизни",17,19],["وَسَعَىٰ","и стремился",17,19],["لَهَا","к ней",17,19],["سَعۡيَهَا","должным стремлением",17,19],["وَهُوَ","и он",17,19],["مُؤۡمِنٞ","верующий",17,19],["فَأُوْلَٰٓئِكَ","то те",17,19],["كَانَ","будет",17,19]],[["سَعۡيُهُم","их стремление",17,19],["مَّشۡكُورٗا","отблагодарённым",17,19],[19],["كُلّٗا","каждому",17,20],["نُّمِدُّ","Мы подаём",17,20],["هَٰٓؤُلَآءِ","этим",17,20],["وَهَٰٓؤُلَآءِ","и этим",17,20],["مِنۡ","из",17,20],["عَطَآءِ","даров",17,20]],[["رَبِّكَۚ","твоего Господа",17,20],["وَمَا","и не",17,20],["كَانَ","были",17,20],["عَطَآءُ","дары",17,20],["رَبِّكَ","твоего Господа",17,20],["مَحۡظُورًا","запретными",17,20],[20],["ٱنظُرۡ","смотри",17,21],["كَيۡفَ","как",17,21],["فَضَّلۡنَا","Мы дали превосходство",17,21]],[["بَعۡضَهُمۡ","одним из них",17,21],["عَلَىٰ","над",17,21],["بَعۡضٖۚ","другими",17,21],["وَلَلۡأٓخِرَةُ","а Последняя жизнь непременно",17,21],["أَكۡبَرُ","больше",17,21],["دَرَجَٰتٖ","степенями",17,21],["وَأَكۡبَرُ","и больше",17,21],["تَفۡضِيلٗا","превосходством",17,21]],[[21],["لَّا","не",17,22],["تَجۡعَلۡ","делай",17,22],["مَعَ","с",17,22],["ٱللَّهِ","Аллахом",17,22],["إِلَٰهًا","бога",17,22],["ءَاخَرَ","другого",17,22],["فَتَقۡعُدَ","а то сядешь",17,22],["مَذۡمُومٗا","порицаемым",17,22],["مَّخۡذُولٗا","покинутым",17,22],[22]],[["۞ وَقَضَىٰ","и предписал",17,23],["رَبُّكَ","твой Господь",17,23],["أَلَّا","чтобы не",17,23],["تَعۡبُدُوٓاْ","поклонялись вы",17,23],["إِلَّآ","кроме",17,23],["إِيَّاهُ","Него одного",17,23],["وَبِٱلۡوَٰلِدَيۡنِ","и к родителям",17,23],["إِحۡسَٰنًاۚ","доброта",17,23],["إِمَّا","если",17,23]],[["يَبۡلُغَنَّ","достигнет",17,23],["عِندَكَ","при тебе",17,23],["ٱلۡكِبَرَ","старости",17,23],["أَحَدُهُمَآ","один из них",17,23],["أَوۡ","или",17,23],["كِلَاهُمَا","оба они",17,23],["فَلَا","то не",17,23],["تَقُل","говори",17,23],["لَّهُمَآ","им двоим",17,23]],[["أُفّٖ","тьфу",17,23],["وَلَا","и не",17,23],["تَنۡهَرۡهُمَا","кричи на них",17,23],["وَقُل","и говори",17,23],["لَّهُمَا","им",17,23],["قَوۡلٗا","слово",17,23],["كَرِيمٗا","почтительное",17,23],[23],["وَٱخۡفِضۡ","и склони",17,24]],[["لَهُمَا","перед ними",17,24],["جَنَاحَ","крыло",17,24],["ٱلذُّلِّ","смирения",17,24],["مِنَ","по",17,24],["ٱلرَّحۡمَةِ","милосердию",17,24],["وَقُل","и говори",17,24],["رَّبِّ","Господи",17,24],["ٱرۡحَمۡهُمَا","помилуй их",17,24],["كَمَا","как",17,24],["رَبَّيَانِي","они растили меня",17,24]],[["صَغِيرٗا","маленьким",17,24],[24],["رَّبُّكُمۡ","ваш Господь",17,25],["أَعۡلَمُ","лучше знает",17,25],["بِمَا","то, что",17,25],["فِي","в",17,25],["نُفُوسِكُمۡۚ","ваших душах",17,25],["إِن","если",17,25],["تَكُونُواْ","вы будете",17,25],["صَٰلِحِينَ","праведными",17,25]],[["فَإِنَّهُۥ","то поистине, Он",17,25],["كَانَ","есть",17,25],["لِلۡأَوَّٰبِينَ","к обращающимся",17,25],["غَفُورٗا","Прощающий",17,25],[25],["وَءَاتِ","и давай",17,26],["ذَا","обладателю",17,26],["ٱلۡقُرۡبَىٰ","родства",17,26],["حَقَّهُۥ","его право",17,26]],[["وَٱلۡمِسۡكِينَ","и бедняку",17,26],["وَٱبۡنَ","и сыну",17,26],["ٱلسَّبِيلِ","пути",17,26],["وَلَا","и не",17,26],["تُبَذِّرۡ","расточай",17,26],["تَبۡذِيرًا","расточительно",17,26],[26],["إِنَّ","поистине",17,27],["ٱلۡمُبَذِّرِينَ","расточители",17,27]],[["كَانُوٓاْ","являются",17,27],["إِخۡوَٰنَ","братьями",17,27],["ٱلشَّيَٰطِينِۖ","дьяволов",17,27],["وَكَانَ","и является",17,27],["ٱلشَّيۡطَٰنُ","дьявол",17,27],["لِرَبِّهِۦ","своему Господу",17,27],["كَفُورٗا","неблагодарным",17,27],[27]]]}