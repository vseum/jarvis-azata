{"p":285,"j":15,"a":[[17,28,["وَإِمَّا","تُعۡرِضَنَّ","عَنۡهُمُ","ٱبۡتِغَآءَ","رَحۡمَةٖ","مِّن","رَّبِّكَ","تَرۡجُوهَا","فَقُل","لَّهُمۡ","قَوۡلٗا","مَّيۡسُورٗا"],"ва'имма ту`риданна `анхумубтигаа рахматим мир раббика таржууха фаḳул лахум ḳаулам майсуура","Если ты отворачиваешься от них (если у тебя нет средств на пожертвования, и ты отказываешь тем, кто имеет на них право), желая обрести милость Аллаха, на которую ты надеешься, то говори с ними любезно.",["и если же","ты отворачиваешься","от них","стремясь к","милости","от","твоего Господа","надеясь на неё","то скажи","им","слово","мягкое"]],[17,29,["وَلَا","تَجۡعَلۡ","يَدَكَ","مَغۡلُولَةً","إِلَىٰ","عُنُقِكَ","وَلَا","تَبۡسُطۡهَا","كُلَّ","ٱلۡبَسۡطِ","فَتَقۡعُدَ","مَلُومٗا","مَّحۡسُورًا"],"вала таж`ал йадака маглуулатан ила `унуḳика вала табсутха куллал басти фатаḳ`уда малуумам махсуура","Не позволяй своей руке быть прикованной к шее, и не раскрывай ее во всю длину (не будь скуп и расточителен), а не то сядешь порицаемым и опечаленным.",["и не","делай","твою руку","прикованной","к","твоей шее","и не","раскрывай её","всем","раскрытием","а то сядешь","порицаемым","обнищавшим"]],[17,30,["إِنَّ","رَبَّكَ","يَبۡسُطُ","ٱلرِّزۡقَ","لِمَن","يَشَآءُ","وَيَقۡدِرُۚ","إِنَّهُۥ","كَانَ","بِعِبَادِهِۦ","خَبِيرَۢا","بَصِيرٗا"],"инна раббака йабсутур ризḳа лиман йашау вайаḳдиру иннахуу кана би`ибадихии хабиира басиира","Воистину, твой Господь увеличивает или ограничивает удел тому, кому пожелает. Он видит и знает Своих рабов.",["поистине","твой Господь","расширяет","удел","тому, кому","Он пожелает","и ограничивает","поистине, Он","есть","о Своих рабах","Ведающий","Видящий"]],[17,31,["وَلَا","تَقۡتُلُوٓاْ","أَوۡلَٰدَكُمۡ","خَشۡيَةَ","إِمۡلَٰقٖۖ","نَّحۡنُ","نَرۡزُقُهُمۡ","وَإِيَّاكُمۡۚ","إِنَّ","قَتۡلَهُمۡ","كَانَ","خِطۡـٔٗا","كَبِيرٗا"],"вала таḳтулуу ауладакум хашйата имлаḳин нахну нарзуḳухум ва'иййакум инна ḳатлахум кана хит'ан кабиира","Не убивайте своих детей, опасаясь нищеты, ведь Мы обеспечиваем пропитанием их вместе с вами. Воистину, убивать детей - тяжкий грех.",["и не","убивайте","ваших детей","из страха","бедности","Мы","наделяем их","и вас","поистине","убийство их","есть","грех","великий"]],[17,32,["وَلَا","تَقۡرَبُواْ","ٱلزِّنَىٰٓۖ","إِنَّهُۥ","كَانَ","فَٰحِشَةٗ","وَسَآءَ","سَبِيلٗا"],"вала таḳрабуз зина иннахуу кана фахишатан васаа сабиила","Не приближайтесь к прелюбодеянию, ибо оно является мерзостью и скверным путем.",["и не","приближайтесь к","прелюбодеянию","поистине, оно","есть","мерзость","и скверен","путь"]],[17,33,["وَلَا","تَقۡتُلُواْ","ٱلنَّفۡسَ","ٱلَّتِي","حَرَّمَ","ٱللَّهُ","إِلَّا","بِٱلۡحَقِّۗ","وَمَن","قُتِلَ","مَظۡلُومٗا","فَقَدۡ","جَعَلۡنَا","لِوَلِيِّهِۦ","سُلۡطَٰنٗا","فَلَا","يُسۡرِف","فِّي","ٱلۡقَتۡلِۖ","إِنَّهُۥ","كَانَ","مَنصُورٗا"],"вала таḳтулун нафсал латии харрамаллаху илла билхаḳḳи ваман ḳутила мазлууман фаḳад жа`ална ливалиййихии султанан фала йусриф фил ḳатли иннахуу кана мансуура","Не убивайте душу, убивать которую Аллах запретил, если только у вас нет на это права. Если ктолибо убит несправедливо, то Мы уже предоставили его правопреемнику полную власть, но пусть он не излишествует в отмщении за убийство. Воистину, ему будет оказана помощь.",["и не","убивайте","душу","которую","запретил","Аллах","кроме как","по праву","а кто","убит","несправедливо","то уже","Мы дали","его наследнику","власть","но пусть не","излишествует","в","убийстве","поистине, он","есть","поддержан"]],[17,34,["وَلَا","تَقۡرَبُواْ","مَالَ","ٱلۡيَتِيمِ","إِلَّا","بِٱلَّتِي","هِيَ","أَحۡسَنُ","حَتَّىٰ","يَبۡلُغَ","أَشُدَّهُۥۚ","وَأَوۡفُواْ","بِٱلۡعَهۡدِۖ","إِنَّ","ٱلۡعَهۡدَ","كَانَ","مَسۡـُٔولٗا"],"вала таḳрабуу малал йатиими илла биллатии хийа ахсану хатта йаблуга ашуддахуу ва'ауфуу бил`ахди иннал `ахда кана мас'уула","Не приближайтесь к имуществу сироты, кроме как во благо ему, пока он не достигнет совершеннолетия. И будьте верны своим обещаниям, ибо за обещания вас призовут к ответу.",["и не","приближайтесь к","имуществу","сироты","кроме как","тем, что","оно","наилучшее","пока не","достигнет он","своей зрелости","и соблюдайте","обещание","поистине","обещание","будет","спрошено"]],[17,35,["وَأَوۡفُواْ","ٱلۡكَيۡلَ","إِذَا","كِلۡتُمۡ","وَزِنُواْ","بِٱلۡقِسۡطَاسِ","ٱلۡمُسۡتَقِيمِۚ","ذَٰلِكَ","خَيۡرٞ","وَأَحۡسَنُ","تَأۡوِيلٗا"],"ва'ауфул кайла иза килтум вазинуу билḳистасил мустаḳиими залика хайрун ва'ахсану та'виила","Наполняйте меру сполна, когда вы отпускаете мерой, и взвешивайте на точных весах. Так будет лучше и прекраснее по исходу (или по вознаграждению).",["и наполняйте сполна","меру","когда","вы отмеряете","и взвешивайте","на весах","верных","это","лучше","и прекраснее","по исходу"]],[17,36,["وَلَا","تَقۡفُ","مَا","لَيۡسَ","لَكَ","بِهِۦ","عِلۡمٌۚ","إِنَّ","ٱلسَّمۡعَ","وَٱلۡبَصَرَ","وَٱلۡفُؤَادَ","كُلُّ","أُوْلَٰٓئِكَ","كَانَ","عَنۡهُ","مَسۡـُٔولٗا"],"вала таḳфу ма лайса лака бихии `илмун иннас сам`а валбасара валфуада куллу улаика кана `анху мас'уула","Не следуй тому, чего ты не знаешь. Воистину, слух, зрение и сердце - все они будут призваны к ответу.",["и не","следуй","тому, чего","нет","у тебя","о нём","знания","поистине","слух","и зрение","и сердце","все","они","будет","о нём","спрошено"]],[17,37,["وَلَا","تَمۡشِ","فِي","ٱلۡأَرۡضِ","مَرَحًاۖ","إِنَّكَ","لَن","تَخۡرِقَ","ٱلۡأَرۡضَ","وَلَن","تَبۡلُغَ","ٱلۡجِبَالَ","طُولٗا"],"вала тамши фил арди марахан иннака лан тахриḳал арда валан таблугал жибала туула","Не ступай по земле горделиво, ведь ты не пробуришь землю и не достигнешь гор высотой!",["и не","ходи","по","земле","горделиво","поистине, ты","никогда не","пробьёшь","землю","и никогда не","достигнешь","гор","высотой"]],[17,38,["كُلُّ","ذَٰلِكَ","كَانَ","سَيِّئُهُۥ","عِندَ","رَبِّكَ","مَكۡرُوهٗا"],"куллу залика кана саййиухуу `инда раббика макрууха","Все это зло ненавистно твоему Господу.",["всё","это","было","зло его","у","твоего Господа","ненавистным"]]],"m":[[["وَإِمَّا","и если же",17,28],["تُعۡرِضَنَّ","ты отворачиваешься",17,28],["عَنۡهُمُ","от них",17,28],["ٱبۡتِغَآءَ","стремясь к",17,28],["رَحۡمَةٖ","милости",17,28],["مِّن","от",17,28],["رَّبِّكَ","твоего Господа",17,28],["تَرۡجُوهَا","надеясь на неё",17,28],["فَقُل","то скажи",17,28],["لَّهُمۡ","им",17,28],["قَوۡلٗا","слово",17,28]],[["مَّيۡسُورٗا","мягкое",17,28],[28],["وَلَا","и не",17,29],["تَجۡعَلۡ","делай",17,29],["يَدَكَ","твою руку",17,29],["مَغۡلُولَةً","прикованной",17,29],["إِلَىٰ","к",17,29],["عُنُقِكَ","твоей шее",17,29],["وَلَا","и не",17,29],["تَبۡسُطۡهَا","раскрывай её",17,29]],[["كُلَّ","всем",17,29],["ٱلۡبَسۡطِ","раскрытием",17,29],["فَتَقۡعُدَ","а то сядешь",17,29],["مَلُومٗا","порицаемым",17,29],["مَّحۡسُورًا","обнищавшим",17,29],[29],["إِنَّ","поистине",17,30],["رَبَّكَ","твой Господь",17,30],["يَبۡسُطُ","расширяет",17,30],["ٱلرِّزۡقَ","удел",17,30]],[["لِمَن","тому, кому",17,30],["يَشَآءُ","Он пожелает",17,30],["وَيَقۡدِرُۚ","и ограничивает",17,30],["إِنَّهُۥ","поистине, Он",17,30],["كَانَ","есть",17,30],["بِعِبَادِهِۦ","о Своих рабах",17,30],["خَبِيرَۢا","Ведающий",17,30],["بَصِيرٗا","Видящий",17,30],[30],["وَلَا","и не",17,31],["تَقۡتُلُوٓاْ","убивайте",17,31]],[["أَوۡلَٰدَكُمۡ","ваших детей",17,31],["خَشۡيَةَ","из страха",17,31],["إِمۡلَٰقٖۖ","бедности",17,31],["نَّحۡنُ","Мы",17,31],["نَرۡزُقُهُمۡ","наделяем их",17,31],["وَإِيَّاكُمۡۚ","и вас",17,31],["إِنَّ","поистине",17,31],["قَتۡلَهُمۡ","убийство их",17,31],["كَانَ","есть",17,31]],[["خِطۡـٔٗا","грех",17,31],["كَبِيرٗا","великий",17,31],[31],["وَلَا","и не",17,32],["تَقۡرَبُواْ","приближайтесь к",17,32],["ٱلزِّنَىٰٓۖ","прелюбодеянию",17,32],["إِنَّهُۥ","поистине, оно",17,32],["كَانَ","есть",17,32],["فَٰحِشَةٗ","мерзость",17,32],["وَسَآءَ","и скверен",17,32]],[["سَبِيلٗا","путь",17,32],[32],["وَلَا","и не",17,33],["تَقۡتُلُواْ","убивайте",17,33],["ٱلنَّفۡسَ","душу",17,33],["ٱلَّتِي","которую",17,33],["حَرَّمَ","запретил",17,33],["ٱللَّهُ","Аллах",17,33],["إِلَّا","кроме как",17,33],["بِٱلۡحَقِّۗ","по праву",17,33],["وَمَن","а кто",17,33]],[["قُتِلَ","убит",17,33],["مَظۡلُومٗا","несправедливо",17,33],["فَقَدۡ","то уже",17,33],["جَعَلۡنَا","Мы дали",17,33],["لِوَلِيِّهِۦ","его наследнику",17,33],["سُلۡطَٰنٗا","власть",17,33],["فَلَا","но пусть не",17,33],["يُسۡرِف","излишествует",17,33],["فِّي","в",17,33]],[["ٱلۡقَتۡلِۖ","убийстве",17,33],["إِنَّهُۥ","поистине, он",17,33],["كَانَ","есть",17,33],["مَنصُورٗا","поддержан",17,33],[33],["وَلَا","и не",17,34],["تَقۡرَبُواْ","приближайтесь к",17,34],["مَالَ","имуществу",17,34],["ٱلۡيَتِيمِ","сироты",17,34],["إِلَّا","кроме как",17,34],["بِٱلَّتِي","тем, что",17,34]],[["هِيَ","оно",17,34],["أَحۡسَنُ","наилучшее",17,34],["حَتَّىٰ","пока не",17,34],["يَبۡلُغَ","достигнет он",17,34],["أَشُدَّهُۥۚ","своей зрелости",17,34],["وَأَوۡفُواْ","и соблюдайте",17,34],["بِٱلۡعَهۡدِۖ","обещание",17,34],["إِنَّ","поистине",17,34],["ٱلۡعَهۡدَ","обещание",17,34],["كَانَ","будет",17,34]],[["مَسۡـُٔولٗا","спрошено",17,34],[34],["وَأَوۡفُواْ","и наполняйте сполна",17,35],["ٱلۡكَيۡلَ","меру",17,35],["إِذَا","когда",17,35],["كِلۡتُمۡ","вы отмеряете",17,35],["وَزِنُواْ","и взвешивайте",17,35],["بِٱلۡقِسۡطَاسِ","на весах",17,35],["ٱلۡمُسۡتَقِيمِۚ","верных",17,35]],[["ذَٰلِكَ","это",17,35],["خَيۡرٞ","лучше",17,35],["وَأَحۡسَنُ","и прекраснее",17,35],["تَأۡوِيلٗا","по исходу",17,35],[35],["وَلَا","и не",17,36],["تَقۡفُ","следуй",17,36],["مَا","тому, чего",17,36],["لَيۡسَ","нет",17,36],["لَكَ","у тебя",17,36],["بِهِۦ","о нём",17,36],["عِلۡمٌۚ","знания",17,36]],[["إِنَّ","поистине",17,36],["ٱلسَّمۡعَ","слух",17,36],["وَٱلۡبَصَرَ","и зрение",17,36],["وَٱلۡفُؤَادَ","и сердце",17,36],["كُلُّ","все",17,36],["أُوْلَٰٓئِكَ","они",17,36],["كَانَ","будет",17,36],["عَنۡهُ","о нём",17,36],["مَسۡـُٔولٗا","спрошено",17,36],[36]],[["وَلَا","и не",17,37],["تَمۡشِ","ходи",17,37],["فِي","по",17,37],["ٱلۡأَرۡضِ","земле",17,37],["مَرَحًاۖ","горделиво",17,37],["إِنَّكَ","поистине, ты",17,37],["لَن","никогда не",17,37],["تَخۡرِقَ","пробьёшь",17,37],["ٱلۡأَرۡضَ","землю",17,37],["وَلَن","и никогда не",17,37],["تَبۡلُغَ","достигнешь",17,37]],[["ٱلۡجِبَالَ","гор",17,37],["طُولٗا","высотой",17,37],[37],["كُلُّ","всё",17,38],["ذَٰلِكَ","это",17,38],["كَانَ","было",17,38],["سَيِّئُهُۥ","зло его",17,38],["عِندَ","у",17,38],["رَبِّكَ","твоего Господа",17,38],["مَكۡرُوهٗا","ненавистным",17,38],[38]]]}