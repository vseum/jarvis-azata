{"p":286,"j":15,"a":[[17,39,["ذَٰلِكَ","مِمَّآ","أَوۡحَىٰٓ","إِلَيۡكَ","رَبُّكَ","مِنَ","ٱلۡحِكۡمَةِۗ","وَلَا","تَجۡعَلۡ","مَعَ","ٱللَّهِ","إِلَٰهًا","ءَاخَرَ","فَتُلۡقَىٰ","فِي","جَهَنَّمَ","مَلُومٗا","مَّدۡحُورًا"],"залика мимма ауха илайка раббука минал хикмати вала таж`ал ма`аллахи илахан ахара фатулḳа фии жаханнама малуумам мадхуура","Такова часть мудрости, которая внушена тебе в откровении от твоего Господа. Не поклоняйся наряду с Аллахом никакому другому богу, а не то будешь брошен в Геенну порицаемым и отверженным.",["это","из того, что","внушил","тебе","твой Господь","из","мудрости","и не","делай","с","Аллахом","бога","другого","а то будешь брошен","в","Геенну","порицаемым","отверженным"]],[17,40,["أَفَأَصۡفَىٰكُمۡ","رَبُّكُم","بِٱلۡبَنِينَ","وَٱتَّخَذَ","مِنَ","ٱلۡمَلَٰٓئِكَةِ","إِنَٰثًاۚ","إِنَّكُمۡ","لَتَقُولُونَ","قَوۡلًا","عَظِيمٗا"],"афаасфакум раббукум билбаниина ваттахаза минал малаикати инасан иннакум латаḳуулууна ḳаулан `азиима","Неужели ваш Господь почтил вас сыновьями, а Себе взял дочерей из числа ангелов? Воистину, вы говорите ужасные слова.",["неужели избрал для вас","ваш Господь","сыновей","и взял","из","ангелов","дочерей","поистине, вы","непременно говорите","слово","ужасное"]],[17,41,["وَلَقَدۡ","صَرَّفۡنَا","فِي","هَٰذَا","ٱلۡقُرۡءَانِ","لِيَذَّكَّرُواْ","وَمَا","يَزِيدُهُمۡ","إِلَّا","نُفُورٗا"],"валаḳад саррафна фии хазал ḳур'ани лийаззаккаруу вама йазиидухум илла нуфуура","Мы дали разъяснения в этом Коране, чтобы они помянули наставление, но это лишь увеличивает их отвращение.",["и уже","Мы разъяснили","в","этом","Коране","чтобы они помянули","но не","увеличивает это их","кроме как","отвращением"]],[17,42,["قُل","لَّوۡ","كَانَ","مَعَهُۥٓ","ءَالِهَةٞ","كَمَا","يَقُولُونَ","إِذٗا","لَّٱبۡتَغَوۡاْ","إِلَىٰ","ذِي","ٱلۡعَرۡشِ","سَبِيلٗا"],"ḳул лау кана ма`ахуу алихатун кама йаḳуулууна изал лабтагау ила зил `арши сабиила","Скажи: «Если бы, как они говорят, наряду с Ним существовали другие боги, то они непременно попытались бы добраться до Господа Трона».",["скажи","если бы","были","с Ним","боги","как","они говорят","тогда","непременно искали бы они","к","Обладателю","Трона","путь"]],[17,43,["سُبۡحَٰنَهُۥ","وَتَعَٰلَىٰ","عَمَّا","يَقُولُونَ","عُلُوّٗا","كَبِيرٗا"],"субханахуу вата`ала `амма йаḳуулууна `улувван кабиира","Пречист Он и премного выше того, что они говорят.",["пречист Он","и превыше","того, что","говорят","высотой","великой"]],[17,44,["تُسَبِّحُ","لَهُ","ٱلسَّمَٰوَٰتُ","ٱلسَّبۡعُ","وَٱلۡأَرۡضُ","وَمَن","فِيهِنَّۚ","وَإِن","مِّن","شَيۡءٍ","إِلَّا","يُسَبِّحُ","بِحَمۡدِهِۦ","وَلَٰكِن","لَّا","تَفۡقَهُونَ","تَسۡبِيحَهُمۡۚ","إِنَّهُۥ","كَانَ","حَلِيمًا","غَفُورٗا"],"тусаббиху лахус самаватус саб`у вал'арду ваман фиихинна ва'им мин шай'ин илла йусаббиху бихамдихии валакил ла тафḳахууна тасбиихахум иннахуу кана халииман гафуура","Его славят семь небес, земля и те, кто на них. Нет ничего, что не прославляло бы Его хвалой, но вы не понимаете их славословия. Воистину, Он - Выдержанный, Прощающий.",["славят","Его","небеса","семь","и земля","и те, кто","на них","и нет","из","вещи","кроме как","славит","хвалой Его","но","не","понимаете вы","их славословия","поистине, Он","есть","Выдержанный","Прощающий"]],[17,45,["وَإِذَا","قَرَأۡتَ","ٱلۡقُرۡءَانَ","جَعَلۡنَا","بَيۡنَكَ","وَبَيۡنَ","ٱلَّذِينَ","لَا","يُؤۡمِنُونَ","بِٱلۡأٓخِرَةِ","حِجَابٗا","مَّسۡتُورٗا"],"ва'иза ḳара'тал ḳур'ана жа`ална байнака вабайнал лазиина ла йу'минууна бил'ахирати хижабам мастуура","Когда ты прочел Коран, Мы воздвигли между тобой и теми, кто не верит в Последнюю жизнь, невидимую завесу.",["и когда","ты читаешь","Коран","Мы помещаем","между тобой","и между","теми, которые","не","веруют","в Последнюю жизнь","завесу","скрытую"]],[17,46,["وَجَعَلۡنَا","عَلَىٰ","قُلُوبِهِمۡ","أَكِنَّةً","أَن","يَفۡقَهُوهُ","وَفِيٓ","ءَاذَانِهِمۡ","وَقۡرٗاۚ","وَإِذَا","ذَكَرۡتَ","رَبَّكَ","فِي","ٱلۡقُرۡءَانِ","وَحۡدَهُۥ","وَلَّوۡاْ","عَلَىٰٓ","أَدۡبَٰرِهِمۡ","نُفُورٗا"],"важа`ална `ала ḳулуубихим акиннатан ан йафḳахууху вафии азанихим ваḳран ва'иза закарта раббака фил ḳур'ани вахдахуу валлау `ала адбарихим нуфуура","Мы набросили на их сердца покрывала, дабы они не могли понять его (Коран), и лишили их уши слуха. Когда ты поминаешь в Коране своего Единственного Господа, они отворачиваются, испытывая к этому отвращение.",["и Мы поместили","на","их сердца","покровы","чтобы не","поняли они его","и в","их уши","глухоту","и когда","ты поминаешь","твоего Господа","в","Коране","Одного","они поворачиваются","на","свои спины","в отвращении"]],[17,47,["نَّحۡنُ","أَعۡلَمُ","بِمَا","يَسۡتَمِعُونَ","بِهِۦٓ","إِذۡ","يَسۡتَمِعُونَ","إِلَيۡكَ","وَإِذۡ","هُمۡ","نَجۡوَىٰٓ","إِذۡ","يَقُولُ","ٱلظَّٰلِمُونَ","إِن","تَتَّبِعُونَ","إِلَّا","رَجُلٗا","مَّسۡحُورًا"],"ннахну а`ламу бима йастами`ууна бихии из йастами`ууна илайка ва'из хум нажва из йаḳуулуз залимууна ин таттаби`ууна илла ражулам масхуура","Мы лучше знаем, что именно они слушают, когда слушают тебя. А когда они совещаются втайне, то беззаконники говорят: «Вы следуете всего лишь за околдованным человеком».",["Мы","лучше знаем","то, с чем","они слушают","это","когда","они слушают","тебя","и когда","они","тайно совещаются","когда","говорят","беззаконники","не","следуете вы","кроме как","человеку","околдованному"]],[17,48,["ٱنظُرۡ","كَيۡفَ","ضَرَبُواْ","لَكَ","ٱلۡأَمۡثَالَ","فَضَلُّواْ","فَلَا","يَسۡتَطِيعُونَ","سَبِيلٗا"],"инзур кайфа дарабуу лакал амсала фадаллуу фала йастатии`ууна сабиила","Посмотри, какие притчи они приводят тебе. Они впали в заблуждение и не могут найти дорогу.",["посмотри","как","они привели","тебе","притчи","и заблудились они","и не","могут они","найти путь"]],[17,49,["وَقَالُوٓاْ","أَءِذَا","كُنَّا","عِظَٰمٗا","وَرُفَٰتًا","أَءِنَّا","لَمَبۡعُوثُونَ","خَلۡقٗا","جَدِيدٗا"],"ваḳалуу а'иза кунна `изаман варуфатан а'инна ламаб`уусууна халḳан жадиида","Они скажут: «Неужели после того, как от нас останутся кости и частички, мы будем воскрешены в новом творении?».",["и сказали они","неужели когда","мы станем","костями","и прахом","неужели мы","непременно воскреше