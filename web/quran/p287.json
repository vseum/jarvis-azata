{"p":287,"j":15,"a":[[17,50,["قُلۡ","كُونُواْ","حِجَارَةً","أَوۡ","حَدِيدًا"],"ḳул куунуу хижаратан ау хадиида","Скажи: «Даже если вы станете камнями, или железом,",["скажи","будьте","камнями","или","железом"]],[17,51,["أَوۡ","خَلۡقٗا","مِّمَّا","يَكۡبُرُ","فِي","صُدُورِكُمۡۚ","فَسَيَقُولُونَ","مَن","يُعِيدُنَاۖ","قُلِ","ٱلَّذِي","فَطَرَكُمۡ","أَوَّلَ","مَرَّةٖۚ","فَسَيُنۡغِضُونَ","إِلَيۡكَ","رُءُوسَهُمۡ","وَيَقُولُونَ","مَتَىٰ","هُوَۖ","قُلۡ","عَسَىٰٓ","أَن","يَكُونَ","قَرِيبٗا"],"ау халḳам мимма йакбуру фии судуурикум фасайаḳуулууна ман йу`иидуна ḳулил лазии фатаракум аввала марратин фасайунгидууна илайка ру'уусахум вайаḳуулууна мата хуа ḳул `аса ан йакууна ḳарииба","или другим творением, которое представляется могучим в ваших сердцах». Они скажут: «Кто же нас возвратит?». Скажи: «Тот, Кто сотворил вас в первый раз». Но они покачают головами и скажут: «Когда же это произойдет?». Скажи: «Быть может, это произойдет очень скоро!».",["или","творением","из того, что","велико","в","ваших грудях","и скажут они","кто","вернёт нас","скажи","Тот, Кто","сотворил вас","в первый","раз","и покачают они","перед тобой","своими головами","и говорят","когда","это","скажи","быть может","что","будет","близко"]],[17,52,["يَوۡمَ","يَدۡعُوكُمۡ","فَتَسۡتَجِيبُونَ","بِحَمۡدِهِۦ","وَتَظُنُّونَ","إِن","لَّبِثۡتُمۡ","إِلَّا","قَلِيلٗا"],"йаума йад`уукум фатастажиибууна бихамдихии ватазуннууна ил лабистум илла ḳалиила","В тот день Он призовет вас, и вы ответите Ему похвалой и предположите, что пробыли на земле совсем недолго.",["в день, когда","Он призовёт вас","и вы ответите","хвалой Ему","и подумаете","не","пробыли вы","кроме как","немного"]],[17,53,["وَقُل","لِّعِبَادِي","يَقُولُواْ","ٱلَّتِي","هِيَ","أَحۡسَنُۚ","إِنَّ","ٱلشَّيۡطَٰنَ","يَنزَغُ","بَيۡنَهُمۡۚ","إِنَّ","ٱلشَّيۡطَٰنَ","كَانَ","لِلۡإِنسَٰنِ","عَدُوّٗا","مُّبِينٗا"],"ваḳул ли`ибадии йаḳуулул латии хийа ахсану иннаш шайтана йанзагу байнахум иннаш шайтана кана лил'инсани `адуввам мубиина","Скажи Моим рабам, чтобы они говорили наилучшие слова, ибо дьявол вносит между ними раздор. Воистину, дьявол для человека - явный враг.",["и скажи","Моим рабам","пусть говорят","то, что","оно","наилучшее","поистине","дьявол","сеет раздор","между ними","поистине","дьявол","есть","для человека","врагом","явным"]],[17,54,["رَّبُّكُمۡ","أَعۡلَمُ","بِكُمۡۖ","إِن","يَشَأۡ","يَرۡحَمۡكُمۡ","أَوۡ","إِن","يَشَأۡ","يُعَذِّبۡكُمۡۚ","وَمَآ","أَرۡسَلۡنَٰكَ","عَلَيۡهِمۡ","وَكِيلٗا"],"рраббукум а`ламу бикум ин йаша' йархамкум ау ин йаша' йу`аззибкум вама арсалнака `алайхим вакиила","Вашему Господу лучше знать вас. Если Он пожелает, то смилостивится над вами, а если пожелает, то подвергнет вас мучениям. Мы не посылали тебя их попечителем и хранителем.",["ваш Господь","лучше знает","вас","если","Он пожелает","помилует вас","или","если","Он пожелает","накажет вас","и не","Мы послали тебя","над ними","попечителем"]],[17,55,["وَرَبُّكَ","أَعۡلَمُ","بِمَن","فِي","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِۗ","وَلَقَدۡ","فَضَّلۡنَا","بَعۡضَ","ٱلنَّبِيِّـۧنَ","عَلَىٰ","بَعۡضٖۖ","وَءَاتَيۡنَا","دَاوُۥدَ","زَبُورٗا"],"вараббука а`ламу биман фис самавати вал'арди валаḳад фаддална ба`дан набиййиина `ала ба`дин ва'атайна давууда забуура","Твоему Господу лучше знать тех, кто на небесах и на земле. Одним пророкам Мы отдали предпочтение над другими. А Давуду (Давиду) Мы даровали Забур (Псалтирь).",["и твой Господь","лучше знает","тех, кто","на","небесах","и земле","и уже","Мы дали превосходство","одним","из пророков","над","другими","и Мы дали","Давуду","Забур"]],[17,56,["قُلِ","ٱدۡعُواْ","ٱلَّذِينَ","زَعَمۡتُم","مِّن","دُونِهِۦ","فَلَا","يَمۡلِكُونَ","كَشۡفَ","ٱلضُّرِّ","عَنكُمۡ","وَلَا","تَحۡوِيلًا"],"ḳулид`ул лазиина за`амтум мин дуунихии фала йамликууна кашфад дурри `анкум вала тахвиила","Скажи: «Взывайте к тем, кого вы считаете богами наряду с Ним. Они не властны отвратить от вас беду или перенести ее на другого».",["скажи","призовите","тех, которых","вы считали (богами)","из","помимо Него","и не","властны они","устранить","беду","от вас","и не","перенести"]],[17,57,["أُوْلَٰٓئِكَ","ٱلَّذِينَ","يَدۡعُونَ","يَبۡتَغُونَ","إِلَىٰ","رَبِّهِمُ","ٱلۡوَسِيلَةَ","أَيُّهُمۡ","أَقۡرَبُ","وَيَرۡجُونَ","رَحۡمَتَهُۥ","وَيَخَافُونَ","عَذَابَهُۥٓۚ","إِنَّ","عَذَابَ","رَبِّكَ","كَانَ","مَحۡذُورٗا"],"улаикал лазиина йад`ууна йабтагууна ила раббихимул васиилата аййухум аḳрабу вайаржууна рахматахуу вайахафууна `азабахуу инна `азаба раббика кана махзуура","Те, к кому они взывают с мольбой, сами ищут близости к своему Господу, пытаясь опередить других. Они надеются на Его милость и страшатся мучений от Него. Воистину, мучений от твоего Господа надлежит остерегаться.",["те","которых","они призывают","ищут","к","своему Господу","средство приближения","кто из них","ближе","и надеются","на Его милость","и страшатся","Его наказания","поистине","наказание","твоего Господа","есть","внушающее страх"]],[17,58,["وَإِن","مِّن","قَرۡيَةٍ","إِلَّا","نَحۡنُ","مُهۡلِكُوهَا","قَبۡلَ","يَوۡمِ","ٱلۡقِيَٰمَةِ","أَوۡ","مُعَذِّبُوهَا","عَذَابٗا","شَدِيدٗاۚ","كَانَ","ذَٰلِكَ","فِي","ٱلۡكِتَٰبِ","مَسۡطُورٗا"],"ва'им мин ḳарйатин илла нахну мухликууха ḳабла йаумил ḳийамати ау му`аззибууха `азабан шадиидан кана залика фил китаби мастуура","Нет такого поселения, которое Мы не разрушим перед наступлением Дня воскресения или не подвергнем тяжким мучениям. Так было предначертано в Писании.",["и нет","из","поселения","кроме как","Мы","погубим его","до","дня","воскресения","или","накажем его","наказанием","суровым","было","это","в","Писании","начертано"]]],"m":[[["۞ قُلۡ","скажи",17,50],["كُونُواْ","будьте",17,50],["حِجَارَةً","камнями",17,50],["أَوۡ","или",17,50],["حَدِيدًا","железом",17,50],[50],["أَوۡ","или",17,51],["خَلۡقٗا","творением",17,51],["مِّمَّا","из того, что",17,51],["يَكۡبُرُ","велико",17,51],["فِي","в",17,51]],[["صُدُورِكُمۡۚ","ваших грудях",17,51],["فَسَيَقُولُونَ","и скажут они",17,51],["مَن","кто",17,51],["يُعِيدُنَاۖ","вернёт нас",17,51],["قُلِ","скажи",17,51],["ٱلَّذِي","Тот, Кто",17,51],["فَطَرَكُمۡ","сотворил вас",17,51],["أَوَّلَ","в первый",17,51],["مَرَّةٖۚ","раз",17,51]],[["فَسَيُنۡغِضُونَ","и покачают они",17,51],["إِلَيۡكَ","перед тобой",17,51],["رُءُوسَهُمۡ","своими головами",17,51],["وَيَقُولُونَ","и говорят",17,51],["مَتَىٰ","когда",17,51],["هُوَۖ","это",17,51],["قُلۡ","скажи",17,51],["عَسَىٰٓ","быть может",17,51],["أَن","что",17,51]],[["يَكُونَ","будет",17,51],["قَرِيبٗا","близко",17,51],[51],["يَوۡمَ","в день, когда",17,52],["يَدۡعُوكُمۡ","Он призовёт вас",17,52],["فَتَسۡتَجِيبُونَ","и вы ответите",17,52],["بِحَمۡدِهِۦ","хвалой Ему",17,52]],[["وَتَظُنُّونَ","и подумаете",17,52],["إِن","не",17,52],["لَّبِثۡتُمۡ","пробыли вы",17,52],["إِلَّا","кроме как",17,52],["قَلِيلٗا","немного",17,52],[52],["وَقُل","и скажи",17,53],["لِّعِبَادِي","Моим рабам",17,53],["يَقُولُواْ","пусть говорят",17,53],["ٱلَّتِي","то, что",17,53],["هِيَ","оно",17,53]],[["أَحۡسَنُۚ","наилучшее",17,53],["إِنَّ","поистине",17,53],["ٱلشَّيۡطَٰنَ","дьявол",17,53],["يَنزَغُ","сеет раздор",17,53],["بَيۡنَهُمۡۚ","между ними",17,53],["إِنَّ","поистине",17,53],["ٱلشَّيۡطَٰنَ","дьявол",17,53],["كَانَ","есть",17,53],["لِلۡإِنسَٰنِ","для человека",17,53]],[["عَدُوّٗا","врагом",17,53],["مُّبِينٗا","явным",17,53],[53],["رَّبُّكُمۡ","ваш Господь",17,54],["أَعۡلَمُ","лучше знает",17,54],["بِكُمۡۖ","вас",17,54],["إِن","если",17,54],["يَشَأۡ","Он пожелает",17,54],["يَرۡحَمۡكُمۡ","помилует вас",17,54],["أَوۡ","или",17,54],["إِن","если",17,54],["يَشَأۡ","Он пожелает",17,54]],[["يُعَذِّبۡكُمۡۚ","накажет вас",17,54],["وَمَآ","и не",17,54],["أَرۡسَلۡنَٰكَ","Мы послали тебя",17,54],["عَلَيۡهِمۡ","над ними",17,54],["وَكِيلٗا","попечителем",17,54],[54],["وَرَبُّكَ","и твой Господь",17,55],["أَعۡلَمُ","лучше знает",17,55]],[["بِمَن","тех, кто",17,55],["فِي","на",17,55],["ٱلسَّمَٰوَٰتِ","небесах",17,55],["وَٱلۡأَرۡضِۗ","и земле",17,55],["وَلَقَدۡ","и уже",17,55],["فَضَّلۡنَا","Мы дали превосходство",17,55],["بَعۡضَ","одним",17,55],["ٱلنَّبِيِّـۧنَ","из пророков",17,55],["عَلَىٰ","над",17,55],["بَعۡضٖۖ","другими",17,55]],[["وَءَاتَيۡنَا","и Мы дали",17,55],["دَاوُۥدَ","Давуду",17,55],["زَبُورٗا","Забур",17,55],[55],["قُلِ","скажи",17,56],["ٱدۡعُواْ","призовите",17,56],["ٱلَّذِينَ","тех, которых",17,56],["زَعَمۡتُم","вы считали (богами)",17,56],["مِّن","из",17,56],["دُونِهِۦ","помимо Него",17,56],["فَلَا","и не",17,56]],[["يَمۡلِكُونَ","властны они",17,56],["كَشۡفَ","устранить",17,56],["ٱلضُّرِّ","беду",17,56],["عَنكُمۡ","от вас",17,56],["وَلَا","и не",17,56],["تَحۡوِيلًا","перенести",17,56],[56],["أُوْلَٰٓئِكَ","те",17,57],["ٱلَّذِينَ","которых",17,57]],[["يَدۡعُونَ","они призывают",17,57],["يَبۡتَغُونَ","ищут",17,57],["إِلَىٰ","к",17,57],["رَبِّهِمُ","своему Господу",17,57],["ٱلۡوَسِيلَةَ","средство приближения",17,57],["أَيُّهُمۡ","кто из них",17,57],["أَقۡرَبُ","ближе",17,57],["وَيَرۡجُونَ","и надеются",17,57]],[["رَحۡمَتَهُۥ","на Его милость",17,57],["وَيَخَافُونَ","и страшатся",17,57],["عَذَابَهُۥٓۚ","Его наказания",17,57],["إِنَّ","поистине",17,57],["عَذَابَ","наказание",17,57],["رَبِّكَ","твоего Господа",17,57],["كَانَ","есть",17,57],["مَحۡذُورٗا","внушающее страх",17,57],[57]],[["وَإِن","и нет",17,58],["مِّن","из",17,58],["قَرۡيَةٍ","поселения",17,58],["إِلَّا","кроме как",17,58],["نَحۡنُ","Мы",17,58],["مُهۡلِكُوهَا","погубим его",17,58],["قَبۡلَ","до",17,58],["يَوۡمِ","дня",17,58],["ٱلۡقِيَٰمَةِ","воскресения",17,58]],[["أَوۡ","или",17,58],["مُعَذِّبُوهَا","накажем его",17,58],["عَذَابٗا","наказанием",17,58],["شَدِيدٗاۚ","суровым",17,58],["كَانَ","было",17,58],["ذَٰلِكَ","это",17,58],["فِي","в",17,58],["ٱلۡكِتَٰبِ","Писании",17,58],["مَسۡطُورٗا","начертано",17,58],[58]]]}