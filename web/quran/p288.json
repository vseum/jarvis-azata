{"p":288,"j":15,"a":[[17,59,["وَمَا","مَنَعَنَآ","أَن","نُّرۡسِلَ","بِٱلۡأٓيَٰتِ","إِلَّآ","أَن","كَذَّبَ","بِهَا","ٱلۡأَوَّلُونَۚ","وَءَاتَيۡنَا","ثَمُودَ","ٱلنَّاقَةَ","مُبۡصِرَةٗ","فَظَلَمُواْ","بِهَاۚ","وَمَا","نُرۡسِلُ","بِٱلۡأٓيَٰتِ","إِلَّا","تَخۡوِيفٗا"],"вама мана`ана ан нурсила бил'айати илла ан каззаба бихал аввалууна ва'атайна самуудан наḳата мубсиратан фазаламуу биха вама нурсилу бил'айати илла тахвиифа","Мы не отправили знамения только потому, что прежние поколения не уверовали в них. Мы даровали самудянам верблюдицу как наглядное знамение, но они поступили с ней несправедливо. Мы ниспосылаем Наши знамения только для устрашения.",["и не","удержало Нас","от того, чтобы","Мы посылали","знамения","кроме","того, что","сочли ложью","их","прежние","и Мы дали","самудянам","верблюдицу","наглядной","но они поступили несправедливо","с ней","и не","Мы посылаем","знамения","кроме как","для устрашения"]],[17,60,["وَإِذۡ","قُلۡنَا","لَكَ","إِنَّ","رَبَّكَ","أَحَاطَ","بِٱلنَّاسِۚ","وَمَا","جَعَلۡنَا","ٱلرُّءۡيَا","ٱلَّتِيٓ","أَرَيۡنَٰكَ","إِلَّا","فِتۡنَةٗ","لِّلنَّاسِ","وَٱلشَّجَرَةَ","ٱلۡمَلۡعُونَةَ","فِي","ٱلۡقُرۡءَانِۚ","وَنُخَوِّفُهُمۡ","فَمَا","يَزِيدُهُمۡ","إِلَّا","طُغۡيَٰنٗا","كَبِيرٗا"],"ва'из ḳулна лака инна раббака ахата биннаси вама жа`алнар ру'йал латии арайнака илла фитнатал линнаси вашшажаратал мал`ууната фил ḳур'ани ванухаввифухум фама йазиидухум илла тугйанан кабиира","Вот Мы сказали тебе: «Воистину, твой Господь объемлет людей». Мы сделали показанное тебе видение и дерево, проклятое в Коране, искушением для людей. Мы устрашаем их, но это лишь увеличивает их великую непокорность.",["и вот","Мы сказали","тебе","поистине","твой Господь","объял","людей","и не","Мы сделали","видение","которое","Мы показали тебе","кроме как","искушением","для людей","и дерево","проклятое","в","Коране","и Мы устрашаем их","но не","увеличивает это их","кроме как","непокорностью","великой"]],[17,61,["وَإِذۡ","قُلۡنَا","لِلۡمَلَٰٓئِكَةِ","ٱسۡجُدُواْ","لِأٓدَمَ","فَسَجَدُوٓاْ","إِلَّآ","إِبۡلِيسَ","قَالَ","ءَأَسۡجُدُ","لِمَنۡ","خَلَقۡتَ","طِينٗا"],"ва'из ḳулна лилмалаикатисжудуу ли'адама фасажадуу илла иблииса ḳала а'асжуду лиман халаḳта тиина","Вот Мы сказали ангелам: «Падите ниц перед Адамом!». Они пали ниц, и только Иблис сказал: «Неужели я паду ниц перед тем, кого Ты создал из глины?».",["и вот","Мы сказали","ангелам","падите ниц","перед Адамом","и пали они ниц","кроме","Иблиса","он сказал","неужели паду я ниц","перед тем, кого","Ты сотворил","из глины"]],[17,62,["قَالَ","أَرَءَيۡتَكَ","هَٰذَا","ٱلَّذِي","كَرَّمۡتَ","عَلَيَّ","لَئِنۡ","أَخَّرۡتَنِ","إِلَىٰ","يَوۡمِ","ٱلۡقِيَٰمَةِ","لَأَحۡتَنِكَنَّ","ذُرِّيَّتَهُۥٓ","إِلَّا","قَلِيلٗا"],"ḳала араайтака хазал лазии каррамта `алаййа ла'ин аххартани ила йаумил ḳийамати ла'ахтаниканна зурриййатахуу илла ḳалиила","Иблис сказал: «Посмотри на того, кому Ты отдал предпочтение предо мною. Если ты дашь мне отсрочку до Последнего дня, то я покорю его потомство, за исключением немногих».",["он сказал","видишь ли Ты","этого","которого","Ты почтил","надо мной","если","Ты отсрочишь мне","до","дня","воскресения","непременно я овладею","его потомством","кроме","немногих"]],[17,63,["قَالَ","ٱذۡهَبۡ","فَمَن","تَبِعَكَ","مِنۡهُمۡ","فَإِنَّ","جَهَنَّمَ","جَزَآؤُكُمۡ","جَزَآءٗ","مَّوۡفُورٗا"],"ḳалазхаб фаман таби`ака минхум фа'инна жаханнама жазаукум жазаам мауфуура","Аллах сказал: «Ступай! И если кто последует за тобой, то Геенна будет для вас воздаянием, полным воздаянием.",["Он сказал","ступай","и кто","последует за тобой","из них","то поистине","Геенна","ваше воздаяние","воздаянием","полным"]],[17,64,["وَٱسۡتَفۡزِزۡ","مَنِ","ٱسۡتَطَعۡتَ","مِنۡهُم","بِصَوۡتِكَ","وَأَجۡلِبۡ","عَلَيۡهِم","بِخَيۡلِكَ","وَرَجِلِكَ","وَشَارِكۡهُمۡ","فِي","ٱلۡأَمۡوَٰلِ","وَٱلۡأَوۡلَٰدِ","وَعِدۡهُمۡۚ","وَمَا","يَعِدُهُمُ","ٱلشَّيۡطَٰنُ","إِلَّا","غُرُورًا"],"вастафзиз манистата`та минхум бисаутика ва'ажлиб `алайхим бихайлика варажилика вашарикхум фил амвали вал'аулади ва`идхум вама йа`идухумуш шайтану илла гуруура","Возбуждай своим голосом, кого сможешь, пускай в ход против них свою конницу и пехоту, дели с ними их богатства и детей и давай им обещания. Воистину, обещания дьявола - всего лишь обольщение.",["и возбуждай","кого","сможешь","из них","твоим голосом","и наступай","на них","твоей конницей","и твоей пехотой","и будь их сообщником","в","имуществе","и детях","и обещай им","и не","обещает им","дьявол","кроме как","обольщение"]],[17,65,["إِنَّ","عِبَادِي","لَيۡسَ","لَكَ","عَلَيۡهِمۡ","سُلۡطَٰنٞۚ","وَكَفَىٰ","بِرَبِّكَ","وَكِيلٗا"],"инна `ибадии лайса лака `алайхим султанун вакафа бираббика вакиила","Воистину, ты не властен над Моими рабами. Довольно того, что твой Господь является их Попечителем и Хранителем».",["поистине","Мои рабы","нет","у тебя","над ними","власти","и довольно","твоего Господа","Попечителем"]],[17,66,["رَّبُّكُمُ","ٱلَّذِي","يُزۡجِي","لَكُمُ","ٱلۡفُلۡكَ","فِي","ٱلۡبَحۡرِ","لِتَبۡتَغُواْ","مِن","فَضۡلِهِۦٓۚ","إِنَّهُۥ","كَانَ","بِكُمۡ","رَحِيمٗا"],"рраббукумул лазии йузжии лакумул фулка фил бахри литабтагуу мин фадлихии иннахуу кана бикум рахиима","Ваш Господь ведет для вас по морю корабли, дабы вы могли снискать Его милость. Воистину, Он милосерден к вам.",["ваш Господь","Тот, Кто","гонит","для вас","корабли","по","морю","чтобы вы искали","из","Его милости","поистине, Он","есть","к вам","Милосердный"]]],"m":[[["وَمَا","и не",17,59],["مَنَعَنَآ","удержало Нас",17,59],["أَن","от того, чтобы",17,59],["نُّرۡسِلَ","Мы посылали",17,59],["بِٱلۡأٓيَٰتِ","знамения",17,59],["إِلَّآ","кроме",17,59],["أَن","того, что",17,59],["كَذَّبَ","сочли ложью",17,59],["بِهَا","их",17,59],["ٱلۡأَوَّلُونَۚ","прежние",17,59]],[["وَءَاتَيۡنَا","и Мы дали",17,59],["ثَمُودَ","самудянам",17,59],["ٱلنَّاقَةَ","верблюдицу",17,59],["مُبۡصِرَةٗ","наглядной",17,59],["فَظَلَمُواْ","но они поступили несправедливо",17,59],["بِهَاۚ","с ней",17,59],["وَمَا","и не",17,59],["نُرۡسِلُ","Мы посылаем",17,59],["بِٱلۡأٓيَٰتِ","знамения",17,59]],[["إِلَّا","кроме как",17,59],["تَخۡوِيفٗا","для устрашен