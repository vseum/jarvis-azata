{"p":289,"j":15,"a":[[17,67,["وَإِذَا","مَسَّكُمُ","ٱلضُّرُّ","فِي","ٱلۡبَحۡرِ","ضَلَّ","مَن","تَدۡعُونَ","إِلَّآ","إِيَّاهُۖ","فَلَمَّا","نَجَّىٰكُمۡ","إِلَى","ٱلۡبَرِّ","أَعۡرَضۡتُمۡۚ","وَكَانَ","ٱلۡإِنسَٰنُ","كَفُورًا"],"ва'иза массакумуд дурру фил бахри далла ман тад`ууна илла иййаху фаламма нажжакум илал барри а`радтум ваканал инсану кафуура","Когда беда постигает вас в море, вас покидают все, к кому вы взывали, кроме Него. Когда же Он спасает вас и выводит на сушу, вы отворачиваетесь. Воистину, человек неблагодарен.",["и когда","касается вас","беда","в","море","исчезают","те, к кому","вы взываете","кроме","Него одного","а когда","Он спасает вас","на","сушу","вы отворачиваетесь","и есть","человек","неблагодарный"]],[17,68,["أَفَأَمِنتُمۡ","أَن","يَخۡسِفَ","بِكُمۡ","جَانِبَ","ٱلۡبَرِّ","أَوۡ","يُرۡسِلَ","عَلَيۡكُمۡ","حَاصِبٗا","ثُمَّ","لَا","تَجِدُواْ","لَكُمۡ","وَكِيلًا"],"афааминтум ан йахсифа бикум жанибал барри ау йурсила `алайкум хасибан сумма ла тажидуу лакум вакиила","Неужели вы не опасаетесь того, что Он может заставить часть суши поглотить вас или низринуть на вас ураган с камнями? Ведь тогда вы не найдете себе попечителя и хранителя!",["неужели вы уверены","что","Он заставит поглотить","вас","край","суши","или","пошлёт","на вас","ураган с камнями","затем","не","найдёте вы","для себя","попечителя"]],[17,69,["أَمۡ","أَمِنتُمۡ","أَن","يُعِيدَكُمۡ","فِيهِ","تَارَةً","أُخۡرَىٰ","فَيُرۡسِلَ","عَلَيۡكُمۡ","قَاصِفٗا","مِّنَ","ٱلرِّيحِ","فَيُغۡرِقَكُم","بِمَا","كَفَرۡتُمۡ","ثُمَّ","لَا","تَجِدُواْ","لَكُمۡ","عَلَيۡنَا","بِهِۦ","تَبِيعٗا"],"ам аминтум ан йу`иидакум фиихи таратан ухра файурсила `алайкум ḳасифам минар риихи файугриḳакум бима кафартум сумма ла тажидуу лакум `алайна бихии табии`а","Или же вы уверены в том, что Он не вернет вас в море еще раз, чтобы наслать на вас ураганный ветер и потопить вас за неверие? Ведь тогда никто не станет мстить Нам за вас!",["или","уверены вы","что","Он вернёт вас","в него","раз","другой","и пошлёт","на вас","сокрушающий ураган","из","ветра","и потопит вас","за то, что","вы не уверовали","затем","не","найдёте вы","для себя","против Нас","за это","мстителя"]],[17,70,["وَلَقَدۡ","كَرَّمۡنَا","بَنِيٓ","ءَادَمَ","وَحَمَلۡنَٰهُمۡ","فِي","ٱلۡبَرِّ","وَٱلۡبَحۡرِ","وَرَزَقۡنَٰهُم","مِّنَ","ٱلطَّيِّبَٰتِ","وَفَضَّلۡنَٰهُمۡ","عَلَىٰ","كَثِيرٖ","مِّمَّنۡ","خَلَقۡنَا","تَفۡضِيلٗا"],"валаḳад каррамна бании адама вахамалнахум фил барри валбахри варазаḳнахум минат таййибати вафаддалнахум `ала касиирим мимман халаḳна тафдиила","Мы почтили сынов Адама и позволяем им передвигаться по суше и морю. Мы наделили их благами и даровали им явное превосходство над многими другими тварями.",["и уже","Мы почтили","сынов","Адама","и Мы понесли их","по","суше","и морю","и Мы наделили их","из","благ","и Мы дали им превосходство","над","многими","из тех, кого","Мы сотворили","превосходством"]],[17,71,["يَوۡمَ","نَدۡعُواْ","كُلَّ","أُنَاسِۭ","بِإِمَٰمِهِمۡۖ","فَمَنۡ","أُوتِيَ","كِتَٰبَهُۥ","بِيَمِينِهِۦ","فَأُوْلَٰٓئِكَ","يَقۡرَءُونَ","كِتَٰبَهُمۡ","وَلَا","يُظۡلَمُونَ","فَتِيلٗا"],"йаума над`уу кулла унаси би'имамихим фаман уутийа китабахуу бийамиинихии фа'улаика йаḳраууна китабахум вала йузламууна фатиила","В тот день Мы созовем всех людей вместе с их предводителями. Тогда те, кому книга будет вручена в правую руку, прочтут ее, и к ним не будет проявлено несправедливости даже величиной с финиковую плеву.",["в день, когда","Мы призовём","всех","людей","с их предводителем","и кому","будет дана","его книга","в его правую руку","то те","прочтут","свои книги","и не","будут обижены","и на финиковую плеву"]],[17,72,["وَمَن","كَانَ","فِي","هَٰذِهِۦٓ","أَعۡمَىٰ","فَهُوَ","فِي","ٱلۡأٓخِرَةِ","أَعۡمَىٰ","وَأَضَلُّ","سَبِيلٗا"],"ваман кана фии хазихии а`ма фахуа фил ахирати а`ма ва'адаллу сабиила","А кто слеп в этом мире, тот будет также слеп в Последней жизни и окажется еще более заблудшим.",["а кто","был","в","этой (жизни)","слепым","то он","в","Последней жизни","слеп","и более заблудший","путём"]],[17,73,["وَإِن","كَادُواْ","لَيَفۡتِنُونَكَ","عَنِ","ٱلَّذِيٓ","أَوۡحَيۡنَآ","إِلَيۡكَ","لِتَفۡتَرِيَ","عَلَيۡنَا","غَيۡرَهُۥۖ","وَإِذٗا","لَّٱتَّخَذُوكَ","خَلِيلٗا"],"ва'ин кадуу лайафтинуунака `анил лазии аухайна илайка литафтарийа `алайна гайрахуу ва'изал латтахазуука халиила","Они чуть было не отклонили тебя от того, что Мы дали тебе в откровении, дабы ты выдумал про Нас нечто другое. Вот тогда ты стал бы их возлюбленным.",["и поистине","едва не","отвратили они тебя","от","того, что","Мы внушили","тебе","чтобы ты измыслил","на Нас","иное","и тогда","непременно взяли бы тебя","другом"]],[17,74,["وَلَوۡلَآ","أَن","ثَبَّتۡنَٰكَ","لَقَدۡ","كِدتَّ","تَرۡكَنُ","إِلَيۡهِمۡ","شَيۡـٔٗا","قَلِيلًا"],"валаула ан саббатнака лаḳад кидтта таркану илайхим шай'ан ḳалиила","Мы поддержали тебя, когда ты готов был уже немного склониться на их сторону.",["и если бы не","то, что","Мы укрепили тебя","непременно уже","ты едва не","склонился","к ним","чем-то","малым"]],[17,75,["إِذٗا","لَّأَذَقۡنَٰكَ","ضِعۡفَ","ٱلۡحَيَوٰةِ","وَضِعۡفَ","ٱلۡمَمَاتِ","ثُمَّ","لَا","تَجِدُ","لَكَ","عَلَيۡنَا","نَصِيرٗا"],"изал ла'азаḳнака ди`фал хайавати вади`фал мамати сумма ла тажиду лака `алайна насиира","Тогда ты вкусил бы наказание вдвойне в этой жизни и вдвойне после смерти. И тогда никто не стал бы помогать тебе против Нас!",["тогда","непременно Мы дали бы тебе вкусить","двойное (наказание)","жизни","и двойное","смерти","затем","не","нашёл бы ты","для себя","против Нас","помощника"]]],"m":[[["وَإِذَا","и когда",17,67],["مَسَّكُمُ","касается вас",17,67],["ٱلضُّرُّ","беда",17,67],["فِي","в",17,67],["ٱلۡبَحۡرِ","море",17,67],["ضَلَّ","исчезают",17,67],["مَن","те, к кому",17,67],["تَدۡعُونَ","вы взываете",17,67],["إِلَّآ","кроме",17,67],["إِيَّاهُۖ","Него одного",17,67],["فَلَمَّا","а когда",17,67],["نَجَّىٰكُمۡ","Он спасает вас",17,67]],[["إِلَى","на",17,67],["ٱلۡبَرِّ","сушу",17,67],["أَعۡرَضۡتُمۡۚ","вы отворачиваетесь",17,67],["وَكَانَ","и есть",17,67],["ٱلۡإِنسَٰنُ","человек",17,67],["كَفُورًا","неблагодарный",17,67],[67],["أَفَأَمِنتُمۡ","неужели вы уверены",17,68],["أَن","что",17,68],["يَخۡسِفَ","Он заставит поглотить",17,68]],[["بِكُمۡ","вас",17,68],["جَانِبَ","край",17,68],["ٱلۡبَرِّ","суши",17,68],["أَوۡ","или",17,68],["يُرۡسِلَ","пошлёт",17,68],["عَلَيۡكُمۡ","на вас",17,68],["حَاصِبٗا","ураган с камнями",17,68],["ثُمَّ","затем",17,68],["لَا","не",17,68],["تَجِدُواْ","найдёте вы",17,68],["لَكُمۡ","для себя",17,68]],[["وَكِيلًا","попечителя",17,68],[68],["أَمۡ","или",17,69],["أَمِنتُمۡ","уверены вы",17,69],["أَن","что",17,69],["يُعِيدَكُمۡ","Он вернёт вас",17,69],["فِيهِ","в него",17,69],["تَارَةً","раз",17,69],["أُخۡرَىٰ","другой",17,69],["فَيُرۡسِلَ","и пошлёт",17,69]],[["عَلَيۡكُمۡ","на вас",17,69],["قَاصِفٗا","сокрушающий ураган",17,69],["مِّنَ","из",17,69],["ٱلرِّيحِ","ветра",17,69],["فَيُغۡرِقَكُم","и потопит вас",17,69],["بِمَا","за то, что",17,69],["كَفَرۡتُمۡ","вы не уверовали",17,69],["ثُمَّ","затем",17,69],["لَا","не",17,69],["تَجِدُواْ","найдёте вы",17,69]],[["لَكُمۡ","для себя",17,69],["عَلَيۡنَا","против Нас",17,69],["بِهِۦ","за это",17,69],["تَبِيعٗا","мстителя",17,69],[69],["۞ وَلَقَدۡ","и уже",17,70],["كَرَّمۡنَا","Мы почтили",17,70],["بَنِيٓ","сынов",17,70],["ءَادَمَ","Адама",17,70],["وَحَمَلۡنَٰهُمۡ","и Мы понесли их",17,70]],[["فِي","по",17,70],["ٱلۡبَرِّ","суше",17,70],["وَٱلۡبَحۡرِ","и морю",17,70],["وَرَزَقۡنَٰهُم","и Мы наделили их",17,70],["مِّنَ","из",17,70],["ٱلطَّيِّبَٰتِ","благ",17,70],["وَفَضَّلۡنَٰهُمۡ","и Мы дали им превосходство",17,70],["عَلَىٰ","над",17,70]],[["كَثِيرٖ","многими",17,70],["مِّمَّنۡ","из тех, кого",17,70],["خَلَقۡنَا","Мы сотворили",17,70],["تَفۡضِيلٗا","превосходством",17,70],[70],["يَوۡمَ","в день, когда",17,71],["نَدۡعُواْ","Мы призовём",17,71],["كُلَّ","всех",17,71],["أُنَاسِۭ","людей",17,71]],[["بِإِمَٰمِهِمۡۖ","с их предводителем",17,71],["فَمَنۡ","и кому",17,71],["أُوتِيَ","будет дана",17,71],["كِتَٰبَهُۥ","его книга",17,71],["بِيَمِينِهِۦ","в его правую руку",17,71],["فَأُوْلَٰٓئِكَ","то те",17,71],["يَقۡرَءُونَ","прочтут",17,71]],[["كِتَٰبَهُمۡ","свои книги",17,71],["وَلَا","и не",17,71],["يُظۡلَمُونَ","будут обижены",17,71],["فَتِيلٗا","и на финиковую плеву",17,71],[71],["وَمَن","а кто",17,72],["كَانَ","был",17,72],["فِي","в",17,72],["هَٰذِهِۦٓ","этой (жизни)",17,72]],[["أَعۡمَىٰ","слепым",17,72],["فَهُوَ","то он",17,72],["فِي","в",17,72],["ٱلۡأٓخِرَةِ","Последней жизни",17,72],["أَعۡمَىٰ","слеп",17,72],["وَأَضَلُّ","и более заблудший",17,72],["سَبِيلٗا","путём",17,72],[72],["وَإِن","и поистине",17,73],["كَادُواْ","едва не",17,73]],[["لَيَفۡتِنُونَكَ","отвратили они тебя",17,73],["عَنِ","от",17,73],["ٱلَّذِيٓ","того, что",17,73],["أَوۡحَيۡنَآ","Мы внушили",17,73],["إِلَيۡكَ","тебе",17,73],["لِتَفۡتَرِيَ","чтобы ты измыслил",17,73],["عَلَيۡنَا","на Нас",17,73],["غَيۡرَهُۥۖ","иное",17,73]],[["وَإِذٗا","и тогда",17,73],["لَّٱتَّخَذُوكَ","непременно взяли бы тебя",17,73],["خَلِيلٗا","другом",17,73],[73],["وَلَوۡلَآ","и если бы не",17,74],["أَن","то, что",17,74],["ثَبَّتۡنَٰكَ","Мы укрепили тебя",17,74],["لَقَدۡ","непременно уже",17,74],["كِدتَّ","ты едва не",17,74]],[["تَرۡكَنُ","склонился",17,74],["إِلَيۡهِمۡ","к ним",17,74],["شَيۡـٔٗا","чем-то",17,74],["قَلِيلًا","малым",17,74],[74],["إِذٗا","тогда",17,75],["لَّأَذَقۡنَٰكَ","непременно Мы дали бы тебе вкусить",17,75],["ضِعۡفَ","двойное (наказание)",17,75]],[["ٱلۡحَيَوٰةِ","жизни",17,75],["وَضِعۡفَ","и двойное",17,75],["ٱلۡمَمَاتِ","смерти",17,75],["ثُمَّ","затем",17,75],["لَا","не",17,75],["تَجِدُ","нашёл бы ты",17,75],["لَكَ","для себя",17,75],["عَلَيۡنَا","против Нас",17,75],["نَصِيرٗا","помощника",17,75],[75]]]}