{"p":290,"j":15,"a":[[17,76,["وَإِن","كَادُواْ","لَيَسۡتَفِزُّونَكَ","مِنَ","ٱلۡأَرۡضِ","لِيُخۡرِجُوكَ","مِنۡهَاۖ","وَإِذٗا","لَّا","يَلۡبَثُونَ","خِلَٰفَكَ","إِلَّا","قَلِيلٗا"],"ва'ин кадуу лайастафиззуунака минал арди лийухрижуука минха ва'изал ла йалбасууна хилафака илла ḳалиила","Они чуть не изгнали тебя с земли, вытесняя тебя оттуда. Но ведь после твоего изгнания они сами оставались бы там лишь недолго.",["и поистине","едва не","вытеснили они тебя","из","земли","чтобы изгнать тебя","из неё","и тогда","не","пробыли бы они","после тебя","кроме как","немного"]],[17,77,["سُنَّةَ","مَن","قَدۡ","أَرۡسَلۡنَا","قَبۡلَكَ","مِن","رُّسُلِنَاۖ","وَلَا","تَجِدُ","لِسُنَّتِنَا","تَحۡوِيلًا"],"сунната ман ḳад арсална ḳаблака мир русулина вала тажиду лисуннатина тахвиила","Так поступали с Нашими посланниками, отправленными до тебя. Ты не найдешь изменений в Наших установлениях.",["обычай","тех, кого","уже","Мы послали","до тебя","из","Наших посланников","и не","найдёшь ты","в Нашем обычае","изменения"]],[17,78,["أَقِمِ","ٱلصَّلَوٰةَ","لِدُلُوكِ","ٱلشَّمۡسِ","إِلَىٰ","غَسَقِ","ٱلَّيۡلِ","وَقُرۡءَانَ","ٱلۡفَجۡرِۖ","إِنَّ","قُرۡءَانَ","ٱلۡفَجۡرِ","كَانَ","مَشۡهُودٗا"],"аḳимис салавата лидулуукиш шамси ила гасаḳил лайли ваḳур'анал фажри инна ḳур'анал фажри кана машхууда","Совершай намаз с полудня до наступления ночного мрака и читай Коран на рассвете. Воистину, на рассвете Коран читают при свидетелях (ангелах).",["совершай","намаз","при склонении","солнца","до","мрака","ночи","и чтение","рассвета","поистине","чтение","рассвета","есть","засвидетельствованное"]],[17,79,["وَمِنَ","ٱلَّيۡلِ","فَتَهَجَّدۡ","بِهِۦ","نَافِلَةٗ","لَّكَ","عَسَىٰٓ","أَن","يَبۡعَثَكَ","رَبُّكَ","مَقَامٗا","مَّحۡمُودٗا"],"ваминал лайли фатахажжад бихии нафилатал лака `аса ан йаб`асака раббука маḳамам махмууда","Бодрствуй часть ночи, читая Коран во время дополнительных намазов. Быть может, Господь твой возведет тебя на Достохвальное место.",["и в часть","ночи","бодрствуй в молитве","с ним","дополнительно","для тебя","быть может","что","воздвигнет тебя","твой Господь","на место","достохвальное"]],[17,80,["وَقُل","رَّبِّ","أَدۡخِلۡنِي","مُدۡخَلَ","صِدۡقٖ","وَأَخۡرِجۡنِي","مُخۡرَجَ","صِدۡقٖ","وَٱجۡعَل","لِّي","مِن","لَّدُنكَ","سُلۡطَٰنٗا","نَّصِيرٗا"],"ваḳул ррабби адхилнии мудхала сидḳин ва'ахрижнии мухража сидḳин важ`ал лии мил ладунка султанан насиира","Скажи: «Господи! Пусть мое пришествие будет правдивым, и пусть мой уход будет правдивым! Даруй мне от Тебя знамение в помощь».",["и скажи","Господи","введи меня","входом","истинным","и выведи меня","выходом","истинным","и сделай","мне","от","Тебя","власть","помогающую"]],[17,81,["وَقُلۡ","جَآءَ","ٱلۡحَقُّ","وَزَهَقَ","ٱلۡبَٰطِلُۚ","إِنَّ","ٱلۡبَٰطِلَ","كَانَ","زَهُوقٗا"],"ваḳул жаал хаḳḳу вазахаḳал батилу иннал батила кана захууḳа","Скажи: «Явилась истина, и сгинула ложь. Воистину, ложь обречена на погибель».",["и скажи","пришла","истина","и исчезла","ложь","поистине","ложь","есть","обречённая исчезнуть"]],[17,82,["وَنُنَزِّلُ","مِنَ","ٱلۡقُرۡءَانِ","مَا","هُوَ","شِفَآءٞ","وَرَحۡمَةٞ","لِّلۡمُؤۡمِنِينَ","وَلَا","يَزِيدُ","ٱلظَّٰلِمِينَ","إِلَّا","خَسَارٗا"],"вануназзилу минал ḳур'ани ма хуа шифаун варахматул лилму'миниина вала йазиидуз залимиина илла хасара","Мы ниспосылаем в Коране то, что является исцелением и милостью для верующих, а беззаконникам он не прибавляет ничего, кроме убытка.",["и Мы ниспосылаем","из","Корана","то, что","оно","исцеление","и милость","для верующих","и не","увеличивает","беззаконникам","кроме как","убыток"]],[17,83,["وَإِذَآ","أَنۡعَمۡنَا","عَلَى","ٱلۡإِنسَٰنِ","أَعۡرَضَ","وَنَـَٔا","بِجَانِبِهِۦ","وَإِذَا","مَسَّهُ","ٱلشَّرُّ","كَانَ","يَـُٔوسٗا"],"ва'иза ан`амна `алал инсани а`рада ванаа бижанибихии ва'иза массахуш шарру кана йа'ууса","Когда Мы даруем милость человеку, он отворачивается и удаляется в гордыне. Если же его касается беда, то он приходит в отчаяние.",["и когда","Мы оказываем милость","по отношению к","человеку","он отворачивается","и удаляется","своим боком","и когда","касается его","зло","он становится","отчаявшимся"]],[17,84,["قُلۡ","كُلّٞ","يَعۡمَلُ","عَلَىٰ","شَاكِلَتِهِۦ","فَرَبُّكُمۡ","أَعۡلَمُ","بِمَنۡ","هُوَ","أَهۡدَىٰ","سَبِيلٗا"],"ḳул куллун йа`малу `ала шакилатихии фараббукум а`ламу биман хуа ахда сабиила","Скажи: «Каждый человек избирает свой путь, а вашему Господу лучше знать, кто следует более прямым путем».",["скажи","каждый","поступает","по","своему образу","а ваш Господь","лучше знает","того, кто","он","более верно ведом","путём"]],[17,85,["وَيَسۡـَٔلُونَكَ","عَنِ","ٱلرُّوحِۖ","قُلِ","ٱلرُّوحُ","مِنۡ","أَمۡرِ","رَبِّي","وَمَآ","أُوتِيتُم","مِّنَ","ٱلۡعِلۡمِ","إِلَّا","قَلِيلٗا"],"вайас'алуунака `анир руухи ḳулир рууху мин амри раббии вама уутиитум минал `илми илла ḳалиила","Они станут спрашивать тебя о духе (душе или Джибриле). Скажи: «Дух - от повеления моего Господа, а вам дано знать об этом очень мало».",["и спрашивают тебя","о","духе","скажи","дух","от","повеления","Господа моего","и не","дано вам","из","знания","кроме","малого"]],[17,86,["وَلَئِن","شِئۡنَا","لَنَذۡهَبَنَّ","بِٱلَّذِيٓ","أَوۡحَيۡنَآ","إِلَيۡكَ","ثُمَّ","لَا","تَجِدُ","لَكَ","بِهِۦ","عَلَيۡنَا","وَكِيلًا"],"валаин ши'на ланазхабанна биллазии аухайна илайка сумма ла тажиду лака бихии `алайна вакиила","Если бы Мы захотели, то лишили бы тебя того, что дали тебе в откровении. И никто не защитил бы тебя от Нас,",["и если бы","пожелали Мы","непременно унесли бы Мы","то, что","внушили Мы","тебе","затем","не","нашёл бы ты","для себя","в этом","против Нас","заступника"]]],"m":[[["وَإِن","и поистине",17,76],["كَادُواْ","едва не",17,76],["لَيَسۡتَفِزُّونَكَ","вытеснили они тебя",17,76],["مِنَ","из",17,76],["ٱلۡأَرۡضِ","земли",17,76],["لِيُخۡرِجُوكَ","чтобы изгнать тебя",17,76],["مِنۡهَاۖ","из неё",17,76]],[["وَإِذٗا","и тогда",17,76],["لَّا","не",17,76],["يَلۡبَثُونَ","пробыли бы они",17,76],["خِلَٰفَكَ","после тебя",17,76],["إِلَّا","кроме как",17,76],["قَلِيلٗا","немного",17,76],[76],["سُنَّةَ","обычай",17,77],["مَن","тех, кого",17,77],["قَدۡ","уже",17,77]]