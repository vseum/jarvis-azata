{"p":291,"j":15,"a":[[17,87,["إِلَّا","رَحۡمَةٗ","مِّن","رَّبِّكَۚ","إِنَّ","فَضۡلَهُۥ","كَانَ","عَلَيۡكَ","كَبِيرٗا"],"илла рахматам мир раббика инна фадлахуу кана `алайка кабиира","не будь милости твоего Господа. Воистину, Его милость к тебе велика!",["кроме","милости","от","Господа твоего","поистине","милость Его","была","к тебе","велика"]],[17,88,["قُل","لَّئِنِ","ٱجۡتَمَعَتِ","ٱلۡإِنسُ","وَٱلۡجِنُّ","عَلَىٰٓ","أَن","يَأۡتُواْ","بِمِثۡلِ","هَٰذَا","ٱلۡقُرۡءَانِ","لَا","يَأۡتُونَ","بِمِثۡلِهِۦ","وَلَوۡ","كَانَ","بَعۡضُهُمۡ","لِبَعۡضٖ","ظَهِيرٗا"],"ḳул ла'инижтама`атил инсу валжинну `ала ан йа'туу бимисли хазал ḳур'ани ла йа'тууна бимислихии валау кана ба`духум либа`дин захиира","Скажи: «Если бы люди и джинны объединились для того, чтобы сочинить нечто, подобное этому Корану, это не удалось бы им, даже если бы они стали помогать друг другу».",["скажи","если бы","собрались","люди","и джинны","на то","чтобы","принести","подобное","этому","Корану","не","принесут они","подобного ему","даже если бы","были","одни из них","другим","помощниками"]],[17,89,["وَلَقَدۡ","صَرَّفۡنَا","لِلنَّاسِ","فِي","هَٰذَا","ٱلۡقُرۡءَانِ","مِن","كُلِّ","مَثَلٖ","فَأَبَىٰٓ","أَكۡثَرُ","ٱلنَّاسِ","إِلَّا","كُفُورٗا"],"валаḳад саррафна линнаси фии хазал ḳур'ани мин кулли масалин фа'аба аксарун наси илла куфуура","Мы разъяснили людям в этом Коране всякие притчи, но большинство людей отвергает все, кроме неверия.",["и уже","разъяснили Мы","людям","в","этом","Коране","из","всякой","притчи","но отказалось","большинство","людей","кроме","неверия"]],[17,90,["وَقَالُواْ","لَن","نُّؤۡمِنَ","لَكَ","حَتَّىٰ","تَفۡجُرَ","لَنَا","مِنَ","ٱلۡأَرۡضِ","يَنۢبُوعًا"],"ваḳалуу лан ну'мина лака хатта тафжура лана минал арди йамбуу`а","Они говорят: «Ни за что мы не уверуем, пока ты не исторгнешь для нас из земли источник;",["и сказали они","никогда не","уверуем мы","тебе","пока не","исторгнешь ты","для нас","из","земли","источник"]],[17,91,["أَوۡ","تَكُونَ","لَكَ","جَنَّةٞ","مِّن","نَّخِيلٖ","وَعِنَبٖ","فَتُفَجِّرَ","ٱلۡأَنۡهَٰرَ","خِلَٰلَهَا","تَفۡجِيرًا"],"ау такууна лака жаннатум мин нахиилин ва`инабин фатуфажжирал анхара хилалаха тафжиира","или пока не будет у тебя пальмовой рощи и виноградника, в которых ты проложишь реки;",["или","будет","у тебя","сад","из","пальм","и винограда","и проведёшь ты","реки","посреди него","обильно"]],[17,92,["أَوۡ","تُسۡقِطَ","ٱلسَّمَآءَ","كَمَا","زَعَمۡتَ","عَلَيۡنَا","كِسَفًا","أَوۡ","تَأۡتِيَ","بِٱللَّهِ","وَٱلۡمَلَٰٓئِكَةِ","قَبِيلًا"],"ау тусḳитас самаа кама за`амта `алайна кисафан ау та'тийа биллахи валмалаикати ḳабиила","или пока не обрушишь на нас небо кусками, как ты это утверждаешь; или не предстанешь перед нами вместе с Аллахом и ангелами;",["или","обрушишь ты","небо","как","утверждал ты","на нас","кусками","или","придёшь ты","с Аллахом","и ангелами","лицом к лицу"]],[17,93,["أَوۡ","يَكُونَ","لَكَ","بَيۡتٞ","مِّن","زُخۡرُفٍ","أَوۡ","تَرۡقَىٰ","فِي","ٱلسَّمَآءِ","وَلَن","نُّؤۡمِنَ","لِرُقِيِّكَ","حَتَّىٰ","تُنَزِّلَ","عَلَيۡنَا","كِتَٰبٗا","نَّقۡرَؤُهُۥۗ","قُلۡ","سُبۡحَانَ","رَبِّي","هَلۡ","كُنتُ","إِلَّا","بَشَرٗا","رَّسُولٗا"],"ау йакууна лака байтум мин зухруфин ау тарḳа фис самаи валан ну'мина лируḳиййика хатта туназзила `алайна китабан наḳраухуу ḳул субхана раббии хал кунту илла башарар расуула","или пока у тебя не будет дома из драгоценностей; или пока ты не взойдешь на небо. Но мы не поверим в твое восхождение, пока ты не спустишься с Писанием, которое мы станем читать». Скажи: «Пречист мой Господь! Я же - всего лишь человек и посланник».",["или","будет","у тебя","дом","из","украшений","или","поднимешься ты","на","небо","и никогда не","уверуем мы","в восхождение твоё","пока не","низведёшь ты","нам","книгу","которую прочтём мы","скажи","пречист","Господь мой","разве","являюсь я","кроме","человеком","посланником"]],[17,94,["وَمَا","مَنَعَ","ٱلنَّاسَ","أَن","يُؤۡمِنُوٓاْ","إِذۡ","جَآءَهُمُ","ٱلۡهُدَىٰٓ","إِلَّآ","أَن","قَالُوٓاْ","أَبَعَثَ","ٱللَّهُ","بَشَرٗا","رَّسُولٗا"],"вама мана`ан наса ан йу'минуу из жаахумул худа илла ан ḳалуу аба`асаллаху башарар расуула","Людям помешало уверовать после того, как к ним явилось верное руководство, только то, что они сказали: «Неужели Аллах отправил посланником человека?».",["и что","помешало","людям","чтобы","уверовали они","когда","пришло к ним","руководство","кроме","того что","сказали они","неужели отправил","Аллах","человека","посланником"]],[17,95,["قُل","لَّوۡ","كَانَ","فِي","ٱلۡأَرۡضِ","مَلَٰٓئِكَةٞ","يَمۡشُونَ","مُطۡمَئِنِّينَ","لَنَزَّلۡنَا","عَلَيۡهِم","مِّنَ","ٱلسَّمَآءِ","مَلَكٗا","رَّسُولٗا"],"ḳул лау кана фил арди малаикатун йамшууна мутмаинниина ланаззална `алайхим минас самаи малакар расуула","Скажи: «Если бы по земле спокойно ходили ангелы, то Мы отправили бы к ним посланником с неба ангела».",["скажи","если бы","были","на","земле","ангелы","ходящие","спокойно","непременно ниспослали бы Мы","к ним","с","неба","ангела","посланником"]],[17,96,["قُلۡ","كَفَىٰ","بِٱللَّهِ","شَهِيدَۢا","بَيۡنِي","وَبَيۡنَكُمۡۚ","إِنَّهُۥ","كَانَ","بِعِبَادِهِۦ","خَبِيرَۢا","بَصِيرٗا"],"ḳул кафа биллахи шахиида байнии вабайнакум иннахуу кана би`ибадихии хабиира басиира","Скажи: «Довольно того, что Аллах является Свидетелем между мною и вами. Воистину, Он знает и видит Своих рабов».",["скажи","достаточно","Аллаха","свидетелем","между мной","и между вами","поистине, Он","был","о рабах Своих","Ведающим","Видящим"]]],"m":[[["إِلَّا","кроме",17,87],["رَحۡمَةٗ","милости",17,87],["مِّن","от",17,87],["رَّبِّكَۚ","Господа твоего",17,87],["إِنَّ","поистине",17,87],["فَضۡلَهُۥ","милость Его",17,87],["كَانَ","была",17,87],["عَلَيۡكَ","к тебе",17,87],["كَبِيرٗا","велика",17,87],[87],["قُل","скажи",17,88]],[["لَّئِنِ","если бы",17,88],["ٱجۡتَمَعَتِ","собрались",17,88],["ٱلۡإِنسُ","люди",17,88],["وَٱلۡجِنُّ","и джинны",17,88],["عَلَىٰٓ","на то",17,88],["أَن","чтобы",17,88],["يَأۡتُواْ","принести",17,88],["بِمِثۡلِ","подобное",17,88],["هَٰذَا","этому",17,88],["ٱلۡقُرۡءَانِ","Корану",17,88]],[["لَا","не",17,88],["يَأۡتُونَ","принесут они",17,88],["بِمِثۡلِهِۦ","под