{"p":292,"j":15,"a":[[17,97,["وَمَن","يَهۡدِ","ٱللَّهُ","فَهُوَ","ٱلۡمُهۡتَدِۖ","وَمَن","يُضۡلِلۡ","فَلَن","تَجِدَ","لَهُمۡ","أَوۡلِيَآءَ","مِن","دُونِهِۦۖ","وَنَحۡشُرُهُمۡ","يَوۡمَ","ٱلۡقِيَٰمَةِ","عَلَىٰ","وُجُوهِهِمۡ","عُمۡيٗا","وَبُكۡمٗا","وَصُمّٗاۖ","مَّأۡوَىٰهُمۡ","جَهَنَّمُۖ","كُلَّمَا","خَبَتۡ","زِدۡنَٰهُمۡ","سَعِيرٗا"],"ваман йахдиллаху фахуал мухтади ваман йудлил фалан тажида лахум аулийаа мин дуунихии ванахшурухум йаумал ḳийамати `ала вужуухихим `умйан вабукман васуммам ма'вахум жаханнаму куллама хабат зиднахум са`иира","Тот, кого Аллах ведет прямым путем, следует прямым путем. А для того, кого Аллах вводит в заблуждение, ты не найдешь покровителей вместо Него. В День воскресения Мы соберем их лежащими ничком, слепыми, немыми, глухими. Их пристанищем будет Геенна. Как только она утихает, Мы добавляем им пламени.",["и кого","ведёт прямо","Аллах","тот","идущий прямо","и кого","вводит в заблуждение","то никогда не","найдёшь ты","для них","покровителей","помимо","Него","и соберём Мы их","в день","воскресения","на","лицах их","слепыми","и немыми","и глухими","пристанище их","Геенна","всякий раз как","утихнет она","прибавим Мы им","пламени"]],[17,98,["ذَٰلِكَ","جَزَآؤُهُم","بِأَنَّهُمۡ","كَفَرُواْ","بِـَٔايَٰتِنَا","وَقَالُوٓاْ","أَءِذَا","كُنَّا","عِظَٰمٗا","وَرُفَٰتًا","أَءِنَّا","لَمَبۡعُوثُونَ","خَلۡقٗا","جَدِيدًا"],"залика жазаухум би'аннахум кафаруу би'айатина ваḳалуу а'иза кунна `изаман варуфатан а'инна ламаб`уусууна халḳан жадиида","Таково возмездие им за то, что они не уверовали в Наши знамения и говорили: «Неужели после того, как мы превратимся в прах и частички, мы будем воскрешены в новом творении?».",["это","воздаяние им","за то, что они","не уверовали","в знамения Наши","и сказали","неужели когда","станем мы","костями","и прахом","неужели мы","непременно воскрешены","творением","новым"]],[17,99,["أَوَلَمۡ","يَرَوۡاْ","أَنَّ","ٱللَّهَ","ٱلَّذِي","خَلَقَ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضَ","قَادِرٌ","عَلَىٰٓ","أَن","يَخۡلُقَ","مِثۡلَهُمۡ","وَجَعَلَ","لَهُمۡ","أَجَلٗا","لَّا","رَيۡبَ","فِيهِ","فَأَبَى","ٱلظَّٰلِمُونَ","إِلَّا","كُفُورٗا"],"авалам йарау анналлахал лазии халаḳас самавати вал'арда ḳадирун `ала ан йахлуḳа мислахум важа`ала лахум ажалал ла райба фиихи фа'абаз залимууна илла куфуура","Неужели они не видят, что Аллах, сотворивший небеса и землю, способен создать подобных им? Он установил для них срок, в котором нет сомнения, но беззаконники отвергают все, кроме неверия.",["разве не","видят они","что","Аллах","Который","сотворил","небеса","и землю","способен","на то","чтобы","сотворить","подобных им","и установил Он","для них","срок","нет","сомнения","в нём","но отказались","беззаконники","кроме","неверия"]],[17,100,["قُل","لَّوۡ","أَنتُمۡ","تَمۡلِكُونَ","خَزَآئِنَ","رَحۡمَةِ","رَبِّيٓ","إِذٗا","لَّأَمۡسَكۡتُمۡ","خَشۡيَةَ","ٱلۡإِنفَاقِۚ","وَكَانَ","ٱلۡإِنسَٰنُ","قَتُورٗا"],"ḳул лау антум тамликууна хазаина рахмати раббии изал ла'амсактум хашйатал инфаḳи ваканал инсану ḳатуура","Скажи: «Если бы вы владели сокровищницами милости моего Господа, то все равно скупились бы из страха обеднеть, ибо человек скуп».",["скажи","если бы","вы","владели","сокровищницами","милости","Господа моего","тогда","непременно скупились бы вы","из страха","расходования","и является","человек","скупым"]],[17,101,["وَلَقَدۡ","ءَاتَيۡنَا","مُوسَىٰ","تِسۡعَ","ءَايَٰتِۭ","بَيِّنَٰتٖۖ","فَسۡـَٔلۡ","بَنِيٓ","إِسۡرَٰٓءِيلَ","إِذۡ","جَآءَهُمۡ","فَقَالَ","لَهُۥ","فِرۡعَوۡنُ","إِنِّي","لَأَظُنُّكَ","يَٰمُوسَىٰ","مَسۡحُورٗا"],"валаḳад атайна мууса тис`а айати баййинатин фас'ал бании исраиила из жаахум фаḳала лахуу фир`ауну иннии ла'азуннука йамууса масхуура","Мы даровали Мусе (Моисею) девять ясных знамений. Спроси сынов Исраила (Израиля) о том, как Муса (Моисей) пришел к ним, и Фараон сказал ему: «О Муса (Моисей)! Воистину, я полагаю, что ты околдован».",["и уже","даровали Мы","Мусе","девять","знамений","ясных","спроси же","сынов","Исраила","когда","пришёл он к ним","и сказал","ему","Фараон","поистине, я","непременно считаю тебя","о Муса","околдованным"]],[17,102,["قَالَ","لَقَدۡ","عَلِمۡتَ","مَآ","أَنزَلَ","هَٰٓؤُلَآءِ","إِلَّا","رَبُّ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِ","بَصَآئِرَ","وَإِنِّي","لَأَظُنُّكَ","يَٰفِرۡعَوۡنُ","مَثۡبُورٗا"],"ḳала лаḳад `алимта ма анзала ха'улаи илла раббус самавати вал'арди басаира ва'иннии ла'азуннука йафир`ауну масбуура","Муса (Моисей) сказал: «Ты уже знаешь, что не кто иной, а только Господь небес и земли ниспослал их в качестве наглядных знамений. О Фараон! Я полагаю, что тебя постигнет погибель».",["сказал он","уже","знаешь ты","не","ниспослал","этих","кроме","Господь","небес","и земли","наглядными доводами","и поистине, я","непременно считаю тебя","о Фараон","погибшим"]],[17,103,["فَأَرَادَ","أَن","يَسۡتَفِزَّهُم","مِّنَ","ٱلۡأَرۡضِ","فَأَغۡرَقۡنَٰهُ","وَمَن","مَّعَهُۥ","جَمِيعٗا"],"фа'арада ан йастафиззахум минал арди фа'аграḳнаху вамам ма`ахуу жамии`а","Фараону хотелось вытеснить их с земли, но Мы потопили его и всех, кто был с ним.",["и захотел он","чтобы","изгнать их","из","земли","но потопили Мы его","и тех, кто","с ним","всех"]],[17,104,["وَقُلۡنَا","مِنۢ","بَعۡدِهِۦ","لِبَنِيٓ","إِسۡرَٰٓءِيلَ","ٱسۡكُنُواْ","ٱلۡأَرۡضَ","فَإِذَا","جَآءَ","وَعۡدُ","ٱلۡأٓخِرَةِ","جِئۡنَا","بِكُمۡ","لَفِيفٗا"],"ваḳулна мим ба`дихии либании исраииласкунул арда фа'иза жаа ва`дул ахирати жи'на бикум лафиифа","После этого Мы сказали сынам Исраила (Израиля): «Живите на этой земле. А когда исполнится последнее обещание, Мы соберем вас всех вместе».",["и сказали Мы","после","него","сынам","Исраила","живите","на земле","а когда","придёт","обещание","последней жизни","приведём Мы","вас","смешанной толпой"]]],"m":[[["وَمَن","и кого",17,97],["يَهۡدِ","ведёт прямо",17,97],["ٱللَّهُ","Аллах",17,97],["فَهُوَ","тот",17,97],["ٱلۡمُهۡتَدِۖ","идущий прямо",17,97],["وَمَن","и кого",17,97],["يُضۡلِلۡ","вводит в заблуждение",17,97],["فَلَن","то никогда не",17,97],["تَجِدَ","найдёшь ты",17,97],["لَهُمۡ","для них",17,97],["أَوۡلِيَآءَ","покровителей",17,97]],[["مِن","помимо",17,97],["دُونِهِۦۖ","Него",17,97],["وَنَحۡشُرُهُمۡ","и соберём Мы их",17,97],["يَوۡمَ","в день",17,97],["ٱلۡقِيَٰمَةِ","воскресения",17,97],["عَلَىٰ","на",17,97],["وُجُوهِهِمۡ","лицах их",17,97],["عُمۡيٗا","слепыми",17,97],["وَبُكۡمٗا","и немыми",17,97]],[["وَصُمّٗاۖ","и глухими",17,97],["مَّأۡوَىٰهُمۡ","пристанище их",17,97],["جَهَنَّمُۖ","Геенна",17,97],["كُلَّمَا","всякий раз как",17,97],["خَبَتۡ","утихнет она",17,97],["زِدۡنَٰهُمۡ","прибавим Мы им",17,97],["سَعِيرٗا","пламени",17,97],[97]],[["ذَٰلِكَ","это",17,98],["جَزَآؤُهُم","воздаяние им",17,98],["بِأَنَّهُمۡ","за то, что они",17,98],["كَفَرُواْ","не уверовали",17,98],["بِـَٔايَٰتِنَا","в знамения Наши",17,98],["وَقَالُوٓاْ","и сказали",17,98],["أَءِذَا","неужели когда",17,98],["كُنَّا","станем мы",17,98],["عِظَٰمٗا","костями",17,98]],[["وَرُفَٰتًا","и прахом",17,98],["أَءِنَّا","неужели мы",17,98],["لَمَبۡعُوثُونَ","непременно воскрешены",17,98],["خَلۡقٗا","творением",17,98],["جَدِيدًا","новым",17,98],[98],["۞ أَوَلَمۡ","разве не",17,99],["يَرَوۡاْ","видят они",17,99],["أَنَّ","что",17,99],["ٱللَّهَ","Аллах",17,99]],[["ٱلَّذِي","Который",17,99],["خَلَقَ","сотворил",17,99],["ٱلسَّمَٰوَٰتِ","небеса",17,99],["وَٱلۡأَرۡضَ","и землю",17,99],["قَادِرٌ","способен",17,99],["عَلَىٰٓ","на то",17,99],["أَن","чтобы",17,99],["يَخۡلُقَ","сотворить",17,99],["مِثۡلَهُمۡ","подобных им",17,99]],[["وَجَعَلَ","и установил Он",17,99],["لَهُمۡ","для них",17,99],["أَجَلٗا","срок",17,99],["لَّا","нет",17,99],["رَيۡبَ","сомнения",17,99],["فِيهِ","в нём",17,99],["فَأَبَى","но отказались",17,99],["ٱلظَّٰلِمُونَ","беззаконники",17,99],["إِلَّا","кроме",17,99],["كُفُورٗا","неверия",17,99],[99]],[["قُل","скажи",17,100],["لَّوۡ","если бы",17,100],["أَنتُمۡ","вы",17,100],["تَمۡلِكُونَ","владели",17,100],["خَزَآئِنَ","сокровищницами",17,100],["رَحۡمَةِ","милости",17,100],["رَبِّيٓ","Господа моего",17,100],["إِذٗا","тогда",17,100],["لَّأَمۡسَكۡتُمۡ","непременно скупились бы вы",17,100],["خَشۡيَةَ","из страха",17,100]],[["ٱلۡإِنفَاقِۚ","расходования",17,100],["وَكَانَ","и является",17,100],["ٱلۡإِنسَٰنُ","человек",17,100],["قَتُورٗا","скупым",17,100],[100],["وَلَقَدۡ","и уже",17,101],["ءَاتَيۡنَا","даровали Мы",17,101],["مُوسَىٰ","Мусе",17,101],["تِسۡعَ","девять",17,101]],[["ءَايَٰتِۭ","знамений",17,101],["بَيِّنَٰتٖۖ","ясных",17,101],["فَسۡـَٔلۡ","спроси же",17,101],["بَنِيٓ","сынов",17,101],["إِسۡرَٰٓءِيلَ","Исраила",17,101],["إِذۡ","когда",17,101],["جَآءَهُمۡ","пришёл он к ним",17,101],["فَقَالَ","и сказал",17,101],["لَهُۥ","ему",17,101],["فِرۡعَوۡنُ","Фараон",17,101]],[["إِنِّي","поистине, я",17,101],["لَأَظُنُّكَ","непременно считаю тебя",17,101],["يَٰمُوسَىٰ","о Муса",17,101],["مَسۡحُورٗا","околдованным",17,101],[101],["قَالَ","сказал он",17,102],["لَقَدۡ","уже",17,102],["عَلِمۡتَ","знаешь ты",17,102],["مَآ","не",17,102],["أَنزَلَ","ниспослал",17,102]],[["هَٰٓؤُلَآءِ","этих",17,102],["إِلَّا","кроме",17,102],["رَبُّ","Господь",17,102],["ٱلسَّمَٰوَٰتِ","небес",17,102],["وَٱلۡأَرۡضِ","и земли",17,102],["بَصَآئِرَ","наглядными доводами",17,102],["وَإِنِّي","и поистине, я",17,102],["لَأَظُنُّكَ","непременно считаю тебя",17,102]],[["يَٰفِرۡعَوۡنُ","о Фараон",17,102],["مَثۡبُورٗا","погибшим",17,102],[102],["فَأَرَادَ","и захотел он",17,103],["أَن","чтобы",17,103],["يَسۡتَفِزَّهُم","изгнать их",17,103],["مِّنَ","из",17,103],["ٱلۡأَرۡضِ","земли",17,103]],[["فَأَغۡرَقۡنَٰهُ","но потопили Мы его",17,103],["وَمَن","и тех, кто",17,103],["مَّعَهُۥ","с ним",17,103],["جَمِيعٗا","всех",17,103],[103],["وَقُلۡنَا","и сказали Мы",17,104],["مِنۢ","после",17,104],["بَعۡدِهِۦ","него",17,104],["لِبَنِيٓ","сынам",17,104],["إِسۡرَٰٓءِيلَ","Исраила",17,104]],[["ٱسۡكُنُواْ","живите",17,104],["ٱلۡأَرۡضَ","на земле",17,104],["فَإِذَا","а когда",17,104],["جَآءَ","придёт",17,104],["وَعۡدُ","обещание",17,104],["ٱلۡأٓخِرَةِ","последней жизни",17,104],["جِئۡنَا","приведём Мы",17,104],["بِكُمۡ","вас",17,104],["لَفِيفٗا","смешанной толпой",17,104],[104]]]}