{"p":293,"j":15,"a":[[17,105,["وَبِٱلۡحَقِّ","أَنزَلۡنَٰهُ","وَبِٱلۡحَقِّ","نَزَلَۗ","وَمَآ","أَرۡسَلۡنَٰكَ","إِلَّا","مُبَشِّرٗا","وَنَذِيرٗا"],"вабилхаḳḳи анзалнаху вабилхаḳḳи назала вама арсалнака илла мубашширан ваназиира","Мы ниспослали его (Коран) с истиной, и он сошел с истиной, а тебя Мы послали только добрым вестником и предостерегающим увещевателем.",["и с истиной","ниспослали Мы его","и с истиной","сошёл он","и не","послали Мы тебя","кроме как","благовестником","и предостерегающим"]],[17,106,["وَقُرۡءَانٗا","فَرَقۡنَٰهُ","لِتَقۡرَأَهُۥ","عَلَى","ٱلنَّاسِ","عَلَىٰ","مُكۡثٖ","وَنَزَّلۡنَٰهُ","تَنزِيلٗا"],"ваḳур'анан фараḳнаху литаḳраахуу `алан наси `ала муксин ваназзалнаху танзиила","Мы разделили Коран для того, чтобы ты читал его людям не спеша. Мы ниспослали его частями.",["и Коран","разделили Мы его","чтобы читал ты его","перед","людьми","с","расстановкой","и ниспослали Мы его","постепенно"]],[17,107,["قُلۡ","ءَامِنُواْ","بِهِۦٓ","أَوۡ","لَا","تُؤۡمِنُوٓاْۚ","إِنَّ","ٱلَّذِينَ","أُوتُواْ","ٱلۡعِلۡمَ","مِن","قَبۡلِهِۦٓ","إِذَا","يُتۡلَىٰ","عَلَيۡهِمۡ","يَخِرُّونَۤ","لِلۡأَذۡقَانِۤ","سُجَّدٗاۤ"],"ḳул аминуу бихии ау ла ту'минуу иннал лазиина уутул `илма мин ḳаблихии иза йутла `алайхим йахиррууна лил'азḳани сужжада","Скажи: «Веруйте в него (Коран) или не веруйте! Воистину, когда его читают тем, кому прежде было даровано знание, они падают ниц, касаясь земли своими подбородками.",["скажи","уверуйте","в него","или","не","веруйте","поистине","те, которые","даровано им","знание","до","него","когда","читается","им","падают они","на подбородки","ниц"]],[17,108,["وَيَقُولُونَ","سُبۡحَٰنَ","رَبِّنَآ","إِن","كَانَ","وَعۡدُ","رَبِّنَا","لَمَفۡعُولٗا"],"вайаḳуулууна субхана раббина ин кана ва`ду раббина ламаф`уула","Они говорят: «Хвала нашему Господу! Воистину, обещание нашего Господа непременно исполнится».",["и говорят они","пречист","Господь наш","поистине","было","обещание","Господа нашего","непременно исполненным"]],[17,109,["وَيَخِرُّونَ","لِلۡأَذۡقَانِ","يَبۡكُونَ","وَيَزِيدُهُمۡ","خُشُوعٗا ۩"],"вайахиррууна лил'азḳани йабкууна вайазиидухум хушуу`а","Они падают ниц, касаясь земли подбородками и рыдая. И это приумножает их смирение».",["и падают они","на подбородки","плача","и увеличивает им","смирение"]],[17,110,["قُلِ","ٱدۡعُواْ","ٱللَّهَ","أَوِ","ٱدۡعُواْ","ٱلرَّحۡمَٰنَۖ","أَيّٗا","مَّا","تَدۡعُواْ","فَلَهُ","ٱلۡأَسۡمَآءُ","ٱلۡحُسۡنَىٰۚ","وَلَا","تَجۡهَرۡ","بِصَلَاتِكَ","وَلَا","تُخَافِتۡ","بِهَا","وَٱبۡتَغِ","بَيۡنَ","ذَٰلِكَ","سَبِيلٗا"],"ḳулид`уллаха авид`ур рахмана аййам ма тад`уу фалахул асмаул хусна вала тажхар бисалатика вала тухафит биха вабтаги байна залика сабиила","Скажи: «Призывайте Аллаха или призывайте Милостивого! Как бы вы ни призывали Его, у Него - самые прекрасные имена». Не совершай свой намаз громко и не совершай его шепотом, а выбери среднее между этим.",["скажи","призывайте","Аллаха","или","призывайте","Милостивого","каким бы","ни","призывали вы","то у Него","имена","прекраснейшие","и не","возвышай голос","в молитве своей","и не","понижай голос","в ней","и ищи","между","этим","путь"]],[17,111,["وَقُلِ","ٱلۡحَمۡدُ","لِلَّهِ","ٱلَّذِي","لَمۡ","يَتَّخِذۡ","وَلَدٗا","وَلَمۡ","يَكُن","لَّهُۥ","شَرِيكٞ","فِي","ٱلۡمُلۡكِ","وَلَمۡ","يَكُن","لَّهُۥ","وَلِيّٞ","مِّنَ","ٱلذُّلِّۖ","وَكَبِّرۡهُ","تَكۡبِيرَۢا"],"ваḳулил хамду лиллахил лазии лам йаттахиз валадан валам йакул лахуу шариикун фил мулки валам йакул лахуу валиййум миназ зулли вакаббирху такбиира","Скажи: «Хвала Аллаху, Который не взял Себе сына, Который ни с кем не делит власть, Которому не нужен защитник от унижения». И возвеличивай Его величаво!",["и скажи","хвала","Аллаху","Который","не","взял","сына","и не","было","у Него","сотоварища","во","власти","и не","было","у Него","покровителя","из-за","унижения","и возвеличивай Его","величанием"]],[18,1,["ٱلۡحَمۡدُ","لِلَّهِ","ٱلَّذِيٓ","أَنزَلَ","عَلَىٰ","عَبۡدِهِ","ٱلۡكِتَٰبَ","وَلَمۡ","يَجۡعَل","لَّهُۥ","عِوَجَاۜ"],"алхамду лиллахил лазии анзала `ала `абдихил китаба валам йаж`ал лахуу `иважа","Хвала Аллаху, Который ниспослал Своему рабу Писание и не допустил в нем неправды,",["хвала","Аллаху","Который","ниспослал","на","раба Своего","Книгу","и не","сделал","в ней","кривизны"]],[18,2,["قَيِّمٗا","لِّيُنذِرَ","بَأۡسٗا","شَدِيدٗا","مِّن","لَّدُنۡهُ","وَيُبَشِّرَ","ٱلۡمُؤۡمِنِينَ","ٱلَّذِينَ","يَعۡمَلُونَ","ٱلصَّٰلِحَٰتِ","أَنَّ","لَهُمۡ","أَجۡرًا","حَسَنٗا"],"ḳаййимал лийунзира ба'сан шадиидам мил ладунху вайубашширал му'миниинал лазиина йа`малуунас салихати анна лахум ажран хасана","и сделал его правильным, чтобы предостеречь неверующих от тяжких мучений от Него и сообщить верующим, совершающим праведные деяния, благую весть о том, что им уготована прекрасная награда,",["прямой","чтобы предостерёг Он","о мучении","сильном","от","Него","и обрадовал Он","верующих","тех, которые","совершают","праведные дела","что","для них","награда","прекрасная"]],[18,3,["مَّٰكِثِينَ","فِيهِ","أَبَدٗا"],"ммакисиина фиихи абада","в которой они пребудут вечно,",["пребывающие","в ней","вечно"]],[18,4,["وَيُنذِرَ","ٱلَّذِينَ","قَالُواْ","ٱتَّخَذَ","ٱللَّهُ","وَلَدٗا"],"вайунзирал лазиина ḳалуттахазаллаху валада","и чтобы предостеречь тех, которые говорят: «Аллах взял Себе сына».",["и предостерёг Он","тех, которые","сказали","взял","Аллах","сына"]]],"m":[[["وَبِٱلۡحَقِّ","и с истиной",17,105],["أَنزَلۡنَٰهُ","ниспослали Мы его",17,105],["وَبِٱلۡحَقِّ","и с истиной",17,105],["نَزَلَۗ","сошёл он",17,105],["وَمَآ","и не",17,105],["أَرۡسَلۡنَٰكَ","послали Мы тебя",17,105],["إِلَّا","кроме как",17,105],["مُبَشِّرٗا","благовестником",17,105],["وَنَذِيرٗا","и предостерегающим",17,105],[105]],[["وَقُرۡءَانٗا","и Коран",17,106],["فَرَقۡنَٰهُ","разделили Мы его",17,106],["لِتَقۡرَأَهُۥ","чтобы читал ты его",17,106],["عَلَى","перед",17,106],["ٱلنَّاسِ","людьми",17,106],["عَلَىٰ","с",17,106],["مُكۡثٖ","расстановкой",17,106],["وَنَزَّلۡنَٰهُ","и ниспослали Мы его",17,106],["تَنزِيلٗا","постепенно",17,106],[106]],[["قُلۡ","скажи",17,107],["ءَامِنُواْ","уверуйте",17,107],["بِهِۦٓ","в него",17,107],[