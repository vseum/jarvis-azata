{"p":294,"j":15,"a":[[18,5,["مَّا","لَهُم","بِهِۦ","مِنۡ","عِلۡمٖ","وَلَا","لِأٓبَآئِهِمۡۚ","كَبُرَتۡ","كَلِمَةٗ","تَخۡرُجُ","مِنۡ","أَفۡوَٰهِهِمۡۚ","إِن","يَقُولُونَ","إِلَّا","كَذِبٗا"],"мма лахум бихии мин `илмин вала ли'абаихим кабурат калиматан тахружу мин афвахихим ин йаḳуулууна илла казиба","Знания об этом нет ни у них, ни у их отцов. Тяжки слова, выходящие из их ртов, и говорят они одну только ложь.",["нет","у них","о нём","никакого","знания","и не","у отцов их","тяжко","слово","выходит","из","ртов их","не","говорят они","кроме","лжи"]],[18,6,["فَلَعَلَّكَ","بَٰخِعٞ","نَّفۡسَكَ","عَلَىٰٓ","ءَاثَٰرِهِمۡ","إِن","لَّمۡ","يُؤۡمِنُواْ","بِهَٰذَا","ٱلۡحَدِيثِ","أَسَفًا"],"фала`аллака бахи`ун нафсака `ала асарихим ил лам йу'минуу бихазал хадииси асафа","Ты можешь погубить себя от скорби по их следам (скорбя о том, что они отворачиваются от истины), если они не уверуют в это повествование?",["может быть, ты","губящий","себя","по","следам их","если","не","уверуют они","в это","повествование","от скорби"]],[18,7,["إِنَّا","جَعَلۡنَا","مَا","عَلَى","ٱلۡأَرۡضِ","زِينَةٗ","لَّهَا","لِنَبۡلُوَهُمۡ","أَيُّهُمۡ","أَحۡسَنُ","عَمَلٗا"],"инна жа`ална ма `алал арди зиинатал лаха линаблуахум аййухум ахсану `амала","Воистину, все, что есть на земле, Мы сделали украшением для нее, чтобы испытать людей ивыявить, чьи деяния окажутся лучше.",["поистине, Мы","сделали","то, что","на","земле","украшением","для неё","чтобы испытать Нам их","кто из них","лучше","делами"]],[18,8,["وَإِنَّا","لَجَٰعِلُونَ","مَا","عَلَيۡهَا","صَعِيدٗا","جُرُزًا"],"ва'инна лажа`илууна ма `алайха са`иидан журуза","Воистину, все, что есть на земле, Мы превратим в безжизненный песок.",["и поистине, Мы","непременно сделаем","то, что","на ней","почвой","бесплодной"]],[18,9,["أَمۡ","حَسِبۡتَ","أَنَّ","أَصۡحَٰبَ","ٱلۡكَهۡفِ","وَٱلرَّقِيمِ","كَانُواْ","مِنۡ","ءَايَٰتِنَا","عَجَبًا"],"ам хасибта анна асхабал кахфи варраḳиими кануу мин айатина `ажаба","Или же ты решил, что люди пещеры и Ракима (название селения, из которого вышли юноши, или плита, на которой были начертаны их имена) были самым удивительным среди Наших знамений?",["или","думал ты","что","обитатели","пещеры","и Ракима","были","из","знамений Наших","чудом"]],[18,10,["إِذۡ","أَوَى","ٱلۡفِتۡيَةُ","إِلَى","ٱلۡكَهۡفِ","فَقَالُواْ","رَبَّنَآ","ءَاتِنَا","مِن","لَّدُنكَ","رَحۡمَةٗ","وَهَيِّئۡ","لَنَا","مِنۡ","أَمۡرِنَا","رَشَدٗا"],"из авал фитйату илал кахфи фаḳалуу раббана атина мил ладунка рахматан вахаййи' лана мин амрина рашада","Вот юноши укрылись в пещере и сказали: «Господь наш! Даруй нам от Себя милость и устрой наше дело наилучшим образом».",["вот","укрылись","юноши","в","пещере","и сказали они","Господь наш","даруй нам","от","Тебя","милость","и устрой","нам","в","деле нашем","правильность"]],[18,11,["فَضَرَبۡنَا","عَلَىٰٓ","ءَاذَانِهِمۡ","فِي","ٱلۡكَهۡفِ","سِنِينَ","عَدَدٗا"],"фадарабна `ала азанихим фил кахфи синиина `адада","Мы запечатали их уши (погрузили их в глубокий сон) в пещере на много лет.",["и наложили Мы","на","уши их","в","пещере","годы","исчисленные"]],[18,12,["ثُمَّ","بَعَثۡنَٰهُمۡ","لِنَعۡلَمَ","أَيُّ","ٱلۡحِزۡبَيۡنِ","أَحۡصَىٰ","لِمَا","لَبِثُوٓاْ","أَمَدٗا"],"сумма ба`аснахум лина`лама аййул хизбайни ахса лима лабисуу амада","Потом Мы разбудили их, чтобы узнать, какая из двух партий точнее подсчитает, какой срок они пробыли там.",["затем","пробудили Мы их","чтобы узнали Мы","какая","из двух партий","точнее подсчитала","сколько","пробыли они","срок"]],[18,13,["نَّحۡنُ","نَقُصُّ","عَلَيۡكَ","نَبَأَهُم","بِٱلۡحَقِّۚ","إِنَّهُمۡ","فِتۡيَةٌ","ءَامَنُواْ","بِرَبِّهِمۡ","وَزِدۡنَٰهُمۡ","هُدٗى"],"ннахну наḳуссу `алайка набаахум билхаḳḳи иннахум фитйатун амануу бираббихим вазиднахум худа","Мы расскажем тебе их историю правдиво. Это были юноши, которые уверовали в своего Господа, и Мы увеличили их приверженность прямому пути.",["Мы","рассказываем","тебе","весть о них","по истине","поистине, они","юноши","уверовали","в Господа своего","и прибавили Мы им","руководства"]],[18,14,["وَرَبَطۡنَا","عَلَىٰ","قُلُوبِهِمۡ","إِذۡ","قَامُواْ","فَقَالُواْ","رَبُّنَا","رَبُّ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِ","لَن","نَّدۡعُوَاْ","مِن","دُونِهِۦٓ","إِلَٰهٗاۖ","لَّقَدۡ","قُلۡنَآ","إِذٗا","شَطَطًا"],"варабатна `ала ḳулуубихим из ḳамуу фаḳалуу раббуна раббус самавати вал'арди лан над`уа мин дуунихии илахал лаḳад ḳулна изан шатата","Мы укрепили их сердца (укрепили их веру и решимость), когда они встали и сказали: «Господь наш - Господь небес и земли! Мы не станем взывать к другим божествам помимо Него. В таком случае мы произнесли бы чрезмерное.",["и укрепили Мы","на","сердцах их","когда","встали они","и сказали","Господь наш","Господь","небес","и земли","никогда не","будем взывать мы","помимо","Него","к божеству","уже","сказали бы мы","тогда","чрезмерное"]],[18,15,["هَٰٓؤُلَآءِ","قَوۡمُنَا","ٱتَّخَذُواْ","مِن","دُونِهِۦٓ","ءَالِهَةٗۖ","لَّوۡلَا","يَأۡتُونَ","عَلَيۡهِم","بِسُلۡطَٰنِۭ","بَيِّنٖۖ","فَمَنۡ","أَظۡلَمُ","مِمَّنِ","ٱفۡتَرَىٰ","عَلَى","ٱللَّهِ","كَذِبٗا"],"ха'улаи ḳаумунаттахазуу мин дуунихии алихатал лаула йа'тууна `алайхим бисултани баййинин фаман азламу мимманифтара `алаллахи казиба","Этот наш народ стал поклоняться вместо Него другим божествам. Почему же они не приводят в пользу этого ясного довода? Кто может быть несправедливее того, кто возводит навет на Аллаха?",["эти","народ наш","взяли","помимо","Него","божеств","почему же не","приводят они","о них","доводом","ясным","и кто","несправедливее","того, кто","измыслил","на","Аллаха","ложь"]]],"m":[[["مَّا","нет",18,5],["لَهُم","у них",18,5],["بِهِۦ","о нём",18,5],["مِنۡ","никакого",18,5],["عِلۡمٖ","знания",18,5],["وَلَا","и не",18,5],["لِأٓبَآئِهِمۡۚ","у отцов их",18,5],["كَبُرَتۡ","тяжко",18,5],["كَلِمَةٗ","слово",18,5],["تَخۡرُجُ","выходит",18,5],["مِنۡ","из",18,5]],[["أَفۡوَٰهِهِمۡۚ","ртов их",18,5],["إِن","не",18,5],["يَقُولُونَ","говорят они",18,5],["إِلَّا","кроме",18,5],["كَذِبٗا","лжи",18,5],[5],["فَلَعَلَّكَ","может быть, ты",18,6],["بَٰخِعٞ","губящий",18,6],["نَّفۡسَكَ","себя",18,6]],[["عَلَىٰٓ","по",18,6],["