ۡ","или",18,19],["بَعۡضَ","часть",18,19],["يَوۡمٖۚ","дня",18,19],["قَالُواْ","сказали они",18,19],["رَبُّكُمۡ","Господь ваш",18,19],["أَعۡلَمُ","лучше знает",18,19],["بِمَا","о том, сколько",18,19],["لَبِثۡتُمۡ","пробыли вы",18,19],["فَٱبۡعَثُوٓاْ","пошлите же",18,19]],[["أَحَدَكُم","одного из вас",18,19],["بِوَرِقِكُمۡ","с монетами вашими",18,19],["هَٰذِهِۦٓ","этими",18,19],["إِلَى","в",18,19],["ٱلۡمَدِينَةِ","город",18,19],["فَلۡيَنظُرۡ","и пусть посмотрит",18,19],["أَيُّهَآ","какая из них",18,19],["أَزۡكَىٰ","чище",18,19]],[["طَعَامٗا","пищей",18,19],["فَلۡيَأۡتِكُم","и пусть принесёт вам",18,19],["بِرِزۡقٖ","пропитание",18,19],["مِّنۡهُ","из неё",18,19],["وَلۡيَتَلَطَّفۡ","и пусть будет осторожен",18,19],["وَلَا","и пусть не",18,19],["يُشۡعِرَنَّ","даст знать",18,19]],[["بِكُمۡ","о вас",18,19],["أَحَدًا","никому",18,19],[19],["إِنَّهُمۡ","поистине, они",18,20],["إِن","если",18,20],["يَظۡهَرُواْ","узнают",18,20],["عَلَيۡكُمۡ","о вас",18,20],["يَرۡجُمُوكُمۡ","побьют вас камнями",18,20]],[["أَوۡ","или",18,20],["يُعِيدُوكُمۡ","вернут вас",18,20],["فِي","в",18,20],["مِلَّتِهِمۡ","веру их",18,20],["وَلَن","и никогда не",18,20],["تُفۡلِحُوٓاْ","преуспеете вы",18,20],["إِذًا","тогда",18,20],["أَبَدٗا","никогда",18,20],[20]]]}