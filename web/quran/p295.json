{"p":295,"j":15,"a":[[18,16,["وَإِذِ","ٱعۡتَزَلۡتُمُوهُمۡ","وَمَا","يَعۡبُدُونَ","إِلَّا","ٱللَّهَ","فَأۡوُۥٓاْ","إِلَى","ٱلۡكَهۡفِ","يَنشُرۡ","لَكُمۡ","رَبُّكُم","مِّن","رَّحۡمَتِهِۦ","وَيُهَيِّئۡ","لَكُم","مِّنۡ","أَمۡرِكُم","مِّرۡفَقٗا"],"ва'изи`тазалтумуухум вама йа`будууна иллаллаха фа'вуу илал кахфи йаншур лакум раббукум мир рахматихии вайухаййи' лакум мин амрикум мирфаḳа","Если вы удалились от них и от того, чему они поклоняются помимо Аллаха, то укройтесь в пещере, и ваш Господь распространит на вас Свою милость и сделает ваше дело легким».",["и когда","удалились вы от них","и от того, чему","поклоняются они","кроме","Аллаха","то укройтесь","в","пещере","распространит","вам","Господь ваш","из","милости Своей","и устроит","вам","в","деле вашем","облегчение"]],[18,17,["وَتَرَى","ٱلشَّمۡسَ","إِذَا","طَلَعَت","تَّزَٰوَرُ","عَن","كَهۡفِهِمۡ","ذَاتَ","ٱلۡيَمِينِ","وَإِذَا","غَرَبَت","تَّقۡرِضُهُمۡ","ذَاتَ","ٱلشِّمَالِ","وَهُمۡ","فِي","فَجۡوَةٖ","مِّنۡهُۚ","ذَٰلِكَ","مِنۡ","ءَايَٰتِ","ٱللَّهِۗ","مَن","يَهۡدِ","ٱللَّهُ","فَهُوَ","ٱلۡمُهۡتَدِۖ","وَمَن","يُضۡلِلۡ","فَلَن","تَجِدَ","لَهُۥ","وَلِيّٗا","مُّرۡشِدٗا"],"ватараш шамса иза тала`ат тазавару `ан кахфихим затал йамиини ва'иза гарабат таḳридухум заташ шимали вахум фии фажватим минху залика мин айатиллахи ман йахдиллаху фахуал мухтади ваман йудлил фалан тажида лахуу валиййам муршида","Ты увидел бы, что солнце на восходе уклонялось от их пещеры вправо, а на закате отворачивалось от них влево. Они же находились в середине пещеры. Это были некоторые из знамений Аллаха. Тот, кого Аллах ведет прямым путем, следует прямым путем. Тому же, кого Он вводит в заблуждение, ты не найдешь ни покровителя, ни наставника.",["и видишь ты","солнце","когда","восходит оно","уклоняется","от","пещеры их","в сторону","правую","и когда","заходит оно","обходит их","в сторону","левую","а они","в","просторном месте","её","это","из","знамений","Аллаха","кого","ведёт прямо","Аллах","тот","идущий прямо","а кого","вводит в заблуждение","то никогда не","найдёшь ты","для него","покровителя","наставляющего"]],[18,18,["وَتَحۡسَبُهُمۡ","أَيۡقَاظٗا","وَهُمۡ","رُقُودٞۚ","وَنُقَلِّبُهُمۡ","ذَاتَ","ٱلۡيَمِينِ","وَذَاتَ","ٱلشِّمَالِۖ","وَكَلۡبُهُم","بَٰسِطٞ","ذِرَاعَيۡهِ","بِٱلۡوَصِيدِۚ","لَوِ","ٱطَّلَعۡتَ","عَلَيۡهِمۡ","لَوَلَّيۡتَ","مِنۡهُمۡ","فِرَارٗا","وَلَمُلِئۡتَ","مِنۡهُمۡ","رُعۡبٗا"],"ватахсабухум айḳазан вахум руḳуудун вануḳаллибухум затал йамиини вазаташ шимали вакалбухум баситун зира`айхи билвасииди лавиттала`та `алайхим лаваллайта минхум фираран валамули'та минхум ру`ба","Ты решил бы, что они бодрствуют, хотя они спали. Мы переворачивали их то на правый бок, то на левый. Их собака лежала перед входом, вытянув лапы. Взглянув на них, ты бросился бы бежать прочь и пришел бы в ужас.",["и думаешь ты о них","бодрствующими","а они","спящие","и переворачиваем Мы их","в сторону","правую","и в сторону","левую","а собака их","вытянувшая","лапы свои","у порога","если бы","заглянул ты","на них","непременно повернулся бы ты","от них","бегством","и непременно наполнился бы ты","от них","ужасом"]],[18,19,["وَكَذَٰلِكَ","بَعَثۡنَٰهُمۡ","لِيَتَسَآءَلُواْ","بَيۡنَهُمۡۚ","قَالَ","قَآئِلٞ","مِّنۡهُمۡ","كَمۡ","لَبِثۡتُمۡۖ","قَالُواْ","لَبِثۡنَا","يَوۡمًا","أَوۡ","بَعۡضَ","يَوۡمٖۚ","قَالُواْ","رَبُّكُمۡ","أَعۡلَمُ","بِمَا","لَبِثۡتُمۡ","فَٱبۡعَثُوٓاْ","أَحَدَكُم","بِوَرِقِكُمۡ","هَٰذِهِۦٓ","إِلَى","ٱلۡمَدِينَةِ","فَلۡيَنظُرۡ","أَيُّهَآ","أَزۡكَىٰ","طَعَامٗا","فَلۡيَأۡتِكُم","بِرِزۡقٖ","مِّنۡهُ","وَلۡيَتَلَطَّفۡ","وَلَا","يُشۡعِرَنَّ","بِكُمۡ","أَحَدًا"],"ваказалика ба`аснахум лийатасаалуу байнахум ḳала ḳаилум минхум кам лабистум ḳалуу лабисна йауман ау ба`да йаумин ḳалуу раббукум а`ламу бима лабистум фаб`асуу ахадакум бивариḳикум хазихии илал мадиинати фалйанзур аййуха азка та`аман фалйа'тикум биризḳим минху валйаталаттаф вала йуш`иранна бикум ахада","Так Мы пробудили их для того, чтобы они расспросили друг друга. Один из них сказал: «Сколько вы пробыли здесь?». Они сказали: «Мы пробыли день или часть дня». Они сказали: «Вашему Господу лучше известно о том, сколько вы пробыли. Пошлите одного из вас в город с вашими серебряными монетами. Пусть он посмотрит, какая еда получше, и принесет вам ее поесть. Но пусть он будет осторожен, чтобы никто не догадался о вас.",["и так","пробудили Мы их","чтобы расспросили они","между собой","сказал","говорящий","из них","сколько","пробыли вы","сказали они","пробыли мы","день","или","часть","дня","сказали они","Господь ваш","лучше знает","о том, сколько","пробыли вы","пошлите же","одного из вас","с монетами вашими","этими","в","город","и пусть посмотрит","какая из них","чище","пищей","и пусть принесёт вам","пропитание","из неё","и пусть будет осторожен","и пусть не","даст знать","о вас","никому"]],[18,20,["إِنَّهُمۡ","إِن","يَظۡهَرُواْ","عَلَيۡكُمۡ","يَرۡجُمُوكُمۡ","أَوۡ","يُعِيدُوكُمۡ","فِي","مِلَّتِهِمۡ","وَلَن","تُفۡلِحُوٓاْ","إِذًا","أَبَدٗا"],"иннахум ин йазхаруу `алайкум йаржумуукум ау йу`иидуукум фии миллатихим валан туфлихуу изан абада","Если они узнают о вас, то побьют вас камнями или обратят вас в свою религию, и тогда вы никогда не преуспеете.",["поистине, они","если","узнают","о вас","побьют вас камнями","или","вернут вас","в","веру их","и никогда не","преуспеете вы","тогда","никогда"]]],"m":[[["وَإِذِ","и когда",18,16],["ٱعۡتَزَلۡتُمُوهُمۡ","удалились вы от них",18,16],["وَمَا","и от того, чему",18,16],["يَعۡبُدُونَ","поклоняются они",18,16],["إِلَّا","кроме",18,16],["ٱللَّهَ","Аллаха",18,16],["فَأۡوُۥٓاْ","то укройтесь",18,16],["إِلَى","в",18,16],["ٱلۡكَهۡفِ","пещере",18,16]],[["يَنشُرۡ","распространит",18,16],["لَكُمۡ","вам",18,16],["رَبُّكُم","Господь ваш",18,16],["مِّن","из",18,16],["رَّحۡمَتِهِۦ","милости Своей",18,16],["وَيُهَيِّئۡ","и устроит",18,16],["لَكُم","вам",18,16],["مِّنۡ","в",18,16],["أَمۡرِكُم","деле вашем",18,16],["مِّرۡفَقٗا","облегчение",18,16]],[[16],["۞ وَتَرَى","и видишь ты",18,17],["ٱلشَّمۡسَ","солнце",18,17],["إِذَا","когда",18,17],["طَلَعَت","восходит оно",18,17],["تَّزَٰوَرُ","уклоняется",18,17],["عَن","от",18,1