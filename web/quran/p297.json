{"p":297,"j":15,"a":[[18,28,["وَٱصۡبِرۡ","نَفۡسَكَ","مَعَ","ٱلَّذِينَ","يَدۡعُونَ","رَبَّهُم","بِٱلۡغَدَوٰةِ","وَٱلۡعَشِيِّ","يُرِيدُونَ","وَجۡهَهُۥۖ","وَلَا","تَعۡدُ","عَيۡنَاكَ","عَنۡهُمۡ","تُرِيدُ","زِينَةَ","ٱلۡحَيَوٰةِ","ٱلدُّنۡيَاۖ","وَلَا","تُطِعۡ","مَنۡ","أَغۡفَلۡنَا","قَلۡبَهُۥ","عَن","ذِكۡرِنَا","وَٱتَّبَعَ","هَوَىٰهُ","وَكَانَ","أَمۡرُهُۥ","فُرُطٗا"],"васбир нафсака ма`ал лазиина йад`ууна раббахум билгадавати вал`ашиййи йуриидууна важхахуу вала та`ду `айнака `анхум турииду зиинатал хайаватид дунйа вала тути` ман агфална ḳалбахуу `ан зикрина ваттаба`а хаваху вакана амрухуу фурута","Будь же терпелив вместе с теми, которые взывают к своему Господу по утрам и перед закатом и стремятся к Его Лику. Не отвращай от них своего взора, желая украшений этого мира, и не повинуйся тем, чьи сердца Мы сделали небрежными к Нашему поминанию, кто потакает своим желаниям и чьи дела окажутся тщетными.",["И удерживай терпеливо","себя","с","теми, которые","взывают","к Господу своему","утром","и вечером","желая","Его Лика","и пусть не","отвращаются","глаза твои","от них","желая","украшения","жизни","ближней","и не","повинуйся","тому, кого","Мы сделали небрежным","его сердце","к","Нашему поминанию","и последовал","своей страсти","и стало","дело его","чрезмерным"]],[18,29,["وَقُلِ","ٱلۡحَقُّ","مِن","رَّبِّكُمۡۖ","فَمَن","شَآءَ","فَلۡيُؤۡمِن","وَمَن","شَآءَ","فَلۡيَكۡفُرۡۚ","إِنَّآ","أَعۡتَدۡنَا","لِلظَّٰلِمِينَ","نَارًا","أَحَاطَ","بِهِمۡ","سُرَادِقُهَاۚ","وَإِن","يَسۡتَغِيثُواْ","يُغَاثُواْ","بِمَآءٖ","كَٱلۡمُهۡلِ","يَشۡوِي","ٱلۡوُجُوهَۚ","بِئۡسَ","ٱلشَّرَابُ","وَسَآءَتۡ","مُرۡتَفَقًا"],"ваḳулил хаḳḳу мир раббикум фаман шаа фалйу'мин ваман шаа фалйакфур инна а`тадна лиззалимиина наран ахата бихим сурадиḳуха ва'ин йастагиисуу йугасуу бимаин калмухли йашвил вужууха би'саш шарабу васаат муртафаḳа","Скажи: «Истина - от вашего Господа. Кто хочет, пусть верует, а кто не хочет, пусть не верует». Мы приготовили для беззаконников Огонь, стены которого будут окружать их со всех сторон. Если они станут просить о помощи (или дожде), то им помогут водой, подобной расплавленному металлу (или осадку масла), которая обжигает лицо. Мерзкий напиток и скверная обитель!",["И скажи","истина","от","Господа вашего","и кто","пожелает","пусть уверует","и кто","пожелает","пусть не верует","поистине, Мы","приготовили","для беззаконников","Огонь","окружили","их","его стены","и если","попросят они о помощи","им помогут","водой","как расплавленный металл","обжигающей","лица","скверен","напиток","и плоха","обитель"]],[18,30,["إِنَّ","ٱلَّذِينَ","ءَامَنُواْ","وَعَمِلُواْ","ٱلصَّٰلِحَٰتِ","إِنَّا","لَا","نُضِيعُ","أَجۡرَ","مَنۡ","أَحۡسَنَ","عَمَلًا"],"иннал лазиина амануу ва`амилус салихати инна ла нудии`у ажра ман ахсана `амала","А что до тех, которые уверовали и совершали праведные деяния, то ведь Мы не теряем награды тех, кто совершал добро.",["Поистине","те, которые","уверовали","и совершали","праведные дела","поистине, Мы","не","теряем","награды","того, кто","сделал хорошим","деяние"]],[18,31,["أُوْلَٰٓئِكَ","لَهُمۡ","جَنَّٰتُ","عَدۡنٖ","تَجۡرِي","مِن","تَحۡتِهِمُ","ٱلۡأَنۡهَٰرُ","يُحَلَّوۡنَ","فِيهَا","مِنۡ","أَسَاوِرَ","مِن","ذَهَبٖ","وَيَلۡبَسُونَ","ثِيَابًا","خُضۡرٗا","مِّن","سُندُسٖ","وَإِسۡتَبۡرَقٖ","مُّتَّكِـِٔينَ","فِيهَا","عَلَى","ٱلۡأَرَآئِكِۚ","نِعۡمَ","ٱلثَّوَابُ","وَحَسُنَتۡ","مُرۡتَفَقٗا"],"улаика лахум жаннату `аднин тажрии мин тахтихимул анхару йухаллауна фииха мин асавира мин захабин вайалбасууна сийабан худрам мин сундусин ва'истабраḳим муттаки'иина фииха `алал араики ни`мас савабу вахасунат муртафаḳа","Именно им уготованы сады Эдема, в которых текут реки. Они будут украшены золотыми браслетами и облачены в зеленые одеяния из атласа и парчи. Они будут возлежать там на ложах, прислонившись. Замечательное вознаграждение и прекрасная обитель!",["Те","для них","сады","Эдема","текут","из","под ними","реки","будут украшены они","в них","из","браслетов","из","золота","и будут носить они","одеяния","зелёные","из","атласа","и парчи","возлежащие","в них","на","ложах","прекрасна","награда","и хороша","обитель"]],[18,32,["وَٱضۡرِبۡ","لَهُم","مَّثَلٗا","رَّجُلَيۡنِ","جَعَلۡنَا","لِأَحَدِهِمَا","جَنَّتَيۡنِ","مِنۡ","أَعۡنَٰبٖ","وَحَفَفۡنَٰهُمَا","بِنَخۡلٖ","وَجَعَلۡنَا","بَيۡنَهُمَا","زَرۡعٗا"],"вадриб лахум масалар ражулайни жа`ална ли'ахадихима жаннатайни мин а`набин вахафафнахума бинахлин важа`ална байнахума зар`а","Приведи им притчу о двух мужах. Одному из них Мы устроили два виноградника, оградили их финиковыми пальмами и поместили между ними ниву.",["И приведи","им","притчу","о двух мужах","Мы сделали","для одного из них","два сада","из","виноградных лоз","и окружили Мы их","финиковыми пальмами","и сделали Мы","между ними","ниву"]],[18,33,["كِلۡتَا","ٱلۡجَنَّتَيۡنِ","ءَاتَتۡ","أُكُلَهَا","وَلَمۡ","تَظۡلِم","مِّنۡهُ","شَيۡـٔٗاۚ","وَفَجَّرۡنَا","خِلَٰلَهُمَا","نَهَرٗا"],"килтал жаннатайни атат укулаха валам тазлим минху шай'ан вафажжарна хилалахума нахара","Оба сада приносили плоды, и ничто из них не пропадало, а между ними Мы проложили реку.",["оба","сада","давали","свои плоды","и не","убавляли","из него","ничего","и провели Мы","между ними","реку"]],[18,34,["وَكَانَ","لَهُۥ","ثَمَرٞ","فَقَالَ","لِصَٰحِبِهِۦ","وَهُوَ","يُحَاوِرُهُۥٓ","أَنَا۠","أَكۡثَرُ","مِنكَ","مَالٗا","وَأَعَزُّ","نَفَرٗا"],"вакана лахуу самарун фаḳала лисахибихии вахуа йухавирухуу ана аксару минка малан ва'а`аззу нафара","У него были плоды (или богатство), и он сказал своему товарищу, беседуя с ним: «У меня больше имущества и помощников, чем у тебя».",["И были","у него","плоды","и сказал он","своему товарищу","а он","беседует с ним","я","больше","тебя","имуществом","и сильнее","людьми"]]],"m":[[["وَٱصۡبِرۡ","И удерживай терпеливо",18,28],["نَفۡسَكَ","себя",18,28],["مَعَ","с",18,28],["ٱلَّذِينَ","теми, которые",18,28],["يَدۡعُونَ","взывают",18,28],["رَبَّهُم","к Господу своему",18,28],["بِٱلۡغَدَوٰةِ","утром",18,28],["وَٱلۡعَشِيِّ","и вечером",18,28]],[["يُرِيدُونَ","желая",18,28],["وَجۡهَهُۥۖ","Его Лика",18,28],["وَلَا","и пусть не",18,28],["تَ