{"p":298,"j":15,"a":[[18,35,["وَدَخَلَ","جَنَّتَهُۥ","وَهُوَ","ظَالِمٞ","لِّنَفۡسِهِۦ","قَالَ","مَآ","أَظُنُّ","أَن","تَبِيدَ","هَٰذِهِۦٓ","أَبَدٗا"],"вадахала жаннатахуу вахуа залимул линафсихии ḳала ма азунну ан табиида хазихии абада","Он вошел в свой сад, поступая несправедливо по отношению к себе, и сказал: «Я не думаю, что он когда-нибудь исчезнет.",["И вошёл он","в свой сад","а он","несправедлив","к себе","сказал он","не","думаю я","что","исчезнет","этот","никогда"]],[18,36,["وَمَآ","أَظُنُّ","ٱلسَّاعَةَ","قَآئِمَةٗ","وَلَئِن","رُّدِدتُّ","إِلَىٰ","رَبِّي","لَأَجِدَنَّ","خَيۡرٗا","مِّنۡهَا","مُنقَلَبٗا"],"вама азуннус са`ата ḳаиматан валаир рудидтту ила раббии ла'ажиданна хайрам минха мунḳалаба","Я не думаю, что настанет Час. Если же меня возвратят к моему Господу, то по возвращении я обрету там нечто еще более прекрасное».",["И не","думаю я","что Час","настанет","и если же","буду возвращён я","к","Господу моему","непременно найду я","лучшее","чем этот","как место возвращения"]],[18,37,["قَالَ","لَهُۥ","صَاحِبُهُۥ","وَهُوَ","يُحَاوِرُهُۥٓ","أَكَفَرۡتَ","بِٱلَّذِي","خَلَقَكَ","مِن","تُرَابٖ","ثُمَّ","مِن","نُّطۡفَةٖ","ثُمَّ","سَوَّىٰكَ","رَجُلٗا"],"ḳала лахуу сахибухуу вахуа йухавирухуу акафарта биллазии халаḳака мин турабин сумма мин нутфатин сумма саввака ражула","Товарищ его, беседуя с ним, сказал: «Неужели ты не веруешь в Того, Кто сотворил тебя из земли, потом - из капли, а потом сделал тебя мужчиной?",["Сказал","ему","его товарищ","а он","беседует с ним","неужели ты не веруешь","в Того, Кто","сотворил тебя","из","праха","затем","из","капли семени","затем","соразмерил тебя","мужчиной"]],[18,38,["لَّٰكِنَّا۠","هُوَ","ٱللَّهُ","رَبِّي","وَلَآ","أُشۡرِكُ","بِرَبِّيٓ","أَحَدٗا"],"ллакинна хуаллаху раббии вала ушрику бираббии ахада","Что же касается меня, то мой Господь - Аллах, и я никого не приобщаю в сотоварищи к моему Господу.",["Но что до меня","Он","Аллах","мой Господь","и не","приобщаю я","к моему Господу","никого"]],[18,39,["وَلَوۡلَآ","إِذۡ","دَخَلۡتَ","جَنَّتَكَ","قُلۡتَ","مَا","شَآءَ","ٱللَّهُ","لَا","قُوَّةَ","إِلَّا","بِٱللَّهِۚ","إِن","تَرَنِ","أَنَا۠","أَقَلَّ","مِنكَ","مَالٗا","وَوَلَدٗا"],"валаула из дахалта жаннатака ḳулта ма шааллаху ла ḳуввата илла биллахи ин тарани ана аḳалла минка малан вавалада","Почему, войдя в свой сад, ты не сказал: «Так пожелал Аллах! Нет мощи, кроме как от Аллаха!» Ты считаешь, что у меня меньше богатства и детей, чем у тебя,",["И почему бы не","когда","вошёл ты","в свой сад","сказал ты","то, что","пожелал","Аллах","нет","силы","кроме как","с Аллахом","если","видишь ты меня","я","меньше","тебя","имуществом","и детьми"]],[18,40,["فَعَسَىٰ","رَبِّيٓ","أَن","يُؤۡتِيَنِ","خَيۡرٗا","مِّن","جَنَّتِكَ","وَيُرۡسِلَ","عَلَيۡهَا","حُسۡبَانٗا","مِّنَ","ٱلسَّمَآءِ","فَتُصۡبِحَ","صَعِيدٗا","زَلَقًا"],"фа`аса раббии ан йу'тийани хайрам мин жаннатика вайурсила `алайха хусбанам минас самаи фатусбиха са`иидан залаḳа","а ведь мой Господь может даровать мне то, что лучше твоего сада, и наслать на него наказание с неба, и тогда он превратится в скользкую землю.",["То, быть может","Господь мой","что","даст мне","лучшее","чем","твой сад","и нашлёт","на него","кару","с","неба","и станет он","землёй","скользкой"]],[18,41,["أَوۡ","يُصۡبِحَ","مَآؤُهَا","غَوۡرٗا","فَلَن","تَسۡتَطِيعَ","لَهُۥ","طَلَبٗا"],"ау йусбиха мауха гауран фалан тастатии`а лахуу талаба","Или же воды его уйдут под землю, и ты не сможешь достать их».",["Или","станет","его вода","ушедшей в землю","и не","сможешь ты","её","отыскать"]],[18,42,["وَأُحِيطَ","بِثَمَرِهِۦ","فَأَصۡبَحَ","يُقَلِّبُ","كَفَّيۡهِ","عَلَىٰ","مَآ","أَنفَقَ","فِيهَا","وَهِيَ","خَاوِيَةٌ","عَلَىٰ","عُرُوشِهَا","وَيَقُولُ","يَٰلَيۡتَنِي","لَمۡ","أُشۡرِكۡ","بِرَبِّيٓ","أَحَدٗا"],"ва'ухиита бисамарихии фа'асбаха йуḳаллибу каффайхи `ала ма анфаḳа фииха вахийа хавийатун `ала `уруушиха вайаḳуулу йалайтании лам ушрик бираббии ахада","Его плоды погибли, и он стал ударять себя по рукам, сожалея о том, что он потратил на виноградник, ветви которого упали на трельяжи. Он сказал: «Лучше бы я никого не приобщал в сотоварищи к моему Господу!».",["И были погублены","его плоды","и стал он","ворочать","своими ладонями","о","том, что","потратил он","на него","а он","обрушен","на","свои подпорки","и говорит он","о, если бы я","не","приобщал","к моему Господу","никого"]],[18,43,["وَلَمۡ","تَكُن","لَّهُۥ","فِئَةٞ","يَنصُرُونَهُۥ","مِن","دُونِ","ٱللَّهِ","وَمَا","كَانَ","مُنتَصِرًا"],"валам такул лахуу фи'атун йансуруунахуу мин дууниллахи вама кана мунтасира","Не было у него людей, которые бы помогли ему вместо Аллаха, и он не мог помочь самому себе.",["И не","было","у него","отряда","помогающих ему","помимо","помимо","Аллаха","и не","был он","сам защищён"]],[18,44,["هُنَالِكَ","ٱلۡوَلَٰيَةُ","لِلَّهِ","ٱلۡحَقِّۚ","هُوَ","خَيۡرٞ","ثَوَابٗا","وَخَيۡرٌ","عُقۡبٗا"],"хуналикал валайату лиллахил хаḳḳи хуа хайрун савабан вахайрун `уḳба","В таких случаях оказать поддержку может только Истинный Аллах. У Него - лучшее вознаграждение и лучший исход.",["Там","покровительство","у Аллаха","Истинного","Он","лучше","наградой","и лучше","исходом"]],[18,45,["وَٱضۡرِبۡ","لَهُم","مَّثَلَ","ٱلۡحَيَوٰةِ","ٱلدُّنۡيَا","كَمَآءٍ","أَنزَلۡنَٰهُ","مِنَ","ٱلسَّمَآءِ","فَٱخۡتَلَطَ","بِهِۦ","نَبَاتُ","ٱلۡأَرۡضِ","فَأَصۡبَحَ","هَشِيمٗا","تَذۡرُوهُ","ٱلرِّيَٰحُۗ","وَكَانَ","ٱللَّهُ","عَلَىٰ","كُلِّ","شَيۡءٖ","مُّقۡتَدِرًا"],"вадриб лахум масалал хайаватид дунйа камаин анзалнаху минас самаи фахталата бихии набатул арди фа'асбаха хашииман тазруухур рийаху ваканаллаху `ала кулли шай'им муḳтадира","Приведи им притчу о мирской жизни. Она подобна воде, которую Мы ниспосылаем с неба. Земные растения смешиваются с ней (или благодаря ней), а потом превращаются в сухие былинки, рассеиваемые ветром. Воистину, Аллах способен на всякую вещь.",["И приведи","им","пример","жизни","ближней","как вода","Мы ниспослали её","с","неба","и смешалась","с ней","растительность","земли","и стала она","сухими стеблями","развеивают её","ветры","и есть","Аллах","над","всякой","вещью","всемогущ"]]],