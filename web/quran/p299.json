{"p":299,"j":15,"a":[[18,46,["ٱلۡمَالُ","وَٱلۡبَنُونَ","زِينَةُ","ٱلۡحَيَوٰةِ","ٱلدُّنۡيَاۖ","وَٱلۡبَٰقِيَٰتُ","ٱلصَّٰلِحَٰتُ","خَيۡرٌ","عِندَ","رَبِّكَ","ثَوَابٗا","وَخَيۡرٌ","أَمَلٗا"],"алмалу валбанууна зиинатул хайаватид дунйа валбаḳийатус салихату хайрун `инда раббика савабан вахайрун амала","Богатство и сыновья - украшение мирской жизни, однако нетленные благодеяния лучше по вознаграждению перед твоим Господом, и на них лучше возлагать надежды.",["Имущество","и сыновья","украшение","жизни","ближней","а нетленные","благие дела","лучше","у","Господа твоего","наградой","и лучше","надеждой"]],[18,47,["وَيَوۡمَ","نُسَيِّرُ","ٱلۡجِبَالَ","وَتَرَى","ٱلۡأَرۡضَ","بَارِزَةٗ","وَحَشَرۡنَٰهُمۡ","فَلَمۡ","نُغَادِرۡ","مِنۡهُمۡ","أَحَدٗا"],"вайаума нусаййирул жибала ватарал арда баризатан вахашарнахум фалам нугадир минхум ахада","В тот день Мы заставим двигаться горы, и ты увидишь, что земля станет плоской. Мы соберем их всех и никого не упустим.",["И в день, когда","сдвинем Мы","горы","и увидишь ты","землю","открытой","и собрали Мы их","и не","оставили Мы","из них","никого"]],[18,48,["وَعُرِضُواْ","عَلَىٰ","رَبِّكَ","صَفّٗا","لَّقَدۡ","جِئۡتُمُونَا","كَمَا","خَلَقۡنَٰكُمۡ","أَوَّلَ","مَرَّةِۭۚ","بَلۡ","زَعَمۡتُمۡ","أَلَّن","نَّجۡعَلَ","لَكُم","مَّوۡعِدٗا"],"ва`уридуу `ала раббика саффал лаḳад жи'тумууна кама халаḳнакум аввала маррати бал за`амтум аллан наж`ала лакум мау`ида","Они предстанут перед твоим Господом рядами: «Вы пришли к Нам такими, какими Мы создали вас в первый раз. Но вы предполагали, что Мы не назначили встречи с вами».",["И представлены были они","перед","Господом твоим","рядами","действительно","пришли вы к Нам","как","Мы сотворили вас","в первый","раз","но","утверждали вы","что никогда не","назначим Мы","для вас","встречи"]],[18,49,["وَوُضِعَ","ٱلۡكِتَٰبُ","فَتَرَى","ٱلۡمُجۡرِمِينَ","مُشۡفِقِينَ","مِمَّا","فِيهِ","وَيَقُولُونَ","يَٰوَيۡلَتَنَا","مَالِ","هَٰذَا","ٱلۡكِتَٰبِ","لَا","يُغَادِرُ","صَغِيرَةٗ","وَلَا","كَبِيرَةً","إِلَّآ","أَحۡصَىٰهَاۚ","وَوَجَدُواْ","مَا","عَمِلُواْ","حَاضِرٗاۗ","وَلَا","يَظۡلِمُ","رَبُّكَ","أَحَدٗا"],"вавуди`ал китабу фатарал мужримиина мушфиḳиина мимма фиихи вайаḳуулууна йавайлатана мали хазал китаби ла йугадиру сагииратан вала кабииратан илла ахсаха ваважадуу ма `амилуу хадиран вала йазлиму раббука ахада","Будет положена книга, и ты увидишь, как грешники будут трепещать от того, что в ней. Они скажут: «Горе нам! Что это за книга! В ней не упущен ни малый, ни великий грех - все подсчитано». Они обнаружат перед собой все, что совершили, и твой Господь ни с кем не поступит несправедливо.",["И положена","книга","и увидишь ты","грешников","страшащимися","того, что","в ней","и говорят они","о горе нам","что с","этой","книгой","не","упускает она","малого","и не","великого","кроме как","подсчитала его","и нашли они","то, что","совершили они","присутствующим","и не","обидит","Господь твой","никого"]],[18,50,["وَإِذۡ","قُلۡنَا","لِلۡمَلَٰٓئِكَةِ","ٱسۡجُدُواْ","لِأٓدَمَ","فَسَجَدُوٓاْ","إِلَّآ","إِبۡلِيسَ","كَانَ","مِنَ","ٱلۡجِنِّ","فَفَسَقَ","عَنۡ","أَمۡرِ","رَبِّهِۦٓۗ","أَفَتَتَّخِذُونَهُۥ","وَذُرِّيَّتَهُۥٓ","أَوۡلِيَآءَ","مِن","دُونِي","وَهُمۡ","لَكُمۡ","عَدُوُّۢۚ","بِئۡسَ","لِلظَّٰلِمِينَ","بَدَلٗا"],"ва'из ḳулна лилмалаикатисжудуу ли'адама фасажадуу илла иблииса кана минал жинни фафасаḳа `ан амри раббихии афататтахизуунахуу вазурриййатахуу аулийаа мин дуунии вахум лакум `адувву би'са лиззалимиина бадала","Вот сказали Мы ангелам: «Падите ниц перед Адамом!». Все они поклонились, кроме Иблиса. Он был одним из джиннов и ослушался воли своего Господа. Неужели вы признаете его и его потомков своими покровителями и помощниками вместо Меня, тогда как они являются вашими врагами? Плохая это замена для беззаконников!",["И вот","сказали Мы","ангелам","падите ниц","перед Адамом","и пали ниц они","кроме","Иблиса","был он","из","джиннов","и отступил он","от","повеления","Господа своего","неужели возьмёте вы его","и его потомство","покровителями","помимо","Меня","а они","вам","враги","скверна","для беззаконников","замена"]],[18,51,["مَّآ","أَشۡهَدتُّهُمۡ","خَلۡقَ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِ","وَلَا","خَلۡقَ","أَنفُسِهِمۡ","وَمَا","كُنتُ","مُتَّخِذَ","ٱلۡمُضِلِّينَ","عَضُدٗا"],"мма ашхадттухум халḳас самавати вал'арди вала халḳа анфусихим вама кунту муттахизал мудиллиина `адуда","Я не сделал их свидетелями сотворения небес и земли и сотворения их самих. Я не беру в помощники тех, кто вводит других в заблуждение.",["Не","сделал Я их свидетелями","сотворения","небес","и земли","и не","сотворения","их самих","и не","был Я","берущим","сбивающих с пути","помощниками"]],[18,52,["وَيَوۡمَ","يَقُولُ","نَادُواْ","شُرَكَآءِيَ","ٱلَّذِينَ","زَعَمۡتُمۡ","فَدَعَوۡهُمۡ","فَلَمۡ","يَسۡتَجِيبُواْ","لَهُمۡ","وَجَعَلۡنَا","بَيۡنَهُم","مَّوۡبِقٗا"],"вайаума йаḳуулу надуу шуракаийал лазиина за`амтум фада`аухум фалам йастажиибуу лахум важа`ална байнахум маубиḳа","В тот день Он скажет: «Призовите Моих сотоварищей, о существовании которых вы предполагали». Они воззовут к ним, но те не ответят им. Мы воздвигнем между ними губительное место (преграду).",["И в день, когда","скажет Он","позовите","Моих сотоварищей","которых","утверждали вы","и позвали они их","но не","ответили они","им","и сделали Мы","между ними","место гибели"]],[18,53,["وَرَءَا","ٱلۡمُجۡرِمُونَ","ٱلنَّارَ","فَظَنُّوٓاْ","أَنَّهُم","مُّوَاقِعُوهَا","وَلَمۡ","يَجِدُواْ","عَنۡهَا","مَصۡرِفٗا"],"вараал мужримуунан нара фазаннуу аннахум муаḳи`ууха валам йажидуу `анха масрифа","Грешники увидят Огонь, и им станет ясно, что они будут брошены в него. Они не найдут от него спасения!",["И увидели","грешники","Огонь","и поняли они","что они","попадут в него","и не","нашли они","от него","спасения"]]],"m":[[["ٱلۡمَالُ","Имущество",18,46],["وَٱلۡبَنُونَ","и сыновья",18,46],["زِينَةُ","украшение",18,46],["ٱلۡحَيَوٰةِ","жизни",18,46],["ٱلدُّنۡيَاۖ","ближней",18,46],["وَٱلۡبَٰقِيَٰتُ","а нетленные",18,46],["ٱلصَّٰلِحَٰتُ","благие дела",18,46]],[["خَيۡرٌ","лучше",18,46],["عِندَ","у",18,46],["رَبِّكَ","Господа твоего",18,46],["ثَوَابٗا","наградой",18,46],["وَخَيۡرٌ","и лучше",18,46],["أَمَلٗا","надеждой",18,46],[46],["وَيَوۡمَ","И в день, когда",18,47],["نُسَيِّرُ","сдвинем Мы",18,47],["ٱلۡجِبَالَ","горы",18,47],["وَتَرَى","и увидишь ты",18,47]],[["ٱلۡأَرۡضَ","землю",18,47],["بَارِزَةٗ","открытой",18,47],["وَحَشَرۡنَٰهُمۡ","и собрали Мы их",18,47],["فَلَمۡ","и не",18,47],["نُغَادِرۡ","оставили Мы",18,47],["مِنۡهُمۡ","из них",18,47],["أَحَدٗا","никого",18,47],[47],["وَعُرِضُواْ","И представлены были они",18,48]],[["عَلَىٰ","перед",18,48],["رَبِّكَ","Господом твоим",18,48],["صَفّٗا","рядами",18,48],["لَّقَدۡ","действительно",18,48],["جِئۡتُمُونَا","пришли вы к Нам",18,48],["كَمَا","как",18,48],["خَلَقۡنَٰكُمۡ","Мы сотворили вас",18,48],["أَوَّلَ","в первый",18,48],["مَرَّةِۭۚ","раз",18,48],["بَلۡ","но",18,48],["زَعَمۡتُمۡ","утверждали вы",18,48]],[["أَلَّن","что никогда не",18,48],["نَّجۡعَلَ","назначим Мы",18,48],["لَكُم","для вас",18,48],["مَّوۡعِدٗا","встречи",18,48],[48],["وَوُضِعَ","И положена",18,49],["ٱلۡكِتَٰبُ","книга",18,49],["فَتَرَى","и увидишь ты",18,49],["ٱلۡمُجۡرِمِينَ","грешников",18,49]],[["مُشۡفِقِينَ","страшащимися",18,49],["مِمَّا","того, что",18,49],["فِيهِ","в ней",18,49],["وَيَقُولُونَ","и говорят они",18,49],["يَٰوَيۡلَتَنَا","о горе нам",18,49],["مَالِ","что с",18,49],["هَٰذَا","этой",18,49],["ٱلۡكِتَٰبِ","книгой",18,49]],[["لَا","не",18,49],["يُغَادِرُ","упускает она",18,49],["صَغِيرَةٗ","малого",18,49],["وَلَا","и не",18,49],["كَبِيرَةً","великого",18,49],["إِلَّآ","кроме как",18,49],["أَحۡصَىٰهَاۚ","подсчитала его",18,49],["وَوَجَدُواْ","и нашли они",18,49],["مَا","то, что",18,49],["عَمِلُواْ","совершили они",18,49]],[["حَاضِرٗاۗ","присутствующим",18,49],["وَلَا","и не",18,49],["يَظۡلِمُ","обидит",18,49],["رَبُّكَ","Господь твой",18,49],["أَحَدٗا","никого",18,49],[49],["وَإِذۡ","И вот",18,50],["قُلۡنَا","сказали Мы",18,50],["لِلۡمَلَٰٓئِكَةِ","ангелам",18,50],["ٱسۡجُدُواْ","падите ниц",18,50]],[["لِأٓدَمَ","перед Адамом",18,50],["فَسَجَدُوٓاْ","и пали ниц они",18,50],["إِلَّآ","кроме",18,50],["إِبۡلِيسَ","Иблиса",18,50],["كَانَ","был он",18,50],["مِنَ","из",18,50],["ٱلۡجِنِّ","джиннов",18,50],["فَفَسَقَ","и отступил он",18,50],["عَنۡ","от",18,50],["أَمۡرِ","повеления",18,50],["رَبِّهِۦٓۗ","Господа своего",18,50]],[["أَفَتَتَّخِذُونَهُۥ","неужели возьмёте вы его",18,50],["وَذُرِّيَّتَهُۥٓ","и его потомство",18,50],["أَوۡلِيَآءَ","покровителями",18,50],["مِن","помимо",18,50],["دُونِي","Меня",18,50],["وَهُمۡ","а они",18,50],["لَكُمۡ","вам",18,50],["عَدُوُّۢۚ","враги",18,50]],[["بِئۡسَ","скверна",18,50],["لِلظَّٰلِمِينَ","для беззаконников",18,50],["بَدَلٗا","замена",18,50],[50],["۞ مَّآ","Не",18,51],["أَشۡهَدتُّهُمۡ","сделал Я их свидетелями",18,51],["خَلۡقَ","сотворения",18,51],["ٱلسَّمَٰوَٰتِ","небес",18,51]],[["وَٱلۡأَرۡضِ","и земли",18,51],["وَلَا","и не",18,51],["خَلۡقَ","сотворения",18,51],["أَنفُسِهِمۡ","их самих",18,51],["وَمَا","и не",18,51],["كُنتُ","был Я",18,51],["مُتَّخِذَ","берущим",18,51],["ٱلۡمُضِلِّينَ","сбивающих с пути",18,51],["عَضُدٗا","помощниками",18,51]],[[51],["وَيَوۡمَ","И в день, когда",18,52],["يَقُولُ","скажет Он",18,52],["نَادُواْ","позовите",18,52],["شُرَكَآءِيَ","Моих сотоварищей",18,52],["ٱلَّذِينَ","которых",18,52],["زَعَمۡتُمۡ","утверждали вы",18,52],["فَدَعَوۡهُمۡ","и позвали они их",18,52]],[["فَلَمۡ","но не",18,52],["يَسۡتَجِيبُواْ","ответили они",18,52],["لَهُمۡ","им",18,52],["وَجَعَلۡنَا","и сделали Мы",18,52],["بَيۡنَهُم","между ними",18,52],["مَّوۡبِقٗا","место гибели",18,52],[52],["وَرَءَا","И увидели",18,53],["ٱلۡمُجۡرِمُونَ","грешники",18,53]],[["ٱلنَّارَ","Огонь",18,53],["فَظَنُّوٓاْ","и поняли они",18,53],["أَنَّهُم","что они",18,53],["مُّوَاقِعُوهَا","попадут в него",18,53],["وَلَمۡ","и не",18,53],["يَجِدُواْ","нашли они",18,53],["عَنۡهَا","от него",18,53],["مَصۡرِفٗا","спасения",18,53],[53]]]}