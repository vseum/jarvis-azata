{"p":300,"j":15,"a":[[18,54,["وَلَقَدۡ","صَرَّفۡنَا","فِي","هَٰذَا","ٱلۡقُرۡءَانِ","لِلنَّاسِ","مِن","كُلِّ","مَثَلٖۚ","وَكَانَ","ٱلۡإِنسَٰنُ","أَكۡثَرَ","شَيۡءٖ","جَدَلٗا"],"валаḳад саррафна фии хазал ḳур'ани линнаси мин кулли масалин ваканал инсану аксара шай'ин жадала","Мы разъяснили людям в этом Коране любые притчи, но человек больше всего склонен препираться.",["И действительно","разъяснили Мы","в","этом","Коране","для людей","из","всякого","примера","и есть","человек","более","всего","препирающийся"]],[18,55,["وَمَا","مَنَعَ","ٱلنَّاسَ","أَن","يُؤۡمِنُوٓاْ","إِذۡ","جَآءَهُمُ","ٱلۡهُدَىٰ","وَيَسۡتَغۡفِرُواْ","رَبَّهُمۡ","إِلَّآ","أَن","تَأۡتِيَهُمۡ","سُنَّةُ","ٱلۡأَوَّلِينَ","أَوۡ","يَأۡتِيَهُمُ","ٱلۡعَذَابُ","قُبُلٗا"],"вама мана`ан наса ан йу'минуу из жаахумул худа вайастагфируу раббахум илла ан та'тийахум суннатул аввалиина ау йа'тийахумул `азабу ḳубула","Что же помешало людям уверовать, когда к ним явилось верное руководство, и попросить прощения у своего Господа, если не стремление к участи первых поколений и мучениям, которые предстанут перед ними лицом к лицу?",["И ничто не","помешало","людям","чтобы","уверовали они","когда","пришло к ним","руководство","и попросили прощения","у Господа своего","кроме как","что","придёт к ним","участь","первых","или","придёт к ним","наказание","воочию"]],[18,56,["وَمَا","نُرۡسِلُ","ٱلۡمُرۡسَلِينَ","إِلَّا","مُبَشِّرِينَ","وَمُنذِرِينَۚ","وَيُجَٰدِلُ","ٱلَّذِينَ","كَفَرُواْ","بِٱلۡبَٰطِلِ","لِيُدۡحِضُواْ","بِهِ","ٱلۡحَقَّۖ","وَٱتَّخَذُوٓاْ","ءَايَٰتِي","وَمَآ","أُنذِرُواْ","هُزُوٗا"],"вама нурсилул мурсалиина илла мубашшириина вамунзириина вайужадилул лазиина кафаруу билбатили лийудхидуу бихил хаḳḳа ваттахазуу айатии вама унзируу хузуа","Мы отправляем посланников только добрыми вестниками и предостерегающими увещевателями. Однако неверующие препираются посредством лживых доводов, чтобы опровергнуть ими истину, и насмехаются над Моими знамениями и тем, от чего их предостерегают.",["И не","посылаем Мы","посланников","кроме как","благовестниками","и предостерегающими","и препираются","те, которые","не уверовали","ложью","чтобы опровергнуть","ею","истину","и взяли они","Мои знамения","и то, чем","их предостерегали","насмешкой"]],[18,57,["وَمَنۡ","أَظۡلَمُ","مِمَّن","ذُكِّرَ","بِـَٔايَٰتِ","رَبِّهِۦ","فَأَعۡرَضَ","عَنۡهَا","وَنَسِيَ","مَا","قَدَّمَتۡ","يَدَاهُۚ","إِنَّا","جَعَلۡنَا","عَلَىٰ","قُلُوبِهِمۡ","أَكِنَّةً","أَن","يَفۡقَهُوهُ","وَفِيٓ","ءَاذَانِهِمۡ","وَقۡرٗاۖ","وَإِن","تَدۡعُهُمۡ","إِلَى","ٱلۡهُدَىٰ","فَلَن","يَهۡتَدُوٓاْ","إِذًا","أَبَدٗا"],"ваман азламу мимман зуккира би'айати раббихии фа'а`рада `анха ванасийа ма ḳаддамат йадаху инна жа`ална `ала ḳулуубихим акиннатан ан йафḳахууху вафии азанихим ваḳран ва'ин тад`ухум илал худа фалан йахтадуу изан абада","Кто может быть несправедливее того, кому напомнили о знамениях его Господа, а он отвернулся от них и забыл то, что совершили его руки? Мы накинули на их сердца покрывала, чтобы они не постигли его (Коран), а их уши поражены глухотой. Если даже ты призовешь их на прямой путь, они никогда не последуют прямым путем.",["И кто","несправедливее","того, кому","напомнили","о знамениях","Господа его","и отвернулся он","от них","и забыл","то, что","уготовили","его руки","поистине, Мы","поместили","на","их сердца","покровы","чтобы не","поняли они его","и в","их ушах","глухота","и если","позовёшь ты их","к","руководству","то никогда не","пойдут они прямым путём","тогда","вовеки"]],[18,58,["وَرَبُّكَ","ٱلۡغَفُورُ","ذُو","ٱلرَّحۡمَةِۖ","لَوۡ","يُؤَاخِذُهُم","بِمَا","كَسَبُواْ","لَعَجَّلَ","لَهُمُ","ٱلۡعَذَابَۚ","بَل","لَّهُم","مَّوۡعِدٞ","لَّن","يَجِدُواْ","مِن","دُونِهِۦ","مَوۡئِلٗا"],"вараббукал гафууру зур рахмати лау йу'ахизухум бима касабуу ла`ажжала лахумул `азаба бал лахум мау`идул лан йажидуу мин дуунихии мауила","Твой Господь - Прощающий, Обладающий милосердием. Если бы Он стал наказывать их за то, что они приобрели, то ускорил бы их мучения, но для них назначен срок, и они не найдут от него спасения.",["И Господь твой","Прощающий","Обладатель","милосердия","если бы","наказывал Он их","за то, что","приобрели они","непременно ускорил бы Он","для них","наказание","но","для них","срок","никогда не","найдут они","помимо","него","убежища"]],[18,59,["وَتِلۡكَ","ٱلۡقُرَىٰٓ","أَهۡلَكۡنَٰهُمۡ","لَمَّا","ظَلَمُواْ","وَجَعَلۡنَا","لِمَهۡلِكِهِم","مَّوۡعِدٗا"],"ватилкал ḳура ахлакнахум ламма заламуу важа`ална лимахликихим мау`ида","Мы погубили эти города, когда они стали поступать несправедливо, и установили для их погибели срок.",["И эти","селения","Мы погубили их","когда","поступили они несправедливо","и сделали Мы","для их погибели","срок"]],[18,60,["وَإِذۡ","قَالَ","مُوسَىٰ","لِفَتَىٰهُ","لَآ","أَبۡرَحُ","حَتَّىٰٓ","أَبۡلُغَ","مَجۡمَعَ","ٱلۡبَحۡرَيۡنِ","أَوۡ","أَمۡضِيَ","حُقُبٗا"],"ва'из ḳала мууса лифатаху ла абраху хатта аблуга мажма`ал бахрайни ау амдийа хуḳуба","Вот Муса (Моисей) сказал своему слуге: «Я не остановлюсь, пока не дойду до места слияния двух морей или пока не потрачу на путешествие долгие годы».",["И вот","сказал","Муса","своему юноше","не","перестану я","пока не","достигну я","слияния","двух морей","или","буду идти","долгие годы"]],[18,61,["فَلَمَّا","بَلَغَا","مَجۡمَعَ","بَيۡنِهِمَا","نَسِيَا","حُوتَهُمَا","فَٱتَّخَذَ","سَبِيلَهُۥ","فِي","ٱلۡبَحۡرِ","سَرَبٗا"],"фаламма балага мажма`а байнихима насийа хуутахума фаттахаза сабиилахуу фил бахри сараба","Когда они дошли до места их слияния, они забыли свою рыбу, и она двинулась в путь по морю, словно по подземному ходу.",["А когда","достигли они","слияния","между ними","забыли они","свою рыбу","и избрала она","свой путь","в","море","подземным ходом"]]],"m":[[["وَلَقَدۡ","И действительно",18,54],["صَرَّفۡنَا","разъяснили Мы",18,54],["فِي","в",18,54],["هَٰذَا","этом",18,54],["ٱلۡقُرۡءَانِ","Коране",18,54],["لِلنَّاسِ","для людей",18,54],["مِن","из",18,54],["كُلِّ","всякого",18,54],["مَثَلٖۚ","примера",18,54],["وَكَانَ","и есть",18,54]],[["ٱلۡإِنسَٰنُ","человек",18,54],["أَكۡثَرَ","более",18,54],["شَيۡءٖ","всего",18,54],["جَدَلٗا","препирающийся",18,54],[54],["وَمَا","И ничто не",18,55],["مَنَعَ","помешало",18,55],["ٱلنَّاسَ","людям",18,55],["أَن","чтобы",18,55],["يُؤۡمِنُوٓاْ","уверовали они",18,55]],[["إِذۡ","когда",18,55],["جَآءَهُمُ","пришло к ним",18,55],["ٱلۡهُدَىٰ","руководство",18,55],["وَيَسۡتَغۡفِرُواْ","и попросили прощения",18,55],["رَبَّهُمۡ","у Господа своего",18,55],["إِلَّآ","кроме как",18,55],["أَن","что",18,55],["تَأۡتِيَهُمۡ","придёт к ним",18,55],["سُنَّةُ","участь",18,55]],[["ٱلۡأَوَّلِينَ","первых",18,55],["أَوۡ","или",18,55],["يَأۡتِيَهُمُ","придёт к ним",18,55],["ٱلۡعَذَابُ","наказание",18,55],["قُبُلٗا","воочию",18,55],[55],["وَمَا","И не",18,56],["نُرۡسِلُ","посылаем Мы",18,56],["ٱلۡمُرۡسَلِينَ","посланников",18,56]],[["إِلَّا","кроме как",18,56],["مُبَشِّرِينَ","благовестниками",18,56],["وَمُنذِرِينَۚ","и предостерегающими",18,56],["وَيُجَٰدِلُ","и препираются",18,56],["ٱلَّذِينَ","те, которые",18,56],["كَفَرُواْ","не уверовали",18,56],["بِٱلۡبَٰطِلِ","ложью",18,56]],[["لِيُدۡحِضُواْ","чтобы опровергнуть",18,56],["بِهِ","ею",18,56],["ٱلۡحَقَّۖ","истину",18,56],["وَٱتَّخَذُوٓاْ","и взяли они",18,56],["ءَايَٰتِي","Мои знамения",18,56],["وَمَآ","и то, чем",18,56],["أُنذِرُواْ","их предостерегали",18,56],["هُزُوٗا","насмешкой",18,56],[56],["وَمَنۡ","И кто",18,57]],[["أَظۡلَمُ","несправедливее",18,57],["مِمَّن","того, кому",18,57],["ذُكِّرَ","напомнили",18,57],["بِـَٔايَٰتِ","о знамениях",18,57],["رَبِّهِۦ","Господа его",18,57],["فَأَعۡرَضَ","и отвернулся он",18,57],["عَنۡهَا","от них",18,57],["وَنَسِيَ","и забыл",18,57],["مَا","то, что",18,57],["قَدَّمَتۡ","уготовили",18,57],["يَدَاهُۚ","его руки",18,57]],[["إِنَّا","поистине, Мы",18,57],["جَعَلۡنَا","поместили",18,57],["عَلَىٰ","на",18,57],["قُلُوبِهِمۡ","их сердца",18,57],["أَكِنَّةً","покровы",18,57],["أَن","чтобы не",18,57],["يَفۡقَهُوهُ","поняли они его",18,57],["وَفِيٓ","и в",18,57],["ءَاذَانِهِمۡ","их ушах",18,57],["وَقۡرٗاۖ","глухота",18,57]],[["وَإِن","и если",18,57],["تَدۡعُهُمۡ","позовёшь ты их",18,57],["إِلَى","к",18,57],["ٱلۡهُدَىٰ","руководству",18,57],["فَلَن","то никогда не",18,57],["يَهۡتَدُوٓاْ","пойдут они прямым путём",18,57],["إِذًا","тогда",18,57],["أَبَدٗا","вовеки",18,57],[57],["وَرَبُّكَ","И Господь твой",18,58]],[["ٱلۡغَفُورُ","Прощающий",18,58],["ذُو","Обладатель",18,58],["ٱلرَّحۡمَةِۖ","милосердия",18,58],["لَوۡ","если бы",18,58],["يُؤَاخِذُهُم","наказывал Он их",18,58],["بِمَا","за то, что",18,58],["كَسَبُواْ","приобрели они",18,58],["لَعَجَّلَ","непременно ускорил бы Он",18,58],["لَهُمُ","для них",18,58]],[["ٱلۡعَذَابَۚ","наказание",18,58],["بَل","но",18,58],["لَّهُم","для них",18,58],["مَّوۡعِدٞ","срок",18,58],["لَّن","никогда не",18,58],["يَجِدُواْ","найдут они",18,58],["مِن","помимо",18,58],["دُونِهِۦ","него",18,58],["مَوۡئِلٗا","убежища",18,58],[58]],[["وَتِلۡكَ","И эти",18,59],["ٱلۡقُرَىٰٓ","селения",18,59],["أَهۡلَكۡنَٰهُمۡ","Мы погубили их",18,59],["لَمَّا","когда",18,59],["ظَلَمُواْ","поступили они несправедливо",18,59],["وَجَعَلۡنَا","и сделали Мы",18,59],["لِمَهۡلِكِهِم","для их погибели",18,59]],[["مَّوۡعِدٗا","срок",18,59],[59],["وَإِذۡ","И вот",18,60],["قَالَ","сказал",18,60],["مُوسَىٰ","Муса",18,60],["لِفَتَىٰهُ","своему юноше",18,60],["لَآ","не",18,60],["أَبۡرَحُ","перестану я",18,60],["حَتَّىٰٓ","пока не",18,60]],[["أَبۡلُغَ","достигну я",18,60],["مَجۡمَعَ","слияния",18,60],["ٱلۡبَحۡرَيۡنِ","двух морей",18,60],["أَوۡ","или",18,60],["أَمۡضِيَ","буду идти",18,60],["حُقُبٗا","долгие годы",18,60],[60],["فَلَمَّا","А когда",18,61],["بَلَغَا","достигли они",18,61]],[["مَجۡمَعَ","слияния",18,61],["بَيۡنِهِمَا","между ними",18,61],["نَسِيَا","забыли они",18,61],["حُوتَهُمَا","свою рыбу",18,61],["فَٱتَّخَذَ","и избрала она",18,61],["سَبِيلَهُۥ","свой путь",18,61],["فِي","в",18,61],["ٱلۡبَحۡرِ","море",18,61],["سَرَبٗا","подземным ходом",18,61],[61]]]}