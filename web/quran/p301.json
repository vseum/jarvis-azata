{"p":301,"j":15,"a":[[18,62,["فَلَمَّا","جَاوَزَا","قَالَ","لِفَتَىٰهُ","ءَاتِنَا","غَدَآءَنَا","لَقَدۡ","لَقِينَا","مِن","سَفَرِنَا","هَٰذَا","نَصَبٗا"],"фаламма жаваза ḳала лифатаху атина гадаана лаḳад лаḳиина мин сафарина хаза насаба","Когда они прошли дальше, он сказал своему слуге: «Подавай наш обед, ведь мы утомились в пути».",["А когда","прошли они дальше","сказал он","своему юноше","подай нам","наш обед","действительно","встретили мы","в","нашем путешествии","этом","усталость"]],[18,63,["قَالَ","أَرَءَيۡتَ","إِذۡ","أَوَيۡنَآ","إِلَى","ٱلصَّخۡرَةِ","فَإِنِّي","نَسِيتُ","ٱلۡحُوتَ","وَمَآ","أَنسَىٰنِيهُ","إِلَّا","ٱلشَّيۡطَٰنُ","أَنۡ","أَذۡكُرَهُۥۚ","وَٱتَّخَذَ","سَبِيلَهُۥ","فِي","ٱلۡبَحۡرِ","عَجَبٗا"],"ḳала араайта из авайна илас сахрати фа'иннии насиитул хуута вама ансанииху иллаш шайтану ан азкурахуу ваттахаза сабиилахуу фил бахри `ажаба","Он сказал: «Помнишь, как мы укрылись под скалой? Я забыл о рыбе, и только дьявол заставил меня не вспомнить о ней. Она же отправилась в путь по морю чудесным образом».",["Сказал он","видел ли ты","когда","укрылись мы","у","скалы","то, поистине, я","забыл","рыбу","и не","заставил меня забыть её","лишь","шайтан","чтобы","упомянул я её","и избрала она","свой путь","в","море","удивительно"]],[18,64,["قَالَ","ذَٰلِكَ","مَا","كُنَّا","نَبۡغِۚ","فَٱرۡتَدَّا","عَلَىٰٓ","ءَاثَارِهِمَا","قَصَصٗا"],"ḳала залика ма кунна набги фартадда `ала асарихима ḳасаса","Муса (Моисей) сказал: «Это - то, чего мы желали!» - и они вернулись назад по своим следам.",["Сказал он","это","то, что","мы","искали","и вернулись они","по","своим следам","прослеживая"]],[18,65,["فَوَجَدَا","عَبۡدٗا","مِّنۡ","عِبَادِنَآ","ءَاتَيۡنَٰهُ","رَحۡمَةٗ","مِّنۡ","عِندِنَا","وَعَلَّمۡنَٰهُ","مِن","لَّدُنَّا","عِلۡمٗا"],"фаважада `абдам мин `ибадина атайнаху рахматам мин `индина ва`алламнаху мил ладунна `илма","Они встретили одного из Наших рабов, которого Мы одарили милостью от Нас и обучили из того, что Нам известно.",["И нашли они","раба","из","Наших рабов","которому Мы даровали","милость","от","Нас","и научили Мы его","от","Нас","знанию"]],[18,66,["قَالَ","لَهُۥ","مُوسَىٰ","هَلۡ","أَتَّبِعُكَ","عَلَىٰٓ","أَن","تُعَلِّمَنِ","مِمَّا","عُلِّمۡتَ","رُشۡدٗا"],"ḳала лахуу мууса хал аттаби`ука `ала ан ту`аллимани мимма `уллимта рушда","Муса (Моисей) сказал ему (Хадиру): «Могу ли я последовать за тобой, чтобы ты научил меня о прямом пути тому, чему ты обучен?».",["Сказал","ему","Муса","можно ли","последовать мне за тобой","с тем","чтобы","научил ты меня","из того, чему","ты научен","прямому пути"]],[18,67,["قَالَ","إِنَّكَ","لَن","تَسۡتَطِيعَ","مَعِيَ","صَبۡرٗا"],"ḳала иннака лан тастатии`а ма`ийа сабра","Он сказал: «У тебя не хватит терпения находиться рядом со мной.",["сказал","поистине, ты","никогда не","сможешь","со мной","терпеть"]],[18,68,["وَكَيۡفَ","تَصۡبِرُ","عَلَىٰ","مَا","لَمۡ","تُحِطۡ","بِهِۦ","خُبۡرٗا"],"вакайфа тасбиру `ала ма лам тухит бихии хубра","Как ты сможешь терпеливо относиться к тому, что ты не объемлешь знанием?».",["И как","вытерпишь ты","в","том, что","не","объял ты","его","знанием"]],[18,69,["قَالَ","سَتَجِدُنِيٓ","إِن","شَآءَ","ٱللَّهُ","صَابِرٗا","وَلَآ","أَعۡصِي","لَكَ","أَمۡرٗا"],"ḳала сатажидунии ин шааллаху сабиран вала а`сии лака амра","Муса (Моисей) сказал: «Если Аллах пожелает, то ты увидишь, что я терпелив, и я не ослушаюсь твоего веления».",["Сказал он","найдёшь ты меня","если","пожелает","Аллах","терпеливым","и не","ослушаюсь я","тебя","в повелении"]],[18,70,["قَالَ","فَإِنِ","ٱتَّبَعۡتَنِي","فَلَا","تَسۡـَٔلۡنِي","عَن","شَيۡءٍ","حَتَّىٰٓ","أُحۡدِثَ","لَكَ","مِنۡهُ","ذِكۡرٗا"],"ḳала фа'иниттаба`тании фала тас'алнии `ан шай'ин хатта ухдиса лака минху зикра","Он сказал: «Если ты последуешь за мной, то не спрашивай меня ни о чем, пока я сам не поведаю тебе об этом».",["Сказал он","а если","последуешь ты за мной","то не","спрашивай меня","о","чём-либо","пока не","открою я","тебе","о нём","рассказ"]],[18,71,["فَٱنطَلَقَا","حَتَّىٰٓ","إِذَا","رَكِبَا","فِي","ٱلسَّفِينَةِ","خَرَقَهَاۖ","قَالَ","أَخَرَقۡتَهَا","لِتُغۡرِقَ","أَهۡلَهَا","لَقَدۡ","جِئۡتَ","شَيۡـًٔا","إِمۡرٗا"],"фанталаḳа хатта иза ракиба фис сафиинати хараḳаха ḳала ахараḳтаха литугриḳа ахлаха лаḳад жи'та шай'ан имра","Они вдвоем двинулись в путь. Когда же они сели на корабль, он сделал в нем пробоину. Он сказал: «Ты сделал пробоину, чтобы потопить людей на нем? Ты совершил тяжкий поступок!».",["И пошли они","пока","когда","сели они","на","корабль","продырявил он его","сказал он","продырявил ли ты его","чтобы потопить","его людей","действительно","совершил ты","дело","тяжкое"]],[18,72,["قَالَ","أَلَمۡ","أَقُلۡ","إِنَّكَ","لَن","تَسۡتَطِيعَ","مَعِيَ","صَبۡرٗا"],"ḳала алам аḳул иннака лан тастатии`а ма`ийа сабра","Он сказал: «Разве я не говорил, что ты не сможешь сохранять терпение рядом со мной?».",["Сказал он","разве не","говорил я","что ты","никогда не","сможешь","со мной","терпеть"]],[18,73,["قَالَ","لَا","تُؤَاخِذۡنِي","بِمَا","نَسِيتُ","وَلَا","تُرۡهِقۡنِي","مِنۡ","أَمۡرِي","عُسۡرٗا"],"ḳала ла ту'ахизнии бима насииту вала турхиḳнии мин амрии `усра","Муса (Моисей) сказал: «Не наказывай меня за то, что я позабыл, и не возлагай на меня тяжелое бремя».",["Сказал он","не","взыщи с меня","за то, что","забыл я","и не","обременяй меня","в","моём деле","трудностью"]],[18,74,["فَٱنطَلَقَا","حَتَّىٰٓ","إِذَا","لَقِيَا","غُلَٰمٗا","فَقَتَلَهُۥ","قَالَ","أَقَتَلۡتَ","نَفۡسٗا","زَكِيَّةَۢ","بِغَيۡرِ","نَفۡسٖ","لَّقَدۡ","جِئۡتَ","شَيۡـٔٗا","نُّكۡرٗا"],"фанталаḳа хатта иза лаḳийа гуламан фаḳаталахуу ḳала аḳаталта нафсан закиййата бигайри нафсил лаḳад жи'та шай'ан нукра","Они продолжили путь, пока не встретили мальчика, и он убил его. Он сказал: «Неужели ты убил невинного человека, который никого не убивал?! Ты совершил предосудительный поступок!».",["И пошли они","пока","когда","встретили они","мальчика","и убил он его","сказал он","неужели убил ты","душу","чистую","не за","душу","действительно","совершил ты","дело","отвратительное"]]],"m":[[["فَلَمَّا","А когда",18,62],["جَاوَزَا","прошли они дальше",18,62]