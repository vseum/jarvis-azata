","всякий",18,79],["سَفِينَةٍ","корабль",18,79],["غَصۡبٗا","силой",18,79],[79],["وَأَمَّا","А что касается",18,80],["ٱلۡغُلَٰمُ","юноши",18,80]],[["فَكَانَ","то были",18,80],["أَبَوَاهُ","его родители",18,80],["مُؤۡمِنَيۡنِ","верующими",18,80],["فَخَشِينَآ","и побоялись мы",18,80],["أَن","что",18,80],["يُرۡهِقَهُمَا","обременит он их",18,80],["طُغۡيَٰنٗا","беззаконием",18,80],["وَكُفۡرٗا","и неверием",18,80]],[[80],["فَأَرَدۡنَآ","И захотели мы",18,81],["أَن","чтобы",18,81],["يُبۡدِلَهُمَا","дал взамен им",18,81],["رَبُّهُمَا","их Господь",18,81],["خَيۡرٗا","лучшего",18,81],["مِّنۡهُ","чем он",18,81],["زَكَوٰةٗ","чистотой",18,81],["وَأَقۡرَبَ","и более близкого",18,81],["رُحۡمٗا","милосердием",18,81]],[[81],["وَأَمَّا","а что касается",18,82],["ٱلۡجِدَارُ","стены",18,82],["فَكَانَ","то была",18,82],["لِغُلَٰمَيۡنِ","двум мальчикам",18,82],["يَتِيمَيۡنِ","сиротам",18,82],["فِي","в",18,82],["ٱلۡمَدِينَةِ","городе",18,82],["وَكَانَ","и был",18,82]],[["تَحۡتَهُۥ","под ней",18,82],["كَنزٞ","клад",18,82],["لَّهُمَا","для них",18,82],["وَكَانَ","и был",18,82],["أَبُوهُمَا","их отец",18,82],["صَٰلِحٗا","праведным",18,82],["فَأَرَادَ","и пожелал",18,82],["رَبُّكَ","Господь твой",18,82],["أَن","чтобы",18,82],["يَبۡلُغَآ","достигли они",18,82]],[["أَشُدَّهُمَا","своей зрелости",18,82],["وَيَسۡتَخۡرِجَا","и извлекли",18,82],["كَنزَهُمَا","свой клад",18,82],["رَحۡمَةٗ","по милости",18,82],["مِّن","от",18,82],["رَّبِّكَۚ","Господа твоего",18,82],["وَمَا","и не",18,82],["فَعَلۡتُهُۥ","сделал я это",18,82]],[["عَنۡ","по",18,82],["أَمۡرِيۚ","своему решению",18,82],["ذَٰلِكَ","это",18,82],["تَأۡوِيلُ","толкование",18,82],["مَا","того, что",18,82],["لَمۡ","не",18,82],["تَسۡطِع","смог ты",18,82],["عَّلَيۡهِ","на это",18,82],["صَبۡرٗا","терпения",18,82],[82],["وَيَسۡـَٔلُونَكَ","И спрашивают они тебя",18,83]],[["عَن","о",18,83],["ذِي","обладателе",18,83],["ٱلۡقَرۡنَيۡنِۖ","двух рогов",18,83],["قُلۡ","скажи",18,83],["سَأَتۡلُواْ","прочту я",18,83],["عَلَيۡكُم","вам",18,83],["مِّنۡهُ",