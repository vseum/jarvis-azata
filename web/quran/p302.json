{"p":302,"j":16,"a":[[18,75,["قَالَ","أَلَمۡ","أَقُل","لَّكَ","إِنَّكَ","لَن","تَسۡتَطِيعَ","مَعِيَ","صَبۡرٗا"],"ḳала алам аḳул лака иннака лан тастатии`а ма`ийа сабра","Он сказал: «Разве я не говорил тебе, что ты не сможешь сохранять терпение рядом со мной?».",["Сказал он","разве не","говорил я","тебе","что ты","никогда не","сможешь","со мной","терпеть"]],[18,76,["قَالَ","إِن","سَأَلۡتُكَ","عَن","شَيۡءِۭ","بَعۡدَهَا","فَلَا","تُصَٰحِبۡنِيۖ","قَدۡ","بَلَغۡتَ","مِن","لَّدُنِّي","عُذۡرٗا"],"ḳала ин са'алтука `ан шай'и ба`даха фала тусахибнии ḳад балагта мил ладуннии `узра","Муса (Моисей) сказал: «Если я спрошу тебя о чем-либо после этого, то не продолжай путь вместе со мной. Твой поступок по отношению ко мне уже оправдан».",["Сказал он","если","спрошу я тебя","о","чём-либо","после этого","то не","бери меня в спутники","уже","достиг ты","от","меня","оправдания"]],[18,77,["فَٱنطَلَقَا","حَتَّىٰٓ","إِذَآ","أَتَيَآ","أَهۡلَ","قَرۡيَةٍ","ٱسۡتَطۡعَمَآ","أَهۡلَهَا","فَأَبَوۡاْ","أَن","يُضَيِّفُوهُمَا","فَوَجَدَا","فِيهَا","جِدَارٗا","يُرِيدُ","أَن","يَنقَضَّ","فَأَقَامَهُۥۖ","قَالَ","لَوۡ","شِئۡتَ","لَتَّخَذۡتَ","عَلَيۡهِ","أَجۡرٗا"],"фанталаḳа хатта иза атайа ахла ḳарйатинистат`ама ахлаха фа'абау ан йудаййифуухума фаважада фииха жидаран йурииду ан йанḳадда фа'аḳамахуу ḳала лау ши'та латтахазта `алайхи ажра","Они продолжили путь, пока не пришли к жителям одного селения. Они попросили его жителей накормить их, но те отказались принять их гостями. Они увидели там стену, которая хотела обрушиться, и он выпрямил ее. Муса (Моисей) сказал: «При желании ты получил бы за это вознаграждение».",["И пошли они","пока","когда","пришли они","к жителям","селения","попросили они еды","у его жителей","но отказались они","чтобы","принять их гостями","и нашли они","в нём","стену","хотела она","чтобы","обрушиться","и выпрямил он её","сказал он","если бы","пожелал ты","непременно взял бы ты","за неё","плату"]],[18,78,["قَالَ","هَٰذَا","فِرَاقُ","بَيۡنِي","وَبَيۡنِكَۚ","سَأُنَبِّئُكَ","بِتَأۡوِيلِ","مَا","لَمۡ","تَسۡتَطِع","عَّلَيۡهِ","صَبۡرًا"],"ḳала хаза фираḳу байнии вабайника са'унаббиука бита'виили ма лам тастати` `алайхи сабра","Он сказал: «Здесь я с тобой расстанусь, но я поведаю тебе толкование того, к чему ты не смог отнестись с терпением.",["Сказал он","это","разлука","между мной","и между тобой","сообщу я тебе","толкование","того, что","не","смог ты","в отношении него","терпеть"]],[18,79,["أَمَّا","ٱلسَّفِينَةُ","فَكَانَتۡ","لِمَسَٰكِينَ","يَعۡمَلُونَ","فِي","ٱلۡبَحۡرِ","فَأَرَدتُّ","أَنۡ","أَعِيبَهَا","وَكَانَ","وَرَآءَهُم","مَّلِكٞ","يَأۡخُذُ","كُلَّ","سَفِينَةٍ","غَصۡبٗا"],"аммас сафиинату факанат лимасакиина йа`малууна фил бахри фа'арадтту ан а`иибаха вакана вараахум маликун йа'хузу кулла сафиинатин гасба","Что касается корабля, то он принадлежал беднякам, которые трудились в море. Я захотел повредить его, потому что перед ними находился царь, который силой отнимал все неповрежденные корабли.",["Что касается","корабля","то был он","у бедняков","трудящихся","в","море","и захотел я","чтобы","повредил я его","и был","перед ними","царь","забирающий","всякий","корабль","силой"]],[18,80,["وَأَمَّا","ٱلۡغُلَٰمُ","فَكَانَ","أَبَوَاهُ","مُؤۡمِنَيۡنِ","فَخَشِينَآ","أَن","يُرۡهِقَهُمَا","طُغۡيَٰنٗا","وَكُفۡرٗا"],"ва'аммал гуламу факана абаваху му'минайни фахашиина ан йурхиḳахума тугйанан вакуфра","Что касается мальчика, то его родители являются верующими, и мы опасались, что он будет притеснять их по причине своего беззакония и неверия.",["А что касается","юноши","то были","его родители","верующими","и побоялись мы","что","обременит он их","беззаконием","и неверием"]],[18,81,["فَأَرَدۡنَآ","أَن","يُبۡدِلَهُمَا","رَبُّهُمَا","خَيۡرٗا","مِّنۡهُ","زَكَوٰةٗ","وَأَقۡرَبَ","رُحۡمٗا"],"фа'арадна ан йубдилахума раббухума хайрам минху закаватан ва'аḳраба рухма","Мы захотели, чтобы Господь их даровал им вместо него того, кто будет чище и милосерднее к своим близким.",["И захотели мы","чтобы","дал взамен им","их Господь","лучшего","чем он","чистотой","и более близкого","милосердием"]],[18,82,["وَأَمَّا","ٱلۡجِدَارُ","فَكَانَ","لِغُلَٰمَيۡنِ","يَتِيمَيۡنِ","فِي","ٱلۡمَدِينَةِ","وَكَانَ","تَحۡتَهُۥ","كَنزٞ","لَّهُمَا","وَكَانَ","أَبُوهُمَا","صَٰلِحٗا","فَأَرَادَ","رَبُّكَ","أَن","يَبۡلُغَآ","أَشُدَّهُمَا","وَيَسۡتَخۡرِجَا","كَنزَهُمَا","رَحۡمَةٗ","مِّن","رَّبِّكَۚ","وَمَا","فَعَلۡتُهُۥ","عَنۡ","أَمۡرِيۚ","ذَٰلِكَ","تَأۡوِيلُ","مَا","لَمۡ","تَسۡطِع","عَّلَيۡهِ","صَبۡرٗا"],"ва'аммал жидару факана лигуламайни йатиимайни фил мадиинати вакана тахтахуу канзул лахума вакана абуухума салихан фа'арада раббука ан йаблуга ашуддахума вайастахрижа канзахума рахматам мир раббика вама фа`алтухуу `ан амрии залика та'виилу ма лам тасти` `алайхи сабра","Что же касается стены, то она принадлежит двум осиротевшим мальчикам из города. Под ней находится их клад. Их отец был праведником, и твой Господь пожелал, чтобы они достигли зрелого возраста и извлекли свой клад по милости твоего Господа. Я не поступал по своему усмотрению. Вот толкование того, к чему ты не смог отнестись с терпением».",["а что касается","стены","то была","двум мальчикам","сиротам","в","городе","и был","под ней","клад","для них","и был","их отец","праведным","и пожелал","Господь твой","чтобы","достигли они","своей зрелости","и извлекли","свой клад","по милости","от","Господа твоего","и не","сделал я это","по","своему решению","это","толкование","того, что","не","смог ты","на это","терпения"]],[18,83,["وَيَسۡـَٔلُونَكَ","عَن","ذِي","ٱلۡقَرۡنَيۡنِۖ","قُلۡ","سَأَتۡلُواْ","عَلَيۡكُم","مِّنۡهُ","ذِكۡرًا"],"вайас'алуунака `ан зил ḳарнайни ḳул са'атлуу `алайкум минху зикра","Они спрашивают тебя о Зуль Карнейне. Скажи: «Я прочту вам поучительный рассказ о нем».",["И спрашивают они тебя","о","обладателе","двух рогов","скажи","прочту я","вам","о нём","рассказ"]]],"m":[[["۞ قَالَ","Сказал он",18,75],["أَلَمۡ","разве не",18,75],["أَقُل","говорил я",18,75],["لَّكَ","тебе",18,75],["إِنَّكَ","что ты",18,75],["لَن","никогда не",18,75],["تَسۡتَطِيعَ","сможешь",18,75],["مَعِيَ","со мной",