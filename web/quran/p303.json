{"p":303,"j":16,"a":[[18,84,["إِنَّا","مَكَّنَّا","لَهُۥ","فِي","ٱلۡأَرۡضِ","وَءَاتَيۡنَٰهُ","مِن","كُلِّ","شَيۡءٖ","سَبَبٗا"],"инна макканна лахуу фил арди ва'атайнаху мин кулли шай'ин сабаба","Воистину, Мы наделили его властью на земле и одарили его всякими возможностями.",["Поистине, Мы","дали власть","ему","на","земле","и даровали Мы ему","из","всякой","вещи","средство"]],[18,85,["فَأَتۡبَعَ","سَبَبًا"],"фа'атба`а сабаба","Он отправился в путь.",["и он последовал","пути"]],[18,86,["حَتَّىٰٓ","إِذَا","بَلَغَ","مَغۡرِبَ","ٱلشَّمۡسِ","وَجَدَهَا","تَغۡرُبُ","فِي","عَيۡنٍ","حَمِئَةٖ","وَوَجَدَ","عِندَهَا","قَوۡمٗاۖ","قُلۡنَا","يَٰذَا","ٱلۡقَرۡنَيۡنِ","إِمَّآ","أَن","تُعَذِّبَ","وَإِمَّآ","أَن","تَتَّخِذَ","فِيهِمۡ","حُسۡنٗا"],"хатта иза балага магрибаш шамси важадаха тагрубу фии `айнин хамиатин ваважада `индаха ḳауман ḳулна йазал ḳарнайни имма ан ту`аззиба ва'имма ан таттахиза фиихим хусна","Когда он прибыл туда, где закатывается солнце, он обнаружил, что оно закатывается в мутный (или горячий) источник. Около него он нашел народ. Мы сказали: «О Зуль Карнейн! Либо ты накажешь их, либо сделаешь им добро».",["пока","когда","он достиг","места заката","солнца","нашёл его","заходящим","в","источник","мутный","и нашёл","около него","народ","Мы сказали","о обладатель","двух рогов","либо","что","ты накажешь","или же","что","ты проявишь","к ним","доброту"]],[18,87,["قَالَ","أَمَّا","مَن","ظَلَمَ","فَسَوۡفَ","نُعَذِّبُهُۥ","ثُمَّ","يُرَدُّ","إِلَىٰ","رَبِّهِۦ","فَيُعَذِّبُهُۥ","عَذَابٗا","نُّكۡرٗا"],"ḳала амма ман залама фасауфа ну`аззибухуу сумма йурадду ила раббихии файу`аззибухуу `азабан нукра","Он сказал: «Того, кто поступает несправедливо, мы накажем, а потом его возвратят к его Господу, и Он подвергнет его тяжким мучениям.",["он сказал","что до","того, кто","поступил несправедливо","то вскоре","мы накажем его","затем","он будет возвращён","к","Господу своему","и Он накажет его","наказанием","тяжким"]],[18,88,["وَأَمَّا","مَنۡ","ءَامَنَ","وَعَمِلَ","صَٰلِحٗا","فَلَهُۥ","جَزَآءً","ٱلۡحُسۡنَىٰۖ","وَسَنَقُولُ","لَهُۥ","مِنۡ","أَمۡرِنَا","يُسۡرٗا"],"ва'амма ман амана ва`амила салихан фалахуу жазаанил хусна васанаḳуулу лахуу мин амрина йусра","Тому же, кто уверовал и поступает праведно, будет наилучшее воздаяние, и мы скажем ему наши легкие повеления».",["а что до","того, кто","уверовал","и совершал","праведное","то ему","в воздаяние","наилучшее","и мы скажем","ему","из","повеления нашего","лёгкое"]],[18,89,["ثُمَّ","أَتۡبَعَ","سَبَبًا"],"сумма атба`а сабаба","Потом он отправился в путь дальше.",["затем","он последовал","пути"]],[18,90,["حَتَّىٰٓ","إِذَا","بَلَغَ","مَطۡلِعَ","ٱلشَّمۡسِ","وَجَدَهَا","تَطۡلُعُ","عَلَىٰ","قَوۡمٖ","لَّمۡ","نَجۡعَل","لَّهُم","مِّن","دُونِهَا","سِتۡرٗا"],"хатта иза балага матли`аш шамси важадаха татлу`у `ала ḳаумил лам наж`ал лахум мин дууниха ситра","Когда он прибыл туда, где восходит солнце, он обнаружил, что оно восходит над людьми, которым Мы не установили от него никакого прикрытия.",["пока","когда","он достиг","места восхода","солнца","нашёл его","восходящим","над","народом","не","Мы сделали","им","от","него","укрытия"]],[18,91,["كَذَٰلِكَۖ","وَقَدۡ","أَحَطۡنَا","بِمَا","لَدَيۡهِ","خُبۡرٗا"],"казалика ваḳад ахатна бима ладайхи хубра","Вот так! Мы объяли знанием все, что происходило с ним.",["так","и уже","Мы объяли","тем, что","у него","знанием"]],[18,92,["ثُمَّ","أَتۡبَعَ","سَبَبًا"],"сумма атба`а сабаба","Потом он отправился в путь дальше.",["затем","он последовал","пути"]],[18,93,["حَتَّىٰٓ","إِذَا","بَلَغَ","بَيۡنَ","ٱلسَّدَّيۡنِ","وَجَدَ","مِن","دُونِهِمَا","قَوۡمٗا","لَّا","يَكَادُونَ","يَفۡقَهُونَ","قَوۡلٗا"],"хатта иза балага байнас саддайни важада мин дуунихима ḳаумал ла йакадууна йафḳахууна ḳаула","Когда он достиг двух горных преград, он обнаружил перед ними людей, которые почти не понимали речи.",["пока","когда","он достиг","между","двумя преградами","он нашёл","по","эту сторону их","народ","не","почти","понимающий","речи"]],[18,94,["قَالُواْ","يَٰذَا","ٱلۡقَرۡنَيۡنِ","إِنَّ","يَأۡجُوجَ","وَمَأۡجُوجَ","مُفۡسِدُونَ","فِي","ٱلۡأَرۡضِ","فَهَلۡ","نَجۡعَلُ","لَكَ","خَرۡجًا","عَلَىٰٓ","أَن","تَجۡعَلَ","بَيۡنَنَا","وَبَيۡنَهُمۡ","سَدّٗا"],"ḳалуу йазал ḳарнайни инна йа'жуужа вама'жуужа муфсидууна фил арди фахал наж`алу лака харжан `ала ан таж`ала байнана вабайнахум садда","Они сказали: «О Зуль Карнейн! Йаджудж и Маджудж (Гог и Магог) распространяют на земле нечестие. Быть может, мы уплатим тебе дань, чтобы ты установил между нами и ними преграду?».",["они сказали","о обладатель","двух рогов","поистине","Йаджудж","и Маджудж","распространяют нечестие","на","земле","так ли","назначим мы","тебе","дань","на","то, что","ты сделаешь","между нами","и между ними","преграду"]],[18,95,["قَالَ","مَا","مَكَّنِّي","فِيهِ","رَبِّي","خَيۡرٞ","فَأَعِينُونِي","بِقُوَّةٍ","أَجۡعَلۡ","بَيۡنَكُمۡ","وَبَيۡنَهُمۡ","رَدۡمًا"],"ḳала ма макканнии фиихи раббии хайрун фа'а`иинуунии биḳувватин аж`ал байнакум вабайнахум радма","Он сказал: «То, чем наделил меня мой Господь, лучше этого. Помогите мне силой, и я установлю между вами и ними преграду.",["он сказал","то, чем","наделил меня","в этом","Господь мой","лучше","так помогите мне","силой","я сделаю","между вами","и между ними","заслон"]],[18,96,["ءَاتُونِي","زُبَرَ","ٱلۡحَدِيدِۖ","حَتَّىٰٓ","إِذَا","سَاوَىٰ","بَيۡنَ","ٱلصَّدَفَيۡنِ","قَالَ","ٱنفُخُواْۖ","حَتَّىٰٓ","إِذَا","جَعَلَهُۥ","نَارٗا","قَالَ","ءَاتُونِيٓ","أُفۡرِغۡ","عَلَيۡهِ","قِطۡرٗا"],"атуунии зубарал хадииди хатта иза сава байнас садафайни ḳаланфухуу хатта иза жа`алахуу наран ḳала атуунии уфриг `алайхи ḳитра","Подайте мне куски железа». Заполнив пространство между двумя склонами, он сказал: «Раздувайте!». Когда они стали красными, словно огонь, он сказал: «Принесите мне расплавленную медь, чтобы я вылил ее на него».",["подайте мне","куски","железа","пока","когда","он сравнял","между","двумя склонами","он сказал","раздувайте","пока","когда","он сделал его","огнём","он сказал","подайте мне","я вылью","на него","расплавленную медь"]],[18,97,["فَمَا","ٱسۡطَٰعُوٓاْ","أَن","يَظۡهَرُوهُ","وَمَا","ٱسۡتَطَٰعُواْ","لَهُۥ","نَقۡبٗا"],"фамаста`уу ан йазхарууху вамастата`уу лахуу наḳба","Они (племена Йаджудж и Маджудж) не смогли забраться на нее и не смогли пробить в ней дыру.",["и не","смогли они","чтобы","взобраться на неё","и не","смогли они","в ней","пробить брешь"]]],"m":[[["إِنَّا","Поистине, Мы",18,84],["مَكَّنَّا","дали власть",18,84],["لَهُۥ","ему",18,84],["فِي","на",18,84],["ٱلۡأَرۡضِ","земле",18,84],["وَءَاتَيۡنَٰهُ","и даровали Мы ему",18,84],["مِن","из",18,84],["كُلِّ","всякой",18,84],["شَيۡءٖ","вещи",18,84],["سَبَبٗا","средство",18,84],[84],["فَأَتۡبَعَ","и он последовал",18,85],["سَبَبًا","пути",18,85]],[[85],["حَتَّىٰٓ","пока",18,86],["إِذَا","когда",18,86],["بَلَغَ","он достиг",18,86],["مَغۡرِبَ","места заката",18,86],["ٱلشَّمۡسِ","солнца",18,86],["وَجَدَهَا","нашёл его",18,86],["تَغۡرُبُ","заходящим",18,86],["فِي","в",18,86],["عَيۡنٍ","источник",18,86],["حَمِئَةٖ","мутный",18,86]],[["وَوَجَدَ","и нашёл",18,86],["عِندَهَا","около него",18,86],["قَوۡمٗاۖ","народ",18,86],["قُلۡنَا","Мы сказали",18,86],["يَٰذَا","о обладатель",18,86],["ٱلۡقَرۡنَيۡنِ","двух рогов",18,86],["إِمَّآ","либо",18,86],["أَن","что",18,86],["تُعَذِّبَ","ты накажешь",18,86],["وَإِمَّآ","или же",18,86],["أَن","что",18,86],["تَتَّخِذَ","ты проявишь",18,86]],[["فِيهِمۡ","к ним",18,86],["حُسۡنٗا","доброту",18,86],[86],["قَالَ","он сказал",18,87],["أَمَّا","что до",18,87],["مَن","того, кто",18,87],["ظَلَمَ","поступил несправедливо",18,87],["فَسَوۡفَ","то вскоре",18,87],["نُعَذِّبُهُۥ","мы накажем его",18,87],["ثُمَّ","затем",18,87],["يُرَدُّ","он будет возвращён",18,87],["إِلَىٰ","к",18,87],["رَبِّهِۦ","Господу своему",18,87]],[["فَيُعَذِّبُهُۥ","и Он накажет его",18,87],["عَذَابٗا","наказанием",18,87],["نُّكۡرٗا","тяжким",18,87],[87],["وَأَمَّا","а что до",18,88],["مَنۡ","того, кто",18,88],["ءَامَنَ","уверовал",18,88],["وَعَمِلَ","и совершал",18,88],["صَٰلِحٗا","праведное",18,88],["فَلَهُۥ","то ему",18,88],["جَزَآءً","в воздаяние",18,88]],[["ٱلۡحُسۡنَىٰۖ","наилу