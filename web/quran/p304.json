{"p":304,"j":16,"a":[[18,98,["قَالَ","هَٰذَا","رَحۡمَةٞ","مِّن","رَّبِّيۖ","فَإِذَا","جَآءَ","وَعۡدُ","رَبِّي","جَعَلَهُۥ","دَكَّآءَۖ","وَكَانَ","وَعۡدُ","رَبِّي","حَقّٗا"],"ḳала хаза рахматум мир раббии фа'иза жаа ва`ду раббии жа`алахуу даккаа вакана ва`ду раббии хаḳḳа","Он сказал: «Это - милость от моего Господа! Когда же исполнится обещание моего Господа, Он сровняет ее с землей. Обещание моего Господа является истиной».",["он сказал","это","милость","от","Господа моего","и когда","придёт","обещание","Господа моего","Он сделает её","сровненной","и является","обещание","Господа моего","истиной"]],[18,99,["وَتَرَكۡنَا","بَعۡضَهُمۡ","يَوۡمَئِذٖ","يَمُوجُ","فِي","بَعۡضٖۖ","وَنُفِخَ","فِي","ٱلصُّورِ","فَجَمَعۡنَٰهُمۡ","جَمۡعٗا"],"ватаракна ба`дахум йаумаизин йамуужу фии ба`дин вануфиха фис суури фажама`нахум жам`а","В тот день Мы позволим им (племенам Йаджудж и Маджудж) хлынуть друг на друга. И затрубят в Рог, и Мы соберем их (творения) всех вместе.",["и Мы оставим","одних из них","в тот день","волнующимися","над","другими","и подуют","в","Рог","и Мы соберём их","собранием"]],[18,100,["وَعَرَضۡنَا","جَهَنَّمَ","يَوۡمَئِذٖ","لِّلۡكَٰفِرِينَ","عَرۡضًا"],"ва`арадна жаханнама йаумаизил лилкафириина `арда","В тот день Мы ясно покажем Геенну неверующим,",["и Мы покажем","Геенну","в тот день","неверующим","показом"]],[18,101,["ٱلَّذِينَ","كَانَتۡ","أَعۡيُنُهُمۡ","فِي","غِطَآءٍ","عَن","ذِكۡرِي","وَكَانُواْ","لَا","يَسۡتَطِيعُونَ","سَمۡعًا"],"аллазиина канат а`йунухум фии гитаин `ан зикрии вакануу ла йастатии`ууна сам`а","на глазах которых было покрывало, отделяющее их от поминания Меня, и которые не могли слышать.",["те, которые","были","глаза их","в","покрывале","от","поминания Меня","и были","не","способными","слышать"]],[18,102,["أَفَحَسِبَ","ٱلَّذِينَ","كَفَرُوٓاْ","أَن","يَتَّخِذُواْ","عِبَادِي","مِن","دُونِيٓ","أَوۡلِيَآءَۚ","إِنَّآ","أَعۡتَدۡنَا","جَهَنَّمَ","لِلۡكَٰفِرِينَ","نُزُلٗا"],"афахасибал лазиина кафаруу ан йаттахизуу `ибадии мин дуунии аулийаа инна а`тадна жаханнама лилкафириина нузула","Неужели неверующие полагали, что они сделают Моих рабов своими покровителями и помощниками вместо Меня? Воистину, Мы приготовили Геенну обителью для неверующих.",["неужели думали","те, которые","не уверовали","что","возьмут они","рабов Моих","помимо","Меня","покровителями","поистине, Мы","приготовили","Геенну","для неверующих","обителью"]],[18,103,["قُلۡ","هَلۡ","نُنَبِّئُكُم","بِٱلۡأَخۡسَرِينَ","أَعۡمَٰلًا"],"ḳул хал нунаббиукум бил'ахсариина а`мала","Скажи: «Не сообщить ли вам о тех, чьи деяния принесут наибольший убыток?",["скажи","не","сообщить ли вам","о самых потерпевших убыток","делами"]],[18,104,["ٱلَّذِينَ","ضَلَّ","سَعۡيُهُمۡ","فِي","ٱلۡحَيَوٰةِ","ٱلدُّنۡيَا","وَهُمۡ","يَحۡسَبُونَ","أَنَّهُمۡ","يُحۡسِنُونَ","صُنۡعًا"],"аллазиина далла са`йухум фил хайаватид дунйа вахум йахсабууна аннахум йухсинууна сун`а","О тех, чьи усилия заблудились в мирской жизни, хотя они думали, что поступают хорошо?",["те, которые","заблудилось","усердие их","в","жизни","ближней","а они","думают","что они","хорошо делают","дело"]],[18,105,["أُوْلَٰٓئِكَ","ٱلَّذِينَ","كَفَرُواْ","بِـَٔايَٰتِ","رَبِّهِمۡ","وَلِقَآئِهِۦ","فَحَبِطَتۡ","أَعۡمَٰلُهُمۡ","فَلَا","نُقِيمُ","لَهُمۡ","يَوۡمَ","ٱلۡقِيَٰمَةِ","وَزۡنٗا"],"улаикал лазиина кафаруу би'айати раббихим валиḳаихии фахабитат а`малухум фала нуḳииму лахум йаумал ḳийамати вазна","Это - те, кто не уверовал в знамения своего Господа и во встречу с Ним. Тщетны будут их деяния, и в День воскресения Мы не отпустим им никакого веса (не придадим им никакого значения; или не поместим на чашу их добрых деяний ни одного праведного поступка)».",["это","те, которые","не уверовали","в знамения","Господа своего","и во встречу с Ним","и тщетны стали","дела их","и не","установим Мы","им","в день","воскресения","веса"]],[18,106,["ذَٰلِكَ","جَزَآؤُهُمۡ","جَهَنَّمُ","بِمَا","كَفَرُواْ","وَٱتَّخَذُوٓاْ","ءَايَٰتِي","وَرُسُلِي","هُزُوًا"],"залика жазаухум жаханнаму бима кафаруу ваттахазуу айатии варусулии хузуа","Геенна будет им воздаянием за то, что они не уверовали и насмехались над Моими знамениями и Моими посланниками.",["это","воздаяние им","Геенна","за то, что","они не уверовали","и взяли","знамения Мои","и посланников Моих","в насмешку"]],[18,107,["إِنَّ","ٱلَّذِينَ","ءَامَنُواْ","وَعَمِلُواْ","ٱلصَّٰلِحَٰتِ","كَانَتۡ","لَهُمۡ","جَنَّٰتُ","ٱلۡفِرۡدَوۡسِ","نُزُلًا"],"иннал лазиина амануу ва`амилус салихати канат лахум жаннатул фирдауси нузула","Воистину, обителью тех, которые уверовали и совершали праведные деяния, будут сады Фирдауса.",["поистине","те, которые","уверовали","и совершали","праведные дела","были","для них","сады","Фирдауса","обителью"]],[18,108,["خَٰلِدِينَ","فِيهَا","لَا","يَبۡغُونَ","عَنۡهَا","حِوَلٗا"],"халидиина фииха ла йабгууна `анха хивала","Они пребудут в них вечно и не пожелают для себя перемен.",["вечно пребывая","в них","не","пожелают","от них","перемены"]],[18,109,["قُل","لَّوۡ","كَانَ","ٱلۡبَحۡرُ","مِدَادٗا","لِّكَلِمَٰتِ","رَبِّي","لَنَفِدَ","ٱلۡبَحۡرُ","قَبۡلَ","أَن","تَنفَدَ","كَلِمَٰتُ","رَبِّي","وَلَوۡ","جِئۡنَا","بِمِثۡلِهِۦ","مَدَدٗا"],"ḳул лау канал бахру мидадал ликалимати раббии ланафидал бахру ḳабла ан танфада калимату раббии валау жи'на бимислихии мадада","Скажи: «Если бы море стало чернилами для слов моего Господа, то море иссякло бы до того, как иссякли бы Слова моего Господа, даже если бы Мы принесли в помощь ему такое же море».",["скажи","если бы","было","море","чернилами","для слов","Господа моего","непременно иссякло бы","море","прежде","чем","иссякнут","слова","Господа моего","и даже если бы","Мы принесли","подобное ему","в подмогу"]],[18,110,["قُلۡ","إِنَّمَآ","أَنَا۠","بَشَرٞ","مِّثۡلُكُمۡ","يُوحَىٰٓ","إِلَيَّ","أَنَّمَآ","إِلَٰهُكُمۡ","إِلَٰهٞ","وَٰحِدٞۖ","فَمَن","كَانَ","يَرۡجُواْ","لِقَآءَ","رَبِّهِۦ","فَلۡيَعۡمَلۡ","عَمَلٗا","صَٰلِحٗا","وَلَا","يُشۡرِكۡ","بِعِبَادَةِ","رَبِّهِۦٓ","أَحَدَۢا"],"ḳул иннама ана башарум мислукум йууха илаййа аннама илахукум илахун вахидун фаман кана йаржуу лиḳаа раббихии фалйа`мал `амалан салихан вала йушрик би`ибадати раббихии ахада","Скажи: «Воистину, я - такой же человек, как и вы. Мне внушено откровение о том, что ваш Бог - Бог Единственный. Тот, кто надеется на встречу со своим Господом, пусть совершает праведные деяния и никому не поклоняется наряду со своим Господом».",["скажи","лишь","я","человек","подобный вам","внушается","мне","что лишь","Бог ваш","Бог","Единый","и кто","будет","надеяться на","встречу","с Господом своим","пусть совершает","деяние","праведное","и не","приобщает","в поклонении","Господу своему","никого"]]],"m":[[["قَالَ","он сказал",18,98],["هَٰذَا","это",18,98],["رَحۡمَةٞ","милость",18,98],["مِّن","от",18,98],["رَّبِّيۖ","Господа моего",18,98],["فَإِذَا","и когда",18,98],["جَآءَ","придёт",18,98],["وَعۡدُ","обещание",18,98],["رَبِّي","Господа моего",18,98],["جَعَلَهُۥ","Он сделает её",18,98],["دَكَّآءَۖ","сровненной",18,98],["وَكَانَ","и является",18,98],["وَعۡدُ","обещание",18,98],["رَبِّي","Господа моего",18,98]],[["حَقّٗا","истиной",18,98],[98],["۞ وَتَرَكۡنَا","и Мы оставим",18,99],["بَعۡضَهُمۡ","одних из них",18,99],["يَوۡمَئِذٖ","в тот день",18,99],["يَمُوجُ","волнующимися",18,99],["فِي","над",18,99],["بَعۡضٖۖ","другими",18,99],["وَنُفِخَ","и подуют",18,99],["فِي","в",18,99],["ٱلصُّورِ","Рог",18,99]],[["فَجَمَعۡنَٰهُمۡ","и Мы соберём их",18,99],["جَمۡعٗا","собранием",18,99],[99],["وَعَرَضۡنَا","и Мы покажем",18,100],["جَهَنَّمَ","Геенну",18,100],["يَوۡمَئِذٖ","в тот день",18,100],["لِّلۡكَٰفِرِينَ","неверующим",18,100],["عَرۡضًا","показом",18,100],[100]],[["ٱلَّذِينَ","те, которые",18,101],["كَانَتۡ","были",18,101],["أَعۡيُنُهُمۡ","глаза их",18,101],["فِي","в",18,101],["غِطَآءٍ","покрывале",18,101],["عَن","от",18,101],["ذِكۡرِي","поминания Меня",18,101],["وَكَانُواْ","и были",18,101],["لَا","не",18,101],["يَسۡتَطِيعُونَ","способными",18,101]],[["سَمۡعًا","слышать",18,101],[101],["أَفَحَسِبَ","неужели думали",18,102],["ٱلَّذِينَ","те, которые",18,102],["كَفَرُوٓاْ","не уверовали",18,102],["أَن","что",18,102],["يَتَّخِذُواْ