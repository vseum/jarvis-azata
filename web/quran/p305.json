{"p":305,"j":16,"a":[[19,1,["كٓهيعٓصٓ"],"кхй`с","Каф. Ха. Йа. Айн. Сад.",["Каф. Ха. Йа. Айн. Сад"]],[19,2,["ذِكۡرُ","رَحۡمَتِ","رَبِّكَ","عَبۡدَهُۥ","زَكَرِيَّآ"],"зикру рахмати раббика `абдахуу закариййа","Это является напоминанием о милости твоего Господа, оказанной Его рабу Закарии (Захарии).",["напоминание","о милости","Господа твоего","рабу Его","Закарии"]],[19,3,["إِذۡ","نَادَىٰ","رَبَّهُۥ","نِدَآءً","خَفِيّٗا"],"из нада раббахуу нидаан хафиййа","Вот он воззвал к своему Господу в тайне",["вот","воззвал он","к Господу своему","зовом","тайным"]],[19,4,["قَالَ","رَبِّ","إِنِّي","وَهَنَ","ٱلۡعَظۡمُ","مِنِّي","وَٱشۡتَعَلَ","ٱلرَّأۡسُ","شَيۡبٗا","وَلَمۡ","أَكُنۢ","بِدُعَآئِكَ","رَبِّ","شَقِيّٗا"],"ḳала рабби иннии ваханал `азму миннии вашта`алар ра'су шайбан валам акум биду`аика рабби шаḳиййа","и сказал: «Господи! Воистину, кости мои ослабели, а седина уже распространилась по моей голове. А ведь раньше благодаря молитвам к Тебе, Господи, я не был несчастен.",["он сказал","Господи","поистине, я","ослабли","кости","мои","и воспламенилась","голова","сединой","и не","был я","в мольбе к Тебе","Господи","несчастным"]],[19,5,["وَإِنِّي","خِفۡتُ","ٱلۡمَوَٰلِيَ","مِن","وَرَآءِي","وَكَانَتِ","ٱمۡرَأَتِي","عَاقِرٗا","فَهَبۡ","لِي","مِن","لَّدُنكَ","وَلِيّٗا"],"ва'иннии хифтул мавалийа мин вараии ваканатимраатии `аḳиран фахаб лии мил ладунка валиййа","Я опасаюсь того, что натворят мои родственники после меня, потому что жена моя бесплодна. Даруй же мне от Тебя наследника,",["и поистине, я","опасаюсь","родственников","после","меня","и была","жена моя","бесплодной","так даруй","мне","от","Себя","наследника"]],[19,6,["يَرِثُنِي","وَيَرِثُ","مِنۡ","ءَالِ","يَعۡقُوبَۖ","وَٱجۡعَلۡهُ","رَبِّ","رَضِيّٗا"],"йарисунии вайарису мин али йа`ḳууба важ`алху рабби радиййа","который наследует мне и семейству Йакуба (Иакова). И сделай его, Господи, угодником».",["который наследует мне","и наследует","от","рода","Йакуба","и сделай его","Господи","угодным"]],[19,7,["يَٰزَكَرِيَّآ","إِنَّا","نُبَشِّرُكَ","بِغُلَٰمٍ","ٱسۡمُهُۥ","يَحۡيَىٰ","لَمۡ","نَجۡعَل","لَّهُۥ","مِن","قَبۡلُ","سَمِيّٗا"],"йазакариййа инна нубашширука бигуламинисмухуу йахйа лам наж`ал лахуу мин ḳаблу самиййа","О Закария (Захария)! Воистину, Мы радуем тебя вестью о мальчике, имя которому Йахья (Иоанн). Мы не создавали прежде никого с таким именем (или никого подобного ему).",["о Закария","поистине, Мы","радуем тебя","мальчиком","имя его","Йахья","не","делали Мы","ему","прежде","прежде","тёзки"]],[19,8,["قَالَ","رَبِّ","أَنَّىٰ","يَكُونُ","لِي","غُلَٰمٞ","وَكَانَتِ","ٱمۡرَأَتِي","عَاقِرٗا","وَقَدۡ","بَلَغۡتُ","مِنَ","ٱلۡكِبَرِ","عِتِيّٗا"],"ḳала рабби анна йакууну лии гуламун ваканатимраатии `аḳиран ваḳад балагту минал кибари `итиййа","Он сказал: «Господи! Как может быть у меня мальчик, если моя жена бесплодна, а я уже достиг дряхлого возраста?».",["он сказал","Господи","как","будет","у меня","мальчик","а была","жена моя","бесплодной","и уже","достиг я","от","старости","дряхлости"]],[19,9,["قَالَ","كَذَٰلِكَ","قَالَ","رَبُّكَ","هُوَ","عَلَيَّ","هَيِّنٞ","وَقَدۡ","خَلَقۡتُكَ","مِن","قَبۡلُ","وَلَمۡ","تَكُ","شَيۡـٔٗا"],"ḳала казалика ḳала раббука хуа `алаййа хаййинун ваḳад халаḳтука мин ḳаблу валам таку шай'а","Он сказал: «Все так и будет! Господь твой сказал: «Это для Меня легко, ведь прежде Я сотворил тебя самого, хотя тебя вообще не было»».",["он сказал","так","сказал","Господь твой","это","для Меня","легко","и ведь","Я сотворил тебя","прежде","прежде","и не","был ты","ничем"]],[19,10,["قَالَ","رَبِّ","ٱجۡعَل","لِّيٓ","ءَايَةٗۖ","قَالَ","ءَايَتُكَ","أَلَّا","تُكَلِّمَ","ٱلنَّاسَ","ثَلَٰثَ","لَيَالٖ","سَوِيّٗا"],"ḳала раббиж`ал ллии айатан ḳала айатука алла тукаллиман наса саласа лайалин савиййа","Он сказал: «Господи! Назначь для меня знамение». Он сказал: «Знамением для тебя станет то, что ты не будешь говорить с людьми в течение трех ночей, будучи в полном здравии».",["он сказал","Господи","сделай","мне","знамение","Он сказал","знамение твоё","что не","будешь говорить ты","с людьми","три","ночи","будучи здоровым"]],[19,11,["فَخَرَجَ","عَلَىٰ","قَوۡمِهِۦ","مِنَ","ٱلۡمِحۡرَابِ","فَأَوۡحَىٰٓ","إِلَيۡهِمۡ","أَن","سَبِّحُواْ","بُكۡرَةٗ","وَعَشِيّٗا"],"фахаража `ала ḳаумихии минал михраби фа'ауха илайхим ан саббихуу букратан ва`ашиййа","Он вышел из молельни к своему народу и дал им понять: «Воздавайте хвалу по утрам и перед закатом!».",["и вышел он","к","своему народу","из","молельни","и дал знать","им","чтобы","славьте","утром","и вечером"]]],"m":[["h",19],["b"],[["كٓهيعٓصٓ","Каф. Ха. Йа. Айн. Сад",19,1],[1],["ذِكۡرُ","напоминание",19,2],["رَحۡمَتِ","о милости",19,2],["رَبِّكَ","Господа твоего",19,2],["عَبۡدَهُۥ","рабу Его",19,2],["زَكَرِيَّآ","Закарии",19,2],[2]],[["إِذۡ","вот",19,3],["نَادَىٰ","воззвал он",19,3],["رَبَّهُۥ","к Господу своему",19,3],["نِدَآءً","зовом",19,3],["خَفِيّٗا","тайным",19,3],[3],["قَالَ","он сказал",19,4],["رَبِّ","Господи",19,4],["إِنِّي","поистине, я",19,4],["وَهَنَ","ослабли",19,4],["ٱلۡعَظۡمُ","кости",19,4]],[["مِنِّي","мои",19,4],["وَٱشۡتَعَلَ","и воспламенилась",19,4],["ٱلرَّأۡسُ","голова",19,4],["شَيۡبٗا","сединой",19,4],["وَلَمۡ","и не",19,4],["أَكُنۢ","был я",19,4],["بِدُعَآئِكَ","в мольбе к Тебе",19,4],["رَبِّ","Господи",19,4]],[["شَقِيّٗا","несчастным",19,4],[4],["وَإِنِّي","и поистине, я",19,5],["خِفۡتُ","опасаюсь",19,5],["ٱلۡمَوَٰلِيَ","родственников",19,5],["مِن","после",19,5],["وَرَآءِي","меня",19,5],["وَكَانَتِ","и была",19,5]],[["ٱمۡرَأَتِي","жена моя",19,5],["عَاقِرٗا","бесплодной",19,5],["فَهَبۡ","так даруй",19,5],["لِي","мне",19,5],["مِن","от",19,5],["لَّدُنكَ","Себя",19,5],["وَلِيّٗا","наследника",19,5],[5],["يَرِثُنِي","который наследует мне",19,6],["وَيَرِثُ","и наследует",19,6]],[["مِنۡ","от",19,6],["ءَالِ","рода",19,6],["يَعۡقُوبَۖ","Йакуба",19,6],["وَٱجۡعَلۡهُ","и сделай его",19,6],["رَبِّ","Господи",19,6],["رَضِيّٗا","угодным",19,6],[6],["يَٰزَكَرِيَّآ","о Закария",19,7]],[["إِنَّا","поистине, Мы",19,7],["نُبَشِّرُكَ","радуем тебя",19,7],["بِغُلَٰمٍ","мальчиком",19,7],["ٱسۡمُهُۥ","имя его",19,7],["يَحۡيَىٰ","Йахья",19,7],["لَمۡ","не",19,7],["نَجۡعَل","делали Мы",19,7],["لَّهُۥ","ему",19,7],["مِن","прежде",19,7],["قَبۡلُ","прежде",19,7],["سَمِيّٗا","тёзки",19,7]],[[7],["قَالَ","он сказал",19,8],["رَبِّ","Господи",19,8],["أَنَّىٰ","как",19,8],["يَكُونُ","будет",19,8],["لِي","у меня",19,8],["غُلَٰمٞ","мальчик",19,8],["وَكَانَتِ","а была",19,8],["ٱمۡرَأَتِي","жена моя",19,8]],[["عَاقِرٗا","бесплодной",19,8],["وَقَدۡ","и уже",19,8],["بَلَغۡتُ","достиг я",19,8],["مِنَ","от",19,8],["ٱلۡكِبَرِ","старости",19,8],["عِتِيّٗا","дряхлости",19,8],[8],["قَالَ","он сказал",19,9],["كَذَٰلِكَ","так",19,9]],[["قَالَ","сказал",19,9],["رَبُّكَ","Господь твой",19,9],["هُوَ","это",19,9],["عَلَيَّ","для Меня",19,9],["هَيِّنٞ","легко",19,9],["وَقَدۡ","и ведь",19,9],["خَلَقۡتُكَ","Я сотворил тебя",19,9],["مِن","прежде",19,9],["قَبۡلُ","прежде",19,9],["وَلَمۡ","и не",19,9],["تَكُ","был ты",19,9]],[["شَيۡـٔٗا","ничем",19,9],[9],["قَالَ","он сказал",19,10],["رَبِّ","Господи",19,10],["ٱجۡعَل","сделай",19,10],["لِّيٓ","мне",19,10],["ءَايَةٗۖ","знамение",19,10],["قَالَ","Он сказал",19,10],["ءَايَتُكَ","знамение твоё",19,10],["أَلَّا","что не",19,10]],[["تُكَلِّمَ","будешь говорить ты",19,10],["ٱلنَّاسَ","с людьми",19,10],["ثَلَٰثَ","три",19,10],["لَيَالٖ","ночи",19,10],["سَوِيّٗا","будучи здоровым",19,10],[10],["فَخَرَجَ","и вышел он",19,11],["عَلَىٰ","к",19,11],["قَوۡمِهِۦ","своему народу",19,11]],[["مِنَ","из",19,11],["ٱلۡمِحۡرَابِ","молельни",19,11],["فَأَوۡحَىٰٓ","и дал знать",19,11],["إِلَيۡهِمۡ","им",19,11],["أَن","чтобы",19,11],["سَبِّحُواْ","славьте",19,11],["بُكۡرَةٗ","утром",19,11],["وَعَشِيّٗا","и вечером",19,11],[11]]]}