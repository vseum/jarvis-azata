{"p":306,"j":16,"a":[[19,12,["يَٰيَحۡيَىٰ","خُذِ","ٱلۡكِتَٰبَ","بِقُوَّةٖۖ","وَءَاتَيۡنَٰهُ","ٱلۡحُكۡمَ","صَبِيّٗا"],"йайахйа хузил китаба биḳувватин ва'атайнахул хукма сабиййа","О Йахья (Иоанн)! Крепко держи Писание. Мы одарили его мудростью, пока он был еще ребенком,",["о Йахья","возьми","Писание","с силой","и Мы даровали ему","мудрость","ребёнком"]],[19,13,["وَحَنَانٗا","مِّن","لَّدُنَّا","وَزَكَوٰةٗۖ","وَكَانَ","تَقِيّٗا"],"вахананам мил ладунна вазакаватан вакана таḳиййа","а также состраданием от Нас и чистотой. Он был богобоязнен,",["и сострадание","от","Нас","и чистоту","и был он","богобоязненным"]],[19,14,["وَبَرَّۢا","بِوَٰلِدَيۡهِ","وَلَمۡ","يَكُن","جَبَّارًا","عَصِيّٗا"],"вабарра бивалидайхи валам йакун жаббаран `асиййа","почтителен к родителям и не был гордецом и ослушником.",["и почтительным","к родителям своим","и не","был он","гордецом","ослушником"]],[19,15,["وَسَلَٰمٌ","عَلَيۡهِ","يَوۡمَ","وُلِدَ","وَيَوۡمَ","يَمُوتُ","وَيَوۡمَ","يُبۡعَثُ","حَيّٗا"],"васаламун `алайхи йаума вулида вайаума йамууту вайаума йуб`асу хаййа","Мир ему в тот день, когда он родился, в тот день, когда он скончался, и в тот день, когда он будет воскрешен к жизни!",["и мир","ему","в день","он родился","и в день","он умрёт","и в день","он будет воскрешён","живым"]],[19,16,["وَٱذۡكُرۡ","فِي","ٱلۡكِتَٰبِ","مَرۡيَمَ","إِذِ","ٱنتَبَذَتۡ","مِنۡ","أَهۡلِهَا","مَكَانٗا","شَرۡقِيّٗا"],"вазкур фил китаби марйама изинтабазат мин ахлиха маканан шарḳиййа","Помяни в Писании Марьям (Марию). Вот она ушла от своей семьи на восток",["и помяни","в","Писании","Марьям","когда","удалилась она","от","семьи своей","в место","восточное"]],[19,17,["فَٱتَّخَذَتۡ","مِن","دُونِهِمۡ","حِجَابٗا","فَأَرۡسَلۡنَآ","إِلَيۡهَا","رُوحَنَا","فَتَمَثَّلَ","لَهَا","بَشَرٗا","سَوِيّٗا"],"фаттахазат мин дуунихим хижабан фа'арсална илайха руухана фатамассала лаха башаран савиййа","и укрылась от них за завесой. Мы же послали к ней Нашего Духа (Джибрила), и он предстал перед ней в облике прекрасно сложенного человека.",["и сделала она","от","них","завесу","и Мы послали","к ней","Духа Нашего","и он принял облик","для неё","человека","совершенного"]],[19,18,["قَالَتۡ","إِنِّيٓ","أَعُوذُ","بِٱلرَّحۡمَٰنِ","مِنكَ","إِن","كُنتَ","تَقِيّٗا"],"ḳалат иннии а`уузу биррахмани минка ин кунта таḳиййа","Она сказала: «Я прибегаю к Милостивому, чтобы Он защитил меня от тебя, если только ты богобоязнен».",["она сказала","поистине, я","прибегаю к защите","Милостивого","от тебя","если","ты","богобоязнен"]],[19,19,["قَالَ","إِنَّمَآ","أَنَا۠","رَسُولُ","رَبِّكِ","لِأَهَبَ","لَكِ","غُلَٰمٗا","زَكِيّٗا"],"ḳала иннама ана расуулу раббики ли'ахаба лаки гуламан закиййа","Он сказал: «Воистину, я послан твоим Господом, чтобы даровать тебе чистого мальчика».",["он сказал","лишь","я","посланник","Господа твоего","чтобы я даровал","тебе","мальчика","чистого"]],[19,20,["قَالَتۡ","أَنَّىٰ","يَكُونُ","لِي","غُلَٰمٞ","وَلَمۡ","يَمۡسَسۡنِي","بَشَرٞ","وَلَمۡ","أَكُ","بَغِيّٗا"],"ḳалат анна йакууну лии гуламун валам йамсаснии башарун валам аку багиййа","Она сказала: «Как у меня может быть мальчик, если меня не касался мужчина, и я не была блудницей?».",["она сказала","как","будет","у меня","мальчик","и не","касался меня","человек","и не","была я","блудницей"]],[19,21,["قَالَ","كَذَٰلِكِ","قَالَ","رَبُّكِ","هُوَ","عَلَيَّ","هَيِّنٞۖ","وَلِنَجۡعَلَهُۥٓ","ءَايَةٗ","لِّلنَّاسِ","وَرَحۡمَةٗ","مِّنَّاۚ","وَكَانَ","أَمۡرٗا","مَّقۡضِيّٗا"],"ḳала казалики ḳала раббуки хуа `алаййа хаййинун валинаж`алахуу айатал линнаси варахматам минна вакана амрам маḳдиййа","Он сказал: «Вот так! Господь твой сказал: «Это для Меня легко. Мы сделаем его знамением для людей и милостью от Нас. Это дело уже предрешено!»»",["он сказал","так","сказал","Господь твой","это","для Меня","легко","и чтобы Мы сделали его","знамением","для людей","и милостью","от Нас","и было","делом","решённым"]],[19,22,["فَحَمَلَتۡهُ","فَٱنتَبَذَتۡ","بِهِۦ","مَكَانٗا","قَصِيّٗا"],"фахамалатху фантабазат бихии маканан ḳасиййа","Она понесла его (забеременела) и отправилась с ним в отдаленное место.",["и она понесла его","и удалилась","с ним","в место","отдалённое"]],[19,23,["فَأَجَآءَهَا","ٱلۡمَخَاضُ","إِلَىٰ","جِذۡعِ","ٱلنَّخۡلَةِ","قَالَتۡ","يَٰلَيۡتَنِي","مِتُّ","قَبۡلَ","هَٰذَا","وَكُنتُ","نَسۡيٗا","مَّنسِيّٗا"],"фа'ажаахал махаду ила жиз`ин нахлати ḳалат йалайтании митту ḳабла хаза вакунту насйам мансиййа","Родовые схватки привели ее к стволу финиковой пальмы, и она сказала: «Лучше бы я умерла до этого и была навсегда забытой!».",["и привели её","родовые схватки","к","стволу","пальмы","она сказала","о, если бы я","умерла","прежде","этого","и была","забытой","позабытой"]],[19,24,["فَنَادَىٰهَا","مِن","تَحۡتِهَآ","أَلَّا","تَحۡزَنِي","قَدۡ","جَعَلَ","رَبُّكِ","تَحۡتَكِ","سَرِيّٗا"],"фанадаха мин тахтиха алла тахзании ḳад жа`ала раббуки тахтаки сариййа","Тогда он (Иса или Джибрил) воззвал к ней из-под нее: «Не печалься! Господь твой создал под тобой ручей.",["и воззвал он к ней","из","под нею","что не","печалься","уже","сделал","Господь твой","под тобой","ручей"]],[19,25,["وَهُزِّيٓ","إِلَيۡكِ","بِجِذۡعِ","ٱلنَّخۡلَةِ","تُسَٰقِطۡ","عَلَيۡكِ","رُطَبٗا","جَنِيّٗا"],"вахуззии илайки бижиз`ин нахлати тусаḳит `алайки рутабан жаниййа","Потряси на себя ствол пальмы, и на тебя попадают свежие финики.",["и потряси","к себе","ствол","пальмы","она уронит","на тебя","финики свежие","спелые"]]],"m":[[["يَٰيَحۡيَىٰ","о Йахья",19,12],["خُذِ","возьми",19,12],["ٱلۡكِتَٰبَ","Писание",19,12],["بِقُوَّةٖۖ","с силой",19,12],["وَءَاتَيۡنَٰهُ","и Мы даровали ему",19,12],["ٱلۡحُكۡمَ","мудрость",19,12],["صَبِيّٗا","ребёнком",19,12],[12]],[["وَحَنَانٗا","и сострадание",19,13],["مِّن","от",19,13],["لَّدُنَّا","Нас",19,13],["وَزَكَوٰةٗۖ","и чистоту",19,13],["وَكَانَ","и был он",19,13],["تَقِيّٗا","богобоязненным",19,13],[13],["وَبَرَّۢا","и почтительным",19,14],["بِوَٰلِدَيۡهِ","к родителям своим",19,14],["وَلَمۡ","и не",19,14]],[["يَكُن","был он",19,14],["جَبَّارًا","гордецом",19,14],["عَصِيّٗا","ослушником",19,14],[14],["وَسَلَٰمٌ","и мир",19,15],["عَلَيۡهِ","ему",19,15],["يَوۡمَ","в день",19,15],["وُلِدَ","он родился",19,15],["وَيَوۡمَ","и в день",19,15],["يَمُوتُ","он умрёт",19,15]],[["وَيَوۡمَ","и в день",19,15],["يُبۡعَثُ","он будет воскрешён",19,15],["حَيّٗا","живым",19,15],[15],["وَٱذۡكُرۡ","и помяни",19,16],["فِي","в",19,16],["ٱلۡكِتَٰبِ","Писании",19,16],["مَرۡيَمَ","Марьям",19,16],["إِذِ","когда",19,16],["ٱنتَبَذَتۡ","удалилась она",19,16]],[["مِنۡ","от",19,16],["أَهۡلِهَا","семьи своей",19,16],["مَكَانٗا","в место",19,16],["شَرۡقِيّٗا","восточное",19,16],[16],["فَٱتَّخَذَتۡ","и сделала она",19,17],["مِن","от",19,17],["دُونِهِمۡ","них",19,17],["حِجَابٗا","завесу",19,17]],[["فَأَرۡسَلۡنَآ","и Мы послали",19,17],["إِلَيۡهَا","к ней",19,17],["رُوحَنَا","Духа Нашего",19,17],["فَتَمَثَّلَ","и он принял облик",19,17],["لَهَا","для неё",19,17],["بَشَرٗا","человека",19,17],["سَوِيّٗا","совершенного",19,17],[17],["قَالَتۡ","она сказала",19,18],["إِنِّيٓ","поистине, я",19,18]],[["أَعُوذُ","прибегаю к защите",19,18],["بِٱلرَّحۡمَٰنِ","Милостивого",19,18],["مِنكَ","от тебя",19,18],["إِن","если",19,18],["كُنتَ","ты",19,18],["تَقِيّٗا","богобоязнен",19,18],[18],["قَالَ","он сказал",19,19],["إِنَّمَآ","лишь",19,19],["أَنَا۠","я",19,19],["رَسُولُ","посланник",19,19]],[["رَبِّكِ","Господа твоего",19,19],["لِأَهَبَ","чтобы я даровал",19,19],["لَكِ","тебе",19,19],["غُلَٰمٗا","мальчика",19,19],["زَكِيّٗا","чистого",19,19],[19],["قَالَتۡ","она сказала",19,20],["أَنَّىٰ","как",19,20],["يَكُونُ","будет",19,20],["لِي","у меня",19,20]],[["غُلَٰمٞ","мальчик",19,20],["وَلَمۡ","и не",19,20],["يَمۡسَسۡنِي","касался меня",19,20],["بَشَرٞ","человек",19,20],["وَلَمۡ","и не",19,20],["أَكُ","была я",19,20],["بَغِيّٗا","блудницей",19,20],[20],["قَالَ","он сказал",19,21],["كَذَٰلِكِ","так",19,21]],[["قَالَ","сказал",19,21],["رَبُّكِ","Господь твой",19,21],["هُوَ","это",19,21],["عَلَيَّ","для Меня",19,21],["هَيِّنٞۖ","легко",19,21],["وَلِنَجۡعَلَهُۥٓ","и чтобы Мы сделали его",19,21],["ءَايَةٗ","знамением",19,21],["لِّلنَّاسِ","для людей",19,21],["وَرَحۡمَةٗ","и милостью",19,21]],[["مِّنَّاۚ","от Нас",19,21],["وَكَانَ","и было",19,21],["أَمۡرٗا","делом",19,21],["مَّقۡضِيّٗا","решённым",19,21],[21],["۞ فَحَمَلَتۡهُ","и она понесла его",19,22],["فَٱنتَبَذَتۡ","и удалилась",19,22]],[["بِهِۦ","с ним",19,22],["مَكَانٗا","в место",19,22],["قَصِيّٗا","отдалённое",19,22],[22],["فَأَجَآءَهَا","и привели её",19,23],["ٱلۡمَخَاضُ","родовые схватки",19,23],["إِلَىٰ","к",19,23],["جِذۡعِ","стволу",19,23],["ٱلنَّخۡلَةِ","пальмы",19,23]],[["قَالَتۡ","она сказала",19,23],["يَٰلَيۡتَنِي","о, если бы я",19,23],["مِتُّ","умерла",19,23],["قَبۡلَ","прежде",19,23],["هَٰذَا","этого",19,23],["وَكُنتُ","и была",19,23],["نَسۡيٗا","забытой",19,23],["مَّنسِيّٗا","позабытой",19,23],[23]],[["فَنَادَىٰهَا","и воззвал он к ней",19,24],["مِن","из",19,24],["تَحۡتِهَآ","под нею",19,24],["أَلَّا","что не",19,24],["تَحۡزَنِي","печалься",19,24],["قَدۡ","уже",19,24],["جَعَلَ","сделал",19,24],["رَبُّكِ","Господь твой",19,24],["تَحۡتَكِ","под тобой",19,24],["سَرِيّٗا","ручей",19,24],[24]],[["وَهُزِّيٓ","и потряси",19,25],["إِلَيۡكِ","к себе",19,25],["بِجِذۡعِ","ствол",19,25],["ٱلنَّخۡلَةِ","пальмы",19,25],["تُسَٰقِطۡ","она уронит",19,25],["عَلَيۡكِ","на тебя",19,25],["رُطَبٗا","финики свежие",19,25],["جَنِيّٗا","спелые",19,25],[25]]]}