{"p":307,"j":16,"a":[[19,26,["فَكُلِي","وَٱشۡرَبِي","وَقَرِّي","عَيۡنٗاۖ","فَإِمَّا","تَرَيِنَّ","مِنَ","ٱلۡبَشَرِ","أَحَدٗا","فَقُولِيٓ","إِنِّي","نَذَرۡتُ","لِلرَّحۡمَٰنِ","صَوۡمٗا","فَلَنۡ","أُكَلِّمَ","ٱلۡيَوۡمَ","إِنسِيّٗا"],"факулии вашрабии ваḳаррии `айнан фа'имма тарайинна минал башари ахадан фаḳуулии иннии назарту лиррахмани сауман фалан укаллимал йаума инсиййа","Ешь, пей и радуйся! Если же увидишь кого-либо из людей, то скажи: «Я дала Милостивому обет хранить молчание и не стану сегодня разговаривать с людьми»».",["так ешь","и пей","и прохлади","глаза","и если","увидишь ты","из","людей","кого-либо","то скажи","поистине, я","дала обет","Милостивому","поста","и не","буду говорить я","сегодня","с человеком"]],[19,27,["فَأَتَتۡ","بِهِۦ","قَوۡمَهَا","تَحۡمِلُهُۥۖ","قَالُواْ","يَٰمَرۡيَمُ","لَقَدۡ","جِئۡتِ","شَيۡـٔٗا","فَرِيّٗا"],"фа'атат бихии ḳаумаха тахмилухуу ḳалуу йамарйаму лаḳад жи'ти шай'ан фариййа","Она пришла к своим родным, неся его. Они сказали: «О Марьям (Мария)! Ты совершила тяжкий (или небывалый, или удивительный) проступок.",["и пришла она","с ним","к народу своему","неся его","они сказали","о Марьям","ты уже","совершила","дело","неслыханное"]],[19,28,["يَٰٓأُخۡتَ","هَٰرُونَ","مَا","كَانَ","أَبُوكِ","ٱمۡرَأَ","سَوۡءٖ","وَمَا","كَانَتۡ","أُمُّكِ","بَغِيّٗا"],"йа'ухта харууна ма кана абуукимраа сауин вама канат уммуки багиййа","О сестра Харуна (Аарона)! Твой отец не был скверным человеком, и мать твоя не была блудницей».",["о сестра","Харуна","не","был","отец твой","человеком","дурным","и не","была","мать твоя","блудницей"]],[19,29,["فَأَشَارَتۡ","إِلَيۡهِۖ","قَالُواْ","كَيۡفَ","نُكَلِّمُ","مَن","كَانَ","فِي","ٱلۡمَهۡدِ","صَبِيّٗا"],"фа'ашарат илайхи ḳалуу кайфа нукаллиму ман кана фил махди сабиййа","Она показала на него, и они сказали: «Как мы можем говорить с младенцем в колыбели?».",["и указала она","на него","они сказали","как","будем говорить мы","с тем, кто","есть","в","колыбели","младенец"]],[19,30,["قَالَ","إِنِّي","عَبۡدُ","ٱللَّهِ","ءَاتَىٰنِيَ","ٱلۡكِتَٰبَ","وَجَعَلَنِي","نَبِيّٗا"],"ḳала иннии `абдуллахи атанийал китаба важа`алании набиййа","Он сказал: «Воистину, я - раб Аллаха. Он даровал мне Писание и сделал меня пророком.",["он сказал","поистине, я","раб","Аллаха","Он даровал мне","Писание","и сделал меня","пророком"]],[19,31,["وَجَعَلَنِي","مُبَارَكًا","أَيۡنَ","مَا","كُنتُ","وَأَوۡصَٰنِي","بِٱلصَّلَوٰةِ","وَٱلزَّكَوٰةِ","مَا","دُمۡتُ","حَيّٗا"],"важа`алании мубаракан айна ма кунту ва'аусании биссалавати ваззакавати ма думту хаййа","Он сделал меня благословенным, где бы я ни был, и заповедал мне совершать намаз и раздавать закят, пока я буду жив.",["и Он сделал меня","благословенным","где","бы ни","был я","и заповедал мне","молитву","и закят","пока","пребываю я","живым"]],[19,32,["وَبَرَّۢا","بِوَٰلِدَتِي","وَلَمۡ","يَجۡعَلۡنِي","جَبَّارٗا","شَقِيّٗا"],"вабарра бивалидатии валам йаж`алнии жаббаран шаḳиййа","Он сделал меня почтительным к моей матери и не сделал меня надменным и несчастным.",["и почтительным","к матери моей","и не","сделал Он меня","надменным","несчастным"]],[19,33,["وَٱلسَّلَٰمُ","عَلَيَّ","يَوۡمَ","وُلِدتُّ","وَيَوۡمَ","أَمُوتُ","وَيَوۡمَ","أُبۡعَثُ","حَيّٗا"],"вассаламу `алаййа йаума вулидтту вайаума амууту вайаума уб`асу хаййа","Мир мне в тот день, когда я родился, в тот день, когда я скончаюсь, и в тот день, когда я буду воскрешен к жизни».",["и мир","мне","в день","я родился","и в день","я умру","и в день","я буду воскрешён","живым"]],[19,34,["ذَٰلِكَ","عِيسَى","ٱبۡنُ","مَرۡيَمَۖ","قَوۡلَ","ٱلۡحَقِّ","ٱلَّذِي","فِيهِ","يَمۡتَرُونَ"],"залика `иисабну марйама ḳаулал хаḳḳил лазии фиихи йамтаруун","Таков Иса (Иисус), сын Марьям (Марьям)! Слово Истины, относительно которого они препираются.",["это","Иса","сын","Марьям","слово","истины","то, которое","о нём","они препираются"]],[19,35,["مَا","كَانَ","لِلَّهِ","أَن","يَتَّخِذَ","مِن","وَلَدٖۖ","سُبۡحَٰنَهُۥٓۚ","إِذَا","قَضَىٰٓ","أَمۡرٗا","فَإِنَّمَا","يَقُولُ","لَهُۥ","كُن","فَيَكُونُ"],"ма кана лиллахи ан йаттахиза мин валадин субханахуу иза ḳада амран фа'иннама йаḳуулу лахуу кун файакуун","Не подобает Аллаху иметь сына. Пречист Он! Когда Он принимает решение, то стоит Ему сказать: «Будь!». - как это сбывается.",["не","подобает","Аллаху","чтобы","Он взял","из","сына","пречист Он","когда","Он решает","дело","то лишь","Он говорит","ему","будь","и оно сбывается"]],[19,36,["وَإِنَّ","ٱللَّهَ","رَبِّي","وَرَبُّكُمۡ","فَٱعۡبُدُوهُۚ","هَٰذَا","صِرَٰطٞ","مُّسۡتَقِيمٞ"],"ва'инналлаха раббии вараббукум фа`будууху хаза сиратум мустаḳиим","Иса (Иисус) сказал: «Воистину, Аллах - мой Господь и ваш Господь. Поклоняйтесь же Ему. Это и есть прямой путь».",["и поистине","Аллах","Господь мой","и Господь ваш","так поклоняйтесь Ему","это","путь","прямой"]],[19,37,["فَٱخۡتَلَفَ","ٱلۡأَحۡزَابُ","مِنۢ","بَيۡنِهِمۡۖ","فَوَيۡلٞ","لِّلَّذِينَ","كَفَرُواْ","مِن","مَّشۡهَدِ","يَوۡمٍ","عَظِيمٍ"],"фахталафал ахзабу мим байнихим фавайлул лиллазиина кафаруу мим машхади йаумин `азиим","Но секты разошлись во мнениях между собой. Горе же неверующим, которые встретят Великий день!",["и разошлись","группировки","между","собой","и горе","тем, которые","не уверовали","от","зрелища","дня","великого"]],[19,38,["أَسۡمِعۡ","بِهِمۡ","وَأَبۡصِرۡ","يَوۡمَ","يَأۡتُونَنَا","لَٰكِنِ","ٱلظَّٰلِمُونَ","ٱلۡيَوۡمَ","فِي","ضَلَٰلٖ","مُّبِينٖ"],"асми` бихим ва'абсир йаума йа'туунана лакиниз залимуунал йаума фии далалим мубиин","Как же ясно они будут слышать и видеть в тот день, когда они явятся к Нам! Но сегодня беззаконники пребывают в очевидном заблуждении.",["как хорошо слышат","они","и как хорошо видят","в день","придут они к Нам","но","беззаконники","сегодня","в","заблуждении","явном"]]],"m":[[["فَكُلِي","так ешь",19,26],["وَٱشۡرَبِي","и пей",19,26],["وَقَرِّي","и прохлади",19,26],["عَيۡنٗاۖ","глаза",19,26],["فَإِمَّا","и если",19,26],["تَرَيِنَّ","увидишь ты",19,26],["مِنَ","из",19,26],["ٱلۡبَشَرِ","людей",19,26],["أَحَدٗا","кого-либо",19,26],["فَقُولِيٓ","то скажи",19,26]],[["إِنِّي","поистине, я",19,26],["نَذَرۡتُ","дала обет",19,26],["لِلرَّحۡمَٰنِ","Милостивому",19,26],["صَوۡمٗا","поста",19,26],["فَلَنۡ","и не",19,26],["أُكَلِّمَ","буду говорить я",19,26],["ٱلۡيَوۡمَ","сегодня",19,26],["إِنسِيّٗا","с человеком",19,26],[26]],[["فَأَتَتۡ","и пришла она",19,27],["بِهِۦ","с ним",19,27],["قَوۡمَهَا","к народу своему",19,27],["تَحۡمِلُهُۥۖ","неся его",19,27],["قَالُواْ","они сказали",19,27],["يَٰمَرۡيَمُ","о Марьям",19,27],["لَقَدۡ","ты уже",19,27],["جِئۡتِ","совершила",19,27],["شَيۡـٔٗا","дело",19,27]],[["فَرِيّٗا","неслыханное",19,27],[27],["يَٰٓأُخۡتَ","о сестра",19,28],["هَٰرُونَ","Харуна",19,28],["مَا","не",19,28],["كَانَ","был",19,28],["أَبُوكِ","отец твой",19,28],["ٱمۡرَأَ","человеком",19,28],["سَوۡءٖ","дурным",19,28],["وَمَا","и не",19,28],["كَانَتۡ","была",19,28]],[["أُمُّكِ","мать твоя",19,28],["بَغِيّٗا","блудницей",19,28],[28],["فَأَشَارَتۡ","и указала она",19,29],["إِلَيۡهِۖ","на него",19,29],["قَالُواْ","они сказали",19,29],["كَيۡفَ","как",19,29],["نُكَلِّمُ","будем говорить мы",19,29],["مَن","с тем, кто",19,29],["كَانَ","есть",19,29],["فِي","в",19,29]],[["ٱلۡمَهۡدِ","колыбели",19,29],["صَبِيّٗا","младенец",19,29],[29],["قَالَ","он сказал",19,30],["إِنِّي","поистине, я",19,30],["عَبۡدُ","раб",19,30],["ٱللَّهِ","Аллаха",19,30],["ءَاتَىٰنِيَ","Он даровал мне",19,30],["ٱلۡكِتَٰبَ","Писание",19,30],["وَجَعَلَنِي","и сделал меня",19,30]],[["نَبِيّٗا","пророком",19,30],[30],["وَجَعَلَنِي","и Он сделал меня",19,31],["مُبَارَكًا","благословенным",19,31],["أَيۡنَ","где",19,31],["مَا","бы ни",19,31],["كُنتُ","был я",19,31],["وَأَوۡصَٰنِي","и заповедал мне",19,31],["بِٱلصَّلَوٰةِ","молитву",19,31]],[["وَٱلزَّكَوٰةِ","и закят",19,31],["مَا","пока",19,31],["دُمۡتُ","пребываю я",19,31],["حَيّٗا","живым",19,31],[31],["وَبَرَّۢا","и почтительным",19,32],["بِوَٰلِدَتِي","к матери моей",19,32],["وَلَمۡ","и не",19,32],["يَجۡعَلۡنِي","сделал Он меня",19,32]],[["جَبَّارٗا","надменным",19,32],["شَقِيّٗا","несчастным",19,32],[32],["وَٱلسَّلَٰمُ","и мир",19,33],["عَلَيَّ","мне",19,33],["يَوۡمَ","в день",19,33],[