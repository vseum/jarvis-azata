ا","высокий",19,50],[50]],[["وَٱذۡكُرۡ","и помяни",19,51],["فِي","в",19,51],["ٱلۡكِتَٰبِ","Писании",19,51],["مُوسَىٰٓۚ","Мусу",19,51],["إِنَّهُۥ","поистине, он",19,51],["كَانَ","был",19,51],["مُخۡلَصٗا","избранным",19,51],["وَكَانَ","и был",19,51],["رَسُولٗا","посланником",19,51],["نَّبِيّٗا","пророком",19,51],[51]]]}