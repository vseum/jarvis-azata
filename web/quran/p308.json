{"p":308,"j":16,"a":[[19,39,["وَأَنذِرۡهُمۡ","يَوۡمَ","ٱلۡحَسۡرَةِ","إِذۡ","قُضِيَ","ٱلۡأَمۡرُ","وَهُمۡ","فِي","غَفۡلَةٖ","وَهُمۡ","لَا","يُؤۡمِنُونَ"],"ва'анзирхум йаумал хасрати из ḳудийал амру вахум фии гафлатин вахум ла йу'минуун","Предупреди их о Дне печали, когда решение уже будет принято. Но они проявляют беспечность и не веруют.",["и предупреди их","о дне","сожаления","когда","будет решено","дело","а они","в","беспечности","и они","не","веруют"]],[19,40,["إِنَّا","نَحۡنُ","نَرِثُ","ٱلۡأَرۡضَ","وَمَنۡ","عَلَيۡهَا","وَإِلَيۡنَا","يُرۡجَعُونَ"],"инна нахну нарисул арда ваман `алайха ва'илайна йуржа`уун","Воистину, Мы унаследуем землю и тех, кто на ней, и они вернутся к Нам!",["поистине, Мы","Мы","унаследуем","землю","и тех, кто","на ней","и к Нам","они будут возвращены"]],[19,41,["وَٱذۡكُرۡ","فِي","ٱلۡكِتَٰبِ","إِبۡرَٰهِيمَۚ","إِنَّهُۥ","كَانَ","صِدِّيقٗا","نَّبِيًّا"],"вазкур фил китаби ибрахиима иннахуу кана сиддииḳан набиййа","Помяни в Писании Ибрахима (Авраама). Он был правдивейшим человеком и пророком.",["и помяни","в","Писании","Ибрахима","поистине, он","был","правдивейшим","пророком"]],[19,42,["إِذۡ","قَالَ","لِأَبِيهِ","يَٰٓأَبَتِ","لِمَ","تَعۡبُدُ","مَا","لَا","يَسۡمَعُ","وَلَا","يُبۡصِرُ","وَلَا","يُغۡنِي","عَنكَ","شَيۡـٔٗا"],"из ḳала ли'абиихи йа'абати лима та`буду ма ла йасма`у вала йубсиру вала йугнии `анка шай'а","Вот он сказал своему отцу: «Отец мой! Почему ты поклоняешься тому, что не слышит и не видит и не принесет тебе никакого избавления?",["вот","сказал он","отцу своему","о отец мой","почему","поклоняешься ты","тому, что","не","слышит","и не","видит","и не","избавляет","тебя","ни от чего"]],[19,43,["يَٰٓأَبَتِ","إِنِّي","قَدۡ","جَآءَنِي","مِنَ","ٱلۡعِلۡمِ","مَا","لَمۡ","يَأۡتِكَ","فَٱتَّبِعۡنِيٓ","أَهۡدِكَ","صِرَٰطٗا","سَوِيّٗا"],"йа'абати иннии ḳад жаании минал `илми ма лам йа'тика фаттаби`нии ахдика сиратан савиййа","Отец мой! Мне открылось знание, которое не было открыто тебе. Последуй же за мной, и я поведу тебя верным путем.",["о отец мой","поистине, я","уже","пришло ко мне","из","знания","то, что","не","пришло к тебе","так последуй за мной","я поведу тебя","путём","ровным"]],[19,44,["يَٰٓأَبَتِ","لَا","تَعۡبُدِ","ٱلشَّيۡطَٰنَۖ","إِنَّ","ٱلشَّيۡطَٰنَ","كَانَ","لِلرَّحۡمَٰنِ","عَصِيّٗا"],"йа'абати ла та`будиш шайтана иннаш шайтана кана лиррахмани `асиййа","Отец мой! Не поклоняйся дьяволу, поскольку он ослушался Милостивого.",["о отец мой","не","поклоняйся","дьяволу","поистине","дьявол","был","Милостивому","ослушником"]],[19,45,["يَٰٓأَبَتِ","إِنِّيٓ","أَخَافُ","أَن","يَمَسَّكَ","عَذَابٞ","مِّنَ","ٱلرَّحۡمَٰنِ","فَتَكُونَ","لِلشَّيۡطَٰنِ","وَلِيّٗا"],"йа'абати иннии ахафу ан йамассака `азабум минар рахмани фатакууна лишшайтани валиййа","Отец мой! Я боюсь, что тебя постигнет наказание от Милостивого и что ты станешь помощником дьявола.",["о отец мой","поистине, я","боюсь","что","коснётся тебя","наказание","от","Милостивого","и станешь ты","дьяволу","помощником"]],[19,46,["قَالَ","أَرَاغِبٌ","أَنتَ","عَنۡ","ءَالِهَتِي","يَٰٓإِبۡرَٰهِيمُۖ","لَئِن","لَّمۡ","تَنتَهِ","لَأَرۡجُمَنَّكَۖ","وَٱهۡجُرۡنِي","مَلِيّٗا"],"ḳала арагибун анта `ан алихатии йа'ибрахииму ла'ил лам тантахи ла'аржуманнака вахжурнии малиййа","Он сказал: «Неужели ты отворачиваешься от моих богов, Ибрахим (Авраам)? Если ты не перестанешь, то я непременно побью тебя камнями. Оставь же меня надолго!».",["он сказал","неужели отвращаешься","ты","от","богов моих","о Ибрахим","если","не","перестанешь ты","непременно побью тебя камнями","и покинь меня","надолго"]],[19,47,["قَالَ","سَلَٰمٌ","عَلَيۡكَۖ","سَأَسۡتَغۡفِرُ","لَكَ","رَبِّيٓۖ","إِنَّهُۥ","كَانَ","بِي","حَفِيّٗا"],"ḳала саламун `алайка са'астагфиру лака раббии иннахуу кана бии хафиййа","Он сказал: «Мир тебе! Я буду просить моего Господа простить тебя. Воистину, Он снисходителен ко мне.",["он сказал","мир","тебе","я попрошу прощения","для тебя","у Господа моего","поистине, Он","был","ко мне","милостив"]],[19,48,["وَأَعۡتَزِلُكُمۡ","وَمَا","تَدۡعُونَ","مِن","دُونِ","ٱللَّهِ","وَأَدۡعُواْ","رَبِّي","عَسَىٰٓ","أَلَّآ","أَكُونَ","بِدُعَآءِ","رَبِّي","شَقِيّٗا"],"ва'а`тазилукум вама тад`ууна мин дууниллахи ва'ад`уу раббии `аса алла акууна биду`аи раббии шаḳиййа","Я удаляюсь от вас и от того, чему вы поклоняетесь помимо Аллаха, и обращаюсь с мольбой к моему Господу. Быть может, благодаря молитвам к моему Господу я не буду несчастен».",["и я удаляюсь от вас","и от того, к чему","вы взываете","помимо","помимо","Аллаха","и я взываю","к Господу моему","быть может","что не","буду я","в мольбе","к Господу моему","несчастным"]],[19,49,["فَلَمَّا","ٱعۡتَزَلَهُمۡ","وَمَا","يَعۡبُدُونَ","مِن","دُونِ","ٱللَّهِ","وَهَبۡنَا","لَهُۥٓ","إِسۡحَٰقَ","وَيَعۡقُوبَۖ","وَكُلّٗا","جَعَلۡنَا","نَبِيّٗا"],"фаламма`тазалахум вама йа`будууна мин дууниллахи вахабна лахуу исхаḳа вайа`ḳууба вакуллан жа`ална набиййа","Когда он удалился от них и от того, чему они поклонялись помимо Аллаха, Мы даровали ему Исхака (Исаака) и Йакуба (Иакова). Каждого из них Мы сделали пророком.",["и когда","он удалился от них","и от того, чему","они поклонялись","помимо","помимо","Аллаха","Мы даровали","ему","Исхака","и Йакуба","и каждого","Мы сделали","пророком"]],[19,50,["وَوَهَبۡنَا","لَهُم","مِّن","رَّحۡمَتِنَا","وَجَعَلۡنَا","لَهُمۡ","لِسَانَ","صِدۡقٍ","عَلِيّٗا"],"вавахабна лахум мир рахматина важа`ална лахум лисана сидḳин `алиййа","Мы одарили их из Нашей милости и оставили о них правдивую молву.",["и Мы даровали","им","из","милости Нашей","и Мы сделали","им","язык","правды","высокий"]],[19,51,["وَٱذۡكُرۡ","فِي","ٱلۡكِتَٰبِ","مُوسَىٰٓۚ","إِنَّهُۥ","كَانَ","مُخۡلَصٗا","وَكَانَ","رَسُولٗا","نَّبِيّٗا"],"вазкур фил китаби мууса иннахуу кана мухласан вакана расуулан набиййа","Помяни в Писании Мусу (Моисея). Воистину, он был избранником (или искренним) и был посланником и пророком.",["и помяни","в","Писании","Мусу","поистине, он","был","избранным","и был","посланником","пророком"]]],"m":[[["وَأَنذِرۡهُمۡ","и предупреди их",19,39],["يَوۡمَ","о дне",19,39],["ٱلۡحَسۡرَةِ","сожаления",19,39],["إِذۡ","когда