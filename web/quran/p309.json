{"p":309,"j":16,"a":[[19,52,["وَنَٰدَيۡنَٰهُ","مِن","جَانِبِ","ٱلطُّورِ","ٱلۡأَيۡمَنِ","وَقَرَّبۡنَٰهُ","نَجِيّٗا"],"ванадайнаху мин жанибит туурил аймани ваḳаррабнаху нажиййа","Мы подали ему глас с правой стороны горы и подозвали его поближе тихим голосом.",["и Мы воззвали к нему","со","стороны","горы","правой","и приблизили его","для беседы"]],[19,53,["وَوَهَبۡنَا","لَهُۥ","مِن","رَّحۡمَتِنَآ","أَخَاهُ","هَٰرُونَ","نَبِيّٗا"],"вавахабна лахуу мир рахматина ахаху харууна набиййа","По милости Своей Мы сделали для него его брата Харуна (Аарона) пророком.",["и даровали Мы","ему","по","Нашей милости","его брата","Харуна","пророком"]],[19,54,["وَٱذۡكُرۡ","فِي","ٱلۡكِتَٰبِ","إِسۡمَٰعِيلَۚ","إِنَّهُۥ","كَانَ","صَادِقَ","ٱلۡوَعۡدِ","وَكَانَ","رَسُولٗا","نَّبِيّٗا"],"вазкур фил китаби исма`иила иннахуу кана садиḳал ва`ди вакана расуулан набиййа","Помяни в Писании Исмаила (Измаила). Воистину, он был правдивым в обещаниях и был посланником и пророком.",["и помяни","в","Писании","Исмаила","поистине, он","был","верен","обещанию","и был","посланником","пророком"]],[19,55,["وَكَانَ","يَأۡمُرُ","أَهۡلَهُۥ","بِٱلصَّلَوٰةِ","وَٱلزَّكَوٰةِ","وَكَانَ","عِندَ","رَبِّهِۦ","مَرۡضِيّٗا"],"вакана йа'муру ахлахуу биссалавати ваззакавати вакана `инда раббихии мардиййа","Он велел своей семье совершать намаз и выплачивать закят, а его Господь был доволен им.",["и он","велел","своей семье","(совершать) намаз","и (давать) закят","и был","у","своего Господа","угодным"]],[19,56,["وَٱذۡكُرۡ","فِي","ٱلۡكِتَٰبِ","إِدۡرِيسَۚ","إِنَّهُۥ","كَانَ","صِدِّيقٗا","نَّبِيّٗا"],"вазкур фил китаби идрииса иннахуу кана сиддииḳан набиййа","Помяни в Писании Идриса. Воистину, он был правдивейшим человеком и пророком.",["и помяни","в","Писании","Идриса","поистине, он","был","правдивейшим","пророком"]],[19,57,["وَرَفَعۡنَٰهُ","مَكَانًا","عَلِيًّا"],"варафа`наху маканан `алиййа","Мы вознесли его на высокое место.",["и Мы вознесли его","на место","высокое"]],[19,58,["أُوْلَٰٓئِكَ","ٱلَّذِينَ","أَنۡعَمَ","ٱللَّهُ","عَلَيۡهِم","مِّنَ","ٱلنَّبِيِّـۧنَ","مِن","ذُرِّيَّةِ","ءَادَمَ","وَمِمَّنۡ","حَمَلۡنَا","مَعَ","نُوحٖ","وَمِن","ذُرِّيَّةِ","إِبۡرَٰهِيمَ","وَإِسۡرَٰٓءِيلَ","وَمِمَّنۡ","هَدَيۡنَا","وَٱجۡتَبَيۡنَآۚ","إِذَا","تُتۡلَىٰ","عَلَيۡهِمۡ","ءَايَٰتُ","ٱلرَّحۡمَٰنِ","خَرُّواْۤ","سُجَّدٗاۤ","وَبُكِيّٗا ۩"],"улаикал лазиина ан`амаллаху `алайхим минан набиййиина мин зурриййати адама вамимман хамална ма`а нуухин вамин зурриййати ибрахиима ва'исраиила вамимман хадайна важтабайна иза тутла `алайхим айатур рахмани харруу сужжадан вабукиййа","Это - те, кого облагодетельствовал Аллах, из числа пророков, которые были потомками Адама и тех, кого Мы спасли вместе с Нухом (Ноем), и потомками Ибрахима (Авраама) и Исраила (Израиля), и из числа тех, кого Мы наставили на прямой путь и избрали. Когда им читали аяты Милостивого, они падали ниц и рыдали.",["те","которые","облагодетельствовал","Аллах","их","из","пророков","из","потомства","Адама","и из тех, кого","Мы несли","с","Нухом","и из","потомства","Ибрахима","и Исраила","и из тех, кого","Мы наставили","и Мы избрали","когда","читаются","им","аяты","Милостивого","они падали","ниц","и плача"]],[19,59,["فَخَلَفَ","مِنۢ","بَعۡدِهِمۡ","خَلۡفٌ","أَضَاعُواْ","ٱلصَّلَوٰةَ","وَٱتَّبَعُواْ","ٱلشَّهَوَٰتِۖ","فَسَوۡفَ","يَلۡقَوۡنَ","غَيًّا"],"фахалафа мим ба`дихим халфун ада`ус салавата ваттаба`уш шахавати фасауфа йалḳауна гаййа","После них пришли потомки, которые перестали совершать намаз и стали потакать желаниям. Все они понесут убыток (или будут испытывать тяготы; или понесут наказание за невежество; или встретят зло),",["и пришли на смену","после","них","потомки","которые упустили","намаз","и последовали","страстям","и вскоре","они встретят","погибель"]],[19,60,["إِلَّا","مَن","تَابَ","وَءَامَنَ","وَعَمِلَ","صَٰلِحٗا","فَأُوْلَٰٓئِكَ","يَدۡخُلُونَ","ٱلۡجَنَّةَ","وَلَا","يُظۡلَمُونَ","شَيۡـٔٗا"],"илла ман таба ва'амана ва`амила салихан фа'улаика йадхулуунал жанната вала йузламууна шай'а","кроме тех, которые раскаялись, уверовали и поступали праведно. Они войдут в Рай, и с ними нисколько не поступят несправедливо.",["кроме","тех, кто","покаялся","и уверовал","и совершал","праведное","то эти","войдут","в Рай","и не","будут обижены","ни в чём"]],[19,61,["جَنَّٰتِ","عَدۡنٍ","ٱلَّتِي","وَعَدَ","ٱلرَّحۡمَٰنُ","عِبَادَهُۥ","بِٱلۡغَيۡبِۚ","إِنَّهُۥ","كَانَ","وَعۡدُهُۥ","مَأۡتِيّٗا"],"жаннати `аднинил латии ва`адар рахману `ибадахуу билгайби иннахуу кана ва`духуу ма'тиййа","Это будут сады Эдема, обещанные Милостивым Его рабам, которые не видели их воочию. Воистину, обещание Его исполнится.",["сады","Эдема","которые","обещал","Милостивый","Своим рабам","заочно (в сокровенном)","поистине","было","обещание Его","исполняемым"]],[19,62,["لَّا","يَسۡمَعُونَ","فِيهَا","لَغۡوًا","إِلَّا","سَلَٰمٗاۖ","وَلَهُمۡ","رِزۡقُهُمۡ","فِيهَا","بُكۡرَةٗ","وَعَشِيّٗا"],"лла йасма`ууна фииха лагван илла саламан валахум ризḳухум фииха букратан ва`ашиййа","Они не услышат там празднословия, но услышат приветствие миром. Для них там приготовлен их удел утром и после полудня.",["не","услышат они","там","празднословия","лишь","мир","и для них","удел их","там","утром","и вечером"]],[19,63,["تِلۡكَ","ٱلۡجَنَّةُ","ٱلَّتِي","نُورِثُ","مِنۡ","عِبَادِنَا","مَن","كَانَ","تَقِيّٗا"],"тилкал жаннатул латии нуурису мин `ибадина ман кана таḳиййа","Таков Рай, который Мы отдадим в наследство тем из Наших рабов, которые были богобоязненны.",["это","Рай","который","Мы даём в наследство","из","Наших рабов","тому, кто","был","богобоязнен"]],[19,64,["وَمَا","نَتَنَزَّلُ","إِلَّا","بِأَمۡرِ","رَبِّكَۖ","لَهُۥ","مَا","بَيۡنَ","أَيۡدِينَا","وَمَا","خَلۡفَنَا","وَمَا","بَيۡنَ","ذَٰلِكَۚ","وَمَا","كَانَ","رَبُّكَ","نَسِيّٗا"],"вама натаназзалу илла би'амри раббика лахуу ма байна айдиина вама халфана вама байна залика вама кана раббука насиййа","Ангелы сказали: «Мы нисходим только по велению твоего Господа. Ему принадлежит то, что перед нами, и то, что позади нас, и то, что между ними. Господь твой не забывчив».",["и не","мы нисходим","кроме как","по велению","твоего Господа","Ему (принадлежит)","то, что","перед","нами","и то, что","позади нас","и то, что","между","этим","и не","был","Господь твой","забывчивым"]]],"m":[[["وَنَٰدَيۡنَٰهُ","и Мы воззвали к нему",19,52],["مِن","со",19,52],["جَانِبِ","стороны",19,52],["ٱلطُّورِ","горы",19,52],["ٱلۡأَيۡمَنِ","правой",19,52],["وَقَرَّبۡنَٰهُ","и приблизили его",19,52],["نَجِيّٗا","для беседы",19,52],[52],["وَوَهَبۡنَا","и даровали Мы",19,53],["لَهُۥ","ему",19,53],["مِن","по",19,53]],[["رَّحۡمَتِنَآ","Нашей милости",19,53],["أَخَاهُ","его брата",19,53],["هَٰرُونَ","Харуна",19,53],["نَبِيّٗا","пророком",19,53],[53],["وَٱذۡكُرۡ","и помяни",19,54],["فِي","в",19,54],["ٱلۡكِتَٰبِ","Писании",19,54],["إِسۡمَٰعِيلَۚ","Исмаила",19,54],["إِنَّهُۥ","поистине, он",19,54],["كَانَ","был",19,54]],[["صَادِقَ","верен",19,54],["ٱلۡوَعۡدِ","обещанию",19,54],["وَكَانَ","и был",19,54],["رَسُولٗا","посланником",19,54],["نَّبِيّٗا","пророком",19,54],[54],["وَكَانَ","и он",19,55],["يَأۡمُرُ","велел",19,55],["أَهۡلَهُۥ","своей семье",19,55],["بِٱلصَّلَوٰةِ","(совершать) намаз",19,55]],[["وَٱلزَّكَوٰةِ","и (давать) закят",19,55],["وَكَانَ","и был",19,55],["عِندَ","у",19,55],["رَبِّهِۦ","своего Господа",19,55],["مَرۡضِيّٗا","угодным",19,55],[55],["وَٱذۡكُرۡ","и помяни",19,56],["فِي","в",19,56],["ٱلۡكِتَٰبِ","Писании",19,56],["إِدۡرِيسَۚ","Идриса",19,56]],[["إِنَّهُۥ","поистине, он",19,56],["كَانَ","был",19,56],["صِدِّيقٗا","правдивейшим",19,56],["نَّبِيّٗا","пророком",19,56],[56],["وَرَفَعۡنَٰهُ","и Мы вознесли его",19,57],["مَكَانًا","на место",19,57],["عَلِيًّا","высокое",19,57],[57],["أُوْلَٰٓئِكَ","те",19,58],["ٱلَّذِينَ","которые",19,58]],[["أَنۡعَمَ","облагодетельствовал",19,58],["ٱللَّهُ","Аллах",19,58],["عَلَيۡهِم","их",19,58],["مِّنَ","из",19,58],["ٱلنَّبِيِّـۧنَ","пророков",19,58],["مِن","из",19,58],["ذُرِّيَّةِ","потомства",19,58],["ءَادَمَ","Адама",19,58],["وَمِمَّنۡ","и из тех, кого",19,58],["حَمَلۡنَا","Мы несли",19,58],["مَعَ","с",19,58],["نُوحٖ","Нухом",19,58]],[["وَمِن","и из",19,58],["ذُرِّيَّةِ","потомства",19,58],["إِبۡرَٰهِيمَ","Ибрахима",19,58],["وَإِسۡرَٰٓءِيلَ","и Исраила",19,58],["وَمِمَّنۡ","и из тех, кого",19,58],["هَدَيۡنَا","Мы наставили",19,58],["وَٱجۡتَبَيۡنَآۚ","и Мы избрали",19,58],["إِذَا","когда",19,58],["تُتۡلَىٰ","читаются",19,58],["عَلَيۡهِمۡ","им",19,58]],[["ءَايَٰتُ","аяты",19,58],["ٱلرَّحۡمَٰنِ","Милостивого",19,58],["خَرُّواْۤ","они падали",19,58],["سُجَّدٗاۤ","ниц",19,58],["وَبُكِيّٗا ۩","и плача",19,58],[58],["۞ فَخَلَفَ","и пришли на смену",19,59],["مِنۢ","после",19,59],["بَعۡدِهِمۡ","них",19,59]],[["خَلۡفٌ","потомки",19,59],["أَضَاعُواْ","которые упустили",19,59],["ٱلصَّلَوٰةَ","намаз",19,59],["وَٱتَّبَعُواْ","и последовали",19,59],["ٱلشَّهَوَٰتِۖ","страстям",19,59],["فَسَوۡفَ","и вскоре",19,59],["يَلۡقَوۡنَ","они встретят",19,59],["غَيًّا","погибель",19,59]],[[59],["إِلَّا","кроме",19,60],["مَن","тех, кто",19,60],["تَابَ","покаялся",19,60],["وَءَامَنَ","и уверовал",19,60],["وَعَمِلَ","и совершал",19,60],["صَٰلِحٗا","праведное",19,60],["فَأُوْلَٰٓئِكَ","то эти",19,60],["يَدۡخُلُونَ","войдут",19,60],["ٱلۡجَنَّةَ","в Рай",19,60]],[["وَلَا","и не",19,60],["يُظۡلَمُونَ","будут обижены",19,60],["شَيۡـٔٗا","ни в чём",19,60],[60],["جَنَّٰتِ","сады",19,61],["عَدۡنٍ","Эдема",19,61],["ٱلَّتِي","которые",19,61],["وَعَدَ","обещал",19,61],["ٱلرَّحۡمَٰنُ","Милостивый",19,61],["عِبَادَهُۥ","Своим рабам",19,61]],[["بِٱلۡغَيۡبِۚ","заочно (в сокровенном)",19,61],["إِنَّهُۥ","поистине",19,61],["كَانَ","было",19,61],["وَعۡدُهُۥ","обещание Его",19,61],["مَأۡتِيّٗا","исполняемым",19,61],[61],["لَّا","не",19,62],["يَسۡمَعُونَ","услышат они",19,62],["فِيهَا","там",19,62],["لَغۡوًا","празднословия",19,62],["إِلَّا","лишь",19,62],["سَلَٰمٗاۖ","мир",19,62]],[["وَلَهُمۡ","и для них",19,62],["رِزۡقُهُمۡ","удел их",19,62],["فِيهَا","там",19,62],["بُكۡرَةٗ","утром",19,62],["وَعَشِيّٗا","и вечером",19,62],[62],["تِلۡكَ","это",19,63],["ٱلۡجَنَّةُ","Рай",19,63],["ٱلَّتِي","который",19,63],["نُورِثُ","Мы даём в наследство",19,63],["مِنۡ","из",19,63]],[["عِبَادِن