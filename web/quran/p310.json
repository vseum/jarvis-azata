],["وَإِذَا","и когда",19,73],["تُتۡلَىٰ","читаются",19,73],["عَلَيۡهِمۡ","им",19,73],["ءَايَٰتُنَا","Наши аяты",19,73],["بَيِّنَٰتٖ","ясными",19,73],["قَالَ","говорят",19,73],["ٱلَّذِينَ","те, которые",19,73],["كَفَرُواْ","не уверовали",19,73]],[["لِلَّذِينَ","тем, которые",19,73],["ءَامَنُوٓاْ","уверовали",19,73],["أَيُّ","какая",19,73],["ٱلۡفَرِيقَيۡنِ","из двух групп",19,73],["خَيۡرٞ","лучше",19,73],["مَّقَامٗا","положением",19,73],["وَأَحۡسَنُ","и прекраснее",19,73],["نَدِيّٗا","собранием",19,73],[73],["وَكَمۡ","и сколько",19,74]],[["أَهۡلَكۡنَا","Мы погубили",19,74],["قَبۡلَهُم","до них",19,74],["مِّن","из",19,74],["قَرۡنٍ","поколений",19,74],["هُمۡ","они",19,74],["أَحۡسَنُ","лучше",19,74],["أَثَٰثٗا","утварью",19,74],["وَرِءۡيٗا","и видом",19,74],[74],["قُلۡ","скажи",19,75],["مَن","кто",19,75]],[["كَانَ","пребывает",19,75],["فِي","в",19,75],["ٱلضَّلَٰلَةِ","заблуждении",19,75],["فَلۡيَمۡدُدۡ","пусть же продлит",19,75],["لَهُ","ему",19,75],["ٱلرَّحۡمَٰنُ","Милостивый",19,75],["مَدًّاۚ","сполна",19,75],["حَتَّىٰٓ","пока",19,75],["إِذَا","когда",19,75],["رَأَوۡاْ","увидят они",19,75],["مَا","то, что",19,75],["يُوعَدُونَ","им обещано",19,75]],[["إِمَّا","либо",19,75],["ٱلۡعَذَابَ","наказание",19,75],["وَإِمَّا","либо",19,75],["ٱلسَّاعَةَ","Час",19,75],["فَسَيَعۡلَمُونَ","тогда узнают они",19,75],["مَنۡ","кто",19,75],["هُوَ","он",19,75],["شَرّٞ","хуже",19,75],["مَّكَانٗا","местом",19,75]],[["وَأَضۡعَفُ","и слабее",19,75],["جُندٗا","войском",19,75],[75],["وَيَزِيدُ","и увеличивает",19,76],["ٱللَّهُ","Аллах",19,76],["ٱلَّذِينَ","тем, которые",19,76],["ٱهۡتَدَوۡاْ","следуют прямым путём",19,76],["هُدٗىۗ","руководство",19,76]],[["وَٱلۡبَٰقِيَٰتُ","а вечные",19,76],["ٱلصَّٰلِحَٰتُ","праведные дела",19,76],["خَيۡرٌ","лучше",19,76],["عِندَ","у",19,76],["رَبِّكَ","Господа твоего",19,76],["ثَوَابٗا","наградой",19,76],["وَخَيۡرٞ","и лучше",19,76],["مَّرَدًّا","исходом",19,76],[76]]]}