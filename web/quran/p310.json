{"p":310,"j":16,"a":[[19,65,["رَّبُّ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِ","وَمَا","بَيۡنَهُمَا","فَٱعۡبُدۡهُ","وَٱصۡطَبِرۡ","لِعِبَٰدَتِهِۦۚ","هَلۡ","تَعۡلَمُ","لَهُۥ","سَمِيّٗا"],"рраббус самавати вал'арди вама байнахума фа`будху вастабир ли`ибадатихии хал та`ламу лахуу самиййа","Господь небес, земли и того, что между ними! Поклоняйся же Ему и будь стоек в поклонении Ему. Знаешь ли ты другого с таким именем (или подобного Ему)?",["Господь","небес","и земли","и того, что","между ними","поклоняйся же Ему","и будь терпелив","в поклонении Ему","разве","знаешь ты","Ему","соименного (равного)"]],[19,66,["وَيَقُولُ","ٱلۡإِنسَٰنُ","أَءِذَا","مَا","مِتُّ","لَسَوۡفَ","أُخۡرَجُ","حَيًّا"],"вайаḳуулул инсану а'иза ма митту ласауфа ухражу хаййа","Человек говорит: «Неужели после того, как я умру, я выйду из могилы живым?».",["и говорит","человек","неужели когда","уже","я умру","то непременно","я буду выведен","живым"]],[19,67,["أَوَلَا","يَذۡكُرُ","ٱلۡإِنسَٰنُ","أَنَّا","خَلَقۡنَٰهُ","مِن","قَبۡلُ","وَلَمۡ","يَكُ","شَيۡـٔٗا"],"авала йазкурул инсану анна халаḳнаху мин ḳаблу валам йаку шай'а","Разве человек не помнит, что еще раньше Мы создали его, хотя его вообще не было?",["разве не","помнит","человек","что Мы","Мы создали его","до","этого","а не","был он","ничем"]],[19,68,["فَوَرَبِّكَ","لَنَحۡشُرَنَّهُمۡ","وَٱلشَّيَٰطِينَ","ثُمَّ","لَنُحۡضِرَنَّهُمۡ","حَوۡلَ","جَهَنَّمَ","جِثِيّٗا"],"фавараббика ланахшураннахум вашшайатиина сумма ланухдираннахум хаула жаханнама жисиййа","Клянусь твоим Господом, Мы непременно соберем их и дьяволов, а затем поставим их вокруг Геенны на колени.",["клянусь же Господом твоим","непременно Мы соберём их","и дьяволов","затем","непременно Мы поставим их","вокруг","Геенны","на коленях"]],[19,69,["ثُمَّ","لَنَنزِعَنَّ","مِن","كُلِّ","شِيعَةٍ","أَيُّهُمۡ","أَشَدُّ","عَلَى","ٱلرَّحۡمَٰنِ","عِتِيّٗا"],"сумма лананзи`анна мин кулли шии`атин аййухум ашадду `алар рахмани `итиййа","Потом Мы выведем из каждой общины того, кто больше других ослушался Милостивого.",["затем","непременно Мы вытащим","из","каждой","группы","того из них, кто","сильнее","против","Милостивого","в непокорности"]],[19,70,["ثُمَّ","لَنَحۡنُ","أَعۡلَمُ","بِٱلَّذِينَ","هُمۡ","أَوۡلَىٰ","بِهَا","صِلِيّٗا"],"сумма ланахну а`ламу биллазиина хум аула биха силиййа","Нам лучше знать, кому более подобает гореть там (или кто более других заслуживает войти туда).",["затем","непременно Мы","лучше знаем","о тех, которые","они","более достойны","её (огня)","горения"]],[19,71,["وَإِن","مِّنكُمۡ","إِلَّا","وَارِدُهَاۚ","كَانَ","عَلَىٰ","رَبِّكَ","حَتۡمٗا","مَّقۡضِيّٗا"],"ва'им минкум илла варидуха кана `ала раббика хатмам маḳдиййа","Каждый из вас войдет туда. Таково окончательное решение твоего Господа.",["и нет","из вас","кроме как","придущего к ней","(это) было","для","Господа твоего","непреложным","решённым"]],[19,72,["ثُمَّ","نُنَجِّي","ٱلَّذِينَ","ٱتَّقَواْ","وَّنَذَرُ","ٱلظَّٰلِمِينَ","فِيهَا","جِثِيّٗا"],"сумма нунажжил лазиинаттаḳав вваназаруз залимиина фииха жисиййа","Потом Мы спасем богобоязненных, а беззаконников оставим там стоять на коленях.",["затем","Мы спасём","тех, которые","были богобоязненны","и оставим","беззаконников","там","на коленях"]],[19,73,["وَإِذَا","تُتۡلَىٰ","عَلَيۡهِمۡ","ءَايَٰتُنَا","بَيِّنَٰتٖ","قَالَ","ٱلَّذِينَ","كَفَرُواْ","لِلَّذِينَ","ءَامَنُوٓاْ","أَيُّ","ٱلۡفَرِيقَيۡنِ","خَيۡرٞ","مَّقَامٗا","وَأَحۡسَنُ","نَدِيّٗا"],"ва'иза тутла `алайхим айатуна баййинатин ḳалал лазиина кафаруу лиллазиина амануу аййул фарииḳайни хайрум маḳаман ва'ахсану надиййа","Когда им читают Наши ясные аяты, неверующие говорят верующим: «Какая из двух групп занимает более высокое положение и более достойное место?».",["и когда","читаются","им","Наши аяты","ясными","говорят","те, которые","не уверовали","тем, которые","уверовали","какая","из двух групп","лучше","положением","и прекраснее","собранием"]],[19,74,["وَكَمۡ","أَهۡلَكۡنَا","قَبۡلَهُم","مِّن","قَرۡنٍ","هُمۡ","أَحۡسَنُ","أَثَٰثٗا","وَرِءۡيٗا"],"вакам ахлакна ḳаблахум мин ḳарнин хум ахсану асасан вари'йа","Сколько же поколений до них Мы погубили! Они превосходили их богатством (или утварью) и внешностью.",["и сколько","Мы погубили","до них","из","поколений","они","лучше","утварью","и видом"]],[19,75,["قُلۡ","مَن","كَانَ","فِي","ٱلضَّلَٰلَةِ","فَلۡيَمۡدُدۡ","لَهُ","ٱلرَّحۡمَٰنُ","مَدًّاۚ","حَتَّىٰٓ","إِذَا","رَأَوۡاْ","مَا","يُوعَدُونَ","إِمَّا","ٱلۡعَذَابَ","وَإِمَّا","ٱلسَّاعَةَ","فَسَيَعۡلَمُونَ","مَنۡ","هُوَ","شَرّٞ","مَّكَانٗا","وَأَضۡعَفُ","جُندٗا"],"ḳул ман кана фид далалати фалйамдуд лахур рахману маддан хатта иза ра'ау ма йуу`адууна иммал `азаба ва'иммас са`ата фасайа`ламууна ман хуа шаррум маканан ва'ад`афу жунда","Скажи: «Да продлит Милостивый жизнь заблудших до тех пор, пока они не увидят обещанные мучения или Час. Тогда они узнают, чье место хуже и чье воинство слабее».",["скажи","кто","пребывает","в","заблуждении","пусть же продлит","ему","Милостивый","сполна","пока","когда","увидят они","то, что","им обещано","либо","наказание","либо","Час","тогда узнают они","кто","он","хуже","местом","и слабее","войском"]],[19,76,["وَيَزِيدُ","ٱللَّهُ","ٱلَّذِينَ","ٱهۡتَدَوۡاْ","هُدٗىۗ","وَٱلۡبَٰقِيَٰتُ","ٱلصَّٰلِحَٰتُ","خَيۡرٌ","عِندَ","رَبِّكَ","ثَوَابٗا","وَخَيۡرٞ","مَّرَدًّا"],"вайазиидуллахул лазиинахтадау худан валбаḳийатус салихату хайрун `инда раббика савабан вахайрум марадда","Аллах увеличивает приверженность прямому пути тех, кто следует прямым путем. А нетленные благодеяния лучше перед твоим Господом по вознаграждению и по исходу.",["и увеличивает","Аллах","тем, которые","следуют прямым путём","руководство","а вечные","праведные дела","лучше","у","Господа твоего","наградой","и лучше","исходом"]]],"m":[[["رَّبُّ","Господь",19,65],["ٱلسَّمَٰوَٰتِ","небес",19,65],["وَٱلۡأَرۡضِ","и земли",19,65],["وَمَا","и того, что",19,65],["بَيۡنَهُمَا","между ними",19,65],["فَٱعۡبُدۡهُ","поклоняйся же Ему",19,65],["وَٱصۡطَبِرۡ","и будь терпелив",19,65],["لِعِبَٰدَتِهِۦۚ","в поклонении Ему",19,65]],[["هَلۡ","разве",19,65],["تَعۡلَمُ","знаешь ты",19,65],["لَهُۥ","Ему",19,65],