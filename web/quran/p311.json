{"p":311,"j":16,"a":[[19,77,["أَفَرَءَيۡتَ","ٱلَّذِي","كَفَرَ","بِـَٔايَٰتِنَا","وَقَالَ","لَأُوتَيَنَّ","مَالٗا","وَوَلَدًا"],"афараайтал лазии кафара би'айатина ваḳала ла'уутайанна малан вавалада","Видел ли ты того, кто не уверовал в Наши знамения и сказал: «Я непременно буду одарен богатством и детьми?».",["видел ли ты","того, кто","не уверовал","в Наши аяты","и сказал","непременно мне будут даны","богатство","и дети"]],[19,78,["أَطَّلَعَ","ٱلۡغَيۡبَ","أَمِ","ٱتَّخَذَ","عِندَ","ٱلرَّحۡمَٰنِ","عَهۡدٗا"],"аттала`ал гайба амиттахаза `индар рахмани `ахда","Разве он знал сокровенное или заключил завет с Милостивым?",["проник ли он","в сокровенное","или","взял он","у","Милостивого","завет"]],[19,79,["كـَلَّاۚ","سَنَكۡتُبُ","مَا","يَقُولُ","وَنَمُدُّ","لَهُۥ","مِنَ","ٱلۡعَذَابِ","مَدّٗا"],"калла санактубу ма йаḳуулу ванамудду лахуу минал `азаби мадда","Нет! Мы запишем его слова и увеличим его мучения.",["нет же","Мы запишем","то, что","он говорит","и продлим","ему","из","наказания","сполна"]],[19,80,["وَنَرِثُهُۥ","مَا","يَقُولُ","وَيَأۡتِينَا","فَرۡدٗا"],"ванарисухуу ма йаḳуулу вайа'тиина фарда","Мы унаследуем от него то, о чем он говорил, и он явится к Нам в одиночестве.",["и Мы унаследуем от него","то, что","он говорит","и он придёт к Нам","одиноким"]],[19,81,["وَٱتَّخَذُواْ","مِن","دُونِ","ٱللَّهِ","ءَالِهَةٗ","لِّيَكُونُواْ","لَهُمۡ","عِزّٗا"],"ваттахазуу мин дууниллахи алихатал лийакуунуу лахум `изза","Они стали поклоняться наряду с Аллахом другим богам, чтобы те одарили их могуществом.",["и взяли они","помимо","(кроме)","Аллаха","богов","чтобы были они","для них","силой"]],[19,82,["كـَلَّاۚ","سَيَكۡفُرُونَ","بِعِبَادَتِهِمۡ","وَيَكُونُونَ","عَلَيۡهِمۡ","ضِدًّا"],"калла сайакфурууна би`ибадатихим вайакуунууна `алайхим дидда","Но нет! Они отрекутся от поклонения им и станут их противниками.",["нет же","отвергнут они","их поклонение","и станут","против них","противниками"]],[19,83,["أَلَمۡ","تَرَ","أَنَّآ","أَرۡسَلۡنَا","ٱلشَّيَٰطِينَ","عَلَى","ٱلۡكَٰفِرِينَ","تَؤُزُّهُمۡ","أَزّٗا"],"алам тара анна арсалнаш шайатиина `алал кафириина та'уззухум азза","Разве ты не видишь, что Мы послали к неверующим дьяволов, чтобы те подстрекали их?",["разве не","видишь ты","что Мы","Мы послали","дьяволов","на","неверующих","подстрекающих их","подстрекательством"]],[19,84,["فَلَا","تَعۡجَلۡ","عَلَيۡهِمۡۖ","إِنَّمَا","نَعُدُّ","لَهُمۡ","عَدّٗا"],"фала та`жал `алайхим иннама на`удду лахум `адда","Посему не торопись с ними! Мы ведем для них счет.",["так не","торопись","с ними","лишь","Мы отсчитываем","им","счётом"]],[19,85,["يَوۡمَ","نَحۡشُرُ","ٱلۡمُتَّقِينَ","إِلَى","ٱلرَّحۡمَٰنِ","وَفۡدٗا"],"йаума нахшурул муттаḳиина илар рахмани вафда","В тот день Мы соберем благочестивых перед Милостивым почтенной делегацией,",["в день, когда","Мы соберём","богобоязненных","к","Милостивому","делегацией"]],[19,86,["وَنَسُوقُ","ٱلۡمُجۡرِمِينَ","إِلَىٰ","جَهَنَّمَ","وِرۡدٗا"],"ванасууḳул мужримиина ила жаханнама вирда","а грешников погоним в Геенну, словно на водопой.",["и погоним","грешников","в","Геенну","(жаждущими) на водопой"]],[19,87,["لَّا","يَمۡلِكُونَ","ٱلشَّفَٰعَةَ","إِلَّا","مَنِ","ٱتَّخَذَ","عِندَ","ٱلرَّحۡمَٰنِ","عَهۡدٗا"],"лла йамликуунаш шафа`ата илла маниттахаза `индар рахмани `ахда","Никто не обретет права заступничества, кроме тех, у кого был завет с Аллахом.",["не","владеют они","заступничеством","кроме","того, кто","взял","у","Милостивого","завет"]],[19,88,["وَقَالُواْ","ٱتَّخَذَ","ٱلرَّحۡمَٰنُ","وَلَدٗا"],"ваḳалуттахазар рахману валада","Они говорят: «Милостивый взял Себе сына».",["и сказали","взял","Милостивый","сына"]],[19,89,["لَّقَدۡ","جِئۡتُمۡ","شَيۡـًٔا","إِدّٗا"],"ллаḳад жи'тум шай'ан идда","Этим вы совершаете ужасное злодеяние.",["уже","вы совершили","нечто","ужасное"]],[19,90,["تَكَادُ","ٱلسَّمَٰوَٰتُ","يَتَفَطَّرۡنَ","مِنۡهُ","وَتَنشَقُّ","ٱلۡأَرۡضُ","وَتَخِرُّ","ٱلۡجِبَالُ","هَدًّا"],"такадус самавату йатафаттарна минху ватаншаḳḳул арду ватахиррул жибалу хадда","Небо готово расколоться, земля готова разверзнуться, а горы готовы рассыпаться в прах от того,",["едва не","небеса","раскалываются","от этого","и разверзается","земля","и рушатся","горы","в прах"]],[19,91,["أَن","دَعَوۡاْ","لِلرَّحۡمَٰنِ","وَلَدٗا"],"ан да`ау лиррахмани валада","что они приписывают Милостивому сына.",["что","приписали они","Милостивому","сына"]],[19,92,["وَمَا","يَنۢبَغِي","لِلرَّحۡمَٰنِ","أَن","يَتَّخِذَ","وَلَدًا"],"вама йамбагии лиррахмани ан йаттахиза валада","Не подобает Милостивому иметь сына!",["и не","подобает","Милостивому","чтобы","Он взял","сына"]],[19,93,["إِن","كُلُّ","مَن","فِي","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِ","إِلَّآ","ءَاتِي","ٱلرَّحۡمَٰنِ","عَبۡدٗا"],"ин куллу ман фис самавати вал'арди илла атир рахмани `абда","Каждый, кто на небесах и на земле, явится к Милостивому только в качестве раба.",["не (есть)","каждый","кто","на","небесах","и земле","кроме как","приходящий","к Милостивому","рабом"]],[19,94,["لَّقَدۡ","أَحۡصَىٰهُمۡ","وَعَدَّهُمۡ","عَدّٗا"],"ллаḳад ахсахум ва`аддахум `адда","Он знает их число и пересчитал их.",["уже","Он исчислил их","и пересчитал их","счётом"]],[19,95,["وَكُلُّهُمۡ","ءَاتِيهِ","يَوۡمَ","ٱلۡقِيَٰمَةِ","فَرۡدًا"],"вакуллухум атиихи йаумал ḳийамати фарда","Каждый из них явится к Нему в День воскресения в одиночестве.",["и каждый из них","придет к Нему","в день","воскресения","одиноким"]]],"m":[[["أَفَرَءَيۡتَ","видел ли ты",19,77],["ٱلَّذِي","того, кто",19,77],["كَفَرَ","не уверовал",19,77],["بِـَٔايَٰتِنَا","в Наши аяты",19,77],["وَقَالَ","и сказал",19,77],["لَأُوتَيَنَّ","непременно мне будут даны",19,77],["مَالٗا","богатство",19,77],["وَوَلَدًا","и дети",19,77]],[[77],["أَطَّلَعَ","проник ли он",19,78],["ٱلۡغَيۡبَ","в сокровенное",19,78],["أَمِ","или",19,78],["ٱتَّخَذَ","взял он",19,78],["عِندَ","у",19,78],["ٱلرَّحۡمَٰنِ","Милостивого",19,78],["عَهۡدٗا","завет",19,78],[78],["كـَلَّاۚ","нет же",19,79]],[["سَنَكۡتُبُ","Мы запишем",19,79],["مَا","то, что",19,79],["يَقُولُ","он говорит",19,79],["وَنَمُدُّ","и продлим",19,79],["لَهُۥ","ему",19,79],["مِنَ","из",19,79],["ٱلۡعَذَابِ"