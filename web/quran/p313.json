{"p":313,"j":16,"a":[[20,13,["وَأَنَا","ٱخۡتَرۡتُكَ","فَٱسۡتَمِعۡ","لِمَا","يُوحَىٰٓ"],"ва'анахтартука фастами` лима йууха","Я избрал тебя, и посему прислушайся к тому, что внушается тебе в откровении.",["и Я","избрал тебя","так слушай","то, что","внушается"]],[20,14,["إِنَّنِيٓ","أَنَا","ٱللَّهُ","لَآ","إِلَٰهَ","إِلَّآ","أَنَا۠","فَٱعۡبُدۡنِي","وَأَقِمِ","ٱلصَّلَوٰةَ","لِذِكۡرِيٓ"],"иннании аналлаху ла илаха илла ана фа`буднии ва'аḳимис салавата лизикрии","Воистину, Я - Аллах! Нет божества, кроме Меня. Поклоняйся же Мне и совершай намаз, чтобы помнить обо Мне.",["поистине, Я","Я","Аллах","нет","божества","кроме","Меня","поклоняйся же Мне","и совершай","намаз","для поминания Меня"]],[20,15,["إِنَّ","ٱلسَّاعَةَ","ءَاتِيَةٌ","أَكَادُ","أُخۡفِيهَا","لِتُجۡزَىٰ","كُلُّ","نَفۡسِۭ","بِمَا","تَسۡعَىٰ"],"иннас са`ата атийатун акаду ухфииха литужза куллу нафси бима тас`а","Я едва ли не скрываю Час от Самого Себя, но он непременно настанет, чтобы каждому человеку воздали тем, к чему он стремился.",["поистине","Час","наступит","Я почти","скрываю его","чтобы было воздано","каждой","душе","за то, к чему","она стремится"]],[20,16,["فَلَا","يَصُدَّنَّكَ","عَنۡهَا","مَن","لَّا","يُؤۡمِنُ","بِهَا","وَٱتَّبَعَ","هَوَىٰهُ","فَتَرۡدَىٰ"],"фала йасудданнака `анха мал ла йу'мину биха ваттаба`а хаваху фатарда","Пусть не отворачивает тебя от него тот, кто не верует в него и потакает своим желаниям, а не то ты погибнешь.",["так пусть не","отвратит тебя","от него","тот, кто","не","верует","в него","и последовал","своей страсти","а не то ты погибнешь"]],[20,17,["وَمَا","تِلۡكَ","بِيَمِينِكَ","يَٰمُوسَىٰ"],"вама тилка бийамииника йамууса","Что это у тебя в правой руке, о Муса (Моисей)?».",["и что","это","в твоей правой руке","о Муса"]],[20,18,["قَالَ","هِيَ","عَصَايَ","أَتَوَكَّؤُاْ","عَلَيۡهَا","وَأَهُشُّ","بِهَا","عَلَىٰ","غَنَمِي","وَلِيَ","فِيهَا","مَـَٔارِبُ","أُخۡرَىٰ"],"ḳала хийа `асайа атаваккау `алайха ва'ахушшу биха `ала ганамии валийа фииха ма'арибу ухра","Муса (Моисей) сказал: «Это - мой посох. Я опираюсь на него и сбиваю им листья для моих овец (или отгоняю им моих овец). Я нахожу ему и другое применение».",["он сказал","это","мой посох","я опираюсь","на него","и сбиваю листья","им","для","моих овец","и у меня","в нём","нужды","другие"]],[20,19,["قَالَ","أَلۡقِهَا","يَٰمُوسَىٰ"],"ḳала алḳиха йамууса","Аллах сказал: «О Муса (Моисей)! Брось его».",["Он сказал","брось его","о Муса"]],[20,20,["فَأَلۡقَىٰهَا","فَإِذَا","هِيَ","حَيَّةٞ","تَسۡعَىٰ"],"фа'алḳаха фа'иза хийа хаййатун тас`а","Он бросил посох, и тот превратился в змею, которая быстро двигалась.",["и он бросил его","и вот","он","змея","ползущая быстро"]],[20,21,["قَالَ","خُذۡهَا","وَلَا","تَخَفۡۖ","سَنُعِيدُهَا","سِيرَتَهَا","ٱلۡأُولَىٰ"],"ḳала хузха вала тахаф сану`иидуха сииратахал уула","Аллах сказал: «Возьми ее и не бойся. Мы вернем ее в прежнее состояние.",["Он сказал","возьми её","и не","бойся","Мы вернём её","в состояние её","прежнее"]],[20,22,["وَٱضۡمُمۡ","يَدَكَ","إِلَىٰ","جَنَاحِكَ","تَخۡرُجۡ","بَيۡضَآءَ","مِنۡ","غَيۡرِ","سُوٓءٍ","ءَايَةً","أُخۡرَىٰ"],"вадмум йадака ила жанахика тахруж байдаа мин гайри сууин айатан ухра","Прижми свою руку к боку, и она выйдет белой (цвета молока, светящейся), без следов болезни. Вот тебе еще одно знамение!",["и прижми","свою руку","к","своему боку","выйдет она","белой","без","всякого","вреда","знамением","другим"]],[20,23,["لِنُرِيَكَ","مِنۡ","ءَايَٰتِنَا","ٱلۡكُبۡرَى"],"линурийака мин айатинал кубра","Мы покажем тебе некоторые из Наших величайших знамений.",["чтобы Мы показали тебе","из","Наших знамений","величайших"]],[20,24,["ٱذۡهَبۡ","إِلَىٰ","فِرۡعَوۡنَ","إِنَّهُۥ","طَغَىٰ"],"изхаб ила фир`ауна иннахуу тага","Ступай к Фараону, ибо он преступил границы дозволенного».",["ступай","к","Фараону","поистине, он","преступил"]],[20,25,["قَالَ","رَبِّ","ٱشۡرَحۡ","لِي","صَدۡرِي"],"ḳала раббишрах лии садрии","Муса (Моисей) сказал: «Господи! Раскрой для меня мою грудь!",["он сказал","Господи","раскрой","мне","мою грудь"]],[20,26,["وَيَسِّرۡ","لِيٓ","أَمۡرِي"],"вайассир лии амрии","Облегчи мою миссию!",["и облегчи","мне","моё дело"]],[20,27,["وَٱحۡلُلۡ","عُقۡدَةٗ","مِّن","لِّسَانِي"],"вахлул `уḳдатам мил лисании","Развяжи узел на моем языке,",["и развяжи","узел","с","моего языка"]],[20,28,["يَفۡقَهُواْ","قَوۡلِي"],"йафḳахуу ḳаулии","чтобы они могли понять мою речь.",["чтобы они поняли","мою речь"]],[20,29,["وَٱجۡعَل","لِّي","وَزِيرٗا","مِّنۡ","أَهۡلِي"],"важ`ал лии вазиирам мин ахлии","Назначь мне помощника из моей семьи -",["и назначь","мне","помощника","из","моей семьи"]],[20,30,["هَٰرُونَ","أَخِي"],"харууна ахии","брата моего Харуна (Аарона).",["Харуна","моего брата"]],[20,31,["ٱشۡدُدۡ","بِهِۦٓ","أَزۡرِي"],"ишдуд бихии азрии","Умножь благодаря ему силу мою",["укрепи","им","мою силу"]],[20,32,["وَأَشۡرِكۡهُ","فِيٓ","أَمۡرِي"],"ва'ашрикху фии амрии","и позволь ему разделить со мной мою миссию,",["и сделай его участником","в","моём деле"]],[20,33,["كَيۡ","نُسَبِّحَكَ","كَثِيرٗا"],"кай нусаббихака касиира","чтобы мы славили Тебя многократно",["чтобы","мы славили Тебя","много"]],[20,34,["وَنَذۡكُرَكَ","كَثِيرًا"],"ваназкурака касиира","и поминали Тебя многократно.",["и поминали Тебя","много"]],[20,35,["إِنَّكَ","كُنتَ","بِنَا","بَصِيرٗا"],"иннака кунта бина басиира","Воистину, Ты видишь нас».",["поистине, Ты","(всегда) был","нас","видящим"]],[20,36,["قَالَ","قَدۡ","أُوتِيتَ","سُؤۡلَكَ","يَٰمُوسَىٰ"],"ḳала ḳад уутиита су'лака йамууса","Аллах сказал: «О Муса (Моисей)! Ты уже получил то, что попросил.",["Он сказал","уже","дано тебе","твоё прошение","о Муса"]],[20,37,["وَلَقَدۡ","مَنَنَّا","عَلَيۡكَ","مَرَّةً","أُخۡرَىٰٓ"],"валаḳад мананна `алайка марратан ухра","Мы и прежде оказывали тебе милость,",["и уже","Мы оказали милость","тебе","раз","другой"]]],"m":[[["وَأَنَا","и Я",20,13],["ٱخۡتَرۡتُكَ","избрал тебя",20,13],["فَٱسۡتَمِعۡ","так слушай",20,13],["لِمَا","то, что",20,13],["يُوحَىٰٓ","внушается",20,13],[13],["إِنَّنِيٓ","поистине, Я",20,14],["أَنَا","Я",20,14],["ٱللَّهُ","Аллах",20,14],["لَآ","нет",20,14],["إ