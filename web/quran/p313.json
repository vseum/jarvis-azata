{"p":313,"j":16,"a":[[20,13,["وَأَنَا","ٱخۡتَرۡتُكَ","فَٱسۡتَمِعۡ","لِمَا","يُوحَىٰٓ"],"уа'анаа хтартука фастами` лимаа йуухаа","Я избрал тебя, и посему прислушайся к тому, что внушается тебе в откровении.",["и Я","избрал тебя","так слушай","то, что","внушается"]],[20,14,["إِنَّنِيٓ","أَنَا","ٱللَّهُ","لَآ","إِلَٰهَ","إِلَّآ","أَنَا۠","فَٱعۡبُدۡنِي","وَأَقِمِ","ٱلصَّلَوٰةَ","لِذِكۡرِيٓ"],"иннании анаа ллаху лаа илааха иллаа ана фа`буднии уа'акими ссалауаата лизикрии","Воистину, Я - Аллах! Нет божества, кроме Меня. Поклоняйся же Мне и совершай намаз, чтобы помнить обо Мне.",["поистине, Я","Я","Аллах","нет","божества","кроме","Меня","поклоняйся же Мне","и совершай","намаз","для поминания Меня"]],[20,15,["إِنَّ","ٱلسَّاعَةَ","ءَاتِيَةٌ","أَكَادُ","أُخۡفِيهَا","لِتُجۡزَىٰ","كُلُّ","نَفۡسِۭ","بِمَا","تَسۡعَىٰ"],"инна ссаа`ата аатийатун акааду ухфиихаа литуджзаа куллу нафси бимаа тас`аа","Я едва ли не скрываю Час от Самого Себя, но он непременно настанет, чтобы каждому человеку воздали тем, к чему он стремился.",["поистине","Час","наступит","Я почти","скрываю его","чтобы было воздано","каждой","душе","за то, к чему","она стремится"]],[20,16,["فَلَا","يَصُدَّنَّكَ","عَنۡهَا","مَن","لَّا","يُؤۡمِنُ","بِهَا","وَٱتَّبَعَ","هَوَىٰهُ","فَتَرۡدَىٰ"],"фалаа йасудданнака `анхаа мал лаа йу'мину бихаа уаттаба`а хауааху фатардаа","Пусть не отворачивает тебя от него тот, кто не верует в него и потакает своим желаниям, а не то ты погибнешь.",["так пусть не","отвратит тебя","от него","тот, кто","не","верует","в него","и последовал","своей страсти","а не то ты погибнешь"]],[20,17,["وَمَا","تِلۡكَ","بِيَمِينِكَ","يَٰمُوسَىٰ"],"уамаа тилка бийамииника йаамуусаа","Что это у тебя в правой руке, о Муса (Моисей)?».",["и что","это","в твоей правой руке","о Муса"]],[20,18,["قَالَ","هِيَ","عَصَايَ","أَتَوَكَّؤُاْ","عَلَيۡهَا","وَأَهُشُّ","بِهَا","عَلَىٰ","غَنَمِي","وَلِيَ","فِيهَا","مَـَٔارِبُ","أُخۡرَىٰ"],"каала хийа `асаайа атауакка'у `алайхаа уа'ахушшу бихаа `алаа ганамии уалийа фиихаа ма'аарибу ухраа","Муса (Моисей) сказал: «Это - мой посох. Я опираюсь на него и сбиваю им листья для моих овец (или отгоняю им моих овец). Я нахожу ему и другое применение».",["он сказал","это","мой посох","я опираюсь","на него","и сбиваю листья","им","для","моих овец","и у меня","в нём","нужды","другие"]],[20,19,["قَالَ","أَلۡقِهَا","يَٰمُوسَىٰ"],"каала алкихаа йаамуусаа","Аллах сказал: «О Муса (Моисей)! Брось его».",["Он сказал","брось его","о Муса"]],[20,20,["فَأَلۡقَىٰهَا","فَإِذَا","هِيَ","حَيَّةٞ","تَسۡعَىٰ"],"фа'алкаахаа фа'изаа хийа хаййатун тас`аа","Он бросил посох, и тот превратился в змею, которая быстро двигалась.",["и он бросил его","и вот","он","змея","ползущая быстро"]],[20,21,["قَالَ","خُذۡهَا","وَلَا","تَخَفۡۖ","سَنُعِيدُهَا","سِيرَتَهَا","ٱلۡأُولَىٰ"],"каала хузхаа уалаа тахаф сану`иидухаа сииратахаа л'уулаа","Аллах сказал: «Возьми ее и не бойся. Мы вернем ее в прежнее состояние.",["Он сказал","возьми её","и не","бойся","Мы вернём её","в состояние её","прежнее"]],[20,22,["وَٱضۡمُمۡ","يَدَكَ","إِلَىٰ","جَنَاحِكَ","تَخۡرُجۡ","بَيۡضَآءَ","مِنۡ","غَيۡرِ","سُوٓءٍ","ءَايَةً","أُخۡرَىٰ"],"уадмум йадака илаа джанаахика тахрудж байдаа'а мин гайри суу'ин аайатан ухраа","Прижми свою руку к боку, и она выйдет белой (цвета молока, светящейся), без следов болезни. Вот тебе еще одно знамение!",["и прижми","свою руку","к","своему боку","выйдет она","белой","без","всякого","вреда","знамением","другим"]],[20,23,["لِنُرِيَكَ","مِنۡ","ءَايَٰتِنَا","ٱلۡكُبۡرَى"],"линурийака мин аайаатинаа лкубра","Мы покажем тебе некоторые из Наших величайших знамений.",["чтобы Мы показали тебе","из","Наших знамений","величайших"]],[20,24,["ٱذۡهَبۡ","إِلَىٰ","فِرۡعَوۡنَ","إِنَّهُۥ","طَغَىٰ"],"изхаб илаа фир`ауна иннахуу тагаа","Ступай к Фараону, ибо он преступил границы дозволенного».",["ступай","к","Фараону","поистине, он","преступил"]],[20,25,["قَالَ","رَبِّ","ٱشۡرَحۡ","لِي","صَدۡرِي"],"каала рабби шрах лии садрии","Муса (Моисей) сказал: «Господи! Раскрой для меня мою грудь!",["он сказал","Господи","раскрой","мне","мою грудь"]],[20,26,["وَيَسِّرۡ","لِيٓ","أَمۡرِي"],"уайассир лии амрии","Облегчи мою миссию!",["и облегчи","мне","моё дело"]],[20,27,["وَٱحۡلُلۡ","عُقۡدَةٗ","مِّن","لِّسَانِي"],"уахлул `укдатам мил лисаании","Развяжи узел на моем языке,",["и развяжи","узел","с","моего языка"]],[20,28,["يَفۡقَهُواْ","قَوۡلِي"],"йафкахуу каулии","чтобы они могли понять мою речь.",["чтобы они поняли","мою речь"]],[20,29,["وَٱجۡعَل","لِّي","وَزِيرٗا","مِّنۡ","أَهۡلِي"],"уадж`ал ллии уазиирам мин ахлии","Назначь мне помощника из моей семьи -",["и назначь","мне","помощника","из","моей семьи"]],[20,30,["هَٰرُونَ","أَخِي"],"хаарууна ахии","брата моего Харуна (Аарона).",["Харуна","моего брата"]],[20,31,["ٱشۡدُدۡ","بِهِۦٓ","أَزۡرِي"],"ишдуд бихии азрии","Умножь благодаря ему силу мою",["укрепи","им","мою силу"]],[20,32,["وَأَشۡرِكۡهُ","فِيٓ","أَمۡرِي"],"уа'ашрикху фии амрии","и позволь ему разделить со мной мою миссию,",["и сделай его участником","в","моём деле"]],[20,33,["كَيۡ","نُسَبِّحَكَ","كَثِيرٗا"],"кай нусаббихака касиира","чтобы мы славили Тебя многократно",["чтобы","мы славили Тебя","много"]],[20,34,["وَنَذۡكُرَكَ","كَثِيرًا"],"уаназкурака касиира","и поминали Тебя многократно.",["и поминали Тебя","много"]],[20,35,["إِنَّكَ","كُنتَ","بِنَا","بَصِيرٗا"],"иннака кунта бинаа басиира","Воистину, Ты видишь нас».",["поистине, Ты","(всегда) был","нас","видящим"]],[20,36,["قَالَ","قَدۡ","أُوتِيتَ","سُؤۡلَكَ","يَٰمُوسَىٰ"],"каала кад уутиита су'лака йаамуусаа","Аллах сказал: «О Муса (Моисей)! Ты уже получил то, что попросил.",["Он сказал","уже","дано тебе","твоё прошение","о Муса"]],[20,37,["وَلَقَدۡ","مَنَنَّا","عَلَيۡكَ","مَرَّةً","أُخۡرَىٰٓ"],"уалакад мананнаа `алайка марратан ухраа","Мы и прежде оказывали тебе милость,",["и уже","Мы оказали милость","тебе","раз","другой"]]]}