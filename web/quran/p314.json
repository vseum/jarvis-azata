{"p":314,"j":16,"a":[[20,38,["إِذۡ","أَوۡحَيۡنَآ","إِلَىٰٓ","أُمِّكَ","مَا","يُوحَىٰٓ"],"из аухайна ила уммика ма йууха","когда внушили твоей матери откровение:",["когда","Мы внушили","(к)","твоей матери","то, что","внушается"]],[20,39,["أَنِ","ٱقۡذِفِيهِ","فِي","ٱلتَّابُوتِ","فَٱقۡذِفِيهِ","فِي","ٱلۡيَمِّ","فَلۡيُلۡقِهِ","ٱلۡيَمُّ","بِٱلسَّاحِلِ","يَأۡخُذۡهُ","عَدُوّٞ","لِّي","وَعَدُوّٞ","لَّهُۥۚ","وَأَلۡقَيۡتُ","عَلَيۡكَ","مَحَبَّةٗ","مِّنِّي","وَلِتُصۡنَعَ","عَلَىٰ","عَيۡنِيٓ"],"аниḳзифиихи фит табуути фаḳзифиихи фил йамми фалйулḳихил йамму биссахили йа'хузху `адуввул лии ва`адуввул лахуу ва'алḳайту `алайка махаббатам миннии валитусна`а `ала `айнии","«Положи его в сундук и пусти его по реке, и река выбросит его на берег. Его подберет Мой враг и его враг». Я одарил тебя Своей любовью, и тебя взрастили у Меня на Глазах.",["что","положи его","в","сундук","и брось его","в","реку","и пусть выбросит его","река","на берег","возьмёт его","враг","Мой","и враг","его","и Я возложил","на тебя","любовь","от Меня","и чтобы ты был взращён","перед","Моим оком"]],[20,40,["إِذۡ","تَمۡشِيٓ","أُخۡتُكَ","فَتَقُولُ","هَلۡ","أَدُلُّكُمۡ","عَلَىٰ","مَن","يَكۡفُلُهُۥۖ","فَرَجَعۡنَٰكَ","إِلَىٰٓ","أُمِّكَ","كَيۡ","تَقَرَّ","عَيۡنُهَا","وَلَا","تَحۡزَنَۚ","وَقَتَلۡتَ","نَفۡسٗا","فَنَجَّيۡنَٰكَ","مِنَ","ٱلۡغَمِّ","وَفَتَنَّٰكَ","فُتُونٗاۚ","فَلَبِثۡتَ","سِنِينَ","فِيٓ","أَهۡلِ","مَدۡيَنَ","ثُمَّ","جِئۡتَ","عَلَىٰ","قَدَرٖ","يَٰمُوسَىٰ"],"из тамшии ухтука фатаḳуулу хал адуллукум `ала ман йакфулухуу фаража`нака ила уммика кай таḳарра `айнуха вала тахзана ваḳаталта нафсан фанажжайнака минал гамми вафатаннака футуунан фалабиста синиина фии ахли мадйана сумма жи'та `ала ḳадарин йамууса","Твоя сестра пришла к семье Фараона и сказала: «Не указать ли вам на ту, которая будет заботиться о нем?». Мы вернули тебя к твоей матери, чтобы порадовался ее взор и чтобы она не горевала. Ты убил человека, и Мы спасли тебя от скорби и подвергли тебя тяжелому испытанию. О Муса (Моисей)! Ты пробыл многие годы среди жителей Мадьяна, а теперь вернулся в срок.",["вот","идёт","твоя сестра","и говорит","разве","указать вам","на","того, кто","вырастит его","и Мы вернули тебя","к","твоей матери","чтобы","успокоился","её глаз","и не","печалилась она","и ты убил","душу","и Мы спасли тебя","от","скорби","и испытали тебя","испытанием","и ты пробыл","годы","среди","жителей","Мадьяна","затем","ты пришёл","по","предопределению","о Муса"]],[20,41,["وَٱصۡطَنَعۡتُكَ","لِنَفۡسِي"],"вастана`тука линафсии","Я избрал тебя для Себя.",["и Я избрал тебя","для Себя"]],[20,42,["ٱذۡهَبۡ","أَنتَ","وَأَخُوكَ","بِـَٔايَٰتِي","وَلَا","تَنِيَا","فِي","ذِكۡرِي"],"изхаб анта ва'ахуука би'айатии вала танийа фии зикрии","Ступайте же вместе с твоим братом с Моими знамениями и не уставайте поминать Меня.",["ступай","ты","и твой брат","с Моими знамениями","и не","ослабевайте","в","поминании Меня"]],[20,43,["ٱذۡهَبَآ","إِلَىٰ","فِرۡعَوۡنَ","إِنَّهُۥ","طَغَىٰ"],"изхаба ила фир`ауна иннахуу тага","Ступайте к Фараону вдвоем, ибо он преступил границы дозволенного.",["ступайте оба","к","Фараону","поистине, он","преступил"]],[20,44,["فَقُولَا","لَهُۥ","قَوۡلٗا","لَّيِّنٗا","لَّعَلَّهُۥ","يَتَذَكَّرُ","أَوۡ","يَخۡشَىٰ"],"фаḳуула лахуу ḳаулал лаййинал ла`аллахуу йатазаккару ау йахша","Говорите с ним мягко, быть может, он прислушается к назиданию или устрашится».",["и скажите","ему","слово","мягкое","может быть, он","внемлет назиданию","или","устрашится"]],[20,45,["قَالَا","رَبَّنَآ","إِنَّنَا","نَخَافُ","أَن","يَفۡرُطَ","عَلَيۡنَآ","أَوۡ","أَن","يَطۡغَىٰ"],"ḳала раббана иннана нахафу ан йафрута `алайна ау ан йатга","Они сказали: «Господь наш! Мы боимся, что он поспешит наказать нас или преступит границы дозволенного».",["они сказали","Господь наш","поистине, мы","боимся","что","он поспешит (наказать)","нас","или","что","он преступит"]],[20,46,["قَالَ","لَا","تَخَافَآۖ","إِنَّنِي","مَعَكُمَآ","أَسۡمَعُ","وَأَرَىٰ"],"ḳала ла тахафа иннании ма`акума асма`у ва'ара","Аллах сказал: «Не бойтесь, ибо Я - с вами. Я слышу и вижу.",["Он сказал","не","бойтесь","поистине, Я","с вами обоими","Я слышу","и вижу"]],[20,47,["فَأۡتِيَاهُ","فَقُولَآ","إِنَّا","رَسُولَا","رَبِّكَ","فَأَرۡسِلۡ","مَعَنَا","بَنِيٓ","إِسۡرَٰٓءِيلَ","وَلَا","تُعَذِّبۡهُمۡۖ","قَدۡ","جِئۡنَٰكَ","بِـَٔايَةٖ","مِّن","رَّبِّكَۖ","وَٱلسَّلَٰمُ","عَلَىٰ","مَنِ","ٱتَّبَعَ","ٱلۡهُدَىٰٓ"],"фа'тийаху фаḳуула инна расуула раббика фа'арсил ма`ана бании исраиила вала ту`аззибхум ḳад жи'нака би'айатим мир раббика вассаламу `ала маниттаба`ал худа","Ступайте к нему вдвоем и скажите: «Мы - посланники твоего Господа. Отпусти с нами сынов Исраила (Израиля) и не причиняй им мучения. Мы явились к тебе со знамением от нашего Господа. Мир тому, кто последовал верному руководству!",["так придите к нему","и скажите","поистине, мы","посланники","твоего Господа","отпусти же","с нами","сынов","Исраила","и не","мучай их","уже","мы пришли к тебе","со знамением","от","твоего Господа","и мир","на","том, кто","последовал","руководству"]],[20,48,["إِنَّا","قَدۡ","أُوحِيَ","إِلَيۡنَآ","أَنَّ","ٱلۡعَذَابَ","عَلَىٰ","مَن","كَذَّبَ","وَتَوَلَّىٰ"],"инна ḳад уухийа илайна аннал `азаба `ала ман каззаба ватавалла","Мы получили откровение о том, что мучениям подвергнется всякий, кто счел истину ложью и отвернулся».",["поистине, мы","уже","было внушено","нам","что","наказание","на","том, кто","счёл ложью","и отвернулся"]],[20,49,["قَالَ","فَمَن","رَّبُّكُمَا","يَٰمُوسَىٰ"],"ḳала фамар раббукума йамууса","Фараон сказал: «Кто же ваш Господь, о Муса (Моисей)?».",["он сказал","кто же","Господь ваш","о Муса"]],[20,50,["قَالَ","رَبُّنَا","ٱلَّذِيٓ","أَعۡطَىٰ","كُلَّ","شَيۡءٍ","خَلۡقَهُۥ","ثُمَّ","هَدَىٰ"],"ḳала раббунал лазии а`та кулла шай'ин халḳахуу сумма хада","Муса (Моисей) ответил: «Господь наш - Тот, Кто придал облик всякой вещи, а затем указал всему путь».",["он сказал","Господь наш","Тот, Кто","дал","каждой","вещи","её облик","затем","указал путь"]],[20,51,["قَالَ","فَمَا","بَالُ","ٱلۡقُرُونِ","ٱلۡأُولَىٰ"],"ḳала фама балул ḳуруунил уула","Фараон сказал: «А что будет с первыми поколениями?».",["он сказал","а каково","положение","поколений","прежних"]]],"m":[[["إِذۡ","когда",20,38],["أَوۡحَيۡنَآ","Мы внушили",20,38],["إِلَىٰٓ","(к)",20,38],["أُمِّكَ","твоей матери",20,38],["مَا","то, что",20,38],["يُوحَىٰٓ","внушается",20,38],[38],["أَنِ","что",20,39],["ٱقۡذِفِيهِ","положи его",20,39],["فِي","в",20,39],["ٱلتَّابُوتِ","сундук",20,39],["فَٱقۡذِفِيهِ","и брось его",20,39]],[["فِي","в",20,39],["ٱلۡيَمِّ","реку",20,39],["فَلۡيُلۡقِهِ","и пусть выбросит его",20,39],["ٱلۡيَمُّ","река",20,39],["بِٱلسَّاحِلِ","на берег",20,39],["يَأۡخُذۡهُ","возьмёт его",20,39],["عَدُوّٞ","враг",20,39],["لِّي","Мой",20,39],["وَعَدُوّٞ","и враг",20,39],["لَّهُۥۚ","его",20,39],["وَأَلۡقَيۡتُ","и Я возложил",20,39]],[["عَلَيۡكَ","на тебя",20,39],["مَحَبَّةٗ","любовь",20,39],["مِّنِّي","от Меня",20,39],["وَلِتُصۡنَعَ","и чтобы ты был взращён",20,39],["عَلَىٰ","перед",20,39],["عَيۡنِيٓ","Моим оком",20,39],[39],["إِذۡ","вот",20,40],["تَمۡشِيٓ","идёт",20,40],["أُخۡتُكَ","твоя сестра",20,40]],[["فَتَقُولُ","и говорит",20,40],["هَلۡ","разве",20,40],["أَدُلُّكُمۡ","указать вам",20,40],["عَلَىٰ","на",20,40],["مَن","того, кто",20,40],["يَكۡفُلُهُۥۖ","вырастит его",20,40],["فَرَجَعۡنَٰكَ","и Мы вернули тебя",20,40],["إِلَىٰٓ","к",20,40],["أُمِّكَ","твоей матери",20,40],["كَيۡ","чтобы",20,40],["تَقَرَّ","успокоился",20,40]],[["عَيۡنُهَا","её глаз",20,40],["وَلَا","и не",20,40],["تَحۡزَنَۚ","печалилась она",20,40],["وَقَتَلۡتَ","и ты убил",20,40],["نَفۡسٗا","душу",20,40],["فَنَجَّيۡنَٰكَ","и Мы спасли тебя",20,40],["مِنَ","от",20,40],["ٱلۡغَمِّ","скорби",20,40],["وَفَتَنَّٰكَ","и испытали тебя",20,40],["فُتُونٗاۚ","испытанием",20,40]],[["فَلَبِثۡتَ","и ты пробыл",20,40],["سِنِينَ","годы",20,40],["فِيٓ","среди",20,40],["أَهۡلِ","жителей",20,40],["مَدۡيَنَ","Мадьяна",20,40],["ثُمَّ","затем",20,40],["جِئۡتَ","ты пришёл",20,40],["عَلَىٰ","по",20,40],["قَدَرٖ","предопределению",20,40],["يَٰمُوسَىٰ","о Муса",20,40],[40]],[["وَٱصۡطَنَعۡتُكَ","и Я избрал тебя",20,41