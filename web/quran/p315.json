{"p":315,"j":16,"a":[[20,52,["قَالَ","عِلۡمُهَا","عِندَ","رَبِّي","فِي","كِتَٰبٖۖ","لَّا","يَضِلُّ","رَبِّي","وَلَا","يَنسَى"],"ḳала `илмуха `инда раббии фии китабил ла йадиллу раббии вала йанса","Муса (Моисей) ответил: «Знание об этом - у моего Господа в Писании. Мой Господь не ошибается и не забывает».",["он сказал","знание о них","у","моего Господа","в","Писании","не","ошибается","мой Господь","и не","забывает"]],[20,53,["ٱلَّذِي","جَعَلَ","لَكُمُ","ٱلۡأَرۡضَ","مَهۡدٗا","وَسَلَكَ","لَكُمۡ","فِيهَا","سُبُلٗا","وَأَنزَلَ","مِنَ","ٱلسَّمَآءِ","مَآءٗ","فَأَخۡرَجۡنَا","بِهِۦٓ","أَزۡوَٰجٗا","مِّن","نَّبَاتٖ","شَتَّىٰ"],"аллазии жа`ала лакумул арда махдан васалака лакум фииха субулан ва'анзала минас самаи маан фа'ахражна бихии азважам мин набатин шатта","Он сделал землю для вас колыбелью, проложил для вас на ней дороги и низвел с неба воду. Благодаря ей Мы взрастили различные растения.",["Тот, Кто","сделал","для вас","землю","колыбелью","и проложил","для вас","на ней","пути","и низвёл","с","неба","воду","и Мы вывели","ею","пары","из","растений","различных"]],[20,54,["كُلُواْ","وَٱرۡعَوۡاْ","أَنۡعَٰمَكُمۡۚ","إِنَّ","فِي","ذَٰلِكَ","لَأٓيَٰتٖ","لِّأُوْلِي","ٱلنُّهَىٰ"],"кулуу вар`ау ан`амакум инна фии залика ла'айатил ли'улин нуха","Вкушайте сами и пасите свой скот. Воистину, в этом - знамения для обладающих разумом.",["Ешьте","и пасите","ваш скот","поистине","в","этом","непременно знамения","для обладающих","разумом"]],[20,55,["مِنۡهَا","خَلَقۡنَٰكُمۡ","وَفِيهَا","نُعِيدُكُمۡ","وَمِنۡهَا","نُخۡرِجُكُمۡ","تَارَةً","أُخۡرَىٰ"],"минха халаḳнакум вафииха ну`иидукум ваминха нухрижукум таратан ухра","Мы сотворили вас из нее (земли), в нее Мы вас вернем и из нее выведем еще раз.",["Из неё","Мы сотворили вас","и в неё","Мы вернём вас","и из неё","Мы выведем вас","раз","другой"]],[20,56,["وَلَقَدۡ","أَرَيۡنَٰهُ","ءَايَٰتِنَا","كُلَّهَا","فَكَذَّبَ","وَأَبَىٰ"],"валаḳад арайнаху айатина куллаха факаззаба ва'аба","Мы явили ему (Фараону) всевозможные Наши знамения, но он счел их ложью и отказался.",["И уже","Мы показали ему","Наши знамения","все их","но он счёл ложью","и отказался"]],[20,57,["قَالَ","أَجِئۡتَنَا","لِتُخۡرِجَنَا","مِنۡ","أَرۡضِنَا","بِسِحۡرِكَ","يَٰمُوسَىٰ"],"ḳала ажи'тана литухрижана мин ардина бисихрика йамууса","Он сказал: «О Муса (Моисей)! Неужели ты явился к нам, чтобы изгнать нас из нашей земли своим колдовством?",["Он сказал","неужели ты пришёл к нам","чтобы изгнать нас","из","нашей земли","твоим колдовством","о Муса"]],[20,58,["فَلَنَأۡتِيَنَّكَ","بِسِحۡرٖ","مِّثۡلِهِۦ","فَٱجۡعَلۡ","بَيۡنَنَا","وَبَيۡنَكَ","مَوۡعِدٗا","لَّا","نُخۡلِفُهُۥ","نَحۡنُ","وَلَآ","أَنتَ","مَكَانٗا","سُوٗى"],"фалана'тийаннака бисихрим мислихии фаж`ал байнана вабайнака мау`идал ла нухлифухуу нахну вала анта маканан суа","Мы непременно покажем тебе такое же колдовство. Назначь же срок для нашей встречи на открытом месте, где мы будем иметь равные шансы, и никто из нас не должен нарушить его».",["то мы непременно придём к тебе","с колдовством","подобным ему","так назначь","между нами","и между тобой","встречу","не","нарушим её","мы","и не","ты","в месте","равном"]],[20,59,["قَالَ","مَوۡعِدُكُمۡ","يَوۡمُ","ٱلزِّينَةِ","وَأَن","يُحۡشَرَ","ٱلنَّاسُ","ضُحٗى"],"ḳала мау`идукум йаумуз зиинати ва'ан йухшаран насу духа","Муса сказал: «Сроком для вас будет день украшения, и пусть люди соберутся утром».",["Он сказал","ваша встреча","в день","праздника","и чтобы","были собраны","люди","утром"]],[20,60,["فَتَوَلَّىٰ","فِرۡعَوۡنُ","فَجَمَعَ","كَيۡدَهُۥ","ثُمَّ","أَتَىٰ"],"фатавалла фир`ауну фажама`а кайдахуу сумма ата","Фараон отвернулся и собрал свои козни (собрал своих колдунов), а затем пришел в назначенный срок.",["И отвернулся","Фараон","и собрал","свои козни","затем","пришёл"]],[20,61,["قَالَ","لَهُم","مُّوسَىٰ","وَيۡلَكُمۡ","لَا","تَفۡتَرُواْ","عَلَى","ٱللَّهِ","كَذِبٗا","فَيُسۡحِتَكُم","بِعَذَابٖۖ","وَقَدۡ","خَابَ","مَنِ","ٱفۡتَرَىٰ"],"ḳала лахум мууса вайлакум ла тафтаруу `алаллахи казибан файусхитакум би`азабин ваḳад хаба манифтара","Муса (Моисей) сказал им: «Горе вам! Не возводите навет на Аллаха, а не то Он уничтожит вас, подвергнув мучениям. Неудача постигнет того, кто измышляет ложь».",["Сказал","им","Муса","горе вам","не","измышляйте","на","Аллаха","ложь","а то Он истребит вас","наказанием","и уже","потерпел неудачу","кто","измыслил"]],[20,62,["فَتَنَٰزَعُوٓاْ","أَمۡرَهُم","بَيۡنَهُمۡ","وَأَسَرُّواْ","ٱلنَّجۡوَىٰ"],"фатаназа`уу амрахум байнахум ва'асаррун нажва","Они стали спорить между собой о своих действиях и сохранили свой разговор в тайне.",["И они заспорили","о своём деле","между собой","и скрыли","тайную беседу"]],[20,63,["قَالُوٓاْ","إِنۡ","هَٰذَٰنِ","لَسَٰحِرَٰنِ","يُرِيدَانِ","أَن","يُخۡرِجَاكُم","مِّنۡ","أَرۡضِكُم","بِسِحۡرِهِمَا","وَيَذۡهَبَا","بِطَرِيقَتِكُمُ","ٱلۡمُثۡلَىٰ"],"ḳалуу ин хазани ласахирани йуриидани ан йухрижакум мин ардикум бисихрихима вайазхаба битарииḳатикумул мусла","Они сказали: «Эти двое мужчин - колдуны. Они хотят колдовством изгнать вас из вашей страны и вдвоем следовать вашим превосходным путем.",["Они сказали","поистине","эти двое","непременно колдуны","они хотят","чтобы","изгнать вас","из","вашей земли","своим колдовством","и устранить","ваш путь","наилучший"]],[20,64,["فَأَجۡمِعُواْ","كَيۡدَكُمۡ","ثُمَّ","ٱئۡتُواْ","صَفّٗاۚ","وَقَدۡ","أَفۡلَحَ","ٱلۡيَوۡمَ","مَنِ","ٱسۡتَعۡلَىٰ"],"фа'ажми`уу кайдакум сумматуу саффан ваḳад афлахал йаума маниста`ла","Объедините ваши козни и выстройтесь в ряд. Сегодня преуспеет тот, кто одержит верх».",["Так соберите","ваши козни","затем","придите","рядом","и уже","преуспел","сегодня","кто","одержал верх"]]],"m":[[["قَالَ","он сказал",20,52],["عِلۡمُهَا","знание о них",20,52],["عِندَ","у",20,52],["رَبِّي","моего Господа",20,52],["فِي","в",20,52],["كِتَٰبٖۖ","Писании",20,52],["لَّا","не",20,52],["يَضِلُّ","ошибается",20,52],["رَبِّي","мой Господь",20,52],["وَلَا","и не",20,52],["يَنسَى","забывает",20,52],[52]],[["ٱلَّذِي","Тот, Кто",20,53],["جَعَلَ","сделал",20,53],["لَكُمُ","для вас",20,53],["ٱلۡأَرۡضَ","землю",20,53],["مَهۡدٗا","колыбелью",20,53],["وَسَلَكَ","и проложил",20,53],["لَكُمۡ","для вас",20,53],["فِيهَا","на ней",20,53],["سُبُلٗا","пути",20,53],["وَأَنزَلَ","и низвёл",20,53]],[["مِنَ","с",20,53],["ٱلسَّمَآءِ","неба",20,53],["مَآءٗ","воду",20,53],["فَأَخۡرَجۡنَا","и Мы вывели",20,53],["بِهِۦٓ","ею",20,53],["أَزۡوَٰجٗا","пары",20,53],["مِّن","из",20,53],["نَّبَاتٖ","растений",20,53],["شَتَّىٰ","различных",20,53],[53],["كُلُواْ","Ешьте",20,54]],[["وَٱرۡعَوۡاْ","и пасите",20,54],["أَنۡعَٰمَكُمۡۚ","ваш скот",20,54],["إِنَّ","поистине",20,54],["فِي","в",20,54],["ذَٰلِكَ","этом",20,54],["لَأٓيَٰتٖ","непременно знамения",20,54],["لِّأُوْلِي","для обладающих",20,54],["ٱلنُّهَىٰ","разумом",20,54],[54],["۞ مِنۡهَا","Из неё",20,55]],[["خَلَقۡنَٰكُمۡ","Мы сотворили вас",20,55],["وَفِيهَا","и в неё",20,55],["نُعِيدُكُمۡ","Мы вернём вас",20,55],["وَمِنۡهَا","и из неё",20,55],["نُخۡرِجُكُمۡ","Мы выведем вас",20,55],["تَارَةً","раз",20,55],["أُخۡرَىٰ","другой",20,55],[55],["وَلَقَدۡ","И уже",20,56]],[["أَرَيۡنَٰهُ","Мы показали ему",20,56],["ءَايَٰتِنَا","Наши знамения",20,56],["كُلَّهَا","все их",20,56],["فَكَذَّبَ","но он счёл ложью",20,56],["وَأَبَىٰ","и отказался",20,56],[56],["قَالَ","Он сказал",20,57],["أَجِئۡتَنَا","неужели ты пришёл к нам",20,57],["لِتُخۡرِجَنَا","чтобы изгнать нас",20,57]],[["مِنۡ","из",20,57],["أَرۡضِنَا","нашей земли",20,57],["بِسِحۡرِكَ","твоим колдовством",20,57],["يَٰمُوسَىٰ","о Муса",20,57],[57],["فَلَنَأۡتِيَنَّكَ","то мы непременно придём к тебе",20,58],["بِسِحۡرٖ","с колдовством",20,58],["مِّثۡلِهِۦ","подобным ему",20,58]],[["فَٱجۡعَلۡ","так назначь",20,58],["بَيۡنَنَا","между нами",20,58],["وَبَيۡنَكَ","и между тобой",20,58],["مَوۡعِدٗا","встречу",20,58],["لَّا","не",20,58],["نُخۡلِفُهُۥ","нарушим её",20,58],["نَحۡنُ","мы",20,58],["وَلَآ","и не",20,58],["أَنتَ","ты",20,58],["مَكَانٗا","в месте",20,58]],[["سُوٗى","равном",20,58],[58],["قَالَ","Он сказал",20,59],["مَوۡعِدُكُمۡ","ваша встреча",20,59],["يَوۡمُ","в день",20,59],["ٱلزِّينَةِ","праздника",20,59],["وَأَن","и чтобы",20,59],["يُحۡشَرَ","были собраны",20,59],["ٱلنَّاسُ","люди",20,59],["ضُحٗى","утром",20,59]],[[59],["فَتَوَلَّىٰ","И отвернулся",20,60],["فِرۡعَوۡنُ","Фараон",20,60],["فَجَمَعَ","и собрал",20,60],["كَيۡدَهُۥ","свои козни",20,60],["ثُمَّ","затем",20,60],["أَتَىٰ","пришёл",20,60],[60],["قَالَ","Сказал",20,61],["لَهُم","им",20,61]],[["مُّوسَىٰ","Муса",20,61],["وَيۡلَكُمۡ","горе вам",20,61],["لَا","не",20,61],["تَفۡتَرُواْ","измышляйте",20,61],["عَلَى","на",20,61],["ٱللَّهِ","Аллаха",20,61],["كَذِبٗا","ложь",20,61],["فَيُسۡحِتَكُم","а то Он истребит вас",20,61],["بِعَذَابٖۖ","наказанием",20,61]],[["وَقَدۡ","и уже",20,61],["خَابَ","потерпел неудачу",20,61],["مَنِ","кто",20,61],["ٱفۡتَرَىٰ","измыслил",20,61],[61],["فَتَنَٰزَعُوٓاْ","И они заспорили",20,62],["أَمۡرَهُم","о своём деле",20,62],["بَيۡنَهُمۡ","между собой",20,62],["وَأَسَرُّواْ","и скрыли",20,62]],[["ٱلنَّجۡوَىٰ","тайную беседу",20,62],[62],["قَالُوٓاْ","Они сказали",20,63],["إِنۡ","поистине",20,63],["هَٰذَٰنِ","эти двое",20,63],["لَسَٰحِرَٰنِ","непременно колдуны",20,63],["يُرِيدَانِ","они хотят",20,63],["أَن","чтобы",20,63],["يُخۡرِجَاكُم","изгнать вас",20,63]],[["مِّنۡ","из",20,63],["أَرۡضِكُم","вашей земли",20,63],["بِسِحۡرِهِمَا","своим колдовством",20,63],["وَيَذۡهَبَا","и устранить",20,63],["بِطَرِيقَتِكُمُ","ваш путь",20,63],["ٱلۡمُثۡلَىٰ","наилучший",20,63],[63],["فَأَجۡمِعُواْ","Так соберите",20,64]],[["كَيۡدَكُمۡ","ваши козни",20,64],["ثُمَّ","затем",20,64],["ٱئۡتُواْ","придите",20,64],["صَفّٗاۚ","рядом",20,64],["وَقَدۡ","и уже",20,64],["أَفۡلَحَ","преуспел",20,64],["ٱلۡيَوۡمَ","сегодня",20,64],["مَنِ","кто",20,64],["ٱسۡتَعۡلَىٰ","одержал верх",20,64],[64]]]}