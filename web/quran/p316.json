{"p":316,"j":16,"a":[[20,65,["قَالُواْ","يَٰمُوسَىٰٓ","إِمَّآ","أَن","تُلۡقِيَ","وَإِمَّآ","أَن","نَّكُونَ","أَوَّلَ","مَنۡ","أَلۡقَىٰ"],"ḳалуу йамууса имма ан тулḳийа ва'имма ан накууна аввала ман алḳа","Они сказали: «О Муса (Моисей)! Ты бросишь первым, или же нам бросать первыми?».",["Они сказали","о Муса","либо","что","ты бросишь","либо","что","мы будем","первыми","кто","бросил"]],[20,66,["قَالَ","بَلۡ","أَلۡقُواْۖ","فَإِذَا","حِبَالُهُمۡ","وَعِصِيُّهُمۡ","يُخَيَّلُ","إِلَيۡهِ","مِن","سِحۡرِهِمۡ","أَنَّهَا","تَسۡعَىٰ"],"ḳала бал алḳуу фа'иза хибалухум ва`исиййухум йухаййалу илайхи мин сихрихим аннаха тас`а","Он сказал: «Нет, бросайте вы!». И тут ему представилось, что их веревки и посохи от их колдовства пришли в движение.",["Он сказал","нет","бросайте","и вот","их верёвки","и их посохи","представилось","ему","от","их колдовства","что они","движутся"]],[20,67,["فَأَوۡجَسَ","فِي","نَفۡسِهِۦ","خِيفَةٗ","مُّوسَىٰ"],"фа'аужаса фии нафсихии хиифатам мууса","Тогда он почувствовал в душе страх.",["И ощутил","в","своей душе","страх","Муса"]],[20,68,["قُلۡنَا","لَا","تَخَفۡ","إِنَّكَ","أَنتَ","ٱلۡأَعۡلَىٰ"],"ḳулна ла тахаф иннака антал а`ла","Мы сказали: «Не бойся! Ты одержишь верх.",["Мы сказали","не","бойся","поистине ты","ты","высший"]],[20,69,["وَأَلۡقِ","مَا","فِي","يَمِينِكَ","تَلۡقَفۡ","مَا","صَنَعُوٓاْۖ","إِنَّمَا","صَنَعُواْ","كَيۡدُ","سَٰحِرٖۖ","وَلَا","يُفۡلِحُ","ٱلسَّاحِرُ","حَيۡثُ","أَتَىٰ"],"ва'алḳи ма фии йамииника талḳаф ма сана`уу иннама сана`уу кайду сахирин вала йуфлихус сахиру хайсу ата","Брось то, что держишь в своей деснице, и оно проглотит содеянное ими. Воистину, содеянное ими - это козни колдуна, а колдун не преуспеет, куда бы он ни пришел».",["И брось","то, что","в","твоей правой руке","оно поглотит","то, что","они сделали","лишь","они сделали","козни","колдуна","и не","преуспеет","колдун","где бы","он ни пришёл"]],[20,70,["فَأُلۡقِيَ","ٱلسَّحَرَةُ","سُجَّدٗا","قَالُوٓاْ","ءَامَنَّا","بِرَبِّ","هَٰرُونَ","وَمُوسَىٰ"],"фа'улḳийас сахарату сужжадан ḳалуу аманна бирабби харууна вамууса","Колдуны пали ниц и сказали: «Мы уверовали в Господа Харуна (Аарона) и Мусы (Моисея)!».",["И были повергнуты","колдуны","падающими ниц","они сказали","мы уверовали","в Господа","Харуна","и Мусы"]],[20,71,["قَالَ","ءَامَنتُمۡ","لَهُۥ","قَبۡلَ","أَنۡ","ءَاذَنَ","لَكُمۡۖ","إِنَّهُۥ","لَكَبِيرُكُمُ","ٱلَّذِي","عَلَّمَكُمُ","ٱلسِّحۡرَۖ","فَلَأُقَطِّعَنَّ","أَيۡدِيَكُمۡ","وَأَرۡجُلَكُم","مِّنۡ","خِلَٰفٖ","وَلَأُصَلِّبَنَّكُمۡ","فِي","جُذُوعِ","ٱلنَّخۡلِ","وَلَتَعۡلَمُنَّ","أَيُّنَآ","أَشَدُّ","عَذَابٗا","وَأَبۡقَىٰ"],"ḳала амантум лахуу ḳабла ан азана лакум иннахуу лакабиирукумул лазии `алламакумус сихра фалауḳатти`анна айдийакум ва'аржулакум мин хилафин валаусаллибаннакум фии жузуу`ин нахли валата`ламунна аййуна ашадду `азабан ва'абḳа","Фараон сказал: «Неужели вы поверили ему без моего соизволения? Воистину, он - старший из вас, который научил вас колдовству. Я отрублю вам руки и ноги накрест и распну вас на пальмовых стволах. Вот тогда вы узнаете, чье наказание суровее и долговечнее».",["Он сказал","вы уверовали","ему","прежде","чем","я позволю","вам","поистине он","непременно ваш старший","который","научил вас","колдовству","так непременно я отрублю","ваши руки","и ваши ноги","с","противоположных сторон","и непременно распну вас","на","стволах","пальм","и непременно узнаете","кто из нас","суровее","наказанием","и долговечнее"]],[20,72,["قَالُواْ","لَن","نُّؤۡثِرَكَ","عَلَىٰ","مَا","جَآءَنَا","مِنَ","ٱلۡبَيِّنَٰتِ","وَٱلَّذِي","فَطَرَنَاۖ","فَٱقۡضِ","مَآ","أَنتَ","قَاضٍۖ","إِنَّمَا","تَقۡضِي","هَٰذِهِ","ٱلۡحَيَوٰةَ","ٱلدُّنۡيَآ"],"ḳалуу лан ну'сирака `ала ма жаана минал баййинати валлазии фатарана фаḳди ма анта ḳадин иннама таḳдии хазихил хайаватад дунйа","Они сказали: «Мы не отдадим тебе предпочтения перед ясными знамениями, которые явились нам, и перед нашим Творцом. Выноси же свой приговор! Воистину, ты выносишь приговор только в мирской жизни.",["Они сказали","никогда не","мы предпочтём тебя","перед","тем, что","пришло к нам","из","ясных знамений","и Тем, Кто","сотворил нас","так решай","что","ты","решаешь","лишь","ты решаешь","эту","жизнь","ближнюю"]],[20,73,["إِنَّآ","ءَامَنَّا","بِرَبِّنَا","لِيَغۡفِرَ","لَنَا","خَطَٰيَٰنَا","وَمَآ","أَكۡرَهۡتَنَا","عَلَيۡهِ","مِنَ","ٱلسِّحۡرِۗ","وَٱللَّهُ","خَيۡرٞ","وَأَبۡقَىٰٓ"],"инна аманна бираббина лийагфира лана хатайана вама акрахтана `алайхи минас сихри валлаху хайрун ва'абḳа","Воистину, мы уверовали в нашего Господа для того, чтобы Он простил нам наши грехи и колдовство, к которому ты нас принудил. Аллах лучше и долговечнее».",["Поистине, мы","уверовали","в нашего Господа","чтобы Он простил","нам","наши прегрешения","и то, что","ты принудил нас","к нему","из","колдовства","а Аллах","лучше","и долговечнее"]],[20,74,["إِنَّهُۥ","مَن","يَأۡتِ","رَبَّهُۥ","مُجۡرِمٗا","فَإِنَّ","لَهُۥ","جَهَنَّمَ","لَا","يَمُوتُ","فِيهَا","وَلَا","يَحۡيَىٰ"],"иннахуу ман йа'ти раббахуу мужриман фа'инна лахуу жаханнама ла йамууту фииха вала йахйа","Тому, кто явится к своему Господу, будучи грешником, уготована Геенна, в которой он не умрет и не будет жить.",["Поистине","кто","придёт","к своему Господу","грешником","то поистине","ему","Геенна","не","он умрёт","в ней","и не","будет жить"]],[20,75,["وَمَن","يَأۡتِهِۦ","مُؤۡمِنٗا","قَدۡ","عَمِلَ","ٱلصَّٰلِحَٰتِ","فَأُوْلَٰٓئِكَ","لَهُمُ","ٱلدَّرَجَٰتُ","ٱلۡعُلَىٰ"],"ваман йа'тихии му'минан ḳад `амилас салихати фа'улаика лахумуд даражатул `ула","А тем, кто явится к Нему, будучи верующим, совершив праведные деяния, уготованы высшие ступени -",["А кто","придёт к Нему","верующим","уже","совершив","праведные дела","то те","им","ступени","высшие"]],[20,76,["جَنَّٰتُ","عَدۡنٖ","تَجۡرِي","مِن","تَحۡتِهَا","ٱلۡأَنۡهَٰرُ","خَٰلِدِينَ","فِيهَاۚ","وَذَٰلِكَ","جَزَآءُ","مَن","تَزَكَّىٰ"],"жаннату `аднин тажрии мин тахтихал анхару халидиина фииха вазалика жазау ман тазакка","сады Эдема, в которых текут реки. Они пребудут там вечно. Таково воздаяние тем, кто очистился.",["Сады","Эдема","текут","от","под ними","реки","вечно пр