{"p":319,"j":16,"a":[[20,99,["كَذَٰلِكَ","نَقُصُّ","عَلَيۡكَ","مِنۡ","أَنۢبَآءِ","مَا","قَدۡ","سَبَقَۚ","وَقَدۡ","ءَاتَيۡنَٰكَ","مِن","لَّدُنَّا","ذِكۡرٗا"],"казалика наḳуссу `алайка мин амбаи ма ḳад сабаḳа ваḳад атайнака мил ладунна зикра","Вот так Мы рассказываем тебе вести о том, что было в прошлом. Мы уже даровали тебе Напоминание.",["Так","Мы рассказываем","тебе","из","вестей","о том, что","уже","прошло","и уже","Мы даровали тебе","от","Нас","Напоминание"]],[20,100,["مَّنۡ","أَعۡرَضَ","عَنۡهُ","فَإِنَّهُۥ","يَحۡمِلُ","يَوۡمَ","ٱلۡقِيَٰمَةِ","وِزۡرًا"],"мман а`рада `анху фа'иннахуу йахмилу йаумал ḳийамати визра","Кто отвернется от него (Корана), тот понесет в День воскресения тяжелую ношу.",["Кто","отвернётся","от него","то поистине, он","понесёт","в день","воскресения","ношу"]],[20,101,["خَٰلِدِينَ","فِيهِۖ","وَسَآءَ","لَهُمۡ","يَوۡمَ","ٱلۡقِيَٰمَةِ","حِمۡلٗا"],"халидиина фиихи васаа лахум йаумал ḳийамати химла","Они пребудут в таком состоянии вечно. Скверна будет их ноша в День воскресения!",["Вечно пребывая","в нём","и скверна","им","в день","воскресения","ноша"]],[20,102,["يَوۡمَ","يُنفَخُ","فِي","ٱلصُّورِۚ","وَنَحۡشُرُ","ٱلۡمُجۡرِمِينَ","يَوۡمَئِذٖ","زُرۡقٗا"],"йаума йунфаху фис суури ванахшурул мужримиина йаумаизин зурḳа","В тот день подуют в Рог, и в тот день Мы соберем грешников синими (синеглазыми).",["В день","подуют","в","Рог","и Мы соберём","грешников","в тот день","синеглазыми"]],[20,103,["يَتَخَٰفَتُونَ","بَيۡنَهُمۡ","إِن","لَّبِثۡتُمۡ","إِلَّا","عَشۡرٗا"],"йатахафатууна байнахум ил лабистум илла `ашра","Они будут переговариваться шепотом: «Вы пробыли там (в мирской жизни) всего десять дней!».",["Они перешёптываются","между собой","не","вы пробыли","кроме","десяти"]],[20,104,["نَّحۡنُ","أَعۡلَمُ","بِمَا","يَقُولُونَ","إِذۡ","يَقُولُ","أَمۡثَلُهُمۡ","طَرِيقَةً","إِن","لَّبِثۡتُمۡ","إِلَّا","يَوۡمٗا"],"ннахну а`ламу бима йаḳуулууна из йаḳуулу амсалухум тарииḳатан ил лабистум илла йаума","Нам лучше знать, о чем они будут говорить. Самый примерный из них скажет: «Вы пробыли там (в мирской жизни) всего один день».",["Мы","лучше знаем","то, что","они говорят","когда","скажет","лучший из них","путём","не","вы пробыли","кроме","дня"]],[20,105,["وَيَسۡـَٔلُونَكَ","عَنِ","ٱلۡجِبَالِ","فَقُلۡ","يَنسِفُهَا","رَبِّي","نَسۡفٗا"],"вайас'алуунака `анил жибали фаḳул йансифуха раббии насфа","Они спрашивают тебя о горах. Скажи: «Мой Господь развеет их",["И они спрашивают тебя","о","горах","так скажи","развеет их","мой Господь","развеянием"]],[20,106,["فَيَذَرُهَا","قَاعٗا","صَفۡصَفٗا"],"файазаруха ḳа`ан сафсафа","и оставит только гладкую равнину.",["И Он оставит их","гладкой","равниной"]],[20,107,["لَّا","تَرَىٰ","فِيهَا","عِوَجٗا","وَلَآ","أَمۡتٗا"],"лла тара фииха `иважан вала амта","Не увидишь ты на ней ни углубления, ни возвышения».",["Не","увидишь","на ней","кривизны","и не","возвышенности"]],[20,108,["يَوۡمَئِذٖ","يَتَّبِعُونَ","ٱلدَّاعِيَ","لَا","عِوَجَ","لَهُۥۖ","وَخَشَعَتِ","ٱلۡأَصۡوَاتُ","لِلرَّحۡمَٰنِ","فَلَا","تَسۡمَعُ","إِلَّا","هَمۡسٗا"],"йаумаизин йаттаби`уунад да`ийа ла `иважа лахуу вахаша`атил асвату лиррахмани фала тасма`у илла хамса","В тот день они последуют за глашатаем, и им не удастся уклониться от этого. Их голоса перед Милостивым будут смиренны, и ты услышишь только тихие звуки.",["В тот день","они последуют","за зовущим","нет","кривизны","у него","и смирились","голоса","перед Милостивым","и не","услышишь","кроме","шёпота"]],[20,109,["يَوۡمَئِذٖ","لَّا","تَنفَعُ","ٱلشَّفَٰعَةُ","إِلَّا","مَنۡ","أَذِنَ","لَهُ","ٱلرَّحۡمَٰنُ","وَرَضِيَ","لَهُۥ","قَوۡلٗا"],"йаумаизил ла танфа`уш шафа`ату илла ман азина лахур рахману варадийа лахуу ḳаула","В тот день заступничество не поможет никому, кроме тех, кому Милостивый позволит и чьими речами Он будет доволен.",["В тот день","не","поможет","заступничество","кроме","тому, кому","позволил","ему","Милостивый","и Он доволен","его","словом"]],[20,110,["يَعۡلَمُ","مَا","بَيۡنَ","أَيۡدِيهِمۡ","وَمَا","خَلۡفَهُمۡ","وَلَا","يُحِيطُونَ","بِهِۦ","عِلۡمٗا"],"йа`ламу ма байна айдиихим вама халфахум вала йухиитууна бихии `илма","Он знает их будущее и прошлое, но они не способны объять Его своим знанием.",["Он знает","то, что","перед","ними","и то, что","позади них","и не","они объемлют","Его","знанием"]],[20,111,["وَعَنَتِ","ٱلۡوُجُوهُ","لِلۡحَيِّ","ٱلۡقَيُّومِۖ","وَقَدۡ","خَابَ","مَنۡ","حَمَلَ","ظُلۡمٗا"],"ва`анатил вужууху лилхаййил ḳаййууми ваḳад хаба ман хамала зулма","Лица смирятся перед Живым, Вседержителем, и разочарование постигнет тех, кто понесет бремя несправедливости.",["И смирились","лица","перед Живым","Вседержителем","и уже","потерпел неудачу","кто","понёс","несправедливость"]],[20,112,["وَمَن","يَعۡمَلۡ","مِنَ","ٱلصَّٰلِحَٰتِ","وَهُوَ","مُؤۡمِنٞ","فَلَا","يَخَافُ","ظُلۡمٗا","وَلَا","هَضۡمٗا"],"ваман йа`мал минас салихати вахуа му'минун фала йахафу зулман вала хадма","А тот, кто совершал праведные дела, будучи верующим, не будет бояться ни несправедливости, ни ущемления.",["А кто","совершает","из","праведных дел","и он","верующий","то не","будет бояться","несправедливости","и не","ущемления"]],[20,113,["وَكَذَٰلِكَ","أَنزَلۡنَٰهُ","قُرۡءَانًا","عَرَبِيّٗا","وَصَرَّفۡنَا","فِيهِ","مِنَ","ٱلۡوَعِيدِ","لَعَلَّهُمۡ","يَتَّقُونَ","أَوۡ","يُحۡدِثُ","لَهُمۡ","ذِكۡرٗا"],"ваказалика анзалнаху ḳур'анан `арабиййан васаррафна фиихи минал ва`ииди ла`аллахум йаттаḳууна ау йухдису лахум зикра","Таким образом Мы ниспослали его в виде Корана на арабском языке и подробно разъяснили в нем Свои угрозы, чтобы они устрашились или чтобы это стало для них назиданием.",["И так","Мы ниспослали его","Кораном","арабским","и Мы разъяснили","в нём","из","угроз","чтобы они","устрашились","или","породил","у них","назидание"]]],"m":[[["كَذَٰلِكَ","Так",20,99],["نَقُصُّ","Мы рассказываем",20,99],["عَلَيۡكَ","тебе",20,99],["مِنۡ","из",20,99],["أَنۢبَآءِ","вестей",20,99],["مَا","о том, что",20,99],["قَدۡ","уже",20,99],["سَبَقَۚ","прошло",20,99],["وَقَدۡ","и уже",20,99],["ءَاتَيۡنَٰكَ","Мы даровали тебе",20,99],["مِن","от",20,99],["لَّدُنَّا","Нас",20,99]],[