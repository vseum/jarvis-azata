{"p":320,"j":16,"a":[[20,114,["فَتَعَٰلَى","ٱللَّهُ","ٱلۡمَلِكُ","ٱلۡحَقُّۗ","وَلَا","تَعۡجَلۡ","بِٱلۡقُرۡءَانِ","مِن","قَبۡلِ","أَن","يُقۡضَىٰٓ","إِلَيۡكَ","وَحۡيُهُۥۖ","وَقُل","رَّبِّ","زِدۡنِي","عِلۡمٗا"],"фата`алаллахул маликул хаḳḳу вала та`жал билḳур'ани мин ḳабли ан йуḳда илайка вахйухуу ваḳул ррабби зиднии `илма","Превыше всего Аллах, Истинный Царь! Не торопись читать Коран, пока ниспослание откровения тебе не будет завершено, и говори: «Господи! Приумножь мои знания».",["Превыше","Аллах","Царь","Истинный","и не","торопись","с Кораном","до","того","как","будет завершено","тебе","его откровение","и скажи","Господи","прибавь мне","знания"]],[20,115,["وَلَقَدۡ","عَهِدۡنَآ","إِلَىٰٓ","ءَادَمَ","مِن","قَبۡلُ","فَنَسِيَ","وَلَمۡ","نَجِدۡ","لَهُۥ","عَزۡمٗا"],"валаḳад `ахидна ила адама мин ḳаблу фанасийа валам нажид лахуу `азма","Прежде Мы заключили завет с Адамом, но он забыл, и Мы не нашли у него твердой воли.",["И уже","Мы заповедали","к","Адаму","до","этого","но он забыл","и не","Мы нашли","у него","твёрдости"]],[20,116,["وَإِذۡ","قُلۡنَا","لِلۡمَلَٰٓئِكَةِ","ٱسۡجُدُواْ","لِأٓدَمَ","فَسَجَدُوٓاْ","إِلَّآ","إِبۡلِيسَ","أَبَىٰ"],"ва'из ḳулна лилмалаикатисжудуу ли'адама фасажадуу илла иблииса аба","Вот сказали Мы ангелам: «Падите ниц перед Адамом!». Они пали ниц, и только Иблис отказался.",["И вот","Мы сказали","ангелам","падите ниц","перед Адамом","и они пали ниц","кроме","Иблиса","он отказался"]],[20,117,["فَقُلۡنَا","يَٰٓـَٔادَمُ","إِنَّ","هَٰذَا","عَدُوّٞ","لَّكَ","وَلِزَوۡجِكَ","فَلَا","يُخۡرِجَنَّكُمَا","مِنَ","ٱلۡجَنَّةِ","فَتَشۡقَىٰٓ"],"фаḳулна йа'адаму инна хаза `адуввул лака вализаужика фала йухрижаннакума минал жаннати фаташḳа","Мы сказали: «О Адам! Это - враг тебе и твоей жене. Пусть же он не выведет вас из Рая, а не то ты станешь несчастным.",["И Мы сказали","о Адам","поистине","этот","враг","тебе","и твоей жене","так не","пусть выведет вас обоих","из","Рая","и ты станешь несчастным"]],[20,118,["إِنَّ","لَكَ","أَلَّا","تَجُوعَ","فِيهَا","وَلَا","تَعۡرَىٰ"],"инна лака алла тажуу`а фииха вала та`ра","В нем ты не будешь голодным и нагим.",["Поистине","тебе","что не","ты будешь голодать","в нём","и не","будешь нагим"]],[20,119,["وَأَنَّكَ","لَا","تَظۡمَؤُاْ","فِيهَا","وَلَا","تَضۡحَىٰ"],"ва'аннака ла тазмау фииха вала тадха","В нем ты не будешь страдать от жажды и зноя».",["И что ты","не","будешь жаждать","в нём","и не","будешь страдать от зноя"]],[20,120,["فَوَسۡوَسَ","إِلَيۡهِ","ٱلشَّيۡطَٰنُ","قَالَ","يَٰٓـَٔادَمُ","هَلۡ","أَدُلُّكَ","عَلَىٰ","شَجَرَةِ","ٱلۡخُلۡدِ","وَمُلۡكٖ","لَّا","يَبۡلَىٰ"],"фавасваса илайхиш шайтану ḳала йа'адаму хал адуллука `ала шажаратил хулди вамулкил ла йабла","Но дьявол стал нашептывать ему и сказал: «О Адам! Показать ли тебе дерево вечности и непреходящей власти?».",["И нашептал","ему","шайтан","он сказал","о Адам","ли","я укажу тебе","на","дерево","вечности","и власть","не","ветшающую"]],[20,121,["فَأَكَلَا","مِنۡهَا","فَبَدَتۡ","لَهُمَا","سَوۡءَٰتُهُمَا","وَطَفِقَا","يَخۡصِفَانِ","عَلَيۡهِمَا","مِن","وَرَقِ","ٱلۡجَنَّةِۚ","وَعَصَىٰٓ","ءَادَمُ","رَبَّهُۥ","فَغَوَىٰ"],"фа'акала минха фабадат лахума сауатухума ватафиḳа йахсифани `алайхима мин вараḳил жаннати ва`аса адаму раббахуу фагава","Они оба поели с него, и тогда им стали видны их срамные места. Они стали прилеплять на себе райские листья. Адам ослушался своего Господа и впал в заблуждение.",["И они оба поели","с него","и открылись","им","их срамные места","и начали","прилеплять","на себя","из","листьев","Рая","и ослушался","Адам","своего Господа","и сбился"]],[20,122,["ثُمَّ","ٱجۡتَبَٰهُ","رَبُّهُۥ","فَتَابَ","عَلَيۡهِ","وَهَدَىٰ"],"суммажтабаху раббухуу фатаба `алайхи вахада","Потом Господь избрал его, принял его покаяние и наставил на прямой путь.",["затем","избрал его","Господь его","и принял покаяние","его","и наставил"]],[20,123,["قَالَ","ٱهۡبِطَا","مِنۡهَا","جَمِيعَۢاۖ","بَعۡضُكُمۡ","لِبَعۡضٍ","عَدُوّٞۖ","فَإِمَّا","يَأۡتِيَنَّكُم","مِّنِّي","هُدٗى","فَمَنِ","ٱتَّبَعَ","هُدَايَ","فَلَا","يَضِلُّ","وَلَا","يَشۡقَىٰ"],"ḳалахбита минха жамии`а ба`дукум либа`дин `адуввун фа'имма йа'тийаннакум миннии худан фаманиттаба`а худайа фала йадиллу вала йашḳа","Он сказал: «Низвергнитесь отсюда вместе, и одни из вас будут врагами других. Если же к вам явится от Меня верное руководство, то всякий, кто последует Моему верному руководству, не окажется заблудшим и несчастным.",["Он сказал","низвергнитесь оба","из него","все вместе","одни из вас","для других","враг","и если же","придёт к вам","от Меня","руководство","то кто","последует","Моему руководству","то не","собьётся","и не","будет несчастным"]],[20,124,["وَمَنۡ","أَعۡرَضَ","عَن","ذِكۡرِي","فَإِنَّ","لَهُۥ","مَعِيشَةٗ","ضَنكٗا","وَنَحۡشُرُهُۥ","يَوۡمَ","ٱلۡقِيَٰمَةِ","أَعۡمَىٰ"],"ваман а`рада `ан зикрии фа'инна лахуу ма`иишатан данкан ванахшурухуу йаумал ḳийамати а`ма","А кто отвернется от Моего Напоминания, того ожидает тяжкая жизнь, а в День воскресения Мы воскресим его слепым».",["А кто","отвернётся","от","Моего напоминания","то поистине","ему","жизнь","тяжкая","и Мы соберём его","в день","воскресения","слепым"]],[20,125,["قَالَ","رَبِّ","لِمَ","حَشَرۡتَنِيٓ","أَعۡمَىٰ","وَقَدۡ","كُنتُ","بَصِيرٗا"],"ḳала рабби лима хашартании а`ма ваḳад кунту басиира","И скажет он: «Господи! Почему Ты воскресил меня слепым, если раньше я был зрячим?».",["Он скажет","Господи","почему","Ты собрал меня","слепым","а уже","я был","зрячим"]]],"m":[[["فَتَعَٰلَى","Превыше",20,114],["ٱللَّهُ","Аллах",20,114],["ٱلۡمَلِكُ","Царь",20,114],["ٱلۡحَقُّۗ","Истинный",20,114],["وَلَا","и не",20,114],["تَعۡجَلۡ","торопись",20,114],["بِٱلۡقُرۡءَانِ","с Кораном",20,114],["مِن","до",20,114],["قَبۡلِ","того",20,114],["أَن","как",20,114]],[["يُقۡضَىٰٓ","будет завершено",20,114],["إِلَيۡكَ","тебе",20,114],["وَحۡيُهُۥۖ","его откровение",20,114],["وَقُل","и скажи",20,114],["رَّبِّ","Господи",20,114],["زِدۡنِي","прибавь мне",20,114],["عِلۡمٗا","знания",20,114],[114],["وَلَقَدۡ","И уже",20,115],["عَهِدۡنَآ","Мы заповедали",20,115]],[["إِلَىٰٓ","к",20,115],["ءَادَمَ","Адаму",20,115],["مِن