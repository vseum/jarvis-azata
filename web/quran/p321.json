{"p":321,"j":16,"a":[[20,126,["قَالَ","كَذَٰلِكَ","أَتَتۡكَ","ءَايَٰتُنَا","فَنَسِيتَهَاۖ","وَكَذَٰلِكَ","ٱلۡيَوۡمَ","تُنسَىٰ"],"ḳала казалика ататка айатуна фанасиитаха ваказаликал йаума тунса","Аллах скажет: «Вот так! Наши знамения явились к тебе, но ты предал их забвению. Таким же образом сегодня ты сам будешь предан забвению».",["Он скажет","так","пришли к тебе","Наши знамения","и ты забыл их","и так","сегодня","ты будешь забыт"]],[20,127,["وَكَذَٰلِكَ","نَجۡزِي","مَنۡ","أَسۡرَفَ","وَلَمۡ","يُؤۡمِنۢ","بِـَٔايَٰتِ","رَبِّهِۦۚ","وَلَعَذَابُ","ٱلۡأٓخِرَةِ","أَشَدُّ","وَأَبۡقَىٰٓ"],"ваказалика нажзии ман асрафа валам йу'мим би'айати раббихии вала`азабул ахирати ашадду ва'абḳа","Так Мы воздаем тем, кто излишествовал и не уверовал в знамения своего Господа. А мучения в Последней жизни будут еще более тяжкими и длительными.",["и так","Мы воздаём","тому, кто","излишествовал","и не","уверовал","в знамения","Господа своего","и наказание непременно","Последней жизни","тяжелее","и долговечнее"]],[20,128,["أَفَلَمۡ","يَهۡدِ","لَهُمۡ","كَمۡ","أَهۡلَكۡنَا","قَبۡلَهُم","مِّنَ","ٱلۡقُرُونِ","يَمۡشُونَ","فِي","مَسَٰكِنِهِمۡۚ","إِنَّ","فِي","ذَٰلِكَ","لَأٓيَٰتٖ","لِّأُوْلِي","ٱلنُّهَىٰ"],"афалам йахди лахум кам ахлакна ḳаблахум минал ḳурууни йамшууна фии масакинихим инна фии залика ла'айатил ли'улин нуха","Неужели их не привело на прямой путь то, что Мы погубили до них столько поколений, по жилищам которых они ходят? Воистину, в этом - знамения для обладающих разумом.",["разве не","указало путь","им","сколько","Мы погубили","до них","из","поколений","они ходят","по","жилищам их","поистине","в","этом","непременно знамения","для обладающих","разумом"]],[20,129,["وَلَوۡلَا","كَلِمَةٞ","سَبَقَتۡ","مِن","رَّبِّكَ","لَكَانَ","لِزَامٗا","وَأَجَلٞ","مُّسَمّٗى"],"валаула калиматун сабаḳат мир раббика лакана лизаман ва'ажалум мусамма","Если бы не было прежде Слова от твоего Господа и если бы не назначенный срок, то оно (наказание) уже обязательно наступило бы.",["и если бы не","слово","предшествовавшее","от","Господа твоего","непременно было бы","неотвратимым","и срок","назначенный"]],[20,130,["فَٱصۡبِرۡ","عَلَىٰ","مَا","يَقُولُونَ","وَسَبِّحۡ","بِحَمۡدِ","رَبِّكَ","قَبۡلَ","طُلُوعِ","ٱلشَّمۡسِ","وَقَبۡلَ","غُرُوبِهَاۖ","وَمِنۡ","ءَانَآيِٕ","ٱلَّيۡلِ","فَسَبِّحۡ","وَأَطۡرَافَ","ٱلنَّهَارِ","لَعَلَّكَ","تَرۡضَىٰ"],"фасбир `ала ма йаḳуулууна васаббих бихамди раббика ḳабла тулуу`иш шамси ваḳабла гуруубиха вамин анайил лайли фасаббих ва'атрафан нахари ла`аллака тарда","Посему будь терпелив к тому, что они говорят, и прославляй хвалой своего Господа перед восходом солнца и перед его закатом (совершай рассветный и послеполуденный намазы), славь его в течение ночи (совершай вечерний и ночные намазы), а также в начале и конце дня (совершай полуденный и закатный намазы). Быть может, ты останешься доволен.",["так терпи","на","то, что","они говорят","и славь","хвалой","Господа твоего","до","восхода","солнца","и до","заката его","и в","часы","ночи","и славь","и на концах","дня","чтобы ты","был доволен"]],[20,131,["وَلَا","تَمُدَّنَّ","عَيۡنَيۡكَ","إِلَىٰ","مَا","مَتَّعۡنَا","بِهِۦٓ","أَزۡوَٰجٗا","مِّنۡهُمۡ","زَهۡرَةَ","ٱلۡحَيَوٰةِ","ٱلدُّنۡيَا","لِنَفۡتِنَهُمۡ","فِيهِۚ","وَرِزۡقُ","رَبِّكَ","خَيۡرٞ","وَأَبۡقَىٰ"],"вала тамудданна `айнайка ила ма матта`на бихии азважам минхум захратал хайаватид дунйа линафтинахум фиихи варизḳу раббика хайрун ва'абḳа","Не заглядывайся на то, чем Мы наделили некоторых из них (неверующих), чтобы подвергнуть их этим искушению. Это - блеск земной жизни, а удел твоего Господа лучше и долговечнее.",["и не","простирай","глаз твоих","к","тому, чем","Мы дали пользоваться","им","разным группам","из них","как блеск","жизни","земной","чтобы испытать их","этим","а удел","Господа твоего","лучше","и долговечнее"]],[20,132,["وَأۡمُرۡ","أَهۡلَكَ","بِٱلصَّلَوٰةِ","وَٱصۡطَبِرۡ","عَلَيۡهَاۖ","لَا","نَسۡـَٔلُكَ","رِزۡقٗاۖ","نَّحۡنُ","نَرۡزُقُكَۗ","وَٱلۡعَٰقِبَةُ","لِلتَّقۡوَىٰ"],"ва'мур ахлака биссалавати вастабир `алайха ла нас'алука ризḳан нахну нарзуḳука вал`аḳибату литтаḳва","Вели своей семье совершать намаз и сам терпеливо совершай его. Мы не просим у тебя удела, ведь Мы Сами наделяем тебя уделом. А добрый исход - за богобоязненностью.",["и вели","семье твоей","молитву","и терпеливо держись","её","не","Мы просим у тебя","удела","Мы","наделяем тебя","а исход","за богобоязненностью"]],[20,133,["وَقَالُواْ","لَوۡلَا","يَأۡتِينَا","بِـَٔايَةٖ","مِّن","رَّبِّهِۦٓۚ","أَوَلَمۡ","تَأۡتِهِم","بَيِّنَةُ","مَا","فِي","ٱلصُّحُفِ","ٱلۡأُولَىٰ"],"ваḳалуу лаула йа'тиина би'айатим мир раббихии авалам та'тихим баййинату ма фис сухуфил уула","Они говорят: «Почему он не принес нам знамение от своего Господа?». Но разве не явилось к ним ясное знамение о том, что было в первых скрижалях?",["и сказали они","почему не","приносит он нам","знамение","от","Господа своего","разве не","пришло к ним","ясное доказательство","того, что","в","свитках","первых"]],[20,134,["وَلَوۡ","أَنَّآ","أَهۡلَكۡنَٰهُم","بِعَذَابٖ","مِّن","قَبۡلِهِۦ","لَقَالُواْ","رَبَّنَا","لَوۡلَآ","أَرۡسَلۡتَ","إِلَيۡنَا","رَسُولٗا","فَنَتَّبِعَ","ءَايَٰتِكَ","مِن","قَبۡلِ","أَن","نَّذِلَّ","وَنَخۡزَىٰ"],"валау анна ахлакнахум би`азабим мин ḳаблихии лаḳалуу раббана лаула арсалта илайна расуулан фанаттаби`а айатика мин ḳабли ан назилла ванахза","Если бы Мы погубили их от наказания до этого (пришествия Мухаммада и ниспослания Корана), то они сказали бы: «Господь наш! Почему Ты не отправил к нам посланника, чтобы мы последовали за Твоими знамениями до того, как оказались унижены и опозорены?».",["и если бы","Мы","погубили их","наказанием","до","него","непременно сказали бы они","Господь наш","почему не","послал Ты","к нам","посланника","и мы последовали бы","знамениям Твоим","до","того","как","мы унижены","и опозорены"]],[20,135,["قُلۡ","كُلّٞ","مُّتَرَبِّصٞ","فَتَرَبَّصُواْۖ","فَسَتَعۡلَمُونَ","مَنۡ","أَصۡحَٰبُ","ٱلصِّرَٰطِ","ٱلسَّوِيِّ","وَمَنِ","ٱهۡتَدَىٰ"],"ḳул куллум мутараббисун фатараббасуу фасата`ламууна ман асхабус сиратис савиййи ваманихтада","Скажи: «Все ждут, и вы подождите. Вы узнаете, кто идет прямой дорогой и следует прямым путем».",["скажи","каждый","выжидает","так выжидайте","и вы узнаете","кто","обладатели","пути","ровного","и кто","последовал верному пути"]]],"m":[[["قَالَ","Он скажет",20,126],["كَذَٰلِكَ","так",20,126],["أَتَتۡكَ","пришли к тебе",20,126],["ءَايَٰتُنَا","Наши знамения",20,126],["فَنَسِيتَهَاۖ","и ты забыл их",20,126],["وَكَذَٰلِكَ","и так",20,126],["ٱلۡيَوۡمَ","сегодня",20,126],["تُنسَىٰ","ты будешь забыт",20,126],[126],["وَكَذَٰلِكَ","и так",20,127]],[["نَجۡزِي","Мы воздаём",20,127],["مَنۡ","тому, кто",20,127],["أَسۡرَفَ","излишествовал",20,127],["وَلَمۡ","и не",20,127],["يُؤۡمِنۢ","уверовал",20,127],["بِـَٔايَٰتِ","в знамения",20,127],["رَبِّهِۦۚ","Господа своего",20,127],["وَلَعَذَابُ","и наказание непременно",20,127],["ٱلۡأٓخِرَةِ","Последней жизни",20,127],["أَشَدُّ","тяжелее",20,127]],[["وَأَبۡقَىٰٓ","и долговечнее",20,127],[127],["أَفَلَمۡ","разве не",20,128],["يَهۡدِ","указало путь",20,128],["لَهُمۡ","им",20,128],["كَمۡ","сколько",20,128],["أَهۡلَكۡنَا","Мы погубили",20,128],["قَبۡلَهُم","до них",20,128],["مِّنَ","из",20,128],["ٱلۡقُرُونِ","поколений",20,128],["يَمۡشُونَ","они ходят",20,128]],[["فِي","по",20,128],["مَسَٰكِنِهِمۡۚ","жилищам их",20,128],["إِنَّ","поистине",20,128],["فِي","в",20,128],["ذَٰلِكَ","этом",20,128],["لَأٓيَٰتٖ","непременно знамения",20,128],["لِّأُوْلِي","для обладающих",20,128],["ٱلنُّهَىٰ","разумом",20,128],[128],["وَلَوۡلَا","и если бы не",20,129],["كَلِمَةٞ","слово",20,129]],[["سَبَقَتۡ","предшествовавшее",20,129],["مِن","от",20,129],["رَّبِّكَ","Господа твоего",20,129],["لَكَانَ","непременно было бы",20,129],["لِزَامٗا","неотвратимым",20,129],["وَأَجَلٞ","и срок",20,129],["مُّسَمّٗى","назначенный",20,129],[129],["فَٱصۡبِرۡ","так терпи",20,130],["عَلَىٰ","на",20,130]],[["مَا","то, что",20,130],["يَقُولُونَ","они говорят",20,130],["وَسَبِّحۡ","и славь",20,130],["بِحَمۡدِ","хвалой",20,130],["رَبِّكَ","Господа твоего",20,130],["قَبۡلَ","до",20,130],["طُلُوعِ","восхода",20,130],["ٱلشَّمۡسِ","солнца",20,130],["وَقَبۡلَ","и до",20,130],["غُرُوبِهَاۖ","заката его",20,130]],[["وَمِنۡ","и в",20,130],["ءَانَآيِٕ","часы",20,130],["ٱلَّيۡلِ","ночи",20,130],["فَسَبِّحۡ","и славь",20,130],["وَأَطۡرَافَ","и на концах",20,130],["ٱلنَّهَارِ","дня",20,130],["لَعَلَّكَ","чтобы ты",20,130],["تَرۡضَىٰ","был доволен",20,130],[130],["وَلَا","и не",20,131]],[["تَمُدَّنَّ","простирай",20,131],["عَيۡنَيۡكَ","глаз твоих",20,131],["إِلَىٰ","к",20,131],["مَا","тому, чем",20,131],["مَتَّعۡنَا","Мы дали пользоваться",20,131],["بِهِۦٓ","им",20,131],["أَزۡوَٰجٗا","разным группам",20,131],["مِّنۡهُمۡ","из них",20,131],["زَهۡرَةَ","как блеск",20,131],["ٱلۡحَيَوٰةِ","жизни",20,131],["ٱلدُّنۡيَا","земной",20,131]],[["لِنَفۡتِنَهُمۡ","чтобы испытать их",20,131],["فِيهِۚ","этим",20,131],["وَرِزۡقُ","а удел",20,131],["رَبِّكَ","Господа твоего",20,131],["خَيۡرٞ","лучше",20,131],["وَأَبۡقَىٰ","и долговечнее",20,131],[131],["وَأۡمُرۡ","и вели",20,132],["أَهۡلَكَ","семье твоей",20,132],["بِٱلصَّلَوٰةِ","молитву",20,132]],[["وَٱصۡطَبِرۡ","и терпеливо держись",20,132],["عَلَيۡهَاۖ","её",20,132],["لَا","не",20,132],["نَسۡـَٔلُكَ","Мы просим у тебя",20,132],["رِزۡقٗاۖ","удела",20,132],["نَّحۡنُ","Мы",20,132],["نَرۡزُقُكَۗ","наделяем тебя",20,132],["وَٱلۡعَٰقِبَةُ","а исход",20,132],["لِلتَّقۡوَىٰ","за богобоязненностью",20,132]],[[132],["وَقَالُواْ","и сказали они",20,133],["لَوۡلَا","почему не",20,133],["يَأۡتِينَا","приносит он нам",20,133],["بِـَٔايَةٖ","знамение",20,133],["مِّن","от",20,133],["رَّبِّهِۦٓۚ","Господа своего",20,133],["أَوَلَمۡ","разве не",20,133],["تَأۡتِهِم","пришло к ним",20,133],["بَيِّنَةُ","ясное доказательство",20,133],["مَا","того, что",20,133],["فِي","в",20,133]],[["ٱلصُّحُفِ","свитках",20,133],["ٱلۡأُولَىٰ","первых",20,133],[133],["وَلَوۡ","и если бы",20,134],["أَنَّآ","Мы",20,134],["أَهۡلَكۡنَٰهُم","погубили их",20,134],["بِعَذَابٖ","наказанием",20,134],["مِّن","до",20,134],["قَبۡلِهِۦ","него",20,134]],[["لَقَالُواْ","непременно сказали бы они",20,134],["رَبَّنَا","Господь наш",20,134],["لَوۡلَآ","почему не",20,134],["أَرۡسَلۡتَ","послал Ты",20,134],["إِلَيۡنَا","к нам",20,134],["رَسُولٗا","посланника",20,134],["فَنَتَّبِعَ","и мы последовали бы",20,134],["ءَايَٰتِكَ","знамениям Твоим",20,134],["مِن","до",20,134]],[["قَبۡلِ","того",20,134],["أَن","как",20,134],["نَّذِلَّ","мы унижены",20,134],["وَنَخۡزَىٰ","и опозорены",20,134],[134],["قُلۡ","скажи",20,135],["كُلّٞ","каждый",20,135],["مُّتَرَبِّصٞ","выжидает",20,135],["فَتَرَبَّصُواْۖ","так выжидайте",20,135]],[["فَسَتَعۡلَمُونَ","и вы узнаете",20,135],["مَنۡ","кто",20,135],["أَصۡحَٰبُ","обладатели",20,135],["ٱلصِّرَٰطِ","пути",20,135],["ٱلسَّوِيِّ","ровного",20,135],["وَمَنِ","и кто",20,135],["ٱهۡتَدَىٰ","последовал верному пути",20,135],[135]]]}