{"p":322,"j":17,"a":[[21,1,["ٱقۡتَرَبَ","لِلنَّاسِ","حِسَابُهُمۡ","وَهُمۡ","فِي","غَفۡلَةٖ","مُّعۡرِضُونَ"],"иḳтараба линнаси хисабухум вахум фии гафлатим му`ридуун","Приблизился к людям расчет с ними, однако они с пренебрежением отворачиваются.",["приблизился","к людям","расчёт их","а они","в","беспечности","отворачиваются"]],[21,2,["مَا","يَأۡتِيهِم","مِّن","ذِكۡرٖ","مِّن","رَّبِّهِم","مُّحۡدَثٍ","إِلَّا","ٱسۡتَمَعُوهُ","وَهُمۡ","يَلۡعَبُونَ"],"ма йа'тиихим мин зикрим мир раббихим мухдасин илластама`ууху вахум йал`абуун","Когда бы ни приходило к ним новое назидание от их Господа, они выслушивали его, забавляясь.",["не","приходит к ним","никакое","напоминание","от","Господа их","новое","без того, чтобы","они слушали его","а они","забавляются"]],[21,3,["لَاهِيَةٗ","قُلُوبُهُمۡۗ","وَأَسَرُّواْ","ٱلنَّجۡوَى","ٱلَّذِينَ","ظَلَمُواْ","هَلۡ","هَٰذَآ","إِلَّا","بَشَرٞ","مِّثۡلُكُمۡۖ","أَفَتَأۡتُونَ","ٱلسِّحۡرَ","وَأَنتُمۡ","تُبۡصِرُونَ"],"лахийатан ḳулуубухум ва'асаррун нажвал лазиина заламуу хал хаза илла башарум мислукум афата'туунас сихра ва'антум тубсируун","Сердца же их оставались беспечными. Беззаконники говорили между собой тайком: «Разве это - не такой же человек, как и вы? Неужели вы покоритесь колдовству, которое вы видите воочию?».",["беспечны","сердца их","и утаили","тайную беседу","те, которые","беззаконничали","разве","этот","не более чем","человек","подобный вам","неужели поддадитесь","колдовству","а вы","видите"]],[21,4,["قَالَ","رَبِّي","يَعۡلَمُ","ٱلۡقَوۡلَ","فِي","ٱلسَّمَآءِ","وَٱلۡأَرۡضِۖ","وَهُوَ","ٱلسَّمِيعُ","ٱلۡعَلِيمُ"],"ḳала раббии йа`ламул ḳаула фис самаи вал'арди вахуас самии`ул `алиим","Мухаммад сказал: «Мой Господь знает то, что говорят на небе и на земле. Он - Слышащий, Знающий».",["сказал он","Господь мой","знает","слово","на","небе","и земле","и Он","Слышащий","Знающий"]],[21,5,["بَلۡ","قَالُوٓاْ","أَضۡغَٰثُ","أَحۡلَٰمِۭ","بَلِ","ٱفۡتَرَىٰهُ","بَلۡ","هُوَ","شَاعِرٞ","فَلۡيَأۡتِنَا","بِـَٔايَةٖ","كَمَآ","أُرۡسِلَ","ٱلۡأَوَّلُونَ"],"бал ḳалуу адгасу ахлами балифтараху бал хуа ша`ирун фалйа'тина би'айатин кама урсилал аввалуун","Они сказали: «Это - бессвязные сны! Нет, он сочинил это! Нет, он - поэт! Пусть он покажет нам знамение, подобное тем, с которыми были отправлены первые посланники».",["нет","сказали они","смешение","снов","нет","выдумал он это","нет","он","поэт","пусть же принесёт нам","знамение","как","были посланы","первые"]],[21,6,["مَآ","ءَامَنَتۡ","قَبۡلَهُم","مِّن","قَرۡيَةٍ","أَهۡلَكۡنَٰهَآۖ","أَفَهُمۡ","يُؤۡمِنُونَ"],"ма аманат ḳаблахум мин ḳарйатин ахлакнаха афахум йу'минуун","Ни одно из селений, которые Мы погубили до них, не уверовало. Неужели они уверуют?",["не","уверовало","до них","ни одно","селение","которое Мы погубили","неужели они","уверуют"]],[21,7,["وَمَآ","أَرۡسَلۡنَا","قَبۡلَكَ","إِلَّا","رِجَالٗا","نُّوحِيٓ","إِلَيۡهِمۡۖ","فَسۡـَٔلُوٓاْ","أَهۡلَ","ٱلذِّكۡرِ","إِن","كُنتُمۡ","لَا","تَعۡلَمُونَ"],"вама арсална ḳаблака илла рижалан нуухии илайхим фас'алуу ахлаз зикри ин кунтум ла та`ламуун","Мы и до тебя отправляли только мужей, которым внушали откровение. Спросите людей Напоминания, если вы не знаете этого.",["и не","посылали Мы","до тебя","кроме","мужей","Мы внушали","им","так спросите","людей","Напоминания","если","вы","не","знаете"]],[21,8,["وَمَا","جَعَلۡنَٰهُمۡ","جَسَدٗا","لَّا","يَأۡكُلُونَ","ٱلطَّعَامَ","وَمَا","كَانُواْ","خَٰلِدِينَ"],"вама жа`алнахум жасадал ла йа'кулуунат та`ама вама кануу халидиин","Мы не сотворили их (посланников) телами, которые не потребляют пищу, и они не были бессмертными.",["и не","сделали Мы их","телами","которые не","едят","пищу","и не","были они","бессмертными"]],[21,9,["ثُمَّ","صَدَقۡنَٰهُمُ","ٱلۡوَعۡدَ","فَأَنجَيۡنَٰهُمۡ","وَمَن","نَّشَآءُ","وَأَهۡلَكۡنَا","ٱلۡمُسۡرِفِينَ"],"сумма садаḳнахумул ва`да фа'анжайнахум ваман нашау ва'ахлакнал мусрифиин","Потом Мы выполнили данное им обещание, спасли их и тех, кого пожелали, и погубили тех, кто излишествовал.",["затем","Мы исполнили им","обещание","и спасли их","и тех, кого","Мы желаем","и погубили Мы","излишествовавших"]],[21,10,["لَقَدۡ","أَنزَلۡنَآ","إِلَيۡكُمۡ","كِتَٰبٗا","فِيهِ","ذِكۡرُكُمۡۚ","أَفَلَا","تَعۡقِلُونَ"],"лаḳад анзална илайкум китабан фиихи зикрукум афала та`ḳилуун","Мы уже ниспослали вам Писание, в котором содержится напоминание о вас. Неужели вы не разумеете?",["Мы уже","ниспослали","вам","Писание","в нём","напоминание о вас","неужели не","вы разумеете"]]],"m":[["h",21],["b"],[["ٱقۡتَرَبَ","приблизился",21,1],["لِلنَّاسِ","к людям",21,1],["حِسَابُهُمۡ","расчёт их",21,1],["وَهُمۡ","а они",21,1],["فِي","в",21,1],["غَفۡلَةٖ","беспечности",21,1],["مُّعۡرِضُونَ","отворачиваются",21,1],[1]],[["مَا","не",21,2],["يَأۡتِيهِم","приходит к ним",21,2],["مِّن","никакое",21,2],["ذِكۡرٖ","напоминание",21,2],["مِّن","от",21,2],["رَّبِّهِم","Господа их",21,2],["مُّحۡدَثٍ","новое",21,2],["إِلَّا","без того, чтобы",21,2],["ٱسۡتَمَعُوهُ","они слушали его",21,2],["وَهُمۡ","а они",21,2]],[["يَلۡعَبُونَ","забавляются",21,2],[2],["لَاهِيَةٗ","беспечны",21,3],["قُلُوبُهُمۡۗ","сердца их",21,3],["وَأَسَرُّواْ","и утаили",21,3],["ٱلنَّجۡوَى","тайную беседу",21,3],["ٱلَّذِينَ","те, которые",21,3],["ظَلَمُواْ","беззаконничали",21,3]],[["هَلۡ","разве",21,3],["هَٰذَآ","этот",21,3],["إِلَّا","не более чем",21,3],["بَشَرٞ","человек",21,3],["مِّثۡلُكُمۡۖ","подобный вам",21,3],["أَفَتَأۡتُونَ","неужели поддадитесь",21,3],["ٱلسِّحۡرَ","колдовству",21,3],["وَأَنتُمۡ","а вы",21,3]],[["تُبۡصِرُونَ","видите",21,3],[3],["قَالَ","сказал он",21,4],["رَبِّي","Господь мой",21,4],["يَعۡلَمُ","знает",21,4],["ٱلۡقَوۡلَ","слово",21,4],["فِي","на",21,4],["ٱلسَّمَآءِ","небе",21,4],["وَٱلۡأَرۡضِۖ","и земле",21,4]],[["وَهُوَ","и Он",21,4],["ٱلسَّمِيعُ","Слышащий",21,4],["ٱلۡعَلِيمُ","Знающий",21,4],[4],["بَلۡ","нет",21,5],["قَالُوٓاْ","сказали они",21,5],["أَضۡغَٰثُ","смешение",21,5],["أَحۡلَٰمِۭ","снов",21,5],["بَلِ","нет",21,5]],[["ٱفۡتَرَىٰهُ","выдумал он это",21,5],["بَلۡ","нет",21,5],["هُوَ","он",21,5],["شَاعِرٞ","поэт",21,5],["فَلۡيَأۡتِنَا","пусть же принесёт нам",21,5],["بِـَٔايَةٖ","знамение",21,5],["كَمَآ","как",21,5],["أُرۡسِلَ","были посланы",21,5],["ٱلۡأَوَّلُونَ","первые",21,5]],[[5],["مَآ","не",21,6],["ءَامَنَتۡ","уверовало",21,6],["قَبۡلَهُم","до них",21,6],["مِّن","ни одно",21,6],["قَرۡيَةٍ","селение",21,6],["أَهۡلَكۡنَٰهَآۖ","которое Мы погубили",21,6],["أَفَهُمۡ","неужели они",21,6],["يُؤۡمِنُونَ","уверуют",21,6]],[[6],["وَمَآ","и не",21,7],["أَرۡسَلۡنَا","посылали Мы",21,7],["قَبۡلَكَ","до тебя",21,7],["إِلَّا","кроме",21,7],["رِجَالٗا","мужей",21,7],["نُّوحِيٓ","Мы внушали",21,7],["إِلَيۡهِمۡۖ","им",21,7],["فَسۡـَٔلُوٓاْ","так спросите",21,7],["أَهۡلَ","людей",21,7]],[["ٱلذِّكۡرِ","Напоминания",21,7],["إِن","если",21,7],["كُنتُمۡ","вы",21,7],["لَا","не",21,7],["تَعۡلَمُونَ","знаете",21,7],[7],["وَمَا","и не",21,8],["جَعَلۡنَٰهُمۡ","сделали Мы их",21,8],["جَسَدٗا","телами",21,8]],[["لَّا","которые не",21,8],["يَأۡكُلُونَ","едят",21,8],["ٱلطَّعَامَ","пищу",21,8],["وَمَا","и не",21,8],["كَانُواْ","были они",21,8],["خَٰلِدِينَ","бессмертными",21,8],[8],["ثُمَّ","затем",21,9],["صَدَقۡنَٰهُمُ","Мы исполнили им",21,9]],[["ٱلۡوَعۡدَ","обещание",21,9],["فَأَنجَيۡنَٰهُمۡ","и спасли их",21,9],["وَمَن","и тех, кого",21,9],["نَّشَآءُ","Мы желаем",21,9],["وَأَهۡلَكۡنَا","и погубили Мы",21,9],["ٱلۡمُسۡرِفِينَ","излишествовавших",21,9],[9]],[["لَقَدۡ","Мы уже",21,10],["أَنزَلۡنَآ","ниспослали",21,10],["إِلَيۡكُمۡ","вам",21,10],["كِتَٰبٗا","Писание",21,10],["فِيهِ","в нём",21,10],["ذِكۡرُكُمۡۚ","напоминание о вас",21,10],["أَفَلَا","неужели не",21,10],["تَعۡقِلُونَ","вы разумеете",21,10],[10]]]}