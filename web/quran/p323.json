{"p":323,"j":17,"a":[[21,11,["وَكَمۡ","قَصَمۡنَا","مِن","قَرۡيَةٖ","كَانَتۡ","ظَالِمَةٗ","وَأَنشَأۡنَا","بَعۡدَهَا","قَوۡمًا","ءَاخَرِينَ"],"вакам ḳасамна мин ḳарйатин канат залиматан ва'анша'на ба`даха ḳауман ахариин","Сколько Мы разрушили селений, которые были несправедливы, сотворив после них другие народы!",["и сколько","Мы сокрушили","из","селений","которое было","несправедливым","и Мы создали","после него","народ","другой"]],[21,12,["فَلَمَّآ","أَحَسُّواْ","بَأۡسَنَآ","إِذَا","هُم","مِّنۡهَا","يَرۡكُضُونَ"],"фаламма ахассуу ба'сана иза хум минха йаркудуун","Когда они чувствовали Наше наказание, то бросались бежать от него.",["и когда","почувствовали они","Наше наказание","вот","они","от него","бегут"]],[21,13,["لَا","تَرۡكُضُواْ","وَٱرۡجِعُوٓاْ","إِلَىٰ","مَآ","أُتۡرِفۡتُمۡ","فِيهِ","وَمَسَٰكِنِكُمۡ","لَعَلَّكُمۡ","تُسۡـَٔلُونَ"],"ла таркудуу варжи`уу ила ма утрифтум фиихи вамасакиникум ла`аллакум тус'алуун","Не убегайте и вернитесь туда, где вам было позволено вести роскошную жизнь, и в свои жилища, быть может, к вам будут обращаться с просьбами!",["не","убегайте","и вернитесь","к","тому, что","вам дана роскошь","в нём","и к жилищам вашим","может быть, вас","будут спрашивать"]],[21,14,["قَالُواْ","يَٰوَيۡلَنَآ","إِنَّا","كُنَّا","ظَٰلِمِينَ"],"ḳалуу йавайлана инна кунна залимиин","Они говорили: «О горе нам! Воистину, мы были несправедливы!».",["сказали они","о горе нам","поистине, мы","были","несправедливыми"]],[21,15,["فَمَا","زَالَت","تِّلۡكَ","دَعۡوَىٰهُمۡ","حَتَّىٰ","جَعَلۡنَٰهُمۡ","حَصِيدًا","خَٰمِدِينَ"],"фама залат тилка да`вахум хатта жа`алнахум хасиидан хамидиин","Они продолжали так взывать, пока Мы не превратили их в затухшее жнивье.",["и не","прекращался","этот","вопль их","пока","Мы не сделали их","жнивьём","угасшими"]],[21,16,["وَمَا","خَلَقۡنَا","ٱلسَّمَآءَ","وَٱلۡأَرۡضَ","وَمَا","بَيۡنَهُمَا","لَٰعِبِينَ"],"вама халаḳнас самаа вал'арда вама байнахума ла`ибиин","Мы не создали небо, землю и все, что между ними, забавляясь.",["и не","создали Мы","небо","и землю","и то, что","между ними","забавляясь"]],[21,17,["لَوۡ","أَرَدۡنَآ","أَن","نَّتَّخِذَ","لَهۡوٗا","لَّٱتَّخَذۡنَٰهُ","مِن","لَّدُنَّآ","إِن","كُنَّا","فَٰعِلِينَ"],"лау арадна ан наттахиза лахвал латтахазнаху мил ладунна ин кунна фа`илиин","Если бы Мы пожелали устроить Себе потеху, то устроили бы ее из того, что есть у Нас.",["если бы","Мы пожелали","чтобы","Мы взяли","забаву","непременно взяли бы её","от","Нас","если бы","Мы были","делающими"]],[21,18,["بَلۡ","نَقۡذِفُ","بِٱلۡحَقِّ","عَلَى","ٱلۡبَٰطِلِ","فَيَدۡمَغُهُۥ","فَإِذَا","هُوَ","زَاهِقٞۚ","وَلَكُمُ","ٱلۡوَيۡلُ","مِمَّا","تَصِفُونَ"],"бал наḳзифу билхаḳḳи `алал батили файадмагухуу фа'иза хуа захиḳун валакумул вайлу мимма тасифуун","Однако Мы бросаем истину в ложь, и та разбивается и исчезает. Горе вам за то, что вы приписываете!",["нет","Мы бросаем","истину","на","ложь","и она разбивает её","и вот","она","исчезает","и вам","горе","за то, что","вы приписываете"]],[21,19,["وَلَهُۥ","مَن","فِي","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِۚ","وَمَنۡ","عِندَهُۥ","لَا","يَسۡتَكۡبِرُونَ","عَنۡ","عِبَادَتِهِۦ","وَلَا","يَسۡتَحۡسِرُونَ"],"валахуу ман фис самавати вал'арди ваман `индахуу ла йастакбирууна `ан `ибадатихии вала йастахсируун","Ему принадлежат все, кто на небесах и на земле. А те, кто находится рядом с Ним, не превозносятся над поклонением Ему и не устают.",["и Ему","кто","на","небесах","и земле","а те, кто","у Него","не","превозносятся","над","поклонением Ему","и не","утомляются"]],[21,20,["يُسَبِّحُونَ","ٱلَّيۡلَ","وَٱلنَّهَارَ","لَا","يَفۡتُرُونَ"],"йусаббихуунал лайла ваннахара ла йафтуруун","Они славят Его днем и ночью без устали.",["славят","ночью","и днем","не","ослабевают"]],[21,21,["أَمِ","ٱتَّخَذُوٓاْ","ءَالِهَةٗ","مِّنَ","ٱلۡأَرۡضِ","هُمۡ","يُنشِرُونَ"],"амиттахазуу алихатам минал арди хум йуншируун","Или же они стали поклоняться божествам из земли, которые способны воскрешать?",["или","взяли они","богов","из","земли","они","воскрешают"]],[21,22,["لَوۡ","كَانَ","فِيهِمَآ","ءَالِهَةٌ","إِلَّا","ٱللَّهُ","لَفَسَدَتَاۚ","فَسُبۡحَٰنَ","ٱللَّهِ","رَبِّ","ٱلۡعَرۡشِ","عَمَّا","يَصِفُونَ"],"лау кана фиихима алихатун иллаллаху лафасадата фасубханаллахи раббил `арши `амма йасифуун","Если бы на них (на небесах и земле) были иные божества наряду с Аллахом, то они (небеса и земля) разрушились бы. Аллах, Господь Трона, пречист и далек от того, что они приписывают Ему!",["если бы","были","на них обоих","боги","кроме","Аллаха","непременно расстроились бы оба","пречист","Аллах","Господь","Трона","от того, что","они приписывают"]],[21,23,["لَا","يُسۡـَٔلُ","عَمَّا","يَفۡعَلُ","وَهُمۡ","يُسۡـَٔلُونَ"],"ла йус'алу `амма йаф`алу вахум йус'алуун","Его не спросят за то, что Он совершает, а они будут спрошены.",["не","будет спрошен Он","о том, что","делает Он","а они","будут спрошены"]],[21,24,["أَمِ","ٱتَّخَذُواْ","مِن","دُونِهِۦٓ","ءَالِهَةٗۖ","قُلۡ","هَاتُواْ","بُرۡهَٰنَكُمۡۖ","هَٰذَا","ذِكۡرُ","مَن","مَّعِيَ","وَذِكۡرُ","مَن","قَبۡلِيۚ","بَلۡ","أَكۡثَرُهُمۡ","لَا","يَعۡلَمُونَ","ٱلۡحَقَّۖ","فَهُم","مُّعۡرِضُونَ"],"амиттахазуу мин дуунихии алихатан ḳул хатуу бурханакум хаза зикру мам ма`ийа вазикру ман ḳаблии бал аксарухум ла йа`ламуунал хаḳḳа фахум му`ридуун","Неужели они стали поклоняться иным божествам вместо Него? Скажи: «Приведите ваши доказательства! Вот напоминание для тех, кто со мной, и напоминание для тех, кто жил до меня». Однако большинство их не ведает об истине и отворачивается.",["или","взяли они","помимо","Него","богов","скажи","приведите","ваше доказательство","это","напоминание","тех, кто","со мной","и напоминание","тех, кто","до меня","но","большинство их","не","знают","истины","и они","отворачиваются"]]],"m":[[["وَكَمۡ","и сколько",21,11],["قَصَمۡنَا","Мы сокрушили",21,11],["مِن","из",21,11],["قَرۡيَةٖ","селений",21,11],["كَانَتۡ","которое было",21,11],["ظَالِمَةٗ","несправедливым",21,11],["وَأَنشَأۡنَا","и Мы создали",21,11],["بَعۡدَهَا","после него",21,11],["قَوۡمًا","народ",21,11]],[["ءَاخَرِينَ","другой",21,11],[11],["فَلَمَّآ","и когда",21,12],[