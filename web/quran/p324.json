{"p":324,"j":17,"a":[[21,25,["وَمَآ","أَرۡسَلۡنَا","مِن","قَبۡلِكَ","مِن","رَّسُولٍ","إِلَّا","نُوحِيٓ","إِلَيۡهِ","أَنَّهُۥ","لَآ","إِلَٰهَ","إِلَّآ","أَنَا۠","فَٱعۡبُدُونِ"],"вама арсална мин ḳаблика мир расуулин илла нуухии илайхи аннахуу ла илаха илла ана фа`будуун","Мы не посылали до тебя ни одного посланника, которому не было бы внушено: «Нет божества, кроме Меня. Поклоняйтесь же Мне!».",["и не","посылали Мы","из","прежде тебя","ни одного","посланника","без того, чтобы","Мы внушали","ему","что","нет","божества","кроме","Меня","так поклоняйтесь Мне"]],[21,26,["وَقَالُواْ","ٱتَّخَذَ","ٱلرَّحۡمَٰنُ","وَلَدٗاۗ","سُبۡحَٰنَهُۥۚ","بَلۡ","عِبَادٞ","مُّكۡرَمُونَ"],"ваḳалуттахазар рахману валадан субханахуу бал `ибадум мукрамуун","Они говорят: «Милостивый взял Себе сына». Пречист Он! Они же - почитаемые рабы.",["и сказали они","взял","Милостивый","сына","пречист Он","нет","рабы","почитаемые"]],[21,27,["لَا","يَسۡبِقُونَهُۥ","بِٱلۡقَوۡلِ","وَهُم","بِأَمۡرِهِۦ","يَعۡمَلُونَ"],"ла йасбиḳуунахуу билḳаули вахум би'амрихии йа`малуун","Они не опережают Его своими речами и поступают согласно Его велениям.",["не","опережают они Его","в слове","и они","по велению Его","действуют"]],[21,28,["يَعۡلَمُ","مَا","بَيۡنَ","أَيۡدِيهِمۡ","وَمَا","خَلۡفَهُمۡ","وَلَا","يَشۡفَعُونَ","إِلَّا","لِمَنِ","ٱرۡتَضَىٰ","وَهُم","مِّنۡ","خَشۡيَتِهِۦ","مُشۡفِقُونَ"],"йа`ламу ма байна айдиихим вама халфахум вала йашфа`ууна илла лиманиртада вахум мин хашйатихии мушфиḳуун","Он ведает их прошлое и будущее. Они заступаются только за тех, кем Он доволен, а сами трепещут от страха перед Ним.",["Он знает","то, что","между","руками их","и то, что","позади них","и не","заступаются они","кроме как","за того, кем","Он доволен","и они","от","страха перед Ним","трепещут"]],[21,29,["وَمَن","يَقُلۡ","مِنۡهُمۡ","إِنِّيٓ","إِلَٰهٞ","مِّن","دُونِهِۦ","فَذَٰلِكَ","نَجۡزِيهِ","جَهَنَّمَۚ","كَذَٰلِكَ","نَجۡزِي","ٱلظَّٰلِمِينَ"],"ваман йаḳул минхум иннии илахум мин дуунихии фазалика нажзиихи жаханнама казалика нажзиз залимиин","А тому из них, кто скажет: «Я являюсь богом наряду с Ним», - воздаянием будет Геенна. Так Мы воздаем беззаконникам.",["а кто","скажет","из них","поистине, я","бог","помимо","Него","то такому","Мы воздадим","Геенной","так","Мы воздаём","беззаконникам"]],[21,30,["أَوَلَمۡ","يَرَ","ٱلَّذِينَ","كَفَرُوٓاْ","أَنَّ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضَ","كَانَتَا","رَتۡقٗا","فَفَتَقۡنَٰهُمَاۖ","وَجَعَلۡنَا","مِنَ","ٱلۡمَآءِ","كُلَّ","شَيۡءٍ","حَيٍّۚ","أَفَلَا","يُؤۡمِنُونَ"],"авалам йарал лазиина кафаруу аннас самавати вал'арда каната ратḳан фафатаḳнахума важа`ална минал маи кулла шай'ин хаййин афала йу'минуун","Неужели неверующие не видят, что небеса и земля были единым целым и что Мы разделили их и сотворили все живое из воды? Неужели они не уверуют?",["разве не","видели","те, которые","не уверовали","что","небеса","и земля","были","слитными","и Мы разделили их","и сделали Мы","из","воды","всякую","вещь","живую","неужели не","уверуют они"]],[21,31,["وَجَعَلۡنَا","فِي","ٱلۡأَرۡضِ","رَوَٰسِيَ","أَن","تَمِيدَ","بِهِمۡ","وَجَعَلۡنَا","فِيهَا","فِجَاجٗا","سُبُلٗا","لَّعَلَّهُمۡ","يَهۡتَدُونَ"],"важа`ална фил арди равасийа ан тамиида бихим важа`ална фииха фижажан субулал ла`аллахум йахтадуун","Мы воздвигли на земле незыблемые горы, чтобы она не колебалась вместе с ними. Мы проложили на ней широкие дороги, чтобы они следовали верным путем.",["и Мы поместили","на","земле","незыблемые горы","чтобы не","колебалась","с ними","и Мы сделали","на ней","широкие проходы","дорогами","чтобы они","шли прямым путём"]],[21,32,["وَجَعَلۡنَا","ٱلسَّمَآءَ","سَقۡفٗا","مَّحۡفُوظٗاۖ","وَهُمۡ","عَنۡ","ءَايَٰتِهَا","مُعۡرِضُونَ"],"важа`алнас самаа саḳфам махфуузан вахум `ан айатиха му`ридуун","Мы сделали небо оберегаемой кровлей, однако они отворачиваются от его знамений.",["и Мы сделали","небо","кровлей","оберегаемой","а они","от","знамений его","отворачиваются"]],[21,33,["وَهُوَ","ٱلَّذِي","خَلَقَ","ٱلَّيۡلَ","وَٱلنَّهَارَ","وَٱلشَّمۡسَ","وَٱلۡقَمَرَۖ","كُلّٞ","فِي","فَلَكٖ","يَسۡبَحُونَ"],"вахуал лазии халаḳал лайла ваннахара вашшамса валḳамара куллун фии фалакин йасбахуун","Он - Тот, Кто сотворил ночь и день, солнце и луну. Все плывут по орбитам.",["и Он","Тот, Который","создал","ночь","и день","и солнце","и луну","все","по","орбите","плывут"]],[21,34,["وَمَا","جَعَلۡنَا","لِبَشَرٖ","مِّن","قَبۡلِكَ","ٱلۡخُلۡدَۖ","أَفَإِيْن","مِّتَّ","فَهُمُ","ٱلۡخَٰلِدُونَ"],"вама жа`ална либашарим мин ḳабликал хулда афаим митта фахумул халидуун","Никому из людей до тебя Мы не даровали бессмертия. Неужели, если даже ты умрешь, они будут жить вечно?",["и не","дали Мы","человеку","из","прежде тебя","бессмертия","разве если","ты умрёшь","то они","вечно живущие"]],[21,35,["كُلُّ","نَفۡسٖ","ذَآئِقَةُ","ٱلۡمَوۡتِۗ","وَنَبۡلُوكُم","بِٱلشَّرِّ","وَٱلۡخَيۡرِ","فِتۡنَةٗۖ","وَإِلَيۡنَا","تُرۡجَعُونَ"],"куллу нафсин заиḳатул маути ванаблуукум бишшарри валхайри фитнатан ва'илайна туржа`уун","Каждая душа вкусит смерть. Мы испытываем вас добром и злом ради искушения, и к Нам вы будете возвращены.",["каждая","душа","вкусит","смерть","и Мы испытываем вас","злом","и добром","в искушение","и к Нам","вы будете возвращены"]]],"m":[[["وَمَآ","и не",21,25],["أَرۡسَلۡنَا","посылали Мы",21,25],["مِن","из",21,25],["قَبۡلِكَ","прежде тебя",21,25],["مِن","ни одного",21,25],["رَّسُولٍ","посланника",21,25],["إِلَّا","без того, чтобы",21,25],["نُوحِيٓ","Мы внушали",21,25],["إِلَيۡهِ","ему",21,25],["أَنَّهُۥ","что",21,25],["لَآ","нет",21,25],["إِلَٰهَ","божества",21,25]],[["إِلَّآ","кроме",21,25],["أَنَا۠","Меня",21,25],["فَٱعۡبُدُونِ","так поклоняйтесь Мне",21,25],[25],["وَقَالُواْ","и сказали они",21,26],["ٱتَّخَذَ","взял",21,26],["ٱلرَّحۡمَٰنُ","Милостивый",21,26],["وَلَدٗاۗ","сына",21,26],["سُبۡحَٰنَهُۥۚ","пречист Он",21,26]],[["بَلۡ","нет",21,26],["عِبَادٞ","рабы",21,26],["مُّكۡرَمُونَ","почитаемые",21,26],[26],["لَا","не",21,27],["يَسۡبِقُونَهُۥ","опережают они Его",21,27],["بِٱلۡقَوۡلِ","в слове",21,27],["وَهُم","и они",21,27]],[["بِأَمۡرِهِۦ","по велению Его",21,27],["يَعۡمَلُونَ","действуют",21,27],[27],["يَعۡلَمُ","Он знает",21,28],["مَا","то, что",21,28],["بَيۡنَ","между",21,28],["أَيۡدِيهِمۡ","руками их",21,28],["وَمَا","и то, что",21,28],["خَلۡفَهُمۡ","позади них",21,28]],[["وَلَا","и не",21,28],["يَشۡفَعُونَ","заступаются они",21,28],["إِلَّا","кроме как",21,28],["لِمَنِ","за того, кем",21,28],["ٱرۡتَضَىٰ","Он доволен",21,28],["وَهُم","и они",21,28],["مِّنۡ","от",21,28],["خَشۡيَتِهِۦ","страха перед Ним",21,28],["مُشۡفِقُونَ","трепещут",21,28]],[[28],["۞ وَمَن","а кто",21,29],["يَقُلۡ","скажет",21,29],["مِنۡهُمۡ","из них",21,29],["إِنِّيٓ","поистине, я",21,29],["إِلَٰهٞ","бог",21,29],["مِّن","помимо",21,29],["دُونِهِۦ","Него",21,29],["فَذَٰلِكَ","то такому",21,29],["نَجۡزِيهِ","Мы воздадим",21,29]],[["جَهَنَّمَۚ","Геенной",21,29],["كَذَٰلِكَ","так",21,29],["نَجۡزِي","Мы воздаём",21,29],["ٱلظَّٰلِمِينَ","беззаконникам",21,29],[29],["أَوَلَمۡ","разве не",21,30],["يَرَ","видели",21,30],["ٱلَّذِينَ","те, которые",21,30],["كَفَرُوٓاْ","не уверовали",21,30]],[["أَنَّ","что",21,30],["ٱلسَّمَٰوَٰتِ","небеса",21,30],["وَٱلۡأَرۡضَ","и земля",21,30],["كَانَتَا","были",21,30],["رَتۡقٗا","слитными",21,30],["فَفَتَقۡنَٰهُمَاۖ","и Мы разделили их",21,30],["وَجَعَلۡنَا","и сделали Мы",21,30]],[["مِنَ","из",21,30],["ٱلۡمَآءِ","воды",21,30],["كُلَّ","всякую",21,30],["شَيۡءٍ","вещь",21,30],["حَيٍّۚ","живую",21,30],["أَفَلَا","неужели не",21,30],["يُؤۡمِنُونَ","уверуют они",21,30],[30],["وَجَعَلۡنَا","и Мы поместили",21,31],["فِي","на",21,31],["ٱلۡأَرۡضِ","земле",21,31]],[["رَوَٰسِيَ","незыблемые горы",21,31],["أَن","чтобы не",21,31],["تَمِيدَ","колебалась",21,31],["بِهِمۡ","с ними",21,31],["وَجَعَلۡنَا","и Мы сделали",21,31],["فِيهَا","на ней",21,31],["فِجَاجٗا","широкие проходы",21,31],["سُبُلٗا","дорогами",21,31],["لَّعَلَّهُمۡ","чтобы они",21,31]],[["يَهۡتَدُونَ","шли прямым путём",21,31],[31],["وَجَعَلۡنَا","и Мы сделали",21,32],["ٱلسَّمَآءَ","небо",21,32],["سَقۡفٗا","кровлей",21,32],["مَّحۡفُوظٗاۖ","оберегаемой",21,32],["وَهُمۡ","а они",21,32],["عَنۡ","от",21,32]],[["ءَايَٰتِهَا","знамений его",21,32],["مُعۡرِضُونَ","отворачиваются",21,32],[32],["وَهُوَ","и Он",21,33],["ٱلَّذِي","Тот, Который",21,33],["خَلَقَ","создал",21,33],["ٱلَّيۡلَ","ночь",21,33],["وَٱلنَّهَارَ","и день",21,33],["وَٱلشَّمۡسَ","и солнце",21,33]],[["وَٱلۡقَمَرَۖ","и луну",21,33],["كُلّٞ","все",21,33],["فِي","по",21,33],["فَلَكٖ","орбите",21,33],["يَسۡبَحُونَ","плывут",21,33],[33],["وَمَا","и не",21,34],["جَعَلۡنَا","дали Мы",21,34],["لِبَشَرٖ","человеку",21,34],["مِّن","из",21,34],["قَبۡلِكَ","прежде тебя",21,34]],[["ٱلۡخُلۡدَۖ","бессмертия",21,34],["أَفَإِيْن","разве если",21,34],["مِّتَّ","ты умрёшь",21,34],["فَهُمُ","то они",21,34],["ٱلۡخَٰلِدُونَ","вечно живущие",21,34],[34],["كُلُّ","каждая",21,35],["نَفۡسٖ","душа",21,35],["ذَآئِقَةُ","вкусит",21,35]],[["ٱلۡمَوۡتِۗ","смерть",21,35],["وَنَبۡلُوكُم","и Мы испытываем вас",21,35],["بِٱلشَّرِّ","злом",21,35],["وَٱلۡخَيۡرِ","и добром",21,35],["فِتۡنَةٗۖ","в искушение",21,35],["وَإِلَيۡنَا","и к Нам",21,35],["تُرۡجَعُونَ","вы будете возвращены",21,35],[35]]]}