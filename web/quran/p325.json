{"p":325,"j":17,"a":[[21,36,["وَإِذَا","رَءَاكَ","ٱلَّذِينَ","كَفَرُوٓاْ","إِن","يَتَّخِذُونَكَ","إِلَّا","هُزُوًا","أَهَٰذَا","ٱلَّذِي","يَذۡكُرُ","ءَالِهَتَكُمۡ","وَهُم","بِذِكۡرِ","ٱلرَّحۡمَٰنِ","هُمۡ","كَٰفِرُونَ"],"ва'иза ра'акал лазиина кафаруу ин йаттахизуунака илла хузуан ахазал лазии йазкуру алихатакум вахум бизикрир рахмани хум кафируун","Когда неверующие видят тебя, они лишь насмехаются над тобой и говорят: «Не тот ли это, кто плохо отзывается о ваших богах?». Но сами они не веруют в поминание Милостивого.",["и когда","видят тебя","те, которые","не уверовали","не","берут тебя","кроме как","в насмешку","разве этот","тот, который","поминает","богов ваших","а они","к поминанию","Милостивого","они","неверующие"]],[21,37,["خُلِقَ","ٱلۡإِنسَٰنُ","مِنۡ","عَجَلٖۚ","سَأُوْرِيكُمۡ","ءَايَٰتِي","فَلَا","تَسۡتَعۡجِلُونِ"],"хулиḳал инсану мин `ажалин са'уриикум айатии фала таста`жилуун","Человек сотворен нетерпеливым. Я покажу вам Свои знамения, и посему не торопите Меня.",["сотворён","человек","из","поспешности","Я покажу вам","знамения Мои","так не","торопите Меня"]],[21,38,["وَيَقُولُونَ","مَتَىٰ","هَٰذَا","ٱلۡوَعۡدُ","إِن","كُنتُمۡ","صَٰدِقِينَ"],"вайаḳуулууна мата хазал ва`ду ин кунтум садиḳиин","Они говорят: «Когда же исполнится это обещание, если вы говорите правду?».",["и говорят они","когда","это","обещание","если","вы","правдивы"]],[21,39,["لَوۡ","يَعۡلَمُ","ٱلَّذِينَ","كَفَرُواْ","حِينَ","لَا","يَكُفُّونَ","عَن","وُجُوهِهِمُ","ٱلنَّارَ","وَلَا","عَن","ظُهُورِهِمۡ","وَلَا","هُمۡ","يُنصَرُونَ"],"лау йа`ламул лазиина кафаруу хиина ла йакуффууна `ан вужуухихимун нара вала `ан зухуурихим вала хум йунсаруун","Если бы только неверующие знали о том времени, когда они не смогут отвратить Огонь от своих лиц и своих спин, когда им никто не поможет!",["если бы","знали","те, которые","не уверовали","время","когда не","отвратят они","от","лиц своих","огонь","и не","от","спин своих","и не","им","помогут"]],[21,40,["بَلۡ","تَأۡتِيهِم","بَغۡتَةٗ","فَتَبۡهَتُهُمۡ","فَلَا","يَسۡتَطِيعُونَ","رَدَّهَا","وَلَا","هُمۡ","يُنظَرُونَ"],"бал та'тиихим багтатан фатабхатухум фала йастатии`ууна раддаха вала хум йунзаруун","Он (Ад или День воскресения) настигнет их внезапно и ошеломит их. Они не смогут избавиться от него, и им не будет предоставлена отсрочка.",["нет","придёт к ним","внезапно","и ошеломит их","и не","смогут они","отвратить его","и не","им","дадут отсрочки"]],[21,41,["وَلَقَدِ","ٱسۡتُهۡزِئَ","بِرُسُلٖ","مِّن","قَبۡلِكَ","فَحَاقَ","بِٱلَّذِينَ","سَخِرُواْ","مِنۡهُم","مَّا","كَانُواْ","بِهِۦ","يَسۡتَهۡزِءُونَ"],"валаḳадистухзиа бирусулим мин ḳаблика фахаḳа биллазиина сахируу минхум ма кануу бихии йастахзиуун","До тебя посланники тоже подвергались осмеянию, но тех, которые смеялись над ними, окружило (или поразило) то, над чем они насмехались.",["и уже","подвергались насмешкам","посланники","из","прежде тебя","и постигло","тех, которые","насмехались","из них","то, над чем","они","над ним","глумились"]],[21,42,["قُلۡ","مَن","يَكۡلَؤُكُم","بِٱلَّيۡلِ","وَٱلنَّهَارِ","مِنَ","ٱلرَّحۡمَٰنِۚ","بَلۡ","هُمۡ","عَن","ذِكۡرِ","رَبِّهِم","مُّعۡرِضُونَ"],"ḳул ман йаклаукум биллайли ваннахари минар рахмани бал хум `ан зикри раббихим му`ридуун","Скажи: «Кто способен защитить вас от Милостивого днем или ночью?». Но они отворачиваются от поминания своего Господа.",["скажи","кто","охраняет вас","ночью","и днём","от","Милостивого","нет","они","от","поминания","Господа их","отворачиваются"]],[21,43,["أَمۡ","لَهُمۡ","ءَالِهَةٞ","تَمۡنَعُهُم","مِّن","دُونِنَاۚ","لَا","يَسۡتَطِيعُونَ","نَصۡرَ","أَنفُسِهِمۡ","وَلَا","هُم","مِّنَّا","يُصۡحَبُونَ"],"ам лахум алихатун тамна`ухум мин дуунина ла йастатии`ууна насра анфусихим вала хум минна йусхабуун","Или же у них есть боги, которые могут защитить их от Нас? Они не способны помочь самим себе, и никто не защитит их от Нас.",["или","у них","боги","защищающие их","от","Нас","не","могут они","помочь","самим себе","и не","они","от Нас","будут защищены"]],[21,44,["بَلۡ","مَتَّعۡنَا","هَٰٓؤُلَآءِ","وَءَابَآءَهُمۡ","حَتَّىٰ","طَالَ","عَلَيۡهِمُ","ٱلۡعُمُرُۗ","أَفَلَا","يَرَوۡنَ","أَنَّا","نَأۡتِي","ٱلۡأَرۡضَ","نَنقُصُهَا","مِنۡ","أَطۡرَافِهَآۚ","أَفَهُمُ","ٱلۡغَٰلِبُونَ"],"бал матта`на ха'улаи ва'абаахум хатта тала `алайхимул `умуру афала йарауна анна на'тил арда нанḳусуха мин атрафиха афахумул галибуун","Мы позволили им и их отцам пользоваться благами, так что их жизнь затянулась. Неужели они не видят, что Мы уменьшаем землю по краям (отдаем ее во владение верующим)? Неужели это они одержат верх?",["нет","Мы дали пользоваться","этим","и отцам их","пока","продлилась","для них","жизнь","разве не","видят они","что Мы","приходим","к земле","уменьшая её","с","краёв её","разве они","победители"]]],"m":[[["وَإِذَا","и когда",21,36],["رَءَاكَ","видят тебя",21,36],["ٱلَّذِينَ","те, которые",21,36],["كَفَرُوٓاْ","не уверовали",21,36],["إِن","не",21,36],["يَتَّخِذُونَكَ","берут тебя",21,36],["إِلَّا","кроме как",21,36],["هُزُوًا","в насмешку",21,36]],[["أَهَٰذَا","разве этот",21,36],["ٱلَّذِي","тот, который",21,36],["يَذۡكُرُ","поминает",21,36],["ءَالِهَتَكُمۡ","богов ваших",21,36],["وَهُم","а они",21,36],["بِذِكۡرِ","к поминанию",21,36],["ٱلرَّحۡمَٰنِ","Милостивого",21,36]],[["هُمۡ","они",21,36],["كَٰفِرُونَ","неверующие",21,36],[36],["خُلِقَ","сотворён",21,37],["ٱلۡإِنسَٰنُ","человек",21,37],["مِنۡ","из",21,37],["عَجَلٖۚ","поспешности",21,37],["سَأُوْرِيكُمۡ","Я покажу вам",21,37]],[["ءَايَٰتِي","знамения Мои",21,37],["فَلَا","так не",21,37],["تَسۡتَعۡجِلُونِ","торопите Меня",21,37],[37],["وَيَقُولُونَ","и говорят они",21,38],["مَتَىٰ","когда",21,38],["هَٰذَا","это",21,38],["ٱلۡوَعۡدُ","обещание",21,38]],[["إِن","если",21,38],["كُنتُمۡ","вы",21,38],["صَٰدِقِينَ","правдивы",21,38],[38],["لَوۡ","если бы",21,39],["يَعۡلَمُ","знали",21,39],["ٱلَّذِينَ","те, которые",21,39],["كَفَرُواْ","не уверовали",21,39],["حِينَ","время",21,39]],[["لَا","когда не",21,39],["يَكُفُّونَ","отвратят они",21,39],["عَن","от",21,39],["وُجُوهِهِمُ","лиц своих",21,39],["ٱلنَّارَ","огонь",21,39],["وَلَا","и не",21,39],["عَن","от",21,39],["ظُهُورِهِمۡ","спин своих",21,39],["وَلَا","и не",21,39]],[["هُمۡ","им",21,39],["يُنصَرُونَ","помогут",21,39],[39],["بَلۡ","нет",21,40],["تَأۡتِيهِم","придёт к ним",21,40],["بَغۡتَةٗ","внезапно",21,40],["فَتَبۡهَتُهُمۡ","и ошеломит их",21,40],["فَلَا","и не",21,40]],[["يَسۡتَطِيعُونَ","смогут они",21,40],["رَدَّهَا","отвратить его",21,40],["وَلَا","и не",21,40],["هُمۡ","им",21,40],["يُنظَرُونَ","дадут отсрочки",21,40],[40],["وَلَقَدِ","и уже",21,41],["ٱسۡتُهۡزِئَ","подвергались насмешкам",21,41]],[["بِرُسُلٖ","посланники",21,41],["مِّن","из",21,41],["قَبۡلِكَ","прежде тебя",21,41],["فَحَاقَ","и постигло",21,41],["بِٱلَّذِينَ","тех, которые",21,41],["سَخِرُواْ","насмехались",21,41],["مِنۡهُم","из них",21,41],["مَّا","то, над чем",21,41],["كَانُواْ","они",21,41],["بِهِۦ","над ним",21,41]],[["يَسۡتَهۡزِءُونَ","глумились",21,41],[41],["قُلۡ","скажи",21,42],["مَن","кто",21,42],["يَكۡلَؤُكُم","охраняет вас",21,42],["بِٱلَّيۡلِ","ночью",21,42],["وَٱلنَّهَارِ","и днём",21,42],["مِنَ","от",21,42]],[["ٱلرَّحۡمَٰنِۚ","Милостивого",21,42],["بَلۡ","нет",21,42],["هُمۡ","они",21,42],["عَن","от",21,42],["ذِكۡرِ","поминания",21,42],["رَبِّهِم","Господа их",21,42],["مُّعۡرِضُونَ","отворачиваются",21,42],[42],["أَمۡ","или",21,43]],[["لَهُمۡ","у них",21,43],["ءَالِهَةٞ","боги",21,43],["تَمۡنَعُهُم","защищающие их",21,43],["مِّن","от",21,43],["دُونِنَاۚ","Нас",21,43],["لَا","не",21,43],["يَسۡتَطِيعُونَ","могут они",21,43],["نَصۡرَ","помочь",21,43]],[["أَنفُسِهِمۡ","самим себе",21,43],["وَلَا","и не",21,43],["هُم","они",21,43],["مِّنَّا","от Нас",21,43],["يُصۡحَبُونَ","будут защищены",21,43],[43],["بَلۡ","нет",21,44],["مَتَّعۡنَا","Мы дали пользоваться",21,44],["هَٰٓؤُلَآءِ","этим",21,44]],[["وَءَابَآءَهُمۡ","и отцам их",21,44],["حَتَّىٰ","пока",21,44],["طَالَ","продлилась",21,44],["عَلَيۡهِمُ","для них",21,44],["ٱلۡعُمُرُۗ","жизнь",21,44],["أَفَلَا","разве не",21,44],["يَرَوۡنَ","видят они",21,44],["أَنَّا","что Мы",21,44],["نَأۡتِي","приходим",21,44]],[["ٱلۡأَرۡ