{"p":326,"j":17,"a":[[21,45,["قُلۡ","إِنَّمَآ","أُنذِرُكُم","بِٱلۡوَحۡيِۚ","وَلَا","يَسۡمَعُ","ٱلصُّمُّ","ٱلدُّعَآءَ","إِذَا","مَا","يُنذَرُونَ"],"ḳул иннама унзирукум билвахйи вала йасма`ус суммуд ду`аа иза ма йунзаруун","Скажи: «Я предостерегаю вас посредством откровения». Но глухие не слышат зова, даже когда их предостерегают.",["скажи","лишь","я предостерегаю вас","откровением","но не","слышат","глухие","зова","когда","же","их предостерегают"]],[21,46,["وَلَئِن","مَّسَّتۡهُمۡ","نَفۡحَةٞ","مِّنۡ","عَذَابِ","رَبِّكَ","لَيَقُولُنَّ","يَٰوَيۡلَنَآ","إِنَّا","كُنَّا","ظَٰلِمِينَ"],"валаим массатхум нафхатум мин `азаби раббика лайаḳуулунна йавайлана инна кунна залимиин","А если их коснется дуновение кары твоего Господа, то они непременно скажут: «О горе нам! Воистину, мы были несправедливы!».",["и если","коснётся их","дуновение","от","наказания","Господа твоего","непременно скажут они","о горе нам","поистине, мы","были","несправедливыми"]],[21,47,["وَنَضَعُ","ٱلۡمَوَٰزِينَ","ٱلۡقِسۡطَ","لِيَوۡمِ","ٱلۡقِيَٰمَةِ","فَلَا","تُظۡلَمُ","نَفۡسٞ","شَيۡـٔٗاۖ","وَإِن","كَانَ","مِثۡقَالَ","حَبَّةٖ","مِّنۡ","خَرۡدَلٍ","أَتَيۡنَا","بِهَاۗ","وَكَفَىٰ","بِنَا","حَٰسِبِينَ"],"ванада`ул мавазиинал ḳиста лийаумил ḳийамати фала тузламу нафсун шай'ан ва'ин кана мисḳала хаббатим мин хардалин атайна биха вакафа бина хасибиин","В День воскресения Мы установим справедливые Весы, и ни с кем не поступят несправедливо. Если найдется нечто весом с горчичное зернышко, Мы принесем его. Довольно того, что Мы ведем счет!",["и Мы установим","весы","справедливые","в День","воскресения","и не","будет обижена","душа","ни в чём","и если","будет","вес","зерна","из","горчицы","Мы принесём","его","и довольно","Нас","как ведущих счёт"]],[21,48,["وَلَقَدۡ","ءَاتَيۡنَا","مُوسَىٰ","وَهَٰرُونَ","ٱلۡفُرۡقَانَ","وَضِيَآءٗ","وَذِكۡرٗا","لِّلۡمُتَّقِينَ"],"валаḳад атайна мууса вахаруунал фурḳана вадийаан вазикрал лилмуттаḳиин","Мы даровали Мусе (Моисею) и Харуну (Аарону) различение (способность различать истину ото лжи), сияние (Таурат) и напоминание для богобоязненных,",["и уже","Мы даровали","Мусе","и Харуну","Различение","и свет","и напоминание","для богобоязненных"]],[21,49,["ٱلَّذِينَ","يَخۡشَوۡنَ","رَبَّهُم","بِٱلۡغَيۡبِ","وَهُم","مِّنَ","ٱلسَّاعَةِ","مُشۡفِقُونَ"],"аллазиина йахшауна раббахум билгайби вахум минас са`ати мушфиḳуун","которые боятся своего Господа, не видя Его воочию, и трепещут перед Часом.",["те, которые","боятся","Господа своего","втайне","и они","перед","Часом","трепещут"]],[21,50,["وَهَٰذَا","ذِكۡرٞ","مُّبَارَكٌ","أَنزَلۡنَٰهُۚ","أَفَأَنتُمۡ","لَهُۥ","مُنكِرُونَ"],"вахаза зикрум мубаракун анзалнаху афаантум лахуу мункируун","Это - благословенное Напоминание, которое Мы ниспослали. Неужели вы станете отрицать его?",["и это","напоминание","благословенное","Мы ниспослали его","неужели вы","его","отрицаете"]],[21,51,["وَلَقَدۡ","ءَاتَيۡنَآ","إِبۡرَٰهِيمَ","رُشۡدَهُۥ","مِن","قَبۡلُ","وَكُنَّا","بِهِۦ","عَٰلِمِينَ"],"валаḳад атайна ибрахиима рушдахуу мин ḳаблу вакунна бихии `алимиин","Еще раньше Мы даровали Ибрахиму (Аврааму) верное руководство, и Мы были осведомлены о нем.",["и уже","Мы даровали","Ибрахиму","разум его","из","прежде","и были Мы","о нём","знающими"]],[21,52,["إِذۡ","قَالَ","لِأَبِيهِ","وَقَوۡمِهِۦ","مَا","هَٰذِهِ","ٱلتَّمَاثِيلُ","ٱلَّتِيٓ","أَنتُمۡ","لَهَا","عَٰكِفُونَ"],"из ḳала ли'абиихи ваḳаумихии ма хазихит тамасиилул латии антум лаха `акифуун","Вот он сказал своему отцу и народу: «Что это за изваяния, которым вы предаетесь?».",["вот","сказал он","отцу своему","и народу своему","что","эти","изваяния","которым","вы","им","преданы"]],[21,53,["قَالُواْ","وَجَدۡنَآ","ءَابَآءَنَا","لَهَا","عَٰبِدِينَ"],"ḳалуу важадна абаана лаха `абидиин","Они сказали: «Мы видели, что наши отцы поклонялись им».",["сказали они","мы нашли","отцов наших","им","поклоняющимися"]],[21,54,["قَالَ","لَقَدۡ","كُنتُمۡ","أَنتُمۡ","وَءَابَآؤُكُمۡ","فِي","ضَلَٰلٖ","مُّبِينٖ"],"ḳала лаḳад кунтум антум ва'абаукум фии далалим мубиин","Он сказал: «Воистину, вы и ваши отцы пребываете в очевидном заблуждении».",["сказал он","уже","были","вы","и отцы ваши","в","заблуждении","явном"]],[21,55,["قَالُوٓاْ","أَجِئۡتَنَا","بِٱلۡحَقِّ","أَمۡ","أَنتَ","مِنَ","ٱللَّٰعِبِينَ"],"ḳалуу ажи'тана билхаḳḳи ам анта минал ла`ибиин","Они сказали: «Ты принес нам истину, или же ты забавляешься?».",["сказали они","пришёл ли ты к нам","с истиной","или","ты","из","забавляющихся"]],[21,56,["قَالَ","بَل","رَّبُّكُمۡ","رَبُّ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِ","ٱلَّذِي","فَطَرَهُنَّ","وَأَنَا۠","عَلَىٰ","ذَٰلِكُم","مِّنَ","ٱلشَّٰهِدِينَ"],"ḳала бал рраббукум раббус самавати вал'ардил лазии фатарахунна ва'ана `ала заликум минаш шахидиин","Он сказал: «О нет! Ваш Господь - Господь небес и земли, Который создал их. Я же являюсь одним из тех, кто свидетельствует об этом».",["сказал он","нет","Господь ваш","Господь","небес","и земли","Который","сотворил их","и я","о","том","из","свидетельствующих"]],[21,57,["وَتَٱللَّهِ","لَأَكِيدَنَّ","أَصۡنَٰمَكُم","بَعۡدَ","أَن","تُوَلُّواْ","مُدۡبِرِينَ"],"ваталлахи ла'акииданна аснамакум ба`да ан туаллуу мудбириин","Ибрахим подумал: «Клянусь Аллахом! Я непременно замыслю хитрость против ваших идолов, когда вы уйдете и отвернетесь».",["и клянусь Аллахом","непременно ухищрюсь","против идолов ваших","после","того как","вы уйдёте","повернувшись спиной"]]],"m":[[["قُلۡ","скажи",21,45],["إِنَّمَآ","лишь",21,45],["أُنذِرُكُم","я предостерегаю вас",21,45],["بِٱلۡوَحۡيِۚ","откровением",21,45],["وَلَا","но не",21,45],["يَسۡمَعُ","слышат",21,45],["ٱلصُّمُّ","глухие",21,45],["ٱلدُّعَآءَ","зова",21,45],["إِذَا","когда",21,45]],[["مَا","же",21,45],["يُنذَرُونَ","их предостерегают",21,45],[45],["وَلَئِن","и если",21,46],["مَّسَّتۡهُمۡ","коснётся их",21,46],["نَفۡحَةٞ","дуновение",21,46],["مِّنۡ","от",21,46],["عَذَابِ","наказания",21,46],["رَبِّكَ","Господа твоего",21,46]],[["لَيَقُولُنَّ","непременно скажут они",21,46],["يَٰوَيۡلَنَآ","о горе нам",21,46],["إِنَّا","поистине, мы",21,46],["كُنَّا","были",21,46],["ظَٰلِمِينَ","несправедливыми",21,46],[46],["وَنَضَعُ","и Мы установим",21,47],["ٱلۡمَوَٰزِينَ","весы",21,47]],[["ٱلۡقِسۡطَ","справедливые",21,47],["لِيَوۡمِ","в День",21,47],["ٱلۡقِيَٰمَةِ","воскресения",21,47],["فَلَا","и не",21,47],["تُظۡلَمُ","будет обижена",21,47],["نَفۡسٞ","душа",21,47],["شَيۡـٔٗاۖ","ни в чём",21,47],["وَإِن","и если",21,47],["كَانَ","будет",21,47]],[["مِثۡقَالَ","вес",21,47],["حَبَّةٖ","зерна",21,47],["مِّنۡ","из",21,47],["خَرۡدَلٍ","горчицы",21,47],["أَتَيۡنَا","Мы принесём",21,47],["بِهَاۗ","его",21,47],["وَكَفَىٰ","и довольно",21,47],["بِنَا","Нас",21,47],["حَٰسِبِينَ","как ведущих счёт",21,47]],[[47],["وَلَقَدۡ","и уже",21,48],["ءَاتَيۡنَا","Мы даровали",21,48],["مُوسَىٰ","Мусе",21,48],["وَهَٰرُونَ","и Харуну",21,48],["ٱلۡفُرۡقَانَ","Различение",21,48],["وَضِيَآءٗ","и свет",21,48],["وَذِكۡرٗا","и напоминание",21,48]],[["لِّلۡمُتَّقِينَ","для богобоязненных",21,48],[48],["ٱلَّذِينَ","те, которые",21,49],["يَخۡشَوۡنَ","боятся",21,49],["رَبَّهُم","Господа своего",21,49],["بِٱلۡغَيۡبِ","втайне",21,49],["وَهُم","и они",21,49],["مِّنَ","перед",21,49]],[["ٱلسَّاعَةِ","Часом",21,49],["مُشۡفِقُونَ","трепещут",21,49],[49],["وَهَٰذَا","и это",21,50],["ذِكۡرٞ","напоминание",21,50],["مُّبَارَكٌ","благословенное",21,50],["أَنزَلۡنَٰهُۚ","Мы ниспослали его",21,50],["أَفَأَنتُمۡ","неужели вы",21,50],["لَهُۥ","его",21,50]],[["مُنكِرُونَ","отрицаете",21,50],[50],["۞ وَلَقَدۡ","и уже",21,51],["ءَاتَيۡنَآ","Мы даровали",21,51],["إِبۡرَٰهِيمَ","Ибрахиму",21,51],["رُشۡدَهُۥ","разум его",21,51],["مِن","из",21,51],["قَبۡلُ","прежде",21,51],["وَكُنَّا","и были Мы",21,51]],[["بِهِۦ","о нём",21,51],["عَٰلِمِينَ","знающими",21,51],[51],["إِذۡ","вот",21,52],["قَالَ","сказал он",21,52],["لِأَبِيهِ","отцу своему",21,52],["وَقَوۡمِهِۦ","и народу своему",21,52],["مَا","что",21,52],["هَٰذِهِ","эти",21,52],["ٱلتَّمَاثِيلُ","изваяния",21,52],["ٱلَّتِيٓ","которым",21,52]],[["أَنتُمۡ","вы",21,52],["لَهَا","им",21,52],["عَٰكِفُونَ","преданы",21,52],[52],["قَالُواْ","сказали они",21,53],["وَجَدۡنَآ","мы нашли",21,53],["ءَابَآءَنَا","отцов наших",21,53],["لَهَا","им",21,53],["عَٰبِدِينَ","поклоняющимися",21,53],[53]],[["قَالَ","сказал он",21,54],["لَقَدۡ","уже",21,54],["كُنتُمۡ","были",21,54],["أَنتُمۡ","вы",21,54],["وَءَابَآؤُكُمۡ","и отцы ваши",21,54],["فِي","в",21,54],["ضَلَٰلٖ","заблуждении",21,54],["مُّبِينٖ","явном",21,54],[54],["قَالُوٓاْ","сказали они",21,55]],[["أَجِئۡتَنَا","пришёл ли ты к нам",21,55],["بِٱلۡحَقِّ","с истиной",21,55],["أَمۡ","или",21,55],["أَنتَ","ты",21,55],["مِنَ","из",21,55],["ٱللَّٰعِبِينَ","забавляющихся",21,55],[55],["قَالَ","сказал он",21,56],["بَل","нет",21,56],["رَّبُّكُمۡ","Господь ваш",21,56],["رَبُّ","Господь",21,56],["ٱلسَّمَٰوَٰتِ","небес",21,56]],[["وَٱلۡأَرۡضِ","и земли",21,56],["ٱلَّذِي","Который",21,56],["فَطَرَهُنَّ","сотворил их",21,56],["وَأَنَا۠","и я",21,56],["عَلَىٰ","о",21,56],["ذَٰلِكُم","том",21,56],["مِّنَ","из",21,56],["ٱلشَّٰهِدِينَ","свидетельствующих",21,56]],[[56],["وَتَٱللَّهِ","и клянусь Аллахом",21,57],["لَأَكِيدَنَّ","непременно ухищрюсь",21,57],["أَصۡنَٰمَكُم","против идолов ваших",21,57],["بَعۡدَ","после",21,57],["أَن","того как",21,57],["تُوَلُّواْ","вы уйдёте",21,57],["مُدۡبِرِينَ","повернувшись спиной",21,57],[57]]]}