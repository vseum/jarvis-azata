{"p":327,"j":17,"a":[[21,58,["فَجَعَلَهُمۡ","جُذَٰذًا","إِلَّا","كَبِيرٗا","لَّهُمۡ","لَعَلَّهُمۡ","إِلَيۡهِ","يَرۡجِعُونَ"],"фажа`алахум жузазан илла кабиирал лахум ла`аллахум илайхи йаржи`уун","Затем он разнес на куски всех идолов, кроме главного из них, чтобы они могли обратиться к нему.",["и сделал он их","обломками","кроме","главного","у них","чтобы они","к нему","обратились"]],[21,59,["قَالُواْ","مَن","فَعَلَ","هَٰذَا","بِـَٔالِهَتِنَآ","إِنَّهُۥ","لَمِنَ","ٱلظَّٰلِمِينَ"],"ḳалуу ман фа`ала хаза би'алихатина иннахуу ламиназ залимиин","Они сказали: «Кто поступил так с нашими богами? Воистину, он является одним из беззаконников!».",["сказали они","кто","сделал","это","с богами нашими","поистине, он","непременно из","беззаконников"]],[21,60,["قَالُواْ","سَمِعۡنَا","فَتٗى","يَذۡكُرُهُمۡ","يُقَالُ","لَهُۥٓ","إِبۡرَٰهِيمُ"],"ḳалуу сами`на фатан йазкурухум йуḳалу лахуу ибрахиим","Они сказали: «Мы слышали, как юноша по имени Ибрахим (Авраам) выступал против них».",["сказали они","мы слышали","юношу","упоминает их","зовётся","ему","Ибрахим"]],[21,61,["قَالُواْ","فَأۡتُواْ","بِهِۦ","عَلَىٰٓ","أَعۡيُنِ","ٱلنَّاسِ","لَعَلَّهُمۡ","يَشۡهَدُونَ"],"ḳалуу фа'туу бихии `ала а`йунин наси ла`аллахум йашхадуун","Они сказали: «Приведите же его пред людские очи, чтобы они могли принести свидетельство».",["сказали","так приведите","его","пред","очами","людей","чтобы они","засвидетельствовали"]],[21,62,["قَالُوٓاْ","ءَأَنتَ","فَعَلۡتَ","هَٰذَا","بِـَٔالِهَتِنَا","يَٰٓإِبۡرَٰهِيمُ"],"ḳалуу а'анта фа`алта хаза би'алихатина йа'ибрахиим","Они сказали: «О Ибрахим (Авраам)! Ты ли поступил таким образом с нашими богами?».",["сказали они","ты ли","сделал","это","с богами нашими","о Ибрахим"]],[21,63,["قَالَ","بَلۡ","فَعَلَهُۥ","كَبِيرُهُمۡ","هَٰذَا","فَسۡـَٔلُوهُمۡ","إِن","كَانُواْ","يَنطِقُونَ"],"ḳала бал фа`алахуу кабиирухум хаза фас'алуухум ин кануу йантиḳуун","Он сказал: «Нет! Это содеял их старший, вот этот. Спросите их самих, если они способны разговаривать».",["сказал он","нет","сделал это","старший их","этот","так спросите их","если","они","говорят"]],[21,64,["فَرَجَعُوٓاْ","إِلَىٰٓ","أَنفُسِهِمۡ","فَقَالُوٓاْ","إِنَّكُمۡ","أَنتُمُ","ٱلظَّٰلِمُونَ"],"фаража`уу ила анфусихим фаḳалуу иннакум антумуз залимуун","Обратившись друг к другу, они сказали: «Воистину, вы сами являетесь беззаконниками!».",["и обратились они","к","самим себе","и сказали","поистине, вы","вы","беззаконники"]],[21,65,["ثُمَّ","نُكِسُواْ","عَلَىٰ","رُءُوسِهِمۡ","لَقَدۡ","عَلِمۡتَ","مَا","هَٰٓؤُلَآءِ","يَنطِقُونَ"],"сумма нукисуу `ала ру'уусихим лаḳад `алимта ма ха'улаи йантиḳуун","Затем они принялись за свое и сказали: «Ты же знаешь, что они не способны разговаривать».",["затем","опрокинулись они","на","головы свои","уже","ты знаешь","не","эти","говорят"]],[21,66,["قَالَ","أَفَتَعۡبُدُونَ","مِن","دُونِ","ٱللَّهِ","مَا","لَا","يَنفَعُكُمۡ","شَيۡـٔٗا","وَلَا","يَضُرُّكُمۡ"],"ḳала афата`будууна мин дууниллахи ма ла йанфа`укум шай'ан вала йадуррукум","Он сказал: «Неужели вы поклоняетесь вместо Аллаха тому, что ничем не способно помочь или навредить вам?",["сказал он","неужели поклоняетесь","из","помимо","Аллаха","тому, что","не","приносит пользы вам","ничем","и не","вредит вам"]],[21,67,["أُفّٖ","لَّكُمۡ","وَلِمَا","تَعۡبُدُونَ","مِن","دُونِ","ٱللَّهِۚ","أَفَلَا","تَعۡقِلُونَ"],"уффил лакум валима та`будууна мин дууниллахи афала та`ḳилуун","Тьфу на вас и на то, чему вы поклоняетесь вместо Аллаха! Неужели же вы не образумитесь?».",["тьфу","на вас","и на то, чему","вы поклоняетесь","из","помимо","Аллаха","неужели не","вы разумеете"]],[21,68,["قَالُواْ","حَرِّقُوهُ","وَٱنصُرُوٓاْ","ءَالِهَتَكُمۡ","إِن","كُنتُمۡ","فَٰعِلِينَ"],"ḳалуу харриḳууху вансуруу алихатакум ин кунтум фа`илиин","Они сказали: «Сожгите его и помогите вашим богам, если вы будете действовать!».",["Они сказали","сожгите его","и помогите","вашим богам","если","вы","действующие"]],[21,69,["قُلۡنَا","يَٰنَارُ","كُونِي","بَرۡدٗا","وَسَلَٰمًا","عَلَىٰٓ","إِبۡرَٰهِيمَ"],"ḳулна йанару куунии бардан васаламан `ала ибрахиим","Мы сказали: «О огонь! Стань для Ибрахима (Авраама) прохладой и спасением!».",["Мы сказали","о огонь","стань","прохладой","и спасением","для","Ибрахима"]],[21,70,["وَأَرَادُواْ","بِهِۦ","كَيۡدٗا","فَجَعَلۡنَٰهُمُ","ٱلۡأَخۡسَرِينَ"],"ва'арадуу бихии кайдан фажа`алнахумул ахсариин","Они хотели навредить ему, но Мы сделали так, что они оказались в наибольшем убытке.",["И они хотели","ему","козни","и Мы сделали их","потерпевшими наибольший убыток"]],[21,71,["وَنَجَّيۡنَٰهُ","وَلُوطًا","إِلَى","ٱلۡأَرۡضِ","ٱلَّتِي","بَٰرَكۡنَا","فِيهَا","لِلۡعَٰلَمِينَ"],"ванажжайнаху валуутан илал ардил латии баракна фииха лил`аламиин","Мы спасли его и Лута (Лота) и привели их на землю, которую Мы сделали благословенной для миров.",["И Мы спасли его","и Лута","в","землю","которую","Мы благословили","в ней","для миров"]],[21,72,["وَوَهَبۡنَا","لَهُۥٓ","إِسۡحَٰقَ","وَيَعۡقُوبَ","نَافِلَةٗۖ","وَكُلّٗا","جَعَلۡنَا","صَٰلِحِينَ"],"вавахабна лахуу исхаḳа вайа`ḳууба нафилатан вакуллан жа`ална салихиин","Мы даровали ему Исхака (Исаака), а вдобавок - Йакуба (Иакова), и сделали их всех праведниками.",["И Мы даровали","ему","Исхака","и Йакуба","вдобавок","и всех","Мы сделали","праведниками"]]],"m":[[["فَجَعَلَهُمۡ","и сделал он их",21,58],["جُذَٰذًا","обломками",21,58],["إِلَّا","кроме",21,58],["كَبِيرٗا","главного",21,58],["لَّهُمۡ","у них",21,58],["لَعَلَّهُمۡ","чтобы они",21,58],["إِلَيۡهِ","к нему",21,58],["يَرۡجِعُونَ","обратились",21,58]],[[58],["قَالُواْ","сказали они",21,59],["مَن","кто",21,59],["فَعَلَ","сделал",21,59],["هَٰذَا","это",21,59],["بِـَٔالِهَتِنَآ","с богами нашими",21,59],["إِنَّهُۥ","поистине, он",21,59],["لَمِنَ","непременно из",21,59],["ٱلظَّٰلِمِينَ","беззаконников",21,59],[59]],[["قَالُواْ","сказали они",21,60],["سَمِعۡنَا","мы слышали",21,60],["فَتٗى","юношу",21,60],["يَذۡكُرُهُمۡ","упоминает их",21,60],["يُقَالُ","зовётся",21,60],["لَهُۥٓ","ему",21,60],["إِبۡرَٰهِيمُ","Ибрахим",21,60],[60],["قَالُواْ","сказали",21,61],["فَأۡتُواْ","так приведите",21,61],["بِهِۦ","его",21,61]],[["عَلَىٰٓ","пред",21,61],["أَعۡيُنِ","очами",21,61],["ٱلنَّاسِ","людей",21,61],["لَعَلَّهُمۡ","чтобы они",21,61],["يَشۡهَدُونَ","засвидетельствовали",21,61],[61],["قَالُوٓاْ","сказали они",21,62],["ءَأَنتَ","ты ли",21,62],["فَعَلۡتَ","сделал",21,62]],[["هَٰذَا","это",21,62],["بِـَٔالِهَتِنَا","с богами нашими",21,62],["يَٰٓإِبۡرَٰهِيمُ","о Ибрахим",21,62],[62],["قَالَ","сказал он",21,63],["بَلۡ","нет",21,63],["فَعَلَهُۥ","сделал это",21,63],["كَبِيرُهُمۡ","старший их",21,63]],[["هَٰذَا","этот",21,63],["فَسۡـَٔلُوهُمۡ","так спросите их",21,63],["إِن","если",21,63],["كَانُواْ","они",21,63],["يَنطِقُونَ","говорят",21,63],[63],["فَرَجَعُوٓاْ","и обратились они",21,64],["إِلَىٰٓ","к",21,64]],[["أَنفُسِهِمۡ","самим себе",21,64],["فَقَالُوٓاْ","и сказали",21,64],["إِنَّكُمۡ","поистине, вы",21,64],["أَنتُمُ","вы",21,64],["ٱلظَّٰلِمُونَ","беззаконники",21,64],[64],["ثُمَّ","затем",21,65],["نُكِسُواْ","опрокинулись они",21,65],["عَلَىٰ","на",21,65]],[["رُءُوسِهِمۡ","головы свои",21,65],["لَقَدۡ","уже",21,65],["عَلِمۡتَ","ты знаешь",21,65],["مَا","не",21,65],["هَٰٓؤُلَآءِ","эти",21,65],["يَنطِقُونَ","говорят",21,65],[65],["قَالَ","сказал он",21,66]],[["أَفَتَعۡبُدُونَ","неужели поклоняетесь",21,66],["مِن","из",21,66],["دُونِ","помимо",21,66],["ٱللَّهِ","Аллаха",21,66],["مَا","тому, что",21,66],["لَا","не",21,66],["يَنفَعُكُمۡ","приносит пользы вам",21,66],["شَيۡـٔٗا","ничем",21,66],["وَلَا","и не",21,66]],[["يَضُرُّكُمۡ","вредит вам",21,66],[66],["أُفّٖ","тьфу",21,67],["لَّكُمۡ","на вас",21,67],["وَلِمَا","и на то, чему",21,67],["تَعۡبُدُونَ","вы поклоняетесь",21,67],["مِن","из",21,67],["دُونِ","помимо",21,67],["ٱللَّهِۚ","Аллаха",21,67],["أَفَلَا","неужели не",21,67]],[["تَعۡقِلُونَ","вы разумеете",21,67],[67],["قَالُواْ","Они сказали",21,68],["حَرِّقُوهُ","сожгите его",21,68],["وَٱنصُرُوٓاْ","и помогите",21,68],["ءَالِهَتَكُمۡ","вашим богам",21,68],["إِن","если",21,68],["كُنتُمۡ","вы",21,68]],[["فَٰعِلِينَ","действующие",21,68],[68],["قُلۡنَا","Мы сказали",21,69],