{"p":328,"j":17,"a":[[21,73,["وَجَعَلۡنَٰهُمۡ","أَئِمَّةٗ","يَهۡدُونَ","بِأَمۡرِنَا","وَأَوۡحَيۡنَآ","إِلَيۡهِمۡ","فِعۡلَ","ٱلۡخَيۡرَٰتِ","وَإِقَامَ","ٱلصَّلَوٰةِ","وَإِيتَآءَ","ٱلزَّكَوٰةِۖ","وَكَانُواْ","لَنَا","عَٰبِدِينَ"],"важа`алнахум а'имматан йахдууна би'амрина ва'аухайна илайхим фи`лал хайрати ва'иḳамас салавати ва'иитааз закавати вакануу лана `абидиин","Мы сделали их вождями, которые по Нашему велению указывали на прямой путь. Мы внушили им вершить добрые дела, совершать намаз и выплачивать закят, и они поклонялись Нам.",["И Мы сделали их","вождями","они ведут","по Нашему велению","и Мы внушили","им","совершать","добрые дела","и выстаивание","намаза","и выплату","закята","и были они","Нам","поклоняющимися"]],[21,74,["وَلُوطًا","ءَاتَيۡنَٰهُ","حُكۡمٗا","وَعِلۡمٗا","وَنَجَّيۡنَٰهُ","مِنَ","ٱلۡقَرۡيَةِ","ٱلَّتِي","كَانَت","تَّعۡمَلُ","ٱلۡخَبَٰٓئِثَۚ","إِنَّهُمۡ","كَانُواْ","قَوۡمَ","سَوۡءٖ","فَٰسِقِينَ"],"валуутан атайнаху хукман ва`илман ванажжайнаху минал ḳарйатил латии канат та`малул хабаиса иннахум кануу ḳаума сауин фасиḳиин","Помяни также Лута (Лота), которому Мы даровали власть (мудрость или пророчество) и знание и которого Мы спасли от селения, жители которого совершали отвратительные поступки. Воистину, они были злодеями и нечестивцами.",["И Луту","Мы даровали ему","мудрость","и знание","и Мы спасли его","от","селения","которое","было","творило","мерзости","поистине, они","были","людьми","зла","нечестивыми"]],[21,75,["وَأَدۡخَلۡنَٰهُ","فِي","رَحۡمَتِنَآۖ","إِنَّهُۥ","مِنَ","ٱلصَّٰلِحِينَ"],"ва'адхалнаху фии рахматина иннахуу минас салихиин","Мы ввели его в Нашу милость, поскольку он был одним из праведников.",["и ввели Мы его","в","Нашу милость","поистине, он","из","праведников"]],[21,76,["وَنُوحًا","إِذۡ","نَادَىٰ","مِن","قَبۡلُ","فَٱسۡتَجَبۡنَا","لَهُۥ","فَنَجَّيۡنَٰهُ","وَأَهۡلَهُۥ","مِنَ","ٱلۡكَرۡبِ","ٱلۡعَظِيمِ"],"вануухан из нада мин ḳаблу фастажабна лахуу фанажжайнаху ва'ахлахуу минал карбил `азиим","Помяни также Нуха (Ноя), который воззвал еще раньше. Мы ответили на его мольбу и спасли его и его семью от великой скорби.",["И Нуха","когда","он воззвал","прежде","прежде","и Мы ответили","ему","и спасли его","и его семью","от","скорби","великой"]],[21,77,["وَنَصَرۡنَٰهُ","مِنَ","ٱلۡقَوۡمِ","ٱلَّذِينَ","كَذَّبُواْ","بِـَٔايَٰتِنَآۚ","إِنَّهُمۡ","كَانُواْ","قَوۡمَ","سَوۡءٖ","فَأَغۡرَقۡنَٰهُمۡ","أَجۡمَعِينَ"],"ванасарнаху минал ḳаумил лазиина каззабуу би'айатина иннахум кануу ḳаума сауин фа'аграḳнахум ажма`иин","Мы помогли ему в борьбе против людей, которые считали ложью Наши знамения. Они были злодеями, и Мы потопили их всех.",["И Мы помогли ему","против","людей","которые","сочли ложью","Наши знамения","поистине, они","были","людьми","зла","и Мы потопили их","всех"]],[21,78,["وَدَاوُۥدَ","وَسُلَيۡمَٰنَ","إِذۡ","يَحۡكُمَانِ","فِي","ٱلۡحَرۡثِ","إِذۡ","نَفَشَتۡ","فِيهِ","غَنَمُ","ٱلۡقَوۡمِ","وَكُنَّا","لِحُكۡمِهِمۡ","شَٰهِدِينَ"],"вадавууда васулаймана из йахкумани фил харси из нафашат фиихи ганамул ḳауми вакунна лихукмихим шахидиин","Помяни также Давуда (Давида) и Сулеймана (Соломона), которые судили о ниве, потравленной ночью чужими овцами. Мы были Свидетелями их суда.",["И Давуда","и Сулеймана","когда","они двое судили","о","ниве","когда","потравили ночью","её","овцы","людей","и Мы были","их суду","свидетелями"]],[21,79,["فَفَهَّمۡنَٰهَا","سُلَيۡمَٰنَۚ","وَكُلًّا","ءَاتَيۡنَا","حُكۡمٗا","وَعِلۡمٗاۚ","وَسَخَّرۡنَا","مَعَ","دَاوُۥدَ","ٱلۡجِبَالَ","يُسَبِّحۡنَ","وَٱلطَّيۡرَۚ","وَكُنَّا","فَٰعِلِينَ"],"фафаххамнаха сулаймана вакуллан атайна хукман ва`илман васаххарна ма`а давуудал жибала йусаббихна ваттайра вакунна фа`илиин","Мы помогли Сулейману (Соломону) разобраться в этом и даровали им обоим власть (мудрость или пророчество) и знание. Мы подчинили горы и птиц для того, чтобы они славили Нас вместе с Давудом (Давидом). Мы это сделали.",["И Мы дали понять это","Сулейману","и каждому","Мы даровали","мудрость","и знание","и Мы подчинили","вместе с","Давудом","горы","прославляющие","и птиц","и Мы были","делающими (это)"]],[21,80,["وَعَلَّمۡنَٰهُ","صَنۡعَةَ","لَبُوسٖ","لَّكُمۡ","لِتُحۡصِنَكُم","مِّنۢ","بَأۡسِكُمۡۖ","فَهَلۡ","أَنتُمۡ","شَٰكِرُونَ"],"ва`алламнаху сан`ата лабуусил лакум литухсинакум мим ба'сикум фахал антум шакируун","Мы научили его (Давуда) изготовлять для вас кольчуги, чтобы они предохраняли вас от причиняемого вами вреда. Но разве вы благодарны?",["И Мы научили его","изготовлению","кольчуг","для вас","чтобы защищали вас","от","вашей ярости в бою","так разве","вы","благодарны"]],[21,81,["وَلِسُلَيۡمَٰنَ","ٱلرِّيحَ","عَاصِفَةٗ","تَجۡرِي","بِأَمۡرِهِۦٓ","إِلَى","ٱلۡأَرۡضِ","ٱلَّتِي","بَٰرَكۡنَا","فِيهَاۚ","وَكُنَّا","بِكُلِّ","شَيۡءٍ","عَٰلِمِينَ"],"валисулайманар рииха `асифатан тажрии би'амрихии илал ардил латии баракна фииха вакунна бикулли шай'ин `алимиин","Мы подчинили Сулейману (Соломону) сильный ветер, который дул по его повелению на землю, которую Мы благословили. Мы знаем о всякой вещи.",["И Сулейману","ветер","сильный","дующий","по его велению","к","земле","которую","Мы благословили","в ней","и Мы были","о всякой","вещи","знающие"]]],"m":[[["وَجَعَلۡنَٰهُمۡ","И Мы сделали их",21,73],["أَئِمَّةٗ","вождями",21,73],["يَهۡدُونَ","они ведут",21,73],["بِأَمۡرِنَا","по Нашему велению",21,73],["وَأَوۡحَيۡنَآ","и Мы внушили",21,73],["إِلَيۡهِمۡ","им",21,73],["فِعۡلَ","совершать",21,73]],[["ٱلۡخَيۡرَٰتِ","добрые дела",21,73],["وَإِقَامَ","и выстаивание",21,73],["ٱلصَّلَوٰةِ","намаза",21,73],["وَإِيتَآءَ","и выплату",21,73],["ٱلزَّكَوٰةِۖ","закята",21,73],["وَكَانُواْ","и были они",21,73],["لَنَا","Нам",21,73]],[["عَٰبِدِينَ","поклоняющимися",21,73],[73],["وَلُوطًا","И Луту",21,74],["ءَاتَيۡنَٰهُ","Мы даровали ему",21,74],["حُكۡمٗا","мудрость",21,74],["وَعِلۡمٗا","и знание",21,74],["وَنَجَّيۡنَٰهُ","и Мы спасли его",21,74],["مِنَ","от",21,74]],[["ٱلۡقَرۡيَةِ","селения",21,74],["ٱلَّتِي","которое",21,74],["كَانَت","было",21,74],["تَّعۡمَلُ","творило",21,74],["ٱلۡخَبَٰٓئِثَۚ","мерзости",21,74],["إِنَّهُمۡ","поистине, они",21,74],["كَانُواْ","были",21,74],["قَوۡمَ","людьми",21,74],["سَوۡءٖ","зла",21,74]],[["فَٰسِقِينَ","нечестивыми",21,74],[74],["وَأَدۡخَلۡنَٰهُ","и ввели Мы его",21,75],["فِي","в",21,75],["رَحۡمَتِنَآۖ","Нашу милость",21,75],["إِنَّهُۥ","поистине, он",21,75],["مِنَ","из",21,75],["ٱلصَّٰلِحِينَ","праведников",21,75]],[[75],["وَنُوحًا","И Нуха",21,76],["إِذۡ","когда",21,76],["نَادَىٰ","он воззвал",21,76],["مِن","прежде",21,76],["قَبۡلُ","прежде",21,76],["فَٱسۡتَجَبۡنَا","и Мы ответили",21,76],["لَهُۥ","ему",21,76],["فَنَجَّيۡنَٰهُ","и спасли его",21,76]],[["وَأَهۡلَهُۥ","и его семью",21,76],["مِنَ","от",21,76],["ٱلۡكَرۡبِ","скорби",21,76],["ٱلۡعَظِيمِ","великой",21,76],[76],["وَنَصَرۡنَٰهُ","И Мы помогли ему",21,77],["مِنَ","против",21,77],["ٱلۡقَوۡمِ","людей",21,77]],[["ٱلَّذِينَ","которые",21,77],["كَذَّبُواْ","сочли ложью",21,77],["بِـَٔايَٰتِنَآۚ","Наши знамения",21,77],["إِنَّهُمۡ","поистине, они",21,77],["كَانُواْ","были",21,77],["قَوۡمَ","людьми",21,77],["سَوۡءٖ","зла",21,77],["فَأَغۡرَقۡنَٰهُمۡ","и Мы потопили их",21,77]],[["أَجۡمَعِينَ","всех",21,77],[77],["وَدَاوُۥدَ","И Давуда",21,78],["وَسُلَيۡمَٰنَ","и Сулеймана",21,78],["إِذۡ","когда",21,78],["يَحۡكُمَانِ","они двое судили",21,78],["فِي","о",21,78],["ٱلۡحَرۡثِ","ниве",21,78],["إِذۡ","когда",21,78]],[["نَفَشَتۡ","потравили ночью",21,78],["فِيهِ","её",21,78],["غَنَمُ","овцы",21,78],["ٱلۡقَوۡمِ","людей",21,78],["وَكُنَّا","и Мы были",21,78],["لِحُكۡمِهِمۡ","их суду",21,78],["شَٰهِدِينَ","свидетелями",21,78],[78]],[["فَفَهَّمۡنَٰهَا","И Мы дали понять это",21,79],["سُلَيۡمَٰنَۚ","Сулейману",21,79],["وَكُلًّا","и каждому",21,79],["ءَاتَيۡنَا","Мы даровали",21,79],["حُكۡمٗا","мудрость",21,79],["وَعِلۡمٗاۚ","и знание",21,79],["وَسَخَّرۡنَا","и Мы подчинили",21,79]],[["مَعَ","вместе с",21,79],["دَاوُۥدَ","Давудом",21,79],["ٱلۡجِبَالَ","горы",21,79],["يُسَبِّحۡنَ","прославляющие",21,79],["وَٱلطَّيۡرَۚ","и птиц",21,79],["وَكُنَّا","и Мы были",21,79],["فَٰعِلِينَ","делающими (это)",21,79],[79]],[["وَعَلَّمۡنَٰهُ","И Мы научили его",21,80],["صَنۡعَةَ","изготовлению",21,80],["لَبُوسٖ","кольчуг",21,80],["لَّكُمۡ","для вас",21,80],["لِتُحۡصِنَكُم","чтобы защищали вас",21,80],["مِّنۢ","от",21,80],["بَأۡسِكُمۡۖ","вашей ярости в бою",21,80]],[["فَهَلۡ","так разве",21,80],["أَنتُمۡ","вы",21,80],["شَٰكِرُونَ","благодарны",21,80],[80],["وَلِسُلَيۡمَٰنَ","И Сулейману",21,81],["ٱلرِّيحَ","ветер",21,81],["عَاصِفَةٗ","сильный",21,81],["تَجۡرِي","дующий",21,81],["بِأَمۡرِهِۦٓ","по его велению",21,81]],[["إِلَى","к",21,81],["ٱلۡأَرۡضِ","земле",21,81],["ٱلَّتِي","которую",21,81],["بَٰرَكۡنَا","Мы благословили",21,81],["فِيهَاۚ","в ней",21,81],["وَكُنَّا","и Мы были",21,81],["بِكُلِّ","о всякой",21,81],["شَيۡءٍ","вещи",21,81],["عَٰلِمِينَ","знающие",21,81],[81]]]}