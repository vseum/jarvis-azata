{"p":329,"j":17,"a":[[21,82,["وَمِنَ","ٱلشَّيَٰطِينِ","مَن","يَغُوصُونَ","لَهُۥ","وَيَعۡمَلُونَ","عَمَلٗا","دُونَ","ذَٰلِكَۖ","وَكُنَّا","لَهُمۡ","حَٰفِظِينَ"],"ваминаш шайатиини ман йагуусууна лахуу вайа`малууна `амалан дууна залика вакунна лахум хафизиин","Среди дьяволов были такие, которые ныряли для него и выполняли другие работы. Мы стерегли их.",["И из","дьяволов","те, кто","ныряли","для него","и делали","работу","кроме","этого","и Мы были","за ними","стерегущими"]],[21,83,["وَأَيُّوبَ","إِذۡ","نَادَىٰ","رَبَّهُۥٓ","أَنِّي","مَسَّنِيَ","ٱلضُّرُّ","وَأَنتَ","أَرۡحَمُ","ٱلرَّٰحِمِينَ"],"ва'аййууба из нада раббахуу аннии массанийад дурру ва'анта архамур рахимиин","Помяни также Айюба (Иова), который воззвал к своему Господу: «Воистину, меня коснулось зло, а ведь Ты - Милосерднейший из милосердных».",["И Айюба","когда","он воззвал","к своему Господу","что я","коснулся меня","вред","а Ты","Милосерднейший","из милосердных"]],[21,84,["فَٱسۡتَجَبۡنَا","لَهُۥ","فَكَشَفۡنَا","مَا","بِهِۦ","مِن","ضُرّٖۖ","وَءَاتَيۡنَٰهُ","أَهۡلَهُۥ","وَمِثۡلَهُم","مَّعَهُمۡ","رَحۡمَةٗ","مِّنۡ","عِندِنَا","وَذِكۡرَىٰ","لِلۡعَٰبِدِينَ"],"фастажабна лахуу факашафна ма бихии мин дуррин ва'атайнаху ахлахуу вамислахум ма`ахум рахматам мин `индина вазикра лил`абидиин","Мы ответили на его мольбу, устранили постигшее его зло и даровали ему его семью и вдобавок еще столько же в качестве милости от Нас и в назидание тем, кто поклоняется.",["И Мы ответили","ему","и устранили","то, что","с ним","из","вреда","и Мы даровали ему","его семью","и столько же","с ними","милостью","от","Нас","и напоминанием","для поклоняющихся"]],[21,85,["وَإِسۡمَٰعِيلَ","وَإِدۡرِيسَ","وَذَا","ٱلۡكِفۡلِۖ","كُلّٞ","مِّنَ","ٱلصَّٰبِرِينَ"],"ва'исма`иила ва'идрииса вазал кифли куллум минас сабириин","Помяни также Исмаила (Измаила), Идриса, Зулькифла. Все они были из числа терпеливых.",["И Исмаила","и Идриса","и обладателя","поручительства (Зулькифла)","все","из","терпеливых"]],[21,86,["وَأَدۡخَلۡنَٰهُمۡ","فِي","رَحۡمَتِنَآۖ","إِنَّهُم","مِّنَ","ٱلصَّٰلِحِينَ"],"ва'адхалнахум фии рахматина иннахум минас салихиин","Мы ввели их в Нашу милость, поскольку они были одними из праведников.",["и ввели Мы их","в","Нашу милость","поистине, они","из","праведников"]],[21,87,["وَذَا","ٱلنُّونِ","إِذ","ذَّهَبَ","مُغَٰضِبٗا","فَظَنَّ","أَن","لَّن","نَّقۡدِرَ","عَلَيۡهِ","فَنَادَىٰ","فِي","ٱلظُّلُمَٰتِ","أَن","لَّآ","إِلَٰهَ","إِلَّآ","أَنتَ","سُبۡحَٰنَكَ","إِنِّي","كُنتُ","مِنَ","ٱلظَّٰلِمِينَ"],"вазан нууни из захаба мугадибан фазанна ал лан наḳдира `алайхи фанада физ зулумати ал ла илаха илла анта субханака иннии кунту миназ залимиин","Помяни также человека в рыбе (Иунуса), который ушел в гневе и подумал, что Мы не справимся с ним. Он воззвал из мрака: «Нет божества, кроме Тебя! Пречист Ты! Воистину, я был одним из беззаконников!».",["И обладателя","рыбы (Юнуса)","когда","он ушёл","разгневанным","и подумал","что","не","Мы стесним","его","и он воззвал","во","мраках","что","нет","божества","кроме","Тебя","пречист Ты","поистине, я","был","из","несправедливых"]],[21,88,["فَٱسۡتَجَبۡنَا","لَهُۥ","وَنَجَّيۡنَٰهُ","مِنَ","ٱلۡغَمِّۚ","وَكَذَٰلِكَ","نُـۨجِي","ٱلۡمُؤۡمِنِينَ"],"фастажабна лахуу ванажжайнаху минал гамми ваказалика нунжил му'миниин","Мы ответили на его мольбу и спасли его от печали. Так Мы спасаем верующих.",["И Мы ответили","ему","и спасли его","от","печали","и так","Мы спасаем","верующих"]],[21,89,["وَزَكَرِيَّآ","إِذۡ","نَادَىٰ","رَبَّهُۥ","رَبِّ","لَا","تَذَرۡنِي","فَرۡدٗا","وَأَنتَ","خَيۡرُ","ٱلۡوَٰرِثِينَ"],"вазакариййа из нада раббахуу рабби ла тазарнии фардан ва'анта хайрул варисиин","Помяни также Закарию (Захарию), который воззвал к своему Господу: «Господи! Не оставляй меня одиноким, и Ты - Наилучший из наследников».",["И Закарию","когда","он воззвал","к своему Господу","Господи","не","оставляй меня","одиноким","а Ты","лучший","из наследников"]],[21,90,["فَٱسۡتَجَبۡنَا","لَهُۥ","وَوَهَبۡنَا","لَهُۥ","يَحۡيَىٰ","وَأَصۡلَحۡنَا","لَهُۥ","زَوۡجَهُۥٓۚ","إِنَّهُمۡ","كَانُواْ","يُسَٰرِعُونَ","فِي","ٱلۡخَيۡرَٰتِ","وَيَدۡعُونَنَا","رَغَبٗا","وَرَهَبٗاۖ","وَكَانُواْ","لَنَا","خَٰشِعِينَ"],"фастажабна лахуу вавахабна лахуу йахйа ва'аслахна лахуу заужахуу иннахум кануу йусари`ууна фил хайрати вайад`уунана рагабан варахабан вакануу лана хаши`иин","Мы ответили на его мольбу, даровали ему Йахью (Иоанна) и сделали его жену способной на это. Воистину, они спешили творить добро, взывали к Нам с чаянием и страхом и были смиренны перед Нами.",["И Мы ответили","ему","и даровали","ему","Йахью","и исцелили","для него","его жену","поистине, они","были","спешащие","в","добрых делах","и взывали к Нам","с надеждой","и страхом","и были они","перед Нами","смиренными"]]],"m":[[["وَمِنَ","И из",21,82],["ٱلشَّيَٰطِينِ","дьяволов",21,82],["مَن","те, кто",21,82],["يَغُوصُونَ","ныряли",21,82],["لَهُۥ","для него",21,82],["وَيَعۡمَلُونَ","и делали",21,82],["عَمَلٗا","работу",21,82]],[["دُونَ","кроме",21,82],["ذَٰلِكَۖ","этого",21,82],["وَكُنَّا","и Мы были",21,82],["لَهُمۡ","за ними",21,82],["حَٰفِظِينَ","стерегущими",21,82],[82],["۞ وَأَيُّوبَ","И Айюба",21,83],["إِذۡ","когда",21,83]],[["نَادَىٰ","он воззвал",21,83],["رَبَّهُۥٓ","к своему Господу",21,83],["أَنِّي","что я",21,83],["مَسَّنِيَ","коснулся меня",21,83],["ٱلضُّرُّ","вред",21,83],["وَأَنتَ","а Ты",21,83],["أَرۡحَمُ","Милосерднейший",21,83],["ٱلرَّٰحِمِينَ","из милосердных",21,83],[83]],[["فَٱسۡتَجَبۡنَا","И Мы ответили",21,84],["لَهُۥ","ему",21,84],["فَكَشَفۡنَا","и устранили",21,84],["مَا","то, что",21,84],["بِهِۦ","с ним",21,84],["مِن","из",21,84],["ضُرّٖۖ","вреда",21,84],["وَءَاتَيۡنَٰهُ","и Мы даровали ему",21,84],["أَهۡلَهُۥ","его семью",21,84]],[["وَمِثۡلَهُم","и столько же",21,84],["مَّعَهُمۡ","с ними",21,84],["رَحۡمَةٗ","милостью",21,84],["مِّنۡ","от",21,84],["عِندِنَا","Нас",21,84],["وَذِكۡرَىٰ","и напоминанием",21,84],["لِلۡعَٰبِدِينَ","для поклоняющихся",21,84],[84]],[["وَإِسۡمَٰعِيلَ","И Исмаила",21,85],["وَإِدۡرِيسَ","и Идриса",21,85],["وَذَا","и обладателя",21,85],["ٱلۡكِفۡلِۖ","поручительства (Зулькифла)",21,85],["كُلّٞ","все",21,85],["مِّنَ","из",21,85],["ٱلصَّٰبِرِينَ","терпеливых",21,85]],[[85],["وَأَدۡخَلۡنَٰهُمۡ","и ввели Мы их",21,86],["فِي","в",21,86],["رَحۡمَتِنَآۖ","Нашу милость",21,86],["إِنَّهُم","поистине, они",21,86],["مِّنَ","из",21,86],["ٱلصَّٰلِحِينَ","праведников",21,86]],[[86],["وَذَا","И обладателя",21,87],["ٱلنُّونِ","рыбы (Юнуса)",21,87],["إِذ","когда",21,87],["ذَّهَبَ","он ушёл",21,87],["مُغَٰضِبٗا","разгневанным",21,87],["فَظَنَّ","и подумал",21,87],["أَن","что",21,87],["لَّن","не",21,87],["نَّقۡدِرَ","Мы стесним",21,87],["عَلَيۡهِ","его",21,87]],[["فَنَادَىٰ","и он воззвал",21,87],["فِي","во",21,87],["ٱلظُّلُمَٰتِ","мраках",21,87],["أَن","что",21,87],["لَّآ","нет",21,87],["إِلَٰهَ","божества",21,87],["إِلَّآ","кроме",21,87],["أَنتَ","Тебя",21,87],["سُبۡحَٰنَكَ","пречист Ты",21,87],["إِنِّي","поистине, я",21,87]],[["كُنتُ","был",21,87],["مِنَ","из",21,87],["ٱلظَّٰلِمِينَ","несправедливых",21,87],[87],["فَٱسۡتَجَبۡنَا","И Мы ответили",21,88],["لَهُۥ","ему",21,88],["وَنَجَّيۡنَٰهُ","и спасли его",21,88]],[["مِنَ","от",21,88],["ٱلۡغَمِّۚ","печали",21,88],["وَكَذَٰلِكَ","и так",21,88],["نُـۨجِي","Мы спасаем",21,88],["ٱلۡمُؤۡمِنِينَ","верующих",21,88],[88],["وَزَكَرِيَّآ","И Закарию",21,89]],[["إِذۡ","когда",21,89],["نَادَىٰ","он воззвал",21,89],["رَبَّهُۥ","к своему Господу",21,89],["رَبِّ","Господи",21,89],["لَا","не",21,89],["تَذَرۡنِي","оставляй меня",21,89],["فَرۡدٗا","одиноким",21,89],["وَأَنتَ","а Ты",21,89],["خَيۡرُ","лучший",21,89],["ٱلۡوَٰرِثِينَ","из наследников",21,89]],[[89],["فَٱسۡتَجَبۡنَا","И Мы ответили",21,90],["لَهُۥ","ему",21,90],["وَوَهَبۡنَا","и даровали",21,90],["لَهُۥ","ему",21,90],["يَحۡيَىٰ","Йахью",21,90],["وَأَصۡلَحۡنَا","и исцелили",21,90]],[["لَهُۥ","для него",21,90],["زَوۡجَهُۥٓۚ","его жену",21,90],["إِنَّهُمۡ","поистине, они",21,90],["كَانُواْ","были",21,90],["يُسَٰرِعُونَ","спешащие",21,90],["فِي","в",21,90],["ٱلۡخَيۡرَٰتِ","добрых делах",21,90]],[["وَيَدۡعُونَنَا","и взывали к Нам",21,90],["رَغَبٗا","с надеждой",21,90],["وَرَهَبٗاۖ","и страхом",21,90],["وَكَانُواْ","и были они",21,90],["لَنَا","перед Нами",21,90],["خَٰشِعِينَ","смиренными",21,90],[90]]]}