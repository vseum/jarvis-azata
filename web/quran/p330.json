{"p":330,"j":17,"a":[[21,91,["وَٱلَّتِيٓ","أَحۡصَنَتۡ","فَرۡجَهَا","فَنَفَخۡنَا","فِيهَا","مِن","رُّوحِنَا","وَجَعَلۡنَٰهَا","وَٱبۡنَهَآ","ءَايَةٗ","لِّلۡعَٰلَمِينَ"],"валлатии ахсанат фаржаха фанафахна фииха мир руухина важа`алнаха вабнаха айатал лил`аламиин","Помяни также ту, которая сохранила свое целомудрие (Марьям). Мы вдохнули в нее посредством Нашего духа (Джибрила) и сделали ее и ее сына (Ису) знамением для миров.",["И ту, которая","сберегла","своё лоно","и Мы вдохнули","в неё","из","Нашего духа","и сделали её","и её сына","знамением","для миров"]],[21,92,["إِنَّ","هَٰذِهِۦٓ","أُمَّتُكُمۡ","أُمَّةٗ","وَٰحِدَةٗ","وَأَنَا۠","رَبُّكُمۡ","فَٱعۡبُدُونِ"],"инна хазихии умматукум умматан вахидатан ва'ана раббукум фа`будуун","Воистину, эта ваша религия - религия единая. Я же - ваш Господь. Поклоняйтесь же Мне!",["Поистине","эта","ваша община","община","единая","и Я","ваш Господь","так поклоняйтесь Мне"]],[21,93,["وَتَقَطَّعُوٓاْ","أَمۡرَهُم","بَيۡنَهُمۡۖ","كُلٌّ","إِلَيۡنَا","رَٰجِعُونَ"],"ватаḳатта`уу амрахум байнахум куллун илайна ражи`уун","Они впали в противоречия, но все они вернутся к Нам.",["Но они раскололи","своё дело","между собой","все","к Нам","вернутся"]],[21,94,["فَمَن","يَعۡمَلۡ","مِنَ","ٱلصَّٰلِحَٰتِ","وَهُوَ","مُؤۡمِنٞ","فَلَا","كُفۡرَانَ","لِسَعۡيِهِۦ","وَإِنَّا","لَهُۥ","كَٰتِبُونَ"],"фаман йа`мал минас салихати вахуа му'минун фала куфрана лиса`йихии ва'инна лахуу катибуун","Устремления того, кто совершал праведные деяния, будучи верующим, не будут отвергнуты. Воистину, Мы записываем их для него.",["И кто","совершит","из","праведных дел","будучи","верующим","то не","отвержения","его усердию","и поистине, Мы","для него","записывающие"]],[21,95,["وَحَرَٰمٌ","عَلَىٰ","قَرۡيَةٍ","أَهۡلَكۡنَٰهَآ","أَنَّهُمۡ","لَا","يَرۡجِعُونَ"],"вахарамун `ала ḳарйатин ахлакнаха аннахум ла йаржи`уун","Запрет лежит на селениях, которые Мы погубили, и они не вернутся,",["И запрет","на","селение","которое Мы погубили","что они","не","вернутся"]],[21,96,["حَتَّىٰٓ","إِذَا","فُتِحَتۡ","يَأۡجُوجُ","وَمَأۡجُوجُ","وَهُم","مِّن","كُلِّ","حَدَبٖ","يَنسِلُونَ"],"хатта иза футихат йа'жуужу вама'жуужу вахум мин кулли хадабин йансилуун","пока Йаджудж и Маджудж (Гог и Магог) не будут выпущены и не устремятся вниз с каждой возвышенности.",["Пока","когда","будут открыты","Йаджудж","и Маджудж","и они","с","каждой","возвышенности","устремятся"]],[21,97,["وَٱقۡتَرَبَ","ٱلۡوَعۡدُ","ٱلۡحَقُّ","فَإِذَا","هِيَ","شَٰخِصَةٌ","أَبۡصَٰرُ","ٱلَّذِينَ","كَفَرُواْ","يَٰوَيۡلَنَا","قَدۡ","كُنَّا","فِي","غَفۡلَةٖ","مِّنۡ","هَٰذَا","بَلۡ","كُنَّا","ظَٰلِمِينَ"],"ваḳтарабал ва`дул хаḳḳу фа'иза хийа шахисатун абсарул лазиина кафаруу йавайлана ḳад кунна фии гафлатим мин хаза бал кунна залимиин","Приблизится истинное обещание, и тогда закатятся взоры неверующих. Они скажут: «О горе нам! Мы беспечно относились к этому. Более того, мы были беззаконниками».",["И приблизится","обещание","истинное","и вот","они","застывшие","взоры","тех, которые","не уверовали","о горе нам","действительно","мы были","в","беспечности","к","этому","нет же","мы были","несправедливыми"]],[21,98,["إِنَّكُمۡ","وَمَا","تَعۡبُدُونَ","مِن","دُونِ","ٱللَّهِ","حَصَبُ","جَهَنَّمَ","أَنتُمۡ","لَهَا","وَٰرِدُونَ"],"иннакум вама та`будууна мин дууниллахи хасабу жаханнама антум лаха варидуун","Вы и те, чему вы поклоняетесь вместо Аллаха, являетесь растопкой для Геенны, в которую вы войдете.",["Поистине, вы","и то, чему","вы поклоняетесь","помимо","помимо","Аллаха","растопка","Геенны","вы","в неё","войдёте"]],[21,99,["لَوۡ","كَانَ","هَٰٓؤُلَآءِ","ءَالِهَةٗ","مَّا","وَرَدُوهَاۖ","وَكُلّٞ","فِيهَا","خَٰلِدُونَ"],"лау кана ха'улаи алихатам ма варадууха вакуллун фииха халидуун","Если бы они были богами, то не вошли бы туда. Но все они останутся там навечно.",["Если бы","были","эти","богами","не","вошли бы в неё","и все","в ней","вечно пребывающие"]],[21,100,["لَهُمۡ","فِيهَا","زَفِيرٞ","وَهُمۡ","فِيهَا","لَا","يَسۡمَعُونَ"],"лахум фииха зафиирун вахум фииха ла йасма`уун","Там они будут стенать при выдохе, но ничего не услышат.",["Для них","там","стенание","и они","там","не","слышат"]],[21,101,["إِنَّ","ٱلَّذِينَ","سَبَقَتۡ","لَهُم","مِّنَّا","ٱلۡحُسۡنَىٰٓ","أُوْلَٰٓئِكَ","عَنۡهَا","مُبۡعَدُونَ"],"иннал лазиина сабаḳат лахум миннал хусна улаика `анха муб`адуун","А те, кому Мы изначально определили наилучшее, будут отдалены от нее.",["Поистине","те, которым","предшествовало","им","от Нас","наилучшее","те","от неё","удалены"]]],"m":[[["وَٱلَّتِيٓ","И ту, которая",21,91],["أَحۡصَنَتۡ","сберегла",21,91],["فَرۡجَهَا","своё лоно",21,91],["فَنَفَخۡنَا","и Мы вдохнули",21,91],["فِيهَا","в неё",21,91],["مِن","из",21,91],["رُّوحِنَا","Нашего духа",21,91]],[["وَجَعَلۡنَٰهَا","и сделали её",21,91],["وَٱبۡنَهَآ","и её сына",21,91],["ءَايَةٗ","знамением",21,91],["لِّلۡعَٰلَمِينَ","для миров",21,91],[91],["إِنَّ","Поистине",21,92],["هَٰذِهِۦٓ","эта",21,92]],[["أُمَّتُكُمۡ","ваша община",21,92],["أُمَّةٗ","община",21,92],["وَٰحِدَةٗ","единая",21,92],["وَأَنَا۠","и Я",21,92],["رَبُّكُمۡ","ваш Господь",21,92],["فَٱعۡبُدُونِ","так поклоняйтесь Мне",21,92],[92]],[["وَتَقَطَّعُوٓاْ","Но они раскололи",21,93],["أَمۡرَهُم","своё дело",21,93],["بَيۡنَهُمۡۖ","между собой",21,93],["كُلٌّ","все",21,93],["إِلَيۡنَا","к Нам",21,93],["رَٰجِعُونَ","вернутся",21,93],[93]],[["فَمَن","И кто",21,94],["يَعۡمَلۡ","совершит",21,94],["مِنَ","из",21,94],["ٱلصَّٰلِحَٰتِ","праведных дел",21,94],["وَهُوَ","будучи",21,94],["مُؤۡمِنٞ","верующим",21,94],["فَلَا","то не",21,94],["كُفۡرَانَ","отвержения",21,94]],[["لِسَعۡيِهِۦ","его усердию",21,94],["وَإِنَّا","и поистине, Мы",21,94],["لَهُۥ","для него",21,94],["كَٰتِبُونَ","записывающие",21,94],[94],["وَحَرَٰمٌ","И запрет",21,95],["عَلَىٰ","на",21,95],["قَرۡيَةٍ","селение",21,95]],[["أَهۡلَكۡنَٰهَآ","которое Мы погубили",21,95],["أَنَّهُمۡ","что они",21,95],["لَا","не",21,95],["يَرۡجِعُونَ","вернутся",21,95],[95],["حَتَّىٰٓ","Пока",21,96],["إِذَا","когда",21,96],["فُتِحَتۡ","будут открыты",21,96]],[["يَأۡجُوجُ","Йаджудж",21,96],["وَمَأۡجُوجُ","и Маджудж",21,96],["وَهُم","и они",21,96],["مِّن","с",21,96],["كُلِّ","каждой",21,96],["حَدَبٖ","возвышенности",21,96],["يَنسِلُونَ","устремятся",21,96],[96]],[["وَٱقۡتَرَبَ","И приблизится",21,97],["ٱلۡوَعۡدُ","обещание",21,97],["ٱلۡحَقُّ","истинное",21,97],["فَإِذَا","и вот",21,97],["هِيَ","они",21,97],["شَٰخِصَةٌ","застывшие",21,97],["أَبۡصَٰرُ","взоры",21,97],["ٱلَّذِينَ","тех, которые",21,97]],[["كَفَرُواْ","не уверовали",21,97],["يَٰوَيۡلَنَا","о горе нам",21,97],["قَدۡ","действительно",21,97],["كُنَّا","мы были",21,97],["فِي","в",21,97],["غَفۡلَةٖ","беспечности",21,97],["مِّنۡ","к",21,97],["هَٰذَا","этому",21,97],["بَلۡ","нет же",21,97],["كُنَّا","мы были",21,97]],[["ظَٰلِمِينَ","несправедливыми",21,97],[97],["إِنَّكُمۡ","Поистине, вы",21,98],["وَمَا","и то, чему",21,98],["تَعۡبُدُونَ","вы поклоняетесь",21,98],["مِن","помимо",21,98],["دُونِ","помимо",21,98]],[["ٱللَّهِ","Аллаха",21,98],["حَصَبُ","растопка",21,98],["جَهَنَّمَ","Геенны",21,98],["أَنتُمۡ","вы",21,98],["لَهَا","в неё",21,98],["وَٰرِدُونَ","войдёте",21,98],[98],["لَوۡ","Если бы",21,99],["كَانَ","были",21,99]],[["هَٰٓؤُلَآءِ","эти",21,99],["ءَالِهَةٗ","богами",21,99],["مَّا","не",21,99],["وَرَدُوهَاۖ","вошли бы в неё",21,99],["وَكُلّٞ","и все",21,99],["فِيهَا","в ней",21,99],["خَٰلِدُونَ","вечно пребывающие",21,99],[99]],[["لَهُمۡ","Для них",21,100],["فِيهَا","там",21,100],["زَفِيرٞ","стенание",21,100],["وَهُمۡ","и они",21,100],["فِيهَا","там",21,100],["لَا","не",21,100],["يَسۡمَعُونَ","слышат",21,100],[100],["إِنَّ","Поистине",21,101],["ٱلَّذِينَ","те, которым",21,101]],[["سَبَقَتۡ","предшествовало",21,101],["لَهُم","им",21,101],["مِّنَّا","от Нас",21,101],["ٱلۡحُسۡنَىٰٓ","наилучшее",21,101],["أُوْلَٰٓئِكَ","те",21,101],["عَنۡهَا","от неё",21,101],["مُبۡعَدُونَ","удалены",21,101],[101]]]}