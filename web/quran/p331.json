{"p":331,"j":17,"a":[[21,102,["لَا","يَسۡمَعُونَ","حَسِيسَهَاۖ","وَهُمۡ","فِي","مَا","ٱشۡتَهَتۡ","أَنفُسُهُمۡ","خَٰلِدُونَ"],"ла йасма`ууна хасиисаха вахум фии маштахат анфусухум халидуун","Они не услышат даже малейшего ее звука и вечно пребудут среди того, что возжелали их души.",["Не","услышат они","малейшего звука её","и они","в","том, что","возжелали","их души","вечно пребывающие"]],[21,103,["لَا","يَحۡزُنُهُمُ","ٱلۡفَزَعُ","ٱلۡأَكۡبَرُ","وَتَتَلَقَّىٰهُمُ","ٱلۡمَلَٰٓئِكَةُ","هَٰذَا","يَوۡمُكُمُ","ٱلَّذِي","كُنتُمۡ","تُوعَدُونَ"],"ла йахзунухумул фаза`ул акбару вататалаḳḳахумул малаикату хаза йаумукумул лазии кунтум туу`адуун","Их не опечалит величайший испуг, а ангелы встретят их словами: «Вот ваш день, который был вам обещан!».",["Не","опечалит их","ужас","величайший","и встретят их","ангелы","это","ваш день","который","вы были","обещаемы"]],[21,104,["يَوۡمَ","نَطۡوِي","ٱلسَّمَآءَ","كَطَيِّ","ٱلسِّجِلِّ","لِلۡكُتُبِۚ","كَمَا","بَدَأۡنَآ","أَوَّلَ","خَلۡقٖ","نُّعِيدُهُۥۚ","وَعۡدًا","عَلَيۡنَآۚ","إِنَّا","كُنَّا","فَٰعِلِينَ"],"йаума натвис самаа катаййис сижилли лилкутуби кама бада'на аввала халḳин ну`иидухуу ва`дан `алайна инна кунна фа`илиин","В тот день Мы свернем небо, как сворачивают свитки для книг. Мы воссоздадим творения подобно тому, как начали творить их в первый раз. Так было обещано Нами. Воистину, Мы сделаем это.",["В день, когда","Мы свернём","небо","как сворачивание","свитка","для записей","как","Мы начали","первое","творение","Мы повторим его","обещанием","на Нас","поистине, Мы","были","делающими"]],[21,105,["وَلَقَدۡ","كَتَبۡنَا","فِي","ٱلزَّبُورِ","مِنۢ","بَعۡدِ","ٱلذِّكۡرِ","أَنَّ","ٱلۡأَرۡضَ","يَرِثُهَا","عِبَادِيَ","ٱلصَّٰلِحُونَ"],"валаḳад катабна физ забуури мим ба`диз зикри аннал арда йарисуха `ибадийас салихуун","Мы уже записали в Писаниях после того, как это было записано в Напоминании (Хранимой скрижали), что землю унаследуют Мои праведные рабы.",["И уже","Мы записали","в","Забуре","после","после","напоминания","что","землю","унаследуют её","Мои рабы","праведные"]],[21,106,["إِنَّ","فِي","هَٰذَا","لَبَلَٰغٗا","لِّقَوۡمٍ","عَٰبِدِينَ"],"инна фии хаза лабалагал лиḳаумин `абидиин","Воистину, в этом - послание для тех, кто поклоняется.",["Поистине","в","этом","непременно послание","для людей","поклоняющихся"]],[21,107,["وَمَآ","أَرۡسَلۡنَٰكَ","إِلَّا","رَحۡمَةٗ","لِّلۡعَٰلَمِينَ"],"вама арсалнака илла рахматал лил`аламиин","Мы отправили тебя только в качестве милости к мирам.",["И не","Мы отправили тебя","кроме как","милостью","для миров"]],[21,108,["قُلۡ","إِنَّمَا","يُوحَىٰٓ","إِلَيَّ","أَنَّمَآ","إِلَٰهُكُمۡ","إِلَٰهٞ","وَٰحِدٞۖ","فَهَلۡ","أَنتُم","مُّسۡلِمُونَ"],"ḳул иннама йууха илаййа аннама илахукум илахун вахидун фахал антум муслимуун","Скажи: «Мне внушено в откровении, что ваш Бог - Бог Единственный. Не станете ли вы мусульманами?».",["Скажи","лишь","внушается","мне","что","ваш бог","Бог","единственный","так разве","вы","покорившиеся"]],[21,109,["فَإِن","تَوَلَّوۡاْ","فَقُلۡ","ءَاذَنتُكُمۡ","عَلَىٰ","سَوَآءٖۖ","وَإِنۡ","أَدۡرِيٓ","أَقَرِيبٌ","أَم","بَعِيدٞ","مَّا","تُوعَدُونَ"],"фа'ин таваллау фаḳул азантукум `ала саваин ва'ин адрии аḳариибун ам ба`иидум ма туу`адуун","Если они отвернутся, то скажи: «Я предупреждаю всех вас в равной мере, и я не знаю, рано или поздно настанет то, что вам обещано.",["А если","они отвернутся","то скажи","я возвестил вам","поровну","поровну","и не","знаю я","близко ли","или","далеко","то, что","вам обещано"]],[21,110,["إِنَّهُۥ","يَعۡلَمُ","ٱلۡجَهۡرَ","مِنَ","ٱلۡقَوۡلِ","وَيَعۡلَمُ","مَا","تَكۡتُمُونَ"],"иннахуу йа`ламул жахра минал ḳаули вайа`ламу ма тактумуун","Воистину, Он ведает о словах, которые произносят вслух, и ведает о том, что вы утаиваете.",["Поистине, Он","знает","открытое","из","слов","и знает","то, что","вы скрываете"]],[21,111,["وَإِنۡ","أَدۡرِي","لَعَلَّهُۥ","فِتۡنَةٞ","لَّكُمۡ","وَمَتَٰعٌ","إِلَىٰ","حِينٖ"],"ва'ин адрии ла`аллахуу фитнатул лакум вамата`ун ила хиин","Я не знаю, может быть, это - искушение для вас или же возможность пользоваться благами до определенного времени».",["И не","знаю я","может быть, это","искушение","для вас","и пользование","до","времени"]],[21,112,["قَٰلَ","رَبِّ","ٱحۡكُم","بِٱلۡحَقِّۗ","وَرَبُّنَا","ٱلرَّحۡمَٰنُ","ٱلۡمُسۡتَعَانُ","عَلَىٰ","مَا","تَصِفُونَ"],"ḳала раббихкум билхаḳḳи вараббунар рахманул муста`ану `ала ма тасифуун","Пророк сказал: «Господи! Рассуди по справедливости. У нашего Милостивого Господа надо просить помощи против того, что вы приписываете».",["Он сказал","Господи","рассуди","по истине","и наш Господь","Милостивый","у Кого просят помощи","против","того, что","вы приписываете"]]],"m":[[["لَا","Не",21,102],["يَسۡمَعُونَ","услышат они",21,102],["حَسِيسَهَاۖ","малейшего звука её",21,102],["وَهُمۡ","и они",21,102],["فِي","в",21,102],["مَا","том, что",21,102],["ٱشۡتَهَتۡ","возжелали",21,102],["أَنفُسُهُمۡ","их души",21,102]],[["خَٰلِدُونَ","вечно пребывающие",21,102],[102],["لَا","Не",21,103],["يَحۡزُنُهُمُ","опечалит их",21,103],["ٱلۡفَزَعُ","ужас",21,103],["ٱلۡأَكۡبَرُ","величайший",21,103],["وَتَتَلَقَّىٰهُمُ","и встретят их",21,103]],[["ٱلۡمَلَٰٓئِكَةُ","ангелы",21,103],["هَٰذَا","это",21,103],["يَوۡمُكُمُ","ваш день",21,103],["ٱلَّذِي","который",21,103],["كُنتُمۡ","вы были",21,103],["تُوعَدُونَ","обещаемы",21,103]],[[103],["يَوۡمَ","В день, когда",21,104],["نَطۡوِي","Мы свернём",21,104],["ٱلسَّمَآءَ","небо",21,104],["كَطَيِّ","как сворачивание",21,104],["ٱلسِّجِلِّ","свитка",21,104],["لِلۡكُتُبِۚ","для записей",21,104],["كَمَا","как",21,104]],[["بَدَأۡنَآ","Мы начали",21,104],["أَوَّلَ","первое",21,104],["خَلۡقٖ","творение",21,104],["نُّعِيدُهُۥۚ","Мы повторим его",21,104],["وَعۡدًا","обещанием",21,104],["عَلَيۡنَآۚ","на Нас",21,104],["إِنَّا","поистине, Мы",21,104],["كُنَّا","были",21,104],["فَٰعِلِينَ","делающими",21,104]],[[104],["وَلَقَدۡ","И уже",21,105],["كَتَبۡنَا","Мы записали",21,105],["فِي","в",21,105],["ٱلزَّبُورِ","Забуре",21,105],["مِنۢ","после",21,105],["بَعۡدِ","после",21,105],["ٱلذِّكۡرِ","напоминания",21,105],["أَنَّ","что",21,105],["ٱلۡأَرۡضَ","землю",21,105]],[["يَرِثُهَا","унаследуют её",21,105],["عِبَادِيَ","Мои рабы",21,105],["ٱلصَّٰلِحُونَ","праведные",21,105],[105],["إِنَّ","Поистине",21,106],["فِي","в",21,106],["هَٰذَا","этом",21,106],["لَبَلَٰغٗا","непременно послание",21,106]],[["لِّقَوۡمٍ","для людей",21,106],["عَٰبِدِينَ","поклоняющихся",21,106],[106],["وَمَآ","И не",21,107],["أَرۡسَلۡنَٰكَ","Мы отправили тебя",21,107],["إِلَّا","кроме как",21,107],["رَحۡمَةٗ","милостью",21,107],["لِّلۡعَٰلَمِينَ","для миров",21,107]],[[107],["قُلۡ","Скажи",21,108],["إِنَّمَا","лишь",21,108],["يُوحَىٰٓ","внушается",21,108],["إِلَيَّ","мне",21,108],["أَنَّمَآ","что",21,108],["إِلَٰهُكُمۡ","ваш бог",21,108],["إِلَٰهٞ","Бог",21,108],["وَٰحِدٞۖ","единственный",21,108]],[["فَهَلۡ","так разве",21,108],["أَنتُم","вы",21,108],["مُّسۡلِمُونَ","покорившиеся",21,108],[108],["فَإِن","А если",21,109],["تَوَلَّوۡاْ","они отвернутся",21,109],["فَقُلۡ","то скажи",21,109],["ءَاذَنتُكُمۡ","я возвестил вам",21,109]],[["عَلَىٰ","поровну",21,109],["سَوَآءٖۖ","поровну",21,109],["وَإِنۡ","и не",21,109],["أَدۡرِيٓ","знаю я",21,109],["أَقَرِيبٌ","близко ли",21,109],["أَم","или",21,109],["بَعِيدٞ","далеко",21,109],["مَّا","то, что",21,109],["تُوعَدُونَ","вам обещано",21,109],[109]],[["إِنَّهُۥ","Поистине, Он",21,110],["يَعۡلَمُ","знает",21,110],["ٱلۡجَهۡرَ","открытое",21,110],["مِنَ","из",21,110],["ٱلۡقَوۡلِ","слов",21,110],["وَيَعۡلَمُ","и знает",21,110],["مَا","то, что",21,110],["تَكۡتُمُونَ","вы скрываете",21,110]],[[110],["وَإِنۡ","И не",21,111],["أَدۡرِي","знаю я",21,111],["لَعَلَّهُۥ","может быть, это",21,111],["فِتۡنَةٞ","искушение",21,111],["لَّكُمۡ","для вас",21,111],["وَمَتَٰعٌ","и пользование",21,111],["إِلَىٰ","до",21,111],["حِينٖ","времени",21,111],[111],["قَٰلَ","Он сказал",21,112]],[["رَبِّ","Господи",21,112],["ٱحۡكُم","рассуди",21,112],["بِٱلۡحَقِّۗ","по истине",21,112],["وَرَبُّنَا","и наш Господь",21,112],["ٱلرَّحۡمَٰنُ","Милостивый",21,112],["ٱلۡمُسۡتَعَانُ","у Кого просят помощи",21,112],["عَلَىٰ","против",21,112],["مَا","того, что",21,112],["تَصِفُونَ","вы приписываете",21,112],[112]],["h",22]]}