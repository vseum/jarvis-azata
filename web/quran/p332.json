{"p":332,"j":17,"a":[[22,1,["يَٰٓأَيُّهَا","ٱلنَّاسُ","ٱتَّقُواْ","رَبَّكُمۡۚ","إِنَّ","زَلۡزَلَةَ","ٱلسَّاعَةِ","شَيۡءٌ","عَظِيمٞ"],"йа'аййухан насуттаḳуу раббакум инна залзалатас са`ати шай'ун `азиим","О люди! Бойтесь вашего Господа! Воистину, сотрясение Часа является ужасным событием.",["О","люди","бойтесь","вашего Господа","поистине","сотрясение","Часа","вещь","великая"]],[22,2,["يَوۡمَ","تَرَوۡنَهَا","تَذۡهَلُ","كُلُّ","مُرۡضِعَةٍ","عَمَّآ","أَرۡضَعَتۡ","وَتَضَعُ","كُلُّ","ذَاتِ","حَمۡلٍ","حَمۡلَهَا","وَتَرَى","ٱلنَّاسَ","سُكَٰرَىٰ","وَمَا","هُم","بِسُكَٰرَىٰ","وَلَٰكِنَّ","عَذَابَ","ٱللَّهِ","شَدِيدٞ"],"йаума тараунаха тазхалу куллу мурди`атин `амма арда`ат ватада`у куллу зати хамлин хамлаха ватаран наса сукара вама хум бисукара валакинна `азабаллахи шадиид","В тот день, когда вы увидите его, каждая кормящая мать забудет того, кого она кормила, а каждая беременная женщина выкинет свой плод. Ты увидишь людей пьяными, но они не будут пьяны, зато мучения от Аллаха будут тяжки.",["В день, когда","вы увидите его","забудет","каждая","кормящая","того, кого","она кормила","и сбросит","каждая","обладательница","бремени","своё бремя","и увидишь","людей","пьяными","но не","они","пьяны","но","наказание","Аллаха","сурово"]],[22,3,["وَمِنَ","ٱلنَّاسِ","مَن","يُجَٰدِلُ","فِي","ٱللَّهِ","بِغَيۡرِ","عِلۡمٖ","وَيَتَّبِعُ","كُلَّ","شَيۡطَٰنٖ","مَّرِيدٖ"],"ваминан наси ман йужадилу филлахи бигайри `илмин вайаттаби`у кулла шайтаним мариид","Среди людей есть такие, которые спорят об Аллахе, не имея знаний, и следуют за всяким мятежным дьяволом.",["И среди","людей","тот, кто","спорит","об","Аллахе","без","знания","и следует","за каждым","дьяволом","мятежным"]],[22,4,["كُتِبَ","عَلَيۡهِ","أَنَّهُۥ","مَن","تَوَلَّاهُ","فَأَنَّهُۥ","يُضِلُّهُۥ","وَيَهۡدِيهِ","إِلَىٰ","عَذَابِ","ٱلسَّعِيرِ"],"кутиба `алайхи аннахуу ман таваллаху фа'аннахуу йудиллухуу вайахдиихи ила `азабис са`иир","Ему было предписано, что любого, кто сочтет его своим покровителем и помощником, он введет в заблуждение и приведет к мучениям в Пламени.",["Предписано","о нём","что он","кто","возьмёт его в покровители","то поистине, он","собьёт его","и поведёт его","к","наказанию","Пламени"]],[22,5,["يَٰٓأَيُّهَا","ٱلنَّاسُ","إِن","كُنتُمۡ","فِي","رَيۡبٖ","مِّنَ","ٱلۡبَعۡثِ","فَإِنَّا","خَلَقۡنَٰكُم","مِّن","تُرَابٖ","ثُمَّ","مِن","نُّطۡفَةٖ","ثُمَّ","مِنۡ","عَلَقَةٖ","ثُمَّ","مِن","مُّضۡغَةٖ","مُّخَلَّقَةٖ","وَغَيۡرِ","مُخَلَّقَةٖ","لِّنُبَيِّنَ","لَكُمۡۚ","وَنُقِرُّ","فِي","ٱلۡأَرۡحَامِ","مَا","نَشَآءُ","إِلَىٰٓ","أَجَلٖ","مُّسَمّٗى","ثُمَّ","نُخۡرِجُكُمۡ","طِفۡلٗا","ثُمَّ","لِتَبۡلُغُوٓاْ","أَشُدَّكُمۡۖ","وَمِنكُم","مَّن","يُتَوَفَّىٰ","وَمِنكُم","مَّن","يُرَدُّ","إِلَىٰٓ","أَرۡذَلِ","ٱلۡعُمُرِ","لِكَيۡلَا","يَعۡلَمَ","مِنۢ","بَعۡدِ","عِلۡمٖ","شَيۡـٔٗاۚ","وَتَرَى","ٱلۡأَرۡضَ","هَامِدَةٗ","فَإِذَآ","أَنزَلۡنَا","عَلَيۡهَا","ٱلۡمَآءَ","ٱهۡتَزَّتۡ","وَرَبَتۡ","وَأَنۢبَتَتۡ","مِن","كُلِّ","زَوۡجِۭ","بَهِيجٖ"],"йа'аййухан насу ин кунтум фии райбим минал ба`си фа'инна халаḳнакум мин турабин сумма мин нутфатин сумма мин `алаḳатин сумма мим мудгатим мухаллаḳатин вагайри мухаллаḳатил линубаййина лакум вануḳирру фил архами ма нашау ила ажалим мусамман сумма нухрижукум тифлан сумма литаблугуу ашуддакум ваминкум ман йутаваффа ваминкум ман йурадду ила арзалил `умури ликайла йа`лама мим ба`ди `илмин шай'ан ватарал арда хамидатан фа'иза анзална `алайхал маахтаззат варабат ва'амбатат мин кулли заужи бахииж","О люди! Если вы сомневаетесь в воскрешении, то ведь Мы сотворили вас из земли, потом - из капли, потом - из сгустка крови, потом - из разжеванного кусочка, сформировавшегося или не сформировавшегося. Так Мы разъясняем вам истину. Мы помещаем в утробах то, что желаем, до назначенного срока. Потом Мы выводим вас младенцами, чтобы вы могли достигнуть зрелого возраста. Одни из вас умирают, другие же возвращаются в жалкую старость и забывают все, что знали. Ты видишь безжизненную землю. Но стоит Нам ниспослать на нее воду, как она приходит в движение, набухает и порождает всякие прекрасные растения.",["О","люди","если","вы","в","сомнении","о","воскрешении","то поистине, Мы","Мы сотворили вас","из","праха","затем","из","капли","затем","из","сгустка","затем","из","кусочка плоти","сформированного","и не","сформированного","чтобы Мы разъяснили","вам","и Мы оставляем","в","утробах","что","Мы пожелаем","до","срока","назначенного","затем","Мы выводим вас","младенцем","затем","чтобы вы достигли","вашей зрелости","и из вас","тот, кто","упокаивается","и из вас","тот, кто","возвращается","к","самому жалкому","возрасту","чтобы не","знал он","после","после","знания","ничего","и ты видишь","землю","безжизненной","а когда","Мы ниспосылаем","на неё","воду","она шевелится","и набухает","и взращивает","из","всякой","пары","прекрасной"]]],"m":[["b"],[["يَٰٓأَيُّهَا","О",22,1],["ٱلنَّاسُ","люди",22,1],["ٱتَّقُواْ","бойтесь",22,1],["رَبَّكُمۡۚ","вашего Господа",22,1],["إِنَّ","поистине",22,1],["زَلۡزَلَةَ","сотрясение",22,1],["ٱلسَّاعَةِ","Часа",22,1],["شَيۡءٌ","вещь",22,1]],[["عَظِيمٞ","великая",22,1],[1],["يَوۡمَ","В день, когда",22,2],["تَرَوۡنَهَا","вы увидите его",22,2],["تَذۡهَلُ","забудет",22,2],["كُلُّ","каждая",22,2],["مُرۡضِعَةٍ","кормящая",22,2],["عَمَّآ","того, кого",22,2]],[["أَرۡضَعَتۡ","она кормила",22,2],["وَتَضَعُ","и сбросит",22,2],["كُلُّ","каждая",22,2],["ذَاتِ","обладательница",22,2],["حَمۡلٍ","бремени",22,2],["حَمۡلَهَا","своё бремя",22,2],["وَتَرَى","и увидишь",22,2],["ٱلنَّاسَ","людей",22,2]],[["سُكَٰرَىٰ","пьяными",22,2],["وَمَا","но не",22,2],["هُم","они",22,2],["بِسُكَٰرَىٰ","пьяны",22,2],["وَلَٰكِنَّ","но",22,2],["عَذَابَ","наказание",22,2],["ٱللَّهِ","Аллаха",22,2],["شَدِيدٞ","сурово",22,2]],[[2],["وَمِنَ","И среди",22,3],["ٱلنَّاسِ","людей",22,3],["مَن","тот, кто",22,3],["يُجَٰدِلُ","спорит",22,3],["فِي","об",22,3],["ٱللَّهِ","Аллахе",22,3],["بِغَيۡرِ","без",22,3],["عِلۡمٖ","знания",22,3],["وَيَتَّبِعُ","и следует",22,3],["كُلَّ","за каждым",22,3]],[["شَيۡطَٰنٖ","дьяволом",22,3],["مَّرِيدٖ","мятежным",22,3],[3],["كُتِبَ","Предписано",22,4],["عَل