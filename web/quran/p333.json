{"p":333,"j":17,"a":[[22,6,["ذَٰلِكَ","بِأَنَّ","ٱللَّهَ","هُوَ","ٱلۡحَقُّ","وَأَنَّهُۥ","يُحۡيِ","ٱلۡمَوۡتَىٰ","وَأَنَّهُۥ","عَلَىٰ","كُلِّ","شَيۡءٖ","قَدِيرٞ"],"залика би'анналлаха хуал хаḳḳу ва'аннахуу йухйил маута ва'аннахуу `ала кулли шай'ин ḳадиир","Это происходит, потому что Аллах является Истиной, оживляет мертвых и способен на всякую вещь,",["Это","потому что","Аллах","Он","Истина","и что Он","оживляет","мёртвых","и что Он","над","всякой","вещью","Всемогущ"]],[22,7,["وَأَنَّ","ٱلسَّاعَةَ","ءَاتِيَةٞ","لَّا","رَيۡبَ","فِيهَا","وَأَنَّ","ٱللَّهَ","يَبۡعَثُ","مَن","فِي","ٱلۡقُبُورِ"],"ва'аннас са`ата атийатул ла райба фииха ва'анналлаха йаб`асу ман фил ḳубуур","потому что Час, в котором нет сомнения, непременно наступит и потому что Аллах воскресит тех, кто в могилах.",["И что","Час","наступит","нет","сомнения","в нём","и что","Аллах","воскресит","тех, кто","в","могилах"]],[22,8,["وَمِنَ","ٱلنَّاسِ","مَن","يُجَٰدِلُ","فِي","ٱللَّهِ","بِغَيۡرِ","عِلۡمٖ","وَلَا","هُدٗى","وَلَا","كِتَٰبٖ","مُّنِيرٖ"],"ваминан наси ман йужадилу филлахи бигайри `илмин вала худан вала китабим муниир","Среди людей есть такой, который спорит об Аллахе, не имея ни знаний, ни верного руководства, ни освещающего Писания.",["И среди","людей","тот, кто","спорит","об","Аллахе","без","знания","и без","руководства","и без","Писания","освещающего"]],[22,9,["ثَانِيَ","عِطۡفِهِۦ","لِيُضِلَّ","عَن","سَبِيلِ","ٱللَّهِۖ","لَهُۥ","فِي","ٱلدُّنۡيَا","خِزۡيٞۖ","وَنُذِيقُهُۥ","يَوۡمَ","ٱلۡقِيَٰمَةِ","عَذَابَ","ٱلۡحَرِيقِ"],"санийа `итфихии лийудилла `ан сабиилиллахи лахуу фид дунйа хизйун ванузииḳухуу йаумал ḳийамати `азабал харииḳ","Он надменно поворачивает шею, чтобы сбить других с пути Аллаха. Ему уготован позор в этом мире, а в День воскресения Мы дадим ему вкусить мучения от обжигающего Огня.",["Отворачивая","свой бок","чтобы сбить","с","пути","Аллаха","ему","в","этом мире","позор","и Мы дадим ему вкусить","в день","воскресения","наказание","обжигающего"]],[22,10,["ذَٰلِكَ","بِمَا","قَدَّمَتۡ","يَدَاكَ","وَأَنَّ","ٱللَّهَ","لَيۡسَ","بِظَلَّٰمٖ","لِّلۡعَبِيدِ"],"залика бима ḳаддамат йадака ва'анналлаха лайса бизалламил лил`абиид","Ему будет сказано: «Это - за то, что приготовили твои руки, ведь Аллах не поступает несправедливо с рабами».",["Это","за то, что","приготовили","твои руки","и что","Аллах","не","несправедлив","к рабам"]],[22,11,["وَمِنَ","ٱلنَّاسِ","مَن","يَعۡبُدُ","ٱللَّهَ","عَلَىٰ","حَرۡفٖۖ","فَإِنۡ","أَصَابَهُۥ","خَيۡرٌ","ٱطۡمَأَنَّ","بِهِۦۖ","وَإِنۡ","أَصَابَتۡهُ","فِتۡنَةٌ","ٱنقَلَبَ","عَلَىٰ","وَجۡهِهِۦ","خَسِرَ","ٱلدُّنۡيَا","وَٱلۡأٓخِرَةَۚ","ذَٰلِكَ","هُوَ","ٱلۡخُسۡرَانُ","ٱلۡمُبِينُ"],"ваминан наси ман йа`будуллаха `ала харфин фа'ин асабахуу хайрунитмаанна бихии ва'ин асабатху фитнатунинḳалаба `ала важхихии хасирад дунйа вал'ахирата залика хуал хусранул мубиин","Среди людей есть и такой, который поклоняется Аллаху, находясь на грани между верой и неверием. Если ему достается добро, то благодаря этому он чувствует себя уверенно; если же его постигает искушение, то он оборачивается вспять. Он теряет как этот мир, так и Последнюю жизнь. Это и есть очевидный убыток!",["И среди","людей","тот, кто","поклоняется","Аллаху","на","грани","и если","постигнет его","добро","успокоится он","им","а если","постигнет его","испытание","обращается он","на","своё лицо","потерял он","этот мир","и последнюю жизнь","это","оно","убыток","явный"]],[22,12,["يَدۡعُواْ","مِن","دُونِ","ٱللَّهِ","مَا","لَا","يَضُرُّهُۥ","وَمَا","لَا","يَنفَعُهُۥۚ","ذَٰلِكَ","هُوَ","ٱلضَّلَٰلُ","ٱلۡبَعِيدُ"],"йад`уу мин дууниллахи ма ла йадуррухуу вама ла йанфа`ухуу залика хуад далалул ба`иид","Вместо Аллаха он взывает к тому, что не приносит ему ни вреда, ни пользы. Это и есть глубокое заблуждение!",["Взывает он","помимо","помимо","Аллаха","к тому, что","не","вредит ему","и что","не","приносит ему пользы","это","оно","заблуждение","далёкое"]],[22,13,["يَدۡعُواْ","لَمَن","ضَرُّهُۥٓ","أَقۡرَبُ","مِن","نَّفۡعِهِۦۚ","لَبِئۡسَ","ٱلۡمَوۡلَىٰ","وَلَبِئۡسَ","ٱلۡعَشِيرُ"],"йад`уу ламан даррухуу аḳрабу мин наф`ихии лаби'сал маула валаби'сал `ашиир","Он взывает к тому, кто может быстрее навредить, чем принести пользу. Плох такой господин! Плох такой товарищ!",["Взывает он","к тому, кто","вред от него","ближе","чем","польза от него","непременно, скверный","покровитель","и непременно, скверный","товарищ"]],[22,14,["إِنَّ","ٱللَّهَ","يُدۡخِلُ","ٱلَّذِينَ","ءَامَنُواْ","وَعَمِلُواْ","ٱلصَّٰلِحَٰتِ","جَنَّٰتٖ","تَجۡرِي","مِن","تَحۡتِهَا","ٱلۡأَنۡهَٰرُۚ","إِنَّ","ٱللَّهَ","يَفۡعَلُ","مَا","يُرِيدُ"],"инналлаха йудхилул лазиина амануу ва`амилус салихати жаннатин тажрии мин тахтихал анхару инналлаха йаф`алу ма йуриид","А тех, которые уверовали и совершали праведные деяния, Аллах введет в Райские сады, в которых текут реки. Воистину, Аллах поступает так, как пожелает.",["Поистине","Аллах","введёт","тех, которые","уверовали","и совершали","праведные дела","в сады","текут","из","под ними","реки","поистине","Аллах","делает","что","Он хочет"]],[22,15,["مَن","كَانَ","يَظُنُّ","أَن","لَّن","يَنصُرَهُ","ٱللَّهُ","فِي","ٱلدُّنۡيَا","وَٱلۡأٓخِرَةِ","فَلۡيَمۡدُدۡ","بِسَبَبٍ","إِلَى","ٱلسَّمَآءِ","ثُمَّ","لۡيَقۡطَعۡ","فَلۡيَنظُرۡ","هَلۡ","يُذۡهِبَنَّ","كَيۡدُهُۥ","مَا","يَغِيظُ"],"ман кана йазунну ал лан йансурахуллаху фид дунйа вал'ахирати фалйамдуд бисабабин илас самаи суммал йаḳта` фалйанзур хал йузхибанна кайдухуу ма йагииз","Кто полагает, что Аллах не окажет ему (Мухаммаду) помощи в этом мире и в Последней жизни, пусть подвяжет веревку к небу (или потолку), а затем перережет ее и посмотрит, устранит ли его хитрость то, что вызывает его ярость.",["Кто","был","думает","что","не","поможет ему","Аллах","в","этом мире","и последней жизни","то пусть протянет","верёвку","к","небу","затем","пусть перережет","и пусть посмотрит","разве","устранит","его хитрость","то, что","гневит"]]],"m":[[["ذَٰلِكَ","Это",22,6],["بِأَنَّ","потому что",22,6],["ٱللَّهَ","Аллах",22,6],["هُوَ","Он",22,6],["ٱلۡحَقُّ","Истина",22,6],["وَأَنَّهُۥ","и что Он",22,6],["يُحۡيِ","оживляет",22,6],["ٱلۡمَوۡتَىٰ