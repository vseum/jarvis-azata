{"p":334,"j":17,"a":[[22,16,["وَكَذَٰلِكَ","أَنزَلۡنَٰهُ","ءَايَٰتِۭ","بَيِّنَٰتٖ","وَأَنَّ","ٱللَّهَ","يَهۡدِي","مَن","يُرِيدُ"],"ваказалика анзалнаху айати баййинатин ва'анналлаха йахдии ман йуриид","Таким образом Мы ниспослали его (Коран) в виде ясных аятов, и Аллах ведет прямым путем того, кого пожелает.",["И так","Мы ниспослали его","аятами","ясными","и что","Аллах","ведёт","кого","Он хочет"]],[22,17,["إِنَّ","ٱلَّذِينَ","ءَامَنُواْ","وَٱلَّذِينَ","هَادُواْ","وَٱلصَّٰبِـِٔينَ","وَٱلنَّصَٰرَىٰ","وَٱلۡمَجُوسَ","وَٱلَّذِينَ","أَشۡرَكُوٓاْ","إِنَّ","ٱللَّهَ","يَفۡصِلُ","بَيۡنَهُمۡ","يَوۡمَ","ٱلۡقِيَٰمَةِۚ","إِنَّ","ٱللَّهَ","عَلَىٰ","كُلِّ","شَيۡءٖ","شَهِيدٌ"],"иннал лазиина амануу валлазиина хадуу вассаби'иина ваннасара валмажууса валлазиина ашракуу инналлаха йафсилу байнахум йаумал ḳийамати инналлаха `ала кулли шай'ин шахиид","В День воскресения Аллах рассудит между верующими, исповедующими иудаизм, сабиями, христианами, огнепоклонниками и многобожниками. Воистину, Аллах является Свидетелем всякой вещи.",["Поистине","те, которые","уверовали","и те, которые","исповедуют иудаизм","и сабии","и христиане","и огнепоклонники","и те, которые","придают сотоварищей","поистине","Аллах","рассудит","между ними","в день","воскресения","поистине","Аллах","над","всякой","вещью","Свидетель"]],[22,18,["أَلَمۡ","تَرَ","أَنَّ","ٱللَّهَ","يَسۡجُدُۤ","لَهُۥۤ","مَن","فِي","ٱلسَّمَٰوَٰتِ","وَمَن","فِي","ٱلۡأَرۡضِ","وَٱلشَّمۡسُ","وَٱلۡقَمَرُ","وَٱلنُّجُومُ","وَٱلۡجِبَالُ","وَٱلشَّجَرُ","وَٱلدَّوَآبُّ","وَكَثِيرٞ","مِّنَ","ٱلنَّاسِۖ","وَكَثِيرٌ","حَقَّ","عَلَيۡهِ","ٱلۡعَذَابُۗ","وَمَن","يُهِنِ","ٱللَّهُ","فَمَا","لَهُۥ","مِن","مُّكۡرِمٍۚ","إِنَّ","ٱللَّهَ","يَفۡعَلُ","مَا","يَشَآءُ ۩"],"алам тара анналлаха йасжуду лахуу ман фис самавати ваман фил арди вашшамсу валḳамару ваннужууму валжибалу вашшажару ваддаваббу вакасиирум минан наси вакасиирун хаḳḳа `алайхил `азабу ваман йухиниллаху фама лахуу мим мукримин инналлаха йаф`алу ма йаша","Неужели ты не видишь, что перед Аллахом падают ниц те, кто на небесах и на земле, солнце, луна, звезды, горы, деревья, животные и многие люди. А многие из них заслуживают мучений. Никто не окажет почтения тому, кого унизит Аллах. Воистину, Аллах поступает так, как пожелает.",["Разве не","видишь ты","что","Аллаху","падает ниц","Ему","тот, кто","в","небесах","и тот, кто","на","земле","и солнце","и луна","и звёзды","и горы","и деревья","и животные","и многие","из","людей","и многие","стало должным","над ним","наказание","и кого","унизит","Аллах","то нет","ему","никакого","почитающего","поистине","Аллах","делает","что","Он желает"]],[22,19,["هَٰذَانِ","خَصۡمَانِ","ٱخۡتَصَمُواْ","فِي","رَبِّهِمۡۖ","فَٱلَّذِينَ","كَفَرُواْ","قُطِّعَتۡ","لَهُمۡ","ثِيَابٞ","مِّن","نَّارٖ","يُصَبُّ","مِن","فَوۡقِ","رُءُوسِهِمُ","ٱلۡحَمِيمُ"],"хазани хасманихтасамуу фии раббихим фаллазиина кафаруу ḳутти`ат лахум сийабум мин нарин йусаббу мин фауḳи ру'уусихимул хамиим","Вот две тяжущиеся группы, которые препирались по поводу своего Господа. Для тех, которые не уверовали, выкроят одеяния из Огня, а на головы им будут лить кипяток.",["эти две","тяжущиеся группы","препирались","о","Господе их","и те, которые","не уверовали","выкроены","для них","одеяния","из","огня","будет литься","с","верха","голов их","кипяток"]],[22,20,["يُصۡهَرُ","بِهِۦ","مَا","فِي","بُطُونِهِمۡ","وَٱلۡجُلُودُ"],"йусхару бихии ма фии бутуунихим валжулууд","От него будут плавиться их внутренности и кожа.",["расплавится","от него","то, что","в","животах их","и кожа"]],[22,21,["وَلَهُم","مَّقَٰمِعُ","مِنۡ","حَدِيدٖ"],"валахум маḳами`у мин хадиид","Для них уготованы железные палицы.",["и для них","палицы","из","железа"]],[22,22,["كُلَّمَآ","أَرَادُوٓاْ","أَن","يَخۡرُجُواْ","مِنۡهَا","مِنۡ","غَمٍّ","أُعِيدُواْ","فِيهَا","وَذُوقُواْ","عَذَابَ","ٱلۡحَرِيقِ"],"куллама арадуу ан йахружуу минха мин гаммин у`иидуу фииха вазууḳуу `азабал харииḳ","Каждый раз, когда они захотят выбраться оттуда и избавиться от печали, их вернут обратно. Вкусите мучения от обжигающего Огня!",["всякий раз, когда","захотят они","чтобы","выйти","из него","от","печали","возвращены будут","в него","и вкусите","мучение","обжигающего (огня)"]],[22,23,["إِنَّ","ٱللَّهَ","يُدۡخِلُ","ٱلَّذِينَ","ءَامَنُواْ","وَعَمِلُواْ","ٱلصَّٰلِحَٰتِ","جَنَّٰتٖ","تَجۡرِي","مِن","تَحۡتِهَا","ٱلۡأَنۡهَٰرُ","يُحَلَّوۡنَ","فِيهَا","مِنۡ","أَسَاوِرَ","مِن","ذَهَبٖ","وَلُؤۡلُؤٗاۖ","وَلِبَاسُهُمۡ","فِيهَا","حَرِيرٞ"],"инналлаха йудхилул лазиина амануу ва`амилус салихати жаннатин тажрии мин тахтихал анхару йухаллауна фииха мин асавира мин захабин валу'луан валибасухум фииха хариир","А тех, которые уверовали и совершали праведные деяния, Аллах введет в Райские сады, в которых текут реки. Там они будут украшены золотыми браслетами и жемчугом, а их одеяния будут из шелка.",["поистине","Аллах","введёт","тех, которые","уверовали","и совершали","праведные (дела)","(в) сады","текут","из","под ними","реки","будут украшены они","там","из","браслетов","из","золота","и жемчугом","и одеяние их","там","шёлк"]]],"m":[[["وَكَذَٰلِكَ","И так",22,16],["أَنزَلۡنَٰهُ","Мы ниспослали его",22,16],["ءَايَٰتِۭ","аятами",22,16],["بَيِّنَٰتٖ","ясными",22,16],["وَأَنَّ","и что",22,16],["ٱللَّهَ","Аллах",22,16],["يَهۡدِي","ведёт",22,16],["مَن","кого",22,16],["يُرِيدُ","Он хочет",22,16]],[[16],["إِنَّ","Поистине",22,17],["ٱلَّذِينَ","те, которые",22,17],["ءَامَنُواْ","уверовали",22,17],["وَٱلَّذِينَ","и те, которые",22,17],["هَادُواْ","исповедуют иудаизм",22,17],["وَٱلصَّٰبِـِٔينَ","и сабии",22,17],["وَٱلنَّصَٰرَىٰ","и христиане",22,17]],[["وَٱلۡمَجُوسَ","и огнепоклонники",22,17],["وَٱلَّذِينَ","и те, которые",22,17],["أَشۡرَكُوٓاْ","придают сотоварищей",22,17],["إِنَّ","поистине",22,17],["ٱللَّهَ","Аллах",22,17],["يَفۡصِلُ","рассудит",22,17],["بَيۡنَهُمۡ","между ними",22,17]],[["يَوۡمَ","в день",22,17],["ٱلۡقِيَٰمَةِۚ","воскресения",22,17],["إِنَّ","поистине",22,17],["ٱللَّهَ","Аллах",22,17],["عَلَىٰ","над",22,17],["كُلِّ","всякой",22,17],["شَيۡءٖ","вещью",22,17],["شَهِيدٌ","Свидетель",22,17],[17],["أَلَمۡ","Разве не",22,18],[