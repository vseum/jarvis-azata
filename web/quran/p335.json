{"p":335,"j":17,"a":[[22,24,["وَهُدُوٓاْ","إِلَى","ٱلطَّيِّبِ","مِنَ","ٱلۡقَوۡلِ","وَهُدُوٓاْ","إِلَىٰ","صِرَٰطِ","ٱلۡحَمِيدِ"],"вахудуу илат таййиби минал ḳаули вахудуу ила сиратил хамиид","Их научили благим словам и наставили на путь Достохвального.",["и наставлены они","к","благому","из","речи","и наставлены они","к","пути","Достохвального"]],[22,25,["إِنَّ","ٱلَّذِينَ","كَفَرُواْ","وَيَصُدُّونَ","عَن","سَبِيلِ","ٱللَّهِ","وَٱلۡمَسۡجِدِ","ٱلۡحَرَامِ","ٱلَّذِي","جَعَلۡنَٰهُ","لِلنَّاسِ","سَوَآءً","ٱلۡعَٰكِفُ","فِيهِ","وَٱلۡبَادِۚ","وَمَن","يُرِدۡ","فِيهِ","بِإِلۡحَادِۭ","بِظُلۡمٖ","نُّذِقۡهُ","مِنۡ","عَذَابٍ","أَلِيمٖ"],"иннал лазиина кафаруу вайасуддууна `ан сабиилиллахи валмасжидил харамил лазии жа`алнаху линнаси саваанил `акифу фиихи валбади ваман йурид фиихи би'илхади бизулмин нузиḳху мин `азабин алиим","Воистину, тем, которые не веруют, сбивают других с пути Аллаха, не пускают их в Заповедную мечеть, которую Мы воздвигли для всех людей, независимо от того, проживают они в ней или кочуют, а также тем, кто желает там уклониться от истины по несправедливости, Мы дадим вкусить мучительные страдания.",["поистине","те, которые","не уверовали","и отвращают","от","пути","Аллаха","и мечети","Заповедной","которую","сделали Мы её","для людей","равной","живущий постоянно","в ней","и пришедший издалека","и кто","пожелает","в ней","уклонением","по несправедливости","дадим вкусить ему","из","мучения","мучительного"]],[22,26,["وَإِذۡ","بَوَّأۡنَا","لِإِبۡرَٰهِيمَ","مَكَانَ","ٱلۡبَيۡتِ","أَن","لَّا","تُشۡرِكۡ","بِي","شَيۡـٔٗا","وَطَهِّرۡ","بَيۡتِيَ","لِلطَّآئِفِينَ","وَٱلۡقَآئِمِينَ","وَٱلرُّكَّعِ","ٱلسُّجُودِ"],"ва'из бавва'на ли'ибрахиима маканал байти ал ла тушрик бии шай'ан ватаххир байтийа литтаифиина валḳаимиина варрукка`ис сужууд","Вот Мы указали Ибрахиму (Аврааму) на место Дома (Каабы): «Ничего не приобщай ко Мне в сотоварищи и очищай Мой Дом (Каабу) для тех, кто совершает обход, выстаивает намазы, кланяется и падает ниц».",["и вот","отвели Мы","Ибрахиму","место","Дома","чтобы","не","приобщай","ко Мне","ничего","и очищай","Дом Мой","для обходящих","и стоящих","и кланяющихся","падающих ниц"]],[22,27,["وَأَذِّن","فِي","ٱلنَّاسِ","بِٱلۡحَجِّ","يَأۡتُوكَ","رِجَالٗا","وَعَلَىٰ","كُلِّ","ضَامِرٖ","يَأۡتِينَ","مِن","كُلِّ","فَجٍّ","عَمِيقٖ"],"ва'аззин фин наси билхажжи йа'туука рижалан ва`ала кулли дамирин йа'тиина мин кулли фажжин `амииḳ","Возвести людям о хадже, и они будут прибывать к тебе пешком и на всех поджарых верблюдах с самых отдаленных дорог.",["и возвести","среди","людей","о хадже","придут они к тебе","пешими","и на","всяких","поджарых (верблюдах)","придут они","из","всякого","горного пути","далёкого"]],[22,28,["لِّيَشۡهَدُواْ","مَنَٰفِعَ","لَهُمۡ","وَيَذۡكُرُواْ","ٱسۡمَ","ٱللَّهِ","فِيٓ","أَيَّامٖ","مَّعۡلُومَٰتٍ","عَلَىٰ","مَا","رَزَقَهُم","مِّنۢ","بَهِيمَةِ","ٱلۡأَنۡعَٰمِۖ","فَكُلُواْ","مِنۡهَا","وَأَطۡعِمُواْ","ٱلۡبَآئِسَ","ٱلۡفَقِيرَ"],"ллийашхадуу манафи`а лахум вайазкурусмаллахи фии аййамим ма`лууматин `ала ма разаḳахум мим бахииматил ан`ами факулуу минха ва'ат`имул баисал фаḳиир","Пусть они засвидетельствуют то, что приносит им пользу, и поминают имя Аллаха в установленные дни над скотиной, которой Он наделил их. Ешьте от них и кормите неимущего страдальца!",["чтобы засвидетельствовали они","пользу","для них","и поминали","имя","Аллаха","в","дни","известные","над","тем, что","наделил Он их","из","животных","скота","и ешьте","от них","и кормите","бедствующего","нуждающегося"]],[22,29,["ثُمَّ","لۡيَقۡضُواْ","تَفَثَهُمۡ","وَلۡيُوفُواْ","نُذُورَهُمۡ","وَلۡيَطَّوَّفُواْ","بِٱلۡبَيۡتِ","ٱلۡعَتِيقِ"],"суммал йаḳдуу тафасахум валйууфуу нузуурахум валйаттаввафуу билбайтил `атииḳ","Затем пусть они завершат свои обряды, исполнят свои обеты и обойдут вокруг древнего Дома (Каабы).",["затем","пусть завершат","обряды очищения их","и пусть исполнят","обеты свои","и пусть обходят","вокруг Дома","Древнего"]],[22,30,["ذَٰلِكَۖ","وَمَن","يُعَظِّمۡ","حُرُمَٰتِ","ٱللَّهِ","فَهُوَ","خَيۡرٞ","لَّهُۥ","عِندَ","رَبِّهِۦۗ","وَأُحِلَّتۡ","لَكُمُ","ٱلۡأَنۡعَٰمُ","إِلَّا","مَا","يُتۡلَىٰ","عَلَيۡكُمۡۖ","فَٱجۡتَنِبُواْ","ٱلرِّجۡسَ","مِنَ","ٱلۡأَوۡثَٰنِ","وَٱجۡتَنِبُواْ","قَوۡلَ","ٱلزُّورِ"],"залика ваман йу`аззим хуруматиллахи фахуа хайрул лахуу `инда раббихии ва'ухиллат лакумул ан`аму илла ма йутла `алайкум фажтанибур рижса минал аусани важтанибуу ḳаулаз зуур","Вот так! Кто почитает святыни Аллаха, тот поступает во благо себе перед своим Господом. Вам дозволена скотина, кроме той, о которой вам читается. Избегайте же скверны идолов и избегайте лживых речей.",["это так","и кто","возвеличивает","святыни","Аллаха","то это","лучше","для него","у","Господа его","и дозволен","вам","скот","кроме","того, что","читается","вам","и сторонитесь","скверны","из","идолов","и сторонитесь","слова","ложного"]]],"m":[[["وَهُدُوٓاْ","и наставлены они",22,24],["إِلَى","к",22,24],["ٱلطَّيِّبِ","благому",22,24],["مِنَ","из",22,24],["ٱلۡقَوۡلِ","речи",22,24],["وَهُدُوٓاْ","и наставлены они",22,24],["إِلَىٰ","к",22,24],["صِرَٰطِ","пути",22,24],["ٱلۡحَمِيدِ","Достохвального",22,24]],[[24],["إِنَّ","поистине",22,25],["ٱلَّذِينَ","те, которые",22,25],["كَفَرُواْ","не уверовали",22,25],["وَيَصُدُّونَ","и отвращают",22,25],["عَن","от",22,25],["سَبِيلِ","пути",22,25],["ٱللَّهِ","Аллаха",22,25],["وَٱلۡمَسۡجِدِ","и мечети",22,25]],[["ٱلۡحَرَامِ","Заповедной",22,25],["ٱلَّذِي","которую",22,25],["جَعَلۡنَٰهُ","сделали Мы её",22,25],["لِلنَّاسِ","для людей",22,25],["سَوَآءً","равной",22,25],["ٱلۡعَٰكِفُ","живущий постоянно",22,25],["فِيهِ","в ней",22,25],["وَٱلۡبَادِۚ","и пришедший издалека",22,25]],[["وَمَن","и кто",22,25],["يُرِدۡ","пожелает",22,25],["فِيهِ","в ней",22,25],["بِإِلۡحَادِۭ","уклонением",22,25],["بِظُلۡمٖ","по несправедливости",22,25],["نُّذِقۡهُ","дадим вкусить ему",22,25],["مِنۡ","из",22,25],["عَذَابٍ","мучения",22,25],["أَلِيمٖ","мучительного",22,25],[25]],[["وَإِذۡ","и вот",22,26],["بَوَّأۡنَا","отвели Мы",22,26],["لِإِبۡرَٰهِيمَ","Ибрахиму",22,26],["مَكَانَ","место",22,26],["ٱلۡبَيۡتِ","Дома",22,26],["أَن","чтобы",2