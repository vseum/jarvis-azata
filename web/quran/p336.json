{"p":336,"j":17,"a":[[22,31,["حُنَفَآءَ","لِلَّهِ","غَيۡرَ","مُشۡرِكِينَ","بِهِۦۚ","وَمَن","يُشۡرِكۡ","بِٱللَّهِ","فَكَأَنَّمَا","خَرَّ","مِنَ","ٱلسَّمَآءِ","فَتَخۡطَفُهُ","ٱلطَّيۡرُ","أَوۡ","تَهۡوِي","بِهِ","ٱلرِّيحُ","فِي","مَكَانٖ","سَحِيقٖ"],"хунафаа лиллахи гайра мушрикиина бихии ваман йушрик биллахи факааннама харра минас самаи фатахтафухут тайру ау тахвии бихир рииху фии маканин сахииḳ","Оставайтесь ханифами и не приобщайте к Нему сотоварищей. А кто приобщает сотоварищей к Аллаху, тот словно падает с неба, и птицы подхватят его, или же ветер забросит его в далекое место.",["(будучи) единобожниками","перед Аллахом","не","приобщающими сотоварищей","к Нему","и кто","приобщает сотоварищей","к Аллаху","то словно","упал он","с","неба","и схватывают его","птицы","или","бросает","его","ветер","в","место","далёкое"]],[22,32,["ذَٰلِكَۖ","وَمَن","يُعَظِّمۡ","شَعَٰٓئِرَ","ٱللَّهِ","فَإِنَّهَا","مِن","تَقۡوَى","ٱلۡقُلُوبِ"],"залика ваман йу`аззим ша`аираллахи фа'иннаха мин таḳвал ḳулууб","Вот так! И если кто почитает обрядовые знамения Аллаха, то это исходит от богобоязненности в сердцах.",["это так","и кто","возвеличивает","обрядовые знаки","Аллаха","то поистине, это","из","богобоязненности","сердец"]],[22,33,["لَكُمۡ","فِيهَا","مَنَٰفِعُ","إِلَىٰٓ","أَجَلٖ","مُّسَمّٗى","ثُمَّ","مَحِلُّهَآ","إِلَى","ٱلۡبَيۡتِ","ٱلۡعَتِيقِ"],"лакум фииха манафи`у ила ажалим мусамман сумма махиллуха илал байтил `атииḳ","Они (жертвенные животные) приносят вам пользу до определенного времени, а место их заклания - у древнего Дома (Каабы).",["для вас","в них","польза","до","срока","назначенного","затем","место заклания их","у","Дома","Древнего"]],[22,34,["وَلِكُلِّ","أُمَّةٖ","جَعَلۡنَا","مَنسَكٗا","لِّيَذۡكُرُواْ","ٱسۡمَ","ٱللَّهِ","عَلَىٰ","مَا","رَزَقَهُم","مِّنۢ","بَهِيمَةِ","ٱلۡأَنۡعَٰمِۗ","فَإِلَٰهُكُمۡ","إِلَٰهٞ","وَٰحِدٞ","فَلَهُۥٓ","أَسۡلِمُواْۗ","وَبَشِّرِ","ٱلۡمُخۡبِتِينَ"],"валикулли умматин жа`ална мансакал лийазкурусмаллахи `ала ма разаḳахум мим бахииматил ан`ами фа'илахукум илахун вахидун фалахуу аслимуу вабашширил мухбитиин","Для каждой общины Мы установили места жертвоприношений (или религиозные обряды), чтобы они поминали имя Аллаха над скотиной, которой Он наделил их. Ваш Бог - Бог Единственный. Будьте же покорны Ему. А ты сообщи благую весть смиренным,",["и для каждой","общины","установили Мы","обряд жертвоприношения","чтобы поминали они","имя","Аллаха","над","тем, что","наделил Он их","из","животных","скота","и Бог ваш","Бог","Единый","и Ему","покоряйтесь","и обрадуй","смиренных"]],[22,35,["ٱلَّذِينَ","إِذَا","ذُكِرَ","ٱللَّهُ","وَجِلَتۡ","قُلُوبُهُمۡ","وَٱلصَّٰبِرِينَ","عَلَىٰ","مَآ","أَصَابَهُمۡ","وَٱلۡمُقِيمِي","ٱلصَّلَوٰةِ","وَمِمَّا","رَزَقۡنَٰهُمۡ","يُنفِقُونَ"],"аллазиина иза зукираллаху важилат ḳулуубухум вассабириина `ала ма асабахум валмуḳиимис салавати вамимма разаḳнахум йунфиḳуун","сердца которых при упоминании имени Аллаха переполняются страхом, которые терпеливы к тому, что их постигает, совершают намаз и расходуют из того, чем Мы их наделили.",["те, которые","когда","упоминается","Аллах","трепещут","сердца их","и терпеливых","к","тому, что","постигло их","и совершающих","намаз","и из того, что","наделили Мы их","расходуют"]],[22,36,["وَٱلۡبُدۡنَ","جَعَلۡنَٰهَا","لَكُم","مِّن","شَعَٰٓئِرِ","ٱللَّهِ","لَكُمۡ","فِيهَا","خَيۡرٞۖ","فَٱذۡكُرُواْ","ٱسۡمَ","ٱللَّهِ","عَلَيۡهَا","صَوَآفَّۖ","فَإِذَا","وَجَبَتۡ","جُنُوبُهَا","فَكُلُواْ","مِنۡهَا","وَأَطۡعِمُواْ","ٱلۡقَانِعَ","وَٱلۡمُعۡتَرَّۚ","كَذَٰلِكَ","سَخَّرۡنَٰهَا","لَكُمۡ","لَعَلَّكُمۡ","تَشۡكُرُونَ"],"валбудна жа`алнаха лакум мин ша`аириллахи лакум фииха хайрун фазкурусмаллахи `алайха саваффа фа'иза важабат жунуубуха факулуу минха ва'ат`имул ḳани`а валму`тарра казалика саххарнаха лакум ла`аллакум ташкуруун","Жертвенных верблюдов Мы сделали для вас обрядовыми знамениями Аллаха. Они приносят вам пользу. Произносите же над ними имя Аллаха, когда они стоят рядами. Когда же они падут на свои бока, то ешьте от них и кормите тех, кто довольствуется малым, и тех, кто просит от нищеты. Так Мы подчинили их (верблюдов) вам, - быть может, вы будете благодарны.",["и жертвенных верблюдов","сделали Мы их","для вас","из","обрядовых знаков","Аллаха","для вас","в них","благо","и поминайте","имя","Аллаха","над ними","выстроенными в ряд","и когда","упадут","бока их","то ешьте","от них","и кормите","довольствующегося малым","и просящего","так","подчинили Мы их","вам","чтобы вы","были благодарны"]],[22,37,["لَن","يَنَالَ","ٱللَّهَ","لُحُومُهَا","وَلَا","دِمَآؤُهَا","وَلَٰكِن","يَنَالُهُ","ٱلتَّقۡوَىٰ","مِنكُمۡۚ","كَذَٰلِكَ","سَخَّرَهَا","لَكُمۡ","لِتُكَبِّرُواْ","ٱللَّهَ","عَلَىٰ","مَا","هَدَىٰكُمۡۗ","وَبَشِّرِ","ٱلۡمُحۡسِنِينَ"],"лан йаналаллаха лухуумуха вала димауха валакин йаналухут таḳва минкум казалика саххараха лакум литукаббируллаха `ала ма хадакум вабашширил мухсиниин","Ни мясо, ни кровь их не доходят до Аллаха. До Него доходит лишь ваша богобоязненность. Так Он подчинил их вам, чтобы вы возвеличивали Аллаха за то, что Он наставил вас на прямой путь. Обрадуй же благой вестью творящих добро.",["никогда не","достигнет","Аллаха","мясо их","и не","кровь их","но","достигает Его","богобоязненность","от вас","так","подчинил Он их","вам","чтобы возвеличивали вы","Аллаха","за","то, что","наставил Он вас","и обрадуй","творящих добро"]],[22,38,["إِنَّ","ٱللَّهَ","يُدَٰفِعُ","عَنِ","ٱلَّذِينَ","ءَامَنُوٓاْۗ","إِنَّ","ٱللَّهَ","لَا","يُحِبُّ","كُلَّ","خَوَّانٖ","كَفُورٍ"],"инналлаха йудафи`у `анил лазиина амануу инналлаха ла йухиббу кулла хавванин кафуур","Воистину, Аллах оберегает тех, кто уверовал. Воистину, Аллах не любит всяких неблагодарных изменников.",["поистине","Аллах","защищает","от","тех, которые","уверовали","поистине","Аллах","не","любит","всякого","изменника","неблагодарного"]]],"m":[[["حُنَفَآءَ","(будучи) единобожниками",22,31],["لِلَّهِ","перед Аллахом",22,31],["غَيۡرَ","не",22,31],["مُشۡرِكِينَ","приобщающими сотоварищей",22,31],["بِهِۦۚ","к Нему",22,31],["وَمَن","и кто",22,31],["يُشۡرِكۡ","приобщает сотоварищей",22,31],["بِٱللَّهِ"