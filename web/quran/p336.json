","и из того, что",22,35]],[["رَزَقۡنَٰهُمۡ","наделили Мы их",22,35],["يُنفِقُونَ","расходуют",22,35],[35],["وَٱلۡبُدۡنَ","и жертвенных верблюдов",22,36],["جَعَلۡنَٰهَا","сделали Мы их",22,36],["لَكُم","для вас",22,36],["مِّن","из",22,36],["شَعَٰٓئِرِ","обрядовых знаков",22,36]],[["ٱللَّهِ","Аллаха",22,36],["لَكُمۡ","для вас",22,36],["فِيهَا","в них",22,36],["خَيۡرٞۖ","благо",22,36],["فَٱذۡكُرُواْ","и поминайте",22,36],["ٱسۡمَ","имя",22,36],["ٱللَّهِ","Аллаха",22,36],["عَلَيۡهَا","над ними",22,36],["صَوَآفَّۖ","выстроенными в ряд",22,36],["فَإِذَا","и когда",22,36],["وَجَبَتۡ","упадут",22,36]],[["جُنُوبُهَا","бока их",22,36],["فَكُلُواْ","то ешьте",22,36],["مِنۡهَا","от них",22,36],["وَأَطۡعِمُواْ","и кормите",22,36],["ٱلۡقَانِعَ","довольствующегося малым",22,36],["وَٱلۡمُعۡتَرَّۚ","и просящего",22,36],["كَذَٰلِكَ","так",22,36],["سَخَّرۡنَٰهَا","подчинили Мы их",22,36]],[["لَكُمۡ","вам",22,36],["لَعَلَّكُمۡ","чтобы вы",22,36],["تَشۡكُرُونَ","были благодарны",22,36],[36],["لَن","никогда не",22,37],["يَنَالَ","достигнет",22,37],["ٱللَّهَ","Аллаха",22,37],["لُحُومُهَا","мясо их",22,37],["وَلَا","и не",22,37],["دِمَآؤُهَا","кровь их",22,37]],[["وَلَٰكِن","но",22,37],["يَنَالُهُ","достигает Его",22,37],["ٱلتَّقۡوَىٰ","богобоязненность",22,37],["مِنكُمۡۚ","от вас",22,37],["كَذَٰلِكَ","так",22,37],["سَخَّرَهَا","подчинил Он их",22,37],["لَكُمۡ","вам",22,37],["لِتُكَبِّرُواْ","чтобы возвеличивали вы",22,37]],[["ٱللَّهَ","Аллаха",22,37],["عَلَىٰ","за",22,37],["مَا","то, что",22,37],["هَدَىٰكُمۡۗ","наставил Он вас",22,37],["وَبَشِّرِ","и обрадуй",22,37],["ٱلۡمُحۡسِنِينَ","творящих добро",22,37],[37],["۞ إِنَّ","поистине",22,38],["ٱللَّهَ","Аллах",22,38]],[["يُدَٰفِعُ","защищает",22,38],["عَنِ","от",22,38],["ٱلَّذِينَ","тех, которые",22,38],["ءَامَنُوٓاْۗ","уверовали",22,38],["إِنَّ","поистине",22,38],["ٱللَّهَ","Аллах",22,38],["لَا","не",22,38],["يُحِبُّ","любит",22,38],["كُلَّ","всякого",22,38],["خَوَّانٖ","изменника",22,38],["كَفُورٍ","неблагодарного",22,38],[38]]]}