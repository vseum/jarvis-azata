{"p":337,"j":17,"a":[[22,39,["أُذِنَ","لِلَّذِينَ","يُقَٰتَلُونَ","بِأَنَّهُمۡ","ظُلِمُواْۚ","وَإِنَّ","ٱللَّهَ","عَلَىٰ","نَصۡرِهِمۡ","لَقَدِيرٌ"],"узина лиллазиина йуḳаталууна би'аннахум зулимуу ва'инналлаха `ала насрихим лаḳадиир","Дозволено тем, против кого сражаются, сражаться, потому что с ними поступили несправедливо. Воистину, Аллах способен помочь им.",["дозволено","тем, которые","против них сражаются","за то, что они","обижены были","и поистине","Аллах","на","помощь им","непременно способен"]],[22,40,["ٱلَّذِينَ","أُخۡرِجُواْ","مِن","دِيَٰرِهِم","بِغَيۡرِ","حَقٍّ","إِلَّآ","أَن","يَقُولُواْ","رَبُّنَا","ٱللَّهُۗ","وَلَوۡلَا","دَفۡعُ","ٱللَّهِ","ٱلنَّاسَ","بَعۡضَهُم","بِبَعۡضٖ","لَّهُدِّمَتۡ","صَوَٰمِعُ","وَبِيَعٞ","وَصَلَوَٰتٞ","وَمَسَٰجِدُ","يُذۡكَرُ","فِيهَا","ٱسۡمُ","ٱللَّهِ","كَثِيرٗاۗ","وَلَيَنصُرَنَّ","ٱللَّهُ","مَن","يَنصُرُهُۥٓۚ","إِنَّ","ٱللَّهَ","لَقَوِيٌّ","عَزِيزٌ"],"аллазиина ухрижуу мин дийарихим бигайри хаḳḳин илла ан йаḳуулуу раббуналлаху валаула даф`уллахин наса ба`дахум биба`дил лахуддимат савами`у вабийа`ун васалаватун вамасажиду йузкару фиихасмуллахи касииран валайансуранналлаху ман йансурухуу инналлаха лаḳавиййун `азииз","Они были несправедливо изгнаны из своих жилищ только за то, что говорили: «Наш Господь - Аллах». Если бы Аллах не позволил одним людям защищаться от других, то были бы разрушены кельи, церкви, синагоги и мечети, в которых премного поминают имя Аллаха. Аллах непременно помогает тому, кто помогает Ему. Воистину, Аллах - Всесильный, Могущественный.",["те, которые","изгнаны были","из","жилищ их","без","права","кроме","того, что","говорили они","Господь наш","Аллах","и если бы не","отражение","Аллахом","людей","одних из них","другими","непременно были бы разрушены","кельи","и церкви","и синагоги","и мечети","поминается","в них","имя","Аллаха","много","и непременно поможет","Аллах","тому, кто","помогает Ему","поистине","Аллах","непременно Сильный","Могущественный"]],[22,41,["ٱلَّذِينَ","إِن","مَّكَّنَّٰهُمۡ","فِي","ٱلۡأَرۡضِ","أَقَامُواْ","ٱلصَّلَوٰةَ","وَءَاتَوُاْ","ٱلزَّكَوٰةَ","وَأَمَرُواْ","بِٱلۡمَعۡرُوفِ","وَنَهَوۡاْ","عَنِ","ٱلۡمُنكَرِۗ","وَلِلَّهِ","عَٰقِبَةُ","ٱلۡأُمُورِ"],"аллазиина им макканнахум фил арди аḳамус салавата ва'атавуз закавата ва'амаруу билма`рууфи ванахау `анил мункари валиллахи `аḳибатул умуур","Если Мы одарим их властью на земле, они будут совершать намаз, выплачивать закят, велеть совершать одобряемое и запрещать предосудительное. А исход всех дел - у Аллаха.",["те, которые","если","укрепим Мы их","на","земле","совершают","намаз","и дают","закят","и велят","одобряемое","и удерживают","от","порицаемого","и Аллаху","исход","дел"]],[22,42,["وَإِن","يُكَذِّبُوكَ","فَقَدۡ","كَذَّبَتۡ","قَبۡلَهُمۡ","قَوۡمُ","نُوحٖ","وَعَادٞ","وَثَمُودُ"],"ва'ин йуказзибуука фаḳад каззабат ḳаблахум ḳауму нуухин ва`адун васамууд","Если они сочтут тебя лжецом, то ведь еще раньше пророков считали лжецами народ Нуха (Ноя), адиты, самудяне,",["и если","сочтут лжецом тебя","то уже","сочли лжецами","до них","народ","Нуха","и адиты","и самудяне"]],[22,43,["وَقَوۡمُ","إِبۡرَٰهِيمَ","وَقَوۡمُ","لُوطٖ"],"ваḳауму ибрахиима ваḳауму луут","народ Ибрахима (Авраама), народ Лута (Лота)",["и народ","Ибрахима","и народ","Лута"]],[22,44,["وَأَصۡحَٰبُ","مَدۡيَنَۖ","وَكُذِّبَ","مُوسَىٰۖ","فَأَمۡلَيۡتُ","لِلۡكَٰفِرِينَ","ثُمَّ","أَخَذۡتُهُمۡۖ","فَكَيۡفَ","كَانَ","نَكِيرِ"],"ва'асхабу мадйана вакуззиба мууса фа'амлайту лилкафириина сумма ахазтухум факайфа кана накиир","и жители Мадьяна. Мусу (Моисея) тоже сочли лжецом. Я предоставил отсрочку неверующим, а затем схватил их. Каким же было Мое обличение!",["и жители","Мадьяна","и сочтён лжецом","Муса","и дал Я отсрочку","неверующим","затем","схватил Я их","и каким","было","обличение Моё"]],[22,45,["فَكَأَيِّن","مِّن","قَرۡيَةٍ","أَهۡلَكۡنَٰهَا","وَهِيَ","ظَالِمَةٞ","فَهِيَ","خَاوِيَةٌ","عَلَىٰ","عُرُوشِهَا","وَبِئۡرٖ","مُّعَطَّلَةٖ","وَقَصۡرٖ","مَّشِيدٍ"],"факааййим мин ḳарйатин ахлакнаха вахийа залиматун фахийа хавийатун `ала `уруушиха ваби'рим му`атталатин ваḳасрим машиид","Сколько селений, которые были несправедливы, Мы погубили, и теперь они разрушены до основания. Сколько заброшенных колодцев и воздвигнутых дворцов!",["и сколько","из","селений","погубили Мы его","в то время как оно","несправедливо","и оно","рухнуло","на","кровли свои","и колодцев","заброшенных","и дворцов","воздвигнутых"]],[22,46,["أَفَلَمۡ","يَسِيرُواْ","فِي","ٱلۡأَرۡضِ","فَتَكُونَ","لَهُمۡ","قُلُوبٞ","يَعۡقِلُونَ","بِهَآ","أَوۡ","ءَاذَانٞ","يَسۡمَعُونَ","بِهَاۖ","فَإِنَّهَا","لَا","تَعۡمَى","ٱلۡأَبۡصَٰرُ","وَلَٰكِن","تَعۡمَى","ٱلۡقُلُوبُ","ٱلَّتِي","فِي","ٱلصُّدُورِ"],"афалам йасиируу фил арди фатакууна лахум ḳулуубун йа`ḳилууна биха ау азанун йасма`ууна биха фа'иннаха ла та`мал абсару валакин та`мал ḳулуубул латии фис судуур","Разве они не странствовали по земле, имея сердца, посредством которых они могли разуметь, и уши, посредством которых они могли слушать? Воистину, слепнут не глаза, а слепнут сердца, находящиеся в груди.",["разве не","странствовали они","по","земле","чтобы были","у них","сердца","разумеющие","ими","или","уши","слышащие","ими","ибо поистине","не","слепнут","взоры","но","слепнут","сердца","которые","в","грудях"]]],"m":[[["أُذِنَ","дозволено",22,39],["لِلَّذِينَ","тем, которые",22,39],["يُقَٰتَلُونَ","против них сражаются",22,39],["بِأَنَّهُمۡ","за то, что они",22,39],["ظُلِمُواْۚ","обижены были",22,39],["وَإِنَّ","и поистине",22,39],["ٱللَّهَ","Аллах",22,39],["عَلَىٰ","на",22,39],["نَصۡرِهِمۡ","помощь им",22,39]],[["لَقَدِيرٌ","непременно способен",22,39],[39],["ٱلَّذِينَ","те, которые",22,40],["أُخۡرِجُواْ","изгнаны были",22,40],["مِن","из",22,40],["دِيَٰرِهِم","жилищ их",22,40],["بِغَيۡرِ","без",22,40],["حَقٍّ","права",22,40],["إِلَّآ","кроме",22,40],["أَن","того, что",22,40]],[["يَقُولُواْ","говорили они",22,40],["رَبُّنَا","Господь наш",22,40],["ٱللَّهُۗ","Аллах",22,40],["وَلَوۡلَا","и если бы не",22,40],["دَفۡعُ","отражение",22,40],["ٱللَّهِ","Аллахом",22,40],["ٱلنَّاسَ","людей",22,40],["بَعۡضَهُم","одних из них",22,