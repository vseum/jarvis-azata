{"p":338,"j":17,"a":[[22,47,["وَيَسۡتَعۡجِلُونَكَ","بِٱلۡعَذَابِ","وَلَن","يُخۡلِفَ","ٱللَّهُ","وَعۡدَهُۥۚ","وَإِنَّ","يَوۡمًا","عِندَ","رَبِّكَ","كَأَلۡفِ","سَنَةٖ","مِّمَّا","تَعُدُّونَ"],"вайаста`жилуунака бил`азаби валан йухлифаллаху ва`дахуу ва'инна йауман `инда раббика ка'алфи санатим мимма та`уддуун","Они торопят тебя с наказанием, но Аллах не нарушает Своего обещания, и день у твоего Господа равен тысяче лет по тому, как вы считаете.",["и торопят они тебя","с наказанием","и никогда не","нарушит","Аллах","обещания Своего","и поистине","день","у","Господа твоего","как тысяча","лет","из того, что","считаете вы"]],[22,48,["وَكَأَيِّن","مِّن","قَرۡيَةٍ","أَمۡلَيۡتُ","لَهَا","وَهِيَ","ظَالِمَةٞ","ثُمَّ","أَخَذۡتُهَا","وَإِلَيَّ","ٱلۡمَصِيرُ"],"вакааййим мин ḳарйатин амлайту лаха вахийа залиматун сумма ахазтуха ва'илаййал масиир","Скольким селениям, которые были несправедливы, Я предоставил отсрочку! Впоследствии Я схватил их, и ко Мне предстоит прибытие.",["и сколько","из","селений","дал Я отсрочку","ему","в то время как оно","несправедливо","затем","схватил Я его","и ко Мне","возвращение"]],[22,49,["قُلۡ","يَٰٓأَيُّهَا","ٱلنَّاسُ","إِنَّمَآ","أَنَا۠","لَكُمۡ","نَذِيرٞ","مُّبِينٞ"],"ḳул йа'аййухан насу иннама ана лакум назиирум мубиин","Скажи: «О люди! Воистину, я для вас - предостерегающий и разъясняющий увещеватель».",["скажи","о","люди","лишь","я","для вас","увещеватель","ясный"]],[22,50,["فَٱلَّذِينَ","ءَامَنُواْ","وَعَمِلُواْ","ٱلصَّٰلِحَٰتِ","لَهُم","مَّغۡفِرَةٞ","وَرِزۡقٞ","كَرِيمٞ"],"фаллазиина амануу ва`амилус салихати лахум магфиратун варизḳун кариим","Тем, которые уверовали и совершали праведные деяния, уготованы прощение и щедрый удел.",["и те, которые","уверовали","и совершали","праведные (дела)","для них","прощение","и удел","щедрый"]],[22,51,["وَٱلَّذِينَ","سَعَوۡاْ","فِيٓ","ءَايَٰتِنَا","مُعَٰجِزِينَ","أُوْلَٰٓئِكَ","أَصۡحَٰبُ","ٱلۡجَحِيمِ"],"валлазиина са`ау фии айатина му`ажизиина улаика асхабул жахиим","Те же, которые старались ослабить Наши знамения, станут обитателями Огня.",["а те, которые","старались","против","знамений Наших","(желая) ослабить","те","обитатели","Ада"]],[22,52,["وَمَآ","أَرۡسَلۡنَا","مِن","قَبۡلِكَ","مِن","رَّسُولٖ","وَلَا","نَبِيٍّ","إِلَّآ","إِذَا","تَمَنَّىٰٓ","أَلۡقَى","ٱلشَّيۡطَٰنُ","فِيٓ","أُمۡنِيَّتِهِۦ","فَيَنسَخُ","ٱللَّهُ","مَا","يُلۡقِي","ٱلشَّيۡطَٰنُ","ثُمَّ","يُحۡكِمُ","ٱللَّهُ","ءَايَٰتِهِۦۗ","وَٱللَّهُ","عَلِيمٌ","حَكِيمٞ"],"вама арсална мин ḳаблика мир расуулин вала набиййин илла иза таманна алḳаш шайтану фии умниййатихии файансахуллаху ма йулḳиш шайтану сумма йухкимуллаху айатихии валлаху `алиимун хакиим","Мы не отправляли до тебя такого посланника или пророка, чтобы дьявол не подбросил свое в его чтение, когда он читал откровение. Аллах уничтожает то, что подбрасывает дьявол. Потом Аллах утверждает Свои знамения, ведь Аллах - Знающий, Мудрый.",["и не","посылали Мы","из","прежде тебя","из","посланника","и не","пророка","кроме того, что","когда","читал он","подбрасывал","дьявол","в","чтение его","и уничтожает","Аллах","то, что","подбрасывает","дьявол","затем","утверждает","Аллах","знамения Свои","и Аллах","Знающий","Мудрый"]],[22,53,["لِّيَجۡعَلَ","مَا","يُلۡقِي","ٱلشَّيۡطَٰنُ","فِتۡنَةٗ","لِّلَّذِينَ","فِي","قُلُوبِهِم","مَّرَضٞ","وَٱلۡقَاسِيَةِ","قُلُوبُهُمۡۗ","وَإِنَّ","ٱلظَّٰلِمِينَ","لَفِي","شِقَاقِۭ","بَعِيدٖ"],"ллийаж`ала ма йулḳиш шайтану фитнатал лиллазиина фии ḳулуубихим марадун валḳасийати ḳулуубухум ва'инназ залимиина лафии шиḳаḳи ба`иид","Он делает то, что подбрасывает дьявол, искушением для тех, чьи сердца поражены недугом и чьи сердца ожесточены. Воистину, беззаконники находятся в полном разладе с истиной.",["чтобы сделал Он","то, что","подбрасывает","дьявол","искушением","для тех, которые","в","сердцах их","болезнь","и ожесточённых","сердцами их","и поистине","несправедливые","непременно в","разладе","далёком"]],[22,54,["وَلِيَعۡلَمَ","ٱلَّذِينَ","أُوتُواْ","ٱلۡعِلۡمَ","أَنَّهُ","ٱلۡحَقُّ","مِن","رَّبِّكَ","فَيُؤۡمِنُواْ","بِهِۦ","فَتُخۡبِتَ","لَهُۥ","قُلُوبُهُمۡۗ","وَإِنَّ","ٱللَّهَ","لَهَادِ","ٱلَّذِينَ","ءَامَنُوٓاْ","إِلَىٰ","صِرَٰطٖ","مُّسۡتَقِيمٖ"],"валийа`ламал лазиина уутул `илма аннахул хаḳḳу мир раббика файу'минуу бихии фатухбита лахуу ḳулуубухум ва'инналлаха лахадил лазиина амануу ила сиратим мустаḳиим","Пусть знают те, кому даровано знание, что это - истина от твоего Господа, чтобы они могли уверовать в него, а их сердца могли смиренно покориться ему. Воистину, Аллах наставляет верующих на прямой путь.",["и чтобы знали","те, которые","дано им","знание","что это","истина","от","Господа твоего","и уверуют они","в него","и смирятся","перед ним","сердца их","и поистине","Аллах","непременно ведёт","тех, которые","уверовали","к","пути","прямому"]],[22,55,["وَلَا","يَزَالُ","ٱلَّذِينَ","كَفَرُواْ","فِي","مِرۡيَةٖ","مِّنۡهُ","حَتَّىٰ","تَأۡتِيَهُمُ","ٱلسَّاعَةُ","بَغۡتَةً","أَوۡ","يَأۡتِيَهُمۡ","عَذَابُ","يَوۡمٍ","عَقِيمٍ"],"вала йазалул лазиина кафаруу фии мирйатим минху хатта та'тийахумус са`ату багтатан ау йа'тийахум `азабу йаумин `аḳиим","А неверующие не перестанут сомневаться в нем, пока не нагрянет внезапно Час или пока не постигнут их мучения в бесплодный день.",["и не","перестанут","те, которые","не уверовали","(быть) в","сомнении","о нём","пока не","придёт к ним","Час","внезапно","или","придёт к ним","мучение","дня","бесплодного"]]],"m":[[["وَيَسۡتَعۡجِلُونَكَ","и торопят они тебя",22,47],["بِٱلۡعَذَابِ","с наказанием",22,47],["وَلَن","и никогда не",22,47],["يُخۡلِفَ","нарушит",22,47],["ٱللَّهُ","Аллах",22,47],["وَعۡدَهُۥۚ","обещания Своего",22,47],["وَإِنَّ","и поистине",22,47],["يَوۡمًا","день",22,47]],[["عِندَ","у",22,47],["رَبِّكَ","Господа твоего",22,47],["كَأَلۡفِ","как тысяча",22,47],["سَنَةٖ","лет",22,47],["مِّمَّا","из того, что",22,47],["تَعُدُّونَ","считаете вы",22,47],[47],["وَكَأَيِّن","и сколько",22,48],["مِّن","из",22,48]],[["قَرۡيَةٍ","селений",22,48],["أَمۡلَيۡتُ","дал Я отсрочку",22,48],["لَهَا","ему",22,48],["وَهِيَ","в то время как оно",22,48],["ظَالِمَةٞ","несправедливо",22,48],["ثُمَّ","затем",22,48],["أَخَذۡتُهَا","схватил Я его",22,48],["وَإِلَيَّ","и ко Мне",22,48],["ٱلۡمَصِيرُ","возвращение",22,48]],[[48],["قُلۡ","скажи",22,49],["يَٰٓأَيُّهَا","о",22,49],["ٱلنَّاسُ","люди",22,49],["إِنَّمَآ","лишь",22,49],["أَنَا۠","я",22,49],["لَكُمۡ","для вас",22,49],["نَذِيرٞ","увещеватель",22,49],["مُّبِينٞ","ясный",22,49],[49],["فَٱلَّذِينَ","и те, которые",22,50]],[["ءَامَنُواْ","уверовали",22,50],["وَعَمِلُواْ","и совершали",22,50],["ٱلصَّٰلِحَٰتِ","праведные (дела)",22,50],["لَهُم","для них",22,50],["مَّغۡفِرَةٞ","прощение",22,50],["وَرِزۡقٞ","и удел",22,50],["كَرِيمٞ","щедрый",22,50],[50]],[["وَٱلَّذِينَ","а те, которые",22,51],["سَعَوۡاْ","старались",22,51],["فِيٓ","против",22,51],["ءَايَٰتِنَا","знамений Наших",22,51],["مُعَٰجِزِينَ","(желая) ослабить",22,51],["أُوْلَٰٓئِكَ","те",22,51],["أَصۡحَٰبُ","обитатели",22,51],["ٱلۡجَحِيمِ","Ада",22,51]],[[51],["وَمَآ","и не",22,52],["أَرۡسَلۡنَا","посылали Мы",22,52],["مِن","из",22,52],["قَبۡلِكَ","прежде тебя",22,52],["مِن","из",22,52],["رَّسُولٖ","посланника",22,52],["وَلَا","и не",22,52],["نَبِيٍّ","пророка",22,52],["إِلَّآ","кроме того, что",22,52],["إِذَا","когда",22,52],["تَمَنَّىٰٓ","читал он",22,52]],[["أَلۡقَى","подбрасывал",22,52],["ٱلشَّيۡطَٰنُ","дьявол",22,52],["فِيٓ","в",22,52],["أُمۡنِيَّتِهِۦ","чтение его",22,52],["فَيَنسَخُ","и уничтожает",22,52],["ٱللَّهُ","Аллах",22,52],["مَا","то, что",22,52],["يُلۡقِي","подбрасывает",22,52],["ٱلشَّيۡطَٰنُ","дьявол",22,52]],[["ثُمَّ","затем",22,52],["يُحۡكِمُ","утверждает",22,52],["ٱللَّهُ","Аллах",22,52],["ءَايَٰتِهِۦۗ","знамения Свои",22,52],["وَٱللَّهُ","и Аллах",22,52],["عَلِيمٌ","Знающий",22,52],["حَكِيمٞ","Мудрый",22,52],[52],["لِّيَجۡعَلَ","чтобы сделал Он",22,53]],[["مَا","то, что",22,53],["يُلۡقِي","подбрасывает",22,53],["ٱلشَّيۡطَٰنُ","дьявол",22,53],["فِتۡنَةٗ","искушением",22,53],["لِّلَّذِينَ","для тех, которые",22,53],["فِي","в",22,53],["قُلُوبِهِم","сердцах их",22,53],["مَّرَضٞ","болезнь",22,53],["وَٱلۡقَاسِيَةِ","и ожесточённых",22,53]],[["قُلُوبُهُمۡۗ","сердцами их",22,53],["وَإِنَّ","и поистине",22,53],["ٱلظَّٰلِمِينَ","несправедливые",22,53],["لَفِي","непременно в",22,53],["شِقَاقِۭ","разладе",22,53],["بَعِيدٖ","далёком",22,53],[53],["وَلِيَعۡلَمَ","и чтобы знали",22,54]],[["ٱلَّذِينَ","те, которые",22,54],["أُوتُواْ","дано им",22,54],["ٱلۡعِلۡمَ","знание",22,54],["أَنَّهُ","что это",22,54],["ٱلۡحَقُّ","истина",22,54],["مِن","от",22,54],["رَّبِّكَ","Господа твоего",22,54],["فَيُؤۡمِنُواْ","и уверуют они",22,54],["بِهِۦ","в него",22,54]],[["فَتُخۡبِتَ","и смирятся",22,54],["لَهُۥ","перед ним",22,54],["قُلُوبُهُمۡۗ","сердца их",22,54],["وَإِنَّ","и поистине",22,54],["ٱللَّهَ","Аллах",22,54],["لَهَادِ","непременно ведёт",22,54],["ٱلَّذِينَ","тех, которые",22,54],["ءَامَنُوٓاْ","уверовали",22,54],["إِلَىٰ","к",22,54],["صِرَٰطٖ","пути",22,54]],[["مُّسۡتَقِيمٖ","прямому",22,54],[54],["وَلَا","и не",22,55],["يَزَالُ","перестанут",22,55],["ٱلَّذِينَ","те, которые",22,55],["كَفَرُواْ","не уверовали",22,55],["فِي","(быть) в",22,55],["مِرۡيَةٖ","сомнении",22,55],["مِّنۡهُ","о нём",22,55],["حَتَّىٰ","пока не",22,55]],[["تَأۡتِيَهُمُ","придёт к ним",22,55],["ٱلسَّاعَةُ","Час",22,55],["بَغۡتَةً","внезапно",22,55],["أَوۡ","или",22,55],["يَأۡتِيَهُمۡ","придёт к ним",22,55],["عَذَابُ","мучение",22,55],["يَوۡمٍ","дня",22,55],["عَقِيمٍ","бесплодного",22,55],[55]]]}