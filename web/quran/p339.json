{"p":339,"j":17,"a":[[22,56,["ٱلۡمُلۡكُ","يَوۡمَئِذٖ","لِّلَّهِ","يَحۡكُمُ","بَيۡنَهُمۡۚ","فَٱلَّذِينَ","ءَامَنُواْ","وَعَمِلُواْ","ٱلصَّٰلِحَٰتِ","فِي","جَنَّٰتِ","ٱلنَّعِيمِ"],"алмулку йаумаизил лиллахи йахкуму байнахум фаллазиина амануу ва`амилус салихати фии жаннатин на`иим","Власть в тот день будет принадлежать Аллаху, и Он рассудит между ними. И тогда те, которые уверовали и совершали праведные деяния, окажутся в Садах блаженства.",["власть","в тот день","Аллаху","рассудит Он","между ними","и те, которые","уверовали","и совершали","праведные (дела)","в","садах","блаженства"]],[22,57,["وَٱلَّذِينَ","كَفَرُواْ","وَكَذَّبُواْ","بِـَٔايَٰتِنَا","فَأُوْلَٰٓئِكَ","لَهُمۡ","عَذَابٞ","مُّهِينٞ"],"валлазиина кафаруу ваказзабуу би'айатина фа'улаика лахум `азабум мухиин","Тем же, которые не уверовали и считали ложью Наши знамения, уготованы унизительные мучения.",["а те, которые","не уверовали","и сочли ложью","знамения Наши","то те","для них","мучение","унизительное"]],[22,58,["وَٱلَّذِينَ","هَاجَرُواْ","فِي","سَبِيلِ","ٱللَّهِ","ثُمَّ","قُتِلُوٓاْ","أَوۡ","مَاتُواْ","لَيَرۡزُقَنَّهُمُ","ٱللَّهُ","رِزۡقًا","حَسَنٗاۚ","وَإِنَّ","ٱللَّهَ","لَهُوَ","خَيۡرُ","ٱلرَّٰزِقِينَ"],"валлазиина хажаруу фии сабиилиллахи сумма ḳутилуу ау матуу лайарзуḳаннахумуллаху ризḳан хасанан ва'инналлаха лахуа хайрур разиḳиин","Аллах непременно наделит прекрасным уделом тех, которые переселились на пути Аллаха, а затем были убиты или умерли. Воистину, Аллах - Наилучший из дарующих удел.",["и те, которые","переселились","на","пути","Аллаха","затем","были убиты","или","умерли","непременно наделит их","Аллах","уделом","прекрасным","и поистине","Аллах","непременно Он","Лучший","из дарующих удел"]],[22,59,["لَيُدۡخِلَنَّهُم","مُّدۡخَلٗا","يَرۡضَوۡنَهُۥۚ","وَإِنَّ","ٱللَّهَ","لَعَلِيمٌ","حَلِيمٞ"],"лайудхиланнахум мудхалан йардаунахуу ва'инналлаха ла`алиимун халиим","Он непременно введет их во вход, которым они останутся довольны. Воистину, Аллах - Знающий, Выдержанный.",["непременно введет Он их","входом","которым они будут довольны","и поистине","Аллах","непременно Знающий","Выдержанный"]],[22,60,["ذَٰلِكَۖ","وَمَنۡ","عَاقَبَ","بِمِثۡلِ","مَا","عُوقِبَ","بِهِۦ","ثُمَّ","بُغِيَ","عَلَيۡهِ","لَيَنصُرَنَّهُ","ٱللَّهُۚ","إِنَّ","ٱللَّهَ","لَعَفُوٌّ","غَفُورٞ"],"залика ваман `аḳаба бимисли ма `ууḳиба бихии сумма бугийа `алайхи лайансураннахуллаху инналлаха ла`афуввун гафуур","Вот так! Если кто-либо наказывает так, как он сам был наказан, после чего с ним поступают несправедливо, то Аллах непременно поможет ему. Воистину, Аллах - Снисходительный, Прощающий.",["это так","и кто","наказал","подобным","тому, чем","был наказан","им","затем","поступили несправедливо","с ним","непременно поможет ему","Аллах","поистине","Аллах","непременно Снисходительный","Прощающий"]],[22,61,["ذَٰلِكَ","بِأَنَّ","ٱللَّهَ","يُولِجُ","ٱلَّيۡلَ","فِي","ٱلنَّهَارِ","وَيُولِجُ","ٱلنَّهَارَ","فِي","ٱلَّيۡلِ","وَأَنَّ","ٱللَّهَ","سَمِيعُۢ","بَصِيرٞ"],"залика би'анналлаха йуулижул лайла фин нахари вайуулижун нахара фил лайли ва'анналлаха самии`у басиир","Это потому, что Аллах удлиняет день за счет ночи и удлиняет ночь за счет дня, а также потому, что Аллах - Слышащий, Видящий.",["это","потому что","Аллах","вводит","ночь","в","день","и вводит","день","в","ночь","и что","Аллах","Слышащий","Видящий"]],[22,62,["ذَٰلِكَ","بِأَنَّ","ٱللَّهَ","هُوَ","ٱلۡحَقُّ","وَأَنَّ","مَا","يَدۡعُونَ","مِن","دُونِهِۦ","هُوَ","ٱلۡبَٰطِلُ","وَأَنَّ","ٱللَّهَ","هُوَ","ٱلۡعَلِيُّ","ٱلۡكَبِيرُ"],"залика би'анналлаха хуал хаḳḳу ва'анна ма йад`ууна мин дуунихии хуал батилу ва'анналлаха хуал `алиййул кабиир","Это потому, что Аллах есть Истина, а то, чему они поклоняются помимо Него, есть ложь, а также потому, что Аллах - Возвышенный, Большой.",["это","потому что","Аллах","Он","Истина","и что","то, что","призывают они","из","помимо Него","оно","ложь","и что","Аллах","Он","Возвышенный","Большой"]],[22,63,["أَلَمۡ","تَرَ","أَنَّ","ٱللَّهَ","أَنزَلَ","مِنَ","ٱلسَّمَآءِ","مَآءٗ","فَتُصۡبِحُ","ٱلۡأَرۡضُ","مُخۡضَرَّةًۚ","إِنَّ","ٱللَّهَ","لَطِيفٌ","خَبِيرٞ"],"алам тара анналлаха анзала минас самаи маан фатусбихул арду мухдарратан инналлаха латиифун хабиир","Неужели ты не видишь, как Аллах ниспосылает с неба воду, после чего земля зеленеет? Воистину, Аллах - Проницательный (или Добрый), Ведающий.",["разве не","видел ты","что","Аллах","ниспослал","с","неба","воду","и становится","земля","зелёной","поистине","Аллах","Проницательный","Ведающий"]],[22,64,["لَّهُۥ","مَا","فِي","ٱلسَّمَٰوَٰتِ","وَمَا","فِي","ٱلۡأَرۡضِۚ","وَإِنَّ","ٱللَّهَ","لَهُوَ","ٱلۡغَنِيُّ","ٱلۡحَمِيدُ"],"ллахуу ма фис самавати вама фил арди ва'инналлаха лахуал ганиййул хамиид","Ему принадлежит то, что на небесах, и то, что на земле. Воистину, Аллах - Богатый, Достохвальный.",["Ему","то, что","в","небесах","и то, что","на","земле","и поистине","Аллах","непременно Он","Богатый","Достохвальный"]]],"m":[[["ٱلۡمُلۡكُ","власть",22,56],["يَوۡمَئِذٖ","в тот день",22,56],["لِّلَّهِ","Аллаху",22,56],["يَحۡكُمُ","рассудит Он",22,56],["بَيۡنَهُمۡۚ","между ними",22,56],["فَٱلَّذِينَ","и те, которые",22,56],["ءَامَنُواْ","уверовали",22,56]],[["وَعَمِلُواْ","и совершали",22,56],["ٱلصَّٰلِحَٰتِ","праведные (дела)",22,56],["فِي","в",22,56],["جَنَّٰتِ","садах",22,56],["ٱلنَّعِيمِ","блаженства",22,56],[56],["وَٱلَّذِينَ","а те, которые",22,57],["كَفَرُواْ","не уверовали",22,57]],[["وَكَذَّبُواْ","и сочли ложью",22,57],["بِـَٔايَٰتِنَا","знамения Наши",22,57],["فَأُوْلَٰٓئِكَ","то те",22,57],["لَهُمۡ","для них",22,57],["عَذَابٞ","мучение",22,57],["مُّهِينٞ","унизительное",22,57],[57]],[["وَٱلَّذِينَ","и те, которые",22,58],["هَاجَرُواْ","переселились",22,58],["فِي","на",22,58],["سَبِيلِ","пути",22,58],["ٱللَّهِ","Аллаха",22,58],["ثُمَّ","затем",22,58],["قُتِلُوٓاْ","были убиты",22,58],["أَوۡ","или",22,58],["مَاتُواْ","умерли",22,58]],[["لَيَرۡزُقَنَّهُمُ","непременно наделит их",22,58],["ٱللَّهُ","Аллах",22,58],["رِزۡقًا","уделом",22,58],["حَسَنٗاۚ","прекрасным",22,58],["وَإِنَّ","и поистине",22,58],["ٱللَّهَ","Аллах",22,58],["لَهُوَ","непременн