{"p":340,"j":17,"a":[[22,65,["أَلَمۡ","تَرَ","أَنَّ","ٱللَّهَ","سَخَّرَ","لَكُم","مَّا","فِي","ٱلۡأَرۡضِ","وَٱلۡفُلۡكَ","تَجۡرِي","فِي","ٱلۡبَحۡرِ","بِأَمۡرِهِۦ","وَيُمۡسِكُ","ٱلسَّمَآءَ","أَن","تَقَعَ","عَلَى","ٱلۡأَرۡضِ","إِلَّا","بِإِذۡنِهِۦٓۚ","إِنَّ","ٱللَّهَ","بِٱلنَّاسِ","لَرَءُوفٞ","رَّحِيمٞ"],"алам тара анналлаха саххара лакум ма фил арди валфулка тажрии фил бахри би'амрихии вайумсикус самаа ан таḳа`а `алал арди илла би'изнихии инналлаха биннаси лараууфур рахиим","Разве ты не видишь, что Аллах подчинил вам все, что на земле, и корабли, которые плывут по морям по Его воле? Он удерживает небо, чтобы оно не упало на землю без Его соизволения. Воистину, Аллах сострадателен и милосерден к людям.",["разве не","видел ты","что","Аллах","подчинил","вам","то, что","на","земле","и корабли","плывут","по","морю","по велению Его","и удерживает Он","небо","чтобы не","упало","на","землю","кроме как","с дозволения Его","поистине","Аллах","к людям","непременно Сострадательный","Милосердный"]],[22,66,["وَهُوَ","ٱلَّذِيٓ","أَحۡيَاكُمۡ","ثُمَّ","يُمِيتُكُمۡ","ثُمَّ","يُحۡيِيكُمۡۗ","إِنَّ","ٱلۡإِنسَٰنَ","لَكَفُورٞ"],"вахуал лазии ахйакум сумма йумиитукум сумма йухйиикум иннал инсана лакафуур","Он - Тот, Кто дарует вам жизнь, затем умерщвляет вас, а затем вновь оживляет. А человек, воистину, неблагодарен.",["и Он","Тот, Который","оживил вас","затем","умертвит вас","затем","оживит вас","поистине","человек","непременно неблагодарен"]],[22,67,["لِّكُلِّ","أُمَّةٖ","جَعَلۡنَا","مَنسَكًا","هُمۡ","نَاسِكُوهُۖ","فَلَا","يُنَٰزِعُنَّكَ","فِي","ٱلۡأَمۡرِۚ","وَٱدۡعُ","إِلَىٰ","رَبِّكَۖ","إِنَّكَ","لَعَلَىٰ","هُدٗى","مُّسۡتَقِيمٖ"],"лликулли умматин жа`ална мансакан хум насикууху фала йунази`уннака фил амри вад`у ила раббика иннака ла`ала худам мустаḳиим","Для каждой общины Мы установили обряды, которые они отправляют, и пусть они не спорят с тобой по этому поводу. Призывай же к своему Господу. Воистину, ты - на прямом пути.",["для каждой","общины","установили Мы","обряд","они","совершают его","и пусть не","препираются с тобой","в","деле","и призывай","к","Господу твоему","поистине, ты","непременно на","руководстве","прямом"]],[22,68,["وَإِن","جَٰدَلُوكَ","فَقُلِ","ٱللَّهُ","أَعۡلَمُ","بِمَا","تَعۡمَلُونَ"],"ва'ин жадалуука фаḳулиллаху а`ламу бима та`малуун","Если же они станут препираться с тобой, то скажи: «Аллаху лучше знать о том, что вы совершаете.",["и если","препирались они с тобой","то скажи","Аллах","лучше знает","о том, что","делаете вы"]],[22,69,["ٱللَّهُ","يَحۡكُمُ","بَيۡنَكُمۡ","يَوۡمَ","ٱلۡقِيَٰمَةِ","فِيمَا","كُنتُمۡ","فِيهِ","تَخۡتَلِفُونَ"],"аллаху йахкуму байнакум йаумал ḳийамати фиима кунтум фиихи тахталифуун","Аллах рассудит между вами в День воскресения в том, в чем вы препирались между собой».",["Аллах","рассудит","между вами","в День","воскресения","в том, в чём","были вы","в нём","расходились"]],[22,70,["أَلَمۡ","تَعۡلَمۡ","أَنَّ","ٱللَّهَ","يَعۡلَمُ","مَا","فِي","ٱلسَّمَآءِ","وَٱلۡأَرۡضِۚ","إِنَّ","ذَٰلِكَ","فِي","كِتَٰبٍۚ","إِنَّ","ذَٰلِكَ","عَلَى","ٱللَّهِ","يَسِيرٞ"],"алам та`лам анналлаха йа`ламу ма фис самаи вал'арди инна залика фии китабин инна залика `алаллахи йасиир","Разве ты не знаешь, что Аллаху известно то, что на небе и на земле? Воистину, это есть в Писании. Воистину, это для Аллаха легко.",["разве не","знаешь ты","что","Аллах","знает","то, что","в","небе","и на земле","поистине","это","в","Писании","поистине","это","для","Аллаха","легко"]],[22,71,["وَيَعۡبُدُونَ","مِن","دُونِ","ٱللَّهِ","مَا","لَمۡ","يُنَزِّلۡ","بِهِۦ","سُلۡطَٰنٗا","وَمَا","لَيۡسَ","لَهُم","بِهِۦ","عِلۡمٞۗ","وَمَا","لِلظَّٰلِمِينَ","مِن","نَّصِيرٖ"],"вайа`будууна мин дууниллахи ма лам йуназзил бихии султанан вама лайса лахум бихии `илмун вама лиззалимиина мин насиир","Они поклоняются вместо Аллаха тому, о чем Он не ниспослал никакого довода, о чем у них нет никакого знания. Не будет у беззаконников помощников!",["и поклоняются они","из","помимо","Аллаха","тому, чему","не","ниспослал Он","для этого","довода","и тому, чего","нет","у них","о нём","знания","и нет","для несправедливых","из","помощника"]],[22,72,["وَإِذَا","تُتۡلَىٰ","عَلَيۡهِمۡ","ءَايَٰتُنَا","بَيِّنَٰتٖ","تَعۡرِفُ","فِي","وُجُوهِ","ٱلَّذِينَ","كَفَرُواْ","ٱلۡمُنكَرَۖ","يَكَادُونَ","يَسۡطُونَ","بِٱلَّذِينَ","يَتۡلُونَ","عَلَيۡهِمۡ","ءَايَٰتِنَاۗ","قُلۡ","أَفَأُنَبِّئُكُم","بِشَرّٖ","مِّن","ذَٰلِكُمُۚ","ٱلنَّارُ","وَعَدَهَا","ٱللَّهُ","ٱلَّذِينَ","كَفَرُواْۖ","وَبِئۡسَ","ٱلۡمَصِيرُ"],"ва'иза тутла `алайхим айатуна баййинатин та`рифу фии вужуухил лазиина кафарул мункара йакадууна йастууна биллазиина йатлууна `алайхим айатина ḳул афаунаббиукум бишаррим мин заликумун нару ва`адахаллахул лазиина кафаруу ваби'сал масиир","Когда им читают Наши ясные аяты, ты видишь на их лицах отрицание. Они готовы наброситься на тех, кто читает им Наши аяты. Скажи: «Не поведать ли вам о том, что хуже этого? Это - Огонь, который Аллах обещал тем, которые не уверовали. Как же скверно это место прибытия!».",["и когда","читаются","им","знамения Наши","ясные","узнаешь ты","на","лицах","тех, которые","не уверовали","отрицание","готовы они","наброситься","на тех, которые","читают","им","знамения Наши","скажи","разве сообщить вам","о худшем","чем","это","Огонь","обещал его","Аллах","тем, которые","не уверовали","и скверно","место прибытия"]]],"m":[[["أَلَمۡ","разве не",22,65],["تَرَ","видел ты",22,65],["أَنَّ","что",22,65],["ٱللَّهَ","Аллах",22,65],["سَخَّرَ","подчинил",22,65],["لَكُم","вам",22,65],["مَّا","то, что",22,65],["فِي","на",22,65],["ٱلۡأَرۡضِ","земле",22,65],["وَٱلۡفُلۡكَ","и корабли",22,65],["تَجۡرِي","плывут",22,65],["فِي","по",22,65],["ٱلۡبَحۡرِ","морю",22,65]],[["بِأَمۡرِهِۦ","по велению Его",22,65],["وَيُمۡسِكُ","и удерживает Он",22,65],["ٱلسَّمَآءَ","небо",22,65],["أَن","чтобы не",22,65],["تَقَعَ","упало",22,65],["عَلَى","на",22,65],["ٱلۡأَرۡضِ","землю",22,65],["إِلَّا","кроме как",22,65],["بِإِذۡنِهِۦٓۚ","с дозволения Его",22,65],["إِنَّ","поистине",22,65]],[["ٱللَّهَ","Аллах",22,65],["بِٱلنَّاسِ","к людям",22,65],["لَرَءُوفٞ","непременно Сострадательный",22,65],["رَّحِيمٞ","Милосердный",22,65],[65],["وَهُوَ","и Он",22,66],["ٱلَّذِيٓ","Тот, Который",22,66],["أَحۡيَاكُمۡ","оживил вас",22,66]],[["ثُمَّ","затем",22,66],["يُمِيتُكُمۡ","умертвит вас",22,66],["ثُمَّ","затем",22,66],["يُحۡيِيكُمۡۗ","оживит вас",22,66],["إِنَّ","поистине",22,66],["ٱلۡإِنسَٰنَ","человек",22,66],["لَكَفُورٞ","непременно неблагодарен",22,66],[66]],[["لِّكُلِّ","для каждой",22,67],["أُمَّةٖ","общины",22,67],["جَعَلۡنَا","установили Мы",22,67],["مَنسَكًا","обряд",22,67],["هُمۡ","они",22,67],["نَاسِكُوهُۖ","совершают его",22,67],["فَلَا","и пусть не",22,67],["يُنَٰزِعُنَّكَ","препираются с тобой",22,67]],[["فِي","в",22,67],["ٱلۡأَمۡرِۚ","деле",22,67],["وَٱدۡعُ","и призывай",22,67],["إِلَىٰ","к",22,67],["رَبِّكَۖ","Господу твоему",22,67],["إِنَّكَ","поистине, ты",22,67],["لَعَلَىٰ","непременно на",22,67],["هُدٗى","руководстве",22,67],["مُّسۡتَقِيمٖ","прямом",22,67],[67]],[["وَإِن","и если",22,68],["جَٰدَلُوكَ","препирались они с тобой",22,68],["فَقُلِ","то скажи",22,68],["ٱللَّهُ","Аллах",22,68],["أَعۡلَمُ","лучше знает",22,68],["بِمَا","о том, что",22,68],["تَعۡمَلُونَ","делаете вы",22,68],[68],["ٱللَّهُ","Аллах",22,69],["يَحۡكُمُ","рассудит",22,69]],[["بَيۡنَكُمۡ","между вами",22,69],["يَوۡمَ","в День",22,69],["ٱلۡقِيَٰمَةِ","воскресения",22,69],["فِيمَا","в том, в чём",22,69],["كُنتُمۡ","были вы",22,69],["فِيهِ","в нём",22,69],["تَخۡتَلِفُونَ","расходились",22,69],[69]],[["أَلَمۡ","разве не",22,70],["تَعۡلَمۡ","знаешь ты",22,70],["أَنَّ","что",22,70],["ٱللَّهَ","Аллах",22,70],["يَعۡلَمُ","знает",22,70],["مَا","то, что",22,70],["فِي","в",22,70],["ٱلسَّمَآءِ","небе",22,70],["وَٱلۡأَرۡضِۚ","и на земле",22,70],["إِنَّ","поистине",22,70],["ذَٰلِكَ","это",22,70]],[["فِي","в",22,70],["كِتَٰبٍۚ","Писании",22,70],["إِنَّ","поистине",22,70],["ذَٰلِكَ","это",22,70],["عَلَى","для",22,70],["ٱللَّهِ","Аллаха",22,70],["يَسِيرٞ","легко",22,70],[70],["وَيَعۡبُدُونَ","и поклоняются они",22,71],["مِن","из",22,71],["دُونِ","помимо",22,71]],[["ٱللَّهِ","Аллаха",2