{"p":341,"j":17,"a":[[22,73,["يَٰٓأَيُّهَا","ٱلنَّاسُ","ضُرِبَ","مَثَلٞ","فَٱسۡتَمِعُواْ","لَهُۥٓۚ","إِنَّ","ٱلَّذِينَ","تَدۡعُونَ","مِن","دُونِ","ٱللَّهِ","لَن","يَخۡلُقُواْ","ذُبَابٗا","وَلَوِ","ٱجۡتَمَعُواْ","لَهُۥۖ","وَإِن","يَسۡلُبۡهُمُ","ٱلذُّبَابُ","شَيۡـٔٗا","لَّا","يَسۡتَنقِذُوهُ","مِنۡهُۚ","ضَعُفَ","ٱلطَّالِبُ","وَٱلۡمَطۡلُوبُ"],"йа'аййухан насу дуриба масалун фастами`уу лахуу иннал лазиина тад`ууна мин дууниллахи лан йахлуḳуу зубабан валавижтама`уу лахуу ва'ин йаслубхумуз зубабу шай'ал ла йастанḳизууху минху да`уфат талибу валматлууб","О люди! Приводится притча, послушайте же ее. Воистину, те, кому вы поклоняетесь помимо Аллаха, не сотворят и мухи, даже если они объединятся для этого. Если же муха заберет у них что-нибудь, они не смогут отобрать у нее это. Слаб тот, кто добивается, и тот, от кого он добивается!",["о","люди","приводится","притча","так послушайте","её","поистине","те, которых","вы призываете","из","помимо","Аллаха","никогда не","сотворят","муху","и даже если","объединятся","для этого","а если","отнимет у них","муха","что-либо","не","отберут они это","у неё","слаб","просящий","и испрашиваемый"]],[22,74,["مَا","قَدَرُواْ","ٱللَّهَ","حَقَّ","قَدۡرِهِۦٓۚ","إِنَّ","ٱللَّهَ","لَقَوِيٌّ","عَزِيزٌ"],"ма ḳадаруллаха хаḳḳа ḳадрихии инналлаха лаḳавиййун `азииз","Они не ценили Аллаха должным образом, а ведь Аллах - Всесильный, Могущественный.",["не","оценили они","Аллаха","должной","оценкой Его","поистине","Аллах","непременно Силён","Могуч"]],[22,75,["ٱللَّهُ","يَصۡطَفِي","مِنَ","ٱلۡمَلَٰٓئِكَةِ","رُسُلٗا","وَمِنَ","ٱلنَّاسِۚ","إِنَّ","ٱللَّهَ","سَمِيعُۢ","بَصِيرٞ"],"аллаху йастафии минал малаикати русулан ваминан наси инналлаха самии`у басиир","Аллах избирает среди ангелов и людей посланников. Воистину, Аллах - Слышащий, Видящий.",["Аллах","избирает","из","ангелов","посланников","и из","людей","поистине","Аллах","Слышащий","Видящий"]],[22,76,["يَعۡلَمُ","مَا","بَيۡنَ","أَيۡدِيهِمۡ","وَمَا","خَلۡفَهُمۡۚ","وَإِلَى","ٱللَّهِ","تُرۡجَعُ","ٱلۡأُمُورُ"],"йа`ламу ма байна айдиихим вама халфахум ва'илаллахи туржа`ул умуур","Он знает их прошлое и будущее, и к Аллаху возвращаются дела.",["Он знает","то, что","между","руками их","и то, что","позади них","и к","Аллаху","возвращаются","дела"]],[22,77,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُواْ","ٱرۡكَعُواْ","وَٱسۡجُدُواْۤ","وَٱعۡبُدُواْ","رَبَّكُمۡ","وَٱفۡعَلُواْ","ٱلۡخَيۡرَ","لَعَلَّكُمۡ","تُفۡلِحُونَ ۩"],"йа'аййухал лазиина аманурка`уу васжудуу ва`будуу раббакум ваф`алул хайра ла`аллакум туфлихуун","О те, которые уверовали! Кланяйтесь, падайте ниц, поклоняйтесь вашему Господу и творите добро, - быть может, вы преуспеете.",["о","те, которые","уверовали","кланяйтесь","и падайте ниц","и поклоняйтесь","Господу вашему","и делайте","добро","чтобы вы","преуспели"]],[22,78,["وَجَٰهِدُواْ","فِي","ٱللَّهِ","حَقَّ","جِهَادِهِۦۚ","هُوَ","ٱجۡتَبَىٰكُمۡ","وَمَا","جَعَلَ","عَلَيۡكُمۡ","فِي","ٱلدِّينِ","مِنۡ","حَرَجٖۚ","مِّلَّةَ","أَبِيكُمۡ","إِبۡرَٰهِيمَۚ","هُوَ","سَمَّىٰكُمُ","ٱلۡمُسۡلِمِينَ","مِن","قَبۡلُ","وَفِي","هَٰذَا","لِيَكُونَ","ٱلرَّسُولُ","شَهِيدًا","عَلَيۡكُمۡ","وَتَكُونُواْ","شُهَدَآءَ","عَلَى","ٱلنَّاسِۚ","فَأَقِيمُواْ","ٱلصَّلَوٰةَ","وَءَاتُواْ","ٱلزَّكَوٰةَ","وَٱعۡتَصِمُواْ","بِٱللَّهِ","هُوَ","مَوۡلَىٰكُمۡۖ","فَنِعۡمَ","ٱلۡمَوۡلَىٰ","وَنِعۡمَ","ٱلنَّصِيرُ"],"важахидуу филлахи хаḳḳа жихадихии хуажтабакум вама жа`ала `алайкум фид диини мин харажим миллата абиикум ибрахиима хуа саммакумул муслимиина мин ḳаблу вафии хаза лийакуунар расуулу шахиидан `алайкум ватакуунуу шухадаа `алан наси фа'аḳиимус салавата ва'атуз закавата ва`тасимуу биллахи хуа маулакум фани`мал маула вани`ман насиир","Усердствуйте на пути Аллаха надлежащим образом. Он избрал вас и не сделал для вас никакого затруднения в религии. Такова вера отца вашего Ибрахима (Авраама). Аллах нарек вас мусульманами до этого и здесь (в Коране), чтобы Посланник был свидетелем о вас, а вы были свидетелями о людях. Совершайте намаз, выплачивайте закят и крепко держитесь за Аллаха. Он - ваш Покровитель. Как же прекрасен этот Покровитель! Как же прекрасен этот Помощник!",["и усердствуйте","ради","Аллаха","должным","усердием Ему","Он","избрал вас","и не","сделал","для вас","в","религии","никакого","затруднения","вера","отца вашего","Ибрахима","Он","назвал вас","мусульманами","из","прежде","и в","этом","чтобы был","Посланник","свидетелем","о вас","и были вы","свидетелями","о","людях","так совершайте","молитву","и давайте","закят","и держитесь крепко","за Аллаха","Он","Покровитель ваш","и прекрасен","Покровитель","и прекрасен","Помощник"]]],"m":[[["يَٰٓأَيُّهَا","о",22,73],["ٱلنَّاسُ","люди",22,73],["ضُرِبَ","приводится",22,73],["مَثَلٞ","притча",22,73],["فَٱسۡتَمِعُواْ","так послушайте",22,73],["لَهُۥٓۚ","её",22,73],["إِنَّ","поистине",22,73],["ٱلَّذِينَ","те, которых",22,73]],[["تَدۡعُونَ","вы призываете",22,73],["مِن","из",22,73],["دُونِ","помимо",22,73],["ٱللَّهِ","Аллаха",22,73],["لَن","никогда не",22,73],["يَخۡلُقُواْ","сотворят",22,73],["ذُبَابٗا","муху",22,73],["وَلَوِ","и даже если",22,73],["ٱجۡتَمَعُواْ","объединятся",22,73],["لَهُۥۖ","для этого",22,73]],[["وَإِن","а если",22,73],["يَسۡلُبۡهُمُ","отнимет у них",22,73],["ٱلذُّبَابُ","муха",22,73],["شَيۡـٔٗا","что-либо",22,73],["لَّا","не",22,73],["يَسۡتَنقِذُوهُ","отберут они это",22,73],["مِنۡهُۚ","у неё",22,73],["ضَعُفَ","слаб",22,73]],[["ٱلطَّالِبُ","просящий",22,73],["وَٱلۡمَطۡلُوبُ","и испрашиваемый",22,73],[73],["مَا","не",22,74],["قَدَرُواْ","оценили они",22,74],["ٱللَّهَ","Аллаха",22,74],["حَقَّ","должной",22,74],["قَدۡرِهِۦٓۚ","оценкой Его",22,74],["إِنَّ","поистине",22,74]],[["ٱللَّهَ","Аллах",22,74],["لَقَوِيٌّ","непременно Силён",22,74],["عَزِيزٌ","Могуч",22,74],[74],["ٱللَّهُ","Аллах",22,75],["يَصۡطَفِي","избирает",22,75],["مِنَ","из",22,75],["ٱلۡمَلَٰٓئِكَةِ","ангелов",22,75]],[["رُسُلٗا","посланников",22,75],["وَمِنَ","и из",22,75],["ٱلنَّاسِۚ","людей",22,75],["إِنَّ","поистине",22,75],["ٱللَّهَ","Аллах",22,75],["سَمِيعُۢ","Слышащий",22,75],["بَصِيرٞ","Видящий",22,75],[75],["يَعۡلَمُ","Он знает",22,76]],[["مَا","то, чт