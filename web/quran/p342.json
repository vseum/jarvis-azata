{"p":342,"j":18,"a":[[23,1,["قَدۡ","أَفۡلَحَ","ٱلۡمُؤۡمِنُونَ"],"ḳад афлахал му'минуун","Воистину, преуспели верующие,",["уже","преуспели","верующие"]],[23,2,["ٱلَّذِينَ","هُمۡ","فِي","صَلَاتِهِمۡ","خَٰشِعُونَ"],"аллазиина хум фии салатихим хаши`уун","которые смиренны во время своих намазов,",["те, которые","они","в","молитве своей","смиренны"]],[23,3,["وَٱلَّذِينَ","هُمۡ","عَنِ","ٱللَّغۡوِ","مُعۡرِضُونَ"],"валлазиина хум `анил лагви му`ридуун","которые отворачиваются от всего праздного,",["и те, которые","они","от","праздного","отворачиваются"]],[23,4,["وَٱلَّذِينَ","هُمۡ","لِلزَّكَوٰةِ","فَٰعِلُونَ"],"валлазиина хум лиззакавати фа`илуун","которые выплачивают закят,",["и те, которые","они","закят","выплачивают"]],[23,5,["وَٱلَّذِينَ","هُمۡ","لِفُرُوجِهِمۡ","حَٰفِظُونَ"],"валлазиина хум лифуруужихим хафизуун","которые оберегают свои половые органы от всех,",["и те, которые","они","срамные места свои","оберегают"]],[23,6,["إِلَّا","عَلَىٰٓ","أَزۡوَٰجِهِمۡ","أَوۡ","مَا","مَلَكَتۡ","أَيۡمَٰنُهُمۡ","فَإِنَّهُمۡ","غَيۡرُ","مَلُومِينَ"],"илла `ала азважихим ау ма малакат айманухум фа'иннахум гайру малуумиин","кроме своих жен или невольниц, которыми овладели их десницы, за что они не заслуживают порицания,",["кроме как","от","жён своих","или","тех, кем","овладели","десницы их","то поистине, они","не","порицаемы"]],[23,7,["فَمَنِ","ٱبۡتَغَىٰ","وَرَآءَ","ذَٰلِكَ","فَأُوْلَٰٓئِكَ","هُمُ","ٱلۡعَادُونَ"],"фаманибтага вараа залика фа'улаика хумул `адуун","тогда как желающие сверх этого являются преступниками;",["а кто","пожелает","сверх","этого","то те","они","преступники"]],[23,8,["وَٱلَّذِينَ","هُمۡ","لِأَمَٰنَٰتِهِمۡ","وَعَهۡدِهِمۡ","رَٰعُونَ"],"валлазиина хум ли'аманатихим ва`ахдихим ра`уун","которые оберегают вверенное им на хранение и соблюдают договоры,",["и те, которые","они","вверенное им","и договор свой","соблюдают"]],[23,9,["وَٱلَّذِينَ","هُمۡ","عَلَىٰ","صَلَوَٰتِهِمۡ","يُحَافِظُونَ"],"валлазиина хум `ала салаватихим йухафизуун","которые регулярно совершают намаз.",["и те, которые","они","за","молитвами своими","следят"]],[23,10,["أُوْلَٰٓئِكَ","هُمُ","ٱلۡوَٰرِثُونَ"],"улаика хумул варисуун","Именно они являются наследниками,",["те","они","наследники"]],[23,11,["ٱلَّذِينَ","يَرِثُونَ","ٱلۡفِرۡدَوۡسَ","هُمۡ","فِيهَا","خَٰلِدُونَ"],"аллазиина йарисуунал фирдауса хум фииха халидуун","которые унаследуют Фирдаус, в котором они пребудут вечно.",["которые","унаследуют","Фирдаус","они","в нём","вечно пребывают"]],[23,12,["وَلَقَدۡ","خَلَقۡنَا","ٱلۡإِنسَٰنَ","مِن","سُلَٰلَةٖ","مِّن","طِينٖ"],"валаḳад халаḳнал инсана мин сулалатим мин тиин","Воистину, Мы сотворили человека из эссенции глины.",["и уже","Мы сотворили","человека","из","эссенции","из","глины"]],[23,13,["ثُمَّ","جَعَلۡنَٰهُ","نُطۡفَةٗ","فِي","قَرَارٖ","مَّكِينٖ"],"сумма жа`алнаху нутфатан фии ḳарарим макиин","Потом Мы поместили его каплей в надежном месте.",["затем","поместили Мы его","каплей","в","месте пребывания","надежном"]],[23,14,["ثُمَّ","خَلَقۡنَا","ٱلنُّطۡفَةَ","عَلَقَةٗ","فَخَلَقۡنَا","ٱلۡعَلَقَةَ","مُضۡغَةٗ","فَخَلَقۡنَا","ٱلۡمُضۡغَةَ","عِظَٰمٗا","فَكَسَوۡنَا","ٱلۡعِظَٰمَ","لَحۡمٗا","ثُمَّ","أَنشَأۡنَٰهُ","خَلۡقًا","ءَاخَرَۚ","فَتَبَارَكَ","ٱللَّهُ","أَحۡسَنُ","ٱلۡخَٰلِقِينَ"],"сумма халаḳнан нутфата `алаḳатан фахалаḳнал `алаḳата мудгатан фахалаḳнал мудгата `изаман факасаунал `изама лахман сумма анша'наху халḳан ахара фатабаракаллаху ахсанул халиḳиин","Потом Мы создали из капли сгусток крови, потом создали из сгустка крови разжеванный кусочек, потом создали из этого кусочка кости, и потом облекли кости мясом. Потом Мы вырастили его в другом творении. Благословен же Аллах, Наилучший из творцов!",["затем","Мы сотворили","каплю","сгустком","и Мы сотворили","сгусток","кусочком плоти","и Мы сотворили","кусочек плоти","костями","и Мы облекли","кости","мясом","затем","Мы вырастили его","творением","иным","и благословен","Аллах","Наилучший","из творцов"]],[23,15,["ثُمَّ","إِنَّكُم","بَعۡدَ","ذَٰلِكَ","لَمَيِّتُونَ"],"сумма иннакум ба`да залика ламаййитуун","После этого вы непременно умрете.",["затем","поистине, вы","после","этого","непременно умрёте"]],[23,16,["ثُمَّ","إِنَّكُمۡ","يَوۡمَ","ٱلۡقِيَٰمَةِ","تُبۡعَثُونَ"],"сумма иннакум йаумал ḳийамати туб`асуун","А потом, в День воскресения, вы непременно будете воскрешены.",["затем","поистине, вы","в День","воскресения","будете воскрешены"]],[23,17,["وَلَقَدۡ","خَلَقۡنَا","فَوۡقَكُمۡ","سَبۡعَ","طَرَآئِقَ","وَمَا","كُنَّا","عَنِ","ٱلۡخَلۡقِ","غَٰفِلِينَ"],"валаḳад халаḳна фауḳакум саб`а тараиḳа вама кунна `анил халḳи гафилиин","Воистину, Мы создали над вами семь небес одно над другим. Мы никогда не находились в неведении о творениях.",["и уже","Мы сотворили","над вами","семь","путей (небес)","и не","были Мы","к","творению","невнимательны"]]]}