{"p":343,"j":18,"a":[[23,18,["وَأَنزَلۡنَا","مِنَ","ٱلسَّمَآءِ","مَآءَۢ","بِقَدَرٖ","فَأَسۡكَنَّٰهُ","فِي","ٱلۡأَرۡضِۖ","وَإِنَّا","عَلَىٰ","ذَهَابِۭ","بِهِۦ","لَقَٰدِرُونَ"],"ва'анзална минас самаи маа биḳадарин фа'асканнаху фил арди ва'инна `ала захаби бихии лаḳадируун","Мы низвели с неба воду в меру и разместили ее на земле. Воистину, Мы способны увести ее.",["и Мы низвели","с","неба","воду","в меру","и поселили её","в","земле","и поистине, Мы","на","увод","её","непременно способны"]],[23,19,["فَأَنشَأۡنَا","لَكُم","بِهِۦ","جَنَّٰتٖ","مِّن","نَّخِيلٖ","وَأَعۡنَٰبٖ","لَّكُمۡ","فِيهَا","فَوَٰكِهُ","كَثِيرَةٞ","وَمِنۡهَا","تَأۡكُلُونَ"],"фа'анша'на лакум бихии жаннатим мин нахиилин ва'а`набил лакум фииха фавакиху касииратун ваминха та'кулуун","Посредством нее Мы вырастили для вас пальмовые сады и виноградники, где растет для вас много плодов, которые вы едите.",["и Мы вырастили","для вас","ею","сады","из","пальм","и виноградников","для вас","в них","плоды","многие","и из них","вы едите"]],[23,20,["وَشَجَرَةٗ","تَخۡرُجُ","مِن","طُورِ","سَيۡنَآءَ","تَنۢبُتُ","بِٱلدُّهۡنِ","وَصِبۡغٖ","لِّلۡأٓكِلِينَ"],"вашажаратан тахружу мин туури сайнаа тамбуту биддухни васибгил лил'акилиин","Мы вырастили дерево, которое растет на горе Синай и дает масло и приправу для вкушающих.",["и дерево","выходящее","из","горы","Синай","растёт","с маслом","и приправой","для едящих"]],[23,21,["وَإِنَّ","لَكُمۡ","فِي","ٱلۡأَنۡعَٰمِ","لَعِبۡرَةٗۖ","نُّسۡقِيكُم","مِّمَّا","فِي","بُطُونِهَا","وَلَكُمۡ","فِيهَا","مَنَٰفِعُ","كَثِيرَةٞ","وَمِنۡهَا","تَأۡكُلُونَ"],"ва'инна лакум фил ан`ами ла`ибратан нусḳиикум мимма фии бутууниха валакум фииха манафи`у касииратун ваминха та'кулуун","Воистину, домашняя скотина служит назиданием для вас. Мы поим вас тем, что находится у них в животах. Они приносят вам многочисленную пользу, и вы питаетесь ими.",["и поистине","для вас","в","скоте","непременно назидание","Мы поим вас","из того, что","в","чревах их","и для вас","в них","польза","многая","и из них","вы едите"]],[23,22,["وَعَلَيۡهَا","وَعَلَى","ٱلۡفُلۡكِ","تُحۡمَلُونَ"],"ва`алайха ва`алал фулки тухмалуун","На них и на кораблях вы передвигаетесь.",["и на них","и на","кораблях","вы перевозитесь"]],[23,23,["وَلَقَدۡ","أَرۡسَلۡنَا","نُوحًا","إِلَىٰ","قَوۡمِهِۦ","فَقَالَ","يَٰقَوۡمِ","ٱعۡبُدُواْ","ٱللَّهَ","مَا","لَكُم","مِّنۡ","إِلَٰهٍ","غَيۡرُهُۥٓۚ","أَفَلَا","تَتَّقُونَ"],"валаḳад арсална нуухан ила ḳаумихии фаḳала йаḳауми`будуллаха ма лакум мин илахин гайрухуу афала таттаḳуун","Воистину, Мы направили Нуха (Ноя) к его народу, и он сказал: «О мой народ! Поклоняйтесь Аллаху, ибо нет у вас другого божества, кроме Него. Неужели вы не устрашитесь?».",["и уже","Мы послали","Нуха","к","народу его","и он сказал","о народ мой","поклоняйтесь","Аллаху","не","для вас","никакого","божества","кроме Него","неужели не","побоитесь"]],[23,24,["فَقَالَ","ٱلۡمَلَؤُاْ","ٱلَّذِينَ","كَفَرُواْ","مِن","قَوۡمِهِۦ","مَا","هَٰذَآ","إِلَّا","بَشَرٞ","مِّثۡلُكُمۡ","يُرِيدُ","أَن","يَتَفَضَّلَ","عَلَيۡكُمۡ","وَلَوۡ","شَآءَ","ٱللَّهُ","لَأَنزَلَ","مَلَٰٓئِكَةٗ","مَّا","سَمِعۡنَا","بِهَٰذَا","فِيٓ","ءَابَآئِنَا","ٱلۡأَوَّلِينَ"],"фаḳалал малаул лазиина кафаруу мин ḳаумихии ма хаза илла башарум мислукум йурииду ан йатафаддала `алайкум валау шааллаху ла'анзала малаикатам ма сами`на бихаза фии абаинал аввалиин","Но знатные люди из его народа, которые не уверовали, сказали: «Он - такой же человек, как и вы. Он лишь хочет возвыситься над вами. Если бы Аллах пожелал, то Он ниспослал бы ангелов. Мы не слышали о подобном от наших праотцев.",["и сказала","знать","те, которые","не уверовали","из","народа его","не","этот","кроме как","человек","подобный вам","он хочет","чтобы","превознестись","над вами","и если бы","пожелал","Аллах","непременно ниспослал бы","ангелов","не","слышали мы","об этом","у","отцов наших","первых"]],[23,25,["إِنۡ","هُوَ","إِلَّا","رَجُلُۢ","بِهِۦ","جِنَّةٞ","فَتَرَبَّصُواْ","بِهِۦ","حَتَّىٰ","حِينٖ"],"ин хуа илла ражулу бихии жиннатун фатараббасуу бихии хатта хиин","Он - не кто иной, как бесноватый муж, так что обождите с ним до поры до времени».",["не","он","кроме как","мужчина","в нём","безумие","так выжидайте","с ним","до","времени"]],[23,26,["قَالَ","رَبِّ","ٱنصُرۡنِي","بِمَا","كَذَّبُونِ"],"ḳала раббинсурнии бима каззабуун","Он сказал: «Господи! Помоги мне, ведь они сочли меня лжецом».",["он сказал","Господи мой","помоги мне","за то, что","сочли меня лжецом"]],[23,27,["فَأَوۡحَيۡنَآ","إِلَيۡهِ","أَنِ","ٱصۡنَعِ","ٱلۡفُلۡكَ","بِأَعۡيُنِنَا","وَوَحۡيِنَا","فَإِذَا","جَآءَ","أَمۡرُنَا","وَفَارَ","ٱلتَّنُّورُ","فَٱسۡلُكۡ","فِيهَا","مِن","كُلّٖ","زَوۡجَيۡنِ","ٱثۡنَيۡنِ","وَأَهۡلَكَ","إِلَّا","مَن","سَبَقَ","عَلَيۡهِ","ٱلۡقَوۡلُ","مِنۡهُمۡۖ","وَلَا","تُخَٰطِبۡنِي","فِي","ٱلَّذِينَ","ظَلَمُوٓاْ","إِنَّهُم","مُّغۡرَقُونَ"],"фа'аухайна илайхи анисна`ил фулка би'а`йунина вавахйина фа'иза жаа амруна вафарат таннууру фаслук фииха мин куллин заужайниснайни ва'ахлака илла ман сабаḳа `алайхил ḳаулу минхум вала тухатибнии фил лазиина заламуу иннахум муграḳуун","Мы внушили ему откровение: «Сооруди ковчег у Нас на Глазах согласно Нашему откровению. А когда явится Наше веление, и вода забьет фонтаном из печи, то погрузи на него по паре всего живого, а также свою семью, кроме тех, о чьей гибели уже было ниспослано Мое веление. И не проси Меня за тех, которые поступали несправедливо. Они будут потоплены.",["и Мы внушили","ему","чтобы","сооруди","ковчег","на Наших глазах","и по откровению Нашему","а когда","придёт","повеление Наше","и забьёт","печь","то помести","в него","из","всякого","пар","две","и семью твою","кроме","тех, кого","опередило","о нём","слово","из них","и не","обращайся ко Мне","о","тех, которые","поступили несправедливо","поистине, они","будут потоплены"]]],"m":[[["وَأَنزَلۡنَا","и Мы низвели",23,18],["مِنَ","с",23,18],["ٱلسَّمَآءِ","неба",23,18],["مَآءَۢ","воду",23,18],["بِقَدَرٖ","в меру",23,18],["فَأَسۡكَنَّٰهُ","и поселили её",23,18],["فِي","в",23,18],["ٱلۡأَرۡضِۖ","земле",23,18],["وَإِنَّا","и поистине, Мы",23,18],["عَلَىٰ","на",23,18],["ذَهَابِۭ","увод",23,18]],[["بِهِۦ","её",23,18],["لَقَٰدِرُونَ","непременно способны",23,18],[18],["فَأَنشَأۡنَا","и Мы вырастили",23,19],["لَكُم","для вас",23,19],["بِهِۦ","ею",23,19],["جَنَّٰتٖ","сады",23,19],["مِّن","из",23,19],["نَّخِيلٖ","пальм",23,19],["وَأَعۡنَٰبٖ","и виноградников",23,19]],[["لَّكُمۡ","для вас",23,19],["فِيهَا","в них",23,19],["فَوَٰكِهُ","плоды",23,19],["كَثِيرَةٞ","многие",23,19],["وَمِنۡهَا","и из них",23,19],["تَأۡكُلُونَ","вы едите",23,19],[19],["وَشَجَرَةٗ","и дерево",23,20],["تَخۡرُجُ","выходящее",23,20],["مِن","из",23,20]],[["طُورِ","горы",23,20],["سَيۡنَآءَ","Синай",23,20],["تَنۢبُتُ","растёт",23,20],["بِٱلدُّهۡنِ","с маслом",23,20],["وَصِبۡغٖ","и приправой",23,20],["لِّلۡأٓكِلِينَ","для едящих",23,20],[20],["وَإِنَّ","и поистине",23,21],["لَكُمۡ","для вас",23,21],["فِي","в",23,21]],[["ٱلۡأَنۡعَٰمِ","скоте",23,21],["لَعِبۡرَةٗۖ","непременно назидание",23,21],["نُّسۡقِيكُم","Мы поим вас",23,21],["مِّمَّا","из того, что",23,21],["فِي","в",23,21],["بُطُونِهَا","чревах их",23,21],["وَلَكُمۡ","и для вас",23,21],["فِيهَا","в них",23,21],["مَنَٰفِعُ","польза",23,21],["كَثِيرَةٞ","многая",23,21]],[["وَمِنۡهَا","и из них",23,21],["تَأۡكُلُونَ","вы едите",23,21],[21],["وَعَلَيۡهَا","и на них",23,22],["وَعَلَى","и на",23,22],["ٱلۡفُلۡكِ","кораблях",23,22],["تُحۡمَلُونَ","вы перевозитесь",23,22],[22],["وَلَقَدۡ","и уже",23,23]],[["أَرۡسَلۡنَا","Мы послали",23,23],["نُوحًا","Нуха",23,23],["إِلَىٰ","к",23,23],["قَوۡمِهِۦ","народу его",23,23],["فَقَالَ","и он сказал",23,23],["يَٰقَوۡمِ","о народ мой",23,23],["ٱعۡبُدُواْ","поклоняйтесь",23,23],["ٱللَّهَ","Аллаху",23,23],["مَا","не",23,23],["لَكُم","для вас",23,23],["مِّنۡ","никакого",23,23],["إِلَٰهٍ","божества",23,23]],[["غَيۡرُهُۥٓۚ","кроме Него",23,23],["أَفَلَا","неужели не",23,23],["تَتَّقُونَ","побоитесь",23,23],[23],["فَقَالَ","и сказала",23,24],["ٱلۡمَلَؤُاْ","знать",23,24],["ٱلَّذِينَ","те, которые",23,24],["كَفَرُواْ","не уверовали",23,24],["مِن","из",23,24],["قَوۡمِهِۦ","народа его",23,