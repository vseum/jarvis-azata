{"p":344,"j":18,"a":[[23,28,["فَإِذَا","ٱسۡتَوَيۡتَ","أَنتَ","وَمَن","مَّعَكَ","عَلَى","ٱلۡفُلۡكِ","فَقُلِ","ٱلۡحَمۡدُ","لِلَّهِ","ٱلَّذِي","نَجَّىٰنَا","مِنَ","ٱلۡقَوۡمِ","ٱلظَّٰلِمِينَ"],"фа'изаставайта анта вамам ма`ака `алал фулки фаḳулил хамду лиллахил лазии нажжана минал ḳаумиз залимиин","А когда ты и те, кто с тобой, сядете в ковчег, скажи: «Хвала Аллаху, Который спас нас от несправедливых людей!»",["а когда","взойдёшь","ты","и тот, кто","с тобой","на","ковчег","то скажи","хвала","Аллаху","Который","спас нас","от","людей","несправедливых"]],[23,29,["وَقُل","رَّبِّ","أَنزِلۡنِي","مُنزَلٗا","مُّبَارَكٗا","وَأَنتَ","خَيۡرُ","ٱلۡمُنزِلِينَ"],"ваḳул ррабби анзилнии мунзалам мубаракан ва'анта хайрул мунзилиин","Скажи также: «Господи! Приведи меня к благословенному месту, ведь Ты - Наилучший из расселяющих»».",["и скажи","Господи мой","высади меня","высадкой","благословенной","и Ты","Лучший","из высаживающих"]],[23,30,["إِنَّ","فِي","ذَٰلِكَ","لَأٓيَٰتٖ","وَإِن","كُنَّا","لَمُبۡتَلِينَ"],"инна фии залика ла'айатин ва'ин кунна ламубталиин","Воистину, в этом есть знамения. Воистину, Мы подвергаем испытанию.",["поистине","в","этом","непременно знамения","и поистине","были Мы","непременно испытывающими"]],[23,31,["ثُمَّ","أَنشَأۡنَا","مِنۢ","بَعۡدِهِمۡ","قَرۡنًا","ءَاخَرِينَ"],"сумма анша'на мим ба`дихим ḳарнан ахариин","Вслед за ними Мы сотворили другое поколение.",["затем","сотворили Мы","от","после них","поколение","другое"]],[23,32,["فَأَرۡسَلۡنَا","فِيهِمۡ","رَسُولٗا","مِّنۡهُمۡ","أَنِ","ٱعۡبُدُواْ","ٱللَّهَ","مَا","لَكُم","مِّنۡ","إِلَٰهٍ","غَيۡرُهُۥٓۚ","أَفَلَا","تَتَّقُونَ"],"фа'арсална фиихим расуулам минхум ани`будуллаха ма лакум мин илахин гайрухуу афала таттаḳуун","Мы направили к ним посланника из них самих: «Поклоняйтесь Аллаху, ибо нет у вас другого божества, кроме Него. Неужели вы не устрашитесь?».",["и Мы послали","к ним","посланника","из них самих","чтобы","поклоняйтесь","Аллаху","не","для вас","никакого","божества","кроме Него","неужели не","побоитесь"]],[23,33,["وَقَالَ","ٱلۡمَلَأُ","مِن","قَوۡمِهِ","ٱلَّذِينَ","كَفَرُواْ","وَكَذَّبُواْ","بِلِقَآءِ","ٱلۡأٓخِرَةِ","وَأَتۡرَفۡنَٰهُمۡ","فِي","ٱلۡحَيَوٰةِ","ٱلدُّنۡيَا","مَا","هَٰذَآ","إِلَّا","بَشَرٞ","مِّثۡلُكُمۡ","يَأۡكُلُ","مِمَّا","تَأۡكُلُونَ","مِنۡهُ","وَيَشۡرَبُ","مِمَّا","تَشۡرَبُونَ"],"ваḳалал малау мин ḳаумихил лазиина кафаруу ваказзабуу билиḳаил ахирати ва'атрафнахум фил хайаватид дунйа ма хаза илла башарум мислукум йа'кулу мимма та'кулууна минху вайашрабу мимма ташрабуун","Знатные люди из его народа, которые не уверовали и отрицали встречу в Последней жизни, которых Мы одарили щедрыми благами в мирской жизни, сказали: «Это - всего лишь человек, подобный вам. Он ест то, что вы едите, и пьет то, что вы пьете.",["и сказала","знать","из","народа его","те, которые","не уверовали","и сочли ложью","встречу","последней жизни","и Мы дали им роскошь","в","жизни","ближней","не","этот","кроме как","человек","подобный вам","он ест","из того, что","вы едите","из него","и пьёт","из того, что","вы пьёте"]],[23,34,["وَلَئِنۡ","أَطَعۡتُم","بَشَرٗا","مِّثۡلَكُمۡ","إِنَّكُمۡ","إِذٗا","لَّخَٰسِرُونَ"],"валаин ата`тум башарам мислакум иннакум изал лахасируун","Если вы станете повиноваться человеку, который подобен вам, то непременно окажетесь в убытке.",["и если","вы повинуетесь","человеку","подобному вам","поистине, вы","тогда","непременно потерпевшие убыток"]],[23,35,["أَيَعِدُكُمۡ","أَنَّكُمۡ","إِذَا","مِتُّمۡ","وَكُنتُمۡ","تُرَابٗا","وَعِظَٰمًا","أَنَّكُم","مُّخۡرَجُونَ"],"айа`идукум аннакум иза миттум вакунтум турабан ва`изаман аннакум мухражуун","Неужели он обещает вам, что вы будете воскрешены после того, как умрете и превратитесь в прах и кости?",["разве обещает он вам","что вы","когда","умрёте","и станете","прахом","и костями","что вы","будете выведены"]],[23,36,["هَيۡهَاتَ","هَيۡهَاتَ","لِمَا","تُوعَدُونَ"],"хайхата хайхата лима туу`адуун","Невероятно, невероятно то, что обещано вам!",["далеко","далеко","то, что","вам обещано"]],[23,37,["إِنۡ","هِيَ","إِلَّا","حَيَاتُنَا","ٱلدُّنۡيَا","نَمُوتُ","وَنَحۡيَا","وَمَا","نَحۡنُ","بِمَبۡعُوثِينَ"],"ин хийа илла хайатунад дунйа намууту ванахйа вама нахну бимаб`уусиин","Нет ничего, кроме нашей жизни в этом мире. Мы умираем и живем, и мы не будем воскрешены.",["не","она","кроме как","жизнь наша","ближняя","мы умираем","и живём","и не","мы","воскрешаемы"]],[23,38,["إِنۡ","هُوَ","إِلَّا","رَجُلٌ","ٱفۡتَرَىٰ","عَلَى","ٱللَّهِ","كَذِبٗا","وَمَا","نَحۡنُ","لَهُۥ","بِمُؤۡمِنِينَ"],"ин хуа илла ражулунифтара `алаллахи казибан вама нахну лахуу биму'миниин","Он - всего лишь человек, который возвел навет на Аллаха, и мы не веруем в него».",["не","он","кроме как","мужчина","измыслил","на","Аллаха","ложь","и не","мы","в него","верующие"]],[23,39,["قَالَ","رَبِّ","ٱنصُرۡنِي","بِمَا","كَذَّبُونِ"],"ḳала раббинсурнии бима каззабуун","Он сказал: «Господи! Помоги мне, ведь они сочли меня лжецом!».",["он сказал","Господи мой","помоги мне","за то, что","сочли меня лжецом"]],[23,40,["قَالَ","عَمَّا","قَلِيلٖ","لَّيُصۡبِحُنَّ","نَٰدِمِينَ"],"ḳала `амма ḳалиилил лайусбихунна надимиин","Аллах сказал: «Очень скоро они будут раскаиваться».",["Он сказал","через","немного","непременно станут они","раскаивающимися"]],[23,41,["فَأَخَذَتۡهُمُ","ٱلصَّيۡحَةُ","بِٱلۡحَقِّ","فَجَعَلۡنَٰهُمۡ","غُثَآءٗۚ","فَبُعۡدٗا","لِّلۡقَوۡمِ","ٱلظَّٰلِمِينَ"],"фа'ахазатхумус сайхату билхаḳḳи фажа`алнахум гусаан фабу`дал лилḳаумиз залимиин","Вопль поразил их по справедливости, и Мы обратили их в подобие сора, растворенного в потоке. Да сгинут люди несправедливые!",["и постиг их","вопль","по праву","и Мы сделали их","сором","и прочь","людей","несправедливых"]],[23,42,["ثُمَّ","أَنشَأۡنَا","مِنۢ","بَعۡدِهِمۡ","قُرُونًا","ءَاخَرِينَ"],"сумма анша'на мим ба`дихим ḳуруунан ахариин","Вслед за ними Мы сотворили другие поколения.",["затем","сотворили Мы","от","после них","поколения","другие"]]],"m":[[["فَإِذَا","а когда",23,28],["ٱسۡتَوَيۡتَ","взойдёшь",23,28],["أَنتَ","ты",23,28],["وَمَن","и тот, кто",23,28],["مَّعَكَ","с тобой",23,28],["ع