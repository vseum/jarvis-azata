{"p":345,"j":18,"a":[[23,43,["مَا","تَسۡبِقُ","مِنۡ","أُمَّةٍ","أَجَلَهَا","وَمَا","يَسۡتَـٔۡخِرُونَ"],"ма тасбиḳу мин умматин ажалаха вама йаста'хируун","Ни одна община не может опередить свой срок или отложить его.",["не","опередит","ни одна","община","срок свой","и не","отсрочат они"]],[23,44,["ثُمَّ","أَرۡسَلۡنَا","رُسُلَنَا","تَتۡرَاۖ","كُلَّ","مَا","جَآءَ","أُمَّةٗ","رَّسُولُهَا","كَذَّبُوهُۖ","فَأَتۡبَعۡنَا","بَعۡضَهُم","بَعۡضٗا","وَجَعَلۡنَٰهُمۡ","أَحَادِيثَۚ","فَبُعۡدٗا","لِّقَوۡمٖ","لَّا","يُؤۡمِنُونَ"],"сумма арсална русулана татра кулла ма жаа умматар расуулуха каззабууху фа'атба`на ба`дахум ба`дан важа`алнахум ахадииса фабу`дал лиḳаумил ла йу'минуун","Потом Мы отправляли одного за другим Наших посланников. Каждый раз, когда к какому-либо народу приходил посланник, они нарекали его лжецом. Мы отправляли их одних за другими на погибель и сделали их предметом сказаний. Да сгинут люди неверующие!",["затем","Мы послали","посланников Наших","одного за другим","всякий","раз, когда","приходил","к общине","посланник её","они сочли его лжецом","и Мы отправили вслед","одних из них","за другими","и Мы сделали их","сказаниями","и прочь","людей","не","верующих"]],[23,45,["ثُمَّ","أَرۡسَلۡنَا","مُوسَىٰ","وَأَخَاهُ","هَٰرُونَ","بِـَٔايَٰتِنَا","وَسُلۡطَٰنٖ","مُّبِينٍ"],"сумма арсална мууса ва'ахаху харууна би'айатина васултаним мубиин","Потом Мы отправили Мусу (Моисея) и его брата Харуна (Аарона) с Нашими знамениями и ясным доказательством",["затем","Мы послали","Мусу","и брата его","Харуна","с Нашими знамениями","и доводом","ясным"]],[23,46,["إِلَىٰ","فِرۡعَوۡنَ","وَمَلَإِيْهِۦ","فَٱسۡتَكۡبَرُواْ","وَكَانُواْ","قَوۡمًا","عَالِينَ"],"ила фир`ауна вамалаихии фастакбаруу вакануу ḳауман `алиин","к Фараону и его знати, но они возгордились, ведь они были людьми надменными.",["к","Фараону","и знати его","но они возгордились","и были они","людьми","надменными"]],[23,47,["فَقَالُوٓاْ","أَنُؤۡمِنُ","لِبَشَرَيۡنِ","مِثۡلِنَا","وَقَوۡمُهُمَا","لَنَا","عَٰبِدُونَ"],"фаḳалуу ану'мину либашарайни мислина ваḳаумухума лана `абидуун","Они сказали: «Неужели мы уверуем в двух людей, которые подобны нам, тогда как их народ служит нам?».",["и сказали они","неужели уверуем мы","двум людям","подобным нам","а народ их","нам","служит"]],[23,48,["فَكَذَّبُوهُمَا","فَكَانُواْ","مِنَ","ٱلۡمُهۡلَكِينَ"],"факаззабуухума факануу минал мухлакиин","Они сочли их обоих лжецами и обрекли себя на погибель.",["и сочли они их обоих лжецами","и стали они","из","погубленных"]],[23,49,["وَلَقَدۡ","ءَاتَيۡنَا","مُوسَى","ٱلۡكِتَٰبَ","لَعَلَّهُمۡ","يَهۡتَدُونَ"],"валаḳад атайна муусал китаба ла`аллахум йахтадуун","Воистину, Мы даровали Мусе (Моисею) Писание, чтобы они могли последовать прямым путем.",["и уже","даровали Мы","Мусе","Писание","чтобы они","следовали прямым путем"]],[23,50,["وَجَعَلۡنَا","ٱبۡنَ","مَرۡيَمَ","وَأُمَّهُۥٓ","ءَايَةٗ","وَءَاوَيۡنَٰهُمَآ","إِلَىٰ","رَبۡوَةٖ","ذَاتِ","قَرَارٖ","وَمَعِينٖ"],"важа`алнабна марйама ва'уммахуу айатан ва'авайнахума ила рабватин зати ḳарарин вама`иин","Мы сделали сына Марьям (Марии) и его мать знамением и поселили их в укромном месте на холме, где протекал ручей.",["и Мы сделали","сына","Марьям","и мать его","знамением","и Мы приютили их","на","возвышенности","обладающей","покоем","и родником"]],[23,51,["يَٰٓأَيُّهَا","ٱلرُّسُلُ","كُلُواْ","مِنَ","ٱلطَّيِّبَٰتِ","وَٱعۡمَلُواْ","صَٰلِحًاۖ","إِنِّي","بِمَا","تَعۡمَلُونَ","عَلِيمٞ"],"йа'аййухар русулу кулуу минат таййибати ва`малуу салихан иннии бима та`малууна `алиим","О посланники! Вкушайте блага и поступайте праведно. Воистину, Мне известно о том, что вы совершаете.",["о","посланники","ешьте","из","благого","и делайте","праведное","поистине, Я","о том, что","вы делаете","Знающий"]],[23,52,["وَإِنَّ","هَٰذِهِۦٓ","أُمَّتُكُمۡ","أُمَّةٗ","وَٰحِدَةٗ","وَأَنَا۠","رَبُّكُمۡ","فَٱتَّقُونِ"],"ва'инна хазихии умматукум умматан вахидатан ва'ана раббукум фаттаḳуун","Воистину, ваша религия - религия единая, а Я - ваш Господь. Бойтесь же Меня!",["и поистине","эта","религия ваша","религия","единая","и Я","Господь ваш","так бойтесь Меня"]],[23,53,["فَتَقَطَّعُوٓاْ","أَمۡرَهُم","بَيۡنَهُمۡ","زُبُرٗاۖ","كُلُّ","حِزۡبِۭ","بِمَا","لَدَيۡهِمۡ","فَرِحُونَ"],"фатаḳатта`уу амрахум байнахум зубуран куллу хизби бима ладайхим фарихуун","Но они разорвали свою религию на части, и каждая секта радуется тому, что имеет.",["но разорвали они","дело своё","между собой","на части","каждая","партия","тому, что","у них","радуется"]],[23,54,["فَذَرۡهُمۡ","فِي","غَمۡرَتِهِمۡ","حَتَّىٰ","حِينٍ"],"фазархум фии гамратихим хатта хиин","Оставь же их в их невежестве (или слепоте и растерянности) до определенного времени.",["так оставь их","в","пучине их заблуждения","до","времени"]],[23,55,["أَيَحۡسَبُونَ","أَنَّمَا","نُمِدُّهُم","بِهِۦ","مِن","مَّالٖ","وَبَنِينَ"],"айахсабууна аннама нумиддухум бихии мим малин вабаниин","Неужели они думают, что Мы поддерживаем их богатством и сыновьями,",["разве думают они","что то, что","Мы подкрепляем их","этим","из","богатства","и сыновей"]],[23,56,["نُسَارِعُ","لَهُمۡ","فِي","ٱلۡخَيۡرَٰتِۚ","بَل","لَّا","يَشۡعُرُونَ"],"нусари`у лахум фил хайрати бал ла йаш`уруун","потому что спешим одарить их благами? О нет! Однако они не ощущают этого!",["Мы спешим","для них","в","благах","нет же","не","чувствуют они"]],[23,57,["إِنَّ","ٱلَّذِينَ","هُم","مِّنۡ","خَشۡيَةِ","رَبِّهِم","مُّشۡفِقُونَ"],"иннал лазиина хум мин хашйати раббихим мушфиḳуун","Воистину, те, которые трепещут от страха перед своим Господом,",["поистине","те, которые","они","от","страха","перед Господом их","трепещут"]],[23,58,["وَٱلَّذِينَ","هُم","بِـَٔايَٰتِ","رَبِّهِمۡ","يُؤۡمِنُونَ"],"валлазиина хум би'айати раббихим йу'минуун","которые веруют в знамения своего Господа,",["и те, которые","они","в знамения","Господа их","веруют"]],[23,59,["وَٱلَّذِينَ","هُم","بِرَبِّهِمۡ","لَا","يُشۡرِكُونَ"],"валлазиина хум бираббихим ла йушрикуун","которые не приобщают к своему Господу сотоварищей,",["и те, которые","они","к Господу их","не","приобщают сотоварищей"]]],"m":[[["مَا","не",23,43],["تَ