","Марьям",23,50],["وَأُمَّهُۥٓ","и мать его",23,50],["ءَايَةٗ","знамением",23,50],["وَءَاوَيۡنَٰهُمَآ","и Мы приютили их",23,50],["إِلَىٰ","на",23,50],["رَبۡوَةٖ","возвышенности",23,50],["ذَاتِ","обладающей",23,50],["قَرَارٖ","покоем",23,50],["وَمَعِينٖ","и родником",23,50]],[[50],["يَٰٓأَيُّهَا","о",23,51],["ٱلرُّسُلُ","посланники",23,51],["كُلُواْ","ешьте",23,51],["مِنَ","из",23,51],["ٱلطَّيِّبَٰتِ","благого",23,51],["وَٱعۡمَلُواْ","и делайте",23,51],["صَٰلِحًاۖ","праведное",23,51],["إِنِّي","поистине, Я",23,51],["بِمَا","о том, что",23,51]],[["تَعۡمَلُونَ","вы делаете",23,51],["عَلِيمٞ","Знающий",23,51],[51],["وَإِنَّ","и поистине",23,52],["هَٰذِهِۦٓ","эта",23,52],["أُمَّتُكُمۡ","религия ваша",23,52],["أُمَّةٗ","религия",23,52],["وَٰحِدَةٗ","единая",23,52],["وَأَنَا۠","и Я",23,52],["رَبُّكُمۡ","Господь ваш",23,52]],[["فَٱتَّقُونِ","так бойтесь Меня",23,52],[52],["فَتَقَطَّعُوٓاْ","но разорвали они",23,53],["أَمۡرَهُم","дело своё",23,53],["بَيۡنَهُمۡ","между собой",23,53],["زُبُرٗاۖ","на части",23,53],["كُلُّ","каждая",23,53],["حِزۡبِۭ","партия",23,53],["بِمَا","тому, что",23,53],["لَدَيۡهِمۡ","у них",23,53]],[["فَرِحُونَ","радуется",23,53],[53],["فَذَرۡهُمۡ","так оставь их",23,54],["فِي","в",23,54],["غَمۡرَتِهِمۡ","пучине их заблуждения",23,54],["حَتَّىٰ","до",23,54],["حِينٍ","времени",23,54],[54],["أَيَحۡسَبُونَ","разве думают они",23,55],["أَنَّمَا","что то, что",23,55]],[["نُمِدُّهُم","Мы подкрепляем их",23,55],["بِهِۦ","этим",23,55],["مِن","из",23,55],["مَّالٖ","богатства",23,55],["وَبَنِينَ","и сыновей",23,55],[55],["نُسَارِعُ","Мы спешим",23,56],["لَهُمۡ","для них",23,56],["فِي","в",23,56],["ٱلۡخَيۡرَٰتِۚ","благах",23,56],["بَل","нет же",23,56],["لَّا","не",23,56],["يَشۡعُرُونَ","чувствуют они",23,56]],[[56],["إِنَّ","поистине",23,57],["ٱلَّذِينَ","те, которые",23,57],["هُم","они",23,57],["مِّنۡ","от",23,57],["خَشۡيَةِ","страха",23,57],["رَبِّهِم","перед Господом их",23,57],["مُّشۡفِقُونَ","трепещут",23,57],[57],["وَٱلَّذِينَ","и те, которые",23,58],["هُم