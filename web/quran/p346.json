{"p":346,"j":18,"a":[[23,60,["وَٱلَّذِينَ","يُؤۡتُونَ","مَآ","ءَاتَواْ","وَّقُلُوبُهُمۡ","وَجِلَةٌ","أَنَّهُمۡ","إِلَىٰ","رَبِّهِمۡ","رَٰجِعُونَ"],"валлазиина йу'тууна ма атав ваḳулуубухум важилатун аннахум ила раббихим ражи`уун","которые раздают милостыню, тогда как их сердца страшатся того, что им суждено вернуться к своему Господу, -",["и те, которые","дают","то, что","дают","а сердца их","трепещут","что они","к","Господу их","возвратятся"]],[23,61,["أُوْلَٰٓئِكَ","يُسَٰرِعُونَ","فِي","ٱلۡخَيۡرَٰتِ","وَهُمۡ","لَهَا","سَٰبِقُونَ"],"улаика йусари`ууна фил хайрати вахум лаха сабиḳуун","все они спешат вершить добрые дела и опережают в этом других.",["те","спешат","к","благим делам","и они","к ним","опережающие"]],[23,62,["وَلَا","نُكَلِّفُ","نَفۡسًا","إِلَّا","وُسۡعَهَاۚ","وَلَدَيۡنَا","كِتَٰبٞ","يَنطِقُ","بِٱلۡحَقِّ","وَهُمۡ","لَا","يُظۡلَمُونَ"],"вала нукаллифу нафсан илла вус`аха валадайна китабун йантиḳу билхаḳḳи вахум ла йузламуун","Мы не возлагаем на человека сверх его возможностей. У Нас есть Писание, которое глаголет истину, и с ними не поступят несправедливо.",["и не","Мы возлагаем","на душу","кроме","её возможности","и у Нас","Писание","говорящее","истину","и они","не","будут обижены"]],[23,63,["بَلۡ","قُلُوبُهُمۡ","فِي","غَمۡرَةٖ","مِّنۡ","هَٰذَا","وَلَهُمۡ","أَعۡمَٰلٞ","مِّن","دُونِ","ذَٰلِكَ","هُمۡ","لَهَا","عَٰمِلُونَ"],"бал ḳулуубухум фии гамратим мин хаза валахум а`малум мин дууни залика хум лаха `амилуун","Однако их сердца слепы к этому (Корану). А наряду с этим они совершают менее тяжкие злодеяния.",["нет же","сердца их","в","пучине","от","этого","и у них","деяния","из","помимо","этого","они","их","совершают"]],[23,64,["حَتَّىٰٓ","إِذَآ","أَخَذۡنَا","مُتۡرَفِيهِم","بِٱلۡعَذَابِ","إِذَا","هُمۡ","يَجۡـَٔرُونَ"],"хатта иза ахазна мутрафиихим бил`азаби иза хум йаж'аруун","А когда Мы подвергнем наказанию изнеженных роскошью среди них, они завопят громким голосом.",["пока","когда","Мы схватим","изнеженных из них","наказанием","вот","они","вопят"]],[23,65,["لَا","تَجۡـَٔرُواْ","ٱلۡيَوۡمَۖ","إِنَّكُم","مِّنَّا","لَا","تُنصَرُونَ"],"ла таж'арул йаума иннакум минна ла тунсаруун","Не вопите сегодня! Воистину, Мы не окажем вам помощи.",["не","вопите","сегодня","поистине, вы","от Нас","не","получите помощи"]],[23,66,["قَدۡ","كَانَتۡ","ءَايَٰتِي","تُتۡلَىٰ","عَلَيۡكُمۡ","فَكُنتُمۡ","عَلَىٰٓ","أَعۡقَٰبِكُمۡ","تَنكِصُونَ"],"ḳад канат айатии тутла `алайкум факунтум `ала а`ḳабикум танкисуун","Вам читали Мои аяты, но вы пятились от них,",["уже","были","аяты Мои","читаемы","вам","а вы","на","пятки ваши","пятились"]],[23,67,["مُسۡتَكۡبِرِينَ","بِهِۦ","سَٰمِرٗا","تَهۡجُرُونَ"],"мустакбириина бихии самиран тахжуруун","возгордившись ею (Каабой) и произнося скверные речи по ночам.",["возгордившись","им","беседуя по ночам","говорите вздор"]],[23,68,["أَفَلَمۡ","يَدَّبَّرُواْ","ٱلۡقَوۡلَ","أَمۡ","جَآءَهُم","مَّا","لَمۡ","يَأۡتِ","ءَابَآءَهُمُ","ٱلۡأَوَّلِينَ"],"афалам йаддаббарул ḳаула ам жаахум ма лам йа'ти абаахумул аввалиин","Неужели они не задумываются над Словом? Или же к ним явилось то, что не приходило к их праотцам?",["разве не","вдумались они","в Слово","или","пришло к ним","то, что","не","приходило","к отцам их","первым"]],[23,69,["أَمۡ","لَمۡ","يَعۡرِفُواْ","رَسُولَهُمۡ","فَهُمۡ","لَهُۥ","مُنكِرُونَ"],"ам лам йа`рифуу расуулахум фахум лахуу мункируун","Или же они не узнали своего Посланника и принялись отвергать его?",["или","не","узнали они","посланника своего","и они","его","отвергают"]],[23,70,["أَمۡ","يَقُولُونَ","بِهِۦ","جِنَّةُۢۚ","بَلۡ","جَآءَهُم","بِٱلۡحَقِّ","وَأَكۡثَرُهُمۡ","لِلۡحَقِّ","كَٰرِهُونَ"],"ам йаḳуулууна бихии жиннату бал жаахум билхаḳḳи ва'аксарухум лилхаḳḳи карихуун","Или же они говорят, что он - бесноватый? Напротив, он принес им истину, но большинство из них не любят ее.",["или","они говорят","в нём","безумие","нет же","он пришёл к ним","с истиной","а большинство их","истину","ненавидят"]],[23,71,["وَلَوِ","ٱتَّبَعَ","ٱلۡحَقُّ","أَهۡوَآءَهُمۡ","لَفَسَدَتِ","ٱلسَّمَٰوَٰتُ","وَٱلۡأَرۡضُ","وَمَن","فِيهِنَّۚ","بَلۡ","أَتَيۡنَٰهُم","بِذِكۡرِهِمۡ","فَهُمۡ","عَن","ذِكۡرِهِم","مُّعۡرِضُونَ"],"валавиттаба`ал хаḳḳу ахваахум лафасадатис самавату вал'арду ваман фиихинна бал атайнахум бизикрихим фахум `ан зикрихим му`ридуун","А если бы истина зависела от их желаний, то сгинули бы небеса, земля и те, кто на них. Мы даровали им их Напоминание (Коран), однако они отвернулись от своего Напоминания.",["а если бы","последовала","истина","страстям их","непременно испортились бы","небеса","и земля","и те, кто","в них","нет же","Мы доставили им","напоминание их","но они","от","напоминания их","отворачиваются"]],[23,72,["أَمۡ","تَسۡـَٔلُهُمۡ","خَرۡجٗا","فَخَرَاجُ","رَبِّكَ","خَيۡرٞۖ","وَهُوَ","خَيۡرُ","ٱلرَّٰزِقِينَ"],"ам тас'алухум харжан фахаражу раббика хайрун вахуа хайрур разиḳиин","Разве ты просишь у них вознаграждения? Воздаяние твоего Господа лучше, и Он - Наилучший из дарующих удел.",["или","ты просишь у них","платы","но плата","Господа твоего","лучше","и Он","Лучший","из наделяющих уделом"]],[23,73,["وَإِنَّكَ","لَتَدۡعُوهُمۡ","إِلَىٰ","صِرَٰطٖ","مُّسۡتَقِيمٖ"],"ва'иннака латад`уухум ила сиратим мустаḳиим","Воистину, ты призываешь их на прямой путь.",["и поистине, ты","непременно зовешь их","к","пути","прямому"]],[23,74,["وَإِنَّ","ٱلَّذِينَ","لَا","يُؤۡمِنُونَ","بِٱلۡأٓخِرَةِ","عَنِ","ٱلصِّرَٰطِ","لَنَٰكِبُونَ"],"ва'иннал лазиина ла йу'минууна бил'ахирати `анис сирати ланакибуун","А те, которые не веруют в Последнюю жизнь, непременно сбиваются с пути.",["и поистине","те, которые","не","веруют","в последнюю жизнь","от","пути","непременно уклоняются"]]],"m":[[["وَٱلَّذِينَ","и те, которые",23,60],["يُؤۡتُونَ","дают",23,60],["مَآ","то, что",23,60],["ءَاتَواْ","дают",23,60],["وَّقُلُوبُهُمۡ","а сердца их",23,60],["وَجِلَةٌ","трепещут",23,60],["أَنَّهُمۡ","что они",23,60],["إِلَىٰ","к",23,60],["رَبِّهِمۡ","Господу их",23,60],["رَٰجِعُونَ","возвратятся",23,60],[60]],[["أُوْلَٰٓئِكَ","те",23,61],["يُسَٰرِعُونَ","спешат",23,61],["فِي","к",23,61],["ٱلۡخَيۡرَٰتِ","благим делам",