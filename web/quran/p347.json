{"p":347,"j":18,"a":[[23,75,["وَلَوۡ","رَحِمۡنَٰهُمۡ","وَكَشَفۡنَا","مَا","بِهِم","مِّن","ضُرّٖ","لَّلَجُّواْ","فِي","طُغۡيَٰنِهِمۡ","يَعۡمَهُونَ"],"валау рахимнахум вакашафна ма бихим мин дуррил лалажжуу фии тугйанихим йа`махуун","Если бы Мы смилостивились над ними и избавили их от беды, они все равно продолжали бы слепо скитаться, настаивая на своем беззаконии.",["и если бы","Мы помиловали их","и устранили","то, что","с ними","из","беды","непременно упорствовали бы","в","бесчинстве своём","скитаясь вслепую"]],[23,76,["وَلَقَدۡ","أَخَذۡنَٰهُم","بِٱلۡعَذَابِ","فَمَا","ٱسۡتَكَانُواْ","لِرَبِّهِمۡ","وَمَا","يَتَضَرَّعُونَ"],"валаḳад ахазнахум бил`азаби фамастакануу лираббихим вама йатадарра`уун","Мы подвергли их мучениям, но они не смирились перед своим Господом и не взмолились перед Ним.",["и уже","Мы схватили их","наказанием","но не","смирились они","перед Господом их","и не","взмолились они"]],[23,77,["حَتَّىٰٓ","إِذَا","فَتَحۡنَا","عَلَيۡهِم","بَابٗا","ذَا","عَذَابٖ","شَدِيدٍ","إِذَا","هُمۡ","فِيهِ","مُبۡلِسُونَ"],"хатта иза фатахна `алайхим бабан за `азабин шадиидин иза хум фиихи мублисуун","Когда же Мы распахнем перед ними врата тяжких мучений, они придут там в отчаяние.",["пока","когда","Мы откроем","над ними","врата","с","наказанием","тяжким","вот","они","в нём","в отчаянии"]],[23,78,["وَهُوَ","ٱلَّذِيٓ","أَنشَأَ","لَكُمُ","ٱلسَّمۡعَ","وَٱلۡأَبۡصَٰرَ","وَٱلۡأَفۡـِٔدَةَۚ","قَلِيلٗا","مَّا","تَشۡكُرُونَ"],"вахуал лазии аншаа лакумус сам`а вал'абсара вал'аф'идата ḳалиилам ма ташкуруун","Он - Тот, Кто сотворил для вас слух, зрение и сердца. Но как мала ваша благодарность!",["и Он","Тот, Который","создал","для вас","слух","и зрение","и сердца","мало","что","вы благодарите"]],[23,79,["وَهُوَ","ٱلَّذِي","ذَرَأَكُمۡ","فِي","ٱلۡأَرۡضِ","وَإِلَيۡهِ","تُحۡشَرُونَ"],"вахуал лазии зараакум фил арди ва'илайхи тухшаруун","Он - Тот, Кто расселил вас по земле, и к Нему вы будете собраны.",["и Он","Тот, Который","расселил вас","на","земле","и к Нему","вы будете собраны"]],[23,80,["وَهُوَ","ٱلَّذِي","يُحۡيِۦ","وَيُمِيتُ","وَلَهُ","ٱخۡتِلَٰفُ","ٱلَّيۡلِ","وَٱلنَّهَارِۚ","أَفَلَا","تَعۡقِلُونَ"],"вахуал лазии йухйии вайумииту валахухтилафул лайли ваннахари афала та`ḳилуун","Он - Тот, Кто дарует жизнь и умерщвляет. Он чередует ночь и день. Неужели вы не разумеете?",["и Он","Тот, Который","оживляет","и умерщвляет","и Ему принадлежит","смена","ночи","и дня","неужели не","уразумеете"]],[23,81,["بَلۡ","قَالُواْ","مِثۡلَ","مَا","قَالَ","ٱلۡأَوَّلُونَ"],"бал ḳалуу мисла ма ḳалал аввалуун","О нет! Они говорят то же, что говорили первые поколения.",["нет же","сказали","подобное","тому, что","сказали","первые"]],[23,82,["قَالُوٓاْ","أَءِذَا","مِتۡنَا","وَكُنَّا","تُرَابٗا","وَعِظَٰمًا","أَءِنَّا","لَمَبۡعُوثُونَ"],"ḳалуу а'иза митна вакунна турабан ва`изаман а'инна ламаб`уусуун","Они говорят: «Неужели мы будем воскрешены после того, как умрем и превратимся в прах и кости?",["они сказали","неужели когда","мы умерли","и стали","прахом","и костями","неужели мы","непременно воскрешены"]],[23,83,["لَقَدۡ","وُعِدۡنَا","نَحۡنُ","وَءَابَآؤُنَا","هَٰذَا","مِن","قَبۡلُ","إِنۡ","هَٰذَآ","إِلَّآ","أَسَٰطِيرُ","ٱلۡأَوَّلِينَ"],"лаḳад ву`идна нахну ва'абауна хаза мин ḳаблу ин хаза илла асатиирул аввалиин","Это обещают нам, а еще раньше это обещали нашим отцам. Это - всего лишь легенды древних народов».",["действительно","было обещано нам","нам","и нашим отцам","это","из","прежде","не","это","кроме","легенды","древних"]],[23,84,["قُل","لِّمَنِ","ٱلۡأَرۡضُ","وَمَن","فِيهَآ","إِن","كُنتُمۡ","تَعۡلَمُونَ"],"ḳул лиманил арду ваман фииха ин кунтум та`ламуун","Скажи: «Кому принадлежит земля и те, кто на ней, если только вы знаете?».",["скажи","кому (принадлежит)","земля","и кто","на ней","если","вы","знаете"]],[23,85,["سَيَقُولُونَ","لِلَّهِۚ","قُلۡ","أَفَلَا","تَذَكَّرُونَ"],"сайаḳуулууна лиллахи ḳул афала тазаккаруун","Они скажут: «Аллаху». Скажи: «Неужели вы не помяните назидание?».",["скажут","Аллаху","скажи","неужели не","вспомните"]],[23,86,["قُلۡ","مَن","رَّبُّ