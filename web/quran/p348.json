{"p":348,"j":18,"a":[[23,90,["بَلۡ","أَتَيۡنَٰهُم","بِٱلۡحَقِّ","وَإِنَّهُمۡ","لَكَٰذِبُونَ"],"бал атайнахум билхаḳḳи ва'иннахум лаказибуун","Мы принесли им истину, однако они - лжецы.",["напротив","Мы принесли им","истину","и поистине, они","непременно лжецы"]],[23,91,["مَا","ٱتَّخَذَ","ٱللَّهُ","مِن","وَلَدٖ","وَمَا","كَانَ","مَعَهُۥ","مِنۡ","إِلَٰهٍۚ","إِذٗا","لَّذَهَبَ","كُلُّ","إِلَٰهِۭ","بِمَا","خَلَقَ","وَلَعَلَا","بَعۡضُهُمۡ","عَلَىٰ","بَعۡضٖۚ","سُبۡحَٰنَ","ٱللَّهِ","عَمَّا","يَصِفُونَ"],"маттахазаллаху мин валадин вама кана ма`ахуу мин илахин изал лазахаба куллу илахи бима халаḳа вала`ала ба`духум `ала ба`дин субханаллахи `амма йасифуун","Аллах не взял Себе сына, и нет наряду с Ним другого бога. В противном случае каждый бог унес бы с собой то, что сотворил, и одни из них возвысились бы над другими. Аллах превыше того, что они приписывают Ему!",["не","взял","Аллах","из","сына","и не","было","с Ним","из","бога","тогда","непременно унёс бы","каждый","бог","то, что","он сотворил","и непременно возвысились","одни из них","над","другими","пречист","Аллах","от того, что","они приписывают"]],[23,92,["عَٰلِمِ","ٱلۡغَيۡبِ","وَٱلشَّهَٰدَةِ","فَتَعَٰلَىٰ","عَمَّا","يُشۡرِكُونَ"],"`алимил гайби вашшахадати фата`ала `амма йушрикуун","Ведающий сокровенное и явное! Он превыше тех, кого они приобщают в сотоварищи!",["Знающий","сокровенное","и явное","превыше же Он","того, что","приобщают"]],[23,93,["قُل","رَّبِّ","إِمَّا","تُرِيَنِّي","مَا","يُوعَدُونَ"],"ḳул ррабби имма турийаннии ма йуу`адуун","Скажи: «Господи! Если Ты покажешь мне то, что им обещано,",["скажи","Господи","если","Ты покажешь мне","то, что","им обещано"]],[23,94,["رَبِّ","فَلَا","تَجۡعَلۡنِي","فِي","ٱلۡقَوۡمِ","ٱلظَّٰلِمِينَ"],"рабби фала таж`алнии фил ḳаумиз залимиин","то не делай меня, Господи, в числе несправедливых людей!».",["Господи","то не","делай меня","среди","людей","несправедливых"]],[23,95,["وَإِنَّا","عَلَىٰٓ","أَن","نُّرِيَكَ","مَا","نَعِدُهُمۡ","لَقَٰدِرُونَ"],"ва'инна `ала ан нурийака ма на`идухум лаḳадируун","Воистину, Мы способны показать тебе то, что им обещано.",["и поистине, Мы","на (то)","чтобы","Мы показали тебе","то, что","Мы обещаем им","непременно способны"]],[23,96,["ٱدۡفَعۡ","بِٱلَّتِي","هِيَ","أَحۡسَنُ","ٱلسَّيِّئَةَۚ","نَحۡنُ","أَعۡلَمُ","بِمَا","يَصِفُونَ"],"идфа` биллатии хийа ахсанус саййиата нахну а`ламу бима йасифуун","Оттолкни зло тем, что лучше. Мы лучше знаем то, что они приписывают.",["отталкивай","тем, что","оно","лучше","зло","Мы","лучше знаем","о том, что","приписывают"]],[23,97,["وَقُل","رَّبِّ","أَعُوذُ","بِكَ","مِنۡ","هَمَزَٰتِ","ٱلشَّيَٰطِينِ"],"ваḳул ррабби а`уузу бика мин хамазатиш шайатиин","Скажи: «Господи! Я прибегаю к Тебе от наваждений дьяволов.",["и скажи","Господи","прибегаю","к Тебе","от","наущений","дьяволов"]],[23,98,["وَأَعُوذُ","بِكَ","رَبِّ","أَن","يَحۡضُرُونِ"],"ва'а`уузу бика рабби ан йахдуруун","Я прибегаю к Тебе, Господи, дабы они не приближались ко мне».",["и прибегаю","к Тебе","Господи","от того, чтобы","они явились ко мне"]],[23,99,["حَتَّىٰٓ","إِذَا","جَآءَ","أَحَدَهُمُ","ٱلۡمَوۡتُ","قَالَ","رَبِّ","ٱرۡجِعُونِ"],"хатта иза жаа ахадахумул мауту ḳала раббиржи`уун","Когда же смерть подступает к кому-нибудь из них, он говорит: «Господи! Верни меня обратно.",["пока","когда","придёт","к одному из них","смерть","он скажет","Господи","верните меня"]],[23,100,["لَعَلِّيٓ","أَعۡمَلُ","صَٰلِحٗا","فِيمَا","تَرَكۡتُۚ","كـَلَّآۚ","إِنَّهَا","كَلِمَةٌ","هُوَ","قَآئِلُهَاۖ","وَمِن","وَرَآئِهِم","بَرۡزَخٌ","إِلَىٰ","يَوۡمِ","يُبۡعَثُونَ"],"ла`аллии а`малу салихан фиима таракту калла иннаха калиматун хуа ḳаилуха вамин вараихим барзахун ила йауми йуб`асуун","Быть может, я стану совершать праведные поступки, которые я отбросил». Но нет! Это - всего лишь слова, которые он произносит. Позади них будет преграда вплоть до того дня, когда они будут воскрешены.",["быть может, я","совершу","праведное","в том, что","я оставил","так нет же","поистине, это","слово","он","говорящий его","и позади","них","преграда","до","дня",