{"p":349,"j":18,"a":[[23,105,["أَلَمۡ","تَكُنۡ","ءَايَٰتِي","تُتۡلَىٰ","عَلَيۡكُمۡ","فَكُنتُم","بِهَا","تُكَذِّبُونَ"],"алам такун айатии тутла `алайкум факунтум биха туказзибуун","Разве вам не читали Мои аяты, а вы считали их ложью?",["разве не","были","Мои аяты","читаемы","вам","а вы были","их","считали ложью"]],[23,106,["قَالُواْ","رَبَّنَا","غَلَبَتۡ","عَلَيۡنَا","شِقۡوَتُنَا","وَكُنَّا","قَوۡمٗا","ضَآلِّينَ"],"ḳалуу раббана галабат `алайна шиḳватуна вакунна ḳауман даллиин","Они скажут: «Господи! Наше злосчастие одолело нас, и мы оказались заблудшими людьми.",["они сказали","Господь наш","одолело","нас","наше злосчастие","и были мы","людьми","заблудшими"]],[23,107,["رَبَّنَآ","أَخۡرِجۡنَا","مِنۡهَا","فَإِنۡ","عُدۡنَا","فَإِنَّا","ظَٰلِمُونَ"],"раббана ахрижна минха фа'ин `удна фа'инна залимуун","Господи! Выведи нас отсюда. И если мы вернемся к грехам, то действительно будем беззаконниками».",["Господь наш","выведи нас","из неё","и если","мы вернёмся","то поистине, мы","несправедливы"]],[23,108,["قَالَ","ٱخۡسَـُٔواْ","فِيهَا","وَلَا","تُكَلِّمُونِ"],"ḳалахсауу фииха вала тукаллимуун","Он скажет: «Оставайтесь здесь с позором и не говорите со Мной!",["Он сказал","сгиньте (с позором)","в ней","и не","говорите со Мной"]],[23,109,["إِنَّهُۥ","كَانَ","فَرِيقٞ","مِّنۡ","عِبَادِي","يَقُولُونَ","رَبَّنَآ","ءَامَنَّا","فَٱغۡفِرۡ","لَنَا","وَٱرۡحَمۡنَا","وَأَنتَ","خَيۡرُ","ٱلرَّٰحِمِينَ"],"иннахуу кана фарииḳум мин `ибадии йаḳуулууна раббана аманна фагфир лана вархамна ва'анта хайрур рахимиин","Воистину, некоторые из Моих рабов говорили: «Господи! Мы уверовали. Прости же нас и помилуй, ибо Ты - Наилучший из милосердных».",["поистине","была","группа","из","Моих рабов","говорили","Господь наш","мы уверовали","так прости","нам","и помилуй нас","и Ты","лучший","из милующих"]],[23,110,["فَٱتَّخَذۡتُمُوهُمۡ","سِخۡرِيًّا","حَتَّىٰٓ","أَنسَوۡكُمۡ","ذِكۡرِي","وَكُنتُم","مِّنۡهُمۡ","تَضۡحَكُونَ"],"фаттахазтумуухум сихриййан хатта ансаукум зикрии вакунтум минхум тадхакуун","Вы же насмехались над ними, пока не забыли Мое Напоминание. И вы смеялись над ними.",["а вы взяли их","(предметом) насмешек","пока","они заставили вас забыть","Моё поминание","и вы были","над ними","смеялись"]],[23,111,["إِنِّي","جَزَيۡتُهُمُ","ٱلۡيَوۡمَ","بِمَا","صَبَرُوٓاْ","أَنَّهُمۡ","هُمُ","ٱلۡفَآئِزُونَ"],"иннии жазайтухумул йаума бима сабаруу аннахум хумул фаизуун","Сегодня Я вознаградил их за то, что они проявили терпение. Воистину, они являются преуспевшими».",["поистине, Я","воздал им","сегодня","за то, что","они терпели","ведь они","они","преуспевшие"]],[23,112,["قَٰلَ","كَمۡ","لَبِثۡتُمۡ","فِي","ٱلۡأَرۡضِ","عَدَدَ","سِنِينَ"],"ḳала кам лабистум фил арди `адада синиин","Аллах скажет: «Сколько лет вы пробыли на земле?».",["Он сказал","сколько","вы пробыли","на","земле","числом","лет"]],[23,113,["قَالُواْ","لَبِثۡنَا","يَوۡمًا","أَوۡ","بَعۡضَ","يَوۡمٖ","فَسۡـَٔلِ","ٱلۡعَآدِّينَ"],"ḳалуу лабисна йауман ау ба`да йаумин фас'алил `аддиин","Они скажут: «Мы пробыли день или часть дня. Лучше спроси тех, кто вел счет».",["они сказали","мы пробыли","день","или","часть","дня","так спроси","считающих"]],[23,114,["قَٰلَ","إِن","لَّبِثۡتُمۡ","إِلَّا","قَلِيلٗاۖ","لَّوۡ","أَنَّكُمۡ","كُنتُمۡ","تَعۡلَمُونَ"],"ḳала ил лабистум илла ḳалиилал лау аннакум кунтум та`ламуун","Он скажет: «Вы пробыли немного, если бы вы только знали.",["Он сказал","не","вы пробыли","кроме","немного","если бы","что вы","были","знаете"]],[23,115,["أَفَحَسِبۡتُمۡ","أَنَّمَا","خَلَقۡنَٰكُمۡ","عَبَثٗا","وَأَنَّكُمۡ","إِلَيۡنَا","لَا","تُرۡجَعُونَ"],"афахасибтум аннама халаḳнакум `абасан ва'аннакум илайна ла туржа`уун","Неужели вы полагали, что Мы сотворили вас ради забавы и что вы не будете возвращены к Нам?».",["разве вы думали","что","Мы сотворили вас","напрасно","и что вы","к Нам","не","будете возвращены"]],[23,116,["فَتَعَٰلَى","ٱللَّهُ","ٱلۡمَلِكُ","ٱلۡحَقُّۖ","لَآ","إِلَٰهَ","إِلَّا","هُوَ","رَبُّ","ٱلۡعَرۡشِ","ٱلۡكَرِيمِ"],"фата`алаллахул маликул хаḳḳу ла илаха илла хуа раббул `аршил кариим","Превыше всего Аллах, Истинный Властелин! Нет божества, кроме Него, Господа благородного Трона.",["превыше","Аллах","Царь","Истинный","нет","бога","кроме","Него","Господь","Трона","благородного"]],[23,117,["وَمَن","يَدۡعُ","مَعَ","ٱللَّهِ","إِلَٰهًا","ءَاخَرَ","لَا","بُرۡهَٰنَ","لَهُۥ","بِهِۦ","فَإِنَّمَا","حِسَابُهُۥ","عِندَ","رَبِّهِۦٓۚ","إِنَّهُۥ","لَا","يُفۡلِحُ","ٱلۡكَٰفِرُونَ"],"ваман йад`у ма`аллахи илахан ахара ла бурхана лахуу бихии фа'иннама хисабухуу `инда раббихии иннахуу ла йуфлихул кафируун","У того, кто молится наряду с Аллахом другим богам, нет в пользу этого никакого довода. Его счет хранится у его Господа. Воистину, неверующие не преуспеют.",["и кто","взывает","наряду с","Аллахом","к богу","другому","нет","довода","у него","на это","то лишь","его расчёт","у","его Господа","поистине","не","преуспеют","неверующие"]],[23,118,["وَقُل","رَّبِّ","ٱغۡفِرۡ","وَٱرۡحَمۡ","وَأَنتَ","خَيۡرُ","ٱلرَّٰحِمِينَ"],"ваḳул рраббигфир вархам ва'анта хайрур рахимиин","Скажи: «Господи, прости и помилуй, ведь Ты - Наилучший из милосердных!».",["и скажи","Господи","прости","и помилуй","и Ты","лучший","из милующих"]]],"m":[[["أَلَمۡ","разве не",23,105],["تَكُنۡ","были",23,105],["ءَايَٰتِي","Мои аяты",23,105],["تُتۡلَىٰ","читаемы",23,105],["عَلَيۡكُمۡ","вам",23,105],["فَكُنتُم","а вы были",23,105],["بِهَا","их",23,105],["تُكَذِّبُونَ","считали ложью",23,105],[105],["قَالُواْ","они сказали",23,106]],[["رَبَّنَا","Господь наш",23,106],["غَلَبَتۡ","одолело",23,106],["عَلَيۡنَا","нас",23,106],["شِقۡوَتُنَا","наше злосчастие",23,106],["وَكُنَّا","и были мы",23,106],["قَوۡمٗا","людьми",23,106],["ضَآلِّينَ","заблудшими",23,106],[106],["رَبَّنَآ","Господь наш",23,107]],[["أَخۡرِجۡنَا","выведи нас",23,107],["مِنۡهَا","из неё",23,107],["فَإِنۡ","и если",23,107],["عُدۡنَا","мы вернёмся",23,107],["فَإِنَّا","то поистине, мы",23,107],["ظَٰلِمُونَ","несправедливы",23,107],[107],["قَالَ","Он сказал",23,108],["ٱخۡسَـُٔواْ","сгиньте (с позором)",23,108],["فِيهَا","в ней",23,108]],[["وَلَا","и не",23,108],["تُكَلِّمُونِ","говорите со Мной",23,108],[108],["إِنَّهُۥ","поистине",23,109],["كَانَ","была",23,109],["فَرِيقٞ","группа",23,109],["مِّنۡ","из",23,109],["عِبَادِي","Моих рабов",23,109],["يَقُولُونَ","говорили",23,109],["رَبَّنَآ","Господь наш",23,109]],[["ءَامَنَّا","мы уверовали",23,109],["فَٱغۡفِرۡ","так прости",23,109],["لَنَا","нам",23,109],["وَٱرۡحَمۡنَا","и помилуй нас",23,109],["وَأَنتَ","и Ты",23,109],["خَيۡرُ","лучший",23,109],["ٱلرَّٰحِمِينَ","из милующих",23,109],[109],["فَٱتَّخَذۡتُمُوهُمۡ","а вы взяли их",23,110]],[["سِخۡرِيًّا","(предметом) насмешек",23,110],["حَتَّىٰٓ","пока",23,110],["أَنسَوۡكُمۡ","они заставили вас забыть",23,110],["ذِكۡرِي","Моё поминание",23,110],["وَكُنتُم","и вы были",23,110],["مِّنۡهُمۡ","над ними",23,110],["تَضۡحَكُونَ","смеялись",23,110],[110]],[["إِنِّي","поистине, Я",23,111],["جَزَيۡتُهُمُ","воздал им",23,111],["ٱلۡيَوۡمَ","сегодня",23,111],["بِمَا","за то, что",23,111],["صَبَرُوٓاْ","они терпели",23,111],["أَنَّهُمۡ","ведь они",23,111],["هُمُ","они",23,111],["ٱلۡفَآئِزُونَ","преуспевшие",23,111],[111],["قَٰلَ","Он сказал",23,112]],[["كَمۡ","сколько",23,112],["لَبِثۡتُمۡ","вы пробыли",23,112],["فِي","на",23,112],["ٱلۡأَرۡضِ","земле",23,112],["عَدَدَ","числом",23,112],["سِنِينَ","лет",23,112],[112],["قَالُواْ","они сказали",23,113],["لَبِثۡنَا","мы пробыли",23,113],["يَوۡمًا","день",23,113],["أَوۡ","или",23,113],["بَعۡضَ","часть",23,113]],[["يَوۡمٖ","дня",23,113],["فَسۡـَٔلِ","так спроси",23,113],["ٱلۡعَآدِّينَ","считающих",23,113],[113],["قَٰلَ","Он сказал",23,114],["إِن","не",23,114],["لَّبِثۡتُمۡ","вы пробыли",23,114],["إِلَّا","кроме",23,114],["قَلِيلٗاۖ","немного",23,114],["لَّوۡ","если бы",23,114],["أَنَّكُمۡ","что вы",23,114]],[["كُنتُمۡ","были",23,114],["تَعۡلَمُونَ","знаете",23,114],[114],["أَفَحَسِبۡتُمۡ","разве вы думали",23,115],["أَنَّمَا","что",23,115],["خَلَقۡنَٰكُمۡ","Мы сотворили вас",23,115],["عَبَثٗا","напрасно",23,115],["وَأَنَّكُمۡ","и что вы",23,115]],[["إِلَيۡنَا","к Нам",23,115],["لَا","не",23,115],["تُرۡجَعُونَ","будете возвращены",23,115],[115],["فَتَعَٰلَى","превыше",23,116],["ٱللَّهُ","Аллах",23,116],["ٱلۡمَلِكُ","Царь",23,116],["ٱلۡحَقُّۖ","Истинный",23,116],["لَآ","нет",23,116],["إِلَٰهَ","бога",23,116],["إِلَّا","кроме",23,116]],[["هُوَ","Него",23,116],["رَبُّ","Господь",23,116],["ٱلۡعَرۡشِ","Трона",23,116],["ٱلۡكَرِيمِ","благородного",23,116],[116],["وَمَن","и кто",23,117],["يَدۡعُ","взывает",23,117],["مَعَ","наряду с",23,117],["ٱللَّهِ","Аллахом",23,117],["إِلَٰهًا","к богу",23,117]],[["ءَاخَرَ","другому",23,117],["لَا","нет",23,117],["بُرۡهَٰنَ","довода",23,117],["لَهُۥ","у него",23,117],["بِهِۦ","на это",23,117],["فَإِنَّمَا","то лишь",23,117],["حِسَابُهُۥ","его расчёт",23,117],["عِندَ","у",23,117],["رَبِّهِۦٓۚ","его Господа",23,117],["إِنَّهُۥ","поистине",23,117],["لَا","не",23,117],["يُفۡلِحُ","преуспеют",23,117]],[["ٱلۡكَٰفِرُونَ","неверующие",23,117],[117],["وَقُل","и скажи",23,118],["رَّبِّ","Господи",23,118],["ٱغۡفِرۡ","прости",23,118],["وَٱرۡحَمۡ","и помилуй",23,118],["وَأَنتَ","и Ты",23,118],["خَيۡرُ","лучший",23,118],["ٱلرَّٰحِمِينَ","из милующих",23,118],[118]],["h",24]]}