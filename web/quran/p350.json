{"p":350,"j":18,"a":[[24,1,["سُورَةٌ","أَنزَلۡنَٰهَا","وَفَرَضۡنَٰهَا","وَأَنزَلۡنَا","فِيهَآ","ءَايَٰتِۭ","بَيِّنَٰتٖ","لَّعَلَّكُمۡ","تَذَكَّرُونَ"],"сууратун анзалнаха вафараднаха ва'анзална фииха айати баййинатил ла`аллакум тазаккаруун","Вот сура, которую Мы ниспослали и сделали законом. Мы ниспослали в ней ясные знамения, чтобы вы могли помянуть назидание.",["сура","Мы ниспослали её","и Мы вменили её","и Мы ниспослали","в ней","знамения","ясные","чтобы вы","помянули назидание"]],[24,2,["ٱلزَّانِيَةُ","وَٱلزَّانِي","فَٱجۡلِدُواْ","كُلَّ","وَٰحِدٖ","مِّنۡهُمَا","مِاْئَةَ","جَلۡدَةٖۖ","وَلَا","تَأۡخُذۡكُم","بِهِمَا","رَأۡفَةٞ","فِي","دِينِ","ٱللَّهِ","إِن","كُنتُمۡ","تُؤۡمِنُونَ","بِٱللَّهِ","وَٱلۡيَوۡمِ","ٱلۡأٓخِرِۖ","وَلۡيَشۡهَدۡ","عَذَابَهُمَا","طَآئِفَةٞ","مِّنَ","ٱلۡمُؤۡمِنِينَ"],"аззанийату ваззании фажлидуу кулла вахидим минхума миата жалдатин вала та'хузкум бихима ра'фатун фии дииниллахи ин кунтум ту'минууна биллахи валйаумил ахири валйашхад `азабахума таифатум минал му'миниин","Прелюбодейку и прелюбодея - каждого из них высеките сто раз. Пусть не овладевает вами жалость к ним ради религии Аллаха, если вы веруете в Аллаха и в Последний день. А свидетелями их наказания пусть будет группа верующих.",["прелюбодейку","и прелюбодея","высеките","каждого","одного","из них двоих","сто","ударов плетью","и пусть не","овладевает вами","к ним двоим","жалость","в","религии","Аллаха","если","вы","веруете","в Аллаха","и в день","Последний","и пусть засвидетельствует","их наказание","группа","из","верующих"]],[24,3,["ٱلزَّانِي","لَا","يَنكِحُ","إِلَّا","زَانِيَةً","أَوۡ","مُشۡرِكَةٗ","وَٱلزَّانِيَةُ","لَا","يَنكِحُهَآ","إِلَّا","زَانٍ","أَوۡ","مُشۡرِكٞۚ","وَحُرِّمَ","ذَٰلِكَ","عَلَى","ٱلۡمُؤۡمِنِينَ"],"аззании ла йанкиху илла занийатан ау мушрикатан ваззанийату ла йанкихуха илла занин ау мушрикун вахуррима залика `алал му'миниин","Прелюбодей женится только на прелюбодейке или многобожнице, а на прелюбодейке женится только прелюбодей или многобожник. Верующим же это запрещено.",["прелюбодей","не","женится","кроме как","на прелюбодейке","или","многобожнице","а прелюбодейка","не","женится на ней","кроме","прелюбодей","или","многобожник","и запрещено","это","для","верующих"]],[24,4,["وَٱلَّذِينَ","يَرۡمُونَ","ٱلۡمُحۡصَنَٰتِ","ثُمَّ","لَمۡ","يَأۡتُواْ","بِأَرۡبَعَةِ","شُهَدَآءَ","فَٱجۡلِدُوهُمۡ","ثَمَٰنِينَ","جَلۡدَةٗ","وَلَا","تَقۡبَلُواْ","لَهُمۡ","شَهَٰدَةً","أَبَدٗاۚ","وَأُوْلَٰٓئِكَ","هُمُ","ٱلۡفَٰسِقُونَ"],"валлазиина йармуунал мухсанати сумма лам йа'туу би'арба`ати шухадаа фажлидуухум саманиина жалдатан вала таḳбалуу лахум шахадатан абадан ва'улаика хумул фасиḳуун","Тех, которые обвинят целомудренных женщин и не приведут четырех свидетелей, высеките восемьдесят раз и никогда не принимайте их свидетельства, ибо они являются нечестивцами,",["а те, которые","обвиняют","целомудренных","затем","не","приведут","четырёх","свидетелей","то высеките их","восемьдесят","ударов плетью","и не","принимайте","от них","свидетельства","никогда","и те","они","нечестивцы"]],[24,5,["إِلَّا","ٱلَّذِينَ","تَابُواْ","مِنۢ","بَعۡدِ","ذَٰلِكَ","وَأَصۡلَحُواْ","فَإِنَّ","ٱللَّهَ","غَفُورٞ","رَّحِيمٞ"],"иллал лазиина табуу мим ба`ди залика ва'аслахуу фа'инналлаха гафуурур рахиим","кроме тех из них, которые после этого раскаялись и стали поступать праведно. Воистину, Аллах - Прощающий, Милосердный.",["кроме","тех, которые","покаялись","после","после","этого","и исправились","то поистине","Аллах","Прощающий","Милосердный"]],[24,6,["وَٱلَّذِينَ","يَرۡمُونَ","أَزۡوَٰجَهُمۡ","وَلَمۡ","يَكُن","لَّهُمۡ","شُهَدَآءُ","إِلَّآ","أَنفُسُهُمۡ","فَشَهَٰدَةُ","أَحَدِهِمۡ","أَرۡبَعُ","شَهَٰدَٰتِۭ","بِٱللَّهِ","إِنَّهُۥ","لَمِنَ","ٱلصَّٰدِقِينَ"],"валлазиина йармууна азважахум валам йакул лахум шухадау илла анфусухум фашахадату ахадихим арба`у шахадати биллахи иннахуу ламинас садиḳиин","А свидетельством каждого из тех, которые обвиняют своих жен в прелюбодеянии, не имея свидетелей, кроме самих себя, должны быть четыре свидетельства Аллахом о том, что он говорит правду,",["а те, которые","обвиняют","своих жён","и не","было","у них","свидетелей","кроме","самих себя","то свидетельство","одного из них","четыре","свидетельства","Аллахом","что он","непременно из","правдивых"]],[24,7,["وَٱلۡخَٰمِسَةُ","أَنَّ","لَعۡنَتَ","ٱللَّهِ","عَلَيۡهِ","إِن","كَانَ","مِنَ","ٱلۡكَٰذِبِينَ"],"валхамисату анна ла`наталлахи `алайхи ин кана минал казибиин","и пятое о том, что проклятие Аллаха ляжет на него, если он лжет.",["а пятое","что","проклятие","Аллаха","на нём","если","он был","из","лжецов"]],[24,8,["وَيَدۡرَؤُاْ","عَنۡهَا","ٱلۡعَذَابَ","أَن","تَشۡهَدَ","أَرۡبَعَ","شَهَٰدَٰتِۭ","بِٱللَّهِ","إِنَّهُۥ","لَمِنَ","ٱلۡكَٰذِبِينَ"],"вайадрау `анхал `азаба ан ташхада арба`а шахадати биллахи иннахуу ламинал казибиин","Наказание будет отвращено от нее, если она принесет четыре свидетельства Аллахом о том, что он лжет,",["и отвращает","от неё","наказание","что","она засвидетельствует","четыре","свидетельства","Аллахом","что он","непременно из","лжецов"]],[24,9,["وَٱلۡخَٰمِسَةَ","أَنَّ","غَضَبَ","ٱللَّهِ","عَلَيۡهَآ","إِن","كَانَ","مِنَ","ٱلصَّٰدِقِينَ"],"валхамисата анна гадабаллахи `алайха ин кана минас садиḳиин","и пятое о том, что гнев Аллаха падет на нее, если он говорит правду.",["а пятое","что","гнев","Аллаха","на ней","если","он был","из","правдивых"]],[24,10,["وَلَوۡلَا","فَضۡلُ","ٱللَّهِ","عَلَيۡكُمۡ","وَرَحۡمَتُهُۥ","وَأَنَّ","ٱللَّهَ","تَوَّابٌ","حَكِيمٌ"],"валаула фадлуллахи `алайкум варахматухуу ва'анналлаха таввабун хакиим","Если бы не милосердие и милость Аллаха к вам и если бы Аллах не был Принимающим покаяния и Мудрым, то лжецов постигло бы скорое наказание.",["и если бы не","милость","Аллаха","к вам","и Его милосердие","и то, что","Аллах","Принимающий покаяния","Мудрый"]]],"m":[["b"],[["سُورَةٌ","сура",24,1],["أَنزَلۡنَٰهَا","Мы ниспослали её",24,1],["وَفَرَضۡنَٰهَا","и Мы вменили её",24,1],["وَأَنزَلۡنَا","и Мы ниспослали",24,1],["فِيهَآ","в ней",24,1],["ءَايَٰتِۭ","знамения",24,1],["بَيِّنَٰتٖ","ясные",24,1],["لَّعَلَّكُمۡ","чтобы вы"