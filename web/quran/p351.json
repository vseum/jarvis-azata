{"p":351,"j":18,"a":[[24,11,["إِنَّ","ٱلَّذِينَ","جَآءُو","بِٱلۡإِفۡكِ","عُصۡبَةٞ","مِّنكُمۡۚ","لَا","تَحۡسَبُوهُ","شَرّٗا","لَّكُمۖ","بَلۡ","هُوَ","خَيۡرٞ","لَّكُمۡۚ","لِكُلِّ","ٱمۡرِيٕٖ","مِّنۡهُم","مَّا","ٱكۡتَسَبَ","مِنَ","ٱلۡإِثۡمِۚ","وَٱلَّذِي","تَوَلَّىٰ","كِبۡرَهُۥ","مِنۡهُمۡ","لَهُۥ","عَذَابٌ","عَظِيمٞ"],"иннал лазиина жауу бил'ифки `усбатум минкум ла тахсабууху шаррал лакум бал хуа хайрул лакум ликуллимрийим минхум мактасаба минал исми валлазии тавалла кибрахуу минхум лахуу `азабун `азиим","Те, которые возвели навет на мать правоверных Аишу, являются группой из вас самих. Не считайте это злом для вас. Напротив, это является добром для вас. Каждому мужу из них достанется заработанный им грех. А тому из них, кто взял на себя большую часть этого, уготованы великие мучения.",["поистине","те, которые","пришли","с клеветой","группа","из вас","не","считайте это","злом","для вас","напротив","это","благо","для вас","каждому","человеку","из них","то, что","он приобрёл","из","греха","а тот, который","взял на себя","большую его часть","из них","ему","наказание","великое"]],[24,12,["لَّوۡلَآ","إِذۡ","سَمِعۡتُمُوهُ","ظَنَّ","ٱلۡمُؤۡمِنُونَ","وَٱلۡمُؤۡمِنَٰتُ","بِأَنفُسِهِمۡ","خَيۡرٗا","وَقَالُواْ","هَٰذَآ","إِفۡكٞ","مُّبِينٞ"],"ллаула из сами`тумууху заннал му'минууна валму'минату би'анфусихим хайран ваḳалуу хаза ифкум мубиин","Почему же, когда вы услышали это, верующие мужчины и женщины не подумали о самих себе (друг о друге) хорошее и не сказали: «Это - очевидная клевета»?",["почему не","когда","вы услышали это","подумали","верующие","и верующие женщины","о самих себе","хорошее","и сказали","это","клевета","явная"]],[24,13,["لَّوۡلَا","جَآءُو","عَلَيۡهِ","بِأَرۡبَعَةِ","شُهَدَآءَۚ","فَإِذۡ","لَمۡ","يَأۡتُواْ","بِٱلشُّهَدَآءِ","فَأُوْلَٰٓئِكَ","عِندَ","ٱللَّهِ","هُمُ","ٱلۡكَٰذِبُونَ"],"ллаула жауу `алайхи би'арба`ати шухадаа фа'из лам йа'туу бишшухадаи фа'улаика `индаллахи хумул казибуун","Почему они не привели для подтверждения этого четырех свидетелей? Если они не привели свидетелей, то перед Аллахом они являются лжецами.",["почему не","привели","на это","четырёх","свидетелей","а раз","не","они привели","свидетелей","то те","у","Аллаха","они","лжецы"]],[24,14,["وَلَوۡلَا","فَضۡلُ","ٱللَّهِ","عَلَيۡكُمۡ","وَرَحۡمَتُهُۥ","فِي","ٱلدُّنۡيَا","وَٱلۡأٓخِرَةِ","لَمَسَّكُمۡ","فِي","مَآ","أَفَضۡتُمۡ","فِيهِ","عَذَابٌ","عَظِيمٌ"],"валаула фадлуллахи `алайкум варахматухуу фид дунйа вал'ахирати ламассакум фии ма афадтум фиихи `азабун `азиим","Если бы не милосердие и милость Аллаха к вам в этом мире и в Последней жизни, то за ваши пространные речи вас коснулись бы великие мучения.",["и если бы не","милость","Аллаха","к вам","и Его милосердие","в","этом мире","и Последней жизни","непременно коснулось бы вас","за","то, что","вы распространялись","об этом","наказание","великое"]],[24,15,["إِذۡ","تَلَقَّوۡنَهُۥ","بِأَلۡسِنَتِكُمۡ","وَتَقُولُونَ","بِأَفۡوَاهِكُم","مَّا","لَيۡسَ","لَكُم","بِهِۦ","عِلۡمٞ","وَتَحۡسَبُونَهُۥ","هَيِّنٗا","وَهُوَ","عِندَ","ٱللَّهِ","عَظِيمٞ"],"из талаḳḳаунахуу би'алсинатикум ватаḳуулууна би'афвахикум ма лайса лакум бихии `илмун ватахсабуунахуу хаййинан вахуа `индаллахи `азиим","Вы распространяете ложь своими языками и говорите своими устами то, о чем у вас нет никакого знания, и полагаете, что этот поступок незначителен, хотя перед Аллахом это - великий грех.",["когда","вы подхватывали это","своими языками","и говорили","своими устами","то, о чём","нет","у вас","о нём","знания","и считали это","незначительным","а оно","у","Аллаха","великое"]],[24,16,["وَلَوۡلَآ","إِذۡ","سَمِعۡتُمُوهُ","قُلۡتُم","مَّا","يَكُونُ","لَنَآ","أَن","نَّتَكَلَّمَ","بِهَٰذَا","سُبۡحَٰنَكَ","هَٰذَا","بُهۡتَٰنٌ","عَظِيمٞ"],"валаула из сами`тумууху ḳултум ма йакууну лана ан натакаллама бихаза субханака хаза бухтанун `азиим","Почему, когда вы услышали это, вы не сказали: «Нам не подобает говорить такое. Пречист Ты! А это - великая клевета»?",["и почему не","когда","вы услышали это","вы сказали","не","подобает","нам","чтобы","мы говорили","об этом","пречист Ты","это","клевета","великая"]],[24,17,["يَعِظُكُمُ","ٱللَّهُ","أَن","تَعُودُواْ","لِمِثۡلِهِۦٓ","أَبَدًا","إِن","كُنتُم","مُّؤۡمِنِينَ"],"йа`изукумуллаху ан та`уудуу лимислихии абадан ин кунтум му'миниин","Аллах наставляет вас никогда не повторять подобного, если вы являетесь верующими.",["увещевает вас","Аллах","чтобы (не)","вы вернулись","к подобному этому","никогда","если","вы","верующие"]],[24,18,["وَيُبَيِّنُ","ٱللَّهُ","لَكُمُ","ٱلۡأٓيَٰتِۚ","وَٱللَّهُ","عَلِيمٌ","حَكِيمٌ"],"вайубаййинуллаху лакумул айати валлаху `алиимун хакиим","Аллах разъясняет вам знамения. Аллах - Знающий, Мудрый.",["и разъясняет","Аллах","вам","знамения","и Аллах","Знающий","Мудрый"]],[24,19,["إِنَّ","ٱلَّذِينَ","يُحِبُّونَ","أَن","تَشِيعَ","ٱلۡفَٰحِشَةُ","فِي","ٱلَّذِينَ","ءَامَنُواْ","لَهُمۡ","عَذَابٌ","أَلِيمٞ","فِي","ٱلدُّنۡيَا","وَٱلۡأٓخِرَةِۚ","وَٱللَّهُ","يَعۡلَمُ","وَأَنتُمۡ","لَا","تَعۡلَمُونَ"],"иннал лазиина йухиббууна ан ташии`ал фахишату фил лазиина амануу лахум `азабун алиимун фид дунйа вал'ахирати валлаху йа`ламу ва'антум ла та`ламуун","Воистину, тем, которые любят, чтобы о верующих распространялась мерзость, уготованы мучительные страдания в этом мире и в Последней жизни. Аллах знает, а вы не знаете.",["поистине","те, которые","любят","чтобы","распространялась","мерзость","среди","тех, которые","уверовали","им","наказание","мучительное","в","этом мире","и Последней жизни","и Аллах","знает","а вы","не","знаете"]],[24,20,["وَلَوۡلَا","فَضۡلُ","ٱللَّهِ","عَلَيۡكُمۡ","وَرَحۡمَتُهُۥ","وَأَنَّ","ٱللَّهَ","رَءُوفٞ","رَّحِيمٞ"],"валаула фадлуллахи `алайкум варахматухуу ва'анналлаха ра'ууфур рахиим","Если бы не милосердие и милость Аллаха к вам и если бы Аллах не был Сострадательным и Милосердным, то грешников постигло бы скорое наказание.",["и если бы не","милость","Аллаха","к вам","и Его милосердие","и то, что","Аллах","Сострадательный","Милосердный"]]],"m":[[["إِنَّ","поистине",24,11],["ٱلَّذِينَ","те, которые",24,11],["جَآءُو","пришли",24,11],["بِٱلۡإِفۡكِ