{"p":352,"j":18,"a":[[24,21,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُواْ","لَا","تَتَّبِعُواْ","خُطُوَٰتِ","ٱلشَّيۡطَٰنِۚ","وَمَن","يَتَّبِعۡ","خُطُوَٰتِ","ٱلشَّيۡطَٰنِ","فَإِنَّهُۥ","يَأۡمُرُ","بِٱلۡفَحۡشَآءِ","وَٱلۡمُنكَرِۚ","وَلَوۡلَا","فَضۡلُ","ٱللَّهِ","عَلَيۡكُمۡ","وَرَحۡمَتُهُۥ","مَا","زَكَىٰ","مِنكُم","مِّنۡ","أَحَدٍ","أَبَدٗا","وَلَٰكِنَّ","ٱللَّهَ","يُزَكِّي","مَن","يَشَآءُۗ","وَٱللَّهُ","سَمِيعٌ","عَلِيمٞ"],"йа'аййухал лазиина амануу ла таттаби`уу хутуатиш шайтани ваман йаттаби` хутуатиш шайтани фа'иннахуу йа'муру билфахшаи валмункари валаула фадлуллахи `алайкум варахматухуу ма зака минкум мин ахадин абадан валакинналлаха йузаккии ман йашау валлаху самии`ун `алиим","О те, которые уверовали! Не следуйте по стопам дьявола. А если кто следует по стопам дьявола, то ведь он призывает к мерзости и предосудительному. И если бы не милосердие и милость Аллаха к вам, то никто из вас никогда не очистился бы. Однако Аллах очищает того, кого пожелает. Аллах - Слышащий, Знающий.",["о","те, которые","уверовали","не","следуйте","стопам","дьявола","а кто","следует","стопам","дьявола","то поистине, он","велит","мерзость","и предосудительное","и если бы не","милость","Аллаха","к вам","и Его милосердие","не","очистился бы","из вас","ни","один","никогда","но","Аллах","очищает","кого","Он пожелает","и Аллах","Слышащий","Знающий"]],[24,22,["وَلَا","يَأۡتَلِ","أُوْلُواْ","ٱلۡفَضۡلِ","مِنكُمۡ","وَٱلسَّعَةِ","أَن","يُؤۡتُوٓاْ","أُوْلِي","ٱلۡقُرۡبَىٰ","وَٱلۡمَسَٰكِينَ","وَٱلۡمُهَٰجِرِينَ","فِي","سَبِيلِ","ٱللَّهِۖ","وَلۡيَعۡفُواْ","وَلۡيَصۡفَحُوٓاْۗ","أَلَا","تُحِبُّونَ","أَن","يَغۡفِرَ","ٱللَّهُ","لَكُمۡۚ","وَٱللَّهُ","غَفُورٞ","رَّحِيمٌ"],"вала йа'тали улул фадли минкум васса`ати ан йу'туу улил ḳурба валмасакиина валмухажириина фии сабиилиллахи валйа`фуу валйасфахуу ала тухиббууна ан йагфираллаху лакум валлаху гафуурур рахиим","Пусть обладающие достоинствами и достатком среди вас не клянутся, что не будут помогать родственникам, беднякам и переселенцам на пути Аллаха. Пусть они простят и будут великодушны. Разве вы не желаете, чтобы Аллах простил вас? Аллах - Прощающий, Милосердный.",["и пусть не","клянутся","обладатели","достоинства","из вас","и достатка","что (не)","они дадут","обладателям","родства","и беднякам","и переселенцам","на","пути","Аллаха","и пусть простят","и пусть будут снисходительны","разве не","вы любите","чтобы","простил","Аллах","вам","и Аллах","Прощающий","Милосердный"]],[24,23,["إِنَّ","ٱلَّذِينَ","يَرۡمُونَ","ٱلۡمُحۡصَنَٰتِ","ٱلۡغَٰفِلَٰتِ","ٱلۡمُؤۡمِنَٰتِ","لُعِنُواْ","فِي","ٱلدُّنۡيَا","وَٱلۡأٓخِرَةِ","وَلَهُمۡ","عَذَابٌ","عَظِيمٞ"],"иннал лазиина йармуунал мухсанатил гафилатил му'минати лу`инуу фид дунйа вал'ахирати валахум `азабун `азиим","Воистину, те, которые обвиняют целомудренных верующих женщин, даже не помышляющих о грехе, будут прокляты в этом мире и в Последней жизни! Им уготованы великие мучения",["поистине","те, которые","обвиняют","целомудренных","неведающих (греха)","верующих","прокляты","в","этом мире","и Последней жизни","и им","наказание","великое"]],[24,24,["يَوۡمَ","تَشۡهَدُ","عَلَيۡهِمۡ","أَلۡسِنَتُهُمۡ","وَأَيۡدِيهِمۡ","وَأَرۡجُلُهُم","بِمَا","كَانُواْ","يَعۡمَلُونَ"],"йаума ташхаду `алайхим алсинатухум ва'айдиихим ва'аржулухум бима кануу йа`малуун","в тот день, когда их языки, руки и ноги будут свидетельствовать против них о том, что они совершили.",["в день","засвидетельствуют","против них","их языки","и их руки","и их ноги","о том, что","они были","делают"]],[24,25,["يَوۡمَئِذٖ","يُوَفِّيهِمُ","ٱللَّهُ","دِينَهُمُ","ٱلۡحَقَّ","وَيَعۡلَمُونَ","أَنَّ","ٱللَّهَ","هُوَ","ٱلۡحَقُّ","ٱلۡمُبِينُ"],"йаумаизин йуаффиихимуллаху диинахумул хаḳḳа вайа`ламууна анналлаха хуал хаḳḳул мубиин","В тот день Аллах воздаст им в полной мере по их истинному счету, и они узнают, что Аллах есть Явная Истина.",["в тот день","воздаст им сполна","Аллах","их воздаяние","истинное","и они узнают","что","Аллах","Он","Истина","Явная"]],[24,26,["ٱلۡخَبِيثَٰتُ","لِلۡخَبِيثِينَ","وَٱلۡخَبِيثُونَ","لِلۡخَبِيثَٰتِۖ","وَٱلطَّيِّبَٰتُ","لِلطَّيِّبِينَ","وَٱلطَّيِّبُونَ","لِلطَّيِّبَٰتِۚ","أُوْلَٰٓئِكَ","مُبَرَّءُونَ","مِمَّا","يَقُولُونَۖ","لَهُم","مَّغۡفِرَةٞ","وَرِزۡقٞ","كَرِيمٞ"],"алхабиисату лилхабиисиина валхабиисууна лилхабиисати ваттаййибату литтаййибиина ваттаййибууна литтаййибати улаика мубарраууна мимма йаḳуулууна лахум магфиратун варизḳун кариим","Скверные женщины - для скверных мужчин, а скверные мужчины - для скверных женщин, и хорошие женщины - для хороших мужчин, а хорошие мужчины - для хороших женщин. Они непричастны к тому, что говорят клеветники. Им уготовано прощение и щедрый удел.",["скверные (женщины)","для скверных (мужчин)","и скверные (мужчины)","для скверных (женщин)","и благие (женщины)","для благих (мужчин)","и благие (мужчины)","для благих (женщин)","те","непричастны","к тому, что","они говорят","им","прощение","и удел","щедрый"]],[24,27,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُواْ","لَا","تَدۡخُلُواْ","بُيُوتًا","غَيۡرَ","بُيُوتِكُمۡ","حَتَّىٰ","تَسۡتَأۡنِسُواْ","وَتُسَلِّمُواْ","عَلَىٰٓ","أَهۡلِهَاۚ","ذَٰلِكُمۡ","خَيۡرٞ","لَّكُمۡ","لَعَلَّكُمۡ","تَذَكَّرُونَ"],"йа'аййухал лазиина амануу ла тадхулуу буйуутан гайра буйуутикум хатта таста'нисуу ватусаллимуу `ала ахлиха заликум хайрул лакум ла`аллакум тазаккаруун","О те, которые уверовали! Не входите в чужие дома, пока не спросите позволения и не поприветствуете миром их обитателей. Это лучше для вас. Быть может, вы помяните назидание.",["о","те, которые","уверовали","не","входите","в дома","кроме","ваших домов","пока (не)","вы спросите позволения","и поприветствуете","к","их обитателей","это","лучше","для вас","быть может, вы","помянете назидание"]]],"m":[[["۞ يَٰٓأَيُّهَا","о",24,21],["ٱلَّذِينَ","те, которые",24,21],["ءَامَنُواْ","уверовали",24,21],["لَا","не",24,21],["تَتَّبِعُواْ","следуйте",24,21],["خُطُوَٰتِ","стопам",24,21],["ٱلشَّيۡطَٰنِۚ","дьявола",24,21],["وَمَن","а кто",24,21],["يَتَّبِعۡ","следует",24,21]],[["خُطُوَٰتِ","стопам",24,21],["ٱلشَّيۡطَٰنِ","дьявола",24,21],["فَإِنَّهُۥ","то поистине, он",24,21],["يَأ