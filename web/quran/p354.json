{"p":354,"j":18,"a":[[24,32,["وَأَنكِحُواْ","ٱلۡأَيَٰمَىٰ","مِنكُمۡ","وَٱلصَّٰلِحِينَ","مِنۡ","عِبَادِكُمۡ","وَإِمَآئِكُمۡۚ","إِن","يَكُونُواْ","فُقَرَآءَ","يُغۡنِهِمُ","ٱللَّهُ","مِن","فَضۡلِهِۦۗ","وَٱللَّهُ","وَٰسِعٌ","عَلِيمٞ"],"ва'анкихул айама минкум вассалихиина мин `ибадикум ва'имаикум ин йакуунуу фуḳараа йугнихимуллаху мин фадлихии валлаху васи`ун `алиим","Сочетайте браком тех из вас, кто холост, и праведников из числа ваших рабов и рабынь. Если они бедны, то Аллах обогатит их из Своей милости. Аллах - Объемлющий, Знающий.",["и сочетайте браком","одиноких","из вас","и праведных","из","рабов ваших","и рабынь ваших","если","будут они","бедными","обогатит их","Аллах","из","милости Своей","и Аллах","Объемлющий","Знающий"]],[24,33,["وَلۡيَسۡتَعۡفِفِ","ٱلَّذِينَ","لَا","يَجِدُونَ","نِكَاحًا","حَتَّىٰ","يُغۡنِيَهُمُ","ٱللَّهُ","مِن","فَضۡلِهِۦۗ","وَٱلَّذِينَ","يَبۡتَغُونَ","ٱلۡكِتَٰبَ","مِمَّا","مَلَكَتۡ","أَيۡمَٰنُكُمۡ","فَكَاتِبُوهُمۡ","إِنۡ","عَلِمۡتُمۡ","فِيهِمۡ","خَيۡرٗاۖ","وَءَاتُوهُم","مِّن","مَّالِ","ٱللَّهِ","ٱلَّذِيٓ","ءَاتَىٰكُمۡۚ","وَلَا","تُكۡرِهُواْ","فَتَيَٰتِكُمۡ","عَلَى","ٱلۡبِغَآءِ","إِنۡ","أَرَدۡنَ","تَحَصُّنٗا","لِّتَبۡتَغُواْ","عَرَضَ","ٱلۡحَيَوٰةِ","ٱلدُّنۡيَاۚ","وَمَن","يُكۡرِههُّنَّ","فَإِنَّ","ٱللَّهَ","مِنۢ","بَعۡدِ","إِكۡرَٰهِهِنَّ","غَفُورٞ","رَّحِيمٞ"],"валйаста`фифил лазиина ла йажидууна никахан хатта йугнийахумуллаху мин фадлихии валлазиина йабтагуунал китаба мимма малакат айманукум факатибуухум ин `алимтум фиихим хайран ва'атуухум мим малиллахил лазии атакум вала тукрихуу фатайатикум `алал бигаи ин арадна тахассунал литабтагуу `арадал хайаватид дунйа ваман йукриххунна фа'инналлаха мим ба`ди икрахихинна гафуурур рахиим","Пусть соблюдают целомудрие те, которые не находят возможности вступить в брак, пока Аллах не обогатит их из Своей милости. Если невольники, которыми овладели ваши десницы, хотят получить письмо о сумме выкупа, то дайте им такое письмо, если вы нашли в них добрые качества, и одарите их из имущества Аллаха, которое Он даровал вам. Не принуждайте своих невольниц к блуду ради обретения тленных благ мирской жизни, если они желают блюсти целомудрие. Если же кто-либо принудит их к этому, то Аллах после принуждения их будет Прощающим, Милосердным.",["и пусть хранят целомудрие","те, которые","не","находят","(возможности) брака","пока (не)","обогатит их","Аллах","из","милости Своей","а те, которые","желают","письма (о выкупе)","из тех, которыми","овладели","десницы ваши","то заключайте договор с ними","если","узнали вы","в них","добро","и давайте им","из","имущества","Аллаха","которое","Он дал вам","и не","принуждайте","невольниц ваших","к","блуду","если","пожелали они","целомудрия","чтобы искали вы","преходящих благ","жизни","мирской","а кто","принудит их","то поистине","Аллах","(уже)","после","принуждения их","Прощающий","Милосердный"]],[24,34,["وَلَقَدۡ","أَنزَلۡنَآ","إِلَيۡكُمۡ","ءَايَٰتٖ","مُّبَيِّنَٰتٖ","وَمَثَلٗا","مِّنَ","ٱلَّذِينَ","خَلَوۡاْ","مِن","قَبۡلِكُمۡ","وَمَوۡعِظَةٗ","لِّلۡمُتَّقِينَ"],"валаḳад анзална илайкум айатим мубаййинатин вамасалам минал лазиина халау мин ḳабликум вамау`изатал лилмуттаḳиин","Мы уже ниспослали вам ясные знамения, и притчу о тех, которые миновали до вас, и увещевание для богобоязненных.",["и уже","Мы ниспослали","вам","знамения","ясные","и пример","из","тех, которые","прошли","(ещё)","до вас","и увещевание","для богобоязненных"]],[24,35,["ٱللَّهُ","نُورُ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِۚ","مَثَلُ","نُورِهِۦ","كَمِشۡكَوٰةٖ","فِيهَا","مِصۡبَاحٌۖ","ٱلۡمِصۡبَاحُ","فِي","زُجَاجَةٍۖ","ٱلزُّجَاجَةُ","كَأَنَّهَا","كَوۡكَبٞ","دُرِّيّٞ","يُوقَدُ","مِن","شَجَرَةٖ","مُّبَٰرَكَةٖ","زَيۡتُونَةٖ","لَّا","شَرۡقِيَّةٖ","وَلَا","غَرۡبِيَّةٖ","يَكَادُ","زَيۡتُهَا","يُضِيٓءُ","وَلَوۡ","لَمۡ","تَمۡسَسۡهُ","نَارٞۚ","نُّورٌ","عَلَىٰ","نُورٖۚ","يَهۡدِي","ٱللَّهُ","لِنُورِهِۦ","مَن","يَشَآءُۚ","وَيَضۡرِبُ","ٱللَّهُ","ٱلۡأَمۡثَٰلَ","لِلنَّاسِۗ","وَٱللَّهُ","بِكُلِّ","شَيۡءٍ","عَلِيمٞ"],"аллаху нуурус самавати вал'арди масалу нуурихии камишкаватин фииха мисбахунил мисбаху фии зужажатиниз зужажату ка'аннаха каукабун дурриййун йууḳаду мин шажаратим мубаракатин зайтуунатил ла шарḳиййатин вала гарбиййатин йакаду зайтуха йудииу валау лам тамсасху нарун нуурун `ала нуурин йахдиллаху линуурихии ман йашау вайадрибуллахул амсала линнаси валлаху бикулли шай'ин `алиим","Аллах - Свет небес и земли. Его свет в душе верующего подобен нише, в которой находится светильник. Светильник заключен в стекло, а стекло подобно жемчужной звезде. Он возжигается от благословенного оливкового дерева, которое не освещается солнцем только с востока или только с запада. Его масло готово светиться даже без соприкосновения с огнем. Один свет поверх другого! Аллах направляет к Своему свету, кого пожелает. Аллах приводит людям притчи, и Аллах знает о всякой вещи.",["Аллах","Свет","небес","и земли","пример","света Его","как ниша","в ней","светильник","светильник","в","стекле","стекло","словно оно","звезда","сверкающая (как жемчуг)","возжигается","от","дерева","благословенного","оливкового","не","восточного","и не","западного","почти","масло его","светится","и даже если","не","коснулся его","огонь","свет","поверх","света","ведёт","Аллах","к свету Своему","кого","пожелает","и приводит","Аллах","притчи","для людей","и Аллах","о всякой","вещи","Знающий"]],[24,36,["فِي","بُيُوتٍ","أَذِنَ","ٱللَّهُ","أَن","تُرۡفَعَ","وَيُذۡكَرَ","فِيهَا","ٱسۡمُهُۥ","يُسَبِّحُ","لَهُۥ","فِيهَا","بِٱلۡغُدُوِّ","وَٱلۡأٓصَالِ"],"фии буйуутин азиналлаху ан турфа`а вайузкара фиихасмухуу йусаббиху лахуу фииха билгудувви вал'асал","В домах, которые Аллах дозволил воздвигнуть, поминается Его имя. Его славят в них по утрам и перед закатом",["в","домах","позволил","Аллах","чтобы","были возвышены они","и поминалось","в них","имя Его","славят","Его","в них","по утрам","и вечерам"]]],"m":[[["وَأَنكِحُواْ","и сочетайте браком",24,32],["ٱلۡأَيَٰمَىٰ","одиноких",24,32],["مِنكُمۡ","из вас",24,32],["وَٱلصَّٰلِحِينَ","и праведных",24,32],["مِنۡ","из",24,32],["عِبَادِكُمۡ","рабов ваших",24,32],["وَإِمَآئِكُمۡۚ"