{"p":355,"j":18,"a":[[24,37,["رِجَالٞ","لَّا","تُلۡهِيهِمۡ","تِجَٰرَةٞ","وَلَا","بَيۡعٌ","عَن","ذِكۡرِ","ٱللَّهِ","وَإِقَامِ","ٱلصَّلَوٰةِ","وَإِيتَآءِ","ٱلزَّكَوٰةِ","يَخَافُونَ","يَوۡمٗا","تَتَقَلَّبُ","فِيهِ","ٱلۡقُلُوبُ","وَٱلۡأَبۡصَٰرُ"],"рижалул ла тулхиихим тижаратун вала бай`ун `ан зикриллахи ва'иḳамис салавати ва'иитаиз закавати йахафууна йауман татаḳаллабу фиихил ḳулуубу вал'абсар","мужи, которых ни торговля, ни купля-продажа не отвлекают от поминания Аллаха, совершения намаза и выплаты закята. Они боятся дня, когда перевернутся сердца и взоры,",["мужи","не","отвлекает их","торговля","и не","купля-продажа","от","поминания","Аллаха","и совершения","намаза","и выплаты","закята","боятся они","дня","перевернутся","в нём","сердца","и взоры"]],[24,38,["لِيَجۡزِيَهُمُ","ٱللَّهُ","أَحۡسَنَ","مَا","عَمِلُواْ","وَيَزِيدَهُم","مِّن","فَضۡلِهِۦۗ","وَٱللَّهُ","يَرۡزُقُ","مَن","يَشَآءُ","بِغَيۡرِ","حِسَابٖ"],"лийажзийахумуллаху ахсана ма `амилуу вайазиидахум мин фадлихии валлаху йарзуḳу ман йашау бигайри хисаб","чтобы Аллах воздал им за наилучшее из того, что они совершили (или лучшим, чем то, что они совершили; или наилучшим образом за то, что они совершили), и приумножил это по Своей милости. Аллах наделяет, кого пожелает, без счета.",["чтобы воздал им","Аллах","лучшим","(из) того, что","совершили они","и прибавил им","из","милости Своей","и Аллах","наделяет","кого","пожелает","без","счёта"]],[24,39,["وَٱلَّذِينَ","كَفَرُوٓاْ","أَعۡمَٰلُهُمۡ","كَسَرَابِۭ","بِقِيعَةٖ","يَحۡسَبُهُ","ٱلظَّمۡـَٔانُ","مَآءً","حَتَّىٰٓ","إِذَا","جَآءَهُۥ","لَمۡ","يَجِدۡهُ","شَيۡـٔٗا","وَوَجَدَ","ٱللَّهَ","عِندَهُۥ","فَوَفَّىٰهُ","حِسَابَهُۥۗ","وَٱللَّهُ","سَرِيعُ","ٱلۡحِسَابِ"],"валлазиина кафаруу а`малухум касараби биḳии`атин йахсабухуз зам'ану маан хатта иза жаахуу лам йажидху шай'ан ваважадаллаха `индахуу фаваффаху хисабахуу валлаху сарии`ул хисаб","А деяния неверующих подобны мареву в пустыне, которое жаждущий принимает за воду. Когда он подходит к нему, то ничего не находит. Он находит вблизи себя Аллаха, который воздает ему сполна по его счету. Аллах скор в расчете.",["а те, которые","не уверовали","деяния их","как мираж","в пустыне","принимает его","жаждущий","(за) воду","пока","когда","подойдёт к нему","не","найдёт его","чем-либо","и найдёт","Аллаха","у себя","и Он воздаст ему сполна","счёт его","и Аллах","скор","(в) расчёте"]],[24,40,["أَوۡ","كَظُلُمَٰتٖ","فِي","بَحۡرٖ","لُّجِّيّٖ","يَغۡشَىٰهُ","مَوۡجٞ","مِّن","فَوۡقِهِۦ","مَوۡجٞ","مِّن","فَوۡقِهِۦ","سَحَابٞۚ","ظُلُمَٰتُۢ","بَعۡضُهَا","فَوۡقَ","بَعۡضٍ","إِذَآ","أَخۡرَجَ","يَدَهُۥ","لَمۡ","يَكَدۡ","يَرَىٰهَاۗ","وَمَن","لَّمۡ","يَجۡعَلِ","ٱللَّهُ","لَهُۥ","نُورٗا","فَمَا","لَهُۥ","مِن","نُّورٍ"],"ау казулуматин фии бахрил лужжиййин йагшаху маужум мин фауḳихии маужум мин фауḳихии сахабун зулумату ба`духа фауḳа ба`дин иза ахража йадахуу лам йакад йараха вамал лам йаж`алиллаху лахуу нууран фама лахуу мин нуур","Или же они подобны мраку в глубине морской пучины. Его покрывает волна, над которой находится другая волна, над которой находится облако. Один мрак поверх другого! Если он вытянет свою руку, то не увидит ее. Кому Аллах не даровал света, тому не будет света.",["или","как мраки","в","море","глубоком","покрывает его","волна","(сверху)","над ней","волна","(сверху)","над ней","облако","мраки","одни из них","над","другими","когда","вытянет он","руку свою","едва ли","сможет","увидеть её","и кому","не","дал","Аллах","ему","свет","то нет","у него","никакого","света"]],[24,41,["أَلَمۡ","تَرَ","أَنَّ","ٱللَّهَ","يُسَبِّحُ","لَهُۥ","مَن","فِي","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِ","وَٱلطَّيۡرُ","صَٰٓفَّٰتٖۖ","كُلّٞ","قَدۡ","عَلِمَ","صَلَاتَهُۥ","وَتَسۡبِيحَهُۥۗ","وَٱللَّهُ","عَلِيمُۢ","بِمَا","يَفۡعَلُونَ"],"алам тара анналлаха йусаббиху лахуу ман фис самавати вал'арди ваттайру саффатин куллун ḳад `алима салатахуу ватасбиихахуу валлаху `алииму бима йаф`алуун","Разве ты не видел, что Аллаха славят те, кто на небесах и на земле, а также птицы с распростертыми крыльями? Каждый знает свою молитву и свое славословие. Аллах знает о том, что они совершают.",["разве не","видел ты","что","Аллаха","славят","Его","те, кто","на","небесах","и земле","и птицы","распростёрши крылья","каждый","уже","знает","молитву свою","и славословие своё","и Аллах","Знающий","о том, что","делают они"]],[24,42,["وَلِلَّهِ","مُلۡكُ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِۖ","وَإِلَى","ٱللَّهِ","ٱلۡمَصِيرُ"],"валиллахи мулкус самавати вал'арди ва'илаллахил масиир","Аллаху принадлежит власть над небесами и землей, и к Аллаху предстоит прибытие.",["и Аллаху (принадлежит)","власть","небес","и земли","и к","Аллаху","прибытие"]],[24,43,["أَلَمۡ","تَرَ","أَنَّ","ٱللَّهَ","يُزۡجِي","سَحَابٗا","ثُمَّ","يُؤَلِّفُ","بَيۡنَهُۥ","ثُمَّ","يَجۡعَلُهُۥ","رُكَامٗا","فَتَرَى","ٱلۡوَدۡقَ","يَخۡرُجُ","مِنۡ","خِلَٰلِهِۦ","وَيُنَزِّلُ","مِنَ","ٱلسَّمَآءِ","مِن","جِبَالٖ","فِيهَا","مِنۢ","بَرَدٖ","فَيُصِيبُ","بِهِۦ","مَن","يَشَآءُ","وَيَصۡرِفُهُۥ","عَن","مَّن","يَشَآءُۖ","يَكَادُ","سَنَا","بَرۡقِهِۦ","يَذۡهَبُ","بِٱلۡأَبۡصَٰرِ"],"алам тара анналлаха йузжии сахабан сумма йу'аллифу байнахуу сумма йаж`алухуу рукаман фатарал вадḳа йахружу мин хилалихии вайуназзилу минас самаи мин жибалин фииха мим барадин файусиибу бихии ман йашау вайасрифухуу `ам ман йашау йакаду сана барḳихии йазхабу бил'абсар","Разве ты не видишь, что Аллах гонит облака, потом соединяет их, потом превращает их в кучу облаков, и ты видишь, как из расщелин ее изливается ливень. Он низвергает град с гор, которые на небе. Он поражает им, кого пожелает, и отвращает его, от кого пожелает. Блеск их молний готов унести зрение.",["разве не","видел ты","что","Аллах","гонит","облака","затем","соединяет","между ними","затем","делает их","грудой","и видишь ты","ливень","выходит","из","промежутков его","и низводит Он","с","неба","из","гор","на нём","из","града","и поражает Он","им","кого","пожелает","и отвращает его","от","кого","пожелает","почти","блеск","молнии его","уносит","взоры"]]],"m":[[["رِجَالٞ","мужи",24,37],["لَّا","не",24,37],["تُلۡهِيهِمۡ","отвлекает их",24,37],[