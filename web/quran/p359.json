{"p":359,"j":18,"a":[[24,62,["إِنَّمَا","ٱلۡمُؤۡمِنُونَ","ٱلَّذِينَ","ءَامَنُواْ","بِٱللَّهِ","وَرَسُولِهِۦ","وَإِذَا","كَانُواْ","مَعَهُۥ","عَلَىٰٓ","أَمۡرٖ","جَامِعٖ","لَّمۡ","يَذۡهَبُواْ","حَتَّىٰ","يَسۡتَـٔۡذِنُوهُۚ","إِنَّ","ٱلَّذِينَ","يَسۡتَـٔۡذِنُونَكَ","أُوْلَٰٓئِكَ","ٱلَّذِينَ","يُؤۡمِنُونَ","بِٱللَّهِ","وَرَسُولِهِۦۚ","فَإِذَا","ٱسۡتَـٔۡذَنُوكَ","لِبَعۡضِ","شَأۡنِهِمۡ","فَأۡذَن","لِّمَن","شِئۡتَ","مِنۡهُمۡ","وَٱسۡتَغۡفِرۡ","لَهُمُ","ٱللَّهَۚ","إِنَّ","ٱللَّهَ","غَفُورٞ","رَّحِيمٞ"],"иннамал му'минуунал лазиина амануу биллахи варасуулихии ва'иза кануу ма`ахуу `ала амрин жами`ил лам йазхабуу хатта йаста'зинууху иннал лазиина йаста'зинуунака улаикал лазиина йу'минууна биллахи варасуулихии фа'изаста'зануука либа`ди ша'нихим фа'зал лиман ши'та минхум вастагфир лахумуллаха инналлаха гафуурур рахиим","Верующими являются только те, которые уверовали в Аллаха и Его Посланника. Когда они находятся рядом с ним по общему делу, то не уходят, пока не попросят у него разрешения. Воистину, те, которые просят у тебя разрешения, действительно являются верующими в Аллаха и Его Посланника. Если они попросят у тебя разрешения по поводу некоторых из своих дел, то разрешай тому из них, кому пожелаешь, и проси Аллаха простить их. Воистину, Аллах - Прощающий, Милосердный.",["лишь","верующие","(это) те, которые","уверовали","в Аллаха","и Посланника Его","и когда","бывают они","с ним","по","делу","общему","не","уходят они","пока (не)","попросят у него разрешения","поистине","те, которые","просят у тебя разрешения","те","(это) те, которые","веруют","в Аллаха","и Посланника Его","и когда","попросят у тебя разрешения","для некоторых","дел их","то разрешай","тому, кому","пожелаешь ты","из них","и проси прощения","для них","(у) Аллаха","поистине","Аллах","Прощающий","Милосердный"]],[24,63,["لَّا","تَجۡعَلُواْ","دُعَآءَ","ٱلرَّسُولِ","بَيۡنَكُمۡ","كَدُعَآءِ","بَعۡضِكُم","بَعۡضٗاۚ","قَدۡ","يَعۡلَمُ","ٱللَّهُ","ٱلَّذِينَ","يَتَسَلَّلُونَ","مِنكُمۡ","لِوَاذٗاۚ","فَلۡيَحۡذَرِ","ٱلَّذِينَ","يُخَالِفُونَ","عَنۡ","أَمۡرِهِۦٓ","أَن","تُصِيبَهُمۡ","فِتۡنَةٌ","أَوۡ","يُصِيبَهُمۡ","عَذَابٌ","أَلِيمٌ"],"лла таж`алуу ду`аар расуули байнакум каду`аи ба`дикум ба`дан ḳад йа`ламуллахул лазиина йатасаллалууна минкум ливазан фалйахзарил лазиина йухалифууна `ан амрихии ан тусиибахум фитнатун ау йусиибахум `азабун алиим","Не равняйте обращение к Посланнику среди вас с тем, как вы обращаетесь друг к другу. Аллах знает тех из вас, которые уходят украдкой под прикрытием. Пусть же остерегаются те, которые противятся его воле, как бы их не постигло искушение или не постигли их мучительные страдания.",["не","делайте","призыв","Посланника","между вами","как призыв","одних из вас","(к) другим","уже","знает","Аллах","тех, которые","ускользают","из вас","прикрываясь (другими)","и пусть остерегаются","те, которые","противятся","(от)","приказу его","как бы (не)","постигло их","искушение","или","постигло их","наказание","мучительное"]],[24,64,["أَلَآ","إِنَّ","لِلَّهِ","مَا","فِي","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِۖ","قَدۡ","يَعۡلَمُ","مَآ","أَنتُمۡ","عَلَيۡهِ","وَيَوۡمَ","يُرۡجَعُونَ","إِلَيۡهِ","فَيُنَبِّئُهُم","بِمَا","عَمِلُواْۗ","وَٱللَّهُ","بِكُلِّ","شَيۡءٍ","عَلِيمُۢ"],"ала инна лиллахи ма фис самавати вал'арди ḳад йа`ламу ма антум `алайхи вайаума йуржа`ууна илайхи файунаббиухум бима `амилуу валлаху бикулли шай'ин `алиим","Воистину, Аллаху принадлежит то, что на небесах и на земле. Он знает ваше положение и тот день, когда они будут возвращены к Нему. Он поведает им о том, что они совершили. Аллаху известно о всякой вещи.",["знайте же","поистине","Аллаху (принадлежит)","то, что","на","небесах","и земле","уже","знает Он","то, в чём","вы","(пребываете)","и день","будут возвращены они","к Нему","и сообщит Он им","о том, что","совершили они","и Аллах","о всякой","вещи","Знающий"]],[25,1,["تَبَارَكَ","ٱلَّذِي","نَزَّلَ","ٱلۡفُرۡقَانَ","عَلَىٰ","عَبۡدِهِۦ","لِيَكُونَ","لِلۡعَٰلَمِينَ","نَذِيرًا"],"табаракал лазии наззалал фурḳана `ала `абдихии лийакууна лил`аламиина назиира","Благословен Тот, Кто ниспослал Своему рабу Различение (Коран), чтобы он предостерег миры.",["благословен","Тот, Кто","ниспослал","Различение","на","раба Своего","чтобы был он","для миров","увещевателем"]],[25,2,["ٱلَّذِي","لَهُۥ","مُلۡكُ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِ","وَلَمۡ","يَتَّخِذۡ","وَلَدٗا","وَلَمۡ","يَكُن","لَّهُۥ","شَرِيكٞ","فِي","ٱلۡمُلۡكِ","وَخَلَقَ","كُلَّ","شَيۡءٖ","فَقَدَّرَهُۥ","تَقۡدِيرٗا"],"аллазии лахуу мулкус самавати вал'арди валам йаттахиз валадан валам йакул лахуу шариикун фил мулки вахалаḳа кулла шай'ин фаḳаддарахуу таḳдиира","Ему принадлежит власть над небесами и землей. Он не взял Себе сына и ни с кем не делил власть. Он сотворил всякую вещь и придал ей соразмерную меру (или предопределил ее).",["Тот, Кто","Ему (принадлежит)","власть","небес","и земли","и не","взял Он","сына","и не","было","у Него","сотоварища","во","власти","и Он сотворил","всякую","вещь","и соразмерил её","мерой"]]],"m":[[["إِنَّمَا","лишь",24,62],["ٱلۡمُؤۡمِنُونَ","верующие",24,62],["ٱلَّذِينَ","(это) те, которые",24,62],["ءَامَنُواْ","уверовали",24,62],["بِٱللَّهِ","в Аллаха",24,62],["وَرَسُولِهِۦ","и Посланника Его",24,62],["وَإِذَا","и когда",24,62],["كَانُواْ","бывают они",24,62],["مَعَهُۥ","с ним",24,62]],[["عَلَىٰٓ","по",24,62],["أَمۡرٖ","делу",24,62],["جَامِعٖ","общему",24,62],["لَّمۡ","не",24,62],["يَذۡهَبُواْ","уходят они",24,62],["حَتَّىٰ","пока (не)",24,62],["يَسۡتَـٔۡذِنُوهُۚ","попросят у него разрешения",24,62],["إِنَّ","поистине",24,62],["ٱلَّذِينَ","те, которые",24,62],["يَسۡتَـٔۡذِنُونَكَ","просят у тебя разрешения",24,62]],[["أُوْلَٰٓئِكَ","те",24,62],["ٱلَّذِينَ","(это) те, которые",24,62],["يُؤۡمِنُونَ","веруют",24,62],["بِٱللَّهِ","в Аллаха",24,62],["وَرَسُولِهِۦۚ","и Посланника Его",24,62],["فَإِذَا","и когда",24,62],["ٱسۡتَـٔۡذَنُوكَ","попросят у тебя разрешения",24,62]],[["لِبَعۡضِ","для некоторых",24,62],["شَأۡنِهِمۡ","дел их",24,62],["فَأۡذَن","то разрешай",24,62],["لِّمَن","тому, кому",24,62],["شِئۡتَ","пожелаешь ты",24,62],["مِنۡهُمۡ","из них",24,62],["وَٱسۡتَغۡفِرۡ","и проси прощения",24,62],["لَهُمُ","для них",24,62]],[["ٱللَّهَۚ","(у) Аллаха",24,62],["إِنَّ","поистине",24,62],["ٱللَّهَ","Аллах",24,62],["غَفُورٞ","Прощающий",24,62],["رَّحِيمٞ","Милосердный",24,62],[62],["لَّا","не",24,63],["تَجۡعَلُواْ","делайте",24,63],["دُعَآءَ","призыв",24,63],["ٱلرَّسُولِ","Посланника",24,63]],[["بَيۡنَكُمۡ","между вами",24,63],["كَدُعَآءِ","как призыв",24,63],["بَعۡضِكُم","одних из вас",24,63],["بَعۡضٗاۚ","(к) другим",24,63],["قَدۡ","уже",24,63],["يَعۡلَمُ","знает",24,63],["ٱللَّهُ","Аллах",24,63],["ٱلَّذِينَ","тех, которые",24,63]],[["يَتَسَلَّلُونَ","ускользают",24,63],["مِنكُمۡ","из вас",24,63],["لِوَاذٗاۚ","прикрываясь (другими)",24,63],["فَلۡيَحۡذَرِ","и пусть остерегаются",24,63],["ٱلَّذِينَ","те, которые",24,63],["يُخَالِفُونَ","противятся",24,63],["عَنۡ","(от)",24,63],["أَمۡرِهِۦٓ","приказу его",24,63]],[["أَن","как бы (не)",24,63],["تُصِيبَهُمۡ","постигло их",24,63],["فِتۡنَةٌ","искушение",24,63],["أَوۡ","или",24,63],["يُصِيبَهُمۡ","постигло их",24,63],["عَذَابٌ","наказание",24,63],["أَلِيمٌ","мучительное",24,63],[63],["أَلَآ","знайте же",24,64],["إِنَّ","поистине",24,64],["لِلَّهِ","Аллаху (принадлежит)",24,64]],[["مَا","то, что",24,64],["فِي","на",24,64],["ٱلسَّمَٰوَٰتِ","небесах",24,64],["وَٱلۡأَرۡضِۖ","и земле",24,64],["قَدۡ","уже",24,64],["يَعۡلَمُ","знает Он",24,64],["مَآ","то, в чём",24,64],["أَنتُمۡ","вы",24,64],["عَلَيۡهِ","(пребываете)",24,64],["وَيَوۡمَ","и день",24,64]],[["يُرۡجَعُونَ","будут возвращены они",24,64],["إِلَيۡهِ","к Нему",24,64],["فَيُنَبِّئُهُم","и сообщит Он им",24,64],["بِمَا","о том, что",24,64],["عَمِلُواْۗ","совершили они",24,64],["وَٱللَّهُ","и Аллах",24,64],["بِكُلِّ","о всякой",24,64],["شَيۡءٍ","вещи",24,64],["عَلِيمُۢ","Знающий",24,64],[64]],["h",25],["b"],[["تَبَارَكَ","благословен",25,1],["ٱلَّذِي","Тот, Кто",25,1],["نَزَّلَ","ниспослал",25,1],["ٱلۡفُرۡقَانَ","Различение",25,1],["عَلَىٰ","на",25,1],["عَبۡدِهِۦ","раба Своего",25,1],["لِيَكُونَ","чтобы был он",25,1],["لِلۡ