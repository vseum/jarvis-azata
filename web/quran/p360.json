{"p":360,"j":18,"a":[[25,3,["وَٱتَّخَذُواْ","مِن","دُونِهِۦٓ","ءَالِهَةٗ","لَّا","يَخۡلُقُونَ","شَيۡـٔٗا","وَهُمۡ","يُخۡلَقُونَ","وَلَا","يَمۡلِكُونَ","لِأَنفُسِهِمۡ","ضَرّٗا","وَلَا","نَفۡعٗا","وَلَا","يَمۡلِكُونَ","مَوۡتٗا","وَلَا","حَيَوٰةٗ","وَلَا","نُشُورٗا"],"ваттахазуу мин дуунихии алихатал ла йахлуḳууна шай'ан вахум йухлаḳууна вала йамликууна ли'анфусихим дарран вала наф`ан вала йамликууна маутан вала хайаватан вала нушуура","Они стали поклоняться вместо Него другим божествам, которые ничего не создают, хотя сами были сотворены. Они не властны принести вред или пользу даже самим себе и не распоряжаются ни смертью, ни жизнью, ни воскрешением.",["и взяли они","из","помимо Него","богов","не","создают они","ничего","а они (сами)","сотворены","и не","владеют они","для самих себя","вредом","и не","пользой","и не","владеют они","смертью","и не","жизнью","и не","воскрешением"]],[25,4,["وَقَالَ","ٱلَّذِينَ","كَفَرُوٓاْ","إِنۡ","هَٰذَآ","إِلَّآ","إِفۡكٌ","ٱفۡتَرَىٰهُ","وَأَعَانَهُۥ","عَلَيۡهِ","قَوۡمٌ","ءَاخَرُونَۖ","فَقَدۡ","جَآءُو","ظُلۡمٗا","وَزُورٗا"],"ваḳалал лазиина кафаруу ин хаза илла ифкунифтараху ва'а`анахуу `алайхи ḳаумун ахарууна фаḳад жауу зулман вазуура","Неверующие говорят: «Это - всего лишь ложь, которую он выдумал с помощью других людей». Воистину, они поступают несправедливо и лгут.",["и сказали","те, которые","не уверовали","не","это","кроме как","ложь","выдумал он её","и помогли ему","в этом","люди","другие","и уже","пришли они","с несправедливостью","и ложью"]],[25,5,["وَقَالُوٓاْ","أَسَٰطِيرُ","ٱلۡأَوَّلِينَ","ٱكۡتَتَبَهَا","فَهِيَ","تُمۡلَىٰ","عَلَيۡهِ","بُكۡرَةٗ","وَأَصِيلٗا"],"ваḳалуу асатиирул аввалиинактатабаха фахийа тумла `алайхи букратан ва'асиила","Они говорят: «Это - легенды древних народов. Он попросил записать их, и их читают ему утром и после полудня».",["и сказали они","сказки","древних","записал он их себе","и они","диктуются","ему","утром","и вечером"]],[25,6,["قُلۡ","أَنزَلَهُ","ٱلَّذِي","يَعۡلَمُ","ٱلسِّرَّ","فِي","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِۚ","إِنَّهُۥ","كَانَ","غَفُورٗا","رَّحِيمٗا"],"ḳул анзалахул лазии йа`ламус сирра фис самавати вал'арди иннахуу кана гафуурар рахиима","Скажи: «Ниспослал его Тот, Кому известны тайны на небесах и на земле. Он - Прощающий, Милосердный».",["скажи","ниспослал его","Тот, Который","знает","тайное","на","небесах","и земле","поистине, Он","есть","Прощающий","Милосердный"]],[25,7,["وَقَالُواْ","مَالِ","هَٰذَا","ٱلرَّسُولِ","يَأۡكُلُ","ٱلطَّعَامَ","وَيَمۡشِي","فِي","ٱلۡأَسۡوَاقِ","لَوۡلَآ","أُنزِلَ","إِلَيۡهِ","مَلَكٞ","فَيَكُونَ","مَعَهُۥ","نَذِيرًا"],"ваḳалуу мали хазар расуули йа'кулут та`ама вайамшии фил асваḳи лаула унзила илайхи малакун файакууна ма`ахуу назиира","Они сказали: «Что это за посланник? Он ест пищу и ходит по рынкам. Почему к нему не был ниспослан ангел, который предостерегал бы вместе с ним?",["и сказали они","что с","этим","посланником","ест он","пищу","и ходит","по","рынкам","почему бы не","был ниспослан","к нему","ангел","и был бы","с ним","увещевателем"]],[25,8,["أَوۡ","يُلۡقَىٰٓ","إِلَيۡهِ","كَنزٌ","أَوۡ","تَكُونُ","لَهُۥ","جَنَّةٞ","يَأۡكُلُ","مِنۡهَاۚ","وَقَالَ","ٱلظَّٰلِمُونَ","إِن","تَتَّبِعُونَ","إِلَّا","رَجُلٗا","مَّسۡحُورًا"],"ау йулḳа илайхи канзун ау такууну лахуу жаннатун йа'кулу минха ваḳалаз залимууна ин таттаби`ууна илла ражулам масхуура","Почему ему не даровано сокровище? Почему у него нет сада, из которого он бы вкушал?». Беззаконники сказали: «Воистину, вы следуете лишь за околдованным мужем».",["или","был бы брошен","к нему","клад","или","был бы","у него","сад","ест он","из него","и сказали","беззаконники","не","следуете вы","кроме как","за мужчиной","околдованным"]],[25,9,["ٱنظُرۡ","كَيۡفَ","ضَرَبُواْ","لَكَ","ٱلۡأَمۡثَٰلَ","فَضَلُّواْ","فَلَا","يَسۡتَطِيعُونَ","سَبِيلٗا"],"инзур кайфа дарабуу лакал амсала фадаллуу фала йастатии`ууна сабиила","Посмотри, как они приводят тебе притчи! Они впали в заблуждение и не могут найти дороги.",["посмотри","как","привели они","тебе","примеры","и заблудились они","и не","могут они (найти)","пути"]],[25,10,["تَبَارَكَ","ٱلَّذِيٓ","إِن","شَآءَ","جَعَلَ","لَكَ","خَيۡرٗا","مِّن","ذَٰلِكَ","جَنَّٰتٖ","تَجۡرِي","مِن","تَحۡتِهَا","ٱلۡأَنۡهَٰرُ","وَيَجۡعَل","لَّكَ","قُصُورَۢا"],"табаракал лазии ин шаа жа`ала лака хайрам мин залика жаннатин тажрии мин тахтихал анхару вайаж`ал лака ḳусуура","Благословен Тот, Кто дарует тебе, если пожелает, нечто лучшее - Райские сады, в которых текут реки, а также дворцы.",["Благословен","Тот, Который","если","пожелает","сделает","тебе","лучше","чем","это","сады","текут","из","под ними","реки","и сделает","тебе","дворцы"]],[25,11,["بَلۡ","كَذَّبُواْ","بِٱلسَّاعَةِۖ","وَأَعۡتَدۡنَا","لِمَن","كَذَّبَ","بِٱلسَّاعَةِ","سَعِيرًا"],"бал каззабуу бисса`ати ва'а`тадна лиман каззаба бисса`ати са`иира","Но они считают ложью Час, а для тех, кто считает ложью Час, Мы приготовили Пламя.",["но нет","сочли ложью они","Час","и приготовили Мы","для того, кто","счёл ложью","Час","пламя"]]],"m":[[["وَٱتَّخَذُواْ","и взяли они",25,3],["مِن","из",25,3],["دُونِهِۦٓ","помимо Него",25,3],["ءَالِهَةٗ","богов",25,3],["لَّا","не",25,3],["يَخۡلُقُونَ","создают они",25,3],["شَيۡـٔٗا","ничего",25,3],["وَهُمۡ","а они (сами)",25,3],["يُخۡلَقُونَ","сотворены",25,3]],[["وَلَا","и не",25,3],["يَمۡلِكُونَ","владеют они",25,3],["لِأَنفُسِهِمۡ","для самих себя",25,3],["ضَرّٗا","вредом",25,3],["وَلَا","и не",25,3],["نَفۡعٗا","пользой",25,3],["وَلَا","и не",25,3],["يَمۡلِكُونَ","владеют они",25,3],["مَوۡتٗا","смертью",25,3]],[["وَلَا","и не",25,3],["حَيَوٰةٗ","жизнью",25,3],["وَلَا","и не",25,3],["نُشُورٗا","воскрешением",25,3],[3],["وَقَالَ","и сказали",25,4],["ٱلَّذِينَ","те, которые",25,4],["كَفَرُوٓاْ","не уверовали",25,4],["إِنۡ","не",25,4],["هَٰذَآ","это",25,4],["إِلَّآ","кроме как",25,4],["إِفۡكٌ","ложь",25,4]],[["ٱفۡتَرَىٰهُ","выдумал он её",25,4],["وَأَعَانَهُۥ","и помогли ему",25,4],["عَلَيۡهِ","в этом",25,4],["قَوۡمٌ","люди",25,4],["ءَاخَرُونَۖ","другие",25,4],["فَقَدۡ","и уже",25,4],["جَآءُو","пришли они",25,4],["ظُلۡمٗا","с несправедливо