{"p":361,"j":18,"a":[[25,12,["إِذَا","رَأَتۡهُم","مِّن","مَّكَانِۭ","بَعِيدٖ","سَمِعُواْ","لَهَا","تَغَيُّظٗا","وَزَفِيرٗا"],"иза ра'атхум мим макани ба`иидин сами`уу лаха тагаййузан вазафиира","Когда оно завидит их издалека, они услышат его яростное шипение и тяжелое дыхание.",["когда","увидит оно их","из","места","далёкого","услышат они","от него","ярость","и рёв"]],[25,13,["وَإِذَآ","أُلۡقُواْ","مِنۡهَا","مَكَانٗا","ضَيِّقٗا","مُّقَرَّنِينَ","دَعَوۡاْ","هُنَالِكَ","ثُبُورٗا"],"ва'иза улḳуу минха маканан даййиḳам муḳарраниина да`ау хуналика субуура","Когда их скованными бросят в тесное место, там они будут призывать погибель.",["и когда","брошены будут они","в него","в место","тесное","скованные вместе","призовут они","там","погибель"]],[25,14,["لَّا","تَدۡعُواْ","ٱلۡيَوۡمَ","ثُبُورٗا","وَٰحِدٗا","وَٱدۡعُواْ","ثُبُورٗا","كَثِيرٗا"],"лла тад`ул йаума субууран вахидан вад`уу субууран касиира","Не призывайте сегодня одну погибели, а призывайте много погибелей!",["не","призывайте","сегодня","погибель","одну","и призывайте","погибелей","много"]],[25,15,["قُلۡ","أَذَٰلِكَ","خَيۡرٌ","أَمۡ","جَنَّةُ","ٱلۡخُلۡدِ","ٱلَّتِي","وُعِدَ","ٱلۡمُتَّقُونَۚ","كَانَتۡ","لَهُمۡ","جَزَآءٗ","وَمَصِيرٗا"],"ḳул азалика хайрун ам жаннатул хулдил латии ву`идал муттаḳууна канат лахум жазаан вамасиира","Скажи: «Это лучше или же Сад вечности, который обещан богобоязненным и будет им воздаянием и местом прибытия?».",["скажи","разве это","лучше","или","Сад","вечности","который","обещан","богобоязненным","был он","для них","воздаянием","и местом прибытия"]],[25,16,["لَّهُمۡ","فِيهَا","مَا","يَشَآءُونَ","خَٰلِدِينَۚ","كَانَ","عَلَىٰ","رَبِّكَ","وَعۡدٗا","مَّسۡـُٔولٗا"],"ллахум фииха ма йашаууна халидиина кана `ала раббика ва`дам мас'уула","Там они получат все, что пожелают, и останутся навечно. Твой Господь взял на себя это испрошенное обещание.",["для них","в нём","что","пожелают они","вечно пребывающие","было это","на","Господе твоём","обещанием","испрашиваемым"]],[25,17,["وَيَوۡمَ","يَحۡشُرُهُمۡ","وَمَا","يَعۡبُدُونَ","مِن","دُونِ","ٱللَّهِ","فَيَقُولُ","ءَأَنتُمۡ","أَضۡلَلۡتُمۡ","عِبَادِي","هَٰٓؤُلَآءِ","أَمۡ","هُمۡ","ضَلُّواْ","ٱلسَّبِيلَ"],"вайаума йахшурухум вама йа`будууна мин дууниллахи файаḳуулу а'антум адлалтум `ибадии ха'улаи ам хум даллус сабиил","В тот день Он соберет их и тех, кому они поклонялись вместо Аллаха, и скажет: «Это вы ввели в заблуждение этих Моих рабов, или же они сами сбились с пути?».",["и в день","соберёт Он их","и то, чему","поклоняются они","из","помимо","Аллаха","и скажет Он","разве вы","ввели в заблуждение","рабов Моих","этих","или","они","сбились","с пути"]],[25,18,["قَالُواْ","سُبۡحَٰنَكَ","مَا","كَانَ","يَنۢبَغِي","لَنَآ","أَن","نَّتَّخِذَ","مِن","دُونِكَ","مِنۡ","أَوۡلِيَآءَ","وَلَٰكِن","مَّتَّعۡتَهُمۡ","وَءَابَآءَهُمۡ","حَتَّىٰ","نَسُواْ","ٱلذِّكۡرَ","وَكَانُواْ","قَوۡمَۢا","بُورٗا"],"ḳалуу субханака ма кана йамбагии лана ан наттахиза мин дууника мин аулийаа валаким матта`тахум ва'абаахум хатта насуз зикра вакануу ḳаума буура","Они скажут: «Пречист Ты! Не подобало нам брать покровителей и помощников вместо Тебя. Однако Ты позволил им и их отцам пользоваться благами, так что они забыли Напоминание. Они были пропащим народом».",["сказали они","пречист Ты","не","было","подобало","нам","чтобы","взяли мы","из","помимо Тебя","никаких","покровителей","но","наделил Ты благами их","и отцов их","пока","не забыли они","Напоминание","и стали они","людьми","погибшими"]],[25,19,["فَقَدۡ","كَذَّبُوكُم","بِمَا","تَقُولُونَ","فَمَا","تَسۡتَطِيعُونَ","صَرۡفٗا","وَلَا","نَصۡرٗاۚ","وَمَن","يَظۡلِم","مِّنكُمۡ","نُذِقۡهُ","عَذَابٗا","كَبِيرٗا"],"фаḳад каззабуукум бима таḳуулууна фама тастатии`ууна сарфан вала насран ваман йазлим минкум нузиḳху `азабан кабиира","Они опровергли то, что вы говорите, и вы не можете ни отвратить наказание, ни помочь себе. Тем из вас, кто поступал несправедливо, Мы дадим вкусить великие мучения.",["и уже","сочли лжецами вас","в том, что","говорите вы","и не","можете вы","отвратить","и не","помощи","и кто","поступает несправедливо","из вас","дадим Мы вкусить ему","наказание","большое"]],[25,20,["وَمَآ","أَرۡسَلۡنَا","قَبۡلَكَ","مِنَ","ٱلۡمُرۡسَلِينَ","إِلَّآ","إِنَّهُمۡ","لَيَأۡكُلُونَ","ٱلطَّعَامَ","وَيَمۡشُونَ","فِي","ٱلۡأَسۡوَاقِۗ","وَجَعَلۡنَا","بَعۡضَكُمۡ","لِبَعۡضٖ","فِتۡنَةً","أَتَصۡبِرُونَۗ","وَكَانَ","رَبُّكَ","بَصِيرٗا"],"вама арсална ḳаблака минал мурсалиина илла иннахум лайа'кулуунат та`ама вайамшууна фил асваḳи важа`ална ба`дакум либа`дин фитнатан атасбирууна вакана раббука басиира","Мы не ниспосылали до тебя посланников, которые не принимали бы пищи и не ходили бы по рынкам. Мы сделали одних из вас искушением для других: проявите ли вы терпение? Твой Господь - Видящий.",["и не","посылали Мы","до тебя","из","посланников","кроме как","поистине, они","непременно ели","пищу","и ходили","по","рынкам","и сделали Мы","одних из вас","для других","испытанием","проявите ли вы терпение","и есть","Господь твой","Видящий"]]],"m":[[["إِذَا","когда",25,12],["رَأَتۡهُم","увидит оно их",25,12],["مِّن","из",25,12],["مَّكَانِۭ","места",25,12],["بَعِيدٖ","далёкого",25,12],["سَمِعُواْ","услышат они",25,12],["لَهَا","от него",25,12],["تَغَيُّظٗا","ярость",25,12],["وَزَفِيرٗا","и рёв",25,12],[12],["وَإِذَآ","и когда",25,13]],[["أُلۡقُواْ","брошены будут они",25,13],["مِنۡهَا","в него",25,13],["مَكَانٗا","в место",25,13],["ضَيِّقٗا","тесное",25,13],["مُّقَرَّنِينَ","скованные вместе",25,13],["دَعَوۡاْ","призовут они",25,13],["هُنَالِكَ","там",25,13],["ثُبُورٗا","погибель",25,13],[13]],[["لَّا","не",25,14],["تَدۡعُواْ","призывайте",25,14],["ٱلۡيَوۡمَ","сегодня",25,14],["ثُبُورٗا","погибель",25,14],["وَٰحِدٗا","одну",25,14],["وَٱدۡعُواْ","и призывайте",25,14],["ثُبُورٗا","погибелей",25,14],["كَثِيرٗا","много",25,14],[14],["قُلۡ","скажи",25,15]],[["أَذَٰلِكَ","разве это",25,15],["خَيۡرٌ","лучше",25,15],["أَمۡ","или",25,15],["جَنَّةُ","Сад",25,15],["ٱلۡخُلۡدِ","вечности",25,15],["ٱلَّتِي","который",25,15],["وُعِدَ","обещан",25,15],["ٱلۡمُتَّقُونَۚ","богобоязненным",25,15],["كَان