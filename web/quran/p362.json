{"p":362,"j":19,"a":[[25,21,["وَقَالَ","ٱلَّذِينَ","لَا","يَرۡجُونَ","لِقَآءَنَا","لَوۡلَآ","أُنزِلَ","عَلَيۡنَا","ٱلۡمَلَٰٓئِكَةُ","أَوۡ","نَرَىٰ","رَبَّنَاۗ","لَقَدِ","ٱسۡتَكۡبَرُواْ","فِيٓ","أَنفُسِهِمۡ","وَعَتَوۡ","عُتُوّٗا","كَبِيرٗا"],"ваḳалал лазиина ла йаржууна лиḳаана лаула унзила `алайнал малаикату ау нара раббана лаḳадистакбаруу фии анфусихим ва`атау `утувван кабиира","Те, которые не надеются на встречу с Нами, говорят: «Почему к нам не ниспосланы ангелы? И почему мы не видим нашего Господа?». Они надменно возгордились в душе собой и проявили великое неповиновение.",["и сказали","те, которые","не","надеются на","встречу с Нами","почему бы не","были ниспосланы","к нам","ангелы","или","видим мы","Господа нашего","непременно уже","возгордились они","в","душах своих","и преступили","преступлением","большим"]],[25,22,["يَوۡمَ","يَرَوۡنَ","ٱلۡمَلَٰٓئِكَةَ","لَا","بُشۡرَىٰ","يَوۡمَئِذٖ","لِّلۡمُجۡرِمِينَ","وَيَقُولُونَ","حِجۡرٗا","مَّحۡجُورٗا"],"йаума йараунал малаиката ла бушра йаумаизил лилмужримиина вайаḳуулууна хижрам махжуура","В тот день, когда они увидят ангелов, для грешников не будет никакой благой вести, и они (ангелы) скажут: «Вот преграда непреодолимая!».",["в день","увидят они","ангелов","нет","благой вести","в тот день","для грешников","и скажут они","преграда","запретная"]],[25,23,["وَقَدِمۡنَآ","إِلَىٰ","مَا","عَمِلُواْ","مِنۡ","عَمَلٖ","فَجَعَلۡنَٰهُ","هَبَآءٗ","مَّنثُورًا"],"ваḳадимна ила ма `амилуу мин `амалин фажа`алнаху хабаам мансуура","Мы займемся деяниями, которые они совершили, и обратим их в развеянный прах.",["и подошли Мы","к","тому, что","совершили они","из","деяния","и сделали Мы его","пылью","развеянной"]],[25,24,["أَصۡحَٰبُ","ٱلۡجَنَّةِ","يَوۡمَئِذٍ","خَيۡرٞ","مُّسۡتَقَرّٗا","وَأَحۡسَنُ","مَقِيلٗا"],"асхабул жаннати йаумаизин хайрум мустаḳарран ва'ахсану маḳиила","У обитателей Рая в тот день будет более хорошая обитель и более прекрасное место отдыха.",["обитатели","Рая","в тот день","лучше","пристанищем","и прекраснее","местом отдыха"]],[25,25,["وَيَوۡمَ","تَشَقَّقُ","ٱلسَّمَآءُ","بِٱلۡغَمَٰمِ","وَنُزِّلَ","ٱلۡمَلَٰٓئِكَةُ","تَنزِيلًا"],"вайаума ташаḳḳаḳус самау билгамами вануззилал малаикату танзиила","В тот день небо разверзнется и покроется облаками, и будут низведены ангелы.",["и в день","расколется","небо","облаками","и ниспосланы будут","ангелы","ниспосланием"]],[25,26,["ٱلۡمُلۡكُ","يَوۡمَئِذٍ","ٱلۡحَقُّ","لِلرَّحۡمَٰنِۚ","وَكَانَ","يَوۡمًا","عَلَى","ٱلۡكَٰفِرِينَ","عَسِيرٗا"],"алмулку йаумаизинил хаḳḳу лиррахмани вакана йауман `алал кафириина `асиира","В тот день власть будет истинной и будет принадлежать Милостивому, и день тот будет тяжким для неверующих.",["власть","в тот день","истинная","у Милостивого","и будет","днём","для","неверующих","тяжким"]],[25,27,["وَيَوۡمَ","يَعَضُّ","ٱلظَّالِمُ","عَلَىٰ","يَدَيۡهِ","يَقُولُ","يَٰلَيۡتَنِي","ٱتَّخَذۡتُ","مَعَ","ٱلرَّسُولِ","سَبِيلٗا"],"вайаума йа`аддуз залиму `ала йадайхи йаḳуулу йалайтаниттахазту ма`ар расуули сабиила","В тот день беззаконник станет кусать свои руки и скажет: «Лучше бы я последовал путем Посланника!",["и в день","кусает","беззаконник","за","руки свои","говорит он","о, если бы я","взял","с","посланником","путь"]],[25,28,["يَٰوَيۡلَتَىٰ","لَيۡتَنِي","لَمۡ","أَتَّخِذۡ","فُلَانًا","خَلِيلٗا"],"йавайлата лайтании лам аттахиз фуланан халиила","О горе мне! Лучше бы я не брал такого-то себе в друзья!",["о, горе мне","если бы я","не","взял","такого-то","другом"]],[25,29,["لَّقَدۡ","أَضَلَّنِي","عَنِ","ٱلذِّكۡرِ","بَعۡدَ","إِذۡ","جَآءَنِيۗ","وَكَانَ","ٱلشَّيۡطَٰنُ","لِلۡإِنسَٰنِ","خَذُولٗا"],"ллаḳад адаллании `аниз зикри ба`да из жаании ваканаш шайтану лил'инсани хазуула","Это он отвратил меня от Напоминания (Корана) после того, как оно дошло до меня». Воистину, дьявол оставляет человека без поддержки.",["непременно уже","сбил он меня","с","Напоминания","после","того как","пришло оно ко мне","и есть","сатана","для человека","оставляющий в беде"]],[25,30,["وَقَالَ","ٱلرَّسُولُ","يَٰرَبِّ","إِنَّ","قَوۡمِي","ٱتَّخَذُواْ","هَٰذَا","ٱلۡقُرۡءَانَ","مَهۡجُورٗا"],"ваḳалар расуулу йарабби инна ḳаумиттахазуу хазал ḳур'ана махжуура","Посланник сказал: «Господи! Мой народ забросил этот Коран».",["и сказал","посланник","о Господь мой","поистине","народ мой","взяли","этот","Коран","оставленным"]],[25,31,["وَكَذَٰلِكَ","جَعَلۡنَا","لِكُلِّ","نَبِيٍّ","عَدُوّٗا","مِّنَ","ٱلۡمُجۡرِمِينَۗ","وَكَفَىٰ","بِرَبِّكَ","هَادِيٗا","وَنَصِيرٗا"],"ваказалика жа`ална ликулли набиййин `адуввам минал мужримиина вакафа бираббика хадийан ванасиира","Так для каждого пророка Мы создали врагов из числа грешников, но довольно того, что твой Господь наставляет на прямой путь и помогает.",["и так","сделали Мы","для каждого","пророка","врага","из","грешников","и достаточно","Господа твоего","как Наставника","и Помощника"]],[25,32,["وَقَالَ","ٱلَّذِينَ","كَفَرُواْ","لَوۡلَا","نُزِّلَ","عَلَيۡهِ","ٱلۡقُرۡءَانُ","جُمۡلَةٗ","وَٰحِدَةٗۚ","كَذَٰلِكَ","لِنُثَبِّتَ","بِهِۦ","فُؤَادَكَۖ","وَرَتَّلۡنَٰهُ","تَرۡتِيلٗا"],"ваḳалал лазиина кафаруу лаула нуззила `алайхил ḳур'ану жумлатан вахидатан казалика линусаббита бихии фу'адака варатталнаху тартиила","Неверующие сказали: «Почему Коран не ниспослан ему целиком за один раз?». Мы поступили так, чтобы укрепить им твое сердце, и разъяснили его самым прекрасным образом.",["и сказали","те, которые","не уверовали","почему бы не","был ниспослан","ему","Коран","целиком","сразу","так","чтобы укрепили Мы","им","сердце твоё","и прочитали Мы его","чтением размеренным"]]],"m":[[["۞ وَقَالَ","и сказали",25,21],["ٱلَّذِينَ","те, которые",25,21],["لَا","не",25,21],["يَرۡجُونَ","надеются на",25,21],["لِقَآءَنَا","встречу с Нами",25,21],["لَوۡلَآ","почему бы не",25,21],["أُنزِلَ","были ниспосланы",25,21],["عَلَيۡنَا","к нам",25,21],["ٱلۡمَلَٰٓئِكَةُ","ангелы",25,21]],[["أَوۡ","или",25,21],["نَرَىٰ","видим мы",25,21],["رَبَّنَاۗ","Господа нашего",25,21],["لَقَدِ","непременно уже",25,21],["ٱسۡتَكۡبَرُواْ","возгордились они",25,21],["فِيٓ","в",25,21],["أَنفُسِهِمۡ","душах своих",25,21],["وَعَتَوۡ","и преступили",25,21],["عُتُوّٗا","преступлением",25,21],["كَبِيرٗا","большим",25,21]],[[21],["يَوۡمَ","в день",25,22],["يَرَوۡنَ","увидят они",25,22],["ٱلۡمَلَٰٓئِكَةَ","ангелов",25,22],["لَا","нет",25,22],["بُشۡرَىٰ","благой вести",25,22],["يَوۡمَئِذٖ","в тот день",25,22],["لِّلۡمُجۡرِمِينَ","для грешников",25,22],["وَيَقُولُونَ","и скажут они",25,22]],[["حِجۡرٗا","преграда",25,22],["مَّحۡجُورٗا","запретная",25,22],[22],["وَقَدِمۡنَآ","и подошли Мы",25,23],["إِلَىٰ","к",25,23],["مَا","тому, что",25,23],["عَمِلُواْ","совершили они",25,23],["مِنۡ","из",25,23],["عَمَلٖ","деяния",25,23],["فَجَعَلۡنَٰهُ","и сделали Мы его",25,23]],[["هَبَآءٗ","пылью",25,23],["مَّنثُورًا","развеянной",25,23],[23],["أَصۡحَٰبُ","обитатели",25,24],["ٱلۡجَنَّةِ","Рая",25,24],["يَوۡمَئِذٍ","в тот день",25,24],["خَيۡرٞ","лучше",25,24],["مُّسۡتَقَرّٗا","пристанищем",25,24]],[["وَأَحۡسَنُ","и прекраснее",25,24],["مَقِيلٗا","местом отдыха",25,24],[24],["وَيَوۡمَ","и в день",25,25],["تَشَقَّقُ","расколется",25,25],["ٱلسَّمَآءُ","небо",25,25],["بِٱلۡغَمَٰمِ","облаками",25,25],["وَنُزِّلَ","и ниспосланы будут",25,25],["ٱلۡمَلَٰٓئِكَةُ","ангелы",25,25]],[["تَنزِيلًا","ниспосланием",25,25],[25],["ٱلۡمُلۡكُ","власть",25,26],["يَوۡمَئِذٍ","в тот день",25,26],["ٱلۡحَقُّ","истинная",25,26],["لِلرَّحۡمَٰنِۚ","у Милостивого",25,26],["وَكَانَ","и будет",25,26],["يَوۡمًا","днём",25,26],["عَلَى","для",25,26]],[["ٱلۡكَٰفِرِينَ","неверующих",25,26],["عَسِيرٗا","тяжким",25,26],[26],["وَيَوۡمَ","и в день",25,27],["يَعَضُّ","кусает",25,27],["ٱلظَّالِمُ","беззаконник",25,27],["عَلَىٰ","за",25,27],["يَدَيۡهِ","руки свои",25,27],["يَقُولُ","говорит он",25,27]],[["يَٰلَيۡتَنِي","о, если бы я",25,27],["ٱتَّخَذۡتُ","взял",25,27],["مَعَ","с",25,27],["ٱلرَّسُولِ","посланником",25,27],["سَبِيلٗا","путь",25,27],[27],["يَٰوَيۡلَتَىٰ","о, горе мне",25,28],["لَيۡتَنِي","если бы я",25,28],["لَمۡ","не",25,28],["أَتَّخِذۡ","взял",25,28]],[["فُلَانًا","такого-то",25,28],["خَلِيلٗا","другом",25,28],[28],["لَّقَدۡ","непременно уже",25,29],["أَضَلَّنِي","сбил он меня",25,29],["عَنِ","с",25,29],["ٱلذِّكۡرِ","Напоминания",25,29],["بَعۡدَ","после",25,29],["إِذۡ","того как",25,29],["جَآءَنِيۗ","пришло оно ко мне",25,29]],[["وَكَانَ","и есть",25,29],["ٱلشَّيۡطَٰنُ","сатана",25,29],["لِلۡإِنسَٰنِ","для человека",25,29],["خَذُولٗا","оставляющий в беде",25,29],[29],["وَقَالَ","и сказал",25,30],["ٱلرَّسُولُ","посланник",25,30]],[["يَٰرَبِّ","о Господь мой",25,30],["إِنَّ","поистине",25,30],["قَوۡمِي","народ мой",25,30],["ٱتَّخَذُواْ","взяли",25,30],["هَٰذَا","этот",25,30],["ٱلۡقُرۡءَانَ","Коран",25,30],["مَهۡجُورٗا","оставленным",25,30],[30],["وَكَذَٰلِكَ","и так",25,31]],[["جَعَلۡنَا","сделали Мы",25,31],["لِكُلِّ","для каждого",25,31],["نَبِيٍّ","пророка",25,31],["عَدُوّٗا","врага",25,31],["مِّنَ","из",25,31],["ٱلۡمُجۡرِمِينَۗ","грешников",25,31],["وَكَفَىٰ","и достаточно",25,31],["بِرَبِّكَ","Господа твоего",25,31],["هَادِيٗا","как Наставника",25,31]],[["وَنَصِيرٗا","и Помощника",25,31],[31],["وَقَالَ","и сказали",25,32],["ٱلَّذِينَ","те, которые",25,32],["كَفَرُواْ","не уверовали",25,32],["لَوۡلَا","почему бы не",25,32],["نُزِّلَ","был ниспослан",25,32],["عَلَيۡهِ","ему",25,32],["ٱلۡقُرۡءَانُ","Коран",25,32],["جُمۡلَةٗ","целиком",25,32]],[["وَٰحِدَةٗۚ","сразу",25,32],["كَذَٰلِكَ","так",25,32],["لِنُثَبِّتَ","чтобы укрепили Мы",25,32],["بِهِۦ","им",25,32],["فُؤَادَكَۖ","сердце твоё",25,32],["وَرَتَّلۡنَٰهُ","и прочитали Мы его",25,32],["تَرۡتِيلٗا","чтением размеренным",25,32],[32]]]}