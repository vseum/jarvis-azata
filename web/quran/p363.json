{"p":363,"j":19,"a":[[25,33,["وَلَا","يَأۡتُونَكَ","بِمَثَلٍ","إِلَّا","جِئۡنَٰكَ","بِٱلۡحَقِّ","وَأَحۡسَنَ","تَفۡسِيرًا"],"вала йа'туунака бимасалин илла жи'нака билхаḳḳи ва'ахсана тафсиира","Какую бы притчу они ни приводили тебе, Мы открывали тебе истину и наилучшее толкование.",["и не","приходят они к тебе","с притчей","кроме как","Мы приводили тебе","истину","и лучшее","толкование"]],[25,34,["ٱلَّذِينَ","يُحۡشَرُونَ","عَلَىٰ","وُجُوهِهِمۡ","إِلَىٰ","جَهَنَّمَ","أُوْلَٰٓئِكَ","شَرّٞ","مَّكَانٗا","وَأَضَلُّ","سَبِيلٗا"],"аллазиина йухшарууна `ала вужуухихим ила жаханнама улаика шаррум маканан ва'адаллу сабиила","Тем, которые будут собраны в Геенну ничком, уготовано наихудшее место, и они более других сбились с пути.",["те, которые","будут собраны","на","лицах своих","к","Геенне","те","хуже всех","местом","и более заблудшие","путём"]],[25,35,["وَلَقَدۡ","ءَاتَيۡنَا","مُوسَى","ٱلۡكِتَٰبَ","وَجَعَلۡنَا","مَعَهُۥٓ","أَخَاهُ","هَٰرُونَ","وَزِيرٗا"],"валаḳад атайна муусал китаба важа`ална ма`ахуу ахаху харууна вазиира","Воистину, Мы даровали Мусе (Моисею) Писание и сделали его брата Харуна (Аарона) помощником ему.",["и уже","Мы даровали","Мусе","Писание","и Мы сделали","вместе с ним","брата его","Харуна","помощником"]],[25,36,["فَقُلۡنَا","ٱذۡهَبَآ","إِلَى","ٱلۡقَوۡمِ","ٱلَّذِينَ","كَذَّبُواْ","بِـَٔايَٰتِنَا","فَدَمَّرۡنَٰهُمۡ","تَدۡمِيرٗا"],"фаḳулназхаба илал ḳаумил лазиина каззабуу би'айатина фадаммарнахум тадмиира","Мы повелели: «Ступайте вдвоем к народу, который счел ложью Наши знамения». А потом Мы уничтожили его до основания.",["и Мы сказали","ступайте вдвоём","к","народу","который","счёл ложью","Наши знамения","и Мы уничтожили их","полным уничтожением"]],[25,37,["وَقَوۡمَ","نُوحٖ","لَّمَّا","كَذَّبُواْ","ٱلرُّسُلَ","أَغۡرَقۡنَٰهُمۡ","وَجَعَلۡنَٰهُمۡ","لِلنَّاسِ","ءَايَةٗۖ","وَأَعۡتَدۡنَا","لِلظَّٰلِمِينَ","عَذَابًا","أَلِيمٗا"],"ваḳаума нуухил ламма каззабур русула аграḳнахум важа`алнахум линнаси айатан ва'а`тадна лиззалимиина `азабан алиима","Мы потопили народ Нуха (Ноя), когда они сочли лжецами посланников, и сделали их знамением для людей. Мы приготовили беззаконникам мучительные страдания.",["и народ","Нуха","когда","сочли ложью они","посланников","Мы потопили их","и Мы сделали их","для людей","знамением","и Мы приготовили","для беззаконников","наказание","мучительное"]],[25,38,["وَعَادٗا","وَثَمُودَاْ","وَأَصۡحَٰبَ","ٱلرَّسِّ","وَقُرُونَۢا","بَيۡنَ","ذَٰلِكَ","كَثِيرٗا"],"ва`адан васамууда ва'асхабар расси ваḳурууна байна залика касиира","А также адитов, самудян, жителей Расса и многие поколения, которые были между ними.",["и адитов","и самудян","и обитателей","ар-Расса","и поколения","между","этим","многочисленные"]],[25,39,["وَكُلّٗا","ضَرَبۡنَا","لَهُ","ٱلۡأَمۡثَٰلَۖ","وَكُلّٗا","تَبَّرۡنَا","تَتۡبِيرٗا"],"вакуллан дарабна лахул амсала вакуллан таббарна татбиира","Каждому из них Мы приводили притчи, и каждый из них Мы подвергли полному истреблению.",["и каждому","Мы приводили","ему","притчи","и каждого","Мы истребили","полным истреблением"]],[25,40,["وَلَقَدۡ","أَتَوۡاْ","عَلَى","ٱلۡقَرۡيَةِ","ٱلَّتِيٓ","أُمۡطِرَتۡ","مَطَرَ","ٱلسَّوۡءِۚ","أَفَلَمۡ","يَكُونُواْ","يَرَوۡنَهَاۚ","بَلۡ","كَانُواْ","لَا","يَرۡجُونَ","نُشُورٗا"],"валаḳад атау `алал ḳарйатил латии умтират матарас сауи афалам йакуунуу йараунаха бал кануу ла йаржууна нушуура","Они уже проходили мимо селения, на которое выпал недобрый дождь. Разве они не видели его? О нет! Они не надеялись на то, что будут воскрешены.",["и уже","приходили они","к","селению","которое","было осыпано","дождём","зла","неужели же не","были они","видящими его","нет же","были они","не","надеющимися на","воскрешение"]],[25,41,["وَإِذَا","رَأَوۡكَ","إِن","يَتَّخِذُونَكَ","إِلَّا","هُزُوًا","أَهَٰذَا","ٱلَّذِي","بَعَثَ","ٱللَّهُ","رَسُولًا"],"ва'иза ра'аука ин йаттахизуунака илла хузуан ахазал лазии ба`асаллаху расуула","Завидев тебя, они лишь насмехаются над тобой: «Неужели это - тот, кого Аллах отправил посланником?",["и когда","видят они тебя","не","принимают они тебя","кроме как","за посмешище","неужели этот","тот, которого","отправил","Аллах","посланником"]],[25,42,["إِن","كَادَ","لَيُضِلُّنَا","عَنۡ","ءَالِهَتِنَا","لَوۡلَآ","أَن","صَبَرۡنَا","عَلَيۡهَاۚ","وَسَوۡفَ","يَعۡلَمُونَ","حِينَ","يَرَوۡنَ","ٱلۡعَذَابَ","مَنۡ","أَضَلُّ","سَبِيلًا"],"ин када лайудиллуна `ан алихатина лаула ан сабарна `алайха васауфа йа`ламууна хиина йараунал `азаба ман адаллу сабиила","Он готов был отвратить нас от наших богов, если бы мы не проявили терпение». Когда они увидят наказание, они узнают, кто больше других сбился с пути.",["поистине","чуть было не","сбил нас","от","наших богов","если бы не","то, что","мы терпели","держась за них","и скоро","узнают они","когда","увидят они","наказание","кто","более заблудший","путём"]],[25,43,["أَرَءَيۡتَ","مَنِ","ٱتَّخَذَ","إِلَٰهَهُۥ","هَوَىٰهُ","أَفَأَنتَ","تَكُونُ","عَلَيۡهِ","وَكِيلًا"],"араайта маниттахаза илахахуу хаваху афаанта такууну `алайхи вакиила","Видел ли ты того, кто обожествил свою прихоть? Разве ты являешься его попечителем и хранителем?",["видел ли ты","того, кто","сделал","богом своим","свою прихоть","разве же ты","будешь","над ним","попечителем"]]],"m":[[["وَلَا","и не",25,33],["يَأۡتُونَكَ","приходят они к тебе",25,33],["بِمَثَلٍ","с притчей",25,33],["إِلَّا","кроме как",25,33],["جِئۡنَٰكَ","Мы приводили тебе",25,33],["بِٱلۡحَقِّ","истину",25,33],["وَأَحۡسَنَ","и лучшее",25,33],["تَفۡسِيرًا","толкование",25,33],[33]],[["ٱلَّذِينَ","те, которые",25,34],["يُحۡشَرُونَ","будут собраны",25,34],["عَلَىٰ","на",25,34],["وُجُوهِهِمۡ","лицах своих",25,34],["إِلَىٰ","к",25,34],["جَهَنَّمَ","Геенне",25,34],["أُوْلَٰٓئِكَ","те",25,34],["شَرّٞ","хуже всех",25,34]],[["مَّكَانٗا","местом",25,34],["وَأَضَلُّ","и более заблудшие",25,34],["سَبِيلٗا","путём",25,34],[34],["وَلَقَدۡ","и уже",25,35],["ءَاتَيۡنَا","Мы даровали",25,35],["مُوسَى","Мусе",25,35],["ٱلۡكِتَٰبَ","Писание",25,35]],[["وَجَعَلۡنَا","и Мы сделали",25,35],["مَعَهُۥٓ","вместе с ним",25,35],["أَخَاهُ","брата его",25,35],["هَٰرُونَ","Харуна",25,35],["وَ