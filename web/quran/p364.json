{"p":364,"j":19,"a":[[25,44,["أَمۡ","تَحۡسَبُ","أَنَّ","أَكۡثَرَهُمۡ","يَسۡمَعُونَ","أَوۡ","يَعۡقِلُونَۚ","إِنۡ","هُمۡ","إِلَّا","كَٱلۡأَنۡعَٰمِ","بَلۡ","هُمۡ","أَضَلُّ","سَبِيلًا"],"ам тахсабу анна аксарахум йасма`ууна ау йа`ḳилууна ин хум илла кал'ан`ами бал хум адаллу сабиила","Или ты полагаешь, что большинство их способны слышать или разуметь? Они - всего лишь подобие скотов, но они еще больше сбились с пути.",["или","полагаешь ты","что","большинство их","слышат","или","разумеют","не","они","кроме как","как скот","нет же","они","более заблудшие","путём"]],[25,45,["أَلَمۡ","تَرَ","إِلَىٰ","رَبِّكَ","كَيۡفَ","مَدَّ","ٱلظِّلَّ","وَلَوۡ","شَآءَ","لَجَعَلَهُۥ","سَاكِنٗا","ثُمَّ","جَعَلۡنَا","ٱلشَّمۡسَ","عَلَيۡهِ","دَلِيلٗا"],"алам тара ила раббика кайфа маддаз зилла валау шаа лажа`алахуу сакинан сумма жа`алнаш шамса `алайхи далиила","Разве ты не видишь, как твой Господь простирает тень? Если бы Он захотел, то сделал бы ее неподвижной. Затем Мы делаем солнце ее путеводителем",["разве не","видишь ты","на","Господа твоего","как","Он простёр","тень","а если бы","пожелал Он","непременно сделал бы её","неподвижной","затем","Мы сделали","солнце","для неё","указателем"]],[25,46,["ثُمَّ","قَبَضۡنَٰهُ","إِلَيۡنَا","قَبۡضٗا","يَسِيرٗا"],"сумма ḳабаднаху илайна ḳабдан йасиира","и затем постепенно сжимаем ее к Себе.",["затем","Мы сжали её","к Нам","сжатием","постепенным"]],[25,47,["وَهُوَ","ٱلَّذِي","جَعَلَ","لَكُمُ","ٱلَّيۡلَ","لِبَاسٗا","وَٱلنَّوۡمَ","سُبَاتٗا","وَجَعَلَ","ٱلنَّهَارَ","نُشُورٗا"],"вахуал лазии жа`ала лакумул лайла либасан ваннаума субатан важа`алан нахара нушуура","Он - Тот, Кто сделал для вас ночь покровом, сон - отдыхом, а день - оживлением.",["и Он","Тот, Который","сделал","для вас","ночь","покровом","и сон","отдыхом","и сделал","день","оживлением"]],[25,48,["وَهُوَ","ٱلَّذِيٓ","أَرۡسَلَ","ٱلرِّيَٰحَ","بُشۡرَۢا","بَيۡنَ","يَدَيۡ","رَحۡمَتِهِۦۚ","وَأَنزَلۡنَا","مِنَ","ٱلسَّمَآءِ","مَآءٗ","طَهُورٗا"],"вахуал лазии арсалар рийаха бушра байна йадай рахматихии ва'анзална минас самаи маан тахуура","Он - Тот, Кто посылает ветры с доброй вестью о Своей милости. Мы ниспосылаем с неба чистую и очищающую воду,",["и Он","Тот, Который","послал","ветры","благой вестью","между","руками (т.е. перед)","Его милости","и Мы ниспослали","с","неба","воду","чистую"]],[25,49,["لِّنُحۡـِۧيَ","بِهِۦ","بَلۡدَةٗ","مَّيۡتٗا","وَنُسۡقِيَهُۥ","مِمَّا","خَلَقۡنَآ","أَنۡعَٰمٗا","وَأَنَاسِيَّ","كَثِيرٗا"],"ллинухиийа бихии балдатам майтан ванусḳийахуу мимма халаḳна ан`аман ва'анасиййа касиира","чтобы оживить ею мертвую землю и напоить ею многочисленный скот и многих людей из тех, кого Мы сотворили.",["чтобы Мы оживили","ею","местность","мёртвую","и напоили ею","из того, что","Мы сотворили","скот","и людей","многочисленных"]],[25,50,["وَلَقَدۡ","صَرَّفۡنَٰهُ","بَيۡنَهُمۡ","لِيَذَّكَّرُواْ","فَأَبَىٰٓ","أَكۡثَرُ","ٱلنَّاسِ","إِلَّا","كُفُورٗا"],"валаḳад саррафнаху байнахум лийаззаккаруу фа'аба аксарун наси илла куфуура","Мы распределяем ее (дождевую воду) между ними, чтобы они помянули назидание, но большинство людей отказываются от всего, кроме неверия (или неблагодарности).",["и уже","Мы распределили её","между ними","чтобы они помянули","но отказалось","большинство","людей","кроме","неверия"]],[25,51,["وَلَوۡ","شِئۡنَا","لَبَعَثۡنَا","فِي","كُلِّ","قَرۡيَةٖ","نَّذِيرٗا"],"валау ши'на лаба`асна фии кулли ḳарйатин назиира","Если бы Мы пожелали, то послали бы в каждое селение предостерегающего увещевателя.",["и если бы","пожелали Мы","непременно послали бы Мы","в","каждое","селение","увещевателя"]],[25,52,["فَلَا","تُطِعِ","ٱلۡكَٰفِرِينَ","وَجَٰهِدۡهُم","بِهِۦ","جِهَادٗا","كَبِيرٗا"],"фала тути`ил кафириина важахидхум бихии жихадан кабиира","Посему не повинуйся неверующим и веди с ними посредством него (Корана) великую борьбу.",["так не","повинуйся","неверующим","и борись с ними","посредством него","борьбой","великой"]],[25,53,["وَهُوَ","ٱلَّذِي","مَرَجَ","ٱلۡبَحۡرَيۡنِ","هَٰذَا","عَذۡبٞ","فُرَاتٞ","وَهَٰذَا","مِلۡحٌ","أُجَاجٞ","وَجَعَلَ","بَيۡنَهُمَا","بَرۡزَخٗا","وَحِجۡرٗا","مَّحۡجُورٗا"],"вахуал лазии маражал бахрайни хаза `азбун фуратун вахаза милхун ужажун важа`ала байнахума барзахан вахижрам махжуура","Он - Тот, Кто смешал два моря (вида воды): одно - приятное, пресное, а другое - соленое, горькое. Он установил между ними преграду и непреодолимое препятствие.",["и Он","Тот, Который","смешал","два моря","это","приятное","пресное","а это","солёное","горькое","и Он сделал","между ними двумя","преграду","и препятствие","непреодолимое"]],[25,54,["وَهُوَ","ٱلَّذِي","خَلَقَ","مِنَ","ٱلۡمَآءِ","بَشَرٗا","فَجَعَلَهُۥ","نَسَبٗا","وَصِهۡرٗاۗ","وَكَانَ","رَبُّكَ","قَدِيرٗا"],"вахуал лазии халаḳа минал маи башаран фажа`алахуу насабан васихран вакана раббука ḳадиира","Он - Тот, Кто сотворил человека из воды и одарил его родственниками и свойственниками. Господь твой - Всемогущий.",["и Он","Тот, Который","сотворил","из","воды","человека","и сделал его","роднёй по крови","и роднёй по браку","и является","Господь твой","Всемогущим"]],[25,55,["وَيَعۡبُدُونَ","مِن","دُونِ","ٱللَّهِ","مَا","لَا","يَنفَعُهُمۡ","وَلَا","يَضُرُّهُمۡۗ","وَكَانَ","ٱلۡكَافِرُ","عَلَىٰ","رَبِّهِۦ","ظَهِيرٗا"],"вайа`будууна мин дууниллахи ма ла йанфа`ухум вала йадуррухум ваканал кафиру `ала раббихии захиира","Они поклоняются помимо Аллаха тому, что не может ни принести им пользу, ни причинить им вред. Неверующий является помощником против своего Господа.",["и поклоняются они","(из)","помимо","Аллаха","тому, что","не","приносит пользы им","и не","вредит им","и является","неверующий","против","Господа своего","пособником"]]],"m":[[["أَمۡ","или",25,44],["تَحۡسَبُ","полагаешь ты",25,44],["أَنَّ","что",25,44],["أَكۡثَرَهُمۡ","большинство их",25,44],["يَسۡمَعُونَ","слышат",25,44],["أَوۡ","или",25,44],["يَعۡقِلُونَۚ","разумеют",25,44],["إِنۡ","не",25,44],["هُمۡ","они",25,44],["إِلَّا","кроме как",25,44]],[["كَٱلۡأَنۡعَٰمِ","как скот",25,44],["بَلۡ","нет же",25,44],["هُمۡ","они",25,44],["أَضَلُّ","более заблудшие",25,44],["سَبِيلًا","путём",25,44],[44],["أَلَمۡ","разве не",25,45],["تَرَ","видишь ты",25,45],["إِلَىٰ","на",25,45],["رَبِّكَ","Господа твоего",25,45],["كَيۡفَ","как",25,45],["مَدَّ","Он простёр",25,45]],[["ٱلظِّلَّ","тень",25,45],["وَلَوۡ","а если бы",25,45],["شَآءَ","пожелал Он",25,45],["لَجَعَلَهُۥ","непременно сделал бы её",25,45],["سَاكِنٗا","неподвижной",25,45],["ثُمَّ","затем",25,45],["جَعَلۡنَا","Мы сделали",25,45],["ٱلشَّمۡسَ","солнце",25,45],["عَلَيۡهِ","для неё",25,45],["دَلِيلٗا","указателем",25,45]],[[45],["ثُمَّ","затем",25,46],["قَبَضۡنَٰهُ","Мы сжали её",25,46],["إِلَيۡنَا","к Нам",25,46],["قَبۡضٗا","сжатием",25,46],["يَسِيرٗا","постепенным",25,46],[46],["وَهُوَ","и Он",25,47],["ٱلَّذِي","Тот, Который",25,47],["جَعَلَ","сделал",25,47]],[["لَكُمُ","для вас",25,47],["ٱلَّيۡلَ","ночь",25,47],["لِبَاسٗا","покровом",25,47],["وَٱلنَّوۡمَ","и сон",25,47],["سُبَاتٗا","отдыхом",25,47],["وَجَعَلَ","и сделал",25,47],["ٱلنَّهَارَ","день",25,47],["نُشُورٗا","оживлением",25,47],[47]],[["وَهُوَ","и Он",25,48],["ٱلَّذِيٓ","Тот, Который",25,48],["أَرۡسَلَ","послал",25,48],["ٱلرِّيَٰحَ","ветры",25,48],["بُشۡرَۢا","благой вестью",25,48],["بَيۡنَ","между",25,48],["يَدَيۡ","руками (т.е. перед)",25,48],["رَحۡمَتِهِۦۚ","Его милости",25,48],["وَأَنزَلۡنَا","и Мы ниспослали",25,48]],[["مِنَ","с",25,48],["ٱلسَّمَآءِ","неба",25,48],["مَآءٗ","воду",25,48],["طَهُورٗا","чистую",25,48],[48],["لِّنُحۡـِۧيَ","чтобы Мы оживили",25,49],["بِهِۦ","ею",25,49],["بَلۡدَةٗ","местность",25,49],["مَّيۡتٗا","мёртвую",25,49],["وَنُسۡقِيَهُۥ","и напоили ею",25,49]],[["مِمَّا","из того, что",25,49],["خَلَقۡنَآ","Мы сотворили",25,49],["أَنۡعَٰمٗا","скот",25,49],["وَأَنَاسِيَّ","и людей",25,49],["كَثِيرٗا","многочисленных",25,49],[49],["وَلَقَدۡ","и уже",25,50],["صَرَّفۡنَٰهُ","Мы распределили её",25,50],["بَيۡنَهُمۡ","между ними",25,50]],[["لِيَذَّكَّرُواْ","чтобы они помянули",25,50],["فَأَبَىٰٓ","но отказалось",25,50],["أَكۡثَرُ","большинство",25,50],["ٱلنَّاسِ","людей",25,50],["إِلَّا","кроме",25,50],["كُفُورٗا","неверия",25,50],[50],["وَلَوۡ","и если бы",25,51],["شِئۡنَا","пожелали Мы",25,51]],[["لَبَعَثۡنَا","непременно послали бы Мы",25,51],["فِي","в",25,51],["كُلِّ","каждое",25,51],["قَرۡيَةٖ","селение",25,51],["نَّذِيرٗا","увещевателя",25,51],[51],["فَلَا","так не",25,52],["تُطِعِ","повинуйся",25,52],["ٱلۡكَٰفِرِينَ","неверующим",25,52]],[["وَجَٰهِدۡهُم","и борись с ними",25,52],["بِهِۦ","посредством него",25,52],["جِهَادٗا","борьбой",25,52],["كَبِيرٗا","великой",25,52],[52],["۞ وَهُوَ","и Он",25,53],["ٱلَّذِي","Тот, Который",25,53],["مَرَجَ","смешал",25,53]],[["ٱلۡبَحۡرَيۡنِ","два моря",25,53],["هَٰذَا","это",25,53],["عَذۡبٞ","приятное",25,53],["فُرَاتٞ","пресное",25,53],["وَهَٰذَا","а это",25,53],["مِلۡحٌ","солёное",25,53],["أُجَاجٞ","горькое",25,53],["وَجَعَلَ","и Он сделал",25,53],["بَيۡنَهُمَا","между ними двумя",25,53],["بَرۡزَخٗا","преграду",25,53]],[["وَحِجۡرٗا","и препятствие",25,53],["مَّحۡجُورٗا","непреодолимое",25,53],[53],["وَهُوَ","и Он",25,54],["ٱلَّذِي","Тот, Который",25,54],["خَلَقَ","сотворил",25,54],["مِنَ","из",25,54],["ٱلۡمَآءِ","воды",25,54],["بَشَرٗا","человека",25,54],["فَجَعَلَهُۥ","и сделал его",25,54]],[["نَسَبٗا","роднёй по крови",25,54],["وَصِهۡرٗاۗ","и роднёй по браку",25,54],["وَكَانَ","и является",25,54],["رَبُّكَ","Господь твой",25,54],["قَدِيرٗا","Всемогущим",25,54],[54],["وَيَعۡبُدُونَ","и поклоняются они",25,55],["مِن","(из)",25,55],["دُونِ","помимо",25,55],["ٱللَّهِ","Аллаха",25,55]],[["مَا","тому, что",25,55],["لَا","не",25,55],["يَنفَعُهُمۡ","приносит пользы им",25,55],["وَلَا","и не",25,55],["يَضُرُّهُمۡۗ","вредит им",25,55],["وَكَانَ","и является",25,55],["ٱلۡكَافِرُ","неверующий",25,55],["عَلَىٰ","против",25,55],["رَبِّهِۦ","Господа своего",25,55],["ظَهِيرٗا","пособником",25,55],[55]]]}