{"p":365,"j":19,"a":[[25,56,["وَمَآ","أَرۡسَلۡنَٰكَ","إِلَّا","مُبَشِّرٗا","وَنَذِيرٗا"],"вама арсалнака илла мубашширан ваназиира","Мы отправили тебя всего лишь добрым вестником и предостерегающим увещевателем.",["и не","Мы послали тебя","кроме как","добрым вестником","и увещевателем"]],[25,57,["قُلۡ","مَآ","أَسۡـَٔلُكُمۡ","عَلَيۡهِ","مِنۡ","أَجۡرٍ","إِلَّا","مَن","شَآءَ","أَن","يَتَّخِذَ","إِلَىٰ","رَبِّهِۦ","سَبِيلٗا"],"ḳул ма ас'алукум `алайхи мин ажрин илла ман шаа ан йаттахиза ила раббихии сабиила","Скажи: «Я не прошу у вас за это никакого вознаграждения, кроме того, чтобы желающие встали на путь к своему Господу».",["скажи","не","прошу я у вас","за это","никакой","награды","кроме","того, кто","пожелал","чтобы","взять","к","Господу своему","путь"]],[25,58,["وَتَوَكَّلۡ","عَلَى","ٱلۡحَيِّ","ٱلَّذِي","لَا","يَمُوتُ","وَسَبِّحۡ","بِحَمۡدِهِۦۚ","وَكَفَىٰ","بِهِۦ","بِذُنُوبِ","عِبَادِهِۦ","خَبِيرًا"],"ватаваккал `алал хаййил лазии ла йамууту васаббих бихамдихии вакафа бихии бизунууби `ибадихии хабиира","Уповай на Живого, Который не умирает, и прославляй Его хвалой. Довольно того, что Он ведает о грехах Своих рабов.",["и уповай","на","Живого","Который","не","умирает","и славь","хвалою Его","и достаточно","Его","о грехах","рабов Его","Ведающим"]],[25,59,["ٱلَّذِي","خَلَقَ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضَ","وَمَا","بَيۡنَهُمَا","فِي","سِتَّةِ","أَيَّامٖ","ثُمَّ","ٱسۡتَوَىٰ","عَلَى","ٱلۡعَرۡشِۖ","ٱلرَّحۡمَٰنُ","فَسۡـَٔلۡ","بِهِۦ","خَبِيرٗا"],"аллазии халаḳас самавати вал'арда вама байнахума фии ситтати аййамин суммастава `алал `аршир рахману фас'ал бихии хабиира","Он сотворил небеса и землю и то, что между ними, за шесть дней, а потом вознесся на Трон (или утвердился на Троне). Он - Милостивый. Спрашивай об этом Ведающего.",["Тот, Который","сотворил","небеса","и землю","и то, что","между ними","за","шесть","дней","затем","вознёсся Он","на","Трон","Милостивый","спроси же","о Нём","Ведающего"]],[25,60,["وَإِذَا","قِيلَ","لَهُمُ","ٱسۡجُدُواْۤ","لِلرَّحۡمَٰنِ","قَالُواْ","وَمَا","ٱلرَّحۡمَٰنُ","أَنَسۡجُدُ","لِمَا","تَأۡمُرُنَا","وَزَادَهُمۡ","نُفُورٗا ۩"],"ва'иза ḳиила лахумусжудуу лиррахмани ḳалуу вамар рахману анасжуду лима та'муруна вазадахум нуфуура","Когда им говорят: «Падайте ниц перед Милостивым!». - они говорят: «Что такое Милостивый? Неужели мы будем падать ниц перед тем, кому ты нам приказываешь?». Это приумножает их отвращение.",["и когда","сказано","им","падайте ниц","перед Милостивым","говорят они","и что такое","Милостивый","неужели мы падём ниц","перед тем, что","велишь ты нам","и прибавило это им","отвращения"]],[25,61,["تَبَارَكَ","ٱلَّذِي","جَعَلَ","فِي","ٱلسَّمَآءِ","بُرُوجٗا","وَجَعَلَ","فِيهَا","سِرَٰجٗا","وَقَمَرٗا","مُّنِيرٗا"],"табаракал лазии жа`ала фис самаи буруужан важа`ала фииха сиражан ваḳамарам муниира","Благословен Тот, Кто установил на небе созвездия Зодиака и установил на нем светильник и освещающую луну.",["благословен","Тот, Кто","поместил","на","небе","созвездия","и поместил","на нём","светильник","и луну","освещающую"]],[25,62,["وَهُوَ","ٱلَّذِي","جَعَلَ","ٱلَّيۡلَ","وَٱلنَّهَارَ","خِلۡفَةٗ","لِّمَنۡ","أَرَادَ","أَن","يَذَّكَّرَ","أَوۡ","أَرَادَ","شُكُورٗا"],"вахуал лазии жа`алал лайла ваннахара хилфатал лиман арада ан йаззаккара ау арада шукуура","Он - Тот, Кто чередует ночь и день для тех, кто желает помнить и благодарить.",["и Он","Тот, Кто","сделал","ночь","и день","сменяющими друг друга","для того, кто","пожелал","чтобы","поминать","или","пожелал","благодарить"]],[25,63,["وَعِبَادُ","ٱلرَّحۡمَٰنِ","ٱلَّذِينَ","يَمۡشُونَ","عَلَى","ٱلۡأَرۡضِ","هَوۡنٗا","وَإِذَا","خَاطَبَهُمُ","ٱلۡجَٰهِلُونَ","قَالُواْ","سَلَٰمٗا"],"ва`ибадур рахманил лазиина йамшууна `алал арди хаунан ва'иза хатабахумул жахилууна ḳалуу салама","А рабами Милостивого являются те, которые ступают по земле смиренно, а когда невежды обращаются к ним, они говорят: «Мир!»",["и рабы","Милостивого","те, которые","ходят","по","земле","смиренно","и когда","обращаются к ним","невежды","говорят они","мир"]],[25,64,["وَٱلَّذِينَ","يَبِيتُونَ","لِرَبِّهِمۡ","سُجَّدٗا","وَقِيَٰمٗا"],"валлазиина йабиитууна лираббихим сужжадан ваḳийама","Они проводят ночи, падая ниц и стоя перед своим Господом.",["и те, которые","проводят ночь","ради Господа своего","падая ниц","и стоя"]],[25,65,["وَٱلَّذِينَ","يَقُولُونَ","رَبَّنَا","ٱصۡرِفۡ","عَنَّا","عَذَابَ","جَهَنَّمَۖ","إِنَّ","عَذَابَهَا","كَانَ","غَرَامًا"],"валлазиина йаḳуулууна раббанасриф `анна `азаба жаханнама инна `азабаха кана гарама","Они говорят: «Господь наш! Отврати от нас мучения в Геенне, поскольку мучения там не отступают.",["и те, которые","говорят","Господь наш","отврати","от нас","наказание","Геенны","поистине","наказание её","является","неотступным"]],[25,66,["إِنَّهَا","سَآءَتۡ","مُسۡتَقَرّٗا","وَمُقَامٗا"],"иннаха саат мустаḳарран вамуḳама","Как скверны эта обитель и местопребывание!».",["поистине, она","скверна","как обитель","и местопребывание"]],[25,67,["وَٱلَّذِينَ","إِذَآ","أَنفَقُواْ","لَمۡ","يُسۡرِفُواْ","وَلَمۡ","يَقۡتُرُواْ","وَكَانَ","بَيۡنَ","ذَٰلِكَ","قَوَامٗا"],"валлазиина иза анфаḳуу лам йусрифуу валам йаḳтуруу вакана байна залика ḳавама","Когда они делают пожертвования, то не излишествуют и не скупятся, а придерживаются середины между этими крайностями.",["и те, которые","когда","расходуют","не","расточительствуют","и не","скупятся","и было","между","этим","умеренным"]]],"m":[[["وَمَآ","и не",25,56],["أَرۡسَلۡنَٰكَ","Мы послали тебя",25,56],["إِلَّا","кроме как",25,56],["مُبَشِّرٗا","добрым вестником",25,56],["وَنَذِيرٗا","и увещевателем",25,56],[56],["قُلۡ","скажи",25,57],["مَآ","не",25,57],["أَسۡـَٔلُكُمۡ","прошу я у вас",25,57],["عَلَيۡهِ","за это",25,57]],[["مِنۡ","никакой",25,57],["أَجۡرٍ","награды",25,57],["إِلَّا","кроме",25,57],["مَن","того, кто",25,57],["شَآءَ","пожелал",25,57],["أَن","чтобы",25,57],["يَتَّخِذَ","взять",25,57],["إِلَىٰ","к",25,57],["رَبِّهِۦ","Господу своему",25,57],["سَبِيلٗا","путь",25,57],[57],["وَتَوَكَّلۡ","и уповай",25,58]],[["عَلَى","на",25,58],["ٱلۡحَيِّ","Живого",25,58],["ٱلَّذِي","Который"