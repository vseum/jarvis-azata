{"p":366,"j":19,"a":[[25,68,["وَٱلَّذِينَ","لَا","يَدۡعُونَ","مَعَ","ٱللَّهِ","إِلَٰهًا","ءَاخَرَ","وَلَا","يَقۡتُلُونَ","ٱلنَّفۡسَ","ٱلَّتِي","حَرَّمَ","ٱللَّهُ","إِلَّا","بِٱلۡحَقِّ","وَلَا","يَزۡنُونَۚ","وَمَن","يَفۡعَلۡ","ذَٰلِكَ","يَلۡقَ","أَثَامٗا"],"валлазиина ла йад`ууна ма`аллахи илахан ахара вала йаḳтулуунан нафсал латии харрамаллаху илла билхаḳḳи вала йазнууна ваман йаф`ал залика йалḳа асама","Они не взывают помимо Аллаха к другим богам, не убивают людей вопреки запрету Аллаха, если только они не имеют права на это, и не прелюбодействуют. А тот, кто поступает так, получит наказание.",["и те, которые","не","взывают","наряду с","Аллахом","к богу","другому","и не","убивают","душу","которую","запретил","Аллах","кроме как","по праву","и не","прелюбодействуют","а кто","сделает","это","встретит","воздаяние за грех"]],[25,69,["يُضَٰعَفۡ","لَهُ","ٱلۡعَذَابُ","يَوۡمَ","ٱلۡقِيَٰمَةِ","وَيَخۡلُدۡ","فِيهِۦ","مُهَانًا"],"йуда`аф лахул `азабу йаумал ḳийамати вайахлуд фиихии мухана","Его мучения будут приумножены в День воскресения, и он навечно останется в них униженным.",["будет умножено","ему","наказание","в День","воскресения","и пребудет вечно он","в нём","униженным"]],[25,70,["إِلَّا","مَن","تَابَ","وَءَامَنَ","وَعَمِلَ","عَمَلٗا","صَٰلِحٗا","فَأُوْلَٰٓئِكَ","يُبَدِّلُ","ٱللَّهُ","سَيِّـَٔاتِهِمۡ","حَسَنَٰتٖۗ","وَكَانَ","ٱللَّهُ","غَفُورٗا","رَّحِيمٗا"],"илла ман таба ва'амана ва`амила `амалан салихан фа'улаика йубаддилуллаху саййиатихим хасанатин ваканаллаху гафуурар рахиима","Это не относится к тем, которые раскаялись, уверовали и поступали праведно. Их злые деяния Аллах заменит добрыми, ибо Аллах - Прощающий, Милосердный.",["кроме","того, кто","покаялся","и уверовал","и совершал","деяние","праведное","то тем","заменит","Аллах","дурные дела их","добрыми делами","и является","Аллах","Прощающим","Милосердным"]],[25,71,["وَمَن","تَابَ","وَعَمِلَ","صَٰلِحٗا","فَإِنَّهُۥ","يَتُوبُ","إِلَى","ٱللَّهِ","مَتَابٗا"],"ваман таба ва`амила салихан фа'иннахуу йатуубу илаллахи матаба","Кто раскаивается и поступает праведно, тот действительно возвращается к Аллаху.",["и кто","покаялся","и совершал","праведное","то поистине он","обращается","к","Аллаху","истинным обращением"]],[25,72,["وَٱلَّذِينَ","لَا","يَشۡهَدُونَ","ٱلزُّورَ","وَإِذَا","مَرُّواْ","بِٱللَّغۡوِ","مَرُّواْ","كِرَامٗا"],"валлазиина ла йашхадууназ зуура ва'иза марруу биллагви марруу кирама","Они не свидетельствуют лживо (или не присутствуют при лживых разговорах), а когда проходят мимо праздного, то проходят с достоинством.",["и те, которые","не","свидетельствуют","ложь","и когда","проходят","мимо пустого","проходят","достойно"]],[25,73,["وَٱلَّذِينَ","إِذَا","ذُكِّرُواْ","بِـَٔايَٰتِ","رَبِّهِمۡ","لَمۡ","يَخِرُّواْ","عَلَيۡهَا","صُمّٗا","وَعُمۡيَانٗا"],"валлазиина иза зуккируу би'айати раббихим лам йахирруу `алайха сумман ва`умйана","Когда им напоминают о знамениях их Господа, они не падают на них глухими и слепыми.",["и те, которые","когда","напоминают им","о знамениях","Господа их","не","падают","на них","глухими","и слепыми"]],[25,74,["وَٱلَّذِينَ","يَقُولُونَ","رَبَّنَا","هَبۡ","لَنَا","مِنۡ","أَزۡوَٰجِنَا","وَذُرِّيَّٰتِنَا","قُرَّةَ","أَعۡيُنٖ","وَٱجۡعَلۡنَا","لِلۡمُتَّقِينَ","إِمَامًا"],"валлазиина йаḳуулууна раббана хаб лана мин азважина вазурриййатина ḳуррата а`йунин важ`ална лилмуттаḳиина имама","Они говорят: «Господь наш! Даруй нам отраду глаз в наших супругах и потомках и сделай нас образцом для богобоязненных».",["и те, которые","говорят","Господь наш","даруй","нам","от","супругов наших","и потомства нашего","отраду","глаз","и сделай нас","для богобоязненных","образцом"]],[25,75,["أُوْلَٰٓئِكَ","يُجۡزَوۡنَ","ٱلۡغُرۡفَةَ","بِمَا","صَبَرُواْ","وَيُلَقَّوۡنَ","فِيهَا","تَحِيَّةٗ","وَسَلَٰمًا"],"улаика йужзаунал гурфата бима сабаруу вайулаḳḳауна фииха тахиййатан васалама","Они получат Наивысшее место в воздаяние за то, что были терпеливы, и их встретят там приветствием и миром.",["те","будут вознаграждены","горницей (рая)","за то, что","они терпели","и будут встречены","в ней","приветствием","и миром"]],[25,76,["خَٰلِدِينَ","فِيهَاۚ","حَسُنَتۡ","مُسۡتَقَرّٗا","وَمُقَامٗا"],"халидиина фииха хасунат мустаḳарран вамуḳама","Они пребудут там вечно. Как прекрасна эта обитель и местопребывание!",["пребывая вечно","в ней","прекрасна она","как обитель","и местопребывание"]],[25,77,["قُلۡ","مَا","يَعۡبَؤُاْ","بِكُمۡ","رَبِّي","لَوۡلَا","دُعَآؤُكُمۡۖ","فَقَدۡ","كَذَّبۡتُمۡ","فَسَوۡفَ","يَكُونُ","لِزَامَۢا"],"ḳул ма йа`бау бикум раббии лаула ду`аукум фаḳад каззабтум фасауфа йакууну лизама","Скажи: «Мой Господь не стал бы обращать на вас внимание, если бы не ваши молитвы. Вы сочли это ложью, и скоро оно (наказание) станет неотступным».",["скажи","не","придал бы значения","вам","Господь мой","если бы не","мольба ваша","и вот уже","сочли ложью вы","и скоро","будет (оно)","неотвратимым"]]],"m":[[["وَٱلَّذِينَ","и те, которые",25,68],["لَا","не",25,68],["يَدۡعُونَ","взывают",25,68],["مَعَ","наряду с",25,68],["ٱللَّهِ","Аллахом",25,68],["إِلَٰهًا","к богу",25,68],["ءَاخَرَ","другому",25,68],["وَلَا","и не",25,68],["يَقۡتُلُونَ","убивают",25,68],["ٱلنَّفۡسَ","душу",25,68]],[["ٱلَّتِي","которую",25,68],["حَرَّمَ","запретил",25,68],["ٱللَّهُ","Аллах",25,68],["إِلَّا","кроме как",25,68],["بِٱلۡحَقِّ","по праву",25,68],["وَلَا","и не",25,68],["يَزۡنُونَۚ","прелюбодействуют",25,68],["وَمَن","а кто",25,68],["يَفۡعَلۡ","сделает",25,68],["ذَٰلِكَ","это",25,68],["يَلۡقَ","встретит",25,68]],[["أَثَامٗا","воздаяние за грех",25,68],[68],["يُضَٰعَفۡ","будет умножено",25,69],["لَهُ","ему",25,69],["ٱلۡعَذَابُ","наказание",25,69],["يَوۡمَ","в День",25,69],["ٱلۡقِيَٰمَةِ","воскресения",25,69],["وَيَخۡلُدۡ","и пребудет вечно он",25,69],["فِيهِۦ","в нём",25,69]],[["مُهَانًا","униженным",25,69],[69],["إِلَّا","кроме",25,70],["مَن","того, кто",25,70],["تَابَ","покаялся",25,70],["وَءَامَنَ","и уверовал",25,70],["وَعَمِلَ","и совершал",25,70],["عَمَلٗا","деяние",25,70],["صَٰلِحٗا","праведное",25,70]],[["فَأُوْلَٰٓئِكَ","то тем",25,70],["يُبَدِّلُ","заменит",25,70],["