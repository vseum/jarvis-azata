{"p":367,"j":19,"a":[[26,1,["طسٓمٓ"],"тсм","Та. Син. Мим.",["Та. Син. Мим."]],[26,2,["تِلۡكَ","ءَايَٰتُ","ٱلۡكِتَٰبِ","ٱلۡمُبِينِ"],"тилка айатул китабил мубиин","Это - аяты ясного Писания.",["это","аяты","Писания","ясного"]],[26,3,["لَعَلَّكَ","بَٰخِعٞ","نَّفۡسَكَ","أَلَّا","يَكُونُواْ","مُؤۡمِنِينَ"],"ла`аллака бахи`ун нафсака алла йакуунуу му'миниин","Ты можешь погубить себя от скорби оттого, что они не становятся верующими.",["может быть, ты","губящий","себя","оттого, что не","являются они","верующими"]],[26,4,["إِن","نَّشَأۡ","نُنَزِّلۡ","عَلَيۡهِم","مِّنَ","ٱلسَّمَآءِ","ءَايَةٗ","فَظَلَّتۡ","أَعۡنَٰقُهُمۡ","لَهَا","خَٰضِعِينَ"],"ин наша' нуназзил `алайхим минас самаи айатан фазаллат а`наḳухум лаха хади`иин","Если Мы пожелаем, то ниспошлем им с неба знамение, перед которым покорно склонятся их шеи.",["если","Мы пожелаем","Мы ниспошлём","на них","с","неба","знамение","и станут","шеи их","перед ним","покорно склонёнными"]],[26,5,["وَمَا","يَأۡتِيهِم","مِّن","ذِكۡرٖ","مِّنَ","ٱلرَّحۡمَٰنِ","مُحۡدَثٍ","إِلَّا","كَانُواْ","عَنۡهُ","مُعۡرِضِينَ"],"вама йа'тиихим мин зикрим минар рахмани мухдасин илла кануу `анху му`ридиин","Какое бы новое напоминание ни приходило к ним от Милостивого, они отворачивались от него.",["и не","приходит к ним","никакое","напоминание","от","Милостивого","новое","кроме как","были они","от него","отворачивающимися"]],[26,6,["فَقَدۡ","كَذَّبُواْ","فَسَيَأۡتِيهِمۡ","أَنۢبَٰٓؤُاْ","مَا","كَانُواْ","بِهِۦ","يَسۡتَهۡزِءُونَ"],"фаḳад каззабуу фасайа'тиихим амбау ма кануу бихии йастахзиуун","Они сочли это ложью, и к ним придут вести о том, над чем они издевались.",["и вот уже","сочли ложью они","и придут к ним","вести","о том, что","бывало они","над ним","насмехаются"]],[26,7,["أَوَلَمۡ","يَرَوۡاْ","إِلَى","ٱلۡأَرۡضِ","كَمۡ","أَنۢبَتۡنَا","فِيهَا","مِن","كُلِّ","زَوۡجٖ","كَرِيمٍ"],"авалам йарау илал арди кам амбатна фииха мин кулли заужин кариим","Неужели они не видят, сколько Мы взрастили на земле благородных видов растений?",["неужели не","видели они","на","землю","сколько","Мы взрастили","на ней","из","всякого","вида","благородного"]],[26,8,["إِنَّ","فِي","ذَٰلِكَ","لَأٓيَةٗۖ","وَمَا","كَانَ","أَكۡثَرُهُم","مُّؤۡمِنِينَ"],"инна фии залика ла'айатан вама кана аксарухум му'миниин","Воистину, в этом - знамение, но большинство их не стали верующими.",["поистине","в","этом","непременно знамение","но не","было","большинство их","верующими"]],[26,9,["وَإِنَّ","رَبَّكَ","لَهُوَ","ٱلۡعَزِيزُ","ٱلرَّحِيمُ"],"ва'инна раббака лахуал `азиизур рахиим","Воистину, твой Господь - Могущественный, Милосердный.",["и поистине","Господь твой","непременно Он","Могущественный","Милосердный"]],[26,10,["وَإِذۡ","نَادَىٰ","رَبُّكَ","مُوسَىٰٓ","أَنِ","ٱئۡتِ","ٱلۡقَوۡمَ","ٱلظَّٰلِمِينَ"],"ва'из нада раббука мууса анитил ḳаумаз залимиин","Вот твой Господь воззвал к Мусе (Моисею): «Ступай к несправедливому народу -",["и вот","воззвал","Господь твой","к Мусе","что","ступай","к народу","несправедливому"]],[26,11,["قَوۡمَ","فِرۡعَوۡنَۚ","أَلَا","يَتَّقُونَ"],"ḳаума фир`ауна ала йаттаḳуун","к народу Фараона. Неужели они не устрашатся?».",["к народу","Фараона","неужели не","убоятся они"]],[26,12,["قَالَ","رَبِّ","إِنِّيٓ","أَخَافُ","أَن","يُكَذِّبُونِ"],"ḳала рабби иннии ахафу ан йуказзибуун","Он сказал: «Господи! Я боюсь, что они сочтут меня лжецом,",["сказал он","Господи","поистине, я","боюсь","что","сочтут они меня лжецом"]],[26,13,["وَيَضِيقُ","صَدۡرِي","وَلَا","يَنطَلِقُ","لِسَانِي","فَأَرۡسِلۡ","إِلَىٰ","هَٰرُونَ"],"вайадииḳу садрии вала йанталиḳу лисании фа'арсил ила харуун","что стеснится моя грудь и не развяжется мой язык. Пошли же за Харуном (Аароном).",["и стеснится","грудь моя","и не","развяжется","язык мой","пошли же","к","Харуну"]],[26,14,["وَلَهُمۡ","عَلَيَّ","ذَنۢبٞ","فَأَخَافُ","أَن","يَقۡتُلُونِ"],"валахум `алаййа замбун фа'ахафу ан йаḳтулуун","Я несу перед ними ответственность за грех и боюсь, что они убьют меня».",["и у них","против меня","вина","и боюсь я","что","убьют меня"]],[26,15,["قَالَ","كـَلَّاۖ","فَٱذۡهَبَا","بِـَٔايَٰتِنَآۖ","إِنَّا","مَعَكُم","مُّسۡتَمِعُونَ"],"ḳала калла фазхаба би'айатина инна ма`акум мустами`уун","Аллах сказал: «Нет! Ступайте вдвоем с Моими знамениями. Мы будем вместе с вами и будем слушать.",["сказал","отнюдь","ступайте же вдвоём","с Нашими знамениями","поистине, Мы","с вами","слушающие"]],[26,16,["فَأۡتِيَا","فِرۡعَوۡنَ","فَقُولَآ","إِنَّا","رَسُولُ","رَبِّ","ٱلۡعَٰلَمِينَ"],"фа'тийа фир`ауна фаḳуула инна расуулу раббил `аламиин","Придите вдвоем к Фараону и скажите: \"Мы посланы Господом миров.",["и придите вдвоём","к Фараону","и скажите","поистине, мы","посланник","Господа","миров"]],[26,17,["أَنۡ","أَرۡسِلۡ","مَعَنَا","بَنِيٓ","إِسۡرَٰٓءِيلَ"],"ан арсил ма`ана бании исраиил","Посему отпусти с нами сынов Исраила (Израиля)\"».",["чтобы","отпусти","с нами","сынов","Исраила"]],[26,18,["قَالَ","أَلَمۡ","نُرَبِّكَ","فِينَا","وَلِيدٗا","وَلَبِثۡتَ","فِينَا","مِنۡ","عُمُرِكَ","سِنِينَ"],"ḳала алам нураббика фиина валиидан валабиста фиина мин `умурика синиин","Фараон сказал: «Разве мы не воспитывали тебя среди нас с младенческих лет? Разве ты не оставался среди нас многие годы своей жизни.",["сказал","разве не","вырастили мы тебя","среди нас","ребёнком","и пробыл ты","среди нас","из","жизни твоей","годы"]],[26,19,["وَفَعَلۡتَ","فَعۡلَتَكَ","ٱلَّتِي","فَعَلۡتَ","وَأَنتَ","مِنَ","ٱلۡكَٰفِرِينَ"],"вафа`алта фа`латакал латии фа`алта ва'анта минал кафириин","Разве ты не совершил тот поступок, который ты совершил? Воистину, ты являешься одним из неблагодарных».",["и совершил ты","поступок твой","который","совершил ты","и ты","из","неблагодарных"]]],"m":[["b"],[["طسٓمٓ","Та. Син. Мим.",26,1],[1],["تِلۡكَ","это",26,2],["ءَايَٰتُ","аяты",26,2],["ٱلۡكِتَٰبِ","Писания",26,2],["ٱلۡمُبِينِ","ясного",26,2],[2],["لَعَلَّكَ","может быть, ты",26,3],["بَٰخِعٞ","губящий",26,3],["نَّفۡسَكَ","себя",26,3]],[["أَلَّا","оттого, что не",26,3],["يَكُونُواْ","являются они",26,3],["مُؤۡمِنِينَ","верующими",26,3],[3],["إِن","если",26,4],["نَّشَأۡ","Мы пожелаем",26,4],["نُنَزِّلۡ","Мы ниспошлём",26,4],["عَلَيۡهِم","на них",26,4],["مِّنَ","с",26,4],["ٱلسَّمَآءِ","неба",26,4],["ءَايَةٗ","знамение",26,4],["فَظَلَّتۡ","и станут",26,4]],[["أَعۡنَٰقُهُمۡ","шеи их",26,4],["لَهَا","перед ним",26,4],["خَٰضِعِينَ","покорно склонёнными",26,4],[4],["وَمَا","и не",26,5],["يَأۡتِيهِم","приходит к ним",26,5],["مِّن","никакое",26,5],["ذِكۡرٖ","напоминание",26,5],["مِّنَ","от",26,5],["ٱلرَّحۡمَٰنِ","Милостивого",26,5],["مُحۡدَثٍ","новое",26,5]],[["إِلَّا","кроме как",26,5],["كَانُواْ","были они",26,5],["عَنۡهُ","от него",26,5],["مُعۡرِضِينَ","отворачивающимися",26,5],[5],["فَقَدۡ","и вот уже",26,6],["كَذَّبُواْ","сочли ложью они",26,6],["فَسَيَأۡتِيهِمۡ","и придут к ним",26,6],["أَنۢبَٰٓؤُاْ","вести",26,6],["مَا","о том, что",26,6],["كَانُواْ","бывало они",26,6]],[["بِهِۦ","над ним",26,6],["يَسۡتَهۡزِءُونَ","насмехаются",26,6],[6],["أَوَلَمۡ","неужели не",26,7],["يَرَوۡاْ","видели они",26,7],["إِلَى","на",26,7],["ٱلۡأَرۡضِ","землю",26,7],["كَمۡ","сколько",26,7],["أَنۢبَتۡنَا","Мы взрастили",26,7],["فِيهَا","на ней",26,7],["مِن","из",26,7],["كُلِّ","всякого",26,7],["زَوۡجٖ","вида",26,7]],[["كَرِيمٍ","благородного",26,7],[7],["إِنَّ","поистине",26,8],["فِي","в",26,8],["ذَٰلِكَ","этом",26,8],["لَأٓيَةٗۖ","непременно знамение",26,8],["وَمَا","но не",26,8],["كَانَ","было",26,8],["أَكۡثَرُهُم","большинство их",26,8],["مُّؤۡمِنِينَ","верующими",26,8],[8],["وَإِنَّ","и поистине",26,9]],[["رَبَّكَ","Господь твой",26,9],["لَهُوَ","непременно Он",26,9],["ٱلۡعَزِيزُ","Могущественный",26,9],["ٱلرَّحِيمُ","Милосердный",26,9],[9],["وَإِذۡ","и вот",26,10],["نَادَىٰ","воззвал",26,10],["رَبُّكَ","Господь твой",26,10],["مُوسَىٰٓ","к Мусе",26,10],["أَنِ","что",26,10],["ٱئۡتِ","ступай",26,10],["ٱلۡقَوۡمَ","к народу",26,10]],[["ٱلظَّٰلِمِينَ","несправедливому",26,10],[10],["قَوۡمَ","к народу",26,11],["فِرۡعَوۡنَۚ","Фараона",26,11],["أَلَا","неужели не",26,11],["يَتَّقُونَ","убоятся они",26,11],[11],["قَالَ","сказал он",26,12],["رَبِّ","Господи",26,12],["إِنِّيٓ","поистине, я",26,12]