{"p":368,"j":19,"a":[[26,20,["قَالَ","فَعَلۡتُهَآ","إِذٗا","وَأَنَا۠","مِنَ","ٱلضَّآلِّينَ"],"ḳала фа`алтуха изан ва'ана минад даллиин","Он сказал: «Я совершил это, когда был в числе заблудших,",["сказал","совершил я его","тогда","и я (был)","из","заблудших"]],[26,21,["فَفَرَرۡتُ","مِنكُمۡ","لَمَّا","خِفۡتُكُمۡ","فَوَهَبَ","لِي","رَبِّي","حُكۡمٗا","وَجَعَلَنِي","مِنَ","ٱلۡمُرۡسَلِينَ"],"фафарарту минкум ламма хифтукум фавахаба лии раббии хукман важа`алании минал мурсалиин","Я сбежал от вас, когда испугался вас, но мой Господь даровал мне власть (пророчество или знание) и сделал меня одним из посланников.",["и бежал я","от вас","когда","испугался я вас","и даровал","мне","Господь мой","мудрость","и сделал меня","из","посланников"]],[26,22,["وَتِلۡكَ","نِعۡمَةٞ","تَمُنُّهَا","عَلَيَّ","أَنۡ","عَبَّدتَّ","بَنِيٓ","إِسۡرَٰٓءِيلَ"],"ватилка ни`матун тамуннуха `алаййа ан `аббадтта бании исраиил","А та милость, в которой ты меня попрекаешь, состоит в том, что ты поработил сынов Исраила (Израиля)».",["и это","милость","попрекаешь ею","меня","что","поработил ты","сынов","Исраила"]],[26,23,["قَالَ","فِرۡعَوۡنُ","وَمَا","رَبُّ","ٱلۡعَٰلَمِينَ"],"ḳала фир`ауну вама раббул `аламиин","Фараон сказал: «А что такое Господь миров?».",["сказал","Фараон","а что (такое)","Господь","миров"]],[26,24,["قَالَ","رَبُّ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِ","وَمَا","بَيۡنَهُمَآۖ","إِن","كُنتُم","مُّوقِنِينَ"],"ḳала раббус самавати вал'арди вама байнахума ин кунтум мууḳиниин","Муса сказал: «Господь небес, земли и того, что между ними, если только вы обладаете убежденностью».",["сказал","Господь","небес","и земли","и того, что","между ними","если","являетесь вы","убеждёнными"]],[26,25,["قَالَ","لِمَنۡ","حَوۡلَهُۥٓ","أَلَا","تَسۡتَمِعُونَ"],"ḳала лиман хаулахуу ала тастами`уун","Фараон сказал тем, кто был около него: «Разве вы не слышите?».",["сказал","тем, кто","вокруг него","разве не","слышите вы"]],[26,26,["قَالَ","رَبُّكُمۡ","وَرَبُّ","ءَابَآئِكُمُ","ٱلۡأَوَّلِينَ"],"ḳала раббукум вараббу абаикумул аввалиин","Муса сказал: «Ваш Господь и Господь ваших праотцев».",["сказал","Господь ваш","и Господь","отцов ваших","первых"]],[26,27,["قَالَ","إِنَّ","رَسُولَكُمُ","ٱلَّذِيٓ","أُرۡسِلَ","إِلَيۡكُمۡ","لَمَجۡنُونٞ"],"ḳала инна расуулакумул лазии урсила илайкум ламажнуун","Фараон сказал: «Воистину, отправленный к вам посланник - одержимый».",["сказал","поистине","посланник ваш","который","послан","к вам","непременно одержимый"]],[26,28,["قَالَ","رَبُّ","ٱلۡمَشۡرِقِ","وَٱلۡمَغۡرِبِ","وَمَا","بَيۡنَهُمَآۖ","إِن","كُنتُمۡ","تَعۡقِلُونَ"],"ḳала раббул машриḳи валмагриби вама байнахума ин кунтум та`ḳилуун","Муса сказал: «Господь востока и запада и того, что между ними, если только вы разумеете».",["сказал","Господь","востока","и запада","и того, что","между ними","если","являетесь вы","разумеете"]],[26,29,["قَالَ","لَئِنِ","ٱتَّخَذۡتَ","إِلَٰهًا","غَيۡرِي","لَأَجۡعَلَنَّكَ","مِنَ","ٱلۡمَسۡجُونِينَ"],"ḳала ла'иниттахазта илахан гайрии ла'аж`аланнака минал масжууниин","Фараон сказал: «Если ты будешь поклоняться иному богу, кроме меня, то я помещу тебя вместе с заключенными».",["сказал","если же","возьмёшь ты","бога","кроме меня","непременно сделаю я тебя","из","заключённых"]],[26,30,["قَالَ","أَوَلَوۡ","جِئۡتُكَ","بِشَيۡءٖ","مُّبِينٖ"],"ḳала авалау жи'тука бишай'им мубиин","Муса сказал: «А если я покажу тебе нечто явное?».",["сказал","а даже если","приду я к тебе","с чем-то","явным"]],[26,31,["قَالَ","فَأۡتِ","بِهِۦٓ","إِن","كُنتَ","مِنَ","ٱلصَّٰدِقِينَ"],"ḳала фа'ти бихии ин кунта минас садиḳиин","Фараон сказал: «Так покажи нам это, если ты - один из тех, кто говорит правду».",["сказал","так приди","с ним","если","являешься ты","из","правдивых"]],[26,32,["فَأَلۡقَىٰ","عَصَاهُ","فَإِذَا","هِيَ","ثُعۡبَانٞ","مُّبِينٞ"],"фа'алḳа `асаху фа'иза хийа су`банум мубиин","Муса бросил свой посох, и тот превратился в явную змею.",["и бросил он","посох свой","и вот","он","змей","явный"]],[26,33,["وَنَزَعَ","يَدَهُۥ","فَإِذَا","هِيَ","بَيۡضَآءُ","لِلنَّٰظِرِينَ"],"ваназа`а йадахуу фа'иза хийа байдау линназириин","Он вынул свою руку, и она стала белой (цвета молока, светящейся) для тех, кто смотрел на нее.",["и вынул он","руку свою","и вот","она","белая","для смотрящих"]],[26,34,["قَالَ","لِلۡمَلَإِ","حَوۡلَهُۥٓ","إِنَّ","هَٰذَا","لَسَٰحِرٌ","عَلِيمٞ"],"ḳала лилмалаи хаулахуу инна хаза ласахирун `алиим","Фараон сказал стоявшим вокруг него приближенным: «Воистину, он - знающий колдун.",["сказал","знати","вокруг него","поистине","этот","непременно колдун","знающий"]],[26,35,["يُرِيدُ","أَن","يُخۡرِجَكُم","مِّنۡ","أَرۡضِكُم","بِسِحۡرِهِۦ","فَمَاذَا","تَأۡمُرُونَ"],"йурииду ан йухрижакум мин ардикум бисихрихии фамаза та'муруун","Он хочет своим колдовством вывести вас из вашей страны. Что же вы прикажете делать?».",["хочет он","чтобы","вывести вас","из","земли вашей","колдовством своим","так что же","повелеваете вы"]],[26,36,["قَالُوٓاْ","أَرۡجِهۡ","وَأَخَاهُ","وَٱبۡعَثۡ","فِي","ٱلۡمَدَآئِنِ","حَٰشِرِينَ"],"ḳалуу аржих ва'ахаху ваб`ас фил мадаини хашириин","Они сказали: «Повремени с ним и его братом и разошли по городам сборщиков,",["сказали они","повремени с ним","и с братом его","и пошли","в","города","сборщиков"]],[26,37,["يَأۡتُوكَ","بِكُلِّ","سَحَّارٍ","عَلِيمٖ"],"йа'туука бикулли саххарин `алиим","чтобы они привели к тебе всех знающих колдунов».",["приведут они к тебе","всякого","колдуна","знающего"]],[26,38,["فَجُمِعَ","ٱلسَّحَرَةُ","لِمِيقَٰتِ","يَوۡمٖ","مَّعۡلُومٖ"],"фажуми`ас сахарату лимииḳати йаумим ма`луум","Колдунов собрали в назначенное время в назначенный день.",["и собраны были","колдуны","к сроку","дня","известного"]],[26,39,["وَقِيلَ","لِلنَّاسِ","هَلۡ","أَنتُم","مُّجۡتَمِعُونَ"],"ваḳиила линнаси хал антум мужтами`уун","Людям сказали: «Собрались ли вы?",["и сказано было","людям","ли","вы","собравшиеся"]]],"m":[[["قَالَ","сказал",26,20],["فَعَلۡتُهَآ","совершил я его",26,20],["إِذٗا","тогда",26,20],["وَأَنَا۠","и я (был)",26,20],["مِنَ","из",26,20],["ٱلضَّآلِّينَ","заблудших",26,20],[20],["فَفَرَرۡتُ","и бежал я",26,21],["مِنكُم