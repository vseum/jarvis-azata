{"p":369,"j":19,"a":[[26,40,["لَعَلَّنَا","نَتَّبِعُ","ٱلسَّحَرَةَ","إِن","كَانُواْ","هُمُ","ٱلۡغَٰلِبِينَ"],"ла`аллана наттаби`ус сахарата ин кануу хумул галибиин","Возможно, нам придется последовать за колдунами, если они одержат верх».",["чтобы мы","последовали","за колдунами","если","окажутся","они","победителями"]],[26,41,["فَلَمَّا","جَآءَ","ٱلسَّحَرَةُ","قَالُواْ","لِفِرۡعَوۡنَ","أَئِنَّ","لَنَا","لَأَجۡرًا","إِن","كُنَّا","نَحۡنُ","ٱلۡغَٰلِبِينَ"],"фаламма жаас сахарату ḳалуу лифир`ауна а'инна лана ла'ажран ин кунна нахнул галибиин","Явившись, колдуны сказали Фараону: «Будет ли нам награда, если мы одержим верх?».",["и когда","пришли","колдуны","сказали они","Фараону","разве","нам","непременно награда","если","окажемся","мы","победителями"]],[26,42,["قَالَ","نَعَمۡ","وَإِنَّكُمۡ","إِذٗا","لَّمِنَ","ٱلۡمُقَرَّبِينَ"],"ḳала на`ам ва'иннакум изал ламинал муḳаррабиин","Он сказал: «Да. В этом случае вы непременно окажетесь в числе приближенных».",["сказал","да","и поистине, вы","тогда","непременно из","приближённых"]],[26,43,["قَالَ","لَهُم","مُّوسَىٰٓ","أَلۡقُواْ","مَآ","أَنتُم","مُّلۡقُونَ"],"ḳала лахум мууса алḳуу ма антум мулḳуун","Муса (Моисей) сказал им: «Бросайте то, что вы собираетесь бросить».",["сказал","им","Муса","бросайте","то, что","вы","бросающие"]],[26,44,["فَأَلۡقَوۡاْ","حِبَالَهُمۡ","وَعِصِيَّهُمۡ","وَقَالُواْ","بِعِزَّةِ","فِرۡعَوۡنَ","إِنَّا","لَنَحۡنُ","ٱلۡغَٰلِبُونَ"],"фа'алḳау хибалахум ва`исиййахум ваḳалуу би`иззати фир`ауна инна ланахнул галибуун","Они бросили свои веревки и посохи и сказали: «Во имя могущества Фараона! Мы непременно одержим верх!».",["и бросили они","верёвки свои","и посохи свои","и сказали","клянёмся могуществом","Фараона","поистине, мы","непременно мы","победители"]],[26,45,["فَأَلۡقَىٰ","مُوسَىٰ","عَصَاهُ","فَإِذَا","هِيَ","تَلۡقَفُ","مَا","يَأۡفِكُونَ"],"фа'алḳа мууса `асаху фа'иза хийа талḳафу ма йа'фикуун","Затем Муса (Моисей) бросил свой посох, и тот проглотил все, что они лживо измыслили.",["и бросил","Муса","посох свой","и вот","он","поглощает","то, что","измышляют они"]],[26,46,["فَأُلۡقِيَ","ٱلسَّحَرَةُ","سَٰجِدِينَ"],"фа'улḳийас сахарату сажидиин","Тогда колдуны пали ниц",["и пали","колдуны","падающими ниц"]],[26,47,["قَالُوٓاْ","ءَامَنَّا","بِرَبِّ","ٱلۡعَٰلَمِينَ"],"ḳалуу аманна бираббил `аламиин","и сказали: «Мы уверовали в Господа миров,",["сказали они","уверовали мы","в Господа","миров"]],[26,48,["رَبِّ","مُوسَىٰ","وَهَٰرُونَ"],"рабби мууса вахаруун","Господа Мусы (Моисея) и Харуна (Аарона)».",["Господа","Мусы","и Харуна"]],[26,49,["قَالَ","ءَامَنتُمۡ","لَهُۥ","قَبۡلَ","أَنۡ","ءَاذَنَ","لَكُمۡۖ","إِنَّهُۥ","لَكَبِيرُكُمُ","ٱلَّذِي","عَلَّمَكُمُ","ٱلسِّحۡرَ","فَلَسَوۡفَ","تَعۡلَمُونَۚ","لَأُقَطِّعَنَّ","أَيۡدِيَكُمۡ","وَأَرۡجُلَكُم","مِّنۡ","خِلَٰفٖ","وَلَأُصَلِّبَنَّكُمۡ","أَجۡمَعِينَ"],"ḳала амантум лахуу ḳабла ан азана лакум иннахуу лакабиирукумул лазии `алламакумус сихра фаласауфа та`ламууна ла'уḳатти`анна айдийакум ва'аржулакум мин хилафин валаусаллибаннакум ажма`иин","Он сказал: «Неужели вы поверили ему до того, как я позволил вам? Воистину, он - старший из вас, который научил вас колдовству! Но скоро вы узнаете! Я отрублю вам руки и ноги накрест и распну вас всех!».",["сказал","уверовали вы","ему","прежде","чем","позволю я","вам","поистине, он","непременно старший ваш","который","научил вас","колдовству","и непременно скоро","узнаете вы","непременно отрублю я","руки ваши","и ноги ваши","с","противоположных сторон","и непременно распну я вас","всех"]],[26,50,["قَالُواْ","لَا","ضَيۡرَۖ","إِنَّآ","إِلَىٰ","رَبِّنَا","مُنقَلِبُونَ"],"ḳалуу ла дайра инна ила раббина мунḳалибуун","Они сказали: «Не беда! Воистину, мы возвратимся к нашему Господу.",["сказали они","нет","беды","поистине, мы","к","Господу нашему","возвращающиеся"]],[26,51,["إِنَّا","نَطۡمَعُ","أَن","يَغۡفِرَ","لَنَا","رَبُّنَا","خَطَٰيَٰنَآ","أَن","كُنَّآ","أَوَّلَ","ٱلۡمُؤۡمِنِينَ"],"инна натма`у ан йагфира лана раббуна хатайана ан кунна аввалал му'миниин","Мы жаждем, чтобы наш Господь простил нам наши грехи за то, что мы стали первыми верующими».",["поистине, мы","жаждем","что","простит","нам","Господь наш","прегрешения наши","за то, что","стали мы","первыми","из верующих"]],[26,52,["وَأَوۡحَيۡنَآ","إِلَىٰ","مُوسَىٰٓ","أَنۡ","أَسۡرِ","بِعِبَادِيٓ","إِنَّكُم","مُّتَّبَعُونَ"],"ва'аухайна ила мууса ан асри би`ибадии иннакум муттаба`уун","Мы внушили Мусе (Моисею): «Отправляйся в путь с Моими рабами ночью, ибо вас будут преследовать».",["и внушили Мы","к","Мусе","что","выйди ночью","с рабами Моими","поистине, вы","преследуемые"]],[26,53,["فَأَرۡسَلَ","فِرۡعَوۡنُ","فِي","ٱلۡمَدَآئِنِ","حَٰشِرِينَ"],"фа'арсала фир`ауну фил мадаини хашириин","Фараон разослал по городам сборщиков.",["и послал","Фараон","по","городам","сборщиков"]],[26,54,["إِنَّ","هَٰٓؤُلَآءِ","لَشِرۡذِمَةٞ","قَلِيلُونَ"],"инна ха'улаи лаширзиматун ḳалиилуун","Он сказал: «Это - всего лишь малочисленная кучка.",["поистине","эти","непременно кучка","малочисленная"]],[26,55,["وَإِنَّهُمۡ","لَنَا","لَغَآئِظُونَ"],"ва'иннахум лана лагаизуун","Они разгневали нас,",["и поистине, они","нас","непременно гневят"]],[26,56,["وَإِنَّا","لَجَمِيعٌ","حَٰذِرُونَ"],"ва'инна лажамии`ун хазируун","и мы все должны быть настороже».",["и поистине, мы","непременно все","настороже"]],[26,57,["فَأَخۡرَجۡنَٰهُم","مِّن","جَنَّٰتٖ","وَعُيُونٖ"],"фа'ахражнахум мин жаннатин ва`уйуун","Мы вынудили их покинуть сады и источники,",["и вывели Мы их","из","садов","и источников"]],[26,58,["وَكُنُوزٖ","وَمَقَامٖ","كَرِيمٖ"],"вакунуузин вамаḳамин кариим","сокровища и благородные места.",["и сокровищ","и места","благородного"]],[26,59,["كَذَٰلِكَۖ","وَأَوۡرَثۡنَٰهَا","بَنِيٓ","إِسۡرَٰٓءِيلَ"],"казалика ва'аураснаха бании исраиил","Вот так! Мы позволили унаследовать это сынам Исраила (Израиля).",["так","и дали Мы унаследовать их","сынам","Исраила"]],[26,60,["فَأَتۡبَعُوهُم","مُّشۡرِقِينَ"],"фа'атба`уухум мушриḳиин","Они последовали за ними на восходе.",["и последовали они за ними","на восходе"]]],"m":[[["لَعَلَّنَا","чтобы мы",26,40]