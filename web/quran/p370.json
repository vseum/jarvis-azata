{"p":370,"j":19,"a":[[26,61,["فَلَمَّا","تَرَٰٓءَا","ٱلۡجَمۡعَانِ","قَالَ","أَصۡحَٰبُ","مُوسَىٰٓ","إِنَّا","لَمُدۡرَكُونَ"],"фаламмаа тараа'аа лджам`аани каала асхаабу муусаа иннаа ламудракуун","Когда два сборища увидели друг друга, сподвижники Мусы (Моисея) сказали: «Нас непременно настигнут».",["и когда","увидели друг друга","два сборища","сказали","сподвижники","Мусы","поистине, мы","непременно настигнутые"]],[26,62,["قَالَ","كـَلَّآۖ","إِنَّ","مَعِيَ","رَبِّي","سَيَهۡدِينِ"],"каала каллаа инна ма`ийа раббии сайахдиин","Он сказал: «О нет! Со мной - мой Господь, и Он укажет мне прямой путь».",["сказал","нет же","поистине","со мной","мой Господь","Он наставит меня"]],[26,63,["فَأَوۡحَيۡنَآ","إِلَىٰ","مُوسَىٰٓ","أَنِ","ٱضۡرِب","بِّعَصَاكَ","ٱلۡبَحۡرَۖ","فَٱنفَلَقَ","فَكَانَ","كُلُّ","فِرۡقٖ","كَٱلطَّوۡدِ","ٱلۡعَظِيمِ"],"фа'аухайнаа илаа муусаа ани дриб бби`асаака лбахра фанфалака факаана куллу фиркин каттауди л`азиим","Тогда Мы внушили Мусе (Моисею): «Ударь своим посохом по морю». Оно разверзлось, и каждая часть его стала подобна огромной горе.",["и внушили Мы","к","Мусе","что","ударь","посохом своим","море","и разверзлось оно","и стала","каждая","часть","как гора","огромная"]],[26,64,["وَأَزۡلَفۡنَا","ثَمَّ","ٱلۡأٓخَرِينَ"],"уа'азлафнаа самма л'хариин","Мы приблизили к нему других (войско Фараона).",["и приблизили Мы","туда","других"]],[26,65,["وَأَنجَيۡنَا","مُوسَىٰ","وَمَن","مَّعَهُۥٓ","أَجۡمَعِينَ"],"уа'анджайнаа муусаа уамам ма`ахуу аджма`иин","Мы спасли Мусу (Моисея) и тех, кто был с ним,",["и спасли Мы","Мусу","и тех, кто","с ним","всех"]],[26,66,["ثُمَّ","أَغۡرَقۡنَا","ٱلۡأٓخَرِينَ"],"сумма агракнаа л'хариин","а затем потопили всех остальных.",["затем","потопили Мы","других"]],[26,67,["إِنَّ","فِي","ذَٰلِكَ","لَأٓيَةٗۖ","وَمَا","كَانَ","أَكۡثَرُهُم","مُّؤۡمِنِينَ"],"инна фии заалика ла'йатан уамаа каана аксарухум мму'миниин","Воистину, в этом - знамение, но большинство их не стали верующими.",["поистине","в","этом","непременно знамение","и не","были","большинство их","верующими"]],[26,68,["وَإِنَّ","رَبَّكَ","لَهُوَ","ٱلۡعَزِيزُ","ٱلرَّحِيمُ"],"уа'инна раббака лахууа л`азиизу ррахиим","Воистину, твой Господь - Могущественный, Милосердный.",["и поистине","Господь твой","непременно Он","Могущественный","Милосердный"]],[26,69,["وَٱتۡلُ","عَلَيۡهِمۡ","نَبَأَ","إِبۡرَٰهِيمَ"],"уатлу `алайхим наба'а ибраахиим","Прочти им историю Ибрахима (Авраама).",["и прочитай","им","весть","об Ибрахиме"]],[26,70,["إِذۡ","قَالَ","لِأَبِيهِ","وَقَوۡمِهِۦ","مَا","تَعۡبُدُونَ"],"из каала ли'абиихи уакаумихии маа та`будуун","Вот он сказал своему отцу и своему народу: «Чему вы поклоняетесь?».",["вот","сказал он","отцу своему","и народу своему","чему","поклоняетесь вы"]],[26,71,["قَالُواْ","نَعۡبُدُ","أَصۡنَامٗا","فَنَظَلُّ","لَهَا","عَٰكِفِينَ"],"каалуу на`буду аснааман фаназаллу лахаа `аакифиин","Они сказали: «Мы поклоняемся идолам и постоянно предаемся им».",["сказали они","поклоняемся мы","идолам","и остаёмся мы","им","преданными"]],[26,72,["قَالَ","هَلۡ","يَسۡمَعُونَكُمۡ","إِذۡ","تَدۡعُونَ"],"каала хал йасма`уунакум из тад`уун","Он сказал: «Слышат ли они, когда вы взываете к ним?",["сказал","разве","слышат они вас","когда","взываете вы"]],[26,73,["أَوۡ","يَنفَعُونَكُمۡ","أَوۡ","يَضُرُّونَ"],"ау йанфа`уунакум ау йадурруун","Помогают ли они вам? И причиняют ли они вред?».",["или","приносят пользу вам","или","вредят"]],[26,74,["قَالُواْ","بَلۡ","وَجَدۡنَآ","ءَابَآءَنَا","كَذَٰلِكَ","يَفۡعَلُونَ"],"каалуу бал уаджаднаа аабаа'анаа казаалика йаф`алуун","Они сказали: «Но мы видели, что наши отцы поступали таким образом».",["сказали","нет","нашли мы","наших отцов","так","поступают"]],[26,75,["قَالَ","أَفَرَءَيۡتُم","مَّا","كُنتُمۡ","تَعۡبُدُونَ"],"каала афара'айтум ммаа кунтум та`будуун","Он сказал: «Видели ли вы, чему поклоняетесь",["сказал","видели ли вы","то, чему","были вы","поклоняющимися"]],[26,76,["أَنتُمۡ","وَءَابَآؤُكُمُ","ٱلۡأَقۡدَمُونَ"],"антум уа'аабаа'укуму л'акдамуун","вы со своими древними отцами?",["вы","и отцы ваши","древние"]],[26,77,["فَإِنَّهُمۡ","عَدُوّٞ","لِّيٓ","إِلَّا","رَبَّ","ٱلۡعَٰلَمِينَ"],"фа'иннахум `адуууул лии иллаа рабба л`ааламиин","Все они - враги мои, кроме Господа миров,",["и поистине, они","враг","мне","кроме","Господа","миров"]],[26,78,["ٱلَّذِي","خَلَقَنِي","فَهُوَ","يَهۡدِينِ"],"аллазии халакании фахууа йахдиин","Который сотворил меня и ведет прямым путем,",["Который","сотворил меня","и Он","наставляет меня"]],[26,79,["وَٱلَّذِي","هُوَ","يُطۡعِمُنِي","وَيَسۡقِينِ"],"уаллазии хууа йут`имунии уайаскиин","Который кормит меня и поит,",["и Который","Он","кормит меня","и поит меня"]],[26,80,["وَإِذَا","مَرِضۡتُ","فَهُوَ","يَشۡفِينِ"],"уа'изаа маридту фахууа йашфиин","Который исцеляет меня, когда я заболеваю,",["и когда","заболею я","то Он","исцеляет меня"]],[26,81,["وَٱلَّذِي","يُمِيتُنِي","ثُمَّ","يُحۡيِينِ"],"уаллазии йумиитунии сумма йухйиин","Который умертвит меня, а потом воскресит,",["и Который","умертвит меня","затем","оживит меня"]],[26,82,["وَٱلَّذِيٓ","أَطۡمَعُ","أَن","يَغۡفِرَ","لِي","خَطِيٓـَٔتِي","يَوۡمَ","ٱلدِّينِ"],"уаллазии атма`у ан йагфира лии хатии'атии йаума ддиин","Который, я надеюсь, простит мой грех в День воздаяния.",["и Который","надеюсь я","что","простит Он","мне","прегрешение моё","в День","воздаяния"]],[26,83,["رَبِّ","هَبۡ","لِي","حُكۡمٗا","وَأَلۡحِقۡنِي","بِٱلصَّٰلِحِينَ"],"рабби хаб лии хукман уа'алхикнии биссаалихиин","Господи! Даруй мне власть (пророчество или знание) и воссоедини меня с праведниками!",["Господи","даруй","мне","мудрость","и присоедини меня","к праведникам"]]]}