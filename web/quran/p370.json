{"p":370,"j":19,"a":[[26,61,["فَلَمَّا","تَرَٰٓءَا","ٱلۡجَمۡعَانِ","قَالَ","أَصۡحَٰبُ","مُوسَىٰٓ","إِنَّا","لَمُدۡرَكُونَ"],"фаламма тараал жам`ани ḳала асхабу мууса инна ламудракуун","Когда два сборища увидели друг друга, сподвижники Мусы (Моисея) сказали: «Нас непременно настигнут».",["и когда","увидели друг друга","два сборища","сказали","сподвижники","Мусы","поистине, мы","непременно настигнутые"]],[26,62,["قَالَ","كـَلَّآۖ","إِنَّ","مَعِيَ","رَبِّي","سَيَهۡدِينِ"],"ḳала калла инна ма`ийа раббии сайахдиин","Он сказал: «О нет! Со мной - мой Господь, и Он укажет мне прямой путь».",["сказал","нет же","поистине","со мной","мой Господь","Он наставит меня"]],[26,63,["فَأَوۡحَيۡنَآ","إِلَىٰ","مُوسَىٰٓ","أَنِ","ٱضۡرِب","بِّعَصَاكَ","ٱلۡبَحۡرَۖ","فَٱنفَلَقَ","فَكَانَ","كُلُّ","فِرۡقٖ","كَٱلطَّوۡدِ","ٱلۡعَظِيمِ"],"фа'аухайна ила мууса анидриб бби`асакал бахра фанфалаḳа факана куллу фирḳин каттаудил `азиим","Тогда Мы внушили Мусе (Моисею): «Ударь своим посохом по морю». Оно разверзлось, и каждая часть его стала подобна огромной горе.",["и внушили Мы","к","Мусе","что","ударь","посохом своим","море","и разверзлось оно","и стала","каждая","часть","как гора","огромная"]],[26,64,["وَأَزۡلَفۡنَا","ثَمَّ","ٱلۡأٓخَرِينَ"],"ва'азлафна саммал ахариин","Мы приблизили к нему других (войско Фараона).",["и приблизили Мы","туда","других"]],[26,65,["وَأَنجَيۡنَا","مُوسَىٰ","وَمَن","مَّعَهُۥٓ","أَجۡمَعِينَ"],"ва'анжайна мууса вамам ма`ахуу ажма`иин","Мы спасли Мусу (Моисея) и тех, кто был с ним,",["и спасли Мы","Мусу","и тех, кто","с ним","всех"]],[26,66,["ثُمَّ","أَغۡرَقۡنَا","ٱلۡأٓخَرِينَ"],"сумма аграḳнал ахариин","а затем потопили всех остальных.",["затем","потопили Мы","других"]],[26,67,["إِنَّ","فِي","ذَٰلِكَ","لَأٓيَةٗۖ","وَمَا","كَانَ","أَكۡثَرُهُم","مُّؤۡمِنِينَ"],"инна фии залика ла'айатан вама кана аксарухум му'миниин","Воистину, в этом - знамение, но большинство их не стали верующими.",["поистине","в","этом","непременно знамение","и не","были","большинство их","верующими"]],[26,68,["وَإِنَّ","رَبَّكَ","لَهُوَ","ٱلۡعَزِيزُ","ٱلرَّحِيمُ"],"ва'инна раббака лахуал `азиизур рахиим","Воистину, твой Господь - Могущественный, Милосердный.",["и поистине","Господь твой","непременно Он","Могущественный","Милосердный"]],[26,69,["وَٱتۡلُ","عَلَيۡهِمۡ","نَبَأَ","إِبۡرَٰهِيمَ"],"ватлу `алайхим набаа ибрахиим","Прочти им историю Ибрахима (Авраама).",["и прочитай","им","весть","об Ибрахиме"]],[26,70,["إِذۡ","قَالَ","لِأَبِيهِ","وَقَوۡمِهِۦ","مَا","تَعۡبُدُونَ"],"из ḳала ли'абиихи ваḳаумихии ма та`будуун","Вот он сказал своему отцу и своему народу: «Чему вы поклоняетесь?».",["вот","сказал он","отцу своему","и народу своему","чему","поклоняетесь вы"]],[26,71,["قَالُواْ","نَعۡبُدُ","أَصۡنَامٗا","فَنَظَلُّ","لَهَا","عَٰكِفِينَ"],"ḳалуу на`буду аснаман фаназаллу лаха `акифиин","Они сказали: «Мы поклоняемся идолам и постоянно предаемся им».",["сказали они","поклоняемся мы","идолам","и остаёмся мы","им","преданными"]],[26,72,["قَالَ","هَلۡ","يَسۡمَعُونَكُمۡ","إِذۡ","تَدۡعُونَ"],"ḳала хал йасма`уунакум из тад`уун","Он сказал: «Слышат ли они, когда вы взываете к ним?",["сказал","разве","слышат они вас","когда","взываете вы"]],[26,73,["أَوۡ","يَنفَعُونَكُمۡ","أَوۡ","يَضُرُّونَ"],"ау йанфа`уунакум ау йадурруун","Помогают ли они вам? И причиняют ли они вред?».",["или","приносят пользу вам","или","вредят"]],[26,74,["قَالُواْ","بَلۡ","وَجَدۡنَآ","ءَابَآءَنَا","كَذَٰلِكَ","يَفۡعَلُونَ"],"ḳалуу бал важадна абаана казалика йаф`алуун","Они сказали: «Но мы видели, что наши отцы поступали таким образом».",["сказали","нет","нашли мы","наших отцов","так","поступают"]],[26,75,["قَالَ","أَفَرَءَيۡتُم","مَّا","كُنتُمۡ","تَعۡبُدُونَ"],"ḳала афараайтум ма кунтум та`будуун","Он сказал: «Видели ли вы, чему поклоняетесь",["сказал","видели ли вы","то, чему","были вы","поклоняющимися"]],[26,76,["أَنتُمۡ","وَءَابَآؤُكُمُ","ٱلۡأَقۡدَمُونَ"],"антум ва'абаукумул аḳдамуун","вы со своими древними отцами?",["вы","и отцы ваши","древние"]],[26,77,["فَإِنَّهُمۡ","عَدُوّٞ","لِّيٓ","إِلَّا","رَبَّ","ٱلۡعَٰلَمِينَ"],"фа'иннахум `адуввул лии илла раббал `аламиин","Все они - враги мои, кроме Господа миров,",["и поистине, они","враг","мне","кроме","Господа","миров"]],[26,78,["ٱلَّذِي","خَلَقَنِي","فَهُوَ","يَهۡدِينِ"],"аллазии халаḳании фахуа йахдиин","Который сотворил меня и ведет прямым путем,",["Который","сотворил меня","и Он","наставляет меня"]],[26,79,["وَٱلَّذِي","هُوَ","يُطۡعِمُنِي","وَيَسۡقِينِ"],"валлазии хуа йут`имунии вайасḳиин","Который кормит меня и поит,",["и Который","Он","кормит меня","и поит меня"]],[26,80,["وَإِذَا","مَرِضۡتُ","فَهُوَ","يَشۡفِينِ"],"ва'иза маридту фахуа йашфиин","Который исцеляет меня, когда я заболеваю,",["и когда","заболею я","то Он","исцеляет меня"]],[26,81,["وَٱلَّذِي","يُمِيتُنِي","ثُمَّ","يُحۡيِينِ"],"валлазии йумиитунии сумма йухйиин","Который умертвит меня, а потом воскресит,",["и Который","умертвит меня","затем","оживит меня"]],[26,82,["وَٱلَّذِيٓ","أَطۡمَعُ","أَن","يَغۡفِرَ","لِي","خَطِيٓـَٔتِي","يَوۡمَ","ٱلدِّينِ"],"валлазии атма`у ан йагфира лии хатииатии йаумад диин","Который, я надеюсь, простит мой грех в День воздаяния.",["и Который","надеюсь я","что","простит Он","мне","прегрешение моё","в День","воздаяния"]],[26,83,["رَبِّ","هَبۡ","لِي","حُكۡمٗا","وَأَلۡحِقۡنِي","بِٱلصَّٰلِحِينَ"],"рабби хаб лии хукман ва'алхиḳнии биссалихиин","Господи! Даруй мне власть (пророчество или знание) и воссоедини меня с праведниками!",["Господи","даруй","мне","мудрость","и присоедини меня","к праведникам"]]]}