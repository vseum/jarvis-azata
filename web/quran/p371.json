{"p":371,"j":19,"a":[[26,84,["وَٱجۡعَل","لِّي","لِسَانَ","صِدۡقٖ","فِي","ٱلۡأٓخِرِينَ"],"уадж`ал ллии лисаана сидкин фии л'хириин","Оставь обо мне правдивую молву в последующих поколениях!",["и сделай","мне","язык","правды","среди","последующих"]],[26,85,["وَٱجۡعَلۡنِي","مِن","وَرَثَةِ","جَنَّةِ","ٱلنَّعِيمِ"],"уадж`алнии мин уарасати джаннати нна`иим","Сделай меня одним из наследников Сада блаженства!",["и сделай меня","из","наследников","Сада","блаженства"]],[26,86,["وَٱغۡفِرۡ","لِأَبِيٓ","إِنَّهُۥ","كَانَ","مِنَ","ٱلضَّآلِّينَ"],"уагфир ли'абии иннахуу каана мина ддааллиин","Прости моего отца, ибо он был одним из заблудших!",["и прости","моему отцу","поистине, он","был","из","заблудших"]],[26,87,["وَلَا","تُخۡزِنِي","يَوۡمَ","يُبۡعَثُونَ"],"уалаа тухзинии йаума йуб`асуун","И не позорь меня в День воскресения -",["и не","позорь меня","в день","будут воскрешены они"]],[26,88,["يَوۡمَ","لَا","يَنفَعُ","مَالٞ","وَلَا","بَنُونَ"],"йаума лаа йанфа`у маалун уалаа бануун","в тот день, когда ни богатство, ни сыновья не принесут пользы никому,",["в день","не","поможет","богатство","и не","сыновья"]],[26,89,["إِلَّا","مَنۡ","أَتَى","ٱللَّهَ","بِقَلۡبٖ","سَلِيمٖ"],"иллаа ман атаа ллаха бикалбин салиим","кроме тех, которые предстанут перед Аллахом с непорочным сердцем».",["кроме","того, кто","придёт","к Аллаху","с сердцем","непорочным"]],[26,90,["وَأُزۡلِفَتِ","ٱلۡجَنَّةُ","لِلۡمُتَّقِينَ"],"уа'узлифати лджаннату лилмуттакиин","Рай будет приближен к богобоязненным,",["и приближен будет","Рай","для богобоязненных"]],[26,91,["وَبُرِّزَتِ","ٱلۡجَحِيمُ","لِلۡغَاوِينَ"],"уабурризати лджахииму лилгаауиин","а Ад будет ясно показан заблудшим.",["и выставлен будет","Ад","для заблудших"]],[26,92,["وَقِيلَ","لَهُمۡ","أَيۡنَ","مَا","كُنتُمۡ","تَعۡبُدُونَ"],"уакиила лахум айна маа кунтум та`будуун","Им скажут: «Где же те, кому вы поклонялись",["и сказано будет","им","где","то, чему","были вы","поклоняющимися"]],[26,93,["مِن","دُونِ","ٱللَّهِ","هَلۡ","يَنصُرُونَكُمۡ","أَوۡ","يَنتَصِرُونَ"],"мин дууни ллахи хал йансуруунакум ау йантасируун","наряду с Аллахом? Помогут ли они вам и помогут ли они себе?».",["из","помимо","Аллаха","разве","помогают они вам","или","помогают они себе"]],[26,94,["فَكُبۡكِبُواْ","فِيهَا","هُمۡ","وَٱلۡغَاوُۥنَ"],"факубкибуу фиихаа хум уалгааууун","Они будут брошены туда вместе с заблудшими,",["и низвергнуты будут","в него","они","и заблудшие"]],[26,95,["وَجُنُودُ","إِبۡلِيسَ","أَجۡمَعُونَ"],"уаджунууду иблииса аджма`уун","а также со всеми воинами Иблиса.",["и воины","Иблиса","все"]],[26,96,["قَالُواْ","وَهُمۡ","فِيهَا","يَخۡتَصِمُونَ"],"каалуу уахум фиихаа йахтасимуун","Препираясь там, они скажут:",["скажут они","и они","в нём","препираются"]],[26,97,["تَٱللَّهِ","إِن","كُنَّا","لَفِي","ضَلَٰلٖ","مُّبِينٍ"],"таллахи ин куннаа лафии далаалим мубиин","«Клянемся Аллахом, мы пребывали в очевидном заблуждении,",["клянёмся Аллахом","поистине","были мы","непременно в","заблуждении","явном"]],[26,98,["إِذۡ","نُسَوِّيكُم","بِرَبِّ","ٱلۡعَٰلَمِينَ"],"из нусаууиикум бирабби л`ааламиин","когда равняли вас с Господом миров.",["когда","равняли мы вас","с Господом","миров"]],[26,99,["وَمَآ","أَضَلَّنَآ","إِلَّا","ٱلۡمُجۡرِمُونَ"],"уамаа адалланаа иллаа лмуджримуун","Только грешники ввели нас в заблуждение,",["и не","сбили нас","кроме","грешники"]],[26,100,["فَمَا","لَنَا","مِن","شَٰفِعِينَ"],"фамаа ланаа мин шаафи`иин","и нет у нас ни заступников,",["и нет","у нас","никаких","заступников"]],[26,101,["وَلَا","صَدِيقٍ","حَمِيمٖ"],"уалаа садиикин хамиим","ни сострадательного друга.",["и ни","друга","близкого"]],[26,102,["فَلَوۡ","أَنَّ","لَنَا","كَرَّةٗ","فَنَكُونَ","مِنَ","ٱلۡمُؤۡمِنِينَ"],"фалау анна ланаа карратан фанакууна мина лму'миниин","Если бы у нас была возможность вернуться, то мы стали бы верующими!».",["и если бы","что","у нас","возвращение","и стали бы мы","из","верующих"]],[26,103,["إِنَّ","فِي","ذَٰلِكَ","لَأٓيَةٗۖ","وَمَا","كَانَ","أَكۡثَرُهُم","مُّؤۡمِنِينَ"],"инна фии заалика ла'йатан уамаа каана аксарухум мму'миниин","Воистину, в этом - знамение, но большинство их не стали верующими.",["поистине","в","этом","непременно знамение","и не","были","большинство их","верующими"]],[26,104,["وَإِنَّ","رَبَّكَ","لَهُوَ","ٱلۡعَزِيزُ","ٱلرَّحِيمُ"],"уа'инна раббака лахууа л`азиизу ррахиим","Воистину, твой Господь - Могущественный, Милосердный.",["и поистине","Господь твой","непременно Он","Могущественный","Милосердный"]],[26,105,["كَذَّبَتۡ","قَوۡمُ","نُوحٍ","ٱلۡمُرۡسَلِينَ"],"каззабат кауму нуухин лмурсалиин","Народ Нуха (Ноя) счел лжецами посланников.",["сочли лжецами","народ","Нуха","посланников"]],[26,106,["إِذۡ","قَالَ","لَهُمۡ","أَخُوهُمۡ","نُوحٌ","أَلَا","تَتَّقُونَ"],"из каала лахум ахуухум нуухун алаа таттакуун","Вот их брат Нух (Ной) сказал им: «Неужели вы не устрашитесь?",["вот","сказал","им","брат их","Нух","разве не","побоитесь вы"]],[26,107,["إِنِّي","لَكُمۡ","رَسُولٌ","أَمِينٞ"],"иннии лакум расуулун амиин","Я являюсь посланником к вам, достойным доверия.",["поистине, я","для вас","посланник","надёжный"]],[26,108,["فَٱتَّقُواْ","ٱللَّهَ","وَأَطِيعُونِ"],"фаттакуу ллаха уа'атии`уун","Бойтесь же Аллаха и повинуйтесь мне.",["бойтесь же","Аллаха","и повинуйтесь мне"]],[26,109,["وَمَآ","أَسۡـَٔلُكُمۡ","عَلَيۡهِ","مِنۡ","أَجۡرٍۖ","إِنۡ","أَجۡرِيَ","إِلَّا","عَلَىٰ","رَبِّ","ٱلۡعَٰلَمِينَ"],"уамаа ас'алукум `алайхи мин аджрин ин аджрийа иллаа `алаа рабби л`ааламиин","Я не прошу у вас за это вознаграждения, ибо вознаградит меня только Господь миров.",["и не","прошу у вас","за это","никакой","награды","не","награда моя","кроме","на","Господе","миров"]],[26,110,["فَٱتَّقُواْ","ٱللَّهَ","وَأَطِيعُونِ"],"фаттакуу ллаха уа'атии`уун","Бойтесь же Аллаха и повинуйтесь мне».",["бойтесь же","Аллаха","и повинуйтесь мне"]],[26,111,["قَالُوٓاْ","أَنُؤۡمِنُ","لَكَ","وَٱتَّبَعَكَ","ٱلۡأَرۡذَلُونَ"],"каалуу ану'мину лака уаттаба`ака л'арзалуун","Они сказали: «Неужели мы поверим тебе, если за тобой последовали самые жалкие люди?».",["сказали они","разве уверуем мы","тебе","когда последовали за тобой","самые низкие"]]]}