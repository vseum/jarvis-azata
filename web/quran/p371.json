{"p":371,"j":19,"a":[[26,84,["وَٱجۡعَل","لِّي","لِسَانَ","صِدۡقٖ","فِي","ٱلۡأٓخِرِينَ"],"важ`ал лии лисана сидḳин фил ахириин","Оставь обо мне правдивую молву в последующих поколениях!",["и сделай","мне","язык","правды","среди","последующих"]],[26,85,["وَٱجۡعَلۡنِي","مِن","وَرَثَةِ","جَنَّةِ","ٱلنَّعِيمِ"],"важ`алнии мин варасати жаннатин на`иим","Сделай меня одним из наследников Сада блаженства!",["и сделай меня","из","наследников","Сада","блаженства"]],[26,86,["وَٱغۡفِرۡ","لِأَبِيٓ","إِنَّهُۥ","كَانَ","مِنَ","ٱلضَّآلِّينَ"],"вагфир ли'абии иннахуу кана минад даллиин","Прости моего отца, ибо он был одним из заблудших!",["и прости","моему отцу","поистине, он","был","из","заблудших"]],[26,87,["وَلَا","تُخۡزِنِي","يَوۡمَ","يُبۡعَثُونَ"],"вала тухзинии йаума йуб`асуун","И не позорь меня в День воскресения -",["и не","позорь меня","в день","будут воскрешены они"]],[26,88,["يَوۡمَ","لَا","يَنفَعُ","مَالٞ","وَلَا","بَنُونَ"],"йаума ла йанфа`у малун вала бануун","в тот день, когда ни богатство, ни сыновья не принесут пользы никому,",["в день","не","поможет","богатство","и не","сыновья"]],[26,89,["إِلَّا","مَنۡ","أَتَى","ٱللَّهَ","بِقَلۡبٖ","سَلِيمٖ"],"илла ман аталлаха биḳалбин салиим","кроме тех, которые предстанут перед Аллахом с непорочным сердцем».",["кроме","того, кто","придёт","к Аллаху","с сердцем","непорочным"]],[26,90,["وَأُزۡلِفَتِ","ٱلۡجَنَّةُ","لِلۡمُتَّقِينَ"],"ва'узлифатил жаннату лилмуттаḳиин","Рай будет приближен к богобоязненным,",["и приближен будет","Рай","для богобоязненных"]],[26,91,["وَبُرِّزَتِ","ٱلۡجَحِيمُ","لِلۡغَاوِينَ"],"вабурризатил жахииму лилгавиин","а Ад будет ясно показан заблудшим.",["и выставлен будет","Ад","для заблудших"]],[26,92,["وَقِيلَ","لَهُمۡ","أَيۡنَ","مَا","كُنتُمۡ","تَعۡبُدُونَ"],"ваḳиила лахум айна ма кунтум та`будуун","Им скажут: «Где же те, кому вы поклонялись",["и сказано будет","им","где","то, чему","были вы","поклоняющимися"]],[26,93,["مِن","دُونِ","ٱللَّهِ","هَلۡ","يَنصُرُونَكُمۡ","أَوۡ","يَنتَصِرُونَ"],"мин дууниллахи хал йансуруунакум ау йантасируун","наряду с Аллахом? Помогут ли они вам и помогут ли они себе?».",["из","помимо","Аллаха","разве","помогают они вам","или","помогают они себе"]],[26,94,["فَكُبۡكِبُواْ","فِيهَا","هُمۡ","وَٱلۡغَاوُۥنَ"],"факубкибуу фииха хум валгавуун","Они будут брошены туда вместе с заблудшими,",["и низвергнуты будут","в него","они","и заблудшие"]],[26,95,["وَجُنُودُ","إِبۡلِيسَ","أَجۡمَعُونَ"],"важунууду иблииса ажма`уун","а также со всеми воинами Иблиса.",["и воины","Иблиса","все"]],[26,96,["قَالُواْ","وَهُمۡ","فِيهَا","يَخۡتَصِمُونَ"],"ḳалуу вахум фииха йахтасимуун","Препираясь там, они скажут:",["скажут они","и они","в нём","препираются"]],[26,97,["تَٱللَّهِ","إِن","كُنَّا","لَفِي","ضَلَٰلٖ","مُّبِينٍ"],"таллахи ин кунна лафии далалим мубиин","«Клянемся Аллахом, мы пребывали в очевидном заблуждении,",["клянёмся Аллахом","поистине","были мы","непременно в","заблуждении","явном"]],[26,98,["إِذۡ","نُسَوِّيكُم","بِرَبِّ","ٱلۡعَٰلَمِينَ"],"из нусаввиикум бираббил `аламиин","когда равняли вас с Господом миров.",["когда","равняли мы вас","с Господом","миров"]],[26,99,["وَمَآ","أَضَلَّنَآ","إِلَّا","ٱلۡمُجۡرِمُونَ"],"вама адаллана иллал мужримуун","Только грешники ввели нас в заблуждение,",["и не","сбили нас","кроме","грешники"]],[26,100,["فَمَا","لَنَا","مِن","شَٰفِعِينَ"],"фама лана мин шафи`иин","и нет у нас ни заступников,",["и нет","у нас","никаких","заступников"]],[26,101,["وَلَا","صَدِيقٍ","حَمِيمٖ"],"вала садииḳин хамиим","ни сострадательного друга.",["и ни","друга","близкого"]],[26,102,["فَلَوۡ","أَنَّ","لَنَا","كَرَّةٗ","فَنَكُونَ","مِنَ","ٱلۡمُؤۡمِنِينَ"],"фалау анна лана карратан фанакууна минал му'миниин","Если бы у нас была возможность вернуться, то мы стали бы верующими!».",["и если бы","что","у нас","возвращение","и стали бы мы","из","верующих"]],[26,103,["إِنَّ","فِي","ذَٰلِكَ","لَأٓيَةٗۖ","وَمَا","كَانَ","أَكۡثَرُهُم","مُّؤۡمِنِينَ"],"инна фии залика ла'айатан вама кана аксарухум му'миниин","Воистину, в этом - знамение, но большинство их не стали верующими.",["поистине","в","этом","непременно знамение","и не","были","большинство их","верующими"]],[26,104,["وَإِنَّ","رَبَّكَ","لَهُوَ","ٱلۡعَزِيزُ","ٱلرَّحِيمُ"],"ва'инна раббака лахуал `азиизур рахиим","Воистину, твой Господь - Могущественный, Милосердный.",["и поистине","Господь твой","непременно Он","Могущественный","Милосердный"]],[26,105,["كَذَّبَتۡ","قَوۡمُ","نُوحٍ","ٱلۡمُرۡسَلِينَ"],"каззабат ḳауму нуухинил мурсалиин","Народ Нуха (Ноя) счел лжецами посланников.",["сочли лжецами","народ","Нуха","посланников"]],[26,106,["إِذۡ","قَالَ","لَهُمۡ","أَخُوهُمۡ","نُوحٌ","أَلَا","تَتَّقُونَ"],"из ḳала лахум ахуухум нуухун ала таттаḳуун","Вот их брат Нух (Ной) сказал им: «Неужели вы не устрашитесь?",["вот","сказал","им","брат их","Нух","разве не","побоитесь вы"]],[26,107,["إِنِّي","لَكُمۡ","رَسُولٌ","أَمِينٞ"],"иннии лакум расуулун амиин","Я являюсь посланником к вам, достойным доверия.",["поистине, я","для вас","посланник","надёжный"]],[26,108,["فَٱتَّقُواْ","ٱللَّهَ","وَأَطِيعُونِ"],"фаттаḳуллаха ва'атии`уун","Бойтесь же Аллаха и повинуйтесь мне.",["бойтесь же","Аллаха","и повинуйтесь мне"]],[26,109,["وَمَآ","أَسۡـَٔلُكُمۡ","عَلَيۡهِ","مِنۡ","أَجۡرٍۖ","إِنۡ","أَجۡرِيَ","إِلَّا","عَلَىٰ","رَبِّ","ٱلۡعَٰلَمِينَ"],"вама ас'алукум `алайхи мин ажрин ин ажрийа илла `ала раббил `аламиин","Я не прошу у вас за это вознаграждения, ибо вознаградит меня только Господь миров.",["и не","прошу у вас","за это","никакой","награды","не","награда моя","кроме","на","Господе","миров"]],[26,110,["فَٱتَّقُواْ","ٱللَّهَ","وَأَطِيعُونِ"],"фаттаḳуллаха ва'атии`уун","Бойтесь же Аллаха и повинуйтесь мне».",["бойтесь же","Аллаха","и повинуйтесь мне"]],[26,111,["قَالُوٓاْ","أَنُؤۡمِنُ","لَكَ","وَٱتَّبَعَكَ","ٱلۡأَرۡذَلُونَ"],"ḳалуу ану'мину лака ваттаба`акал арзалуун","Они сказали: «Неужели мы поверим тебе, если за тобой последовали самые жалкие люди?».",["сказали они","разве уверуем мы","тебе","когда последовали за тобой","самые низкие"]]]}