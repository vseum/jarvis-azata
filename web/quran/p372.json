{"p":372,"j":19,"a":[[26,112,["قَالَ","وَمَا","عِلۡمِي","بِمَا","كَانُواْ","يَعۡمَلُونَ"],"ḳала вама `илмии бима кануу йа`малуун","Он сказал: «Не мне знать о том, что они совершают.",["сказал","и что","мое знание","о том, что","они были","делают"]],[26,113,["إِنۡ","حِسَابُهُمۡ","إِلَّا","عَلَىٰ","رَبِّيۖ","لَوۡ","تَشۡعُرُونَ"],"ин хисабухум илла `ала раббии лау таш`уруун","Только мой Господь предъявит им счет, если бы вы только понимали.",["не","их расчет","кроме как","на","моем Господе","если бы","вы понимали"]],[26,114,["وَمَآ","أَنَا۠","بِطَارِدِ","ٱلۡمُؤۡمِنِينَ"],"вама ана битаридил му'миниин","Я не стану прогонять верующих.",["и не","я","прогоняющий","верующих"]],[26,115,["إِنۡ","أَنَا۠","إِلَّا","نَذِيرٞ","مُّبِينٞ"],"ин ана илла назиирум мубиин","Я - всего лишь предостерегающий и разъясняющий увещеватель».",["не","я","кроме","увещеватель","ясный"]],[26,116,["قَالُواْ","لَئِن","لَّمۡ","تَنتَهِ","يَٰنُوحُ","لَتَكُونَنَّ","مِنَ","ٱلۡمَرۡجُومِينَ"],"ḳалуу ла'ил лам тантахи йанууху латакуунанна минал маржуумиин","Они сказали: «О Нух (Ной)! Если ты не прекратишь, то непременно окажешься одним из тех, кого побили камнями».",["Сказали они","Если","не","прекратишь ты","О Нух","непременно будешь ты","из","побиваемых камнями"]],[26,117,["قَالَ","رَبِّ","إِنَّ","قَوۡمِي","كَذَّبُونِ"],"ḳала рабби инна ḳаумии каззабуун","Он сказал: «Господи! Мой народ счел меня лжецом.",["Сказал он","Господи","поистине","народ мой","счёл меня лжецом"]],[26,118,["فَٱفۡتَحۡ","بَيۡنِي","وَبَيۡنَهُمۡ","فَتۡحٗا","وَنَجِّنِي","وَمَن","مَّعِيَ","مِنَ","ٱلۡمُؤۡمِنِينَ"],"фафтах байнии вабайнахум фатхан ванажжинии вамам ма`ийа минал му'миниин","Рассуди же нас окончательно и спаси меня и тех верующих, которые со мной».",["Рассуди же","между мной","и между ними","решением","и спаси меня","и тех, кто","со мной","из","верующих"]],[26,119,["فَأَنجَيۡنَٰهُ","وَمَن","مَّعَهُۥ","فِي","ٱلۡفُلۡكِ","ٱلۡمَشۡحُونِ"],"фа'анжайнаху вамам ма`ахуу фил фулкил машхуун","Мы спасли его и тех, кто был с ним, в перепо