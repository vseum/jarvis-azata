{"p":372,"j":19,"a":[[26,112,["قَالَ","وَمَا","عِلۡمِي","بِمَا","كَانُواْ","يَعۡمَلُونَ"],"ḳала вама `илмии бима кануу йа`малуун","Он сказал: «Не мне знать о том, что они совершают.",["сказал","и что","мое знание","о том, что","они были","делают"]],[26,113,["إِنۡ","حِسَابُهُمۡ","إِلَّا","عَلَىٰ","رَبِّيۖ","لَوۡ","تَشۡعُرُونَ"],"ин хисабухум илла `ала раббии лау таш`уруун","Только мой Господь предъявит им счет, если бы вы только понимали.",["не","их расчет","кроме как","на","моем Господе","если бы","вы понимали"]],[26,114,["وَمَآ","أَنَا۠","بِطَارِدِ","ٱلۡمُؤۡمِنِينَ"],"вама ана битаридил му'миниин","Я не стану прогонять верующих.",["и не","я","прогоняющий","верующих"]],[26,115,["إِنۡ","أَنَا۠","إِلَّا","نَذِيرٞ","مُّبِينٞ"],"ин ана илла назиирум мубиин","Я - всего лишь предостерегающий и разъясняющий увещеватель».",["не","я","кроме","увещеватель","ясный"]],[26,116,["قَالُواْ","لَئِن","لَّمۡ","تَنتَهِ","يَٰنُوحُ","لَتَكُونَنَّ","مِنَ","ٱلۡمَرۡجُومِينَ"],"ḳалуу ла'ил лам тантахи йанууху латакуунанна минал маржуумиин","Они сказали: «О Нух (Ной)! Если ты не прекратишь, то непременно окажешься одним из тех, кого побили камнями».",["Сказали они","Если","не","прекратишь ты","О Нух","непременно будешь ты","из","побиваемых камнями"]],[26,117,["قَالَ","رَبِّ","إِنَّ","قَوۡمِي","كَذَّبُونِ"],"ḳала рабби инна ḳаумии каззабуун","Он сказал: «Господи! Мой народ счел меня лжецом.",["Сказал он","Господи","поистине","народ мой","счёл меня лжецом"]],[26,118,["فَٱفۡتَحۡ","بَيۡنِي","وَبَيۡنَهُمۡ","فَتۡحٗا","وَنَجِّنِي","وَمَن","مَّعِيَ","مِنَ","ٱلۡمُؤۡمِنِينَ"],"фафтах байнии вабайнахум фатхан ванажжинии вамам ма`ийа минал му'миниин","Рассуди же нас окончательно и спаси меня и тех верующих, которые со мной».",["Рассуди же","между мной","и между ними","решением","и спаси меня","и тех, кто","со мной","из","верующих"]],[26,119,["فَأَنجَيۡنَٰهُ","وَمَن","مَّعَهُۥ","فِي","ٱلۡفُلۡكِ","ٱلۡمَشۡحُونِ"],"фа'анжайнаху вамам ма`ахуу фил фулкил машхуун","Мы спасли его и тех, кто был с ним, в переполненном ковчеге,",["И спасли Мы его","и тех, кто","с ним","в","ковчеге","нагруженном"]],[26,120,["ثُمَّ","أَغۡرَقۡنَا","بَعۡدُ","ٱلۡبَاقِينَ"],"сумма аграḳна ба`дул баḳиин","а потом потопили оставшихся.",["Затем","потопили Мы","после","оставшихся"]],[26,121,["إِنَّ","فِي","ذَٰلِكَ","لَأٓيَةٗۖ","وَمَا","كَانَ","أَكۡثَرُهُم","مُّؤۡمِنِينَ"],"инна фии залика ла'айатан вама кана аксарухум му'миниин","Воистину, в этом - знамение, но большинство их не стали верующими.",["поистине","в","этом","непременно знамение","но не","были","большинство их","верующими"]],[26,122,["وَإِنَّ","رَبَّكَ","لَهُوَ","ٱلۡعَزِيزُ","ٱلرَّحِيمُ"],"ва'инна раббака лахуал `азиизур рахиим","Воистину, твой Господь - Могущественный, Милосердный.",["И поистине","Господь твой","непременно Он","Могущественный","Милосердный"]],[26,123,["كَذَّبَتۡ","عَادٌ","ٱلۡمُرۡسَلِينَ"],"каззабат `адунил мурсалиин","Адиты сочли лжецами посланников.",["Сочли лжецами","адиты","посланников"]],[26,124,["إِذۡ","قَالَ","لَهُمۡ","أَخُوهُمۡ","هُودٌ","أَلَا","تَتَّقُونَ"],"из ḳала лахум ахуухум хуудун ала таттаḳуун","Вот их брат Худ сказал им: «Неужели вы не устрашитесь?",["вот","сказал","им","их брат","Худ","разве не","устрашитесь"]],[26,125,["إِنِّي","لَكُمۡ","رَسُولٌ","أَمِينٞ"],"иннии лакум расуулун амиин","Я являюсь посланником к вам, достойным доверия.",["Поистине, я","для вас","посланник","верный"]],[26,126,["فَٱتَّقُواْ","ٱللَّهَ","وَأَطِيعُونِ"],"фаттаḳуллаха ва'атии`уун","Бойтесь же Аллаха и повинуйтесь мне.",["Бойтесь же","Аллаха","и повинуйтесь мне"]],[26,127,["وَمَآ","أَسۡـَٔلُكُمۡ","عَلَيۡهِ","مِنۡ","أَجۡرٍۖ","إِنۡ","أَجۡرِيَ","إِلَّا","عَلَىٰ","رَبِّ","ٱلۡعَٰلَمِينَ"],"вама ас'алукум `алайхи мин ажрин ин ажрийа илла `ала раббил `аламиин","Я не прошу у вас за это вознаграждения, ибо вознаградит меня только Господь миров.",["И не","прошу я у вас","за это","никакой","награды","Не","награда моя","кроме как","на","Господе","миров"]],[26,128,["أَتَبۡنُونَ","بِكُلِّ","رِيعٍ","ءَايَةٗ","تَعۡبَثُونَ"],"атабнууна бикулли рии`ин айатан та`басуун","Неужели вы будете понапрасну возводить на каждом холме по примете (по высокому строению),",["Неужели строите вы","на каждом","возвышении","знак (строение)","забавляясь"]],[26,129,["وَتَتَّخِذُونَ","مَصَانِعَ","لَعَلَّكُمۡ","تَخۡلُدُونَ"],"вататтахизууна масани`а ла`аллакум тахлудуун","строить замки (или водохранилища), словно вы будете жить вечно,",["И возводите вы","крепости","словно вы","будете жить вечно"]],[26,130,["وَإِذَا","بَطَشۡتُم","بَطَشۡتُمۡ","جَبَّارِينَ"],"ва'иза баташтум баташтум жаббариин","и хватать людей, подобно деспотичным тиранам?",["И когда","хватаете вы","хватаете вы","как тираны"]],[26,131,["فَٱتَّقُواْ","ٱللَّهَ","وَأَطِيعُونِ"],"фаттаḳуллаха ва'атии`уун","Бойтесь же Аллаха и повинуйтесь мне.",["Бойтесь же","Аллаха","и повинуйтесь мне"]],[26,132,["وَٱتَّقُواْ","ٱلَّذِيٓ","أَمَدَّكُم","بِمَا","تَعۡلَمُونَ"],"ваттаḳул лазии амаддакум бима та`ламуун","Бойтесь Того, Кто помог вам тем, что вам известно.",["И бойтесь","Того, Кто","помог вам","тем, что","знаете вы"]],[26,133,["أَمَدَّكُم","بِأَنۡعَٰمٖ","وَبَنِينَ"],"амаддакум би'ан`амин вабаниин","Он помог вам домашней скотиной и сыновьями,",["помог Он вам","скотом","и сыновьями"]],[26,134,["وَجَنَّٰتٖ","وَعُيُونٍ"],"важаннатин ва`уйуун","садами и источниками.",["и садами","и источниками"]],[26,135,["إِنِّيٓ","أَخَافُ","عَلَيۡكُمۡ","عَذَابَ","يَوۡمٍ","عَظِيمٖ"],"иннии ахафу `алайкум `азаба йаумин `азиим","Я боюсь того, что вас постигнут мучения в Великий день».",["поистине, я","боюсь","за вас","наказания","дня","великого"]],[26,136,["قَالُواْ","سَوَآءٌ","عَلَيۡنَآ","أَوَعَظۡتَ","أَمۡ","لَمۡ","تَكُن","مِّنَ","ٱلۡوَٰعِظِينَ"],"ḳалуу саваун `алайна ава`азта ам лам такум минал ва`изиин","Они сказали: «Нам все равно, будешь ты увещевать или же не будешь в числе тех, которые увещевают.",["Сказали они","Одинаково","для нас","увещевал ли ты","или","не","был","из","увещевающих"]]]}