{"p":372,"j":19,"a":[[26,112,["قَالَ","وَمَا","عِلۡمِي","بِمَا","كَانُواْ","يَعۡمَلُونَ"],"каала уамаа `илмии бимаа каануу йа`малуун","Он сказал: «Не мне знать о том, что они совершают.",["сказал","и что","мое знание","о том, что","они были","делают"]],[26,113,["إِنۡ","حِسَابُهُمۡ","إِلَّا","عَلَىٰ","رَبِّيۖ","لَوۡ","تَشۡعُرُونَ"],"ин хисаабухум иллаа `алаа раббии лау таш`уруун","Только мой Господь предъявит им счет, если бы вы только понимали.",["не","их расчет","кроме как","на","моем Господе","если бы","вы понимали"]],[26,114,["وَمَآ","أَنَا۠","بِطَارِدِ","ٱلۡمُؤۡمِنِينَ"],"уамаа ана битаариди лму'миниин","Я не стану прогонять верующих.",["и не","я","прогоняющий","верующих"]],[26,115,["إِنۡ","أَنَا۠","إِلَّا","نَذِيرٞ","مُّبِينٞ"],"ин ана иллаа назиирум мубиин","Я - всего лишь предостерегающий и разъясняющий увещеватель».",["не","я","кроме","увещеватель","ясный"]],[26,116,["قَالُواْ","لَئِن","لَّمۡ","تَنتَهِ","يَٰنُوحُ","لَتَكُونَنَّ","مِنَ","ٱلۡمَرۡجُومِينَ"],"каалуу ла'ил лам тантахи йаанууху латакуунанна мина лмарджуумиин","Они сказали: «О Нух (Ной)! Если ты не прекратишь, то непременно окажешься одним из тех, кого побили камнями».",["Сказали они","Если","не","прекратишь ты","О Нух","непременно будешь ты","из","побиваемых камнями"]],[26,117,["قَالَ","رَبِّ","إِنَّ","قَوۡمِي","كَذَّبُونِ"],"каала рабби инна каумии каззабуун","Он сказал: «Господи! Мой народ счел меня лжецом.",["Сказал он","Господи","поистине","народ мой","счёл меня лжецом"]],[26,118,["فَٱفۡتَحۡ","بَيۡنِي","وَبَيۡنَهُمۡ","فَتۡحٗا","وَنَجِّنِي","وَمَن","مَّعِيَ","مِنَ","ٱلۡمُؤۡمِنِينَ"],"фафтах байнии уабайнахум фатхан уанаджджинии уамам ма`ийа мина лму'миниин","Рассуди же нас окончательно и спаси меня и тех верующих, которые со мной».",["Рассуди же","между мной","и между ними","решением","и спаси меня","и тех, кто","со мной","из","верующих"]],[26,119,["فَأَنجَيۡنَٰهُ","وَمَن","مَّعَهُۥ","فِي","ٱلۡفُلۡكِ","ٱلۡمَشۡحُونِ"],"фа'анджайнааху уамам ма`ахуу фии лфулки лмашхуун","Мы спасли его и тех, кто был с ним, в переполненном ковчеге,",["И спасли Мы его","и тех, кто","с ним","в","ковчеге","нагруженном"]],[26,120,["ثُمَّ","أَغۡرَقۡنَا","بَعۡدُ","ٱلۡبَاقِينَ"],"сумма агракнаа ба`ду лбаакиин","а потом потопили оставшихся.",["Затем","потопили Мы","после","оставшихся"]],[26,121,["إِنَّ","فِي","ذَٰلِكَ","لَأٓيَةٗۖ","وَمَا","كَانَ","أَكۡثَرُهُم","مُّؤۡمِنِينَ"],"инна фии заалика ла'йатан уамаа каана аксарухум мму'миниин","Воистину, в этом - знамение, но большинство их не стали верующими.",["поистине","в","этом","непременно знамение","но не","были","большинство их","верующими"]],[26,122,["وَإِنَّ","رَبَّكَ","لَهُوَ","ٱلۡعَزِيزُ","ٱلرَّحِيمُ"],"уа'инна раббака лахууа л`азиизу ррахиим","Воистину, твой Господь - Могущественный, Милосердный.",["И поистине","Господь твой","непременно Он","Могущественный","Милосердный"]],[26,123,["كَذَّبَتۡ","عَادٌ","ٱلۡمُرۡسَلِينَ"],"каззабат `аадун лмурсалиин","Адиты сочли лжецами посланников.",["Сочли лжецами","адиты","посланников"]],[26,124,["إِذۡ","قَالَ","لَهُمۡ","أَخُوهُمۡ","هُودٌ","أَلَا","تَتَّقُونَ"],"из каала лахум ахуухум хуудун алаа таттакуун","Вот их брат Худ сказал им: «Неужели вы не устрашитесь?",["вот","сказал","им","их брат","Худ","разве не","устрашитесь"]],[26,125,["إِنِّي","لَكُمۡ","رَسُولٌ","أَمِينٞ"],"иннии лакум расуулун амиин","Я являюсь посланником к вам, достойным доверия.",["Поистине, я","для вас","посланник","верный"]],[26,126,["فَٱتَّقُواْ","ٱللَّهَ","وَأَطِيعُونِ"],"фаттакуу ллаха уа'атии`уун","Бойтесь же Аллаха и повинуйтесь мне.",["Бойтесь же","Аллаха","и повинуйтесь мне"]],[26,127,["وَمَآ","أَسۡـَٔلُكُمۡ","عَلَيۡهِ","مِنۡ","أَجۡرٍۖ","إِنۡ","أَجۡرِيَ","إِلَّا","عَلَىٰ","رَبِّ","ٱلۡعَٰلَمِينَ"],"уамаа ас'алукум `алайхи мин аджрин ин аджрийа иллаа `алаа рабби л`ааламиин","Я не прошу у вас за это вознаграждения, ибо вознаградит меня только Господь миров.",["И не","прошу я у вас","за это","никакой","награды","Не","награда моя","кроме как","на","Господе","миров"]],[26,128,["أَتَبۡنُونَ","بِكُلِّ","رِيعٍ","ءَايَةٗ","تَعۡبَثُونَ"],"атабнууна бикулли рии`ин аайатан та`басуун","Неужели вы будете понапрасну возводить на каждом холме по примете (по высокому строению),",["Неужели строите вы","на каждом","возвышении","знак (строение)","забавляясь"]],[26,129,["وَتَتَّخِذُونَ","مَصَانِعَ","لَعَلَّكُمۡ","تَخۡلُدُونَ"],"уататтахизууна масаани`а ла`аллакум тахлудуун","строить замки (или водохранилища), словно вы будете жить вечно,",["И возводите вы","крепости","словно вы","будете жить вечно"]],[26,130,["وَإِذَا","بَطَشۡتُم","بَطَشۡتُمۡ","جَبَّارِينَ"],"уа'изаа баташтум баташтум джаббаариин","и хватать людей, подобно деспотичным тиранам?",["И когда","хватаете вы","хватаете вы","как тираны"]],[26,131,["فَٱتَّقُواْ","ٱللَّهَ","وَأَطِيعُونِ"],"фаттакуу ллаха уа'атии`уун","Бойтесь же Аллаха и повинуйтесь мне.",["Бойтесь же","Аллаха","и повинуйтесь мне"]],[26,132,["وَٱتَّقُواْ","ٱلَّذِيٓ","أَمَدَّكُم","بِمَا","تَعۡلَمُونَ"],"уаттакуу ллазии амаддакум бимаа та`ламуун","Бойтесь Того, Кто помог вам тем, что вам известно.",["И бойтесь","Того, Кто","помог вам","тем, что","знаете вы"]],[26,133,["أَمَدَّكُم","بِأَنۡعَٰمٖ","وَبَنِينَ"],"амаддакум би'ан`аамин уабаниин","Он помог вам домашней скотиной и сыновьями,",["помог Он вам","скотом","и сыновьями"]],[26,134,["وَجَنَّٰتٖ","وَعُيُونٍ"],"уаджаннаатин уа`уйуун","садами и источниками.",["и садами","и источниками"]],[26,135,["إِنِّيٓ","أَخَافُ","عَلَيۡكُمۡ","عَذَابَ","يَوۡمٍ","عَظِيمٖ"],"иннии ахаафу `алайкум `азааба йаумин `азиим","Я боюсь того, что вас постигнут мучения в Великий день».",["поистине, я","боюсь","за вас","наказания","дня","великого"]],[26,136,["قَالُواْ","سَوَآءٌ","عَلَيۡنَآ","أَوَعَظۡتَ","أَمۡ","لَمۡ","تَكُن","مِّنَ","ٱلۡوَٰعِظِينَ"],"каалуу сауаа'ун `алайнаа ауа`азта ам лам такум мина луаа`изиин","Они сказали: «Нам все равно, будешь ты увещевать или же не будешь в числе тех, которые увещевают.",["Сказали они","Одинаково","для нас","увещевал ли ты","или","не","был","из","увещевающих"]]]}