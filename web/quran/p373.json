{"p":373,"j":19,"a":[[26,137,["إِنۡ","هَٰذَآ","إِلَّا","خُلُقُ","ٱلۡأَوَّلِينَ"],"ин хаза илла хулуḳул аввалиин","Это - всего лишь обычаи (или измышления) первых поколений,",["Не","это","кроме как","обычай","прежних (народов)"]],[26,138,["وَمَا","نَحۡنُ","بِمُعَذَّبِينَ"],"вама нахну биму`аззабиин","и мы не будем наказаны».",["И не","мы","наказываемые"]],[26,139,["فَكَذَّبُوهُ","فَأَهۡلَكۡنَٰهُمۡۚ","إِنَّ","فِي","ذَٰلِكَ","لَأٓيَةٗۖ","وَمَا","كَانَ","أَكۡثَرُهُم","مُّؤۡمِنِينَ"],"факаззабууху фа'ахлакнахум инна фии залика ла'айатан вама кана аксарухум му'миниин","Они сочли его лжецом, а Мы погубили их. Воистину, в этом - знамение, но большинство их не стали верующими.",["И сочли они его лжецом","и погубили Мы их","поистине","в","этом","непременно знамение","но не","были","большинство их","верующими"]],[26,140,["وَإِنَّ","رَبَّكَ","لَهُوَ","ٱلۡعَزِيزُ","ٱلرَّحِيمُ"],"ва'инна раббака лахуал `азиизур рахиим","Воистину, твой Господь - Могущественный, Милосердный.",["И поистине","Господь твой","непременно Он","Могущественный","Милосердный"]],[26,141,["كَذَّبَتۡ","ثَمُودُ","ٱلۡمُرۡسَلِينَ"],"каззабат самуудул мурсалиин","Самудяне сочли лжецами посланников.",["Сочли лжецами","самудяне","посланников"]],[26,142,["إِذۡ","قَالَ","لَهُمۡ","أَخُوهُمۡ","صَٰلِحٌ","أَلَا","تَتَّقُونَ"],"из ḳала лахум ахуухум салихун ала таттаḳуун","Вот их брат Салих сказал им: «Неужели вы не устрашитесь?",["Когда","сказал","им","брат их","Салих","Неужели не","устрашитесь вы"]],[26,143,["إِنِّي","لَكُمۡ","رَسُولٌ","أَمِينٞ"],"иннии лакум расуулун амиин","Я являюсь посланником к вам, достойным доверия.",["Поистине, я","для вас","посланник","верный"]],[26,144,["فَٱتَّقُواْ","ٱللَّهَ","وَأَطِيعُونِ"],"фаттаḳуллаха ва'атии`уун","Бойтесь же Аллаха и повинуйтесь мне.",["Бойтесь же","Аллаха","и повинуйтесь мне"]],[26,145,["وَمَآ","أَسۡـَٔلُكُمۡ","عَلَيۡهِ","مِنۡ","أَجۡرٍۖ","إِنۡ","أَجۡرِيَ","إِلَّا","عَلَىٰ","رَبِّ","ٱلۡعَٰلَمِينَ"],"вама ас'алукум `алайхи мин ажрин ин ажрийа илла `ала раббил `аламиин","Я не прошу у вас за это вознаграждения, ибо вознаградит меня только Господь миров.",["И не","прошу я у вас","за это","никакой","награды","Не","награда моя","кроме как","на","Господе","миров"]],[26,146,["أَتُتۡرَكُونَ","فِي","مَا","هَٰهُنَآ","ءَامِنِينَ"],"атутракууна фии ма хахуна аминиин","Неужели вы будете оставлены в безопасности среди того, что есть здесь,",["Неужели будете оставлены вы","в","том, что","здесь","в безопасности"]],[26,147,["فِي","جَنَّٰتٖ","وَعُيُونٖ"],"фии жаннатин ва`уйуун","среди садов и источников,",["В","садах","и источниках"]],[26,148,["وَزُرُوعٖ","وَنَخۡلٖ","طَلۡعُهَا","هَضِيمٞ"],"вазуруу`ин ванахлин тал`уха хадиим","среди посевов и финиковых пальм с нежными плодами,",["и посевах","и пальмах","плоды (завязи) их","нежные"]],[26,149,["وَتَنۡحِتُونَ","مِنَ","ٱلۡجِبَالِ","بُيُوتٗا","فَٰرِهِينَ"],"ватанхитууна минал жибали буйуутан фарихиин","и будете искусно (или горделиво) высекать в горах жилища?",["И высекаете вы","из","гор","дома","искусно"]],[26,150,["فَٱتَّقُواْ","ٱللَّهَ","وَأَطِيعُونِ"],"фаттаḳуллаха ва'атии`уун","Бойтесь же Аллаха и повинуйтесь мне,",["Бойтесь же","Аллаха","и повинуйтесь мне"]],[26,151,["وَلَا","تُطِيعُوٓاْ","أَمۡرَ","ٱلۡمُسۡرِفِينَ"],"вала тутии`уу амрал мусрифиин","и не слушайтесь повелений тех, кто излишествует,",["И не","повинуйтесь","повелению","излишествующих"]],[26,152,["ٱلَّذِينَ","يُفۡسِدُونَ","فِي","ٱلۡأَرۡضِ","وَلَا","يُصۡلِحُونَ"],"аллазиина йуфсидууна фил арди вала йуслихуун","кто распространяет на земле нечестие и ничего не улучшает».",["тех, которые","распространяют нечестие","на","земле","и не","исправляют"]],[26,153,["قَالُوٓاْ","إِنَّمَآ","أَنتَ","مِنَ","ٱلۡمُسَحَّرِينَ"],"ḳалуу иннама анта минал мусаххариин","Они сказали: «Ты - всего лишь один из околдованных.",["Сказали они","Лишь","ты","из","околдованных"]],[26,154,["مَآ","أَنتَ","إِلَّا","بَشَرٞ","مِّثۡلُنَا","فَأۡتِ","بِـَٔايَةٍ","إِن","كُنتَ","مِنَ","ٱلصَّٰدِقِينَ"],"ма анта илла башарум мислуна фа'ти би'айатин ин кунта минас садиḳиин","Ты - всего лишь такой же человек, как и мы. Покажи нам знамение, если ты - один из тех, кто говорит правду».",["Не","ты","кроме как","человек","подобный нам","Так приведи же","знамение","если","являешься ты","из","правдивых"]],[26,155,["قَالَ","هَٰذِهِۦ","نَاقَةٞ","لَّهَا","شِرۡبٞ","وَلَكُمۡ","شِرۡبُ","يَوۡمٖ","مَّعۡلُومٖ"],"ḳала хазихии наḳатул лаха ширбун валакум ширбу йаумим ма`луум","Он сказал: «Вот верблюдица! Она должна пить, и вы должны пить по определенным дням.",["Сказал он","Это","верблюдица","для неё","питьё","и для вас","питьё","дня","известного"]],[26,156,["وَلَا","تَمَسُّوهَا","بِسُوٓءٖ","فَيَأۡخُذَكُمۡ","عَذَابُ","يَوۡمٍ","عَظِيمٖ"],"вала тамассууха бисууин файа'хузакум `азабу йаумин `азиим","Не прикасайтесь к ней со злом, а не то вас постигнут мучения в Великий день».",["и не","касайтесь ее","злом","и схватит вас","наказание","дня","великого"]],[26,157,["فَعَقَرُوهَا","فَأَصۡبَحُواْ","نَٰدِمِينَ"],"фа`аḳарууха фа'асбахуу надимиин","Но они подрезали ей поджилки и стали сожалеть об этом.",["Но подрезали они ей поджилки","и стали они","сожалеющими"]],[26,158,["فَأَخَذَهُمُ","ٱلۡعَذَابُۚ","إِنَّ","فِي","ذَٰلِكَ","لَأٓيَةٗۖ","وَمَا","كَانَ","أَكۡثَرُهُم","مُّؤۡمِنِينَ"],"фа'ахазахумул `азабу инна фии залика ла'айатан вама кана аксарухум му'миниин","Их постигло наказание. Воистину, в этом - знамение, но большинство их не стали верующими.",["И постигло их","наказание","поистине","в","этом","непременно знамение","но не","были","большинство их","верующими"]],[26,159,["وَإِنَّ","رَبَّكَ","لَهُوَ","ٱلۡعَزِيزُ","ٱلرَّحِيمُ"],"ва'инна раббака лахуал `азиизур рахиим","Воистину, твой Господь - Могущественный, Милосердный.",["И поистине","Господь твой","непременно Он","Могущественный","Милосердный"]]]}