{"p":374,"j":19,"a":[[26,160,["كَذَّبَتۡ","قَوۡمُ","لُوطٍ","ٱلۡمُرۡسَلِينَ"],"каззабат ḳауму луутинил мурсалиин","Народ Лута (Лота) счел лжецами посланников.",["Сочли лжецами","народ","Лута","посланников"]],[26,161,["إِذۡ","قَالَ","لَهُمۡ","أَخُوهُمۡ","لُوطٌ","أَلَا","تَتَّقُونَ"],"из ḳала лахум ахуухум луутун ала таттаḳуун","Вот их брат Лут (Лот) сказал им: «Неужели вы не устрашитесь?",["Когда","сказал","им","брат их","Лут","Неужели не","устрашитесь вы"]],[26,162,["إِنِّي","لَكُمۡ","رَسُولٌ","أَمِينٞ"],"иннии лакум расуулун амиин","Я являюсь посланником к вам, достойным доверия.",["Поистине, я","для вас","посланник","верный"]],[26,163,["فَٱتَّقُواْ","ٱللَّهَ","وَأَطِيعُونِ"],"фаттаḳуллаха ва'атии`уун","Бойтесь же Аллаха и повинуйтесь мне.",["Бойтесь же","Аллаха","и повинуйтесь мне"]],[26,164,["وَمَآ","أَسۡـَٔلُكُمۡ","عَلَيۡهِ","مِنۡ","أَجۡرٍۖ","إِنۡ","أَجۡرِيَ","إِلَّا","عَلَىٰ","رَبِّ","ٱلۡعَٰلَمِينَ"],"вама ас'алукум `алайхи мин ажрин ин ажрийа илла `ала раббил `аламиин","Я не прошу у вас за это вознаграждения, ибо вознаградит меня только Господь миров.",["И не","прошу я у вас","за это","никакой","награды","Не","награда моя","кроме как","на","Господе","миров"]],[26,165,["أَتَأۡتُونَ","ٱلذُّكۡرَانَ","مِنَ","ٱلۡعَٰلَمِينَ"],"ата'тууназ зукрана минал `аламиин","Неужели вы будете возлежать с мужчинами из миров",["Неужели приходите вы","к мужчинам","из","миров"]],[26,166,["وَتَذَرُونَ","مَا","خَلَقَ","لَكُمۡ","رَبُّكُم","مِّنۡ","أَزۡوَٰجِكُمۚ","بَلۡ","أَنتُمۡ","قَوۡمٌ","عَادُونَ"],"ватазарууна ма халаḳа лакум раббукум мин азважикум бал антум ḳаумун `адуун","и оставлять ваших жен, которых ваш Господь создал для вас? О нет! Вы являетесь преступным народом».",["И оставляете вы","то, что","сотворил","для вас","Господь ваш","из","жён ваших","Нет же","вы","народ","преступающий"]],[26,167,["قَالُواْ","لَئِن","لَّمۡ","تَنتَهِ","يَٰلُوطُ","لَتَكُونَنَّ","مِنَ","ٱلۡمُخۡرَجِينَ"],"ḳалуу ла'ил лам тантахи йалууту латакуунанна минал мухражиин","Они сказали: «О Лут (Лот), если ты не прекратишь, то окажешься одним из тех, кто был изгнан».",["Сказали они","Если","не","прекратишь ты","О Лут","непременно будешь ты","из","изгнанных"]],[26,168,["قَالَ","إِنِّي","لِعَمَلِكُم","مِّنَ","ٱلۡقَالِينَ"],"ḳала иннии ли`амаликум минал ḳалиин","Он сказал: «Я - один из тех, кому ненавистно ваше деяние.",["Сказал он","Поистине, я","к деянию вашему","из","ненавидящих"]],[26,169,["رَبِّ","نَجِّنِي","وَأَهۡلِي","مِمَّا","يَعۡمَلُونَ"],"рабби нажжинии ва'ахлии мимма йа`малуун","Господи! Спаси меня и мою семью от того, что они совершают».",["Господи","спаси меня","и семью мою","от того, что","делают они"]],[26,170,["فَنَجَّيۡنَٰهُ","وَأَهۡلَهُۥٓ","أَجۡمَعِينَ"],"фанажжайнаху ва'ахлахуу ажма`иин","Мы спасли его и его семью - всех,",["И спасли Мы его","и семью его","всех"]],[26,171,["إِلَّا","عَجُوزٗا","فِي","ٱلۡغَٰبِرِينَ"],"илла `ажуузан фил габириин","кроме старухи, которая оказалась среди оставшихся позади.",["кроме","старухи","среди","оставшихся позади"]],[26,172,["ثُمَّ","دَمَّرۡنَا","ٱلۡأٓخَرِينَ"],"сумма даммарнал ахариин","Затем Мы уничтожили остальных",["Затем","уничтожили Мы","других"]],[26,173,["وَأَمۡطَرۡنَا","عَلَيۡهِم","مَّطَرٗاۖ","فَسَآءَ","مَطَرُ","ٱلۡمُنذَرِينَ"],"ва'амтарна `алайхим матаран фасаа матарул мунзариин","и пролили на них дождь. Как же пагубен дождь тех, кого предостерегали!",["И пролили Мы","на них","дождь","и скверен","дождь","предостережённых"]],[26,174,["إِنَّ","فِي","ذَٰلِكَ","لَأٓيَةٗۖ","وَمَا","كَانَ","أَكۡثَرُهُم","مُّؤۡمِنِينَ"],"инна фии залика ла'айатан вама кана аксарухум му'миниин","Воистину, в этом - знамение, но большинство их не стали верующими.",["поистине","в","этом","непременно знамение","но не","были","большинство их","верующими"]],[26,175,["وَإِنَّ","رَبَّكَ","لَهُوَ","ٱلۡعَزِيزُ","ٱلرَّحِيمُ"],"ва'инна раббака лахуал `азиизур рахиим","Воистину, твой Господь - Могущественный, Милосердный.",["И поистине","Господь твой","непременно Он","Могущественный","Милосердный"]],[26,176,["كَذَّبَ","أَصۡحَٰبُ","لۡـَٔيۡكَةِ","ٱلۡمُرۡسَلِينَ"],"каззаба асхабул айкатил мурсалиин","Жители Айки сочли лжецами посланников.",["Сочли лжецами","обитатели","Айки (рощи)","посланников"]],[26,177,["إِذۡ","قَالَ","لَهُمۡ","شُعَيۡبٌ","أَلَا","تَتَّقُونَ"],"из ḳала лахум шу`айбун ала таттаḳуун","Вот Шуейб сказал им: «Неужели вы не устрашитесь?",["вот","сказал","им","Шуайб","разве не","устрашитесь"]],[26,178,["إِنِّي","لَكُمۡ","رَسُولٌ","أَمِينٞ"],"иннии лакум расуулун амиин","Я являюсь посланником к вам, достойным доверия.",["Поистине, я","для вас","посланник","верный"]],[26,179,["فَٱتَّقُواْ","ٱللَّهَ","وَأَطِيعُونِ"],"фаттаḳуллаха ва'атии`уун","Бойтесь же Аллаха и повинуйтесь мне.",["Бойтесь же","Аллаха","и повинуйтесь мне"]],[26,180,["وَمَآ","أَسۡـَٔلُكُمۡ","عَلَيۡهِ","مِنۡ","أَجۡرٍۖ","إِنۡ","أَجۡرِيَ","إِلَّا","عَلَىٰ","رَبِّ","ٱلۡعَٰلَمِينَ"],"вама ас'алукум `алайхи мин ажрин ин ажрийа илла `ала раббил `аламиин","Я не прошу у вас за это вознаграждения, ибо вознаградит меня только Господь миров.",["И не","прошу я у вас","за это","никакой","награды","Не","награда моя","кроме как","на","Господе","миров"]],[26,181,["أَوۡفُواْ","ٱلۡكَيۡلَ","وَلَا","تَكُونُواْ","مِنَ","ٱلۡمُخۡسِرِينَ"],"ауфул кайла вала такуунуу минал мухсириин","Наполняйте меру полностью и не будьте одними из тех, кто наносит урон.",["Наполняйте полностью","меру","и не","будьте","из","наносящих урон"]],[26,182,["وَزِنُواْ","بِٱلۡقِسۡطَاسِ","ٱلۡمُسۡتَقِيمِ"],"вазинуу билḳистасил мустаḳиим","Взвешивайте на точных весах.",["И взвешивайте","на весах","точных"]],[26,183,["وَلَا","تَبۡخَسُواْ","ٱلنَّاسَ","أَشۡيَآءَهُمۡ","وَلَا","تَعۡثَوۡاْ","فِي","ٱلۡأَرۡضِ","مُفۡسِدِينَ"],"вала табхасун наса ашйаахум вала та`сау фил арди муфсидиин","Не убавляйте людям того, что им причитается, и не творите на земле зла, распространяя нечестие.",["И не","убавляйте","людям","вещей их","и не","бесчинствуйте","на","земле","распространяя нечестие"]]]}