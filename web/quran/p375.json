{"p":375,"j":19,"a":[[26,184,["وَٱتَّقُواْ","ٱلَّذِي","خَلَقَكُمۡ","وَٱلۡجِبِلَّةَ","ٱلۡأَوَّلِينَ"],"ваттаḳул лазии халаḳакум валжибиллатал аввалиин","Бойтесь Того, Кто сотворил вас и первые поколения».",["И бойтесь","Того, Кто","сотворил вас","и поколения","прежние"]],[26,185,["قَالُوٓاْ","إِنَّمَآ","أَنتَ","مِنَ","ٱلۡمُسَحَّرِينَ"],"ḳалуу иннама анта минал мусаххариин","Они сказали: «Ты - всего лишь один из околдованных.",["Сказали они","Лишь","ты","из","околдованных"]],[26,186,["وَمَآ","أَنتَ","إِلَّا","بَشَرٞ","مِّثۡلُنَا","وَإِن","نَّظُنُّكَ","لَمِنَ","ٱلۡكَٰذِبِينَ"],"вама анта илла башарум мислуна ва'ин назуннука ламинал казибиин","Ты - всего лишь такой же человек, как и мы, и мы полагаем, что ты являешься одним из лжецов.",["И не","ты","кроме как","человек","подобный нам","и поистине","считаем мы тебя","непременно из","лжецов"]],[26,187,["فَأَسۡقِطۡ","عَلَيۡنَا","كِسَفٗا","مِّنَ","ٱلسَّمَآءِ","إِن","كُنتَ","مِنَ","ٱلصَّٰدِقِينَ"],"фа'асḳит `алайна кисафам минас самаи ин кунта минас садиḳиин","Низринь на нас осколок неба, если ты - один из тех, кто говорит правду».",["Так низринь","на нас","куски","из","неба","если","являешься ты","из","правдивых"]],[26,188,["قَالَ","رَبِّيٓ","أَعۡلَمُ","بِمَا","تَعۡمَلُونَ"],"ḳала раббии а`ламу бима та`малуун","Он сказал: «Мой Господь лучше знает о том, что вы совершаете».",["сказал","мой Господь","лучше знает","о том, что","делаете"]],[26,189,["فَكَذَّبُوهُ","فَأَخَذَهُمۡ","عَذَابُ","يَوۡمِ","ٱلظُّلَّةِۚ","إِنَّهُۥ","كَانَ","عَذَابَ","يَوۡمٍ","عَظِيمٍ"],"факаззабууху фа'ахазахум `азабу йаумиз зуллати иннахуу кана `азаба йаумин `азиим","Они сочли его лжецом, и их постигли мучения в день тени. Воистину, это были мучения в Великий день.",["И сочли они его лжецом","и постигло их","наказание","дня","тени (облака)","Поистине, оно","было","наказанием","дня","великого"]],[26,190,["إِنَّ","فِي","ذَٰلِكَ","لَأٓيَةٗۖ","وَمَا","كَانَ","أَكۡثَرُهُم","مُّؤۡمِنِينَ"],"инна фии залика ла'айатан вама кана аксарухум му'миниин","Воистину, в этом - знамение, но большинство их не стали верующими.",["поистине","в","этом","непременно знамение","но не","были","большинство их","верующими"]],[26,191,["وَإِنَّ","رَبَّكَ","لَهُوَ","ٱلۡعَزِيزُ","ٱلرَّحِيمُ"],"ва'инна раббака лахуал `азиизур рахиим","Воистину, твой Господь - Могущественный, Милосердный.",["И поистине","Господь твой","непременно Он","Могущественный","Милосердный"]],[26,192,["وَإِنَّهُۥ","لَتَنزِيلُ","رَبِّ","ٱلۡعَٰلَمِينَ"],"ва'иннахуу латанзиилу раббил `аламиин","Воистину, это - Ниспослание от Господа миров.",["И поистине, он (Коран)","непременно ниспослание","Господа","миров"]],[26,193,["نَزَلَ","بِهِ","ٱلرُّوحُ","ٱلۡأَمِينُ"],"назала бихир руухул амиин","Верный Дух (Джибрил) сошел с ним",["Сошёл","с ним","Дух","верный"]],[26,194,["عَلَىٰ","قَلۡبِكَ","لِتَكُونَ","مِنَ","ٱلۡمُنذِرِينَ"],"`ала ḳалбика литакууна минал мунзириин","на твое сердце, чтобы ты стал одним из тех, кто предостерегает.",["на","сердце твоё","чтобы был ты","из","предостерегающих"]],[26,195,["بِلِسَانٍ","عَرَبِيّٖ","مُّبِينٖ"],"билисанин `арабиййим мубиин","Оно ниспослано на ясном арабском языке",["на языке","арабском","ясном"]],[26,196,["وَإِنَّهُۥ","لَفِي","زُبُرِ","ٱلۡأَوَّلِينَ"],"ва'иннахуу лафии зубурил аввалиин","и упоминается в Писаниях древних народов.",["И поистине, он","непременно в","писаниях","прежних (народов)"]],[26,197,["أَوَلَمۡ","يَكُن","لَّهُمۡ","ءَايَةً","أَن","يَعۡلَمَهُۥ","عُلَمَٰٓؤُاْ","بَنِيٓ","إِسۡرَٰٓءِيلَ"],"авалам йакул лахум айатан ан йа`ламахуу `уламау бании исраиил","Разве для них не является знамением то, что ученые сынов Исраила (Израиля) знают его?",["Разве не","является","для них","знамением","то, что","знают его","учёные","сынов","Исраила"]],[26,198,["وَلَوۡ","نَزَّلۡنَٰهُ","عَلَىٰ","بَعۡضِ","ٱلۡأَعۡجَمِينَ"],"валау наззалнаху `ала ба`дил а`жамиин","Если бы Мы ниспослали его кому-либо из неарабов",["И если бы","ниспослали Мы его","на","кого-либо","из неарабов"]],[26,199,["فَقَرَأَهُۥ","عَلَيۡهِم","مَّا","كَانُواْ","بِهِۦ","مُؤۡمِنِينَ"],"фаḳараахуу `алайхим ма кануу бихии му'миниин","и если бы он прочел его им, то они не уверовали бы в него.",["и прочёл он его","им","не","были бы они","в него","верующими"]],[26,200,["كَذَٰلِكَ","سَلَكۡنَٰهُ","فِي","قُلُوبِ","ٱلۡمُجۡرِمِينَ"],"казалика салакнаху фии ḳулуубил мужримиин","Так Мы внедряем его (неверие) в сердца грешников.",["так","ввели Мы его","в","сердца","грешников"]],[26,201,["لَا","يُؤۡمِنُونَ","بِهِۦ","حَتَّىٰ","يَرَوُاْ","ٱلۡعَذَابَ","ٱلۡأَلِيمَ"],"ла йу'минууна бихии хатта йаравул `азабал алиим","Они не уверуют в него, пока не увидят мучительные страдания.",["не","уверуют","в него","пока не","увидят","наказание","мучительное"]],[26,202,["فَيَأۡتِيَهُم","بَغۡتَةٗ","وَهُمۡ","لَا","يَشۡعُرُونَ"],"файа'тийахум багтатан вахум ла йаш`уруун","Они постигнут их неожиданно, так что они даже не почувствуют этого.",["И придёт оно к ним","внезапно","и они","не","почувствуют"]],[26,203,["فَيَقُولُواْ","هَلۡ","نَحۡنُ","مُنظَرُونَ"],"файаḳуулуу хал нахну мунзаруун","Тогда они скажут: «Предоставят ли нам отсрочку?».",["И скажут они","Разве","мы","получим отсрочку"]],[26,204,["أَفَبِعَذَابِنَا","يَسۡتَعۡجِلُونَ"],"афаби`азабина йаста`жилуун","Неужели они торопят мучения от Нас?",["Неужели наказание Наше","торопят они"]],[26,205,["أَفَرَءَيۡتَ","إِن","مَّتَّعۡنَٰهُمۡ","سِنِينَ"],"афараайта им матта`нахум синиин","Знаешь ли ты, что если Мы позволим им пользоваться благами многие годы,",["Видел ли ты","если","дадим Мы им пользоваться","годы"]],[26,206,["ثُمَّ","جَآءَهُم","مَّا","كَانُواْ","يُوعَدُونَ"],"сумма жаахум ма кануу йуу`адуун","после чего к ним явится то, что им было обещано,",["затем","придёт к ним","то, что","были они","обещаемы"]]],"m":[[["وَٱتَّقُواْ","И бойтесь",26,184],["ٱلَّذِي","Того, Кто",26,184],["خَلَقَكُمۡ","сотворил вас",26,184],["وَٱلۡجِبِلَّةَ","и поколения",26,184],["ٱلۡأَوَّلِينَ","прежние",26,184],[184],["قَالُوٓاْ","Сказали они",26,185],["إِنَّمَآ","Лишь",26,185],["أَنتَ","ты",26,185]],[["مِنَ","из",26,185],["ٱلۡمُسَحَّرِينَ","околдованн