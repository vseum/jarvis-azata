{"p":376,"j":19,"a":[[26,207,["مَآ","أَغۡنَىٰ","عَنۡهُم","مَّا","كَانُواْ","يُمَتَّعُونَ"],"маа агнаа `анхум ммаа каануу йуматта`уун","то все, чем им было позволено пользоваться, не принесет им никакой пользы?",["Не","избавит","от них","то, чем","были они","наделяемы благами"]],[26,208,["وَمَآ","أَهۡلَكۡنَا","مِن","قَرۡيَةٍ","إِلَّا","لَهَا","مُنذِرُونَ"],"уамаа ахлакнаа мин карйатин иллаа лахаа мунзируун","Мы не губили ни одного селения, в котором предостерегающие увещеватели не побывали",["И не","погубили Мы","ни одного","селения","кроме как","у него","предостерегающие"]],[26,209,["ذِكۡرَىٰ","وَمَا","كُنَّا","ظَٰلِمِينَ"],"зикраа уамаа куннаа заалимиин","с назиданиями. Мы не были несправедливы.",["в назидание","и не","были Мы","несправедливыми"]],[26,210,["وَمَا","تَنَزَّلَتۡ","بِهِ","ٱلشَّيَٰطِينُ"],"уамаа таназзалат бихи шшайаатиин","Дьяволы не нисходили с ним (Кораном).",["И не","нисходили","с ним","дьяволы"]],[26,211,["وَمَا","يَنۢبَغِي","لَهُمۡ","وَمَا","يَسۡتَطِيعُونَ"],"уамаа йамбагии лахум уамаа йастатии`уун","Это не подобает им, и они не способны на это.",["И не","подобает","им","и не","способны они"]],[26,212,["إِنَّهُمۡ","عَنِ","ٱلسَّمۡعِ","لَمَعۡزُولُونَ"],"иннахум `ани ссам`и лама`зуулуун","Они отстранены от прислушивания к нему.",["Поистине, они","от","слушания","непременно отстранены"]],[26,213,["فَلَا","تَدۡعُ","مَعَ","ٱللَّهِ","إِلَٰهًا","ءَاخَرَ","فَتَكُونَ","مِنَ","ٱلۡمُعَذَّبِينَ"],"фалаа тад`у ма`а ллахи илаахан аахара фатакууна мина лму`аззабиин","Не взывай к другим богам помимо Аллаха, а не то окажешься в числе тех, кого подвергнут мучениям.",["Так не","взывай","наряду с","Аллахом","к богу","другому","а не то будешь ты","из","наказываемых"]],[26,214,["وَأَنذِرۡ","عَشِيرَتَكَ","ٱلۡأَقۡرَبِينَ"],"уа'анзир `ашииратака л'акрабиин","Предостереги своих ближайших родственников!",["И предостерегай","родственников твоих","ближайших"]],[26,215,["وَٱخۡفِضۡ","جَنَاحَكَ","لِمَنِ","ٱتَّبَعَكَ","مِنَ","ٱلۡمُؤۡمِنِينَ"],"уахфид джанаахака лимани ттаба`ака мина лму'миниин","Склони свое крыло перед верующими, которые следует за тобой (будь добр и милосерден к ним).",["И опусти","крыло твоё","для тех, кто","последовал за тобой","из","верующих"]],[26,216,["فَإِنۡ","عَصَوۡكَ","فَقُلۡ","إِنِّي","بَرِيٓءٞ","مِّمَّا","تَعۡمَلُونَ"],"фа'ин `асаука факул иннии барии'ум миммаа та`малуун","Если же они ослушаются тебя, то скажи: «Я не причастен к тому, что вы совершаете».",["А если","ослушаются они тебя","то скажи","Поистине, я","непричастен","к тому, что","делаете вы"]],[26,217,["وَتَوَكَّلۡ","عَلَى","ٱلۡعَزِيزِ","ٱلرَّحِيمِ"],"уатауаккал `алаа л`азиизи ррахиим","Уповай на Могущественного, Милосердного,",["И уповай","на","Могущественного","Милосердного"]],[26,218,["ٱلَّذِي","يَرَىٰكَ","حِينَ","تَقُومُ"],"аллазии йараака хиина такуум","Который видит тебя, когда ты выстаиваешь намазы по ночам",["Который","видит тебя","когда","встаёшь ты"]],[26,219,["وَتَقَلُّبَكَ","فِي","ٱلسَّٰجِدِينَ"],"уатакаллубака фии ссааджидиин","и двигаешься среди падающих ниц.",["и движения твои","среди","падающих ниц"]],[26,220,["إِنَّهُۥ","هُوَ","ٱلسَّمِيعُ","ٱلۡعَلِيمُ"],"иннахуу хууа ссамии`у л`алиим","Воистину, Он - Слышащий, Знающий.",["Поистине, Он","Он","Слышащий","Знающий"]],[26,221,["هَلۡ","أُنَبِّئُكُمۡ","عَلَىٰ","مَن","تَنَزَّلُ","ٱلشَّيَٰطِينُ"],"хал унабби'укум `алаа ман таназзалу шшайаатиин","Поведать ли вам о том, на кого нисходят дьяволы?",["ли","сообщу вам","о","ком","нисходят","дьяволы"]],[26,222,["تَنَزَّلُ","عَلَىٰ","كُلِّ","أَفَّاكٍ","أَثِيمٖ"],"таназзалу `алаа кулли аффаакин асиим","Они нисходят на каждого лжеца и грешника.",["Нисходят они","на","каждого","лжеца","грешного"]],[26,223,["يُلۡقُونَ","ٱلسَّمۡعَ","وَأَكۡثَرُهُمۡ","كَٰذِبُونَ"],"йулкууна ссам`а уа'аксарухум каазибуун","Они подбрасывают услышанное, но большинство из них являются лжецами.",["подбрасывают","услышанное","а большинство из них","лжецы"]],[26,224,["وَٱلشُّعَرَآءُ","يَتَّبِعُهُمُ","ٱلۡغَاوُۥنَ"],"уашшу`араа'у йаттаби`ухуму лгааууун","А за поэтами следуют заблудшие.",["а поэты","следуют за ними","заблудшие"]],[26,225,["أَلَمۡ","تَرَ","أَنَّهُمۡ","فِي","كُلِّ","وَادٖ","يَهِيمُونَ"],"алам тара аннахум фии кулли уаадин йахиимуун","Разве ты не видишь, что они блуждают по всем долинам (слагают стихи на любые темы)",["разве не","видишь ты","что они","в","каждой","долине","блуждают"]],[26,226,["وَأَنَّهُمۡ","يَقُولُونَ","مَا","لَا","يَفۡعَلُونَ"],"уа'аннахум йакуулууна маа лаа йаф`алуун","и говорят то, чего не делают?",["и что они","говорят","то, что","не","делают"]],[26,227,["إِلَّا","ٱلَّذِينَ","ءَامَنُواْ","وَعَمِلُواْ","ٱلصَّٰلِحَٰتِ","وَذَكَرُواْ","ٱللَّهَ","كَثِيرٗا","وَٱنتَصَرُواْ","مِنۢ","بَعۡدِ","مَا","ظُلِمُواْۗ","وَسَيَعۡلَمُ","ٱلَّذِينَ","ظَلَمُوٓاْ","أَيَّ","مُنقَلَبٖ","يَنقَلِبُونَ"],"иллаа ллазиина аамануу уа`амилуу ссаалихаати уазакаруу ллаха касииран уантасаруу мим ба`ди маа зулимуу уасайа`ламу ллазиина заламуу аййа мункалабин йанкалибуун","Это не относится к тем, которые уверовали, совершают праведные деяния, многократно поминают Аллаха и защищаются после того, как с ними поступили несправедливо? А те, которые поступают несправедливо, скоро узнают, куда они вернутся.",["кроме","тех, которые","уверовали","и совершали","праведные дела","и поминали","Аллаха","много","и защищались","после","после","того как","с ними поступили несправедливо","и узнают","те, которые","поступили несправедливо","каким","возвращением","они вернутся"]]]}