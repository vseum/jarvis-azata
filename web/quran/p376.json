{"p":376,"j":19,"a":[[26,207,["مَآ","أَغۡنَىٰ","عَنۡهُم","مَّا","كَانُواْ","يُمَتَّعُونَ"],"ма агна `анхум ма кануу йуматта`уун","то все, чем им было позволено пользоваться, не принесет им никакой пользы?",["Не","избавит","от них","то, чем","были они","наделяемы благами"]],[26,208,["وَمَآ","أَهۡلَكۡنَا","مِن","قَرۡيَةٍ","إِلَّا","لَهَا","مُنذِرُونَ"],"вама ахлакна мин ḳарйатин илла лаха мунзируун","Мы не губили ни одного селения, в котором предостерегающие увещеватели не побывали",["И не","погубили Мы","ни одного","селения","кроме как","у него","предостерегающие"]],[26,209,["ذِكۡرَىٰ","وَمَا","كُنَّا","ظَٰلِمِينَ"],"зикра вама кунна залимиин","с назиданиями. Мы не были несправедливы.",["в назидание","и не","были Мы","несправедливыми"]],[26,210,["وَمَا","تَنَزَّلَتۡ","بِهِ","ٱلشَّيَٰطِينُ"],"вама таназзалат бихиш шайатиин","Дьяволы не нисходили с ним (Кораном).",["И не","нисходили","с ним","дьяволы"]],[26,211,["وَمَا","يَنۢبَغِي","لَهُمۡ","وَمَا","يَسۡتَطِيعُونَ"],"вама йамбагии лахум вама йастатии`уун","Это не подобает им, и они не способны на это.",["И не","подобает","им","и не","способны они"]],[26,212,["إِنَّهُمۡ","عَنِ","ٱلسَّمۡعِ","لَمَعۡزُولُونَ"],"иннахум `анис сам`и лама`зуулуун","Они отстранены от прислушивания к нему.",["Поистине, они","от","слушания","непременно отстранены"]],[26,213,["فَلَا","تَدۡعُ","مَعَ","ٱللَّهِ","إِلَٰهًا","ءَاخَرَ","فَتَكُونَ","مِنَ","ٱلۡمُعَذَّبِينَ"],"фала тад`у ма`аллахи илахан ахара фатакууна минал му`аззабиин","Не взывай к другим богам помимо Аллаха, а не то окажешься в числе тех, кого подвергнут мучениям.",["Так не","взывай","наряду с","Аллахом","к богу","другому","а не то будешь ты","из","наказываемых"]],[26,214,["وَأَنذِرۡ","عَشِيرَتَكَ","ٱلۡأَقۡرَبِينَ"],"ва'анзир `ашииратакал аḳрабиин","Предостереги своих ближайших родственников!",["И предостерегай","родственников твоих","ближайших"]],[26,215,["وَٱخۡفِضۡ","جَنَاحَكَ","لِمَنِ","ٱتَّبَعَكَ","مِنَ","ٱلۡمُؤۡمِنِينَ"],"вахфид жанахака лиманиттаба`ака минал му'миниин","Склони свое крыло перед верующими, которые следует за тобой (будь добр и милосерден к ним).",["И опусти","крыло твоё","для тех, кто","последовал за тобой","из","верующих"]],[26,216,["فَإِنۡ","عَصَوۡكَ","فَقُلۡ","إِنِّي","بَرِيٓءٞ","مِّمَّا","تَعۡمَلُونَ"],"фа'ин `асаука фаḳул иннии барииум мимма та`малуун","Если же они ослушаются тебя, то скажи: «Я не причастен к тому, что вы совершаете».",["А если","ослушаются они тебя","то скажи","Поистине, я","непричастен","к тому, что","делаете вы"]],[26,217,["وَتَوَكَّلۡ","عَلَى","ٱلۡعَزِيزِ","ٱلرَّحِيمِ"],"ватаваккал `алал `азиизир рахиим","Уповай на Могущественного, Милосердного,",["И уповай","на","Могущественного","Милосердного"]],[26,218,["ٱلَّذِي","يَرَىٰكَ","حِينَ","تَقُومُ"],"аллазии йарака хиина таḳуум","Который видит тебя, когда ты выстаиваешь намазы по ночам",["Который","видит тебя","когда","встаёшь ты"]],[26,219,["وَتَقَلُّبَكَ","فِي","ٱلسَّٰجِدِينَ"],"ватаḳаллубака фис сажидиин","и двигаешься среди падающих ниц.",["и движения твои","среди","падающих ниц"]],[26,220,["إِنَّهُۥ","هُوَ","ٱلسَّمِيعُ","ٱلۡعَلِيمُ"],"иннахуу хуас самии`ул `алиим","Воистину, Он - Слышащий, Знающий.",["Поистине, Он","Он","Слышащий","Знающий"]],[26,221,["هَلۡ","أُنَبِّئُكُمۡ","عَلَىٰ","مَن","تَنَزَّلُ","ٱلشَّيَٰطِينُ"],"хал унаббиукум `ала ман таназзалуш шайатиин","Поведать ли вам о том, на кого нисходят дьяволы?",["ли","сообщу вам","о","ком","нисходят","дьяволы"]],[26,222,["تَنَزَّلُ","عَلَىٰ","كُلِّ","أَفَّاكٍ","أَثِيمٖ"],"таназзалу `ала кулли аффакин асиим","Они нисходят на каждого лжеца и грешника.",["Нисходят они","на","каждого","лжеца","грешного"]],[26,223,["يُلۡقُونَ","ٱلسَّمۡعَ","وَأَكۡثَرُهُمۡ","كَٰذِبُونَ"],"йулḳуунас сам`а ва'аксарухум казибуун","Они подбрасывают услышанное, но большинство из них являются лжецами.",["подбрасывают","услышанное","а большинство из них","лжецы"]],[26,224,["وَٱلشُّعَرَآءُ","يَتَّبِعُهُمُ","ٱلۡغَاوُۥنَ"],"вашшу`арау йаттаби`ухумул гавуун","А за поэтами следуют заблудшие.",["а поэты","следуют за ними","заблудшие"]],[26,225,["أَلَمۡ","تَرَ","أَنَّهُمۡ","فِي","كُلِّ","وَادٖ","يَهِيمُونَ"],"алам тара аннахум фии кулли вадин йахиимуун","Разве ты не видишь, что они блуждают по всем долинам (слагают стихи на любые темы)",["разве не","видишь ты","что они","в","каждой","долине","блуждают"]],[26,226,["وَأَنَّهُمۡ","يَقُولُونَ","مَا","لَا","يَفۡعَلُونَ"],"ва'аннахум йаḳуулууна ма ла йаф`алуун","и говорят то, чего не делают?",["и что они","говорят","то, что","не","делают"]],[26,227,["إِلَّا","ٱلَّذِينَ","ءَامَنُواْ","وَعَمِلُواْ","ٱلصَّٰلِحَٰتِ","وَذَكَرُواْ","ٱللَّهَ","كَثِيرٗا","وَٱنتَصَرُواْ","مِنۢ","بَعۡدِ","مَا","ظُلِمُواْۗ","وَسَيَعۡلَمُ","ٱلَّذِينَ","ظَلَمُوٓاْ","أَيَّ","مُنقَلَبٖ","يَنقَلِبُونَ"],"иллал лазиина амануу ва`амилус салихати вазакаруллаха касииран вантасаруу мим ба`ди ма зулимуу васайа`ламул лазиина заламуу аййа мунḳалабин йанḳалибуун","Это не относится к тем, которые уверовали, совершают праведные деяния, многократно поминают Аллаха и защищаются после того, как с ними поступили несправедливо? А те, которые поступают несправедливо, скоро узнают, куда они вернутся.",["кроме","тех, которые","уверовали","и совершали","праведные дела","и поминали","Аллаха","много","и защищались","после","после","того как","с ними поступили несправедливо","и узнают","те, которые","поступили несправедливо","каким","возвращением","они вернутся"]]],"m":[[["مَآ","Не",26,207],["أَغۡنَىٰ","избавит",26,207],["عَنۡهُم","от них",26,207],["مَّا","то, чем",26,207],["كَانُواْ","были они",26,207],["يُمَتَّعُونَ","наделяемы благами",26,207],[207],["وَمَآ","И не",26,208],["أَهۡلَكۡنَا","погубили Мы",26,208],["مِن","ни одного",26,208],["قَرۡيَةٍ","селения",26,208],["إِلَّا","кроме как",26,208]],[["لَهَا","у него",26,208],["مُنذِرُونَ","предостерегающие",26,208],[208],["ذِكۡرَىٰ","в назидание",26,209],["وَمَا","и не",26,209],["كُنَّا","были Мы",26,209],["ظَٰلِمِينَ","несправедливыми",26,209],[209],["وَمَا","И не",26,210],["تَنَزَّلَتۡ","нисходили",26,210],["بِهِ","с ним",26,210]],[["ٱلشَّيَٰطِينُ",