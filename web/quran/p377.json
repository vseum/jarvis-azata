{"p":377,"j":19,"a":[[27,1,["طسٓۚ","تِلۡكَ","ءَايَٰتُ","ٱلۡقُرۡءَانِ","وَكِتَابٖ","مُّبِينٍ"],"тс тилка айатул ḳур'ани вакитабим мубиин","Та. Син. Это - аяты Корана и ясного Писания,",["Та. Син","это","аяты","Корана","и Писания","ясного"]],[27,2,["هُدٗى","وَبُشۡرَىٰ","لِلۡمُؤۡمِنِينَ"],"худан вабушра лилму'миниин","верное руководство и благая весть для верующих,",["руководство","и благая весть","для верующих"]],[27,3,["ٱلَّذِينَ","يُقِيمُونَ","ٱلصَّلَوٰةَ","وَيُؤۡتُونَ","ٱلزَّكَوٰةَ","وَهُم","بِٱلۡأٓخِرَةِ","هُمۡ","يُوقِنُونَ"],"аллазиина йуḳиимуунас салавата вайу'тууназ закавата вахум бил'ахирати хум йууḳинуун","которые совершают намаз, выплачивают закят и убеждены в Последней жизни.",["те, которые","совершают","намаз","и дают","закят","и они","в Последней жизни","они","убеждены"]],[27,4,["إِنَّ","ٱلَّذِينَ","لَا","يُؤۡمِنُونَ","بِٱلۡأٓخِرَةِ","زَيَّنَّا","لَهُمۡ","أَعۡمَٰلَهُمۡ","فَهُمۡ","يَعۡمَهُونَ"],"иннал лазиина ла йу'минууна бил'ахирати заййанна лахум а`малахум фахум йа`махуун","Воистину, тем, которые не веруют в Последнюю жизнь, Мы представили их деяния прекрасными, и они блуждают в растерянности.",["поистине","те, которые","не","веруют","в Последнюю жизнь","Мы украсили","для них","их деяния","и они","блуждают вслепую"]],[27,5,["أُوْلَٰٓئِكَ","ٱلَّذِينَ","لَهُمۡ","سُوٓءُ","ٱلۡعَذَابِ","وَهُمۡ","فِي","ٱلۡأٓخِرَةِ","هُمُ","ٱلۡأَخۡسَرُونَ"],"улаикал лазиина лахум суул `азаби вахум фил ахирати хумул ахсаруун","Они - те, которым уготованы злые мучения, а в Последней жизни они понесут наибольший убыток.",["те","которые","им","злое","наказание","и они","в","Последней жизни","они","наибольшие неудачники"]],[27,6,["وَإِنَّكَ","لَتُلَقَّى","ٱلۡقُرۡءَانَ","مِن","لَّدُنۡ","حَكِيمٍ","عَلِيمٍ"],"ва'иннака латулаḳḳал ḳур'ана мил ладун хакиимин `алиим","Воистину, ты получаешь Коран от Мудрого, Знающего.",["и поистине, ты","непременно получаешь","Коран","от","(Того), у Кого","Мудрого","Знающего"]],[27,7,["إِذۡ","قَالَ","مُوسَىٰ","لِأَهۡلِهِۦٓ","إِنِّيٓ","ءَانَسۡتُ","نَارٗا","سَـَٔاتِيكُم","مِّنۡهَا","بِخَبَرٍ","أَوۡ","ءَاتِيكُم","بِشِهَابٖ","قَبَسٖ","لَّعَلَّكُمۡ","تَصۡطَلُونَ"],"из ḳала мууса ли'ахлихии иннии анасту наран са'атиикум минха бихабарин ау атиикум бишихабин ḳабасил ла`аллакум тасталуун","Вот Муса (Моисей) сказал своей семье: «Воистину, я вижу огонь. Я принесу вам оттуда известие или горящую головню, чтобы вы могли согреться».",["вот","сказал","Муса","своей семье","поистине, я","заметил","огонь","я принесу вам","от него","известие","или","принесу вам","головню","горящую","чтобы вы","согрелись"]],[27,8,["فَلَمَّا","جَآءَهَا","نُودِيَ","أَنۢ","بُورِكَ","مَن","فِي","ٱلنَّارِ","وَمَنۡ","حَوۡلَهَا","وَسُبۡحَٰنَ","ٱللَّهِ","رَبِّ","ٱلۡعَٰلَمِينَ"],"фаламма жааха нуудийа ам буурика ман фин нари ваман хаулаха васубханаллахи раббил `аламиин","Когда он подошел туда, раздался глас: «Благословен тот, кто в огне, и тот, кто вокруг него. Пречист Аллах, Господь миров!",["и когда","он пришёл к нему","его позвали","что","благословен","тот, кто","в","огне","и тот, кто","вокруг него","и пречист","Аллах","Господь","миров"]],[27,9,["يَٰمُوسَىٰٓ","إِنَّهُۥٓ","أَنَا","ٱللَّهُ","ٱلۡعَزِيزُ","ٱلۡحَكِيمُ"],"йамууса иннахуу аналлахул `азиизул хакиим","О Муса (Моисей)! Воистину, Я - Аллах, Могущественный, Мудрый.",["о Муса","поистине, это","Я","Аллах","Могущественный","Мудрый"]],[27,10,["وَأَلۡقِ","عَصَاكَۚ","فَلَمَّا","رَءَاهَا","تَهۡتَزُّ","كَأَنَّهَا","جَآنّٞ","وَلَّىٰ","مُدۡبِرٗا","وَلَمۡ","يُعَقِّبۡۚ","يَٰمُوسَىٰ","لَا","تَخَفۡ","إِنِّي","لَا","يَخَافُ","لَدَيَّ","ٱلۡمُرۡسَلُونَ"],"ва'алḳи `асака фаламма ра'аха тахтаззу ка'аннаха жаннун валла мудбиран валам йу`аḳḳиб йамууса ла тахаф иннии ла йахафу ладаййал мурсалуун","Брось свой посох!». Когда он увидел, как тот извивается, словно змея, то бросился бежать назад и не вернулся (или не обернулся). Аллах сказал: «О Муса (Моисей)! Не бойся, ибо посланникам нечего бояться, когда они находятся предо Мною.",["и брось","свой посох","и когда","он увидел его","извивающимся","словно он","змея","он повернулся","убегая","и не","обернулся","о Муса","не","бойся","поистине, Я","не","боятся","предо Мною","посланники"]],[27,11,["إِلَّا","مَن","ظَلَمَ","ثُمَّ","بَدَّلَ","حُسۡنَۢا","بَعۡدَ","سُوٓءٖ","فَإِنِّي","غَفُورٞ","رَّحِيمٞ"],"илла ман залама сумма баддала хусна ба`да сууин фа'иннии гафуурур рахиим","А если кто совершил несправедливость, а затем заменил зло добром, то ведь Я - Прощающий, Милосердный.",["кроме","того, кто","поступил несправедливо","затем","заменил","добром","после","зла","то поистине, Я","Прощающий","Милосердный"]],[27,12,["وَأَدۡخِلۡ","يَدَكَ","فِي","جَيۡبِكَ","تَخۡرُجۡ","بَيۡضَآءَ","مِنۡ","غَيۡرِ","سُوٓءٖۖ","فِي","تِسۡعِ","ءَايَٰتٍ","إِلَىٰ","فِرۡعَوۡنَ","وَقَوۡمِهِۦٓۚ","إِنَّهُمۡ","كَانُواْ","قَوۡمٗا","فَٰسِقِينَ"],"ва'адхил йадака фии жайбика тахруж байдаа мин гайри сууин фии тис`и айатин ила фир`ауна ваḳаумихии иннахум кануу ḳауман фасиḳиин","Сунь свою руку за пазуху, и она выйдет белой (цвета молока, светящейся), без следов болезни. Вот некоторые из девяти знамений для Фараона и его народа. Воистину, они являются людьми нечестивыми».",["и введи","свою руку","за","пазуху","она выйдет","белой","без","без","вреда","в числе","девяти","знамений","к","Фараону","и его народу","поистине, они","были","людьми","нечестивыми"]],[27,13,["فَلَمَّا","جَآءَتۡهُمۡ","ءَايَٰتُنَا","مُبۡصِرَةٗ","قَالُواْ","هَٰذَا","سِحۡرٞ","مُّبِينٞ"],"фаламма жаатхум айатуна мубсиратан ḳалуу хаза сихрум мубиин","Когда Наши знамения были наглядно показаны им, они сказали: «Это - очевидное колдовство».",["и когда","пришли к ним","Наши знамения","наглядными","они сказали","это","колдовство","явное"]]],"m":[["b"],[["طسٓۚ","Та. Син",27,1],["تِلۡكَ","это",27,1],["ءَايَٰتُ","аяты",27,1],["ٱلۡقُرۡءَانِ","Корана",27,1],["وَكِتَابٖ","и Писания",27,1],["مُّبِينٍ","ясного",27,1],[1],["هُدٗى","руководство",27,2],["وَبُشۡرَىٰ","и благая весть",27,2]],[["لِلۡمُؤۡمِنِينَ","для верующих",27,2],[2],["ٱلَّذِينَ","те, которые",27,3],["يُقِيمُونَ","совершают",27,3],["ٱلصَّلَوٰةَ","намаз",27,3],["وَيُ