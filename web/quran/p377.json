7,9],["ٱلۡحَكِيمُ","Мудрый",27,9],[9],["وَأَلۡقِ","и брось",27,10],["عَصَاكَۚ","свой посох",27,10]],[["فَلَمَّا","и когда",27,10],["رَءَاهَا","он увидел его",27,10],["تَهۡتَزُّ","извивающимся",27,10],["كَأَنَّهَا","словно он",27,10],["جَآنّٞ","змея",27,10],["وَلَّىٰ","он повернулся",27,10],["مُدۡبِرٗا","убегая",27,10],["وَلَمۡ","и не",27,10],["يُعَقِّبۡۚ","обернулся",27,10],["يَٰمُوسَىٰ","о Муса",27,10],["لَا","не",27,10],["تَخَفۡ","бойся",27,10]],[["إِنِّي","поистине, Я",27,10],["لَا","не",27,10],["يَخَافُ","боятся",27,10],["لَدَيَّ","предо Мною",27,10],["ٱلۡمُرۡسَلُونَ","посланники",27,10],[10],["إِلَّا","кроме",27,11],["مَن","того, кто",27,11],["ظَلَمَ","поступил несправедливо",27,11],["ثُمَّ","затем",27,11],["بَدَّلَ","заменил",27,11],["حُسۡنَۢا","добром",27,11],["بَعۡدَ","после",27,11]],[["سُوٓءٖ","зла",27,11],["فَإِنِّي","то поистине, Я",27,11],["غَفُورٞ","Прощающий",27,11],["رَّحِيمٞ","Милосердный",27,11],[11],["وَأَدۡخِلۡ","и введи",27,12],["يَدَكَ","свою руку",27,12],["فِي","за",27,12],["جَيۡبِكَ","пазуху",27,12],["تَخۡرُجۡ","она выйдет",27,12],["بَيۡضَآءَ","белой",27,12]],[["مِنۡ","без",27,12],["غَيۡرِ","без",27,12],["سُوٓءٖۖ","вреда",27,12],["فِي","в числе",27,12],["تِسۡعِ","девяти",27,12],["ءَايَٰتٍ","знамений",27,12],["إِلَىٰ","к",27,12],["فِرۡعَوۡنَ","Фараону",27,12],["وَقَوۡمِهِۦٓۚ","и его народу",27,12],["إِنَّهُمۡ","поистине, они",27,12],["كَانُواْ","были",27,12],["قَوۡمٗا","людьми",27,12],["فَٰسِقِينَ","нечестивыми",27,12]],[[12],["فَلَمَّا","и когда",27,13],["جَآءَتۡهُمۡ","пришли к ним",27,13],["ءَايَٰتُنَا","Наши знамения",27,13],["مُبۡصِرَةٗ","наглядными",27,13],["قَالُواْ","они сказали",27,13],["هَٰذَا","это",27,13],["سِحۡرٞ","колдовство",27,13],["مُّبِينٞ","явное",27,13],[13]]]}