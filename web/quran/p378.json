{"p":378,"j":19,"a":[[27,14,["وَجَحَدُواْ","بِهَا","وَٱسۡتَيۡقَنَتۡهَآ","أَنفُسُهُمۡ","ظُلۡمٗا","وَعُلُوّٗاۚ","فَٱنظُرۡ","كَيۡفَ","كَانَ","عَٰقِبَةُ","ٱلۡمُفۡسِدِينَ"],"важахадуу биха вастайḳанатха анфусухум зулман ва`улувван фанзур кайфа кана `аḳибатул муфсидиин","Они отвергли их несправедливо и надменно, хотя в душе они были убеждены в их правдивости. Посмотри же, каким был конец распространявших нечестие!",["и отвергли","их","хотя убедились в них","их души","по несправедливости","и надменности","посмотри же","каким","был","конец","распространяющих нечестие"]],[27,15,["وَلَقَدۡ","ءَاتَيۡنَا","دَاوُۥدَ","وَسُلَيۡمَٰنَ","عِلۡمٗاۖ","وَقَالَا","ٱلۡحَمۡدُ","لِلَّهِ","ٱلَّذِي","فَضَّلَنَا","عَلَىٰ","كَثِيرٖ","مِّنۡ","عِبَادِهِ","ٱلۡمُؤۡمِنِينَ"],"валаḳад атайна давууда васулаймана `илман ваḳалал хамду лиллахил лазии фаддалана `ала касиирим мин `ибадихил му'миниин","Мы даровали знание Давуду (Давиду) и Сулейману (Соломону), и они сказали: «Хвала Аллаху, который предпочел нас многим из Своих верующих рабов».",["и уже","Мы даровали","Давуду","и Сулейману","знание","и они сказали","хвала","Аллаху","Который","возвысил нас","над","многими","из","Его рабов","верующих"]],[27,16,["وَوَرِثَ","سُلَيۡمَٰنُ","دَاوُۥدَۖ","وَقَالَ","يَٰٓأَيُّهَا","ٱلنَّاسُ","عُلِّمۡنَا","مَنطِقَ","ٱلطَّيۡرِ","وَأُوتِينَا","مِن","كُلِّ","شَيۡءٍۖ","إِنَّ","هَٰذَا","لَهُوَ","ٱلۡفَضۡلُ","ٱلۡمُبِينُ"],"вавариса сулайману давууда ваḳала йа'аййухан насу `уллимна мантиḳат тайри ва'уутиина мин кулли шай'ин инна хаза лахуал фадлул мубиин","Сулейман (Соломон) наследовал Давуду (Давиду) и сказал: «О люди! Мы обучены языку птиц, и нам даровано от всего сущего. Это и есть явное превосходство (или явная милость)».",["и наследовал","Сулейман","Давуду","и сказал","о","люди","мы обучены","языку","птиц","и нам даровано","из","всякой","вещи","поистине","это","непременно оно","превосходство","явное"]],[27,17,["وَحُشِرَ","لِسُلَيۡمَٰنَ","جُنُودُهُۥ","مِنَ","ٱلۡجِنِّ","وَٱلۡإِنسِ","وَٱلطَّيۡرِ","فَهُمۡ","يُوزَعُونَ"],"вахушира лисулаймана жунуудухуу минал жинни вал'инси ваттайри фахум йууза`уун","И собраны были к Сулейману (Соломону) его воины из числа джиннов, людей и птиц. Они были разделены на боевые порядки.",["и были собраны","для Сулеймана","его войска","из","джиннов","и людей","и птиц","и они","были выстроены рядами"]],[27,18,["حَتَّىٰٓ","إِذَآ","أَتَوۡاْ","عَلَىٰ","وَادِ","ٱلنَّمۡلِ","قَالَتۡ","نَمۡلَةٞ","يَٰٓأَيُّهَا","ٱلنَّمۡلُ","ٱدۡخُلُواْ","مَسَٰكِنَكُمۡ","لَا","يَحۡطِمَنَّكُمۡ","سُلَيۡمَٰنُ","وَجُنُودُهُۥ","وَهُمۡ","لَا","يَشۡعُرُونَ"],"хатта иза атау `ала вадин намли ḳалат намлатун йа'аййухан намлудхулуу масакинакум ла йахтиманнакум сулайману важунуудухуу вахум ла йаш`уруун","Когда они прибыли в долину муравьев, муравьиха сказала: «О муравьи! Войдите в свои жилища, чтобы Сулейман (Соломон) и его воины не погубили вас, даже не почувствовав этого».",["пока","когда","они пришли","к","долине","муравьёв","сказала","муравьиха","о","муравьи","войдите","в ваши жилища","да не","раздавят вас","Сулейман","и его войска","а они","не","почувствуют"]],[27,19,["فَتَبَسَّمَ","ضَاحِكٗا","مِّن","قَوۡلِهَا","وَقَالَ","رَبِّ","أَوۡزِعۡنِيٓ","أَنۡ","أَشۡكُرَ","نِعۡمَتَكَ","ٱلَّتِيٓ","أَنۡعَمۡتَ","عَلَيَّ","وَعَلَىٰ","وَٰلِدَيَّ","وَأَنۡ","أَعۡمَلَ","صَٰلِحٗا","تَرۡضَىٰهُ","وَأَدۡخِلۡنِي","بِرَحۡمَتِكَ","فِي","عِبَادِكَ","ٱلصَّٰلِحِينَ"],"фатабассама дахикам мин ḳаулиха ваḳала рабби аузи`нии ан ашкура ни`матакал латии ан`амта `алаййа ва`ала валидаййа ва'ан а`мала салихан тардаху ва'адхилнии бирахматика фии `ибадикас салихиин","Он улыбнулся, рассмеявшись от ее слов. Он сказал: «Господи! Внуши мне быть благодарным за Твою милость, которую Ты оказал мне и моим родителям, и совершать праведные деяния, которыми Ты будешь доволен. Введи меня по Своей милости в число Своих праведных рабов».",["и он улыбнулся","смеясь","от","её слов","и сказал","Господи","внуши мне","чтобы","я благодарил","Твою милость","которую","Ты оказал","мне","и","моим родителям","и чтобы","я делал","праведное","которым Ты доволен","и введи меня","по Твоей милости","в число","Твоих рабов","праведных"]],[27,20,["وَتَفَقَّدَ","ٱلطَّيۡرَ","فَقَالَ","مَا","لِيَ","لَآ","أَرَى","ٱلۡهُدۡهُدَ","أَمۡ","كَانَ","مِنَ","ٱلۡغَآئِبِينَ"],"ватафаḳḳадат тайра фаḳала ма лийа ла арал худхуда ам кана минал гаибиин","Осматривая птиц, он сказал: «Что со мной? Почему я не вижу удода? Или же он оказался в числе отсутствующих?",["и он осмотрел","птиц","и сказал","что","со мной","не","вижу я","удода","или","он оказался","среди","отсутствующих"]],[27,21,["لَأُعَذِّبَنَّهُۥ","عَذَابٗا","شَدِيدًا","أَوۡ","لَأَاْذۡبَحَنَّهُۥٓ","أَوۡ","لَيَأۡتِيَنِّي","بِسُلۡطَٰنٖ","مُّبِينٖ"],"ла'у`аззибаннахуу `азабан шадиидан ау ла'азбаханнахуу ау лайа'тийаннии бисултаним мубиин","Я подвергну его суровым мучениям или же зарежу его, если он не приведет ясного довода».",["непременно накажу его","наказанием","суровым","или","непременно зарежу его","или (пусть)","непременно приведёт мне","довод","ясный"]],[27,22,["فَمَكَثَ","غَيۡرَ","بَعِيدٖ","فَقَالَ","أَحَطتُ","بِمَا","لَمۡ","تُحِطۡ","بِهِۦ","وَجِئۡتُكَ","مِن","سَبَإِۭ","بِنَبَإٖ","يَقِينٍ"],"фамакаса гайра ба`иидин фаḳала ахатту бима лам тухит бихии важи'тука мин сабаи бинабаин йаḳиин","Он оставался там недолго и сказал: «Я узнал о том, чего ты не знаешь. Я прибыл к тебе из Сабы (Савы) с достоверным известием.",["и пробыл он","не","долго","и сказал","я постиг","то, что","не","постиг ты","это","и я пришёл к тебе","из","Сабы","с известием","достоверным"]]],"m":[[["وَجَحَدُواْ","и отвергли",27,14],["بِهَا","их",27,14],["وَٱسۡتَيۡقَنَتۡهَآ","хотя убедились в них",27,14],["أَنفُسُهُمۡ","их души",27,14],["ظُلۡمٗا","по несправедливости",27,14],["وَعُلُوّٗاۚ","и надменности",27,14],["فَٱنظُرۡ","посмотри же",27,14],["كَيۡفَ","каким",27,14]],[["كَانَ","был",27,14],["عَٰقِبَةُ","конец",27,14],["ٱلۡمُفۡسِدِينَ","распространяющих нечестие",27,14],[14],["وَلَقَدۡ","и уже",27,15],["ءَاتَيۡنَا","Мы даровали",27,15],["دَاوُۥدَ","Давуду",27,15],["وَسُلَيۡمَٰنَ","и Сулейману",27,15],["عِلۡمٗاۖ","знание",27,15]],[["وَقَالَا","и они сказали",27,15],["ٱلۡحَمۡدُ","хвала",27,15],["لِلَّهِ","Аллаху",27,15],["ٱلَّذِي","Который",27,15],["فَضَّلَنَا","возвысил нас",27,15],["عَلَىٰ","над",27,15],["كَثِيرٖ","многими",27,15],["مِّنۡ","из",27,15],["عِبَادِهِ","Его рабов",27,15],["ٱلۡمُؤۡمِنِينَ","верующих",27,15],[15]],[["وَوَرِثَ","и наследовал",27,16],["سُلَيۡمَٰنُ","Сулейман",27,16],["دَاوُۥدَۖ","Давуду",27,16],["وَقَالَ","и сказал",27,16],["يَٰٓأَيُّهَا","о",27,16],["ٱلنَّاسُ","люди",27,16],["عُلِّمۡنَا","мы обучены",27,16],["مَنطِقَ","языку",27,16],["ٱلطَّيۡرِ","птиц",27,16]],[["وَأُوتِينَا","и нам даровано",27,16],["مِن","из",27,16],["كُلِّ","всякой",27,16],["شَيۡءٍۖ","вещи",27,16],["إِنَّ","поистине",27,16],["هَٰذَا","это",27,16],["لَهُوَ","непременно оно",27,16],["ٱلۡفَضۡلُ","превосходство",27,16],["ٱلۡمُبِينُ","явное",27,16],[16],["وَحُشِرَ","и были собраны",27,17]],[["لِسُلَيۡمَٰنَ","для Сулеймана",27,17],["جُنُودُهُۥ","его войска",27,17],["مِنَ","из",27,17],["ٱلۡجِنِّ","джиннов",27,17],["وَٱلۡإِنسِ","и людей",27,17],["وَٱلطَّيۡرِ","и птиц",27,17],["فَهُمۡ","и они",27,17],["يُوزَعُونَ","были выстроены рядами",27,17],[17]],[["حَتَّىٰٓ","пока",27,18],["إِذَآ","когда",27,18],["أَتَوۡاْ","они пришли",27,18],["عَلَىٰ","к",27,18],["وَادِ","долине",27,18],["ٱلنَّمۡلِ","муравьёв",27,18],["قَالَتۡ","сказала",27,18],["نَمۡلَةٞ","муравьиха",27,18],["يَٰٓأَيُّهَا","о",27,18],["ٱلنَّمۡلُ","муравьи",27,18],["ٱدۡخُلُواْ","войдите",27,18]],[["مَسَٰكِنَكُمۡ","в ваши жилища",27,18],["لَا","да не",27,18],["يَحۡطِمَنَّكُمۡ","раздавят вас",27,18],["سُلَيۡمَٰنُ","Сулейман",27,18],["وَجُنُودُهُۥ","и его войска",27,18],["وَهُمۡ","а они",27,18],["لَا","не",27,18],["يَشۡعُرُونَ","почувствуют",27,18]],[[18],["فَتَبَسَّمَ","и он улыбнулся",27,19],["ضَاحِكٗا","смеясь",27,19],["مِّن","от",27,19],["قَوۡلِهَا","её слов",27,19],["وَقَالَ","и сказал",27,19],["رَبِّ","Господи",27,19],["أَوۡزِعۡنِيٓ","внуши мне",27,19],["أَنۡ","чтобы",27,19],["أَشۡكُرَ","я благодарил",27,19]],[["نِعۡمَتَكَ","Твою милость",27,19],["ٱلَّتِيٓ","которую",27,19],["أَنۡعَمۡتَ","Ты оказал",27,19],["عَلَيَّ","мне",27,19],["وَعَلَىٰ","и",27,19],["وَٰلِدَيَّ","моим родителям",27,19],["وَأَنۡ","и чтобы",27,19],["أَعۡمَلَ","я делал",27,19],["صَٰلِحٗا","праведное",27,19]],[["تَرۡضَىٰهُ","которым Ты доволен",27,19],["وَأَدۡخِلۡنِي","и введи меня",27,19],["بِرَحۡمَتِكَ","по Твоей милости",27,19],["فِي","в число",27,19],["عِبَادِكَ","Твоих рабов",27,19],["ٱلصَّٰلِحِينَ","праведных",27,19],[19]],[["وَتَفَقَّدَ","и он осмотрел",27,20],["ٱلطَّيۡرَ","птиц",27,20],["فَقَالَ","и сказал",27,20],["مَا","что",27,20],["لِيَ","со мной",27,20],["لَآ","не",27,20],["أَرَى","вижу я",27,20],["ٱلۡهُدۡهُدَ","удода",27,20],["أَمۡ","или",27,20],["كَانَ","он оказался",27,20],["مِنَ","среди",27,20]],[["ٱلۡغَآئِبِينَ","отсутствующих",27,20],[20],["لَأُعَذِّبَنَّهُۥ","непременно накажу его",27,21],["عَذَابٗا","наказанием",27,21],["شَدِيدًا","суровым",27,21],["أَوۡ","или",27,21],["لَأَاْذۡبَحَنَّهُۥٓ","непременно зарежу его",27,21]],[["أَوۡ","или (пусть)",27,21],["لَيَأۡتِيَنِّي","непременно приведёт мне",27,21],["بِسُلۡطَٰنٖ","довод",27,21],["مُّبِينٖ","ясный",27,21],[21],["فَمَكَثَ","и пробыл он",27,22],["غَيۡرَ","не",27,22],["بَعِيدٖ","долго",27,22],["فَقَالَ","и сказал",27,22]],[["أَحَطتُ","я постиг",27,22],["بِمَا","то, что",27,22],["لَمۡ","не",27,22],["تُحِطۡ","постиг ты",27,22],["بِهِۦ","это",27,22],["وَجِئۡتُكَ","и я пришёл к тебе",27,22],["مِن","из",27,22],["سَبَإِۭ","Сабы",27,22],["بِنَبَإٖ","с известием",27,22],["يَقِينٍ","достоверным",27,22],[22]]]}