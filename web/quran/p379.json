{"p":379,"j":19,"a":[[27,23,["إِنِّي","وَجَدتُّ","ٱمۡرَأَةٗ","تَمۡلِكُهُمۡ","وَأُوتِيَتۡ","مِن","كُلِّ","شَيۡءٖ","وَلَهَا","عَرۡشٌ","عَظِيمٞ"],"иннии важадттумраатан тамликухум ва'уутийат мин кулли шай'ин валаха `аршун `азиим","Я обнаружил там женщину, которая царствует над ними. Ей даровано все, и у нее есть великий трон.",["поистине, я","нашёл","женщину","царствующую над ними","и ей даровано","из","всякой","вещи","и у неё","трон","великий"]],[27,24,["وَجَدتُّهَا","وَقَوۡمَهَا","يَسۡجُدُونَ","لِلشَّمۡسِ","مِن","دُونِ","ٱللَّهِ","وَزَيَّنَ","لَهُمُ","ٱلشَّيۡطَٰنُ","أَعۡمَٰلَهُمۡ","فَصَدَّهُمۡ","عَنِ","ٱلسَّبِيلِ","فَهُمۡ","لَا","يَهۡتَدُونَ"],"важадттуха ваḳаумаха йасжудууна лишшамси мин дууниллахи вазаййана лахумуш шайтану а`малахум фасаддахум `анис сабиили фахум ла йахтадуун","Я увидел, что она вместе со своим народом поклоняется солнцу вместо Аллаха. Дьявол представил им их деяния прекрасными и сбил их с пути, и они не следуют прямым путем.",["я нашёл её","и её народ","поклоняющимися","солнцу","помимо","помимо","Аллаха","и украсил","для них","дьявол","их деяния","и отвратил их","от","пути","и они","не","следуют прямым путём"]],[27,25,["أَلَّاۤ","يَسۡجُدُواْۤ","لِلَّهِ","ٱلَّذِي","يُخۡرِجُ","ٱلۡخَبۡءَ","فِي","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِ","وَيَعۡلَمُ","مَا","تُخۡفُونَ","وَمَا","تُعۡلِنُونَ"],"алла йасжудуу лиллахил лазии йухрижул хаб'а фис самавати вал'арди вайа`ламу ма тухфууна вама ту`линуун","Это было сделано для того, чтобы они не поклонялись Аллаху, Который выявляет все сокрытое на небесах и на земле и знает то, что вы скрываете, и то, что вы обнаруживаете.",["чтобы не","они поклонялись","Аллаху","Который","выводит","сокрытое","на","небесах","и земле","и знает","то, что","вы скрываете","и то, что","вы обнаруживаете"]],[27,26,["ٱللَّهُ","لَآ","إِلَٰهَ","إِلَّا","هُوَ","رَبُّ","ٱلۡعَرۡشِ","ٱلۡعَظِيمِ۩"],"аллаху ла илаха илла хуа раббул `аршил `азиим","Нет иного божества, кроме Аллаха, Господа великого Трона».",["Аллах","нет","божества","кроме","Него","Господь","Трона","великого"]],[27,27,["قَالَ","سَنَنظُرُ","أَصَدَقۡتَ","أَمۡ","كُنتَ","مِنَ","ٱلۡكَٰذِبِينَ"],"ḳала сананзуру асадаḳта ам кунта минал казибиин","Он сказал: «Посмотрим, сказал ли ты правду или же являешься одним из лжецов.",["он сказал","мы посмотрим","сказал ли ты правду","или","ты","из","лжецов"]],[27,28,["ٱذۡهَب","بِّكِتَٰبِي","هَٰذَا","فَأَلۡقِهۡ","إِلَيۡهِمۡ","ثُمَّ","تَوَلَّ","عَنۡهُمۡ","فَٱنظُرۡ","مَاذَا","يَرۡجِعُونَ"],"изхаб бикитабии хаза фа'алḳих илайхим сумма тавалла `анхум фанзур маза йаржи`уун","Отправляйся с этим посланием от меня и брось его им. Затем встань поодаль и погляди, что они ответят».",["отправляйся","с моим письмом","этим","и брось его","им","затем","отойди","от них","и посмотри","что","они ответят"]],[27,29,["قَالَتۡ","يَٰٓأَيُّهَا","ٱلۡمَلَؤُاْ","إِنِّيٓ","أُلۡقِيَ","إِلَيَّ","كِتَٰبٞ","كَرِيمٌ"],"ḳалат йа'аййухал малау иннии улḳийа илаййа китабун кариим","Она сказала: «О знать! Мне было брошено благородное письмо.",["она сказала","о","знать","поистине, я","брошено","мне","письмо","благородное"]],[27,30,["إِنَّهُۥ","مِن","سُلَيۡمَٰنَ","وَإِنَّهُۥ","بِسۡمِ","ٱللَّهِ","ٱلرَّحۡمَٰنِ","ٱلرَّحِيمِ"],"иннахуу мин сулаймана ва'иннахуу бисмиллахир рахманир рахиим","Оно - от Сулеймана (Соломона), и в нем сказано: «Во имя Аллаха, Милостивого, Милосердного!",["поистине, оно","от","Сулеймана","и поистине, оно","во имя","Аллаха","Милостивого","Милосердного"]],[27,31,["أَلَّا","تَعۡلُواْ","عَلَيَّ","وَأۡتُونِي","مُسۡلِمِينَ"],"алла та`луу `алаййа ва'туунии муслимиин","Не превозноситесь предо мною и явитесь ко мне покорными»».",["чтобы не","превозносились вы","надо мной","и придите ко мне","покорившимися"]],[27,32,["قَالَتۡ","يَٰٓأَيُّهَا","ٱلۡمَلَؤُاْ","أَفۡتُونِي","فِيٓ","أَمۡرِي","مَا","كُنتُ","قَاطِعَةً","أَمۡرًا","حَتَّىٰ","تَشۡهَدُونِ"],"ḳалат йа'аййухал малау афтуунии фии амрии ма кунту ḳати`атан амран хатта ташхадуун","Она сказала: «О знать! Посоветуйте, как мне поступить. Я никогда не принимала решений самостоятельно, пока вы находились рядом со мной».",["она сказала","о","знать","посоветуйте мне","в","моём деле","не","была я","решающей","дело","пока не","вы присутствуете при мне"]],[27,33,["قَالُواْ","نَحۡنُ","أُوْلُواْ","قُوَّةٖ","وَأُوْلُواْ","بَأۡسٖ","شَدِيدٖ","وَٱلۡأَمۡرُ","إِلَيۡكِ","فَٱنظُرِي","مَاذَا","تَأۡمُرِينَ"],"ḳалуу нахну улуу ḳувватин ва'улуу ба'син шадиидин вал'амру илайки фанзурии маза та'муриин","Они сказали: «Мы обладаем силой и великой мощью, но решение остается за тобой. Подумай, что ты прикажешь делать».",["они сказали","мы","обладатели","силы","и обладатели","мощи","великой","а решение","за тобой","посмотри же","что","ты прикажешь"]],[27,34,["قَالَتۡ","إِنَّ","ٱلۡمُلُوكَ","إِذَا","دَخَلُواْ","قَرۡيَةً","أَفۡسَدُوهَا","وَجَعَلُوٓاْ","أَعِزَّةَ","أَهۡلِهَآ","أَذِلَّةٗۚ","وَكَذَٰلِكَ","يَفۡعَلُونَ"],"ḳалат иннал мулуука иза дахалуу ḳарйатан афсадууха важа`алуу а`иззата ахлиха азиллатан ваказалика йаф`алуун","Она сказала: «Когда цари вторгаются в селение, они разрушают его и превращают его самых славных жителей в самых униженных. Вот так они поступают.",["она сказала","поистине","цари","когда","входят","в селение","портят его","и делают","самых славных","его жителей","униженными","и так","они делают"]],[27,35,["وَإِنِّي","مُرۡسِلَةٌ","إِلَيۡهِم","بِهَدِيَّةٖ","فَنَاظِرَةُۢ","بِمَ","يَرۡجِعُ","ٱلۡمُرۡسَلُونَ"],"ва'иннии мурсилатун илайхим бихадиййатин фаназирату бима йаржи`ул мурсалуун","Я пошлю им дары и посмотрю, с чем вернутся послы».",["и поистине, я","пошлю","им","дар","и посмотрю","с чем","вернутся","посланные"]]],"m":[[["إِنِّي","поистине, я",27,23],["وَجَدتُّ","нашёл",27,23],["ٱمۡرَأَةٗ","женщину",27,23],["تَمۡلِكُهُمۡ","царствующую над ними",27,23],["وَأُوتِيَتۡ","и ей даровано",27,23],["مِن","из",27,23],["كُلِّ","всякой",27,23],["شَيۡءٖ","вещи",27,23],["وَلَهَا","и у неё",27,23]],[["عَرۡشٌ","трон",27,23],["عَظِيمٞ","великий",27,23],[23],["وَجَدتُّهَا","я нашёл её",27,24],["وَقَوۡمَهَا","и её народ",27,24],["يَسۡجُدُونَ","поклоняющимися",27,24],["لِلشَّمۡسِ","солнцу",27