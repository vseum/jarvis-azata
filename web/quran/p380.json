{"p":380,"j":19,"a":[[27,36,["فَلَمَّا","جَآءَ","سُلَيۡمَٰنَ","قَالَ","أَتُمِدُّونَنِ","بِمَالٖ","فَمَآ","ءَاتَىٰنِۦَ","ٱللَّهُ","خَيۡرٞ","مِّمَّآ","ءَاتَىٰكُمۚ","بَلۡ","أَنتُم","بِهَدِيَّتِكُمۡ","تَفۡرَحُونَ"],"фаламма жаа сулаймана ḳала атумиддуунани бималин фама атанаиллаху хайрум мимма атакум бал антум бихадиййатикум тафрахуун","Когда они прибыли к Сулейману (Соломону), он сказал: «Неужели вы можете помочь мне богатством? То, что даровал мне Аллах, лучше того, что Он даровал вам. Нет, это вы радуетесь преподнесенным вам дарам.",["и когда","пришёл (посланец)","к Сулейману","он сказал","разве вы поможете мне","богатством","но то, что","даровал мне","Аллах","лучше","того, что","Он даровал вам","нет же","вы","своему дару","радуетесь"]],[27,37,["ٱرۡجِعۡ","إِلَيۡهِمۡ","فَلَنَأۡتِيَنَّهُم","بِجُنُودٖ","لَّا","قِبَلَ","لَهُم","بِهَا","وَلَنُخۡرِجَنَّهُم","مِّنۡهَآ","أَذِلَّةٗ","وَهُمۡ","صَٰغِرُونَ"],"иржи` илайхим фалана'тийаннахум бижунуудил ла ḳибала лахум биха валанухрижаннахум минха азиллатан вахум сагируун","Возвращайся к ним, а мы обязательно прибудем с войском, перед которым они не устоят, и изгоним их оттуда униженными и ничтожными».",["вернись","к ним","и мы непременно придём к ним","с войсками","нет","силы противостоять","у них","им","и непременно изгоним их","оттуда","униженными","и они","ничтожны"]],[27,38,["قَالَ","يَٰٓأَيُّهَا","ٱلۡمَلَؤُاْ","أَيُّكُمۡ","يَأۡتِينِي","بِعَرۡشِهَا","قَبۡلَ","أَن","يَأۡتُونِي","مُسۡلِمِينَ"],"ḳала йа'аййухал малау аййукум йа'тиинии би`аршиха ḳабла ан йа'туунии муслимиин","Он сказал: «О знать! Кто из вас принесет мне ее трон до того, как они предстанут предо мною покорными?».",["он сказал","о","знать","кто из вас","принесёт мне","её трон","прежде","чем","они придут ко мне","покорившимися"]],[27,39,["قَالَ","عِفۡرِيتٞ","مِّنَ","ٱلۡجِنِّ","أَنَا۠","ءَاتِيكَ","بِهِۦ","قَبۡلَ","أَن","تَقُومَ","مِن","مَّقَامِكَۖ","وَإِنِّي","عَلَيۡهِ","لَقَوِيٌّ","أَمِينٞ"],"ḳала `ифриитум минал жинни ана атиика бихии ḳабла ан таḳуума мим маḳамика ва'иннии `алайхи лаḳавиййун амиин","Силач из числа джиннов сказал: «Я принесу его тебе прежде, чем ты встанешь со своего места (до окончания собрания). Я достаточно силен и заслуживаю доверия для этого».",["сказал","силач","из","джиннов","я","принесу тебе","его","прежде","чем","ты встанешь","с","своего места","и поистине, я","для этого","непременно силён","надёжен"]],[27,40,["قَالَ","ٱلَّذِي","عِندَهُۥ","عِلۡمٞ","مِّنَ","ٱلۡكِتَٰبِ","أَنَا۠","ءَاتِيكَ","بِهِۦ","قَبۡلَ","أَن","يَرۡتَدَّ","إِلَيۡكَ","طَرۡفُكَۚ","فَلَمَّا","رَءَاهُ","مُسۡتَقِرًّا","عِندَهُۥ","قَالَ","هَٰذَا","مِن","فَضۡلِ","رَبِّي","لِيَبۡلُوَنِيٓ","ءَأَشۡكُرُ","أَمۡ","أَكۡفُرُۖ","وَمَن","شَكَرَ","فَإِنَّمَا","يَشۡكُرُ","لِنَفۡسِهِۦۖ","وَمَن","كَفَرَ","فَإِنَّ","رَبِّي","غَنِيّٞ","كَرِيمٞ"],"ḳалал лазии `индахуу `илмум минал китаби ана атиика бихии ḳабла ан йартадда илайка тарфука фаламма ра'аху мустаḳирран `индахуу ḳала хаза мин фадли раббии лийаблуании а'ашкуру ам акфуру ваман шакара фа'иннама йашкуру линафсихии ваман кафара фа'инна раббии ганиййун кариим","А тот, который обладал знанием из Писания, сказал: «Я принесу его тебе в мгновение ока». Увидев установленный перед ним трон, он сказал: «Мой Господь оказал мне эту милость для того, чтобы испытать меня, буду ли я благодарен или же буду непризнателен. Кто благодарен, тот благодарен во благо себе. А если кто непризнателен, то ведь мой Господь - Богатый, Великодушный».",["сказал","тот, который","у него","знание","из","Писания","я","принесу тебе","его","прежде","чем","вернётся","к тебе","твой взгляд","и когда","он увидел его","установленным","перед ним","он сказал","это","от","милости","моего Господа","чтобы испытать меня","буду ли я благодарен","или","буду неблагодарен","и кто","благодарен","то лишь","благодарен он","для самого себя","а кто","неблагодарен","то поистине","мой Господь","Богатый","Щедрый"]],[27,41,["قَالَ","نَكِّرُواْ","لَهَا","عَرۡشَهَا","نَنظُرۡ","أَتَهۡتَدِيٓ","أَمۡ","تَكُونُ","مِنَ","ٱلَّذِينَ","لَا","يَهۡتَدُونَ"],"ḳала наккируу лаха `аршаха нанзур атахтадии ам такууну минал лазиина ла йахтадуун","Он сказал: «Переделайте ее трон так, чтобы она не узнала его, и мы посмотрим, следует она прямым путем или же является одной из тех, кто не следует прямым путем».",["он сказал","измените","для неё","её трон","посмотрим мы","последует ли она прямым путём","или","окажется","из","тех, которые","не","следуют прямым путём"]],[27,42,["فَلَمَّا","جَآءَتۡ","قِيلَ","أَهَٰكَذَا","عَرۡشُكِۖ","قَالَتۡ","كَأَنَّهُۥ","هُوَۚ","وَأُوتِينَا","ٱلۡعِلۡمَ","مِن","قَبۡلِهَا","وَكُنَّا","مُسۡلِمِينَ"],"фаламма жаат ḳиила ахаказа `аршуки ḳалат ка'аннахуу хуа ва'уутиинал `илма мин ḳаблиха вакунна муслимиин","Когда она прибыла, ей сказали: «Таков ли твой трон?». Она сказала: «Будто это он и есть». Сулейман (Соломон) сказал: «Знание было даровано нам раньше, чем ей, и мы являемся мусульманами».",["и когда","она пришла","было сказано","разве таков","твой трон","она сказала","словно это","он","а нам было даровано","знание","до","неё","и мы были","покорившимися (мусульманами)"]],[27,43,["وَصَدَّهَا","مَا","كَانَت","تَّعۡبُدُ","مِن","دُونِ","ٱللَّهِۖ","إِنَّهَا","كَانَتۡ","مِن","قَوۡمٖ","كَٰفِرِينَ"],"васаддаха ма канат та`буду мин дууниллахи иннаха канат мин ḳаумин кафириин","Ей мешало то, чему она поклонялась вместо Аллаха, ведь она принадлежала к неверующему народу.",["и отвратило её","то, чему","она была","поклонялась","помимо","помимо","Аллаха","поистине, она","была","из","народа","неверующих"]],[27,44,["قِيلَ","لَهَا","ٱدۡخُلِي","ٱلصَّرۡحَۖ","فَلَمَّا","رَأَتۡهُ","حَسِبَتۡهُ","لُجَّةٗ","وَكَشَفَتۡ","عَن","سَاقَيۡهَاۚ","قَالَ","إِنَّهُۥ","صَرۡحٞ","مُّمَرَّدٞ","مِّن","قَوَارِيرَۗ","قَالَتۡ","رَبِّ","إِنِّي","ظَلَمۡتُ","نَفۡسِي","وَأَسۡلَمۡتُ","مَعَ","سُلَيۡمَٰنَ","لِلَّهِ","رَبِّ","ٱلۡعَٰلَمِينَ"],"ḳиила лахадхулис сарха фаламма ра'атху хасибатху лужжатан вакашафат `ан саḳайха ḳала иннахуу сархум мумаррадум мин ḳавариира ḳалат рабби иннии заламту нафсии ва'асламту ма`а сулаймана лиллахи раббил `аламиин","Ей сказали: «Войди во дворец». Увидев его, она приняла его за водную пучину и обнажила свои голени. Он сказал: «Это - отшлифованный дворец из хрусталя». Она сказала: «Господи! Я была несправедлива к самой себе. Я покоряюсь вместе с Сулейманом (Соломоном) Аллаху, Господу миров».",["было сказано","ей","войди","во дворец","и когда","она увидела его","она сочла его","водной пучиной","и обнажила","(от)","свои голени","он сказал","поистине, это","дворец","гладкий","из","хрусталя","она сказала","Господи","поистине, я","поступила несправедливо","к самой себе","и я покорилась","вместе с","Сулейманом","Аллаху","Господу","миров"]]],"m":[[["فَلَمَّا","и когда",27,36],["جَآءَ","пришёл (посланец)",27,36],["سُلَيۡمَٰنَ","к Сулейману",27,36],["قَالَ","он сказал",27,36],["أَتُمِدُّونَنِ","разве вы поможете мне",27,36],["بِمَالٖ","богатством",27,36],["فَمَآ","но то, что",27,36],["ءَاتَىٰنِۦَ","даровал мне",27,36],["ٱللَّهُ","Аллах",27,36],["خَيۡرٞ","лучше",27,36],["مِّمَّآ","того, что",27,36]],[["ءَاتَىٰكُمۚ","Он даровал вам",27,36],["بَلۡ","нет же",27,36],["أَنتُم","вы",27,36],["بِهَدِيَّتِكُمۡ","своему дару",27,36],["تَفۡرَحُونَ","радуетесь",27,36],[36],["ٱرۡجِعۡ","вернись",27,37],["إِلَيۡهِمۡ","к ним",27,37],["فَلَنَأۡتِيَنَّهُم","и мы непременно придём к ним",27,37]],[["بِجُنُودٖ","с войсками",27,37],["لَّا","нет",27,37],["قِبَلَ","силы противостоять",27,37],["لَهُم","у них",27,37],["بِهَا","им",27,37],["وَلَنُخۡرِجَنَّهُم","и непременно изгоним их",27,37],["مِّنۡهَآ","оттуда",27,37],["أَذِلَّةٗ","униженными",27,37],["وَهُمۡ","и они",27,37],["صَٰغِرُونَ","ничтожны",27,37],[37],["قَالَ","он сказал",27,38]],[["يَٰٓأَيُّهَا","о",27,38],["ٱلۡمَلَؤُاْ","знать",27,38],["أَيُّكُمۡ","кто из вас",27,38],["يَأۡتِينِي","принесёт мне",27,38],["بِعَرۡشِهَا","её трон",27,38],["قَبۡلَ","прежде",27,38],["أَن","чем",27,38],["يَأۡتُونِي","они придут ко мне",27,38],["مُسۡلِمِينَ","покорившимися",27,38],[38]],[["قَالَ","сказал",27,39],["عِفۡرِيتٞ","силач",27,39],["مِّنَ","из",27,39],["ٱلۡجِنِّ","джиннов",27,3