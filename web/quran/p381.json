{"p":381,"j":19,"a":[[27,45,["وَلَقَدۡ","أَرۡسَلۡنَآ","إِلَىٰ","ثَمُودَ","أَخَاهُمۡ","صَٰلِحًا","أَنِ","ٱعۡبُدُواْ","ٱللَّهَ","فَإِذَا","هُمۡ","فَرِيقَانِ","يَخۡتَصِمُونَ"],"валаḳад арсална ила самууда ахахум салихан ани`будуллаха фа'иза хум фарииḳани йахтасимуун","Мы послали к самудянам их брата Салиха, чтобы они поклонялись Аллаху, но они стали двумя препирающимися группами.",["и уже","Мы послали","к","самудянам","их брата","Салиха","чтобы","поклоняйтесь","Аллаху","и вот","они","две группы","препираются"]],[27,46,["قَالَ","يَٰقَوۡمِ","لِمَ","تَسۡتَعۡجِلُونَ","بِٱلسَّيِّئَةِ","قَبۡلَ","ٱلۡحَسَنَةِۖ","لَوۡلَا","تَسۡتَغۡفِرُونَ","ٱللَّهَ","لَعَلَّكُمۡ","تُرۡحَمُونَ"],"ḳала йаḳауми лима таста`жилууна биссаййиати ḳаблал хасанати лаула тастагфирууналлаха ла`аллакум турхамуун","Он сказал: «О мой народ! Почему вы торопите зло прежде добра? Почему вы не просите у Аллаха прощения? Быть может, вы будете помилованы».",["он сказал","о мой народ","почему","вы торопите","зло","прежде","добра","почему бы не","просите прощения","у Аллаха","быть может, вы","будете помилованы"]],[27,47,["قَالُواْ","ٱطَّيَّرۡنَا","بِكَ","وَبِمَن","مَّعَكَۚ","قَالَ","طَٰٓئِرُكُمۡ","عِندَ","ٱللَّهِۖ","بَلۡ","أَنتُمۡ","قَوۡمٞ","تُفۡتَنُونَ"],"ḳалуттаййарна бика вабимам ма`ака ḳала та'ирукум `индаллахи бал антум ḳаумун туфтануун","Они сказали: «Мы видим дурное предзнаменование в тебе и тех, кто с тобой». Он сказал: «Ваше дурное предзнаменование - у Аллаха, но вы являетесь народом, который подвергают искушению».",["они сказали","мы видим дурной знак","в тебе","и в тех, кто","с тобой","он сказал","ваш дурной знак","у","Аллаха","нет же","вы","народ","подвергаетесь испытанию"]],[27,48,["وَكَانَ","فِي","ٱلۡمَدِينَةِ","تِسۡعَةُ","رَهۡطٖ","يُفۡسِدُونَ","فِي","ٱلۡأَرۡضِ","وَلَا","يُصۡلِحُونَ"],"вакана фил мадиинати тис`ату рахтин йуфсидууна фил арди вала йуслихуун","В городе было девять человек, которые распространяли на земле нечестие и ничего не улучшали.",["и было","в","городе","девять","человек","сеют нечестие","на","земле","и не","исправляют"]],[27,49,["قَالُواْ","تَقَاسَمُواْ","بِٱللَّهِ","لَنُبَيِّتَنَّهُۥ","وَأَهۡلَهُۥ","ثُمَّ","لَنَقُولَنَّ","لِوَلِيِّهِۦ","مَا","شَهِدۡنَا","مَهۡلِكَ","أَهۡلِهِۦ","وَإِنَّا","لَصَٰدِقُونَ"],"ḳалуу таḳасамуу биллахи ланубаййитаннахуу ва'ахлахуу сумма ланаḳууланна ливалиййихии ма шахидна махлика ахлихии ва'инна ласадиḳуун","Они сказали: «Поклянитесь друг другу Аллахом, что ночью мы обязательно нападем на Салиха и его семью, а потом скажем его близкому родственнику, что мы не присутствовали при убийстве его семьи и что мы говорим правду».",["они сказали","поклянитесь друг другу","Аллахом","непременно нападём ночью на него","и его семью","затем","непременно скажем","его родственнику","не","мы присутствовали","при гибели","его семьи","и поистине, мы","непременно правдивы"]],[27,50,["وَمَكَرُواْ","مَكۡرٗا","وَمَكَرۡنَا","مَكۡرٗا","وَهُمۡ","لَا","يَشۡعُرُونَ"],"вамакаруу макран вамакарна макран вахум ла йаш`уруун","Они замыслили хитрость, и Мы замыслили хитрость, но они не ощущали этого.",["и они замыслили","хитрость","и Мы замыслили","хитрость","а они","не","ощущали"]],[27,51,["فَٱنظُرۡ","كَيۡفَ","كَانَ","عَٰقِبَةُ","مَكۡرِهِمۡ","أَنَّا","دَمَّرۡنَٰهُمۡ","وَقَوۡمَهُمۡ","أَجۡمَعِينَ"],"фанзур кайфа кана `аḳибату макрихим анна даммарнахум ваḳаумахум ажма`иин","Посмотри же, каким был конец их хитрости! Мы уничтожили их вместе со всем их народом.",["посмотри же","каким","был","конец","их хитрости","что Мы","уничтожили их","и их народ","всех"]],[27,52,["فَتِلۡكَ","بُيُوتُهُمۡ","خَاوِيَةَۢ","بِمَا","ظَلَمُوٓاْۚ","إِنَّ","فِي","ذَٰلِكَ","لَأٓيَةٗ","لِّقَوۡمٖ","يَعۡلَمُونَ"],"фатилка буйуутухум хавийата бима заламуу инна фии залика ла'айатал лиḳаумин йа`ламуун","Вот их дома, разрушенные за то, что они поступали несправедливо. Воистину, в этом - знамения для людей знающих.",["и вот","их дома","опустевшие","за то, что","они были несправедливы","поистине","в","этом","непременно знамение","для людей","(которые) знают"]],[27,53,["وَأَنجَيۡنَا","ٱلَّذِينَ","ءَامَنُواْ","وَكَانُواْ","يَتَّقُونَ"],"ва'анжайнал лазиина амануу вакануу йаттаḳуун","А тех, которые уверовали и были богобоязненны, Мы спасли.",["и Мы спасли","тех, которые","уверовали","и были","богобоязненны"]],[27,54,["وَلُوطًا","إِذۡ","قَالَ","لِقَوۡمِهِۦٓ","أَتَأۡتُونَ","ٱلۡفَٰحِشَةَ","وَأَنتُمۡ","تُبۡصِرُونَ"],"валуутан из ḳала лиḳаумихии ата'туунал фахишата ва'антум тубсируун","Вот Лут (Лот) сказал своему народу: «Неужели вы будете совершать мерзость, видя это?",["и Лута (вспомни)","вот","он сказал","своему народу","неужели вы совершаете","мерзость","а вы","видите"]],[27,55,["أَئِنَّكُمۡ","لَتَأۡتُونَ","ٱلرِّجَالَ","شَهۡوَةٗ","مِّن","دُونِ","ٱلنِّسَآءِۚ","بَلۡ","أَنتُمۡ","قَوۡمٞ","تَجۡهَلُونَ"],"а'иннакум лата'туунар рижала шахватам мин дуунин нисаи бал антум ḳаумун тажхалуун","Неужели вы будете приходить с вожделением к мужчинам вместо женщин? О нет! Вы - невежественный народ!».",["неужели вы","непременно приходите","к мужчинам","с вожделением","вместо","(помимо)","женщин","нет же","вы","народ","(который) невежествует"]]],"m":[[["وَلَقَدۡ","и уже",27,45],["أَرۡسَلۡنَآ","Мы послали",27,45],["إِلَىٰ","к",27,45],["ثَمُودَ","самудянам",27,45],["أَخَاهُمۡ","их брата",27,45],["صَٰلِحًا","Салиха",27,45],["أَنِ","чтобы",27,45],["ٱعۡبُدُواْ","поклоняйтесь",27,45],["ٱللَّهَ","Аллаху",27,45],["فَإِذَا","и вот",27,45]],[["هُمۡ","они",27,45],["فَرِيقَانِ","две группы",27,45],["يَخۡتَصِمُونَ","препираются",27,45],[45],["قَالَ","он сказал",27,46],["يَٰقَوۡمِ","о мой народ",27,46],["لِمَ","почему",27,46],["تَسۡتَعۡجِلُونَ","вы торопите",27,46]],[["بِٱلسَّيِّئَةِ","зло",27,46],["قَبۡلَ","прежде",27,46],["ٱلۡحَسَنَةِۖ","добра",27,46],["لَوۡلَا","почему бы не",27,46],["تَسۡتَغۡفِرُونَ","просите прощения",27,46],["ٱللَّهَ","у Аллаха",27,46],["لَعَلَّكُمۡ","быть может, вы",27,46]],[["تُرۡحَمُونَ","будете помилованы",27,46],[46],["قَالُواْ","они сказали",27,47],["ٱطَّيَّرۡنَا","мы видим дурной знак",27,47],["بِكَ","в тебе",27,47],["وَبِمَن","и в тех, кто",27,47],["مَّ