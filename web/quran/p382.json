{"p":382,"j":20,"a":[[27,56,["فَمَا","كَانَ","جَوَابَ","قَوۡمِهِۦٓ","إِلَّآ","أَن","قَالُوٓاْ","أَخۡرِجُوٓاْ","ءَالَ","لُوطٖ","مِّن","قَرۡيَتِكُمۡۖ","إِنَّهُمۡ","أُنَاسٞ","يَتَطَهَّرُونَ"],"фама кана жаваба ḳаумихии илла ан ḳалуу ахрижуу ала луутим мин ḳарйатикум иннахум унасун йататаххаруун","В ответ его народ смог лишь сказать: «Прогоните семью Лута (Лота) из вашего селения. Воистину, эти люди хотят очиститься».",["и не","было","ответом","его народа","кроме","того, что","они сказали","изгоните","семью","Лута","из","вашего селения","поистине, они","люди","(которые) очищаются"]],[27,57,["فَأَنجَيۡنَٰهُ","وَأَهۡلَهُۥٓ","إِلَّا","ٱمۡرَأَتَهُۥ","قَدَّرۡنَٰهَا","مِنَ","ٱلۡغَٰبِرِينَ"],"фа'анжайнаху ва'ахлахуу илламраатахуу ḳаддарнаха минал габириин","Мы спасли его вместе с его семьей, кроме его жены. Мы предопределили ей оказаться в числе оставшихся позади.",["и Мы спасли его","и его семью","кроме","его жены","Мы предопределили ей (быть)","из","оставшихся позади"]],[27,58,["وَأَمۡطَرۡنَا","عَلَيۡهِم","مَّطَرٗاۖ","فَسَآءَ","مَطَرُ","ٱلۡمُنذَرِينَ"],"ва'амтарна `алайхим матаран фасаа матарул мунзариин","Мы пролили на них дождь. Как же пагубен дождь тех, кого предостерегали!",["и Мы пролили","на них","дождь","и скверен","дождь","предостережённых"]],[27,59,["قُلِ","ٱلۡحَمۡدُ","لِلَّهِ","وَسَلَٰمٌ","عَلَىٰ","عِبَادِهِ","ٱلَّذِينَ","ٱصۡطَفَىٰٓۗ","ءَآللَّهُ","خَيۡرٌ","أَمَّا","يُشۡرِكُونَ"],"ḳулил хамду лиллахи васаламун `ала `ибадихил лазиинастафа аллаху хайрун амма йушрикуун","Скажи: «Хвала Аллаху, и мир Его избранным рабам! Аллах лучше или те, кого вы приобщаете в сотоварищи?».",["скажи","хвала","Аллаху","и мир","на","Его рабах","которых","Он избрал","Аллах ли","лучше","или то, что","они приобщают"]],[27,60,["أَمَّنۡ","خَلَقَ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضَ","وَأَنزَلَ","لَكُم","مِّنَ","ٱلسَّمَآءِ","مَآءٗ","فَأَنۢبَتۡنَا","بِهِۦ","حَدَآئِقَ","ذَاتَ","بَهۡجَةٖ","مَّا","كَانَ","لَكُمۡ","أَن","تُنۢبِتُواْ","شَجَرَهَآۗ","أَءِلَٰهٞ","مَّعَ","ٱللَّهِۚ","بَلۡ","هُمۡ","قَوۡمٞ","يَعۡدِلُونَ"],"амман халаḳас самавати вал'арда ва'анзала лакум минас самаи маан фа'амбатна бихии хадаиḳа зата бахжатим ма кана лакум ан тумбитуу шажараха а'илахум ма`аллахи бал хум ḳаумун йа`дилуун","Кто создал небеса и землю и ниспослал вам с неба воду? Посредством нее Мы взрастили прекрасные сады. Вы не смогли бы взрастить деревья в них. Так есть ли бог, кроме Аллаха? Нет, но они являются людьми, которые уклоняются от истины (или равняют с Аллахом вымышленных богов).",["или кто","создал","небеса","и землю","и ниспослал","вам","с","неба","воду","и Мы взрастили","ею","сады","обладающие","красотой","не","было","вам (по силам)","чтобы","вы взрастили","их деревья","разве бог","наряду с","Аллахом","нет же","они","люди","(которые) уклоняются"]],[27,61,["أَمَّن","جَعَلَ","ٱلۡأَرۡضَ","قَرَارٗا","وَجَعَلَ","خِلَٰلَهَآ","أَنۡهَٰرٗا","وَجَعَلَ","لَهَا","رَوَٰسِيَ","وَجَعَلَ","بَيۡنَ","ٱلۡبَحۡرَيۡنِ","حَاجِزًاۗ","أَءِلَٰهٞ","مَّعَ","ٱللَّهِۚ","بَلۡ","أَكۡثَرُهُمۡ","لَا","يَعۡلَمُونَ"],"амман жа`алал арда ḳараран важа`ала хилалаха анхаран важа`ала лаха равасийа важа`ала байнал бахрайни хажизан а'илахум ма`аллахи бал аксарухум ла йа`ламуун","Кто сделал землю жилищем, проложил по ее расщелинам реки, воздвиг на ней незыблемые горы и установил преграду между морями? Есть ли бог, кроме Аллаха? Нет, но большинство их не знает этого.",["или кто","сделал","землю","жилищем","и сделал","посреди неё","реки","и сделал","для неё","незыблемые горы","и сделал","между","двумя морями","преграду","разве бог","наряду с","Аллахом","нет же","большинство их","не","знают"]],[27,62,["أَمَّن","يُجِيبُ","ٱلۡمُضۡطَرَّ","إِذَا","دَعَاهُ","وَيَكۡشِفُ","ٱلسُّوٓءَ","وَيَجۡعَلُكُمۡ","خُلَفَآءَ","ٱلۡأَرۡضِۗ","أَءِلَٰهٞ","مَّعَ","ٱللَّهِۚ","قَلِيلٗا","مَّا","تَذَكَّرُونَ"],"амман йужиибул мудтарра иза да`аху вайакшифус сууа вайаж`алукум хулафаал арди а'илахум ма`аллахи ḳалиилам ма тазаккаруун","Кто отвечает на мольбу нуждающегося, когда он взывает к Нему, устраняет зло и делает вас наследниками земли? Есть ли бог, кроме Аллаха? Мало же вы поминаете назидания!",["или кто","отвечает","нуждающемуся","когда","он воззвал к Нему","и устраняет","зло","и делает вас","наследниками","земли","разве бог","наряду с","Аллахом","мало","же","вы поминаете назидание"]],[27,63,["أَمَّن","يَهۡدِيكُمۡ","فِي","ظُلُمَٰتِ","ٱلۡبَرِّ","وَٱلۡبَحۡرِ","وَمَن","يُرۡسِلُ","ٱلرِّيَٰحَ","بُشۡرَۢا","بَيۡنَ","يَدَيۡ","رَحۡمَتِهِۦٓۗ","أَءِلَٰهٞ","مَّعَ","ٱللَّهِۚ","تَعَٰلَى","ٱللَّهُ","عَمَّا","يُشۡرِكُونَ"],"амман йахдиикум фии зулуматил барри валбахри ваман йурсилур рийаха бушра байна йадай рахматихии а'илахум ма`аллахи та`алаллаху `амма йушрикуун","Кто ведет вас прямым путем во мраках суши и моря и посылает ветры с доброй вестью о Своей милости? Есть ли бог, кроме Аллаха? Аллах превыше тех, кого приобщают в сотоварищи!",["или кто","ведёт вас","во","мраках","суши","и моря","и кто","посылает","ветры","благой вестью","перед","(руками)","Его милости","разве бог","наряду с","Аллахом","превыше","Аллах","того, что","они приобщают"]]],"m":[[["۞ فَمَا","и не",27,56],["كَانَ","было",27,56],["جَوَابَ","ответом",27,56],["قَوۡمِهِۦٓ","его народа",27,56],["إِلَّآ","кроме",27,56],["أَن","того, что",27,56],["قَالُوٓاْ","они сказали",27,56],["أَخۡرِجُوٓاْ","изгоните",27,56],["ءَالَ","семью",27,56]],[["لُوطٖ","Лута",27,56],["مِّن","из",27,56],["قَرۡيَتِكُمۡۖ","вашего селения",27,56],["إِنَّهُمۡ","поистине, они",27,56],["أُنَاسٞ","люди",27,56],["يَتَطَهَّرُونَ","(которые) очищаются",27,56],[56],["فَأَنجَيۡنَٰهُ","и Мы спасли его",27,57]],[["وَأَهۡلَهُۥٓ","и его семью",27,57],["إِلَّا","кроме",27,57],["ٱمۡرَأَتَهُۥ","его жены",27,57],["قَدَّرۡنَٰهَا","Мы предопределили ей (быть)",27,57],["مِنَ","из",27,57],["ٱلۡغَٰبِرِينَ","оставшихся позади",27,57],[57],["وَأَمۡطَرۡنَا","и Мы пролили",27,58]],[["عَلَيۡهِم","на них",27,58],["مَّطَرٗاۖ","дождь",27,58],["فَسَآءَ","и скверен",27,58],["مَطَرُ","дождь",27,58],["ٱلۡمُنذَرِينَ","предостережённых",27,58],[58],["قُلِ","скажи",27,59],["ٱلۡحَمۡدُ","хвала",27,59],["لِلَّهِ","Аллаху",27,59],["وَسَلَٰمٌ","и мир",27,59]],[["عَلَىٰ","на",27,59],["عِبَادِهِ","Его рабах",27,59],["ٱلَّذِينَ","которых",27,59],["ٱصۡطَفَىٰٓۗ","Он избрал",27,59],["ءَآللَّهُ","Аллах ли",27,59],["خَيۡرٌ","лучше",27,59],["أَمَّا","или то, что",27,59],["يُشۡرِكُونَ","они приобщают",27,59],[59]],[["أَمَّنۡ","или кто",27,60],["خَلَقَ","создал",27,60],["ٱلسَّمَٰوَٰتِ","небеса",27,60],["وَٱلۡأَرۡضَ","и землю",27,60],["وَأَنزَلَ","и ниспослал",27,60],["لَكُم","вам",27,60],["مِّنَ","с",27,60],["ٱلسَّمَآءِ","неба",27,60]],[["مَآءٗ","воду",27,60],["فَأَنۢبَتۡنَا","и Мы взрастили",27,60],["بِهِۦ","ею",27,60],["حَدَآئِقَ","сады",27,60],["ذَاتَ","обладающие",27,60],["بَهۡجَةٖ","красотой",27,60],["مَّا","не",27,60],["كَانَ","было",27,60],["لَكُمۡ","вам (по силам)",27,60]],[["أَن","чтобы",27,60],["تُنۢبِتُواْ","вы взрастили",27,60],["شَجَرَهَآۗ","их деревья",27,60],["أَءِلَٰهٞ","разве бог",27,60],["مَّعَ","наряду с",27,60],["ٱللَّهِۚ","Аллахом",27,60],["بَلۡ","нет же",27,60],["هُمۡ","они",27,60],["قَوۡمٞ","люди",27,60],["يَعۡدِلُونَ","(которые) уклоняются",27,60],[60]],[["أَمَّن","или кто",27,61],["جَعَلَ","сделал",27,61],["ٱلۡأَرۡضَ","землю",27,61],["قَرَارٗا","жилищем",27,61],["وَجَعَلَ","и сделал",27,61],["خِلَٰلَهَآ","посреди неё",27,61],["أَنۡهَٰرٗا","реки",27,61],["وَجَعَلَ","и сделал",27,61],["لَهَا","для неё",27,61]],[["رَوَٰسِيَ","незыблемые горы",27,61],["وَجَعَلَ","и сделал",27,61],["بَيۡنَ","между",27,61],["ٱلۡبَحۡرَيۡنِ","двумя морями",27,61],["حَاجِزًاۗ","преграду",27,61],["أَءِلَٰهٞ","разве бог",27,61],["مَّعَ","наряду с",27,61],["ٱللَّهِۚ","Аллахом",27,61],["بَلۡ","нет же",27,61]],[["أَكۡثَرُهُمۡ","большинство их",27,61],["لَا","не",27,61],["يَعۡلَمُونَ","знают",27,61],[61],["أَمَّن","или кто",27,62],["يُجِيبُ","отвечает",27,62],["ٱلۡمُضۡطَرَّ","нуждающемуся",27,62],["إِذَا","когда",27,62],["دَعَاهُ","он воззвал к Нему",27,62]],[["وَيَكۡشِفُ","и устраняет",27,62],["ٱلسُّوٓءَ","зло",27,62],["وَيَجۡعَلُكُمۡ","и делает вас",27,62],["خُلَفَآءَ","наследниками",27,62