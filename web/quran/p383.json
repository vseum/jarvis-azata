{"p":383,"j":20,"a":[[27,64,["أَمَّن","يَبۡدَؤُاْ","ٱلۡخَلۡقَ","ثُمَّ","يُعِيدُهُۥ","وَمَن","يَرۡزُقُكُم","مِّنَ","ٱلسَّمَآءِ","وَٱلۡأَرۡضِۗ","أَءِلَٰهٞ","مَّعَ","ٱللَّهِۚ","قُلۡ","هَاتُواْ","بُرۡهَٰنَكُمۡ","إِن","كُنتُمۡ","صَٰدِقِينَ"],"амман йабдаул халḳа сумма йу`иидухуу ваман йарзуḳукум минас самаи вал'арди а'илахум ма`аллахи ḳул хатуу бурханакум ин кунтум садиḳиин","Кто создает творение изначально, а затем воссоздает его и обеспечивает вас пропитанием с неба и земли? Есть ли бог, кроме Аллаха? Скажи: «Приведите ваше доказательство, если вы говорите правду».",["или кто","начинает","творение","затем","повторяет его","и кто","наделяет вас уделом","с","неба","и земли","разве бог","наряду с","Аллахом","скажи","приведите","ваше доказательство","если","вы","правдивы"]],[27,65,["قُل","لَّا","يَعۡلَمُ","مَن","فِي","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِ","ٱلۡغَيۡبَ","إِلَّا","ٱللَّهُۚ","وَمَا","يَشۡعُرُونَ","أَيَّانَ","يُبۡعَثُونَ"],"ḳул ла йа`ламу ман фис самавати вал'ардил гайба иллаллаху вама йаш`урууна аййана йуб`асуун","Скажи: «Никто из тех, кто на небесах и на земле, не ведает сокровенное, кроме Аллаха, а они даже не подозревают, когда их воскресят.",["скажи","не","знает","(никто) кто","на","небесах","и земле","сокровенного","кроме","Аллаха","и не","ведают они","когда","они будут воскрешены"]],[27,66,["بَلِ","ٱدَّٰرَكَ","عِلۡمُهُمۡ","فِي","ٱلۡأٓخِرَةِۚ","بَلۡ","هُمۡ","فِي","شَكّٖ","مِّنۡهَاۖ","بَلۡ","هُم","مِّنۡهَا","عَمُونَ"],"балиддарака `илмухум фил ахирати бал хум фии шакким минха бал хум минха `амуун","Но они не постигли о Последней жизни (или но их знание станет совершенным в Последней жизни). Более того, они сомневаются в ней и даже слепы к ней».",["нет же","иссякло","их знание","о","Последней жизни","более того","они","в","сомнении","о ней","более того","они","к ней","слепы"]],[27,67,["وَقَالَ","ٱلَّذِينَ","كَفَرُوٓاْ","أَءِذَا","كُنَّا","تُرَٰبٗا","وَءَابَآؤُنَآ","أَئِنَّا","لَمُخۡرَجُونَ"],"ваḳалал лазиина кафаруу а'иза кунна турабан ва'абауна а'инна ламухражуун","Неверующие говорят: «Неужели после того, как мы и наши отцы превратимся в прах, мы будем выведены из могил?",["и сказали","те, которые","не уверовали","неужели когда","мы станем","прахом","и наши отцы","разве мы","непременно будем выведены"]],[27,68,["لَقَدۡ","وُعِدۡنَا","هَٰذَا","نَحۡنُ","وَءَابَآؤُنَا","مِن","قَبۡلُ","إِنۡ","هَٰذَآ","إِلَّآ","أَسَٰطِيرُ","ٱلۡأَوَّلِينَ"],"лаḳад ву`идна хаза нахну ва'абауна мин ḳаблу ин хаза илла асатиирул аввалиин","Это было обещано нам и еще раньше - нашим отцам. Но это - всего лишь легенды древних народов».",["уже","было обещано нам","это","нам","и нашим отцам","ещё","раньше","не","это","кроме","сказки","древних"]],[27,69,["قُلۡ","سِيرُواْ","فِي","ٱلۡأَرۡضِ","فَٱنظُرُواْ","كَيۡفَ","كَانَ","عَٰقِبَةُ","ٱلۡمُجۡرِمِينَ"],"ḳул сиируу фил арди фанзуруу кайфа кана `аḳибатул мужримиин","Скажи: «Постранствуйте по земле и посмотрите, каким был конец грешников».",["скажи","странствуйте","по","земле","и посмотрите","каким","был","конец","грешников"]],[27,70,["وَلَا","تَحۡزَنۡ","عَلَيۡهِمۡ","وَلَا","تَكُن","فِي","ضَيۡقٖ","مِّمَّا","يَمۡكُرُونَ"],"вала тахзан `алайхим вала такун фии дайḳим мимма йамкуруун","Не печалься о них и пусть не стесняет тебя то, что они замышляют.",["и не","печалься","о них","и не","будь","в","стеснении","из-за того, что","они замышляют"]],[27,71,["وَيَقُولُونَ","مَتَىٰ","هَٰذَا","ٱلۡوَعۡدُ","إِن","كُنتُمۡ","صَٰدِقِينَ"],"вайаḳуулууна мата хазал ва`ду ин кунтум садиḳиин","Они говорят: «Когда же сбудется это обещание, если вы говорите правду?».",["и они говорят","когда","это","обещание","если","вы","правдивы"]],[27,72,["قُلۡ","عَسَىٰٓ","أَن","يَكُونَ","رَدِفَ","لَكُم","بَعۡضُ","ٱلَّذِي","تَسۡتَعۡجِلُونَ"],"ḳул `аса ан йакууна радифа лакум ба`дул лазии таста`жилуун","Скажи: «Возможно, некоторое из того, что вы торопите, уже находится позади вас».",["скажи","быть может","что","окажется","подступило","к вам","часть","того, что","вы торопите"]],[27,73,["وَإِنَّ","رَبَّكَ","لَذُو","فَضۡلٍ","عَلَى","ٱلنَّاسِ","وَلَٰكِنَّ","أَكۡثَرَهُمۡ","لَا","يَشۡكُرُونَ"],"ва'инна раббака лазуу фадлин `алан наси валакинна аксарахум ла йашкуруун","Воистину, твой Господь оказывает милость людям, но большинство их неблагодарны.",["и поистине","твой Господь","непременно обладатель","милости","к","людям","но","большинство их","не","благодарят"]],[27,74,["وَإِنَّ","رَبَّكَ","لَيَعۡلَمُ","مَا","تُكِنُّ","صُدُورُهُمۡ","وَمَا","يُعۡلِنُونَ"],"ва'инна раббака лайа`ламу ма тукинну судуурухум вама йу`линуун","Воистину, твой Господь знает то, что таят их сердца, и то, что они обнаруживают.",["и поистине","твой Господь","непременно знает","то, что","таят","их груди","и то, что","они обнаруживают"]],[27,75,["وَمَا","مِنۡ","غَآئِبَةٖ","فِي","ٱلسَّمَآءِ","وَٱلۡأَرۡضِ","إِلَّا","فِي","كِتَٰبٖ","مُّبِينٍ"],"вама мин гаибатин фис самаи вал'арди илла фии китабим мубиин","На небе и на земле нет такого сокровенного, которого бы не было в ясном Писании.",["и нет","никакого","сокрытого","на","небе","и земле","кроме как","в","Писании","ясном"]],[27,76,["إِنَّ","هَٰذَا","ٱلۡقُرۡءَانَ","يَقُصُّ","عَلَىٰ","بَنِيٓ","إِسۡرَٰٓءِيلَ","أَكۡثَرَ","ٱلَّذِي","هُمۡ","فِيهِ","يَخۡتَلِفُونَ"],"инна хазал ḳур'ана йаḳуссу `ала бании исраиила аксарал лазии хум фиихи йахталифуун","Воистину, этот Коран рассказывает сынам Исраила (Израиля) большую часть того, о чем они расходятся во мнениях.",["поистине","этот","Коран","рассказывает","перед","сынами","Исраила","большую часть","того, что","они","о чём","расходятся"]]],"m":[[["أَمَّن","или кто",27,64],["يَبۡدَؤُاْ","начинает",27,64],["ٱلۡخَلۡقَ","творение",27,64],["ثُمَّ","затем",27,64],["يُعِيدُهُۥ","повторяет его",27,64],["وَمَن","и кто",27,64],["يَرۡزُقُكُم","наделяет вас уделом",27,64],["مِّنَ","с",27,64],["ٱلسَّمَآءِ","неба",27,64],["وَٱلۡأَرۡضِۗ","и земли",27,64]],[["أَءِلَٰهٞ","разве бог",27,64],["مَّعَ","наряду с",27,64],["ٱللَّهِۚ","Аллахом",27,64],["قُلۡ","скажи",27,64],["هَاتُواْ","приведите",27,64],["بُرۡهَٰنَكُمۡ","ваше доказательство",27,64],["إِن","если",27,64],["كُنتُمۡ",