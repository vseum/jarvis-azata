{"p":384,"j":20,"a":[[27,77,["وَإِنَّهُۥ","لَهُدٗى","وَرَحۡمَةٞ","لِّلۡمُؤۡمِنِينَ"],"ва'иннахуу лахудан варахматул лилму'миниин","Воистину, это - верное руководство и милость для верующих.",["и поистине, он","непременно руководство","и милость","для верующих"]],[27,78,["إِنَّ","رَبَّكَ","يَقۡضِي","بَيۡنَهُم","بِحُكۡمِهِۦۚ","وَهُوَ","ٱلۡعَزِيزُ","ٱلۡعَلِيمُ"],"инна раббака йаḳдии байнахум бихукмихии вахуал `азиизул `алиим","Воистину, твой Господь рассудит между ними Своим судом. Он - Могущественный, Знающий.",["поистине","твой Господь","рассудит","между ними","Своим судом","и Он","Могущественный","Знающий"]],[27,79,["فَتَوَكَّلۡ","عَلَى","ٱللَّهِۖ","إِنَّكَ","عَلَى","ٱلۡحَقِّ","ٱلۡمُبِينِ"],"фатаваккал `алаллахи иннака `алал хаḳḳил мубиин","Уповай же на Аллаха, ибо ты придерживаешься очевидной истины.",["уповай же","на","Аллаха","поистине, ты","на","истине","очевидной"]],[27,80,["إِنَّكَ","لَا","تُسۡمِعُ","ٱلۡمَوۡتَىٰ","وَلَا","تُسۡمِعُ","ٱلصُّمَّ","ٱلدُّعَآءَ","إِذَا","وَلَّوۡاْ","مُدۡبِرِينَ"],"иннака ла тусми`ул маута вала тусми`ус суммад ду`аа иза валлау мудбириин","Ты не заставишь слышать мертвецов и не заставишь глухих услышать твой призыв, когда они обращаются вспять.",["поистине, ты","не","заставишь слышать","мёртвых","и не","заставишь слышать","глухих","призыв","когда","они обратились","вспять"]],[27,81,["وَمَآ","أَنتَ","بِهَٰدِي","ٱلۡعُمۡيِ","عَن","ضَلَٰلَتِهِمۡۖ","إِن","تُسۡمِعُ","إِلَّا","مَن","يُؤۡمِنُ","بِـَٔايَٰتِنَا","فَهُم","مُّسۡلِمُونَ"],"вама анта бихадил `умйи `ан далалатихим ин тусми`у илла ман йу'мину би'айатина фахум муслимуун","Ты не выведешь слепых из их заблуждения. Ты можешь заставить слышать только тех, которые веруют в Наши знамения, будучи мусульманами.",["и не","ты","выводящий","слепых","из","их заблуждения","не","заставишь слышать","кроме","тех, кто","верует","в Наши знамения","и они","мусульмане"]],[27,82,["وَإِذَا","وَقَعَ","ٱلۡقَوۡلُ","عَلَيۡهِمۡ","أَخۡرَجۡنَا","لَهُمۡ","دَآبَّةٗ","مِّنَ","ٱلۡأَرۡضِ","تُكَلِّمُهُمۡ","أَنَّ","ٱلنَّاسَ","كَانُواْ","بِـَٔايَٰتِنَا","لَا","يُوقِنُونَ"],"ва'иза ваḳа`ал ḳаулу `алайхим ахражна лахум даббатам минал арди тукаллимухум аннан наса кануу би'айатина ла йууḳинуун","Когда же свершится над ними Слово, Мы выведем к ним из земли животное, которое скажет им, что люди не были убеждены в Наших знамениях.",["и когда","свершится","Слово","над ними","Мы выведем","для них","животное","из","земли","говорящее с ними","что","люди","были","в Наших знамениях","не","убеждены"]],[27,83,["وَيَوۡمَ","نَحۡشُرُ","مِن","كُلِّ","أُمَّةٖ","فَوۡجٗا","مِّمَّن","يُكَذِّبُ","بِـَٔايَٰتِنَا","فَهُمۡ","يُوزَعُونَ"],"вайаума нахшуру мин кулли умматин фаужам мимман йуказзибу би'айатина фахум йууза`уун","В тот день Мы соберем из каждого народа толпу тех, кто считал ложью Наши знамения, и их будут подталкивать.",["и в день","Мы соберём","из","каждой","общины","толпу","из тех, кто","считает ложью","Наши знамения","и они","будут выстроены рядами"]],[27,84,["حَتَّىٰٓ","إِذَا","جَآءُو","قَالَ","أَكَذَّبۡتُم","بِـَٔايَٰتِي","وَلَمۡ","تُحِيطُواْ","بِهَا","عِلۡمًا","أَمَّاذَا","كُنتُمۡ","تَعۡمَلُونَ"],"хатта иза жауу ḳала аказзабтум би'айатии валам тухиитуу биха `илман аммаза кунтум та`малуун","Когда они придут, Он скажет: «Неужели вы сочли ложью Мои знамения, даже не постигнув их? Что же вы совершали?».",["пока не","когда","они придут","Он скажет","неужели вы сочли ложью","Мои знамения","и не","охватили","их","знанием","или что же","вы","делали"]],[27,85,["وَوَقَعَ","ٱلۡقَوۡلُ","عَلَيۡهِم","بِمَا","ظَلَمُواْ","فَهُمۡ","لَا","يَنطِقُونَ"],"ваваḳа`ал ḳаулу `алайхим бима заламуу фахум ла йантиḳуун","Слово свершится над ними за то, что они поступали несправедливо, и они будут безмолвствовать.",["и свершится","Слово","над ними","за то, что","они были несправедливы","и они","не","заговорят"]],[27,86,["أَلَمۡ","يَرَوۡاْ","أَنَّا","جَعَلۡنَا","ٱلَّيۡلَ","لِيَسۡكُنُواْ","فِيهِ","وَٱلنَّهَارَ","مُبۡصِرًاۚ","إِنَّ","فِي","ذَٰلِكَ","لَأٓيَٰتٖ","لِّقَوۡمٖ","يُؤۡمِنُونَ"],"алам йарау анна жа`алнал лайла лийаскунуу фиихи ваннахара мубсиран инна фии залика ла'айатил лиḳаумин йу'минуун","Разве они не видели, что Мы создали ночь для того, чтобы они отдыхали в течение нее, и день для освещения? Воистину, в этом - знамения для верующих людей.",["разве не","видели они","что Мы","сделали","ночь","чтобы они отдыхали","в ней","и день","освещающим","поистине","в","этом","непременно знамения","для людей","(которые) веруют"]],[27,87,["وَيَوۡمَ","يُنفَخُ","فِي","ٱلصُّورِ","فَفَزِعَ","مَن","فِي","ٱلسَّمَٰوَٰتِ","وَمَن","فِي","ٱلۡأَرۡضِ","إِلَّا","مَن","شَآءَ","ٱللَّهُۚ","وَكُلٌّ","أَتَوۡهُ","دَٰخِرِينَ"],"вайаума йунфаху фис суури фафази`а ман фис самавати ваман фил арди илла ман шааллаху вакуллун атауху дахириин","В тот день подуют в Рог, и перепугаются те, кто на небесах и на земле, кроме тех, кого Аллах пожелает выделить. Все предстанут перед Ним смиренными.",["и в день","подуют","в","Рог","и испугаются","те, кто","на","небесах","и кто","на","земле","кроме","тех, кого","пожелал","Аллах","и все","придут к Нему","смиренными"]],[27,88,["وَتَرَى","ٱلۡجِبَالَ","تَحۡسَبُهَا","جَامِدَةٗ","وَهِيَ","تَمُرُّ","مَرَّ","ٱلسَّحَابِۚ","صُنۡعَ","ٱللَّهِ","ٱلَّذِيٓ","أَتۡقَنَ","كُلَّ","شَيۡءٍۚ","إِنَّهُۥ","خَبِيرُۢ","بِمَا","تَفۡعَلُونَ"],"ватарал жибала тахсабуха жамидатан вахийа тамурру маррас сахаби сун`аллахил лазии атḳана кулла шай'ин иннахуу хабииру бима таф`алуун","И ты увидишь, что горы, которые ты считал неподвижными, придут в движение, словно облака. Таково творение Аллаха, Который выполнил все в совершенстве. Воистину, Он ведает о том, что вы делаете.",["и ты видишь","горы","считаешь их","неподвижными","а они","проходят","как проходят","облака","творение","Аллаха","Который","сделал совершенной","всякую","вещь","поистине, Он","ведающий","о том, что","вы делаете"]]],"m":[[["وَإِنَّهُۥ","и поистине, он",27,77],["لَهُدٗى","непременно руководство",27,77],["وَرَحۡمَةٞ","и милость",27,77],["لِّلۡمُؤۡمِنِينَ","для верующих",27,77],[77],["إِنَّ","поистине",27,78],["رَبَّكَ","твой Господь",27