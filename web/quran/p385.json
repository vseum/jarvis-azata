{"p":385,"j":20,"a":[[27,89,["مَن","جَآءَ","بِٱلۡحَسَنَةِ","فَلَهُۥ","خَيۡرٞ","مِّنۡهَا","وَهُم","مِّن","فَزَعٖ","يَوۡمَئِذٍ","ءَامِنُونَ"],"ман жаа билхасанати фалахуу хайрум минха вахум мин фаза`ин йаумаизин аминуун","Те, которые предстанут с добрым деянием, получат нечто лучшее. В тот день они будут защищены от испуга.",["кто","придёт","с добрым деянием","тому","лучшее","чем оно","и они","от","испуга","в тот день","в безопасности"]],[27,90,["وَمَن","جَآءَ","بِٱلسَّيِّئَةِ","فَكُبَّتۡ","وُجُوهُهُمۡ","فِي","ٱلنَّارِ","هَلۡ","تُجۡزَوۡنَ","إِلَّا","مَا","كُنتُمۡ","تَعۡمَلُونَ"],"ваман жаа биссаййиати факуббат вужуухухум фин нари хал тужзауна илла ма кунтум та`малуун","А те, которые предстанут с дурными деяниями, будут повергнуты в Огонь ничком: «Разве вы не получаете воздаяние только за то, что совершали?».",["а кто","придёт","с дурным деянием","то повергнуты будут","их лица","в","Огонь","разве","вам воздаётся","кроме как","за то, что","вы","делали"]],[27,91,["إِنَّمَآ","أُمِرۡتُ","أَنۡ","أَعۡبُدَ","رَبَّ","هَٰذِهِ","ٱلۡبَلۡدَةِ","ٱلَّذِي","حَرَّمَهَا","وَلَهُۥ","كُلُّ","شَيۡءٖۖ","وَأُمِرۡتُ","أَنۡ","أَكُونَ","مِنَ","ٱلۡمُسۡلِمِينَ"],"иннама умирту ан а`буда рабба хазихил балдатил лазии харрамаха валахуу куллу шай'ин ва'умирту ан акууна минал муслимиин","Скажи: «Мне велено только поклоняться Господу этого города (Мекки), который Он провозгласил заповедным. Ему принадлежит всякая вещь, мне же велено быть одним из мусульман",["лишь","мне велено","чтобы","я поклонялся","Господу","этого","города","Который","сделал его заповедным","и Ему (принадлежит)","всякая","вещь","и мне велено","чтобы","я был","из","мусульман"]],[27,92,["وَأَنۡ","أَتۡلُوَاْ","ٱلۡقُرۡءَانَۖ","فَمَنِ","ٱهۡتَدَىٰ","فَإِنَّمَا","يَهۡتَدِي","لِنَفۡسِهِۦۖ","وَمَن","ضَلَّ","فَقُلۡ","إِنَّمَآ","أَنَا۠","مِنَ","ٱلۡمُنذِرِينَ"],"ва'ан атлуал ḳур'ана фаманихтада фа'иннама йахтадии линафсихии ваман далла фаḳул иннама ана минал мунзириин","и читать Коран». Кто следует прямым путем, тот поступает во благо себе. А тому, кто впал в заблуждение, скажи: «Я - всего лишь один из тех, кто предостерегает».",["и чтобы","я читал","Коран","и кто","последовал прямым путём","то лишь","следует прямым путём","для себя","а кто","впал в заблуждение","то скажи","лишь","я","из","предостерегающих"]],[27,93,["وَقُلِ","ٱلۡحَمۡدُ","لِلَّهِ","سَيُرِيكُمۡ","ءَايَٰتِهِۦ","فَتَعۡرِفُونَهَاۚ","وَمَا","رَبُّكَ","بِغَٰفِلٍ","عَمَّا","تَعۡمَلُونَ"],"ваḳулил хамду лиллахи сайуриикум айатихии фата`рифуунаха вама раббука бигафилин `амма та`малуун","Скажи: «Хвала Аллаху! Он покажет вам Свои знамения, и вы узнаете их». Твой Господь не находится в неведении о том, что вы совершаете.",["и скажи","хвала","Аллаху","Он покажет вам","Свои знамения","и вы узнаете их","и не","твой Господь","в неведении","о том, что","вы делаете"]],[28,1,["طسٓمٓ"],"тсм","Та. Син. Мим.",["Та. Син. Мим."]],[28,2,["تِلۡكَ","ءَايَٰتُ","ٱلۡكِتَٰبِ","ٱلۡمُبِينِ"],"тилка айатул китабил мубиин","Это - аяты ясного Писания.",["Это","аяты","Писания","ясного"]],[28,3,["نَتۡلُواْ","عَلَيۡكَ","مِن","نَّبَإِ","مُوسَىٰ","وَفِرۡعَوۡنَ","بِٱلۡحَقِّ","لِقَوۡمٖ","يُؤۡمِنُونَ"],"натлуу `алайка мин набаи мууса вафир`ауна билхаḳḳи лиḳаумин йу'минуун","Мы правдиво прочтем тебе для верующих людей историю Мусы (Моисея) и Фараона.",["Мы читаем","тебе","из","вести","Мусы","и Фараона","по истине","для людей","которые веруют"]],[28,4,["إِنَّ","فِرۡعَوۡنَ","عَلَا","فِي","ٱلۡأَرۡضِ","وَجَعَلَ","أَهۡلَهَا","شِيَعٗا","يَسۡتَضۡعِفُ","طَآئِفَةٗ","مِّنۡهُمۡ","يُذَبِّحُ","أَبۡنَآءَهُمۡ","وَيَسۡتَحۡيِۦ","نِسَآءَهُمۡۚ","إِنَّهُۥ","كَانَ","مِنَ","ٱلۡمُفۡسِدِينَ"],"инна фир`ауна `ала фил арди важа`ала ахлаха шийа`ан йастад`ифу таифатам минхум йузаббиху абнаахум вайастахйии нисаахум иннахуу кана минал муфсидиин","Фараон возгордился на земле и разделил ее жителей на группы. Одних он ослаблял, убивая их сыновей и оставляя в живых их женщин. Воистину, он был одним из тех, кто распространял нечестие.",["Поистине","Фараон","возвысился","на","земле","и сделал","её жителей","группами","ослабляя","часть","из них","закалывая","их сыновей","и оставляя в живых","их женщин","поистине, он","был","из","сеющих порчу"]],[28,5,["وَنُرِيدُ","أَن","نَّمُنَّ","عَلَى","ٱلَّذِينَ","ٱسۡتُضۡعِفُواْ","فِي","ٱلۡأَرۡضِ","وَنَجۡعَلَهُمۡ","أَئِمَّةٗ","وَنَجۡعَلَهُمُ","ٱلۡوَٰرِثِينَ"],"ванурииду ан намунна `алал лазиинастуд`ифуу фил арди ванаж`алахум а'имматан ванаж`алахумул варисиин","Мы пожелали оказать милость тем, кто был унижен на земле, сделать их предводителями и наследниками,",["И Мы желаем","чтобы","оказать милость","на","тех, которые","были ослаблены","на","земле","и сделать их","предводителями","и сделать их","наследниками"]]],"m":[[["مَن","кто",27,89],["جَآءَ","придёт",27,89],["بِٱلۡحَسَنَةِ","с добрым деянием",27,89],["فَلَهُۥ","тому",27,89],["خَيۡرٞ","лучшее",27,89],["مِّنۡهَا","чем оно",27,89],["وَهُم","и они",27,89],["مِّن","от",27,89],["فَزَعٖ","испуга",27,89],["يَوۡمَئِذٍ","в тот день",27,89],["ءَامِنُونَ","в безопасности",27,89],[89]],[["وَمَن","а кто",27,90],["جَآءَ","придёт",27,90],["بِٱلسَّيِّئَةِ","с дурным деянием",27,90],["فَكُبَّتۡ","то повергнуты будут",27,90],["وُجُوهُهُمۡ","их лица",27,90],["فِي","в",27,90],["ٱلنَّارِ","Огонь",27,90],["هَلۡ","разве",27,90],["تُجۡزَوۡنَ","вам воздаётся",27,90]],[["إِلَّا","кроме как",27,90],["مَا","за то, что",27,90],["كُنتُمۡ","вы",27,90],["تَعۡمَلُونَ","делали",27,90],[90],["إِنَّمَآ","лишь",27,91],["أُمِرۡتُ","мне велено",27,91],["أَنۡ","чтобы",27,91],["أَعۡبُدَ","я поклонялся",27,91],["رَبَّ","Господу",27,91],["هَٰذِهِ","этого",27,91]],[["ٱلۡبَلۡدَةِ","города",27,91],["ٱلَّذِي","Который",27,91],["حَرَّمَهَا","сделал его заповедным",27,91],["وَلَهُۥ","и Ему (принадлежит)",27,91],["كُلُّ","всякая",27,91],["شَيۡءٖۖ","вещь",27,91],["وَأُمِرۡتُ","и мне велено",27,91],["أَنۡ","чтобы",27,91],["أَكُونَ","я был",27,91],["مِنَ","из",27,91]],[["ٱلۡمُسۡلِمِينَ","мусульман",27,91],[91],["وَأَنۡ","и чтобы",27,92],["أَتۡلُوَاْ","я читал",27,92],["ٱلۡقُرۡءَانَۖ","Коран",27,92],["فَمَنِ","и кто",27,92],["ٱهۡتَ