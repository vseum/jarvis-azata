{"p":386,"j":20,"a":[[28,6,["وَنُمَكِّنَ","لَهُمۡ","فِي","ٱلۡأَرۡضِ","وَنُرِيَ","فِرۡعَوۡنَ","وَهَٰمَٰنَ","وَجُنُودَهُمَا","مِنۡهُم","مَّا","كَانُواْ","يَحۡذَرُونَ"],"ванумаккина лахум фил арди ванурийа фир`ауна вахамана важунуудахума минхум ма кануу йахзаруун","даровать им власть на земле и показать Фараону, Хаману и их воинам то, чего они остерегались.",["и утвердить","им","на","земле","и показать","Фараону","и Хаману","и их воинам","от них","то, что","они были","остерегались"]],[28,7,["وَأَوۡحَيۡنَآ","إِلَىٰٓ","أُمِّ","مُوسَىٰٓ","أَنۡ","أَرۡضِعِيهِۖ","فَإِذَا","خِفۡتِ","عَلَيۡهِ","فَأَلۡقِيهِ","فِي","ٱلۡيَمِّ","وَلَا","تَخَافِي","وَلَا","تَحۡزَنِيٓۖ","إِنَّا","رَآدُّوهُ","إِلَيۡكِ","وَجَاعِلُوهُ","مِنَ","ٱلۡمُرۡسَلِينَ"],"ва'аухайна ила умми мууса ан арди`иихи фа'иза хифти `алайхи фа'алḳиихи фил йамми вала тахафии вала тахзании инна раддууху илайки важа`илууху минал мурсалиин","Мы внушили матери Мусы (Моисея): «Корми его грудью. Когда же станешь опасаться за него, то брось его в реку. Не бойся и не печалься, ибо Мы вернем его тебе и сделаем одним из посланников».",["И Мы внушили","к","матери","Мусы","что","корми его грудью","а когда","ты будешь бояться","за него","то брось его","в","реку","и не","бойся","и не","печалься","поистине, Мы","вернём его","тебе","и сделаем его","из","посланников"]],[28,8,["فَٱلۡتَقَطَهُۥٓ","ءَالُ","فِرۡعَوۡنَ","لِيَكُونَ","لَهُمۡ","عَدُوّٗا","وَحَزَنًاۗ","إِنَّ","فِرۡعَوۡنَ","وَهَٰمَٰنَ","وَجُنُودَهُمَا","كَانُواْ","خَٰطِـِٔينَ"],"фалтаḳатахуу алу фир`ауна лийакууна лахум `адувван вахазанан инна фир`ауна вахамана важунуудахума кануу хати'иин","Семья Фараона подобрала его, чтобы он стал их врагом и печалью. Воистину, Фараон, Хаман и их воины были грешниками.",["И подобрала его","семья","Фараона","чтобы он стал","для них","врагом","и печалью","Поистине","Фараон","и Хаман","и их воины","были","грешниками"]],[28,9,["وَقَالَتِ","ٱمۡرَأَتُ","فِرۡعَوۡنَ","قُرَّتُ","عَيۡنٖ","لِّي","وَلَكَۖ","لَا","تَقۡتُلُوهُ","عَسَىٰٓ","أَن","يَنفَعَنَآ","أَوۡ","نَتَّخِذَهُۥ","وَلَدٗا","وَهُمۡ","لَا","يَشۡعُرُونَ"],"ваḳалатимраату фир`ауна ḳуррату `айнил лии валака ла таḳтулууху `аса ан йанфа`ана ау наттахизахуу валадан вахум ла йаш`уруун","Жена Фараона сказала: «Вот услада очей для меня и тебя. Не убивайте его! Быть может, он принесет нам пользу, или же мы усыновим его». Они ни о чем не подозревали.",["И сказала","жена","Фараона","услада","глаза","для меня","и для тебя","не","убивайте его","быть может","что","он принесёт нам пользу","или","мы возьмём его","сыном","а они","не","сознавали"]],[28,10,["وَأَصۡبَحَ","فُؤَادُ","أُمِّ","مُوسَىٰ","فَٰرِغًاۖ","إِن","كَادَتۡ","لَتُبۡدِي","بِهِۦ","لَوۡلَآ","أَن","رَّبَطۡنَا","عَلَىٰ","قَلۡبِهَا","لِتَكُونَ","مِنَ","ٱلۡمُؤۡمِنِينَ"],"ва'асбаха фу'аду умми мууса фариган ин кадат латубдии бихии лаула ар рабатна `ала ḳалбиха литакууна минал му'миниин","Сердце матери Мусы (Моисея) опустело (переполнилось тревогой и оказалось лишено всех иных чувств). Она готова была раскрыть его (свой поступок), если бы Мы не укрепили ее сердце, чтобы она оставалась верующей.",["И стало","сердце","матери","Мусы","пустым","поистине","она едва не","раскрыла","его","если бы не","то, что","Мы укрепили","на","её сердце","чтобы она была","из","верующих"]],[28,11,["وَقَالَتۡ","لِأُخۡتِهِۦ","قُصِّيهِۖ","فَبَصُرَتۡ","بِهِۦ","عَن","جُنُبٖ","وَهُمۡ","لَا","يَشۡعُرُونَ"],"ваḳалат ли'ухтихии ḳуссиихи фабасурат бихии `ан жунубин вахум ла йаш`уруун","Она сказала его сестре: «Следуй за ним». Она наблюдала за ним издали, и они не замечали этого.",["И она сказала","его сестре","следуй за ним","и она наблюдала","за ним","с","отдаления","а они","не","замечали"]],[28,12,["وَحَرَّمۡنَا","عَلَيۡهِ","ٱلۡمَرَاضِعَ","مِن","قَبۡلُ","فَقَالَتۡ","هَلۡ","أَدُلُّكُمۡ","عَلَىٰٓ","أَهۡلِ","بَيۡتٖ","يَكۡفُلُونَهُۥ","لَكُمۡ","وَهُمۡ","لَهُۥ","نَٰصِحُونَ"],"вахаррамна `алайхил маради`а мин ḳаблу фаḳалат хал адуллукум `ала ахли байтин йакфулуунахуу лакум вахум лахуу насихуун","Мы запретили ему брать грудь кормилиц, пока она (сестра Мусы) не сказала: «Показать ли вам семью, которая будет заботиться о нем для вас и будет желать ему добра?».",["И Мы запретили","для него","кормилиц","ещё","прежде","и сказала она","ли","указать мне вам","на","семью","дома","которые вырастят его","для вас","и они","к нему","доброжелательны"]],[28,13,["فَرَدَدۡنَٰهُ","إِلَىٰٓ","أُمِّهِۦ","كَيۡ","تَقَرَّ","عَيۡنُهَا","وَلَا","تَحۡزَنَ","وَلِتَعۡلَمَ","أَنَّ","وَعۡدَ","ٱللَّهِ","حَقّٞ","وَلَٰكِنَّ","أَكۡثَرَهُمۡ","لَا","يَعۡلَمُونَ"],"фарададнаху ила уммихии кай таḳарра `айнуха вала тахзана валита`лама анна ва`даллахи хаḳḳун валакинна аксарахум ла йа`ламуун","Так Мы вернули его матери, чтобы утешились ее глаза, чтобы она не печалилась и знала, что обещание Аллаха истинно. Но большинство их не ведает этого.",["И Мы вернули его","к","его матери","чтобы","утешился","её глаз","и не","печалилась","и чтобы она знала","что","обещание","Аллаха","истина","но","большинство их","не","знают"]]],"m":[[["وَنُمَكِّنَ","и утвердить",28,6],["لَهُمۡ","им",28,6],["فِي","на",28,6],["ٱلۡأَرۡضِ","земле",28,6],["وَنُرِيَ","и показать",28,6],["فِرۡعَوۡنَ","Фараону",28,6],["وَهَٰمَٰنَ","и Хаману",28,6],["وَجُنُودَهُمَا","и их воинам",28,6]],[["مِنۡهُم","от них",28,6],["مَّا","то, что",28,6],["كَانُواْ","они были",28,6],["يَحۡذَرُونَ","остерегались",28,6],[6],["وَأَوۡحَيۡنَآ","И Мы внушили",28,7],["إِلَىٰٓ","к",28,7],["أُمِّ","матери",28,7],["مُوسَىٰٓ","Мусы",28,7]],[["أَنۡ","что",28,7],["أَرۡضِعِيهِۖ","корми его грудью",28,7],["فَإِذَا","а когда",28,7],["خِفۡتِ","ты будешь бояться",28,7],["عَلَيۡهِ","за него",28,7],["فَأَلۡقِيهِ","то брось его",28,7],["فِي","в",28,7],["ٱلۡيَمِّ","реку",28,7],["وَلَا","и не",28,7],["تَخَافِي","бойся",28,7]],[["وَلَا","и не",28,7],["تَحۡزَنِيٓۖ","печалься",28,7],["إِنَّا","поистине, Мы",28,7],["رَآدُّوهُ","вернём его",28,7],["إِلَيۡكِ","тебе",28,7],["وَجَاعِلُوهُ","и сделаем его",28,7],["مِنَ","из",28,7],["ٱلۡمُرۡسَلِينَ","посланников",28,7],[7]],[["فَٱلۡتَقَطَهُۥٓ","И подобрала его",28,8],["ءَالُ","семья",28,8],["فِرۡعَوۡنَ","Фараона",28,8],["لِيَكُونَ","чтобы он стал",28,8],["لَهُمۡ","для них",28,8],["عَدُوّٗا","врагом",28,8],["وَحَزَنًاۗ","и печалью",28,8],["إِنَّ","Поистине",28,8]],[["فِرۡعَوۡنَ","Фараон",28,8],["وَهَٰمَٰنَ","и Хаман",28,8],["وَجُنُودَهُمَا","и их воины",28,8],["كَانُواْ","были",28,8],["خَٰطِـِٔينَ","грешниками",28,8],[8]],[["وَقَالَتِ","И сказала",28,9],["ٱمۡرَأَتُ","жена",28,9],["فِرۡعَوۡنَ","Фараона",28,9],["قُرَّتُ","услада",28,9],["عَيۡنٖ","глаза",28,9],["لِّي","для меня",28,9],["وَلَكَۖ","и для тебя",28,9],["لَا","не",28,9],["تَقۡتُلُوهُ","убивайте его",28,9],["عَسَىٰٓ","быть может",28,9]],[["أَن","что",28,9],["يَنفَعَنَآ","он принесёт нам пользу",28,9],["أَوۡ","или",28,9],["نَتَّخِذَهُۥ","мы возьмём его",28,9],["وَلَدٗا","сыном",28,9],["وَهُمۡ","а они",28,9],["لَا","не",28,9],["يَشۡعُرُونَ","сознавали",28,9],[9],["وَأَصۡبَحَ","И стало",28,10]],[["فُؤَادُ","сердце",28,10],["أُمِّ","матери",28,10],["مُوسَىٰ","Мусы",28,10],["فَٰرِغًاۖ","пустым",28,10],["إِن","поистине",28,10],["كَادَتۡ","она едва не",28,10],["لَتُبۡدِي","раскрыла",28,10],["بِهِۦ","его",28,10],["لَوۡلَآ","если бы не",28,10],["أَن","то, что",28,10]],[["رَّبَطۡنَا","Мы укрепили",28,10],["عَلَىٰ","на",28,10],["قَلۡبِهَا","её сердце",28,10],["لِتَكُونَ","чтобы она была",28,10],["مِنَ","из",28,10],["ٱلۡمُؤۡمِنِينَ","верующих",28,10],[10],["وَقَالَتۡ","И она сказала",28,11]],[["لِأُخۡتِهِۦ","его сестре",28,11],["قُصِّيهِۖ","следуй за ним",28,11],["فَبَصُرَتۡ","и она наблюдала",28,11],["بِهِۦ","за ним",28,11],["عَن","с",28,11],["جُنُبٖ","отдаления",28,11],["وَهُمۡ","а они",28,11],["لَا","не",28,11],["يَشۡعُرُونَ","замечали",28,11]],[[11],["۞ وَحَرَّمۡنَا","И Мы запретили",28,12],["عَلَيۡهِ","для него",28,12],["ٱلۡمَرَاضِعَ","кормилиц",28,12],["مِن","ещё",28,12],["قَبۡلُ","прежде",28,12],["فَقَالَتۡ","и сказала она",28,12],["هَلۡ","ли",28,12],["أَدُلُّكُمۡ","указать мне вам",28,12]],[["عَلَىٰٓ","на",28,12],["أَهۡلِ","семью",28,12],["بَيۡتٖ","дома",28,12],["يَكۡفُلُونَهُۥ","которые вырастят его",28,12],["لَكُمۡ","для вас",28,12],["وَهُمۡ","и они",28,12],["لَهُۥ","к нему",28,12],["نَٰصِحُونَ","доброжелательны",28,12],[12]],[["فَرَدَدۡنَٰهُ","И Мы вернули его",28,13],["إِلَىٰٓ","к",28,13],["أُمِّهِۦ","его матери",28,13],["كَيۡ","чтобы",28,13],["تَقَرَّ","утешился",28,13],["عَيۡنُهَا","её глаз",28,13],["وَلَا","и не",28,13],["تَحۡزَنَ","печалилась",28,13],["وَلِتَعۡلَمَ","и чтобы она знала",28,13]],[["أَنَّ","что",28,13],["وَعۡدَ","обещание",28,13],["ٱللَّهِ","Аллаха",28,13],["حَقّٞ","истина",28,13],["وَلَٰكِنَّ","но",28,13],["أَكۡثَرَهُمۡ","большинство их",28,13],["لَا","не",28,13],["يَعۡلَمُونَ","знают",28,13],[13]]]}