{"p":387,"j":20,"a":[[28,14,["وَلَمَّا","بَلَغَ","أَشُدَّهُۥ","وَٱسۡتَوَىٰٓ","ءَاتَيۡنَٰهُ","حُكۡمٗا","وَعِلۡمٗاۚ","وَكَذَٰلِكَ","نَجۡزِي","ٱلۡمُحۡسِنِينَ"],"валамма балага ашуддахуу вастава атайнаху хукман ва`илман ваказалика нажзил мухсиниин","Когда он достиг зрелого возраста, Мы даровали ему власть (мудрость или пророчество) и знание. Так Мы воздаем творящим добро.",["И когда","он достиг","своей зрелости","и возмужал","Мы даровали ему","мудрость","и знание","И так","Мы воздаём","творящим добро"]],[28,15,["وَدَخَلَ","ٱلۡمَدِينَةَ","عَلَىٰ","حِينِ","غَفۡلَةٖ","مِّنۡ","أَهۡلِهَا","فَوَجَدَ","فِيهَا","رَجُلَيۡنِ","يَقۡتَتِلَانِ","هَٰذَا","مِن","شِيعَتِهِۦ","وَهَٰذَا","مِنۡ","عَدُوِّهِۦۖ","فَٱسۡتَغَٰثَهُ","ٱلَّذِي","مِن","شِيعَتِهِۦ","عَلَى","ٱلَّذِي","مِنۡ","عَدُوِّهِۦ","فَوَكَزَهُۥ","مُوسَىٰ","فَقَضَىٰ","عَلَيۡهِۖ","قَالَ","هَٰذَا","مِنۡ","عَمَلِ","ٱلشَّيۡطَٰنِۖ","إِنَّهُۥ","عَدُوّٞ","مُّضِلّٞ","مُّبِينٞ"],"вадахалал мадиината `ала хиини гафлатим мин ахлиха фаважада фииха ражулайни йаḳтатилани хаза мин шии`атихии вахаза мин `адуввихии фастагасахул лазии мин шии`атихии `алал лазии мин `адуввихии фаваказахуу мууса фаḳада `алайхи ḳала хаза мин `амалиш шайтани иннахуу `адуввум мудиллум мубиин","Войдя в город, когда его жители были невнимательны, он встретил двух мужчин, которые дрались друг с другом. Один был из числа его сторонников, а другой был из числа его врагов. Тот, кто был из числа его сторонников, попросил его помочь ему против того, кто был из числа его врагов. Муса (Моисей) ударил его кулаком и прикончил. Он сказал: «Это - одно из деяний дьявола. Воистину, он является явным врагом, вводящим в заблуждение».",["И вошёл он","в город","в","время","беспечности","из","её жителей","и нашёл","в нём","двух мужчин","дерущихся друг с другом","этот","из","его сторонников","а этот","из","его врагов","и попросил его о помощи","тот, который","из","его сторонников","против","того, который","из","его врагов","и ударил его кулаком","Муса","и покончил","с ним","Он сказал","это","из","деяния","сатаны","поистине, он","враг","сбивающий с пути","явный"]],[28,16,["قَالَ","رَبِّ","إِنِّي","ظَلَمۡتُ","نَفۡسِي","فَٱغۡفِرۡ","لِي","فَغَفَرَ","لَهُۥٓۚ","إِنَّهُۥ","هُوَ","ٱلۡغَفُورُ","ٱلرَّحِيمُ"],"ḳала рабби иннии заламту нафсии фагфир лии фагафара лахуу иннахуу хуал гафуурур рахиим","Он сказал: «Господи! Я поступил несправедливо по отношению к себе. Прости же меня!». Он простил его, ибо Он - Прощающий, Милосердный.",["Он сказал","Господи","поистине, я","поступил несправедливо","с самим собой","прости же","мне","и Он простил","ему","поистине, Он","Он","Прощающий","Милосердный"]],[28,17,["قَالَ","رَبِّ","بِمَآ","أَنۡعَمۡتَ","عَلَيَّ","فَلَنۡ","أَكُونَ","ظَهِيرٗا","لِّلۡمُجۡرِمِينَ"],"ḳала рабби бима ан`амта `алаййа фалан акууна захиирал лилмужримиин","Он сказал: «Господи, за то, что Ты оказал мне милость, я никогда не буду пособлять грешникам».",["Он сказал","Господи","за то, что","Ты оказал милость","мне","то никогда не","буду я","пособником","для грешников"]],[28,18,["فَأَصۡبَحَ","فِي","ٱلۡمَدِينَةِ","خَآئِفٗا","يَتَرَقَّبُ","فَإِذَا","ٱلَّذِي","ٱسۡتَنصَرَهُۥ","بِٱلۡأَمۡسِ","يَسۡتَصۡرِخُهُۥۚ","قَالَ","لَهُۥ","مُوسَىٰٓ","إِنَّكَ","لَغَوِيّٞ","مُّبِينٞ"],"фа'асбаха фил мадиинати хаифан йатараḳḳабу фа'изал лазистансарахуу бил'амси йастасрихухуу ḳала лахуу мууса иннака лагавиййум мубиин","Утром он отправился в город, оглядываясь со страхом, и вдруг тот, кто попросил его о помощи накануне, вновь позвал его на помощь. Муса (Моисей) сказал ему: «Ты являешься явным заблудшим».",["И утром он оказался","в","городе","боящимся","озираясь","и вот","тот, который","просил его о помощи","вчера","зовёт его на помощь","Сказал","ему","Муса","поистине, ты","непременно заблудший","явный"]],[28,19,["فَلَمَّآ","أَنۡ","أَرَادَ","أَن","يَبۡطِشَ","بِٱلَّذِي","هُوَ","عَدُوّٞ","لَّهُمَا","قَالَ","يَٰمُوسَىٰٓ","أَتُرِيدُ","أَن","تَقۡتُلَنِي","كَمَا","قَتَلۡتَ","نَفۡسَۢا","بِٱلۡأَمۡسِۖ","إِن","تُرِيدُ","إِلَّآ","أَن","تَكُونَ","جَبَّارٗا","فِي","ٱلۡأَرۡضِ","وَمَا","تُرِيدُ","أَن","تَكُونَ","مِنَ","ٱلۡمُصۡلِحِينَ"],"фаламма ан арада ан йабтиша биллазии хуа `адуввул лахума ḳала йамууса атурииду ан таḳтулании кама ḳаталта нафса бил'амси ин турииду илла ан такууна жаббаран фил арди вама турииду ан такууна минал муслихиин","Когда же он захотел схватить того, кто был их врагом, тот сказал: «О Муса (Моисей)! Неужели ты хочешь убить меня, как убил человека вчера? Ты лишь хочешь стать тираном на земле и не хочешь быть в числе тех, кто примиряет людей».",["А когда","же","он захотел","чтобы","схватить","того, который","он","враг","им обоим","он сказал","о Муса","неужели ты хочешь","чтобы","убить меня","как","ты убил","человека","вчера","не","хочешь ты","кроме","чтобы","стать","тираном","на","земле","и не","хочешь ты","чтобы","быть","из","примиряющих"]],[28,20,["وَجَآءَ","رَجُلٞ","مِّنۡ","أَقۡصَا","ٱلۡمَدِينَةِ","يَسۡعَىٰ","قَالَ","يَٰمُوسَىٰٓ","إِنَّ","ٱلۡمَلَأَ","يَأۡتَمِرُونَ","بِكَ","لِيَقۡتُلُوكَ","فَٱخۡرُجۡ","إِنِّي","لَكَ","مِنَ","ٱلنَّٰصِحِينَ"],"важаа ражулум мин аḳсал мадиинати йас`а ḳала йамууса иннал малаа йа'тамирууна бика лийаḳтулуука фахруж иннии лака минан насихиин","С окраины города второпях пришел мужчина и сказал: «О Муса (Моисей)! Знать договаривается о том, чтобы убить тебя. Уходи! Воистину, я даю тебе добрый совет».",["И пришёл","мужчина","с","дальнего края","города","спеша","Он сказал","о Муса","поистине","знать","совещаются","о тебе","чтобы убить тебя","так уходи","поистине, я","тебе","из","доброжелателей"]],[28,21,["فَخَرَجَ","مِنۡهَا","خَآئِفٗا","يَتَرَقَّبُۖ","قَالَ","رَبِّ","نَجِّنِي","مِنَ","ٱلۡقَوۡمِ","ٱلظَّٰلِمِينَ"],"фахаража минха хаифан йатараḳḳабу ḳала рабби нажжинии минал ḳаумиз залимиин","Муса (Моисей) покинул город, оглядываясь со страхом, и сказал: «Господи! Спаси меня от несправедливых людей!».",["И вышел он","из него","боящимся","озираясь","Он сказал","Господи","спаси меня","от","людей","несправедливых"]]],"m":[[["وَلَمَّا","И когда",28,14],["بَلَغَ","он достиг",28,14],["أَشُدَّهُۥ","своей зрелости",28,1