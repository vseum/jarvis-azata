{"p":388,"j":20,"a":[[28,22,["وَلَمَّا","تَوَجَّهَ","تِلۡقَآءَ","مَدۡيَنَ","قَالَ","عَسَىٰ","رَبِّيٓ","أَن","يَهۡدِيَنِي","سَوَآءَ","ٱلسَّبِيلِ"],"валамма таважжаха тилḳаа мадйана ḳала `аса раббии ан йахдийании саваас сабиил","Направившись в сторону Мадьяна, он сказал: «Быть может, мой Господь наставит меня на правильный путь».",["И когда","он направился","в сторону","Мадьяна","он сказал","быть может","мой Господь","что","наставит меня","на прямой","путь"]],[28,23,["وَلَمَّا","وَرَدَ","مَآءَ","مَدۡيَنَ","وَجَدَ","عَلَيۡهِ","أُمَّةٗ","مِّنَ","ٱلنَّاسِ","يَسۡقُونَ","وَوَجَدَ","مِن","دُونِهِمُ","ٱمۡرَأَتَيۡنِ","تَذُودَانِۖ","قَالَ","مَا","خَطۡبُكُمَاۖ","قَالَتَا","لَا","نَسۡقِي","حَتَّىٰ","يُصۡدِرَ","ٱلرِّعَآءُۖ","وَأَبُونَا","شَيۡخٞ","كَبِيرٞ"],"валамма варада маа мадйана важада `алайхи умматам минан наси йасḳууна ваважада мин дуунихимумраатайни тазуудани ḳала ма хатбукума ḳалата ла насḳии хатта йусдирар ри`ау ва'абууна шайхун кабиир","Когда он прибыл к колодцу в Мадьяне, то обнаружил возле него людей, которые поили скотину. Неподалеку от них он увидел двух женщин, которые отгоняли свое стадо. Он сказал: «Что с вами?». Они сказали: «Мы не поим скотину, пока пастухи не уведут свои стада. Наш отец очень стар».",["И когда","он прибыл","к воде","Мадьяна","он нашёл","у неё","толпу","из","людей","поящих","и нашёл","поодаль","от них","двух женщин","отгоняющих (стадо)","Он сказал","каково","ваше дело","сказали обе","не","поим мы","пока не","уведут (стада)","пастухи","а наш отец","старец","преклонный"]],[28,24,["فَسَقَىٰ","لَهُمَا","ثُمَّ","تَوَلَّىٰٓ","إِلَى","ٱلظِّلِّ","فَقَالَ","رَبِّ","إِنِّي","لِمَآ","أَنزَلۡتَ","إِلَيَّ","مِنۡ","خَيۡرٖ","فَقِيرٞ"],"фасаḳа лахума сумма тавалла илаз зилли фаḳала рабби иннии лима анзалта илаййа мин хайрин фаḳиир","Он напоил для них скотину, а затем вернулся в тень и сказал: «Господи! Воистину, я нуждаюсь в любом благе, которое Ты ниспошлешь мне».",["И он напоил","для них обеих","затем","отошёл","к","тени","и сказал","Господи","поистине, я","в том, что","Ты ниспослал","мне","из","блага","нуждающийся"]],[28,25,["فَجَآءَتۡهُ","إِحۡدَىٰهُمَا","تَمۡشِي","عَلَى","ٱسۡتِحۡيَآءٖ","قَالَتۡ","إِنَّ","أَبِي","يَدۡعُوكَ","لِيَجۡزِيَكَ","أَجۡرَ","مَا","سَقَيۡتَ","لَنَاۚ","فَلَمَّا","جَآءَهُۥ","وَقَصَّ","عَلَيۡهِ","ٱلۡقَصَصَ","قَالَ","لَا","تَخَفۡۖ","نَجَوۡتَ","مِنَ","ٱلۡقَوۡمِ","ٱلظَّٰلِمِينَ"],"фажаатху ихдахума тамшии `аластихйаин ḳалат инна абии йад`уука лийажзийака ажра ма саḳайта лана фаламма жаахуу ваḳасса `алайхил ḳасаса ḳала ла тахаф нажаута минал ḳаумиз залимиин","Одна из двух женщин подошла к нему застенчиво и сказала: «Мой отец зовет тебя, чтобы вознаградить тебя за то, что ты напоил для нас скотину». Когда он пришел к отцу и поведал ему рассказ, он сказал: «Не бойся. Ты спасся от несправедливых людей».",["И пришла к нему","одна из них двух","идя","с","застенчивостью","Она сказала","поистине","мой отец","зовёт тебя","чтобы вознаградить тебя","платой","за то, что","ты напоил","для нас","А когда","он пришёл к нему","и рассказал","ему","историю","он сказал","не","бойся","ты спасся","от","людей","несправедливых"]],[28,26,["قَالَتۡ","إِحۡدَىٰهُمَا","يَٰٓأَبَتِ","ٱسۡتَـٔۡجِرۡهُۖ","إِنَّ","خَيۡرَ","مَنِ","ٱسۡتَـٔۡجَرۡتَ","ٱلۡقَوِيُّ","ٱلۡأَمِينُ"],"ḳалат ихдахума йа'абатиста'жирху инна хайра маниста'жартал ḳавиййул амиин","Одна из двух женщин сказала: «Отец мой! Найми его, ведь лучшим из тех, кого ты наймешь, будет тот, кто силен и заслуживает доверия».",["Сказала","одна из них двух","о отец мой","найми его","поистине","лучший","кого","ты нанял","сильный","надёжный"]],[28,27,["قَالَ","إِنِّيٓ","أُرِيدُ","أَنۡ","أُنكِحَكَ","إِحۡدَى","ٱبۡنَتَيَّ","هَٰتَيۡنِ","عَلَىٰٓ","أَن","تَأۡجُرَنِي","ثَمَٰنِيَ","حِجَجٖۖ","فَإِنۡ","أَتۡمَمۡتَ","عَشۡرٗا","فَمِنۡ","عِندِكَۖ","وَمَآ","أُرِيدُ","أَنۡ","أَشُقَّ","عَلَيۡكَۚ","سَتَجِدُنِيٓ","إِن","شَآءَ","ٱللَّهُ","مِنَ","ٱلصَّٰلِحِينَ"],"ḳала иннии урииду ан ункихака ихдабнатаййа хатайни `ала ан та'журании саманийа хижажин фа'ин атмамта `ашран фамин `индика вама урииду ан ашуḳḳа `алайка сатажидунии ин шааллаху минас салихиин","Он сказал: «Воистину, я хочу сочетать тебя браком с одной из моих дочерей этих при условии, что ты наймешься ко мне на восемь лет. Если же ты останешься на все десять, то это будет милостью от тебя. Я не собираюсь обременять тебя, и ты увидишь, если пожелает Аллах, что я являюсь одним из праведников».",["Он сказал","поистине, я","хочу","чтобы","женить тебя","на одной","из двух моих дочерей","этих двух","на (условии)","что","ты будешь служить мне","восемь","лет","а если","ты завершишь","десять","то от","тебя","И не","хочу я","чтобы","обременить","тебя","ты найдёшь меня","если","пожелает","Аллах","из","праведников"]],[28,28,["قَالَ","ذَٰلِكَ","بَيۡنِي","وَبَيۡنَكَۖ","أَيَّمَا","ٱلۡأَجَلَيۡنِ","قَضَيۡتُ","فَلَا","عُدۡوَٰنَ","عَلَيَّۖ","وَٱللَّهُ","عَلَىٰ","مَا","نَقُولُ","وَكِيلٞ"],"ḳала залика байнии вабайнака аййамал ажалайни ḳадайту фала `удвана `алаййа валлаху `ала ма наḳуулу вакиил","Он сказал: «Договорились. Какой бы из этих двух сроков я ни отработал, пусть со мной не поступают несправедливо. Аллах является Попечителем и Хранителем того, что мы говорим».",["Он сказал","это","между мной","и между тобой","какой бы из","двух сроков","я ни отработал","то нет","посягательства","на меня","И Аллах","над","тем, что","мы говорим","Попечитель"]]],"m":[[["وَلَمَّا","И когда",28,22],["تَوَجَّهَ","он направился",28,22],["تِلۡقَآءَ","в сторону",28,22],["مَدۡيَنَ","Мадьяна",28,22],["قَالَ","он сказал",28,22],["عَسَىٰ","быть может",28,22],["رَبِّيٓ","мой Господь",28,22],["أَن","что",28,22],["يَهۡدِيَنِي","наставит меня",28,22],["سَوَآءَ","на прямой",28,22]],[["ٱلسَّبِيلِ","путь",28,22],[22],["وَلَمَّا","И когда",28,23],["وَرَدَ","он прибыл",28,23],["مَآءَ","к воде",28,23],["مَدۡيَنَ","Мадьяна",28,23],["وَجَدَ","он нашёл",28,23],["عَلَيۡهِ","у неё",28,23],["أُمَّةٗ","толпу",28,23],["مِّنَ","из",28,23]],[["ٱلنَّاسِ","людей",28,23],["يَسۡقُونَ","поящих",28,23],["وَوَجَدَ","и нашёл",28,23],["مِن","поодаль",28,23],["دُونِهِ