{"p":389,"j":20,"a":[[28,29,["فَلَمَّا","قَضَىٰ","مُوسَى","ٱلۡأَجَلَ","وَسَارَ","بِأَهۡلِهِۦٓ","ءَانَسَ","مِن","جَانِبِ","ٱلطُّورِ","نَارٗاۖ","قَالَ","لِأَهۡلِهِ","ٱمۡكُثُوٓاْ","إِنِّيٓ","ءَانَسۡتُ","نَارٗا","لَّعَلِّيٓ","ءَاتِيكُم","مِّنۡهَا","بِخَبَرٍ","أَوۡ","جَذۡوَةٖ","مِّنَ","ٱلنَّارِ","لَعَلَّكُمۡ","تَصۡطَلُونَ"],"фаламма ḳада муусал ажала васара би'ахлихии анаса мин жанибит туури наран ḳала ли'ахлихимкусуу иннии анасту нарал ла`аллии атиикум минха бихабарин ау жазватим минан нари ла`аллакум тасталуун","Когда Муса (Моисей) отработал срок и двинулся в путь со своей семьей, он увидел со стороны горы огонь и сказал своей семье: «Оставайтесь здесь! Я увидел огонь. Возможно, я принесу вам оттуда известие или горящую головню, чтобы вы могли согреться».",["А когда","завершил","Муса","срок","и отправился","со своей семьёй","он увидел","со","стороны","Тура","огонь","Он сказал","своей семье","оставайтесь","поистине, я","увидел","огонь","может быть, я","принесу вам","от него","весть","или","головню","из","огня","может быть, вы","согреетесь"]],[28,30,["فَلَمَّآ","أَتَىٰهَا","نُودِيَ","مِن","شَٰطِيِٕ","ٱلۡوَادِ","ٱلۡأَيۡمَنِ","فِي","ٱلۡبُقۡعَةِ","ٱلۡمُبَٰرَكَةِ","مِنَ","ٱلشَّجَرَةِ","أَن","يَٰمُوسَىٰٓ","إِنِّيٓ","أَنَا","ٱللَّهُ","رَبُّ","ٱلۡعَٰلَمِينَ"],"фаламма атаха нуудийа мин шатийил вадил аймани фил буḳ`атил мубаракати минаш шажарати ан йамууса иннии аналлаху раббул `аламиин","Подойдя туда, он услышал глас со стороны дерева, которое росло в благословенном месте на правой стороне долины: «О Муса (Моисей)! Я- Аллах, Господь миров.",["А когда","он подошёл к нему","раздался ему зов","от","края","долины","правого","в","месте","благословенном","от","дерева","что","о Муса","поистине, Я","Я","Аллах","Господь","миров"]],[28,31,["وَأَنۡ","أَلۡقِ","عَصَاكَۚ","فَلَمَّا","رَءَاهَا","تَهۡتَزُّ","كَأَنَّهَا","جَآنّٞ","وَلَّىٰ","مُدۡبِرٗا","وَلَمۡ","يُعَقِّبۡۚ","يَٰمُوسَىٰٓ","أَقۡبِلۡ","وَلَا","تَخَفۡۖ","إِنَّكَ","مِنَ","ٱلۡأٓمِنِينَ"],"ва'ан алḳи `асака фаламма ра'аха тахтаззу ка'аннаха жаннун валла мудбиран валам йу`аḳḳиб йамууса аḳбил вала тахаф иннака минал аминиин","Брось свой посох!». Когда же он увидел, как тот извивается, словно змея, он бросился бежать и не вернулся (или не обернулся). Аллах сказал: «О Муса (Моисей)! Подойди и не бойся, ибо ты являешься одним из тех, кто находится в безопасности.",["И что","брось","свой посох","А когда","он увидел его","извивающимся","будто он","змея","он повернулся","убегая","и не","вернулся","о Муса","подойди","и не","бойся","поистине, ты","из","находящихся в безопасности"]],[28,32,["ٱسۡلُكۡ","يَدَكَ","فِي","جَيۡبِكَ","تَخۡرُجۡ","بَيۡضَآءَ","مِنۡ","غَيۡرِ","سُوٓءٖ","وَٱضۡمُمۡ","إِلَيۡكَ","جَنَاحَكَ","مِنَ","ٱلرَّهۡبِۖ","فَذَٰنِكَ","بُرۡهَٰنَانِ","مِن","رَّبِّكَ","إِلَىٰ","فِرۡعَوۡنَ","وَمَلَإِيْهِۦٓۚ","إِنَّهُمۡ","كَانُواْ","قَوۡمٗا","فَٰسِقِينَ"],"ислук йадака фии жайбика тахруж байдаа мин гайри сууин вадмум илайка жанахака минар рахби фазаника бурханани мир раббика ила фир`ауна вамалаихии иннахум кануу ḳауман фасиḳиин","Сунь свою руку за пазуху, и она выйдет белой (цвета молока, светящейся), без следов болезни. Прижми к себе руку, чтобы избавиться от страха. Это - два доказательства от твоего Господа для Фараона и его знати. Воистину, они являются людьми нечестивыми».",["Введи","свою руку","в","свою пазуху","выйдет она","белой","без","какого-либо","вреда","И прижми","к себе","свою руку","от","страха","И вот эти","два доказательства","от","твоего Господа","к","Фараону","и его знати","поистине, они","были","людьми","нечестивыми"]],[28,33,["قَالَ","رَبِّ","إِنِّي","قَتَلۡتُ","مِنۡهُمۡ","نَفۡسٗا","فَأَخَافُ","أَن","يَقۡتُلُونِ"],"ḳала рабби иннии ḳаталту минхум нафсан фа'ахафу ан йаḳтулуун","Он сказал: «Господи! Я убил одного из них и боюсь, что они убьют меня.",["Он сказал","Господи","поистине, я","убил","из них","человека","и я боюсь","что","они убьют меня"]],[28,34,["وَأَخِي","هَٰرُونُ","هُوَ","أَفۡصَحُ","مِنِّي","لِسَانٗا","فَأَرۡسِلۡهُ","مَعِيَ","رِدۡءٗا","يُصَدِّقُنِيٓۖ","إِنِّيٓ","أَخَافُ","أَن","يُكَذِّبُونِ"],"ва'ахии харууну хуа афсаху миннии лисанан фа'арсилху ма`ийа рид'ан йусаддиḳунии иннии ахафу ан йуказзибуун","Мой брат Харун (Аарон) более красноречив, чем я. Пошли же его со мною помощником, чтобы он подтвердил мою правдивость. Я действительно боюсь, что они сочтут меня лжецом».",["А мой брат","Харун","он","красноречивее","меня","языком","так пошли его","со мной","помощником","подтверждающим меня","поистине, я","боюсь","что","они сочтут меня лжецом"]],[28,35,["قَالَ","سَنَشُدُّ","عَضُدَكَ","بِأَخِيكَ","وَنَجۡعَلُ","لَكُمَا","سُلۡطَٰنٗا","فَلَا","يَصِلُونَ","إِلَيۡكُمَا","بِـَٔايَٰتِنَآۚ","أَنتُمَا","وَمَنِ","ٱتَّبَعَكُمَا","ٱلۡغَٰلِبُونَ"],"ḳала санашудду `адудака би'ахиика ванаж`алу лакума султанан фала йасилууна илайкума би'айатина антума ваманиттаба`акумал галибуун","Он сказал: «Мы укрепим твою руку посредством твоего брата и одарим вас доказательством (или силой). Они не смогут навредить вам. Благодаря Нашим знамениям вы и те, кто последует за вами, станете победителями».",["Он сказал","Мы укрепим","твою руку","твоим братом","и Мы дадим","вам обоим","власть","и не","доберутся они","до вас обоих","благодаря Нашим знамениям","вы двое","и те, кто","последовал за вами","победители"]]],"m":[[["۞ فَلَمَّا","А когда",28,29],["قَضَىٰ","завершил",28,29],["مُوسَى","Муса",28,29],["ٱلۡأَجَلَ","срок",28,29],["وَسَارَ","и отправился",28,29],["بِأَهۡلِهِۦٓ","со своей семьёй",28,29],["ءَانَسَ","он увидел",28,29],["مِن","со",28,29],["جَانِبِ","стороны",28,29]],[["ٱلطُّورِ","Тура",28,29],["نَارٗاۖ","огонь",28,29],["قَالَ","Он сказал",28,29],["لِأَهۡلِهِ","своей семье",28,29],["ٱمۡكُثُوٓاْ","оставайтесь",28,29],["إِنِّيٓ","поистине, я",28,29],["ءَانَسۡتُ","увидел",28,29],["نَارٗا","огонь",28,29],["لَّعَلِّيٓ","может быть, я",28,29],["ءَاتِيكُم","принесу вам",28,29]],[["مِّنۡهَا","от него",28,29],["بِخَبَرٍ","весть",28,29],["أَوۡ","или",28,29],["جَذۡوَةٖ","головню",28,29],["مِّنَ","из",28,29],["ٱلنَّارِ","огня",28,29],["لَعَلَّكُمۡ","может быть, вы",28,29],["تَصۡطَلُونَ","согреетесь",28,29]],[[29],["فَلَمَّآ","А когда",28,30],["أَتَىٰهَا","он подошёл к нему",28,30],["نُودِيَ","раздался ему зов",28,30],["مِن","от",28,30],["شَٰطِيِٕ","края",28,30],["ٱلۡوَادِ","долины",28,30],["ٱلۡأَيۡمَنِ","правого",28,30],["فِي","в",28,30],["ٱلۡبُقۡعَةِ","месте",28,30]],[["ٱلۡمُبَٰرَكَةِ","благословенном",28,30],["مِنَ","от",28,30],["ٱلشَّجَرَةِ","дерева",28,30],["أَن","что",28,30],["يَٰمُوسَىٰٓ","о Муса",28,30],["إِنِّيٓ","поистине, Я",28,30],["أَنَا","Я",28,30],["ٱللَّهُ","Аллах",28,30],["رَبُّ","Господь",28,30]],[["ٱلۡعَٰلَمِينَ","миров",28,30],[30],["وَأَنۡ","И что",28,31],["أَلۡقِ","брось",28,31],["عَصَاكَۚ","свой посох",28,31],["فَلَمَّا","А когда",28,31],["رَءَاهَا","он увидел его",28,31],["تَهۡتَزُّ","извивающимся",28,31],["كَأَنَّهَا","будто он",28,31]],[["جَآنّٞ","змея",28,31],["وَلَّىٰ","он повернулся",28,31],["مُدۡبِرٗا","убегая",28,31],["وَلَمۡ","и не",28,31],["يُعَقِّبۡۚ","вернулся",28,31],["يَٰمُوسَىٰٓ","о Муса",28,31],["أَقۡبِلۡ","подойди",28,31],["وَلَا","и не",28,31],["تَخَفۡۖ","бойся",28,31],["إِنَّكَ","поистине, ты",28,31]],[["مِنَ","из",28,31],["ٱلۡأٓمِنِينَ","находящихся в безопасности",28,31],[31],["ٱسۡلُكۡ","Введи",28,32],["يَدَكَ","свою руку",28,32],["فِي","в",28,32],["جَيۡبِكَ","свою пазуху",28,32],["تَخۡرُجۡ","выйдет она",28,32],["بَيۡضَآءَ","белой",28,32],["مِنۡ","без",28,32]],[["غَيۡرِ","какого-либо",28,32],["سُوٓءٖ","вреда",28,32],["وَٱضۡمُمۡ","И прижми",28,32],["إِلَيۡكَ","к себе",28,32],["جَنَاحَكَ","свою руку",28,32],["مِنَ","от",28,32],["ٱلرَّهۡبِۖ","страха",28,32],["فَذَٰنِكَ","И вот эти",28,32]],[["بُرۡهَٰنَانِ","два доказательства",28,32],["مِن","от",28,32],["رَّبِّكَ","твоего Господа",28,32],["إِلَىٰ","к",28,32],["فِرۡعَوۡنَ","Фараону",28,32],["وَمَلَإِيْهِۦٓۚ","и его знати",28,32],["إِنَّهُمۡ","поистине, они",28,32],["كَانُواْ","были",28,32]],[["قَوۡمٗا","людьми",28,32],["فَٰسِقِينَ","нечестивыми",28,32],[32],["قَالَ","Он сказал",28,33],["رَبِّ","Господи",28,33],["إِنِّي","поистине, я",28,33],["قَتَلۡتُ","убил",28,33],["مِنۡهُمۡ","из них",28,33],["نَفۡسٗا","человека",28,33],["فَأَخَافُ","и я боюсь",28,33]],[["أَن","что",28,33],["يَقۡتُلُونِ","они убьют меня",28,33],[33],["وَأَخِي","А мой брат",28,34],["هَٰرُونُ","Харун",28,34],["هُوَ","он",28,34],["أَفۡصَحُ","красноречивее",28,34],["مِنِّي","меня",28,34],["لِسَانٗا","языком",28,34]],[["فَأَرۡسِلۡهُ","так пошли его",28,34],["مَعِيَ","со мной",28,34],["رِدۡءٗا","помощником",28,34],["يُصَدِّقُنِيٓۖ","подтверждающим меня",28,34],["إِنِّيٓ","поистине, я",28,34],["أَخَافُ","боюсь",28,34],["أَن","что",28,34],["يُكَذِّبُونِ","они сочтут меня лжецом",28,34],[34]],[["قَالَ","Он сказал",28,35],["سَنَشُدُّ","Мы укрепим",28,35],["عَضُدَكَ","твою руку",28,35],["بِأَخِيكَ","твоим братом",28,35],["وَنَجۡعَلُ","и Мы дадим",28,35],["لَكُمَا","вам обоим",28,35],["سُلۡطَٰنٗا","власть",28,35],["فَلَا","и не",28,35]],[["يَصِلُونَ","доберутся они",28,35],["إِلَيۡكُمَا","до вас обоих",28,35],["بِـَٔايَٰتِنَآۚ","благодаря Нашим знамениям",28,35],["أَنتُمَا","вы двое",28,35],["وَمَنِ","и те, кто",28,35],["ٱتَّبَعَكُمَا","последовал за вами",28,35],["ٱلۡغَٰلِبُونَ","победители",28,35],[35]]]}