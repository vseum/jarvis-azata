{"p":390,"j":20,"a":[[28,36,["فَلَمَّا","جَآءَهُم","مُّوسَىٰ","بِـَٔايَٰتِنَا","بَيِّنَٰتٖ","قَالُواْ","مَا","هَٰذَآ","إِلَّا","سِحۡرٞ","مُّفۡتَرٗى","وَمَا","سَمِعۡنَا","بِهَٰذَا","فِيٓ","ءَابَآئِنَا","ٱلۡأَوَّلِينَ"],"фаламма жаахум мууса би'айатина баййинатин ḳалуу ма хаза илла сихрум муфтаран вама сами`на бихаза фии абаинал аввалиин","Когда Муса (Моисей) явился к ним с Нашими ясными знамениями, они сказали: «Это - всего лишь вымышленное колдовство. Мы не слышали об этом от наших праотцев».",["А когда","пришёл к ним","Муса","с Нашими знамениями","ясными","они сказали","не","это","лишь","колдовство","измышленное","и не","слышали мы","об этом","у","наших отцов","древних"]],[28,37,["وَقَالَ","مُوسَىٰ","رَبِّيٓ","أَعۡلَمُ","بِمَن","جَآءَ","بِٱلۡهُدَىٰ","مِنۡ","عِندِهِۦ","وَمَن","تَكُونُ","لَهُۥ","عَٰقِبَةُ","ٱلدَّارِۚ","إِنَّهُۥ","لَا","يُفۡلِحُ","ٱلظَّٰلِمُونَ"],"ваḳала мууса раббии а`ламу биман жаа билхуда мин `индихии ваман такууну лахуу `аḳибатуд дари иннахуу ла йуфлихуз залимуун","Тогда Муса (Моисей) сказал: «Мой Господь лучше знает, кто пришел с верным руководством от Него и чей исход в Последней жизни окажется счастливым. Воистину, беззаконники не преуспеют».",["И сказал","Муса","Мой Господь","лучше знает","о том, кто","пришёл","с руководством","от","Него","и о том, кто","будет","для него","исход","обители","поистине","не","преуспеют","беззаконники"]],[28,38,["وَقَالَ","فِرۡعَوۡنُ","يَٰٓأَيُّهَا","ٱلۡمَلَأُ","مَا","عَلِمۡتُ","لَكُم","مِّنۡ","إِلَٰهٍ","غَيۡرِي","فَأَوۡقِدۡ","لِي","يَٰهَٰمَٰنُ","عَلَى","ٱلطِّينِ","فَٱجۡعَل","لِّي","صَرۡحٗا","لَّعَلِّيٓ","أَطَّلِعُ","إِلَىٰٓ","إِلَٰهِ","مُوسَىٰ","وَإِنِّي","لَأَظُنُّهُۥ","مِنَ","ٱلۡكَٰذِبِينَ"],"ваḳала фир`ауну йа'аййухал малау ма `алимту лакум мин илахин гайрии фа'ауḳид лии йахаману `алат тиини фаж`ал лии сархал ла`аллии аттали`у ила илахи мууса ва'иннии ла'азуннухуу минал казибиин","Фараон сказал: «О знать! Я не знаю для вас иного бога, кроме меня. О Хаман! Разожги огонь над глиной и сооруди для меня башню, чтобы я смог подняться к Богу Мусы. Воистину, я полагаю, что он является одним из лжецов».",["И сказал","Фараон","О","знать","не","знаю я","для вас","какого-либо","бога","кроме меня","так разожги","для меня","о Хаман","над","глиной","и сделай","для меня","башню","чтобы я","взглянул","на","Бога","Мусы","и поистине, я","непременно считаю его","из","лжецов"]],[28,39,["وَٱسۡتَكۡبَرَ","هُوَ","وَجُنُودُهُۥ","فِي","ٱلۡأَرۡضِ","بِغَيۡرِ","ٱلۡحَقِّ","وَظَنُّوٓاْ","أَنَّهُمۡ","إِلَيۡنَا","لَا","يُرۡجَعُونَ"],"вастакбара хуа важунуудухуу фил арди бигайрил хаḳḳи вазаннуу аннахум илайна ла йуржа`уун","Он и его воины несправедливо возгордились на земле и предположили, что они не вернутся к Нам.",["И возгордился","он","и его войска","на","земле","без","права","и подумали они","что они","к Нам","не","будут возвращены"]],[28,40,["فَأَخَذۡنَٰهُ","وَجُنُودَهُۥ","فَنَبَذۡنَٰهُمۡ","فِي","ٱلۡيَمِّۖ","فَٱنظُرۡ","كَيۡفَ","كَانَ","عَٰقِبَةُ","ٱلظَّٰلِمِينَ"],"фа'ахазнаху важунуудахуу фанабазнахум фил йамми фанзур кайфа кана `аḳибатуз залимиин","Мы схватили его и его воинов и бросили их в море. Посмотри же, каким был конец беззаконников!",["И схватили Мы его","и его войска","и бросили Мы их","в","море","посмотри же","каким","был","конец","беззаконников"]],[28,41,["وَجَعَلۡنَٰهُمۡ","أَئِمَّةٗ","يَدۡعُونَ","إِلَى","ٱلنَّارِۖ","وَيَوۡمَ","ٱلۡقِيَٰمَةِ","لَا","يُنصَرُونَ"],"важа`алнахум а'имматан йад`ууна илан нари вайаумал ḳийамати ла йунсаруун","Мы сделали их предводителями, которые призывают в Огонь, и в День воскресения им не окажут помощи.",["И сделали Мы их","предводителями","призывающими","к","Огню","и в День","воскресения","не","получат помощи"]],[28,42,["وَأَتۡبَعۡنَٰهُمۡ","فِي","هَٰذِهِ","ٱلدُّنۡيَا","لَعۡنَةٗۖ","وَيَوۡمَ","ٱلۡقِيَٰمَةِ","هُم","مِّنَ","ٱلۡمَقۡبُوحِينَ"],"ва'атба`нахум фии хазихид дунйа ла`натан вайаумал ḳийамати хум минал маḳбуухиин","Мы сделали так, что проклятие следует за ними в этом мире, а в День воскресения они будут в числе отдаленных от милости.",["И послали Мы вслед им","в","этом","мире","проклятие","и в День","воскресения","они","из","отвергнутых"]],[28,43,["وَلَقَدۡ","ءَاتَيۡنَا","مُوسَى","ٱلۡكِتَٰبَ","مِنۢ","بَعۡدِ","مَآ","أَهۡلَكۡنَا","ٱلۡقُرُونَ","ٱلۡأُولَىٰ","بَصَآئِرَ","لِلنَّاسِ","وَهُدٗى","وَرَحۡمَةٗ","لَّعَلَّهُمۡ","يَتَذَكَّرُونَ"],"валаḳад атайна муусал китаба мим ба`ди ма ахлакнал ḳуруунал уула басаира линнаси вахудан варахматал ла`аллахум йатазаккаруун","Погубив первые поколения, Мы даровали Мусе (Моисею) Писание в качестве наглядного наставления для людей, верного руководства и милости, чтобы они могли помянуть назидание.",["И уже","даровали Мы","Мусе","Писание","после","того","как","погубили Мы","поколения","первые","прозрениями","для людей","и руководством","и милостью","чтобы они","помянули назидание"]]],"m":[[["فَلَمَّا","А когда",28,36],["جَآءَهُم","пришёл к ним",28,36],["مُّوسَىٰ","Муса",28,36],["بِـَٔايَٰتِنَا","с Нашими знамениями",28,36],["بَيِّنَٰتٖ","ясными",28,36],["قَالُواْ","они сказали",28,36],["مَا","не",28,36],["هَٰذَآ","это",28,36],["إِلَّا","лишь",28,36],["سِحۡرٞ","колдовство",28,36]],[["مُّفۡتَرٗى","измышленное",28,36],["وَمَا","и не",28,36],["سَمِعۡنَا","слышали мы",28,36],["بِهَٰذَا","об этом",28,36],["فِيٓ","у",28,36],["ءَابَآئِنَا","наших отцов",28,36],["ٱلۡأَوَّلِينَ","древних",28,36],[36],["وَقَالَ","И сказал",28,37]],[["مُوسَىٰ","Муса",28,37],["رَبِّيٓ","Мой Господь",28,37],["أَعۡلَمُ","лучше знает",28,37],["بِمَن","о том, кто",28,37],["جَآءَ","пришёл",28,37],["بِٱلۡهُدَىٰ","с руководством",28,37],["مِنۡ","от",28,37],["عِندِهِۦ","Него",28,37],["وَمَن","и о том, кто",28,37],["تَكُونُ","будет",28,37]],[["لَهُۥ","для него",28,37],["عَٰقِبَةُ","исход",28,37],["ٱلدَّارِۚ","обители",28,37],["إِنَّهُۥ","поистине",28,37],["لَا","не",28,37],["يُفۡلِحُ","преуспеют",28,37],["ٱلظَّٰلِمُونَ","беззаконники",28,37],[37],["وَقَالَ","И сказал",28,38],["فِرۡعَوۡنُ","Фараон",28,38]],[["يَٰٓأَيُّهَا","О",28,38],["ٱلۡمَلَأُ","знать",28,38],["مَا","не",28,38],["عَلِمۡتُ","знаю я",28,38],["لَكُم"