{"p":391,"j":20,"a":[[28,44,["وَمَا","كُنتَ","بِجَانِبِ","ٱلۡغَرۡبِيِّ","إِذۡ","قَضَيۡنَآ","إِلَىٰ","مُوسَى","ٱلۡأَمۡرَ","وَمَا","كُنتَ","مِنَ","ٱلشَّٰهِدِينَ"],"вама кунта бижанибил гарбиййи из ḳадайна ила муусал амра вама кунта минаш шахидиин","Тебя не было на западном склоне, когда Мы возложили на Мусу (Моисея) наши повеления, и тебя не было в числе присутствовавших.",["И не","был ты","на склоне","западном","когда","возложили Мы","на","Мусу","повеление","и не","был ты","из","свидетелей"]],[28,45,["وَلَٰكِنَّآ","أَنشَأۡنَا","قُرُونٗا","فَتَطَاوَلَ","عَلَيۡهِمُ","ٱلۡعُمُرُۚ","وَمَا","كُنتَ","ثَاوِيٗا","فِيٓ","أَهۡلِ","مَدۡيَنَ","تَتۡلُواْ","عَلَيۡهِمۡ","ءَايَٰتِنَا","وَلَٰكِنَّا","كُنَّا","مُرۡسِلِينَ"],"валакинна анша'на ḳуруунан фататавала `алайхимул `умуру вама кунта савийан фии ахли мадйана татлуу `алайхим айатина валакинна кунна мурсилиин","Но Мы сотворили поколения после Мусы (Моисея), и долгим оказался для них срок. Тебя не было среди жителей Мадьяна, и ты не читал им Наши аяты, но Мы отправили посланников.",["Но Мы","сотворили","поколения","и продлился","для них","срок жизни","и не","был ты","проживающим","среди","жителей","Мадьяна","читая","им","Наши аяты","но Мы","были","посылающими"]],[28,46,["وَمَا","كُنتَ","بِجَانِبِ","ٱلطُّورِ","إِذۡ","نَادَيۡنَا","وَلَٰكِن","رَّحۡمَةٗ","مِّن","رَّبِّكَ","لِتُنذِرَ","قَوۡمٗا","مَّآ","أَتَىٰهُم","مِّن","نَّذِيرٖ","مِّن","قَبۡلِكَ","لَعَلَّهُمۡ","يَتَذَكَّرُونَ"],"вама кунта бижанибит туури из надайна валакир рахматам мир раббика литунзира ḳаумам ма атахум мин назиирим мин ḳаблика ла`аллахум йатазаккаруун","Тебя не было на склоне горы, когда Мы воззвали, но это было милостью твоего Господа, чтобы ты предостерег народ, к которому до тебя не приходил предостерегающий увещеватель. Быть может, они помянут назидание.",["И не","был ты","у склона","Тура","когда","воззвали Мы","но","по милости","от","твоего Господа","чтобы ты предостерёг","народ","не","приходил к ним","какой-либо","предостерегающий","до","тебя","чтобы они","помянули назидание"]],[28,47,["وَلَوۡلَآ","أَن","تُصِيبَهُم","مُّصِيبَةُۢ","بِمَا","قَدَّمَتۡ","أَيۡدِيهِمۡ","فَيَقُولُواْ","رَبَّنَا","لَوۡلَآ","أَرۡسَلۡتَ","إِلَيۡنَا","رَسُولٗا","فَنَتَّبِعَ","ءَايَٰتِكَ","وَنَكُونَ","مِنَ","ٱلۡمُؤۡمِنِينَ"],"валаула ан тусиибахум мусиибату бима ḳаддамат айдиихим файаḳуулуу раббана лаула арсалта илайна расуулан фанаттаби`а айатика ванакууна минал му'миниин","А если бы этого не произошло и если бы их постигло несчастье за то, что приготовили их руки, то они бы сказали: «Господь наш! Почему Ты не отправил к нам посланника, чтобы мы последовали за Твоими знамениями и стали одними из верующих?».",["И если бы не","то, что","постигнет их","беда","за то, что","уготовили","их руки","и сказали бы они","Господь наш","почему не","послал Ты","к нам","посланника","и последовали бы мы","Твоим знамениям","и были бы мы","из","верующих"]],[28,48,["فَلَمَّا","جَآءَهُمُ","ٱلۡحَقُّ","مِنۡ","عِندِنَا","قَالُواْ","لَوۡلَآ","أُوتِيَ","مِثۡلَ","مَآ","أُوتِيَ","مُوسَىٰٓۚ","أَوَلَمۡ","يَكۡفُرُواْ","بِمَآ","أُوتِيَ","مُوسَىٰ","مِن","قَبۡلُۖ","قَالُواْ","سِحۡرَانِ","تَظَٰهَرَا","وَقَالُوٓاْ","إِنَّا","بِكُلّٖ","كَٰفِرُونَ"],"фаламма жаахумул хаḳḳу мин `индина ḳалуу лаула уутийа мисла ма уутийа мууса авалам йакфуруу бима уутийа мууса мин ḳаблу ḳалуу сихрани тазахара ваḳалуу инна бикуллин кафируун","Когда же к ним явилась истина от Нас, они сказали: «Почему ему не даровано то, что было даровано Мусе (Моисею)?». Разве они не отвергли то, что прежде было даровано Мусе (Моисею)? Они сказали: «Эти два колдовства (Коран и Тора) поддерживают друг друга». Они также сказали: «Мы не веруем ни в одно из них».",["Когда же","пришла к ним","истина","от","Нас","сказали они","почему не","дано ему","подобное","тому, что","дано","Мусе","разве не","отвергли они","то, что","дано","Мусе","ещё","прежде","сказали они","два колдовства","поддерживающие друг друга","и сказали они","поистине, мы","в каждое","неверующие"]],[28,49,["قُلۡ","فَأۡتُواْ","بِكِتَٰبٖ","مِّنۡ","عِندِ","ٱللَّهِ","هُوَ","أَهۡدَىٰ","مِنۡهُمَآ","أَتَّبِعۡهُ","إِن","كُنتُمۡ","صَٰدِقِينَ"],"ḳул фа'туу бикитабим мин `индиллахи хуа ахда минхума аттаби`ху ин кунтум садиḳиин","Скажи: «Если вы говорите правду, то принесите Писание от Аллаха, которое было бы более верным руководством, чем эти два Писания, и я последую за ним».",["Скажи","так принесите","Писание","со","стороны","Аллаха","которое","вернее ведёт","чем они оба","последую я за ним","если","являетесь вы","правдивыми"]],[28,50,["فَإِن","لَّمۡ","يَسۡتَجِيبُواْ","لَكَ","فَٱعۡلَمۡ","أَنَّمَا","يَتَّبِعُونَ","أَهۡوَآءَهُمۡۚ","وَمَنۡ","أَضَلُّ","مِمَّنِ","ٱتَّبَعَ","هَوَىٰهُ","بِغَيۡرِ","هُدٗى","مِّنَ","ٱللَّهِۚ","إِنَّ","ٱللَّهَ","لَا","يَهۡدِي","ٱلۡقَوۡمَ","ٱلظَّٰلِمِينَ"],"фа'ил лам йастажиибуу лака фа`лам аннама йаттаби`ууна ахваахум ваман адаллу мимманиттаба`а хаваху бигайри худам миналлахи инналлаха ла йахдил ḳаумаз залимиин","Если они не ответят тебе, то знай, что они лишь потакают своим желаниям. А кто может быть более заблудшим, чем тот, кто потакает своим желаниям без верного руководства от Аллаха? Воистину, Аллах не ведет прямым путем несправедливых людей.",["А если","не","ответят они","тебе","то знай","что лишь","следуют они","своим страстям","и кто","более заблудший","чем тот, кто","последовал","своей страсти","без","руководства","от","Аллаха","поистине","Аллах","не","ведёт прямым путём","людей","беззаконных"]]],"m":[[["وَمَا","И не",28,44],["كُنتَ","был ты",28,44],["بِجَانِبِ","на склоне",28,44],["ٱلۡغَرۡبِيِّ","западном",28,44],["إِذۡ","когда",28,44],["قَضَيۡنَآ","возложили Мы",28,44],["إِلَىٰ","на",28,44],["مُوسَى","Мусу",28,44],["ٱلۡأَمۡرَ","повеление",28,44],["وَمَا","и не",28,44],["كُنتَ","был ты",28,44]],[["مِنَ","из",28,44],["ٱلشَّٰهِدِينَ","свидетелей",28,44],[44],["وَلَٰكِنَّآ","Но Мы",28,45],["أَنشَأۡنَا","сотворили",28,45],["قُرُونٗا","поколения",28,45],["فَتَطَاوَلَ","и продлился",28,45],["عَلَيۡهِمُ","для них",28,45]],[["ٱلۡعُمُرُۚ","срок жизни",28,45],["وَمَا","и не",28,45],["كُنتَ","был ты",28,45],["ثَاوِيٗا","проживающим",28,45],["فِيٓ","среди",28,45],["أَهۡلِ","жителей",28,45],["مَدۡيَنَ","Мадьяна",28,45],["تَتۡلُواْ","читая",28,45],["عَلَيۡهِمۡ","им",28,45]],[["ءَايَٰتِنَا","Наши аяты",28,45],["وَلَٰكِنَّا","но Мы",28,45],["كُنَّا","были",28,45],["مُرۡسِلِينَ","посылающими",28,45],[45],["وَمَا","И не",28,46],["كُنتَ","был ты",28,46],["بِجَانِبِ","у склона",28,46]],[["ٱلطُّورِ","Тура",28,46],["إِذۡ","когда",28,46],["نَادَيۡنَا","воззвали Мы",28,46],["وَلَٰكِن","но",28,46],["رَّحۡمَةٗ","по милости",28,46],["مِّن","от",28,46],["رَّبِّكَ","твоего Господа",28,46],["لِتُنذِرَ","чтобы ты предостерёг",28,46],["قَوۡمٗا","народ",28,46]],[["مَّآ","не",28,46],["أَتَىٰهُم","приходил к ним",28,46],["مِّن","какой-либо",28,46],["نَّذِيرٖ","предостерегающий",28,46],["مِّن","до",28,46],["قَبۡلِكَ","тебя",28,46],["لَعَلَّهُمۡ","чтобы они",28,46],["يَتَذَكَّرُونَ","помянули назидание",28,46],[46]],[["وَلَوۡلَآ","И если бы не",28,47],["أَن","то, что",28,47],["تُصِيبَهُم","постигнет их",28,47],["مُّصِيبَةُۢ","беда",28,47],["بِمَا","за то, что",28,47],["قَدَّمَتۡ","уготовили",28,47],["أَيۡدِيهِمۡ","их руки",28,47],["فَيَقُولُواْ","и сказали бы они",28,47]],[["رَبَّنَا","Господь наш",28,47],["لَوۡلَآ","почему не",28,47],["أَرۡسَلۡتَ","послал Ты",28,47],["إِلَيۡنَا","к нам",28,47],["رَسُولٗا","посланника",28,47],["فَنَتَّبِعَ","и последовали бы мы",28,47],["ءَايَٰتِكَ","Твоим знамениям",28,47],["وَنَكُونَ","и были бы мы",28,47]],[["مِنَ","из",28,47],["ٱلۡمُؤۡمِنِينَ","верующих",28,47],[47],["فَلَمَّا","Когда же",28,48],["جَآءَهُمُ","пришла к ним",28,48],["ٱلۡحَقُّ","истина",28,48],["مِنۡ","от",28,48],["عِندِنَا","Нас",28,48],["قَالُواْ","сказали они",28,48]],[["لَوۡلَآ","почему не",28,48],["أُوتِيَ","дано ему",28,48],["مِثۡلَ","подобное",28,48],["مَآ","тому, что",28,48],["أُوتِيَ","дано",28,48],["مُوسَىٰٓۚ","Мусе",28,48],["أَوَلَمۡ","разве не",28,48],["يَكۡفُرُواْ","отвергли они",28,48],["بِمَآ","то, что",28,48],["أُوتِيَ","дано",28,48]],[["مُوسَىٰ","Мусе",28,48],["مِن","ещё",28,48],["قَبۡلُۖ","прежде",28,48],["قَالُواْ","сказали они",28,48],["سِحۡرَانِ","два колдовства",28,48],["تَظَٰهَرَا","поддерживающие друг друга",28,48],["وَقَالُوٓاْ","и сказали они",28,48],["إِنَّا","поистине, мы",28,48],["بِكُلّٖ","в каждое",28,48],["كَٰفِرُونَ","неверующие",28,48]],[[48],["قُلۡ","Скажи",28,49],["فَأۡتُواْ","так принесите",28,49],["بِكِتَٰبٖ","Писание",28,49],["مِّنۡ","со",28,49],["عِندِ","стороны",28,49],["ٱللَّهِ","Аллаха",28,49],["هُوَ","которое",28,49],["أَهۡدَىٰ","вернее ведёт",28,49],["مِنۡهُمَآ","чем они оба",28,49],["أَتَّبِعۡهُ","последую я за ним",28,49]],[["إِن","если",28,49],["كُنتُمۡ","являетесь вы",28,49],["صَٰدِقِينَ","правдивыми",28,49],[49],["فَإِن","А если",28,50],["لَّمۡ","не",28,50],["يَسۡتَجِيبُواْ","ответят они",28,50],["لَكَ","тебе",28,50],["فَٱعۡلَمۡ","то знай",28,50]],[["أَنَّمَا","что лишь",28,50],["يَتَّبِعُونَ","следуют они",28,50],["أَهۡوَآءَهُمۡۚ","своим страстям",28,50],["وَمَنۡ","и кто",28,50],["أَضَلُّ","более заблудший",28,50],["مِمَّنِ","чем тот, кто",28,50],["ٱتَّبَعَ","последовал",28,50],["هَوَىٰهُ","своей страсти",28,50],["بِغَيۡرِ","без",28,50]],[["هُدٗى","руководства",28,50],["مِّنَ","от",28,50],["ٱللَّهِۚ","Аллаха",28,50],["إِنَّ","поистине",28,50],["ٱللَّهَ","Аллах",28,50],["لَا","не",28,50],["يَهۡدِي","ведёт прямым путём",28,50],["ٱلۡقَوۡمَ","людей",28,50],["ٱلظَّٰلِمِينَ","беззаконных",28,50],[50]]]}