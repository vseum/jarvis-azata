{"p":392,"j":20,"a":[[28,51,["وَلَقَدۡ","وَصَّلۡنَا","لَهُمُ","ٱلۡقَوۡلَ","لَعَلَّهُمۡ","يَتَذَكَّرُونَ"],"валаḳад вассална лахумул ḳаула ла`аллахум йатазаккаруун","Мы довели до них Слово, чтобы они могли помянуть назидание.",["и уже","довели Мы","до них","Слово","чтобы они","помянули назидание"]],[28,52,["ٱلَّذِينَ","ءَاتَيۡنَٰهُمُ","ٱلۡكِتَٰبَ","مِن","قَبۡلِهِۦ","هُم","بِهِۦ","يُؤۡمِنُونَ"],"аллазиина атайнахумул китаба мин ḳаблихии хум бихии йу'минуун","Те, кому Мы прежде даровали Писание, уверовали в него (Коран).",["Те, кому","даровали Мы (им)","Писание","до","него","они","в него","веруют"]],[28,53,["وَإِذَا","يُتۡلَىٰ","عَلَيۡهِمۡ","قَالُوٓاْ","ءَامَنَّا","بِهِۦٓ","إِنَّهُ","ٱلۡحَقُّ","مِن","رَّبِّنَآ","إِنَّا","كُنَّا","مِن","قَبۡلِهِۦ","مُسۡلِمِينَ"],"ва'иза йутла `алайхим ḳалуу аманна бихии иннахул хаḳḳу мир раббина инна кунна мин ḳаблихии муслимиин","Когда им читают его, они говорят: «Мы уверовали в него! Это - истина от нашего Господа. Мы и прежде были мусульманами».",["И когда","читается","им","говорят они","уверовали мы","в него","поистине, он","истина","от","нашего Господа","поистине, мы","были","до","него","мусульманами"]],[28,54,["أُوْلَٰٓئِكَ","يُؤۡتَوۡنَ","أَجۡرَهُم","مَّرَّتَيۡنِ","بِمَا","صَبَرُواْ","وَيَدۡرَءُونَ","بِٱلۡحَسَنَةِ","ٱلسَّيِّئَةَ","وَمِمَّا","رَزَقۡنَٰهُمۡ","يُنفِقُونَ"],"улаика йу'тауна ажрахум марратайни бима сабаруу вайадраууна билхасанатис саййиата вамимма разаḳнахум йунфиḳуун","Они получат свою награду в двойном размере за то, что были терпеливы. Они отвращают зло добром и расходуют из того, чем Мы наделили их.",["Те","будет дана","их награда","дважды","за то, что","терпели они","и отвращают они","добром","зло","и из того, что","наделили Мы их","расходуют они"]],[28,55,["وَإِذَا","سَمِعُواْ","ٱللَّغۡوَ","أَعۡرَضُواْ","عَنۡهُ","وَقَالُواْ","لَنَآ","أَعۡمَٰلُنَا","وَلَكُمۡ","أَعۡمَٰلُكُمۡ","سَلَٰمٌ","عَلَيۡكُمۡ","لَا","نَبۡتَغِي","ٱلۡجَٰهِلِينَ"],"ва'иза сами`ул лагва а`радуу `анху ваḳалуу лана а`малуна валакум а`малукум саламун `алайкум ла набтагил жахилиин","А услышав праздные речи, они отворачиваются от них и говорят: «Нам достанутся наши деяния, а вам - ваши. Мир вам! Мы не желаем следовать путем невежд».",["И когда","услышат они","пустословие","отворачиваются они","от него","и говорят","нам","наши деяния","и вам","ваши деяния","мир","вам","не","ищем мы","невежд"]],[28,56,["إِنَّكَ","لَا","تَهۡدِي","مَنۡ","أَحۡبَبۡتَ","وَلَٰكِنَّ","ٱللَّهَ","يَهۡدِي","مَن","يَشَآءُۚ","وَهُوَ","أَعۡلَمُ","بِٱلۡمُهۡتَدِينَ"],"иннака ла тахдии ман ахбабта валакинналлаха йахдии ман йашау вахуа а`ламу билмухтадиин","Воистину, ты не сможешь наставить на прямой путь тех, кого возлюбил. Только Аллах наставляет на прямой путь тех, кого пожелает. Он лучше знает тех, кто следует прямым путем.",["Поистине, ты","не","наставишь","того, кого","полюбил ты","но","Аллах","наставляет","того, кого","пожелает Он","и Он","лучше знает","следующих прямым путём"]],[28,57,["وَقَالُوٓاْ","إِن","نَّتَّبِعِ","ٱلۡهُدَىٰ","مَعَكَ","نُتَخَطَّفۡ","مِنۡ","أَرۡضِنَآۚ","أَوَلَمۡ","نُمَكِّن","لَّهُمۡ","حَرَمًا","ءَامِنٗا","يُجۡبَىٰٓ","إِلَيۡهِ","ثَمَرَٰتُ","كُلِّ","شَيۡءٖ","رِّزۡقٗا","مِّن","لَّدُنَّا","وَلَٰكِنَّ","أَكۡثَرَهُمۡ","لَا","يَعۡلَمُونَ"],"ваḳалуу ин наттаби`ил худа ма`ака нутахаттаф мин ардина авалам нумаккил лахум хараман аминан йужба илайхи самарату кулли шай'ир ризḳам мил ладунна валакинна аксарахум ла йа`ламуун","Они (неверующие мекканцы) сказали: «Если мы последуем за верным руководством вместе с тобой, то мы будем выброшены из нашей земли». Разве Мы не закрепили за ними безопасного святилища, в которое привозят плоды любых видов в качестве пропитания от Нас? Однако большинство их не ведает этого.",["И сказали они","если","последуем мы","руководству","с тобой","будем мы изгнаны","из","нашей земли","разве не","утвердили Мы","для них","святилище","безопасное","свозятся","к нему","плоды","всякой","вещи","пропитанием","от","Нас","но","большинство их","не","знают"]],[28,58,["وَكَمۡ","أَهۡلَكۡنَا","مِن","قَرۡيَةِۭ","بَطِرَتۡ","مَعِيشَتَهَاۖ","فَتِلۡكَ","مَسَٰكِنُهُمۡ","لَمۡ","تُسۡكَن","مِّنۢ","بَعۡدِهِمۡ","إِلَّا","قَلِيلٗاۖ","وَكُنَّا","نَحۡنُ","ٱلۡوَٰرِثِينَ"],"вакам ахлакна мин ḳарйати батират ма`иишатаха фатилка масакинухум лам тускам мим ба`дихим илла ḳалиилан вакунна нахнул варисиин","Сколько селений, которых обуяла гордыня из-за дарованных им средств, Мы погубили! Вот их жилища, в которых никто не проживает после них, за исключением немногих. Мы унаследовали все это.",["И сколько","погубили Мы","из","селений","возгордившихся","своим достатком","и вот","их жилища","не","заселялись","после","них","кроме","немногих","и были Мы","Мы","наследниками"]],[28,59,["وَمَا","كَانَ","رَبُّكَ","مُهۡلِكَ","ٱلۡقُرَىٰ","حَتَّىٰ","يَبۡعَثَ","فِيٓ","أُمِّهَا","رَسُولٗا","يَتۡلُواْ","عَلَيۡهِمۡ","ءَايَٰتِنَاۚ","وَمَا","كُنَّا","مُهۡلِكِي","ٱلۡقُرَىٰٓ","إِلَّا","وَأَهۡلُهَا","ظَٰلِمُونَ"],"вама кана раббука мухликал ḳура хатта йаб`аса фии уммиха расуулан йатлуу `алайхим айатина вама кунна мухликил ḳура илла ва'ахлуха залимуун","Твой Господь не уничтожал селения, пока не отправлял в важнейшее из них посланника, который читал им Наши аяты. Мы не уничтожали селения, если только их жители не были беззаконниками.",["И не","был","твой Господь","губящим","селения","пока не","отправит","в","главное из них","посланника","читающего","им","Наши аяты","и не","были Мы","губящими","селения","кроме как","когда их жители","беззаконники"]]],"m":[[["۞ وَلَقَدۡ","и уже",28,51],["وَصَّلۡنَا","довели Мы",28,51],["لَهُمُ","до них",28,51],["ٱلۡقَوۡلَ","Слово",28,51],["لَعَلَّهُمۡ","чтобы они",28,51],["يَتَذَكَّرُونَ","помянули назидание",28,51],[51],["ٱلَّذِينَ","Те, кому",28,52]],[["ءَاتَيۡنَٰهُمُ","даровали Мы (им)",28,52],["ٱلۡكِتَٰبَ","Писание",28,52],["مِن","до",28,52],["قَبۡلِهِۦ","него",28,52],["هُم","они",28,52],["بِهِۦ","в него",28,52],["يُؤۡمِنُونَ","веруют",28,52],[52],["وَإِذَا","И когда",28,53],["يُتۡلَىٰ","читается",28,53],["عَلَيۡهِمۡ","им",28,53]],[["قَالُوٓاْ","говорят они",28,53],["ءَامَنَّا","уверовали мы",28,53],["بِهِۦٓ","в него",28,53],["إِنَّهُ","поистине, он",28,53],["ٱلۡحَقُّ","истина",28,53],["مِن","от",28,53],["رَّبِّنَآ","нашего Господа",28,53],["إِنَّا","поистине, мы",28,53],["كُنَّا","были",28,53],["مِن","до",28,53],["قَبۡلِهِۦ","него",28,53],["مُسۡلِمِينَ","мусульманами",28,53],[53]],[["أُوْلَٰٓئِكَ","Те",28,54],["يُؤۡتَوۡنَ","будет дана",28,54],["أَجۡرَهُم","их награда",28,54],["مَّرَّتَيۡنِ","дважды",28,54],["بِمَا","за то, что",28,54],["صَبَرُواْ","терпели они",28,54],["وَيَدۡرَءُونَ","и отвращают они",28,54],["بِٱلۡحَسَنَةِ","добром",28,54]],[["ٱلسَّيِّئَةَ","зло",28,54],["وَمِمَّا","и из того, что",28,54],["رَزَقۡنَٰهُمۡ","наделили Мы их",28,54],["يُنفِقُونَ","расходуют они",28,54],[54],["وَإِذَا","И когда",28,55],["سَمِعُواْ","услышат они",28,55],["ٱللَّغۡوَ","пустословие",28,55]],[["أَعۡرَضُواْ","отворачиваются они",28,55],["عَنۡهُ","от него",28,55],["وَقَالُواْ","и говорят",28,55],["لَنَآ","нам",28,55],["أَعۡمَٰلُنَا","наши деяния",28,55],["وَلَكُمۡ","и вам",28,55],["أَعۡمَٰلُكُمۡ","ваши деяния",28,55],["سَلَٰمٌ","мир",28,55],["عَلَيۡكُمۡ","вам",28,55]],[["لَا","не",28,55],["نَبۡتَغِي","ищем мы",28,55],["ٱلۡجَٰهِلِينَ","невежд",28,55],[55],["إِنَّكَ","Поистине, ты",28,56],["لَا","не",28,56],["تَهۡدِي","наставишь",28,56],["مَنۡ","того, кого",28,56],["أَحۡبَبۡتَ","полюбил ты",28,56],["وَلَٰكِنَّ","но",28,56]],[["ٱللَّهَ","Аллах",28,56],["يَهۡدِي","наставляет",28,56],["مَن","того, кого",28,56],["يَشَآءُۚ","пожелает Он",28,56],["وَهُوَ","и Он",28,56],["أَعۡلَمُ","лучше знает",28,56],["بِٱلۡمُهۡتَدِينَ","следующих прямым путём",28,56],[56],["وَقَالُوٓاْ","И сказали они",28,57],["إِن","если",28,57]],[["نَّتَّبِعِ","последуем мы",28,57],["ٱلۡهُدَىٰ","руководству",28,57],["مَعَكَ","с тобой",28,57],["نُتَخَطَّفۡ","будем мы изгнаны",28,57],["مِنۡ","из",28,57],["أَرۡضِنَآۚ","нашей земли",28,57],["أَوَلَمۡ","разве не",28,57],["نُمَكِّن","утвердили Мы",28,57],["لَّهُمۡ","для них",28,57]],[["حَرَمًا","святилище",28,57],["ءَامِنٗا","безопасное",28,57],["يُجۡبَىٰٓ","свозятся",28,57],["إِلَيۡهِ","к нему",28,57],["ثَمَرَٰتُ","плоды",28,57],["كُلِّ","всякой",28,57],["شَيۡءٖ","вещи",28,57],["رِّزۡقٗا","пропитанием",28,57],["مِّن","от",28,57],["لَّدُنَّا","Нас",28,57],["وَلَٰكِنَّ","но",28,57]],[["أَكۡثَرَهُمۡ","большинство их",28,57],["لَا","не",28,57],["يَعۡلَمُونَ","знают",28,57],[57],["وَكَمۡ","И сколько",28,58],["أَهۡلَكۡنَا","погубили Мы",28,58],["مِن","из",28,58],["قَرۡيَةِۭ","селений",28,58]],[["بَطِرَتۡ","возгордившихся",28,58],["مَعِيشَتَهَاۖ","своим достатком",28,58],["فَتِلۡكَ","и вот",28,58],["مَسَٰكِنُهُمۡ","их жилища",28,58],["لَمۡ","не",28,58],["تُسۡكَن","заселялись",28,58],["مِّنۢ","после",28,58],["بَعۡدِهِمۡ","них",28,58]],[["إِلَّا","кроме",28,58],["قَلِيلٗاۖ","немногих",28,58],["وَكُنَّا","и были Мы",28,58],["نَحۡنُ","Мы",28,58],["ٱلۡوَٰرِثِينَ","наследниками",28,58],[58],["وَمَا","И не",28,59],["كَانَ","был",28,59],["رَبُّكَ","твой Господь",28,59],["مُهۡلِكَ","губящим",28,59]],[["ٱلۡقُرَىٰ","селения",28,59],["حَتَّىٰ","пока не",28,59],["يَبۡعَثَ","отправит",28,59],["فِيٓ","в",28,59],["أُمِّهَا","главное из них",28,59],["رَسُولٗا","посланника",28,59],["يَتۡلُواْ","читающего",28,59],["عَلَيۡهِمۡ","им",28,59],["ءَايَٰتِنَاۚ","Наши аяты",28,59],["وَمَا","и не",28,59]],[["كُنَّا","были Мы",28,59],["مُهۡلِكِي","губящими",28,59],["ٱلۡقُرَىٰٓ","селения",28,59],["إِلَّا","кроме как",28,59],["وَأَهۡلُهَا","когда их жители",28,59],["ظَٰلِمُونَ","беззаконники",28,59],[59]]]}