{"p":393,"j":20,"a":[[28,60,["وَمَآ","أُوتِيتُم","مِّن","شَيۡءٖ","فَمَتَٰعُ","ٱلۡحَيَوٰةِ","ٱلدُّنۡيَا","وَزِينَتُهَاۚ","وَمَا","عِندَ","ٱللَّهِ","خَيۡرٞ","وَأَبۡقَىٰٓۚ","أَفَلَا","تَعۡقِلُونَ"],"вама уутиитум мин шай'ин фамата`ул хайаватид дунйа вазиинатуха вама `индаллахи хайрун ва'абḳа афала та`ḳилуун","Все, что вам даровано, является всего лишь преходящим благом мирской жизни и ее украшением, а у Аллаха - нечто более прекрасное и долговечное. Неужели вы не разумеете?",["И всё, что","дано вам","из","вещей","то пользование","жизни","мирской","и её украшение","а то, что","у","Аллаха","лучше","и долговечнее","неужели не","разумеете вы"]],[28,61,["أَفَمَن","وَعَدۡنَٰهُ","وَعۡدًا","حَسَنٗا","فَهُوَ","لَٰقِيهِ","كَمَن","مَّتَّعۡنَٰهُ","مَتَٰعَ","ٱلۡحَيَوٰةِ","ٱلدُّنۡيَا","ثُمَّ","هُوَ","يَوۡمَ","ٱلۡقِيَٰمَةِ","مِنَ","ٱلۡمُحۡضَرِينَ"],"афаман ва`аднаху ва`дан хасанан фахуа лаḳиихи камам матта`наху мата`ал хайаватид дунйа сумма хуа йаумал ḳийамати минал мухдариин","Неужели тот, кому Мы дали прекрасное обещание, с которым он непременно встретится, равен тому, кого Мы наделили преходящими благами мирской жизни и кто в День воскресения предстанет в числе обитателей Ада?",["Разве тот, кому","обещали Мы","обещание","прекрасное","и он","встретит его","подобен тому, кого","наделили Мы","благами","жизни","мирской","затем","он","в День","воскресения","из","приведённых"]],[28,62,["وَيَوۡمَ","يُنَادِيهِمۡ","فَيَقُولُ","أَيۡنَ","شُرَكَآءِيَ","ٱلَّذِينَ","كُنتُمۡ","تَزۡعُمُونَ"],"вайаума йунадиихим файаḳуулу айна шуракаийал лазиина кунтум таз`умуун","В тот день Он воззовет к ним и скажет: «Где же Мои сотоварищи, о существовании которых вы предполагали?».",["И в день","воззовёт Он к ним","и скажет","где","Мои сотоварищи","которых","вы","утверждали"]],[28,63,["قَالَ","ٱلَّذِينَ","حَقَّ","عَلَيۡهِمُ","ٱلۡقَوۡلُ","رَبَّنَا","هَٰٓؤُلَآءِ","ٱلَّذِينَ","أَغۡوَيۡنَآ","أَغۡوَيۡنَٰهُمۡ","كَمَا","غَوَيۡنَاۖ","تَبَرَّأۡنَآ","إِلَيۡكَۖ","مَا","كَانُوٓاْ","إِيَّانَا","يَعۡبُدُونَ"],"ḳалал лазиина хаḳḳа `алайхимул ḳаулу раббана ха'улаил лазиина агвайна агвайнахум кама гавайна табарра'на илайка ма кануу иййана йа`будуун","Тогда те, относительно которых подтвердилось Слово, скажут: «Господь наш! Вот те, которых мы ввели в заблуждение. Мы ввели их в заблуждение, потому что сами были заблудшими. Мы отрекаемся от них перед Тобой. Не нам они поклонялись».",["Скажут","те, о которых","подтвердилось","в отношении них","Слово","Господь наш","эти","те, которых","совратили мы","совратили мы их","как","заблудились мы","отрекаемся мы","пред Тобой","не","были они","нам","поклоняющимися"]],[28,64,["وَقِيلَ","ٱدۡعُواْ","شُرَكَآءَكُمۡ","فَدَعَوۡهُمۡ","فَلَمۡ","يَسۡتَجِيبُواْ","لَهُمۡ","وَرَأَوُاْ","ٱلۡعَذَابَۚ","لَوۡ","أَنَّهُمۡ","كَانُواْ","يَهۡتَدُونَ"],"ваḳиилад`уу шуракаакум фада`аухум фалам йастажиибуу лахум вараавул `азаба лау аннахум кануу йахтадуун","Им скажут: «Призовите своих сотоварищей!». Они призовут их, но те не ответят им, и тогда они увидят наказание. О, если бы они следовали прямым путем!",["И будет сказано","позовите","ваших сотоварищей","и позовут они их","но не","ответят они","им","и увидят они","наказание","если бы","они","были","следующими прямым путём"]],[28,65,["وَيَوۡمَ","يُنَادِيهِمۡ","فَيَقُولُ","مَاذَآ","أَجَبۡتُمُ","ٱلۡمُرۡسَلِينَ"],"вайаума йунадиихим файаḳуулу маза ажабтумул мурсалиин","В тот день Он воззовет к ним и скажет: «Что вы ответили посланникам?».",["и в день","воззовет Он к ним","и скажет","что","ответили вы","посланникам"]],[28,66,["فَعَمِيَتۡ","عَلَيۡهِمُ","ٱلۡأَنۢبَآءُ","يَوۡمَئِذٖ","فَهُمۡ","لَا","يَتَسَآءَلُونَ"],"фа`амийат `алайхимул амбау йаумаизин фахум ла йатасаалуун","В тот день известия будут сокрыты от них, и они не будут расспрашивать друг друга.",["И сокрыты будут","для них","вести","в тот день","и они","не","будут расспрашивать друг друга"]],[28,67,["فَأَمَّا","مَن","تَابَ","وَءَامَنَ","وَعَمِلَ","صَٰلِحٗا","فَعَسَىٰٓ","أَن","يَكُونَ","مِنَ","ٱلۡمُفۡلِحِينَ"],"фа'амма ман таба ва'амана ва`амила салихан фа`аса ан йакууна минал муфлихиин","А тот, кто раскаялся, уверовал и поступал праведно, возможно, окажется в числе преуспевших.",["А что до","того, кто","покаялся","и уверовал","и совершал","праведное","то, возможно","что","окажется он","из","преуспевших"]],[28,68,["وَرَبُّكَ","يَخۡلُقُ","مَا","يَشَآءُ","وَيَخۡتَارُۗ","مَا","كَانَ","لَهُمُ","ٱلۡخِيَرَةُۚ","سُبۡحَٰنَ","ٱللَّهِ","وَتَعَٰلَىٰ","عَمَّا","يُشۡرِكُونَ"],"вараббука йахлуḳу ма йашау вайахтару ма кана лахумул хийарату субханаллахи вата`ала `амма йушрикуун","Твой Господь создает, что пожелает, и избирает, но у них нет выбора. Аллах пречист и превыше тех, кого они приобщают в сотоварищи!",["И твой Господь","творит","что","пожелает Он","и избирает","не","было","у них","выбора","пречист","Аллах","и превыше Он","того, что","приобщают они"]],[28,69,["وَرَبُّكَ","يَعۡلَمُ","مَا","تُكِنُّ","صُدُورُهُمۡ","وَمَا","يُعۡلِنُونَ"],"вараббука йа`ламу ма тукинну судуурухум вама йу`линуун","Твой Господь знает то, что кроется в их груди, и то, что они обнаруживают.",["И твой Господь","знает","что","скрывают","их груди","и что","обнаруживают они"]],[28,70,["وَهُوَ","ٱللَّهُ","لَآ","إِلَٰهَ","إِلَّا","هُوَۖ","لَهُ","ٱلۡحَمۡدُ","فِي","ٱلۡأُولَىٰ","وَٱلۡأٓخِرَةِۖ","وَلَهُ","ٱلۡحُكۡمُ","وَإِلَيۡهِ","تُرۡجَعُونَ"],"вахуаллаху ла илаха илла хуа лахул хамду фил уула вал'ахирати валахул хукму ва'илайхи туржа`уун","Он - Аллах, кроме Которого нет иного божества. Ему надлежит хвала в первой жизни и в Последней жизни. Он принимает решения, и к Нему вы будете возвращены.",["И Он","Аллах","нет","божества","кроме","Него","Ему","хвала","в","первой (жизни)","и в Последней","и Ему","решение","и к Нему","будете возвращены вы"]]],"m":[[["وَمَآ","И всё, что",28,60],["أُوتِيتُم","дано вам",28,60],["مِّن","из",28,60],["شَيۡءٖ","вещей",28,60],["فَمَتَٰعُ","то пользование",28,60],["ٱلۡحَيَوٰةِ","жизни",28,60],["ٱلدُّنۡيَا","мирской",28,60],["وَزِينَتُهَاۚ","и её украшение",28,60],["وَمَا","а то, что",28,60],["عِندَ","у",28,60]],[["ٱللَّهِ","Аллаха",28,60],[