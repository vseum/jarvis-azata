{"p":394,"j":20,"a":[[28,71,["قُلۡ","أَرَءَيۡتُمۡ","إِن","جَعَلَ","ٱللَّهُ","عَلَيۡكُمُ","ٱلَّيۡلَ","سَرۡمَدًا","إِلَىٰ","يَوۡمِ","ٱلۡقِيَٰمَةِ","مَنۡ","إِلَٰهٌ","غَيۡرُ","ٱللَّهِ","يَأۡتِيكُم","بِضِيَآءٍۚ","أَفَلَا","تَسۡمَعُونَ"],"ḳул араайтум ин жа`алаллаху `алайкумул лайла сармадан ила йаумил ḳийамати ман илахун гайруллахи йа'тиикум бидийаин афала тасма`уун","Скажи: «Как вы думаете, какой бог, кроме Аллаха, сможет принести вам свет, если Аллах продлит вам ночь до Дня воскресения? Неужели вы не слышите?».",["Скажи","как вы думаете","если","сделает","Аллах","над вами","ночь","вечной","до","Дня","воскресения","какой","бог","кроме","Аллаха","принесёт вам","свет","неужели не","слышите вы"]],[28,72,["قُلۡ","أَرَءَيۡتُمۡ","إِن","جَعَلَ","ٱللَّهُ","عَلَيۡكُمُ","ٱلنَّهَارَ","سَرۡمَدًا","إِلَىٰ","يَوۡمِ","ٱلۡقِيَٰمَةِ","مَنۡ","إِلَٰهٌ","غَيۡرُ","ٱللَّهِ","يَأۡتِيكُم","بِلَيۡلٖ","تَسۡكُنُونَ","فِيهِۚ","أَفَلَا","تُبۡصِرُونَ"],"ḳул араайтум ин жа`алаллаху `алайкумун нахара сармадан ила йаумил ḳийамати ман илахун гайруллахи йа'тиикум билайлин таскунууна фиихи афала тубсируун","Скажи: «Как вы думаете, какой бог, кроме Аллаха, сможет принести вам ночь, чтобы вы могли отдохнуть во время нее, если Аллах продлит вам день до Дня воскресения? Неужели вы не видите?».",["Скажи","как вы думаете","если","сделает","Аллах","над вами","день","вечным","до","Дня","воскресения","какой","бог","кроме","Аллаха","принесёт вам","ночь","отдыхаете вы","в ней","неужели не","видите вы"]],[28,73,["وَمِن","رَّحۡمَتِهِۦ","جَعَلَ","لَكُمُ","ٱلَّيۡلَ","وَٱلنَّهَارَ","لِتَسۡكُنُواْ","فِيهِ","وَلِتَبۡتَغُواْ","مِن","فَضۡلِهِۦ","وَلَعَلَّكُمۡ","تَشۡكُرُونَ"],"вамир рахматихии жа`ала лакумул лайла ваннахара литаскунуу фиихи валитабтагуу мин фадлихии вала`аллакум ташкуруун","По милости Своей Он сотворил для вас ночь и день, чтобы вы отдыхали во время нее и искали Его милость, - быть может, вы будете благодарны.",["И по","Его милости","сделал Он","для вас","ночь","и день","чтобы вы отдыхали","в ней","и чтобы искали вы","из","Его щедрот","и, быть может, вы","будете благодарны"]],[28,74,["وَيَوۡمَ","يُنَادِيهِمۡ","فَيَقُولُ","أَيۡنَ","شُرَكَآءِيَ","ٱلَّذِينَ","كُنتُمۡ","تَزۡعُمُونَ"],"вайаума йунадиихим файаḳуулу айна шуракаийал лазиина кунтум таз`умуун","В тот день Он воззовет к ним и скажет: «Где же Мои сотоварищи, о существовании которых вы предполагали?».",["И в день","воззовёт Он к ним","и скажет","где","Мои сотоварищи","которых","вы","утверждали"]],[28,75,["وَنَزَعۡنَا","مِن","كُلِّ","أُمَّةٖ","شَهِيدٗا","فَقُلۡنَا","هَاتُواْ","بُرۡهَٰنَكُمۡ","فَعَلِمُوٓاْ","أَنَّ","ٱلۡحَقَّ","لِلَّهِ","وَضَلَّ","عَنۡهُم","مَّا","كَانُواْ","يَفۡتَرُونَ"],"ваназа`на мин кулли умматин шахиидан фаḳулна хатуу бурханакум фа`алимуу аннал хаḳḳа лиллахи вадалла `анхум ма кануу йафтаруун","Из каждой общины Мы выберем свидетеля и скажем: «Приведите ваше доказательство!». Тогда они узнают, что истина - с Аллахом. И покинет их (или исчезнет) то, что они измышляли.",["И извлечём Мы","из","каждой","общины","свидетеля","и скажем Мы","приведите","ваш довод","и узнают они","что","истина","у Аллаха","и исчезнет","от них","то, что","они","измышляли"]],[28,76,["إِنَّ","قَٰرُونَ","كَانَ","مِن","قَوۡمِ","مُوسَىٰ","فَبَغَىٰ","عَلَيۡهِمۡۖ","وَءَاتَيۡنَٰهُ","مِنَ","ٱلۡكُنُوزِ","مَآ","إِنَّ","مَفَاتِحَهُۥ","لَتَنُوٓأُ","بِٱلۡعُصۡبَةِ","أُوْلِي","ٱلۡقُوَّةِ","إِذۡ","قَالَ","لَهُۥ","قَوۡمُهُۥ","لَا","تَفۡرَحۡۖ","إِنَّ","ٱللَّهَ","لَا","يُحِبُّ","ٱلۡفَرِحِينَ"],"инна ḳарууна кана мин ḳауми мууса фабага `алайхим ва'атайнаху минал кунуузи ма инна мафатихахуу латану'уу бил`усбати улил ḳуввати из ḳала лахуу ḳаумухуу ла тафрах инналлаха ла йухиббул фарихиин","Воистину, Карун (Корей) был соплеменником Мусы, но притеснял их. Мы даровали ему столько сокровищ, что ключи от них были обременительны даже для нескольких силачей. Соплеменники сказали ему: «Не ликуй, ведь Аллах не любит тех, кто ликует.",["Поистине","Карун","был","из","народа","Мусы","но притеснял он","их","и даровали Мы ему","из","сокровищ","столько, что","поистине","ключи от них","непременно отягощали","группу","обладающих","силой","когда","сказал","ему","его народ","не","ликуй","поистине","Аллах","не","любит","ликующих"]],[28,77,["وَٱبۡتَغِ","فِيمَآ","ءَاتَىٰكَ","ٱللَّهُ","ٱلدَّارَ","ٱلۡأٓخِرَةَۖ","وَلَا","تَنسَ","نَصِيبَكَ","مِنَ","ٱلدُّنۡيَاۖ","وَأَحۡسِن","كَمَآ","أَحۡسَنَ","ٱللَّهُ","إِلَيۡكَۖ","وَلَا","تَبۡغِ","ٱلۡفَسَادَ","فِي","ٱلۡأَرۡضِۖ","إِنَّ","ٱللَّهَ","لَا","يُحِبُّ","ٱلۡمُفۡسِدِينَ"],"вабтаги фиима атакаллахуд дарал ахирата вала танса насиибака минад дунйа ва'ахсин кама ахсаналлаху илайка вала табгил фасада фил арди инналлаха ла йухиббул муфсидиин","А посредством того, что Аллах даровал тебе, стремись к Последней обители, но не забывай о своей доле в этом мире! Твори добро, подобно тому, как Аллах сотворил добро для тебя, и не стремись распространять нечестие на земле, ведь Аллах не любит распространяющих нечестие».",["и стремись","посредством того, что","даровал тебе","Аллах","к обители","Последней","и не","забывай","долю твою","из","мира (этого)","и твори добро","как","сотворил добро","Аллах","тебе","и не","стремись к","нечестию","на","земле","поистине","Аллах","не","любит","распространяющих нечестие"]]],"m":[[["قُلۡ","Скажи",28,71],["أَرَءَيۡتُمۡ","как вы думаете",28,71],["إِن","если",28,71],["جَعَلَ","сделает",28,71],["ٱللَّهُ","Аллах",28,71],["عَلَيۡكُمُ","над вами",28,71],["ٱلَّيۡلَ","ночь",28,71],["سَرۡمَدًا","вечной",28,71],["إِلَىٰ","до",28,71],["يَوۡمِ","Дня",28,71],["ٱلۡقِيَٰمَةِ","воскресения",28,71]],[["مَنۡ","какой",28,71],["إِلَٰهٌ","бог",28,71],["غَيۡرُ","кроме",28,71],["ٱللَّهِ","Аллаха",28,71],["يَأۡتِيكُم","принесёт вам",28,71],["بِضِيَآءٍۚ","свет",28,71],["أَفَلَا","неужели не",28,71],["تَسۡمَعُونَ","слышите вы",28,71],[71]],[["قُلۡ","Скажи",28,72],["أَرَءَيۡتُمۡ","как вы думаете",28,72],["إِن","если",28,72],["جَعَلَ","сделает",28,72],["ٱللَّهُ","Аллах",28,72],["عَلَيۡكُمُ","над вами",28,72],["ٱلنَّهَارَ","день",28,72],["سَرۡمَدًا","вечным",28,72],["إِلَىٰ","до",28,72]],[["يَوۡمِ","Дня",28,72],["ٱلۡقِيَٰمَةِ","воскресения",28,72],["مَنۡ","какой",28,72],["إِلَٰهٌ","бог",28,72],["غَيۡرُ","кроме",28,72],["ٱللَّهِ","Аллаха",28,72],["يَأۡتِيكُم","принесёт вам",28,72],["بِلَيۡلٖ","ночь",28,72],["تَسۡكُنُونَ","отдыхаете вы",28,72]],[["فِيهِۚ","в ней",28,72],["أَفَلَا","неужели не",28,72],["تُبۡصِرُونَ","видите вы",28,72],[72],["وَمِن","И по",28,73],["رَّحۡمَتِهِۦ","Его милости",28,73],["جَعَلَ","сделал Он",28,73],["لَكُمُ","для вас",28,73],["ٱلَّيۡلَ","ночь",28,73]],[["وَٱلنَّهَارَ","и день",28,73],["لِتَسۡكُنُواْ","чтобы вы отдыхали",28,73],["فِيهِ","в ней",28,73],["وَلِتَبۡتَغُواْ","и чтобы искали вы",28,73],["مِن","из",28,73],["فَضۡلِهِۦ","Его щедрот",28,73],["وَلَعَلَّكُمۡ","и, быть может, вы",28,73],["تَشۡكُرُونَ","будете благодарны",28,73]],[[73],["وَيَوۡمَ","И в день",28,74],["يُنَادِيهِمۡ","воззовёт Он к ним",28,74],["فَيَقُولُ","и скажет",28,74],["أَيۡنَ","где",28,74],["شُرَكَآءِيَ","Мои сотоварищи",28,74],["ٱلَّذِينَ","которых",28,74],["كُنتُمۡ","вы",28,74]],[["تَزۡعُمُونَ","утверждали",28,74],[74],["وَنَزَعۡنَا","И извлечём Мы",28,75],["مِن","из",28,75],["كُلِّ","каждой",28,75],["أُمَّةٖ","общины",28,75],["شَهِيدٗا","свидетеля",28,75],["فَقُلۡنَا","и скажем Мы",28,75]],[["هَاتُواْ","приведите",28,75],["بُرۡهَٰنَكُمۡ","ваш довод",28,75],["فَعَلِمُوٓاْ","и узнают они",28,75],["أَنَّ","что",28,75],["ٱلۡحَقَّ","истина",28,75],["لِلَّهِ","у Аллаха",28,75],["وَضَلَّ","и исчезнет",28,75],["عَنۡهُم","от них",28,75],["مَّا","то, что",28,75],["كَانُواْ","они",28,75]],[["يَفۡتَرُونَ","измышляли",28,75],[75],["۞ إِنَّ","Поистине",28,76],["قَٰرُونَ","Карун",28,76],["كَانَ","был",28,76],["مِن","из",28,76],["قَوۡمِ","народа",28,76],["مُوسَىٰ","Мусы",28,76],["فَبَغَىٰ","но притеснял он",28,76]],[["عَلَيۡهِمۡۖ","их",28,76],["وَءَاتَيۡنَٰهُ","и даровали Мы ему",28,76],["مِنَ","из",28,76],["ٱلۡكُنُوزِ","сокровищ",28,76],["مَآ","столько, что",28,76],["إِنَّ","поистине",28,76],["مَفَاتِحَهُۥ","ключи от них",28,76],["لَتَنُوٓأُ","непременно отягощали",28,76],["بِٱلۡعُصۡبَةِ","группу",28,76]],[["أُوْلِي","обладающих",28,76],["ٱلۡقُوَّةِ","силой",28,76],["إِذۡ","когда",28,76],["قَالَ","сказал",28,76],["لَهُۥ","ему",28,76],["قَوۡمُهُۥ","его народ",28,76],["لَا","не",28,76],["تَفۡرَحۡۖ","ликуй",28,76],["إِنَّ","поистине",28,76],["ٱللَّهَ","Аллах",28,76],["لَا","не",28,76],["يُحِبُّ","любит",28,76],["ٱلۡفَرِحِينَ","ликующих",28,76]],[[76],["وَٱبۡتَغِ","и стремись",28,77],["فِيمَآ","посредством того, что",28,77],["ءَاتَىٰكَ","даровал тебе",28,77],["ٱللَّهُ","Аллах",28,77],["ٱلدَّارَ","к обители",28,77],["ٱلۡأٓخِرَةَۖ","Последней",28,77],["وَلَا","и не",28,77],["تَنسَ","забывай",28,77]],[["نَصِيبَكَ","долю твою",28,77],["مِنَ","из",28,77],["ٱلدُّنۡيَاۖ","мира (этого)",28,77],["وَأَحۡسِن","и твори добро",28,77],["كَمَآ","как",28,77],["أَحۡسَنَ","сотворил добро",28,77],["ٱللَّهُ","Аллах",28,77],["إِلَيۡكَۖ","тебе",28,77]],[["وَلَا","и не",28,77],["تَبۡغِ","стремись к",28,77],["ٱلۡفَسَادَ","нечестию",28,77],["فِي","на",28,77],["ٱلۡأَرۡضِۖ","земле",28,77],["إِنَّ","поистине",28,77],["ٱللَّهَ","Аллах",28,77],["لَا","не",28,77],["يُحِبُّ","любит",28,77],["ٱلۡمُفۡسِدِينَ","распространяющих нечестие",28,77],[77]]]}