{"p":395,"j":20,"a":[[28,78,["قَالَ","إِنَّمَآ","أُوتِيتُهُۥ","عَلَىٰ","عِلۡمٍ","عِندِيٓۚ","أَوَلَمۡ","يَعۡلَمۡ","أَنَّ","ٱللَّهَ","قَدۡ","أَهۡلَكَ","مِن","قَبۡلِهِۦ","مِنَ","ٱلۡقُرُونِ","مَنۡ","هُوَ","أَشَدُّ","مِنۡهُ","قُوَّةٗ","وَأَكۡثَرُ","جَمۡعٗاۚ","وَلَا","يُسۡـَٔلُ","عَن","ذُنُوبِهِمُ","ٱلۡمُجۡرِمُونَ"],"ḳала иннама уутиитухуу `ала `илмин `индии авалам йа`лам анналлаха ḳад ахлака мин ḳаблихии минал ḳурууни ман хуа ашадду минху ḳувватан ва'аксару жам`ан вала йус'алу `ан зунуубихимул мужримуун","Он сказал: «Все это даровано мне благодаря знанию, которым я обладаю». Неужели он не знал, что до него Аллах погубил целые поколения, которые превосходили его мощью и накоплениями? Грешники не будут спрошены об их грехах.",["сказал он","лишь","дано мне это","по","знанию","у меня","разве не","знал он","что","Аллах","уже","погубил","до","него","из","поколений","тех, кто","он","сильнее","его","мощью","и больше","накоплениями","и не","будут спрошены","о","грехах их","грешники"]],[28,79,["فَخَرَجَ","عَلَىٰ","قَوۡمِهِۦ","فِي","زِينَتِهِۦۖ","قَالَ","ٱلَّذِينَ","يُرِيدُونَ","ٱلۡحَيَوٰةَ","ٱلدُّنۡيَا","يَٰلَيۡتَ","لَنَا","مِثۡلَ","مَآ","أُوتِيَ","قَٰرُونُ","إِنَّهُۥ","لَذُو","حَظٍّ","عَظِيمٖ"],"фахаража `ала ḳаумихии фии зиинатихии ḳалал лазиина йуриидуунал хайаватад дунйа йалайта лана мисла ма уутийа ḳарууну иннахуу лазуу хаззин `азиим","Он вышел к своему народу в своих украшениях. Те, которые желали мирской жизни, сказали: «Вот если бы у нас было то, что даровано Каруну (Корею)! Воистину, он обладает великой долей».",["и вышел он","к","народу своему","в","убранстве своём","сказали","те, которые","желают","жизни","мирской","о, если бы","у нас (было)","подобное","тому, что","дано","Каруну","поистине, он","непременно обладатель","доли","великой"]],[28,80,["وَقَالَ","ٱلَّذِينَ","أُوتُواْ","ٱلۡعِلۡمَ","وَيۡلَكُمۡ","ثَوَابُ","ٱللَّهِ","خَيۡرٞ","لِّمَنۡ","ءَامَنَ","وَعَمِلَ","صَٰلِحٗاۚ","وَلَا","يُلَقَّىٰهَآ","إِلَّا","ٱلصَّٰبِرُونَ"],"ваḳалал лазиина уутул `илма вайлакум савабуллахи хайрул лиман амана ва`амила салихан вала йулаḳḳаха иллас сабируун","А те, которым было даровано знание, сказали: «Горе вам! Вознаграждение Аллаха будет лучше для тех, которые уверовали и поступали праведно. Но не обретет этого никто, кроме терпеливых».",["и сказали","те, которым","было дано","знание","горе вам","награда","Аллаха","лучше","для того, кто","уверовал","и совершал","праведное","и не","даруется она","кроме","терпеливым"]],[28,81,["فَخَسَفۡنَا","بِهِۦ","وَبِدَارِهِ","ٱلۡأَرۡضَ","فَمَا","كَانَ","لَهُۥ","مِن","فِئَةٖ","يَنصُرُونَهُۥ","مِن","دُونِ","ٱللَّهِ","وَمَا","كَانَ","مِنَ","ٱلۡمُنتَصِرِينَ"],"фахасафна бихии вабидарихил арда фама кана лахуу мин фи'атин йансуруунахуу мин дууниллахи вама кана минал мунтасириин","Мы заставили землю поглотить его вместе с его домом. Не было у него сторонников, которые помогли бы ему вместо Аллаха, и сам он не мог помочь себе.",["и Мы заставили поглотить","его","и дом его","землю","и не","было","у него","никакой","группы","помогающих ему","из","помимо","Аллаха","и не","был он","из","защитивших себя"]],[28,82,["وَأَصۡبَحَ","ٱلَّذِينَ","تَمَنَّوۡاْ","مَكَانَهُۥ","بِٱلۡأَمۡسِ","يَقُولُونَ","وَيۡكَأَنَّ","ٱللَّهَ","يَبۡسُطُ","ٱلرِّزۡقَ","لِمَن","يَشَآءُ","مِنۡ","عِبَادِهِۦ","وَيَقۡدِرُۖ","لَوۡلَآ","أَن","مَّنَّ","ٱللَّهُ","عَلَيۡنَا","لَخَسَفَ","بِنَاۖ","وَيۡكَأَنَّهُۥ","لَا","يُفۡلِحُ","ٱلۡكَٰفِرُونَ"],"ва'асбахал лазиина таманнау маканахуу бил'амси йаḳуулууна вайкаанналлаха йабсутур ризḳа лиман йашау мин `ибадихии вайаḳдиру лаула ам манналлаху `алайна лахасафа бина вайкааннахуу ла йуфлихул кафируун","А те, которые накануне желали оказаться на его месте, наутро сказали: «Ох! Аллах увеличивает или ограничивает удел тому из Своих рабов, кому пожелает? Если бы Аллах не оказал нам милость, то Он заставил бы землю поглотить нас. Ох! Неверующие не преуспеют».",["и стали","те, которые","желали","места его","вчера","говорить","ох! ведь","Аллах","расширяет","удел","тому, кому","пожелает Он","из","рабов Своих","и ограничивает","если бы не","что","оказал милость","Аллах","нам","непременно Он заставил бы поглотить","нас","ох! ведь","не","преуспевают","неверующие"]],[28,83,["تِلۡكَ","ٱلدَّارُ","ٱلۡأٓخِرَةُ","نَجۡعَلُهَا","لِلَّذِينَ","لَا","يُرِيدُونَ","عُلُوّٗا","فِي","ٱلۡأَرۡضِ","وَلَا","فَسَادٗاۚ","وَٱلۡعَٰقِبَةُ","لِلۡمُتَّقِينَ"],"тилкад дарул ахирату наж`алуха лиллазиина ла йуриидууна `улувван фил арди вала фасадан вал`аḳибату лилмуттаḳиин","Ту Последнюю обитель Мы определили для тех, которые не желают превозноситься на земле и распространять нечестие. Добрый исход уготован только для богобоязненных.",["та","обитель","Последняя","Мы отводим её","для тех, которые","не","желают","превозношения","на","земле","и не","нечестия","и исход (добрый)","для богобоязненных"]],[28,84,["مَن","جَآءَ","بِٱلۡحَسَنَةِ","فَلَهُۥ","خَيۡرٞ","مِّنۡهَاۖ","وَمَن","جَآءَ","بِٱلسَّيِّئَةِ","فَلَا","يُجۡزَى","ٱلَّذِينَ","عَمِلُواْ","ٱلسَّيِّـَٔاتِ","إِلَّا","مَا","كَانُواْ","يَعۡمَلُونَ"],"ман жаа билхасанати фалахуу хайрум минха ваман жаа биссаййиати фала йужзал лазиина `амилус саййиати илла ма кануу йа`малуун","Тот, который предстанет с добрым деянием, получит нечто лучшее. А если кто предстанет со злым деянием, то ведь творящие зло получат воздаяние только за то, что они совершали.",["кто","придёт","с добрым деянием","то ему","лучшее","чем оно","а кто","придёт","со злым деянием","то не","получат воздаяние","те, которые","совершали","злые деяния","кроме (как за)","то, что","они","делали"]]],"m":[[["قَالَ","сказал он",28,78],["إِنَّمَآ","лишь",28,78],["أُوتِيتُهُۥ","дано мне это",28,78],["عَلَىٰ","по",28,78],["عِلۡمٍ","знанию",28,78],["عِندِيٓۚ","у меня",28,78],["أَوَلَمۡ","разве не",28,78],["يَعۡلَمۡ","знал он",28,78],["أَنَّ","что",28,78],["ٱللَّهَ","Аллах",28,78],["قَدۡ","уже",28,78],["أَهۡلَكَ","погубил",28,78]],[["مِن","до",28,78],["قَبۡلِهِۦ","него",28,78],["مِنَ","из",28,78],["ٱلۡقُرُونِ","поколений",28,78],["مَنۡ","тех, кто",28,78],["هُوَ","он",28,78],["أَشَدُّ","сильнее",28,78],["مِنۡهُ","его",28,78],["قُوَّةٗ","мощью",28,78],["وَأَكۡثَرُ","и больше",28,78],["جَمۡعٗاۚ","накоплениями",28,78]],[["وَلَا","и не",28,78],["يُسۡـَٔلُ","будут спрошены",28,78],["عَن","о",28,78],["ذُنُوبِهِمُ","грехах их",28,78],["ٱلۡمُجۡرِمُونَ","грешники",28,78],[78],["فَخَرَجَ","и вышел он",28,79],["عَلَىٰ","к",28,79],["قَوۡمِهِۦ","народу своему",28,79]],[["فِي","в",28,79],["زِينَتِهِۦۖ","убранстве своём",28,79],["قَالَ","сказали",28,79],["ٱلَّذِينَ","те, которые",28,79],["يُرِيدُونَ","желают",28,79],["ٱلۡحَيَوٰةَ","жизни",28,79],["ٱلدُّنۡيَا","мирской",28,79],["يَٰلَيۡتَ","о, если бы",28,79],["لَنَا","у нас (было)",28,79]],[["مِثۡلَ","подобное",28,79],["مَآ","тому, что",28,79],["أُوتِيَ","дано",28,79],["قَٰرُونُ","Каруну",28,79],["إِنَّهُۥ","поистине, он",28,79],["لَذُو","непременно обладатель",28,79],["حَظٍّ","доли",28,79],["عَظِيمٖ","великой",28,79],[79],["وَقَالَ","и сказали",28,80]],[["ٱلَّذِينَ","те, которым",28,80],["أُوتُواْ","было дано",28,80],["ٱلۡعِلۡمَ","знание",28,80],["وَيۡلَكُمۡ","горе вам",28,80],["ثَوَابُ","награда",28,80],["ٱللَّهِ","Аллаха",28,80],["خَيۡرٞ","лучше",28,80],["لِّمَنۡ","для того, кто",28,80],["ءَامَنَ","уверовал",28,80]],[["وَعَمِلَ","и совершал",28,80],["صَٰلِحٗاۚ","праведное",28,80],["وَلَا","и не",28,80],["يُلَقَّىٰهَآ","даруется она",28,80],["إِلَّا","кроме",28,80],["ٱلصَّٰبِرُونَ","терпеливым",28,80],[80],["فَخَسَفۡنَا","и Мы заставили поглотить",28,81]],[["بِهِۦ","его",28,81],["وَبِدَارِهِ","и дом его",28,81],["ٱلۡأَرۡضَ","землю",28,81],["فَمَا","и не",28,81],["كَانَ","было",28,81],["لَهُۥ","у него",28,81],["مِن","никакой",28,81],["فِئَةٖ","группы",28,81],["يَنصُرُونَهُۥ","помогающих ему",28,81],["مِن","из",28,81],["دُونِ","помимо",28,81]],[["ٱللَّهِ","Аллаха",28,81],["وَمَا","и не",28,81],["كَانَ","был он",28,81],["مِنَ","из",28,81],["ٱلۡمُنتَصِرِينَ","защитивших себя",28,81],[81],["وَأَصۡبَحَ","и стали",28,82],["ٱلَّذِينَ","те, которые",28,82],["تَمَنَّوۡاْ","желали",28,82]],[["مَكَانَهُۥ","места его",28,82],["بِٱلۡأَمۡسِ","вчера",28,82],["يَقُولُونَ","говорить",28,82],["وَيۡكَأَنَّ","ох! ведь",28,82],["ٱللَّهَ","Аллах",28,82],["يَبۡسُطُ","расширяет",28,82],["ٱلرِّزۡقَ","удел",28,82],["لِمَن","тому, кому",28,82]],[["يَشَآءُ","пожелает Он",28,82],["مِنۡ","из",28,82],["عِبَادِهِۦ","рабов Своих",28,82],["وَيَقۡدِرُۖ","и ограничивает",28,82],["لَوۡلَآ","если бы не",28,82],["أَن","что",28,82],["مَّنَّ","оказал милость",28,82],["ٱللَّهُ","Аллах",28,82],["عَلَيۡنَا","нам",28,82],["لَخَسَفَ","непременно Он заставил бы поглотить",28,82],["بِنَاۖ","нас",28,82]],[["وَيۡكَأَنَّهُۥ","ох! ведь",28,82],["لَا","не",28,82],["يُفۡلِحُ","преуспевают",28,82],["ٱلۡكَٰفِرُونَ","неверующие",28,82],[82],["تِلۡكَ","та",28,83],["ٱلدَّارُ","обитель",28,83],["ٱلۡأٓخِرَةُ","Последняя",28,83],["نَجۡعَلُهَا","Мы отводим её",28,83]],[["لِلَّذِينَ","для тех, которые",28,83],["لَا","не",28,83],["يُرِيدُونَ","желают",28,83],["عُلُوّٗا","превозношения",28,83],["فِي","на",28,83],["ٱلۡأَرۡضِ","земле",28,83],["وَلَا","и не",28,83],["فَسَادٗاۚ","нечестия",28,83],["وَٱلۡعَٰقِبَةُ","и исход (добрый)",28,83],["لِلۡمُتَّقِينَ","для богобоязненных",28,83]],[[83],["مَن","кто",28,84],["جَآءَ","придёт",28,84],["بِٱلۡحَسَنَةِ","с добрым деянием",28,84],["فَلَهُۥ","то ему",28,84],["خَيۡرٞ","лучшее",28,84],["مِّنۡهَاۖ","чем оно",28,84],["وَمَن","а кто",28,84],["جَآءَ","придёт",28,84],["بِٱلسَّيِّئَةِ","со злым деянием",28,84],["فَلَا","то не",28,84]],[["يُجۡزَى","получат воздаяние",28,84],["ٱلَّذِينَ","те, которые",28,84],["عَمِلُواْ","совершали",28,84],["ٱلسَّيِّـَٔاتِ","злые деяния",28,84],["إِلَّا","кроме (как за)",28,84],["مَا","то, что",28,84],["كَانُواْ","они",28,84],["يَعۡمَلُونَ","делали",28,84],[84]]]}