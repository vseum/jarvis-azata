{"p":396,"j":20,"a":[[28,85,["إِنَّ","ٱلَّذِي","فَرَضَ","عَلَيۡكَ","ٱلۡقُرۡءَانَ","لَرَآدُّكَ","إِلَىٰ","مَعَادٖۚ","قُل","رَّبِّيٓ","أَعۡلَمُ","مَن","جَآءَ","بِٱلۡهُدَىٰ","وَمَنۡ","هُوَ","فِي","ضَلَٰلٖ","مُّبِينٖ"],"иннал лазии фарада `алайкал ḳур'ана лараддука ила ма`адин ḳул рраббии а`ламу ман жаа билхуда ваман хуа фии далалим мубиин","Тот, кто ниспослал тебе Коран и сделал его предписания обязательными, непременно вернет тебя к месту возвращения (в Мекку или в Рай). Скажи: «Мой Господь лучше знает, кто принес верное руководство, а кто находится в очевидном заблуждении».",["поистине","Тот, Кто","вменил","тебе","Коран","непременно вернёт тебя","к","месту возвращения","скажи","Господь мой","лучше знает","кто","пришёл","с руководством","и кто","он","в","заблуждении","явном"]],[28,86,["وَمَا","كُنتَ","تَرۡجُوٓاْ","أَن","يُلۡقَىٰٓ","إِلَيۡكَ","ٱلۡكِتَٰبُ","إِلَّا","رَحۡمَةٗ","مِّن","رَّبِّكَۖ","فَلَا","تَكُونَنَّ","ظَهِيرٗا","لِّلۡكَٰفِرِينَ"],"вама кунта таржуу ан йулḳа илайкал китабу илла рахматам мир раббика фала такуунанна захиирал лилкафириин","Ты не ожидал, что тебе будет ниспослано Писание, но это было милостью от твоего Господа. Посему никогда не поддерживай неверующих.",["и не","был ты","надеющимся","что","будет ниспослано","тебе","Писание","но лишь (как)","милость","от","Господа твоего","так не","будь же","помощником","неверующим"]],[28,87,["وَلَا","يَصُدُّنَّكَ","عَنۡ","ءَايَٰتِ","ٱللَّهِ","بَعۡدَ","إِذۡ","أُنزِلَتۡ","إِلَيۡكَۖ","وَٱدۡعُ","إِلَىٰ","رَبِّكَۖ","وَلَا","تَكُونَنَّ","مِنَ","ٱلۡمُشۡرِكِينَ"],"вала йасуддуннака `ан айатиллахи ба`да из унзилат илайка вад`у ила раббика вала такуунанна минал мушрикиин","Да не отвратят они тебя от аятов Аллаха после того, как они были ниспосланы тебе. Призывай к своему Господу и не будь одним из многобожников.",["и да не","отвратят тебя","от","аятов","Аллаха","после","того как","ниспосланы они","тебе","и призывай","к","Господу твоему","и не","будь же","из","многобожников"]],[28,88,["وَلَا","تَدۡعُ","مَعَ","ٱللَّهِ","إِلَٰهًا","ءَاخَرَۘ","لَآ","إِلَٰهَ","إِلَّا","هُوَۚ","كُلُّ","شَيۡءٍ","هَالِكٌ","إِلَّا","وَجۡهَهُۥۚ","لَهُ","ٱلۡحُكۡمُ","وَإِلَيۡهِ","تُرۡجَعُونَ"],"вала тад`у ма`аллахи илахан ахара ла илаха илла хуа куллу шай'ин халикун илла важхахуу лахул хукму ва'илайхи туржа`уун","Не взывай наряду с Аллахом к другим богам. Нет божества, кроме Него! Всякая вещь погибнет, кроме Его Лика. Только Он принимает решения, и к Нему вы будете возвращены.",["и не","призывай","наряду с","Аллахом","бога","другого","нет","бога","кроме","Него","всякая","вещь","погибнет","кроме","Лика Его","Ему (принадлежит)","решение","и к Нему","вы будете возвращены"]],[29,1,["الٓمٓ"],"лм","Алиф. Лам. Мим.",["Алиф Лам Мим"]],[29,2,["أَحَسِبَ","ٱلنَّاسُ","أَن","يُتۡرَكُوٓاْ","أَن","يَقُولُوٓاْ","ءَامَنَّا","وَهُمۡ","لَا","يُفۡتَنُونَ"],"ахасибан насу ан йутракуу ан йаḳуулуу аманна вахум ла йуфтануун","Неужели люди полагают, что их оставят и не подвергнут искушению только за то, что они скажут: «Мы уверовали»?",["разве полагают","люди","что","будут оставлены они","(за) то, что","скажут они","мы уверовали","и они","не","будут испытаны"]],[29,3,["وَلَقَدۡ","فَتَنَّا","ٱلَّذِينَ","مِن","قَبۡلِهِمۡۖ","فَلَيَعۡلَمَنَّ","ٱللَّهُ","ٱلَّذِينَ","صَدَقُواْ","وَلَيَعۡلَمَنَّ","ٱلۡكَٰذِبِينَ"],"валаḳад фатаннал лазиина мин ḳаблихим фалайа`ламанналлахул лазиина садаḳуу валайа`ламаннал казибиин","Мы уже подвергли искушению тех, кто был до них. Аллах непременно узнает тех, которые говорят правду, и непременно узнает лжецов.",["и уже","Мы испытали","тех, которые","до","них","и непременно узнает","Аллах","тех, которые","сказали правду","и непременно узнает Он","лжецов"]],[29,4,["أَمۡ","حَسِبَ","ٱلَّذِينَ","يَعۡمَلُونَ","ٱلسَّيِّـَٔاتِ","أَن","يَسۡبِقُونَاۚ","سَآءَ","مَا","يَحۡكُمُونَ"],"ам хасибал лазиина йа`малуунас саййиати ан йасбиḳууна саа ма йахкумуун","Неужели те, которые совершают злые деяния, полагают, что они опередят Нас (спасутся от наказания)? Скверно же они судят!",["или","полагают","те, которые","совершают","злые деяния","что","опередят они Нас","скверно","то, что","они судят"]],[29,5,["مَن","كَانَ","يَرۡجُواْ","لِقَآءَ","ٱللَّهِ","فَإِنَّ","أَجَلَ","ٱللَّهِ","لَأٓتٖۚ","وَهُوَ","ٱلسَّمِيعُ","ٱلۡعَلِيمُ"],"ман кана йаржуу лиḳааллахи фа'инна ажалаллахи ла'атин вахуас самии`ул `алиим","Если кто надеется на встречу с Аллахом, то ведь срок Аллаха непременно наступит. Он - Слышащий, Видящий.",["кто","был","надеется на","встречу (с)","Аллахом","то поистине","срок","Аллаха","непременно наступит","и Он","Слышащий","Знающий"]],[29,6,["وَمَن","جَٰهَدَ","فَإِنَّمَا","يُجَٰهِدُ","لِنَفۡسِهِۦٓۚ","إِنَّ","ٱللَّهَ","لَغَنِيٌّ","عَنِ","ٱلۡعَٰلَمِينَ"],"ваман жахада фа'иннама йужахиду линафсихии инналлаха лаганиййун `анил `аламиин","Тот, кто сражается, сражается во благо себе. Воистину, Аллах не нуждается в мирах!",["и кто","усердствует","то лишь","усердствует он","для себя самого","поистине","Аллах","непременно не нуждается","в","мирах"]]],"m":[[["إِنَّ","поистине",28,85],["ٱلَّذِي","Тот, Кто",28,85],["فَرَضَ","вменил",28,85],["عَلَيۡكَ","тебе",28,85],["ٱلۡقُرۡءَانَ","Коран",28,85],["لَرَآدُّكَ","непременно вернёт тебя",28,85],["إِلَىٰ","к",28,85],["مَعَادٖۚ","месту возвращения",28,85],["قُل","скажи",28,85],["رَّبِّيٓ","Господь мой",28,85]],[["أَعۡلَمُ","лучше знает",28,85],["مَن","кто",28,85],["جَآءَ","пришёл",28,85],["بِٱلۡهُدَىٰ","с руководством",28,85],["وَمَنۡ","и кто",28,85],["هُوَ","он",28,85],["فِي","в",28,85],["ضَلَٰلٖ","заблуждении",28,85],["مُّبِينٖ","явном",28,85],[85],["وَمَا","и не",28,86],["كُنتَ","был ты",28,86]],[["تَرۡجُوٓاْ","надеющимся",28,86],["أَن","что",28,86],["يُلۡقَىٰٓ","будет ниспослано",28,86],["إِلَيۡكَ","тебе",28,86],["ٱلۡكِتَٰبُ","Писание",28,86],["إِلَّا","но лишь (как)",28,86],["رَحۡمَةٗ","милость",28,86],["مِّن","от",28,86],["رَّبِّكَۖ","Господа твоего",28,86]],[["فَلَا","так не",28,86],["تَكُونَنَّ","будь же",28,86],["ظَهِيرٗا","помощником",28,86],["لِّلۡكَٰفِرِينَ","неверующим",28,86],[86],["وَلَا","и да не",28,87],["يَصُدُّنَّكَ","отвратят тебя",