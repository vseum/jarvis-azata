{"p":397,"j":20,"a":[[29,7,["وَٱلَّذِينَ","ءَامَنُواْ","وَعَمِلُواْ","ٱلصَّٰلِحَٰتِ","لَنُكَفِّرَنَّ","عَنۡهُمۡ","سَيِّـَٔاتِهِمۡ","وَلَنَجۡزِيَنَّهُمۡ","أَحۡسَنَ","ٱلَّذِي","كَانُواْ","يَعۡمَلُونَ"],"валлазиина амануу ва`амилус салихати ланукаффиранна `анхум саййиатихим валанажзийаннахум ахсанал лазии кануу йа`малуун","Тем, которые уверовали и совершали праведные деяния, Мы простим их злодеяния и воздадим за наилучшее из того, что они совершали (или лучшим, чем то, что они совершали; или наилучшим образом за то, что они совершали).",["и те, которые","уверовали","и совершали","праведные деяния","непременно Мы загладим","с них","злые деяния их","и непременно Мы воздадим им","(по) наилучшему","(из) того, что","они","совершали"]],[29,8,["وَوَصَّيۡنَا","ٱلۡإِنسَٰنَ","بِوَٰلِدَيۡهِ","حُسۡنٗاۖ","وَإِن","جَٰهَدَاكَ","لِتُشۡرِكَ","بِي","مَا","لَيۡسَ","لَكَ","بِهِۦ","عِلۡمٞ","فَلَا","تُطِعۡهُمَآۚ","إِلَيَّ","مَرۡجِعُكُمۡ","فَأُنَبِّئُكُم","بِمَا","كُنتُمۡ","تَعۡمَلُونَ"],"вавассайнал инсана бивалидайхи хуснан ва'ин жахадака литушрика бии ма лайса лака бихии `илмун фала тути`хума илаййа маржи`укум фа'унаббиукум бима кунтум та`малуун","Мы заповедали человеку быть добрым к родителям. А если они станут сражаться с тобой, чтобы ты приобщал ко мне сотоварищей, о которых ты ничего не знаешь, то не повинуйся им. Ко Мне предстоит ваше возвращение, и тогда Я поведаю вам о том, что вы совершали.",["и Мы заповедали","человеку","к родителям своим","доброту","а если","станут оба добиваться от тебя","чтобы ты приобщил в сотоварищи","Мне","то, что","нет","у тебя","о том","знания","то не","повинуйся им обоим","ко Мне","возвращение ваше","и Я сообщу вам","о том, что","вы","делали"]],[29,9,["وَٱلَّذِينَ","ءَامَنُواْ","وَعَمِلُواْ","ٱلصَّٰلِحَٰتِ","لَنُدۡخِلَنَّهُمۡ","فِي","ٱلصَّٰلِحِينَ"],"валлазиина амануу ва`амилус салихати ланудхиланнахум фис салихиин","А тех, которые уверовали и совершали праведные деяния, Мы введем в Рай вместе с праведниками.",["и те, которые","уверовали","и совершали","праведные дела","непременно введем Мы их","в число","праведников"]],[29,10,["وَمِنَ","ٱلنَّاسِ","مَن","يَقُولُ","ءَامَنَّا","بِٱللَّهِ","فَإِذَآ","أُوذِيَ","فِي","ٱللَّهِ","جَعَلَ","فِتۡنَةَ","ٱلنَّاسِ","كَعَذَابِ","ٱللَّهِۖ","وَلَئِن","جَآءَ","نَصۡرٞ","مِّن","رَّبِّكَ","لَيَقُولُنَّ","إِنَّا","كُنَّا","مَعَكُمۡۚ","أَوَلَيۡسَ","ٱللَّهُ","بِأَعۡلَمَ","بِمَا","فِي","صُدُورِ","ٱلۡعَٰلَمِينَ"],"ваминан наси ман йаḳуулу аманна биллахи фа'иза уузийа филлахи жа`ала фитнатан наси ка`азабиллахи валаин жаа насрум мир раббика лайаḳуулунна инна кунна ма`акум авалайсаллаху би'а`лама бима фии судуурил `аламиин","Среди людей есть такие, которые говорят: «Мы уверовали в Аллаха». Но стоит им пострадать ради Аллаха, как они сравнивают искушения (наказание) людей с мучениями от Аллаха. Если же явится победа от твоего Господа, то они непременно скажут: «Мы были вместе с вами». Но разве Аллаху не лучше знать, что таится в груди миров?",["и среди","людей","(есть) тот, кто","говорит","мы уверовали","в Аллаха","но когда","пострадал он","ради","Аллаха","считает он","искушение","людей","как наказание","Аллаха","а если","придёт","помощь","от","Господа твоего","непременно скажут они","поистине, мы","были","с вами","разве не","Аллах","лучше знающий","о том, что","в","груди","миров"]],[29,11,["وَلَيَعۡلَمَنَّ","ٱللَّهُ","ٱلَّذِينَ","ءَامَنُواْ","وَلَيَعۡلَمَنَّ","ٱلۡمُنَٰفِقِينَ"],"валайа`ламанналлахул лазиина амануу валайа`ламаннал мунафиḳиин","Аллах непременно узнает тех, кто уверовал, и непременно узнает лицемеров.",["и непременно узнает","Аллах","тех, которые","уверовали","и непременно узнает Он","лицемеров"]],[29,12,["وَقَالَ","ٱلَّذِينَ","كَفَرُواْ","لِلَّذِينَ","ءَامَنُواْ","ٱتَّبِعُواْ","سَبِيلَنَا","وَلۡنَحۡمِلۡ","خَطَٰيَٰكُمۡ","وَمَا","هُم","بِحَٰمِلِينَ","مِنۡ","خَطَٰيَٰهُم","مِّن","شَيۡءٍۖ","إِنَّهُمۡ","لَكَٰذِبُونَ"],"ваḳалал лазиина кафаруу лиллазиина амануттаби`уу сабиилана валнахмил хатайакум вама хум бихамилиина мин хатайахум мин шай'ин иннахум лаказибуун","Неверующие говорят тем, которые уверовали: «Следуйте нашим путем, и мы возьмем на себя ваши грехи». Они не возьмут на себя даже части их грехов. Воистину, они - лжецы.",["и сказали","те, которые","не уверовали","тем, которые","уверовали","следуйте","путём нашим","и пусть мы понесём","грехи ваши","и не","они","несущие","из","грехов их","ни","малейшего","поистине, они","непременно лжецы"]],[29,13,["وَلَيَحۡمِلُنَّ","أَثۡقَالَهُمۡ","وَأَثۡقَالٗا","مَّعَ","أَثۡقَالِهِمۡۖ","وَلَيُسۡـَٔلُنَّ","يَوۡمَ","ٱلۡقِيَٰمَةِ","عَمَّا","كَانُواْ","يَفۡتَرُونَ"],"валайахмилунна асḳалахум ва'асḳалам ма`а асḳалихим валайус'алунна йаумал ḳийамати `амма кануу йафтаруун","Они непременно понесут свое бремя и другое бремя вместе со своим бременем. В День воскресения их непременно спросят о том, что они измышляли.",["и непременно понесут они","бремя своё","и (другое) бремя","с","бременем своим","и непременно будут спрошены они","в День","воскресения","о том, что","они","измышляли"]],[29,14,["وَلَقَدۡ","أَرۡسَلۡنَا","نُوحًا","إِلَىٰ","قَوۡمِهِۦ","فَلَبِثَ","فِيهِمۡ","أَلۡفَ","سَنَةٍ","إِلَّا","خَمۡسِينَ","عَامٗا","فَأَخَذَهُمُ","ٱلطُّوفَانُ","وَهُمۡ","ظَٰلِمُونَ"],"валаḳад арсална нуухан ила ḳаумихии фалабиса фиихим алфа санатин илла хамсиина `аман фа'ахазахумут тууфану вахум залимуун","Мы послали Нуха (Ноя) к его народу, и он пробыл среди них тысячу лет без пятидесяти годов. Они были беззаконниками, и их погубил потоп.",["и уже","Мы послали","Нуха","к","народу его","и пробыл он","среди них","тысячу","лет","кроме","пятидесяти","лет","и постиг их","потоп","и они","беззаконники"]]],"m":[[["وَٱلَّذِينَ","и те, которые",29,7],["ءَامَنُواْ","уверовали",29,7],["وَعَمِلُواْ","и совершали",29,7],["ٱلصَّٰلِحَٰتِ","праведные деяния",29,7],["لَنُكَفِّرَنَّ","непременно Мы загладим",29,7],["عَنۡهُمۡ","с них",29,7],["سَيِّـَٔاتِهِمۡ","злые деяния их",29,7]],[["وَلَنَجۡزِيَنَّهُمۡ","и непременно Мы воздадим им",29,7],["أَحۡسَنَ","(по) наилучшему",29,7],["ٱلَّذِي","(из) того, что",29,7],["كَانُواْ","они",29,7],["يَعۡمَلُونَ","совершали",29,7],[7],["وَوَصَّيۡنَا","и Мы заповедали",29,8],["ٱلۡإِنسَٰنَ","человеку",29,8]],[["بِوَٰلِدَيۡهِ","к родителям своим",29,8],["حُسۡنٗاۖ","доброту",29,8],["وَإِن","а если",29,8],["جَٰهَدَاكَ","станут оба добиваться от тебя",29,8],["لِتُشۡرِكَ","чтобы ты приобщил в сотоварищи",29,8],["بِي","Мне",29,8],["مَا","то, что",29,8],["لَيۡسَ","нет",29,8],["لَكَ","у тебя",29,8],["بِهِۦ","о том",29,8],["عِلۡمٞ","знания",29,8]],[["فَلَا","то не",29,8],["تُطِعۡهُمَآۚ","повинуйся им обоим",29,8],["إِلَيَّ","ко Мне",29,8],["مَرۡجِعُكُمۡ","возвращение ваше",29,8],["فَأُنَبِّئُكُم","и Я сообщу вам",29,8],["بِمَا","о том, что",29,8],["كُنتُمۡ","вы",29,8],["تَعۡمَلُونَ","делали",29,8],[8]],[["وَٱلَّذِينَ","и те, которые",29,9],["ءَامَنُواْ","уверовали",29,9],["وَعَمِلُواْ","и совершали",29,9],["ٱلصَّٰلِحَٰتِ","праведные дела",29,9],["لَنُدۡخِلَنَّهُمۡ","непременно введем Мы их",29,9],["فِي","в число",29,9],["ٱلصَّٰلِحِينَ","праведников",29,9]],[[9],["وَمِنَ","и среди",29,10],["ٱلنَّاسِ","людей",29,10],["مَن","(есть) тот, кто",29,10],["يَقُولُ","говорит",29,10],["ءَامَنَّا","мы уверовали",29,10],["بِٱللَّهِ","в Аллаха",29,10],["فَإِذَآ","но когда",29,10],["أُوذِيَ","пострадал он",29,10],["فِي","ради",29,10],["ٱللَّهِ","Аллаха",29,10],["جَعَلَ","считает он",29,10]],[["فِتۡنَةَ","искушение",29,10],["ٱلنَّاسِ","людей",29,10],["كَعَذَابِ","как наказание",29,10],["ٱللَّهِۖ","Аллаха",29,10],["وَلَئِن","а если",29,10],["جَآءَ","придёт",29,10],["نَصۡرٞ","помощь",29,10],["مِّن","от",29,10],["رَّبِّكَ","Господа твоего",29,10],["لَيَقُولُنَّ","непременно скажут они",29,10]],[["إِنَّا","поистине, мы",29,10],["كُنَّا","были",29,10],["مَعَكُمۡۚ","с вами",29,10],["أَوَلَيۡسَ","разве не",29,10],["ٱللَّهُ","Аллах",29,10],["بِأَعۡلَمَ","лучше знающий",29,10],["بِمَا","о том, что",29,10],["فِي","в",29,10],["صُدُورِ","груди",29,10],["ٱلۡعَٰلَمِينَ","миров",29,10]],[[10],["وَلَيَعۡلَمَنَّ","и непременно узнает",29,11],["ٱللَّهُ","Аллах",29,11],["ٱلَّذِينَ","тех, которые",29,11],["ءَامَنُواْ","уверовали",29,11],["وَلَيَعۡلَمَنَّ","и непременно узнает Он",29,11],["ٱلۡمُنَٰفِقِينَ","лицемеров",29,11]],[[11],["وَقَالَ","и сказали",29,12],["ٱلَّذِينَ","те, которые",29,12],["كَفَرُواْ","не уверовали",29,12],["لِلَّذِينَ","тем, которые",29,12],["ءَامَنُواْ","уверовали",29,12],["ٱتَّبِعُواْ","следуйте",29,12],["سَبِيلَنَا","путём нашим",29,12]],[["وَلۡنَحۡمِلۡ","и пусть мы понесём",29,12],["خَطَٰيَٰكُمۡ","грехи ваши",29,12],["وَمَا","и не",29,12],["هُم","они",29,12],["بِحَٰمِلِينَ","несущие",29,12],["مِنۡ","из",29,12],["خَطَٰيَٰهُم","грехов их",29,12],["مِّن","ни",29,12]],[["شَيۡءٍۖ","малейшего",29,12],["إِنَّهُمۡ","поистине, они",29,12],["لَكَٰذِبُونَ","непременно лжецы",29,12],[12],["وَلَيَحۡمِلُنَّ","и непременно понесут они",29,13],["أَثۡقَالَهُمۡ","бремя своё",29,13],["وَأَثۡقَالٗا","и (другое) бремя",29,13]],[["مَّعَ","с",29,13],["أَثۡقَالِهِمۡۖ","бременем своим",29,13],["وَلَيُسۡـَٔلُنَّ","и непременно будут спрошены они",29,13],["يَوۡمَ","в День",29,13],["ٱلۡقِيَٰمَةِ","воскресения",29,13],["عَمَّا","о том, что",29,13],["كَانُواْ","они",29,13],["يَفۡتَرُونَ","измышляли",29,13]],[[13],["وَلَقَدۡ","и уже",29,14],["أَرۡسَلۡنَا","Мы послали",29,14],["نُوحًا","Нуха",29,14],["إِلَىٰ","к",29,14],["قَوۡمِهِۦ","народу его",29,14],["فَلَبِثَ","и пробыл он",29,14],["فِيهِمۡ","среди них",29,14],["أَلۡفَ","тысячу",29,14],["سَنَةٍ","лет",29,14]],[["إِلَّا","кроме",29,14],["خَمۡسِينَ","пятидесяти",29,14],["عَامٗا","лет",29,14],["فَأَخَذَهُمُ","и постиг их",29,14],["ٱلطُّوفَانُ","потоп",29,14],["وَهُمۡ","и они",29,14],["ظَٰلِمُونَ","беззаконники",29,14],[14]]]}