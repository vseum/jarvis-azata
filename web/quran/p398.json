{"p":398,"j":20,"a":[[29,15,["فَأَنجَيۡنَٰهُ","وَأَصۡحَٰبَ","ٱلسَّفِينَةِ","وَجَعَلۡنَٰهَآ","ءَايَةٗ","لِّلۡعَٰلَمِينَ"],"фа'анжайнаху ва'асхабас сафиинати важа`алнаха айатал лил`аламиин","Мы спасли его вместе с теми, кто был в ковчеге, и сделали его (ковчег или чудесное спасение) знамением для миров.",["и Мы спасли его","и людей","ковчега","и Мы сделали его","знамением","для миров"]],[29,16,["وَإِبۡرَٰهِيمَ","إِذۡ","قَالَ","لِقَوۡمِهِ","ٱعۡبُدُواْ","ٱللَّهَ","وَٱتَّقُوهُۖ","ذَٰلِكُمۡ","خَيۡرٞ","لَّكُمۡ","إِن","كُنتُمۡ","تَعۡلَمُونَ"],"ва'ибрахиима из ḳала лиḳаумихи`будуллаха ваттаḳууху заликум хайрул лакум ин кунтум та`ламуун","А вот Ибрахим (Авраам) сказал своему народу: «Поклоняйтесь Аллаху и бойтесь Его! Так будет лучше для вас, если бы вы только знали.",["и Ибрахима","когда","сказал он","народу своему","поклоняйтесь","Аллаху","и бойтесь Его","это","лучше","для вас","если","вы","знаете"]],[29,17,["إِنَّمَا","تَعۡبُدُونَ","مِن","دُونِ","ٱللَّهِ","أَوۡثَٰنٗا","وَتَخۡلُقُونَ","إِفۡكًاۚ","إِنَّ","ٱلَّذِينَ","تَعۡبُدُونَ","مِن","دُونِ","ٱللَّهِ","لَا","يَمۡلِكُونَ","لَكُمۡ","رِزۡقٗا","فَٱبۡتَغُواْ","عِندَ","ٱللَّهِ","ٱلرِّزۡقَ","وَٱعۡبُدُوهُ","وَٱشۡكُرُواْ","لَهُۥٓۖ","إِلَيۡهِ","تُرۡجَعُونَ"],"иннама та`будууна мин дууниллахи аусанан ватахлуḳууна ифкан иннал лазиина та`будууна мин дууниллахи ла йамликууна лакум ризḳан фабтагуу `индаллахир ризḳа ва`будууху вашкуруу лахуу илайхи туржа`уун","Вы поклоняетесь вместо Аллаха идолам и измышляете ложь. Воистину, те, кому вы поклоняетесь вместо Аллаха, не способны даровать вам пропитание. Ищите же пропитание у Аллаха, поклоняйтесь Ему и благодарите Его. К Нему вы будете возвращены».",["лишь","поклоняетесь вы","из","помимо","Аллаха","идолам","и творите","ложь","поистине","те, которым","вы поклоняетесь","из","помимо","Аллаха","не","властны","для вас","пропитанием","так ищите","у","Аллаха","пропитание","и поклоняйтесь Ему","и благодарите","Его","к Нему","вы будете возвращены"]],[29,18,["وَإِن","تُكَذِّبُواْ","فَقَدۡ","كَذَّبَ","أُمَمٞ","مِّن","قَبۡلِكُمۡۖ","وَمَا","عَلَى","ٱلرَّسُولِ","إِلَّا","ٱلۡبَلَٰغُ","ٱلۡمُبِينُ"],"ва'ин туказзибуу фаḳад каззаба умамум мин ḳабликум вама `алар расуули иллал балагул мубиин","Если вы сочтете это ложью, то ведь до вас целые народы считали это ложью, но на Посланника возложена только ясная передача откровения.",["а если","сочтёте ложью вы","то уже","сочли ложью","народы","до","вас","и не","на","Посланнике","лишь","передача","ясная"]],[29,19,["أَوَلَمۡ","يَرَوۡاْ","كَيۡفَ","يُبۡدِئُ","ٱللَّهُ","ٱلۡخَلۡقَ","ثُمَّ","يُعِيدُهُۥٓۚ","إِنَّ","ذَٰلِكَ","عَلَى","ٱللَّهِ","يَسِيرٞ"],"авалам йарау кайфа йубдиуллахул халḳа сумма йу`иидухуу инна залика `алаллахи йасиир","Неужели они не видят, как Аллах создает творение в первый раз, а затем воссоздает его. Воистину, это для Аллаха легко.",["разве не","видели они","как","впервые создаёт","Аллах","творение","затем","повторяет его","поистине","это","для","Аллаха","легко"]],[29,20,["قُلۡ","سِيرُواْ","فِي","ٱلۡأَرۡضِ","فَٱنظُرُواْ","كَيۡفَ","بَدَأَ","ٱلۡخَلۡقَۚ","ثُمَّ","ٱللَّهُ","يُنشِئُ","ٱلنَّشۡأَةَ","ٱلۡأٓخِرَةَۚ","إِنَّ","ٱللَّهَ","عَلَىٰ","كُلِّ","شَيۡءٖ","قَدِيرٞ"],"ḳул сиируу фил арди фанзуруу кайфа бадаал халḳа суммаллаху йуншиун наш'атал ахирата инналлаха `ала кулли шай'ин ḳадиир","Скажи: «Постранствуйте по земле и посмотрите, как Он создал творение в первый раз. Затем Аллах создаст конечное творение (воскресит мертвых). Воистину, Аллах способен на всякую вещь.",["скажи","странствуйте","по","земле","и посмотрите","как","Он начал","творение","затем","Аллах","создаст","создание","последнее","поистине","Аллах","на","всякую","вещь","способен"]],[29,21,["يُعَذِّبُ","مَن","يَشَآءُ","وَيَرۡحَمُ","مَن","يَشَآءُۖ","وَإِلَيۡهِ","تُقۡلَبُونَ"],"йу`аззибу ман йашау вайархаму ман йашау ва'илайхи туḳлабуун","Он подвергает мучениям, кого пожелает, и милует, кого пожелает, и к Нему вы будете возвращены.",["подвергает мучению Он","кого","пожелает Он","и милует","кого","пожелает Он","и к Нему","вы будете обращены"]],[29,22,["وَمَآ","أَنتُم","بِمُعۡجِزِينَ","فِي","ٱلۡأَرۡضِ","وَلَا","فِي","ٱلسَّمَآءِۖ","وَمَا","لَكُم","مِّن","دُونِ","ٱللَّهِ","مِن","وَلِيّٖ","وَلَا","نَصِيرٖ"],"вама антум биму`жизиина фил арди вала фис самаи вама лакум мин дууниллахи мин валиййин вала насиир","Вы не сможете сбежать ни на земле, ни на небе, и не будет у вас покровителей и помощников помимо Аллаха».",["и не","вы","ускользнёте","на","земле","и не","на","небе","и нет","у вас","из","помимо","Аллаха","никакого","покровителя","и не","помощника"]],[29,23,["وَٱلَّذِينَ","كَفَرُواْ","بِـَٔايَٰتِ","ٱللَّهِ","وَلِقَآئِهِۦٓ","أُوْلَٰٓئِكَ","يَئِسُواْ","مِن","رَّحۡمَتِي","وَأُوْلَٰٓئِكَ","لَهُمۡ","عَذَابٌ","أَلِيمٞ"],"валлазиина кафаруу би'айатиллахи валиḳаихии улаика йа'исуу мир рахматии ва'улаика лахум `азабун алиим","Те, которые не веруют в знамения Аллаха и во встречу с Ним, потеряли надежду на Мою милость. Именно им уготованы мучительные страдания.",["и те, которые","не уверовали","в знамения","Аллаха","и во встречу с Ним","они","отчаялись","в","милости Моей","и они","для них","наказание","мучительное"]]],"m":[[["فَأَنجَيۡنَٰهُ","и Мы спасли его",29,15],["وَأَصۡحَٰبَ","и людей",29,15],["ٱلسَّفِينَةِ","ковчега",29,15],["وَجَعَلۡنَٰهَآ","и Мы сделали его",29,15],["ءَايَةٗ","знамением",29,15],["لِّلۡعَٰلَمِينَ","для миров",29,15]],[[15],["وَإِبۡرَٰهِيمَ","и Ибрахима",29,16],["إِذۡ","когда",29,16],["قَالَ","сказал он",29,16],["لِقَوۡمِهِ","народу своему",29,16],["ٱعۡبُدُواْ","поклоняйтесь",29,16],["ٱللَّهَ","Аллаху",29,16],["وَٱتَّقُوهُۖ","и бойтесь Его",29,16],["ذَٰلِكُمۡ","это",29,16]],[["خَيۡرٞ","лучше",29,16],["لَّكُمۡ","для вас",29,16],["إِن","если",29,16],["كُنتُمۡ","вы",29,16],["تَعۡلَمُونَ","знаете",29,16],[16],["إِنَّمَا","лишь",29,17],["تَعۡبُدُونَ","поклоняетесь вы",29,17],["مِن","из",29,17]],[["دُونِ","помимо",29,17],["ٱللَّهِ","Аллаха",29,17],["أَوۡثَٰنٗا","идолам",29,17],["وَتَخۡلُقُونَ","и творите",29,17],["إِفۡكًاۚ","ложь",29,17],["إِنَّ","поистине",29,17],["ٱلَّذِينَ","те, которым",29,17],["تَعۡبُدُونَ","вы поклоняетесь",29,17],["مِن","из",29,17]],[["دُونِ","помимо",29,17],["ٱللَّهِ","Аллаха",29,17],["لَا","не",29,17],["يَمۡلِكُونَ","властны",29,17],["لَكُمۡ","для вас",29,17],["رِزۡقٗا","пропитанием",29,17],["فَٱبۡتَغُواْ","так ищите",29,17],["عِندَ","у",29,17],["ٱللَّهِ","Аллаха",29,17],["ٱلرِّزۡقَ","пропитание",29,17]],[["وَٱعۡبُدُوهُ","и поклоняйтесь Ему",29,17],["وَٱشۡكُرُواْ","и благодарите",29,17],["لَهُۥٓۖ","Его",29,17],["إِلَيۡهِ","к Нему",29,17],["تُرۡجَعُونَ","вы будете возвращены",29,17],[17],["وَإِن","а если",29,18],["تُكَذِّبُواْ","сочтёте ложью вы",29,18]],[["فَقَدۡ","то уже",29,18],["كَذَّبَ","сочли ложью",29,18],["أُمَمٞ","народы",29,18],["مِّن","до",29,18],["قَبۡلِكُمۡۖ","вас",29,18],["وَمَا","и не",29,18],["عَلَى","на",29,18],["ٱلرَّسُولِ","Посланнике",29,18],["إِلَّا","лишь",29,18],["ٱلۡبَلَٰغُ","передача",29,18]],[["ٱلۡمُبِينُ","ясная",29,18],[18],["أَوَلَمۡ","разве не",29,19],["يَرَوۡاْ","видели они",29,19],["كَيۡفَ","как",29,19],["يُبۡدِئُ","впервые создаёт",29,19],["ٱللَّهُ","Аллах",29,19],["ٱلۡخَلۡقَ","творение",29,19],["ثُمَّ","затем",29,19]],[["يُعِيدُهُۥٓۚ","повторяет его",29,19],["إِنَّ","поистине",29,19],["ذَٰلِكَ","это",29,19],["عَلَى","для",29,19],["ٱللَّهِ","Аллаха",29,19],["يَسِيرٞ","легко",29,19],[19],["قُلۡ","скажи",29,20],["سِيرُواْ","странствуйте",29,20],["فِي","по",29,20],["ٱلۡأَرۡضِ","земле",29,20]],[["فَٱنظُرُواْ","и посмотрите",29,20],["كَيۡفَ","как",29,20],["بَدَأَ","Он начал",29,20],["ٱلۡخَلۡقَۚ","творение",29,20],["ثُمَّ","затем",29,20],["ٱللَّهُ","Аллах",29,20],["يُنشِئُ","создаст",29,20],["ٱلنَّشۡأَةَ","создание",29,20],["ٱلۡأٓخِرَةَۚ","последнее",29,20]],[["إِنَّ","поистине",29,20],["ٱللَّهَ","Аллах",29,20],["عَلَىٰ","на",29,20],["كُلِّ","всякую",29,20],["شَيۡءٖ","вещь",29,20],["قَدِيرٞ","способен",29,20],[20],["يُعَذِّبُ","подвергает мучению Он",29,21],["مَن","кого",29,21],["يَشَآءُ","пожелает Он",29,21],["وَيَرۡحَمُ","и милует",29,21]],[["مَن","кого",29,21],["يَشَآءُۖ","пожелает Он",29,21],["وَإِلَيۡهِ","и к Нему",29,21],["تُقۡلَبُونَ","вы будете обращены",29,21],[21],["وَمَآ","и не",29,22],["أَنتُم","вы",29,22],["بِمُعۡجِزِينَ","ускользнёте",29,22],["فِي","на",29,22]],[["ٱلۡأَرۡضِ","земле",29,22],["وَلَا","и не",29,22],["فِي","на",29,22],["ٱلسَّمَآءِۖ","небе",29,22],["وَمَا","и нет",29,22],["لَكُم","у вас",29,22],["مِّن","из",29,22],["دُونِ","помимо",29,22],["ٱللَّهِ","Аллаха",29,22],["مِن","никакого",29,22],["وَلِيّٖ","покровителя",29,22]],[["وَلَا","и не",29,22],["نَصِيرٖ","помощника",29,22],[22],["وَٱلَّذِينَ","и те, которые",29,23],["كَفَرُواْ","не уверовали",29,23],["بِـَٔايَٰتِ","в знамения",29,23],["ٱللَّهِ","Аллаха",29,23],["وَلِقَآئِهِۦٓ","и во встречу с Ним",29,23]],[["أُوْلَٰٓئِكَ","они",29,23],["يَئِسُواْ","отчаялись",29,23],["مِن","в",29,23],["رَّحۡمَتِي","милости Моей",29,23],["وَأُوْلَٰٓئِكَ","и они",29,23],["لَهُمۡ","для них",29,23],["عَذَابٌ","наказание",29,23],["أَلِيمٞ","мучительное",29,23],[23]]]}