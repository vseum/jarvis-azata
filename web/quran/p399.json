{"p":399,"j":20,"a":[[29,24,["فَمَا","كَانَ","جَوَابَ","قَوۡمِهِۦٓ","إِلَّآ","أَن","قَالُواْ","ٱقۡتُلُوهُ","أَوۡ","حَرِّقُوهُ","فَأَنجَىٰهُ","ٱللَّهُ","مِنَ","ٱلنَّارِۚ","إِنَّ","فِي","ذَٰلِكَ","لَأٓيَٰتٖ","لِّقَوۡمٖ","يُؤۡمِنُونَ"],"фама кана жаваба ḳаумихии илла ан ḳалуḳтулууху ау харриḳууху фа'анжахуллаху минан нари инна фии залика ла'айатил лиḳаумин йу'минуун","В ответ его народ лишь сказал: «Убейте его или сожгите!». Но Аллах спас его из огня. Воистину, в этом - знамения для верующих людей.",["и не","был","ответ","народа его","кроме","того, что","сказали они","убейте его","или","сожгите его","и спас его","Аллах","от","огня","поистине","в","этом","непременно знамения","для людей","которые веруют"]],[29,25,["وَقَالَ","إِنَّمَا","ٱتَّخَذۡتُم","مِّن","دُونِ","ٱللَّهِ","أَوۡثَٰنٗا","مَّوَدَّةَ","بَيۡنِكُمۡ","فِي","ٱلۡحَيَوٰةِ","ٱلدُّنۡيَاۖ","ثُمَّ","يَوۡمَ","ٱلۡقِيَٰمَةِ","يَكۡفُرُ","بَعۡضُكُم","بِبَعۡضٖ","وَيَلۡعَنُ","بَعۡضُكُم","بَعۡضٗا","وَمَأۡوَىٰكُمُ","ٱلنَّارُ","وَمَا","لَكُم","مِّن","نَّٰصِرِينَ"],"ваḳала иннаматтахазтум ммин дууниллахи аусанам маваддата байникум фил хайаватид дунйа сумма йаумал ḳийамати йакфуру ба`дукум биба`дин вайал`ану ба`дукум ба`дан вама'вакумун нару вама лакум мин насириин","Он сказал: «Вы стали поклоняться идолам вместо Аллаха только из-за любви (или ради любви) друг к другу в мирской жизни. Но потом, в День воскресения, одни из вас станут отвергать и проклинать других. Вашим пристанищем будет Огонь, и не будет у вас защитников».",["и сказал он","лишь","взяли вы","из","помимо","Аллаха","идолов","из любви","между вами","в","жизни","мирской","затем","в День","воскресения","отречётся","часть вас","от части","и проклянёт","часть вас","часть","и пристанище ваше","Огонь","и нет","у вас","никаких","помощников"]],[29,26,["فَـَٔامَنَ","لَهُۥ","لُوطٞۘ","وَقَالَ","إِنِّي","مُهَاجِرٌ","إِلَىٰ","رَبِّيٓۖ","إِنَّهُۥ","هُوَ","ٱلۡعَزِيزُ","ٱلۡحَكِيمُ"],"фа'амана лахуу луутун ваḳала иннии мухажирун ила раббии иннахуу хуал `азиизул хакиим","В него уверовал Лут (Лот), и Ибрахим (Авраам) сказал: «Я собираюсь совершить переселение ради своего Господа. Воистину, Он - Могущественный, Мудрый».",["и уверовал","в него","Лут","и сказал он","поистине, я","переселяющийся","к","Господу моему","поистине, Он","Он","Могущественный","Мудрый"]],[29,27,["وَوَهَبۡنَا","لَهُۥٓ","إِسۡحَٰقَ","وَيَعۡقُوبَ","وَجَعَلۡنَا","فِي","ذُرِّيَّتِهِ","ٱلنُّبُوَّةَ","وَٱلۡكِتَٰبَ","وَءَاتَيۡنَٰهُ","أَجۡرَهُۥ","فِي","ٱلدُّنۡيَاۖ","وَإِنَّهُۥ","فِي","ٱلۡأٓخِرَةِ","لَمِنَ","ٱلصَّٰلِحِينَ"],"вавахабна лахуу исхаḳа вайа`ḳууба важа`ална фии зурриййатихин нубуввата валкитаба ва'атайнаху ажрахуу фид дунйа ва'иннахуу фил ахирати ламинас салихиин","Мы даровали ему Исхака (Исаака) и Йакуба (Иакова), а его потомству - пророчество и Писание. Мы даровали ему его награду в этом мире, а в Последней жизни он будет в числе праведников.",["и Мы даровали","ему","Исхака","и Йакуба","и Мы поместили","в","его потомстве","пророчество","и Писание","и Мы дали ему","его награду","в","этом мире","и поистине, он","в","Последней жизни","непременно из числа","праведников"]],[29,28,["وَلُوطًا","إِذۡ","قَالَ","لِقَوۡمِهِۦٓ","إِنَّكُمۡ","لَتَأۡتُونَ","ٱلۡفَٰحِشَةَ","مَا","سَبَقَكُم","بِهَا","مِنۡ","أَحَدٖ","مِّنَ","ٱلۡعَٰلَمِينَ"],"валуутан из ḳала лиḳаумихии иннакум лата'туунал фахишата ма сабаḳакум биха мин ахадим минал `аламиин","Вот Лут (Лот) сказал своему народу: «Воистину, вы совершаете мерзость, которую не совершал до вас никто из миров.",["и Лута (вспомни)","когда","он сказал","своему народу","поистине, вы","непременно совершаете","мерзость","не","опередил вас","в ней","ни","один","из","миров"]],[29,29,["أَئِنَّكُمۡ","لَتَأۡتُونَ","ٱلرِّجَالَ","وَتَقۡطَعُونَ","ٱلسَّبِيلَ","وَتَأۡتُونَ","فِي","نَادِيكُمُ","ٱلۡمُنكَرَۖ","فَمَا","كَانَ","جَوَابَ","قَوۡمِهِۦٓ","إِلَّآ","أَن","قَالُواْ","ٱئۡتِنَا","بِعَذَابِ","ٱللَّهِ","إِن","كُنتَ","مِنَ","ٱلصَّٰدِقِينَ"],"а'иннакум лата'туунар рижала ватаḳта`уунас сабиила вата'тууна фии надиикумул мункара фама кана жаваба ḳаумихии илла ан ḳалутина би`азабиллахи ин кунта минас садиḳиин","Неужели вы вожделеете мужчин, перекрываете дороги и совершаете предосудительное на своих сборищах?». В ответ его народ лишь сказал: «Нашли на нас мучения от Аллаха, если ты - один из тех, кто говорит правду».",["неужели вы","непременно приходите к","мужчинам","и перекрываете","дорогу","и совершаете","на","ваших сборищах","предосудительное","и не","был","ответом","его народа","кроме","того, что","они сказали","приведи на нас","наказание","Аллаха","если","ты есть","из","правдивых"]],[29,30,["قَالَ","رَبِّ","ٱنصُرۡنِي","عَلَى","ٱلۡقَوۡمِ","ٱلۡمُفۡسِدِينَ"],"ḳала раббинсурнии `алал ḳаумил муфсидиин","Он сказал: «Господи! Помоги мне одержать верх над людьми, распространяющими нечестие!».",["сказал","Господи","помоги мне","против","людей","распространяющих нечестие"]]],"m":[[["فَمَا","и не",29,24],["كَانَ","был",29,24],["جَوَابَ","ответ",29,24],["قَوۡمِهِۦٓ","народа его",29,24],["إِلَّآ","кроме",29,24],["أَن","того, что",29,24],["قَالُواْ","сказали они",29,24],["ٱقۡتُلُوهُ","убейте его",29,24],["أَوۡ","или",29,24],["حَرِّقُوهُ","сожгите его",29,24]],[["فَأَنجَىٰهُ","и спас его",29,24],["ٱللَّهُ","Аллах",29,24],["مِنَ","от",29,24],["ٱلنَّارِۚ","огня",29,24],["إِنَّ","поистине",29,24],["فِي","в",29,24],["ذَٰلِكَ","этом",29,24],["لَأٓيَٰتٖ","непременно знамения",29,24],["لِّقَوۡمٖ","для людей",29,24],["يُؤۡمِنُونَ","которые веруют",29,24]],[[24],["وَقَالَ","и сказал он",29,25],["إِنَّمَا","лишь",29,25],["ٱتَّخَذۡتُم","взяли вы",29,25],["مِّن","из",29,25],["دُونِ","помимо",29,25],["ٱللَّهِ","Аллаха",29,25],["أَوۡثَٰنٗا","идолов",29,25],["مَّوَدَّةَ","из любви",29,25],["بَيۡنِكُمۡ","между вами",29,25]],[["فِي","в",29,25],["ٱلۡحَيَوٰةِ","жизни",29,25],["ٱلدُّنۡيَاۖ","мирской",29,25],["ثُمَّ","затем",29,25],["يَوۡمَ","в День",29,25],["ٱلۡقِيَٰمَةِ","воскресения",29,25],["يَكۡفُرُ","отречётся",29,25],["بَعۡضُكُم","часть вас",29,25]],[["بِبَعۡضٖ","от части",29,25],["وَيَلۡعَنُ","и проклянёт",29,25],["بَعۡضُكُم","часть вас",29,25],["بَعۡضٗا","часть",29,25],["وَمَأۡوَىٰكُمُ","и пристанище ваше",29,25],["ٱلنَّارُ","Огонь",29,25]],[["وَمَا","и нет",29,25],["لَكُم","у вас",29,25],["مِّن","никаких",29,25],["نَّٰصِرِينَ","помощников",29,25],[25],["۞ فَـَٔامَنَ","и уверовал",29,26],["لَهُۥ","в него",29,26],["لُوطٞۘ","Лут",29,26],["وَقَالَ","и сказал он",29,26]],[["إِنِّي","поистине, я",29,26],["مُهَاجِرٌ","переселяющийся",29,26],["إِلَىٰ","к",29,26],["رَبِّيٓۖ","Господу моему",29,26],["إِنَّهُۥ","поистине, Он",29,26],["هُوَ","Он",29,26],["ٱلۡعَزِيزُ","Могущественный",29,26],["ٱلۡحَكِيمُ","Мудрый",29,26],[26],["وَوَهَبۡنَا","и Мы даровали",29,27]],[["لَهُۥٓ","ему",29,27],["إِسۡحَٰقَ","Исхака",29,27],["وَيَعۡقُوبَ","и Йакуба",29,27],["وَجَعَلۡنَا","и Мы поместили",29,27],["فِي","в",29,27],["ذُرِّيَّتِهِ","его потомстве",29,27],["ٱلنُّبُوَّةَ","пророчество",29,27],["وَٱلۡكِتَٰبَ","и Писание",29,27]],[["وَءَاتَيۡنَٰهُ","и Мы дали ему",29,27],["أَجۡرَهُۥ","его награду",29,27],["فِي","в",29,27],["ٱلدُّنۡيَاۖ","этом мире",29,27],["وَإِنَّهُۥ","и поистине, он",29,27],["فِي","в",29,27],["ٱلۡأٓخِرَةِ","Последней жизни",29,27],["لَمِنَ","непременно из числа",29,27],["ٱلصَّٰلِحِينَ","праведников",29,27]],[[27],["وَلُوطًا","и Лута (вспомни)",29,28],["إِذۡ","когда",29,28],["قَالَ","он сказал",29,28],["لِقَوۡمِهِۦٓ","своему народу",29,28],["إِنَّكُمۡ","поистине, вы",29,28],["لَتَأۡتُونَ","непременно совершаете",29,28],["ٱلۡفَٰحِشَةَ","мерзость",29,28]],[["مَا","не",29,28],["سَبَقَكُم","опередил вас",29,28],["بِهَا","в ней",29,28],["مِنۡ","ни",29,28],["أَحَدٖ","один",29,28],["مِّنَ","из",29,28],["ٱلۡعَٰلَمِينَ","миров",29,28],[28]],[["أَئِنَّكُمۡ","неужели вы",29,29],["لَتَأۡتُونَ","непременно приходите к",29,29],["ٱلرِّجَالَ","мужчинам",29,29],["وَتَقۡطَعُونَ","и перекрываете",29,29],["ٱلسَّبِيلَ","дорогу",29,29],["وَتَأۡتُونَ","и совершаете",29,29]],[["فِي","на",29,29],["نَادِيكُمُ","ваших сборищах",29,29],["ٱلۡمُنكَرَۖ","предосудительное",29,29],["فَمَا","и не",29,29],["كَانَ","был",29,29],["جَوَابَ","ответом",29,29],["قَوۡمِهِۦٓ","его народа",29,29],["إِلَّآ","кроме",29,29]],[["أَن","того, что",29,29],["قَالُواْ","они сказали",29,29],["ٱئۡتِنَا","приведи на нас",29,29],["بِعَذَابِ","наказание",29,29],["ٱللَّهِ","Аллаха",29,29],["إِن","если",29,29],["كُنتَ","ты есть",29,29],["مِنَ","из",29,29],["ٱلصَّٰدِقِينَ","правдивых",29,29]],[[29],["قَالَ","сказал",29,30],["رَبِّ","Господи",29,30],["ٱنصُرۡنِي","помоги мне",29,30],["عَلَى","против",29,30],["ٱلۡقَوۡمِ","людей",29,30],["ٱلۡمُفۡسِدِينَ","распространяющих нечестие",29,30],[30]]]}