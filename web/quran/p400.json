{"p":400,"j":20,"a":[[29,31,["وَلَمَّا","جَآءَتۡ","رُسُلُنَآ","إِبۡرَٰهِيمَ","بِٱلۡبُشۡرَىٰ","قَالُوٓاْ","إِنَّا","مُهۡلِكُوٓاْ","أَهۡلِ","هَٰذِهِ","ٱلۡقَرۡيَةِۖ","إِنَّ","أَهۡلَهَا","كَانُواْ","ظَٰلِمِينَ"],"валамма жаат русулуна ибрахиима билбушра ḳалуу инна мухликуу ахли хазихил ḳарйати инна ахлаха кануу залимиин","Когда Наши посланцы прибыли к Ибрахиму (Аврааму) с радостной вестью, они сказали: «Мы собираемся погубить жителей этого селения. Воистину, его жители являются беззаконниками».",["и когда","пришли","Наши посланцы","к Ибрахиму","с радостной вестью","они сказали","поистине, мы","погубим","жителей","этого","селения","поистине","его жители","были","беззаконниками"]],[29,32,["قَالَ","إِنَّ","فِيهَا","لُوطٗاۚ","قَالُواْ","نَحۡنُ","أَعۡلَمُ","بِمَن","فِيهَاۖ","لَنُنَجِّيَنَّهُۥ","وَأَهۡلَهُۥٓ","إِلَّا","ٱمۡرَأَتَهُۥ","كَانَتۡ","مِنَ","ٱلۡغَٰبِرِينَ"],"ḳала инна фииха луутан ḳалуу нахну а`ламу биман фииха ланунажжийаннахуу ва'ахлахуу илламраатахуу канат минал габириин","Он сказал: «Но ведь там Лут (Лот)!». Они сказали: «Нам лучше знать, кто там! Мы непременно спасем его и его семью, кроме его жены, которая будет в числе оставшихся позади».",["он сказал","поистине","в нём","Лут","они сказали","мы","лучше знаем","о том, кто","в нём","непременно спасём его","и его семью","кроме","его жены","она была","из","оставшихся позади"]],[29,33,["وَلَمَّآ","أَن","جَآءَتۡ","رُسُلُنَا","لُوطٗا","سِيٓءَ","بِهِمۡ","وَضَاقَ","بِهِمۡ","ذَرۡعٗاۖ","وَقَالُواْ","لَا","تَخَفۡ","وَلَا","تَحۡزَنۡ","إِنَّا","مُنَجُّوكَ","وَأَهۡلَكَ","إِلَّا","ٱمۡرَأَتَكَ","كَانَتۡ","مِنَ","ٱلۡغَٰبِرِينَ"],"валамма ан жаат русулуна луутан сииа бихим вадаḳа бихим зар`ан ваḳалуу ла тахаф вала тахзан инна мунажжуука ва'ахлака илламраатака канат минал габириин","Когда Наши посланцы прибыли к Луту (Лоту), он огорчился и почувствовал свое бессилие. Тогда они сказали: «Не бойся и не печалься! Мы спасем тебя и твою семью, кроме твоей жены, которая будет в числе оставшихся позади.",["и когда","(что)","пришли","Наши посланцы","к Луту","он огорчился","из-за них","и стеснён был","из-за них","в силах","и они сказали","не","бойся","и не","печалься","поистине, мы","спасём тебя","и твою семью","кроме","твоей жены","она была","из","оставшихся позади"]],[29,34,["إِنَّا","مُنزِلُونَ","عَلَىٰٓ","أَهۡلِ","هَٰذِهِ","ٱلۡقَرۡيَةِ","رِجۡزٗا","مِّنَ","ٱلسَّمَآءِ","بِمَا","كَانُواْ","يَفۡسُقُونَ"],"инна мунзилууна `ала ахли хазихил ḳарйати рижзам минас самаи бима кануу йафсуḳуун","Мы низвергнем на жителей этого селения наказание с небес за то, что они грешили».",["поистине, мы","низведём","на","жителей","этого","селения","наказание","с","неба","за то, что","они были","нечестивыми"]],[29,35,["وَلَقَد","تَّرَكۡنَا","مِنۡهَآ","ءَايَةَۢ","بَيِّنَةٗ","لِّقَوۡمٖ","يَعۡقِلُونَ"],"валаḳад ттаракна минха айата баййинатал лиḳаумин йа`ḳилуун","Мы оставили от него (селения народа Лута) ясное знамение для людей разумеющих.",["и уже","оставили Мы","от него","знамение","ясное","для людей","разумеющих"]],[29,36,["وَإِلَىٰ","مَدۡيَنَ","أَخَاهُمۡ","شُعَيۡبٗا","فَقَالَ","يَٰقَوۡمِ","ٱعۡبُدُواْ","ٱللَّهَ","وَٱرۡجُواْ","ٱلۡيَوۡمَ","ٱلۡأٓخِرَ","وَلَا","تَعۡثَوۡاْ","فِي","ٱلۡأَرۡضِ","مُفۡسِدِينَ"],"ва'ила мадйана ахахум шу`айбан фаḳала йаḳауми`будуллаха варжул йаумал ахира вала та`сау фил арди муфсидиин","Мы отправили к мадьянитам их брата Шуейба, и он сказал: «О мой народ! Поклоняйтесь Аллаху, надейтесь на Последний день и не творите на земле зла, распространяя нечестие».",["и к","Мадьяну","их брата","Шуайба","и он сказал","о мой народ","поклоняйтесь","Аллаху","и надейтесь на","день","Последний","и не","бесчинствуйте","на","земле","распространяя нечестие"]],[29,37,["فَكَذَّبُوهُ","فَأَخَذَتۡهُمُ","ٱلرَّجۡفَةُ","فَأَصۡبَحُواْ","فِي","دَارِهِمۡ","جَٰثِمِينَ"],"факаззабууху фа'ахазатхумур ражфату фа'асбахуу фии дарихим жасимиин","Они сочли его лжецом, и тогда их постигло землетрясение, и они оказались повергнуты ниц в своих домах.",["и они сочли его лжецом","и постигло их","землетрясение","и они оказались","в","своём жилище","повергнутыми ниц"]],[29,38,["وَعَادٗا","وَثَمُودَاْ","وَقَد","تَّبَيَّنَ","لَكُم","مِّن","مَّسَٰكِنِهِمۡۖ","وَزَيَّنَ","لَهُمُ","ٱلشَّيۡطَٰنُ","أَعۡمَٰلَهُمۡ","فَصَدَّهُمۡ","عَنِ","ٱلسَّبِيلِ","وَكَانُواْ","مُسۡتَبۡصِرِينَ"],"ва`адан васамууда ваḳад ттабаййана лакум мим масакинихим вазаййана лахумуш шайтану а`малахум фасаддахум `анис сабиили вакануу мустабсириин","А также адиты и самудяне! Вам это ясно по их жилищам. Дьявол представил им их деяния прекрасными и сбил их с пути, хотя они были проницательны.",["и адитов","и самудян","и уже","стало ясно","вам","по","их жилищам","и разукрасил","им","дьявол","их деяния","и отвратил их","от","пути","хотя они были","проницательными"]]],"m":[[["وَلَمَّا","и когда",29,31],["جَآءَتۡ","пришли",29,31],["رُسُلُنَآ","Наши посланцы",29,31],["إِبۡرَٰهِيمَ","к Ибрахиму",29,31],["بِٱلۡبُشۡرَىٰ","с радостной вестью",29,31],["قَالُوٓاْ","они сказали",29,31],["إِنَّا","поистине, мы",29,31],["مُهۡلِكُوٓاْ","погубим",29,31]],[["أَهۡلِ","жителей",29,31],["هَٰذِهِ","этого",29,31],["ٱلۡقَرۡيَةِۖ","селения",29,31],["إِنَّ","поистине",29,31],["أَهۡلَهَا","его жители",29,31],["كَانُواْ","были",29,31],["ظَٰلِمِينَ","беззаконниками",29,31],[31]],[["قَالَ","он сказал",29,32],["إِنَّ","поистине",29,32],["فِيهَا","в нём",29,32],["لُوطٗاۚ","Лут",29,32],["قَالُواْ","они сказали",29,32],["نَحۡنُ","мы",29,32],["أَعۡلَمُ","лучше знаем",29,32],["بِمَن","о том, кто",29,32],["فِيهَاۖ","в нём",29,32],["لَنُنَجِّيَنَّهُۥ","непременно спасём его",29,32]],[["وَأَهۡلَهُۥٓ","и его семью",29,32],["إِلَّا","кроме",29,32],["ٱمۡرَأَتَهُۥ","его жены",29,32],["كَانَتۡ","она была",29,32],["مِنَ","из",29,32],["ٱلۡغَٰبِرِينَ","оставшихся позади",29,32],[32],["وَلَمَّآ","и когда",29,33]],[["أَن","(что)",29,33],["جَآءَتۡ","пришли",29,33],["رُسُلُنَا","Наши посланцы",29,33],["لُوطٗا","к Луту",29,33],["سِيٓءَ","он огорчился",29,33],["بِهِمۡ","из-за них",29,33],["وَضَاقَ","и стеснён был",29,33],["بِهِمۡ","из-за них",29,33],["ذَرۡعٗاۖ","в силах",29,33]],[["وَ