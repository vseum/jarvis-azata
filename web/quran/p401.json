{"p":401,"j":20,"a":[[29,39,["وَقَٰرُونَ","وَفِرۡعَوۡنَ","وَهَٰمَٰنَۖ","وَلَقَدۡ","جَآءَهُم","مُّوسَىٰ","بِٱلۡبَيِّنَٰتِ","فَٱسۡتَكۡبَرُواْ","فِي","ٱلۡأَرۡضِ","وَمَا","كَانُواْ","سَٰبِقِينَ"],"ваḳарууна вафир`ауна вахамана валаḳад жаахум мууса билбаййинати фастакбаруу фил арди вама кануу сабиḳиин","А также Карун (Корей), Фараон и Хаман! Муса (Моисей) явился к ним с ясными знамениями, но они превознеслись на земле и не смогли опередить наказание.",["и Каруна","и Фараона","и Хамана","и уже","пришёл к ним","Муса","с ясными знамениями","но они возгордились","на","земле","и не","были они","опередившими (Нас)"]],[29,40,["فَكُلًّا","أَخَذۡنَا","بِذَنۢبِهِۦۖ","فَمِنۡهُم","مَّنۡ","أَرۡسَلۡنَا","عَلَيۡهِ","حَاصِبٗا","وَمِنۡهُم","مَّنۡ","أَخَذَتۡهُ","ٱلصَّيۡحَةُ","وَمِنۡهُم","مَّنۡ","خَسَفۡنَا","بِهِ","ٱلۡأَرۡضَ","وَمِنۡهُم","مَّنۡ","أَغۡرَقۡنَاۚ","وَمَا","كَانَ","ٱللَّهُ","لِيَظۡلِمَهُمۡ","وَلَٰكِن","كَانُوٓاْ","أَنفُسَهُمۡ","يَظۡلِمُونَ"],"факуллан ахазна бизамбихии фаминхум ман арсална `алайхи хасибан ваминхум ман ахазатхус сайхату ваминхум ман хасафна бихил арда ваминхум ман аграḳна вама каналлаху лийазлимахум валакин кануу анфусахум йазлимуун","Каждого Мы схватили за его грех. На некоторых из них Мы наслали ураган с камнями, некоторых из низ поразил чудовищный вопль, некоторых из них по Нашему велению поглотила земля, а некоторых из них Мы потопили. Аллах не был несправедлив к ним - они сами поступали несправедливо по отношению к себе.",["и каждого","Мы схватили","за его грех","и из них","тот, кого","Мы наслали","на него","ураган с камнями","и из них","тот, кого","постиг его","вопль","и из них","тот, кого","Мы дали поглотить","его","земле","и из них","тот, кого","Мы потопили","и не","был","Аллах","чтобы притеснять их","но","были они","самих себя","притесняющими"]],[29,41,["مَثَلُ","ٱلَّذِينَ","ٱتَّخَذُواْ","مِن","دُونِ","ٱللَّهِ","أَوۡلِيَآءَ","كَمَثَلِ","ٱلۡعَنكَبُوتِ","ٱتَّخَذَتۡ","بَيۡتٗاۖ","وَإِنَّ","أَوۡهَنَ","ٱلۡبُيُوتِ","لَبَيۡتُ","ٱلۡعَنكَبُوتِۚ","لَوۡ","كَانُواْ","يَعۡلَمُونَ"],"масалул лазиинаттахазуу мин дууниллахи аулийаа камасалил `анкабуутиттахазат байтан ва'инна ауханал буйуути лабайтул `анкабуути лау кануу йа`ламуун","Те, которые взяли себе покровителей и помощников помимо Аллаха, подобны пауку, соткавшему себе жилище. Воистину, самое непрочное жилище - это жилище паука. Если бы они только знали!",["пример","тех, которые","взяли","кроме","помимо","Аллаха","покровителей","подобен примеру","паука","(который) соткал","дом","и поистине","самый непрочный","из домов","непременно дом","паука","если бы","они","знали"]],[29,42,["إِنَّ","ٱللَّهَ","يَعۡلَمُ","مَا","يَدۡعُونَ","مِن","دُونِهِۦ","مِن","شَيۡءٖۚ","وَهُوَ","ٱلۡعَزِيزُ","ٱلۡحَكِيمُ"],"инналлаха йа`ламу ма йад`ууна мин дуунихии мин шай'ин вахуал `азиизул хакиим","Воистину, Аллах знает всех тех, кому они поклоняются помимо Него (или знает, что те, кому они поклоняются помимо Него, являются ничем). Он - Могущественный, Мудрый.",["поистине","Аллах","знает","то, что","они призывают","кроме","помимо Него","из","чего-либо","и Он","Могущественный","Мудрый"]],[29,43,["وَتِلۡكَ","ٱلۡأَمۡثَٰلُ","نَضۡرِبُهَا","لِلنَّاسِۖ","وَمَا","يَعۡقِلُهَآ","إِلَّا","ٱلۡعَٰلِمُونَ"],"ватилкал амсалу надрибуха линнаси вама йа`ḳилуха иллал `алимуун","Такие притчи Мы приводим людям, но разумеют их только обладающие знанием.",["и эти","притчи","Мы приводим их","для людей","и не","разумеют их","кроме","знающих"]],[29,44,["خَلَقَ","ٱللَّهُ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضَ","بِٱلۡحَقِّۚ","إِنَّ","فِي","ذَٰلِكَ","لَأٓيَةٗ","لِّلۡمُؤۡمِنِينَ"],"халаḳаллахус самавати вал'арда билхаḳḳи инна фии залика ла'айатал лилму'миниин","Аллах создал небеса и землю ради истины. Воистину, в этом - знамение для верующих.",["создал","Аллах","небеса","и землю","ради истины","поистине","в","этом","непременно знамение","для верующих"]],[29,45,["ٱتۡلُ","مَآ","أُوحِيَ","إِلَيۡكَ","مِنَ","ٱلۡكِتَٰبِ","وَأَقِمِ","ٱلصَّلَوٰةَۖ","إِنَّ","ٱلصَّلَوٰةَ","تَنۡهَىٰ","عَنِ","ٱلۡفَحۡشَآءِ","وَٱلۡمُنكَرِۗ","وَلَذِكۡرُ","ٱللَّهِ","أَكۡبَرُۗ","وَٱللَّهُ","يَعۡلَمُ","مَا","تَصۡنَعُونَ"],"итлу ма уухийа илайка минал китаби ва'аḳимис салавата иннас салавата танха `анил фахшаи валмункари валазикруллахи акбару валлаху йа`ламу ма тасна`уун","Читай то, что внушено тебе из Писания, и совершай намаз. Воистину, намаз оберегает от мерзости и предосудительного. Но поминание Аллаха - гораздо важнее, и Аллах знает о том, что вы творите.",["читай","то, что","внушено","тебе","из","Писания","и совершай","намаз","поистине","намаз","удерживает","от","мерзости","и предосудительного","и непременно поминание","Аллаха","больше","и Аллах","знает","то, что","вы творите"]]],"m":[[["وَقَٰرُونَ","и Каруна",29,39],["وَفِرۡعَوۡنَ","и Фараона",29,39],["وَهَٰمَٰنَۖ","и Хамана",29,39],["وَلَقَدۡ","и уже",29,39],["جَآءَهُم","пришёл к ним",29,39],["مُّوسَىٰ","Муса",29,39]],[["بِٱلۡبَيِّنَٰتِ","с ясными знамениями",29,39],["فَٱسۡتَكۡبَرُواْ","но они возгордились",29,39],["فِي","на",29,39],["ٱلۡأَرۡضِ","земле",29,39],["وَمَا","и не",29,39],["كَانُواْ","были они",29,39],["سَٰبِقِينَ","опередившими (Нас)",29,39]],[[39],["فَكُلًّا","и каждого",29,40],["أَخَذۡنَا","Мы схватили",29,40],["بِذَنۢبِهِۦۖ","за его грех",29,40],["فَمِنۡهُم","и из них",29,40],["مَّنۡ","тот, кого",29,40],["أَرۡسَلۡنَا","Мы наслали",29,40],["عَلَيۡهِ","на него",29,40],["حَاصِبٗا","ураган с камнями",29,40]],[["وَمِنۡهُم","и из них",29,40],["مَّنۡ","тот, кого",29,40],["أَخَذَتۡهُ","постиг его",29,40],["ٱلصَّيۡحَةُ","вопль",29,40],["وَمِنۡهُم","и из них",29,40],["مَّنۡ","тот, кого",29,40],["خَسَفۡنَا","Мы дали поглотить",29,40],["بِهِ","его",29,40]],[["ٱلۡأَرۡضَ","земле",29,40],["وَمِنۡهُم","и из них",29,40],["مَّنۡ","тот, кого",29,40],["أَغۡرَقۡنَاۚ","Мы потопили",29,40],["وَمَا","и не",29,40],["كَانَ","был",29,40],["ٱللَّهُ","Аллах",29,40],["لِيَظۡلِمَهُمۡ","чтобы притеснять их",29,40]],[["وَلَٰكِن","но",29,40],["كَانُوٓاْ","были они",29,40],["أَنفُسَهُمۡ","самих себя",29,40],["يَظۡلِمُونَ","притесняющими",29,40],[40],["مَثَلُ","пример",29,41],["ٱلَّذِينَ","тех, которые",29,41]],[["ٱتَّخَذُواْ","взяли",29,41],["مِن","кроме",29,41],["دُونِ","помимо",29,41],["ٱللَّهِ","Аллаха",29,41],["أَوۡلِيَآءَ","покровителей",29,41],["كَمَثَلِ","подобен примеру",29,41],["ٱلۡعَنكَبُوتِ","паука",29,41]],[["ٱتَّخَذَتۡ","(который) соткал",29,41],["بَيۡتٗاۖ","дом",29,41],["وَإِنَّ","и поистине",29,41],["أَوۡهَنَ","самый непрочный",29,41],["ٱلۡبُيُوتِ","из домов",29,41],["لَبَيۡتُ","непременно дом",29,41],["ٱلۡعَنكَبُوتِۚ","паука",29,41]],[["لَوۡ","если бы",29,41],["كَانُواْ","они",29,41],["يَعۡلَمُونَ","знали",29,41],[41],["إِنَّ","поистине",29,42],["ٱللَّهَ","Аллах",29,42],["يَعۡلَمُ","знает",29,42],["مَا","то, что",29,42],["يَدۡعُونَ","они призывают",29,42],["مِن","кроме",29,42]],[["دُونِهِۦ","помимо Него",29,42],["مِن","из",29,42],["شَيۡءٖۚ","чего-либо",29,42],["وَهُوَ","и Он",29,42],["ٱلۡعَزِيزُ","Могущественный",29,42],["ٱلۡحَكِيمُ","Мудрый",29,42],[42],["وَتِلۡكَ","и эти",29,43]],[["ٱلۡأَمۡثَٰلُ","притчи",29,43],["نَضۡرِبُهَا","Мы приводим их",29,43],["لِلنَّاسِۖ","для людей",29,43],["وَمَا","и не",29,43],["يَعۡقِلُهَآ","разумеют их",29,43],["إِلَّا","кроме",29,43],["ٱلۡعَٰلِمُونَ","знающих",29,43]],[[43],["خَلَقَ","создал",29,44],["ٱللَّهُ","Аллах",29,44],["ٱلسَّمَٰوَٰتِ","небеса",29,44],["وَٱلۡأَرۡضَ","и землю",29,44],["بِٱلۡحَقِّۚ","ради истины",29,44],["إِنَّ","поистине",29,44],["فِي","в",29,44],["ذَٰلِكَ","этом",29,44]],[["لَأٓيَةٗ","непременно знамение",29,44],["لِّلۡمُؤۡمِنِينَ","для верующих",29,44],[44],["ٱتۡلُ","читай",29,45],["مَآ","то, что",29,45],["أُوحِيَ","внушено",29,45],["إِلَيۡكَ","тебе",29,45],["مِنَ","из",29,45],["ٱلۡكِتَٰبِ","Писания",29,45]],[["وَأَقِمِ","и совершай",29,45],["ٱلصَّلَوٰةَۖ","намаз",29,45],["إِنَّ","поистине",29,45],["ٱلصَّلَوٰةَ","намаз",29,45],["تَنۡهَىٰ","удерживает",29,45],["عَنِ","от",29,45],["ٱلۡفَحۡشَآءِ","мерзости",29,45]],[["وَٱلۡمُنكَرِۗ","и предосудительного",29,45],["وَلَذِكۡرُ","и непременно поминание",29,45],["ٱللَّهِ","Аллаха",29,45],["أَكۡبَرُۗ","больше",29,45],["وَٱللَّهُ","и Аллах",29,45],["يَعۡلَمُ","знает",29,45],["مَا","то, что",29,45],["تَصۡنَعُونَ","вы творите",29,45],[45]]]}