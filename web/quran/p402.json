{"p":402,"j":21,"a":[[29,46,["وَلَا","تُجَٰدِلُوٓاْ","أَهۡلَ","ٱلۡكِتَٰبِ","إِلَّا","بِٱلَّتِي","هِيَ","أَحۡسَنُ","إِلَّا","ٱلَّذِينَ","ظَلَمُواْ","مِنۡهُمۡۖ","وَقُولُوٓاْ","ءَامَنَّا","بِٱلَّذِيٓ","أُنزِلَ","إِلَيۡنَا","وَأُنزِلَ","إِلَيۡكُمۡ","وَإِلَٰهُنَا","وَإِلَٰهُكُمۡ","وَٰحِدٞ","وَنَحۡنُ","لَهُۥ","مُسۡلِمُونَ"],"вала тужадилуу ахлал китаби илла биллатии хийа ахсану иллал лазиина заламуу минхум ваḳуулуу аманна биллазии унзила илайна ва'унзила илайкум ва'илахуна ва'илахукум вахидун ванахну лахуу муслимуун","Если вступаете в спор с людьми Писания, то ведите его наилучшим образом. Это не относится к тем из них, которые поступают несправедливо. Скажите: «Мы уверовали в то, что ниспослано нам, и то, что ниспослано вам. Наш Бог и ваш Бог - один, и мы покоряемся только Ему».",["и не","спорьте с","людьми","Писания","кроме как","тем, что","оно","наилучшее","кроме","тех, которые","поступили несправедливо","из них","и говорите","мы уверовали","в то, что","ниспослано","нам","и ниспослано","вам","и наш Бог","и ваш Бог","един","и мы","Ему","покорны"]],[29,47,["وَكَذَٰلِكَ","أَنزَلۡنَآ","إِلَيۡكَ","ٱلۡكِتَٰبَۚ","فَٱلَّذِينَ","ءَاتَيۡنَٰهُمُ","ٱلۡكِتَٰبَ","يُؤۡمِنُونَ","بِهِۦۖ","وَمِنۡ","هَٰٓؤُلَآءِ","مَن","يُؤۡمِنُ","بِهِۦۚ","وَمَا","يَجۡحَدُ","بِـَٔايَٰتِنَآ","إِلَّا","ٱلۡكَٰفِرُونَ"],"ваказалика анзална илайкал китаба фаллазиина атайнахумул китаба йу'минууна бихии вамин ха'улаи ман йу'мину бихии вама йажхаду би'айатина иллал кафируун","Так Мы ниспослали тебе Писание. Те, кому Мы даровали Писание, веруют в него. И среди этих (современников Пророка Мухаммада из числа людей Писания) есть такие, которые веруют в него (Коран), и только неверующие отвергают Наши знамения.",["и так","Мы ниспослали","тебе","Писание","и те, которым","Мы даровали","Писание","веруют","в него","и из","этих","есть те, кто","верует","в него","и не","отвергает","Наши знамения","кроме","неверующих"]],[29,48,["وَمَا","كُنتَ","تَتۡلُواْ","مِن","قَبۡلِهِۦ","مِن","كِتَٰبٖ","وَلَا","تَخُطُّهُۥ","بِيَمِينِكَۖ","إِذٗا","لَّٱرۡتَابَ","ٱلۡمُبۡطِلُونَ"],"вама кунта татлуу мин ḳаблихии мин китабин вала тахуттухуу бийамииника изал лартабал мубтилуун","Ты не читал прежде ни одного Писания и не переписывал его своей десницей. В противном случае приверженцы лжи впали бы в сомнение.",["и не","был ты","читал","прежде","него","ни одного","Писания","и не","писал его","своей десницей","тогда","непременно усомнились бы","приверженцы лжи"]],[29,49,["بَلۡ","هُوَ","ءَايَٰتُۢ","بَيِّنَٰتٞ","فِي","صُدُورِ","ٱلَّذِينَ","أُوتُواْ","ٱلۡعِلۡمَۚ","وَمَا","يَجۡحَدُ","بِـَٔايَٰتِنَآ","إِلَّا","ٱلظَّٰلِمُونَ"],"бал хуа айату баййинатун фии судуурил лазиина уутул `илма вама йажхаду би'айатина иллаз залимуун","Напротив, это - ясные аяты в груди тех, кому даровано знание, и только беззаконники отвергают Наши знамения.",["нет же","это","знамения","ясные","в","груди","тех, которым","даровано","знание","и не","отвергает","Наши знамения","кроме","беззаконников"]],[29,50,["وَقَالُواْ","لَوۡلَآ","أُنزِلَ","عَلَيۡهِ","ءَايَٰتٞ","مِّن","رَّبِّهِۦۚ","قُلۡ","إِنَّمَا","ٱلۡأٓيَٰتُ","عِندَ","ٱللَّهِ","وَإِنَّمَآ","أَنَا۠","نَذِيرٞ","مُّبِينٌ"],"ваḳалуу лаула унзила `алайхи айатум мир раббихии ḳул иннамал айату `индаллахи ва'иннама ана назиирум мубиин","Они говорят: «Почему ему не ниспосланы знамения от его Господа?». Скажи: «Воистину, знамения - у Аллаха, а я - всего лишь предостерегающий и разъясняющий увещеватель».",["и они сказали","почему не","ниспосланы","ему","знамения","от","его Господа","скажи","лишь","знамения","у","Аллаха","и лишь","я","увещеватель","ясный"]],[29,51,["أَوَلَمۡ","يَكۡفِهِمۡ","أَنَّآ","أَنزَلۡنَا","عَلَيۡكَ","ٱلۡكِتَٰبَ","يُتۡلَىٰ","عَلَيۡهِمۡۚ","إِنَّ","فِي","ذَٰلِكَ","لَرَحۡمَةٗ","وَذِكۡرَىٰ","لِقَوۡمٖ","يُؤۡمِنُونَ"],"авалам йакфихим анна анзална `алайкал китаба йутла `алайхим инна фии залика ларахматан вазикра лиḳаумин йу'минуун","Неужели им не достаточно того, что Мы ниспослали тебе Писание, которое им читается? Воистину, в этом - милость и напоминание для верующих людей.",["разве же не","достаточно им","что Мы","ниспослали","тебе","Писание","читается","им","поистине","в","этом","непременно милость","и напоминание","для людей","верующих"]],[29,52,["قُلۡ","كَفَىٰ","بِٱللَّهِ","بَيۡنِي","وَبَيۡنَكُمۡ","شَهِيدٗاۖ","يَعۡلَمُ","مَا","فِي","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِۗ","وَٱلَّذِينَ","ءَامَنُواْ","بِٱلۡبَٰطِلِ","وَكَفَرُواْ","بِٱللَّهِ","أُوْلَٰٓئِكَ","هُمُ","ٱلۡخَٰسِرُونَ"],"ḳул кафа биллахи байнии вабайнакум шахиидан йа`ламу ма фис самавати вал'арди валлазиина амануу билбатили вакафаруу биллахи улаика хумул хасируун","Скажи: «Довольно того, что Аллах является Свидетелем между мною и вами. Он знает то, что на небесах и на земле. Те же, которые уверовали в ложь и не уверовали в Аллаха, непременно окажутся в убытке».",["скажи","довольно","Аллаха","между мной","и между вами","Свидетелем","Он знает","то, что","в","небесах","и земле","а те, которые","уверовали","в ложь","и не уверовали","в Аллаха","те","они","потерпевшие убыток"]]],"m":[[["۞ وَلَا","и не",29,46],["تُجَٰدِلُوٓاْ","спорьте с",29,46],["أَهۡلَ","людьми",29,46],["ٱلۡكِتَٰبِ","Писания",29,46],["إِلَّا","кроме как",29,46],["بِٱلَّتِي","тем, что",29,46],["هِيَ","оно",29,46],["أَحۡسَنُ","наилучшее",29,46],["إِلَّا","кроме",29,46]],[["ٱلَّذِينَ","тех, которые",29,46],["ظَلَمُواْ","поступили несправедливо",29,46],["مِنۡهُمۡۖ","из них",29,46],["وَقُولُوٓاْ","и говорите",29,46],["ءَامَنَّا","мы уверовали",29,46],["بِٱلَّذِيٓ","в то, что",29,46],["أُنزِلَ","ниспослано",29,46],["إِلَيۡنَا","нам",29,46],["وَأُنزِلَ","и ниспослано",29,46]],[["إِلَيۡكُمۡ","вам",29,46],["وَإِلَٰهُنَا","и наш Бог",29,46],["وَإِلَٰهُكُمۡ","и ваш Бог",29,46],["وَٰحِدٞ","един",29,46],["وَنَحۡنُ","и мы",29,46],["لَهُۥ","Ему",29,46],["مُسۡلِمُونَ","покорны",29,46],[46]],[["وَكَذَٰلِكَ","и так",29,47],["أَنزَلۡنَآ","Мы ниспослали",29,47],["إِلَيۡكَ","тебе",29,47],["ٱلۡكِتَٰبَۚ","Писание",29,47],["فَٱلَّذِينَ","и те, которым",29,47],["ءَاتَيۡنَٰهُمُ","Мы даровали",29,47],["ٱلۡكِتَٰبَ","Писание",29,47]],[["يُؤۡمِنُونَ","веруют",29,47],["بِهِۦۖ","в него",29,47],["وَمِنۡ","и из",29,47],["هَٰٓؤُلَآءِ","этих",29,47],["مَن","есть те, кто",29,47],["يُؤۡمِنُ","верует",29,47],["بِهِۦۚ","в него",29,47],["وَمَا","и не",29,47],["يَجۡحَدُ","отвергает",29,47],["بِـَٔايَٰتِنَآ","Наши знамения",29,47]],[["إِلَّا","кроме",29,47],["ٱلۡكَٰفِرُونَ","неверующих",29,47],[47],["وَمَا","и не",29,48],["كُنتَ","был ты",29,48],["تَتۡلُواْ","читал",29,48],["مِن","прежде",29,48],["قَبۡلِهِۦ","него",29,48],["مِن","ни одного",29,48],["كِتَٰبٖ","Писания",29,48]],[["وَلَا","и не",29,48],["تَخُطُّهُۥ","писал его",29,48],["بِيَمِينِكَۖ","своей десницей",29,48],["إِذٗا","тогда",29,48],["لَّٱرۡتَابَ","непременно усомнились бы",29,48],["ٱلۡمُبۡطِلُونَ","приверженцы лжи",29,48],[48],["بَلۡ","нет же",29,49],["هُوَ","это",29,49]],[["ءَايَٰتُۢ","знамения",29,49],["بَيِّنَٰتٞ","ясные",29,49],["فِي","в",29,49],["صُدُورِ","груди",29,49],["ٱلَّذِينَ","тех, которым",29,49],["أُوتُواْ","даровано",29,49],["ٱلۡعِلۡمَۚ","знание",29,49],["وَمَا","и не",29,49],["يَجۡحَدُ","отвергает",29,49]],[["بِـَٔايَٰتِنَآ","Наши знамения",29,49],["إِلَّا","кроме",29,49],["ٱلظَّٰلِمُونَ","беззаконников",29,49],[49],["وَقَالُواْ","и они сказали",29,50],["لَوۡلَآ","почему не",29,50],["أُنزِلَ","ниспосланы",29,50],["عَلَيۡهِ","ему",29,50]],[["ءَايَٰتٞ","знамения",29,50],["مِّن","от",29,50],["رَّبِّهِۦۚ","его Господа",29,50],["قُلۡ","скажи",29,50],["إِنَّمَا","лишь",29,50],["ٱلۡأٓيَٰتُ","знамения",29,50],["عِندَ","у",29,50],["ٱللَّهِ","Аллаха",29,50],["وَإِنَّمَآ","и лишь",29,50],["أَنَا۠","я",29,50],["نَذِيرٞ","увещеватель",29,50]],[["مُّبِينٌ","ясный",29,50],[50],["أَوَلَمۡ","разве же не",29,51],["يَكۡفِهِمۡ","достаточно им",29,51],["أَنَّآ","что Мы",29,51],["أَنزَلۡنَا","ниспослали",29,51],["عَلَيۡكَ","тебе",29,51],["ٱلۡكِتَٰبَ","Писание",29,51]],[["يُتۡلَىٰ","читается",29,51],["عَلَيۡهِمۡۚ","им",29,51],["إِنَّ","поистине",29,51],["فِي","в",29,51],["ذَٰلِكَ","этом",29,51],["لَرَحۡمَةٗ","непременно милость",29,51],["وَذِكۡرَىٰ","и напоминание",29,51],["لِقَوۡمٖ","для людей",29,51]],[["يُؤۡمِنُونَ","верующих",29,51],[51],["قُلۡ","скажи",29,52],["كَفَىٰ","довольно",29,52],["بِٱللَّهِ","Аллаха",29,52],["بَيۡنِي","между мной",29,52],["وَبَيۡنَكُمۡ","и между вами",29,52],["شَهِيدٗاۖ","Свидетелем",29,52]],[["يَعۡلَمُ","Он знает",29,52],["مَا","то, что",29,52],["فِي","в",29,52],["ٱلسَّمَٰوَٰتِ","небесах",29,52],["وَٱلۡأَرۡضِۗ","и земле",29,52],["وَٱلَّذِينَ","а те, которые",29,52],["ءَامَنُواْ","уверовали",29,52]],[["بِٱلۡبَٰطِلِ","в ложь",29,52],["وَكَفَرُواْ","и не уверовали",29,52],["بِٱللَّهِ","в Аллаха",29,52],["أُوْلَٰٓئِكَ","те",29,52],["هُمُ","они",29,52],["ٱلۡخَٰسِرُونَ","потерпевшие убыток",29,52],[52]]]}