َهُ","Аллах",29,60],["يَرۡزُقُهَا","наделяет пропитанием их",29,60],["وَإِيَّاكُمۡۚ","и вас",29,60],["وَهُوَ","и Он",29,60],["ٱلسَّمِيعُ","Слышащий",29,60],["ٱلۡعَلِيمُ","Знающий",29,60],[60],["وَلَئِن","и если",29,61]],[["سَأَلۡتَهُم","ты спросишь их",29,61],["مَّنۡ","кто",29,61],["خَلَقَ","создал",29,61],["ٱلسَّمَٰوَٰتِ","небеса",29,61],["وَٱلۡأَرۡضَ","и землю",29,61],["وَسَخَّرَ","и подчинил",29,61],["ٱلشَّمۡسَ","солнце",29,61],["وَٱلۡقَمَرَ","и луну",29,61]],[["لَيَقُولُنَّ","непременно они скажут",29,61],["ٱللَّهُۖ","Аллах",29,61],["فَأَنَّىٰ","так как же",29,61],["يُؤۡفَكُونَ","они отвращены",29,61],[61],["ٱللَّهُ","Аллах",29,62],["يَبۡسُطُ","расширяет",29,62],["ٱلرِّزۡقَ","удел",29,62],["لِمَن","тому, кому",29,62],["يَشَآءُ","Он пожелает",29,62],["مِنۡ","из",29,62]],[["عِبَادِهِۦ","Своих рабов",29,62],["وَيَقۡدِرُ","и ограничивает",29,62],["لَهُۥٓۚ","ему",29,62],["إِنَّ","поистине",29,62],["ٱللَّهَ","Аллах",29,62],["بِكُلِّ","о всякой",29,62],["شَيۡءٍ","вещи",29,62],["عَلِيمٞ","Знающий",29,62],[62],["وَلَئِن","и если",29,63],["سَأَلۡتَهُم","ты спросишь их",29,63]],[["مَّن","кто",29,63],["نَّزَّلَ","ниспослал",29,63],["مِنَ","с",29,63],["ٱلسَّمَآءِ","неба",29,63],["مَآءٗ","воду",29,63],["فَأَحۡيَا","и оживил",29,63],["بِهِ","ею",29,63],["ٱلۡأَرۡضَ","землю",29,63],["مِنۢ","из",29,63],["بَعۡدِ","после",29,63],["مَوۡتِهَا","её смерти",29,63]],[["لَيَقُولُنَّ","непременно они скажут",29,63],["ٱللَّهُۚ","Аллах",29,63],["قُلِ","скажи",29,63],["ٱلۡحَمۡدُ","хвала",29,63],["لِلَّهِۚ","Аллаху",29,63],["بَلۡ","но",29,63],["أَكۡثَرُهُمۡ","большинство их",29,63],["لَا","не",29,63],["يَعۡقِلُونَ","разумеют",29,63],[63]]]}