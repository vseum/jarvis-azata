{"p":403,"j":21,"a":[[29,53,["وَيَسۡتَعۡجِلُونَكَ","بِٱلۡعَذَابِ","وَلَوۡلَآ","أَجَلٞ","مُّسَمّٗى","لَّجَآءَهُمُ","ٱلۡعَذَابُۚ","وَلَيَأۡتِيَنَّهُم","بَغۡتَةٗ","وَهُمۡ","لَا","يَشۡعُرُونَ"],"вайаста`жилуунака бил`азаби валаула ажалум мусаммал лажаахумул `азабу валайа'тийаннахум багтатан вахум ла йаш`уруун","Они торопят тебя с мучениями. Если бы не назначенный срок, то мучения уже явились бы к ним. Воистину, они явятся к ним внезапно, и они даже не почувствуют этого.",["и они торопят тебя","с наказанием","и если бы не","срок","назначенный","непременно пришло бы к ним","наказание","и непременно придёт к ним","внезапно","а они","не","почувствуют"]],[29,54,["يَسۡتَعۡجِلُونَكَ","بِٱلۡعَذَابِ","وَإِنَّ","جَهَنَّمَ","لَمُحِيطَةُۢ","بِٱلۡكَٰفِرِينَ"],"йаста`жилуунака бил`азаби ва'инна жаханнама ламухиитату билкафириин","Они торопят тебя с мучениями. Воистину, Геенна непременно обступит неверующих.",["они торопят тебя","с наказанием","и поистине","Геенна","непременно объемлет","неверующих"]],[29,55,["يَوۡمَ","يَغۡشَىٰهُمُ","ٱلۡعَذَابُ","مِن","فَوۡقِهِمۡ","وَمِن","تَحۡتِ","أَرۡجُلِهِمۡ","وَيَقُولُ","ذُوقُواْ","مَا","كُنتُمۡ","تَعۡمَلُونَ"],"йаума йагшахумул `азабу мин фауḳихим вамин тахти аржулихим вайаḳуулу зууḳуу ма кунтум та`малуун","В тот день мучения покроют их сверху и из-под ног. Он скажет: «Вкусите то, что вы совершали!».",["в день","покроет их","наказание","из","над ними","и из","под","их ног","и Он скажет","вкусите","то, что","вы были","совершающими"]],[29,56,["يَٰعِبَادِيَ","ٱلَّذِينَ","ءَامَنُوٓاْ","إِنَّ","أَرۡضِي","وَٰسِعَةٞ","فَإِيَّٰيَ","فَٱعۡبُدُونِ"],"йа`ибадийал лазиина амануу инна ардии васи`атун фа'иййайа фа`будуун","О Мои верующие рабы! Воистину, Моя земля обширна, поклоняйтесь же Мне!",["о Мои рабы","которые","уверовали","поистине","Моя земля","обширна","и Мне одному","же поклоняйтесь Мне"]],[29,57,["كُلُّ","نَفۡسٖ","ذَآئِقَةُ","ٱلۡمَوۡتِۖ","ثُمَّ","إِلَيۡنَا","تُرۡجَعُونَ"],"куллу нафсин заиḳатул маути сумма илайна туржа`уун","Каждая душа вкусит смерть, а потом вы будете возвращены к Нам.",["каждая","душа","вкусит","смерть","затем","к Нам","будете возвращены"]],[29,58,["وَٱلَّذِينَ","ءَامَنُواْ","وَعَمِلُواْ","ٱلصَّٰلِحَٰتِ","لَنُبَوِّئَنَّهُم","مِّنَ","ٱلۡجَنَّةِ","غُرَفٗا","تَجۡرِي","مِن","تَحۡتِهَا","ٱلۡأَنۡهَٰرُ","خَٰلِدِينَ","فِيهَاۚ","نِعۡمَ","أَجۡرُ","ٱلۡعَٰمِلِينَ"],"валлазиина амануу ва`амилус салихати ланубаввианнахум минал жаннати гурафан тажрии мин тахтихал анхару халидиина фииха ни`ма ажрул `амилиин","Тех, которые уверовали и совершали праведные деяния, Мы непременно поселим в горницах в Раю, в котором текут реки. Они пребудут там вечно. Как же прекрасно вознаграждение тружеников,",["и тех, которые","уверовали","и совершали","праведные деяния","непременно Мы поселим их","в","Раю","в горницах","текут","из","под ними","реки","вечно пребывая","там","как прекрасна","награда","тружеников"]],[29,59,["ٱلَّذِينَ","صَبَرُواْ","وَعَلَىٰ","رَبِّهِمۡ","يَتَوَكَّلُونَ"],"аллазиина сабаруу ва`ала раббихим йатаваккалуун","которые были терпеливы и уповали на своего Господа!",["те, которые","терпели","и на","своего Господа","уповают"]],[29,60,["وَكَأَيِّن","مِّن","دَآبَّةٖ","لَّا","تَحۡمِلُ","رِزۡقَهَا","ٱللَّهُ","يَرۡزُقُهَا","وَإِيَّاكُمۡۚ","وَهُوَ","ٱلسَّمِيعُ","ٱلۡعَلِيمُ"],"вакааййим мин даббатил ла тахмилу ризḳахаллаху йарзуḳуха ва'иййакум вахуас самии`ул `алиим","Сколько есть живых существ, которые не уносят своего пропитания (или не запасаются своим пропитанием)! Аллах наделяет пропитанием их и вас. Он - Слышащий, Знающий.",["и сколько","из","живых существ","не","несут","своего пропитания","Аллах","наделяет пропитанием их","и вас","и Он","Слышащий","Знающий"]],[29,61,["وَلَئِن","سَأَلۡتَهُم","مَّنۡ","خَلَقَ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضَ","وَسَخَّرَ","ٱلشَّمۡسَ","وَٱلۡقَمَرَ","لَيَقُولُنَّ","ٱللَّهُۖ","فَأَنَّىٰ","يُؤۡفَكُونَ"],"валаин са'алтахум ман халаḳас самавати вал'арда васаххараш шамса валḳамара лайаḳуулунналлаху фа'анна йу'факуун","Если ты спросишь их: «Кто создал небеса и землю и подчинил солнце и луну?». - они непременно скажут: «Аллах». До чего же они отвращены от истины!",["и если","ты спросишь их","кто","создал","небеса","и землю","и подчинил","солнце","и луну","непременно они скажут","Аллах","так как же","они отвращены"]],[29,62,["ٱللَّهُ","يَبۡسُطُ","ٱلرِّزۡقَ","لِمَن","يَشَآءُ","مِنۡ","عِبَادِهِۦ","وَيَقۡدِرُ","لَهُۥٓۚ","إِنَّ","ٱللَّهَ","بِكُلِّ","شَيۡءٍ","عَلِيمٞ"],"аллаху йабсутур ризḳа лиман йашау мин `ибадихии вайаḳдиру лахуу инналлаха бикулли шай'ин `алиим","Аллах увеличивает или ограничивает удел тому из Своих рабов, кому пожелает. Воистину, Аллах знает о всякой вещи.",["Аллах","расширяет","удел","тому, кому","Он пожелает","из","Своих рабов","и ограничивает","ему","поистине","Аллах","о всякой","вещи","Знающий"]],[29,63,["وَلَئِن","سَأَلۡتَهُم","مَّن","نَّزَّلَ","مِنَ","ٱلسَّمَآءِ","مَآءٗ","فَأَحۡيَا","بِهِ","ٱلۡأَرۡضَ","مِنۢ","بَعۡدِ","مَوۡتِهَا","لَيَقُولُنَّ","ٱللَّهُۚ","قُلِ","ٱلۡحَمۡدُ","لِلَّهِۚ","بَلۡ","أَكۡثَرُهُمۡ","لَا","يَعۡقِلُونَ"],"валаин са'алтахум ман наззала минас самаи маан фа'ахйа бихил арда мим ба`ди маутиха лайаḳуулунналлаху ḳулил хамду лиллахи бал аксарухум ла йа`ḳилуун","Если ты спросишь их: «Кто ниспосылает с неба воду и оживляет ею землю после того, как она умерла?». - они непременно скажут: «Аллах». Скажи: «Хвала Аллаху!». Но большинство их не разумеет.",["и если","ты спросишь их","кто","ниспослал","с","неба","воду","и оживил","ею","землю","из","после","её смерти","непременно они скажут","Аллах","скажи","хвала","Аллаху","но","большинство их","не","разумеют"]]],"m":[[["وَيَسۡتَعۡجِلُونَكَ","и они торопят тебя",29,53],["بِٱلۡعَذَابِ","с наказанием",29,53],["وَلَوۡلَآ","и если бы не",29,53],["أَجَلٞ","срок",29,53],["مُّسَمّٗى","назначенный",29,53],["لَّجَآءَهُمُ","непременно пришло бы к ним",29,53],["ٱلۡعَذَابُۚ","наказание",29,53]],[["وَلَيَأۡتِيَنَّهُم","и непременно придёт к ним",29,53],["بَغۡتَةٗ","внезапно",29,53],["وَهُمۡ","а они",29,53],["لَا","не",29,53],["يَشۡعُرُونَ","почувствуют",29,53],[53],["يَسۡتَعۡجِلُو