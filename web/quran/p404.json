{"p":404,"j":21,"a":[[29,64,["وَمَا","هَٰذِهِ","ٱلۡحَيَوٰةُ","ٱلدُّنۡيَآ","إِلَّا","لَهۡوٞ","وَلَعِبٞۚ","وَإِنَّ","ٱلدَّارَ","ٱلۡأٓخِرَةَ","لَهِيَ","ٱلۡحَيَوَانُۚ","لَوۡ","كَانُواْ","يَعۡلَمُونَ"],"вама хазихил хайаватуд дунйа илла лахвун вала`ибун ва'иннад дарал ахирата лахийал хайавану лау кануу йа`ламуун","Мирская жизнь - всего лишь потеха и игра, а Последняя обитель - это настоящая жизнь. Если бы они только знали это!",["и не","эта","жизнь","мирская","кроме","потеха","и игра","и поистине","обитель","Последняя","непременно она","(истинная) жизнь","если бы","они","знали"]],[29,65,["فَإِذَا","رَكِبُواْ","فِي","ٱلۡفُلۡكِ","دَعَوُاْ","ٱللَّهَ","مُخۡلِصِينَ","لَهُ","ٱلدِّينَ","فَلَمَّا","نَجَّىٰهُمۡ","إِلَى","ٱلۡبَرِّ","إِذَا","هُمۡ","يُشۡرِكُونَ"],"фа'иза ракибуу фил фулки да`авуллаха мухлисиина лахуд диина фаламма нажжахум илал барри иза хум йушрикуун","Когда они садятся на корабль, то взывают к Аллаху, очищая перед Ним свою веру. Когда же Он спасает их и выводит на сушу, они тотчас начинают приобщать сотоварищей.",["а когда","они садятся","на","корабль","они взывают к","Аллаху","очищая","перед Ним","веру","а когда","Он спасает их","на","сушу","тотчас","они","приобщают сотоварищей"]],[29,66,["لِيَكۡفُرُواْ","بِمَآ","ءَاتَيۡنَٰهُمۡ","وَلِيَتَمَتَّعُواْۚ","فَسَوۡفَ","يَعۡلَمُونَ"],"лийакфуруу бима атайнахум валийатаматта`уу фасауфа йа`ламуун","Это происходит для того, чтобы они проявили неблагодарность за то, чем Мы их одарили, и могли попользоваться благами, но скоро они узнают.",["чтобы они проявили неблагодарность","за то, что","Мы даровали им","и чтобы пользовались","но скоро","они узнают"]],[29,67,["أَوَلَمۡ","يَرَوۡاْ","أَنَّا","جَعَلۡنَا","حَرَمًا","ءَامِنٗا","وَيُتَخَطَّفُ","ٱلنَّاسُ","مِنۡ","حَوۡلِهِمۡۚ","أَفَبِٱلۡبَٰطِلِ","يُؤۡمِنُونَ","وَبِنِعۡمَةِ","ٱللَّهِ","يَكۡفُرُونَ"],"авалам йарау анна жа`ална хараман аминан вайутахаттафун насу мин хаулихим афабилбатили йу'минууна вабини`матиллахи йакфуруун","Неужели они не видят, что Мы сделали Мекку безопасным святилищем, тогда как вокруг них людей хватают? Неужели они веруют в ложь и не веруют в милость Аллаха?",["разве же не","видят они","что Мы","сделали","святилище","безопасным","а похищаются","люди","из","вокруг них","неужели же в ложь","они веруют","а в милость","Аллаха","не веруют"]],[29,68,["وَمَنۡ","أَظۡلَمُ","مِمَّنِ","ٱفۡتَرَىٰ","عَلَى","ٱللَّهِ","كَذِبًا","أَوۡ","كَذَّبَ","بِٱلۡحَقِّ","لَمَّا","جَآءَهُۥٓۚ","أَلَيۡسَ","فِي","جَهَنَّمَ","مَثۡوٗى","لِّلۡكَٰفِرِينَ"],"ваман азламу мимманифтара `алаллахи казибан ау каззаба билхаḳḳи ламма жаахуу алайса фии жаханнама масвал лилкафириин","Кто может быть несправедливее того, кто возводит навет на Аллаха или считает ложью истину, которая явилась к нему? Разве не в Геенне будет обитель неверующих?",["и кто","несправедливее","того, кто","измыслил","на","Аллаха","ложь","или","счёл ложью","истину","когда","она пришла к нему","разве не","в","Геенне","обитель","для неверующих"]],[29,69,["وَٱلَّذِينَ","جَٰهَدُواْ","فِينَا","لَنَهۡدِيَنَّهُمۡ","سُبُلَنَاۚ","وَإِنَّ","ٱللَّهَ","لَمَعَ","ٱلۡمُحۡسِنِينَ"],"валлазиина жахадуу фиина ланахдийаннахум субулана ва'инналлаха лама`ал мухсиниин","А тех, которые сражаются ради Нас, Мы непременно поведем Нашими путями. Воистину, Аллах - с творящими добро!",["а те, которые","усердствовали","ради Нас","Мы непременно поведём их","Нашими путями","и поистине","Аллах","непременно с","творящими добро"]],[30,1,["الٓمٓ"],"лм","Алиф. Лам. Мим.",["Алиф. Лам. Мим"]],[30,2,["غُلِبَتِ","ٱلرُّومُ"],"гулибатир руум","Повержены римляне",["побеждены","римляне"]],[30,3,["فِيٓ","أَدۡنَى","ٱلۡأَرۡضِ","وَهُم","مِّنۢ","بَعۡدِ","غَلَبِهِمۡ","سَيَغۡلِبُونَ"],"фии аднал арди вахум мим ба`ди галабихим сайаглибуун","в самой низкой (или ближайшей) земле. Но после своего поражения они одержат верх",["в","ближайшей","земле","но они","вслед","за","своим поражением","победят"]],[30,4,["فِي","بِضۡعِ","سِنِينَۗ","لِلَّهِ","ٱلۡأَمۡرُ","مِن","قَبۡلُ","وَمِنۢ","بَعۡدُۚ","وَيَوۡمَئِذٖ","يَفۡرَحُ","ٱلۡمُؤۡمِنُونَ"],"фии бид`и синиина лиллахил амру мин ḳаблу вамим ба`ду вайаумаизин йафрахул му'минуун","через несколько (от трех до десяти) лет. Аллах принимал решения до этого и будет принимать их после этого. В тот день верующие возрадуются",["в течение","нескольких","лет","Аллаху принадлежит","решение","до","этого","и после","этого","и в тот день","возрадуются","верующие"]],[30,5,["بِنَصۡرِ","ٱللَّهِۚ","يَنصُرُ","مَن","يَشَآءُۖ","وَهُوَ","ٱلۡعَزِيزُ","ٱلرَّحِيمُ"],"бинасриллахи йансуру ман йашау вахуал `азиизур рахиим","помощи Аллаха. Он помогает, кому пожелает. Он - Могущественный, Милосердный.",["помощи","Аллаха","Он помогает","кому","пожелает","и Он","Могущественный","Милосердный"]]],"m":[[["وَمَا","и не",29,64],["هَٰذِهِ","эта",29,64],["ٱلۡحَيَوٰةُ","жизнь",29,64],["ٱلدُّنۡيَآ","мирская",29,64],["إِلَّا","кроме",29,64],["لَهۡوٞ","потеха",29,64],["وَلَعِبٞۚ","и игра",29,64],["وَإِنَّ","и поистине",29,64],["ٱلدَّارَ","обитель",29,64],["ٱلۡأٓخِرَةَ","Последняя",29,64]],[["لَهِيَ","непременно она",29,64],["ٱلۡحَيَوَانُۚ","(истинная) жизнь",29,64],["لَوۡ","если бы",29,64],["كَانُواْ","они",29,64],["يَعۡلَمُونَ","знали",29,64],[64],["فَإِذَا","а когда",29,65],["رَكِبُواْ","они садятся",29,65],["فِي","на",29,65]],[["ٱلۡفُلۡكِ","корабль",29,65],["دَعَوُاْ","они взывают к",29,65],["ٱللَّهَ","Аллаху",29,65],["مُخۡلِصِينَ","очищая",29,65],["لَهُ","перед Ним",29,65],["ٱلدِّينَ","веру",29,65],["فَلَمَّا","а когда",29,65],["نَجَّىٰهُمۡ","Он спасает их",29,65],["إِلَى","на",29,65],["ٱلۡبَرِّ","сушу",29,65],["إِذَا","тотчас",29,65]],[["هُمۡ","они",29,65],["يُشۡرِكُونَ","приобщают сотоварищей",29,65],[65],["لِيَكۡفُرُواْ","чтобы они проявили неблагодарность",29,66],["بِمَآ","за то, что",29,66],["ءَاتَيۡنَٰهُمۡ","Мы даровали им",29,66],["وَلِيَتَمَتَّعُواْۚ","и чтобы пользовались",29,66],["فَسَوۡفَ","но скоро",29,66]],[["يَعۡلَمُونَ","они узнают",29,66],[66],["أَوَلَمۡ","разве же не",29,67],["يَرَوۡاْ","видят они",29,67],["أَنَّا","что Мы",29,67],["جَعَلۡنَا","сделали",29,67],["حَرَمًا","святилище",29,67]