{"p":405,"j":21,"a":[[30,6,["وَعۡدَ","ٱللَّهِۖ","لَا","يُخۡلِفُ","ٱللَّهُ","وَعۡدَهُۥ","وَلَٰكِنَّ","أَكۡثَرَ","ٱلنَّاسِ","لَا","يَعۡلَمُونَ"],"ва`даллахи ла йухлифуллаху ва`дахуу валакинна аксаран наси ла йа`ламуун","Таково обещание Аллаха, и Аллах не нарушает Своего обещания, однако большинство людей не знают этого.",["обещание","Аллаха","не","нарушает","Аллах","Своего обещания","однако","большинство","людей","не","знают"]],[30,7,["يَعۡلَمُونَ","ظَٰهِرٗا","مِّنَ","ٱلۡحَيَوٰةِ","ٱلدُّنۡيَا","وَهُمۡ","عَنِ","ٱلۡأٓخِرَةِ","هُمۡ","غَٰفِلُونَ"],"йа`ламууна захирам минал хайаватид дунйа вахум `анил ахирати хум гафилуун","Они знают о мирской жизни только явное, и они беспечны к Последней жизни.",["знают","явное","из","жизни","мирской","а они","о","Последней жизни","они","беспечны"]],[30,8,["أَوَلَمۡ","يَتَفَكَّرُواْ","فِيٓ","أَنفُسِهِمۗ","مَّا","خَلَقَ","ٱللَّهُ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضَ","وَمَا","بَيۡنَهُمَآ","إِلَّا","بِٱلۡحَقِّ","وَأَجَلٖ","مُّسَمّٗىۗ","وَإِنَّ","كَثِيرٗا","مِّنَ","ٱلنَّاسِ","بِلِقَآيِٕ","رَبِّهِمۡ","لَكَٰفِرُونَ"],"авалам йатафаккаруу фии анфусихим ма халаḳаллахус самавати вал'арда вама байнахума илла билхаḳḳи ва'ажалим мусамман ва'инна касиирам минан наси билиḳайи раббихим лакафируун","Неужели они не размышляли о самих себе? Аллах создал небеса, землю и то, что между ними, только ради истины и только на определенный срок. Но многие люди не веруют во встречу со своим Господом.",["разве не","поразмыслили они","о","самих себе","не","создал","Аллах","небеса","и землю","и то, что","между ними","кроме как","истиной","и на срок","определённый","и поистине","многие","из","людей","во встречу","со своим Господом","непременно неверующие"]],[30,9,["أَوَلَمۡ","يَسِيرُواْ","فِي","ٱلۡأَرۡضِ","فَيَنظُرُواْ","كَيۡفَ","كَانَ","عَٰقِبَةُ","ٱلَّذِينَ","مِن","قَبۡلِهِمۡۚ","كَانُوٓاْ","أَشَدَّ","مِنۡهُمۡ","قُوَّةٗ","وَأَثَارُواْ","ٱلۡأَرۡضَ","وَعَمَرُوهَآ","أَكۡثَرَ","مِمَّا","عَمَرُوهَا","وَجَآءَتۡهُمۡ","رُسُلُهُم","بِٱلۡبَيِّنَٰتِۖ","فَمَا","كَانَ","ٱللَّهُ","لِيَظۡلِمَهُمۡ","وَلَٰكِن","كَانُوٓاْ","أَنفُسَهُمۡ","يَظۡلِمُونَ"],"авалам йасиируу фил арди файанзуруу кайфа кана `аḳибатул лазиина мин ḳаблихим кануу ашадда минхум ḳувватан ва'асарул арда ва`амарууха аксара мимма `амарууха важаатхум русулухум билбаййинати фама каналлаху лийазлимахум валакин кануу анфусахум йазлимуун","Неужели они не странствовали по земле и не видели, каким был конец тех, кто был до них? Они превосходили их силой, возделывали землю и отстраивали ее лучше, чем это делают они (мекканские язычники). Их посланники приносили им ясные знамения. Аллах не был несправедлив к ним - они сами поступили несправедливо по отношению к себе.",["разве не","странствовали они","по","земле","и не видели","каким","был","конец","тех, которые","до","них","были они","сильнее","их","силой","и вспахивали","землю","и возделывали её","больше","чем","возделали её они","и приходили к ним","их посланники","с ясными знамениями","и не","был","Аллах","чтобы обидеть их","однако","были они","самих себя","обижающими"]],[30,10,["ثُمَّ","كَانَ","عَٰقِبَةَ","ٱلَّذِينَ","أَسَٰٓـُٔواْ","ٱلسُّوٓأَىٰٓ","أَن","كَذَّبُواْ","بِـَٔايَٰتِ","ٱللَّهِ","وَكَانُواْ","بِهَا","يَسۡتَهۡزِءُونَ"],"сумма кана `аḳибатал лазиина асаус сууа ан каззабуу би'айатиллахи вакануу биха йастахзиуун","Концом тех, кто творил зло, стало зло, потому что они сочли ложью знамения Аллаха и насмехались над ними.",["затем","был","конец","тех, которые","творили зло","наихудшим","за то, что","сочли ложью","знамения","Аллаха","и были","над ними","насмехающимися"]],[30,11,["ٱللَّهُ","يَبۡدَؤُاْ","ٱلۡخَلۡقَ","ثُمَّ","يُعِيدُهُۥ","ثُمَّ","إِلَيۡهِ","تُرۡجَعُونَ"],"аллаху йабдаул халḳа сумма йу`иидухуу сумма илайхи туржа`уун","Аллах создает творение в первый раз, а затем воссоздает его. А после этого вы будете возвращены к Нему.",["Аллах","начинает","творение","затем","Он повторяет его","затем","к Нему","вы будете возвращены"]],[30,12,["وَيَوۡمَ","تَقُومُ","ٱلسَّاعَةُ","يُبۡلِسُ","ٱلۡمُجۡرِمُونَ"],"вайаума таḳуумус са`ату йублисул 