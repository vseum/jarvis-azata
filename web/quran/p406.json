{"p":406,"j":21,"a":[[30,16,["وَأَمَّا","ٱلَّذِينَ","كَفَرُواْ","وَكَذَّبُواْ","بِـَٔايَٰتِنَا","وَلِقَآيِٕ","ٱلۡأٓخِرَةِ","فَأُوْلَٰٓئِكَ","فِي","ٱلۡعَذَابِ","مُحۡضَرُونَ"],"ва'аммал лазиина кафаруу ваказзабуу би'айатина валиḳайил ахирати фа'улаика фил `азаби мухдаруун","А те, которые не уверовали и сочли ложью Наши знамения и встречу в Последней жизни, будут испытывать мучения.",["а что до","тех, которые","не уверовали","и сочли ложью","Наши знамения","и встречу","в Последней жизни","то те","в","мучении","будут приведены"]],[30,17,["فَسُبۡحَٰنَ","ٱللَّهِ","حِينَ","تُمۡسُونَ","وَحِينَ","تُصۡبِحُونَ"],"фасубханаллахи хиина тумсууна вахиина тусбихуун","Славьте же Аллаха, когда для вас наступает вечер и когда наступает утро!",["пречист же","Аллах","когда","вы встречаете вечер","и когда","вы встречаете утро"]],[30,18,["وَلَهُ","ٱلۡحَمۡدُ","فِي","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِ","وَعَشِيّٗا","وَحِينَ","تُظۡهِرُونَ"],"валахул хамду фис самавати вал'арди ва`ашиййан вахиина тузхируун","Ему надлежит хвала на небесах и на земле. Славьте Его после полудня и в полдень!",["и Ему","хвала","на","небесах","и на земле","и вечером","и когда","вы встречаете полдень"]],[30,19,["يُخۡرِجُ","ٱلۡحَيَّ","مِنَ","ٱلۡمَيِّتِ","وَيُخۡرِجُ","ٱلۡمَيِّتَ","مِنَ","ٱلۡحَيِّ","وَيُحۡيِ","ٱلۡأَرۡضَ","بَعۡدَ","مَوۡتِهَاۚ","وَكَذَٰلِكَ","تُخۡرَجُونَ"],"йухрижул хаййа минал маййити вайухрижул маййита минал хаййи вайухйил арда ба`да маутиха ваказалика тухражуун","Он выводит живое из мертвого и выводит мертвое из живого. Он оживляет землю после ее смерти, и таким же образом вы будете выведены из могил.",["Он выводит","живое","из","мёртвого","и выводит","мёртвое","из","живого","и оживляет","землю","после","её смерти","и так же","вы будете выведены"]],[30,20,["وَمِنۡ","ءَايَٰتِهِۦٓ","أَنۡ","خَلَقَكُم","مِّن","تُرَابٖ","ثُمَّ","إِذَآ","أَنتُم","بَشَرٞ","تَنتَشِرُونَ"],"вамин айатихии ан халаḳакум мин турабин сумма иза антум башарун танташируун","Среди Его знамений - то, что Он сотворил вас из земли. После этого вы стали родом человеческим и расселяетесь.",["и из","Его знамений","то, что","Он создал вас","из","праха","затем","вот","вы","люди","расселяетесь"]],[30,21,["وَمِنۡ","ءَايَٰتِهِۦٓ","أَنۡ","خَلَقَ","لَكُم","مِّنۡ","أَنفُسِكُمۡ","أَزۡوَٰجٗا","لِّتَسۡكُنُوٓاْ","إِلَيۡهَا","وَجَعَلَ","بَيۡنَكُم","مَّوَدَّةٗ","وَرَحۡمَةًۚ","إِنَّ","فِي","ذَٰلِكَ","لَأٓيَٰتٖ","لِّقَوۡمٖ","يَتَفَكَّرُونَ"],"вамин айатихии ан халаḳа лакум мин анфусикум азважал литаскунуу илайха важа`ала байнакум маваддатан варахматан инна фии залика ла'айатил лиḳаумин йатафаккаруун","Среди Его знамений - то, что Он сотворил из вас самих жен для вас, чтобы вы находили в них успокоение, и установил между вами любовь и милосердие. Воистину, в этом - знамения для людей размышляющих.",["и из","Его знамений","то, что","Он создал","для вас","из","вас самих","жён","чтобы вы находили покой","у них","и установил","между вами","любовь","и милосердие","поистине","в","этом","непременно знамения","для людей","размышляющих"]],[30,22,["وَمِنۡ","ءَايَٰتِهِۦ","خَلۡقُ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِ","وَٱخۡتِلَٰفُ","أَلۡسِنَتِكُمۡ","وَأَلۡوَٰنِكُمۡۚ","إِنَّ","فِي","ذَٰلِكَ","لَأٓيَٰتٖ","لِّلۡعَٰلِمِينَ"],"вамин айатихии халḳус самавати вал'арди вахтилафу алсинатикум ва'алваникум инна фии залика ла'айатил лил`алимиин","Среди Его знамений - сотворение небес и земли и различие ваших языков и цветов. Воистину, в этом - знамения для обладающих знанием.",["и из","Его знамений","сотворение","небес","и земли","и различие","ваших языков","и ваших цветов","поистине","в","этом","непременно знамения","для знающих"]],[30,23,["وَمِنۡ","ءَايَٰتِهِۦ","مَنَامُكُم","بِٱلَّيۡلِ","وَٱلنَّهَارِ","وَٱبۡتِغَآؤُكُم","مِّن","فَضۡلِهِۦٓۚ","إِنَّ","فِي","ذَٰلِكَ","لَأٓيَٰتٖ","لِّقَوۡمٖ","يَسۡمَعُونَ"],"вамин айатихии манамукум биллайли ваннахари вабтигаукум мин фадлихии инна фии залика ла'айатил лиḳаумин йасма`уун","Среди Его знамений - ваш ночной и дневной сон и ваши поиски Его милости. Воистину, в этом - знамения для людей слышащих.",["и из","Его з