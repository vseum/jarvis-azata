{"p":407,"j":21,"a":[[30,25,["وَمِنۡ","ءَايَٰتِهِۦٓ","أَن","تَقُومَ","ٱلسَّمَآءُ","وَٱلۡأَرۡضُ","بِأَمۡرِهِۦۚ","ثُمَّ","إِذَا","دَعَاكُمۡ","دَعۡوَةٗ","مِّنَ","ٱلۡأَرۡضِ","إِذَآ","أَنتُمۡ","تَخۡرُجُونَ"],"вамин айатихии ан таḳуумас самау вал'арду би'амрихии сумма иза да`акум да`ватам минал арди иза антум тахружуун","Среди Его знамений - то, что небо и земля держатся по Его воле. Потом Он позовет вас всего один раз, и вы выйдете из могил.",["и из","Его знамений","то, что","стоит","небо","и земля","по Его повелению","затем","когда","Он позовёт вас","зовом","из","земли","вот","вы","выйдете"]],[30,26,["وَلَهُۥ","مَن","فِي","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِۖ","كُلّٞ","لَّهُۥ","قَٰنِتُونَ"],"валахуу ман фис самавати вал'арди куллул лахуу ḳанитуун","Ему принадлежат те, кто на небесах и на земле. Все они покорны Ему.",["и Ему принадлежат","те, кто","на","небесах","и на земле","все","Ему","покорны"]],[30,27,["وَهُوَ","ٱلَّذِي","يَبۡدَؤُاْ","ٱلۡخَلۡقَ","ثُمَّ","يُعِيدُهُۥ","وَهُوَ","أَهۡوَنُ","عَلَيۡهِۚ","وَلَهُ","ٱلۡمَثَلُ","ٱلۡأَعۡلَىٰ","فِي","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِۚ","وَهُوَ","ٱلۡعَزِيزُ","ٱلۡحَكِيمُ"],"вахуал лазии йабдаул халḳа сумма йу`иидухуу вахуа ахвану `алайхи валахул масалул а`ла фис самавати вал'арди вахуал `азиизул хакиим","Он - Тот, Кто создает творения в первый раз, а затем воссоздает их, и сделать это для Него еще легче. Ему принадлежат наивысшие качества на небесах и на земле. Он - Могущественный, Мудрый.",["и Он","Тот, Кто","начинает","творение","затем","повторяет его","и это","легче","для Него","и Ему","описание","высочайшее","на","небесах","и на земле","и Он","Могущественный","Мудрый"]],[30,28,["ضَرَبَ","لَكُم","مَّثَلٗا","مِّنۡ","أَنفُسِكُمۡۖ","هَل","لَّكُم","مِّن","مَّا","مَلَكَتۡ","أَيۡمَٰنُكُم","مِّن","شُرَكَآءَ","فِي","مَا","رَزَقۡنَٰكُمۡ","فَأَنتُمۡ","فِيهِ","سَوَآءٞ","تَخَافُونَهُمۡ","كَخِيفَتِكُمۡ","أَنفُسَكُمۡۚ","كَذَٰلِكَ","نُفَصِّلُ","ٱلۡأٓيَٰتِ","لِقَوۡمٖ","يَعۡقِلُونَ"],"дараба лакум масалам мин анфусикум хал лакум мим ма малакат айманукум мин шуракаа фии ма разаḳнакум фа'антум фиихи саваун тахафуунахум кахиифатикум анфусакум казалика нуфассилул айати лиḳаумин йа`ḳилуун","Он привел вам притчу о вас самих. Есть ли среди невольников, которыми овладели ваши десницы, совладельцы того, чем Мы наделили вас, которые имеют с вами одинаковые права на это и которых вы опасаетесь так, как опасаетесь друг друга? Так Мы разъясняем знамения для людей разумеющих.",["Он привёл","вам","притчу","из","вас самих","есть ли","у вас","из","тех, кем","овладели","ваши десницы","какие-либо","совладельцы","в","том, что","Мы даровали вам","так что вы","в этом","равны","вы боитесь их","как боитесь","друг друга","так","Мы разъясняем","знамения","для людей","разумеющих"]],[30,29,["بَلِ","ٱتَّبَعَ","ٱلَّذِينَ","ظَلَمُوٓاْ","أَهۡوَآءَهُم","بِغَيۡرِ","عِلۡمٖۖ","فَمَن","يَهۡدِي","مَنۡ","أَضَلَّ","ٱللَّهُۖ","وَمَا","لَهُم","مِّن","نَّٰصِرِينَ"],"балиттаба`ал лазиина заламуу ахваахум бигайри `илмин фаман йахдии ман адаллаллаху вама лахум мин насириин","Но нет! Беззаконники потакают своим желаниям без всякого знания. Кто наставит на прямой путь тех, кого Аллах ввел в заблуждение? Не будет для них помощников!",["но нет","последовали","те, которые","поступали несправедливо","своим страстям","без","знания","кто же","наставит","того, кого","ввёл в заблуждение","Аллах","и нет","у них","никаких","помощников"]],[30,30,["فَأَقِمۡ","وَجۡهَكَ","لِلدِّينِ","حَنِيفٗاۚ","فِطۡرَتَ","ٱللَّهِ","ٱلَّتِي","فَطَرَ","ٱلنَّاسَ","عَلَيۡهَاۚ","لَا","تَبۡدِيلَ","لِخَلۡقِ","ٱللَّهِۚ","ذَٰلِكَ","ٱلدِّينُ","ٱلۡقَيِّمُ","وَلَٰكِنَّ","أَكۡثَرَ","ٱلنَّاسِ","لَا","يَعۡلَمُونَ"],"фа'аḳим важхака лиддиини ханиифан фитраталлахил латии фатаран наса `алайха ла табдиила лихалḳиллахи заликад диинул ḳаййиму валакинна аксаран наси ла йа`ламуун","Обрати свой лик к религии, как ханиф. Таково врожденное качество, с которым Аллах сотворил людей. Творение Аллаха не подлежит изменению. Такова правая вера, но большинство людей не знают этого.",["обрати же","своё лицо","к религии","единобожником","природа","Аллаха","которой","Он сотворил","людей","с ней","нет","изменения","творению","Аллаха","это","религия","правая","однако","большинство","людей","не","знают"]],[30,31,["مُنِيبِينَ","إِلَيۡهِ","وَٱتَّقُوهُ","وَأَقِيمُواْ","ٱلصَّلَوٰةَ","وَلَا","تَكُونُواْ","مِنَ","ٱلۡمُشۡرِكِينَ"],"муниибиина илайхи ваттаḳууху ва'аḳиимус салавата вала такуунуу минал мушрикиин","Обращайтесь к Нему с раскаянием, бойтесь Его, совершайте намаз и не будьте в числе многобожников,",["обращаясь с покаянием","к Нему","и бойтесь Его","и совершайте","намаз","и не","будьте","из","многобожников"]],[30,32,["مِنَ","ٱلَّذِينَ","فَرَّقُواْ","دِينَهُمۡ","وَكَانُواْ","شِيَعٗاۖ","كُلُّ","حِزۡبِۭ","بِمَا","لَدَيۡهِمۡ","فَرِحُونَ"],"минал лазиина фарраḳуу диинахум вакануу шийа`ан куллу хизби бима ладайхим фарихуун","в числе тех, которые внесли раскол в свою религию и стали сектами, каждая из которых радуется тому, что имеет.",["из","тех, которые","раскололи","свою религию","и стали","сектами","каждая","партия","тем, что","у них","радуется"]]],"m":[[["وَمِنۡ","и из",30,25],["ءَايَٰتِهِۦٓ","Его знамений",30,25],["أَن","то, что",30,25],["تَقُومَ","стоит",30,25],["ٱلسَّمَآءُ","небо",30,25],["وَٱلۡأَرۡضُ","и земля",30,25],["بِأَمۡرِهِۦۚ","по Его повелению",30,25],["ثُمَّ","затем",30,25],["إِذَا","когда",30,25],["دَعَاكُمۡ","Он позовёт вас",30,25]],[["دَعۡوَةٗ","зовом",30,25],["مِّنَ","из",30,25],["ٱلۡأَرۡضِ","земли",30,25],["إِذَآ","вот",30,25],["أَنتُمۡ","вы",30,25],["تَخۡرُجُونَ","выйдете",30,25],[25],["وَلَهُۥ","и Ему принадлежат",30,26],["مَن","те, кто",30,26],["فِي","на",30,26],["ٱلسَّمَٰوَٰتِ","небесах",30,26]],[["وَٱلۡأَرۡضِۖ","и на земле",30,26],["كُلّٞ","все",30,26],["لَّهُۥ","Ему",30,26],["قَٰنِتُونَ","покорны",30,26],[26],["وَهُوَ","и Он",30,27],["ٱلَّذِي","Тот, Кто",30,27],["يَبۡدَؤُاْ","начинает",30,27],["ٱلۡخَلۡقَ","творение",30,27]],[["ثُمَّ","затем",30,27],["يُعِيدُهُۥ","повторяет его",30,27],["وَهُوَ","и это",30,27],["أَهۡوَنُ","легче",30,27],["عَلَيۡهِۚ","для Него",30,2