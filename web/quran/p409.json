{"p":409,"j":21,"a":[[30,42,["قُلۡ","سِيرُواْ","فِي","ٱلۡأَرۡضِ","فَٱنظُرُواْ","كَيۡفَ","كَانَ","عَٰقِبَةُ","ٱلَّذِينَ","مِن","قَبۡلُۚ","كَانَ","أَكۡثَرُهُم","مُّشۡرِكِينَ"],"ḳул сиируу фил арди фанзуруу кайфа кана `аḳибатул лазиина мин ḳаблу кана аксарухум мушрикиин","Скажи: «Постранствуйте по земле и посмотрите, каким был конец тех, которые жили прежде. Большинство из них были многобожниками».",["скажи","странствуйте","по","земле","и посмотрите","каким","был","конец","тех, которые","из","прежде","были","большинство их","многобожниками"]],[30,43,["فَأَقِمۡ","وَجۡهَكَ","لِلدِّينِ","ٱلۡقَيِّمِ","مِن","قَبۡلِ","أَن","يَأۡتِيَ","يَوۡمٞ","لَّا","مَرَدَّ","لَهُۥ","مِنَ","ٱللَّهِۖ","يَوۡمَئِذٖ","يَصَّدَّعُونَ"],"фа'аḳим важхака лиддиинил ḳаййими мин ḳабли ан йа'тийа йаумул ла марадда лахуу миналлахи йаумаизин йассадда`уун","Обрати свой лик к правой вере до того, как придет Неотвратимый день от Аллаха. В тот день они будут поделены на две группы.",["обрати же","своё лицо","к религии","правой","до","того","как","придёт","день","нет","отвращения","ему","от","Аллаха","в тот день","они разделятся"]],[30,44,["مَن","كَفَرَ","فَعَلَيۡهِ","كُفۡرُهُۥۖ","وَمَنۡ","عَمِلَ","صَٰلِحٗا","فَلِأَنفُسِهِمۡ","يَمۡهَدُونَ"],"ман кафара фа`алайхи куфрухуу ваман `амила салихан фалианфусихим йамхадуун","Кто не уверовал, того неверие обратится против него самого. А те, которые поступали праведно, будут готовить для себя места в Раю.",["кто","не уверовал","то на нём","его неверие","а кто","совершал","праведное","то для самих себя","они уготавливают"]],[30,45,["لِيَجۡزِيَ","ٱلَّذِينَ","ءَامَنُواْ","وَعَمِلُواْ","ٱلصَّٰلِحَٰتِ","مِن","فَضۡلِهِۦٓۚ","إِنَّهُۥ","لَا","يُحِبُّ","ٱلۡكَٰفِرِينَ"],"лийажзийал лазиина амануу ва`амилус салихати мин фадлихии иннахуу ла йухиббул кафириин","Это произойдет для того, чтобы Он воздал Своими щедротами тем, которые уверовали и совершали праведные деяния. Воистину, Он не любит неверующих.",["чтобы Он воздал","тем, которые","уверовали","и совершали","праведные дела","по","Своей щедрости","поистине, Он","не","любит","неверующих"]],[30,46,["وَمِنۡ","ءَايَٰتِهِۦٓ","أَن","يُرۡسِلَ","ٱلرِّيَاحَ","مُبَشِّرَٰتٖ","وَلِيُذِيقَكُم","مِّن","رَّحۡمَتِهِۦ","وَلِتَجۡرِيَ","ٱلۡفُلۡكُ","بِأَمۡرِهِۦ","وَلِتَبۡتَغُواْ","مِن","فَضۡلِهِۦ","وَلَعَلَّكُمۡ","تَشۡكُرُونَ"],"вамин айатихии ан йурсилар рийаха мубашширатин валийузииḳакум мир рахматихии валитажрийал фулку би'амрихии валитабтагуу мин фадлихии вала`аллакум ташкуруун","Среди Его знамений - то, что Он посылает ветры добрыми вестниками, чтобы дать вам вкусить от Его милости, чтобы корабли плыли по Его воле и чтобы вы искали Его милость, - быть может, вы будете благодарны.",["и среди","Его знамений","то, что","Он посылает","ветры","благовестниками","и чтобы дать вам вкусить","от","Его милости","и чтобы плыли","корабли","по Его повелению","и чтобы вы искали","из","Его щедрот","и, быть может, вы","будете благодарны"]],[30,47,["وَلَقَدۡ","أَرۡسَلۡنَا","مِن","قَبۡلِكَ","رُسُلًا","إِلَىٰ","قَوۡمِهِمۡ","فَجَآءُوهُم","بِٱلۡبَيِّنَٰتِ","فَٱنتَقَمۡنَا","مِنَ","ٱلَّذِينَ","أَجۡرَمُواْۖ","وَكَانَ","حَقًّا","عَلَيۡنَا","نَصۡرُ","ٱلۡمُؤۡمِنِينَ"],"валаḳад арсална мин ḳаблика русулан ила ḳаумихим фажауухум билбаййинати фантаḳамна минал лазиина ажрамуу вакана хаḳḳан `алайна насрул му'миниин","Мы уже отправляли до тебя посланников к их народам, и они приносили им ясные знамения. Мы отомстили грешникам, и Нашим долгом было помогать верующим.",["и уже","Мы отправили","до","тебя","посланников","к","их народам","и они пришли к ним","с ясными знамениями","и Мы отомстили","от","тем, которые","совершали преступления","и было","долгом","на Нас","помочь","верующим"]],[30,48,["ٱللَّهُ","ٱلَّذِي","يُرۡسِلُ","ٱلرِّيَٰحَ","فَتُثِيرُ","سَحَابٗا","فَيَبۡسُطُهُۥ","فِي","ٱلسَّمَآءِ","كَيۡفَ","يَشَآءُ","وَيَجۡعَلُهُۥ","كِسَفٗا","فَتَرَى","ٱلۡوَدۡقَ","يَخۡرُجُ","مِنۡ","خِلَٰلِهِۦۖ","فَإِذَآ","أَصَابَ","بِهِۦ","مَن","يَشَآءُ","مِنۡ","عِبَادِهِۦٓ","إِذَا","هُمۡ","يَسۡتَبۡشِرُونَ"],"аллахул лазии йурсилур рийаха фатусииру сахабан файабсутухуу фис самаи кайфа йашау вайаж`алухуу кисафан фатарал вадḳа йахружу мин хилалихии фа'иза асаба бихии ман йашау мин `ибадихии иза хум йастабшируун","Аллах - Тот, Кто посылает ветры, которые поднимают облака. Он простирает их по небу, как пожелает, и разрывает их в клочья. Потом ты видишь, как из их расщелин льется дождь. Стоит Ему пролить его на тех из Своих рабов, на кого Он пожелает, как они радуются,",["Аллах","Тот, Кто","посылает","ветры","и они поднимают","облака","и Он простирает их","по","небу","как","Он пожелает","и Он делает их","клочьями","и ты видишь","дождь","выходящий","из","их промежутков","и когда","Он проливает","его","на кого","Он пожелает","из","Своих рабов","вот","они","радуются"]],[30,49,["وَإِن","كَانُواْ","مِن","قَبۡلِ","أَن","يُنَزَّلَ","عَلَيۡهِم","مِّن","قَبۡلِهِۦ","لَمُبۡلِسِينَ"],"ва'ин кануу мин ḳабли ан йуназзала `алайхим мин ḳаблихии ламублисиин","хотя до того, как он был ниспослан им, они были в отчаянии.",["и хотя","они были","ещё","до","того как","было ниспослано","на них","ещё","до него","в отчаянии"]],[30,50,["فَٱنظُرۡ","إِلَىٰٓ","ءَاثَٰرِ","رَحۡمَتِ","ٱللَّهِ","كَيۡفَ","يُحۡيِ","ٱلۡأَرۡضَ","بَعۡدَ","مَوۡتِهَآۚ","إِنَّ","ذَٰلِكَ","لَمُحۡيِ","ٱلۡمَوۡتَىٰۖ","وَهُوَ","عَلَىٰ","كُلِّ","شَيۡءٖ","قَدِيرٞ"],"фанзур ила асари рахматиллахи кайфа йухйил арда ба`да маутиха инна залика ламухйил маута вахуа `ала кулли шай'ин ḳадиир","Посмотри на следы милости Аллаха, на то, как Он оживляет землю после ее смерти. Воистину, Он способен оживить мертвых и способен на всякую вещь.",["посмотри же","на","следы","милости","Аллаха","как","Он оживляет","землю","после","её смерти","поистине","Тот","непременно оживит","мёртвых","и Он","над","всякой","вещью","могуществен"]]],"m":[[["قُلۡ","скажи",30,42],["سِيرُواْ","странствуйте",30,42],["فِي","по",30,42],["ٱلۡأَرۡضِ","земле",30,42],["فَٱنظُرُواْ","и посмотрите",30,42],["كَيۡفَ","каким",30,42],["كَانَ","был",30,42],["عَٰقِبَةُ","конец",30,42],["ٱلَّذِينَ","тех, которые",30,42],["مِن","из",30,42