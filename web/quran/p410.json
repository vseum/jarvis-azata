{"p":410,"j":21,"a":[[30,51,["وَلَئِنۡ","أَرۡسَلۡنَا","رِيحٗا","فَرَأَوۡهُ","مُصۡفَرّٗا","لَّظَلُّواْ","مِنۢ","بَعۡدِهِۦ","يَكۡفُرُونَ"],"валаин арсална риихан фараауху мусфаррал лазаллуу мим ба`дихии йакфуруун","Если Мы пошлем ветер, и они увидят, как она (нива) пожелтела, то после этого они будут неблагодарны.",["и если","Мы пошлём","ветер","и они увидят его","пожелтевшим","непременно станут они","вслед","за этим","проявлять неверие"]],[30,52,["فَإِنَّكَ","لَا","تُسۡمِعُ","ٱلۡمَوۡتَىٰ","وَلَا","تُسۡمِعُ","ٱلصُّمَّ","ٱلدُّعَآءَ","إِذَا","وَلَّوۡاْ","مُدۡبِرِينَ"],"фа'иннака ла тусми`ул маута вала тусми`ус суммад ду`аа иза валлау мудбириин","Воистину, ты не заставишь слышать мертвецов и не заставишь глухих услышать призыв, когда они обращаются вспять.",["и поистине, ты","не","заставишь слышать","мёртвых","и не","заставишь слышать","глухих","призыв","когда","они отвернулись","уходя прочь"]],[30,53,["وَمَآ","أَنتَ","بِهَٰدِ","ٱلۡعُمۡيِ","عَن","ضَلَٰلَتِهِمۡۖ","إِن","تُسۡمِعُ","إِلَّا","مَن","يُؤۡمِنُ","بِـَٔايَٰتِنَا","فَهُم","مُّسۡلِمُونَ"],"вама анта бихадил `умйи `ан далалатихим ин тусми`у илла ман йу'мину би'айатина фахум муслимуун","Ты не выведешь слепых из их заблуждения. Ты можешь заставить слышать только тех, которые веруют в Наши знамения, будучи мусульманами.",["и не","ты","выведешь","слепых","из","их заблуждения","не","заставишь слышать ты","кроме","того, кто","верует","в Наши знамения","и они","покорные"]],[30,54,["ٱللَّهُ","ٱلَّذِي","خَلَقَكُم","مِّن","ضَعۡفٖ","ثُمَّ","جَعَلَ","مِنۢ","بَعۡدِ","ضَعۡفٖ","قُوَّةٗ","ثُمَّ","جَعَلَ","مِنۢ","بَعۡدِ","قُوَّةٖ","ضَعۡفٗا","وَشَيۡبَةٗۚ","يَخۡلُقُ","مَا","يَشَآءُۚ","وَهُوَ","ٱلۡعَلِيمُ","ٱلۡقَدِيرُ"],"аллахул лазии халаḳакум мин да`фин сумма жа`ала мим ба`ди да`фин ḳувватан сумма жа`ала мим ба`ди ḳувватин да`фан вашайбатан йахлуḳу ма йашау вахуал `алиимул ḳадиир","Аллах - Тот, Кто создает вас из слабости (создает вас из капли или создает вас слабыми). После слабости Он наделяет вас силой, а потом заменяет ее слабостью и сединой. Он творит, что пожелает, ибо Он - Знающий, Всемогущий.",["Аллах","Тот, Кто","создал вас","из","слабости","затем","Он сделал","вслед","за","слабостью","силу","затем","Он сделал","вслед","за","силой","слабость","и седину","Он творит","что","пожелает","и Он","Знающий","Всемогущий"]],[30,55,["وَيَوۡمَ","تَقُومُ","ٱلسَّاعَةُ","يُقۡسِمُ","ٱلۡمُجۡرِمُونَ","مَا","لَبِثُواْ","غَيۡرَ","سَاعَةٖۚ","كَذَٰلِكَ","كَانُواْ","يُؤۡفَكُونَ"],"вайаума таḳуумус са`ату йуḳсимул мужримууна ма лабисуу гайра са`атин казалика кануу йу'факуун","В тот день, когда наступит Час, грешники станут клясться, что они пробыли на земле или в могилах всего лишь один час. Таким же образом они были отвращены от истины!",["и в день, когда","наступит","Час","поклянутся","преступники","не","пробыли они","более","часа","так","они были","отвращаемы"]],[30,56,["وَقَالَ","ٱلَّذِينَ","أُوتُواْ","ٱلۡعِلۡمَ","وَٱلۡإِيمَٰنَ","لَقَدۡ","لَبِثۡتُمۡ","فِي","كِتَٰبِ","ٱللَّهِ","إِلَىٰ","يَوۡمِ","ٱلۡبَعۡثِۖ","فَهَٰذَا","يَوۡمُ","ٱلۡبَعۡثِ","وَلَٰكِنَّكُمۡ","كُنتُمۡ","لَا","تَعۡلَمُونَ"],"ваḳалал лазиина уутул `илма вал'иимана лаḳад лабистум фии китабиллахи ила йаумил ба`си фахаза йаумул ба`си валакиннакум кунтум ла та`ламуун","А те, кому дарованы знание и вера, скажут: «В соответствии с предписанием Аллаха вы пробыли там до Дня воскресения. Это и есть День воскресения, но вы не знали этого».",["и скажут","те, которые","получили","знание","и веру","вы уже","пробыли","по","предписанию","Аллаха","до","Дня","воскресения","и это","День","воскресения","но вы","были","не","знающими"]],[30,57,["فَيَوۡمَئِذٖ","لَّا","يَنفَعُ","ٱلَّذِينَ","ظَلَمُواْ","مَعۡذِرَتُهُمۡ","وَلَا","هُمۡ","يُسۡتَعۡتَبُونَ"],"файаумаизил ла йанфа`ул лазиина заламуу ма`зиратухум вала хум йуста`табуун","В тот день беззаконникам не принесут пользы их извинения (или оправдания), и от них не потребуют покаяния.",["и в тот день","не","поможет","тем, которые","поступали несправедливо","их оправдание","и не","они","будут призваны покаяться"]],[30,58,["وَلَقَدۡ","ضَرَبۡنَا","لِلنَّاسِ","فِي","هَٰذَا","ٱلۡقُرۡءَانِ","مِن","كُلِّ","مَثَلٖۚ","وَلَئِن","جِئۡتَهُم","بِـَٔايَةٖ","لَّيَقُولَنَّ","ٱلَّذِينَ","كَفَرُوٓاْ","إِنۡ","أَنتُمۡ","إِلَّا","مُبۡطِلُونَ"],"валаḳад дарабна линнаси фии хазал ḳур'ани мин кулли масалин валаин жи'тахум би'айатил лайаḳууланнал лазиина кафаруу ин антум илла мубтилуун","Мы уже привели людям в этом Коране любые притчи. Если ты явишь им знамение, то неверующие непременно скажут: «Вы - всего лишь приверженцы лжи».",["и уже","Мы привели","для людей","в","этом","Коране","из","всяких","притч","и если","ты придёшь к ним","со знамением","непременно скажут","те, которые","не уверовали","не","вы","кроме","приверженцы лжи"]],[30,59,["كَذَٰلِكَ","يَطۡبَعُ","ٱللَّهُ","عَلَىٰ","قُلُوبِ","ٱلَّذِينَ","لَا","يَعۡلَمُونَ"],"казалика йатба`уллаху `ала ḳулуубил лазиина ла йа`ламуун","Так Аллах запечатывает сердца тех, которые не обладают знанием.",["так","запечатывает","Аллах","на","сердца","тех, которые","не","знают"]],[30,60,["فَٱصۡبِرۡ","إِنَّ","وَعۡدَ","ٱللَّهِ","حَقّٞۖ","وَلَا","يَسۡتَخِفَّنَّكَ","ٱلَّذِينَ","لَا","يُوقِنُونَ"],"фасбир инна ва`даллахи хаḳḳун вала йастахиффаннакал лазиина ла йууḳинуун","Будь же терпелив, ведь обещание Аллаха истинно. И пусть те, которые лишены убежденности, не находят тебя легковесным (не отвращают тебя от религии).",["терпи же","поистине","обещание","Аллаха","истинно","и пусть не","поколеблют тебя","те, которые","не","убеждены"]]],"m":[[["وَلَئِنۡ","и если",30,51],["أَرۡسَلۡنَا","Мы пошлём",30,51],["رِيحٗا","ветер",30,51],["فَرَأَوۡهُ","и они увидят его",30,51],["مُصۡفَرّٗا","пожелтевшим",30,51],["لَّظَلُّواْ","непременно станут они",30,51],["مِنۢ","вслед",30,51],["بَعۡدِهِۦ","за этим",30,51],["يَكۡفُرُونَ","проявлять неверие",30,51]],[[51],["فَإِنَّكَ","и поистине, ты",30,52],["لَا","не",30,52],["تُسۡمِعُ","заставишь слышать",30,52],["ٱلۡمَوۡتَىٰ","мёртвых",30,52],["وَلَا","и не",30,52],["تُسۡمِعُ","заставишь слышать",30,52],["ٱلصُّمَّ","глухих",30,52],["ٱلدُّعَآءَ","призыв",30,52],["إِذَا","когда",30,52],["وَلَّوۡاْ","они отвернулись",30,52]],[["مُدۡبِرِينَ","уходя прочь",30,52],[52],["وَمَآ","и не",30,53],["أَنتَ","ты",30,53],["بِهَٰدِ","выведешь",30,53],["ٱلۡعُمۡيِ","слепых",30,53],["عَن","из",30,53],["ضَلَٰلَتِهِمۡۖ","их заблуждения",30,53],["إِن","не",30,53],["تُسۡمِعُ","заставишь слышать ты",30,53],["إِلَّا","кроме",30,53]],[["مَن","того, кто",30,53],["يُؤۡمِنُ","верует",30,53],["بِـَٔايَٰتِنَا","в Наши знамения",30,53],["فَهُم","и они",30,53],["مُّسۡلِمُونَ","покорные",30,53],[53],["۞ ٱللَّهُ","Аллах",30,54],["ٱلَّذِي","Тот, Кто",30,54],["خَلَقَكُم","создал вас",30,54]],[["مِّن","из",30,54],["ضَعۡفٖ","слабости",30,54],["ثُمَّ","затем",30,54],["جَعَلَ","Он сделал",30,54],["مِنۢ","вслед",30,54],["بَعۡدِ","за",30,54],["ضَعۡفٖ","слабостью",30,54],["قُوَّةٗ","силу",30,54],["ثُمَّ","затем",30,54],["جَعَلَ","Он сделал",30,54],["مِنۢ","вслед",30,54],["بَعۡدِ","за",30,54]],[["قُوَّةٖ","силой",30,54],["ضَعۡفٗا","слабость",30,54],["وَشَيۡبَةٗۚ","и седину",30,54],["يَخۡلُقُ","Он творит",30,54],["مَا","что",30,54],["يَشَآءُۚ","пожелает",30,54],["وَهُوَ","и Он",30,54],["ٱلۡعَلِيمُ","Знающий",30,54],["ٱلۡقَدِيرُ","Всемогущий",30,54],[54]],[["وَيَوۡمَ","и в день, когда",30,55],["تَقُومُ","наступит",30,55],["ٱلسَّاعَةُ","Час",30,55],["يُقۡسِمُ","поклянутся",30,55],["ٱلۡمُجۡرِمُونَ","преступники",30,55],["مَا","не",30,55],["لَبِثُواْ","пробыли они",30,55],["غَيۡرَ","более",30,55],["سَاعَةٖۚ","часа",30,55]],[["كَذَٰلِكَ","так",30,55],["كَانُواْ","они были",30,55],["يُؤۡفَكُونَ","отвращаемы",30,55],[55],["وَقَالَ","и скажут",30,56],["ٱلَّذِينَ","те, которые",30,56],["أُوتُواْ","получили",30,56],["ٱلۡعِلۡمَ","знание",30,56],["وَٱلۡإِيمَٰنَ","и веру",30,56]],[["لَقَدۡ","вы уже",30,56],["لَبِثۡتُمۡ","пробыли",30,56],["فِي","по",30,56],["كِتَٰبِ","предписанию",30,56],["ٱللَّهِ","Аллаха",30,56],["إِلَىٰ","до",30,56],["يَوۡمِ","Дня",30,56],["ٱلۡبَعۡثِۖ","воскресения",30,56],["فَهَٰذَا","и это",30,56],["يَوۡمُ","День",30,56],["ٱلۡبَعۡثِ","воскресения",30,56]],[["وَلَٰكِنَّكُمۡ","но вы",30,56],["كُنتُمۡ","были",30,56],["لَا","не",30,56],["تَعۡلَمُونَ","знающими",30,56],[56],["فَيَوۡمَئِذٖ","и в тот день",30,57],["لَّا","не",30,57],["يَنفَعُ","поможет",30,57],["ٱلَّذِينَ","тем, которые",30,57]],[["ظَلَمُواْ","поступали несправедливо",30,57],["مَعۡذِرَتُهُمۡ","их оправдание",30,57],["وَلَا","и не",30,57],["هُمۡ","они",30,57],["يُسۡتَعۡتَبُونَ","будут призваны покаяться",30,57],[57],["وَلَقَدۡ","и уже",30,58],["ضَرَبۡنَا","Мы привели",30,58]],[["لِلنَّاسِ","для людей",30,58],["فِي","в",30,58],["هَٰذَا","этом",30,58],["ٱلۡقُرۡءَانِ","Коране",30,58],["مِن","из",30,58],["كُلِّ","всяких",30,58],["مَثَلٖۚ","притч",30,58],["وَلَئِن","и если",30,58],["جِئۡتَهُم","ты придёшь к ним",30,58],["بِـَٔايَةٖ","со знамением",30,58]],[["لَّيَقُولَنَّ","непременно скажут",30,58],["ٱلَّذِينَ","те, которые",30,58],["كَفَرُوٓاْ","не уверовали",30,58],["إِنۡ","не",30,58],["أَنتُمۡ","вы",30,58],["إِلَّا","кроме",30,58],["مُبۡطِلُونَ","приверженцы лжи",30,58],[58],["كَذَٰلِكَ","так",30,59]],[["يَطۡبَعُ","запечатывает",30,59],["ٱللَّهُ","Аллах",30,59],["عَلَىٰ","на",30,59],["قُلُوبِ","сердца",30,59],["ٱلَّذِينَ","тех, которые",30,59],["لَا","не",30,59],["يَعۡلَمُونَ","знают",30,59],[59],["فَٱصۡبِرۡ","терпи же",30,60],["إِنَّ","поистине",30,60]],[["وَعۡدَ","обещание",30,60],["ٱللَّهِ","Аллаха",30,60],["حَقّٞۖ","истинно",30,60],["وَلَا","и пусть не",30,60],["يَسۡتَخِفَّنَّكَ","поколеблют тебя",30,60],["ٱلَّذِينَ","те, которые",30,60],["لَا","не",30,60],["يُوقِنُونَ","убеждены",30,60],[60]]]}