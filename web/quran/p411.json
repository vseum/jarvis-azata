{"p":411,"j":21,"a":[[31,1,["الٓمٓ"],"лм","Алиф. Лам. Мим.",["Алиф. Лам. Мим."]],[31,2,["تِلۡكَ","ءَايَٰتُ","ٱلۡكِتَٰبِ","ٱلۡحَكِيمِ"],"тилка айатул китабил хакиим","Это - аяты мудрого Писания,",["это","аяты","Писания","мудрого"]],[31,3,["هُدٗى","وَرَحۡمَةٗ","لِّلۡمُحۡسِنِينَ"],"худан варахматал лилмухсиниин","верное руководство и милость для творящих добро,",["руководство","и милость","для творящих добро"]],[31,4,["ٱلَّذِينَ","يُقِيمُونَ","ٱلصَّلَوٰةَ","وَيُؤۡتُونَ","ٱلزَّكَوٰةَ","وَهُم","بِٱلۡأٓخِرَةِ","هُمۡ","يُوقِنُونَ"],"аллазиина йуḳиимуунас салавата вайу'тууназ закавата вахум бил'ахирати хум йууḳинуун","которые совершают намаз, выплачивают закят и убеждены в Последней жизни.",["те, которые","совершают","намаз","и дают","закят","и они","в Последней жизни","они","убеждены"]],[31,5,["أُوْلَٰٓئِكَ","عَلَىٰ","هُدٗى","مِّن","رَّبِّهِمۡۖ","وَأُوْلَٰٓئِكَ","هُمُ","ٱلۡمُفۡلِحُونَ"],"улаика `ала худам мир раббихим ва'улаика хумул муфлихуун","Они следуют верному руководству от их Господа, и они являются преуспевшими.",["те","на","руководстве","от","их Господа","и те","они","преуспевшие"]],[31,6,["وَمِنَ","ٱلنَّاسِ","مَن","يَشۡتَرِي","لَهۡوَ","ٱلۡحَدِيثِ","لِيُضِلَّ","عَن","سَبِيلِ","ٱللَّهِ","بِغَيۡرِ","عِلۡمٖ","وَيَتَّخِذَهَا","هُزُوًاۚ","أُوْلَٰٓئِكَ","لَهُمۡ","عَذَابٞ","مُّهِينٞ"],"ваминан наси ман йаштарии лахвал хадииси лийудилла `ан сабиилиллахи бигайри `илмин вайаттахизаха хузуан улаика лахум `азабум мухиин","Среди людей есть такой, который покупает потешные речи (песни и музыку), чтобы сбивать других с пути Аллаха без всякого знания, и высмеивает их (знамения Аллаха). Таким уготованы унизительные мучения.",["и среди","людей","тот, кто","покупает","забаву","речей","чтобы сбивать","с","пути","Аллаха","без","знания","и обращает его","в насмешку","те","им","наказание","унизительное"]],[31,7,["وَإِذَا","تُتۡلَىٰ","عَلَيۡهِ","ءَايَٰتُنَا","وَلَّىٰ","مُسۡتَكۡبِرٗا","كَأَن","لَّمۡ","يَسۡمَعۡهَا","كَأَنَّ","فِيٓ","أُذُنَيۡهِ","وَقۡرٗاۖ","فَبَشِّرۡهُ","بِعَذَابٍ","أَلِيمٍ"],"ва'иза тутла `алайхи айатуна валла мустакбиран ка'ал лам йасма`ха ка'анна фии узунайхи ваḳран фабашширху би`азабин алиим","Когда ему читают Наши аяты, он надменно отворачивается, словно он даже не слышал их, словно он туг на ухо. Обрадуй же его вестью о мучительных страданиях.",["и когда","читаются","ему","Наши аяты","он отворачивается","высокомерно","словно","не","слышал он их","словно","в","его ушах","глухота","обрадуй же его","наказанием","мучительным"]],[31,8,["إِنَّ","ٱلَّذِينَ","ءَامَنُواْ","وَعَمِلُواْ","ٱلصَّٰلِحَٰتِ","لَهُمۡ","جَنَّٰتُ","ٱلنَّعِيمِ"],"иннал лазиина амануу ва`амилус салихати лахум жаннатун на`иим","Воистину, тем, которые уверовали и совершали праведные деяния, уготованы Сады блаженства.",["поистине","те, которые","уверовали","и совершали","праведные дела","им","сады","блаженства"]],[31,9,["خَٰلِدِينَ","فِيهَاۖ","وَعۡدَ","ٱللَّهِ","حَقّٗاۚ","وَهُوَ","ٱلۡعَزِيزُ","ٱلۡحَكِيمُ"],"халидиина фииха ва`даллахи хаḳḳан вахуал `азиизул хакиим","Они пребудут в них вечно согласно истинному обещанию Аллаха. Он - Могущественный, Мудрый.",["вечно пребывающие","в них","обещание","Аллаха","истинное","и Он","Могущественный","Мудрый"]],[31,10,["خَلَقَ","ٱلسَّمَٰوَٰتِ","بِغَيۡرِ","عَمَدٖ","تَرَوۡنَهَاۖ","وَأَلۡقَىٰ","فِي","ٱلۡأَرۡضِ","رَوَٰسِيَ","أَن","تَمِيدَ","بِكُمۡ","وَبَثَّ","فِيهَا","مِن","كُلِّ","دَآبَّةٖۚ","وَأَنزَلۡنَا","مِنَ","ٱلسَّمَآءِ","مَآءٗ","فَأَنۢبَتۡنَا","فِيهَا","مِن","كُلِّ","زَوۡجٖ","كَرِيمٍ"],"халаḳас самавати бигайри `амадин тараунаха ва'алḳа фил арди равасийа ан тамиида бикум вабасса фииха мин кулли даббатин ва'анзална минас самаи маан фа'амбатна фииха мин кулли заужин кариим","Он создал небеса без опор, которые бы вы могли увидеть, воздвиг на земле незыблемые горы, чтобы она не колебалась вместе с вами, и расселил на ней всяких животных. Мы ниспослали с неба воду и взрастили там всякие благородные виды.",["Он создал","небеса","без","опор","которые вы видите","и Он водрузил","на","земле","незыблемые горы","чтобы не","колебалась она","с вами","и Он рассеял","на ней","из","всяких","животных","и Мы ниспослали","с","неба","воду","и Мы взрастили","на ней","из","всякого","вида","благородного"]],[31,11,["هَٰذَا","خَلۡقُ","ٱللَّهِ","فَأَرُونِي","مَاذَا","خَلَقَ","ٱلَّذِينَ","مِن","دُونِهِۦۚ","بَلِ","ٱلظَّٰلِمُونَ","فِي","ضَلَٰلٖ","مُّبِينٖ"],"хаза халḳуллахи фа'аруунии маза халаḳал лазиина мин дуунихии бализ залимууна фии далалим мубиин","Таково творение Аллаха! Так покажите Мне, что сотворили все остальные. О нет! Беззаконники находятся в очевидном заблуждении.",["это","творение","Аллаха","покажите же Мне","что","сотворили","те, которые","помимо","Него","нет же","беззаконники","в","заблуждении","явном"]]],"m":[["h",31],["b"],[["الٓمٓ","Алиф. Лам. Мим.",31,1],[1],["تِلۡكَ","это",31,2],["ءَايَٰتُ","аяты",31,2],["ٱلۡكِتَٰبِ","Писания",31,2],["ٱلۡحَكِيمِ","мудрого",31,2],[2],["هُدٗى","руководство",31,3],["وَرَحۡمَةٗ","и милость",31,3]],[["لِّلۡمُحۡسِنِينَ","для творящих добро",31,3],[3],["ٱلَّذِينَ","те, которые",31,4],["يُقِيمُونَ","совершают",31,4],["ٱلصَّلَوٰةَ","намаз",31,4],["وَيُؤۡتُونَ","и дают",31,4],["ٱلزَّكَوٰةَ","закят",31,4],["وَهُم","и они",31,4]],[["بِٱلۡأٓخِرَةِ","в Последней жизни",31,4],["هُمۡ","они",31,4],["يُوقِنُونَ","убеждены",31,4],[4],["أُوْلَٰٓئِكَ","те",31,5],["عَلَىٰ","на",31,5],["هُدٗى","руководстве",31,5],["مِّن","от",31,5],["رَّبِّهِمۡۖ","их Господа",31,5],["وَأُوْلَٰٓئِكَ","и те",31,5]],[["هُمُ","они",31,5],["ٱلۡمُفۡلِحُونَ","преуспевшие",31,5],[5],["وَمِنَ","и среди",31,6],["ٱلنَّاسِ","людей",31,6],["مَن","тот, кто",31,6],["يَشۡتَرِي","покупает",31,6],["لَهۡوَ","забаву",31,6],["ٱلۡحَدِيثِ","речей",31,6]],[["لِيُضِلَّ","чтобы сбивать",31,6],["عَن","с",31,6],["سَبِيلِ","пути",31,6],["ٱللَّهِ","Аллаха",31,6],["بِغَيۡرِ","без",31,6],["عِلۡمٖ","знания",31,6],["وَيَتَّخِذَهَا","и обращает его",31,6],["هُزُوًاۚ","в насмешку",31,6],["أُوْلَٰٓئِكَ","те",31,6],["لَهُمۡ","им",31,6]],[["عَذَابٞ","наказание",31,6],["مُّهِينٞ","унизительное",31,6],[6],["وَإِذَا","и когда",31,7],["تُتۡلَىٰ","читаются",31,7],["عَلَيۡهِ","ему",31,7],["ءَايَٰتُنَا","Наши аяты",31,7],["وَلَّىٰ","он отворачивается",31,7],["مُسۡتَكۡبِرٗا","высокомерно",31,7]],[["كَأَن","словно",31,7],["لَّمۡ","не",31,7],["يَسۡمَعۡهَا","слышал он их",31,7],["كَأَنَّ","словно",31,7],["فِيٓ","в",31,7],["أُذُنَيۡهِ","его ушах",31,7],["وَقۡرٗاۖ","глухота",31,7],["فَبَشِّرۡهُ","обрадуй же его",31,7],["بِعَذَابٍ","наказанием",31,7],["أَلِيمٍ","мучительным",31,7],[7]],[["إِنَّ","поистине",31,8],["ٱلَّذِينَ","те, которые",31,8],["ءَامَنُواْ","уверовали",31,8],["وَعَمِلُواْ","и совершали",31,8],["ٱلصَّٰلِحَٰتِ","праведные дела",31,8],["لَهُمۡ","им",31,8],["جَنَّٰتُ","сады",31,8],["ٱلنَّعِيمِ","блаженства",31,8],[8]],[["خَٰلِدِينَ","вечно пребывающие",31,9],["فِيهَاۖ","в них",31,9],["وَعۡدَ","обещание",31,9],["ٱللَّهِ","Аллаха",31,9],["حَقّٗاۚ","истинное",31,9],["وَهُوَ","и Он",31,9],["ٱلۡعَزِيزُ","Могущественный",31,9],["ٱلۡحَكِيمُ","Мудрый",31,9],[9],["خَلَقَ","Он создал",31,10]],[["ٱلسَّمَٰوَٰتِ","небеса",31,10],["بِغَيۡرِ","без",31,10],["عَمَدٖ","опор",31,10],["تَرَوۡنَهَاۖ","которые вы видите",31,10],["وَأَلۡقَىٰ","и Он водрузил",31,10],["فِي","на",31,10],["ٱلۡأَرۡضِ","земле",31,10],["رَوَٰسِيَ","незыблемые горы",31,10],["أَن","чтобы не",31,10],["تَمِيدَ","колебалась она",31,10]],[["بِكُمۡ","с вами",31,10],["وَبَثَّ","и Он рассеял",31,10],["فِيهَا","на ней",31,10],["مِن","из",31,10],["كُلِّ","всяких",31,10],["دَآبَّةٖۚ","животных",31,10],["وَأَنزَلۡنَا","и Мы ниспослали",31,10],["مِنَ","с",31,10],["ٱلسَّمَآءِ","неба",31,10],["مَآءٗ","воду",31,10],["فَأَنۢبَتۡنَا","и Мы взрастили",31,10],["فِيهَا","на ней",31,10]],[["مِن","из",31,10],["كُلِّ","всякого",31,10],["زَوۡجٖ","вида",31,10],["كَرِيمٍ","благородного",31,10],[10],["هَٰذَا","это",31,11],["خَلۡقُ","творение",31,11],["ٱللَّهِ","Аллаха",31,11],["فَأَرُونِي","покажите же Мне",31,11],["مَاذَا","что",31,11]],[["خَلَقَ","сотворили",31,11],["ٱلَّذِينَ","те, которые",31,11],["مِن","помимо",31,11],["دُونِهِۦۚ","Него",31,11],["بَلِ","нет же",31,1