{"p":412,"j":21,"a":[[31,12,["وَلَقَدۡ","ءَاتَيۡنَا","لُقۡمَٰنَ","ٱلۡحِكۡمَةَ","أَنِ","ٱشۡكُرۡ","لِلَّهِۚ","وَمَن","يَشۡكُرۡ","فَإِنَّمَا","يَشۡكُرُ","لِنَفۡسِهِۦۖ","وَمَن","كَفَرَ","فَإِنَّ","ٱللَّهَ","غَنِيٌّ","حَمِيدٞ"],"валаḳад атайна луḳманал хикмата анишкур лиллахи ваман йашкур фа'иннама йашкуру линафсихии ваман кафара фа'инналлаха ганиййун хамиид","Мы даровали Лукману мудрость: «Благодари Аллаха! Тот, кто благодарит, поступает только во благо себе. А если кто неблагодарен, то ведь Аллах - Богатый, Достохвальный».",["и уже","Мы даровали","Лукману","мудрость","что","благодари","Аллаха","и кто","благодарит","то лишь","благодарит он","ради себя","а кто","неблагодарен","то поистине","Аллах","Богатый","Достохвальный"]],[31,13,["وَإِذۡ","قَالَ","لُقۡمَٰنُ","لِٱبۡنِهِۦ","وَهُوَ","يَعِظُهُۥ","يَٰبُنَيَّ","لَا","تُشۡرِكۡ","بِٱللَّهِۖ","إِنَّ","ٱلشِّرۡكَ","لَظُلۡمٌ","عَظِيمٞ"],"ва'из ḳала луḳману либнихии вахуа йа`изухуу йабунаййа ла тушрик биллахи иннаш ширка лазулмун `азиим","Вот Лукман сказал своему сыну, наставляя его: «О сын мой! Не приобщай к Аллаху сотоварищей, ибо многобожие является великой несправедливостью».",["и вот","сказал","Лукман","своему сыну","и он","наставлял его","о сынок мой","не","приобщай сотоварищей","к Аллаху","поистине","многобожие","непременно несправедливость","великая"]],[31,14,["وَوَصَّيۡنَا","ٱلۡإِنسَٰنَ","بِوَٰلِدَيۡهِ","حَمَلَتۡهُ","أُمُّهُۥ","وَهۡنًا","عَلَىٰ","وَهۡنٖ","وَفِصَٰلُهُۥ","فِي","عَامَيۡنِ","أَنِ","ٱشۡكُرۡ","لِي","وَلِوَٰلِدَيۡكَ","إِلَيَّ","ٱلۡمَصِيرُ"],"вавассайнал инсана бивалидайхи хамалатху уммухуу вахнан `ала вахнин вафисалухуу фии `амайни анишкур лии валивалидайка илаййал масиир","Мы заповедали человеку делать добро его родителям. Его мать носила его, испытывая изнеможение за изнеможением, и отняла его от груди в два года. Благодари Меня и своих родителей, ибо ко Мне предстоит прибытие.",["и Мы заповедали","человеку","о его родителях","носила его","его мать","изнеможением","за","изнеможением","и отнятие его от груди","в","два года","что","благодари","Меня","и твоих родителей","ко Мне","прибытие"]],[31,15,["وَإِن","جَٰهَدَاكَ","عَلَىٰٓ","أَن","تُشۡرِكَ","بِي","مَا","لَيۡسَ","لَكَ","بِهِۦ","عِلۡمٞ","فَلَا","تُطِعۡهُمَاۖ","وَصَاحِبۡهُمَا","فِي","ٱلدُّنۡيَا","مَعۡرُوفٗاۖ","وَٱتَّبِعۡ","سَبِيلَ","مَنۡ","أَنَابَ","إِلَيَّۚ","ثُمَّ","إِلَيَّ","مَرۡجِعُكُمۡ","فَأُنَبِّئُكُم","بِمَا","كُنتُمۡ","تَعۡمَلُونَ"],"ва'ин жахадака `ала ан тушрика бии ма лайса лака бихии `илмун фала тути`хума васахибхума фид дунйа ма`рууфан ваттаби` сабиила ман анаба илаййа сумма илаййа маржи`укум фа'унаббиукум бима кунтум та`малуун","А если они будут сражаться с тобой, чтобы ты приобщил ко Мне сотоварищей, о которых у тебя нет знаний, то не повинуйся им, но сопровождай их в этом мире по-доброму и следуй путем тех, кто обратился ко Мне. Потом вам предстоит вернуться ко Мне, и Я поведаю вам о том, что вы совершили.",["а если","они оба будут принуждать тебя","к тому","чтобы","ты приобщил сотоварищей","ко Мне","то, о чём","нет","у тебя","о нём","знания","то не","повинуйся им обоим","и сопровождай их обоих","в","этом мире","по-доброму","и следуй","путём","того, кто","обратился","ко Мне","затем","ко Мне","ваше возвращение","и Я поведаю вам","о том, что","вы","делали"]],[31,16,["يَٰبُنَيَّ","إِنَّهَآ","إِن","تَكُ","مِثۡقَالَ","حَبَّةٖ","مِّنۡ","خَرۡدَلٖ","فَتَكُن","فِي","صَخۡرَةٍ","أَوۡ","فِي","ٱلسَّمَٰوَٰتِ","أَوۡ","فِي","ٱلۡأَرۡضِ","يَأۡتِ","بِهَا","ٱللَّهُۚ","إِنَّ","ٱللَّهَ","لَطِيفٌ","خَبِيرٞ"],"йабунаййа иннаха ин таку мисḳала хаббатим мин хардалин фатакун фии сахратин ау фис самавати ау фил арди йа'ти бихаллаху инналлаха латиифун хабиир","О сын мой! Если нечто весом с горчичное зернышко будет внутри скалы, или на небесах, или в земле, то Аллах принесет его. Воистину, Аллах - Проницательный (или Добрый), Ведающий.",["о сынок мой","поистине, она","если","будет она","весом","зерна","из","горчицы","и будет она","в","скале","или","на","небесах","или","в","земле","принесёт","её","Аллах","поистине","Аллах","Проницательный","Ведающий"]],[31,17,["يَٰبُنَيَّ","أَقِمِ","ٱلصَّلَوٰةَ","وَأۡمُرۡ","بِٱلۡمَعۡرُوفِ","وَٱنۡهَ","عَنِ","ٱلۡمُنكَرِ","وَٱصۡبِرۡ","عَلَىٰ","مَآ","أَصَابَكَۖ","إِنَّ","ذَٰلِكَ","مِنۡ","عَزۡمِ","ٱلۡأُمُورِ"],"йабунаййа аḳимис салавата ва'мур билма`рууфи ванха `анил мункари васбир `ала ма асабака инна залика мин `азмил умуур","О сын мой! Совершай намаз, повелевай совершать одобряемое, запрещай предосудительное и терпеливо сноси все, что постигает тебя. Воистину, в этих делах надлежит проявлять решимость.",["о сынок мой","совершай","намаз","и повелевай","одобряемое","и удерживай","от","порицаемого","и терпи","в","том, что","постигло тебя","поистине","это","из","решимости","в делах"]],[31,18,["وَلَا","تُصَعِّرۡ","خَدَّكَ","لِلنَّاسِ","وَلَا","تَمۡشِ","فِي","ٱلۡأَرۡضِ","مَرَحًاۖ","إِنَّ","ٱللَّهَ","لَا","يُحِبُّ","كُلَّ","مُخۡتَالٖ","فَخُورٖ"],"вала туса``ир хаддака линнаси вала тамши фил арди марахан инналлаха ла йухиббу кулла мухталин фахуур","Не отворачивай своего лица от людей из высокомерия и не шествуй по земле кичливо. Воистину, Аллах не любит всяких гордецов и бахвалов.",["и не","отворачивай","свою щеку","от людей","и не","ходи","по","земле","кичливо","поистине","Аллах","не","любит","всякого","гордеца","хвастуна"]],[31,19,["وَٱقۡصِدۡ","فِي","مَشۡيِكَ","وَٱغۡضُضۡ","مِن","صَوۡتِكَۚ","إِنَّ","أَنكَرَ","ٱلۡأَصۡوَٰتِ","لَصَوۡتُ","ٱلۡحَمِيرِ"],"ваḳсид фии машйика вагдуд мин саутика инна анкарал асвати ласаутул хамиир","Ступай размеренной поступью и понижай свой голос, ибо самый неприятный голос - это рев осла.",["и соблюдай меру","в","своей ходьбе","и понижай","(часть)","своего голоса","поистине","самый неприятный","из голосов","непременно голос","ослов"]]],"m":[[["وَلَقَدۡ","и уже",31,12],["ءَاتَيۡنَا","Мы даровали",31,12],["لُقۡمَٰنَ","Лукману",31,12],["ٱلۡحِكۡمَةَ","мудрость",31,12],["أَنِ","что",31,12],["ٱشۡكُرۡ","благодари",31,12],["لِلَّهِۚ","Аллаха",31,12],["وَمَن","и кто",31,12],["يَشۡكُرۡ","благодарит",31,12],["فَإِنَّمَا","то лишь",31,12]],[["يَشۡكُرُ","бл