{"p":413,"j":21,"a":[[31,20,["أَلَمۡ","تَرَوۡاْ","أَنَّ","ٱللَّهَ","سَخَّرَ","لَكُم","مَّا","فِي","ٱلسَّمَٰوَٰتِ","وَمَا","فِي","ٱلۡأَرۡضِ","وَأَسۡبَغَ","عَلَيۡكُمۡ","نِعَمَهُۥ","ظَٰهِرَةٗ","وَبَاطِنَةٗۗ","وَمِنَ","ٱلنَّاسِ","مَن","يُجَٰدِلُ","فِي","ٱللَّهِ","بِغَيۡرِ","عِلۡمٖ","وَلَا","هُدٗى","وَلَا","كِتَٰبٖ","مُّنِيرٖ"],"алам тарау анналлаха саххара лакум ма фис самавати вама фил арди ва'асбага `алайкум ни`амахуу захиратан вабатинатан ваминан наси ман йужадилу филлахи бигайри `илмин вала худан вала китабим муниир","Неужели вы не видите, что Аллах подчинил вам то, что на небесах, и то, что на земле, и одарил вас сполна Своими явными и незримыми благами? Но среди людей находится такой, который спорит об Аллахе, не имея ни знания, ни верного руководства, ни озаряющего Писания.",["разве не","видите вы","что","Аллах","подчинил","вам","то, что","на","небесах","и то, что","на","земле","и Он излил сполна","на вас","Свои блага","явные","и скрытые","и среди","людей","тот, кто","спорит","об","Аллахе","без","знания","и без","руководства","и без","Писания","озаряющего"]],[31,21,["وَإِذَا","قِيلَ","لَهُمُ","ٱتَّبِعُواْ","مَآ","أَنزَلَ","ٱللَّهُ","قَالُواْ","بَلۡ","نَتَّبِعُ","مَا","وَجَدۡنَا","عَلَيۡهِ","ءَابَآءَنَآۚ","أَوَلَوۡ","كَانَ","ٱلشَّيۡطَٰنُ","يَدۡعُوهُمۡ","إِلَىٰ","عَذَابِ","ٱلسَّعِيرِ"],"ва'иза ḳиила лахумуттаби`уу ма анзалаллаху ḳалуу бал наттаби`у ма важадна `алайхи абаана авалау канаш шайтану йад`уухум ила `азабис са`иир","Когда им говорят: «Следуйте за тем, что ниспослал Аллах!». - они говорят: «О нет! Мы будем следовать тому, чему следовали наши отцы». А если дьявол позовет их к мучениям в Пламени?",["и когда","говорят","им","следуйте","тому, что","ниспослал","Аллах","они говорят","нет","мы следуем","тому, что","мы застали","на нём","наших отцов","а даже если","был","дьявол","зовёт их","к","мучению","Пламени"]],[31,22,["وَمَن","يُسۡلِمۡ","وَجۡهَهُۥٓ","إِلَى","ٱللَّهِ","وَهُوَ","مُحۡسِنٞ","فَقَدِ","ٱسۡتَمۡسَكَ","بِٱلۡعُرۡوَةِ","ٱلۡوُثۡقَىٰۗ","وَإِلَى","ٱللَّهِ","عَٰقِبَةُ","ٱلۡأُمُورِ"],"ваман йуслим важхахуу илаллахи вахуа мухсинун фаḳадистамсака бил`урватил вусḳа ва'илаллахи `аḳибатул умуур","Кто подчинил свой лик Аллаху, будучи творящим добро, тот ухватился за надежную рукоять, а решение всех дел - за Аллахом.",["и кто","покорит","своё лицо","пред","Аллахом","и он","творящий добро","то уже","он ухватился","за рукоять","надёжнейшую","и к","Аллаху","исход","дел"]],[31,23,["وَمَن","كَفَرَ","فَلَا","يَحۡزُنكَ","كُفۡرُهُۥٓۚ","إِلَيۡنَا","مَرۡجِعُهُمۡ","فَنُنَبِّئُهُم","بِمَا","عَمِلُوٓاْۚ","إِنَّ","ٱللَّهَ","عَلِيمُۢ","بِذَاتِ","ٱلصُّدُورِ"],"ваман кафара фала йахзунка куфрухуу илайна маржи`ухум фанунаббиухум бима `амилуу инналлаха `алииму бизатис судуур","А если кто не уверовал, то пусть его неверие не печалит тебя. Им предстоит вернутся к Нам, и Мы поведаем им о том, что они совершили. Воистину, Аллах знает о том, что в груди.",["а кто","не уверовал","то пусть не","печалит тебя","его неверие","к Нам","их возвращение","и Мы поведаем им","о том, что","они делали","поистине","Аллах","знает","о том, что в","грудях"]],[31,24,["نُمَتِّعُهُمۡ","قَلِيلٗا","ثُمَّ","نَضۡطَرُّهُمۡ","إِلَىٰ","عَذَابٍ","غَلِيظٖ"],"нуматти`ухум ḳалиилан сумма надтаррухум ила `азабин галииз","Мы позволим им пользоваться благами недолгое время, а потом принудим к страшным мучениям.",["Мы даём им пользоваться","немного","затем","Мы принудим их","к","наказанию","суровому"]],[31,25,["وَلَئِن","سَأَلۡتَهُم","مَّنۡ","خَلَقَ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضَ","لَيَقُولُنَّ","ٱللَّهُۚ","قُلِ","ٱلۡحَمۡدُ","لِلَّهِۚ","بَلۡ","أَكۡثَرُهُمۡ","لَا","يَعۡلَمُونَ"],"валаин са'алтахум ман халаḳас самавати вал'арда лайаḳуулунналлаху ḳулил хамду лиллахи бал аксарухум ла йа`ламуун","Если ты спросишь их: «Кто сотворил небеса и землю?». - они непременно скажут: «Аллах». Скажи: «Хвала Аллаху!». Но большинство их не знает.",["и если","ты спросишь их","кто","сотворил","небеса","и землю","непременно скажут они","Аллах","скажи","хвала","Аллаху","но","большинство из них","не","знает"]],[31,26,["لِلَّهِ","مَا","فِي","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِۚ","إِنَّ","ٱللَّهَ","هُوَ","ٱلۡغَنِيُّ","ٱلۡحَمِيدُ"],"лиллахи ма фис самавати вал'арди инналлаха хуал ганиййул хамиид","Аллаху принадлежит то, что на небесах и на земле. Воистину, Аллах - Богатый, Достохвальный.",["Аллаху","то, что","в","небесах","и на земле","поистине","Аллах","Он","Богатый","Достохвальный"]],[31,27,["وَلَوۡ","أَنَّمَا","فِي","ٱلۡأَرۡضِ","مِن","شَجَرَةٍ","أَقۡلَٰمٞ","وَٱلۡبَحۡرُ","يَمُدُّهُۥ","مِنۢ","بَعۡدِهِۦ","سَبۡعَةُ","أَبۡحُرٖ","مَّا","نَفِدَتۡ","كَلِمَٰتُ","ٱللَّهِۚ","إِنَّ","ٱللَّهَ","عَزِيزٌ","حَكِيمٞ"],"валау аннама фил арди мин шажаратин аḳламун валбахру йамуддухуу мим ба`дихии саб`ату абхурим ма нафидат калиматуллахи инналлаха `азиизун хакиим","Если бы все деревья земли стали письменными тростями, а за морем чернил находилось еще семь морей, то не исчерпались бы Слова Аллаха. Воистину, Аллах - Могущественный, Мудрый.",["и если бы","то, что","на","земле","из","деревьев","(были) перьями","и море","пополняло бы его","с","после него","семь","морей","не","иссякли бы","слова","Аллаха","поистине","Аллах","Могущественный","Мудрый"]],[31,28,["مَّا","خَلۡقُكُمۡ","وَلَا","بَعۡثُكُمۡ","إِلَّا","كَنَفۡسٖ","وَٰحِدَةٍۚ","إِنَّ","ٱللَّهَ","سَمِيعُۢ","بَصِيرٌ"],"мма халḳукум вала ба`сукум илла канафсин вахидатин инналлаха самии`у басиир","Сотворение и воскрешение ваше подобно сотворению и воскрешению одного человека. Воистину, Аллах - Слышащий, Видящий.",["не","сотворение ваше","и не","воскрешение ваше","кроме как","как душа","одна","поистине","Аллах","Слышащий","Видящий"]]],"m":[[["أَلَمۡ","разве не",31,20],["تَرَوۡاْ","видите вы",31,20],["أَنَّ","что",31,20],["ٱللَّهَ","Аллах",31,20],["سَخَّرَ","подчинил",31,20],["لَكُم","вам",31,20],["مَّا","то, что",31,20],["فِي","на",31,20],["ٱلسَّمَٰوَٰتِ","небесах",31,20],["وَمَا","и то, что",31,20],["فِي","на",31,20],["ٱلۡأَرۡضِ","земле",31,20],["وَأَسۡبَغَ","и Он излил сполна",31,20]],[["عَلَيۡكُمۡ","на вас",31,20],["نِعَمَهُۥ","Свои блага",31,20],["ظَٰهِرَةٗ","явные",31,20],["وَبَاطِنَةٗۗ","и скрытые",31,20],["وَمِنَ","и среди",31,20],["ٱلنَّاسِ","людей",31,20],["مَن","тот, кто",31,20],["يُجَٰدِلُ","спорит",31,20],["فِي","об",31,20],["ٱللَّهِ","Аллахе",31,20]],[["بِغَيۡرِ","без",31,20],["عِلۡمٖ","знания",31,20],["وَلَا","и без",31,20],["هُدٗى","руководства",31,20],["وَلَا","и без",31,20],["كِتَٰبٖ","Писания",31,20],["مُّنِيرٖ","озаряющего",31,20],[20],["وَإِذَا","и когда",31,21],["قِيلَ","говорят",31,21],["لَهُمُ","им",31,21],["ٱتَّبِعُواْ","следуйте",31,21]],[["مَآ","тому, что",31,21],["أَنزَلَ","ниспослал",31,21],["ٱللَّهُ","Аллах",31,21],["قَالُواْ","они говорят",31,21],["بَلۡ","нет",31,21],["نَتَّبِعُ","мы следуем",31,21],["مَا","тому, что",31,21],["وَجَدۡنَا","мы застали",31,21],["عَلَيۡهِ","на нём",31,21],["ءَابَآءَنَآۚ","наших отцов",31,21],["أَوَلَوۡ","а даже если",31,21],["كَانَ","был",31,21]],[["ٱلشَّيۡطَٰنُ","дьявол",31,21],["يَدۡعُوهُمۡ","зовёт их",31,21],["إِلَىٰ","к",31,21],["عَذَابِ","мучению",31,21],["ٱلسَّعِيرِ","Пламени",31,21],[21],["۞ وَمَن","и кто",31,22],["يُسۡلِمۡ","покорит",31,22]],[["وَجۡهَهُۥٓ","своё лицо",31,22],["إِلَى","пред",31,22],["ٱللَّهِ","Аллахом",31,22],["وَهُوَ","и он",31,22],["مُحۡسِنٞ","творящий добро",31,22],["فَقَدِ","то уже",31,22],["ٱسۡتَمۡسَكَ","он ухватился",31,22],["بِٱلۡعُرۡوَةِ","за рукоять",31,22],["ٱلۡوُثۡقَىٰۗ","надёжнейшую",31,22]],[["وَإِلَى","и к",31,22],["ٱللَّهِ","Аллаху",31,22],["عَٰقِبَةُ","исход",31,22],["ٱلۡأُمُورِ","дел",31,22],[22],["وَمَن","а кто",31,23],["كَفَرَ","не уверовал",31,23],["فَلَا","то пусть не",31,23],["يَحۡزُنكَ","печалит тебя",31,23],["كُفۡرُهُۥٓۚ","его неверие",31,23]],[["إِلَيۡنَا","к Нам",31,23],["مَرۡجِعُهُمۡ","их возвращение",31,23],["فَنُنَبِّئُهُم","и Мы поведаем им",31,23],["بِمَا","о том, что",31,23],["عَمِلُوٓاْۚ","они делали",31,23],["إِنَّ","поистине",31,23],["ٱللَّهَ","Аллах",31,23],["عَلِيمُۢ","знает",31,23],["بِذَاتِ","о том, что в",31,23],["ٱلصُّدُورِ","грудях",31,23]],[[23],["نُمَتِّعُهُمۡ","Мы даём им пользоваться",31,24],["قَلِيلٗا","немного",31,24],["ثُمَّ","затем",31,24],["نَضۡطَرُّهُمۡ","Мы принудим их",31,24],["إِلَىٰ","к",31,24],["عَذَابٍ","наказанию",31,24],["غَلِيظٖ","суровому",31,24],[24]],[["وَلَئِن","и если",31,25],["سَأَلۡتَهُم","ты спросишь их",31,25],["مَّنۡ","кто",31,25],["خَلَقَ","сотворил",31,25],["ٱلسَّمَٰوَٰتِ","небеса",31,25],["وَٱلۡأَرۡضَ","и землю",31,25],["لَيَقُولُنَّ","непременно скажут они",31,25],["ٱللَّهُۚ","Аллах",31,25],["قُلِ","скажи",31,25]],[["ٱلۡحَمۡدُ","хвала",31,25],["لِلَّهِۚ","Аллаху",31,25],["بَلۡ","но",31,25],["أَكۡثَرُهُمۡ","большинство из них",31,25],["لَا","не",31,25],["يَعۡلَمُونَ","знает",31,25],[25],["لِلَّهِ","Аллаху",31,26],["مَا","то, что",31,26],["فِي","в",31,26],["ٱلسَّمَٰوَٰتِ","небесах",31,26]],[["وَٱلۡأَرۡضِۚ","и на земле",31,26],["إِنَّ","поистине",31,26],["ٱللَّهَ","Аллах",31,26],["هُوَ","Он",31,26],["ٱلۡغَنِيُّ","Богатый",31,26],["ٱلۡحَمِيدُ","Достохвальный",31,26],[26],["وَلَوۡ","и если бы",31,27],["أَنَّمَا","то, что",31,27],["فِي","на",31,27],["ٱلۡأَرۡضِ","земле",31,27]],[["مِن","из",31,27],["شَجَرَةٍ","деревьев",31,27],["أَقۡلَٰمٞ","(были) перьями",31,27],["وَٱلۡبَحۡرُ","и море",31,27],["يَمُدُّهُۥ","пополняло бы его",31,27],["مِنۢ","с",31,27],["بَعۡدِهِۦ","после него",31,27],["سَبۡعَةُ","семь",31,27],["أَبۡحُرٖ","морей",31,27]],[["مَّا","не",31,27],["نَفِدَتۡ","иссякли бы",31,27],["كَلِمَٰتُ","слова",31,27],["ٱللَّهِۚ","Аллаха",31,27],["إِنَّ","поистине",31,27],["ٱللَّهَ","Аллах",31,27],["عَزِيزٌ","Могущественный",31,27],["حَكِيمٞ","Мудрый",31,27],[27],["مَّا","не",31,28],["خَلۡقُكُمۡ","сотворение ваше",31,28]],[["وَلَا","и не",31,28],["بَعۡثُكُمۡ","воскрешение ваше",31,28],["إِلَّا","кроме как",31,28],["كَنَفۡسٖ","как душа",31,28],["وَٰحِدَةٍۚ","одна",31,28],["إِنَّ","поистине",31,28],["ٱللَّهَ","Аллах",31,28],["سَمِيعُۢ","Слышащий",31,28],["بَصِيرٌ","Видящий",31,28],[28]]]}