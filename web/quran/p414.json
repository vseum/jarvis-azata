{"p":414,"j":21,"a":[[31,29,["أَلَمۡ","تَرَ","أَنَّ","ٱللَّهَ","يُولِجُ","ٱلَّيۡلَ","فِي","ٱلنَّهَارِ","وَيُولِجُ","ٱلنَّهَارَ","فِي","ٱلَّيۡلِ","وَسَخَّرَ","ٱلشَّمۡسَ","وَٱلۡقَمَرَۖ","كُلّٞ","يَجۡرِيٓ","إِلَىٰٓ","أَجَلٖ","مُّسَمّٗى","وَأَنَّ","ٱللَّهَ","بِمَا","تَعۡمَلُونَ","خَبِيرٞ"],"алам тара анналлаха йуулижул лайла фин нахари вайуулижун нахара фил лайли васаххараш шамса валḳамара куллун йажрии ила ажалим мусамман ва'анналлаха бима та`малууна хабиир","Разве ты не видишь, что Аллах удлиняет день за счет ночи и удлиняет ночь за счет дня, и подчинил солнце и луну, которые движутся к назначенному сроку, и что Аллаху ведомо о том, что вы совершаете?",["разве не","видишь ты","что","Аллах","вводит","ночь","в","день","и вводит","день","в","ночь","и подчинил","солнце","и луну","каждый","движется","до","срока","назначенного","и что","Аллах","о том, что","вы делаете","Ведающий"]],[31,30,["ذَٰلِكَ","بِأَنَّ","ٱللَّهَ","هُوَ","ٱلۡحَقُّ","وَأَنَّ","مَا","يَدۡعُونَ","مِن","دُونِهِ","ٱلۡبَٰطِلُ","وَأَنَّ","ٱللَّهَ","هُوَ","ٱلۡعَلِيُّ","ٱلۡكَبِيرُ"],"залика би'анналлаха хуал хаḳḳу ва'анна ма йад`ууна мин дуунихил батилу ва'анналлаха хуал `алиййул кабиир","Это потому, что Аллах является Истиной, а все, к чему взывают помимо Него, является ложью, а также потому, что Аллах - Возвышенный, Большой.",["это","потому, что","Аллах","Он","Истина","и что","то, что","призывают они","из","помимо Него","ложь","и что","Аллах","Он","Высокий","Великий"]],[31,31,["أَلَمۡ","تَرَ","أَنَّ","ٱلۡفُلۡكَ","تَجۡرِي","فِي","ٱلۡبَحۡرِ","بِنِعۡمَتِ","ٱللَّهِ","لِيُرِيَكُم","مِّنۡ","ءَايَٰتِهِۦٓۚ","إِنَّ","فِي","ذَٰلِكَ","لَأٓيَٰتٖ","لِّكُلِّ","صَبَّارٖ","شَكُورٖ"],"алам тара аннал фулка тажрии фил бахри бини`матиллахи лийурийакум мин айатихии инна фии залика ла'айатил ликулли саббарин шакуур","Разве ты не видишь, что по милости Аллаха корабль плывет по морю, чтобы Он показал вам некоторые из Своих знамений? Воистину, в этом - знамения для каждого, кто терпелив и благодарен.",["разве не","видишь ты","что","корабли","плывут","по","морю","по милости","Аллаха","чтобы показал Он вам","из","знамений Его","поистине","в","этом","непременно знамения","для каждого","терпеливого","благодарного"]],[31,32,["وَإِذَا","غَشِيَهُم","مَّوۡجٞ","كَٱلظُّلَلِ","دَعَوُاْ","ٱللَّهَ","مُخۡلِصِينَ","لَهُ","ٱلدِّينَ","فَلَمَّا","نَجَّىٰهُمۡ","إِلَى","ٱلۡبَرِّ","فَمِنۡهُم","مُّقۡتَصِدٞۚ","وَمَا","يَجۡحَدُ","بِـَٔايَٰتِنَآ","إِلَّا","كُلُّ","خَتَّارٖ","كَفُورٖ"],"ва'иза гашийахум маужун каззулали да`авуллаха мухлисиина лахуд диина фаламма нажжахум илал барри фаминхум муḳтасидун вама йажхаду би'айатина илла куллу хаттарин кафуур","Когда волна накрывает их, словно тень, они взывают к Аллаху, очищая перед Ним свою веру. Когда же Он спасает их и выводит на сушу, то среди них находится тот, кто проявляет умеренность (проявляет покорность или уклоняется от должной благодарности). Но отвергают Наши знамения только неблагодарные изменники.",["и когда","покрывает их","волна","как навесы","взывают они","к Аллаху","искренне посвящая","Ему","веру","а когда","спас Он их","на","сушу","то среди них","умеренный","и не","отвергает","Наши знамения","кроме","всякий","вероломный","неблагодарный"]],[31,33,["يَٰٓأَيُّهَا","ٱلنَّاسُ","ٱتَّقُواْ","رَبَّكُمۡ","وَٱخۡشَوۡاْ","يَوۡمٗا","لَّا","يَجۡزِي","وَالِدٌ","عَن","وَلَدِهِۦ","وَلَا","مَوۡلُودٌ","هُوَ","جَازٍ","عَن","وَالِدِهِۦ","شَيۡـًٔاۚ","إِنَّ","وَعۡدَ","ٱللَّهِ","حَقّٞۖ","فَلَا","تَغُرَّنَّكُمُ","ٱلۡحَيَوٰةُ","ٱلدُّنۡيَا","وَلَا","يَغُرَّنَّكُم","بِٱللَّهِ","ٱلۡغَرُورُ"],"йа'аййухан насуттаḳуу раббакум вахшау йаумал ла йажзии валидун `ан валадихии вала маулуудун хуа жазин `ан валидихии шай'ан инна ва`даллахи хаḳḳун фала тагурраннакумул хайаватуд дунйа вала йагурраннакум биллахил гаруур","О люди! Бойтесь вашего Господа и страшитесь того дня, когда родитель никак не защитит своего ребенка, а ребенок - своего родителя. Обещание Аллаха истинно, и пусть не обольщает вас мирская жизнь, и пусть соблазнитель (дьявол) не обольщает вас относительно Аллаха.",["о","люди","бойтесь","Господа вашего","и страшитесь","дня","не","поможет","родитель","за","ребёнка своего","и не","рождённый","он","помогающий","за","родителя своего","ничем","поистине","обещание","Аллаха","истинно","так пусть не","обольщает вас","жизнь","ближняя","и пусть не","обольщает вас","об Аллахе","обольститель"]],[31,34,["إِنَّ","ٱللَّهَ","عِندَهُۥ","عِلۡمُ","ٱلسَّاعَةِ","وَيُنَزِّلُ","ٱلۡغَيۡثَ","وَيَعۡلَمُ","مَا","فِي","ٱلۡأَرۡحَامِۖ","وَمَا","تَدۡرِي","نَفۡسٞ","مَّاذَا","تَكۡسِبُ","غَدٗاۖ","وَمَا","تَدۡرِي","نَفۡسُۢ","بِأَيِّ","أَرۡضٖ","تَمُوتُۚ","إِنَّ","ٱللَّهَ","عَلِيمٌ","خَبِيرُۢ"],"инналлаха `индахуу `илмус са`ати вайуназзилул гайса вайа`ламу ма фил архами вама тадрии нафсум маза таксибу гадан вама тадрии нафсу би'аййи ардин тамууту инналлаха `алиимун хабиир","Воистину, только Аллах обладает знанием о Часе, ниспосылает дождь и знает о том, что в утробах. Ни один человек не знает, что он приобретет завтра, и ни один человек не знает, в какой земле он умрет. Воистину, Аллах - Знающий, Ведающий.",["поистине","Аллах","у Него","знание","Часа","и ниспосылает Он","дождь","и знает","то, что","в","утробах","и не","знает","душа","что","приобретёт она","завтра","и не","знает","душа","в какой","земле","умрёт она","поистине","Аллах","Знающий","Ведающий"]]],"m":[[["أَلَمۡ","разве не",31,29],["تَرَ","видишь ты",31,29],["أَنَّ","что",31,29],["ٱللَّهَ","Аллах",31,29],["يُولِجُ","вводит",31,29],["ٱلَّيۡلَ","ночь",31,29],["فِي","в",31,29],["ٱلنَّهَارِ","день",31,29],["وَيُولِجُ","и вводит",31,29],["ٱلنَّهَارَ","день",31,29],["فِي","в",31,29],["ٱلَّيۡلِ","ночь",31,29]],[["وَسَخَّرَ","и подчинил",31,29],["ٱلشَّمۡسَ","солнце",31,29],["وَٱلۡقَمَرَۖ","и луну",31,29],["كُلّٞ","каждый",31,29],["يَجۡرِيٓ","движется",31,29],["إِلَىٰٓ","до",31,29],["أَجَلٖ","срока",31,29],["مُّسَمّٗى","назначенного",31,29],["وَأَنَّ","и что",31,29],["ٱللَّهَ","Аллах",31,29]],[["بِمَا","о том, что",31,29],["تَعۡمَلُونَ","вы делаете",31,29],["خَبِيرٞ","Ведающий",31,29],[29],["ذَٰلِكَ","это",31,30],["بِأَنَّ","п