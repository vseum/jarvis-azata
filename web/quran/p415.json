{"p":415,"j":21,"a":[[32,1,["الٓمٓ"],"лм","Алиф. Лам. Мим.",["Алиф Лам Мим"]],[32,2,["تَنزِيلُ","ٱلۡكِتَٰبِ","لَا","رَيۡبَ","فِيهِ","مِن","رَّبِّ","ٱلۡعَٰلَمِينَ"],"танзиилул китаби ла райба фиихи мир раббил `аламиин","Это Писание, в котором нет сомнения, ниспослано Господом миров.",["ниспослание","Писания","нет","сомнения","в нём","от","Господа","миров"]],[32,3,["أَمۡ","يَقُولُونَ","ٱفۡتَرَىٰهُۚ","بَلۡ","هُوَ","ٱلۡحَقُّ","مِن","رَّبِّكَ","لِتُنذِرَ","قَوۡمٗا","مَّآ","أَتَىٰهُم","مِّن","نَّذِيرٖ","مِّن","قَبۡلِكَ","لَعَلَّهُمۡ","يَهۡتَدُونَ"],"ам йаḳуулуунафтараху бал хуал хаḳḳу мир раббика литунзира ḳаумам ма атахум мин назиирим мин ḳаблика ла`аллахум йахтадуун","Или же они скажут: «Он измыслил его»? Нет, оно является истиной от твоего Господа, чтобы ты предостерег людей, к которым до тебя не приходил предостерегающий увещеватель, - быть может, они последуют прямым путем.",["или","говорят они","измыслил он его","нет","оно","истина","от","Господа твоего","чтобы ты предостерёг","людей","не","приходил к ним","никакой","увещеватель","от","до тебя","быть может, они","последуют прямым путём"]],[32,4,["ٱللَّهُ","ٱلَّذِي","خَلَقَ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضَ","وَمَا","بَيۡنَهُمَا","فِي","سِتَّةِ","أَيَّامٖ","ثُمَّ","ٱسۡتَوَىٰ","عَلَى","ٱلۡعَرۡشِۖ","مَا","لَكُم","مِّن","دُونِهِۦ","مِن","وَلِيّٖ","وَلَا","شَفِيعٍۚ","أَفَلَا","تَتَذَكَّرُونَ"],"аллахул лазии халаḳас самавати вал'арда вама байнахума фии ситтати аййамин суммастава `алал `арши ма лакум мин дуунихии мин валиййин вала шафии`ин афала татазаккаруун","Аллах - Тот, Кто создал небеса и землю и то, что между ними, за шесть дней, а затем вознесся на Трон (или утвердился на Троне). Нет для вас, помимо Него, ни покровителя, ни заступника. Неужели вы не помяните назидание?",["Аллах","Тот, Который","создал","небеса","и землю","и то, что","между ними","за","шесть","дней","затем","вознёсся","на","Трон","нет","у вас","из","помимо Него","никакого","покровителя","и не","заступника","неужели не","помянете вы"]],[32,5,["يُدَبِّرُ","ٱلۡأَمۡرَ","مِنَ","ٱلسَّمَآءِ","إِلَى","ٱلۡأَرۡضِ","ثُمَّ","يَعۡرُجُ","إِلَيۡهِ","فِي","يَوۡمٖ","كَانَ","مِقۡدَارُهُۥٓ","أَلۡفَ","سَنَةٖ","مِّمَّا","تَعُدُّونَ"],"йудаббирул амра минас самаи илал арди сумма йа`ружу илайхи фии йаумин кана миḳдарухуу алфа санатим мимма та`уддуун","Он управляет делами с неба до земли, а затем они опять восходят к Нему в течение дня, который продолжается тысячу лет по тому, как вы считаете.",["управляет Он","делом","с","неба","до","земли","затем","восходит","к Нему","в","день","(который) был","мера его","тысяча","лет","из того, что","вы считаете"]],[32,6,["ذَٰلِكَ","عَٰلِمُ","ٱلۡغَيۡبِ","وَٱلشَّهَٰدَةِ","ٱلۡعَزِيزُ","ٱلرَّحِيمُ"],"залика `алимул гайби вашшахадатил `азиизур рахиим","Таков Ведающий сокровенное и явное, Могущественный, Милосердный,",["это","Знающий","сокровенное","и явное","Могущественный","Милосердный"]],[32,7,["ٱلَّذِيٓ","أَحۡسَنَ","كُلَّ","شَيۡءٍ","خَلَقَهُۥۖ","وَبَدَأَ","خَلۡقَ","ٱلۡإِنسَٰنِ","مِن","طِينٖ"],"аллазии ахсана кулла шай'ин халаḳахуу вабадаа халḳал инсани мин тиин","Который превосходно создал все, что сотворил, и начал создавать человека из глины,",["Который","сделал прекрасной","всякую","вещь","создал Он её","и начал","создание","человека","из","глины"]],[32,8,["ثُمَّ","جَعَلَ","نَسۡلَهُۥ","مِن","سُلَٰلَةٖ","مِّن","مَّآءٖ","مَّهِينٖ"],"сумма жа`ала наслахуу мин сулалатим мим маим махиин","затем создал его потомство из капли презренной жидкости,",["затем","сделал Он","потомство его","из","вытяжки","из","воды","презренной"]],[32,9,["ثُمَّ","سَوَّىٰهُ","وَنَفَخَ","فِيهِ","مِن","رُّوحِهِۦۖ","وَجَعَلَ","لَكُمُ","ٱلسَّمۡعَ","وَٱلۡأَبۡصَٰرَ","وَٱلۡأَفۡـِٔدَةَۚ","قَلِيلٗا","مَّا","تَشۡكُرُونَ"],"сумма савваху ванафаха фиихи мир руухихии важа`ала лакумус сам`а вал'абсара вал'аф'идата ḳалиилам ма ташкуруун","затем придал ему соразмерный облик, вдохнул в него от Своего духа и даровал вам слух, зрение и сердца. Но как мала ваша благодарность!",["затем","соразмерил Он его","и вдунул","в него","из","духа Своего","и сделал","для вас","слух","и зрение","и сердца","мало","(как)","благодарите вы"]],[32,10,["وَقَالُوٓاْ","أَءِذَا","ضَلَلۡنَا","فِي","ٱلۡأَرۡضِ","أَءِنَّا","لَفِي","خَلۡقٖ","جَدِيدِۭۚ","بَلۡ","هُم","بِلِقَآءِ","رَبِّهِمۡ","كَٰفِرُونَ"],"ваḳалуу а'иза далална фил арди а'инна лафии халḳин жадииди бал хум билиḳаи раббихим кафируун","Они говорят: «Неужели после того, как мы затеряемся в земле, мы возродимся в новом творении?». Но они не веруют во встречу со своим Господом.",["и сказали они","неужели когда","затерялись мы","в","земле","неужели мы","непременно в","творении","новом","нет","они","во встречу","с Господом их","неверующие"]],[32,11,["قُلۡ","يَتَوَفَّىٰكُم","مَّلَكُ","ٱلۡمَوۡتِ","ٱلَّذِي","وُكِّلَ","بِكُمۡ","ثُمَّ","إِلَىٰ","رَبِّكُمۡ","تُرۡجَعُونَ"],"ḳул йатаваффакум малакул маутил лазии вуккила бикум сумма ила раббикум туржа`уун","Скажи: «Ангел смерти, которому вы поручены, умертвит вас, а затем вы будете возвращены к своему Господу».",["скажи","упокоит вас","ангел","смерти","который","поставлен","над вами","затем","к","Господу вашему","вы будете возвращены"]]],"m":[["b"],[["الٓمٓ","Алиф Лам Мим",32,1],[1],["تَنزِيلُ","ниспослание",32,2],["ٱلۡكِتَٰبِ","Писания",32,2],["لَا","нет",32,2],["رَيۡبَ","сомнения",32,2],["فِيهِ","в нём",32,2],["مِن","от",32,2],["رَّبِّ","Господа",32,2],["ٱلۡعَٰلَمِينَ","миров",32,2]],[[2],["أَمۡ","или",32,3],["يَقُولُونَ","говорят они",32,3],["ٱفۡتَرَىٰهُۚ","измыслил он его",32,3],["بَلۡ","нет",32,3],["هُوَ","оно",32,3],["ٱلۡحَقُّ","истина",32,3],["مِن","от",32,3],["رَّبِّكَ","Господа твоего",32,3],["لِتُنذِرَ","чтобы ты предостерёг",32,3],["قَوۡمٗا","людей",32,3]],[["مَّآ","не",32,3],["أَتَىٰهُم","приходил к ним",32,3],["مِّن","никакой",32,3],["نَّذِيرٖ","увещеватель",32,3],["مِّن","от",32,3],["قَبۡلِكَ","до тебя",32,3],["لَعَلَّهُمۡ","быть может, они",32,3],["يَهۡتَدُونَ","последуют прямым путём",32,3],[3],["ٱللَّهُ","Аллах",32,4]],[["ٱلَّذِي","Тот, Который",32,4],["خَلَقَ","создал",32,4],["ٱلسَّمَٰوَٰتِ","небеса",32,4],["وَٱلۡأَرۡضَ","и землю",32,4],["وَمَا","и то, что",32,4],["بَيۡنَهُمَا","между ними",32,4],["فِي","за",32,4],["سِتَّةِ","шесть",32,4],["أَيَّامٖ","дней",32,4]],[["ثُمَّ","затем",32,4],["ٱسۡتَوَىٰ","вознёсся",32,4],["عَلَى","на",32,4],["ٱلۡعَرۡشِۖ","Трон",32,4],["مَا","нет",32,4],["لَكُم","у вас",32,4],["مِّن","из",32,4],["دُونِهِۦ","помимо Него",32,4],["مِن","никакого",32,4],["وَلِيّٖ","покровителя",32,4],["وَلَا","и не",32,4],["شَفِيعٍۚ","заступника",32,4],["أَفَلَا","неужели не",32,4]],[["تَتَذَكَّرُونَ","помянете вы",32,4],[4],["يُدَبِّرُ","управляет Он",32,5],["ٱلۡأَمۡرَ","делом",32,5],["مِنَ","с",32,5],["ٱلسَّمَآءِ","неба",32,5],["إِلَى","до",32,5],["ٱلۡأَرۡضِ","земли",32,5],["ثُمَّ","затем",32,5],["يَعۡرُجُ","восходит",32,5]],[["إِلَيۡهِ","к Нему",32,5],["فِي","в",32,5],["يَوۡمٖ","день",32,5],["كَانَ","(который) был",32,5],["مِقۡدَارُهُۥٓ","мера его",32,5],["أَلۡفَ","тысяча",32,5],["سَنَةٖ","лет",32,5],["مِّمَّا","из того, что",32,5],["تَعُدُّونَ","вы считаете",32,5],[5],["ذَٰلِكَ","это",32,6]],[["عَٰلِمُ","Знающий",32,6],["ٱلۡغَيۡبِ","сокровенное",32,6],["وَٱلشَّهَٰدَةِ","и явное",32,6],["ٱلۡعَزِيزُ","Могущественный",32,6],["ٱلرَّحِيمُ","Милосердный",32,6],[6],["ٱلَّذِيٓ","Который",32,7],["أَحۡسَنَ","сделал прекрасной",32,7]],[["كُلَّ","всякую",32,7],["شَيۡءٍ","вещь",32,7],["خَلَقَهُۥۖ","создал Он её",32,7],["وَبَدَأَ","и начал",32,7],["خَلۡقَ","создание",32,7],["ٱلۡإِنسَٰنِ","человека",32,7],["مِن","из",32,7],["طِينٖ","глины",32,7],[7],["ثُمَّ","затем",32,8],["جَعَلَ","сделал Он",32,8]],[["نَسۡلَهُۥ","потомство его",32,8],["مِن","из",32,8],["سُلَٰلَةٖ","вытяжки",32,8],["مِّن","из",32,8],["مَّآءٖ","воды",32,8],["مَّهِينٖ","презренной",32,8],[8],["ثُمَّ","затем",32,9],["سَوَّىٰهُ","соразмерил Он его",32,9],["وَنَفَخَ","и вдунул",32,9],["فِيهِ","в него",32,9]],[["مِن","из",32,9],["رُّوحِهِۦۖ","духа Своего",32,9],["وَجَعَلَ","и сделал",32,9],["لَكُمُ","для вас",32,9],["ٱلسَّمۡعَ","слух",32,9],["وَٱلۡأَبۡصَٰرَ","и зрение",32,9],["وَٱلۡأَفۡـِٔدَةَۚ","и сердца",32,9],["قَ