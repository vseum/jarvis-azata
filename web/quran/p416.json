{"p":416,"j":21,"a":[[32,12,["وَلَوۡ","تَرَىٰٓ","إِذِ","ٱلۡمُجۡرِمُونَ","نَاكِسُواْ","رُءُوسِهِمۡ","عِندَ","رَبِّهِمۡ","رَبَّنَآ","أَبۡصَرۡنَا","وَسَمِعۡنَا","فَٱرۡجِعۡنَا","نَعۡمَلۡ","صَٰلِحًا","إِنَّا","مُوقِنُونَ"],"валау тара изил мужримууна накисуу ру'уусихим `инда раббихим раббана абсарна васами`на фаржи`на на`мал салихан инна мууḳинуун","Если бы ты видел, как грешники опустят головы перед своим Господом: «Господь наш! Мы увидели и услышали. Пошли нас обратно, и мы будем поступать праведно. Воистину, мы обрели убежденность».",["и если бы","ты увидел","когда","грешники","опустившие","головы свои","перед","Господом их","Господь наш","увидели мы","и услышали мы","так верни нас","мы будем делать","праведное","поистине, мы","убеждённые"]],[32,13,["وَلَوۡ","شِئۡنَا","لَأٓتَيۡنَا","كُلَّ","نَفۡسٍ","هُدَىٰهَا","وَلَٰكِنۡ","حَقَّ","ٱلۡقَوۡلُ","مِنِّي","لَأَمۡلَأَنَّ","جَهَنَّمَ","مِنَ","ٱلۡجِنَّةِ","وَٱلنَّاسِ","أَجۡمَعِينَ"],"валау ши'на ла'атайна кулла нафсин худаха валакин хаḳḳал ḳаулу миннии ла'амлаанна жаханнама минал жиннати ваннаси ажма`иин","Если бы Мы пожелали, то наставили бы на прямой путь каждого человека, однако исполнится Слово Мое: «Я непременно заполню Геенну джиннами и людьми - всеми вместе!».",["и если бы","пожелали Мы","непременно дали бы Мы","каждой","душе","руководство её","но","сбылось","слово","от Меня","непременно наполню Я","Геенну","из","джиннов","и людей","всеми"]],[32,14,["فَذُوقُواْ","بِمَا","نَسِيتُمۡ","لِقَآءَ","يَوۡمِكُمۡ","هَٰذَآ","إِنَّا","نَسِينَٰكُمۡۖ","وَذُوقُواْ","عَذَابَ","ٱلۡخُلۡدِ","بِمَا","كُنتُمۡ","تَعۡمَلُونَ"],"фазууḳуу бима насиитум лиḳаа йаумикум хаза инна насиинакум вазууḳуу `азабал хулди бима кунтум та`малуун","Вкусите за то, что вы предали забвению встречу с этим днем вашим. Воистину, Мы предали забвению вас самих. Вкусите же вечные мучения за то, что вы совершали.",["так вкусите","за то, что","забыли вы","встречу","дня вашего","этого","поистине, Мы","забыли Мы вас","и вкусите","наказание","вечности","за то, что","были вы","делали"]],[32,15,["إِنَّمَا","يُؤۡمِنُ","بِـَٔايَٰتِنَا","ٱلَّذِينَ","إِذَا","ذُكِّرُواْ","بِهَا","خَرُّواْۤ","سُجَّدٗاۤ","وَسَبَّحُواْ","بِحَمۡدِ","رَبِّهِمۡ","وَهُمۡ","لَا","يَسۡتَكۡبِرُونَ ۩"],"иннама йу'мину би'айатинал лазиина иза зуккируу биха харруу сужжадан васаббахуу бихамди раббихим вахум ла йастакбируун","Воистину, веруют в Наши знамения только те, которые, когда им напоминают о них, падают ниц, прославляют хвалой своего Господа и не проявляют высокомерия.",["только","веруют","в Наши знамения","те, которые","когда","напоминают им","о них","падают","в земном поклоне","и славят","хвалой","Господа их","и они","не","превозносятся"]],[32,16,["تَتَجَافَىٰ","جُنُوبُهُمۡ","عَنِ","ٱلۡمَضَاجِعِ","يَدۡعُونَ","رَبَّهُمۡ","خَوۡفٗا","وَطَمَعٗا","وَمِمَّا","رَزَقۡنَٰهُمۡ","يُنفِقُونَ"],"татажафа жунуубухум `анил мадажи`и йад`ууна раббахум хауфан ватама`ан вамимма разаḳнахум йунфиḳуун","Они отрывают свои бока от постелей, взывая к своему Господу со страхом и надеждой, и расходуют из того, чем Мы их наделили.",["отрываются","бока их","от","постелей","взывают они","к Господу их","в страхе","и надежде","и из того, что","Мы наделили их","они расходуют"]],[32,17,["فَلَا","تَعۡلَمُ","نَفۡسٞ","مَّآ","أُخۡفِيَ","لَهُم","مِّن","قُرَّةِ","أَعۡيُنٖ","جَزَآءَۢ","بِمَا","كَانُواْ","يَعۡمَلُونَ"],"фала та`ламу нафсум ма ухфийа лахум мин ḳуррати а`йунин жазаа бима кануу йа`малуун","Ни один человек не знает, какие услады для глаз сокрыты для них в воздаяние за то, что они совершали.",["и не","знает","душа","что","скрыто","для них","из","услады","глаз","воздаянием","за то, что","были они","делали"]],[32,18,["أَفَمَن","كَانَ","مُؤۡمِنٗا","كَمَن","كَانَ","فَاسِقٗاۚ","لَّا","يَسۡتَوُۥنَ"],"афаман кана му'минан каман кана фасиḳал ла йаставуун","Неужели верующий подобен нечестивцу? Не равны они!",["неужели тот, кто","был","верующим","как тот, кто","был","нечестивцем","не","равны они"]],[32,19,["أَمَّا","ٱلَّذِينَ","ءَامَنُواْ","وَعَمِلُواْ","ٱلصَّٰلِحَٰتِ","فَلَهُمۡ","جَنَّٰتُ","ٱلۡمَأۡوَىٰ","نُزُلَۢا","بِمَا","كَانُواْ","يَعۡمَلُونَ"],"аммал лазиина амануу ва`амилус салихати фалахум жаннатул ма'ва нузула бима кануу йа`малуун","Для тех, которые уверовали и совершали праведные деяния, Сады пристанища станут угощением за то, что они совершили.",["что касается","тех, которые","уверовали","и совершали","праведные деяния","то для них","сады","пристанища","угощением","за то, что","были они","делали"]],[32,20,["وَأَمَّا","ٱلَّذِينَ","فَسَقُواْ","فَمَأۡوَىٰهُمُ","ٱلنَّارُۖ","كُلَّمَآ","أَرَادُوٓاْ","أَن","يَخۡرُجُواْ","مِنۡهَآ","أُعِيدُواْ","فِيهَا","وَقِيلَ","لَهُمۡ","ذُوقُواْ","عَذَابَ","ٱلنَّارِ","ٱلَّذِي","كُنتُم","بِهِۦ","تُكَذِّبُونَ"],"ва'аммал лазиина фасаḳуу фама'вахумун нару куллама арадуу ан йахружуу минха у`иидуу фииха ваḳиила лахум зууḳуу `азабан нарил лазии кунтум бихии туказзибуун","А пристанищем нечестивцев будет Огонь. Всякий раз, когда они захотят выйти оттуда, их вернут туда, и им будет сказано: «Вкусите мучения в Огне, которые вы считали ложью!».",["а что касается","тех, которые","были нечестивы","то пристанище их","Огонь","всякий раз, как","захотят они","чтобы","выйти они","из него","возвращены они","в него","и сказано","им","вкусите","наказание","Огня","которое","были вы","его","считали ложью"]]],"m":[[["وَلَوۡ","и если бы",32,12],["تَرَىٰٓ","ты увидел",32,12],["إِذِ","когда",32,12],["ٱلۡمُجۡرِمُونَ","грешники",32,12],["نَاكِسُواْ","опустившие",32,12],["رُءُوسِهِمۡ","головы свои",32,12],["عِندَ","перед",32,12],["رَبِّهِمۡ","Господом их",32,12]],[["رَبَّنَآ","Господь наш",32,12],["أَبۡصَرۡنَا","увидели мы",32,12],["وَسَمِعۡنَا","и услышали мы",32,12],["فَٱرۡجِعۡنَا","так верни нас",32,12],["نَعۡمَلۡ","мы будем делать",32,12],["صَٰلِحًا","праведное",32,12],["إِنَّا","поистине, мы",32,12],["مُوقِنُونَ","убеждённые",32,12]],[[12],["وَلَوۡ","и если бы",32,13],["شِئۡنَا","пожелали Мы",32,13],["لَأٓتَيۡنَا","непременно дали бы Мы",32,13],["كُلَّ","каждой",32,13],["نَفۡسٍ","душе",32,13],["هُدَىٰهَا","руководство её",32,13],["وَلَٰكِنۡ","но",32,13],["حَقَّ","сбылось",32,13],["ٱلۡقَوۡلُ","слово",32,13]],[["مِنِّي","от Меня",32,13],["لَأَمۡلَأَنَّ","непременно наполню Я",32,13],["جَهَنَّمَ","Геенну",32,13],["مِنَ","из",32,13],["ٱلۡجِنَّةِ","джиннов",32,13],["وَٱلنَّاسِ","и людей",32,13],["أَجۡمَعِينَ","всеми",32,13],[13]],[["فَذُوقُواْ","так вкусите",32,14],["بِمَا","за то, что",32,14],["نَسِيتُمۡ","забыли вы",32,14],["لِقَآءَ","встречу",32,14],["يَوۡمِكُمۡ","дня вашего",32,14],["هَٰذَآ","этого",32,14],["إِنَّا","поистине, Мы",32,14],["نَسِينَٰكُمۡۖ","забыли Мы вас",32,14]],[["وَذُوقُواْ","и вкусите",32,14],["عَذَابَ","наказание",32,14],["ٱلۡخُلۡدِ","вечности",32,14],["بِمَا","за то, что",32,14],["كُنتُمۡ","были вы",32,14],["تَعۡمَلُونَ","делали",32,14],[14],["إِنَّمَا","только",32,15],["يُؤۡمِنُ","веруют",32,15]],[["بِـَٔايَٰتِنَا","в Наши знамения",32,15],["ٱلَّذِينَ","те, которые",32,15],["إِذَا","когда",32,15],["ذُكِّرُواْ","напоминают им",32,15],["بِهَا","о них",32,15],["خَرُّواْۤ","падают",32,15],["سُجَّدٗاۤ","в земном поклоне",32,15],["وَسَبَّحُواْ","и славят",32,15],["بِحَمۡدِ","хвалой",32,15]],[["رَبِّهِمۡ","Господа их",32,15],["وَهُمۡ","и они",32,15],["لَا","не",32,15],["يَسۡتَكۡبِرُونَ ۩","превозносятся",32,15],[15],["تَتَجَافَىٰ","отрываются",32,16],["جُنُوبُهُمۡ","бока их",32,16]],[["عَنِ","от",32,16],["ٱلۡمَضَاجِعِ","постелей",32,16],["يَدۡعُونَ","взывают они",32,16],["رَبَّهُمۡ","к Господу их",32,16],["خَوۡفٗا","в страхе",32,16],["وَطَمَعٗا","и надежде",32,16],["وَمِمَّا","и из того, что",32,16],["رَزَقۡنَٰهُمۡ","Мы наделили их",32,16]],[["يُنفِقُونَ","они расходуют",32,16],[16],["فَلَا","и не",32,17],["تَعۡلَمُ","знает",32,17],["نَفۡسٞ","душа",32,17],["مَّآ","что",32,17],["أُخۡفِيَ","скрыто",32,17],["لَهُم","для них",32,17],["مِّن","из",32,17],["قُرَّةِ","услады",32,17],["أَعۡيُنٖ","глаз",32,17],["جَزَآءَۢ","воздаянием",32,17]],[["بِمَا","за то, что",32,17],["كَانُواْ","были они",32,17],["يَعۡمَلُونَ","делали",32,17],[17],["أَفَمَن","неужели тот, кто",32,18],["كَانَ","был",32,18],["مُؤۡمِنٗا","верующим",32,18],["كَمَن","как тот, кто",32,18],["كَانَ","был",32,18],["فَاسِقٗاۚ","нечестивцем",32,18]],[["لَّا","не",32,18],["يَسۡتَوُۥنَ","равны они",32,18],[18],["أَمَّا","что касается",32,19],["ٱلَّذِينَ","тех, которые",32,19],["ءَامَنُواْ","уверовали",32,19],["وَعَمِلُواْ","и совершали",32,19],["ٱلصَّٰلِحَٰتِ","праведные деяния",32,19],["فَلَهُمۡ","то для них",32,19]],[["جَنَّٰتُ","сады",32,19],["ٱلۡمَأۡوَىٰ","пристанища",32,19],["نُزُلَۢا","угощением",32,19],["بِمَا","за то, что",32,19],["كَانُواْ","были они",32,19],["يَعۡمَلُونَ","делали",32,19],[19],["وَأَمَّا","а что касается",32,20],["ٱلَّذِينَ","тех, которые",32,20],["فَسَقُواْ","были нечестивы",32,20]],[["فَمَأۡوَىٰهُمُ","то пристанище их",32,20],["ٱلنَّارُۖ","Огонь",32,20],["كُلَّمَآ","всякий раз, как",32,20],["أَرَادُوٓاْ","захотят они",32,20],["أَن","чтобы",32,20],["يَخۡرُجُواْ","выйти они",32,20],["مِنۡهَآ","из него",32,20],["أُعِيدُواْ","возвращены они",32,20],["فِيهَا","в него",32,20],["وَقِيلَ","и сказано",32,20]],[["لَهُمۡ","им",32,20],["ذُوقُواْ","вкусите",32,20],["عَذَابَ","наказание",32,20],["ٱلنَّارِ","Огня",32,20],["ٱلَّذِي","которое",32,20],["كُنتُم","были вы",32,20],["بِهِۦ","его",32,20],["تُكَذِّبُونَ","считали ложью",32,20],[20]]]}