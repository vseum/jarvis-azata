{"p":417,"j":21,"a":[[32,21,["وَلَنُذِيقَنَّهُم","مِّنَ","ٱلۡعَذَابِ","ٱلۡأَدۡنَىٰ","دُونَ","ٱلۡعَذَابِ","ٱلۡأَكۡبَرِ","لَعَلَّهُمۡ","يَرۡجِعُونَ"],"валанузииḳаннахум минал `азабил адна дуунал `азабил акбари ла`аллахум йаржи`уун","Но помимо величайших мучений Мы непременно дадим им вкусить меньшие мучения, чтобы они могли вернуться на прямой путь.",["и непременно дадим Мы им вкусить","из","наказания","ближнего","до","наказания","величайшего","быть может, они","вернутся"]],[32,22,["وَمَنۡ","أَظۡلَمُ","مِمَّن","ذُكِّرَ","بِـَٔايَٰتِ","رَبِّهِۦ","ثُمَّ","أَعۡرَضَ","عَنۡهَآۚ","إِنَّا","مِنَ","ٱلۡمُجۡرِمِينَ","مُنتَقِمُونَ"],"ваман азламу мимман зуккира би'айати раббихии сумма а`рада `анха инна минал мужримиина мунтаḳимуун","Кто может быть несправедливее того, кому напомнили об аятах его Господа, после чего он отвернулся от них? Воистину, Мы отомстим грешникам.",["и кто","несправедливее","того, кому","напомнили","об аятах","Господа его","затем","отвернулся он","от них","поистине, Мы","от","грешников","отомстим"]],[32,23,["وَلَقَدۡ","ءَاتَيۡنَا","مُوسَى","ٱلۡكِتَٰبَ","فَلَا","تَكُن","فِي","مِرۡيَةٖ","مِّن","لِّقَآئِهِۦۖ","وَجَعَلۡنَٰهُ","هُدٗى","لِّبَنِيٓ","إِسۡرَٰٓءِيلَ"],"валаḳад атайна муусал китаба фала такун фии мирйатим мил лиḳаихии важа`алнаху худал либании исраиил","Мы даровали Мусе (Моисею) Писание, и не сомневайся во встрече с ним (во встрече с Мусой или встрече Мусы с Аллахом). Мы сделали его (Писание) верным руководством для сынов Исраила (Израиля).",["и уже","даровали Мы","Мусе","Писание","так не","будь","в","сомнении","о","встрече с ним","и сделали Мы его","руководством","для сынов","Исраила"]],[32,24,["وَجَعَلۡنَا","مِنۡهُمۡ","أَئِمَّةٗ","يَهۡدُونَ","بِأَمۡرِنَا","لَمَّا","صَبَرُواْۖ","وَكَانُواْ","بِـَٔايَٰتِنَا","يُوقِنُونَ"],"важа`ална минхум а'имматан йахдууна би'амрина ламма сабаруу вакануу би'айатина йууḳинуун","Мы создали среди них предводителей, которые вели остальных по Нашему повелению прямым путем, поскольку они были терпеливы и убежденно верили в Наши знамения.",["и сделали Мы","из них","предводителей","ведут они","по повелению Нашему","когда","проявили терпение они","и были они","в Наши знамения","убеждённо верили"]],[32,25,["إِنَّ","رَبَّكَ","هُوَ","يَفۡصِلُ","بَيۡنَهُمۡ","يَوۡمَ","ٱلۡقِيَٰمَةِ","فِيمَا","كَانُواْ","فِيهِ","يَخۡتَلِفُونَ"],"инна раббака хуа йафсилу байнахум йаумал ḳийамати фиима кануу фиихи йахталифуун","В День воскресения твой Господь рассудит между ними в том, в чем они расходились во мнениях.",["поистине","Господь твой","Он","рассудит","между ними","в день","воскресения","в том, в чём","были они","в нём","расходились"]],[32,26,["أَوَلَمۡ","يَهۡدِ","لَهُمۡ","كَمۡ","أَهۡلَكۡنَا","مِن","قَبۡلِهِم","مِّنَ","ٱلۡقُرُونِ","يَمۡشُونَ","فِي","مَسَٰكِنِهِمۡۚ","إِنَّ","فِي","ذَٰلِكَ","لَأٓيَٰتٍۚ","أَفَلَا","يَسۡمَعُونَ"],"авалам йахди лахум кам ахлакна мин ḳаблихим минал ḳурууни йамшууна фии масакинихим инна фии залика ла'айатин афала йасма`уун","Неужели их не привело на прямой путь то, что Мы погубили до них столько поколений, по жилищам которых они ходят? Воистину, в этом есть знамения. Неужели они не прислушаются?",["разве не","указало путь","им","сколько","погубили Мы","из","до них","из","поколений","ходят они","в","жилищах их","поистине","в","этом","непременно знамения","неужели не","слышат они"]],[32,27,["أَوَلَمۡ","يَرَوۡاْ","أَنَّا","نَسُوقُ","ٱلۡمَآءَ","إِلَى","ٱلۡأَرۡضِ","ٱلۡجُرُزِ","فَنُخۡرِجُ","بِهِۦ","زَرۡعٗا","تَأۡكُلُ","مِنۡهُ","أَنۡعَٰمُهُمۡ","وَأَنفُسُهُمۡۚ","أَفَلَا","يُبۡصِرُونَ"],"авалам йарау анна насууḳул маа илал ардил журузи фанухрижу бихии зар`ан та'кулу минху ан`амухум ва'анфусухум афала йубсируун","Неужели они не видят, что Мы пригоняем воду к сухой земле и выводим посредством нее посевы, которыми питаются их скот и они сами? Неужели они не видят этого?",["разве не","видят они","что Мы","гоним","воду","к","земле","бесплодной","и выводим Мы","ею","посевы","едят","из них","скот их","и сами они","неужели не","видят они"]],[32,28,["وَيَقُولُونَ","مَتَىٰ","هَٰذَا","ٱلۡفَتۡحُ","إِن","كُنتُمۡ","صَٰدِقِينَ"],"вайаḳуулууна мата хазал фатху ин кунтум садиḳиин","Они говорят: «Когда же свершится этот суд, если вы говорите правду?».",["и говорят они","когда","этот","суд","если","являетесь вы","правдивыми"]],[32,29,["قُلۡ","يَوۡمَ","ٱلۡفَتۡحِ","لَا","يَنفَعُ","ٱلَّذِينَ","كَفَرُوٓاْ","إِيمَٰنُهُمۡ","وَلَا","هُمۡ","يُنظَرُونَ"],"ḳул йаумал фатхи ла йанфа`ул лазиина кафаруу ииманухум вала хум йунзаруун","Скажи: «В День суда неверующим не принесет пользы их вера, и они не получат отсрочки».",["скажи","в День","победы","не","принесет пользы","тем, которые","не уверовали","их вера","и не","они","получат отсрочку"]],[32,30,["فَأَعۡرِضۡ","عَنۡهُمۡ","وَٱنتَظِرۡ","إِنَّهُم","مُّنتَظِرُونَ"],"фа'а`рид `анхум вантазир иннахум мунтазируун","Отвернись от них и подожди, ведь они тоже ждут.",["так отвернись","от них","и жди","поистине, они","ждущие"]]],"m":[[["وَلَنُذِيقَنَّهُم","и непременно дадим Мы им вкусить",32,21],["مِّنَ","из",32,21],["ٱلۡعَذَابِ","наказания",32,21],["ٱلۡأَدۡنَىٰ","ближнего",32,21],["دُونَ","до",32,21],["ٱلۡعَذَابِ","наказания",32,21],["ٱلۡأَكۡبَرِ","величайшего",32,21]],[["لَعَلَّهُمۡ","быть может, они",32,21],["يَرۡجِعُونَ","вернутся",32,21],[21],["وَمَنۡ","и кто",32,22],["أَظۡلَمُ","несправедливее",32,22],["مِمَّن","того, кому",32,22],["ذُكِّرَ","напомнили",32,22],["بِـَٔايَٰتِ","об аятах",32,22],["رَبِّهِۦ","Господа его",32,22],["ثُمَّ","затем",32,22]],[["أَعۡرَضَ","отвернулся он",32,22],["عَنۡهَآۚ","от них",32,22],["إِنَّا","поистине, Мы",32,22],["مِنَ","от",32,22],["ٱلۡمُجۡرِمِينَ","грешников",32,22],["مُنتَقِمُونَ","отомстим",32,22],[22],["وَلَقَدۡ","и уже",32,23],["ءَاتَيۡنَا","даровали Мы",32,23]],[["مُوسَى","Мусе",32,23],["ٱلۡكِتَٰبَ","Писание",32,23],["فَلَا","так не",32,23],["تَكُن","будь",32,23],["فِي","в",32,23],["مِرۡيَةٖ","сомнении",32,23],["مِّن","о",32,23],["لِّقَآئِهِۦۖ","встрече с ним",32,23],["وَجَعَلۡنَٰهُ","и сделали Мы его",32,23]],[["هُدٗى","руководством",32,23],["لِّبَنِيٓ","для сынов",32,23],["إِسۡرَٰٓءِيلَ","Исраила",32,23],[23],["وَجَعَلۡنَا","и сделали Мы",32,24],["مِنۡهُمۡ","из них",32,24],["أَئِمَّةٗ","предводителей",32,24],["يَهۡدُونَ","ведут они",32,24]],[["بِأَمۡرِنَا","по повелению Нашему",32,24],["لَمَّا","когда",32,24],["صَبَرُواْۖ","проявили терпение они",32,24],["وَكَانُواْ","и были они",32,24],["بِـَٔايَٰتِنَا","в Наши знамения",32,24],["يُوقِنُونَ","убеждённо верили",32,24],[24],["إِنَّ","поистине",32,25],["رَبَّكَ","Господь твой",32,25]],[["هُوَ","Он",32,25],["يَفۡصِلُ","рассудит",32,25],["بَيۡنَهُمۡ","между ними",32,25],["يَوۡمَ","в день",32,25],["ٱلۡقِيَٰمَةِ","воскресения",32,25],["فِيمَا","в том, в чём",32,25],["كَانُواْ","были они",32,25],["فِيهِ","в нём",32,25],["يَخۡتَلِفُونَ","расходились",32,25]],[[25],["أَوَلَمۡ","разве не",32,26],["يَهۡدِ","указало путь",32,26],["لَهُمۡ","им",32,26],["كَمۡ","сколько",32,26],["أَهۡلَكۡنَا","погубили Мы",32,26],["مِن","из",32,26],["قَبۡلِهِم","до них",32,26],["مِّنَ","из",32,26],["ٱلۡقُرُونِ","поколений",32,26]],[["يَمۡشُونَ","ходят они",32,26],["فِي","в",32,26],["مَسَٰكِنِهِمۡۚ","жилищах их",32,26],["إِنَّ","поистине",32,26],["فِي","в",32,26],["ذَٰلِكَ","этом",32,26],["لَأٓيَٰتٍۚ","непременно знамения",32,26],["أَفَلَا","неужели не",32,26],["يَسۡمَعُونَ","слышат они",32,26]],[[26],["أَوَلَمۡ","разве не",32,27],["يَرَوۡاْ","видят они",32,27],["أَنَّا","что Мы",32,27],["نَسُوقُ","гоним",32,27],["ٱلۡمَآءَ","воду",32,27],["إِلَى","к",32,27],["ٱلۡأَرۡضِ","земле",32,27],["ٱلۡجُرُزِ","бесплодной",32,27],["فَنُخۡرِجُ","и выводим Мы",32,27]],[["بِهِۦ","ею",32,27],["زَرۡعٗا","посевы",32,27],["تَأۡكُلُ","едят",32,27],["مِنۡهُ","из них",32,27],["أَنۡعَٰمُهُمۡ","скот их",32,27],["وَأَنفُسُهُمۡۚ","и сами они",32,27],["أَفَلَا","неужели не",32,27],["يُبۡصِرُونَ","видят они",32,27],[27]],[["وَيَقُولُونَ","и говорят они",32,28],["مَتَىٰ","когда",32,28],["هَٰذَا","этот",32,28],["ٱلۡفَتۡحُ","суд",32,28],["إِن","если",32,28],["كُنتُمۡ","являетесь вы",32,28],["صَٰدِقِينَ","правдивыми",32,28],[28]],[["قُلۡ","скажи",32,29],["يَوۡمَ","в День",32,29],["ٱلۡفَتۡحِ","победы",32,29],["لَا","не",32,29],["يَنفَعُ","принесет пользы",32,29],["ٱلَّذِينَ","тем, которые",32,29],["كَفَرُوٓاْ","не уверовали",32,29],["إِيمَٰنُهُمۡ","их вера",32,29],["وَلَا","и не",32,29],["هُمۡ","они",32,29],["يُنظَرُونَ","получат отсрочку",32,29]],[[29],["فَأَعۡرِضۡ","так отвернись",32,30],["عَنۡهُمۡ","от них",32,30],["وَٱنتَظِرۡ","и жди",32,30],["إِنَّهُم","поистине, они",32,30],["مُّنتَظِرُونَ","ждущие",32,30],[30]],["h",33]]}