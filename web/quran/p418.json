{"p":418,"j":21,"a":[[33,1,["يَٰٓأَيُّهَا","ٱلنَّبِيُّ","ٱتَّقِ","ٱللَّهَ","وَلَا","تُطِعِ","ٱلۡكَٰفِرِينَ","وَٱلۡمُنَٰفِقِينَۚ","إِنَّ","ٱللَّهَ","كَانَ","عَلِيمًا","حَكِيمٗا"],"йа'аййухан набиййуттаḳиллаха вала тути`ил кафириина валмунафиḳиина инналлаха кана `алииман хакиима","О Пророк! Бойся Аллаха и не повинуйся неверующим и лицемерам. Воистину, Аллах - Знающий, Мудрый.",["о","Пророк","бойся","Аллаха","и не","повинуйся","неверующим","и лицемерам","поистине","Аллах","был","Знающим","Мудрым"]],[33,2,["وَٱتَّبِعۡ","مَا","يُوحَىٰٓ","إِلَيۡكَ","مِن","رَّبِّكَۚ","إِنَّ","ٱللَّهَ","كَانَ","بِمَا","تَعۡمَلُونَ","خَبِيرٗا"],"ваттаби` ма йууха илайка мир раббика инналлаха кана бима та`малууна хабиира","Следуй тому, что внушается тебе в откровении от твоего Господа. Воистину, Аллах ведает о том, что вы совершаете.",["и следуй","тому, что","внушается","тебе","от","Господа твоего","поистине","Аллах","был","о том, что","делаете вы","Ведающим"]],[33,3,["وَتَوَكَّلۡ","عَلَى","ٱللَّهِۚ","وَكَفَىٰ","بِٱللَّهِ","وَكِيلٗا"],"ватаваккал `алаллахи вакафа биллахи вакиила","Уповай на Аллаха, и довольно того, что Аллах является Попечителем и Хранителем!",["и уповай","на","Аллаха","и довольно","Аллаха","Попечителем"]],[33,4,["مَّا","جَعَلَ","ٱللَّهُ","لِرَجُلٖ","مِّن","قَلۡبَيۡنِ","فِي","جَوۡفِهِۦۚ","وَمَا","جَعَلَ","أَزۡوَٰجَكُمُ","ٱلَّٰٓـِٔي","تُظَٰهِرُونَ","مِنۡهُنَّ","أُمَّهَٰتِكُمۡۚ","وَمَا","جَعَلَ","أَدۡعِيَآءَكُمۡ","أَبۡنَآءَكُمۡۚ","ذَٰلِكُمۡ","قَوۡلُكُم","بِأَفۡوَٰهِكُمۡۖ","وَٱللَّهُ","يَقُولُ","ٱلۡحَقَّ","وَهُوَ","يَهۡدِي","ٱلسَّبِيلَ"],"мма жа`алаллаху лиражулим мин ḳалбайни фии жауфихии вама жа`ала азважакумул лаии тузахирууна минхунна уммахатикум вама жа`ала ад`ийаакум абнаакум заликум ḳаулукум би'афвахикум валлаху йаḳуулул хаḳḳа вахуа йахдис сабиил","Аллах не даровал человеку двух сердец в одном теле. Он не сделал вашими матерями тех ваших жен, которых вы объявляете запретными для себя, и не сделал ваших приемных сыновей вашими сыновьями. Это - всего лишь слова из ваших уст. Аллах же глаголет истину и наставляет на прямой путь.",["не","сделал","Аллах","для мужчины","из","двух сердец","в","нутре его","и не","сделал Он","жён ваших","которых","объявляете запретными","из них","матерями вашими","и не","сделал Он","приёмных сыновей ваших","сыновьями вашими","это","слова ваши","устами вашими","а Аллах","говорит","истину","и Он","ведёт","путём"]],[33,5,["ٱدۡعُوهُمۡ","لِأٓبَآئِهِمۡ","هُوَ","أَقۡسَطُ","عِندَ","ٱللَّهِۚ","فَإِن","لَّمۡ","تَعۡلَمُوٓاْ","ءَابَآءَهُمۡ","فَإِخۡوَٰنُكُمۡ","فِي","ٱلدِّينِ","وَمَوَٰلِيكُمۡۚ","وَلَيۡسَ","عَلَيۡكُمۡ","جُنَاحٞ","فِيمَآ","أَخۡطَأۡتُم","بِهِۦ","وَلَٰكِن","مَّا","تَعَمَّدَتۡ","قُلُوبُكُمۡۚ","وَكَانَ","ٱللَّهُ","غَفُورٗا","رَّحِيمًا"],"ид`уухум ли'абаихим хуа аḳсату `индаллахи фа'ил лам та`ламуу абаахум фа'ихванукум фид диини вамавалиикум валайса `алайкум жунахун фиима ахта'тум бихии валаким ма та`аммадат ḳулуубукум ваканаллаху гафуурар рахиима","Зовите их (приемных детей) по именам их отцов. Это более справедливо перед Аллахом. Если же вы не знаете их отцов, то они являются вашими братьями по вере и вашими близкими. Не будет на вас греха, если вы совершите ошибку, если только вы не вознамерились совершить такое в сердце. Аллах - Прощающий, Милосердный.",["зовите их","по их отцам","это","справедливее","у","Аллаха","а если","не","знаете вы","их отцов","то ваши братья","в","религии","и ваши близкие","и нет","на вас","греха","в том, что","ошиблись вы","в этом","но","то, что","умыслили","ваши сердца","и есть","Аллах","Прощающий","Милосердный"]],[33,6,["ٱلنَّبِيُّ","أَوۡلَىٰ","بِٱلۡمُؤۡمِنِينَ","مِنۡ","أَنفُسِهِمۡۖ","وَأَزۡوَٰجُهُۥٓ","أُمَّهَٰتُهُمۡۗ","وَأُوْلُواْ","ٱلۡأَرۡحَامِ","بَعۡضُهُمۡ","أَوۡلَىٰ","بِبَعۡضٖ","فِي","كِتَٰبِ","ٱللَّهِ","مِنَ","ٱلۡمُؤۡمِنِينَ","وَٱلۡمُهَٰجِرِينَ","إِلَّآ","أَن","تَفۡعَلُوٓاْ","إِلَىٰٓ","أَوۡلِيَآئِكُم","مَّعۡرُوفٗاۚ","كَانَ","ذَٰلِكَ","فِي","ٱلۡكِتَٰبِ","مَسۡطُورٗا"],"аннабиййу аула билму'миниина мин анфусихим ва'азважухуу уммахатухум ва'улул архами ба`духум аула биба`дин фии китабиллахи минал му'миниина валмухажириина илла ан таф`алуу ила аулийаикум ма`рууфан кана залика фил китаби мастуура","Пророк ближе к верующим, чем они сами, а его жены - их матери. В соответствии с предписанием Аллаха, кровные родственники ближе друг к другу, чем верующие и мухаджиры, если только вы не сделаете добро своим друзьям. Так было записано в Писании (Хранимой скрижали).",["Пророк","ближе","к верующим","чем","они сами","а его жёны","их матери","а обладатели","родства","одни из них","ближе","к другим","в","Писании","Аллаха","чем","верующие","и переселенцы","кроме","того чтобы","сделали вы","к","вашим друзьям","добро","было","это","в","Писании","записано"]]],"m":[["b"],[["يَٰٓأَيُّهَا","о",33,1],["ٱلنَّبِيُّ","Пророк",33,1],["ٱتَّقِ","бойся",33,1],["ٱللَّهَ","Аллаха",33,1],["وَلَا","и не",33,1],["تُطِعِ","повинуйся",33,1],["ٱلۡكَٰفِرِينَ","неверующим",33,1],["وَٱلۡمُنَٰفِقِينَۚ","и лицемерам",33,1],["إِنَّ","поистине",33,1],["ٱللَّهَ","Аллах",33,1]],[["كَانَ","был",33,1],["عَلِيمًا","Знающим",33,1],["حَكِيمٗا","Мудрым",33,1],[1],["وَٱتَّبِعۡ","и следуй",33,2],["مَا","тому, что",33,2],["يُوحَىٰٓ","внушается",33,2],["إِلَيۡكَ","тебе",33,2],["مِن","от",33,2]],[["رَّبِّكَۚ","Господа твоего",33,2],["إِنَّ","поистине",33,2],["ٱللَّهَ","Аллах",33,2],["كَانَ","был",33,2],["بِمَا","о том, что",33,2],["تَعۡمَلُونَ","делаете вы",33,2],["خَبِيرٗا","Ведающим",33,2],[2],["وَتَوَكَّلۡ","и уповай",33,3],["عَلَى","на",33,3],["ٱللَّهِۚ","Аллаха",33,3]],[["وَكَفَىٰ","и довольно",33,3],["بِٱللَّهِ","Аллаха",33,3],["وَكِيلٗا","Попечителем",33,3],[3],["مَّا","не",33,4],["جَعَلَ","сделал",33,4],["ٱللَّهُ","Аллах",33,4],["لِرَجُلٖ","для мужчины",33,4],["مِّن","из",33,4],["قَلۡبَيۡنِ","двух сердец",33,4],["فِي","в",33,4]],[["جَوۡفِهِۦۚ","нутре его",33,4],["وَمَا","и не",33,4],["جَعَلَ","сделал Он",33,4],["أَزۡوَٰجَكُمُ","жён ваших",33,4],["ٱلَّٰٓـِٔي","которых",33,4],["تُظَٰهِرُونَ","объявляете запретными",33,4],["مِنۡهُنَّ","из них",33,4],["أُمَّهَٰتِكُمۡۚ","матерями вашими",33,4]],[["وَمَا","и не",33,4],["جَعَلَ","сделал Он",33,4],["أَدۡعِيَآءَكُمۡ","приёмных сыновей ваших",33,4],["أَبۡنَآءَكُمۡۚ","сыновьями вашими",33,4],["ذَٰلِكُمۡ","это",33,4],["قَوۡلُكُم","слова ваши",33,4],["بِأَفۡوَٰهِكُمۡۖ","устами вашими",33,4],["وَٱللَّهُ","а Аллах",33,4]],[["يَقُولُ","говорит",33,4],["ٱلۡحَقَّ","истину",33,4],["وَهُوَ","и Он",33,4],["يَهۡدِي","ведёт",33,4],["ٱلسَّبِيلَ","путём",33,4],[4],["ٱدۡعُوهُمۡ","зовите их",33,5],["لِأٓبَآئِهِمۡ","по их отцам",33,5]],[["هُوَ","это",33,5],["أَقۡسَطُ","справедливее",33,5],["عِندَ","у",33,5],["ٱللَّهِۚ","Аллаха",33,5],["فَإِن","а если",33,5],["لَّمۡ","не",33,5],["تَعۡلَمُوٓاْ","знаете вы",33,5],["ءَابَآءَهُمۡ","их отцов",33,5],["فَإِخۡوَٰنُكُمۡ","то ваши братья",33,5]],[["فِي","в",33,5],["ٱلدِّينِ","религии",33,5],["وَمَوَٰلِيكُمۡۚ","и ваши близкие",33,5],["وَلَيۡسَ","и нет",33,5],["عَلَيۡكُمۡ","на вас",33,5],["جُنَاحٞ","греха",33,5],["فِيمَآ","в том, что",33,5],["أَخۡطَأۡتُم","ошиблись вы",33,5]],[["بِهِۦ","в этом",33,5],["وَلَٰكِن","но",33,5],["مَّا","то, что",33,5],["تَعَمَّدَتۡ","умыслили",33,5],["قُلُوبُكُمۡۚ","ваши сердца",33,5],["وَكَانَ","и есть",33,5],["ٱللَّهُ","Аллах",33,5],["غَفُورٗا","Прощающий",33,5],["رَّحِيمًا","Милосердный",33,5]],[[5],["ٱلنَّبِيُّ","Пророк",33,6],["أَوۡلَىٰ","ближе",33,6],["بِٱلۡمُؤۡمِنِينَ","к верующим",33,6],["مِنۡ","чем",33,6],["أَنفُسِهِمۡۖ","они сами",33,6],["وَأَزۡوَٰجُهُۥٓ","а его жёны",33,6],["أُمَّهَٰتُهُمۡۗ","их матери",33,6]],[["وَأُوْلُواْ","а обладатели",33,6],["ٱلۡأَرۡحَامِ","родства",33,6],["بَعۡضُهُمۡ","одни из них",33,6],["أَوۡلَىٰ","ближе",33,6],["بِبَعۡضٖ","к другим",33,6],["فِي","в",33,6],["كِتَٰبِ","Писании",33,6],["ٱللَّهِ","Аллаха",33,6]],[["مِنَ","чем",33,6],["ٱلۡمُؤۡمِنِينَ","верующие",33,6],["وَٱلۡمُهَٰجِرِينَ","и переселенцы",33,6],["إِلَّآ","кроме",33,6],["أَن","того чтобы",33,6],["تَفۡعَلُوٓاْ","сделали вы",33,6],["إِلَىٰٓ","к",33,6],["أَوۡلِيَآئِكُم","вашим друзьям",33,6]],[["مَّعۡرُوفٗاۚ","добро",33,6],["كَانَ","было",33,6],["ذَٰلِكَ","это",33,6],["فِي","в",33,6],["ٱلۡكِتَٰبِ","Писании",33,6],["مَسۡطُورٗا","записано",33,6],[6]]]}