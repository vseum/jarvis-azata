{"p":419,"j":21,"a":[[33,7,["وَإِذۡ","أَخَذۡنَا","مِنَ","ٱلنَّبِيِّـۧنَ","مِيثَٰقَهُمۡ","وَمِنكَ","وَمِن","نُّوحٖ","وَإِبۡرَٰهِيمَ","وَمُوسَىٰ","وَعِيسَى","ٱبۡنِ","مَرۡيَمَۖ","وَأَخَذۡنَا","مِنۡهُم","مِّيثَٰقًا","غَلِيظٗا"],"ва'из ахазна минан набиййиина миисаḳахум ваминка вамин нуухин ва'ибрахиима вамууса ва`иисабни марйама ва'ахазна минхум миисаḳан галииза","Вот Мы заключили завет с пророками, с тобой, Нухом (Ноем), Ибрахимом (Авраамом), Мусой (Моисеем) и Исой (Иисусом), сыном Марьям (Марии). Мы заключили с ними суровый завет,",["и вот","взяли Мы","от","пророков","их завет","и от тебя","и от","Нуха","и Ибрахима","и Мусы","и Исы","сына","Марьям","и взяли Мы","от них","завет","суровый"]],[33,8,["لِّيَسۡـَٔلَ","ٱلصَّٰدِقِينَ","عَن","صِدۡقِهِمۡۚ","وَأَعَدَّ","لِلۡكَٰفِرِينَ","عَذَابًا","أَلِيمٗا"],"ллийас'алас садиḳиина `ан сидḳихим ва'а`адда лилкафириина `азабан алиима","чтобы Он спросил правдивых об их правдивости. Он приготовил неверующим мучительные страдания.",["чтобы спросил Он","правдивых","о","их правдивости","и приготовил Он","для неверующих","наказание","мучительное"]],[33,9,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُواْ","ٱذۡكُرُواْ","نِعۡمَةَ","ٱللَّهِ","عَلَيۡكُمۡ","إِذۡ","جَآءَتۡكُمۡ","جُنُودٞ","فَأَرۡسَلۡنَا","عَلَيۡهِمۡ","رِيحٗا","وَجُنُودٗا","لَّمۡ","تَرَوۡهَاۚ","وَكَانَ","ٱللَّهُ","بِمَا","تَعۡمَلُونَ","بَصِيرًا"],"йа'аййухал лазиина аманузкуруу ни`маталлахи `алайкум из жааткум жунуудун фа'арсална `алайхим риихан важунуудал лам тарауха ваканаллаху бима та`малууна басиира","О те, которые уверовали! Помните милость Аллаха, которая была оказана вам, когда воины выступили против вас. Мы наслали на них ветер и воинов, которых вы не видели. Аллах видит то, что вы совершаете.",["о вы","те, которые","уверовали","помните","милость","Аллаха","вам","когда","пришли к вам","войска","и наслали Мы","на них","ветер","и войска","не","видели вы их","и есть","Аллах","то, что","делаете вы","Видящий"]],[33,10,["إِذۡ","جَآءُوكُم","مِّن","فَوۡقِكُمۡ","وَمِنۡ","أَسۡفَلَ","مِنكُمۡ","وَإِذۡ","زَاغَتِ","ٱلۡأَبۡصَٰرُ","وَبَلَغَتِ","ٱلۡقُلُوبُ","ٱلۡحَنَاجِرَ","وَتَظُنُّونَ","بِٱللَّهِ","ٱلظُّنُونَا۠"],"из жауукум мин фауḳикум вамин асфала минкум ва'из загатил абсару вабалагатил ḳулуубул ханажира ватазуннууна биллахиз зунуун","Вот они напали на вас сверху и снизу, и тогда взоры замерли, сердца достигли горла, и вы стали делать предположения об Аллахе.",["когда","пришли они к вам","с","высоты вашей","и с","ниже","вас","и когда","блуждали","взоры","и достигли","сердца","гортаней","и думали вы","об Аллахе","предположения"]],[33,11,["هُنَالِكَ","ٱبۡتُلِيَ","ٱلۡمُؤۡمِنُونَ","وَزُلۡزِلُواْ","زِلۡزَالٗا","شَدِيدٗا"],"хуналикабтулийал му'минууна вазулзилуу зилзалан шадиида","Там верующие подверглись испытанию и сильному потрясению.",["там","были испытаны","верующие","и были потрясены","потрясением","сильным"]],[33,12,["وَإِذۡ","يَقُولُ","ٱلۡمُنَٰفِقُونَ","وَٱلَّذِينَ","فِي","قُلُوبِهِم","مَّرَضٞ","مَّا","وَعَدَنَا","ٱللَّهُ","وَرَسُولُهُۥٓ","إِلَّا","غُرُورٗا"],"ва'из йаḳуулул мунафиḳууна валлазиина фии ḳулуубихим марадум ма ва`аданаллаху варасуулухуу илла гуруура","Вот сказали лицемеры и те, чьи сердца поражены недугом: «Обещания Аллаха и Его Посланника были всего лишь обольщением».",["и вот","говорили","лицемеры","и те, которые","в","их сердцах","болезнь","не","обещал нам","Аллах","и Его Посланник","кроме","обольщения"]],[33,13,["وَإِذۡ","قَالَت","طَّآئِفَةٞ","مِّنۡهُمۡ","يَٰٓأَهۡلَ","يَثۡرِبَ","لَا","مُقَامَ","لَكُمۡ","فَٱرۡجِعُواْۚ","وَيَسۡتَـٔۡذِنُ","فَرِيقٞ","مِّنۡهُمُ","ٱلنَّبِيَّ","يَقُولُونَ","إِنَّ","بُيُوتَنَا","عَوۡرَةٞ","وَمَا","هِيَ","بِعَوۡرَةٍۖ","إِن","يُرِيدُونَ","إِلَّا","فِرَارٗا"],"ва'из ḳалат таифатум минхум йа'ахла йасриба ла муḳама лакум фаржи`уу вайаста'зину фарииḳум минхумун набиййа йаḳуулууна инна буйуутана `ауратун вама хийа би`ауратин ин йуриидууна илла фирара","Вот некоторые из них сказали: «О жители Ясриба (Медины), вы не сможете выстоять! Вернитесь!». А некоторые из них попросили разрешения у Пророка и сказали: «Наши дома остались беззащитны». Они не были беззащитны - они лишь хотели сбежать.",["и вот","сказала","группа","из них","о жители","Ясриба","нет","стоянки","вам","возвращайтесь же","и просит позволения","часть","из них","у Пророка","говорят они","поистине","наши дома","беззащитны","и не","они","беззащитны","не","хотят они","кроме","бегства"]],[33,14,["وَلَوۡ","دُخِلَتۡ","عَلَيۡهِم","مِّنۡ","أَقۡطَارِهَا","ثُمَّ","سُئِلُواْ","ٱلۡفِتۡنَةَ","لَأٓتَوۡهَا","وَمَا","تَلَبَّثُواْ","بِهَآ","إِلَّا","يَسِيرٗا"],"валау духилат `алайхим мин аḳтариха сумма су'илул фитната ла'атауха вама талаббасуу биха илла йасиира","Если бы они (союзники) вторглись в него со всех сторон и потребовали бы от них искушения (отказаться от веры), то они пошли бы на это и не стали бы медлить с этим, разве что немного.",["и если бы","вторглись бы","к ним","со","всех её сторон","затем","попросили бы их","смуты","непременно совершили бы её","и не","медлили бы они","с ней","кроме","немного"]],[33,15,["وَلَقَدۡ","كَانُواْ","عَٰهَدُواْ","ٱللَّهَ","مِن","قَبۡلُ","لَا","يُوَلُّونَ","ٱلۡأَدۡبَٰرَۚ","وَكَانَ","عَهۡدُ","ٱللَّهِ","مَسۡـُٔولٗا"],"валаḳад кануу `ахадуллаха мин ḳаблу ла йуаллуунал адбара вакана `ахдуллахи мас'уула","А ведь прежде они заключили завет с Аллахом о том, что не обратятся вспять. О завете с Аллахом они будут спрошены.",["и ведь уже","были они","(клятвенно) обещали","Аллаху","до","этого","не","обратят","спины","и есть","обещание","Аллаху","спрашиваемое"]]],"m":[[["وَإِذۡ","и вот",33,7],["أَخَذۡنَا","взяли Мы",33,7],["مِنَ","от",33,7],["ٱلنَّبِيِّـۧنَ","пророков",33,7],["مِيثَٰقَهُمۡ","их завет",33,7],["وَمِنكَ","и от тебя",33,7],["وَمِن","и от",33,7],["نُّوحٖ","Нуха",33,7],["وَإِبۡرَٰهِيمَ","и Ибрахима",33,7]],[["وَمُوسَىٰ","и Мусы",33,7],["وَعِيسَى","и Исы",33,7],["ٱبۡنِ","сына",33,7],["مَرۡيَمَۖ","Марьям",33,7],["وَأَخَذۡنَا","и взяли Мы",33,7],["مِنۡهُم","от них",33,7],["مِّيثَٰقًا","завет",33,7],["غَلِيظٗا","суровый",33,7],[7]],[["لِّيَسۡـَٔلَ","чтобы спросил Он",33,8],["ٱلصَّٰدِقِينَ","правдивых",33,8],["عَن","о",33,8],["صِدۡقِهِمۡۚ","их правдивости",33,8],["وَأَعَدَّ","и приготовил Он",33,8],["لِلۡكَٰفِرِينَ","для неверующих",33,8],["عَذَابًا","наказание",33,8],["أَلِيمٗا","мучительное",33,8]],[[8],["يَٰٓأَيُّهَا","о вы",33,9],["ٱلَّذِينَ","те, которые",33,9],["ءَامَنُواْ","уверовали",33,9],["ٱذۡكُرُواْ","помните",33,9],["نِعۡمَةَ","милость",33,9],["ٱللَّهِ","Аллаха",33,9],["عَلَيۡكُمۡ","вам",33,9],["إِذۡ","когда",33,9],["جَآءَتۡكُمۡ","пришли к вам",33,9]],[["جُنُودٞ","войска",33,9],["فَأَرۡسَلۡنَا","и наслали Мы",33,9],["عَلَيۡهِمۡ","на них",33,9],["رِيحٗا","ветер",33,9],["وَجُنُودٗا","и войска",33,9],["لَّمۡ","не",33,9],["تَرَوۡهَاۚ","видели вы их",33,9],["وَكَانَ","и есть",33,9],["ٱللَّهُ","Аллах",33,9]],[["بِمَا","то, что",33,9],["تَعۡمَلُونَ","делаете вы",33,9],["بَصِيرًا","Видящий",33,9],[9],["إِذۡ","когда",33,10],["جَآءُوكُم","пришли они к вам",33,10],["مِّن","с",33,10],["فَوۡقِكُمۡ","высоты вашей",33,10],["وَمِنۡ","и с",33,10],["أَسۡفَلَ","ниже",33,10]],[["مِنكُمۡ","вас",33,10],["وَإِذۡ","и когда",33,10],["زَاغَتِ","блуждали",33,10],["ٱلۡأَبۡصَٰرُ","взоры",33,10],["وَبَلَغَتِ","и достигли",33,10],["ٱلۡقُلُوبُ","сердца",33,10],["ٱلۡحَنَاجِرَ","гортаней",33,10]],[["وَتَظُنُّونَ","и думали вы",33,10],["بِٱللَّهِ","об Аллахе",33,10],["ٱلظُّنُونَا۠","предположения",33,10],[10],["هُنَالِكَ","там",33,11],["ٱبۡتُلِيَ","были испытаны",33,11],["ٱلۡمُؤۡمِنُونَ","верующие",33,11],["وَزُلۡزِلُواْ","и были потрясены",33,11]],[["زِلۡزَالٗا","потрясением",33,11],["شَدِيدٗا","сильным",33,11],[11],["وَإِذۡ","и вот",33,12],["يَقُولُ","говорили",33,12],["ٱلۡمُنَٰفِقُونَ","лицемеры",33,12],["وَٱلَّذِينَ","и те, которые",33,12],["فِي","в",33,12],["قُلُوبِهِم","их сердцах",33,12]],[["مَّرَضٞ","болезнь",33,12],["مَّا","не",33,12],["وَعَدَنَا","обещал нам",33,12],["ٱللَّهُ","Аллах",33,12],["وَرَسُولُهُۥٓ","и Его Посланник",33,12],["إِلَّا","кроме",33,12],["غُرُورٗا","обольщения",33,12],[12],["وَإِذۡ","и вот",33,13],["قَالَت","сказала",33,13],["طَّآئِفَةٞ","группа",33,13]],[["مِّنۡهُمۡ","из них",33,13],["يَٰٓأَهۡلَ","о жители",33,13],["يَثۡرِبَ","Ясриба",33,13],["لَا","нет",33,13],["مُقَامَ","стоянки",33,13],["لَكُمۡ","вам",33,13],["فَٱرۡجِعُواْۚ","возвращайтесь же",33,13],["وَيَسۡتَـٔۡذِنُ","и просит позволения",33,13],["فَرِيقٞ","часть",33,13]],[["مِّنۡهُمُ","из них",33,13],["ٱلنَّبِيَّ","у Пророка",33,13],["يَقُولُونَ","говорят они",33,13],["إِنَّ","поистине",33,13],["بُيُوتَنَا","наши дома",33,13],["عَوۡرَةٞ","беззащитны",33,13],["وَمَا","и не",33,13],["هِيَ","они",33,13],["بِعَوۡرَةٍۖ","беззащитны",33,13],["إِن","не",33,13],["يُرِيدُونَ","хотят они",33,13],["إِلَّا","кроме",33,13]],[["فِرَارٗا","бегства",33,13],[13],["وَلَوۡ","и если бы",33,14],["دُخِلَتۡ","вторглись бы",33,14],["عَلَيۡهِم","к ним",33,14],["مِّنۡ","со",33,14],["أَقۡطَارِهَا","всех её сторон",33,14],["ثُمَّ","затем",33,14],["سُئِلُواْ","попросили бы их",33,14],["ٱلۡفِتۡنَةَ","смуты",33,14]],[["لَأٓتَوۡهَا","непременно совершили бы её",33,14],["وَمَا","и не",33,14],["تَلَبَّثُواْ","медлили бы они",33,14],["بِهَآ","с ней",33,14],["إِلَّا","кроме",33,14],["يَسِيرٗا","немного",33,14],[14],["وَلَقَدۡ","и ведь уже",33,15],["كَانُواْ","были они",33,15],["عَٰهَدُواْ","(клятвенно) обещали",33,15]],[["ٱللَّهَ","Аллаху",33,15],["مِن","до",33,15],["قَبۡلُ","этого",33,15],["لَا","не",33,15],["يُوَلُّونَ","обратят",33,15],["ٱلۡأَدۡبَٰرَۚ","спины",33,15],["وَكَانَ","и есть",33,15],["عَهۡدُ","обещание",33,15],["ٱللَّهِ","Аллаху",33,15],["مَسۡـُٔولٗا","спрашиваемое",33,15],[15]]]}