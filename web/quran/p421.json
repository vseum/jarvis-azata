{"p":421,"j":21,"a":[[33,23,["مِّنَ","ٱلۡمُؤۡمِنِينَ","رِجَالٞ","صَدَقُواْ","مَا","عَٰهَدُواْ","ٱللَّهَ","عَلَيۡهِۖ","فَمِنۡهُم","مَّن","قَضَىٰ","نَحۡبَهُۥ","وَمِنۡهُم","مَّن","يَنتَظِرُۖ","وَمَا","بَدَّلُواْ","تَبۡدِيلٗا"],"мминал му'миниина рижалун садаḳуу ма `ахадуллаха `алайхи фаминхум ман ḳада нахбахуу ваминхум ман йантазиру вама баддалуу табдиила","Среди верующих есть мужи, которые верны завету, который они заключили с Аллахом. Среди них есть такие, которые уже выполнили свои обязательства (или умерли), и такие, которые еще ожидают, но никак не изменяют своему завету.",["из","верующих","мужи","верны были","тому, что","обещали","Аллаху","о нём","и из них","кто","исполнил","свой обет","и из них","кто","ожидает","и не","изменили","изменением"]],[33,24,["لِّيَجۡزِيَ","ٱللَّهُ","ٱلصَّٰدِقِينَ","بِصِدۡقِهِمۡ","وَيُعَذِّبَ","ٱلۡمُنَٰفِقِينَ","إِن","شَآءَ","أَوۡ","يَتُوبَ","عَلَيۡهِمۡۚ","إِنَّ","ٱللَّهَ","كَانَ","غَفُورٗا","رَّحِيمٗا"],"ллийажзийаллахус садиḳиина бисидḳихим вайу`аззибал мунафиḳиина ин шаа ау йатууба `алайхим инналлаха кана гафуурар рахиима","Это происходит для того, чтобы Аллах воздал правдивым за их правдивость и наказал лицемеров, если Он пожелает этого, или принял их покаяния. Воистину, Аллах - Прощающий, Милосердный.",["чтобы воздал","Аллах","правдивым","за их правдивость","и наказал","лицемеров","если","пожелает Он","или","примет покаяние","их","поистине","Аллах","есть","Прощающий","Милосердный"]],[33,25,["وَرَدَّ","ٱللَّهُ","ٱلَّذِينَ","كَفَرُواْ","بِغَيۡظِهِمۡ","لَمۡ","يَنَالُواْ","خَيۡرٗاۚ","وَكَفَى","ٱللَّهُ","ٱلۡمُؤۡمِنِينَ","ٱلۡقِتَالَۚ","وَكَانَ","ٱللَّهُ","قَوِيًّا","عَزِيزٗا"],"вараддаллахул лазиина кафаруу бигайзихим лам йаналуу хайран вакафаллахул му'миниинал ḳитала ваканаллаху ḳавиййан `азииза","Аллах вернул неверующих в ярости (или по причине их ярости), и они не обрели добра. Аллах избавил верующих от сражения. Аллах - Всесильный, Могущественный.",["и вернул","Аллах","тех, которые","не уверовали","в их ярости","не","достигли они","добра","и избавил","Аллах","верующих","(от) сражения","и есть","Аллах","Сильный","Могущественный"]],[33,26,["وَأَنزَلَ","ٱلَّذِينَ","ظَٰهَرُوهُم","مِّنۡ","أَهۡلِ","ٱلۡكِتَٰبِ","مِن","صَيَاصِيهِمۡ","وَقَذَفَ","فِي","قُلُوبِهِمُ","ٱلرُّعۡبَ","فَرِيقٗا","تَقۡتُلُونَ","وَتَأۡسِرُونَ","فَرِيقٗا"],"ва'анзалал лазиина захаруухум мин ахлил китаби мин сайасиихим ваḳазафа фии ḳулуубихимур ру`ба фарииḳан таḳтулууна вата'сирууна фарииḳа","Он вывел из крепостей тех людей Писания, которые помогали им (союзникам), и вселил в их сердца страх. Одну часть их вы убили, а другую взяли в плен.",["и низвёл Он","тех, которые","поддержали их","из","людей","Писания","из","их крепостей","и вверг Он","в","их сердца","страх","часть","убиваете вы","и пленяете вы","часть"]],[33,27,["وَأَوۡرَثَكُمۡ","أَرۡضَهُمۡ","وَدِيَٰرَهُمۡ","وَأَمۡوَٰلَهُمۡ","وَأَرۡضٗا","لَّمۡ","تَطَـُٔوهَاۚ","وَكَانَ","ٱللَّهُ","عَلَىٰ","كُلِّ","شَيۡءٖ","قَدِيرٗا"],"ва'аурасакум ардахум вадийарахум ва'амвалахум ва'ардал лам татаууха ваканаллаху `ала кулли шай'ин ḳадиира","Он дал вам в наследство их землю, их дома, их имущество и землю, на которую вы даже не ступали. Аллах способен на всякую вещь.",["и дал Он вам в наследство","их землю","и их жилища","и их имущество","и землю","не","ступали вы на неё","и есть","Аллах","над","всякой","вещью","Всемогущий"]],[33,28,["يَٰٓأَيُّهَا","ٱلنَّبِيُّ","قُل","لِّأَزۡوَٰجِكَ","إِن","كُنتُنَّ","تُرِدۡنَ","ٱلۡحَيَوٰةَ","ٱلدُّنۡيَا","وَزِينَتَهَا","فَتَعَالَيۡنَ","أُمَتِّعۡكُنَّ","وَأُسَرِّحۡكُنَّ","سَرَاحٗا","جَمِيلٗا"],"йа'аййухан набиййу ḳул ли'азважика ин кунтунна туриднал хайаватад дунйа вазиинатаха фата`алайна уматти`кунна ва'усаррихкунна сарахан жамиила","О Пророк! Скажи своим женам: «Если вы желаете мирской жизни и ее украшений, то придите, и я наделю вас благами и отпущу красиво.",["о","Пророк","скажи","своим жёнам","если","являетесь вы","желаете","жизни","ближней","и её украшения","то придите","одарю я вас","и отпущу я вас","отпусканием","красивым"]],[33,29,["وَإِن","كُنتُنَّ","تُرِدۡنَ","ٱللَّهَ","وَرَسُولَهُۥ","وَٱلدَّارَ","ٱلۡأٓخِرَةَ","فَإِنَّ","ٱللَّهَ","أَعَدَّ","لِلۡمُحۡسِنَٰتِ","مِنكُنَّ","أَجۡرًا","عَظِيمٗا"],"ва'ин кунтунна туридналлаха варасуулахуу ваддарал ахирата фа'инналлаха а`адда лилмухсинати минкунна ажран `азиима","Но если вы желаете Аллаха, Его Посланника и Последнюю жизнь, то Аллах приготовил творящим добро среди вас великую награду».",["а если","являетесь вы","желаете","Аллаха","и Его Посланника","и обитель","последнюю","то поистине","Аллах","приготовил","для творящих добро","из вас","награду","великую"]],[33,30,["يَٰنِسَآءَ","ٱلنَّبِيِّ","مَن","يَأۡتِ","مِنكُنَّ","بِفَٰحِشَةٖ","مُّبَيِّنَةٖ","يُضَٰعَفۡ","لَهَا","ٱلۡعَذَابُ","ضِعۡفَيۡنِۚ","وَكَانَ","ذَٰلِكَ","عَلَى","ٱللَّهِ","يَسِيرٗا"],"йанисаан набиййи ман йа'ти минкунна бифахишатим мубаййинатин йуда`аф лахал `азабу ди`файни вакана залика `алаллахи йасиира","О жены Пророка! Если кто из вас совершит явную мерзость, то ее мучения будут удвоены. Это для Аллаха легко.",["о жёны","Пророка","кто","совершит","из вас","мерзость","явную","удвоится","для неё","наказание","вдвойне","и есть","это","для","Аллаха","легко"]]],"m":[[["مِّنَ","из",33,23],["ٱلۡمُؤۡمِنِينَ","верующих",33,23],["رِجَالٞ","мужи",33,23],["صَدَقُواْ","верны были",33,23],["مَا","тому, что",33,23],["عَٰهَدُواْ","обещали",33,23],["ٱللَّهَ","Аллаху",33,23],["عَلَيۡهِۖ","о нём",33,23],["فَمِنۡهُم","и из них",33,23],["مَّن","кто",33,23]],[["قَضَىٰ","исполнил",33,23],["نَحۡبَهُۥ","свой обет",33,23],["وَمِنۡهُم","и из них",33,23],["مَّن","кто",33,23],["يَنتَظِرُۖ","ожидает",33,23],["وَمَا","и не",33,23],["بَدَّلُواْ","изменили",33,23],["تَبۡدِيلٗا","изменением",33,23],[23],["لِّيَجۡزِيَ","чтобы воздал",33,24]],[["ٱللَّهُ","Аллах",33,24],["ٱلصَّٰدِقِينَ","правдивым",33,24],["بِصِدۡقِهِمۡ","за их правдивость",33,24],["وَيُعَذِّبَ","и наказал",33,24],["ٱلۡمُنَٰفِقِينَ","лицемеров",33,24],["إِن","если",33,24],["شَآءَ","пожелает Он",33,24]],[["أَوۡ","или",33,24],["يَتُوبَ","примет покаяние",33,24],["عَلَيۡهِمۡۚ","их",33,24],["إِنَّ","поистине",33,24],["ٱللَّهَ","Аллах",33,24],["كَانَ","есть",33,24],["غَفُورٗا","Прощающий",33,24],["رَّحِيمٗا","Милосердный",33,24],[24],["وَرَدَّ","и вернул",33,25],["ٱللَّهُ","Аллах",33,25],["ٱلَّذِينَ","тех, которые",33,25]],[["كَفَرُواْ","не уверовали",33,25],["بِغَيۡظِهِمۡ","в их ярости",33,25],["لَمۡ","не",33,25],["يَنَالُواْ","достигли они",33,25],["خَيۡرٗاۚ","добра",33,25],["وَكَفَى","и избавил",33,25],["ٱللَّهُ","Аллах",33,25],["ٱلۡمُؤۡمِنِينَ","верующих",33,25],["ٱلۡقِتَالَۚ","(от) сражения",33,25]],[["وَكَانَ","и есть",33,25],["ٱللَّهُ","Аллах",33,25],["قَوِيًّا","Сильный",33,25],["عَزِيزٗا","Могущественный",33,25],[25],["وَأَنزَلَ","и низвёл Он",33,26],["ٱلَّذِينَ","тех, которые",33,26],["ظَٰهَرُوهُم","поддержали их",33,26],["مِّنۡ","из",33,26]],[["أَهۡلِ","людей",33,26],["ٱلۡكِتَٰبِ","Писания",33,26],["مِن","из",33,26],["صَيَاصِيهِمۡ","их крепостей",33,26],["وَقَذَفَ","и вверг Он",33,26],["فِي","в",33,26],["قُلُوبِهِمُ","их сердца",33,26],["ٱلرُّعۡبَ","страх",33,26]],[["فَرِيقٗا","часть",33,26],["تَقۡتُلُونَ","убиваете вы",33,26],["وَتَأۡسِرُونَ","и пленяете вы",33,26],["فَرِيقٗا","часть",33,26],[26],["وَأَوۡرَثَكُمۡ","и дал Он вам в наследство",33,27],["أَرۡضَهُمۡ","их землю",33,27]],[["وَدِيَٰرَهُمۡ","и их жилища",33,27],["وَأَمۡوَٰلَهُمۡ","и их имущество",33,27],["وَأَرۡضٗا","и землю",33,27],["لَّمۡ","не",33,27],["تَطَـُٔوهَاۚ","ступали вы на неё",33,27],["وَكَانَ","и есть",33,27],["ٱللَّهُ","Аллах",33,27],["عَلَىٰ","над",33,27],["كُلِّ","всякой",33,27]],[["شَيۡءٖ","вещью",33,27],["قَدِيرٗا","Всемогущий",33,27],[27],["يَٰٓأَيُّهَا","о",33,28],["ٱلنَّبِيُّ","Пророк",33,28],["قُل","скажи",33,28],["لِّأَزۡوَٰجِكَ","своим жёнам",33,28],["إِن","если",33,28],["كُنتُنَّ","являетесь вы",33,28],["تُرِدۡنَ","желаете",33,28]],[["ٱلۡحَيَوٰةَ","жизни",33,28],["ٱلدُّنۡيَا","ближней",33,28],["وَزِينَتَهَا","и её украшения",33,28],["فَتَعَالَيۡنَ","то придите",33,28],["أُمَتِّعۡكُنَّ","одарю я вас",33,28],["وَأُسَرِّحۡكُنَّ","и отпущу я вас",33,28]],[["سَرَاحٗا","отпусканием",33,28],["جَمِيلٗا","красивым",33,28],[28],["وَإِن","а если",33,29],["كُنتُنَّ","являетесь вы",33,29],["تُرِدۡنَ","желаете",33,29],["ٱللَّهَ","Аллаха",33,29],["وَرَسُولَهُۥ","и Его Посланника",33,29],["وَٱلدَّارَ","и обитель",33,29]],[["ٱلۡأٓخِرَةَ","последнюю",33,29],["فَإِنَّ","то поистине",33,29],["ٱللَّهَ","Аллах",33,29],["أَعَدَّ","приготовил",33,29],["لِلۡمُحۡسِنَٰتِ","для творящих добро",33,29],["مِنكُنَّ","из вас",33,29],["أَجۡرًا","награду",33,29],["عَظِيمٗا","великую",33,29],[29]],[["يَٰنِسَآءَ","о жёны",33,30],["ٱلنَّبِيِّ","Пророка",33,30],["مَن","кто",33,30],["يَأۡتِ","совершит",33,30],["مِنكُنَّ","из вас",33,30],["بِفَٰحِشَةٖ","мерзость",33,30],["مُّبَيِّنَةٖ","явную",33,30],["يُضَٰعَفۡ","удвоится",33,30]],[["لَهَا","для неё",33,30],["ٱلۡعَذَابُ","наказание",33,30],["ضِعۡفَيۡنِۚ","вдвойне",33,30],["وَكَانَ","и есть",33,30],["ذَٰلِكَ","это",33,30],["عَلَى","для",33,30],["ٱللَّهِ","Аллаха",33,30],["يَسِيرٗا","легко",33,30],[30]]]}