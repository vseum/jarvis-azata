{"p":422,"j":22,"a":[[33,31,["وَمَن","يَقۡنُتۡ","مِنكُنَّ","لِلَّهِ","وَرَسُولِهِۦ","وَتَعۡمَلۡ","صَٰلِحٗا","نُّؤۡتِهَآ","أَجۡرَهَا","مَرَّتَيۡنِ","وَأَعۡتَدۡنَا","لَهَا","رِزۡقٗا","كَرِيمٗا"],"ваман йаḳнут минкунна лиллахи варасуулихии вата`мал салихан ну'тиха ажраха марратайни ва'а`тадна лаха ризḳан кариима","А ту из вас, которая будет покорна Аллаху и Его Посланнику и будет поступать праведно, Мы одарим двойным вознаграждением, и Мы приготовили для нее щедрый удел.",["а кто","покорна будет","из вас","Аллаху","и Его Посланнику","и совершит","праведное","дадим Мы ей","её награду","дважды","и приготовили Мы","для неё","удел","щедрый"]],[33,32,["يَٰنِسَآءَ","ٱلنَّبِيِّ","لَسۡتُنَّ","كَأَحَدٖ","مِّنَ","ٱلنِّسَآءِ","إِنِ","ٱتَّقَيۡتُنَّۚ","فَلَا","تَخۡضَعۡنَ","بِٱلۡقَوۡلِ","فَيَطۡمَعَ","ٱلَّذِي","فِي","قَلۡبِهِۦ","مَرَضٞ","وَقُلۡنَ","قَوۡلٗا","مَّعۡرُوفٗا"],"йанисаан набиййи ластунна ка'ахадим минан нисаи иниттаḳайтунна фала тахда`на билḳаули файатма`ал лазии фии ḳалбихии марадун ваḳулна ḳаулам ма`рууфа","О жены Пророка! Вы не таковы, как любая другая женщина. Если вы богобоязненны, то не проявляйте нежности в речах, дабы не возжелал вас тот, чье сердце поражено недугом, а говорите достойным образом.",["о жёны","Пророка","не являетесь вы","как любая","из","женщин","если","боитесь вы (Аллаха)","то не","смягчайте","речь","чтобы не возжелал","тот, который","в","его сердце","болезнь","и говорите","словом","достойным"]],[33,33,["وَقَرۡنَ","فِي","بُيُوتِكُنَّ","وَلَا","تَبَرَّجۡنَ","تَبَرُّجَ","ٱلۡجَٰهِلِيَّةِ","ٱلۡأُولَىٰۖ","وَأَقِمۡنَ","ٱلصَّلَوٰةَ","وَءَاتِينَ","ٱلزَّكَوٰةَ","وَأَطِعۡنَ","ٱللَّهَ","وَرَسُولَهُۥٓۚ","إِنَّمَا","يُرِيدُ","ٱللَّهُ","لِيُذۡهِبَ","عَنكُمُ","ٱلرِّجۡسَ","أَهۡلَ","ٱلۡبَيۡتِ","وَيُطَهِّرَكُمۡ","تَطۡهِيرٗا"],"ваḳарна фии буйуутикунна вала табарражна табарружал жахилиййатил уула ва'аḳимнас салавата ва'атииназ закавата ва'ати`наллаха варасуулахуу иннама йуриидуллаху лийузхиба `анкумур рижса ахлал байти вайутаххиракум татхиира","Оставайтесь в своих домах, не наряжайтесь так, как наряжались во времена первого невежества, совершайте намаз, раздавайте закят и повинуйтесь Аллаху и Его Посланнику. О обитатели дома, Аллах желает лишь избавить вас от скверны и очистить вас полностью.",["и оставайтесь","в","ваших домах","и не","наряжайтесь","наряжанием","невежества","прежнего","и выстаивайте","молитву","и давайте","закят","и повинуйтесь","Аллаху","и Его Посланнику","лишь","желает","Аллах","удалить","от вас","скверну","обитатели","дома","и очистить вас","очищением"]],[33,34,["وَٱذۡكُرۡنَ","مَا","يُتۡلَىٰ","فِي","بُيُوتِكُنَّ","مِنۡ","ءَايَٰتِ","ٱللَّهِ","وَٱلۡحِكۡمَةِۚ","إِنَّ","ٱللَّهَ","كَانَ","لَطِيفًا","خَبِيرًا"],"вазкурна ма йутла фии буйуутикунна мин айатиллахи валхикмати инналлаха кана латиифан хабиира","И поминайте то, что читается в ваших домах из аятов Аллаха и мудрости. Воистину, Аллах - Проницательный (или Добрый), Ведающий.",["и помните","то, что","читается","в","ваших домах","из","аятов","Аллаха","и мудрости","поистине","Аллах","есть","Проницательный","Ведающий"]],[33,35,["إِنَّ","ٱلۡمُسۡلِمِينَ","وَٱلۡمُسۡلِمَٰتِ","وَٱلۡمُؤۡمِنِينَ","وَٱلۡمُؤۡمِنَٰتِ","وَٱلۡقَٰنِتِينَ","وَٱلۡقَٰنِتَٰتِ","وَٱلصَّٰدِقِينَ","وَٱلصَّٰدِقَٰتِ","وَٱلصَّٰبِرِينَ","وَٱلصَّٰبِرَٰتِ","وَٱلۡخَٰشِعِينَ","وَٱلۡخَٰشِعَٰتِ","وَٱلۡمُتَصَدِّقِينَ","وَٱلۡمُتَصَدِّقَٰتِ","وَٱلصَّٰٓئِمِينَ","وَٱلصَّٰٓئِمَٰتِ","وَٱلۡحَٰفِظِينَ","فُرُوجَهُمۡ","وَٱلۡحَٰفِظَٰتِ","وَٱلذَّٰكِرِينَ","ٱللَّهَ","كَثِيرٗا","وَٱلذَّٰكِرَٰتِ","أَعَدَّ","ٱللَّهُ","لَهُم","مَّغۡفِرَةٗ","وَأَجۡرًا","عَظِيمٗا"],"иннал муслимиина валмуслимати валму'миниина валму'минати валḳанитиина валḳанитати вассадиḳиина вассадиḳати вассабириина вассабирати валхаши`иина валхаши`ати валмутасаддиḳиина валмутасаддиḳати вассаимиина вассаимати валхафизиина фуруужахум валхафизати ваззакирииналлаха касииран ваззакирати а`аддаллаху лахум магфиратан ва'ажран `азиима","Воистину, для мусульман и мусульманок, верующих мужчин и верующих женщин, покорных мужчин и покорных женщин, правдивых мужчин и правдивых женщин, терпеливых мужчин и терпеливых женщин, смиренных мужчин и смиренных женщин, подающих милостыню мужчин и подающих милостыню женщин, постящихся мужчин и постящихся женщин, хранящих целомудрие мужчин и хранящих целомудрие женщин и часто поминающих Аллаха мужчин и женщин, Аллах уготовил прощение и великую награду.",["поистине","мусульмане","и мусульманки","и верующие","и верующие (женщины)","и покорные","и покорные (женщины)","и правдивые","и правдивые (женщины)","и терпеливые","и терпеливые (женщины)","и смиренные","и смиренные (женщины)","и подающие милостыню","и подающие милостыню (женщины)","и постящиеся","и постящиеся (женщины)","и хранящие","свои срамные места","и хранящие (женщины)","и поминающие","Аллаха","много","и поминающие (женщины)","приготовил","Аллах","для них","прощение","и награду","великую"]]],"m":[[["۞ وَمَن","а кто",33,31],["يَقۡنُتۡ","покорна будет",33,31],["مِنكُنَّ","из вас",33,31],["لِلَّهِ","Аллаху",33,31],["وَرَسُولِهِۦ","и Его Посланнику",33,31],["وَتَعۡمَلۡ","и совершит",33,31],["صَٰلِحٗا","праведное",33,31],["نُّؤۡتِهَآ","дадим Мы ей",33,31]],[["أَجۡرَهَا","её награду",33,31],["مَرَّتَيۡنِ","дважды",33,31],["وَأَعۡتَدۡنَا","и приготовили Мы",33,31],["لَهَا","для неё",33,31],["رِزۡقٗا","удел",33,31],["كَرِيمٗا","щедрый",33,31],[31],["يَٰنِسَآءَ","о жёны",33,32],["ٱلنَّبِيِّ","Пророка",33,32]],[["لَسۡتُنَّ","не являетесь вы",33,32],["كَأَحَدٖ","как любая",33,32],["مِّنَ","из",33,32],["ٱلنِّسَآءِ","женщин",33,32],["إِنِ","если",33,32],["ٱتَّقَيۡتُنَّۚ","боитесь вы (Аллаха)",33,32],["فَلَا","то не",33,32],["تَخۡضَعۡنَ","смягчайте",33,32],["بِٱلۡقَوۡلِ","речь",33,32]],[["فَيَطۡمَعَ","чтобы не возжелал",33,32],["ٱلَّذِي","тот, который",33,32],["فِي","в",33,32],["قَلۡبِهِۦ","его сердце",33,32],["مَرَضٞ","болезнь",33,32],["وَقُلۡنَ","и говорите",33,32],["قَوۡلٗا","словом",33,32],["مَّعۡرُوفٗا","достойным",33,32],[32],["وَقَرۡنَ","и оставайтесь",33,33]],[["فِي","в",33,33],["بُيُوتِكُنَّ","ваших домах",33,33],["وَلَا","и не",33,33],