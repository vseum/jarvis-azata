{"p":423,"j":22,"a":[[33,36,["وَمَا","كَانَ","لِمُؤۡمِنٖ","وَلَا","مُؤۡمِنَةٍ","إِذَا","قَضَى","ٱللَّهُ","وَرَسُولُهُۥٓ","أَمۡرًا","أَن","يَكُونَ","لَهُمُ","ٱلۡخِيَرَةُ","مِنۡ","أَمۡرِهِمۡۗ","وَمَن","يَعۡصِ","ٱللَّهَ","وَرَسُولَهُۥ","فَقَدۡ","ضَلَّ","ضَلَٰلٗا","مُّبِينٗا"],"вама кана лиму'минин вала му'минатин иза ḳадаллаху варасуулухуу амран ан йакууна лахумул хийарату мин амрихим ваман йа`силлаха варасуулахуу фаḳад далла далалам мубиина","Для верующего мужчины и верующей женщины нет выбора при принятии ими решения, если Аллах и Его Посланник уже приняли решение. А кто ослушается Аллаха и Его Посланника, тот впал в очевидное заблуждение.",["и не","было","для верующего","и не","верующей","когда","решил","Аллах","и Его Посланник","дело","чтобы","было","у них","выбор","в","их деле","а кто","ослушается","Аллаха","и Его Посланника","то уже","заблудился он","заблуждением","явным"]],[33,37,["وَإِذۡ","تَقُولُ","لِلَّذِيٓ","أَنۡعَمَ","ٱللَّهُ","عَلَيۡهِ","وَأَنۡعَمۡتَ","عَلَيۡهِ","أَمۡسِكۡ","عَلَيۡكَ","زَوۡجَكَ","وَٱتَّقِ","ٱللَّهَ","وَتُخۡفِي","فِي","نَفۡسِكَ","مَا","ٱللَّهُ","مُبۡدِيهِ","وَتَخۡشَى","ٱلنَّاسَ","وَٱللَّهُ","أَحَقُّ","أَن","تَخۡشَىٰهُۖ","فَلَمَّا","قَضَىٰ","زَيۡدٞ","مِّنۡهَا","وَطَرٗا","زَوَّجۡنَٰكَهَا","لِكَيۡ","لَا","يَكُونَ","عَلَى","ٱلۡمُؤۡمِنِينَ","حَرَجٞ","فِيٓ","أَزۡوَٰجِ","أَدۡعِيَآئِهِمۡ","إِذَا","قَضَوۡاْ","مِنۡهُنَّ","وَطَرٗاۚ","وَكَانَ","أَمۡرُ","ٱللَّهِ","مَفۡعُولٗا"],"ва'из таḳуулу лиллазии ан`амаллаху `алайхи ва'ан`амта `алайхи амсик `алайка заужака ваттаḳиллаха ватухфии фии нафсика маллаху мубдиихи ватахшан наса валлаху ахаḳḳу ан тахшаху фаламма ḳада зайдум минха ватаран завважнакаха ликай ла йакууна `алал му'миниина харажун фии азважи ад`ийаихим иза ḳадау минхунна ватаран вакана амруллахи маф`уула","Вот ты сказал тому, кому Аллах оказал милость и кому ты сам оказал милость (Зейду, сыну Харисы): «Удержи свою жену при себе и побойся Аллаха». Ты скрыл в своей душе то, что Аллах сделает явным, и ты опасался людей, хотя Аллах больше заслуживает того, чтобы ты опасался Его. Когда же Зейд удовлетворил с ней свое желание (вступил с ней в половую близость или развелся с ней), Мы женили тебя на ней, чтобы верующие не испытывали никакого стеснения в отношении жен своих приемных сыновей после того, как те удовлетворят с ними свое желание. Веление Аллаха обязательно исполняется!",["и вот","говоришь ты","тому, которому","оказал милость","Аллах","ему","и оказал милость ты","ему","удержи","при себе","свою жену","и бойся","Аллаха","и скрываешь ты","в","своей душе","то, что","Аллах","обнаружит это (явным)","и боишься ты","людей","а Аллах","достойнее","чтобы","боялся ты Его","а когда","удовлетворил","Зейд","с ней","желание","Мы женили тебя на ней","чтобы","не","было","на","верующих","стеснения","в отношении","жён","их приёмных сыновей","когда","удовлетворили они","с ними","желание","и есть","веление","Аллаха","исполненное"]],[33,38,["مَّا","كَانَ","عَلَى","ٱلنَّبِيِّ","مِنۡ","حَرَجٖ","فِيمَا","فَرَضَ","ٱللَّهُ","لَهُۥۖ","سُنَّةَ","ٱللَّهِ","فِي","ٱلَّذِينَ","خَلَوۡاْ","مِن","قَبۡلُۚ","وَكَانَ","أَمۡرُ","ٱللَّهِ","قَدَرٗا","مَّقۡدُورًا"],"мма кана `алан набиййи мин харажин фиима фарадаллаху лахуу суннаталлахи фил лазиина халау мин ḳаблу вакана амруллахи ḳадарам маḳдуура","На Пророке нет греха в том, что предписал для него Аллах. Таково было установление Аллаха для тех, которые жили прежде. Веление Аллаха является решением предопределенным.",["не","было","на","Пророке","никакого","стеснения (греха)","в том, что","предписал","Аллах","ему","(таково) установление","Аллаха","относительно","тех, которые","прошли","из","прежде","и было","веление","Аллаха","предопределением","предрешённым"]],[33,39,["ٱلَّذِينَ","يُبَلِّغُونَ","رِسَٰلَٰتِ","ٱللَّهِ","وَيَخۡشَوۡنَهُۥ","وَلَا","يَخۡشَوۡنَ","أَحَدًا","إِلَّا","ٱللَّهَۗ","وَكَفَىٰ","بِٱللَّهِ","حَسِيبٗا"],"аллазиина йубаллигууна рисалатиллахи вайахшаунахуу вала йахшауна ахадан иллаллаха вакафа биллахи хасииба","Они передали послания Аллаха и боялись Его и не боялись никого, кроме Аллаха. Довольно того, что Аллах ведет счет.",["те, которые","доносят","послания","Аллаха","и боятся Его","и не","боятся","никого","кроме","Аллаха","и достаточно","Аллаха","как Ведущего счёт"]],[33,40,["مَّا","كَانَ","مُحَمَّدٌ","أَبَآ","أَحَدٖ","مِّن","رِّجَالِكُمۡ","وَلَٰكِن","رَّسُولَ","ٱللَّهِ","وَخَاتَمَ","ٱلنَّبِيِّـۧنَۗ","وَكَانَ","ٱللَّهُ","بِكُلِّ","شَيۡءٍ","عَلِيمٗا"],"мма кана мухаммадун аба ахадим мир рижаликум валакир расуулаллахи вахатаман набиййиина ваканаллаху бикулли шай'ин `алиима","Мухаммад - не отец кого-либо из ваших мужей, а Посланник Аллаха и печать пророков (или последний из пророков). Аллах знает о всякой вещи.",["не","был","Мухаммад","отцом","кого-либо","из","ваших мужчин","но (он)","Посланник","Аллаха","и печать","пророков","и был","Аллах","о всякой","вещи","Знающим"]],[33,41,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُواْ","ٱذۡكُرُواْ","ٱللَّهَ","ذِكۡرٗا","كَثِيرٗا"],"йа'аййухал лазиина аманузкуруллаха зикран касиира","О те, которые уверовали! Поминайте Аллаха многократно",["о","те, которые","уверовали","поминайте","Аллаха","поминанием","многим"]],[33,42,["وَسَبِّحُوهُ","بُكۡرَةٗ","وَأَصِيلًا"],"васаббихууху букратан ва'асиила","и славьте Его утром и перед закатом.",["и славьте Его","утром","и перед закатом"]],[33,43,["هُوَ","ٱلَّذِي","يُصَلِّي","عَلَيۡكُمۡ","وَمَلَٰٓئِكَتُهُۥ","لِيُخۡرِجَكُم","مِّنَ","ٱلظُّلُمَٰتِ","إِلَى","ٱلنُّورِۚ","وَكَانَ","بِٱلۡمُؤۡمِنِينَ","رَحِيمٗا"],"хуал лазии йусаллии `алайкум вамалаикатухуу лийухрижакум миназ зулумати илан нуури вакана билму'миниина рахиима","Он - Тот, Кто благословляет вас, и Его ангелы также благословляют вас, чтобы вывести вас из мраков к свету. Он милосерден к верующим.",["Он","Тот, Кто","благословляет","вас","и Его ангелы","чтобы вывести вас","из","мраков","к","свету","и был Он","к верующим","Милосердным"]]],"m":[[["وَمَا","и не",33,36],["كَانَ","было",33,36],["لِمُؤۡمِنٖ","для верующего",33,36],["وَلَا","и не",33,36],["مُؤۡمِنَةٍ","верующей",33,36],["إِذَا","когда",33,36],["قَضَى","решил",33,36],