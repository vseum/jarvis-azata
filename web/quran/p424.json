{"p":424,"j":22,"a":[[33,44,["تَحِيَّتُهُمۡ","يَوۡمَ","يَلۡقَوۡنَهُۥ","سَلَٰمٞۚ","وَأَعَدَّ","لَهُمۡ","أَجۡرٗا","كَرِيمٗا"],"тахиййатухум йаума йалḳаунахуу саламун ва'а`адда лахум ажран кариима","В тот день, когда они встретят Его, их приветствием будет слово: «Мир!». Он уготовил для них щедрую награду.",["их приветствие","в день","встретят они Его","мир","и уготовил Он","им","награду","щедрую"]],[33,45,["يَٰٓأَيُّهَا","ٱلنَّبِيُّ","إِنَّآ","أَرۡسَلۡنَٰكَ","شَٰهِدٗا","وَمُبَشِّرٗا","وَنَذِيرٗا"],"йа'аййухан набиййу инна арсалнака шахидан вамубашширан ваназиира","О Пророк! Мы отправили тебя свидетелем, добрым вестником и предостерегающим увещевателем,",["о","Пророк","поистине, Мы","отправили тебя","свидетелем","и добрым вестником","и предостерегающим"]],[33,46,["وَدَاعِيًا","إِلَى","ٱللَّهِ","بِإِذۡنِهِۦ","وَسِرَاجٗا","مُّنِيرٗا"],"вада`ийан илаллахи би'изнихии васиражам муниира","призывающим к Аллаху с Его дозволения, и освещающим светочем.",["и призывающим","к","Аллаху","с Его дозволения","и светильником","освещающим"]],[33,47,["وَبَشِّرِ","ٱلۡمُؤۡمِنِينَ","بِأَنَّ","لَهُم","مِّنَ","ٱللَّهِ","فَضۡلٗا","كَبِيرٗا"],"вабашширил му'миниина би'анна лахум миналлахи фадлан кабиира","Сообщи же верующим благую весть о том, что для них у Аллаха есть великая милость.",["и обрадуй","верующих","тем, что","для них","от","Аллаха","милость","великая"]],[33,48,["وَلَا","تُطِعِ","ٱلۡكَٰفِرِينَ","وَٱلۡمُنَٰفِقِينَ","وَدَعۡ","أَذَىٰهُمۡ","وَتَوَكَّلۡ","عَلَى","ٱللَّهِۚ","وَكَفَىٰ","بِٱللَّهِ","وَكِيلٗا"],"вала тути`ил кафириина валмунафиḳиина вада` азахум ватаваккал `алаллахи вакафа биллахи вакиила","Не подчиняйся неверующим и лицемерам, оставь причиняемые ими страдания и уповай на Аллаха. Довольно того, что Аллах является Попечителем и Хранителем!",["и не","повинуйся","неверующим","и лицемерам","и оставь","их обиды","и уповай","на","Аллаха","и достаточно","Аллаха","как Попечителя"]],[33,49,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُوٓاْ","إِذَا","نَكَحۡتُمُ","ٱلۡمُؤۡمِنَٰتِ","ثُمَّ","طَلَّقۡتُمُوهُنَّ","مِن","قَبۡلِ","أَن","تَمَسُّوهُنَّ","فَمَا","لَكُمۡ","عَلَيۡهِنَّ","مِنۡ","عِدَّةٖ","تَعۡتَدُّونَهَاۖ","فَمَتِّعُوهُنَّ","وَسَرِّحُوهُنَّ","سَرَاحٗا","جَمِيلٗا"],"йа'аййухал лазиина амануу иза накахтумул му'минати сумма таллаḳтумуухунна мин ḳабли ан тамассуухунна фама лакум `алайхинна мин `иддатин та`таддуунаха фаматти`уухунна васаррихуухунна сарахан жамиила","О те, которые уверовали! Если вы вступаете в брак с верующими женщинами, а затем объявляете им развод до того, как вы коснулись их, то они не обязаны перед вами выжидать срок. Одарите их и отпустите их красиво.",["о","те, которые","уверовали","когда","женитесь вы","на верующих","затем","разводитесь с ними","из","прежде","чем","коснётесь их","то не","для вас","за ними","никакого","выжидательного срока","который отсчитывали бы","так одарите их","и отпустите их","отпусканием","красивым"]],[33,50,["يَٰٓأَيُّهَا","ٱلنَّبِيُّ","إِنَّآ","أَحۡلَلۡنَا","لَكَ","أَزۡوَٰجَكَ","ٱلَّٰتِيٓ","ءَاتَيۡتَ","أُجُورَهُنَّ","وَمَا","مَلَكَتۡ","يَمِينُكَ","مِمَّآ","أَفَآءَ","ٱللَّهُ","عَلَيۡكَ","وَبَنَاتِ","عَمِّكَ","وَبَنَاتِ","عَمَّٰتِكَ","وَبَنَاتِ","خَالِكَ","وَبَنَاتِ","خَٰلَٰتِكَ","ٱلَّٰتِي","هَاجَرۡنَ","مَعَكَ","وَٱمۡرَأَةٗ","مُّؤۡمِنَةً","إِن","وَهَبَتۡ","نَفۡسَهَا","لِلنَّبِيِّ","إِنۡ","أَرَادَ","ٱلنَّبِيُّ","أَن","يَسۡتَنكِحَهَا","خَالِصَةٗ","لَّكَ","مِن","دُونِ","ٱلۡمُؤۡمِنِينَۗ","قَدۡ","عَلِمۡنَا","مَا","فَرَضۡنَا","عَلَيۡهِمۡ","فِيٓ","أَزۡوَٰجِهِمۡ","وَمَا","مَلَكَتۡ","أَيۡمَٰنُهُمۡ","لِكَيۡلَا","يَكُونَ","عَلَيۡكَ","حَرَجٞۗ","وَكَانَ","ٱللَّهُ","غَفُورٗا","رَّحِيمٗا"],"йа'аййухан набиййу инна ахлална лака азважакал латии атайта ужуурахунна вама малакат йамиинука мимма афааллаху `алайка вабанати `аммика вабанати `амматика вабанати халика вабанати халатикал латии хажарна ма`ака вамраатам му'минатан ин вахабат нафсаха линнабиййи ин арадан набиййу ан йастанкихаха халисатал лака мин дуунил му'миниина ḳад `алимна ма фарадна `алайхим фии азважихим вама малакат айманухум ликайла йакууна `алайка харажун ваканаллаху гафуурар рахиима","О Пророк! Мы сделали для тебя дозволенными твоих жен, которым ты уплатил их вознаграждение, и невольниц, которыми овладела твоя десница и которыми Аллах одарил тебя, а также дочерей твоих дядей со стороны отца, дочерей твоих теток со стороны отца, дочерей твоих дядей со стороны матери, дочерей твоих теток со стороны матери, которые переселились вместе с тобой, а также любую верующую женщину, которая подарит себя Пророку, если Пророк захочет жениться на ней. Последнее дозволено только тебе, но не другим верующим. Мы знаем, что Мы предписали им относительно их жен и невольниц, которыми овладели их десницы. Тебе сделаны исключения для того, чтобы ты не испытывал никакого стеснения. Аллах - Прощающий, Милосердный.",["о","Пророк","поистине, Мы","сделали дозволенными","тебе","твоих жён","которым","дал ты","их вознаграждения","и тех, которыми","овладела","твоя десница","из тех, что","даровал (в добычу)","Аллах","тебе","и дочерей","твоего дяди (по отцу)","и дочерей","твоих тёток (по отцу)","и дочерей","твоего дяди (по матери)","и дочерей","твоих тёток (по матери)","которые","переселились","с тобой","и женщину","верующую","если","подарит","себя","Пророку","если","пожелает","Пророк","чтобы","жениться на ней","исключительно","для тебя","из","помимо","верующих","уже","знаем Мы","что","предписали Мы","им","относительно","их жён","и тех, которыми","овладели","их десницы","чтобы не","было","на тебе","стеснения","и был","Аллах","Прощающим","Милосердным"]]],"m":[[["تَحِيَّتُهُمۡ","их приветствие",33,44],["يَوۡمَ","в день",33,44],["يَلۡقَوۡنَهُۥ","встретят они Его",33,44],["سَلَٰمٞۚ","мир",33,44],["وَأَعَدَّ","и уготовил Он",33,44],["لَهُمۡ","им",33,44],["أَجۡرٗا","награду",33,44],["كَرِيمٗا","щедрую",33,44],[44],["يَٰٓأَيُّهَا","о",33,45]],[["ٱلنَّبِيُّ","Пророк",33,45],["إِنَّآ","поистине, Мы",33,45],["أَرۡسَلۡنَٰكَ","отправили тебя",33,45],["شَٰهِدٗا","свидетелем",33,45],["وَمُبَشِّرٗا","и добрым вестником",33,45],["وَنَذِيرٗا","и предостерегающим",33,45],[45],["وَدَاعِيًا","и призывающим",33,46]],[["إِلَى","к",33,46],["ٱللَّهِ","Аллаху",33,46],["بِإِذۡنِهِۦ","с Его дозволения",33,46],["وَسِرَاجٗا","и светильником",33,46],["مُّنِيرٗا","освещающим",33,46],[46],["وَبَشِّرِ","и обрадуй",33,47],["ٱلۡمُؤۡمِنِينَ","верующих",33,47],["بِأَنَّ","тем, что",33,47],["لَهُم","для них",33,47]],[["مِّنَ","от",33,47],["ٱللَّهِ","Аллаха",33,47],["فَضۡلٗا","милость",33,47],["كَبِيرٗا","великая",33,47],[47],["وَلَا","и не",33,48],["تُطِعِ","повинуйся",33,48],["ٱلۡكَٰفِرِينَ","неверующим",33,48],["وَٱلۡمُنَٰفِقِينَ","и лицемерам",33,48]],[["وَدَعۡ","и оставь",33,48],["أَذَىٰهُمۡ","их обиды",33,48],["وَتَوَكَّلۡ","и уповай",33,48],["عَلَى","на",33,48],["ٱللَّهِۚ","Аллаха",33,48],["وَكَفَىٰ","и достаточно",33,48],["بِٱللَّهِ","Аллаха",33,48],["وَكِيلٗا","как Попечителя",33,48],[48]],[["يَٰٓأَيُّهَا","о",33,49],["ٱلَّذِينَ","те, которые",33,49],["ءَامَنُوٓاْ","уверовали",33,49],["إِذَا","когда",33,49],["نَكَحۡتُمُ","женитесь вы",33,49],["ٱلۡمُؤۡمِنَٰتِ","на верующих",33,49],["ثُمَّ","затем",33,49],["طَلَّقۡتُمُوهُنَّ","разводитесь с ними",33,49]],[["مِن","из",33,49],["قَبۡلِ","прежде",33,49],["أَن","чем",33,49],["تَمَسُّوهُنَّ","коснётесь их",33,49],["فَمَا","то не",33,49],["لَكُمۡ","для вас",33,49],["عَلَيۡهِنَّ","за ними",33,49],["مِنۡ","никакого",33,49],["عِدَّةٖ","выжидательного срока",33,49],["تَعۡتَدُّونَهَاۖ","который отсчитывали бы",33,49]],[["فَمَتِّعُوهُنَّ","так одарите их",33,49],["وَسَرِّحُوهُنَّ","и отпустите их",33,49],["سَرَاحٗا","отпусканием",33,49],["جَمِيلٗا","красивым",33,49],[49],["يَٰٓأَيُّهَا","о",33,50],["ٱلنَّبِيُّ","Пророк",33,50],["إِنَّآ","поистине, Мы",33,50]],[["أَحۡلَلۡنَا","сделали дозволенными",33,50],["لَكَ","тебе",33,50],["أَزۡوَٰجَكَ","твоих жён",33,50],["ٱلَّٰتِيٓ","которым",33,50],["ءَاتَيۡتَ","дал ты",33,50],["أُجُورَهُنَّ","их вознаграждения",33,50],["وَمَا","и тех, которыми",33,50],["مَلَكَتۡ","овладела",33,50]],[["يَمِينُكَ","твоя десница",33,50],["مِمَّآ","из тех, что",33,50],["أَفَآءَ","даровал (в добычу)",33,50],["ٱللَّهُ","Аллах",33,50],["عَلَيۡكَ","тебе",33,50],["وَبَنَاتِ","и дочерей",33,50],["عَمِّكَ","твоего дяди (по отцу)",33,50],["وَبَنَاتِ","и дочерей",33,50],["عَمَّٰتِكَ","твоих тёток (по отцу)",33,50]],[["وَبَنَاتِ","и дочерей",33,50],["خَالِكَ","твоего дяди (по матери)",33,50],["وَبَنَاتِ","и дочерей",33,50],["خَٰلَٰتِكَ","твоих тёток (по матери)",33,50],["ٱلَّٰتِي","которые",33,50],["هَاجَرۡنَ","переселились",33,50],["مَعَكَ","с тобой",33,50],["وَٱمۡرَأَةٗ","и женщину",33,50]],[["مُّؤۡمِنَةً","верующую",33,50],["إِن","если",33,50],["وَهَبَتۡ","подарит",33,50],["نَفۡسَهَا","себя",33,50],["لِلنَّبِيِّ","Пророку",33,50],["إِنۡ","если",33,50],["أَرَادَ","пожелает",33,50],["ٱلنَّبِيُّ","Пророк",33,50],["أَن","чтобы",33,50],["يَسۡتَنكِحَهَا","жениться на ней",33,50]],[["خَالِصَةٗ","исключительно",33,50],["لَّكَ","для тебя",33,50],["مِن","из",33,50],["دُونِ","помимо",33,50],["ٱلۡمُؤۡمِنِينَۗ","верующих",33,50],["قَدۡ","уже",33,50],["عَلِمۡنَا","знаем Мы",33,50],["مَا","что",33,50],["فَرَضۡنَا","предписали Мы",33,50]],[["عَلَيۡهِمۡ","им",33,50],["فِيٓ","относительно",33,50],["أَزۡوَٰجِهِمۡ","их жён",33,50],["وَمَا","и тех, которыми",33,50],["مَلَكَتۡ","овладели",33,50],["أَيۡمَٰنُهُمۡ","их десницы",33,50],["لِكَيۡلَا","чтобы не",33,50]],[["يَكُونَ","было",33,50],["عَلَيۡكَ","на тебе",33,50],["حَرَجٞۗ","стеснения",33,50],["وَكَانَ","и был",33,50],["ٱللَّهُ","Аллах",33,50],["غَفُورٗا","Прощающим",33,50],["رَّحِيمٗا","Милосердным",33,50],[50]]]}