{"p":425,"j":22,"a":[[33,51,["تُرۡجِي","مَن","تَشَآءُ","مِنۡهُنَّ","وَتُـٔۡوِيٓ","إِلَيۡكَ","مَن","تَشَآءُۖ","وَمَنِ","ٱبۡتَغَيۡتَ","مِمَّنۡ","عَزَلۡتَ","فَلَا","جُنَاحَ","عَلَيۡكَۚ","ذَٰلِكَ","أَدۡنَىٰٓ","أَن","تَقَرَّ","أَعۡيُنُهُنَّ","وَلَا","يَحۡزَنَّ","وَيَرۡضَيۡنَ","بِمَآ","ءَاتَيۡتَهُنَّ","كُلُّهُنَّۚ","وَٱللَّهُ","يَعۡلَمُ","مَا","فِي","قُلُوبِكُمۡۚ","وَكَانَ","ٱللَّهُ","عَلِيمًا","حَلِيمٗا"],"туржии ман ташау минхунна вату'вии илайка ман ташау ваманибтагайта мимман `азалта фала жунаха `алайка залика адна ан таḳарра а`йунухунна вала йахзанна вайардайна бима атайтахунна куллухунна валлаху йа`ламу ма фии ḳулуубикум ваканаллаху `алииман халиима","Ты можешь по своему желанию отложить посещение любой из них (жен Пророка), и удержать возле себя ту, которую пожелаешь. Если же ты пожелаешь ту, которую ты прежде отстранил, то это не будет для тебя грехом. Это лучше для того, чтобы глаза каждой из них радовались, чтобы они не печалились и были довольны тем, что ты даруешь им. Аллах знает то, что в ваших сердцах, ибо Аллах - Знающий, Выдержанный.",["откладываешь ты","кого","пожелаешь","из них","и приближаешь","к себе","кого","пожелаешь","а кого","пожелал ты","из тех, кого","отстранил ты","то нет","греха","на тебе","это","ближе к тому","чтобы","радовались (охлаждались)","их глаза","и не","печалились они","и были довольны","тем, что","дал ты им","все они","и Аллах","знает","что","в","ваших сердцах","и был","Аллах","Знающим","Выдержанным"]],[33,52,["لَّا","يَحِلُّ","لَكَ","ٱلنِّسَآءُ","مِنۢ","بَعۡدُ","وَلَآ","أَن","تَبَدَّلَ","بِهِنَّ","مِنۡ","أَزۡوَٰجٖ","وَلَوۡ","أَعۡجَبَكَ","حُسۡنُهُنَّ","إِلَّا","مَا","مَلَكَتۡ","يَمِينُكَۗ","وَكَانَ","ٱللَّهُ","عَلَىٰ","كُلِّ","شَيۡءٖ","رَّقِيبٗا"],"лла йахиллу лакан нисау мим ба`ду вала ан табаддала бихинна мин азважин валау а`жабака хуснухунна илла ма малакат йамиинука ваканаллаху `ала кулли шай'ир раḳииба","Отныне тебе не дозволено жениться на других женщинах и заменять их другими женами, даже если их красота поразит тебя, но это не относится к невольницам, которыми овладела твоя десница. Аллах наблюдает за всякой вещью.",["не","дозволены","тебе","женщины","из","после (этого)","и не","чтобы","заменять","ими","из","(других) жён","даже если","восхитила тебя","их красота","кроме","тех, которыми","овладела","твоя десница","и был","Аллах","над","всякой","вещью","Наблюдающим"]],[33,53,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُواْ","لَا","تَدۡخُلُواْ","بُيُوتَ","ٱلنَّبِيِّ","إِلَّآ","أَن","يُؤۡذَنَ","لَكُمۡ","إِلَىٰ","طَعَامٍ","غَيۡرَ","نَٰظِرِينَ","إِنَىٰهُ","وَلَٰكِنۡ","إِذَا","دُعِيتُمۡ","فَٱدۡخُلُواْ","فَإِذَا","طَعِمۡتُمۡ","فَٱنتَشِرُواْ","وَلَا","مُسۡتَـٔۡنِسِينَ","لِحَدِيثٍۚ","إِنَّ","ذَٰلِكُمۡ","كَانَ","يُؤۡذِي","ٱلنَّبِيَّ","فَيَسۡتَحۡيِۦ","مِنكُمۡۖ","وَٱللَّهُ","لَا","يَسۡتَحۡيِۦ","مِنَ","ٱلۡحَقِّۚ","وَإِذَا","سَأَلۡتُمُوهُنَّ","مَتَٰعٗا","فَسۡـَٔلُوهُنَّ","مِن","وَرَآءِ","حِجَابٖۚ","ذَٰلِكُمۡ","أَطۡهَرُ","لِقُلُوبِكُمۡ","وَقُلُوبِهِنَّۚ","وَمَا","كَانَ","لَكُمۡ","أَن","تُؤۡذُواْ","رَسُولَ","ٱللَّهِ","وَلَآ","أَن","تَنكِحُوٓاْ","أَزۡوَٰجَهُۥ","مِنۢ","بَعۡدِهِۦٓ","أَبَدًاۚ","إِنَّ","ذَٰلِكُمۡ","كَانَ","عِندَ","ٱللَّهِ","عَظِيمًا"],"йа'аййухал лазиина амануу ла тадхулуу буйуутан набиййи илла ан йу'зана лакум ила та`амин гайра назириина инаху валакин иза ду`иитум фадхулуу фа'иза та`имтум фанташируу вала муста'нисиина лихадиисин инна заликум кана йу'зин набиййа файастахйии минкум валлаху ла йастахйии минал хаḳḳи ва'иза са'алтумуухунна мата`ан фас'алуухунна мин вараи хижабин заликум атхару лиḳулуубикум ваḳулуубихинна вама кана лакум ан ту'зуу расуулаллахи вала ан танкихуу азважахуу мим ба`дихии абадан инна заликум кана `индаллахи `азиима","О те, которые уверовали! Не входите в дома Пророка, если только вас не пригласят на трапезу, но не дожидайтесь ее приготовления (не приходите заранее). Если же вас пригласят, то входите, а когда поедите, то расходитесь и не усаживайтесь для разговоров. Этим вы причиняете неудобство Пророку. Он стыдится вас, но Аллах не стыдится истины. Если вы просите у них (жен Пророка) какую-либо утварь, то просите у них через завесу. Так будет чище для ваших сердец и их сердец. Вам не подобает ни обижать Посланника Аллаха, ни жениться на его женах после его смерти. Воистину, это является великим грехом перед Аллахом.",["о","те, которые","уверовали","не","входите","в дома","Пророка","кроме","как","будет дозволено","вам","к","еде","не","ожидающими","её готовности","но","когда","позваны вы","то входите","а когда","поели вы","то расходитесь","и не","засиживаясь","для беседы","поистине","это","было","докучает","Пророку","и он стыдится","вас","а Аллах","не","стыдится","от","истины","и когда","просите вы у них","(какую-либо) вещь","то просите их","из","за","завесы","это","чище","для ваших сердец","и их сердец","и не","было","вам","чтобы","обижали вы","Посланника","Аллаха","и не","чтобы","женились вы","на его жёнах","из","после него","никогда","поистине","это","было","у","Аллаха","великим (грехом)"]],[33,54,["إِن","تُبۡدُواْ","شَيۡـًٔا","أَوۡ","تُخۡفُوهُ","فَإِنَّ","ٱللَّهَ","كَانَ","بِكُلِّ","شَيۡءٍ","عَلِيمٗا"],"ин тубдуу шай'ан ау тухфууху фа'инналлаха кана бикулли шай'ин `алиима","Обнаруживаете вы что-либо или скрываете, Аллах все равно знает о каждой вещи.",["если","обнаружите вы","что-либо","или","скроете это","то поистине","Аллах","был","о всякой","вещи","Знающим"]]],"m":[[["۞ تُرۡجِي","откладываешь ты",33,51],["مَن","кого",33,51],["تَشَآءُ","пожелаешь",33,51],["مِنۡهُنَّ","из них",33,51],["وَتُـٔۡوِيٓ","и приближаешь",33,51],["إِلَيۡكَ","к себе",33,51],["مَن","кого",33,51],["تَشَآءُۖ","пожелаешь",33,51],["وَمَنِ","а кого",33,51],["ٱبۡتَغَيۡتَ","пожелал ты",33,51]],[["مِمَّنۡ","из тех, кого",33,51],["عَزَلۡتَ","отстранил ты",33,51],["فَلَا","то нет",33,51],["جُنَاحَ","греха",33,51],["عَلَيۡكَۚ","на тебе",33,51],["ذَٰلِكَ","это",33,51],["أَدۡنَىٰٓ","ближе к тому",33,51],["أَن","чтобы",33,51],["تَقَرَّ","радовались (охлаждались)",33,51],["أَعۡيُنُهُنَّ","их глаза",33,51]],[["وَلَا","и не",33,51],["يَحۡزَنَّ","печалились они",33,51],