{"p":426,"j":22,"a":[[33,55,["لَّا","جُنَاحَ","عَلَيۡهِنَّ","فِيٓ","ءَابَآئِهِنَّ","وَلَآ","أَبۡنَآئِهِنَّ","وَلَآ","إِخۡوَٰنِهِنَّ","وَلَآ","أَبۡنَآءِ","إِخۡوَٰنِهِنَّ","وَلَآ","أَبۡنَآءِ","أَخَوَٰتِهِنَّ","وَلَا","نِسَآئِهِنَّ","وَلَا","مَا","مَلَكَتۡ","أَيۡمَٰنُهُنَّۗ","وَٱتَّقِينَ","ٱللَّهَۚ","إِنَّ","ٱللَّهَ","كَانَ","عَلَىٰ","كُلِّ","شَيۡءٖ","شَهِيدًا"],"лла жунаха `алайхинна фии абаихинна вала абнаихинна вала ихванихинна вала абнаи ихванихинна вала абнаи ахаватихинна вала нисаихинна вала ма малакат айманухунна ваттаḳииналлаха инналлаха кана `ала кулли шай'ин шахиида","На них (женах Пророка) не будет греха, если они будут без покрывала перед их отцами, их сыновьями, их братьями, сыновьями их братьев, сыновьями их сестер, своими женщинами и невольниками, которыми овладели их десницы. Бойтесь Аллаха, ведь Аллах - Свидетель всякой вещи.",["нет","греха","на них","в отношении","их отцов","и не","их сыновей","и не","их братьев","и не","сыновей","их братьев","и не","сыновей","их сестёр","и не","их женщин","и не","тех, которыми","овладели","их десницы","и бойтесь","Аллаха","поистине","Аллах","был","над","всякой","вещью","Свидетелем"]],[33,56,["إِنَّ","ٱللَّهَ","وَمَلَٰٓئِكَتَهُۥ","يُصَلُّونَ","عَلَى","ٱلنَّبِيِّۚ","يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُواْ","صَلُّواْ","عَلَيۡهِ","وَسَلِّمُواْ","تَسۡلِيمًا"],"инналлаха вамалаикатахуу йусаллууна `алан набиййи йа'аййухал лазиина амануу саллуу `алайхи васаллимуу таслиима","Воистину, Аллах и Его ангелы благословляют Пророка. О те, которые уверовали! Благословляйте его и приветствуйте миром.",["поистине","Аллах","и Его ангелы","благословляют","на","Пророка","о","те, которые","уверовали","благословляйте","его","и приветствуйте","приветствием"]],[33,57,["إِنَّ","ٱلَّذِينَ","يُؤۡذُونَ","ٱللَّهَ","وَرَسُولَهُۥ","لَعَنَهُمُ","ٱللَّهُ","فِي","ٱلدُّنۡيَا","وَٱلۡأٓخِرَةِ","وَأَعَدَّ","لَهُمۡ","عَذَابٗا","مُّهِينٗا"],"иннал лазиина йу'зууналлаха варасуулахуу ла`анахумуллаху фид дунйа вал'ахирати ва'а`адда лахум `азабам мухиина","Воистину, тех, которые поносят Аллаха и Его Посланника, Аллах проклял в этом мире и в Последней жизни и уготовил им унизительные мучения.",["поистине","те, которые","обижают","Аллаха","и Его Посланника","проклял их","Аллах","в","этом мире","и в Последней жизни","и уготовил","им","наказание","унизительное"]],[33,58,["وَٱلَّذِينَ","يُؤۡذُونَ","ٱلۡمُؤۡمِنِينَ","وَٱلۡمُؤۡمِنَٰتِ","بِغَيۡرِ","مَا","ٱكۡتَسَبُواْ","فَقَدِ","ٱحۡتَمَلُواْ","بُهۡتَٰنٗا","وَإِثۡمٗا","مُّبِينٗا"],"валлазиина йу'зуунал му'миниина валму'минати бигайри мактасабуу фаḳадихтамалуу бухтанан ва'исмам мубиина","А те, которые незаслуженно поносят верующих мужчин и верующих женщин, взваливают на себя бремя клеветы и явного греха.",["а те, которые","обижают","верующих мужчин","и верующих женщин","без","того, что","приобрели они","то уже","взвалили они","клевету","и грех","явный"]],[33,59,["يَٰٓأَيُّهَا","ٱلنَّبِيُّ","قُل","لِّأَزۡوَٰجِكَ","وَبَنَاتِكَ","وَنِسَآءِ","ٱلۡمُؤۡمِنِينَ","يُدۡنِينَ","عَلَيۡهِنَّ","مِن","جَلَٰبِيبِهِنَّۚ","ذَٰلِكَ","أَدۡنَىٰٓ","أَن","يُعۡرَفۡنَ","فَلَا","يُؤۡذَيۡنَۗ","وَكَانَ","ٱللَّهُ","غَفُورٗا","رَّحِيمٗا"],"йа'аййухан набиййу ḳул ли'азважика вабанатика ванисаил му'миниина йудниина `алайхинна мин жалабиибихинна залика адна ан йу`рафна фала йу'зайна ваканаллаху гафуурар рахиима","О Пророк! Скажи твоим женам, твоим дочерям и женщинам верующих мужчин, чтобы они опускали на себя (или сближали на себе) свои покрывала. Так их будут легче узнавать (отличать от рабынь и блудниц) и не подвергнут оскорблениям. Аллах - Прощающий, Милосердный.",["о","Пророк","скажи","твоим жёнам","и твоим дочерям","и женщинам","верующих","пусть опускают","на себя","из","своих покрывал","это","ближе к тому","чтобы","узнавали их","и не","обижали их","и был","Аллах","Прощающим","Милосердным"]],[33,60,["لَّئِن","لَّمۡ","يَنتَهِ","ٱلۡمُنَٰفِقُونَ","وَٱلَّذِينَ","فِي","قُلُوبِهِم","مَّرَضٞ","وَٱلۡمُرۡجِفُونَ","فِي","ٱلۡمَدِينَةِ","لَنُغۡرِيَنَّكَ","بِهِمۡ","ثُمَّ","لَا","يُجَاوِرُونَكَ","فِيهَآ","إِلَّا","قَلِيلٗا"],"лла'ил лам йантахил мунафиḳууна валлазиина фии ḳулуубихим марадун валмуржифууна фил мадиинати ланугрийаннака бихим сумма ла йужавируунака фииха илла ḳалиила","Если лицемеры и те, чьи сердца поражены недугом, и те, кто распространяет слухи в Медине, не перестанут, то Мы непременно поможем тебе одолеть их, и тогда они будут соседствовать с тобой здесь совсем недолго,",["если","не","перестанут","лицемеры","и те, которые","в","их сердцах","болезнь","и распускающие слухи","в","Медине","непременно натравим Мы тебя","на них","затем","не","будут соседствовать с тобой","в ней","кроме","недолго"]],[33,61,["مَّلۡعُونِينَۖ","أَيۡنَمَا","ثُقِفُوٓاْ","أُخِذُواْ","وَقُتِّلُواْ","تَقۡتِيلٗا"],"ммал`ууниина айнама суḳифуу ухизуу ваḳуттилуу таḳтиила","будучи проклятыми. Где бы их ни обнаружили, их будут хватать и безжалостно убивать.",["проклятыми","где бы ни","обнаружены были","схвачены будут","и перебиты","избиением"]],[33,62,["سُنَّةَ","ٱللَّهِ","فِي","ٱلَّذِينَ","خَلَوۡاْ","مِن","قَبۡلُۖ","وَلَن","تَجِدَ","لِسُنَّةِ","ٱللَّهِ","تَبۡدِيلٗا"],"суннаталлахи фил лазиина халау мин ḳаблу валан тажида лисуннатиллахи табдиила","Таково было установление Аллаха для тех, которые жили прежде, и ты не найдешь изменения в установлении Аллаха.",["(таково) установление","Аллаха","относительно","тех, которые","прошли","из","прежде","и никогда не","найдёшь ты","установлению","Аллаха","замены"]]],"m":[[["لَّا","нет",33,55],["جُنَاحَ","греха",33,55],["عَلَيۡهِنَّ","на них",33,55],["فِيٓ","в отношении",33,55],["ءَابَآئِهِنَّ","их отцов",33,55],["وَلَآ","и не",33,55],["أَبۡنَآئِهِنَّ","их сыновей",33,55],["وَلَآ","и не",33,55],["إِخۡوَٰنِهِنَّ","их братьев",33,55],["وَلَآ","и не",33,55],["أَبۡنَآءِ","сыновей",33,55]],[["إِخۡوَٰنِهِنَّ","их братьев",33,55],["وَلَآ","и не",33,55],["أَبۡنَآءِ","сыновей",33,55],["أَخَوَٰتِهِنَّ","их сестёр",33,55],["وَلَا","и не",33,55],["نِسَآئِهِنَّ","их женщин",33,55],["وَلَا","и не",33,55],["مَا","тех, которыми",33,55],["مَلَكَتۡ","овладели",33,55]],[["أَيۡمَٰنُهُنَّۗ","их десницы",33,55],["وَٱتَّقِينَ","и бойтесь",33,55],["ٱللَّهَۚ","Аллаха",33,55],["إِنَّ","поистине",33,55],["ٱللَّهَ","Аллах",33,55],["كَانَ","был",33,55],["عَلَىٰ","над",33,55],["كُلِّ","всякой",33,55],["شَيۡءٖ","вещью",33,55],["شَهِيدًا","Свидетелем",33,55]],[[55],["إِنَّ","поистине",33,56],["ٱللَّهَ","Аллах",33,56],["وَمَلَٰٓئِكَتَهُۥ","и Его ангелы",33,56],["يُصَلُّونَ","благословляют",33,56],["عَلَى","на",33,56],["ٱلنَّبِيِّۚ","Пророка",33,56],["يَٰٓأَيُّهَا","о",33,56],["ٱلَّذِينَ","те, которые",33,56]],[["ءَامَنُواْ","уверовали",33,56],["صَلُّواْ","благословляйте",33,56],["عَلَيۡهِ","его",33,56],["وَسَلِّمُواْ","и приветствуйте",33,56],["تَسۡلِيمًا","приветствием",33,56],[56],["إِنَّ","поистине",33,57],["ٱلَّذِينَ","те, которые",33,57],["يُؤۡذُونَ","обижают",33,57]],[["ٱللَّهَ","Аллаха",33,57],["وَرَسُولَهُۥ","и Его Посланника",33,57],["لَعَنَهُمُ","проклял их",33,57],["ٱللَّهُ","Аллах",33,57],["فِي","в",33,57],["ٱلدُّنۡيَا","этом мире",33,57],["وَٱلۡأٓخِرَةِ","и в Последней жизни",33,57],["وَأَعَدَّ","и уготовил",33,57],["لَهُمۡ","им",33,57],["عَذَابٗا","наказание",33,57]],[["مُّهِينٗا","унизительное",33,57],[57],["وَٱلَّذِينَ","а те, которые",33,58],["يُؤۡذُونَ","обижают",33,58],["ٱلۡمُؤۡمِنِينَ","верующих мужчин",33,58],["وَٱلۡمُؤۡمِنَٰتِ","и верующих женщин",33,58]],[["بِغَيۡرِ","без",33,58],["مَا","того, что",33,58],["ٱكۡتَسَبُواْ","приобрели они",33,58],["فَقَدِ","то уже",33,58],["ٱحۡتَمَلُواْ","взвалили они",33,58],["بُهۡتَٰنٗا","клевету",33,58],["وَإِثۡمٗا","и грех",33,58],["مُّبِينٗا","явный",33,58],[58]],[["يَٰٓأَيُّهَا","о",33,59],["ٱلنَّبِيُّ","Пророк",33,59],["قُل","скажи",33,59],["لِّأَزۡوَٰجِكَ","твоим жёнам",33,59],["وَبَنَاتِكَ","и твоим дочерям",33,59],["وَنِسَآءِ","и женщинам",33,59],["ٱلۡمُؤۡمِنِينَ","верующих",33,59],["يُدۡنِينَ","пусть опускают",33,59]],[["عَلَيۡهِنَّ","на себя",33,59],["مِن","из",33,59],["جَلَٰبِيبِهِنَّۚ","своих покрывал",33,59],["ذَٰلِكَ","это",33,59],["أَدۡنَىٰٓ","ближе к тому",33,59],["أَن","чтобы",33,59],["يُعۡرَفۡنَ","узнавали их",33,59],["فَلَا","и не",33,59],["يُؤۡذَيۡنَۗ","обижали их",33,59],["وَكَانَ","и был",33,59]],[["ٱللَّهُ","Аллах",33,59],["غَفُورٗا","Прощающим",33,59],["رَّحِيمٗا","Милосердным",33,59],[59],["۞ لَّئِن","если",33,60],["لَّمۡ","не",33,60],["يَنتَهِ","перестанут",33,60],["ٱلۡمُنَٰفِقُونَ","лицемеры",33,60],["وَٱلَّذِينَ","и те, которые",33,60]],[["فِي","в",33,60],["قُلُوبِهِم","их сердцах",33,60],["مَّرَضٞ","болезнь",33,60],["وَٱلۡمُرۡجِفُونَ","и распускающие слухи",33,60],["فِي","в",33,60],["ٱلۡمَدِينَةِ","Медине",33,60],["لَنُغۡرِيَنَّكَ","непременно натравим Мы тебя",33,60]],[["بِهِمۡ","на них",33,60],["ثُمَّ","затем",33,60],["لَا","не",33,60],["يُجَاوِرُونَكَ","будут соседствовать с тобой",33,60],["فِيهَآ","в ней",33,60],["إِلَّا","кроме",33,60],["قَلِيلٗا","недолго",33,60],[60],["مَّلۡعُونِينَۖ","проклятыми",33,61]],[["أَيۡنَمَا","где бы ни",33,61],["ثُقِفُوٓاْ","обнаружены были",33,61],["أُخِذُواْ","схвачены будут",33,61],["وَقُتِّلُواْ","и перебиты",33,61],["تَقۡتِيلٗا","избиением",33,61],[61],["سُنَّةَ","(таково) установление",33,62],["ٱللَّهِ","Аллаха",33,62],["فِي","относительно",33,62]],[["ٱلَّذِينَ","тех, которые",33,62],["خَلَوۡاْ","прошли",33,62],["مِن","из",33,62],["قَبۡلُۖ","прежде",33,62],["وَلَن","и никогда не",33,62],["تَجِدَ","найдёшь ты",33,62],["لِسُنَّةِ","установлению",33,62],["ٱللَّهِ","Аллаха",33,62],["تَبۡدِيلٗا","замены",33,62],[62]]]}