{"p":427,"j":22,"a":[[33,63,["يَسۡـَٔلُكَ","ٱلنَّاسُ","عَنِ","ٱلسَّاعَةِۖ","قُلۡ","إِنَّمَا","عِلۡمُهَا","عِندَ","ٱللَّهِۚ","وَمَا","يُدۡرِيكَ","لَعَلَّ","ٱلسَّاعَةَ","تَكُونُ","قَرِيبًا"],"йас'алукан насу `анис са`ати ḳул иннама `илмуха `индаллахи вама йудриика ла`аллас са`ата такууну ḳарииба","Люди спрашивают тебя о Часе. Скажи: «Знанием о нем обладает только Аллах». Откуда тебе знать, быть может, Час близок?",["спрашивают тебя","люди","о","Часе","скажи","лишь","знание о нём","у","Аллаха","и что","даст знать тебе","возможно","Час","будет","близким"]],[33,64,["إِنَّ","ٱللَّهَ","لَعَنَ","ٱلۡكَٰفِرِينَ","وَأَعَدَّ","لَهُمۡ","سَعِيرًا"],"инналлаха ла`анал кафириина ва'а`адда лахум са`иира","Воистину, Аллах проклял неверующих и уготовил для них Пламя,",["поистине","Аллах","проклял","неверующих","и уготовил","им","Пламя"]],[33,65,["خَٰلِدِينَ","فِيهَآ","أَبَدٗاۖ","لَّا","يَجِدُونَ","وَلِيّٗا","وَلَا","نَصِيرٗا"],"халидиина фииха абадал ла йажидууна валиййан вала насиира","в котором они пребудут вечно. Они не найдут ни покровителя, ни помощника.",["вечно пребывающими","в нём","навсегда","не","найдут они","покровителя","и не","помощника"]],[33,66,["يَوۡمَ","تُقَلَّبُ","وُجُوهُهُمۡ","فِي","ٱلنَّارِ","يَقُولُونَ","يَٰلَيۡتَنَآ","أَطَعۡنَا","ٱللَّهَ","وَأَطَعۡنَا","ٱلرَّسُولَا۠"],"йаума туḳаллабу вужуухухум фин нари йаḳуулууна йалайтана ата`наллаха ва'ата`нар расуул","В тот день их лица будут поворачиваться (или изменяться) в Огне, и они скажут: «Лучше бы мы повиновались Аллаху и повиновались Посланнику!».",["в день","будут переворачиваться","их лица","в","Огне","скажут они","о, если бы мы","повиновались мы","Аллаху","и повиновались мы","Посланнику"]],[33,67,["وَقَالُواْ","رَبَّنَآ","إِنَّآ","أَطَعۡنَا","سَادَتَنَا","وَكُبَرَآءَنَا","فَأَضَلُّونَا","ٱلسَّبِيلَا۠"],"ваḳалуу раббана инна ата`на садатана вакубараана фа'адаллуунас сабиил","Они скажут: «Господь наш! Мы повиновались нашим старейшинам и нашей знати, и они сбили нас с пути.",["и скажут они","Господь наш","поистине, мы","повиновались мы","нашим господам","и нашим старшим","и сбили они нас","с пути"]],[33,68,["رَبَّنَآ","ءَاتِهِمۡ","ضِعۡفَيۡنِ","مِنَ","ٱلۡعَذَابِ","وَٱلۡعَنۡهُمۡ","لَعۡنٗا","كَبِيرٗا"],"раббана атихим ди`файни минал `азаби вал`анхум ла`нан кабиира","Господь наш! Удвой для них мучения и прокляни их великим проклятием!».",["Господь наш","дай им","вдвойне","из","наказания","и прокляни их","проклятием","великим"]],[33,69,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُواْ","لَا","تَكُونُواْ","كَٱلَّذِينَ","ءَاذَوۡاْ","مُوسَىٰ","فَبَرَّأَهُ","ٱللَّهُ","مِمَّا","قَالُواْۚ","وَكَانَ","عِندَ","ٱللَّهِ","وَجِيهٗا"],"йа'аййухал лазиина амануу ла такуунуу каллазиина азау мууса фабарраахуллаху мимма ḳалуу вакана `индаллахи важииха","О те, которые уверовали! Не будьте подобны тем, которые обидели Мусу (Моисея). Аллах оправдал его и опроверг то, что они говорили. Он был почитаем перед Аллахом.",["о","те, которые","уверовали","не","будьте","как те, которые","обидели","Мусу","и оправдал его","Аллах","от того, что","сказали они","и был он","у","Аллаха","почитаемым"]],[33,70,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُواْ","ٱتَّقُواْ","ٱللَّهَ","وَقُولُواْ","قَوۡلٗا","سَدِيدٗا"],"йа'аййухал лазиина амануттаḳуллаха ваḳуулуу ḳаулан садиида","О те, которые уверовали! Бойтесь Аллаха и говорите правое слово.",["о","те, которые","уверовали","бойтесь","Аллаха","и говорите","слово","правильное"]],[33,71,["يُصۡلِحۡ","لَكُمۡ","أَعۡمَٰلَكُمۡ","وَيَغۡفِرۡ","لَكُمۡ","ذُنُوبَكُمۡۗ","وَمَن","يُطِعِ","ٱللَّهَ","وَرَسُولَهُۥ","فَقَدۡ","فَازَ","فَوۡزًا","عَظِيمًا"],"йуслих лакум а`малакум вайагфир лакум зунуубакум ваман йути`иллаха варасуулахуу фаḳад фаза фаузан `азиима","Тогда Он исправит для вас ваши дела и простит вам ваши грехи. А кто повинуется Аллаху и Его Посланнику, тот уже достиг великого успеха.",["исправит Он","для вас","ваши дела","и простит Он","вам","ваши грехи","а кто","повинуется","Аллаху","и Его Посланнику","то уже","достиг","успеха","великого"]],[33,72,["إِنَّا","عَرَضۡنَا","ٱلۡأَمَانَةَ","عَلَى","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِ","وَٱلۡجِبَالِ","فَأَبَيۡنَ","أَن","يَحۡمِلۡنَهَا","وَأَشۡفَقۡنَ","مِنۡهَا","وَحَمَلَهَا","ٱلۡإِنسَٰنُۖ","إِنَّهُۥ","كَانَ","ظَلُومٗا","جَهُولٗا"],"инна `араднал аманата `алас самавати вал'арди валжибали фа'абайна ан йахмилнаха ва'ашфаḳна минха вахамалахал инсану иннахуу кана залууман жахуула","Мы предложили небесам, земле и горам взять на себя ответственность, но они отказались нести ее и испугались этого, а человек взялся нести ее. Воистину, он является несправедливым и невежественным.",["поистине, Мы","предложили Мы","доверенное (бремя)","перед","небесами","и землёй","и горами","и отказались они","чтобы","нести его","и устрашились","его","и понёс его","человек","поистине, он","был","несправедливым","невежественным"]],[33,73,["لِّيُعَذِّبَ","ٱللَّهُ","ٱلۡمُنَٰفِقِينَ","وَٱلۡمُنَٰفِقَٰتِ","وَٱلۡمُشۡرِكِينَ","وَٱلۡمُشۡرِكَٰتِ","وَيَتُوبَ","ٱللَّهُ","عَلَى","ٱلۡمُؤۡمِنِينَ","وَٱلۡمُؤۡمِنَٰتِۗ","وَكَانَ","ٱللَّهُ","غَفُورٗا","رَّحِيمَۢا"],"ллийу`аззибаллахул мунафиḳиина валмунафиḳати валмушрикиина валмушрикати вайатуубаллаху `алал му'миниина валму'минати ваканаллаху гафуурар рахиима","Это произошло для того, чтобы Аллах наказал лицемеров и лицемерок, многобожников и многобожниц и принял покаяния верующих мужчин и верующих женщин. Аллах - Прощающий, Милосердный.",["чтобы наказал","Аллах","лицемеров","и лицемерок","и многобожников","и многобожниц","и чтобы принял покаяние","Аллах","от","верующих мужчин","и верующих женщин","и был","Аллах","Прощающим","Милосердным"]]],"m":[[["يَسۡـَٔلُكَ","спрашивают тебя",33,63],["ٱلنَّاسُ","люди",33,63],["عَنِ","о",33,63],["ٱلسَّاعَةِۖ","Часе",33,63],["قُلۡ","скажи",33,63],["إِنَّمَا","лишь",33,63],["عِلۡمُهَا","знание о нём",33,63],["عِندَ","у",33,63],["ٱللَّهِۚ","Аллаха",33,63],["وَمَا","и что",33,63],["يُدۡرِيكَ","даст знать тебе",33,63]],[["لَعَلَّ","возможно",33,63],["ٱلسَّاعَةَ","Час",33,63],["تَكُونُ","будет",33,63],["قَرِيبًا","близким",33,63],[63],["إِنَّ","поистине",33,64],["ٱللَّهَ","Аллах",33