{"p":428,"j":22,"a":[[34,1,["ٱلۡحَمۡدُ","لِلَّهِ","ٱلَّذِي","لَهُۥ","مَا","فِي","ٱلسَّمَٰوَٰتِ","وَمَا","فِي","ٱلۡأَرۡضِ","وَلَهُ","ٱلۡحَمۡدُ","فِي","ٱلۡأٓخِرَةِۚ","وَهُوَ","ٱلۡحَكِيمُ","ٱلۡخَبِيرُ"],"алхамду лиллахил лазии лахуу ма фис самавати вама фил арди валахул хамду фил ахирати вахуал хакиимул хабиир","Хвала Аллаху, Которому принадлежит то, что на небесах, и то, что на земле. Ему же надлежит хвала в Последней жизни. Он - Мудрый, Ведающий.",["Хвала","Аллаху","Который","Ему (принадлежит)","то, что","на","небесах","и то, что","на","земле","и Ему","хвала","в","Последней жизни","и Он","Мудрый","Ведающий"]],[34,2,["يَعۡلَمُ","مَا","يَلِجُ","فِي","ٱلۡأَرۡضِ","وَمَا","يَخۡرُجُ","مِنۡهَا","وَمَا","يَنزِلُ","مِنَ","ٱلسَّمَآءِ","وَمَا","يَعۡرُجُ","فِيهَاۚ","وَهُوَ","ٱلرَّحِيمُ","ٱلۡغَفُورُ"],"йа`ламу ма йалижу фил арди вама йахружу минха вама йанзилу минас самаи вама йа`ружу фииха вахуар рахиимул гафуур","Он знает то, что проникает в землю, и то, что выходит из нее, и то, что нисходит с неба, и то, что восходит к нему. Он - Милосердный, Прощающий.",["Он знает","то, что","проникает","в","землю","и то, что","выходит","из неё","и то, что","нисходит","с","неба","и то, что","восходит","на него","и Он","Милосердный","Прощающий"]],[34,3,["وَقَالَ","ٱلَّذِينَ","كَفَرُواْ","لَا","تَأۡتِينَا","ٱلسَّاعَةُۖ","قُلۡ","بَلَىٰ","وَرَبِّي","لَتَأۡتِيَنَّكُمۡ","عَٰلِمِ","ٱلۡغَيۡبِۖ","لَا","يَعۡزُبُ","عَنۡهُ","مِثۡقَالُ","ذَرَّةٖ","فِي","ٱلسَّمَٰوَٰتِ","وَلَا","فِي","ٱلۡأَرۡضِ","وَلَآ","أَصۡغَرُ","مِن","ذَٰلِكَ","وَلَآ","أَكۡبَرُ","إِلَّا","فِي","كِتَٰبٖ","مُّبِينٖ"],"ваḳалал лазиина кафаруу ла та'тиинас са`ату ḳул бала вараббии лата'тийаннакум `алимил гайби ла йа`зубу `анху мисḳалу зарратин фис самавати вала фил арди вала асгару мин залика вала акбару илла фии китабим мубиин","Неверующие сказали: «Час не наступит для нас». Скажи: «Нет, клянусь моим Господом, Ведающим сокровенное! Он непременно наступит для вас. Ни на небесах, ни на земле не ускользнет от Него даже то, что весом с мельчайшую частицу, или меньше нее, или больше нее. Все это есть в ясном Писании,",["И сказали","те, которые","не уверовали","не","придёт к нам","Час","Скажи","Нет же","клянусь моим Господом","непременно придёт к вам","Знающим","сокровенное","не","ускользнёт","от Него","вес","пылинки","на","небесах","и не","на","земле","и не","меньше","чем","это","и не","больше","кроме как","в","Писании","ясном"]],[34,4,["لِّيَجۡزِيَ","ٱلَّذِينَ","ءَامَنُواْ","وَعَمِلُواْ","ٱلصَّٰلِحَٰتِۚ","أُوْلَٰٓئِكَ","لَهُم","مَّغۡفِرَةٞ","وَرِزۡقٞ","كَرِيمٞ"],"ллийажзийал лазиина амануу ва`амилус салихати улаика лахум магфиратун варизḳун кариим","дабы Он воздал тем, которые уверовали и совершали праведные деяния. Именно им уготовано прощение и щедрый удел».",["чтобы Он воздал","тем, которые","уверовали","и совершали","праведные дела","те","им","прощение","и удел","щедрый"]],[34,5,["وَٱلَّذِينَ","سَعَوۡ","فِيٓ","ءَايَٰتِنَا","مُعَٰجِزِينَ","أُوْلَٰٓئِكَ","لَهُمۡ","عَذَابٞ","مِّن","رِّجۡزٍ","أَلِيمٞ"],"валлазиина са`ау фии айатина му`ажизиина улаика лахум `азабум мир рижзин алиим","А тем, которые старались ослабить Наши знамения, уготованы страдания от мучительного наказания.",["А те, которые","старались","против","Наших знамений","стремясь ослабить","те","им","наказание","из","кары","мучительной"]],[34,6,["وَيَرَى","ٱلَّذِينَ","أُوتُواْ","ٱلۡعِلۡمَ","ٱلَّذِيٓ","أُنزِلَ","إِلَيۡكَ","مِن","رَّبِّكَ","هُوَ","ٱلۡحَقَّ","وَيَهۡدِيٓ","إِلَىٰ","صِرَٰطِ","ٱلۡعَزِيزِ","ٱلۡحَمِيدِ"],"вайарал лазиина уутул `илмал лазии унзила илайка мир раббика хуал хаḳḳа вайахдии ила сиратил `азиизил хамиид","Те, которым даровано знание, видят, что ниспосланное тебе от твоего Господа есть истина, которая ведет к пути Могущественного, Достохвального.",["И видят","те, которым","дано","знание","что то, что","ниспослано","тебе","от","твоего Господа","оно","истина","и ведёт","к","пути","Могущественного","Достохвального"]],[34,7,["وَقَالَ","ٱلَّذِينَ","كَفَرُواْ","هَلۡ","نَدُلُّكُمۡ","عَلَىٰ","رَجُلٖ","يُنَبِّئُكُمۡ","إِذَا","مُزِّقۡتُمۡ","كُلَّ","مُمَزَّقٍ","إِنَّكُمۡ","لَفِي","خَلۡقٖ","جَدِيدٍ"],"ваḳалал лазиина кафаруу хал надуллукум `ала ражулин йунаббиукум иза муззиḳтум кулла мумаззаḳин иннакум лафии халḳин жадиид","Неверующие сказали: «Указать ли вам на мужа, который возвещает вам, что вы возродитесь в новом творении после того, как полностью распадетесь?",["И сказали","те, которые","не уверовали","ли","укажем вам","на","мужа","который возвещает вам","когда","вы будете растерзаны","всяким","растерзанием","поистине, вы","непременно в","творении","новом"]]],"m":[["h",34],["b"],[["ٱلۡحَمۡدُ","Хвала",34,1],["لِلَّهِ","Аллаху",34,1],["ٱلَّذِي","Который",34,1],["لَهُۥ","Ему (принадлежит)",34,1],["مَا","то, что",34,1],["فِي","на",34,1],["ٱلسَّمَٰوَٰتِ","небесах",34,1],["وَمَا","и то, что",34,1],["فِي","на",34,1],["ٱلۡأَرۡضِ","земле",34,1],["وَلَهُ","и Ему",34,1],["ٱلۡحَمۡدُ","хвала",34,1]],[["فِي","в",34,1],["ٱلۡأٓخِرَةِۚ","Последней жизни",34,1],["وَهُوَ","и Он",34,1],["ٱلۡحَكِيمُ","Мудрый",34,1],["ٱلۡخَبِيرُ","Ведающий",34,1],[1],["يَعۡلَمُ","Он знает",34,2],["مَا","то, что",34,2],["يَلِجُ","проникает",34,2],["فِي","в",34,2],["ٱلۡأَرۡضِ","землю",34,2]],[["وَمَا","и то, что",34,2],["يَخۡرُجُ","выходит",34,2],["مِنۡهَا","из неё",34,2],["وَمَا","и то, что",34,2],["يَنزِلُ","нисходит",34,2],["مِنَ","с",34,2],["ٱلسَّمَآءِ","неба",34,2],["وَمَا","и то, что",34,2],["يَعۡرُجُ","восходит",34,2],["فِيهَاۚ","на него",34,2],["وَهُوَ","и Он",34,2]],[["ٱلرَّحِيمُ","Милосердный",34,2],["ٱلۡغَفُورُ","Прощающий",34,2],[2],["وَقَالَ","И сказали",34,3],["ٱلَّذِينَ","те, которые",34,3],["كَفَرُواْ","не уверовали",34,3],["لَا","не",34,3],["تَأۡتِينَا","придёт к нам",34,3],["ٱلسَّاعَةُۖ","Час",34,3]],[["قُلۡ","Скажи",34,3],["بَلَىٰ","Нет же",34,3],["وَرَبِّي","клянусь моим Господом",34,3],["لَتَأۡتِيَنَّكُمۡ","непременно придёт к вам",34,3],["عَٰلِمِ","Знающим",34,3],["ٱلۡغَيۡبِۖ","сокровенное",34,3],["لَا","не",34,3],["يَعۡزُبُ","ускользнёт",34,3],["عَنۡهُ","от Него",34,3],["مِثۡقَالُ","вес",34,3]],[["ذَرَّةٖ","пылинки",34,3],["فِي","на",34,3],["ٱلسَّمَٰوَٰتِ","небесах",34,3],["وَلَا","и не",34,3],["فِي","на",34,3],["ٱلۡأَرۡضِ","земле",34,3],["وَلَآ","и не",34,3],["أَصۡغَرُ","меньше",34,3],["مِن","чем",34,3],["ذَٰلِكَ","это",34,3]],[["وَلَآ","и не",34,3],["أَكۡبَرُ","больше",34,3],["إِلَّا","кроме как",34,3],["فِي","в",34,3],["كِتَٰبٖ","Писании",34,3],["مُّبِينٖ","ясном",34,3],[3],["لِّيَجۡزِيَ","чтобы Он воздал",34,4],["ٱلَّذِينَ","тем, которые",34,4]],[["ءَامَنُواْ","уверовали",34,4],["وَعَمِلُواْ","и совершали",34,4],["ٱلصَّٰلِحَٰتِۚ","праведные дела",34,4],["أُوْلَٰٓئِكَ","те",34,4],["لَهُم","им",34,4],["مَّغۡفِرَةٞ","прощение",34,4],["وَرِزۡقٞ","и удел",34,4]],[["كَرِيمٞ","щедрый",34,4],[4],["وَٱلَّذِينَ","А те, которые",34,5],["سَعَوۡ","старались",34,5],["فِيٓ","против",34,5],["ءَايَٰتِنَا","Наших знамений",34,5],["مُعَٰجِزِينَ","стремясь ослабить",34,5],["أُوْلَٰٓئِكَ","те",34,5]],[["لَهُمۡ","им",34,5],["عَذَابٞ","наказание",34,5],["مِّن","из",34,5],["رِّجۡزٍ","кары",34,5],["أَلِيمٞ","мучительной",34,5],[5],["وَيَرَى","И видят",34,6],["ٱلَّذِينَ","те, которым",34,6],["أُوتُواْ","дано",34,6],["ٱلۡعِلۡمَ","знание",34,6]],[["ٱلَّذِيٓ","что то, что",34,6],["أُنزِلَ","ниспослано",34,6],["إِلَيۡكَ","тебе",34,6],["مِن","от",34,6],["رَّبِّكَ","твоего Господа",34,6],["هُوَ","оно",34,6],["ٱلۡحَقَّ","истина",34,6],["وَيَهۡدِيٓ","и ведёт",34,6],["إِلَىٰ","к",34,6],["صِرَٰطِ","пути",34,6]],[["ٱلۡعَزِيزِ","Могущественного",34,6],["ٱلۡحَمِيدِ","Достохвального",34,6],[6],["وَقَالَ","И сказали",34,7],["ٱلَّذِينَ","те, которые",34,7],["كَفَرُواْ","не уверовали",34,7],["هَلۡ","ли",34,7],["نَدُلُّكُمۡ","укажем вам",34,7],["عَلَىٰ","на",34,7],["رَجُلٖ","мужа",34,7]],[["يُنَبِّئُكُمۡ","который возвещает вам",34,7],["إِذَا","когда",34,7],["مُزِّقۡتُمۡ","вы будете растерзаны",34,7],["كُلَّ","всяким",34,7],["مُمَزَّقٍ","растерзанием",34,7],["إِنَّكُمۡ","поистине, вы",34,7],["لَفِي","непременно в",34,7],["خَلۡقٖ","творении",34,7],["جَدِيدٍ","новом",34,7],[7]]]}