{"p":429,"j":22,"a":[[34,8,["أَفۡتَرَىٰ","عَلَى","ٱللَّهِ","كَذِبًا","أَم","بِهِۦ","جِنَّةُۢۗ","بَلِ","ٱلَّذِينَ","لَا","يُؤۡمِنُونَ","بِٱلۡأٓخِرَةِ","فِي","ٱلۡعَذَابِ","وَٱلضَّلَٰلِ","ٱلۡبَعِيدِ"],"афтара `алаллахи казибан ам бихии жиннату балил лазиина ла йу'минууна бил'ахирати фил `азаби ваддалалил ба`иид","Измыслил ли он ложь об Аллахе, или же он является бесноватым?». О нет! Те, которые не веруют в Последнюю жизнь, будут подвергнуты мучениям и пребывают в глубоком заблуждении.",["Измыслил ли он","на","Аллаха","ложь","или","в нём","безумие","Нет же","те, которые","не","веруют","в Последнюю жизнь","в","наказании","и заблуждении","далёком"]],[34,9,["أَفَلَمۡ","يَرَوۡاْ","إِلَىٰ","مَا","بَيۡنَ","أَيۡدِيهِمۡ","وَمَا","خَلۡفَهُم","مِّنَ","ٱلسَّمَآءِ","وَٱلۡأَرۡضِۚ","إِن","نَّشَأۡ","نَخۡسِفۡ","بِهِمُ","ٱلۡأَرۡضَ","أَوۡ","نُسۡقِطۡ","عَلَيۡهِمۡ","كِسَفٗا","مِّنَ","ٱلسَّمَآءِۚ","إِنَّ","فِي","ذَٰلِكَ","لَأٓيَةٗ","لِّكُلِّ","عَبۡدٖ","مُّنِيبٖ"],"афалам йарау ила ма байна айдиихим вама халфахум минас самаи вал'арди ин наша' нахсиф бихимул арда ау нусḳит `алайхим кисафам минас самаи инна фии залика ла'айатал ликулли `абдим мунииб","Неужели они не видят того, что перед ними и что позади них на небе и на земле? Если Мы пожелаем, то заставим землю поглотить их или же низринем на них кусок неба. Воистину, в этом - знамение для каждого раскаивающегося раба.",["Разве же не","видели они","на","то, что","перед","ними","и то, что","позади них","из","неба","и земли","Если","Мы пожелаем","Мы заставим поглотить","их","землю","или","Мы обрушим","на них","куски","из","неба","Поистине","в","этом","непременно знамение","для каждого","раба","обращающегося (к Аллаху)"]],[34,10,["وَلَقَدۡ","ءَاتَيۡنَا","دَاوُۥدَ","مِنَّا","فَضۡلٗاۖ","يَٰجِبَالُ","أَوِّبِي","مَعَهُۥ","وَٱلطَّيۡرَۖ","وَأَلَنَّا","لَهُ","ٱلۡحَدِيدَ"],"валаḳад атайна давууда минна фадлан йажибалу аввибии ма`ахуу ваттайра ва'аланна лахул хадиид","Мы одарили Давуда (Давида) милостью от Нас и сказали: «О горы и птицы! Славьте вместе с ним!». Мы сделали железо мягким для него.",["И уже","Мы даровали","Давуду","от Нас","милость","О горы","вторьте хвале","с ним","и птицы","и Мы смягчили","ему","железо"]],[34,11,["أَنِ","ٱعۡمَلۡ","سَٰبِغَٰتٖ","وَقَدِّرۡ","فِي","ٱلسَّرۡدِۖ","وَٱعۡمَلُواْ","صَٰلِحًاۖ","إِنِّي","بِمَا","تَعۡمَلُونَ","بَصِيرٞ"],"ани`мал сабигатин ваḳаддир фис сарди ва`малуу салихан иннии бима та`малууна басиир","Выкуй длинные кольчуги и соблюдай меру в кольцах. Поступайте праведно, ведь Я вижу то, что вы совершаете.",["(велев:)","Делай","кольчуги","и соразмеряй","в","плетении колец","и совершайте","праведное","поистине, Я","то, что","вы совершаете","Видящий"]],[34,12,["وَلِسُلَيۡمَٰنَ","ٱلرِّيحَ","غُدُوُّهَا","شَهۡرٞ","وَرَوَاحُهَا","شَهۡرٞۖ","وَأَسَلۡنَا","لَهُۥ","عَيۡنَ","ٱلۡقِطۡرِۖ","وَمِنَ","ٱلۡجِنِّ","مَن","يَعۡمَلُ","بَيۡنَ","يَدَيۡهِ","بِإِذۡنِ","رَبِّهِۦۖ","وَمَن","يَزِغۡ","مِنۡهُمۡ","عَنۡ","أَمۡرِنَا","نُذِقۡهُ","مِنۡ","عَذَابِ","ٱلسَّعِيرِ"],"валисулайманар рииха гудуввуха шахрун варавахуха шахрун ва'асална лахуу `айнал ḳитри ваминал жинни ман йа`малу байна йадайхи би'изни раббихии ваман йазиг минхум `ан амрина нузиḳху мин `азабис са`иир","Мы подчинили Сулейману (Соломону) ветер, который утром пролетал месячный путь и после полудня пролетал месячный путь. Мы заставили для него течь источник меди. Среди джиннов были такие, которые работали перед ним с дозволения его Господа. А того из них, кто уклонился от Нашего повеления, Мы заставили вкусить мучения в Пламени.",["И Сулейману (подчинили)","ветер","его утренний путь","месяц","и его вечерний путь","месяц","и Мы заставили течь","для него","источник","меди","И из","джиннов","(были) те, кто","трудился","перед","ним","с дозволения","его Господа","А кто","уклонится","из них","от","Нашего повеления","Мы дадим вкусить ему","из","наказания","Пламени"]],[34,13,["يَعۡمَلُونَ","لَهُۥ","مَا","يَشَآءُ","مِن","مَّحَٰرِيبَ","وَتَمَٰثِيلَ","وَجِفَانٖ","كَٱلۡجَوَابِ","وَقُدُورٖ","رَّاسِيَٰتٍۚ","ٱعۡمَلُوٓاْ","ءَالَ","دَاوُۥدَ","شُكۡرٗاۚ","وَقَلِيلٞ","مِّنۡ","عِبَادِيَ","ٱلشَّكُورُ"],"йа`малууна лахуу ма йашау мим махарииба ватамасиила важифанин калжаваби ваḳудуурир расийатини`малуу ала давууда шукран ваḳалиилум мин `ибадийаш шакуур","Они создавали прекрасные строения, изваяния, миски, подобные водоемам, и неподвижные котлы. О род Давуда (Давида)! Трудитесь в знак благодарности. Но среди Моих рабов мало благодарных.",["Они делали","для него","то, что","он желал","из","высоких строений","и изваяний","и чаш","подобных водоёмам","и котлов","неподвижных","Трудитесь","о род","Давуда","в благодарность","Но немногие","из","Моих рабов","благодарны"]],[34,14,["فَلَمَّا","قَضَيۡنَا","عَلَيۡهِ","ٱلۡمَوۡتَ","مَا","دَلَّهُمۡ","عَلَىٰ","مَوۡتِهِۦٓ","إِلَّا","دَآبَّةُ","ٱلۡأَرۡضِ","تَأۡكُلُ","مِنسَأَتَهُۥۖ","فَلَمَّا","خَرَّ","تَبَيَّنَتِ","ٱلۡجِنُّ","أَن","لَّوۡ","كَانُواْ","يَعۡلَمُونَ","ٱلۡغَيۡبَ","مَا","لَبِثُواْ","فِي","ٱلۡعَذَابِ","ٱلۡمُهِينِ"],"фаламма ḳадайна `алайхил маута ма даллахум `ала маутихии илла даббатул арди та'кулу минсаатахуу фаламма харра табаййанатил жинну ал лау кануу йа`ламуунал гайба ма лабисуу фил `азабил мухиин","Когда же Мы предписали ему умереть, они узнали об этом лишь благодаря земляному червю, который источил его посох. Когда же он упал, джинны уяснили, что если бы они знали сокровенное, то не оставались бы в унизительных мучениях.",["Когда же","Мы предрешили","ему","смерть","не","указало им","на","его смерть","кроме","тварь","земли","поедающая","его посох","Когда же","он упал","стало ясно","джиннам","что","если бы","они","знали","сокровенное","не","пробыли бы они","в","наказании","унизительном"]]],"m":[[["أَفۡتَرَىٰ","Измыслил ли он",34,8],["عَلَى","на",34,8],["ٱللَّهِ","Аллаха",34,8],["كَذِبًا","ложь",34,8],["أَم","или",34,8],["بِهِۦ","в нём",34,8],["جِنَّةُۢۗ","безумие",34,8],["بَلِ","Нет же",34,8],["ٱلَّذِينَ","те, которые",34,8],["لَا","не",34,8],["يُؤۡمِنُونَ","веруют",34,8],["بِٱلۡأٓخِرَةِ","в Последнюю жизнь",34,8]],[["فِي","в",34,8],["ٱلۡعَذَابِ","наказании",34,8],["وَٱلضَّلَٰلِ","и заблуждении",34,8],["ٱلۡبَعِيدِ","далёком",34,8],[8],["أَفَلَمۡ","Разве же не",34,9],["يَرَوۡاْ","видели они",34,9],["إِلَىٰ","на",34,9],["مَا","то, что",34,9],["بَيۡنَ","перед",34,9],["أَيۡدِيهِمۡ","ними",34,9]],[["وَمَا","и то, что",34,9],["خَلۡفَهُم","позади них",34,9],["مِّنَ","из",34,9],["ٱلسَّمَآءِ","неба",34,9],["وَٱلۡأَرۡضِۚ","и земли",34,9],["إِن","Если",34,9],["نَّشَأۡ","Мы пожелаем",34,9],["نَخۡسِفۡ","Мы заставим поглотить",34,9],["بِهِمُ","их",34,9]],[["ٱلۡأَرۡضَ","землю",34,9],["أَوۡ","или",34,9],["نُسۡقِطۡ","Мы обрушим",34,9],["عَلَيۡهِمۡ","на них",34,9],["كِسَفٗا","куски",34,9],["مِّنَ","из",34,9],["ٱلسَّمَآءِۚ","неба",34,9],["إِنَّ","Поистине",34,9],["فِي","в",34,9],["ذَٰلِكَ","этом",34,9]],[["لَأٓيَةٗ","непременно знамение",34,9],["لِّكُلِّ","для каждого",34,9],["عَبۡدٖ","раба",34,9],["مُّنِيبٖ","обращающегося (к Аллаху)",34,9],[9],["۞ وَلَقَدۡ","И уже",34,10],["ءَاتَيۡنَا","Мы даровали",34,10],["دَاوُۥدَ","Давуду",34,10],["مِنَّا","от Нас",34,10],["فَضۡلٗاۖ","милость",34,10]],[["يَٰجِبَالُ","О горы",34,10],["أَوِّبِي","вторьте хвале",34,10],["مَعَهُۥ","с ним",34,10],["وَٱلطَّيۡرَۖ","и птицы",34,10],["وَأَلَنَّا","и Мы смягчили",34,10],["لَهُ","ему",34,10],["ٱلۡحَدِيدَ","железо",34,10],[10],["أَنِ","(велев:)",34,11],["ٱعۡمَلۡ","Делай",34,11]],[["سَٰبِغَٰتٖ","кольчуги",34,11],["وَقَدِّرۡ","и соразмеряй",34,11],["فِي","в",34,11],["ٱلسَّرۡدِۖ","плетении колец",34,11],["وَٱعۡمَلُواْ","и совершайте",34,11],["صَٰلِحًاۖ","праведное",34,11],["إِنِّي","поистине, Я",34,11],["بِمَا","то, что",34,11],["تَعۡمَلُونَ","вы совершаете",34,11]],[["بَصِيرٞ","Видящий",34,11],[11],["وَلِسُلَيۡمَٰنَ","И Сулейману (подчинили)",34,12],["ٱلرِّيحَ","ветер",34,12],["غُدُوُّهَا","его утренний путь",34,12],["شَهۡرٞ","месяц",34,12],["وَرَوَاحُهَا","и его вечерний путь",34,12],["شَهۡرٞۖ","месяц",34,12]],[["وَأَسَلۡنَا","и Мы заставили течь",34,12],["لَهُۥ","для него",34,12],["عَيۡنَ","источник",34,12],["ٱلۡقِطۡرِۖ","меди",34,12],["وَمِنَ","И из",34,12],["ٱلۡجِنِّ","джиннов",34,12],["مَن","(были) те, кто",34,12],["يَعۡمَلُ","трудился",34,12],["بَيۡنَ","перед",34,12],["يَدَيۡهِ","ним",34,12],["بِإِذۡنِ","с дозволения",34,12]],[["رَبِّهِۦۖ","его Господа",34,12],["وَمَن","А кто",34,12],["يَزِغۡ","уклонится",34,12],["مِنۡهُمۡ","из них",34,12],["عَنۡ","от",34,12],["أَمۡرِنَا","Нашего повеления",34,12],["نُذِقۡهُ","Мы дадим вкусить ему",34,12],["مِنۡ","из",34,12],["عَذَابِ","наказания",34,12],["ٱلسَّعِيرِ","Пламени",34,12],[12]],[["يَعۡمَلُونَ","Они делали",34,13],["لَهُۥ","для него",34,13],["مَا","то, что",34,13],["يَشَآءُ","он желал",34,13],["مِن","из",34,13],["مَّحَٰرِيبَ","высоких строений",34,13],["وَتَمَٰثِيلَ","и изваяний",34,13],["وَجِفَانٖ","и чаш",34,13],["كَٱلۡجَوَابِ","подобных водоёмам",34,13]],[["وَقُدُورٖ","и котлов",34,13],["رَّاسِيَٰتٍۚ","неподвижных",34,13],["ٱعۡمَلُوٓاْ","Трудитесь",34,13],["ءَالَ","о род",34,13],["دَاوُۥدَ","Давуда",34,13],["شُكۡرٗاۚ","в благодарность",34,13],["وَقَلِيلٞ","Но немногие",34,13],["مِّنۡ","из",34,13],["عِبَادِيَ","Моих рабов",34,13]],[["ٱلشَّكُورُ","благодарны",34,13],[13],["فَلَمَّا","Когда же",34,14],["قَضَيۡنَا","Мы предрешили",34,14],["عَلَيۡهِ","ему",34,14],["ٱلۡمَوۡتَ","смерть",34,14],["مَا","не",34,14],["دَلَّهُمۡ","указало им",34,14],["عَلَىٰ","на",34,14],["مَوۡتِهِۦٓ","его смерть",34,14]],[["إِلَّا","кроме",34,14],["دَآبَّةُ","тварь",34,14],["ٱلۡأَرۡضِ","земли",34,14],["تَأۡكُلُ","поедающая",34,14],["مِنسَأَتَهُۥۖ","его посох",34,14],["فَلَمَّا","Когда же",34,14],["خَرَّ","он упал",34,14],["تَبَيَّنَتِ","стало ясно",34,14],["ٱلۡجِنُّ","джиннам",34,14]],[["أَن","что",34,14],["لَّوۡ","если бы",34,14],["كَانُواْ","они",34,14],["يَعۡلَمُونَ","знали",34,14],["ٱلۡغَيۡبَ","сокровенное",34,14],["مَا","не",34,14],["لَبِثُواْ","пробыли бы они",34,14],["فِي","в",34,14],["ٱلۡعَذَابِ","наказании",34,14],["ٱلۡمُهِينِ","унизительном",34,14],[14]]]}