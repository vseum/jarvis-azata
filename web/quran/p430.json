{"p":430,"j":22,"a":[[34,15,["لَقَدۡ","كَانَ","لِسَبَإٖ","فِي","مَسۡكَنِهِمۡ","ءَايَةٞۖ","جَنَّتَانِ","عَن","يَمِينٖ","وَشِمَالٖۖ","كُلُواْ","مِن","رِّزۡقِ","رَبِّكُمۡ","وَٱشۡكُرُواْ","لَهُۥۚ","بَلۡدَةٞ","طَيِّبَةٞ","وَرَبٌّ","غَفُورٞ"],"лаḳад кана лисабаин фии масканихим айатун жаннатани `ан йамиинин вашималин кулуу мир ризḳи раббикум вашкуруу лахуу балдатун таййибатун вараббун гафуур","В поселении сабейцев было знамение - два сада справа и слева. Вкушайте из удела вашего Господа и благодарите Его. Прекрасная страна и Прощающий Господь!",["Уже","было","у Сабы","в","их жилище","знамение","два сада","с","правой стороны","и слева","Ешьте","из","удела","вашего Господа","и благодарите","Его","Страна","благая","и Господь","Прощающий"]],[34,16,["فَأَعۡرَضُواْ","فَأَرۡسَلۡنَا","عَلَيۡهِمۡ","سَيۡلَ","ٱلۡعَرِمِ","وَبَدَّلۡنَٰهُم","بِجَنَّتَيۡهِمۡ","جَنَّتَيۡنِ","ذَوَاتَيۡ","أُكُلٍ","خَمۡطٖ","وَأَثۡلٖ","وَشَيۡءٖ","مِّن","سِدۡرٖ","قَلِيلٖ"],"фа'а`радуу фа'арсална `алайхим сайлал `арими вабаддалнахум бижаннатайхим жаннатайни заватай укулин хамтин ва'аслин вашай'им мин сидрин ḳалиил","Но они отвернулись, и Мы наслали на них поток, прорвавший плотину, и заменили их два сада двумя садами с горькими плодами, тамариском и несколькими лотосами.",["Но они отвернулись","и Мы наслали","на них","поток","плотины","и Мы заменили им","их два сада","двумя садами","обладающими","плодами","горькими","и тамариском","и чем-то","из","лотоса","немногим"]],[34,17,["ذَٰلِكَ","جَزَيۡنَٰهُم","بِمَا","كَفَرُواْۖ","وَهَلۡ","نُجَٰزِيٓ","إِلَّا","ٱلۡكَفُورَ"],"залика жазайнахум бима кафаруу вахал нужазии иллал кафуур","Так Мы воздали им за то, что они не уверовали. Разве Мы караем так кого-либо, кроме неблагодарных?",["Так","Мы воздали им","за то, что","они были неблагодарны","И разве","Мы воздаём (так)","кроме как","неблагодарному"]],[34,18,["وَجَعَلۡنَا","بَيۡنَهُمۡ","وَبَيۡنَ","ٱلۡقُرَى","ٱلَّتِي","بَٰرَكۡنَا","فِيهَا","قُرٗى","ظَٰهِرَةٗ","وَقَدَّرۡنَا","فِيهَا","ٱلسَّيۡرَۖ","سِيرُواْ","فِيهَا","لَيَالِيَ","وَأَيَّامًا","ءَامِنِينَ"],"важа`ална байнахум вабайнал ḳурал латии баракна фииха ḳуран захиратан ваḳаддарна фиихас сайра сиируу фииха лайалийа ва'аййаман аминиин","Между ними и городами, которые Мы благословили, Мы воздвигли ясно различимые города и размерили путь между ними. Разъезжайте между ними ночью и днем в безопасности!",["И Мы сделали","между ними","и между","селениями","которые","Мы благословили","в них","селения","видимые","и Мы размерили","в них","путь","Ездите","по ним","ночами","и днями","в безопасности"]],[34,19,["فَقَالُواْ","رَبَّنَا","بَٰعِدۡ","بَيۡنَ","أَسۡفَارِنَا","وَظَلَمُوٓاْ","أَنفُسَهُمۡ","فَجَعَلۡنَٰهُمۡ","أَحَادِيثَ","وَمَزَّقۡنَٰهُمۡ","كُلَّ","مُمَزَّقٍۚ","إِنَّ","فِي","ذَٰلِكَ","لَأٓيَٰتٖ","لِّكُلِّ","صَبَّارٖ","شَكُورٖ"],"фаḳалуу раббана ба`ид байна асфарина вазаламуу анфусахум фажа`алнахум ахадииса вамаззаḳнахум кулла мумаззаḳин инна фии залика ла'айатил ликулли саббарин шакуур","Они сказали: «Господь наш! Удлини расстояния между нашими остановками в пути». Они поступили несправедливо по отношению к себе. Мы сделали их предметом сказаний и рассеяли их. Воистину, в этом - знамение для каждого, кто терпелив и благодарен.",["Но они сказали","Господь наш","удали (расстояния)","между","нашими поездками","И они обидели","самих себя","и Мы сделали их","сказаниями","и Мы рассеяли их","всяческим","рассеянием","Поистине","в","этом","непременно знамения","для каждого","терпеливого","благодарного"]],[34,20,["وَلَقَدۡ","صَدَّقَ","عَلَيۡهِمۡ","إِبۡلِيسُ","ظَنَّهُۥ","فَٱتَّبَعُوهُ","إِلَّا","فَرِيقٗا","مِّنَ","ٱلۡمُؤۡمِنِينَ"],"валаḳад саддаḳа `алайхим иблиису заннахуу фаттаба`ууху илла фарииḳам минал му'миниин","Предположение Иблиса относительно них оказалось правдивым, и они последовали за ним, за исключением группы верующих.",["И уже","подтвердил","о них","Иблис","своё предположение","и они последовали за ним","кроме","группы","из","верующих"]],[34,21,["وَمَا","كَانَ","لَهُۥ","عَلَيۡهِم","مِّن","سُلۡطَٰنٍ","إِلَّا","لِنَعۡلَمَ","مَن","يُؤۡمِنُ","بِٱلۡأٓخِرَةِ","مِمَّنۡ","هُوَ","مِنۡهَا","فِي","شَكّٖۗ","وَرَبُّكَ","عَلَىٰ","كُلِّ","شَيۡءٍ","حَفِيظٞ"],"вама кана лахуу `алайхим мин султанин илла лина`лама ман йу'мину бил'ахирати мимман хуа минха фии шаккин вараббука `ала кулли шай'ин хафииз","У него не было над ними никакой власти (или не было для них никакого доказательства). Но он искушал людей, чтобы Мы узнали и отличили того, кто верует в Последнюю жизнь, от того, кто сомневается в ней. Господь твой - Хранитель всякой вещи.",["И не","было","у него","над ними","никакой","власти","кроме как","чтобы Мы узнали","кто","верует","в Последнюю жизнь","от того, кто","он","о ней","в","сомнении","И твой Господь","над","всякой","вещью","Хранитель"]],[34,22,["قُلِ","ٱدۡعُواْ","ٱلَّذِينَ","زَعَمۡتُم","مِّن","دُونِ","ٱللَّهِ","لَا","يَمۡلِكُونَ","مِثۡقَالَ","ذَرَّةٖ","فِي","ٱلسَّمَٰوَٰتِ","وَلَا","فِي","ٱلۡأَرۡضِ","وَمَا","لَهُمۡ","فِيهِمَا","مِن","شِرۡكٖ","وَمَا","لَهُۥ","مِنۡهُم","مِّن","ظَهِيرٖ"],"ḳулид`ул лазиина за`амтум мин дууниллахи ла йамликууна мисḳала зарратин фис самавати вала фил арди вама лахум фиихима мин ширкин вама лахуу минхум мин захиир","Скажи: «Призовите тех, кого вы считали богами наряду с Аллахом». Они не владеют даже мельчайшей частицей на небесах и на земле и не являются совладельцами чего-либо на них, и нет у Него среди них помощников.",["Скажи","Призовите","тех, которых","вы возомнили (богами)","из","помимо","Аллаха","Не","владеют они","весом","пылинки","на","небесах","и не","на","земле","и нет","у них","в них обоих","никакого","соучастия","и нет","у Него","из них","никакого","помощника"]]],"m":[[["لَقَدۡ","Уже",34,15],["كَانَ","было",34,15],["لِسَبَإٖ","у Сабы",34,15],["فِي","в",34,15],["مَسۡكَنِهِمۡ","их жилище",34,15],["ءَايَةٞۖ","знамение",34,15],["جَنَّتَانِ","два сада",34,15],["عَن","с",34,15],["يَمِينٖ","правой стороны",34,15],["وَشِمَالٖۖ","и слева",34,15]],[["كُلُواْ","Ешьте",34,15],["مِن","из",34,15],["رِّزۡقِ","удела",34,15],["رَبِّكُمۡ","вашего Господа",34,15],["وَٱشۡكُرُواْ","и благодарите",34,15],["لَهُۥۚ","Его",34,15],["بَلۡدَةٞ","Страна",34,15],["طَيِّبَةٞ","благая",34,15],["وَرَبٌّ","и Господь",34,15],["غَفُورٞ","Прощающий",34,15]],[[15],["فَأَعۡرَضُواْ","Но они отвернулись",34,16],["فَأَرۡسَلۡنَا","и Мы наслали",34,16],["عَلَيۡهِمۡ","на них",34,16],["سَيۡلَ","поток",34,16],["ٱلۡعَرِمِ","плотины",34,16],["وَبَدَّلۡنَٰهُم","и Мы заменили им",34,16],["بِجَنَّتَيۡهِمۡ","их два сада",34,16]],[["جَنَّتَيۡنِ","двумя садами",34,16],["ذَوَاتَيۡ","обладающими",34,16],["أُكُلٍ","плодами",34,16],["خَمۡطٖ","горькими",34,16],["وَأَثۡلٖ","и тамариском",34,16],["وَشَيۡءٖ","и чем-то",34,16],["مِّن","из",34,16],["سِدۡرٖ","лотоса",34,16],["قَلِيلٖ","немногим",34,16]],[[16],["ذَٰلِكَ","Так",34,17],["جَزَيۡنَٰهُم","Мы воздали им",34,17],["بِمَا","за то, что",34,17],["كَفَرُواْۖ","они были неблагодарны",34,17],["وَهَلۡ","И разве",34,17],["نُجَٰزِيٓ","Мы воздаём (так)",34,17],["إِلَّا","кроме как",34,17],["ٱلۡكَفُورَ","неблагодарному",34,17],[17]],[["وَجَعَلۡنَا","И Мы сделали",34,18],["بَيۡنَهُمۡ","между ними",34,18],["وَبَيۡنَ","и между",34,18],["ٱلۡقُرَى","селениями",34,18],["ٱلَّتِي","которые",34,18],["بَٰرَكۡنَا","Мы благословили",34,18],["فِيهَا","в них",34,18],["قُرٗى","селения",34,18],["ظَٰهِرَةٗ","видимые",34,18]],[["وَقَدَّرۡنَا","и Мы размерили",34,18],["فِيهَا","в них",34,18],["ٱلسَّيۡرَۖ","путь",34,18],["سِيرُواْ","Ездите",34,18],["فِيهَا","по ним",34,18],["لَيَالِيَ","ночами",34,18],["وَأَيَّامًا","и днями",34,18],["ءَامِنِينَ","в безопасности",34,18],[18]],[["فَقَالُواْ","Но они сказали",34,19],["رَبَّنَا","Господь наш",34,19],["بَٰعِدۡ","удали (расстояния)",34,19],["بَيۡنَ","между",34,19],["أَسۡفَارِنَا","нашими поездками",34,19],["وَظَلَمُوٓاْ","И они обидели",34,19],["أَنفُسَهُمۡ","самих себя",34,19],["فَجَعَلۡنَٰهُمۡ","и Мы сделали их",34,19]],[["أَحَادِيثَ","сказаниями",34,19],["وَمَزَّقۡنَٰهُمۡ","и Мы рассеяли их",34,19],["كُلَّ","всяческим",34,19],["مُمَزَّقٍۚ","рассеянием",34,19],["إِنَّ","Поистине",34,19],["فِي","в",34,19],["ذَٰلِكَ","этом",34,19],["لَأٓيَٰتٖ","непременно знамения",34,19],["لِّكُلِّ","для каждого",34,19],["صَبَّارٖ","терпеливого",34,19]],[["شَكُورٖ","благодарного",34,19],[19],["وَلَقَدۡ","И уже",34,20],["صَدَّقَ","подтвердил",34,20],["عَلَيۡهِمۡ","о них",34,20],["إِبۡلِيسُ","Иблис",34,20],["ظَنَّهُۥ","своё предположение",34,20],["فَٱتَّبَعُوهُ","и они последовали за ним",34,20],["إِلَّا","кроме",34,20]],[["فَرِيقٗا","группы",34,20],["مِّنَ","из",34,20],["ٱلۡمُؤۡمِنِينَ","верующих",34,20],[20],["وَمَا","И не",34,21],["كَانَ","было",34,21],["لَهُۥ","у него",34,21],["عَلَيۡهِم","над ними",34,21],["مِّن","никакой",34,21],["سُلۡطَٰنٍ","власти",34,21]],[["إِلَّا","кроме как",34,21],["لِنَعۡلَمَ","чтобы Мы узнали",34,21],["مَن","кто",34,21],["يُؤۡمِنُ","верует",34,21],["بِٱلۡأٓخِرَةِ","в Последнюю жизнь",34,21],["مِمَّنۡ","от того, кто",34,21],["هُوَ","он",34,21],["مِنۡهَا","о ней",34,21],["فِي","в",34,21],["شَكّٖۗ","сомнении",34,21],["وَرَبُّكَ","И твой Господь",34,21]],[["عَلَىٰ","над",34,21],["كُلِّ","всякой",34,21],["شَيۡءٍ","вещью",34,21],["حَفِيظٞ","Хранитель",34,21],[21],["قُلِ","Скажи",34,22],["ٱدۡعُواْ","Призовите",34,22],["ٱلَّذِينَ","тех, которых",34,22],["زَعَمۡتُم","вы возомнили (богами)",34,22],["مِّن","из",34,22],["دُونِ","помимо",34,22]],[["ٱللَّهِ","Аллаха",34,22],["لَا","Не",34,22],["يَمۡلِكُونَ","владеют они",34,22],["مِثۡقَالَ","весом",34,22],["ذَرَّةٖ","пылинки",34,22],["فِي","на",34,22],["ٱلسَّمَٰوَٰتِ","небесах",34,22],["وَلَا","и не",34,22],["فِي","на",34,22]],[["ٱلۡأَرۡضِ","земле",34,22],["وَمَا","и нет",34,22],["لَهُمۡ","у них",34,22],["فِيهِمَا","в них обоих",34,22],["مِن","никакого",34,22],["شِرۡكٖ","соучастия",34,22],["وَمَا","и нет",34,22],["لَهُۥ","у Него",34,22],["مِنۡهُم","из них",34,22],["مِّن","никакого",34,22],["ظَهِيرٖ","помощника",34,22],[22]]]}