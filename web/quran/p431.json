{"p":431,"j":22,"a":[[34,23,["وَلَا","تَنفَعُ","ٱلشَّفَٰعَةُ","عِندَهُۥٓ","إِلَّا","لِمَنۡ","أَذِنَ","لَهُۥۚ","حَتَّىٰٓ","إِذَا","فُزِّعَ","عَن","قُلُوبِهِمۡ","قَالُواْ","مَاذَا","قَالَ","رَبُّكُمۡۖ","قَالُواْ","ٱلۡحَقَّۖ","وَهُوَ","ٱلۡعَلِيُّ","ٱلۡكَبِيرُ"],"вала танфа`уш шафа`ату `индахуу илла лиман азина лахуу хатта иза фуззи`а `ан ḳулуубихим ḳалуу маза ḳала раббукум ḳалул хаḳḳа вахуал `алиййул кабиир","Ничье заступничество перед Ним не принесет пользы, кроме тех, кому будет дозволено. Когда же испуг покинет их (многобожников или ангелов) сердца, они скажут: «Что сказал ваш Господь?». Они скажут: «Истину, ведь Он - Возвышенный, Великий».",["И не","принесёт пользы","заступничество","у Него","кроме как","тому, кому","Он позволил","ему","Пока","когда","удалён испуг","с","их сердец","они скажут","Что","сказал","ваш Господь","Они скажут","Истину","и Он","Возвышенный","Великий"]],[34,24,["قُلۡ","مَن","يَرۡزُقُكُم","مِّنَ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِۖ","قُلِ","ٱللَّهُۖ","وَإِنَّآ","أَوۡ","إِيَّاكُمۡ","لَعَلَىٰ","هُدًى","أَوۡ","فِي","ضَلَٰلٖ","مُّبِينٖ"],"ḳул ман йарзуḳукум минас самавати вал'арди ḳулиллаху ва'инна ау иййакум ла`ала худан ау фии далалим мубиин","Скажи: «Кто наделяет вас уделом с небес и земли?». Скажи: «Аллах! Воистину, одни из нас либо на прямом пути, либо в очевидном заблуждении».",["Скажи","Кто","наделяет вас","с","небес","и земли","Скажи","Аллах","И поистине, мы","или","вы","непременно на","прямом пути","или","в","заблуждении","ясном"]],[34,25,["قُل","لَّا","تُسۡـَٔلُونَ","عَمَّآ","أَجۡرَمۡنَا","وَلَا","نُسۡـَٔلُ","عَمَّا","تَعۡمَلُونَ"],"ḳул ла тус'алууна `амма ажрамна вала нус'алу `амма та`малуун","Скажи: «Вас не спросят о грехах, которые мы совершили, а нас не спросят о том, что совершаете вы».",["Скажи","не","будете спрошены вы","о том, что","мы согрешили","и не","будем спрошены мы","о том, что","вы делаете"]],[34,26,["قُلۡ","يَجۡمَعُ","بَيۡنَنَا","رَبُّنَا","ثُمَّ","يَفۡتَحُ","بَيۡنَنَا","بِٱلۡحَقِّ","وَهُوَ","ٱلۡفَتَّاحُ","ٱلۡعَلِيمُ"],"ḳул йажма`у байнана раббуна сумма йафтаху байнана билхаḳḳи вахуал фаттахул `алиим","Скажи: «Наш Господь соберет всех нас, а потом рассудит между нами по справедливости, ибо Он - Раскрывающий (или Справедливый Судья), Знающий».",["Скажи","соберёт","нас вместе","наш Господь","затем","Он рассудит","между нами","по истине","и Он","Судья","Знающий"]],[34,27,["قُلۡ","أَرُونِيَ","ٱلَّذِينَ","أَلۡحَقۡتُم","بِهِۦ","شُرَكَآءَۖ","كـَلَّاۚ","بَلۡ","هُوَ","ٱللَّهُ","ٱلۡعَزِيزُ","ٱلۡحَكِيمُ"],"ḳул аруунийал лазиина алхаḳтум бихии шуракаа калла бал хуаллахул `азиизул хакиим","Скажи: «Покажите мне тех, кого вы приобщаете к Нему в сотоварищи. О нет! Он - Аллах, Могущественный, Мудрый».",["Скажи","Покажите мне","тех, которых","вы присоединили","к Нему","сотоварищами","Отнюдь","Нет же","Он","Аллах","Могущественный","Мудрый"]],[34,28,["وَمَآ","أَرۡسَلۡنَٰكَ","إِلَّا","كَآفَّةٗ","لِّلنَّاسِ","بَشِيرٗا","وَنَذِيرٗا","وَلَٰكِنَّ","أَكۡثَرَ","ٱلنَّاسِ","لَا","يَعۡلَمُونَ"],"вама арсалнака илла каффатал линнаси башииран ваназииран валакинна аксаран наси ла йа`ламуун","Мы отправили тебя ко всем людям добрым вестником и предостерегающим увещевателем, но большинство людей не знает этого.",["И не","Мы отправили тебя","кроме как","ко всем","людям","вестником","и увещевателем","но","большинство","людей","не","знают"]],[34,29,["وَيَقُولُونَ","مَتَىٰ","هَٰذَا","ٱلۡوَعۡدُ","إِن","كُنتُمۡ","صَٰدِقِينَ"],"вайаḳуулууна мата хазал ва`ду ин кунтум садиḳиин","Они сказали: «Когда же сбудется это обещание, если вы говорите правду?».",["И они говорят","Когда","это","обещание","если","вы","правдивы"]],[34,30,["قُل","لَّكُم","مِّيعَادُ","يَوۡمٖ","لَّا","تَسۡتَـٔۡخِرُونَ","عَنۡهُ","سَاعَةٗ","وَلَا","تَسۡتَقۡدِمُونَ"],"ḳул лакум мии`аду йаумил ла таста'хирууна `анху са`атан вала тастаḳдимуун","Скажи: «Вам обещан день, который вы не сможете отдалить или приблизить даже на час».",["Скажи","Вам","срок","дня","не","отсрочите","его","на час","и не","ускорите"]],[34,31,["وَقَالَ","ٱلَّذِينَ","كَفَرُواْ","لَن","نُّؤۡمِنَ","بِهَٰذَا","ٱلۡقُرۡءَانِ","وَلَا","بِٱلَّذِي","بَيۡنَ","يَدَيۡهِۗ","وَلَوۡ","تَرَىٰٓ","إِذِ","ٱلظَّٰلِمُونَ","مَوۡقُوفُونَ","عِندَ","رَبِّهِمۡ","يَرۡجِعُ","بَعۡضُهُمۡ","إِلَىٰ","بَعۡضٍ","ٱلۡقَوۡلَ","يَقُولُ","ٱلَّذِينَ","ٱسۡتُضۡعِفُواْ","لِلَّذِينَ","ٱسۡتَكۡبَرُواْ","لَوۡلَآ","أَنتُمۡ","لَكُنَّا","مُؤۡمِنِينَ"],"ваḳалал лазиина кафаруу лан ну'мина бихазал ḳур'ани вала биллазии байна йадайхи валау тара изиз залимууна мауḳууфууна `инда раббихим йаржи`у ба`духум ила ба`динил ḳаула йаḳуулул лазиинастуд`ифуу лиллазиинастакбаруу лаула антум лакунна му'миниин","Неверующие сказали: «Мы никогда не уверуем ни в этот Коран, ни в то, что было до него». Если бы ты видел беззаконников, когда они будут стоять перед их Господом, отвечая друг другу словами. Те, которые были слабыми, скажут тем, которые превозносились: «Если бы не вы, то мы стали бы верующими».",["И сказали","те, которые","не уверовали","Никогда не","уверуем мы","в этот","Коран","и не","в то, что","перед","ним","А если бы","ты видел","когда","беззаконники","поставлены","перед","их Господом","возвращают","одни из них","к","другим","слово","Скажут","те, которые","были ослаблены","тем, которые","превозносились","Если бы не","вы","непременно были бы мы","верующими"]]],"m":[[["وَلَا","И не",34,23],["تَنفَعُ","принесёт пользы",34,23],["ٱلشَّفَٰعَةُ","заступничество",34,23],["عِندَهُۥٓ","у Него",34,23],["إِلَّا","кроме как",34,23],["لِمَنۡ","тому, кому",34,23],["أَذِنَ","Он позволил",34,23],["لَهُۥۚ","ему",34,23],["حَتَّىٰٓ","Пока",34,23],["إِذَا","когда",34,23],["فُزِّعَ","удалён испуг",34,23],["عَن","с",34,23]],[["قُلُوبِهِمۡ","их сердец",34,23],["قَالُواْ","они скажут",34,23],["مَاذَا","Что",34,23],["قَالَ","сказал",34,23],["رَبُّكُمۡۖ","ваш Господь",34,23],["قَالُواْ","Они скажут",34,23],["ٱلۡحَقَّۖ","Истину",34,23],["وَهُوَ","и Он",34,23],["ٱلۡعَلِيُّ","Возвышенный",34,23],["ٱلۡكَبِيرُ","Великий",34,23]],[[23],["۞ قُلۡ","Скажи",34,24],["مَن","Кто",34,24],["يَرۡزُقُكُم","наделяет вас",34,24],["مِّنَ","с",34,24],["ٱل