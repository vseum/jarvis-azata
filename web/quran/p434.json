{"p":434,"j":22,"a":[[34,49,["قُلۡ","جَآءَ","ٱلۡحَقُّ","وَمَا","يُبۡدِئُ","ٱلۡبَٰطِلُ","وَمَا","يُعِيدُ"],"ḳул жаал хаḳḳу вама йубдиул батилу вама йу`иид","Скажи: «Явилась истина, и ложь ничего больше не породит и не вернется».",["Скажи","Пришла","истина","и не","начинает","ложь","и не","повторяет"]],[34,50,["قُلۡ","إِن","ضَلَلۡتُ","فَإِنَّمَآ","أَضِلُّ","عَلَىٰ","نَفۡسِيۖ","وَإِنِ","ٱهۡتَدَيۡتُ","فَبِمَا","يُوحِيٓ","إِلَيَّ","رَبِّيٓۚ","إِنَّهُۥ","سَمِيعٞ","قَرِيبٞ"],"ḳул ин далалту фа'иннама адиллу `ала нафсии ва'инихтадайту фабима йуухии илаййа раббии иннахуу самии`ун ḳарииб","Скажи: «Если я заблуждаюсь, то заблуждаюсь только во вред себе. Если же я следую прямым путем, то только благодаря тому, что внушил мне мой Господь. Воистину, Он - Слышащий, Близкий».",["Скажи","Если","заблудился я","то лишь","заблуждаюсь я","во вред","себе","а если","пошёл я прямым путём","то благодаря тому, что","внушает","мне","Господь мой","Поистине, Он","Слышащий","Близкий"]],[34,51,["وَلَوۡ","تَرَىٰٓ","إِذۡ","فَزِعُواْ","فَلَا","فَوۡتَ","وَأُخِذُواْ","مِن","مَّكَانٖ","قَرِيبٖ"],"валау тара из фази`уу фала фаута ва'ухизуу мим маканин ḳарииб","Если бы ты видел, как они будут напуганы. Они не смогут сбежать и будут схвачены поблизости.",["И если бы","увидел ты","когда","испугаются они","и нет","спасения","и будут схвачены они","из","места","близкого"]],[34,52,["وَقَالُوٓاْ","ءَامَنَّا","بِهِۦ","وَأَنَّىٰ","لَهُمُ","ٱلتَّنَاوُشُ","مِن","مَّكَانِۭ","بَعِيدٖ"],"ваḳалуу аманна бихии ва'анна лахумут танавушу мим макани ба`иид","Они скажут: «Мы уверовали в это!». Но как им обрести веру или заслужить прощение в таком далеком месте!",["И скажут они","Уверовали мы","в него","Но как","для них","достижение (веры)","из","места","далёкого"]],[34,53,["وَقَدۡ","كَفَرُواْ","بِهِۦ","مِن","قَبۡلُۖ","وَيَقۡذِفُونَ","بِٱلۡغَيۡبِ","مِن","مَّكَانِۭ","بَعِيدٖ"],"ваḳад кафаруу бихии мин ḳаблу вайаḳзифууна билгайби мим макани ба`иид","Они не верили в это прежде и делали предположения из далекого места.",["И уже","не уверовали они","в него","до","этого","и бросали они (догадки)","о сокровенном","из","места","далёкого"]],[34,54,["وَحِيلَ","بَيۡنَهُمۡ","وَبَيۡنَ","مَا","يَشۡتَهُونَ","كَمَا","فُعِلَ","بِأَشۡيَاعِهِم","مِّن","قَبۡلُۚ","إِنَّهُمۡ","كَانُواْ","فِي","شَكّٖ","مُّرِيبِۭ"],"вахиила байнахум вабайна ма йаштахууна кама фу`ила би'ашйа`ихим мин ḳаблу иннахум кануу фии шакким мурииб","Между ними и тем, что они пожелают, будет воздвигнута преграда, что прежде произошло с подобными им. Воистину, они терзались смутными сомнениями.",["И преграждено","между ними","и между","тем, что","желают они","как","было сделано","с подобными им","до","этого","Поистине, они","были","в","сомнении","тревожащем"]],[35,1,["ٱلۡحَمۡدُ","لِلَّهِ","فَاطِرِ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِ","جَاعِلِ","ٱلۡمَلَٰٓئِكَةِ","رُسُلًا","أُوْلِيٓ","أَجۡنِحَةٖ","مَّثۡنَىٰ","وَثُلَٰثَ","وَرُبَٰعَۚ","يَزِيدُ","فِي","ٱلۡخَلۡقِ","مَا","يَشَآءُۚ","إِنَّ","ٱللَّهَ","عَلَىٰ","كُلِّ","شَيۡءٖ","قَدِيرٞ"],"алхамду лиллахи фатирис самавати вал'арди жа`илил малаикати русулан улии ажнихатим масна васуласа варуба`а йазииду фил халḳи ма йашау инналлаха `ала кулли шай'ин ḳадиир","Хвала Аллаху, Творцу небес и земли, Сделавшему посланцами ангелов с двумя, тремя и четырьмя крыльями. Он приумножает в творении, что пожелает. Воистину, Аллах способен на всякую вещь.",["Хвала","Аллаху","Творцу","небес","и земли","Сделавшему","ангелов","посланниками","обладающими","крыльями","по два","и по три","и по четыре","Он увеличивает","в","творении","что","пожелает Он","Поистине","Аллах","над","всякой","вещью","Всемогущ"]],[35,2,["مَّا","يَفۡتَحِ","ٱللَّهُ","لِلنَّاسِ","مِن","رَّحۡمَةٖ","فَلَا","مُمۡسِكَ","لَهَاۖ","وَمَا","يُمۡسِكۡ","فَلَا","مُرۡسِلَ","لَهُۥ","مِنۢ","بَعۡدِهِۦۚ","وَهُوَ","ٱلۡعَزِيزُ","ٱلۡحَكِيمُ"],"мма йафтахиллаху линнаси мир рахматин фала мумсика лаха вама йумсик фала мурсила лахуу мим ба`дихии вахуал `азиизул хакиим","Никто не удержит милость, которую Аллах открывает людям. А то, что Он удерживает, никто не может ниспослать после Него. Он - Могущественный, Мудрый.",["Что","откроет","Аллах","людям","из","милости","то нет","удерживающего","её","а что","удержит Он","то нет","посылающего","её","после","Него","и Он","Могущественный","Мудрый"]],[35,3,["يَٰٓأَيُّهَا","ٱلنَّاسُ","ٱذۡكُرُواْ","نِعۡمَتَ","ٱللَّهِ","عَلَيۡكُمۡۚ","هَلۡ","مِنۡ","خَٰلِقٍ","غَيۡرُ","ٱللَّهِ","يَرۡزُقُكُم","مِّنَ","ٱلسَّمَآءِ","وَٱلۡأَرۡضِۚ","لَآ","إِلَٰهَ","إِلَّا","هُوَۖ","فَأَنَّىٰ","تُؤۡفَكُونَ"],"йа'аййухан насузкуруу ни`маталлахи `алайкум хал мин халиḳин гайруллахи йарзуḳукум минас самаи вал'арди ла илаха илла хуа фа'анна ту'факуун","О люди! Помните о милости Аллаха по отношению к вам. Есть ли наряду с Аллахом другой творец, который давал бы вам пропитание с неба и земли? Нет божества, кроме Него! До чего же вы отвращены от истины!",["О","люди","Помните","милость","Аллаха","к вам","Разве","есть","творец","помимо","Аллаха","наделяет вас уделом","с","неба","и земли","Нет","божества","кроме","Него","Так до чего же","отвращены вы"]]],"m":[[["قُلۡ","Скажи",34,49],["جَآءَ","Пришла",34,49],["ٱلۡحَقُّ","истина",34,49],["وَمَا","и не",34,49],["يُبۡدِئُ","начинает",34,49],["ٱلۡبَٰطِلُ","ложь",34,49],["وَمَا","и не",34,49],["يُعِيدُ","повторяет",34,49],[49],["قُلۡ","Скажи",34,50],["إِن","Если",34,50],["ضَلَلۡتُ","заблудился я",34,50]],[["فَإِنَّمَآ","то лишь",34,50],["أَضِلُّ","заблуждаюсь я",34,50],["عَلَىٰ","во вред",34,50],["نَفۡسِيۖ","себе",34,50],["وَإِنِ","а если",34,50],["ٱهۡتَدَيۡتُ","пошёл я прямым путём",34,50],["فَبِمَا","то благодаря тому, что",34,50],["يُوحِيٓ","внушает",34,50],["إِلَيَّ","мне",34,50],["رَبِّيٓۚ","Господь мой",34,50],["إِنَّهُۥ","Поистине, Он",34,50]],[["سَمِيعٞ","Слышащий",34,50],["قَرِيبٞ","Близкий",34,50],[50],["وَلَوۡ","И если бы",34,51],["تَرَىٰٓ","увидел ты",34,51],["إِذۡ","когда",34,51],["فَزِعُواْ","испугаются они",34,51],["فَلَا","и нет",34,51],["فَوۡتَ","спасения",34,51],["وَأُخِذُواْ","и будут схвачены они",34,51],["مِن","из",34,51]],[["مَّكَانٖ","места",34,51],["قَرِيبٖ","близкого",34,51],[51],["وَقَالُوٓاْ","И скажут они",34,52],["ءَامَنَّا","Уверовали мы",34,52],["بِهِۦ","в него",34,52],["وَأَنَّىٰ","Но как",34,52],["لَهُمُ","для них",34,52],["ٱلتَّنَاوُشُ","достижение (веры)",34,52],["مِن","из",34,52]],[["مَّكَانِۭ","места",34,52],["بَعِيدٖ","далёкого",34,52],[52],["وَقَدۡ","И уже",34,53],["كَفَرُواْ","не уверовали они",34,53],["بِهِۦ","в него",34,53],["مِن","до",34,53],["قَبۡلُۖ","этого",34,53],["وَيَقۡذِفُونَ","и бросали они (догадки)",34,53]],[["بِٱلۡغَيۡبِ","о сокровенном",34,53],["مِن","из",34,53],["مَّكَانِۭ","места",34,53],["بَعِيدٖ","далёкого",34,53],[53],["وَحِيلَ","И преграждено",34,54],["بَيۡنَهُمۡ","между ними",34,54],["وَبَيۡنَ","и между",34,54],["مَا","тем, что",34,54],["يَشۡتَهُونَ","желают они",34,54]],[["كَمَا","как",34,54],["فُعِلَ","было сделано",34,54],["بِأَشۡيَاعِهِم","с подобными им",34,54],["مِّن","до",34,54],["قَبۡلُۚ","этого",34,54],["إِنَّهُمۡ","Поистине, они",34,54],["كَانُواْ","были",34,54],["فِي","в",34,54],["شَكّٖ","сомнении",34,54],["مُّرِيبِۭ","тревожащем",34,54],[54]],["h",35],["b"],[["ٱلۡحَمۡدُ","Хвала",35,1],["لِلَّهِ","Аллаху",35,1],["فَاطِرِ","Творцу",35,1],["ٱلسَّمَٰوَٰتِ","небес",35,1],["وَٱلۡأَرۡضِ","и земли",35,1],["جَاعِلِ","Сделавшему",35,1],["ٱلۡمَلَٰٓئِكَةِ","ангелов",35,1],["رُسُلًا","посланниками",35,1],["أُوْلِيٓ","обладающими",35,1]],[["أَجۡنِحَةٖ","крыльями",35,1],["مَّثۡنَىٰ","по два",35,1],["وَثُلَٰثَ","и по три",35,1],["وَرُبَٰعَۚ","и по четыре",35,1],["يَزِيدُ","Он увеличивает",35,1],["فِي","в",35,1],["ٱلۡخَلۡقِ","творении",35,1],["مَا","что",35,1],["يَشَآءُۚ","пожелает Он",35,1],["إِنَّ","Поистине",35,1],["ٱللَّهَ","Аллах",35,1],["عَلَىٰ","над",35,1],["كُلِّ","всякой",35,1]],[["شَيۡءٖ","вещью",35,1],["قَدِيرٞ","Всемогущ",35,1],[1],["مَّا","Что",35,2],["يَفۡتَحِ","откроет",35,2],["ٱللَّهُ","Аллах",35,2],["لِلنَّاسِ","людям",35,2],["مِن","из",35,2],["رَّحۡمَةٖ","милости",35,2],["فَلَا","то нет",35,2],["مُمۡسِكَ","удерживающего",35,2],["لَهَاۖ","её",35,2]],[["وَمَا","а что",35,2],["يُمۡسِكۡ","удержит Он",35,2],["فَلَا","то нет",35,2],["مُرۡسِلَ","посылающего",35,2],["لَهُۥ","её",35,2],["مِنۢ","после",35,2],["بَعۡدِهِۦۚ","Него",35,2],["وَهُوَ","и Он",35,2],["ٱلۡعَزِيزُ","Могущественный",35,2],["ٱلۡحَكِيمُ","Мудрый",35,2],[2],["يَٰٓأَيُّهَا","О",35,3]],[["ٱلنَّاسُ","люди",35,3],["ٱذۡكُرُواْ","Помните",35,3],["نِعۡمَتَ","милость",35,3],["ٱللَّهِ","Аллаха",35,3],["عَلَيۡكُمۡۚ","к вам",35,3],["هَلۡ","Разве",35,3],["مِنۡ","есть",35,3],["خَٰلِقٍ","творец",35,3],["غَيۡرُ","помимо",35,3],["ٱللَّهِ","Аллаха",35,3],["يَرۡزُقُكُم","наделяет вас уделом",35,3]],[["مِّنَ","с",35,3],["ٱلسَّمَآءِ","неба",35,3],["وَٱلۡأَرۡضِۚ","и земли",35,3],["لَآ","Нет",35,3],["إِلَٰهَ","божества",35,3],["إِلَّا","кроме",35,3],["هُوَۖ","Него",35,3],["فَأَنَّىٰ","Так до чего же",35,3],["تُؤۡفَكُونَ","отвращены вы",35,3],[3]]]}