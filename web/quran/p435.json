{"p":435,"j":22,"a":[[35,4,["وَإِن","يُكَذِّبُوكَ","فَقَدۡ","كُذِّبَتۡ","رُسُلٞ","مِّن","قَبۡلِكَۚ","وَإِلَى","ٱللَّهِ","تُرۡجَعُ","ٱلۡأُمُورُ"],"ва'ин йуказзибуука фаḳад куззибат русулум мин ḳаблика ва'илаллахи туржа`ул умуур","Если они сочтут тебя лжецом, то ведь до тебя посланников также считали лжецами. Но дела возвращаются к Аллаху.",["И если","сочтут они тебя лжецом","то ведь уже","были сочтены лжецами","посланники","до","тебя","И к","Аллаху","возвращаются","дела"]],[35,5,["يَٰٓأَيُّهَا","ٱلنَّاسُ","إِنَّ","وَعۡدَ","ٱللَّهِ","حَقّٞۖ","فَلَا","تَغُرَّنَّكُمُ","ٱلۡحَيَوٰةُ","ٱلدُّنۡيَا","وَلَا","يَغُرَّنَّكُم","بِٱللَّهِ","ٱلۡغَرُورُ"],"йа'аййухан насу инна ва`даллахи хаḳḳун фала тагурраннакумул хайаватуд дунйа вала йагурраннакум биллахил гаруур","О люди! Воистину, обещание Аллаха истинно. Пусть не обольщает вас мирская жизнь, и пусть соблазнитель (дьявол) не обольщает вас относительно Аллаха.",["О","люди","Поистине","обещание","Аллаха","истинно","Так пусть не","обольщает вас","жизнь","мирская","и пусть не","обольщает вас","относительно Аллаха","обольститель"]],[35,6,["إِنَّ","ٱلشَّيۡطَٰنَ","لَكُمۡ","عَدُوّٞ","فَٱتَّخِذُوهُ","عَدُوًّاۚ","إِنَّمَا","يَدۡعُواْ","حِزۡبَهُۥ","لِيَكُونُواْ","مِنۡ","أَصۡحَٰبِ","ٱلسَّعِيرِ"],"иннаш шайтана лакум `адуввун фаттахизууху `адувван иннама йад`уу хизбахуу лийакуунуу мин асхабис са`иир","Воистину, дьявол является вашим врагом, так относитесь же к нему как к врагу. Он зовет свою партию к тому, чтобы они стали обитателями Пламени.",["Поистине","шайтан","для вас","враг","так считайте его","врагом","Лишь","призывает он","партию свою","чтобы были они","из","обитателей","Пламени"]],[35,7,["ٱلَّذِينَ","كَفَرُواْ","لَهُمۡ","عَذَابٞ","شَدِيدٞۖ","وَٱلَّذِينَ","ءَامَنُواْ","وَعَمِلُواْ","ٱلصَّٰلِحَٰتِ","لَهُم","مَّغۡفِرَةٞ","وَأَجۡرٞ","كَبِيرٌ"],"аллазиина кафаруу лахум `азабун шадиидун валлазиина амануу ва`амилус салихати лахум магфиратун ва'ажрун кабиир","Тем, которые не уверовали, уготованы тяжкие мучения. А тем, которые уверовали и совершали праведные деяния, уготованы прощение и великая награда.",["Те, которые","не уверовали","для них","мучение","тяжкое","а те, которые","уверовали","и совершали","праведные деяния","для них","прощение","и награда","великая"]],[35,8,["أَفَمَن","زُيِّنَ","لَهُۥ","سُوٓءُ","عَمَلِهِۦ","فَرَءَاهُ","حَسَنٗاۖ","فَإِنَّ","ٱللَّهَ","يُضِلُّ","مَن","يَشَآءُ","وَيَهۡدِي","مَن","يَشَآءُۖ","فَلَا","تَذۡهَبۡ","نَفۡسُكَ","عَلَيۡهِمۡ","حَسَرَٰتٍۚ","إِنَّ","ٱللَّهَ","عَلِيمُۢ","بِمَا","يَصۡنَعُونَ"],"афаман зуййина лахуу су'уу `амалихии фарааху хасанан фа'инналлаха йудиллу ман йашау вайахдии ман йашау фала тазхаб нафсука `алайхим хасаратин инналлаха `алииму бима йасна`уун","Разве тот, кому его злодеяние представлено прекрасным и кто считает его благом, равен тому, кто следует прямым путем? Воистину, Аллах вводит в заблуждение того, кого пожелает, и ведет прямым путем того, кого пожелает. Не изводи себя скорбью по ним. Воистину, Аллах знает о том, что они творят.",["Разве тот, кому","было приукрашено","ему","злое","деяние его","и увидел он его","прекрасным","Ведь поистине","Аллах","вводит в заблуждение","кого","пожелает Он","и ведёт прямым путём","кого","пожелает Он","так пусть не","уходит","душа твоя","по ним","(в) скорби","Поистине","Аллах","Знающий","о том, что","творят они"]],[35,9,["وَٱللَّهُ","ٱلَّذِيٓ","أَرۡسَلَ","ٱلرِّيَٰحَ","فَتُثِيرُ","سَحَابٗا","فَسُقۡنَٰهُ","إِلَىٰ","بَلَدٖ","مَّيِّتٖ","فَأَحۡيَيۡنَا","بِهِ","ٱلۡأَرۡضَ","بَعۡدَ","مَوۡتِهَاۚ","كَذَٰلِكَ","ٱلنُّشُورُ"],"валлахул лазии арсалар рийаха фатусииру сахабан фасуḳнаху ила баладим маййитин фа'ахйайна бихил арда ба`да маутиха казаликан нушуур","Аллах - Тот, Кто посылает ветры, которые поднимают облака. Потом Мы гоним их в вымершие страны и оживляем ею (дождевою водой) землю после ее смерти. Таким же образом произойдет воскрешение.",["И Аллах","Тот, Который","послал","ветры","и поднимают они","облака","и погнали Мы их","к","местности","мёртвой","и оживили Мы","им","землю","после","смерти её","Так же","воскрешение"]],[35,10,["مَن","كَانَ","يُرِيدُ","ٱلۡعِزَّةَ","فَلِلَّهِ","ٱلۡعِزَّةُ","جَمِيعًاۚ","إِلَيۡهِ","يَصۡعَدُ","ٱلۡكَلِمُ","ٱلطَّيِّبُ","وَٱلۡعَمَلُ","ٱلصَّٰلِحُ","يَرۡفَعُهُۥۚ","وَٱلَّذِينَ","يَمۡكُرُونَ","ٱلسَّيِّـَٔاتِ","لَهُمۡ","عَذَابٞ","شَدِيدٞۖ","وَمَكۡرُ","أُوْلَٰٓئِكَ","هُوَ","يَبُورُ"],"ман кана йуриидул `иззата фалиллахил `иззату жамии`ан илайхи йас`адул калимут таййибу вал`амалус салиху йарфа`ухуу валлазиина йамкуруунас саййиати лахум `азабун шадиидун вамакру улаика хуа йабуур","Если кто жаждет могущества, то ведь могущество целиком принадлежит Аллаху. К Нему восходит прекрасное слово, и Он возносит праведное деяние (или праведное деяние возносит прекрасное слово; или праведное деяние возносит человека). А тем, которые замышляют злодеяния, уготованы тяжкие мучения, и их замыслы окажутся безуспешными.",["Кто","есть","желает","могущества","то Аллаху","могущество","целиком","К Нему","восходит","слово","благое","и деяние","праведное","возносит его","А те, которые","замышляют","злодеяния","для них","мучение","тяжкое","и замыслы","тех","они","пропадут"]],[35,11,["وَٱللَّهُ","خَلَقَكُم","مِّن","تُرَابٖ","ثُمَّ","مِن","نُّطۡفَةٖ","ثُمَّ","جَعَلَكُمۡ","أَزۡوَٰجٗاۚ","وَمَا","تَحۡمِلُ","مِنۡ","أُنثَىٰ","وَلَا","تَضَعُ","إِلَّا","بِعِلۡمِهِۦۚ","وَمَا","يُعَمَّرُ","مِن","مُّعَمَّرٖ","وَلَا","يُنقَصُ","مِنۡ","عُمُرِهِۦٓ","إِلَّا","فِي","كِتَٰبٍۚ","إِنَّ","ذَٰلِكَ","عَلَى","ٱللَّهِ","يَسِيرٞ"],"валлаху халаḳакум мин турабин сумма мин нутфатин сумма жа`алакум азважан вама тахмилу мин унса вала тада`у илла би`илмихии вама йу`аммару мим му`аммарин вала йунḳасу мин `умурихии илла фии китабин инна залика `алаллахи йасиир","Аллах создал вас из земли, затем - из капли, а затем сделал вас парами. Самка может зачать или родить только с Его ведома. Даруется долгожителю долгая жизнь или укорачивается его жизнь, все это есть в Писании (Хранимой скрижали). Воистину, это для Аллаха легко.",["И Аллах","создал вас","из","праха","затем","из","капли","затем","сделал Он вас","парами","И не","вынашивает","никакая","самка","и не","рожает","кроме как","с ведома Его","И не","продлевается жизнь","никакому","долгожителю","и не","убавляется","от","жизни его","кроме как","в","Писании","Поистине","это","для","Аллаха","легко"]]],"m":[[["وَإِن","И если",35,4],["يُكَذِّبُوكَ","сочтут они тебя лжецом",35,4],["فَقَدۡ","то ведь уже",35,4],["كُذِّبَتۡ","были сочтены лжецами",35,4],["رُسُلٞ","посланники",35,4],["مِّن","до",35,4],["قَبۡلِكَۚ","тебя",35,4],["وَإِلَى","И к",35,4],["ٱللَّهِ","Аллаху",35,4],["تُرۡجَعُ","возвращаются",35,4],["ٱلۡأُمُورُ","дела",35,4]],[[4],["يَٰٓأَيُّهَا","О",35,5],["ٱلنَّاسُ","люди",35,5],["إِنَّ","Поистине",35,5],["وَعۡدَ","обещание",35,5],["ٱللَّهِ","Аллаха",35,5],["حَقّٞۖ","истинно",35,5],["فَلَا","Так пусть не",35,5],["تَغُرَّنَّكُمُ","обольщает вас",35,5],["ٱلۡحَيَوٰةُ","жизнь",35,5],["ٱلدُّنۡيَا","мирская",35,5]],[["وَلَا","и пусть не",35,5],["يَغُرَّنَّكُم","обольщает вас",35,5],["بِٱللَّهِ","относительно Аллаха",35,5],["ٱلۡغَرُورُ","обольститель",35,5],[5],["إِنَّ","Поистине",35,6],["ٱلشَّيۡطَٰنَ","шайтан",35,6],["لَكُمۡ","для вас",35,6],["عَدُوّٞ","враг",35,6],["فَٱتَّخِذُوهُ","так считайте его",35,6]],[["عَدُوًّاۚ","врагом",35,6],["إِنَّمَا","Лишь",35,6],["يَدۡعُواْ","призывает он",35,6],["حِزۡبَهُۥ","партию свою",35,6],["لِيَكُونُواْ","чтобы были они",35,6],["مِنۡ","из",35,6],["أَصۡحَٰبِ","обитателей",35,6],["ٱلسَّعِيرِ","Пламени",35,6],[6],["ٱلَّذِينَ","Те, которые",35,7]],[["كَفَرُواْ","не уверовали",35,7],["لَهُمۡ","для них",35,7],["عَذَابٞ","мучение",35,7],["شَدِيدٞۖ","тяжкое",35,7],["وَٱلَّذِينَ","а те, которые",35,7],["ءَامَنُواْ","уверовали",35,7],["وَعَمِلُواْ","и совершали",35,7],["ٱلصَّٰلِحَٰتِ","праведные деяния",35,7],["لَهُم","для них",35,7]],[["مَّغۡفِرَةٞ","прощение",35,7],["وَأَجۡرٞ","и награда",35,7],["كَبِيرٌ","великая",35,7],[7],["أَفَمَن","Разве тот, кому",35,8],["زُيِّنَ","было приукрашено",35,8],["لَهُۥ","ему",35,8],["سُوٓءُ","злое",35,8],["عَمَلِهِۦ","деяние его",35,8],["فَرَءَاهُ","и увидел он его",35,8],["حَسَنٗاۖ","прекрасным",35,8]],[["فَإِنَّ","Ведь поистине",35,8],["ٱللَّهَ","Аллах",35,8],["يُضِلُّ","вводит в заблуждение",35,8],["مَن","кого",35,8],["يَشَآءُ","пожелает Он",35,8],["وَيَهۡدِي","и ведёт прямым путём",35,8],["مَن","кого",35,8],["يَشَآءُۖ","пожелает Он",35,8],["فَلَا","так пусть не",35,8],["تَذۡهَبۡ","уходит",35,8],["نَفۡسُكَ","душа твоя",35,8]],[["عَلَيۡهِمۡ","по ним",35,8],["حَسَرَٰتٍۚ","(в) скорби",35,8],["إِنَّ","Поистине",35,8],["ٱللَّهَ","Аллах",35,8],["عَلِيمُۢ","Знающий",35,8],["بِمَا","о том, что",35,8],["يَصۡنَعُونَ","творят они",35,8],[8],["وَٱللَّهُ","И Аллах",35,9],["ٱلَّذِيٓ","Тот, Который",35,9],["أَرۡسَلَ","послал",35,9]],[["ٱلرِّيَٰحَ","ветры",35,9],["فَتُثِيرُ","и поднимают они",35,9],["سَحَابٗا","облака",35,9],["فَسُقۡنَٰهُ","и погнали Мы их",35,9],["إِلَىٰ","к",35,9],["بَلَدٖ","местности",35,9],["مَّيِّتٖ","мёртвой",35,9],["فَأَحۡيَيۡنَا","и оживили Мы",35,9],["بِهِ","им",35,9],["ٱلۡأَرۡضَ","землю",35,9],["بَعۡدَ","после",35,9]],[["مَوۡتِهَاۚ","смерти её",35,9],["كَذَٰلِكَ","Так же",35,9],["ٱلنُّشُورُ","воскрешение",35,9],[9],["مَن","Кто",35,10],["كَانَ","есть",35,10],["يُرِيدُ","желает",35,10],["ٱلۡعِزَّةَ","могущества",35,10],["فَلِلَّهِ","то Аллаху",35,10],["ٱلۡعِزَّةُ","могущество",35,10],["جَمِيعًاۚ","целиком",35,10]],[["إِلَيۡهِ","К Нему",35,10],["يَصۡعَدُ","восходит",35,10],["ٱلۡكَلِمُ","слово",35,10],["ٱلطَّيِّبُ","благое",35,10],["وَٱلۡعَمَلُ","и деяние",35,10],["ٱلصَّٰلِحُ","праведное",35,10],["يَرۡفَعُهُۥۚ","возносит его",35,10],["وَٱلَّذِينَ","А те, которые",35,10]],[["يَمۡكُرُونَ","замышляют",35,10],["ٱلسَّيِّـَٔاتِ","злодеяния",35,10],["لَهُمۡ","для них",35,10],["عَذَابٞ","мучение",35,10],["شَدِيدٞۖ","тяжкое",35,10],["وَمَكۡرُ","и замыслы",35,10],["أُوْلَٰٓئِكَ","тех",35,10],["هُوَ","они",35,10],["يَبُورُ","пропадут",35,10]],[[10],["وَٱللَّهُ","И Аллах",35,11],["خَلَقَكُم","создал вас",35,11],["مِّن","из",35,11],["تُرَابٖ","праха",35,11],["ثُمَّ","затем",35,11],["مِن","из",35,11],["نُّطۡفَةٖ","капли",35,11],["ثُمَّ","затем",35,11],["جَعَلَكُمۡ","сделал Он вас",35,11],["أَزۡوَٰجٗاۚ","парами",35,11]],[["وَمَا","И не",35,11],["تَحۡمِلُ","вынашивает",35,11],["مِنۡ","никакая",35,11],["أُنثَىٰ","самка",35,11],["وَلَا","и не",35,11],["تَضَعُ","рожает",35,11],["إِلَّا","кроме как",35,11],["بِعِلۡمِهِۦۚ","с ведома Его",35,11],["وَمَا","И не",35,11],["يُعَمَّرُ","продлевается жизнь",35,11],["مِن","никакому",35,11],["مُّعَمَّرٖ","долгожителю",35,11]],[["وَلَا","и не",35,11],["يُنقَصُ","убавляется",35,11],["مِنۡ","от",35,11],["عُمُرِهِۦٓ","жизни его",35,11],["إِلَّا","кроме как",35,11],["فِي","в",35,11],["كِتَٰبٍۚ","Писании",35,11],["إِنَّ","Поистине",35,11],["ذَٰلِكَ","это",35,11],["عَلَى","для",35,11],["ٱللَّهِ","Аллаха",35,11],["يَسِيرٞ","легко",35,11],[11]]]}