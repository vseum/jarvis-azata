{"p":436,"j":22,"a":[[35,12,["وَمَا","يَسۡتَوِي","ٱلۡبَحۡرَانِ","هَٰذَا","عَذۡبٞ","فُرَاتٞ","سَآئِغٞ","شَرَابُهُۥ","وَهَٰذَا","مِلۡحٌ","أُجَاجٞۖ","وَمِن","كُلّٖ","تَأۡكُلُونَ","لَحۡمٗا","طَرِيّٗا","وَتَسۡتَخۡرِجُونَ","حِلۡيَةٗ","تَلۡبَسُونَهَاۖ","وَتَرَى","ٱلۡفُلۡكَ","فِيهِ","مَوَاخِرَ","لِتَبۡتَغُواْ","مِن","فَضۡلِهِۦ","وَلَعَلَّكُمۡ","تَشۡكُرُونَ"],"вама йаставил бахрани хаза `азбун фуратун саигун шарабухуу вахаза милхун ужажун вамин куллин та'кулууна лахман тариййан ватастахрижууна хилйатан талбасуунаха ватарал фулка фиихи мавахира литабтагуу мин фадлихии вала`аллакум ташкуруун","Не равны два моря (вида воды). Это - вкусное, пресное, приятное для питья, а это - соленое, горькое. Из каждого из них вы едите свежее мясо и добываете украшения, которые вы носите. Ты видишь, как корабли бороздят их, чтобы вы могли искать Его милость, - быть может, вы будете благодарны.",["И не","равны","два моря","Это","пресное","сладкое","приятно","питьё его","а это","солёное","горькое","И из","каждого","едите вы","мясо","свежее","и добываете вы","украшения","носите вы их","и видишь ты","корабли","в нём","рассекающими (волны)","чтобы искали вы","из","щедрости Его","и, может быть, вы","будете благодарны"]],[35,13,["يُولِجُ","ٱلَّيۡلَ","فِي","ٱلنَّهَارِ","وَيُولِجُ","ٱلنَّهَارَ","فِي","ٱلَّيۡلِ","وَسَخَّرَ","ٱلشَّمۡسَ","وَٱلۡقَمَرَۖ","كُلّٞ","يَجۡرِي","لِأَجَلٖ","مُّسَمّٗىۚ","ذَٰلِكُمُ","ٱللَّهُ","رَبُّكُمۡ","لَهُ","ٱلۡمُلۡكُۚ","وَٱلَّذِينَ","تَدۡعُونَ","مِن","دُونِهِۦ","مَا","يَمۡلِكُونَ","مِن","قِطۡمِيرٍ"],"йуулижул лайла фин нахари вайуулижун нахара фил лайли васаххараш шамса валḳамара куллун йажрии ли'ажалим мусамман заликумуллаху раббукум лахул мулку валлазиина тад`ууна мин дуунихии ма йамликууна мин ḳитмиир","Он удлиняет день за счет ночи и удлиняет ночь за счет дня. Он подчинил солнце и луну, и они движутся до назначенного срока. Таков Аллах, ваш Господь. Ему принадлежит власть, а те, к кому вы взываете помимо Него, не владеют даже плевой на финиковой косточке.",["Он вводит","ночь","в","день","и вводит Он","день","в","ночь","и подчинил Он","солнце","и луну","каждый","течёт","до срока","назначенного","Таков","Аллах","Господь ваш","Ему","власть","А те, к которым","взываете вы","помимо","Него","не","владеют они","даже","плёнкой финиковой косточки"]],[35,14,["إِن","تَدۡعُوهُمۡ","لَا","يَسۡمَعُواْ","دُعَآءَكُمۡ","وَلَوۡ","سَمِعُواْ","مَا","ٱسۡتَجَابُواْ","لَكُمۡۖ","وَيَوۡمَ","ٱلۡقِيَٰمَةِ","يَكۡفُرُونَ","بِشِرۡكِكُمۡۚ","وَلَا","يُنَبِّئُكَ","مِثۡلُ","خَبِيرٖ"],"ин тад`уухум ла йасма`уу ду`аакум валау сами`уу мастажабуу лакум вайаумал ḳийамати йакфурууна биширкикум вала йунаббиука мислу хабиир","Когда вы взываете к ним, они не слышат вашей молитвы, а если бы даже услышали, то не ответили бы вам. В День воскресения они отвергнут ваше поклонение. Никто не поведает тебе так, как Ведающий.",["Если","будете взывать вы к ним","не","услышат они","зова вашего","и если бы","услышали они","не","ответили бы они","вам","И в день","воскресения","отвергнут они","ваше придавание сотоварищей","И не","сообщит тебе","подобно","Ведающему"]],[35,15,["يَٰٓأَيُّهَا","ٱلنَّاسُ","أَنتُمُ","ٱلۡفُقَرَآءُ","إِلَى","ٱللَّهِۖ","وَٱللَّهُ","هُوَ","ٱلۡغَنِيُّ","ٱلۡحَمِيدُ"],"йа'аййухан насу антумул фуḳарау илаллахи валлаху хуал ганиййул хамиид","О люди! Вы нуждаетесь в Аллахе, тогда как Аллах - Богатый, Достохвальный.",["О","люди","Вы","нуждающиеся","в","Аллахе","а Аллах","Он","Богатый","Достохвальный"]],[35,16,["إِن","يَشَأۡ","يُذۡهِبۡكُمۡ","وَيَأۡتِ","بِخَلۡقٖ","جَدِيدٖ"],"ин йаша' йузхибкум вайа'ти бихалḳин жадиид","Если Он пожелает, то погубит вас и приведет новые творения.",["Если","пожелает Он","уведёт Он вас","и приведёт","творение","новое"]],[35,17,["وَمَا","ذَٰلِكَ","عَلَى","ٱللَّهِ","بِعَزِيزٖ"],"вама залика `алаллахи би`азииз","Это нетрудно для Аллаха.",["и не","это","для","Аллаха","трудно"]],[35,18,["وَلَا","تَزِرُ","وَازِرَةٞ","وِزۡرَ","أُخۡرَىٰۚ","وَإِن","تَدۡعُ","مُثۡقَلَةٌ","إِلَىٰ","حِمۡلِهَا","لَا","يُحۡمَلۡ","مِنۡهُ","شَيۡءٞ","وَلَوۡ","كَانَ","ذَا","قُرۡبَىٰٓۗ","إِنَّمَا","تُنذِرُ","ٱلَّذِينَ","يَخۡشَوۡنَ","رَبَّهُم","بِٱلۡغَيۡبِ","وَأَقَامُواْ","ٱلصَّلَوٰةَۚ","وَمَن","تَزَكَّىٰ","فَإِنَّمَا","يَتَزَكَّىٰ","لِنَفۡسِهِۦۚ","وَإِلَى","ٱللَّهِ","ٱلۡمَصِيرُ"],"вала тазиру вазиратун визра ухра ва'ин тад`у мусḳалатун ила химлиха ла йухмал минху шай'ун валау кана за ḳурба иннама тунзирул лазиина йахшауна раббахум билгайби ва'аḳамус салавата ваман тазакка фа'иннама йатазакка линафсихии ва'илаллахил масиир","Ни одна душа не понесет чужого бремени, и если обремененная душа взмолится о том, чтобы ей помогли понести ее ношу, ничто не будет взято из нее, даже если просящий окажется близким родственником. Ты предостерегаешь только тех, которые боятся своего Господа, не видя Его воочию, и совершают намаз. Кто очищается, тот очищается во благо себе, и к Аллаху предстоит прибытие.",["и не","понесёт","несущая (бремя)","бремени","другой","и если","призовёт","обременённая","к","ноше своей","не","будет понесено","из неё","ничего","даже если","будет (он)","обладателем","родства","лишь","предостерегаешь ты","тех, которые","боятся","Господа своего","втайне (не видя)","и совершали","намаз","и кто","очистился","то лишь","очищается","для себя самого","и к","Аллаху","возвращение"]]],"m":[[["وَمَا","И не",35,12],["يَسۡتَوِي","равны",35,12],["ٱلۡبَحۡرَانِ","два моря",35,12],["هَٰذَا","Это",35,12],["عَذۡبٞ","пресное",35,12],["فُرَاتٞ","сладкое",35,12],["سَآئِغٞ","приятно",35,12],["شَرَابُهُۥ","питьё его",35,12],["وَهَٰذَا","а это",35,12]],[["مِلۡحٌ","солёное",35,12],["أُجَاجٞۖ","горькое",35,12],["وَمِن","И из",35,12],["كُلّٖ","каждого",35,12],["تَأۡكُلُونَ","едите вы",35,12],["لَحۡمٗا","мясо",35,12],["طَرِيّٗا","свежее",35,12],["وَتَسۡتَخۡرِجُونَ","и добываете вы",35,12]],[["حِلۡيَةٗ","украшения",35,12],["تَلۡبَسُونَهَاۖ","носите вы их",35,12],["وَتَرَى","и видишь ты",35,12],["ٱلۡفُلۡكَ","корабли",35,12],["فِيهِ","в нём",35,12],["مَوَاخِرَ","рассекающими (волны)",35,12],["لِتَبۡتَغُواْ","чтобы искали вы",35,12],["مِن","из",35,12],["فَضۡلِهِۦ","щедрости Его",35,12]],[["وَلَعَلَّكُمۡ","и, может быть, вы",35,12],["تَشۡكُرُونَ","будете благодарны",35,12],[12],["يُولِجُ","Он вводит",35,13],["ٱلَّيۡلَ","ночь",35,13],["فِي","в",35,13],["ٱلنَّهَارِ","день",35,13],["وَيُولِجُ","и вводит Он",35,13]],[["ٱلنَّهَارَ","день",35,13],["فِي","в",35,13],["ٱلَّيۡلِ","ночь",35,13],["وَسَخَّرَ","и подчинил Он",35,13],["ٱلشَّمۡسَ","солнце",35,13],["وَٱلۡقَمَرَۖ","и луну",35,13],["كُلّٞ","каждый",35,13],["يَجۡرِي","течёт",35,13]],[["لِأَجَلٖ","до срока",35,13],["مُّسَمّٗىۚ","назначенного",35,13],["ذَٰلِكُمُ","Таков",35,13],["ٱللَّهُ","Аллах",35,13],["رَبُّكُمۡ","Господь ваш",35,13],["لَهُ","Ему",35,13],["ٱلۡمُلۡكُۚ","власть",35,13],["وَٱلَّذِينَ","А те, к которым",35,13]],[["تَدۡعُونَ","взываете вы",35,13],["مِن","помимо",35,13],["دُونِهِۦ","Него",35,13],["مَا","не",35,13],["يَمۡلِكُونَ","владеют они",35,13],["مِن","даже",35,13],["قِطۡمِيرٍ","плёнкой финиковой косточки",35,13],[13],["إِن","Если",35,14]],[["تَدۡعُوهُمۡ","будете взывать вы к ним",35,14],["لَا","не",35,14],["يَسۡمَعُواْ","услышат они",35,14],["دُعَآءَكُمۡ","зова вашего",35,14],["وَلَوۡ","и если бы",35,14],["سَمِعُواْ","услышали они",35,14],["مَا","не",35,14],["ٱسۡتَجَابُواْ","ответили бы они",35,14],["لَكُمۡۖ","вам",35,14]],[["وَيَوۡمَ","И в день",35,14],["ٱلۡقِيَٰمَةِ","воскресения",35,14],["يَكۡفُرُونَ","отвергнут они",35,14],["بِشِرۡكِكُمۡۚ","ваше придавание сотоварищей",35,14],["وَلَا","И не",35,14],["يُنَبِّئُكَ","сообщит тебе",35,14],["مِثۡلُ","подобно",35,14],["خَبِيرٖ","Ведающему",35,14]],[[14],["۞ يَٰٓأَيُّهَا","О",35,15],["ٱلنَّاسُ","люди",35,15],["أَنتُمُ","Вы",35,15],["ٱلۡفُقَرَآءُ","нуждающиеся",35,15],["إِلَى","в",35,15],["ٱللَّهِۖ","Аллахе",35,15],["وَٱللَّهُ","а Аллах",35,15],["هُوَ","Он",35,15],["ٱلۡغَنِيُّ","Богатый",35,15]],[["ٱلۡحَمِيدُ","Достохвальный",35,15],[15],["إِن","Если",35,16],["يَشَأۡ","пожелает Он",35,16],["يُذۡهِبۡكُمۡ","уведёт Он вас",35,16],["وَيَأۡتِ","и приведёт",35,16],["بِخَلۡقٖ","творение",35,16],["جَدِيدٖ","новое",35,16],[16]],[["وَمَا","и не",35,17],["ذَٰلِكَ","это",35,17],["عَلَى","для",35,17],["ٱللَّهِ","Аллаха",35,17],["بِعَزِيزٖ","трудно",35,17],[17],["وَلَا","и не",35,18],["تَزِرُ","понесёт",35,18],["وَازِرَةٞ","несущая (бремя)",35,18],["وِزۡرَ","бремени",35,18],["أُخۡرَىٰۚ","другой",35,18],["وَإِن","и если",35,18]],[["تَدۡعُ","призовёт",35,18],["مُثۡقَلَةٌ","обременённая",35,18],["إِلَىٰ","к",35,18],["حِمۡلِهَا","ноше своей",35,18],["لَا","не",35,18],["يُحۡمَلۡ","будет понесено",35,18],["مِنۡهُ","из неё",35,18],["شَيۡءٞ","ничего",35,18],["وَلَوۡ","даже если",35,18],["كَانَ","будет (он)",35,18],["ذَا","обладателем",35,18],["قُرۡبَىٰٓۗ","родства",35,18]],[["إِنَّمَا","лишь",35,18],["تُنذِرُ","предостерегаешь ты",35,18],["ٱلَّذِينَ","тех, которые",35,18],["يَخۡشَوۡنَ","боятся",35,18],["رَبَّهُم","Господа своего",35,18],["بِٱلۡغَيۡبِ","втайне (не видя)",35,18],["وَأَقَامُواْ","и совершали",35,18],["ٱلصَّلَوٰةَۚ","намаз",35,18]],[["وَمَن","и кто",35,18],["تَزَكَّىٰ","очистился",35,18],["فَإِنَّمَا","то лишь",35,18],["يَتَزَكَّىٰ","очищается",35,18],["لِنَفۡسِهِۦۚ","для себя самого",35,18],["وَإِلَى","и к",35,18],["ٱللَّهِ","Аллаху",35,18],["ٱلۡمَصِيرُ","возвращение",35,18],[18]]]}