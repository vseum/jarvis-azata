{"p":437,"j":22,"a":[[35,19,["وَمَا","يَسۡتَوِي","ٱلۡأَعۡمَىٰ","وَٱلۡبَصِيرُ"],"вама йаставил а`ма валбасиир","Не равны слепой и зрячий,",["и не","равны","слепой","и зрячий"]],[35,20,["وَلَا","ٱلظُّلُمَٰتُ","وَلَا","ٱلنُّورُ"],"валаз зулумату валан нуур","мраки и свет,",["и не","мраки","и не","свет"]],[35,21,["وَلَا","ٱلظِّلُّ","وَلَا","ٱلۡحَرُورُ"],"валаз зиллу валал харуур","тень и зной.",["и не","тень","и не","зной"]],[35,22,["وَمَا","يَسۡتَوِي","ٱلۡأَحۡيَآءُ","وَلَا","ٱلۡأَمۡوَٰتُۚ","إِنَّ","ٱللَّهَ","يُسۡمِعُ","مَن","يَشَآءُۖ","وَمَآ","أَنتَ","بِمُسۡمِعٖ","مَّن","فِي","ٱلۡقُبُورِ"],"вама йаставил ахйау валал амвату инналлаха йусми`у ман йашау вама анта бимусми`им ман фил ḳубуур","Не равны живые и мертвые. Воистину, Аллах дарует слух тому, кому пожелает, и ты не можешь заставить слышать тех, кто в могиле.",["и не","равны","живые","и не","мёртвые","поистине","Аллах","даёт услышать","кому","пожелает","и не","ты","дающий услышать","тех, кто","в","могилах"]],[35,23,["إِنۡ","أَنتَ","إِلَّا","نَذِيرٌ"],"ин анта илла назиир","Ты - всего лишь предостерегающий увещеватель.",["не","ты","кроме","увещеватель"]],[35,24,["إِنَّآ","أَرۡسَلۡنَٰكَ","بِٱلۡحَقِّ","بَشِيرٗا","وَنَذِيرٗاۚ","وَإِن","مِّنۡ","أُمَّةٍ","إِلَّا","خَلَا","فِيهَا","نَذِيرٞ"],"инна арсалнака билхаḳḳи башииран ваназииран ва'им мин умматин илла хала фииха назиир","Мы послали тебя с истиной добрым вестником и предостерегающим увещевателем, и нет ни одного народа, к которому не приходил бы предостерегающий увещеватель.",["поистине, Мы","послали Мы тебя","с истиной","благовестником","и увещевателем","и не","из","общины","кроме (того, что)","прошёл","в ней","увещеватель"]],[35,25,["وَإِن","يُكَذِّبُوكَ","فَقَدۡ","كَذَّبَ","ٱلَّذِينَ","مِن","قَبۡلِهِمۡ","جَآءَتۡهُمۡ","رُسُلُهُم","بِٱلۡبَيِّنَٰتِ","وَبِٱلزُّبُرِ","وَبِٱلۡكِتَٰبِ","ٱلۡمُنِيرِ"],"ва'ин йуказзибуука фаḳад каззабал лазиина мин ḳаблихим жаатхум русулухум билбаййинати вабиззубури вабилкитабил муниир","Если они не сочли тебя лжецом, то ведь их предшественники также считали лжецами посланников. Их посланники приносили им ясные знамения, Писания и освещающую книгу.",["и если","сочтут лжецом тебя","то уже","сочли лжецами","те, которые","из","прежде них","приходили к ним","посланники их","с ясными знамениями","и с Писаниями","и с Книгой","освещающей"]],[35,26,["ثُمَّ","أَخَذۡتُ","ٱلَّذِينَ","كَفَرُواْۖ","فَكَيۡفَ","كَانَ","نَكِيرِ"],"сумма ахазтул лазиина кафаруу факайфа кана накиир","Затем Я схватил тех, которые не уверовали. Каким же было Мое обличение!",["затем","схватил Я","тех, которые","не уверовали","и каким же","было","Моё порицание"]],[35,27,["أَلَمۡ","تَرَ","أَنَّ","ٱللَّهَ","أَنزَلَ","مِنَ","ٱلسَّمَآءِ","مَآءٗ","فَأَخۡرَجۡنَا","بِهِۦ","ثَمَرَٰتٖ","مُّخۡتَلِفًا","أَلۡوَٰنُهَاۚ","وَمِنَ","ٱلۡجِبَالِ","جُدَدُۢ","بِيضٞ","وَحُمۡرٞ","مُّخۡتَلِفٌ","أَلۡوَٰنُهَا","وَغَرَابِيبُ","سُودٞ"],"алам тара анналлаха анзала минас самаи маан фа'ахражна бихии самаратим мухталифан алвануха ваминал жибали жудаду биидун вахумрум мухталифун алвануха вагарабиибу сууд","Неужели ты не видишь, как Аллах ниспосылает с неба воду, посредством которой Мы взращиваем плоды различных цветов. В горах также есть различные тропы - белые, красные и совершенно черные.",["разве не","видишь ты","что","Аллах","ниспослал","с","неба","воду","и вывели Мы","ею","плоды","различные","цвета их","и в","горах","полосы","белые","и красные","различные","цвета их","и густо-чёрные","чёрные"]],[35,28,["وَمِنَ","ٱلنَّاسِ","وَٱلدَّوَآبِّ","وَٱلۡأَنۡعَٰمِ","مُخۡتَلِفٌ","أَلۡوَٰنُهُۥ","كَذَٰلِكَۗ","إِنَّمَا","يَخۡشَى","ٱللَّهَ","مِنۡ","عِبَادِهِ","ٱلۡعُلَمَٰٓؤُاْۗ","إِنَّ","ٱللَّهَ","عَزِيزٌ","غَفُورٌ"],"ваминан наси ваддавабби вал'ан`ами мухталифун алванухуу казалика иннама йахшаллаха мин `ибадихил `уламау инналлаха `азиизун гафуур","Люди, животные и скот также бывают различных цветов. Боятся Аллаха среди Его рабов только обладающие знанием. Воистину, Аллах - Могущественный, Прощающий.",["и среди","людей","и животных","и скота","различные","цвета его","так же","лишь","боятся","Аллаха","из","рабов Его","знающие","поистине","Аллах","Могущественный","Прощающий"]],[35,29,["إِنَّ","ٱلَّذِينَ","يَتۡلُونَ","كِتَٰبَ","ٱللَّهِ","وَأَقَامُواْ","ٱلصَّلَوٰةَ","وَأَنفَقُواْ","مِمَّا","رَزَقۡنَٰهُمۡ","سِرّٗا","وَعَلَانِيَةٗ","يَرۡجُونَ","تِجَٰرَةٗ","لَّن","تَبُورَ"],"иннал лазиина йатлууна китабаллахи ва'аḳамус салавата ва'анфаḳуу мимма разаḳнахум сирран ва`аланийатан йаржууна тижаратал лан табуур","Воистину, те, которые читают Писание Аллаха, совершают намаз и расходуют из того, чем Мы наделили их, тайно и открыто, надеются на сделку, которая не окажется безуспешной,",["поистине","те, которые","читают","Писание","Аллаха","и совершали","намаз","и расходовали","из того, чем","наделили Мы их","тайно","и открыто","надеются (на)","сделку","никогда не","пропадёт"]],[35,30,["لِيُوَفِّيَهُمۡ","أُجُورَهُمۡ","وَيَزِيدَهُم","مِّن","فَضۡلِهِۦٓۚ","إِنَّهُۥ","غَفُورٞ","شَكُورٞ"],"лийуаффийахум ужуурахум вайазиидахум мин фадлихии иннахуу гафуурун шакуур","дабы Он вознаградил их сполна и даже добавил от Своей милости. Воистину, Он - Прощающий, Благодарный.",["чтобы сполна воздал Он им","награды их","и прибавил Он им","из","щедрости Своей","поистине, Он","Прощающий","Благодарный"]]],"m":[[["وَمَا","и не",35,19],["يَسۡتَوِي","равны",35,19],["ٱلۡأَعۡمَىٰ","слепой",35,19],["وَٱلۡبَصِيرُ","и зрячий",35,19],[19],["وَلَا","и не",35,20],["ٱلظُّلُمَٰتُ","мраки",35,20],["وَلَا","и не",35,20],["ٱلنُّورُ","свет",35,20]],[[20],["وَلَا","и не",35,21],["ٱلظِّلُّ","тень",35,21],["وَلَا","и не",35,21],["ٱلۡحَرُورُ","зной",35,21],[21],["وَمَا","и не",35,22],["يَسۡتَوِي","равны",35,22],["ٱلۡأَحۡيَآءُ","живые",35,22],["وَلَا","и не",35,22],["ٱلۡأَمۡوَٰتُۚ","мёртвые",35,22]],[["إِنَّ","поистине",35,22],["ٱللَّهَ","Аллах",35,22],["يُسۡمِعُ","даёт услышать",35,22],["مَن","кому",35,22],["يَشَآءُۖ","пожелает",35,22],["وَمَآ","и не",35,22],["أَنتَ","ты",35,22],["بِمُسۡمِعٖ","дающий услышать",35,22],["مَّن","тех, кто",35,22],["فِي","в",35,22],["ٱلۡقُبُورِ","могилах",35,22],[22],["إِنۡ","не",35,23]],[["أَنتَ","ты",35,23],["إِلَّا","кроме",35,23],["نَذِيرٌ","увещеватель",35,23],[23],["إِنَّآ","поистине, Мы",35,24],["أَرۡسَلۡنَٰكَ","послали Мы тебя",35,24],["بِٱلۡحَقِّ","с истиной",35,24],["بَشِيرٗا","благовестником",35,24],["وَنَذِيرٗاۚ","и увещевателем",35,24],["وَإِن","и не",35,24],["مِّنۡ","из",35,24]],[["أُمَّةٍ","общины",35,24],["إِلَّا","кроме (того, что)",35,24],["خَلَا","прошёл",35,24],["فِيهَا","в ней",35,24],["نَذِيرٞ","увещеватель",35,24],[24],["وَإِن","и если",35,25],["يُكَذِّبُوكَ","сочтут лжецом тебя",35,25],["فَقَدۡ","то уже",35,25],["كَذَّبَ","сочли лжецами",35,25],["ٱلَّذِينَ","те, которые",35,25]],[["مِن","из",35,25],["قَبۡلِهِمۡ","прежде них",35,25],["جَآءَتۡهُمۡ","приходили к ним",35,25],["رُسُلُهُم","посланники их",35,25],["بِٱلۡبَيِّنَٰتِ","с ясными знамениями",35,25],["وَبِٱلزُّبُرِ","и с Писаниями",35,25],["وَبِٱلۡكِتَٰبِ","и с Книгой",35,25]],[["ٱلۡمُنِيرِ","освещающей",35,25],[25],["ثُمَّ","затем",35,26],["أَخَذۡتُ","схватил Я",35,26],["ٱلَّذِينَ","тех, которые",35,26],["كَفَرُواْۖ","не уверовали",35,26],["فَكَيۡفَ","и каким же",35,26],["كَانَ","было",35,26],["نَكِيرِ","Моё порицание",35,26],[26]],[["أَلَمۡ","разве не",35,27],["تَرَ","видишь ты",35,27],["أَنَّ","что",35,27],["ٱللَّهَ","Аллах",35,27],["أَنزَلَ","ниспослал",35,27],["مِنَ","с",35,27],["ٱلسَّمَآءِ","неба",35,27],["مَآءٗ","воду",35,27],["فَأَخۡرَجۡنَا","и вывели Мы",35,27],["بِهِۦ","ею",35,27],["ثَمَرَٰتٖ","плоды",35,27],["مُّخۡتَلِفًا","различные",35,27]],[["أَلۡوَٰنُهَاۚ","цвета их",35,27],["وَمِنَ","и в",35,27],["ٱلۡجِبَالِ","горах",35,27],["جُدَدُۢ","полосы",35,27],["بِيضٞ","белые",35,27],["وَحُمۡرٞ","и красные",35,27],["مُّخۡتَلِفٌ","различные",35,27],["أَلۡوَٰنُهَا","цвета их",35,27]],[["وَغَرَابِيبُ","и густо-чёрные",35,27],["سُودٞ","чёрные",35,27],[27],["وَمِنَ","и среди",35,28],["ٱلنَّاسِ","людей",35,28],["وَٱلدَّوَآبِّ","и животных",35,28],["وَٱلۡأَنۡعَٰمِ","и скота",35,28]],[["مُخۡتَلِفٌ","различные",35,28],["أَلۡوَٰنُهُۥ","цвета его",35,28],["كَذَٰلِكَۗ","так же",35,28],["إِنَّمَا","лишь",35,28],["يَخۡشَى","боятся",35,28],["ٱللَّهَ","Аллаха",35,28],["مِنۡ","из",35,28],["عِبَادِهِ","рабов Его",35,28],["ٱلۡعُلَمَٰٓؤُاْۗ","знающие",35,28]],[["إِنَّ","поистине",35,28],["ٱللَّهَ","Аллах",35,28],["عَزِيزٌ","Могущественный",35,28],["غَفُورٌ","Прощающий",35,28],[28],["إِنَّ","поистине",35,29],["ٱلَّذِينَ","те, которые",35,29],["يَتۡلُونَ","читают",35,29],["كِتَٰبَ","Писание",35,29],["ٱللَّهِ","Аллаха",35,29]],[["وَأَقَامُواْ","и совершали",35,29],["ٱلصَّلَوٰةَ","намаз",35,29],["وَأَنفَقُواْ","и расходовали",35,29],["مِمَّا","из того, чем",35,29],["رَزَقۡنَٰهُمۡ","наделили Мы их",35,29],["سِرّٗا","тайно",35,29],["وَعَلَانِيَةٗ","и открыто",35,29]],[["يَرۡجُونَ","надеются (на)",35,29],["تِجَٰرَةٗ","сделку",35,29],["لَّن","никогда не",35,29],["تَبُورَ","пропадёт",35,29],[29],["لِيُوَفِّيَهُمۡ","чтобы сполна воздал Он им",35,30],["أُجُورَهُمۡ","награды их",35,30]],[["وَيَزِيدَهُم","и прибавил Он им",35,30],["مِّن","из",35,30],["فَضۡلِهِۦٓۚ","щедрости Своей",35,30],["إِنَّهُۥ","поистине, Он",35,30],["غَفُورٞ","Прощающий",35,30],["شَكُورٞ","Благодарный",35,30],[30]]]}