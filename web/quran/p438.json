{"p":438,"j":22,"a":[[35,31,["وَٱلَّذِيٓ","أَوۡحَيۡنَآ","إِلَيۡكَ","مِنَ","ٱلۡكِتَٰبِ","هُوَ","ٱلۡحَقُّ","مُصَدِّقٗا","لِّمَا","بَيۡنَ","يَدَيۡهِۗ","إِنَّ","ٱللَّهَ","بِعِبَادِهِۦ","لَخَبِيرُۢ","بَصِيرٞ"],"валлазии аухайна илайка минал китаби хуал хаḳḳу мусаддиḳал лима байна йадайхи инналлаха би`ибадихии лахабииру басиир","Писание, которое Мы внушили тебе в откровении, является истиной, которая подтверждает то, что было до него. Воистину, Аллах ведает о Своих рабах и видит их.",["и то, что","внушили Мы","тебе","из","Писания","оно","истина","подтверждающая","то, что","перед","ним (до него)","поистине","Аллах","о рабах Своих","непременно Сведущий","Видящий"]],[35,32,["ثُمَّ","أَوۡرَثۡنَا","ٱلۡكِتَٰبَ","ٱلَّذِينَ","ٱصۡطَفَيۡنَا","مِنۡ","عِبَادِنَاۖ","فَمِنۡهُمۡ","ظَالِمٞ","لِّنَفۡسِهِۦ","وَمِنۡهُم","مُّقۡتَصِدٞ","وَمِنۡهُمۡ","سَابِقُۢ","بِٱلۡخَيۡرَٰتِ","بِإِذۡنِ","ٱللَّهِۚ","ذَٰلِكَ","هُوَ","ٱلۡفَضۡلُ","ٱلۡكَبِيرُ"],"сумма аураснал китабал лазиинастафайна мин `ибадина фаминхум залимул линафсихии ваминхум муḳтасидун ваминхум сабиḳу билхайрати би'изниллахи залика хуал фадлул кабиир","Потом Мы дали Писание в наследие тем из Наших рабов, которых Мы избрали. Среди них есть такие, которые несправедливы к самим себе, умеренные и опережающие других в добрых делах с дозволения Аллаха. Это и есть большая милость.",["затем","дали в наследие Мы","Писание","тем, которых","избрали Мы","из","рабов Наших","и из них","несправедливый","к себе","и из них","умеренный","и из них","опережающий","в добрых делах","с дозволения","Аллаха","это","оно","милость","великая"]],[35,33,["جَنَّٰتُ","عَدۡنٖ","يَدۡخُلُونَهَا","يُحَلَّوۡنَ","فِيهَا","مِنۡ","أَسَاوِرَ","مِن","ذَهَبٖ","وَلُؤۡلُؤٗاۖ","وَلِبَاسُهُمۡ","فِيهَا","حَرِيرٞ"],"жаннату `аднин йадхулуунаха йухаллауна фииха мин асавира мин захабин валу'луан валибасухум фииха хариир","Они войдут в сады Эдема, где будут украшены браслетами из золота и жемчугом, а их убранство будет из шелка.",["сады","вечности","войдут они в них","будут украшены они","там","из","браслетов","из","золота","и жемчугом","и одеяние их","там","шёлк"]],[35,34,["وَقَالُواْ","ٱلۡحَمۡدُ","لِلَّهِ","ٱلَّذِيٓ","أَذۡهَبَ","عَنَّا","ٱلۡحَزَنَۖ","إِنَّ","رَبَّنَا","لَغَفُورٞ","شَكُورٌ"],"ваḳалул хамду лиллахил лазии азхаба `аннал хазана инна раббана лагафуурун шакуур","Они скажут: «Хвала Аллаху, Который избавил нас от печали! Воистину, наш Господь - Прощающий, Благодарный.",["и скажут они","хвала","Аллаху","Который","удалил","от нас","печаль","поистине","Господь наш","непременно Прощающий","Благодарный"]],[35,35,["ٱلَّذِيٓ","أَحَلَّنَا","دَارَ","ٱلۡمُقَامَةِ","مِن","فَضۡلِهِۦ","لَا","يَمَسُّنَا","فِيهَا","نَصَبٞ","وَلَا","يَمَسُّنَا","فِيهَا","لُغُوبٞ"],"аллазии ахаллана дарал муḳамати мин фадлихии ла йамассуна фииха насабун вала йамассуна фииха лугууб","Он поселил нас по Своей милости в Вечной обители, где нас не коснется ни усталость, ни изнеможение».",["Который","поселил нас","в обители","пребывания (вечной)","по","милости Своей","не","касается нас","там","усталость","и не","касается нас","там","изнеможение"]],[35,36,["وَٱلَّذِينَ","كَفَرُواْ","لَهُمۡ","نَارُ","جَهَنَّمَ","لَا","يُقۡضَىٰ","عَلَيۡهِمۡ","فَيَمُوتُواْ","وَلَا","يُخَفَّفُ","عَنۡهُم","مِّنۡ","عَذَابِهَاۚ","كَذَٰلِكَ","نَجۡزِي","كُلَّ","كَفُورٖ"],"валлазиина кафаруу лахум нару жаханнама ла йуḳда `алайхим файамуутуу вала йухаффафу `анхум мин `азабиха казалика нажзии кулла кафуур","А тем, которые не уверовали, уготован огонь Геенны. С ними не покончат так, чтобы они могли умереть, и их мучения не облегчатся. Так Мы воздаем каждому неверующему.",["а те, которые","не уверовали","им","огонь","Геенны","не","выносится решение","о них","чтобы умерли они","и не","облегчается","им","из","мучения его","так","воздаём Мы","каждому","неблагодарному"]],[35,37,["وَهُمۡ","يَصۡطَرِخُونَ","فِيهَا","رَبَّنَآ","أَخۡرِجۡنَا","نَعۡمَلۡ","صَٰلِحًا","غَيۡرَ","ٱلَّذِي","كُنَّا","نَعۡمَلُۚ","أَوَلَمۡ","نُعَمِّرۡكُم","مَّا","يَتَذَكَّرُ","فِيهِ","مَن","تَذَكَّرَ","وَجَآءَكُمُ","ٱلنَّذِيرُۖ","فَذُوقُواْ","فَمَا","لِلظَّٰلِمِينَ","مِن","نَّصِيرٍ"],"вахум йастарихууна фииха раббана ахрижна на`мал салихан гайрал лазии кунна на`малу авалам ну`аммиркум ма йатазаккару фиихи ман тазаккара важаакумун назииру фазууḳуу фама лиззалимиина мин насиир","Там они возопят: «Господь наш! Выведи нас отсюда, и мы будем поступать праведно, а не так, как мы поступали прежде». Разве Мы не даровали вам жизнь достаточно долгую для того, чтобы опомнился тот, кто мог опомниться? Да и предостерегающий увещеватель приходил к вам. Вкусите же наказание, и нет для беззаконников помощников.",["и они","будут вопить","там","Господь наш","выведи нас","будем делать мы","праведное","иное, чем","то, что","были мы","делаем","разве не","дали Мы вам долгую жизнь","(столько,) что","опомнился бы","в ней","кто","опомнился бы","и пришёл к вам","увещеватель","вкусите же","и нет","для беззаконников","никакого","помощника"]],[35,38,["إِنَّ","ٱللَّهَ","عَٰلِمُ","غَيۡبِ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِۚ","إِنَّهُۥ","عَلِيمُۢ","بِذَاتِ","ٱلصُّدُورِ"],"инналлаха `алиму гайбис самавати вал'арди иннахуу `алииму бизатис судуур","Аллах - Ведающий сокровенное небес и земли. Он ведает о том, что в груди.",["поистине","Аллах","Знающий","сокровенное","небес","и земли","поистине, Он","Знающий","о том, что в","грудях"]]],"m":[[["وَٱلَّذِيٓ","и то, что",35,31],["أَوۡحَيۡنَآ","внушили Мы",35,31],["إِلَيۡكَ","тебе",35,31],["مِنَ","из",35,31],["ٱلۡكِتَٰبِ","Писания",35,31],["هُوَ","оно",35,31],["ٱلۡحَقُّ","истина",35,31],["مُصَدِّقٗا","подтверждающая",35,31],["لِّمَا","то, что",35,31],["بَيۡنَ","перед",35,31]],[["يَدَيۡهِۗ","ним (до него)",35,31],["إِنَّ","поистине",35,31],["ٱللَّهَ","Аллах",35,31],["بِعِبَادِهِۦ","о рабах Своих",35,31],["لَخَبِيرُۢ","непременно Сведущий",35,31],["بَصِيرٞ","Видящий",35,31],[31],["ثُمَّ","затем",35,32],["أَوۡرَثۡنَا","дали в наследие Мы",35,32],["ٱلۡكِتَٰبَ","Писание",35,32]],[["ٱلَّذِينَ","тем, которых",35,32],["ٱصۡطَفَيۡنَا","избрали Мы",35,32],["مِنۡ","из",35,32],["عِبَادِنَاۖ","рабов Наших",35,32],[