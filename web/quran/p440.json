{"p":440,"j":22,"a":[[35,45,["وَلَوۡ","يُؤَاخِذُ","ٱللَّهُ","ٱلنَّاسَ","بِمَا","كَسَبُواْ","مَا","تَرَكَ","عَلَىٰ","ظَهۡرِهَا","مِن","دَآبَّةٖ","وَلَٰكِن","يُؤَخِّرُهُمۡ","إِلَىٰٓ","أَجَلٖ","مُّسَمّٗىۖ","فَإِذَا","جَآءَ","أَجَلُهُمۡ","فَإِنَّ","ٱللَّهَ","كَانَ","بِعِبَادِهِۦ","بَصِيرَۢا"],"валау йу'ахизуллахун наса бима касабуу ма тарака `ала захриха мин даббатин валакин йу'аххирухум ила ажалим мусамман фа'иза жаа ажалухум фа'инналлаха кана би`ибадихии басиира","Если бы Аллах стал наказывать людей за то, что они приобретают, то Он не оставил бы на ее (земли) поверхности ни единого живого существа, но Он предоставляет им отсрочку до назначенного срока. Их срок настанет, и Аллах видит Своих рабов.",["и если бы","наказывал","Аллах","людей","за то, что","приобрели они","не","оставил бы Он","на","поверхности её","ни","одного существа","но","отсрочивает Он им","до","срока","назначенного","и когда","придёт","срок их","то поистине","Аллах","является","о рабах Своих","Видящим"]],[36,1,["يسٓ"],"йс","Йа. Син.",["Йа Син"]],[36,2,["وَٱلۡقُرۡءَانِ","ٱلۡحَكِيمِ"],"валḳур'анил хакиим","Клянусь мудрым Кораном!",["клянусь Кораном","мудрым"]],[36,3,["إِنَّكَ","لَمِنَ","ٱلۡمُرۡسَلِينَ"],"иннака ламинал мурсалиин","Воистину, ты - один из посланников",["поистине, ты","непременно из","посланников"]],[36,4,["عَلَىٰ","صِرَٰطٖ","مُّسۡتَقِيمٖ"],"`ала сиратим мустаḳиим","на прямом пути.",["на","пути","прямом"]],[36,5,["تَنزِيلَ","ٱلۡعَزِيزِ","ٱلرَّحِيمِ"],"танзиилал `азиизир рахиим","Он ниспослан Могущественным, Милосердным,",["ниспослание","Могущественного","Милосердного"]],[36,6,["لِتُنذِرَ","قَوۡمٗا","مَّآ","أُنذِرَ","ءَابَآؤُهُمۡ","فَهُمۡ","غَٰفِلُونَ"],"литунзира ḳаумам ма унзира абаухум фахум гафилуун","чтобы ты предостерег людей, отцов которых никто не предостерег, из-за чего они оставались беспечными невеждами.",["чтобы предостерёг ты","людей","не","были предостережены","отцы их","и они","беспечны"]],[36,7,["لَقَدۡ","حَقَّ","ٱلۡقَوۡلُ","عَلَىٰٓ","أَكۡثَرِهِمۡ","فَهُمۡ","لَا","يُؤۡمِنُونَ"],"лаḳад хаḳḳал ḳаулу `ала аксарихим фахум ла йу'минуун","Относительно большинства из них сбылось Слово, и они не уверуют.",["уже","сбылось","слово","относительно","большинства из них","и они","не","уверуют"]],[36,8,["إِنَّا","جَعَلۡنَا","فِيٓ","أَعۡنَٰقِهِمۡ","أَغۡلَٰلٗا","فَهِيَ","إِلَى","ٱلۡأَذۡقَانِ","فَهُم","مُّقۡمَحُونَ"],"инна жа`ална фии а`наḳихим аглалан фахийа илал азḳани фахум муḳмахуун","Воистину, Мы наложили на их шеи оковы до самого подбородка, и их головы задраны.",["поистине, Мы","наложили Мы","на","шеи их","оковы","и они","до","подбородков","и они","с задранными головами"]],[36,9,["وَجَعَلۡنَا","مِنۢ","بَيۡنِ","أَيۡدِيهِمۡ","سَدّٗا","وَمِنۡ","خَلۡفِهِمۡ","سَدّٗا","فَأَغۡشَيۡنَٰهُمۡ","فَهُمۡ","لَا","يُبۡصِرُونَ"],"важа`ална мим байни айдиихим саддан вамин халфихим саддан фа'агшайнахум фахум ла йубсируун","Мы установили преграду перед ними и преграду позади них и накрыли их покрывалом, и они не видят.",["и установили Мы","из","между","руками их (впереди)","преграду","и из","позади них","преграду","и покрыли Мы их","и они","не","видят"]],[36,10,["وَسَوَآءٌ","عَلَيۡهِمۡ","ءَأَنذَرۡتَهُمۡ","أَمۡ","لَمۡ","تُنذِرۡهُمۡ","لَا","يُؤۡمِنُونَ"],"васаваун `алайхим а'анзартахум ам лам тунзирхум ла йу'минуун","Им все равно, предостерег ты их или не предостерег. Они не веруют.",["и одинаково","для них","предостерег ли ты их","или","не","предостерег их","не","уверуют"]],[36,11,["إِنَّمَا","تُنذِرُ","مَنِ","ٱتَّبَعَ","ٱلذِّكۡرَ","وَخَشِيَ","ٱلرَّحۡمَٰنَ","بِٱلۡغَيۡبِۖ","فَبَشِّرۡهُ","بِمَغۡفِرَةٖ","وَأَجۡرٖ","كَرِيمٍ"],"иннама тунзиру маниттаба`аз зикра вахашийар рахмана билгайби фабашширху бимагфиратин ва'ажрин кариим","Ты можешь предостеречь только того, кто последовал за Напоминанием и устрашился Милостивого, не видя Его воочию. Обрадуй его вестью о прощении и щедрой награде.",["лишь","предостерегаешь ты","того, кто","последовал","Напоминанию","и устрашился","Милостивого","втайне (не видя)","обрадуй же его","прощением","и наградой","щедрой"]],[36,12,["إِنَّا","نَحۡنُ","نُحۡيِ","ٱلۡمَوۡتَىٰ","وَنَكۡتُبُ","مَا","قَدَّمُواْ","وَءَاثَٰرَهُمۡۚ","وَكُلَّ","شَيۡءٍ","أَحۡصَيۡنَٰهُ","فِيٓ","إِمَامٖ","مُّبِينٖ"],"инна нахну нухйил маута ванактубу ма ḳаддамуу ва'асарахум вакулла шай'ин ахсайнаху фии имамим мубиин","Воистину, Мы оживляем мертвых и записываем то, что они совершили, и то, что они оставили после себя. Всякую вещь Мы подсчитали в ясном руководстве (Хранимой скрижали).",["поистине, Мы","Мы","оживляем","мёртвых","и записываем Мы","то, что","уготовили они","и следы их","и всякую","вещь","исчислили Мы её","в","книге","ясной"]]],"m":[[["وَلَوۡ","и если бы",35,45],["يُؤَاخِذُ","наказывал",35,45],["ٱللَّهُ","Аллах",35,45],["ٱلنَّاسَ","людей",35,45],["بِمَا","за то, что",35,45],["كَسَبُواْ","приобрели они",35,45],["مَا","не",35,45],["تَرَكَ","оставил бы Он",35,45],["عَلَىٰ","на",35,45]],[["ظَهۡرِهَا","поверхности её",35,45],["مِن","ни",35,45],["دَآبَّةٖ","одного существа",35,45],["وَلَٰكِن","но",35,45],["يُؤَخِّرُهُمۡ","отсрочивает Он им",35,45],["إِلَىٰٓ","до",35,45],["أَجَلٖ","срока",35,45],["مُّسَمّٗىۖ","назначенного",35,45]],[["فَإِذَا","и когда",35,45],["جَآءَ","придёт",35,45],["أَجَلُهُمۡ","срок их",35,45],["فَإِنَّ","то поистине",35,45],["ٱللَّهَ","Аллах",35,45],["كَانَ","является",35,45],["بِعِبَادِهِۦ","о рабах Своих",35,45],["بَصِيرَۢا","Видящим",35,45],[45]],["h",36],["b"],[["يسٓ","Йа Син",36,1],[1],["وَٱلۡقُرۡءَانِ","клянусь Кораном",36,2],["ٱلۡحَكِيمِ","мудрым",36,2],[2],["إِنَّكَ","поистине, ты",36,3],["لَمِنَ","непременно из",36,3],["ٱلۡمُرۡسَلِينَ","посланников",36,3],[3],["عَلَىٰ","на",36,4]],[["صِرَٰطٖ","пути",36,4],["مُّسۡتَقِيمٖ","прямом",36,4],[4],["تَنزِيلَ","ниспослание",36,5],["ٱلۡعَزِيزِ","Могущественного",36,5],["ٱلرَّحِيمِ","Милосердного",36,5],[5],["لِتُنذِرَ","чтобы предостерёг ты",36,6],["قَوۡمٗا","людей",36,6],["مَّآ","не",36,6]],[["أُنذِرَ","были предостережены",36,6],["ءَابَآؤُهُمۡ","отцы их",36,6],["فَهُمۡ","и они",36,6],["غَٰفِلُونَ","беспечны",36,6],[6],["لَقَدۡ","уже",36,7],["حَقَّ","сбылось",36,7],["ٱلۡقَوۡلُ","слово",36,7],["عَلَىٰٓ","относительно",36,7],["أَكۡثَرِهِمۡ","большинства из них",36,7]],[["فَهُمۡ","и они",36,7],["لَا","не",36,7],["يُؤۡمِنُونَ","уверуют",36,7],[7],["إِنَّا","поистине, Мы",36,8],["جَعَلۡنَا","наложили Мы",36,8],["فِيٓ","на",36,8],["أَعۡنَٰقِهِمۡ","шеи их",36,8],["أَغۡلَٰلٗا","оковы",36,8],["فَهِيَ","и они",36,8],["إِلَى","до",36,8]],[["ٱلۡأَذۡقَانِ","подбородков",36,8],["فَهُم","и они",36,8],["مُّقۡمَحُونَ","с задранными головами",36,8],[8],["وَجَعَلۡنَا","и установили Мы",36,9],["مِنۢ","из",36,9],["بَيۡنِ","между",36,9],["أَيۡدِيهِمۡ","руками их (впереди)",36,9],["سَدّٗا","преграду",36,9]],[["وَمِنۡ","и из",36,9],["خَلۡفِهِمۡ","позади них",36,9],["سَدّٗا","преграду",36,9],["فَأَغۡشَيۡنَٰهُمۡ","и покрыли Мы их",36,9],["فَهُمۡ","и они",36,9],["لَا","не",36,9],["يُبۡصِرُونَ","видят",36,9],[9],["وَسَوَآءٌ","и одинаково",36,10]],[["عَلَيۡهِمۡ","для них",36,10],["ءَأَنذَرۡتَهُمۡ","предостерег ли ты их",36,10],["أَمۡ","или",36,10],["لَمۡ","не",36,10],["تُنذِرۡهُمۡ","предостерег их",36,10],["لَا","не",36,10],["يُؤۡمِنُونَ","уверуют",36,10],[10],["إِنَّمَا","лишь",36,11],["تُنذِرُ","предостерегаешь ты",36,11]],[["مَنِ","того, кто",36,11],["ٱتَّبَعَ","последовал",36,11],["ٱلذِّكۡرَ","Напоминанию",36,11],["وَخَشِيَ","и устрашился",36,11],["ٱلرَّحۡمَٰنَ","Милостивого",36,11],["بِٱلۡغَيۡبِۖ","втайне (не видя)",36,11],["فَبَشِّرۡهُ","обрадуй же его",36,11],["بِمَغۡفِرَةٖ","прощением",36,11]],[["وَأَجۡرٖ","и наградой",36,11],["كَرِيمٍ","щедрой",36,11],[11],["إِنَّا","поистине, Мы",36,12],["نَحۡنُ","Мы",36,12],["نُحۡيِ","оживляем",36,12],["ٱلۡمَوۡتَىٰ","мёртвых",36,12],["وَنَكۡتُبُ","и записываем Мы",36,12]],[["مَا","то, что",36,12],["قَدَّمُواْ","уготовили они",36,12],["وَءَاثَٰرَهُمۡۚ","и следы их",36,12],["وَكُلَّ","и всякую",36,12],["شَيۡءٍ","вещь",36,12],["أَحۡصَيۡنَٰهُ","исчислили Мы её",36,12],["فِيٓ","в",36,12],["إِمَامٖ","книге",36,12],["مُّبِينٖ","ясной",36,12],[12]]]}