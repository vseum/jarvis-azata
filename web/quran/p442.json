{"p":442,"j":23,"a":[[36,28,["وَمَآ","أَنزَلۡنَا","عَلَىٰ","قَوۡمِهِۦ","مِنۢ","بَعۡدِهِۦ","مِن","جُندٖ","مِّنَ","ٱلسَّمَآءِ","وَمَا","كُنَّا","مُنزِلِينَ"],"вама анзална `ала ḳаумихии мим ба`дихии мин жундим минас самаи вама кунна мунзилиин","После него Мы не ниспослали на его народ никакого войска с неба и не собирались делать этого.",["И не","ниспослали Мы","на","народ его","из","после него","никакого","войска","с","неба","и не","были Мы","ниспосылающими"]],[36,29,["إِن","كَانَتۡ","إِلَّا","صَيۡحَةٗ","وَٰحِدَةٗ","فَإِذَا","هُمۡ","خَٰمِدُونَ"],"ин канат илла сайхатан вахидатан фа'иза хум хамидуун","Был всего лишь один глас, и они затухли.",["Не","было","кроме","гласа","одного","и вот","они","угасшие"]],[36,30,["يَٰحَسۡرَةً","عَلَى","ٱلۡعِبَادِۚ","مَا","يَأۡتِيهِم","مِّن","رَّسُولٍ","إِلَّا","كَانُواْ","بِهِۦ","يَسۡتَهۡزِءُونَ"],"йахасратан `алал `ибади ма йа'тиихим мир расуулин илла кануу бихии йастахзиуун","О горе рабам! Не приходил к ним ни один посланник, над которым бы они не издевались.",["О горе","над","рабами","Не","приходит к ним","ни один","посланник","без того чтобы","были они","над ним","насмехаются"]],[36,31,["أَلَمۡ","يَرَوۡاْ","كَمۡ","أَهۡلَكۡنَا","قَبۡلَهُم","مِّنَ","ٱلۡقُرُونِ","أَنَّهُمۡ","إِلَيۡهِمۡ","لَا","يَرۡجِعُونَ"],"алам йарау кам ахлакна ḳаблахум минал ḳурууни аннахум илайхим ла йаржи`уун","Неужели они не видят, сколько поколений Мы погубили до них и что они не вернутся к ним?",["Разве не","видят они","сколько","погубили Мы","до них","из","поколений","что они","к ним","не","возвращаются"]],[36,32,["وَإِن","كُلّٞ","لَّمَّا","جَمِيعٞ","لَّدَيۡنَا","مُحۡضَرُونَ"],"ва'ин куллул ламма жамии`ул ладайна мухдаруун","Воистину, все они будут собраны у Нас.",["И поистине","все","непременно","вместе","у Нас","представлены будут"]],[36,33,["وَءَايَةٞ","لَّهُمُ","ٱلۡأَرۡضُ","ٱلۡمَيۡتَةُ","أَحۡيَيۡنَٰهَا","وَأَخۡرَجۡنَا","مِنۡهَا","حَبّٗا","فَمِنۡهُ","يَأۡكُلُونَ"],"ва'айатул лахумул ардул майтату ахйайнаха ва'ахражна минха хаббан фаминху йа'кулуун","Знамением для них является мертвая земля, которую Мы оживили и извлекли из нее зерно, которым они питаются.",["И знамение","для них","земля","мёртвая","оживили Мы её","и вывели Мы","из неё","зерно","и из него","едят они"]],[36,34,["وَجَعَلۡنَا","فِيهَا","جَنَّٰتٖ","مِّن","نَّخِيلٖ","وَأَعۡنَٰبٖ","وَفَجَّرۡنَا","فِيهَا","مِنَ","ٱلۡعُيُونِ"],"важа`ална фииха жаннатим мин нахиилин ва'а`набин вафажжарна фииха минал `уйуун","Мы создали на ней сады из финиковых пальм и винограда и заставили биться в них источники,",["И сделали Мы","на ней","сады","из","финиковых пальм","и виноградных лоз","и заставили Мы забить","на ней","из","источников"]],[36,35,["لِيَأۡكُلُواْ","مِن","ثَمَرِهِۦ","وَمَا","عَمِلَتۡهُ","أَيۡدِيهِمۡۚ","أَفَلَا","يَشۡكُرُونَ"],"лийа'кулуу мин самарихии вама `амилатху айдиихим афала йашкуруун","чтобы они вкушали их плоды и то, что создали своими руками (или чтобы они вкушали плоды, которые они не создали своими руками). Неужели они не будут благодарны?",["Чтобы ели они","из","плодов его","и то, что","сделали это","руки их","Неужели не","благодарят они"]],[36,36,["سُبۡحَٰنَ","ٱلَّذِي","خَلَقَ","ٱلۡأَزۡوَٰجَ","كُلَّهَا","مِمَّا","تُنۢبِتُ","ٱلۡأَرۡضُ","وَمِنۡ","أَنفُسِهِمۡ","وَمِمَّا","لَا","يَعۡلَمُونَ"],"субханал лазии халаḳал азважа куллаха мимма тумбитул арду вамин анфусихим вамимма ла йа`ламуун","Пречист Тот, Кто сотворил парами то, что растит земля, их самих и то, чего они не знают.",["Пречист","Тот, Который","сотворил","пары","все их","из того, что","выращивает","земля","и из","них самих","и из того, что","не","знают они"]],[36,37,["وَءَايَةٞ","لَّهُمُ","ٱلَّيۡلُ","نَسۡلَخُ","مِنۡهُ","ٱلنَّهَارَ","فَإِذَا","هُم","مُّظۡلِمُونَ"],"ва'айатул лахумул лайлу наслаху минхун нахара фа'иза хум музлимуун","Знамением для них является ночь, которую Мы отделяем ото дня, и вот они погружаются во мрак.",["И знамение","для них","ночь","совлекаем Мы","с неё","день","и вот","они","во мраке"]],[36,38,["وَٱلشَّمۡسُ","تَجۡرِي","لِمُسۡتَقَرّٖ","لَّهَاۚ","ذَٰلِكَ","تَقۡدِيرُ","ٱلۡعَزِيزِ","ٱلۡعَلِيمِ"],"вашшамсу тажрии лимустаḳаррил лаха залика таḳдиирул `азиизил `алиим","Солнце плывет к своему местопребыванию. Так предопределил Могущественный, Знающий.",["и солнце","течет","к пристанищу","своему","это","предопределение","Могущественного","Знающего"]],[36,39,["وَٱلۡقَمَرَ","قَدَّرۡنَٰهُ","مَنَازِلَ","حَتَّىٰ","عَادَ","كَٱلۡعُرۡجُونِ","ٱلۡقَدِيمِ"],"валḳамара ḳаддарнаху маназила хатта `ада кал`уржуунил ḳадиим","Мы предопределили для луны положения, пока она вновь не становится подобна старой пальмовой ветви.",["И луну","предопределили Мы ей","стоянки","пока не","вернётся","как пальмовая ветвь","старая"]],[36,40,["لَا","ٱلشَّمۡسُ","يَنۢبَغِي","لَهَآ","أَن","تُدۡرِكَ","ٱلۡقَمَرَ","وَلَا","ٱلَّيۡلُ","سَابِقُ","ٱلنَّهَارِۚ","وَكُلّٞ","فِي","فَلَكٖ","يَسۡبَحُونَ"],"лаш шамсу йамбагии лаха ан тудрикал ḳамара валал лайлу сабиḳун нахари вакуллун фии фалакин йасбахуун","Солнцу не надлежит догонять луну, и ночь не опережает день. Каждый плывет по орбите.",["Не","солнце","подобает","ему","чтобы","догнало","луну","и не","ночь","опережает","день","и все","по","орбите","плывут"]]],"m":[[["۞ وَمَآ","И не",36,28],["أَنزَلۡنَا","ниспослали Мы",36,28],["عَلَىٰ","на",36,28],["قَوۡمِهِۦ","народ его",36,28],["مِنۢ","из",36,28],["بَعۡدِهِۦ","после него",36,28],["مِن","никакого",36,28],["جُندٖ","войска",36,28],["مِّنَ","с",36,28],["ٱلسَّمَآءِ","неба",36,28],["وَمَا","и не",36,28]],[["كُنَّا","были Мы",36,28],["مُنزِلِينَ","ниспосылающими",36,28],[28],["إِن","Не",36,29],["كَانَتۡ","было",36,29],["إِلَّا","кроме",36,29],["صَيۡحَةٗ","гласа",36,29],["وَٰحِدَةٗ","одного",36,29],["فَإِذَا","и вот",36,29],["هُمۡ","они",36,29],["خَٰمِدُونَ","угасшие",36,29]],[[29],["يَٰحَسۡرَةً","О горе",36,30],["عَلَى","над",36,30],["ٱلۡعِبَادِۚ","рабами",36,30],["مَا","Не",36,30],["يَأۡتِيهِم","приходит к ним",36,30],["مِّن","ни один",36,30],["رَّسُولٍ","посланник",36,30],["إِلَّا","без того чтобы",36,30],["كَانُواْ","были они",36,30],["بِهِۦ","над ним",36,30]],[["يَسۡتَهۡزِءُونَ",