{"p":443,"j":23,"a":[[36,41,["وَءَايَةٞ","لَّهُمۡ","أَنَّا","حَمَلۡنَا","ذُرِّيَّتَهُمۡ","فِي","ٱلۡفُلۡكِ","ٱلۡمَشۡحُونِ"],"ва'айатул лахум анна хамална зурриййатахум фил фулкил машхуун","Знамением для них является то, что Мы перенесли их потомство в переполненном ковчеге.",["и знамение","для них","что Мы","перенесли","их потомство","в","ковчеге","переполненном"]],[36,42,["وَخَلَقۡنَا","لَهُم","مِّن","مِّثۡلِهِۦ","مَا","يَرۡكَبُونَ"],"вахалаḳна лахум мим мислихии ма йаркабуун","Мы создали для них по его подобию то, на что они садятся.",["и Мы сотворили","для них","из","подобного ему","то, что","садятся верхом"]],[36,43,["وَإِن","نَّشَأۡ","نُغۡرِقۡهُمۡ","فَلَا","صَرِيخَ","لَهُمۡ","وَلَا","هُمۡ","يُنقَذُونَ"],"ва'ин наша' нугриḳхум фала сарииха лахум вала хум йунḳазуун","Если Мы пожелаем, то потопим их, и тогда никто не спасет их, и сами они не спасутся,",["И если","пожелаем Мы","потопим Мы их","и не","будет помощника","им","и не","они","будут спасены"]],[36,44,["إِلَّا","رَحۡمَةٗ","مِّنَّا","وَمَتَٰعًا","إِلَىٰ","حِينٖ"],"илла рахматам минна вамата`ан ила хиин","если только Мы не окажем им милость и не позволим им пользоваться благами до определенного времени.",["Кроме как","по милости","от Нас","и пользования","до","времени"]],[36,45,["وَإِذَا","قِيلَ","لَهُمُ","ٱتَّقُواْ","مَا","بَيۡنَ","أَيۡدِيكُمۡ","وَمَا","خَلۡفَكُمۡ","لَعَلَّكُمۡ","تُرۡحَمُونَ"],"ва'иза ḳиила лахумуттаḳуу ма байна айдиикум вама халфакум ла`аллакум турхамуун","Когда им говорят: «Бойтесь того, что перед вами, и того, что после вас, чтобы вы были помилованы», - они не отвечают.",["И когда","сказано","им","Бойтесь","того, что","между","руками вашими","и того, что","позади вас","чтобы вы","были помилованы"]],[36,46,["وَمَا","تَأۡتِيهِم","مِّنۡ","ءَايَةٖ","مِّنۡ","ءَايَٰتِ","رَبِّهِمۡ","إِلَّا","كَانُواْ","عَنۡهَا","مُعۡرِضِينَ"],"вама та'тиихим мин айатим мин айати раббихим илла кануу `анха му`ридиин","Какое бы знамение из знамений их Господа не явилось к ним, они непременно отворачиваются от него.",["И не","приходит к ним","ни одно","знамение","из","знамений","Господа их","без того чтобы","были они","от него","отворачивающимися"]],[36,47,["وَإِذَا","قِيلَ","لَهُمۡ","أَنفِقُواْ","مِمَّا","رَزَقَكُمُ","ٱللَّهُ","قَالَ","ٱلَّذِينَ","كَفَرُواْ","لِلَّذِينَ","ءَامَنُوٓاْ","أَنُطۡعِمُ","مَن","لَّوۡ","يَشَآءُ","ٱللَّهُ","أَطۡعَمَهُۥٓ","إِنۡ","أَنتُمۡ","إِلَّا","فِي","ضَلَٰلٖ","مُّبِينٖ"],"ва'иза ḳиила лахум анфиḳуу мимма разаḳакумуллаху ḳалал лазиина кафаруу лиллазиина амануу анут`иму мал лау йашауллаху ат`амахуу ин антум илла фии далалим мубиин","Когда им говорят: «Расходуйте из того, чем вас наделил Аллах», - неверующие говорят верующим: «Неужели мы будем кормить того, кого накормил бы Аллах, если бы пожелал? Воистину, вы лишь находитесь в очевидном заблуждении».",["И когда","сказано","им","Расходуйте","из того, что","наделил вас","Аллах","сказали","те, которые","не уверовали","тем, которые","уверовали","Разве накормим мы","того, кого","если бы","пожелал","Аллах","накормил бы Он его","Не","вы","кроме как","в","заблуждении","явном"]],[36,48,["وَيَقُولُونَ","مَتَىٰ","هَٰذَا","ٱلۡوَعۡدُ","إِن","كُنتُمۡ","صَٰدِقِينَ"],"вайаḳуулууна мата хазал ва`ду ин кунтум садиḳиин","Они говорят: «Когда сбудется это обещание, если вы говорите правду?».",["и говорят","когда","это","обещание","если","вы","правдивы"]],[36,49,["مَا","يَنظُرُونَ","إِلَّا","صَيۡحَةٗ","وَٰحِدَةٗ","تَأۡخُذُهُمۡ","وَهُمۡ","يَخِصِّمُونَ"],"ма йанзурууна илла сайхатан вахидатан та'хузухум вахум йахиссимуун","Им нечего ожидать, кроме одного только гласа, который поразит их тогда, когда они будут препираться.",["Не","ожидают они","кроме","гласа","одного","схватит он их","в то время как они","препираются"]],[36,50,["فَلَا","يَسۡتَطِيعُونَ","تَوۡصِيَةٗ","وَلَآ","إِلَىٰٓ","أَهۡلِهِمۡ","يَرۡجِعُونَ"],"фала йастатии`ууна таусийатан вала ила ахлихим йаржи`уун","Они не смогут ни оставить завещание, ни вернуться к своим семьям.",["и не","смогут","завещания","и не","к","своим семьям","вернутся"]],[36,51,["وَنُفِخَ","فِي","ٱلصُّورِ","فَإِذَا","هُم","مِّنَ","ٱلۡأَجۡدَاثِ","إِلَىٰ","رَبِّهِمۡ","يَنسِلُونَ"],"вануфиха фис суури фа'иза хум минал аждаси ила раббихим йансилуун","Протрубят в Рог, и вот они устремляются к своему Господу из могил.",["И подуто будет","в","Рог","и вот","они","из","могил","к","Господу своему","устремляются"]],[36,52,["قَالُواْ","يَٰوَيۡلَنَا","مَنۢ","بَعَثَنَا","مِن","مَّرۡقَدِنَاۜۗ","هَٰذَا","مَا","وَعَدَ","ٱلرَّحۡمَٰنُ","وَصَدَقَ","ٱلۡمُرۡسَلُونَ"],"ḳалуу йавайлана мам ба`асана мим марḳадина хаза ма ва`адар рахману васадаḳал мурсалуун","Они скажут: «О горе нам! Кто поднял нас с места, где мы спали?». Это - то, что обещал Милостивый, и посланники говорили правду».",["Скажут они","О горе нам","Кто","поднял нас","из","места сна нашего","Это","то, что","обещал","Милостивый","и правду сказали","посланники"]],[36,53,["إِن","كَانَتۡ","إِلَّا","صَيۡحَةٗ","وَٰحِدَةٗ","فَإِذَا","هُمۡ","جَمِيعٞ","لَّدَيۡنَا","مُحۡضَرُونَ"],"ин канат илла сайхатан вахидатан фа'иза хум жамии`ул ладайна мухдаруун","Будет один только глас, и все они будут собраны у Нас.",["Не","будет","кроме","гласа","одного","и вот","они","все вместе","у Нас","представлены будут"]],[36,54,["فَٱلۡيَوۡمَ","لَا","تُظۡلَمُ","نَفۡسٞ","شَيۡـٔٗا","وَلَا","تُجۡزَوۡنَ","إِلَّا","مَا","كُنتُمۡ","تَعۡمَلُونَ"],"фалйаума ла тузламу нафсун шай'ан вала тужзауна илла ма кунтум та`малуун","Сегодня ни одной душе не будет причинено никакой несправедливости, и вам воздастся только за то, что вы совершали.",["И сегодня","не","будет обижена","душа","ни в чём","и не","будете вознаграждены","кроме как","за то, что","были вы","делаете"]]],"m":[[["وَءَايَةٞ","и знамение",36,41],["لَّهُمۡ","для них",36,41],["أَنَّا","что Мы",36,41],["حَمَلۡنَا","перенесли",36,41],["ذُرِّيَّتَهُمۡ","их потомство",36,41],["فِي","в",36,41],["ٱلۡفُلۡكِ","ковчеге",36,41],["ٱلۡمَشۡحُونِ","переполненном",36,41],[41],["وَخَلَقۡنَا","и Мы сотворили",36,42]],[["لَهُم","для них",36,42],["مِّن","из",36,42],["مِّثۡلِهِۦ","подобного ему",36,42],["مَا","то, что",36,42],["يَرۡكَبُونَ","садятся верхом",36,42],[42],["وَإِن","И если",36,43],["نَّشَأۡ","пожелаем Мы",36,43],["نُغۡرِقۡهُمۡ","потопим Мы их",36,43],["فَلَا","и не",36,43],["صَرِيخَ","будет помощника",36,43],["لَهُمۡ","им",36,43]],[["وَلَا","и не",36,43],["هُمۡ","они",36,43],["يُنقَذُونَ","будут спасены",36,43],[43],["إِلَّا","Кроме как",36,44],["رَحۡمَةٗ","по милости",36,44],["مِّنَّا","от Нас",36,44],["وَمَتَٰعًا","и пользования",36,44],["إِلَىٰ","до",36,44],["حِينٖ","времени",36,44],[44],["وَإِذَا","И когда",36,45]],[["قِيلَ","сказано",36,45],["لَهُمُ","им",36,45],["ٱتَّقُواْ","Бойтесь",36,45],["مَا","того, что",36,45],["بَيۡنَ","между",36,45],["أَيۡدِيكُمۡ","руками вашими",36,45],["وَمَا","и того, что",36,45],["خَلۡفَكُمۡ","позади вас",36,45],["لَعَلَّكُمۡ","чтобы вы",36,45],["تُرۡحَمُونَ","были помилованы",36,45],[45]],[["وَمَا","И не",36,46],["تَأۡتِيهِم","приходит к ним",36,46],["مِّنۡ","ни одно",36,46],["ءَايَةٖ","знамение",36,46],["مِّنۡ","из",36,46],["ءَايَٰتِ","знамений",36,46],["رَبِّهِمۡ","Господа их",36,46],["إِلَّا","без того чтобы",36,46],["كَانُواْ","были они",36,46],["عَنۡهَا","от него",36,46],["مُعۡرِضِينَ","отворачивающимися",36,46]],[[46],["وَإِذَا","И когда",36,47],["قِيلَ","сказано",36,47],["لَهُمۡ","им",36,47],["أَنفِقُواْ","Расходуйте",36,47],["مِمَّا","из того, что",36,47],["رَزَقَكُمُ","наделил вас",36,47],["ٱللَّهُ","Аллах",36,47],["قَالَ","сказали",36,47],["ٱلَّذِينَ","те, которые",36,47],["كَفَرُواْ","не уверовали",36,47]],[["لِلَّذِينَ","тем, которые",36,47],["ءَامَنُوٓاْ","уверовали",36,47],["أَنُطۡعِمُ","Разве накормим мы",36,47],["مَن","того, кого",36,47],["لَّوۡ","если бы",36,47],["يَشَآءُ","пожелал",36,47],["ٱللَّهُ","Аллах",36,47],["أَطۡعَمَهُۥٓ","накормил бы Он его",36,47],["إِنۡ","Не",36,47],["أَنتُمۡ","вы",36,47],["إِلَّا","кроме как",36,47],["فِي","в",36,47]],[["ضَلَٰلٖ","заблуждении",36,47],["مُّبِينٖ","явном",36,47],[47],["وَيَقُولُونَ","и говорят",36,48],["مَتَىٰ","когда",36,48],["هَٰذَا","это",36,48],["ٱلۡوَعۡدُ","обещание",36,48],["إِن","если",36,48],["كُنتُمۡ","вы",36,48],["صَٰدِقِينَ","правдивы",36,48]],[[48],["مَا","Не",36,49],["يَنظُرُونَ","ожидают они",36,49],["إِلَّا","кроме",36,49],["صَيۡحَةٗ","гласа",36,49],["وَٰحِدَةٗ","одного",36,49],["تَأۡخُذُهُمۡ","схватит он их",36,49],["وَهُمۡ","в то время как они",36,49],["يَخِصِّمُونَ","препираются",36,49]],[[49],["فَلَا","и не",36,50],["يَسۡتَطِيعُونَ","смогут",36,50],["تَوۡصِيَةٗ","завещания",36,50],["وَلَآ","и не",36,50],["إِلَىٰٓ","к",36,50],["أَهۡلِهِمۡ","своим семьям",36,50],["يَرۡجِعُونَ","вернутся",36,50],[50]],[["وَنُفِخَ","И подуто будет",36,51],["فِي","в",36,51],["ٱلصُّورِ","Рог",36,51],["فَإِذَا","и вот",36,51],["هُم","они",36,51],["مِّنَ","из",36,51],["ٱلۡأَجۡدَاثِ","могил",36,51],["إِلَىٰ","к",36,51],["رَبِّهِمۡ","Господу своему",36,51],["يَنسِلُونَ","устремляются",36,51]],[[51],["قَالُواْ","Скажут они",36,52],["يَٰوَيۡلَنَا","О горе нам",36,52],["مَنۢ","Кто",36,52],["بَعَثَنَا","поднял нас",36,52],["مِن","из",36,52],["مَّرۡقَدِنَاۜۗ","места сна нашего",36,52],["هَٰذَا","Это",36,52],["مَا","то, что",36,52],["وَعَدَ","обещал",36,52],["ٱلرَّحۡمَٰنُ","Милостивый",36,52],["وَصَدَقَ","и правду сказали",36,52]],[["ٱلۡمُرۡسَلُونَ","посланники",36,52],[52],["إِن","Не",36,53],["كَانَتۡ","будет",36,53],["إِلَّا","кроме",36,53],["صَيۡحَةٗ","гласа",36,53]],[["وَٰحِدَةٗ","одного",36,53],["فَإِذَا","и вот",36,53],["هُمۡ","они",36,53],["جَمِيعٞ","все вместе",36,53],["لَّدَيۡنَا","у Нас",36,53],["مُحۡضَرُونَ","представлены будут",36,53],[53],["فَٱلۡيَوۡمَ","И сегодня",36,54],["لَا","не",36,54],["تُظۡلَمُ","будет обижена",36,54]],[["نَفۡسٞ","душа",36,54],["شَيۡـٔٗا","ни в чём",36,54],["وَلَا","и не",36,54],["تُجۡزَوۡنَ","будете вознаграждены",36,54],["إِلَّا","кроме как",36,54],["مَا","за то, что",36,54],["كُنتُمۡ","были вы",36,54],["تَعۡمَلُونَ","делаете",36,54],[54]]]}