{"p":445,"j":23,"a":[[36,71,["أَوَلَمۡ","يَرَوۡاْ","أَنَّا","خَلَقۡنَا","لَهُم","مِّمَّا","عَمِلَتۡ","أَيۡدِينَآ","أَنۡعَٰمٗا","فَهُمۡ","لَهَا","مَٰلِكُونَ"],"авалам йарау анна халаḳна лахум мимма `амилат айдиина ан`аман фахум лаха маликуун","Неужели они не видят, что из того, что совершили Наши руки (Мы Сами), Мы создали для них скот, и что они им владеют?",["Разве не","видят они","что Мы","сотворили","для них","из того, что","сделали","руки Наши","скот","и они","им","владеющие"]],[36,72,["وَذَلَّلۡنَٰهَا","لَهُمۡ","فَمِنۡهَا","رَكُوبُهُمۡ","وَمِنۡهَا","يَأۡكُلُونَ"],"вазаллалнаха лахум фаминха ракуубухум ваминха йа'кулуун","Мы сделали его подвластным им. На одних из них они ездят верхом, а другими питаются.",["и Мы подчинили их","им","и на одних из них","их езда","и других из них","едят"]],[36,73,["وَلَهُمۡ","فِيهَا","مَنَٰفِعُ","وَمَشَارِبُۚ","أَفَلَا","يَشۡكُرُونَ"],"валахум фииха манафи`у вамашарибу афала йашкуруун","Они приносят им пользу и питье. Неужели они не будут благодарны?",["И для них","в нём","польза","и питьё","Неужели не","благодарят они"]],[36,74,["وَٱتَّخَذُواْ","مِن","دُونِ","ٱللَّهِ","ءَالِهَةٗ","لَّعَلَّهُمۡ","يُنصَرُونَ"],"ваттахазуу мин дууниллахи алихатал ла`аллахум йунсаруун","Но они поклоняются вместо Аллаха другим богам в надежде на то, что им окажут помощь.",["и взяли","из","помимо","Аллаха","богов","может быть, им","окажут помощь"]],[36,75,["لَا","يَسۡتَطِيعُونَ","نَصۡرَهُمۡ","وَهُمۡ","لَهُمۡ","جُندٞ","مُّحۡضَرُونَ"],"ла йастатии`ууна насрахум вахум лахум жундум мухдаруун","Они не могут помочь им, хотя они являются для них готовым войском (язычники готовы сражаться за своих идолов, или идолы будут в Последней жизни готовым войском против язычников).",["Не","могут они","помочь им","и они","для них","войско","представленное"]],[36,76,["فَلَا","يَحۡزُنكَ","قَوۡلُهُمۡۘ","إِنَّا","نَعۡلَمُ","مَا","يُسِرُّونَ","وَمَا","يُعۡلِنُونَ"],"фала йахзунка ḳаулухум инна на`ламу ма йусиррууна вама йу`линуун","Пусть их речи не печалят тебя. Мы знаем то, что они скрывают, и то, что они обнаруживают.",["Так пусть не","печалят тебя","слова их","Поистине, Мы","знаем","то, что","скрывают они","и то, что","обнаруживают они"]],[36,77,["أَوَلَمۡ","يَرَ","ٱلۡإِنسَٰنُ","أَنَّا","خَلَقۡنَٰهُ","مِن","نُّطۡفَةٖ","فَإِذَا","هُوَ","خَصِيمٞ","مُّبِينٞ"],"авалам йарал инсану анна халаḳнаху мин нутфатин фа'иза хуа хасиимум мубиин","Неужели человек не видит, что Мы сотворили его из капли? И вот он открыто препирается!",["Разве не","видит","человек","что Мы","сотворили его","из","капли семени","и вот","он","спорщик","явный"]],[36,78,["وَضَرَبَ","لَنَا","مَثَلٗا","وَنَسِيَ","خَلۡقَهُۥۖ","قَالَ","مَن","يُحۡيِ","ٱلۡعِظَٰمَ","وَهِيَ","رَمِيمٞ"],"вадараба лана масалан ванасийа халḳахуу ḳала ман йухйил `изама вахийа рамиим","Он привел Нам притчу и забыл о своем сотворении. Он сказал: «Кто оживит кости, которые истлели?».",["И привёл он","Нам","пример","и забыл","сотворение своё","Сказал он","Кто","оживит","кости","в то время как они","истлевшие"]],[36,79,["قُلۡ","يُحۡيِيهَا","ٱلَّذِيٓ","أَنشَأَهَآ","أَوَّلَ","مَرَّةٖۖ","وَهُوَ","بِكُلِّ","خَلۡقٍ","عَلِيمٌ"],"ḳул йухйиихал лазии аншааха аввала марратин вахуа бикулли халḳин `алиим","Скажи: «Оживит их Тот, Кто создал их в первый раз. Он ведает о всяком творении».",["Скажи","оживит их","Тот, Который","создал их","в первый","раз","и Он","о всяком","творении","Знающий"]],[36,80,["ٱلَّذِي","جَعَلَ","لَكُم","مِّنَ","ٱلشَّجَرِ","ٱلۡأَخۡضَرِ","نَارٗا","فَإِذَآ","أَنتُم","مِّنۡهُ","تُوقِدُونَ"],"аллазии жа`ала лакум минаш шажарил ахдари наран фа'иза антум минху тууḳидуун","Он создал для вас огонь из зеленого дерева, и теперь вы разжигаете огонь от него.",["Тот, Который","сделал","для вас","из","дерева","зелёного","огонь","и вот","вы","от него","разжигаете"]],[36,81,["أَوَلَيۡسَ","ٱلَّذِي","خَلَقَ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضَ","بِقَٰدِرٍ","عَلَىٰٓ","أَن","يَخۡلُقَ","مِثۡلَهُمۚ","بَلَىٰ","وَهُوَ","ٱلۡخَلَّٰقُ","ٱلۡعَلِيمُ"],"авалайсал лазии халаḳас самавати вал'арда биḳадирин `ала ан йахлуḳа мислахум бала вахуал халлаḳул `алиим","Неужели Тот, Кто сотворил небеса и землю, не способен создать подобных им? Конечно, ведь Он - Творец, Знающий.",["Разве не","Тот, Который","сотворил","небеса","и землю","способен","на","то, чтобы","сотворить","подобных им","Конечно","и Он","Творец","Знающий"]],[36,82,["إِنَّمَآ","أَمۡرُهُۥٓ","إِذَآ","أَرَادَ","شَيۡـًٔا","أَن","يَقُولَ","لَهُۥ","كُن","فَيَكُونُ"],"иннама амрухуу иза арада шай'ан ан йаḳуула лахуу кун файакуун","Когда Он желает чего-либо, то стоит Ему сказать: «Будь!». - как это сбывается.",["Лишь только","повеление Его","когда","пожелает Он","чего-либо","чтобы","скажет Он","ему","Будь","и оно сбывается"]],[36,83,["فَسُبۡحَٰنَ","ٱلَّذِي","بِيَدِهِۦ","مَلَكُوتُ","كُلِّ","شَيۡءٖ","وَإِلَيۡهِ","تُرۡجَعُونَ"],"фасубханал лазии бийадихии малакууту кулли шай'ин ва'илайхи туржа`уун","Пречист Тот, в Чьей Руке власть над всякой вещью! К Нему вы будете возвращены.",["так пречист","Тот, Который","в Чьей руке","власть","над всякой","вещью","и к Нему","вы будете возвращены"]]],"m":[[["أَوَلَمۡ","Разве не",36,71],["يَرَوۡاْ","видят они",36,71],["أَنَّا","что Мы",36,71],["خَلَقۡنَا","сотворили",36,71],["لَهُم","для них",36,71],["مِّمَّا","из того, что",36,71],["عَمِلَتۡ","сделали",36,71],["أَيۡدِينَآ","руки Наши",36,71],["أَنۡعَٰمٗا","скот",36,71],["فَهُمۡ","и они",36,71],["لَهَا","им",36,71]],[["مَٰلِكُونَ","владеющие",36,71],[71],["وَذَلَّلۡنَٰهَا","и Мы подчинили их",36,72],["لَهُمۡ","им",36,72],["فَمِنۡهَا","и на одних из них",36,72],["رَكُوبُهُمۡ","их езда",36,72],["وَمِنۡهَا","и других из них",36,72],["يَأۡكُلُونَ","едят",36,72],[72]],[["وَلَهُمۡ","И для них",36,73],["فِيهَا","в нём",36,73],["مَنَٰفِعُ","польза",36,73],["وَمَشَارِبُۚ","и питьё",36,73],["أَفَلَا","Неужели не",36,73],["يَشۡكُرُونَ","благодарят они",36,73],[73],["وَٱتَّخَذُواْ","и взяли",36,74]],[["مِن","из",36,74],["دُونِ","помимо",36,74],["ٱللَّهِ","Аллаха",36,74],["ءَالِهَةٗ","богов",36,74],["لَّعَلَّهُمۡ","может быть, им",36,74],["يُنصَرُونَ","окажут помощь"