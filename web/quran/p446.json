{"p":446,"j":23,"a":[[37,1,["وَٱلصَّٰٓفَّٰتِ","صَفّٗا"],"вассаффати саффа","Клянусь выстроившимися в ряды,",["клянусь выстроившимися","рядами"]],[37,2,["فَٱلزَّٰجِرَٰتِ","زَجۡرٗا"],"фаззажирати зажра","гонящими упорно,",["и отгоняющими","отгоном"]],[37,3,["فَٱلتَّٰلِيَٰتِ","ذِكۡرًا"],"фатталийати зикра","читающими напоминание!",["и читающими","напоминание"]],[37,4,["إِنَّ","إِلَٰهَكُمۡ","لَوَٰحِدٞ"],"инна илахакум лавахид","Воистину, ваш Бог - Единственный.",["поистине","ваш Бог","непременно Один"]],[37,5,["رَّبُّ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِ","وَمَا","بَيۡنَهُمَا","وَرَبُّ","ٱلۡمَشَٰرِقِ"],"рраббус самавати вал'арди вама байнахума вараббул машариḳ","Он - Господь небес, земли и того, что между ними, Господь восходов.",["Господь","небес","и земли","и того, что","между ними","и Господь","востоков"]],[37,6,["إِنَّا","زَيَّنَّا","ٱلسَّمَآءَ","ٱلدُّنۡيَا","بِزِينَةٍ","ٱلۡكَوَاكِبِ"],"инна заййаннас самаад дунйа бизиинатинил кавакиб","Мы украсили ближайшее небо красотой звезд (или звездами)",["поистине, Мы","украсили","небо","ближнее","украшением","звезд"]],[37,7,["وَحِفۡظٗا","مِّن","كُلِّ","شَيۡطَٰنٖ","مَّارِدٖ"],"вахифзам мин кулли шайтаним марид","и оберегаем его от всякого мятежного дьявола.",["и для защиты","от","всякого","дьявола","непокорного"]],[37,8,["لَّا","يَسَّمَّعُونَ","إِلَى","ٱلۡمَلَإِ","ٱلۡأَعۡلَىٰ","وَيُقۡذَفُونَ","مِن","كُلِّ","جَانِبٖ"],"лла йассамма`ууна илал малаил а`ла вайуḳзафууна мин кулли жаниб","Они не могут прислушаться к высшему сонму, и их забрасывают со всех сторон,",["не","подслушивают","к","собранию","высшему","и их забрасывают","с","каждой","стороны"]],[37,9,["دُحُورٗاۖ","وَلَهُمۡ","عَذَابٞ","وَاصِبٌ"],"духууран валахум `азабун васиб","чтобы изгнать оттуда. Им уготованы вечные мучения.",["изгоняя","и для них","наказание","постоянное"]],[37,10,["إِلَّا","مَنۡ","خَطِفَ","ٱلۡخَطۡفَةَ","فَأَتۡبَعَهُۥ","شِهَابٞ","ثَاقِبٞ"],"илла ман хатифал хатфата фа'атба`ахуу шихабун саḳиб","Но если кто из дьяволов выхватит слово, то за ним последует яркий пылающий огонь.",["кроме","того, кто","похитил","похищением (обрывок)","и преследует его","пламя (метеор)","пронзающее"]],[37,11,["فَٱسۡتَفۡتِهِمۡ","أَهُمۡ","أَشَدُّ","خَلۡقًا","أَم","مَّنۡ","خَلَقۡنَآۚ","إِنَّا","خَلَقۡنَٰهُم","مِّن","طِينٖ","لَّازِبِۭ"],"фастафтихим ахум ашадду халḳан ам ман халаḳна инна халаḳнахум мин тиинил лазиб","Спроси их (людей), они созданы прочнее или то, что Мы сотворили? Воистину, Мы сотворили их из липкой глины.",["спроси же их","разве они","сильнее","по сотворению","или","те, кого","Мы сотворили","поистине, Мы","сотворили их","из","глины","липкой"]],[37,12,["بَلۡ","عَجِبۡتَ","وَيَسۡخَرُونَ"],"бал `ажибта вайасхаруун","Но ты удивлен, а они глумятся.",["но","ты удивляешься","а они насмехаются"]],[37,13,["وَإِذَا","ذُكِّرُواْ","لَا","يَذۡكُرُونَ"],"ва'иза зуккируу ла йазкуруун","Когда же им напоминают, они отказываются помнить.",["и когда","им напоминают","не","внемлют"]],[37,14,["وَإِذَا","رَأَوۡاْ","ءَايَةٗ","يَسۡتَسۡخِرُونَ"],"ва'иза ра'ау айатан йастасхируун","Когда же они видят знамение, то высмеивают его.",["и когда","увидят","знамение","насмехаются"]],[37,15,["وَقَالُوٓاْ","إِنۡ","هَٰذَآ","إِلَّا","سِحۡرٞ","مُّبِينٌ"],"ваḳалуу ин хаза илла сихрум мубиин","Они говорят: «Это - всего лишь очевидное колдовство.",["и говорят","не","это","кроме","колдовство","явное"]],[37,16,["أَءِذَا","مِتۡنَا","وَكُنَّا","تُرَابٗا","وَعِظَٰمًا","أَءِنَّا","لَمَبۡعُوثُونَ"],"а'иза митна вакунна турабан ва`изаман а'инна ламаб`уусуун","Неужели мы будем воскрешены после того, как умрем и станем прахом и костями?",["неужели когда","мы умрём","и станем","прахом","и костями","неужели мы","непременно воскрешены"]],[37,17,["أَوَءَابَآؤُنَا","ٱلۡأَوَّلُونَ"],"аваабаунал аввалуун","Или же наши праотцы?».",["и наши отцы","первые"]],[37,18,["قُلۡ","نَعَمۡ","وَأَنتُمۡ","دَٰخِرُونَ"],"ḳул на`ам ва'антум дахируун","Скажи: «Да, и вы будете унижены!».",["скажи","да","и вы","униженные"]],[37,19,["فَإِنَّمَا","هِيَ","زَجۡرَةٞ","وَٰحِدَةٞ","فَإِذَا","هُمۡ","يَنظُرُونَ"]