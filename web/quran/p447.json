{"p":447,"j":23,"a":[[37,25,["مَا","لَكُمۡ","لَا","تَنَاصَرُونَ"],"маа лакум лаа танаасаруун","«Что с вами? Почему вы не помогаете друг другу?».",["что","с вами","не","помогаете друг другу"]],[37,26,["بَلۡ","هُمُ","ٱلۡيَوۡمَ","مُسۡتَسۡلِمُونَ"],"бал хуму лйаума мустаслимуун","О нет! Сегодня они будут покорны.",["нет","они","сегодня","покорны"]],[37,27,["وَأَقۡبَلَ","بَعۡضُهُمۡ","عَلَىٰ","بَعۡضٖ","يَتَسَآءَلُونَ"],"уа'акбала ба`духум `алаа ба`дин йатасаа'алуун","Они будут обращаться друг к другу с вопросами.",["и обратились","одни из них","к","другим","расспрашивая друг друга"]],[37,28,["قَالُوٓاْ","إِنَّكُمۡ","كُنتُمۡ","تَأۡتُونَنَا","عَنِ","ٱلۡيَمِينِ"],"каалуу иннакум кунтум та'туунанаа `ани лйамиин","Они скажут: «Вы приходили к нам справа».",["сказали","поистине, вы","были","приходили к нам","от","правой стороны"]],[37,29,["قَالُواْ","بَل","لَّمۡ","تَكُونُواْ","مُؤۡمِنِينَ"],"каалуу бал ллам такуунуу му'миниин","Они ответят: «О нет! Вы сами не были верующими.",["сказали они","нет","не","были вы","верующими"]],[37,30,["وَمَا","كَانَ","لَنَا","عَلَيۡكُم","مِّن","سُلۡطَٰنِۭۖ","بَلۡ","كُنتُمۡ","قَوۡمٗا","طَٰغِينَ"],"уамаа каана ланаа `алайкум ммин султаани бал кунтум кауман таагиин","Мы не обладали властью над вами. Вы сами были людьми, преступавшими границы дозволенного.",["и не","было","у нас","над вами","никакой","власти","напротив","вы были","людьми","преступающими меру"]],[37,31,["فَحَقَّ","عَلَيۡنَا","قَوۡلُ","رَبِّنَآۖ","إِنَّا","لَذَآئِقُونَ"],"фахакка `алайнаа каулу раббинаа иннаа лазаа'икуун","Относительно нас сбылось Слово нашего Господа. Воистину, мы будем вкушать наказание.",["и оправдалось","на нас","слово","нашего Господа","поистине, мы","непременно вкусим"]],[37,32,["فَأَغۡوَيۡنَٰكُمۡ","إِنَّا","كُنَّا","غَٰوِينَ"],"фа'агуайнаакум иннаа куннаа гаауиин","Мы ввели вас в заблуждение, и мы сами были заблудшими».",["и мы ввели вас в заблуждение","поистине, мы","были","заблудшими"]],[37,33,["فَإِنَّهُمۡ","يَوۡمَئِذٖ","فِي","ٱلۡعَذَابِ","مُشۡتَرِكُونَ"],"фа'иннахум йаума'изин фии л`азааби муштарикуун","Воистину, в тот день они разделят наказание.",["и поистине, они","в тот день","в","наказании","соучастники"]],[37,34,["إِنَّا","كَذَٰلِكَ","نَفۡعَلُ","بِٱلۡمُجۡرِمِينَ"],"иннаа казаалика наф`алу билмуджримиин","Воистину, так Мы поступаем с грешниками.",["поистине, Мы","так","поступаем","с грешниками"]],[37,35,["إِنَّهُمۡ","كَانُوٓاْ","إِذَا","قِيلَ","لَهُمۡ","لَآ","إِلَٰهَ","إِلَّا","ٱللَّهُ","يَسۡتَكۡبِرُونَ"],"иннахум каануу изаа киила лахум лаа илааха иллаа ллаху йастакбируун","Когда им говорили: «Нет божества, кроме Аллаха», - они превозносились",["поистине, они","были","когда","говорилось","им","нет","божества","кроме","Аллаха","превозносились"]],[37,36,["وَيَقُولُونَ","أَئِنَّا","لَتَارِكُوٓاْ","ءَالِهَتِنَا","لِشَاعِرٖ","مَّجۡنُونِۭ"],"уайакуулууна а'иннаа латаарикуу аалихатинаа лишаа`ирим маджнуун","и говорили: «Неужели мы откажемся от наших богов ради одержимого поэта?».",["и говорят","неужели мы","непременно оставим","наших богов","ради поэта","одержимого"]],[37,37,["بَلۡ","جَآءَ","بِٱلۡحَقِّ","وَصَدَّقَ","ٱلۡمُرۡسَلِينَ"],"бал джаа'а билхакки уасаддака лмурсалиин","О нет! Он принес истину и подтвердил правдивость посланников.",["нет","он пришёл","с истиной","и подтвердил","посланников"]],[37,38,["إِنَّكُمۡ","لَذَآئِقُواْ","ٱلۡعَذَابِ","ٱلۡأَلِيمِ"],"иннакум лазаа'икуу л`азааби л'алиим","Вы непременно вкусите мучительные страдания,",["поистине, вы","непременно вкусите","наказание","мучительное"]],[37,39,["وَمَا","تُجۡزَوۡنَ","إِلَّا","مَا","كُنتُمۡ","تَعۡمَلُونَ"],"уамаа туджзауна иллаа маа кунтум та`малуун","и получите воздаяние только за то, что вы совершали.",["и не","получите воздаяние","кроме как","за то, что","вы","совершали"]],[37,40,["إِلَّا","عِبَادَ","ٱللَّهِ","ٱلۡمُخۡلَصِينَ"],"иллаа `ибаада ллахи лмухласиин","Это не относится лишь к избранным (или искренним) рабам Аллаха.",["кроме","рабов","Аллаха","избранных"]],[37,41,["أُوْلَٰٓئِكَ","لَهُمۡ","رِزۡقٞ","مَّعۡلُومٞ"],"улаа'ика лахум ризкум ма`луум","Именно им уготован известный удел -",["те","для них","удел","известный"]],[37,42,["فَوَٰكِهُ","وَهُم","مُّكۡرَمُونَ"],"фауаакиху уахум ммукрамуун","фрукты. Им будут оказаны почести",["плоды","и они","почитаемые"]],[37,43,["فِي","جَنَّٰتِ","ٱلنَّعِيمِ"],"фии джаннаати нна`иим","в Садах блаженства.",["в","садах","блаженства"]],[37,44,["عَلَىٰ","سُرُرٖ","مُّتَقَٰبِلِينَ"],"`алаа сурурим мутакаабилиин","Они будут возлежать на ложах друг против друга.",["на","ложах","друг против друга"]],[37,45,["يُطَافُ","عَلَيۡهِم","بِكَأۡسٖ","مِّن","مَّعِينِۭ"],"йутаафу `алайхим бика'сим мим ма`иин","Их будут обходить с чашей родникового напитка (вина),",["будут обносить","их","чашей","из","источника"]],[37,46,["بَيۡضَآءَ","لَذَّةٖ","لِّلشَّٰرِبِينَ"],"байдаа'а лаззатил лилшшаарибиин","белого, доставляющего удовольствие пьющим.",["белого","приятного","для пьющих"]],[37,47,["لَا","فِيهَا","غَوۡلٞ","وَلَا","هُمۡ","عَنۡهَا","يُنزَفُونَ"],"лаа фиихаа гаулун уалаа хум `анхаа йунзафуун","Он не лишает рассудка и не пьянит.",["нет","в нём","вреда","и не","они","от него","пьянеют"]],[37,48,["وَعِندَهُمۡ","قَٰصِرَٰتُ","ٱلطَّرۡفِ","عِينٞ"],"уа`индахум каасираату ттарфи `иин","Возле них будут гурии, потупляющие взоры, большеглазые,",["и у них","потупляющие","взор","большеглазые"]],[37,49,["كَأَنَّهُنَّ","بَيۡضٞ","مَّكۡنُونٞ"],"ка'аннахунна байдум макнуун","подобные оберегаемому яйцу.",["словно они","яйца","сокрытые"]],[37,50,["فَأَقۡبَلَ","بَعۡضُهُمۡ","عَلَىٰ","بَعۡضٖ","يَتَسَآءَلُونَ"],"фа'акбала ба`духум `алаа ба`дин йатасаа'алуун","Они будут обращаться друг к другу с вопросами.",["и обратились","одни из них","к","другим","расспрашивая друг друга"]],[37,51,["قَالَ","قَآئِلٞ","مِّنۡهُمۡ","إِنِّي","كَانَ","لِي","قَرِينٞ"],"каала каа'илум минхум иннии каана лии кариин","Один из них скажет: «Был у меня товарищ.",["сказал","говорящий","из них","поистине, я","был","у меня","товарищ"]]]}