{"p":448,"j":23,"a":[[37,52,["يَقُولُ","أَءِنَّكَ","لَمِنَ","ٱلۡمُصَدِّقِينَ"],"йаḳуулу а'иннака ламинал мусаддиḳиин","Он говорил: «Неужели ты принадлежишь к числу верующих?",["говорил","неужели ты","непременно из","верящих"]],[37,53,["أَءِذَا","مِتۡنَا","وَكُنَّا","تُرَابٗا","وَعِظَٰمًا","أَءِنَّا","لَمَدِينُونَ"],"а'иза митна вакунна турабан ва`изаман а'инна ламадиинуун","Неужели мы получим воздаяние после того, как мы умрем и станем прахом и костями?»»",["неужели когда","мы умрём","и станем","прахом","и костями","неужели мы","непременно получим воздаяние"]],[37,54,["قَالَ","هَلۡ","أَنتُم","مُّطَّلِعُونَ"],"ḳала хал антум муттали`уун","Он скажет: «Не взгляните ли вы?».",["сказал","разве","вы","взглянете"]],[37,55,["فَٱطَّلَعَ","فَرَءَاهُ","فِي","سَوَآءِ","ٱلۡجَحِيمِ"],"фаттала`а фарааху фии саваил жахиим","Он взглянет и увидит его в середине Ада.",["и взглянул он","и увидел его","в","середине","Ада"]],[37,56,["قَالَ","تَٱللَّهِ","إِن","كِدتَّ","لَتُرۡدِينِ"],"ḳала таллахи ин кидтта латурдиин","Он скажет: «Клянусь Аллахом! Ты чуть было не погубил меня.",["сказал","клянусь Аллахом","поистине","ты едва не","погубил меня"]],[37,57,["وَلَوۡلَا","نِعۡمَةُ","رَبِّي","لَكُنتُ","مِنَ","ٱلۡمُحۡضَرِينَ"],"валаула ни`мату раббии лакунту минал мухдариин","Если бы не милость моего Господа, то я оказался бы в числе ввергнутых в Геенну.",["и если бы не","милость","моего Господа","непременно я был бы","из","приведённых"]],[37,58,["أَفَمَا","نَحۡنُ","بِمَيِّتِينَ"],"афама нахну бимаййитиин","Неужели мы никогда не умрем",["разве не","мы","умрём"]],[37,59,["إِلَّا","مَوۡتَتَنَا","ٱلۡأُولَىٰ","وَمَا","نَحۡنُ","بِمُعَذَّبِينَ"],"илла маутатанал уула вама нахну биму`аззабиин","после нашей первой смерти? Неужели мы никогда не будем подвергнуты мучениям?».",["кроме","нашей смерти","первой","и не","мы","наказанные"]],[37,60,["إِنَّ","هَٰذَا","لَهُوَ","ٱلۡفَوۡزُ","ٱلۡعَظِيمُ"],"инна хаза лахуал фаузул `азиим","Это и есть великое преуспеяние!",["поистине","это","непременно оно","успех","великий"]],[37,61,["لِمِثۡلِ","هَٰذَا","فَلۡيَعۡمَلِ","ٱلۡعَٰمِلُونَ"],"лимисли хаза фалйа`малил `амилуун","Ради такого пусть трудятся труженики!",["ради подобного","этому","пусть трудятся","труженики"]],[37,62,["أَذَٰلِكَ","خَيۡرٞ","نُّزُلًا","أَمۡ","شَجَرَةُ","ٱلزَّقُّومِ"],"азалика хайрун нузулан ам шажаратуз заḳḳуум","Это угощение лучше или дерево заккум?",["разве это","лучше","как угощение","или","дерево","заккум"]],[37,63,["إِنَّا","جَعَلۡنَٰهَا","فِتۡنَةٗ","لِّلظَّٰلِمِينَ"],"инна жа`алнаха фитнатал лиззалимиин","Мы сделали его искушением для беззаконников.",["поистине, Мы","сделали его","искушением","для несправедливых"]],[37,64,["إِنَّهَا","شَجَرَةٞ","تَخۡرُجُ","فِيٓ","أَصۡلِ","ٱلۡجَحِيمِ"],"иннаха шажаратун тахружу фии аслил жахиим","Это - дерево, которое растет из основания Ада.",["поистине, оно","дерево","растёт","в","основании","Ада"]],[37,65,["طَلۡعُهَا","كَأَنَّهُۥ","رُءُوسُ","ٱلشَّيَٰطِينِ"],"тал`уха ка'аннахуу ру'уусуш шайатиин","Плоды его - словно головы дьяволов.",["его плоды","словно они","головы","дьяволов"]],[37,66,["فَإِنَّهُمۡ","لَأٓكِلُونَ","مِنۡهَا","فَمَالِـُٔونَ","مِنۡهَا","ٱلۡبُطُونَ"],"фа'иннахум ла'акилууна минха фамалиууна минхал бутуун","Они будут пожирать их и наполнять ими свои животы.",["и поистине, они","непременно будут есть","из него","и наполнят","им","животы"]],[37,67,["ثُمَّ","إِنَّ","لَهُمۡ","عَلَيۡهَا","لَشَوۡبٗا","مِّنۡ","حَمِيمٖ"],"сумма инна лахум `алайха лашаубам мин хамиим","Потом они (плоды заккума) будут смешаны для них с кипятком.",["затем","поистине","для них","поверх него","непременно смесь","из","кипятка"]],[37,68,["ثُمَّ","إِنَّ","مَرۡجِعَهُمۡ","لَإِلَى","ٱلۡجَحِيمِ"],"сумма инна маржи`ахум ла'илал жахиим","А потом их вернут в Ад.",["затем","поистине","их возвращение","непременно к","Аду"]],[37,69,["إِنَّهُمۡ","أَلۡفَوۡاْ","ءَابَآءَهُمۡ","ضَآلِّينَ"],"иннахум алфау абаахум даллиин","Воистину, они нашли своих отцов заблудшими",["поистине, они","нашли","своих отцов","заблудшими"]],[37,70,["فَهُمۡ","عَلَىٰٓ","ءَاثَ