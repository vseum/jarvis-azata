{"p":449,"j":23,"a":[[37,77,["وَجَعَلۡنَا","ذُرِّيَّتَهُۥ","هُمُ","ٱلۡبَاقِينَ"],"уаджа`алнаа зурриййатахуу хуму лбаакиин","и сохранили только его потомство.",["и Мы сделали","его потомство","именно их","оставшимися"]],[37,78,["وَتَرَكۡنَا","عَلَيۡهِ","فِي","ٱلۡأٓخِرِينَ"],"уатаракнаа `алайхи фии л'хириин","Мы оставили о нем в последующих поколениях добрую молву.",["и Мы оставили","о нём","среди","последующих"]],[37,79,["سَلَٰمٌ","عَلَىٰ","نُوحٖ","فِي","ٱلۡعَٰلَمِينَ"],"салаамун `алаа нуухин фии л`ааламиин","Мир Нуху (Ною) среди миров!",["мир","над","Нухом","среди","миров"]],[37,80,["إِنَّا","كَذَٰلِكَ","نَجۡزِي","ٱلۡمُحۡسِنِينَ"],"иннаа казаалика наджзии лмухсиниин","Воистину, так Мы воздаем творящим добро.",["поистине, Мы","так","вознаграждаем","творящих добро"]],[37,81,["إِنَّهُۥ","مِنۡ","عِبَادِنَا","ٱلۡمُؤۡمِنِينَ"],"иннахуу мин `ибаадинаа лму'миниин","Воистину, он - один из Наших верующих рабов.",["поистине, он","из","Наших рабов","верующих"]],[37,82,["ثُمَّ","أَغۡرَقۡنَا","ٱلۡأٓخَرِينَ"],"сумма агракнаа л'хариин","Затем Мы потопили всех остальных.",["затем","Мы потопили","других"]],[37,83,["وَإِنَّ","مِن","شِيعَتِهِۦ","لَإِبۡرَٰهِيمَ"],"уа'инна мин шии`атихии ла'ибраахиим","Ибрахим (Авраам) был одним из его приверженцев.",["и поистине","из","его последователей","непременно Ибрахим"]],[37,84,["إِذۡ","جَآءَ","رَبَّهُۥ","بِقَلۡبٖ","سَلِيمٍ"],"из джаа'а раббахуу бикалбин салиим","Вот он пришел к своему Господу с непорочным сердцем.",["вот","пришёл","к своему Господу","с сердцем","непорочным"]],[37,85,["إِذۡ","قَالَ","لِأَبِيهِ","وَقَوۡمِهِۦ","مَاذَا","تَعۡبُدُونَ"],"из каала ли'абиихи уакаумихии маазаа та`будуун","Он сказал своему отцу и своему народу: «Чему вы поклоняетесь?",["когда","сказал","отцу своему","и народу своему","что","поклоняетесь"]],[37,86,["أَئِفۡكًا","ءَالِهَةٗ","دُونَ","ٱللَّهِ","تُرِيدُونَ"],"а'ифкан аалихатан дууна ллахи туриидуун","Неужели вы жаждете других богов, помимо Аллаха, измышляя ложь?",["разве ложь","богов","помимо","Аллаха","желаете"]],[37,87,["فَمَا","ظَنُّكُم","بِرَبِّ","ٱلۡعَٰلَمِينَ"],"фамаа заннукум бирабби л`ааламиин","И что вы думаете о Господе миров?».",["и что","ваше мнение","о Господе","миров"]],[37,88,["فَنَظَرَ","نَظۡرَةٗ","فِي","ٱلنُّجُومِ"],"фаназара назратан фии ннуджуум","Потом он бросил взгляд на звезды",["и посмотрел он","взглядом","на","звёзды"]],[37,89,["فَقَالَ","إِنِّي","سَقِيمٞ"],"факаала иннии сакиим","и сказал: «Я болен».",["и сказал","поистине, я","болен"]],[37,90,["فَتَوَلَّوۡاْ","عَنۡهُ","مُدۡبِرِينَ"],"фатауаллау `анху мудбириин","Они отвернулись от него, обратившись вспять.",["и отвернулись они","от него","уходя"]],[37,91,["فَرَاغَ","إِلَىٰٓ","ءَالِهَتِهِمۡ","فَقَالَ","أَلَا","تَأۡكُلُونَ"],"фараага илаа аалихатихим факаала алаа та'кулуун","Он украдкой пробрался к их богам и сказал: «Не поесть ли вам?",["и пробрался он","к","их богам","и сказал","разве не","вы едите"]],[37,92,["مَا","لَكُمۡ","لَا","تَنطِقُونَ"],"маа лакум лаа тантикуун","Что с вами? Почему вы не разговариваете?",["что","с вами","не","говорите"]],[37,93,["فَرَاغَ","عَلَيۡهِمۡ","ضَرۡبَۢا","بِٱلۡيَمِينِ"],"фараага `алайхим дарбаа билйамиин","Он подошел к ним и стал бить их десницей.",["и набросился он","на них","ударяя","правой рукой"]],[37,94,["فَأَقۡبَلُوٓاْ","إِلَيۡهِ","يَزِفُّونَ"],"фа'акбалуу илайхи йазиффуун","Они (язычники) направились к нему второпях.",["и направились они","к нему","поспешно"]],[37,95,["قَالَ","أَتَعۡبُدُونَ","مَا","تَنۡحِتُونَ"],"каала ата`будууна маа танхитуун","Он сказал: «Неужели вы поклоняетесь тому, что сами высекаете?",["сказал","неужели вы поклоняетесь","тому, что","вытёсываете"]],[37,96,["وَٱللَّهُ","خَلَقَكُمۡ","وَمَا","تَعۡمَلُونَ"],"уаллаху халакакум уамаа та`малуун","Аллах сотворил вас и то, что вы делаете (или Аллах сотворил вас, и сами вы ничего не делаете; или Аллах сотворил вас. Что же вы делаете?)».",["а Аллах","сотворил вас","и то, что","вы делаете"]],[37,97,["قَالُواْ","ٱبۡنُواْ","لَهُۥ","بُنۡيَٰنٗا","فَأَلۡقُوهُ","فِي","ٱلۡجَحِيمِ"],"каалуу бнуу лахуу бунйаанан фа'алкууху фии лджахиим","Они сказали: «Соорудите для него строение и бросьте его в огонь!».",["сказали они","постройте","для него","строение","и бросьте его","в","Ад (пылающий огонь)"]],[37,98,["فَأَرَادُواْ","بِهِۦ","كَيۡدٗا","فَجَعَلۡنَٰهُمُ","ٱلۡأَسۡفَلِينَ"],"фа'араадуу бихии кайдан фаджа`алнаахуму л'асфалиин","Они замыслили против него козни, но Мы сделали их нижайшими.",["и хотели они","против него","хитрость","но Мы сделали их","нижайшими"]],[37,99,["وَقَالَ","إِنِّي","ذَاهِبٌ","إِلَىٰ","رَبِّي","سَيَهۡدِينِ"],"уакаала иннии заахибун илаа раббии сайахдиин","Он сказал: «Я ухожу к моему Господу, Который поведет меня прямым путем.",["и сказал","поистине, я","ухожу","к","моему Господу","Он поведёт меня прямым путём"]],[37,100,["رَبِّ","هَبۡ","لِي","مِنَ","ٱلصَّٰلِحِينَ"],"рабби хаб лии мина ссаалихиин","Господи, одари меня потомством из числа праведников!».",["Господи мой","даруй","мне","из","праведников"]],[37,101,["فَبَشَّرۡنَٰهُ","بِغُلَٰمٍ","حَلِيمٖ"],"фабашшарнааху бигулаамин халиим","Тогда Мы обрадовали его вестью о выдержанном мальчике.",["и Мы обрадовали его","мальчиком","выдержанным"]],[37,102,["فَلَمَّا","بَلَغَ","مَعَهُ","ٱلسَّعۡيَ","قَالَ","يَٰبُنَيَّ","إِنِّيٓ","أَرَىٰ","فِي","ٱلۡمَنَامِ","أَنِّيٓ","أَذۡبَحُكَ","فَٱنظُرۡ","مَاذَا","تَرَىٰۚ","قَالَ","يَٰٓأَبَتِ","ٱفۡعَلۡ","مَا","تُؤۡمَرُۖ","سَتَجِدُنِيٓ","إِن","شَآءَ","ٱللَّهُ","مِنَ","ٱلصَّٰبِرِينَ"],"фаламмаа балага ма`аху сса`йа каала йаабунаййа иннии араа фии лманаами аннии азбахука фанзур маазаа тараа каала йаа'абати ф`ал маа ту'мару сатаджидунии ин шаа'а ллаху мина ссаабириин","Когда он достиг того возраста, чтобы усердствовать вместе с ним, он сказал: «Сын мой! Я вижу во сне, что зарезаю тебя. Посмотри, что ты думаешь?». Он сказал: «Отец мой! Сделай то, что тебе велено. Если Аллах пожелает, ты найдешь меня одним из терпеливых».",["и когда","достиг","с ним","усердия (возраста трудов)","сказал он","о сынок мой","поистине, я","вижу","во","сне","что я","закалываю тебя","посмотри же","что","ты думаешь","сказал","о отец мой","делай","то, что","тебе велят","ты найдёшь меня","если","пожелает","Аллах","из","терпеливых"]]]}