{"p":449,"j":23,"a":[[37,77,["وَجَعَلۡنَا","ذُرِّيَّتَهُۥ","هُمُ","ٱلۡبَاقِينَ"],"важа`ална зурриййатахуу хумул баḳиин","и сохранили только его потомство.",["и Мы сделали","его потомство","именно их","оставшимися"]],[37,78,["وَتَرَكۡنَا","عَلَيۡهِ","فِي","ٱلۡأٓخِرِينَ"],"ватаракна `алайхи фил ахириин","Мы оставили о нем в последующих поколениях добрую молву.",["и Мы оставили","о нём","среди","последующих"]],[37,79,["سَلَٰمٌ","عَلَىٰ","نُوحٖ","فِي","ٱلۡعَٰلَمِينَ"],"саламун `ала нуухин фил `аламиин","Мир Нуху (Ною) среди миров!",["мир","над","Нухом","среди","миров"]],[37,80,["إِنَّا","كَذَٰلِكَ","نَجۡزِي","ٱلۡمُحۡسِنِينَ"],"инна казалика нажзил мухсиниин","Воистину, так Мы воздаем творящим добро.",["поистине, Мы","так","вознаграждаем","творящих добро"]],[37,81,["إِنَّهُۥ","مِنۡ","عِبَادِنَا","ٱلۡمُؤۡمِنِينَ"],"иннахуу мин `ибадинал му'миниин","Воистину, он - один из Наших верующих рабов.",["поистине, он","из","Наших рабов","верующих"]],[37,82,["ثُمَّ","أَغۡرَقۡنَا","ٱلۡأٓخَرِينَ"],"сумма аграḳнал ахариин","Затем Мы потопили всех остальных.",["затем","Мы потопили","других"]],[37,83,["وَإِنَّ","مِن","شِيعَتِهِۦ","لَإِبۡرَٰهِيمَ"],"ва'инна мин шии`атихии ла'ибрахиим","Ибрахим (Авраам) был одним из его приверженцев.",["и поистине","из","его последователей","непременно Ибрахим"]],[37,84,["إِذۡ","جَآءَ","رَبَّهُۥ","بِقَلۡبٖ","سَلِيمٍ"],"из жаа раббахуу биḳалбин салиим","Вот он пришел к своему Господу с непорочным сердцем.",["вот","пришёл","к своему Господу","с сердцем","непорочным"]],[37,85,["إِذۡ","قَالَ","لِأَبِيهِ","وَقَوۡمِهِۦ","مَاذَا","تَعۡبُدُونَ"],"из ḳала ли'абиихи ваḳаумихии маза та`будуун","Он сказал своему отцу и своему народу: «Чему вы поклоняетесь?",["когда","сказал","отцу своему","и народу своему","что","поклоняетесь"]],[37,86,["أَئِفۡكًا","ءَالِهَةٗ","دُونَ","ٱللَّهِ","تُرِيدُونَ"],"а'ифкан алихатан дууналлахи туриидуун","Неужели вы жаждете других богов, помимо Аллаха, измышляя ложь?",["разве ложь","богов","помимо","Аллаха","желаете"]],[37,87,["فَمَا","ظَنُّكُم","بِرَبِّ","ٱلۡعَٰلَمِينَ"],"фама заннукум бираббил `аламиин","И что вы думаете о Господе миров?».",["и что","ваше мнение","о Господе","миров"]],[37,88,["فَنَظَرَ","نَظۡرَةٗ","فِي","ٱلنُّجُومِ"],"фаназара назратан фин нужуум","Потом он бросил взгляд на звезды",["и посмотрел он","взглядом","на","звёзды"]],[37,89,["فَقَالَ","إِنِّي","سَقِيمٞ"],"фаḳала иннии саḳиим","и сказал: «Я болен».",["и сказал","поистине, я","болен"]],[37,90,["فَتَوَلَّوۡاْ","عَنۡهُ","مُدۡبِرِينَ"],"фатаваллау `анху мудбириин","Они отвернулись от него, обратившись вспять.",["и отвернулись они","от него","уходя"]],[37,91,["فَرَاغَ","إِلَىٰٓ","ءَالِهَتِهِمۡ","فَقَالَ","أَلَا","تَأۡكُلُونَ"],"фарага ила алихатихим фаḳала ала та'кулуун","Он украдкой пробрался к их богам и сказал: «Не поесть ли вам?",["и пробрался он","к","их богам","и сказал","разве не","вы едите"]],[37,92,["مَا","لَكُمۡ","لَا","تَنطِقُونَ"],"ма лакум ла тантиḳуун","Что с вами? Почему вы не разговариваете?",["что","с вами","не","говорите"]],[37,93,["فَرَاغَ","عَلَيۡهِمۡ","ضَرۡبَۢا","بِٱلۡيَمِينِ"],"фарага `алайхим дарба билйамиин","Он подошел к ним и стал бить их десницей.",["и набросился он","на них","ударяя","правой рукой"]],[37,94,["فَأَقۡبَلُوٓاْ","إِلَيۡهِ","يَزِفُّونَ"],"фа'аḳбалуу илайхи йазиффуун","Они (язычники) направились к нему второпях.",["и направились они","к нему","поспешно"]],[37,95,["قَالَ","أَتَعۡبُدُونَ","مَا","تَنۡحِتُونَ"],"ḳала ата`будууна ма танхитуун","Он сказал: «Неужели вы поклоняетесь тому, что сами высекаете?",["сказал","неужели вы поклоняетесь","тому, что","вытёсываете"]],[37,96,["وَٱللَّهُ","خَلَقَكُمۡ","وَمَا","تَعۡمَلُونَ"],"валлаху халаḳакум вама та`малуун","Аллах сотворил вас и то, что вы делаете (или Аллах сотворил вас, и сами вы ничего не делаете; или Аллах сотворил вас. Что же вы делаете?)».",["а Аллах","сотворил вас","и то, что","вы делаете"]],[37,97,["قَالُواْ","ٱبۡنُواْ","لَهُۥ","بُنۡيَٰنٗا","فَأَلۡقُوهُ","فِي","ٱلۡجَحِيمِ"],"ḳалубнуу лахуу бунйанан фа'алḳууху фил жахиим","Они сказали: «Соорудите для него строение и бросьте его в огонь!».",["сказали они","постройте","для него","строение","и бросьте его","в","Ад (пылающий огонь)"]],[37,98,["فَأَرَادُواْ","بِهِۦ","كَيۡدٗا","فَجَعَلۡنَٰهُمُ","ٱلۡأَسۡفَلِينَ"],"фа'арадуу бихии кайдан фажа`алнахумул асфалиин","Они замыслили против него козни, но Мы сделали их нижайшими.",["и хотели они","против него","хитрость","но Мы сделали их","нижайшими"]],[37,99,["وَقَالَ","إِنِّي","ذَاهِبٌ","إِلَىٰ","رَبِّي","سَيَهۡدِينِ"],"ваḳала иннии захибун ила раббии сайахдиин","Он сказал: «Я ухожу к моему Господу, Который поведет меня прямым путем.",["и сказал","поистине, я","ухожу","к","моему Господу","Он поведёт меня прямым путём"]],[37,100,["رَبِّ","هَبۡ","لِي","مِنَ","ٱلصَّٰلِحِينَ"],"рабби хаб лии минас салихиин","Господи, одари меня потомством из числа праведников!».",["Господи мой","даруй","мне","из","праведников"]],[37,101,["فَبَشَّرۡنَٰهُ","بِغُلَٰمٍ","حَلِيمٖ"],"фабашшарнаху бигуламин халиим","Тогда Мы обрадовали его вестью о выдержанном мальчике.",["и Мы обрадовали его","мальчиком","выдержанным"]],[37,102,["فَلَمَّا","بَلَغَ","مَعَهُ","ٱلسَّعۡيَ","قَالَ","يَٰبُنَيَّ","إِنِّيٓ","أَرَىٰ","فِي","ٱلۡمَنَامِ","أَنِّيٓ","أَذۡبَحُكَ","فَٱنظُرۡ","مَاذَا","تَرَىٰۚ","قَالَ","يَٰٓأَبَتِ","ٱفۡعَلۡ","مَا","تُؤۡمَرُۖ","سَتَجِدُنِيٓ","إِن","شَآءَ","ٱللَّهُ","مِنَ","ٱلصَّٰبِرِينَ"],"фаламма балага ма`ахус са`йа ḳала йабунаййа иннии ара фил манами аннии азбахука фанзур маза тара ḳала йа'абатиф`ал ма ту'мару сатажидунии ин шааллаху минас сабириин","Когда он достиг того возраста, чтобы усердствовать вместе с ним, он сказал: «Сын мой! Я вижу во сне, что зарезаю тебя. Посмотри, что ты думаешь?». Он сказал: «Отец мой! Сделай то, что тебе велено. Если Аллах пожелает, ты найдешь меня одним из терпеливых».",["и когда","достиг","с ним","усердия (возраста трудов)","сказал он","о сынок мой","поистине, я","вижу","во","сне","что я","закалываю тебя","посмотри же","что","ты думаешь","сказал","о отец мой","делай","то, что","тебе велят","ты найдё