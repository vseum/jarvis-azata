{"p":450,"j":23,"a":[[37,103,["فَلَمَّآ","أَسۡلَمَا","وَتَلَّهُۥ","لِلۡجَبِينِ"],"фаламма аслама ваталлахуу лилжабиин","Когда они оба покорились, и он уложил его на бок,",["и когда","оба покорились","и он уложил его","на висок (лбом)"]],[37,104,["وَنَٰدَيۡنَٰهُ","أَن","يَٰٓإِبۡرَٰهِيمُ"],"ванадайнаху ан йа'ибрахиим","Мы воззвали к нему: «О Ибрахим (Авраам)!",["и Мы воззвали к нему","что","о Ибрахим"]],[37,105,["قَدۡ","صَدَّقۡتَ","ٱلرُّءۡيَآۚ","إِنَّا","كَذَٰلِكَ","نَجۡزِي","ٱلۡمُحۡسِنِينَ"],"ḳад саддаḳтар ру'йа инна казалика нажзил мухсиниин","Ты оправдал сновидение». Воистину, так Мы воздаем творящим добро.",["уже","ты оправдал","сон","поистине, Мы","так","воздаем","творящим добро"]],[37,106,["إِنَّ","هَٰذَا","لَهُوَ","ٱلۡبَلَٰٓؤُاْ","ٱلۡمُبِينُ"],"инна хаза лахуал балаул мубиин","Это и есть явное испытание (или явная милость).",["поистине","это","непременно оно","испытание","явное"]],[37,107,["وَفَدَيۡنَٰهُ","بِذِبۡحٍ","عَظِيمٖ"],"вафадайнаху бизибхин `азиим","Мы выкупили его великой жертвой.",["и Мы выкупили его","жертвой","великой"]],[37,108,["وَتَرَكۡنَا","عَلَيۡهِ","فِي","ٱلۡأٓخِرِينَ"],"ватаракна `алайхи фил ахириин","Мы оставили о нем в последующих поколениях добрую молву.",["и Мы оставили","о нём","среди","последующих"]],[37,109,["سَلَٰمٌ","عَلَىٰٓ","إِبۡرَٰهِيمَ"],"саламун `ала ибрахиим","Мир Ибрахиму (Аврааму)!",["мир","над","Ибрахимом"]],[37,110,["كَذَٰلِكَ","نَجۡزِي","ٱلۡمُحۡسِنِينَ"],"казалика нажзил мухсиниин","Воистину, так Мы воздаем творящим добро.",["так","Мы вознаграждаем","творящих добро"]],[37,111,["إِنَّهُۥ","مِنۡ","عِبَادِنَا","ٱلۡمُؤۡمِنِينَ"],"иннахуу мин `ибадинал му'миниин","Воистину, он - один из Наших верующих рабов.",["поистине, он","из","Наших рабов","верующих"]],[37,112,["وَبَشَّرۡنَٰهُ","بِإِسۡحَٰقَ","نَبِيّٗا","مِّنَ","ٱلصَّٰلِحِينَ"],"вабашшарнаху би'исхаḳа набиййам минас салихиин","Мы обрадовали его вестью об Исхаке (Исааке) - пророке из числа праведников.",["и Мы обрадовали его","Исхаком","пророком","из","праведников"]],[37,113,["وَبَٰرَكۡنَا","عَلَيۡهِ","وَعَلَىٰٓ","إِسۡحَٰقَۚ","وَمِن","ذُرِّيَّتِهِمَا","مُحۡسِنٞ","وَظَالِمٞ","لِّنَفۡسِهِۦ","مُبِينٞ"],"вабаракна `алайхи ва`ала исхаḳа вамин зурриййатихима мухсинун вазалимул линафсихии мубиин","Мы благословили его и Исхака (Исаака). Среди их потомства есть творящие добро и поступающие явно несправедливо к самим себе.",["и Мы благословили","его","и","Исхака","и из","их потомства","творящий добро","и несправедливый","к самому себе","явно"]],[37,114,["وَلَقَدۡ","مَنَنَّا","عَلَىٰ","مُوسَىٰ","وَهَٰرُونَ"],"валаḳад мананна `ала мууса вахаруун","Мы оказали милость Мусе (Моисею) и Харуну (Аарону).",["и уже","Мы оказали милость","к","Мусе","и Харуну"]],[37,115,["وَنَجَّيۡنَٰهُمَا","وَقَوۡمَهُمَا","مِنَ","ٱلۡكَرۡبِ","ٱلۡعَظِيمِ"],"ванажжайнахума ваḳаумахума минал карбил `азиим","Мы спасли их обоих и их народ от великой печали.",["и Мы спасли их обоих","и их народ","от","бедствия","великого"]],[37,116,["وَنَصَرۡنَٰهُمۡ","فَكَانُواْ","هُمُ","ٱلۡغَٰلِبِينَ"],"ванасарнахум факануу хумул галибиин","Мы оказали им помощь, и именно они стали победителями.",["и Мы помогли им","и были","именно они","победителями"]],[37,117,["وَءَاتَيۡنَٰهُمَا","ٱلۡكِتَٰبَ","ٱلۡمُسۡتَبِينَ"],"ва'атайнахумал китабал мустабиин","Мы даровали им ясное Писание",["и Мы даровали им обоим","Писание","ясное"]],[37,118,["وَهَدَيۡنَٰهُمَا","ٱلصِّرَٰطَ","ٱلۡمُسۡتَقِيمَ"],"вахадайнахумас сиратал мустаḳиим","и повели их прямым путем.",["и Мы повели их обоих","путём","прямым"]],[37,119,["وَتَرَكۡنَا","عَلَيۡهِمَا","فِي","ٱلۡأٓخِرِينَ"],"ватаракна `алайхима фил ахириин","Мы оставили о них в последующих поколениях добрую молву.",["и Мы оставили","о них обоих","среди","последующих"]],[37,120,["سَلَٰمٌ","عَلَىٰ","مُوسَىٰ","وَهَٰرُونَ"],"саламун `ала мууса вахаруун","Мир Мусе (Моисею) и Харуну (Аарону)!",["мир","над","Мусой","и Харуном"]],[37,121,["إِنَّا","كَذَٰلِكَ","نَجۡزِي","ٱلۡمُحۡسِنِينَ"],"инна казалика нажзил мухсиниин","Воистину, так Мы воздаем творящим добро.",["поистине, Мы","так","воздаём","творящим добро"]],[37,122,["إِنَّهُمَا","مِنۡ","عِبَادِنَا","ٱلۡمُؤۡمِنِينَ"],"иннахума мин `ибадинал му'миниин","Воистину, они - одни из Наших верующих рабов.",["поистине, они оба","из","Наших рабов","верующих"]],[37,123,["وَإِنَّ","إِلۡيَاسَ","لَمِنَ","ٱلۡمُرۡسَلِينَ"],"ва'инна илйаса ламинал мурсалиин","Ильяс (Илия) также был одним из посланников.",["и поистине","Ильяс","непременно из","посланников"]],[37,124,["إِذۡ","قَالَ","لِقَوۡمِهِۦٓ","أَلَا","تَتَّقُونَ"],"из ḳала лиḳаумихии ала таттаḳуун","Он сказал своему народу: «Неужели вы не устрашитесь?",["вот","сказал он","своему народу","неужели не","побоитесь вы"]],[37,125,["أَتَدۡعُونَ","بَعۡلٗا","وَتَذَرُونَ","أَحۡسَنَ","ٱلۡخَٰلِقِينَ"],"атад`ууна ба`лан ватазарууна ахсанал халиḳиин","Неужели вы взываете к Балу и оставляете Самого прекрасного из творцов -",["неужели взываете вы","к Ваалу","и оставляете","Лучшего","из творцов"]],[37,126,["ٱللَّهَ","رَبَّكُمۡ","وَرَبَّ","ءَابَآئِكُمُ","ٱلۡأَوَّلِينَ"],"аллаха раббакум варабба абаикумул аввалиин","Аллаха, Господа вашего и Господа ваших праотцев?».",["Аллаха","Господа вашего","и Господа","отцов ваших","первых"]]],"m":[[["فَلَمَّآ","и когда",37,103],["أَسۡلَمَا","оба покорились",37,103],["وَتَلَّهُۥ","и он уложил его",37,103],["لِلۡجَبِينِ","на висок (лбом)",37,103],[103],["وَنَٰدَيۡنَٰهُ","и Мы воззвали к нему",37,104],["أَن","что",37,104],["يَٰٓإِبۡرَٰهِيمُ","о Ибрахим",37,104],[104],["قَدۡ","уже",37,105]],[["صَدَّقۡتَ","ты оправдал",37,105],["ٱلرُّءۡيَآۚ","сон",37,105],["إِنَّا","поистине, Мы",37,105],["كَذَٰلِكَ","так",37,105],["نَجۡزِي","воздаем",37,105],["ٱلۡمُحۡسِنِينَ","творящим добро",37,105],[105],["إِنَّ","поистине",37,106],["هَٰذَا","это",37,106],["لَهُوَ","непременно оно",37,106]],[["ٱلۡبَلَٰٓؤُاْ","испытание",37,106],["ٱلۡمُبِينُ","явное",37,106],[106],["وَفَدَيۡنَٰهُ","и Мы выкупили его",37,107],["بِذِبۡحٍ","жертвой",37,107],["عَظِيمٖ","великой",37,107],[107],["وَتَرَكۡنَا","и Мы оставили",37,108],["عَلَيۡهِ","о нём",37,108],["فِي","среди",3