{"p":450,"j":23,"a":[[37,103,["فَلَمَّآ","أَسۡلَمَا","وَتَلَّهُۥ","لِلۡجَبِينِ"],"фаламмаа асламаа уаталлахуу лилджабиин","Когда они оба покорились, и он уложил его на бок,",["и когда","оба покорились","и он уложил его","на висок (лбом)"]],[37,104,["وَنَٰدَيۡنَٰهُ","أَن","يَٰٓإِبۡرَٰهِيمُ"],"уанаадайнааху ан йаа'ибраахиим","Мы воззвали к нему: «О Ибрахим (Авраам)!",["и Мы воззвали к нему","что","о Ибрахим"]],[37,105,["قَدۡ","صَدَّقۡتَ","ٱلرُّءۡيَآۚ","إِنَّا","كَذَٰلِكَ","نَجۡزِي","ٱلۡمُحۡسِنِينَ"],"кад саддакта рру'йаа иннаа казаалика наджзии лмухсиниин","Ты оправдал сновидение». Воистину, так Мы воздаем творящим добро.",["уже","ты оправдал","сон","поистине, Мы","так","воздаем","творящим добро"]],[37,106,["إِنَّ","هَٰذَا","لَهُوَ","ٱلۡبَلَٰٓؤُاْ","ٱلۡمُبِينُ"],"инна хаазаа лахууа лбалаа'у лмубиин","Это и есть явное испытание (или явная милость).",["поистине","это","непременно оно","испытание","явное"]],[37,107,["وَفَدَيۡنَٰهُ","بِذِبۡحٍ","عَظِيمٖ"],"уафадайнааху бизибхин `азиим","Мы выкупили его великой жертвой.",["и Мы выкупили его","жертвой","великой"]],[37,108,["وَتَرَكۡنَا","عَلَيۡهِ","فِي","ٱلۡأٓخِرِينَ"],"уатаракнаа `алайхи фии л'хириин","Мы оставили о нем в последующих поколениях добрую молву.",["и Мы оставили","о нём","среди","последующих"]],[37,109,["سَلَٰمٌ","عَلَىٰٓ","إِبۡرَٰهِيمَ"],"салаамун `алаа ибраахиим","Мир Ибрахиму (Аврааму)!",["мир","над","Ибрахимом"]],[37,110,["كَذَٰلِكَ","نَجۡزِي","ٱلۡمُحۡسِنِينَ"],"казаалика наджзии лмухсиниин","Воистину, так Мы воздаем творящим добро.",["так","Мы вознаграждаем","творящих добро"]],[37,111,["إِنَّهُۥ","مِنۡ","عِبَادِنَا","ٱلۡمُؤۡمِنِينَ"],"иннахуу мин `ибаадинаа лму'миниин","Воистину, он - один из Наших верующих рабов.",["поистине, он","из","Наших рабов","верующих"]],[37,112,["وَبَشَّرۡنَٰهُ","بِإِسۡحَٰقَ","نَبِيّٗا","مِّنَ","ٱلصَّٰلِحِينَ"],"уабашшарнааху би'исхаака набиййам мина ссаалихиин","Мы обрадовали его вестью об Исхаке (Исааке) - пророке из числа праведников.",["и Мы обрадовали его","Исхаком","пророком","из","праведников"]],[37,113,["وَبَٰرَكۡنَا","عَلَيۡهِ","وَعَلَىٰٓ","إِسۡحَٰقَۚ","وَمِن","ذُرِّيَّتِهِمَا","مُحۡسِنٞ","وَظَالِمٞ","لِّنَفۡسِهِۦ","مُبِينٞ"],"уабааракнаа `алайхи уа`алаа исхаака уамин зурриййатихимаа мухсинун уазаалимул линафсихии мубиин","Мы благословили его и Исхака (Исаака). Среди их потомства есть творящие добро и поступающие явно несправедливо к самим себе.",["и Мы благословили","его","и","Исхака","и из","их потомства","творящий добро","и несправедливый","к самому себе","явно"]],[37,114,["وَلَقَدۡ","مَنَنَّا","عَلَىٰ","مُوسَىٰ","وَهَٰرُونَ"],"уалакад мананнаа `алаа муусаа уахааруун","Мы оказали милость Мусе (Моисею) и Харуну (Аарону).",["и уже","Мы оказали милость","к","Мусе","и Харуну"]],[37,115,["وَنَجَّيۡنَٰهُمَا","وَقَوۡمَهُمَا","مِنَ","ٱلۡكَرۡبِ","ٱلۡعَظِيمِ"],"уанаджджайнаахумаа уакаумахумаа мина лкарби л`азиим","Мы спасли их обоих и их народ от великой печали.",["и Мы спасли их обоих","и их народ","от","бедствия","великого"]],[37,116,["وَنَصَرۡنَٰهُمۡ","فَكَانُواْ","هُمُ","ٱلۡغَٰلِبِينَ"],"уанасарнаахум факаануу хуму лгаалибиин","Мы оказали им помощь, и именно они стали победителями.",["и Мы помогли им","и были","именно они","победителями"]],[37,117,["وَءَاتَيۡنَٰهُمَا","ٱلۡكِتَٰبَ","ٱلۡمُسۡتَبِينَ"],"уа'аатайнаахумаа лкитааба лмустабиин","Мы даровали им ясное Писание",["и Мы даровали им обоим","Писание","ясное"]],[37,118,["وَهَدَيۡنَٰهُمَا","ٱلصِّرَٰطَ","ٱلۡمُسۡتَقِيمَ"],"уахадайнаахумаа ссираата лмустакиим","и повели их прямым путем.",["и Мы повели их обоих","путём","прямым"]],[37,119,["وَتَرَكۡنَا","عَلَيۡهِمَا","فِي","ٱلۡأٓخِرِينَ"],"уатаракнаа `алайхимаа фии л'хириин","Мы оставили о них в последующих поколениях добрую молву.",["и Мы оставили","о них обоих","среди","последующих"]],[37,120,["سَلَٰمٌ","عَلَىٰ","مُوسَىٰ","وَهَٰرُونَ"],"салаамун `алаа муусаа уахааруун","Мир Мусе (Моисею) и Харуну (Аарону)!",["мир","над","Мусой","и Харуном"]],[37,121,["إِنَّا","كَذَٰلِكَ","نَجۡزِي","ٱلۡمُحۡسِنِينَ"],"иннаа казаалика наджзии лмухсиниин","Воистину, так Мы воздаем творящим добро.",["поистине, Мы","так","воздаём","творящим добро"]],[37,122,["إِنَّهُمَا","مِنۡ","عِبَادِنَا","ٱلۡمُؤۡمِنِينَ"],"иннахумаа мин `ибаадинаа лму'миниин","Воистину, они - одни из Наших верующих рабов.",["поистине, они оба","из","Наших рабов","верующих"]],[37,123,["وَإِنَّ","إِلۡيَاسَ","لَمِنَ","ٱلۡمُرۡسَلِينَ"],"уа'инна илйааса ламина лмурсалиин","Ильяс (Илия) также был одним из посланников.",["и поистине","Ильяс","непременно из","посланников"]],[37,124,["إِذۡ","قَالَ","لِقَوۡمِهِۦٓ","أَلَا","تَتَّقُونَ"],"из каала ликаумихии алаа таттакуун","Он сказал своему народу: «Неужели вы не устрашитесь?",["вот","сказал он","своему народу","неужели не","побоитесь вы"]],[37,125,["أَتَدۡعُونَ","بَعۡلٗا","وَتَذَرُونَ","أَحۡسَنَ","ٱلۡخَٰلِقِينَ"],"атад`ууна ба`лан уатазарууна ахсана лхааликиин","Неужели вы взываете к Балу и оставляете Самого прекрасного из творцов -",["неужели взываете вы","к Ваалу","и оставляете","Лучшего","из творцов"]],[37,126,["ٱللَّهَ","رَبَّكُمۡ","وَرَبَّ","ءَابَآئِكُمُ","ٱلۡأَوَّلِينَ"],"аллаха раббакум уарабба аабаа'икуму л'аууалиин","Аллаха, Господа вашего и Господа ваших праотцев?».",["Аллаха","Господа вашего","и Господа","отцов ваших","первых"]]]}