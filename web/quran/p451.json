{"p":451,"j":23,"a":[[37,127,["فَكَذَّبُوهُ","فَإِنَّهُمۡ","لَمُحۡضَرُونَ"],"факаззабууху фа'иннахум ламухдаруун","Они сочли его лжецом, и все они непременно будут собраны в Аду,",["и они сочли его лжецом","и поистине, они","непременно будут доставлены"]],[37,128,["إِلَّا","عِبَادَ","ٱللَّهِ","ٱلۡمُخۡلَصِينَ"],"илла `ибадаллахил мухласиин","кроме избранных (или искренних) рабов Аллаха.",["кроме","рабов","Аллаха","избранных"]],[37,129,["وَتَرَكۡنَا","عَلَيۡهِ","فِي","ٱلۡأٓخِرِينَ"],"ватаракна `алайхи фил ахириин","Мы оставили о нем в последующих поколениях добрую молву.",["и Мы оставили","о нём","среди","последующих"]],[37,130,["سَلَٰمٌ","عَلَىٰٓ","إِلۡ يَاسِينَ"],"саламун `ала илйасиин","Мир Ильясину (Ильясу, или семейству Йасина)!",["мир","над","Ильясином"]],[37,131,["إِنَّا","كَذَٰلِكَ","نَجۡزِي","ٱلۡمُحۡسِنِينَ"],"инна казалика нажзил мухсиниин","Воистину, так Мы воздаем творящим добро.",["поистине, Мы","так","воздаём","творящим добро"]],[37,132,["إِنَّهُۥ","مِنۡ","عِبَادِنَا","ٱلۡمُؤۡمِنِينَ"],"иннахуу мин `ибадинал му'миниин","Воистину, он - один из Наших верующих рабов.",["поистине, он","из","Наших рабов","верующих"]],[37,133,["وَإِنَّ","لُوطٗا","لَّمِنَ","ٱلۡمُرۡسَلِينَ"],"ва'инна луутал ламинал мурсалиин","Лут (Лот) также был одним из посланников.",["и поистине","Лут","непременно из","посланников"]],[37,134,["إِذۡ","نَجَّيۡنَٰهُ","وَأَهۡلَهُۥٓ","أَجۡمَعِينَ"],"из нажжайнаху ва'ахлахуу ажма`иин","Мы спасли его и всю его семью,",["вот","Мы спасли его","и его семью","всех"]],[37,135,["إِلَّا","عَجُوزٗا","فِي","ٱلۡغَٰبِرِينَ"],"илла `ажуузан фил габириин","кроме старухи, которая была в числе оставшихся позади.",["кроме","старухи","среди","оставшихся позади"]],[37,136,["ثُمَّ","دَمَّرۡنَا","ٱلۡأٓخَرِينَ"],"сумма даммарнал ахариин","Затем Мы уничтожили всех остальных.",["затем","Мы уничтожили","остальных"]],[37,137,["وَإِنَّكُمۡ","لَتَمُرُّونَ","عَلَيۡهِم","مُّصۡبِحِينَ"],"ва'иннакум латамуррууна `алайхим мусбихиин","Вы проходите мимо них утром",["и поистине, вы","непременно проходите","мимо них","утром"]],[37,138,["وَبِٱلَّيۡلِۚ","أَفَلَا","تَعۡقِلُونَ"],"вабиллайли афала та`ḳилуун","и вечером. Неужели вы не разумеете?",["и ночью","неужели же не","уразумеете вы"]],[37,139,["وَإِنَّ","يُونُسَ","لَمِنَ","ٱلۡمُرۡسَلِينَ"],"ва'инна йуунуса ламинал мурсалиин","Йунус (Иона) также был одним из посланников.",["и поистине","Йунус","непременно из","посланников"]],[37,140,["إِذۡ","أَبَقَ","إِلَى","ٱلۡفُلۡكِ","ٱلۡمَشۡحُونِ"],"из абаḳа илал фулкил машхуун","Он сбежал на переполненный корабль.",["вот","сбежал он","к","кораблю","переполненному"]],[37,141,["فَسَاهَمَ","فَكَانَ","مِنَ","ٱلۡمُدۡحَضِينَ"],"фасахама факана минал мудхадиин","Он бросил жребий вместе с другими и оказался проигравшим.",["и он бросил жребий","и оказался","из","проигравших"]],[37,142,["فَٱلۡتَقَمَهُ","ٱلۡحُوتُ","وَهُوَ","مُلِيمٞ"],"фалтаḳамахул хууту вахуа мулиим","Его проглотила рыба, когда он был достоин порицания.",["и проглотила его","рыба","а он","достоин порицания"]],[37,143,["فَلَوۡلَآ","أَنَّهُۥ","كَانَ","مِنَ","ٱلۡمُسَبِّحِينَ"],"фалаула аннахуу кана минал мусаббихиин","Если бы он не был одним из прославляющих Аллаха,",["и если бы не","то, что он","был","из","прославляющих"]],[37,144,["لَلَبِثَ","فِي","بَطۡنِهِۦٓ","إِلَىٰ","يَوۡمِ","يُبۡعَثُونَ"],"лалабиса фии батнихии ила йауми йуб`асуун","то непременно остался бы в ее чреве до того дня, когда они будут воскрешены.",["непременно пребывал бы он","в","её чреве","до","дня","будут воскрешены они"]],[37,145,["فَنَبَذۡنَٰهُ","بِٱلۡعَرَآءِ","وَهُوَ","سَقِيمٞ"],"фанабазнаху бил`араи вахуа саḳиим","Мы выбросили его на открытую местность, и он был болен.",["и Мы выбросили его","на голое место","а он","болен"]],[37,146,["وَأَنۢبَتۡنَا","عَلَيۡهِ","شَجَرَةٗ","مِّن","يَقۡطِينٖ"],"ва'амбатна `алайхи шажаратам мин йаḳтиин","Мы взрастили над ним (или возле него) тыкву.",["и Мы взрастили","над ним","растение","из","тыквы"]],[37,147,["وَأَرۡسَلۡنَٰهُ","إِلَىٰ","مِاْئَةِ","أَلۡفٍ","أَوۡ","يَزِيدُونَ"],"ва'арсалнаху ила миа