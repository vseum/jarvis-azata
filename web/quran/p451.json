{"p":451,"j":23,"a":[[37,127,["فَكَذَّبُوهُ","فَإِنَّهُمۡ","لَمُحۡضَرُونَ"],"факаззабууху фа'иннахум ламухдаруун","Они сочли его лжецом, и все они непременно будут собраны в Аду,",["и они сочли его лжецом","и поистине, они","непременно будут доставлены"]],[37,128,["إِلَّا","عِبَادَ","ٱللَّهِ","ٱلۡمُخۡلَصِينَ"],"иллаа `ибаада ллахи лмухласиин","кроме избранных (или искренних) рабов Аллаха.",["кроме","рабов","Аллаха","избранных"]],[37,129,["وَتَرَكۡنَا","عَلَيۡهِ","فِي","ٱلۡأٓخِرِينَ"],"уатаракнаа `алайхи фии л'хириин","Мы оставили о нем в последующих поколениях добрую молву.",["и Мы оставили","о нём","среди","последующих"]],[37,130,["سَلَٰمٌ","عَلَىٰٓ","إِلۡ يَاسِينَ"],"салаамун `алаа илйаасиин","Мир Ильясину (Ильясу, или семейству Йасина)!",["мир","над","Ильясином"]],[37,131,["إِنَّا","كَذَٰلِكَ","نَجۡزِي","ٱلۡمُحۡسِنِينَ"],"иннаа казаалика наджзии лмухсиниин","Воистину, так Мы воздаем творящим добро.",["поистине, Мы","так","воздаём","творящим добро"]],[37,132,["إِنَّهُۥ","مِنۡ","عِبَادِنَا","ٱلۡمُؤۡمِنِينَ"],"иннахуу мин `ибаадинаа лму'миниин","Воистину, он - один из Наших верующих рабов.",["поистине, он","из","Наших рабов","верующих"]],[37,133,["وَإِنَّ","لُوطٗا","لَّمِنَ","ٱلۡمُرۡسَلِينَ"],"уа'инна луутал ламина лмурсалиин","Лут (Лот) также был одним из посланников.",["и поистине","Лут","непременно из","посланников"]],[37,134,["إِذۡ","نَجَّيۡنَٰهُ","وَأَهۡلَهُۥٓ","أَجۡمَعِينَ"],"из наджджайнааху уа'ахлахуу аджма`иин","Мы спасли его и всю его семью,",["вот","Мы спасли его","и его семью","всех"]],[37,135,["إِلَّا","عَجُوزٗا","فِي","ٱلۡغَٰبِرِينَ"],"иллаа `аджуузан фии лгаабириин","кроме старухи, которая была в числе оставшихся позади.",["кроме","старухи","среди","оставшихся позади"]],[37,136,["ثُمَّ","دَمَّرۡنَا","ٱلۡأٓخَرِينَ"],"сумма даммарнаа л'хариин","Затем Мы уничтожили всех остальных.",["затем","Мы уничтожили","остальных"]],[37,137,["وَإِنَّكُمۡ","لَتَمُرُّونَ","عَلَيۡهِم","مُّصۡبِحِينَ"],"уа'иннакум латамуррууна `алайхим ммусбихиин","Вы проходите мимо них утром",["и поистине, вы","непременно проходите","мимо них","утром"]],[37,138,["وَبِٱلَّيۡلِۚ","أَفَلَا","تَعۡقِلُونَ"],"уабиллайли афалаа та`килуун","и вечером. Неужели вы не разумеете?",["и ночью","неужели же не","уразумеете вы"]],[37,139,["وَإِنَّ","يُونُسَ","لَمِنَ","ٱلۡمُرۡسَلِينَ"],"уа'инна йуунуса ламина лмурсалиин","Йунус (Иона) также был одним из посланников.",["и поистине","Йунус","непременно из","посланников"]],[37,140,["إِذۡ","أَبَقَ","إِلَى","ٱلۡفُلۡكِ","ٱلۡمَشۡحُونِ"],"из абака илаа лфулки лмашхуун","Он сбежал на переполненный корабль.",["вот","сбежал он","к","кораблю","переполненному"]],[37,141,["فَسَاهَمَ","فَكَانَ","مِنَ","ٱلۡمُدۡحَضِينَ"],"фасаахама факаана мина лмудхадиин","Он бросил жребий вместе с другими и оказался проигравшим.",["и он бросил жребий","и оказался","из","проигравших"]],[37,142,["فَٱلۡتَقَمَهُ","ٱلۡحُوتُ","وَهُوَ","مُلِيمٞ"],"фалтакамаху лхууту уахууа мулиим","Его проглотила рыба, когда он был достоин порицания.",["и проглотила его","рыба","а он","достоин порицания"]],[37,143,["فَلَوۡلَآ","أَنَّهُۥ","كَانَ","مِنَ","ٱلۡمُسَبِّحِينَ"],"фалаулаа аннахуу каана мина лмусаббихиин","Если бы он не был одним из прославляющих Аллаха,",["и если бы не","то, что он","был","из","прославляющих"]],[37,144,["لَلَبِثَ","فِي","بَطۡنِهِۦٓ","إِلَىٰ","يَوۡمِ","يُبۡعَثُونَ"],"лалабиса фии батнихии илаа йауми йуб`асуун","то непременно остался бы в ее чреве до того дня, когда они будут воскрешены.",["непременно пребывал бы он","в","её чреве","до","дня","будут воскрешены они"]],[37,145,["فَنَبَذۡنَٰهُ","بِٱلۡعَرَآءِ","وَهُوَ","سَقِيمٞ"],"фанабазнааху бил`араа'и уахууа сакиим","Мы выбросили его на открытую местность, и он был болен.",["и Мы выбросили его","на голое место","а он","болен"]],[37,146,["وَأَنۢبَتۡنَا","عَلَيۡهِ","شَجَرَةٗ","مِّن","يَقۡطِينٖ"],"уа'амбатнаа `алайхи шаджаратам мин йактиин","Мы взрастили над ним (или возле него) тыкву.",["и Мы взрастили","над ним","растение","из","тыквы"]],[37,147,["وَأَرۡسَلۡنَٰهُ","إِلَىٰ","مِاْئَةِ","أَلۡفٍ","أَوۡ","يَزِيدُونَ"],"уа'арсалнааху илаа ми'ати алфин ау йазиидуун","Мы отправили его к ста тысячам или даже больше того.",["и Мы отправили его","к","ста","тысячам","или","больше"]],[37,148,["فَـَٔامَنُواْ","فَمَتَّعۡنَٰهُمۡ","إِلَىٰ","حِينٖ"],"фа'аамануу фаматта`наахум илаа хиин","Они уверовали, и Мы позволили им пользоваться благами до определенного времени.",["и они уверовали","и Мы дали им пользоваться","до","времени"]],[37,149,["فَٱسۡتَفۡتِهِمۡ","أَلِرَبِّكَ","ٱلۡبَنَاتُ","وَلَهُمُ","ٱلۡبَنُونَ"],"фастафтихим алираббика лбанаату уалахуму лбануун","Спроси их, почему это у твоего Господа дочери, а у них - сыновья?",["спроси же их","неужели у твоего Господа","дочери","а у них","сыновья"]],[37,150,["أَمۡ","خَلَقۡنَا","ٱلۡمَلَٰٓئِكَةَ","إِنَٰثٗا","وَهُمۡ","شَٰهِدُونَ"],"ам халакнаа лмалаа'иката инаасан уахум шаахидуун","Или же Мы сотворили ангелов женщинами, и они присутствовали при этом?",["или","Мы сотворили","ангелов","женщинами","а они","свидетели"]],[37,151,["أَلَآ","إِنَّهُم","مِّنۡ","إِفۡكِهِمۡ","لَيَقُولُونَ"],"алаа иннахум ммин ифкихим лайакуулуун","Воистину, по своей лживости они говорят:",["о да","поистине, они","из-за","их лживости","непременно говорят"]],[37,152,["وَلَدَ","ٱللَّهُ","وَإِنَّهُمۡ","لَكَٰذِبُونَ"],"уалада ллаху уа'иннахум лакаазибуун","«Аллах родил». Воистину, они - лжецы.",["родил","Аллах","и поистине, они","непременно лжецы"]],[37,153,["أَصۡطَفَى","ٱلۡبَنَاتِ","عَلَى","ٱلۡبَنِينَ"],"астафаа лбанаати `алаа лбаниин","Неужели Он избрал дочерей и возвысил их над сыновьями?",["неужели избрал Он","дочерей","над","сыновьями"]]]}