{"p":452,"j":23,"a":[[37,154,["مَا","لَكُمۡ","كَيۡفَ","تَحۡكُمُونَ"],"маа лакум кайфа тахкумуун","Что с вами? Как вы судите?",["что","с вами","как","судите"]],[37,155,["أَفَلَا","تَذَكَّرُونَ"],"афалаа тазаккаруун","Не помянуть ли вам назидание?",["неужели же не","опомнитесь вы"]],[37,156,["أَمۡ","لَكُمۡ","سُلۡطَٰنٞ","مُّبِينٞ"],"ам лакум султаанум мубиин","Или у вас есть ясное доказательство?",["или","у вас","довод","ясный"]],[37,157,["فَأۡتُواْ","بِكِتَٰبِكُمۡ","إِن","كُنتُمۡ","صَٰدِقِينَ"],"фа'туу бикитаабикум ин кунтум саадикиин","Принесите же ваше Писание, если вы говорите правду.",["так принесите","ваше писание","если","вы","правдивы"]],[37,158,["وَجَعَلُواْ","بَيۡنَهُۥ","وَبَيۡنَ","ٱلۡجِنَّةِ","نَسَبٗاۚ","وَلَقَدۡ","عَلِمَتِ","ٱلۡجِنَّةُ","إِنَّهُمۡ","لَمُحۡضَرُونَ"],"уаджа`алуу байнахуу уабайна лджиннати насабан уалакад `алимати лджиннату иннахум ламухдаруун","Они установили родство между Ним и джиннами, но джинны знают, что они будут собраны (неверующие будут собраны в Геенне, или джинны будут собраны для расчета).",["и установили они","между Ним","и между","джиннами","родство","и уже","знали","джинны","что они","непременно будут доставлены"]],[37,159,["سُبۡحَٰنَ","ٱللَّهِ","عَمَّا","يَصِفُونَ"],"субхаана ллахи `аммаа йасифуун","Аллах превыше того, что они приписывают Ему.",["пречист","Аллах","от того, что","приписывают они"]],[37,160,["إِلَّا","عِبَادَ","ٱللَّهِ","ٱلۡمُخۡلَصِينَ"],"иллаа `ибаада ллахи лмухласиин","Не делают этого только избранные (или искренние) рабы Аллаха.",["кроме","рабов","Аллаха","избранных"]],[37,161,["فَإِنَّكُمۡ","وَمَا","تَعۡبُدُونَ"],"фа'иннакум уамаа та`будуун","Вы (многобожники) и то, чему вы поклоняетесь,",["и поистине, вы","и то, чему","поклоняетесь вы"]],[37,162,["مَآ","أَنتُمۡ","عَلَيۡهِ","بِفَٰتِنِينَ"],"маа антум `алайхи бифаатиниин","не сможете отвратить от Него никого,",["не","вы","против Него","совратите (никого)"]],[37,163,["إِلَّا","مَنۡ","هُوَ","صَالِ","ٱلۡجَحِيمِ"],"иллаа ман хууа саали лджахиим","кроме тех, кому суждено сгореть в Аду.",["кроме","того, кто","он","горящий","в Аду"]],[37,164,["وَمَا","مِنَّآ","إِلَّا","لَهُۥ","مَقَامٞ","مَّعۡلُومٞ"],"уамаа миннаа иллаа лахуу макаамум ма`луум","Ангелы сказали: «У каждого из нас есть известное место.",["и нет","из нас","кроме","у него","место","известное"]],[37,165,["وَإِنَّا","لَنَحۡنُ","ٱلصَّآفُّونَ"],"уа'иннаа ланахну ссааффуун","Воистину, мы выстраиваемся рядами.",["и поистине, мы","непременно мы","стоящие рядами"]],[37,166,["وَإِنَّا","لَنَحۡنُ","ٱلۡمُسَبِّحُونَ"],"уа'иннаа ланахну лмусаббихуун","Воистину, мы прославляем Аллаха».",["и поистине, мы","непременно мы","прославляющие"]],[37,167,["وَإِن","كَانُواْ","لَيَقُولُونَ"],"уа'ин каануу лайакуулуун","Они (мекканские многобожники) сказали:",["и поистине","были они","непременно говорили"]],[37,168,["لَوۡ","أَنَّ","عِندَنَا","ذِكۡرٗا","مِّنَ","ٱلۡأَوَّلِينَ"],"лау анна `инданаа зикрам мина л'аууалиин","«Если бы у нас было напоминание от первых поколений,",["если бы","что","у нас","напоминание","от","первых"]],[37,169,["لَكُنَّا","عِبَادَ","ٱللَّهِ","ٱلۡمُخۡلَصِينَ"],"лакуннаа `ибаада ллахи лмухласиин","то мы непременно были бы избранными рабами Аллаха».",["непременно были бы мы","рабами","Аллаха","избранными"]],[37,170,["فَكَفَرُواْ","بِهِۦۖ","فَسَوۡفَ","يَعۡلَمُونَ"],"факафаруу бихии фасауфа йа`ламуун","Они не уверовали в него, и скоро они узнают.",["но они не уверовали","в него","и скоро","узнают они"]],[37,171,["وَلَقَدۡ","سَبَقَتۡ","كَلِمَتُنَا","لِعِبَادِنَا","ٱلۡمُرۡسَلِينَ"],"уалакад сабакат калиматунаа ли`ибаадинаа лмурсалиин","Нашим посланным рабам уже было сказано Наше Слово.",["и уже","опередило","слово Наше","рабам Нашим","посланным"]],[37,172,["إِنَّهُمۡ","لَهُمُ","ٱلۡمَنصُورُونَ"],"иннахум лахуму лмансууруун","Воистину, им будет оказана помощь.",["поистине, они","непременно они","получающие помощь"]],[37,173,["وَإِنَّ","جُندَنَا","لَهُمُ","ٱلۡغَٰلِبُونَ"],"уа'инна джунданаа лахуму лгаалибуун","Воистину, Наше войско одержит победу.",["и поистине","Наше войско","непременно они","одерживающие верх"]],[37,174,["فَتَوَلَّ","عَنۡهُمۡ","حَتَّىٰ","حِينٖ"],"фатауалла `анхум хаттаа хиин","Отвернись же от них до определенного срока.",["так отвернись","от них","до","времени"]],[37,175,["وَأَبۡصِرۡهُمۡ","فَسَوۡفَ","يُبۡصِرُونَ"],"уа'абсирхум фасауфа йубсируун","Посмотри на них, и скоро они увидят.",["и смотри на них","и скоро","увидят они"]],[37,176,["أَفَبِعَذَابِنَا","يَسۡتَعۡجِلُونَ"],"афаби`азаабинаа йаста`джилуун","Неужели они торопят мучения от Нас?",["неужели Наше наказание","торопят они"]],[37,177,["فَإِذَا","نَزَلَ","بِسَاحَتِهِمۡ","فَسَآءَ","صَبَاحُ","ٱلۡمُنذَرِينَ"],"фа'изаа назала бисаахатихим фасаа'а сабааху лмунзариин","Когда они сойдут на их участки, то скверно будет утро тех, кого предостерегали.",["а когда","сойдёт оно","на их двор","то скверно","утро","предостережённых"]],[37,178,["وَتَوَلَّ","عَنۡهُمۡ","حَتَّىٰ","حِينٖ"],"уатауалла `анхум хаттаа хиин","Отвернись же от них до определенного срока.",["и отвернись","от них","до","времени"]],[37,179,["وَأَبۡصِرۡ","فَسَوۡفَ","يُبۡصِرُونَ"],"уа'абсир фасауфа йубсируун","Посмотри, и скоро они увидят.",["и смотри","и скоро","увидят они"]],[37,180,["سُبۡحَٰنَ","رَبِّكَ","رَبِّ","ٱلۡعِزَّةِ","عَمَّا","يَصِفُونَ"],"субхаана раббика рабби л`иззати `аммаа йасифуун","Твой Господь, Господь могущества, пречист и далек от того, что они приписывают Ему.",["пречист","твой Господь","Господь","могущества","от того, что","приписывают они"]],[37,181,["وَسَلَٰمٌ","عَلَى","ٱلۡمُرۡسَلِينَ"],"уасалаамун `алаа лмурсалиин","Мир посланникам!",["и мир","над","посланниками"]],[37,182,["وَٱلۡحَمۡدُ","لِلَّهِ","رَبِّ","ٱلۡعَٰلَمِينَ"],"уалхамду лиллахи рабби л`ааламиин","Хвала Аллаху, Господу миров!",["и хвала","Аллаху","Господу","миров"]]]}