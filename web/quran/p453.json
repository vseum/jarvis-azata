{"p":453,"j":23,"a":[[38,1,["صٓۚ","وَٱلۡقُرۡءَانِ","ذِي","ٱلذِّكۡرِ"],"с валḳур'ани зиз зикр","Сад. Клянусь Кораном, содержащим напоминание!",["Сад","клянусь Кораном","обладающим","напоминанием"]],[38,2,["بَلِ","ٱلَّذِينَ","كَفَرُواْ","فِي","عِزَّةٖ","وَشِقَاقٖ"],"балил лазиина кафаруу фии `иззатин вашиḳаḳ","Однако те, которые не веруют, пребывают в гордыне и разладе с истиной.",["но","те, которые","не уверовали","в","гордыне","и раздоре"]],[38,3,["كَمۡ","أَهۡلَكۡنَا","مِن","قَبۡلِهِم","مِّن","قَرۡنٖ","فَنَادَواْ","وَّلَاتَ","حِينَ","مَنَاصٖ"],"кам ахлакна мин ḳаблихим мин ḳарнин фанадав валата хиина манас","Как же много поколений погубили Мы до них! Они взывали, но уже было поздно для того, чтобы уклониться.",["сколько","Мы погубили","из","до них","из","поколений","и воззвали они","но не было","времени","спасения"]],[38,4,["وَعَجِبُوٓاْ","أَن","جَآءَهُم","مُّنذِرٞ","مِّنۡهُمۡۖ","وَقَالَ","ٱلۡكَٰفِرُونَ","هَٰذَا","سَٰحِرٞ","كَذَّابٌ"],"ва`ажибуу ан жаахум мунзирум минхум ваḳалал кафирууна хаза сахирун каззаб","Они удивились тому, что к ним явился предостерегающий увещеватель из них самих, и неверующие сказали: «Это - лживый колдун!",["и удивились они","что","пришёл к ним","предостерегающий","из них самих","и сказали","неверующие","это","колдун","лжец"]],[38,5,["أَجَعَلَ","ٱلۡأٓلِهَةَ","إِلَٰهٗا","وَٰحِدًاۖ","إِنَّ","هَٰذَا","لَشَيۡءٌ","عُجَابٞ"],"ажа`алал алихата илахан вахидан инна хаза лашай'ун `ужаб","Неужели он обратил богов в Единственного Бога? Воистину, это - нечто удивительное!».",["неужели сделал он","богов","богом","единым","поистине","это","непременно вещь","удивительная"]],[38,6,["وَٱنطَلَقَ","ٱلۡمَلَأُ","مِنۡهُمۡ","أَنِ","ٱمۡشُواْ","وَٱصۡبِرُواْ","عَلَىٰٓ","ءَالِهَتِكُمۡۖ","إِنَّ","هَٰذَا","لَشَيۡءٞ","يُرَادُ"],"ванталаḳал малау минхум анимшуу васбируу `ала алихатикум инна хаза лашай'ун йурад","Знатные люди из их числа удалились со словами: «Ступайте и терпите за ваших богов. Воистину, это - некий замысел (или нечто желанное).",["и удалились","знатные","из них","(говоря)","идите","и терпите","за","ваших богов","поистине","это","непременно вещь","замышляемая"]],[38,7,["مَا","سَمِعۡنَا","بِهَٰذَا","فِي","ٱلۡمِلَّةِ","ٱلۡأٓخِرَةِ","إِنۡ","هَٰذَآ","إِلَّا","ٱخۡتِلَٰقٌ"],"ма сами`на бихаза фил миллатил ахирати ин хаза иллахтилаḳ","Мы не слышали об этом в последней религии. Это - не что иное, как вымысел.",["не","слышали мы","об этом","в","вере","последней","не","это","кроме","вымысел"]],[38,8,["أَءُنزِلَ","عَلَيۡهِ","ٱلذِّكۡرُ","مِنۢ","بَيۡنِنَاۚ","بَلۡ","هُمۡ","فِي","شَكّٖ","مِّن","ذِكۡرِيۚ","بَل","لَّمَّا","يَذُوقُواْ","عَذَابِ"],"а'унзила `алайхиз зикру мим байнина бал хум фии шакким мин зикрии бал ламма йазууḳуу `азаб","Неужели среди нас Напоминание ниспослано только ему одному?». О нет! Они сомневаются в Моем Напоминании (Коране). О нет! Они еще не вкусили мучений.",["неужели ниспослано","ему","напоминание","из","среди нас","нет же","они","в","сомнении","о","Моём напоминании","нет же","ещё не","вкусили они","Моего наказания"]],[38,9,["أَمۡ","عِندَهُمۡ","خَزَآئِنُ","رَحۡمَةِ","رَبِّكَ","ٱلۡعَزِيزِ","ٱلۡوَهَّابِ"],"ам `индахум хазаину рахмати раббикал `азиизил ваххаб","Или же у них есть сокровищницы милости твоего Господа, Могущественного, Дарующего?",["или","у них","сокровищницы","милости","твоего Господа","Могущественного","Дарующего"]],[38,10,["أَمۡ","لَهُم","مُّلۡكُ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِ","وَمَا","بَيۡنَهُمَاۖ","فَلۡيَرۡتَقُواْ","فِي","ٱلۡأَسۡبَٰبِ"],"ам лахум мулкус самавати вал'арди вама байнахума фалйартаḳуу фил асбаб","Или же им принадлежит власть над небесами, землей и тем, что между ними? Пусть же они поднимутся на небеса по путям (или веревкам).",["или","у них","власть","небес","и земли","и того, что","между ними","пусть же поднимутся они","по","путям"]],[38,11,["جُندٞ","مَّا","هُنَالِكَ","مَهۡزُومٞ","مِّنَ","ٱلۡأَحۡزَابِ"],"жундум ма хуналика махзуумум минал ахзаб","Это войско будет разбито, подобно прежним соумышленникам.",["войско","какое-то","там","разбитое","из","союзников"]],[38,12,["كَذَّبَتۡ","قَبۡلَهُمۡ","قَوۡمُ","نُوحٖ","وَعَادٞ","وَفِرۡعَوۡنُ","ذُو","ٱلۡأَوۡتَادِ"],"каззабат ḳаблахум ḳауму нуухин ва`адун вафир`ауну зул аутад","До них посланников сочли лжецами народ Нуха (Ноя), адиты и Фараон, владыка кольев,",["сочли лжецами","до них","народ","Нуха","и адиты","и Фараон","обладатель","кольев"]],[38,13,["وَثَمُودُ","وَقَوۡمُ","لُوطٖ","وَأَصۡحَٰبُ","لۡـَٔيۡكَةِۚ","أُوْلَٰٓئِكَ","ٱلۡأَحۡزَابُ"],"васамууду ваḳауму луутин ва'асхабул айкати улаикал ахзаб","самудяне, народ Лута (Лота) и жители Айки. Это были соумышленники.",["и самудяне","и народ","Лута","и обитатели","Айки","эти","союзники"]],[38,14,["إِن","كُلٌّ","إِلَّا","كَذَّبَ","ٱلرُّسُلَ","فَحَقَّ","عِقَابِ"],"ин куллун илла каззабар русула фахаḳḳа `иḳаб","Все они сочли лжецами посланников, и истинным было Мое наказание.",["не","каждый","кроме","счёл лжецами","посланников","и сбылось","Моё наказание"]],[38,15,["وَمَا","يَنظُرُ","هَٰٓؤُلَآءِ","إِلَّا","صَيۡحَةٗ","وَٰحِدَةٗ","مَّا","لَهَا","مِن","فَوَاقٖ"],"вама йанзуру ха'улаи илла сайхатан вахидатам ма лаха мин фаваḳ","Им нечего ждать, кроме одного лишь гласа, для которого нет возврата.",["и не","ждут","эти","кроме","клича","единого","не","для него","никакой","отсрочки"]],[38,16,["وَقَالُواْ","رَبَّنَا","عَجِّل","لَّنَا","قِطَّنَا","قَبۡلَ","يَوۡمِ","ٱلۡحِسَابِ"],"ваḳалуу раббана `ажжил лана ḳиттана ḳабла йаумил хисаб","Они сказали: «Господь наш! Приблизь нашу долю (покажи нам книгу с нашими добрыми и злыми деяниями) до наступления Дня расчета».",["и сказали они","Господь наш","ускорь","нам","нашу долю","до","дня","расчёта"]]],"m":[["b"],[["صٓۚ","Сад",38,1],["وَٱلۡقُرۡءَانِ","клянусь Кораном",38,1],["ذِي","обладающим",38,1],["ٱلذِّكۡرِ","напоминанием",38,1],[1],["بَلِ","но",38,2],["ٱلَّذِينَ","те, которые",38,2],["كَفَرُواْ","не уверовали",38,2],["فِي","в",38,2],["عِزَّةٖ","гордыне",38,2],["وَشِقَاقٖ","и раздоре",38,2],[2]],[["كَمۡ","сколько",38,3],["أَهۡلَكۡنَا","Мы погубили",38,3],["مِن","из",38,3],["قَبۡلِهِم","до них",38,3],["مِّن","из",38,