{"p":454,"j":23,"a":[[38,17,["ٱصۡبِرۡ","عَلَىٰ","مَا","يَقُولُونَ","وَٱذۡكُرۡ","عَبۡدَنَا","دَاوُۥدَ","ذَا","ٱلۡأَيۡدِۖ","إِنَّهُۥٓ","أَوَّابٌ"],"исбир `ала ма йаḳуулууна вазкур `абдана давууда зал айди иннахуу авваб","Терпи то, что они говорят, и помяни Нашего могучего раба Давуда (Давида). Он всегда обращался к Аллаху.",["терпи","на","то, что","говорят они","и помяни","Нашего раба","Давуда","обладателя","силы","поистине, он","обращающийся (к Аллаху)"]],[38,18,["إِنَّا","سَخَّرۡنَا","ٱلۡجِبَالَ","مَعَهُۥ","يُسَبِّحۡنَ","بِٱلۡعَشِيِّ","وَٱلۡإِشۡرَاقِ"],"инна саххарнал жибала ма`ахуу йусаббихна бил`ашиййи вал'ишраḳ","Мы подчинили горы, и они славословили вместе с ним после полудня и утром.",["поистине, Мы","подчинили","горы","с ним","славят","вечером","и на восходе"]],[38,19,["وَٱلطَّيۡرَ","مَحۡشُورَةٗۖ","كُلّٞ","لَّهُۥٓ","أَوَّابٞ"],"ваттайра махшууратан куллул лахуу авваб","А также птиц, собранных вместе. Все они обращались к Нему.",["и птиц","собранных","все","к нему","обращающиеся"]],[38,20,["وَشَدَدۡنَا","مُلۡكَهُۥ","وَءَاتَيۡنَٰهُ","ٱلۡحِكۡمَةَ","وَفَصۡلَ","ٱلۡخِطَابِ"],"вашададна мулкахуу ва'атайнахул хикмата вафаслал хитаб","Мы укрепили его власть и даровали ему мудрость и решающее слово.",["и Мы укрепили","его власть","и Мы дали ему","мудрость","и разрешение","речи"]],[38,21,["وَهَلۡ","أَتَىٰكَ","نَبَؤُاْ","ٱلۡخَصۡمِ","إِذۡ","تَسَوَّرُواْ","ٱلۡمِحۡرَابَ"],"вахал атака набаул хасми из тасавварул михраб","Дошла ли до тебя весть о тех, кто затеял тяжбу и перелез через стену молельни?",["и разве","пришла к тебе","весть","о тяжущихся","когда","перелезли они","в молельню"]],[38,22,["إِذۡ","دَخَلُواْ","عَلَىٰ","دَاوُۥدَ","فَفَزِعَ","مِنۡهُمۡۖ","قَالُواْ","لَا","تَخَفۡۖ","خَصۡمَانِ","بَغَىٰ","بَعۡضُنَا","عَلَىٰ","بَعۡضٖ","فَٱحۡكُم","بَيۡنَنَا","بِٱلۡحَقِّ","وَلَا","تُشۡطِطۡ","وَٱهۡدِنَآ","إِلَىٰ","سَوَآءِ","ٱلصِّرَٰطِ"],"из дахалуу `ала давууда фафази`а минхум ḳалуу ла тахаф хасмани бага ба`дуна `ала ба`дин фахкум байнана билхаḳḳи вала туштит вахдина ила саваис сират","Они вошли к Давуду (Давиду), и он испугался их. Они сказали: «Не бойся, мы - двое тяжущихся. Один из нас поступил несправедливо по отношению к другому. Рассуди же между нами по справедливости, не будь несправедлив и укажи нам на верный путь.",["когда","вошли они","к","Давуду","и он испугался","их","сказали они","не","бойся","двое тяжущихся","притеснил","один из нас","на","другого","так рассуди","между нами","по истине","и не","преступай меры","и веди нас","к","ровному","пути"]],[38,23,["إِنَّ","هَٰذَآ","أَخِي","لَهُۥ","تِسۡعٞ","وَتِسۡعُونَ","نَعۡجَةٗ","وَلِيَ","نَعۡجَةٞ","وَٰحِدَةٞ","فَقَالَ","أَكۡفِلۡنِيهَا","وَعَزَّنِي","فِي","ٱلۡخِطَابِ"],"инна хаза ахии лахуу тис`ун ватис`ууна на`жатан валийа на`жатун вахидатун фаḳала акфилнииха ва`аззании фил хитаб","Это - мой брат. У него есть девяносто девять овец, а у меня - всего одна овца. Он сказал: «Отдай ее мне!» - и одолел меня на словах».",["поистине","это","мой брат","у него","девять","и девяносто","овец","а у меня","овца","одна","и сказал он","отдай её мне","и одолел меня","в","речи"]],[38,24,["قَالَ","لَقَدۡ","ظَلَمَكَ","بِسُؤَالِ","نَعۡجَتِكَ","إِلَىٰ","نِعَاجِهِۦۖ","وَإِنَّ","كَثِيرٗا","مِّنَ","ٱلۡخُلَطَآءِ","لَيَبۡغِي","بَعۡضُهُمۡ","عَلَىٰ","بَعۡضٍ","إِلَّا","ٱلَّذِينَ","ءَامَنُواْ","وَعَمِلُواْ","ٱلصَّٰلِحَٰتِ","وَقَلِيلٞ","مَّا","هُمۡۗ","وَظَنَّ","دَاوُۥدُ","أَنَّمَا","فَتَنَّٰهُ","فَٱسۡتَغۡفَرَ","رَبَّهُۥ","وَخَرَّۤ","رَاكِعٗاۤ","وَأَنَابَ ۩"],"ḳала лаḳад заламака бисуали на`жатика ила ни`ажихии ва'инна касиирам минал хулатаи лайабгии ба`духум `ала ба`дин иллал лазиина амануу ва`амилус салихати ваḳалиилум ма хум вазанна давууду аннама фатаннаху фастагфара раббахуу вахарра раки`ан ва'анаб","Давуд (Давид) сказал: «Он поступил по отношению к тебе несправедливо, когда попросил присоединить твою овцу к своим. Воистину, многие партнеры поступают несправедливо по отношению друг к другу, кроме тех, которые уверовали и совершают праведные деяния. Но таких мало». Давуд (Давид) убедился, что Мы подвергли его искушению, попросил прощения у своего Господа, пал ниц и раскаялся.",["сказал он","действительно","он обидел тебя","требованием","твоей овцы","к","его овцам","и поистине","многие","из","компаньонов","непременно притесняют","одни из них","на","других","кроме","тех, которые","уверовали","и совершали","праведные дела","и мало","(же)","их","и понял","Давуд","что","Мы испытали его","и попросил прощения","у своего Господа","и пал","кланяясь","и обратился (к Аллаху)"]],[38,25,["فَغَفَرۡنَا","لَهُۥ","ذَٰلِكَۖ","وَإِنَّ","لَهُۥ","عِندَنَا","لَزُلۡفَىٰ","وَحُسۡنَ","مَـَٔابٖ"],"фагафарна лахуу залика ва'инна лахуу `индана лазулфа вахусна ма'аб","Мы простили ему это. Воистину, он приближен к Нам, и ему уготовано прекрасное место возвращения.",["и Мы простили","ему","это","и поистине","для него","у Нас","непременно близость","и прекрасное","место возвращения"]],[38,26,["يَٰدَاوُۥدُ","إِنَّا","جَعَلۡنَٰكَ","خَلِيفَةٗ","فِي","ٱلۡأَرۡضِ","فَٱحۡكُم","بَيۡنَ","ٱلنَّاسِ","بِٱلۡحَقِّ","وَلَا","تَتَّبِعِ","ٱلۡهَوَىٰ","فَيُضِلَّكَ","عَن","سَبِيلِ","ٱللَّهِۚ","إِنَّ","ٱلَّذِينَ","يَضِلُّونَ","عَن","سَبِيلِ","ٱللَّهِ","لَهُمۡ","عَذَابٞ","شَدِيدُۢ","بِمَا","نَسُواْ","يَوۡمَ","ٱلۡحِسَابِ"],"йадавууду инна жа`алнака халиифатан фил арди фахкум байнан наси билхаḳḳи вала таттаби`ил хава файудиллака `ан сабиилиллахи иннал лазиина йадиллууна `ан сабиилиллахи лахум `азабун шадииду бима насуу йаумал хисаб","О Давуд (Давид)! Воистину, Мы назначили тебя наместником на земле. Суди же людей по справедливости и не потакай порочным желаниям, а не то они собьют тебя с пути Аллаха. Воистину, тем, кто сбивается с пути Аллаха, уготованы тяжкие мучения за то, что они предали забвению День расчета.",["о Давуд","поистине, Мы","Мы сделали тебя","наместником","на","земле","так суди","между","людьми","по истине","и не","следуй","страсти","ибо собьёт она тебя","с","пути","Аллаха","поистине","те, которые","сбиваются","с","пути","Аллаха","для них","наказание","тяжкое","за то, что","забыли они","день","расчёта"]]],"m":[[[