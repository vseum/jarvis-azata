8,23],["نَعۡجَةٗ","овец",38,23]],[["وَلِيَ","а у меня",38,23],["نَعۡجَةٞ","овца",38,23],["وَٰحِدَةٞ","одна",38,23],["فَقَالَ","и сказал он",38,23],["أَكۡفِلۡنِيهَا","отдай её мне",38,23],["وَعَزَّنِي","и одолел меня",38,23],["فِي","в",38,23],["ٱلۡخِطَابِ","речи",38,23],[23],["قَالَ","сказал он",38,24]],[["لَقَدۡ","действительно",38,24],["ظَلَمَكَ","он обидел тебя",38,24],["بِسُؤَالِ","требованием",38,24],["نَعۡجَتِكَ","твоей овцы",38,24],["إِلَىٰ","к",38,24],["نِعَاجِهِۦۖ","его овцам",38,24],["وَإِنَّ","и поистине",38,24],["كَثِيرٗا","многие",38,24],["مِّنَ","из",38,24],["ٱلۡخُلَطَآءِ","компаньонов",38,24],["لَيَبۡغِي","непременно притесняют",38,24]],[["بَعۡضُهُمۡ","одни из них",38,24],["عَلَىٰ","на",38,24],["بَعۡضٍ","других",38,24],["إِلَّا","кроме",38,24],["ٱلَّذِينَ","тех, которые",38,24],["ءَامَنُواْ","уверовали",38,24],["وَعَمِلُواْ","и совершали",38,24],["ٱلصَّٰلِحَٰتِ","праведные дела",38,24],["وَقَلِيلٞ","и мало",38,24]],[["مَّا","(же)",38,24],["هُمۡۗ","их",38,24],["وَظَنَّ","и понял",38,24],["دَاوُۥدُ","Давуд",38,24],["أَنَّمَا","что",38,24],["فَتَنَّٰهُ","Мы испытали его",38,24],["فَٱسۡتَغۡفَرَ","и попросил прощения",38,24],["رَبَّهُۥ","у своего Господа",38,24],["وَخَرَّۤ","и пал",38,24],["رَاكِعٗاۤ","кланяясь",38,24],["وَأَنَابَ ۩","и обратился (к Аллаху)",38,24]],[[24],["فَغَفَرۡنَا","и Мы простили",38,25],["لَهُۥ","ему",38,25],["ذَٰلِكَۖ","это",38,25],["وَإِنَّ","и поистине",38,25],["لَهُۥ","для него",38,25],["عِندَنَا","у Нас",38,25],["لَزُلۡفَىٰ","непременно близость",38,25],["وَحُسۡنَ","и прекрасное",38,25],["مَـَٔابٖ","место возвращения",38,25]],[[25],["يَٰدَاوُۥدُ","о Давуд",38,26],["إِنَّا","поистине, Мы",38,26],["جَعَلۡنَٰكَ","Мы сделали тебя",38,26],["خَلِيفَةٗ","наместником",38,26],["فِي","на",38,26],["ٱلۡأَرۡضِ","земле",38,26],["فَٱحۡكُم","так суди",38,26],["بَيۡنَ","между",38,26],["ٱلنَّاسِ","людьми",38,26]],[["بِٱلۡحَقِّ","по истине",38,26],["وَلَا","и не",38,26],["تَتَّبِعِ","следуй",38,26],["ٱلۡهَوَىٰ","страсти",38,26],["فَيُضِلَّكَ","ибо