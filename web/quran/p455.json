{"p":455,"j":23,"a":[[38,27,["وَمَا","خَلَقۡنَا","ٱلسَّمَآءَ","وَٱلۡأَرۡضَ","وَمَا","بَيۡنَهُمَا","بَٰطِلٗاۚ","ذَٰلِكَ","ظَنُّ","ٱلَّذِينَ","كَفَرُواْۚ","فَوَيۡلٞ","لِّلَّذِينَ","كَفَرُواْ","مِنَ","ٱلنَّارِ"],"вама халаḳнас самаа вал'арда вама байнахума батилан залика заннул лазиина кафаруу фавайлул лиллазиина кафаруу минан нар","Мы не создали небо, землю и то, что между ними, понапрасну. Так думают только те, которые не веруют. Горе же тем, которые не веруют, от Огня!",["и не","Мы создали","небо","и землю","и то, что","между ними","напрасно","это","мнение","тех, которые","не уверовали","и горе","тем, которые","не уверовали","от","Огня"]],[38,28,["أَمۡ","نَجۡعَلُ","ٱلَّذِينَ","ءَامَنُواْ","وَعَمِلُواْ","ٱلصَّٰلِحَٰتِ","كَٱلۡمُفۡسِدِينَ","فِي","ٱلۡأَرۡضِ","أَمۡ","نَجۡعَلُ","ٱلۡمُتَّقِينَ","كَٱلۡفُجَّارِ"],"ам наж`алул лазиина амануу ва`амилус салихати калмуфсидиина фил арди ам наж`алул муттаḳиина калфужжар","Неужели Мы уравняем тех, кто уверовал и совершал праведные деяния, с теми, кто распространял нечестие на земле? Или же Мы уравняем богобоязненных с грешниками?",["или","Мы сделаем","тех, которые","уверовали","и совершали","праведные дела","как распространяющих порчу","на","земле","или","Мы сделаем","богобоязненных","как нечестивцев"]],[38,29,["كِتَٰبٌ","أَنزَلۡنَٰهُ","إِلَيۡكَ","مُبَٰرَكٞ","لِّيَدَّبَّرُوٓاْ","ءَايَٰتِهِۦ","وَلِيَتَذَكَّرَ","أُوْلُواْ","ٱلۡأَلۡبَٰبِ"],"китабун анзалнаху илайка мубаракул лийаддаббаруу айатихии валийатазаккара улул албаб","Это - благословенное Писание, которое Мы ниспослали тебе, дабы они размышляли над его аятами и дабы обладающие разумом помянули назидание.",["Писание","Мы ниспослали его","тебе","благословенное","чтобы размышляли они","над его аятами","и чтобы помянули","обладающие","разумом"]],[38,30,["وَوَهَبۡنَا","لِدَاوُۥدَ","سُلَيۡمَٰنَۚ","نِعۡمَ","ٱلۡعَبۡدُ","إِنَّهُۥٓ","أَوَّابٌ"],"вавахабна лидавууда сулаймана ни`мал `абду иннахуу авваб","Мы даровали Давуду (Давиду) Сулеймана (Соломона). Как прекрасен был этот раб! Воистину, он всегда обращался к Аллаху.",["и Мы даровали","Давуду","Сулеймана","как прекрасен","раб","поистине, он","обращающийся (к Аллаху)"]],[38,31,["إِذۡ","عُرِضَ","عَلَيۡهِ","بِٱلۡعَشِيِّ","ٱلصَّٰفِنَٰتُ","ٱلۡجِيَادُ"],"из `урида `алайхи бил`ашиййис сафинатул жийад","Однажды после полудня ему показали коней, бьющих копытами, быстроногих (или породистых).",["вот","были показаны","ему","после полудня","породистые кони","быстрые скакуны"]],[38,32,["فَقَالَ","إِنِّيٓ","أَحۡبَبۡتُ","حُبَّ","ٱلۡخَيۡرِ","عَن","ذِكۡرِ","رَبِّي","حَتَّىٰ","تَوَارَتۡ","بِٱلۡحِجَابِ"],"фаḳала иннии ахбабту хуббал хайри `ан зикри раббии хатта таварат билхижаб","Он сказал: «Я продолжал отдавать предпочтение любви к добру перед поминанием моего Господа, пока оно (солнце) не скрылось за преградой.",["и сказал он","поистине, я","предпочёл","любовь","к благу","перед","поминанием","моего Господа","пока не","скрылось","за завесой"]],[38,33,["رُدُّوهَا","عَلَيَّۖ","فَطَفِقَ","مَسۡحَۢا","بِٱلسُّوقِ","وَٱلۡأَعۡنَاقِ"],"руддууха `алаййа фатафиḳа масха биссууḳи вал'а`наḳ","Верните их ко мне!». А затем он стал рубить им голени и шеи.",["верните их","мне","и принялся он","проводить (рукой)","по голеням","и шеям"]],[38,34,["وَلَقَدۡ","فَتَنَّا","سُلَيۡمَٰنَ","وَأَلۡقَيۡنَا","عَلَىٰ","كُرۡسِيِّهِۦ","جَسَدٗا","ثُمَّ","أَنَابَ"],"валаḳад фатанна сулаймана ва'алḳайна `ала курсиййихии жасадан сумма анаб","Мы подвергли Сулеймана (Соломона) искушению и бросили на его трон тело (уродливое тело ребенка или дьявола), после чего он раскаялся (или вернулся к власти).",["и уже","Мы испытали","Сулеймана","и Мы бросили","на","его трон","тело","затем","он обратился (к Аллаху)"]],[38,35,["قَالَ","رَبِّ","ٱغۡفِرۡ","لِي","وَهَبۡ","لِي","مُلۡكٗا","لَّا","يَنۢبَغِي","لِأَحَدٖ","مِّنۢ","بَعۡدِيٓۖ","إِنَّكَ","أَنتَ","ٱلۡوَهَّابُ"],"ḳала раббигфир лии вахаб лии мулкал ла йамбагии ли'ахадим мим ба`дии иннака антал ваххаб","Он сказал: «Господи! Прости меня и даруй мне такую власть, которая не будет подобать никому после меня. Воистину, Ты - Дарующий».",["сказал он","Господи","прости","мне","и даруй","мне","власть","которая не","подобает","никому","после","меня","поистине, Ты","Ты","Дарующий"]],[38,36,["فَسَخَّرۡنَا","لَهُ","ٱلرِّيحَ","تَجۡرِي","بِأَمۡرِهِۦ","رُخَآءً","حَيۡثُ","أَصَابَ"],"фасаххарна лахур рииха тажрии би'амрихии рухаан хайсу асаб","Тогда Мы подчинили ему ветер, который нежно дул по его велению, куда бы он ни пожелал,",["и Мы подчинили","ему","ветер","дующий","по его велению","мягко","куда","он пожелал"]],[38,37,["وَٱلشَّيَٰطِينَ","كُلَّ","بَنَّآءٖ","وَغَوَّاصٖ"],"вашшайатиина кулла баннаин вагаввас","а также дьяволов - всяких строителей, ныряльщиков",["и дьяволов","всяких","строителей","и ныряльщиков"]],[38,38,["وَءَاخَرِينَ","مُقَرَّنِينَ","فِي","ٱلۡأَصۡفَادِ"],"ва'ахариина муḳарраниина фил асфад","и прочих, связанных оковами.",["и других","скованных","в","оковах"]],[38,39,["هَٰذَا","عَطَآؤُنَا","فَٱمۡنُنۡ","أَوۡ","أَمۡسِكۡ","بِغَيۡرِ","حِسَابٖ"],"хаза `атауна фамнун ау амсик бигайри хисаб","Это - Наш дар. Оказывай милость или удерживай - расчета не будет (ты не будешь нести ответственность за то, что одарял дарами одних и не оказывал милости другим, или тебе будут дарованы блага без расчета).",["это","Наш дар","так оказывай милость","или","удерживай","без","расчёта"]],[38,40,["وَإِنَّ","لَهُۥ","عِندَنَا","لَزُلۡفَىٰ","وَحُسۡنَ","مَـَٔابٖ"],"ва'инна лахуу `индана лазулфа вахусна ма'аб","Воистину, он приближен к Нам, и ему уготовано прекрасное место возвращения.",["и поистине","ему","у Нас","непременно приближенность","и прекрасное","место возвращения"]],[38,41,["وَٱذۡكُرۡ","عَبۡدَنَآ","أَيُّوبَ","إِذۡ","نَادَىٰ","رَبَّهُۥٓ","أَنِّي","مَسَّنِيَ","ٱلشَّيۡطَٰنُ","بِنُصۡبٖ","وَعَذَابٍ"],"вазкур `абдана аййууба из нада раббахуу аннии массанийаш шайтану бинусбин ва`азаб","Помяни Нашего раба Айюба (Иова). Он воззвал к своему Господу: «Дьявол причинил мне вред и мучения!».",["и помяни","Нашего раба","Айюба","когда","он воззвал","к своему Господу","что (я)","коснулся меня","шайтан","изнурением","и мучением"]],[38,42,["ٱرۡكُضۡ","بِرِجۡلِكَۖ","هَٰذَا","مُغۡتَسَلُۢ","بَارِدٞ","وَشَرَابٞ"],"иркуд бирижлика хаза мугтасалу баридун вашараб","Ему было сказано: «Топни ногой! Вот прохладная вода для купания и питье».",["топни","своей ногой","вот","вода для омовения","прохладная","и питьё"]]],"m":[[["وَمَا","и не",38,27],["خَلَقۡنَا","Мы создали",38,27],["ٱلسَّمَآءَ","небо",38,27],["وَٱلۡأَرۡضَ","и землю",38,27],["وَمَا","и то, что",38,27],["بَيۡنَهُمَا","между ними",38,27],["بَٰطِلٗاۚ","напрасно",38,27],["ذَٰلِكَ","это",38,27],["ظَنُّ","мнение",38,27],["ٱلَّذِينَ","тех, которые",38,27],["كَفَرُواْۚ","не уверовали",38,27]],[["فَوَيۡلٞ","и горе",38,27],["لِّلَّذِينَ","тем, которые",38,27],["كَفَرُواْ","не уверовали",38,27],["مِنَ","от",38,27],["ٱلنَّارِ","Огня",38,27],[27],["أَمۡ","или",38,28],["نَجۡعَلُ","Мы сделаем",38,28],["ٱلَّذِينَ","тех, которые",38,28],["ءَامَنُواْ","уверовали",38,28],["وَعَمِلُواْ","и совершали",38,28]],[["ٱلصَّٰلِحَٰتِ","праведные дела",38,28],["كَٱلۡمُفۡسِدِينَ","как распространяющих порчу",38,28],["فِي","на",38,28],["ٱلۡأَرۡضِ","земле",38,28],["أَمۡ","или",38,28],["نَجۡعَلُ","Мы сделаем",38,28],["ٱلۡمُتَّقِينَ","богобоязненных",38,28],["كَٱلۡفُجَّارِ","как нечестивцев",38,28]],[[28],["كِتَٰبٌ","Писание",38,29],["أَنزَلۡنَٰهُ","Мы ниспослали его",38,29],["إِلَيۡكَ","тебе",38,29],["مُبَٰرَكٞ","благословенное",38,29],["لِّيَدَّبَّرُوٓاْ","чтобы размышляли они",38,29],["ءَايَٰتِهِۦ","над его аятами",38,29],["وَلِيَتَذَكَّرَ","и чтобы помянули",38,29],["أُوْلُواْ","обладающие",38,29]],[["ٱلۡأَلۡبَٰبِ","разумом",38,29],[29],["وَوَهَبۡنَا","и Мы даровали",38,30],["لِدَاوُۥدَ","Давуду",38,30],["سُلَيۡمَٰنَۚ","Сулеймана",38,30],["نِعۡمَ","как прекрасен",38,30],["ٱلۡعَبۡدُ","раб",38,30],["إِنَّهُۥٓ","поистине, он",38,30],["أَوَّابٌ","обращающийся (к Аллаху)",38,30]],[[30],["إِذۡ","вот",38,31],["عُرِضَ","были показаны",38,31],["عَلَيۡهِ","ему",38,31],["بِٱلۡعَشِيِّ","после полудня",38,31],["ٱلصَّٰفِنَٰتُ","породистые кони",38,31],["ٱلۡجِيَادُ","быстрые скакуны",38,31],[31],["فَقَالَ","и сказал он",38,32],["إِنِّيٓ","поистине, я",38,32]],[["أَحۡبَبۡتُ","предпочёл",38,32],["حُبَّ","любовь",38,32],["ٱلۡخَيۡرِ","к благу",38,32],["عَن","перед",38,32],["ذِكۡرِ","поминанием",38,32],["رَبِّي","моего Господа",38,32],["حَتَّىٰ","пока не",38,32],["تَوَارَتۡ","скрылось",38,32],["بِٱلۡحِجَابِ","за завесой",38,32],[32]],[["رُدُّوهَا","верните их",38,33],["عَلَيَّۖ","мне",38,33],["فَطَفِقَ","и принялся он",38,33],["مَسۡحَۢا","проводить (рукой)",38,33],["بِٱلسُّوقِ","по голеням",38,33],["وَٱلۡأَعۡنَاقِ","и шеям",38,33],[33],["وَلَقَدۡ","и уже",38,34],["فَتَنَّا","Мы испытали",38,34]],[["سُلَيۡمَٰنَ","Сулеймана",38,34],["وَأَلۡقَيۡنَا","и Мы бросили",38,34],["عَلَىٰ","на",38,34],["كُرۡسِيِّهِۦ","его трон",38,34],["جَسَدٗا","тело",38,34],["ثُمَّ","затем",38,34],["أَنَابَ","он обратился (к Аллаху)",38,34],[34],["قَالَ","сказал он",38,35],["رَبِّ","Господи",38,35],["ٱغۡفِرۡ","прости",38,35]],[["لِي","мне",38,35],["وَهَبۡ","и даруй",38,35],["لِي","мне",38,35],["مُلۡكٗا","власть",38,35],["لَّا","которая не",38,35],["يَنۢبَغِي","подобает",38,35],["لِأَحَدٖ","никому",38,35],["مِّنۢ","после",38,35],["بَعۡدِيٓۖ","меня",38,35],["إِنَّكَ","поистине, Ты",38,35],["أَنتَ","Ты",38,35],["ٱلۡوَهَّابُ","Дарующий",38,35],[35]],[["فَسَخَّرۡنَا","и Мы подчинили",38,36],["لَهُ","ему",38,36],["ٱلرِّيحَ","ветер",38,36],["تَجۡرِي","дующий",38,36],["بِأَمۡرِهِۦ","по его велению",38,36],["رُخَآءً","мягко",38,36],["حَيۡثُ","куда",38,36],["أَصَابَ","он пожелал",38,36],[36],["وَٱلشَّيَٰطِينَ","и дьяволов",38,37]],[["كُلَّ","всяких",38,37],["بَنَّآءٖ","строителей",38,37],["وَغَوَّاصٖ","и ныряльщиков",38,37],[37],["وَءَاخَرِينَ","и других",38,38],["مُقَرَّنِينَ","скованных",38,38],["فِي","в",38,38],["ٱلۡأَصۡفَادِ","оковах",38,38],[38],["هَٰذَا","это",38,39]],[["عَطَآؤُنَا","Наш дар",38,39],["فَٱمۡنُنۡ","так оказывай милость",38,39],["أَوۡ","или",38,39],["أَمۡسِكۡ","удерживай",38,39],["بِغَيۡرِ","без",38,39],["حِسَابٖ","расчёта",38,39],[39],["وَ