{"p":456,"j":23,"a":[[38,43,["وَوَهَبۡنَا","لَهُۥٓ","أَهۡلَهُۥ","وَمِثۡلَهُم","مَّعَهُمۡ","رَحۡمَةٗ","مِّنَّا","وَذِكۡرَىٰ","لِأُوْلِي","ٱلۡأَلۡبَٰبِ"],"вавахабна лахуу ахлахуу вамислахум ма`ахум рахматам минна вазикра ли'улил албаб","Мы даровали ему его семью и еще столько же вместе с ними по Нашей милости и как напоминание для обладающих разумом.",["и Мы даровали","ему","его семью","и подобных им","вместе с ними","по милости","от Нас","и как напоминание","для обладающих","разумом"]],[38,44,["وَخُذۡ","بِيَدِكَ","ضِغۡثٗا","فَٱضۡرِب","بِّهِۦ","وَلَا","تَحۡنَثۡۗ","إِنَّا","وَجَدۡنَٰهُ","صَابِرٗاۚ","نِّعۡمَ","ٱلۡعَبۡدُ","إِنَّهُۥٓ","أَوَّابٞ"],"вахуз бийадика дигсан фадриб бихии вала тахнас инна важаднаху сабиран ни`мал `абду иннахуу авваб","Возьми в руку пучок, ударь им жену и не преступай клятвы». Воистину, Мы нашли его терпеливым. Как прекрасен был этот раб! Воистину, он всегда обращался к Аллаху.",["и возьми","в свою руку","пучок (прутьев)","и ударь","им","и не","нарушай клятвы","поистине, Мы","Мы нашли его","терпеливым","как прекрасен","раб","поистине, он","обращающийся (к Аллаху)"]],[38,45,["وَٱذۡكُرۡ","عِبَٰدَنَآ","إِبۡرَٰهِيمَ","وَإِسۡحَٰقَ","وَيَعۡقُوبَ","أُوْلِي","ٱلۡأَيۡدِي","وَٱلۡأَبۡصَٰرِ"],"вазкур `ибадана ибрахиима ва'исхаḳа вайа`ḳууба улил айдии вал'абсар","Помяни Наших рабов Ибрахима (Авраама), Исхака (Исаака) и Йакуба (Иакова), могучих и прозорливых.",["и помяни","Наших рабов","Ибрахима","и Исхака","и Йакуба","обладателей","силы","и прозорливости"]],[38,46,["إِنَّآ","أَخۡلَصۡنَٰهُم","بِخَالِصَةٖ","ذِكۡرَى","ٱلدَّارِ"],"инна ахласнахум бихалисатин зикрад дар","Мы избрали их за то, что они искренне поминали Последнюю обитель.",["поистине, Мы","Мы избрали их","особым (качеством)","поминанием","Обители"]],[38,47,["وَإِنَّهُمۡ","عِندَنَا","لَمِنَ","ٱلۡمُصۡطَفَيۡنَ","ٱلۡأَخۡيَارِ"],"ва'иннахум `индана ламинал мустафайнал ахйар","Воистину, они у Нас - в числе избранных, лучших.",["и поистине, они","у Нас","непременно из числа","избранных","лучших"]],[38,48,["وَٱذۡكُرۡ","إِسۡمَٰعِيلَ","وَٱلۡيَسَعَ","وَذَا","ٱلۡكِفۡلِۖ","وَكُلّٞ","مِّنَ","ٱلۡأَخۡيَارِ"],"вазкур исма`иила валйаса`а вазал кифли вакуллум минал ахйар","Помяни Исмаила (Измаила), Альясу (Елисея) иЗулькифла. Все они принадлежат к числу лучших.",["и помяни","Исмаила","и аль-Йасаа","и Зуль-","Кифля","и все","из числа","лучших"]],[38,49,["هَٰذَا","ذِكۡرٞۚ","وَإِنَّ","لِلۡمُتَّقِينَ","لَحُسۡنَ","مَـَٔابٖ"],"хаза зикрун ва'инна лилмуттаḳиина лахусна ма'аб","Это - Напоминание, и богобоязненным уготовано прекрасное место возвращения -",["это","напоминание","и поистине","для богобоязненных","непременно прекрасное","место возвращения"]],[38,50,["جَنَّٰتِ","عَدۡنٖ","مُّفَتَّحَةٗ","لَّهُمُ","ٱلۡأَبۡوَٰبُ"],"жаннати `адним муфаттахатал лахумул абваб","сады Эдема, врата которых будут раскрываться перед ними.",["сады","вечности","открытые","для них","врата"]],[38,51,["مُتَّكِـِٔينَ","فِيهَا","يَدۡعُونَ","فِيهَا","بِفَٰكِهَةٖ","كَثِيرَةٖ","وَشَرَابٖ"],"муттаки'иина фииха йад`ууна фииха бифакихатин касииратин вашараб","Они будут возлежать там, прислонившись, и просить принести им множество фруктов и питье.",["возлежащие","там","они просят","там","плодов","многих","и питья"]],[38,52,["وَعِندَهُمۡ","قَٰصِرَٰتُ","ٱلطَّرۡفِ","أَتۡرَابٌ"],"ва`индахум ḳасиратут тарфи атраб","Рядом с ними будут сверстницы с потупленными взорами.",["и возле них","потупившие","взоры","сверстницы"]],[38,53,["هَٰذَا","مَا","تُوعَدُونَ","لِيَوۡمِ","ٱلۡحِسَابِ"],"хаза ма туу`адууна лийаумил хисаб","Это - то, что обещано вам ко Дню расчета.",["это","то, что","вам обещано","ко дню","расчета"]],[38,54,["إِنَّ","هَٰذَا","لَرِزۡقُنَا","مَا","لَهُۥ","مِن","نَّفَادٍ"],"инна хаза ларизḳуна ма лахуу мин нафад","Это - Наш неиссякаемый удел.",["поистине","это","непременно удел Наш","нет","у него","никакого","истощения"]],[38,55,["هَٰذَاۚ","وَإِنَّ","لِلطَّٰغِينَ","لَشَرَّ","مَـَٔابٖ"],"хаза ва'инна литтагиина лашарра ма'аб","Вот так! Воистину, для преступивших границы дозволенного уготовано скверное место возвращения -",["это так","и поистине","для преступивших","непременно скверное","место возвращения"]],[38,56,["جَهَنَّمَ","يَصۡلَوۡنَهَا","فَبِئۡسَ","ٱلۡمِهَادُ"],"жаханнама йаслаунаха фаби'сал михад","Геенна, в которой они будут гореть. Как же скверно это ложе!",["Геенна","они будут гореть в ней","и скверно же","ложе"]],[38,57,["هَٰذَا","فَلۡيَذُوقُوهُ","حَمِيمٞ","وَغَسَّاقٞ"],"хаза фалйазууḳууху хамиимун вагассаḳ","Это - кипяток и гной. Пусть же они вкушают его.",["это","пусть же вкусят его","кипяток","и гной"]],[38,58,["وَءَاخَرُ","مِن","شَكۡلِهِۦٓ","أَزۡوَٰجٌ"],"ва'ахару мин шаклихии азваж","Им уготованы и другие виды подобных мучений.",["и другое","из","подобного ему","разных видов"]],[38,59,["هَٰذَا","فَوۡجٞ","مُّقۡتَحِمٞ","مَّعَكُمۡ","لَا","مَرۡحَبَۢا","بِهِمۡۚ","إِنَّهُمۡ","صَالُواْ","ٱلنَّارِ"],"хаза фаужум муḳтахимум ма`акум ла мархаба бихим иннахум салун нар","Неверующие скажут: «Вот толпа, ввергаемая вместе с вами. Нет им приветствия! Воистину, они будут гореть в Огне!».",["это","толпа","врывающаяся","вместе с вами","нет","приветствия","им","поистине, они","горят в","Огне"]],[38,60,["قَالُواْ","بَلۡ","أَنتُمۡ","لَا","مَرۡحَبَۢا","بِكُمۡۖ","أَنتُمۡ","قَدَّمۡتُمُوهُ","لَنَاۖ","فَبِئۡسَ","ٱلۡقَرَارُ"],"ḳалуу бал антум ла мархаба бикум антум ḳаддамтумууху лана фаби'сал ḳарар","Они скажут: «О нет! Это вам не будет приветствия! Это вы преподнесли его нам. Как же скверно это местопребывание!».",["сказали они","нет же","вы","нет","приветствия","вам","вы","уготовили это","нам","и скверно же","пристанище"]],[38,61,["قَالُواْ","رَبَّنَا","مَن","قَدَّمَ","لَنَا","هَٰذَا","فَزِدۡهُ","عَذَابٗا","ضِعۡفٗا","فِي","ٱلنَّارِ"],"ḳалуу раббана ман ḳаддама лана хаза фазидху `азабан ди`фан фин нар","Они скажут: «Господь наш! Приумножь многократно мучения в Огне тем, кто преподнес это нам».",["сказали они","Господь наш","кто","уготовил","нам","это","так умножь ему","мучение","вдвойне","в","Огне"]]],"m":[[["وَوَهَبۡنَا","и Мы даровали",38,43],["لَهُۥٓ","ему",38,43],["أَهۡلَهُۥ","его семь