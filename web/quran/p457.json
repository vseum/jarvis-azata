{"p":457,"j":23,"a":[[38,62,["وَقَالُواْ","مَا","لَنَا","لَا","نَرَىٰ","رِجَالٗا","كُنَّا","نَعُدُّهُم","مِّنَ","ٱلۡأَشۡرَارِ"],"ваḳалуу ма лана ла нара рижалан кунна на`уддухум минал ашрар","Они скажут: «Что с нами? Почему мы не видим мужей, которых мы считали плохими?",["и сказали они","что","с нами","не","видим мы","мужей","которых мы","считали их","из числа","дурных"]],[38,63,["أَتَّخَذۡنَٰهُمۡ","سِخۡرِيًّا","أَمۡ","زَاغَتۡ","عَنۡهُمُ","ٱلۡأَبۡصَٰرُ"],"аттахазнахум сихриййан ам загат `анхумул абсар","Неужели мы несправедливо глумились над ними? Или же просто взоры не падают на них?».",["разве мы брали их","на посмешище","или","отвернулись","от них","взоры"]],[38,64,["إِنَّ","ذَٰلِكَ","لَحَقّٞ","تَخَاصُمُ","أَهۡلِ","ٱلنَّارِ"],"инна залика лахаḳḳун тахасуму ахлин нар","Воистину, препирательство обитателей Огня является истиной.",["поистине","это","непременно истина","препирательство","обитателей","Огня"]],[38,65,["قُلۡ","إِنَّمَآ","أَنَا۠","مُنذِرٞۖ","وَمَا","مِنۡ","إِلَٰهٍ","إِلَّا","ٱللَّهُ","ٱلۡوَٰحِدُ","ٱلۡقَهَّارُ"],"ḳул иннама ана мунзирун вама мин илахин иллаллахул вахидул ḳаххар","Скажи: «Я - всего лишь предостерегающий увещеватель. Нет божества, кроме Единственного и Всемогущего Аллаха,",["скажи","лишь","я","предостерегающий","и нет","никакого","божества","кроме","Аллаха","Единственного","Всепокоряющего"]],[38,66,["رَبُّ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِ","وَمَا","بَيۡنَهُمَا","ٱلۡعَزِيزُ","ٱلۡغَفَّٰرُ"],"раббус самавати вал'арди вама байнахумал `азиизул гаффар","Господа небес, земли и того, что между ними, Могущественного, Всепрощающего».",["Господа","небес","и земли","и того, что","между ними","Могущественного","Всепрощающего"]],[38,67,["قُلۡ","هُوَ","نَبَؤٌاْ","عَظِيمٌ"],"ḳул хуа набаун `азиим","Скажи: «Это - великая весть,",["скажи","это","весть","великая"]],[38,68,["أَنتُمۡ","عَنۡهُ","مُعۡرِضُونَ"],"антум `анху му`ридуун","от которой вы отворачиваетесь.",["вы","от неё","отворачиваетесь"]],[38,69,["مَا","كَانَ","لِيَ","مِنۡ","عِلۡمِۭ","بِٱلۡمَلَإِ","ٱلۡأَعۡلَىٰٓ","إِذۡ","يَخۡتَصِمُونَ"],"ма кана лийа мин `илми билмалаил а`ла из йахтасимуун","У меня не было знания о том, как препирались в высшем сонме.",["не","было","у меня","никакого","знания","о сонме","высшем","когда","они препирались"]],[38,70,["إِن","يُوحَىٰٓ","إِلَيَّ","إِلَّآ","أَنَّمَآ","أَنَا۠","نَذِيرٞ","مُّبِينٌ"],"ин йууха илаййа илла аннама ана назиирум мубиин","Мне внушается в откровении только то, что я - всего лишь предостерегающий и разъясняющий увещеватель».",["не","внушается","мне","кроме","того, что лишь","я","увещеватель","ясный"]],[38,71,["إِذۡ","قَالَ","رَبُّكَ","لِلۡمَلَٰٓئِكَةِ","إِنِّي","خَٰلِقُۢ","بَشَرٗا","مِّن","طِينٖ"],"из ḳала раббука лилмалаикати иннии халиḳу башарам мин тиин","Вот твой Господь сказал ангелам: «Я создам человека из глины.",["вот","сказал","твой Господь","ангелам","поистине, Я","создам","человека","из","глины"]],[38,72,["فَإِذَا","سَوَّيۡتُهُۥ","وَنَفَخۡتُ","فِيهِ","مِن","رُّوحِي","فَقَعُواْ","لَهُۥ","سَٰجِدِينَ"],"фа'иза саввайтухуу ванафахту фиихи мир руухии фаḳа`уу лахуу сажидиин","Когда же Я придам ему соразмерный облик и вдохну в него от Моего духа, то падите перед ним ниц».",["и когда","Я соразмерю его","и вдохну","в него","от","Моего духа","то падите","перед ним","ниц"]],[38,73,["فَسَجَدَ","ٱلۡمَلَٰٓئِكَةُ","كُلُّهُمۡ","أَجۡمَعُونَ"],"фасажадал малаикату куллухум ажма`уун","Все ангелы без исключения пали ниц,",["и пали ниц","ангелы","все они","вместе"]],[38,74,["إِلَّآ","إِبۡلِيسَ","ٱسۡتَكۡبَرَ","وَكَانَ","مِنَ","ٱلۡكَٰفِرِينَ"],"илла иблиисастакбара вакана минал кафириин","кроме Иблиса, который возгордился и стал одним из неверующих.",["кроме","Иблиса","он возгордился","и стал","из числа","неверующих"]],[38,75,["قَالَ","يَٰٓإِبۡلِيسُ","مَا","مَنَعَكَ","أَن","تَسۡجُدَ","لِمَا","خَلَقۡتُ","بِيَدَيَّۖ","أَسۡتَكۡبَرۡتَ","أَمۡ","كُنتَ","مِنَ","ٱلۡعَالِينَ"],"ḳала йа'иблиису ма мана`ака ан тасжуда лима халаḳту бийадаййа астакбарта ам кунта минал `алиин","Он сказал: «О Иблис! Что помешало тебе пасть ниц перед тем, кого Я сотворил Своими обеими Руками? Ты возгордился или же принадлежишь к числу превозносящихся?».",["сказал Он","о Иблис","что","помешало тебе","чтобы","ты пал ниц","перед тем, кого","Я сотворил","Своими двумя Руками","ты возгордился","или","ты был","из числа","превозносящихся"]],[38,76,["قَالَ","أَنَا۠","خَيۡرٞ","مِّنۡهُ","خَلَقۡتَنِي","مِن","نَّارٖ","وَخَلَقۡتَهُۥ","مِن","طِينٖ"],"ḳала ана хайрум минху халаḳтании мин нарин вахалаḳтахуу мин тиин","Иблис сказал: «Я лучше него. Ты сотворил меня из огня, а его сотворил из глины».",["сказал он","я","лучше","него","Ты сотворил меня","из","огня","и Ты сотворил его","из","глины"]],[38,77,["قَالَ","فَٱخۡرُجۡ","مِنۡهَا","فَإِنَّكَ","رَجِيمٞ"],"ḳала фахруж минха фа'иннака ражиим","Аллах сказал: «Изыди, и отныне ты будешь изгнан и побит.",["сказал Он","так выйди","из него","ведь, поистине, ты","изгнанный"]],[38,78,["وَإِنَّ","عَلَيۡكَ","لَعۡنَتِيٓ","إِلَىٰ","يَوۡمِ","ٱلدِّينِ"],"ва'инна `алайка ла`натии ила йаумид диин","И проклятие Мое пребудет над тобой до Дня воздаяния».",["и поистине","на тебе","Моё проклятие","до","Дня","воздаяния"]],[38,79,["قَالَ","رَبِّ","فَأَنظِرۡنِيٓ","إِلَىٰ","يَوۡمِ","يُبۡعَثُونَ"],"ḳала рабби фа'анзирнии ила йауми йуб`асуун","Иблис сказал: «Господи! Предоставь мне отсрочку до того дня, когда они будут воскрешены».",["сказал он","Господи","так дай мне отсрочку","до","дня","они будут воскрешены"]],[38,80,["قَالَ","فَإِنَّكَ","مِنَ","ٱلۡمُنظَرِينَ"],"ḳала фа'иннака минал мунзариин","Аллах сказал: «Воистину, ты - один из тех, кому предоставлена отсрочка",["сказал Он","так, поистине, ты","из числа","получивших отсрочку"]],[38,81,["إِلَىٰ","يَوۡمِ","ٱلۡوَقۡتِ","ٱلۡمَعۡلُومِ"],"ила йаумил ваḳтил ма`луум","до дня, срок которого определен».",["до","дня","времени","известного"]],[38,82,["قَالَ","فَبِعِزَّتِكَ","لَأُغۡوِيَنَّهُمۡ","أَجۡمَعِينَ"],"ḳала фаби`иззатика ла'угвийаннахум ажма`иин","Иблис сказал: «Клянусь Твоим могуществом! Я совращу их всех,",["сказал он","клянусь же Твоим могуществом","я непре