{"p":458,"j":23,"a":[[38,84,["قَالَ","فَٱلۡحَقُّ","وَٱلۡحَقَّ","أَقُولُ"],"ḳала фалхаḳḳу валхаḳḳа аḳуул","Аллах сказал: «Вот истина! Я говорю только истину.",["сказал Он","вот истина","и истину","Я говорю"]],[38,85,["لَأَمۡلَأَنَّ","جَهَنَّمَ","مِنكَ","وَمِمَّن","تَبِعَكَ","مِنۡهُمۡ","أَجۡمَعِينَ"],"ла'амлаанна жаханнама минка вамимман таби`ака минхум ажма`иин","Я непременно заполню Геенну тобою и всеми, кто последует за тобою».",["непременно Я заполню","Геенну","тобой","и теми, кто","последовал за тобой","из них","всеми"]],[38,86,["قُلۡ","مَآ","أَسۡـَٔلُكُمۡ","عَلَيۡهِ","مِنۡ","أَجۡرٖ","وَمَآ","أَنَا۠","مِنَ","ٱلۡمُتَكَلِّفِينَ"],"ḳул ма ас'алукум `алайхи мин ажрин вама ана минал мутакаллифиин","Скажи: «Я не прошу у вас за это никакого вознаграждения и не обременяю себя измышлениями.",["скажи","не","прошу я у вас","за это","никакой","платы","и не","я","из числа","обременяющих себя"]],[38,87,["إِنۡ","هُوَ","إِلَّا","ذِكۡرٞ","لِّلۡعَٰلَمِينَ"],"ин хуа илла зикрул лил`аламиин","Это - не что иное, как Напоминание для миров.",["не","оно","кроме","напоминание","для миров"]],[38,88,["وَلَتَعۡلَمُنَّ","نَبَأَهُۥ","بَعۡدَ","حِينِۭ"],"валата`ламунна набаахуу ба`да хиин","А вы непременно узнаете весть о нем через определенное время».",["и непременно узнаете вы","весть о нём","через","время"]],[39,1,["تَنزِيلُ","ٱلۡكِتَٰبِ","مِنَ","ٱللَّهِ","ٱلۡعَزِيزِ","ٱلۡحَكِيمِ"],"танзиилул китаби миналлахил `азиизил хакиим","Писание ниспослано от Аллаха Могущественного, Мудрого.",["ниспослание","Писания","от","Аллаха","Могущественного","Мудрого"]],[39,2,["إِنَّآ","أَنزَلۡنَآ","إِلَيۡكَ","ٱلۡكِتَٰبَ","بِٱلۡحَقِّ","فَٱعۡبُدِ","ٱللَّهَ","مُخۡلِصٗا","لَّهُ","ٱلدِّينَ"],"инна анзална илайкал китаба билхаḳḳи фа`будиллаха мухлисал лахуд диин","Мы ниспослали тебе Писание с истиной. Поклоняйся же Аллаху, очищая перед Ним веру.",["поистине, Мы","Мы ниспослали","тебе","Писание","с истиной","так поклоняйся","Аллаху","очищая","Ему","веру"]],[39,3,["أَلَا","لِلَّهِ","ٱلدِّينُ","ٱلۡخَالِصُۚ","وَٱلَّذِينَ","ٱتَّخَذُواْ","مِن","دُونِهِۦٓ","أَوۡلِيَآءَ","مَا","نَعۡبُدُهُمۡ","إِلَّا","لِيُقَرِّبُونَآ","إِلَى","ٱللَّهِ","زُلۡفَىٰٓ","إِنَّ","ٱللَّهَ","يَحۡكُمُ","بَيۡنَهُمۡ","فِي","مَا","هُمۡ","فِيهِ","يَخۡتَلِفُونَۗ","إِنَّ","ٱللَّهَ","لَا","يَهۡدِي","مَنۡ","هُوَ","كَٰذِبٞ","كَفَّارٞ"],"ала лиллахид диинул халису валлазиинаттахазуу мин дуунихии аулийаа ма на`будухум илла лийуḳаррибууна илаллахи зулфа инналлаха йахкуму байнахум фии ма хум фиихи йахталифууна инналлаха ла йахдии ман хуа казибун каффар","Воистину, чистая вера может быть посвящена одному Аллаху. А те, которые взяли себе вместо Него других покровителей и помощников, говорят: «Мы поклоняемся им только для того, чтобы они приблизили нас к Аллаху как можно ближе». Аллах рассудит их в том, в чем они расходились во мнениях. Воистину, Аллах не ведет прямым путем тех, кто лжет и не верует.",["знайте же","Аллаху","вера","чистая","а те, которые","взяли","помимо","Него","покровителей","не","поклоняемся мы им","кроме как","чтобы они приблизили нас","к","Аллаху","близостью","поистине","Аллах","рассудит","между ними","в","том, что","они","в нём","расходятся","поистине","Аллах","не","ведёт прямым путём","того, кто","он","лжец","неверный"]],[39,4,["لَّوۡ","أَرَادَ","ٱللَّهُ","أَن","يَتَّخِذَ","وَلَدٗا","لَّٱصۡطَفَىٰ","مِمَّا","يَخۡلُقُ","مَا","يَشَآءُۚ","سُبۡحَٰنَهُۥۖ","هُوَ","ٱللَّهُ","ٱلۡوَٰحِدُ","ٱلۡقَهَّارُ"],"ллау арадаллаху ан йаттахиза валадал ластафа мимма йахлуḳу ма йашау субханахуу хуаллахул вахидул ḳаххар","Если бы Аллах захотел иметь детей, то Он избрал бы из Своих творений того, кого бы пожелал. Пречист Он! Он - Аллах, Единственный, Всемогущий.",["если бы","пожелал","Аллах","чтобы","взять (Себе)","ребёнка","непременно избрал бы Он","из того, что","Он творит","что","пожелает","Пречист Он","Он","Аллах","Единственный","Всепокоряющий"]],[39,5,["خَلَقَ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضَ","بِٱلۡحَقِّۖ","يُكَوِّرُ","ٱلَّيۡلَ","عَلَى","ٱلنَّهَارِ","وَيُكَوِّرُ","ٱلنَّهَارَ","عَلَى","ٱلَّيۡلِۖ","وَسَخَّرَ","ٱلشَّمۡسَ","وَٱلۡقَمَرَۖ","كُلّٞ","يَجۡرِي","لِأَجَلٖ","مُّسَمًّىۗ","أَلَا","هُوَ","ٱلۡعَزِيزُ","ٱلۡغَفَّٰرُ"],"халаḳас самавати вал'арда билхаḳḳи йукаввирул лайла `алан нахари вайукаввирун нахара `алал лайли васаххараш шамса валḳамара куллун йажрии ли'ажалим мусамман ала хуал `азиизул гаффар","Он сотворил небеса и землю ради истины. Он обвивает ночью день и обвивает днем ночь. Он подчинил солнце и луну. Все они движутся к назначенному сроку. Воистину, Он - Могущественный, Всепрощающий.",["Он сотворил","небеса","и землю","истиной","Он обвивает","ночь","вокруг","дня","и обвивает","день","вокруг","ночи","и подчинил Он","солнце","и луну","каждое","движется","до срока","назначенного","знайте же","Он","Могущественный","Всепрощающий"]]],"m":[[["قَالَ","сказал Он",38,84],["فَٱلۡحَقُّ","вот истина",38,84],["وَٱلۡحَقَّ","и истину",38,84],["أَقُولُ","Я говорю",38,84],[84],["لَأَمۡلَأَنَّ","непременно Я заполню",38,85],["جَهَنَّمَ","Геенну",38,85],["مِنكَ","тобой",38,85],["وَمِمَّن","и теми, кто",38,85],["تَبِعَكَ","последовал за тобой",38,85]],[["مِنۡهُمۡ","из них",38,85],["أَجۡمَعِينَ","всеми",38,85],[85],["قُلۡ","скажи",38,86],["مَآ","не",38,86],["أَسۡـَٔلُكُمۡ","прошу я у вас",38,86],["عَلَيۡهِ","за это",38,86],["مِنۡ","никакой",38,86],["أَجۡرٖ","платы",38,86],["وَمَآ","и не",38,86],["أَنَا۠","я",38,86],["مِنَ","из числа",38,86],["ٱلۡمُتَكَلِّفِينَ","обременяющих себя",38,86]],[[86],["إِنۡ","не",38,87],["هُوَ","оно",38,87],["إِلَّا","кроме",38,87],["ذِكۡرٞ","напоминание",38,87],["لِّلۡعَٰلَمِينَ","для миров",38,87],[87],["وَلَتَعۡلَمُنَّ","и непременно узнаете вы",38,88],["نَبَأَهُۥ","весть о нём",38,88],["بَعۡدَ","через",38,88],["حِينِۭ","время",38,88],[88]],["h",39],["b"],[["تَنزِيلُ","ниспослание",39,1],["ٱلۡكِتَٰبِ","Писания",39,1],["مِنَ","от",39,1],["ٱللَّهِ","Аллаха",39,1],["ٱلۡعَزِيزِ","Могущественного",39,1],["ٱلۡحَكِيمِ","Мудрого",39,1],[1],["إِنَّآ","поистине, Мы",39,2],["أَنزَلۡنَآ","Мы ниспослали",39,2],["إِلَيۡكَ","тебе",39,2]],[["ٱلۡكِتَٰبَ","Писание",39,2],["بِٱل