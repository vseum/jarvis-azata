у",39,5]],[["كُلّٞ","каждое",39,5],["يَجۡرِي","движется",39,5],["لِأَجَلٖ","до срока",39,5],["مُّسَمًّىۗ","назначенного",39,5],["أَلَا","знайте же",39,5],["هُوَ","Он",39,5],["ٱلۡعَزِيزُ","Могущественный",39,5],["ٱلۡغَفَّٰرُ","Всепрощающий",39,5],[5]]]}