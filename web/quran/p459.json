{"p":459,"j":23,"a":[[39,6,["خَلَقَكُم","مِّن","نَّفۡسٖ","وَٰحِدَةٖ","ثُمَّ","جَعَلَ","مِنۡهَا","زَوۡجَهَا","وَأَنزَلَ","لَكُم","مِّنَ","ٱلۡأَنۡعَٰمِ","ثَمَٰنِيَةَ","أَزۡوَٰجٖۚ","يَخۡلُقُكُمۡ","فِي","بُطُونِ","أُمَّهَٰتِكُمۡ","خَلۡقٗا","مِّنۢ","بَعۡدِ","خَلۡقٖ","فِي","ظُلُمَٰتٖ","ثَلَٰثٖۚ","ذَٰلِكُمُ","ٱللَّهُ","رَبُّكُمۡ","لَهُ","ٱلۡمُلۡكُۖ","لَآ","إِلَٰهَ","إِلَّا","هُوَۖ","فَأَنَّىٰ","تُصۡرَفُونَ"],"халаḳакум мин нафсин вахидатин сумма жа`ала минха заужаха ва'анзала лакум минал ан`ами саманийата азважин йахлуḳукум фии бутууни уммахатикум халḳам мим ба`ди халḳин фии зулуматин саласин заликумуллаху раббукум лахул мулку ла илаха илла хуа фа'анна тусрафуун","Он создал вас из одного человека. Он сотворил из него жену и ниспослал для вас из скотины восемь животных парами. Он создает вас в утробах ваших матерей: одно творение появляется вслед за другим в трех мраках. Таков Аллах, ваш Господь. Ему принадлежит власть. Нет божества, кроме Него. До чего же вы отвращены от истины!",["Он сотворил вас","из","души","единой","затем","сделал Он","из неё","её пару","и ниспослал Он","вам","из","скота","восемь","пар","Он творит вас","в","утробах","ваших матерей","творением","вслед","за","творением","в","мраках","трёх","таков","Аллах","ваш Господь","Ему","власть","нет","божества","кроме","Него","так куда же","вы отвращаетесь"]],[39,7,["إِن","تَكۡفُرُواْ","فَإِنَّ","ٱللَّهَ","غَنِيٌّ","عَنكُمۡۖ","وَلَا","يَرۡضَىٰ","لِعِبَادِهِ","ٱلۡكُفۡرَۖ","وَإِن","تَشۡكُرُواْ","يَرۡضَهُ","لَكُمۡۗ","وَلَا","تَزِرُ","وَازِرَةٞ","وِزۡرَ","أُخۡرَىٰۚ","ثُمَّ","إِلَىٰ","رَبِّكُم","مَّرۡجِعُكُمۡ","فَيُنَبِّئُكُم","بِمَا","كُنتُمۡ","تَعۡمَلُونَۚ","إِنَّهُۥ","عَلِيمُۢ","بِذَاتِ","ٱلصُّدُورِ"],"ин такфуруу фа'инналлаха ганиййун `анкум вала йарда ли`ибадихил куфра ва'ин ташкуруу йардаху лакум вала тазиру вазиратун визра ухра сумма ила раббикум маржи`укум файунаббиукум бима кунтум та`малууна иннахуу `алииму бизатис судуур","Если вы не уверуете, то ведь Аллах не нуждается в вас. Он не одобряет неверия для Своих рабов. А если вы будете благодарны, то Он одобрит для вас это. Ни одна душа не понесет чужого бремени. Затем вам предстоит вернуться к вашему Господу, и Он поведает вам о том, что вы совершали. Воистину, Он ведает о том, что в груди.",["если","вы не уверуете","то поистине","Аллах","не нуждается","в вас","и не","одобряет Он","для Своих рабов","неверия","а если","вы будете благодарны","Он одобрит это","для вас","и не","понесёт","несущая бремя","бремени","другой","затем","к","вашему Господу","ваше возвращение","и Он сообщит вам","о том, что","вы","делали","поистине, Он","Знающий","о том, что в","груди"]],[39,8,["وَإِذَا","مَسَّ","ٱلۡإِنسَٰنَ","ضُرّٞ","دَعَا","رَبَّهُۥ","مُنِيبًا","إِلَيۡهِ","ثُمَّ","إِذَا","خَوَّلَهُۥ","نِعۡمَةٗ","مِّنۡهُ","نَسِيَ","مَا","كَانَ","يَدۡعُوٓاْ","إِلَيۡهِ","مِن","قَبۡلُ","وَجَعَلَ","لِلَّهِ","أَندَادٗا","لِّيُضِلَّ","عَن","سَبِيلِهِۦۚ","قُلۡ","تَمَتَّعۡ","بِكُفۡرِكَ","قَلِيلًا","إِنَّكَ","مِنۡ","أَصۡحَٰبِ","ٱلنَّارِ"],"ва'иза массал инсана дуррун да`а раббахуу муниибан илайхи сумма иза хаввалахуу ни`матам минху насийа ма кана йад`уу илайхи мин ḳаблу важа`ала лиллахи андадал лийудилла `ан сабиилихии ḳул таматта` бикуфрика ḳалиилан иннака мин асхабин нар","Когда человека коснется вред, он взывает к своему Господу, обращаясь к Нему одному. Когда же Он предоставляет ему благо от Себя, человек забывает Того, к Кому он взывал прежде (или забывает то, ради чего он взывал прежде), и равняет с Аллахом других, чтобы сбить других с Его пути. Скажи: «Попользуйся благами со своим неверием немного! Воистину, ты будешь одним из обитателей Огня».",["и когда","коснётся","человека","вред","он взывает","к своему Господу","обращаясь","к Нему","затем","когда","Он дарует ему","благо","от Себя","он забывает","то, о чём","он","взывал","к Нему","до","того","и придаёт он","Аллаху","равных","чтобы сбить","с","Его пути","скажи","наслаждайся","своим неверием","немного","поистине, ты","из числа","обитателей","Огня"]],[39,9,["أَمَّنۡ","هُوَ","قَٰنِتٌ","ءَانَآءَ","ٱلَّيۡلِ","سَاجِدٗا","وَقَآئِمٗا","يَحۡذَرُ","ٱلۡأٓخِرَةَ","وَيَرۡجُواْ","رَحۡمَةَ","رَبِّهِۦۗ","قُلۡ","هَلۡ","يَسۡتَوِي","ٱلَّذِينَ","يَعۡلَمُونَ","وَٱلَّذِينَ","لَا","يَعۡلَمُونَۗ","إِنَّمَا","يَتَذَكَّرُ","أُوْلُواْ","ٱلۡأَلۡبَٰبِ"],"амман хуа ḳанитун анаал лайли сажидан ваḳаиман йахзарул ахирата вайаржуу рахмата раббихии ḳул хал йаставил лазиина йа`ламууна валлазиина ла йа`ламууна иннама йатазаккару улул албаб","Неужели тот, кто смиренно проводит ночные часы, падая ниц и стоя, страшась Последней жизни и надеясь на милость своего Господа, равен неверующему? Скажи: «Неужели равны те, которые знают, и те, которые не знают?». Воистину, поминают назидание только обладающие разумом.",["Разве тот, кто","он","покорно молится","в часы","ночи","падая ниц","и стоя","опасаясь","Последней жизни","и надеясь на","милость","своего Господа","Скажи","разве","равны","те, которые","знают","и те, которые","не","знают","лишь","внемлют назиданию","обладающие","разумом"]],[39,10,["قُلۡ","يَٰعِبَادِ","ٱلَّذِينَ","ءَامَنُواْ","ٱتَّقُواْ","رَبَّكُمۡۚ","لِلَّذِينَ","أَحۡسَنُواْ","فِي","هَٰذِهِ","ٱلدُّنۡيَا","حَسَنَةٞۗ","وَأَرۡضُ","ٱللَّهِ","وَٰسِعَةٌۗ","إِنَّمَا","يُوَفَّى","ٱلصَّٰبِرُونَ","أَجۡرَهُم","بِغَيۡرِ","حِسَابٖ"],"ḳул йа`ибадил лазиина амануттаḳуу раббакум лиллазиина ахсануу фии хазихид дунйа хасанатун ва'ардуллахи васи`атун иннама йуаффас сабирууна ажрахум бигайри хисаб","Скажи Моим рабам, которые уверовали: «Бойтесь вашего Господа! Тем, которые совершили добро в этом мире, уготовано добро. Земля Аллаха обширна. Воистину, терпеливым их награда воздастся полностью без счета».",["Скажи","о рабы Мои","которые","уверовали","бойтесь","вашего Господа","для тех, которые","творили добро","в","этом","мире","добро","и земля","Аллаха","обширна","лишь","будет воздана сполна","терпеливым","их награда","без","счёта"]]],"m":[[["خَلَقَكُم","Он сотворил вас",39,6],["مِّن","из",39,6],["نَّفۡسٖ","души",39,6],["وَٰحِدَةٖ","единой",39,6],["ثُمَّ","затем",39,6],["جَعَلَ","сделал Он",39,6],["مِنۡهَا","из неё",39,6],["زَوۡجَهَا","её пару",39,6],["وَأَنزَلَ","и ниспослал Он",39,6],["لَكُم","вам",39,6]],[["مِّنَ","из",39,6],["ٱلۡأَنۡعَٰمِ","скота",39,6],["ثَمَٰنِيَةَ","восемь",39,6],["أَزۡوَٰجٖۚ","пар",39,6],["يَخۡلُقُكُمۡ","Он творит вас",39,6],["فِي","в",39,6],["بُطُونِ","утробах",39,6],["أُمَّهَٰتِكُمۡ","ваших матерей",39,6]],[["خَلۡقٗا","творением",39,6],["مِّنۢ","вслед",39,6],["بَعۡدِ","за",39,6],["خَلۡقٖ","творением",39,6],["فِي","в",39,6],["ظُلُمَٰتٖ","мраках",39,6],["ثَلَٰثٖۚ","трёх",39,6],["ذَٰلِكُمُ","таков",39,6],["ٱللَّهُ","Аллах",39,6],["رَبُّكُمۡ","ваш Господь",39,6],["لَهُ","Ему",39,6]],[["ٱلۡمُلۡكُۖ","власть",39,6],["لَآ","нет",39,6],["إِلَٰهَ","божества",39,6],["إِلَّا","кроме",39,6],["هُوَۖ","Него",39,6],["فَأَنَّىٰ","так куда же",39,6],["تُصۡرَفُونَ","вы отвращаетесь",39,6],[6],["إِن","если",39,7],["تَكۡفُرُواْ","вы не уверуете",39,7],["فَإِنَّ","то поистине",39,7]],[["ٱللَّهَ","Аллах",39,7],["غَنِيٌّ","не нуждается",39,7],["عَنكُمۡۖ","в вас",39,7],["وَلَا","и не",39,7],["يَرۡضَىٰ","одобряет Он",39,7],["لِعِبَادِهِ","для Своих рабов",39,7],["ٱلۡكُفۡرَۖ","неверия",39,7],["وَإِن","а если",39,7],["تَشۡكُرُواْ","вы будете благодарны",39,7],["يَرۡضَهُ","Он одобрит это",39,7]],[["لَكُمۡۗ","для вас",39,7],["وَلَا","и не",39,7],["تَزِرُ","понесёт",39,7],["وَازِرَةٞ","несущая бремя",39,7],["وِزۡرَ","бремени",39,7],["أُخۡرَىٰۚ","другой",39,7],["ثُمَّ","затем",39,7],["إِلَىٰ","к",39,7],["رَبِّكُم","вашему Господу",39,7],["مَّرۡجِعُكُمۡ","ваше возвращение",39,7]],[["فَيُنَبِّئُكُم","и Он сообщит вам",39,7],["بِمَا","о том, что",39,7],["كُنتُمۡ","вы",39,7],["تَعۡمَلُونَۚ","делали",39,7],["إِنَّهُۥ","поистине, Он",39,7],["عَلِيمُۢ","Знающий",39,7],["بِذَاتِ","о том, что в",39,7],["ٱلصُّدُورِ","груди",39,7],[7]],[["۞ وَإِذَا","и когда",39,8],["مَسَّ","коснётся",39,8],["ٱلۡإِنسَٰنَ","человека",39,8],["ضُرّٞ","вред",39,8],["دَعَا","он взывает",39,8],["رَبَّهُۥ","к своему Господу",39,8],["مُنِيبًا","обращаясь",39,8],["إِلَيۡهِ","к Нему",39,8],["ثُمَّ","затем",39,8],