{"p":460,"j":23,"a":[[39,11,["قُلۡ","إِنِّيٓ","أُمِرۡتُ","أَنۡ","أَعۡبُدَ","ٱللَّهَ","مُخۡلِصٗا","لَّهُ","ٱلدِّينَ"],"ḳул иннии умирту ан а`будаллаха мухлисал лахуд диин","Скажи: «Мне велено поклоняться Аллаху, очищая перед Ним веру.",["Скажи","поистине, мне","велено","чтобы","я поклонялся","Аллаху","очищая","для Него","веру"]],[39,12,["وَأُمِرۡتُ","لِأَنۡ","أَكُونَ","أَوَّلَ","ٱلۡمُسۡلِمِينَ"],"ва'умирту ли'ан акууна аввалал муслимиин","Мне также велено быть первым из мусульман».",["и мне велено","чтобы","я был","первым","из мусульман"]],[39,13,["قُلۡ","إِنِّيٓ","أَخَافُ","إِنۡ","عَصَيۡتُ","رَبِّي","عَذَابَ","يَوۡمٍ","عَظِيمٖ"],"ḳул иннии ахафу ин `асайту раббии `азаба йаумин `азиим","Скажи: «Я боюсь, что если я ослушаюсь своего Господа, то меня постигнут мучения в Великий день».",["Скажи","поистине, я","боюсь","если","ослушаюсь","своего Господа","мучений","дня","великого"]],[39,14,["قُلِ","ٱللَّهَ","أَعۡبُدُ","مُخۡلِصٗا","لَّهُۥ","دِينِي"],"ḳулиллаха а`буду мухлисал лахуу диинии","Скажи: «Я поклоняюсь одному Аллаху, очищая перед Ним веру.",["Скажи","Аллаху","поклоняюсь","очищая","для Него","мою веру"]],[39,15,["فَٱعۡبُدُواْ","مَا","شِئۡتُم","مِّن","دُونِهِۦۗ","قُلۡ","إِنَّ","ٱلۡخَٰسِرِينَ","ٱلَّذِينَ","خَسِرُوٓاْ","أَنفُسَهُمۡ","وَأَهۡلِيهِمۡ","يَوۡمَ","ٱلۡقِيَٰمَةِۗ","أَلَا","ذَٰلِكَ","هُوَ","ٱلۡخُسۡرَانُ","ٱلۡمُبِينُ"],"фа`будуу ма ши'тум мин дуунихии ḳул иннал хасириинал лазиина хасируу анфусахум ва'ахлиихим йаумал ḳийамати ала залика хуал хусранул мубиин","Поклоняйтесь же, помимо Него, чему пожелаете». Скажи: «Воистину, потерпят убыток те, которые потеряют себя и свои семьи в День воскресения. Воистину, это и есть явный убыток!",["поклоняйтесь же","чему","пожелаете","кроме","помимо Него","Скажи","поистине","потерпевшие убыток","те, которые","потеряли","самих себя","и свои семьи","в день","воскресения","воистину","это","оно","убыток","явный"]],[39,16,["لَهُم","مِّن","فَوۡقِهِمۡ","ظُلَلٞ","مِّنَ","ٱلنَّارِ","وَمِن","تَحۡتِهِمۡ","ظُلَلٞۚ","ذَٰلِكَ","يُخَوِّفُ","ٱللَّهُ","بِهِۦ","عِبَادَهُۥۚ","يَٰعِبَادِ","فَٱتَّقُونِ"],"лахум мин фауḳихим зулалум минан нари вамин тахтихим зулалун залика йухаввифуллаху бихии `ибадахуу йа`ибади фаттаḳуун","Над ними будут навесы из огня, и под ними будут навесы». Этим Аллах устрашает Своих рабов. О рабы Мои, бойтесь Меня!",["для них","из","над ними","навесы","из","огня","и из","под ними","навесы","этим","устрашает","Аллах","им","Своих рабов","о рабы Мои","бойтесь же Меня"]],[39,17,["وَٱلَّذِينَ","ٱجۡتَنَبُواْ","ٱلطَّٰغُوتَ","أَن","يَعۡبُدُوهَا","وَأَنَابُوٓاْ","إِلَى","ٱللَّهِ","لَهُمُ","ٱلۡبُشۡرَىٰۚ","فَبَشِّرۡ","عِبَادِ"],"валлазиинажтанабут тагуута ан йа`будууха ва'анабуу илаллахи лахумул бушра фабашшир `ибад","Для тех, которые избежали поклонения тагуту и обратились к Аллаху, есть благая весть. Обрадуй же Моих рабов,",["и те, которые","сторонились","тагута","чтобы (не)","поклоняться ему","и обратились","к","Аллаху","для них","благая весть","обрадуй же","Моих рабов"]],[39,18,["ٱلَّذِينَ","يَسۡتَمِعُونَ","ٱلۡقَوۡلَ","فَيَتَّبِعُونَ","أَحۡسَنَهُۥٓۚ","أُوْلَٰٓئِكَ","ٱلَّذِينَ","هَدَىٰهُمُ","ٱللَّهُۖ","وَأُوْلَٰٓئِكَ","هُمۡ","أُوْلُواْ","ٱلۡأَلۡبَٰبِ"],"аллазиина йастами`уунал ḳаула файаттаби`ууна ахсанахуу улаикал лазиина хадахумуллаху ва'улаика хум улул албаб","которые прислушиваются к словам и следуют наилучшим из них. Это - те, которых Аллах наставил на прямой путь. Они и есть обладающие разумом.",["которые","слушают","слово","и следуют","наилучшему в нём","те","которых","наставил (их)","Аллах","и те","они","обладающие","разумом"]],[39,19,["أَفَمَنۡ","حَقَّ","عَلَيۡهِ","كَلِمَةُ","ٱلۡعَذَابِ","أَفَأَنتَ","تُنقِذُ","مَن","فِي","ٱلنَّارِ"],"афаман хаḳḳа `алайхи калиматул `азаби афаанта тунḳизу ман фин нар","Разве ты сможешь спасти того, относительно кого сбылось Слово о мучениях, кто находится в Огне?",["Разве же тот, кто","сбылось","о нём","слово","мучения","разве же ты","спасёшь","того, кто","в","огне"]],[39,20,["لَٰكِنِ","ٱلَّذِينَ","ٱتَّقَوۡاْ","رَبَّهُمۡ","لَهُمۡ","غُرَفٞ","مِّن","فَوۡقِ