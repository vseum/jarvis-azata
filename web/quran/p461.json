,25],["يَشۡعُرُونَ","ощущали они",39,25],[25],["فَأَذَاقَهُمُ","и дал вкусить им",39,26],["ٱللَّهُ","Аллах",39,26],["ٱلۡخِزۡيَ","позор",39,26],["فِي","в",39,26],["ٱلۡحَيَوٰةِ","жизни",39,26],["ٱلدُّنۡيَاۖ","мирской",39,26],["وَلَعَذَابُ","а мучение же",39,26]],[["ٱلۡأٓخِرَةِ","Последней жизни",39,26],["أَكۡبَرُۚ","больше",39,26],["لَوۡ","если бы",39,26],["كَانُواْ","они",39,26],["يَعۡلَمُونَ","знали",39,26],[26],["وَلَقَدۡ","и уже",39,27],["ضَرَبۡنَا","привели Мы",39,27],["لِلنَّاسِ","для людей",39,27],["فِي","в",39,27]],[["هَٰذَا","этом",39,27],["ٱلۡقُرۡءَانِ","Коране",39,27],["مِن","из",39,27],["كُلِّ","всякой",39,27],["مَثَلٖ","притчи",39,27],["لَّعَلَّهُمۡ","чтобы они",39,27],["يَتَذَكَّرُونَ","внимали назиданию",39,27],[27],["قُرۡءَانًا","Кораном",39,28],["عَرَبِيًّا","арабским",39,28]],[["غَيۡرَ","не",39,28],["ذِي","имеющим",39,28],["عِوَجٖ","кривизны",39,28],["لَّعَلَّهُمۡ","чтобы они",39,28],["يَتَّقُونَ","были богобоязненны",39,28],[28],["ضَرَبَ","привёл",39,29],["ٱللَّهُ","Аллах",39,29],["مَثَلٗا","притчу",39,29],["رَّجُلٗا","человека",39,29],["فِيهِ","в нём",39,29]],[["شُرَكَآءُ","совладельцы",39,29],["مُتَشَٰكِسُونَ","несговорчивые",39,29],["وَرَجُلٗا","и человека",39,29],["سَلَمٗا","всецело принадлежащего",39,29],["لِّرَجُلٍ","одному человеку",39,29],["هَلۡ","разве",39,29],["يَسۡتَوِيَانِ","равны они двое",39,29],["مَثَلًاۚ","по примеру",39,29]],[["ٱلۡحَمۡدُ","хвала",39,29],["لِلَّهِۚ","Аллаху",39,29],["بَلۡ","но",39,29],["أَكۡثَرُهُمۡ","большинство их",39,29],["لَا","не",39,29],["يَعۡلَمُونَ","знают",39,29],[29],["إِنَّكَ","поистине, ты",39,30],["مَيِّتٞ","смертен",39,30],["وَإِنَّهُم","и поистине, они",39,30],["مَّيِّتُونَ","смертны",39,30]],[[30],["ثُمَّ","затем",39,31],["إِنَّكُمۡ","поистине, вы",39,31],["يَوۡمَ","в день",39,31],["ٱلۡقِيَٰمَةِ","воскресения",39,31],["عِندَ","у",39,31],["رَبِّكُمۡ","вашего Господа",39,31],["تَخۡتَصِمُونَ","будете препираться",39,31],[31]]]}