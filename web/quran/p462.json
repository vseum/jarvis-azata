{"p":462,"j":24,"a":[[39,32,["فَمَنۡ","أَظۡلَمُ","مِمَّن","كَذَبَ","عَلَى","ٱللَّهِ","وَكَذَّبَ","بِٱلصِّدۡقِ","إِذۡ","جَآءَهُۥٓۚ","أَلَيۡسَ","فِي","جَهَنَّمَ","مَثۡوٗى","لِّلۡكَٰفِرِينَ"],"фаман азламу мимман казаба `алаллахи ваказзаба биссидḳи из жаахуу алайса фии жаханнама масвал лилкафириин","Кто может быть несправедливее того, кто возвел навет на Аллаха и счел ложью правду, когда она явилась ему? Разве не в Геенне обитель неверующих?",["кто же","несправедливее","того, кто","солгал","на","Аллаха","и счёл ложью","правду","когда","пришла она к нему","разве нет","в","Геенне","обители","для неверующих"]],[39,33,["وَٱلَّذِي","جَآءَ","بِٱلصِّدۡقِ","وَصَدَّقَ","بِهِۦٓ","أُوْلَٰٓئِكَ","هُمُ","ٱلۡمُتَّقُونَ"],"валлазии жаа биссидḳи васаддаḳа бихии улаика хумул муттаḳуун","Но тот, кто явился с правдой, и тот, кто признал ее истинность, действительно являются богобоязненными.",["а тот, кто","пришёл","с правдой","и признал истинной","её","те","они","богобоязненные"]],[39,34,["لَهُم","مَّا","يَشَآءُونَ","عِندَ","رَبِّهِمۡۚ","ذَٰلِكَ","جَزَآءُ","ٱلۡمُحۡسِنِينَ"],"лахум ма йашаууна `инда раббихим залика жазаул мухсиниин","Для них у их Господа уготовано то, чего они пожелают. Таково воздаяние творящим добро!",["для них","то, что","пожелают они","у","их Господа","это","воздаяние","творящих добро"]],[39,35,["لِيُكَفِّرَ","ٱللَّهُ","عَنۡهُمۡ","أَسۡوَأَ","ٱلَّذِي","عَمِلُواْ","وَيَجۡزِيَهُمۡ","أَجۡرَهُم","بِأَحۡسَنِ","ٱلَّذِي","كَانُواْ","يَعۡمَلُونَ"],"лийукаффираллаху `анхум асваал лазии `амилуу вайажзийахум ажрахум би'ахсанил лазии кануу йа`малуун","Это произойдет для того, чтобы Аллах простил им наихудшее из того, что они совершили, и воздал им наградой за лучшее из того, что они совершали (или лучшим, чем то, что они совершали).",["чтобы загладил","Аллах","с них","наихудшее","из того, что","совершили они","и воздал им","их награду","по лучшему","из того, что","они","совершали"]],[39,36,["أَلَيۡسَ","ٱللَّهُ","بِكَافٍ","عَبۡدَهُۥۖ","وَيُخَوِّفُونَكَ","بِٱلَّذِينَ","مِن","دُونِهِۦۚ","وَمَن","يُضۡلِلِ","ٱللَّهُ","فَمَا","لَهُۥ","مِنۡ","هَادٖ"],"алайсаллаху бикафин `абдахуу вайухаввифуунака биллазиина мин дуунихии ваман йудлилиллаху фама лахуу мин хад","Разве Аллаха не достаточно для Его раба? Они устрашают тебя теми, которые ниже Него. А кого Аллах введет в заблуждение, тому не будет наставника.",["разве не","Аллах","достаточен","для Своего раба","и пугают тебя","теми, которые","кроме","помимо Него","а кого","введёт в заблуждение","Аллах","то нет","для него","никакого","наставника"]],[39,37,["وَمَن","يَهۡدِ","ٱللَّهُ","فَمَا","لَهُۥ","مِن","مُّضِلٍّۗ","أَلَيۡسَ","ٱللَّهُ","بِعَزِيزٖ","ذِي","ٱنتِقَامٖ"],"ваман йахдиллаху фама лахуу мим мудиллин алайсаллаху би`азиизин зинтиḳам","А кого Аллах наставит на прямой путь, того никто не введет в заблуждение. Разве Аллах - не Могущественный, Способный на возмездие?",["а кого","наставит","Аллах","то нет","для него","никакого","вводящего в заблуждение","разве не","Аллах","Могущественный","Обладатель","возмездия"]],[39,38,["وَلَئِن","سَأَلۡتَهُم","مَّنۡ","خَلَقَ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضَ","لَيَقُولُنَّ","ٱللَّهُۚ","قُلۡ","أَفَرَءَيۡتُم","مَّا","تَدۡعُونَ","مِن","دُونِ","ٱللَّهِ","إِنۡ","أَرَادَنِيَ","ٱللَّهُ","بِضُرٍّ","هَلۡ","هُنَّ","كَٰشِفَٰتُ","ضُرِّهِۦٓ","أَوۡ","أَرَادَنِي","بِرَحۡمَةٍ","هَلۡ","هُنَّ","مُمۡسِكَٰتُ","رَحۡمَتِهِۦۚ","قُلۡ","حَسۡبِيَ","ٱللَّهُۖ","عَلَيۡهِ","يَتَوَكَّلُ","ٱلۡمُتَوَكِّلُونَ"],"валаин са'алтахум ман халаḳас самавати вал'арда лайаḳуулунналлаху ḳул афараайтум ма тад`ууна мин дууниллахи ин араданийаллаху бидуррин хал хунна кашифату дуррихии ау арадании бирахматин хал хунна мумсикату рахматихии ḳул хасбийаллаху `алайхи йатаваккалул мутаваккилуун","Если ты спросишь их: «Кто создал небеса и землю?». - они непременно скажут: «Аллах». Скажи: «Видели ли вы тех, к кому вы взываете вместо Аллаха? Если Аллах захочет навредить мне, разве они смогут отвратить Его вред? Или же, если Он захочет оказать мне милость, разве они смогут удержать Его милость?». Скажи: «Довольно мне Аллаха. На Него одного уповают уповающие».",["и если","спросишь ты их","кто","сотворил","небеса","и землю","непременно скажут они","Аллах","Скажи","видели ли вы","то, что","призываете вы","кроме","помимо","Аллаха","если","пожелает мне","Аллах","вреда","разве","они","устраняющие","Его вред","или","пожелает Он мне","милости","разве","они","удерживающие","Его милость","Скажи","достаточно мне","Аллаха","на Него","уповают","уповающие"]],[39,39,["قُلۡ","يَٰقَوۡمِ","ٱعۡمَلُواْ","عَلَىٰ","مَكَانَتِكُمۡ","إِنِّي","عَٰمِلٞۖ","فَسَوۡفَ","تَعۡلَمُونَ"],"ḳул йаḳауми`малуу `ала маканатикум иннии `амилун фасауфа та`ламуун","Скажи: «О мой народ! Действуйте по своему усмотрению, и я тоже буду действовать. Скоро вы узнаете,",["Скажи","о мой народ","действуйте","по","вашему положению","поистине, я","действую","и вскоре","узнаете вы"]],[39,40,["مَن","يَأۡتِيهِ","عَذَابٞ","يُخۡزِيهِ","وَيَحِلُّ","عَلَيۡهِ","عَذَابٞ","مُّقِيمٌ"],"ман йа'тиихи `азабун йухзиихи вайахиллу `алайхи `азабум муḳиим","кого постигнет мучение, которое опозорит его, и на кого падут вечные мучения».",["кого","постигнет (его)","мучение","позорящее его","и падёт","на него","мучение","вечное"]]],"m":[[["۞ فَمَنۡ","кто же",39,32],["أَظۡلَمُ","несправедливее",39,32],["مِمَّن","того, кто",39,32],["كَذَبَ","солгал",39,32],["عَلَى","на",39,32],["ٱللَّهِ","Аллаха",39,32],["وَكَذَّبَ","и счёл ложью",39,32],["بِٱلصِّدۡقِ","правду",39,32]],[["إِذۡ","когда",39,32],["جَآءَهُۥٓۚ","пришла она к нему",39,32],["أَلَيۡسَ","разве нет",39,32],["فِي","в",39,32],["جَهَنَّمَ","Геенне",39,32],["مَثۡوٗى","обители",39,32],["لِّلۡكَٰفِرِينَ","для неверующих",39,32],[32],["وَٱلَّذِي","а тот, кто",39,33]],[["جَآءَ","пришёл",39,33],["بِٱلصِّدۡقِ","с правдой",39,33],["وَصَدَّقَ","и признал истинной",39,33],["بِهِۦٓ","её",39,33],["أُوْلَٰٓئِكَ","те",39,33],["هُمُ","они",39,33],["ٱلۡمُتَّقُونَ","богобоязненные",39,33],[33]],[["لَهُم","для них",39,34],["مَّا","то, что",39,34],["يَشَآءُونَ","пожелают они",39,34],["عِندَ","у",39,34],["رَبِّهِمۡۚ","их Гос