{"p":463,"j":24,"a":[[39,41,["إِنَّآ","أَنزَلۡنَا","عَلَيۡكَ","ٱلۡكِتَٰبَ","لِلنَّاسِ","بِٱلۡحَقِّۖ","فَمَنِ","ٱهۡتَدَىٰ","فَلِنَفۡسِهِۦۖ","وَمَن","ضَلَّ","فَإِنَّمَا","يَضِلُّ","عَلَيۡهَاۖ","وَمَآ","أَنتَ","عَلَيۡهِم","بِوَكِيلٍ"],"инна анзална `алайкал китаба линнаси билхаḳḳи фаманихтада фалинафсихии ваман далла фа'иннама йадиллу `алайха вама анта `алайхим бивакиил","Мы ниспослали тебе Писание для людей с истиной. Тот, кто последовал прямым путем, поступил во благо себе. А тот, кто впал в заблуждение, поступает во вред только себе, и ты не являешься их попечителем и хранителем.",["поистине, Мы","ниспослали Мы","тебе","Писание","для людей","с истиной","и кто","пошёл прямым путём","то для своей души","а кто","заблудился","то лишь","заблуждается","во вред ей","и не","ты","над ними","попечитель"]],[39,42,["ٱللَّهُ","يَتَوَفَّى","ٱلۡأَنفُسَ","حِينَ","مَوۡتِهَا","وَٱلَّتِي","لَمۡ","تَمُتۡ","فِي","مَنَامِهَاۖ","فَيُمۡسِكُ","ٱلَّتِي","قَضَىٰ","عَلَيۡهَا","ٱلۡمَوۡتَ","وَيُرۡسِلُ","ٱلۡأُخۡرَىٰٓ","إِلَىٰٓ","أَجَلٖ","مُّسَمًّىۚ","إِنَّ","فِي","ذَٰلِكَ","لَأٓيَٰتٖ","لِّقَوۡمٖ","يَتَفَكَّرُونَ"],"аллаху йатаваффал анфуса хиина маутиха валлатии лам тамут фии манамиха файумсикул латии ḳада `алайхал маута вайурсилул ухра ила ажалим мусамман инна фии залика ла'айатил лиḳаумин йатафаккаруун","Аллах забирает души в момент смерти, а ту, которая пока не умирает, - во время сна. Он удерживает ту, которой предопределил смерть, а другую отпускает до определенного срока. Воистину, в этом - знамения для людей размышляющих.",["Аллах","забирает","души","в момент","их смерти","и ту, которая","не","умерла","во","её сне","и удерживает Он","ту, которой","предопределил Он","для неё","смерть","и отпускает Он","другую","до","срока","назначенного","поистине","в","этом","непременно знамения","для людей","размышляющих"]],[39,43,["أَمِ","ٱتَّخَذُواْ","مِن","دُونِ","ٱللَّهِ","شُفَعَآءَۚ","قُلۡ","أَوَلَوۡ","كَانُواْ","لَا","يَمۡلِكُونَ","شَيۡـٔٗا","وَلَا","يَعۡقِلُونَ"],"амиттахазуу мин дууниллахи шуфа`аа ḳул авалау кануу ла йамликууна шай'ан вала йа`ḳилуун","Или же они взяли себе заступников помимо Аллаха? Скажи: «А если они не владеют ничем и не разумеют?».",["или","взяли они","кроме","помимо","Аллаха","заступников","Скажи","даже если","были они","не","владеют","ничем","и не","разумеют"]],[39,44,["قُل","لِّلَّهِ","ٱلشَّفَٰعَةُ","جَمِيعٗاۖ","لَّهُۥ","مُلۡكُ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِۖ","ثُمَّ","إِلَيۡهِ","تُرۡجَعُونَ"],"ḳул лиллахиш шафа`ату жамии`ал лахуу мулкус самавати вал'арди сумма илайхи туржа`уун","Скажи: «Аллаху принадлежит заступничество целиком. Ему принадлежит власть над небесами и землей, и к Нему вы будете возвращены».",["Скажи","Аллаху","заступничество","целиком","Ему","власть","небес","и земли","затем","к Нему","будете возвращены вы"]],[39,45,["وَإِذَا","ذُكِرَ","ٱللَّهُ","وَحۡدَهُ","ٱشۡمَأَزَّتۡ","قُلُوبُ","ٱلَّذِينَ","لَا","يُؤۡمِنُونَ","بِٱلۡأٓخِرَةِۖ","وَإِذَا","ذُكِرَ","ٱلَّذِينَ","مِن","دُونِهِۦٓ","إِذَا","هُمۡ","يَسۡتَبۡشِرُونَ"],"ва'иза зукираллаху вахдахушмааззат ḳулуубул лазиина ла йу'минууна бил'ахирати ва'иза зукирал лазиина мин дуунихии иза хум йастабшируун","Когда поминают одного лишь Аллаха, содрогаются от отвращения сердца тех, которые не веруют в Последнюю жизнь. А когда поминают тех, которые ниже Него, они радуются.",["и когда","упомянут","Аллах","Его одного","содрогнулись с отвращением","сердца","тех, которые","не","веруют","в Последнюю жизнь","а когда","упомянуты","те, которые","кроме","помимо Него","вот","они","радуются"]],[39,46,["قُلِ","ٱللَّهُمَّ","فَاطِرَ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِ","عَٰلِمَ","ٱلۡغَيۡبِ","وَٱلشَّهَٰدَةِ","أَنتَ","تَحۡكُمُ","بَيۡنَ","عِبَادِكَ","فِي","مَا","كَانُواْ","فِيهِ","يَخۡتَلِفُونَ"],"ḳулиллахумма фатирас самавати вал'арди `алимал гайби вашшахадати анта тахкуму байна `ибадика фии ма кануу фиихи йахталифуун","Скажи: «О Аллах, Творец небес и земли, Ведающий сокровенное и явное! Ты рассудишь Своих рабов в том, в чем они расходились во мнениях».",["Скажи","о Аллах","Творец","небес","и земли","Знающий","сокровенное","и явное","Ты","рассудишь","между","Твоими рабами","в","том, что","они","в нём","расходились"]],[39,47,["وَلَوۡ","أَنَّ","لِلَّذِينَ","ظَلَمُواْ","مَا","فِي","ٱلۡأَرۡضِ","جَمِيعٗا","وَمِثۡلَهُۥ","مَعَهُۥ","لَٱفۡتَدَوۡاْ","بِهِۦ","مِن","سُوٓءِ","ٱلۡعَذَابِ","يَوۡمَ","ٱلۡقِيَٰمَةِۚ","وَبَدَا","لَهُم","مِّنَ","ٱللَّهِ","مَا","لَمۡ","يَكُونُواْ","يَحۡتَسِبُونَ"],"валау анна лиллазиина заламуу ма фил арди жамии`ан вамислахуу ма`ахуу лафтадау бихии мин сууил `азаби йаумал ḳийамати вабада лахум миналлахи ма лам йакуунуу йахтасибуун","Если бы у тех, которые поступали несправедливо, было все, что на земле, и еще столько же, то они непременно попытались бы откупиться этим от ужасных мучений в День воскресения. Но откроется им от Аллаха то, о чем они даже не предполагали.",["и если бы","(было)","у тех, которые","поступили несправедливо","то, что","на","земле","всё","и столько же","вместе с ним","непременно откупились бы","этим","от","злого","мучения","в день","воскресения","и открылось","им","от","Аллаха","то, чего","не","они","предполагали"]]],"m":[[["إِنَّآ","поистине, Мы",39,41],["أَنزَلۡنَا","ниспослали Мы",39,41],["عَلَيۡكَ","тебе",39,41],["ٱلۡكِتَٰبَ","Писание",39,41],["لِلنَّاسِ","для людей",39,41],["بِٱلۡحَقِّۖ","с истиной",39,41],["فَمَنِ","и кто",39,41],["ٱهۡتَدَىٰ","пошёл прямым путём",39,41]],[["فَلِنَفۡسِهِۦۖ","то для своей души",39,41],["وَمَن","а кто",39,41],["ضَلَّ","заблудился",39,41],["فَإِنَّمَا","то лишь",39,41],["يَضِلُّ","заблуждается",39,41],["عَلَيۡهَاۖ","во вред ей",39,41],["وَمَآ","и не",39,41],["أَنتَ","ты",39,41],["عَلَيۡهِم","над ними",39,41]],[["بِوَكِيلٍ","попечитель",39,41],[41],["ٱللَّهُ","Аллах",39,42],["يَتَوَفَّى","забирает",39,42],["ٱلۡأَنفُسَ","души",39,42],["حِينَ","в момент",39,42],["مَوۡتِهَا","их смерти",39,42],["وَٱلَّتِي","и ту, которая",39,42]],[["لَمۡ","не",39,42],["تَمُتۡ","умерла",39,42],["فِي","во",39,42],["مَنَامِهَاۖ","её сне",39,42],["فَيُمۡسِكُ","и удерживает Он",39,42],["ٱلَّتِي","ту, которой",39,42],["قَضَىٰ","предопределил Он",39,42],["عَلَيۡهَا","для неё",39,42],["ٱلۡمَوۡتَ","смерть",39,42]],[["وَيُرۡسِلُ","и отпускает Он",39,42],["ٱلۡأُخۡرَىٰٓ","другую",39,42],["إِلَىٰٓ","до",39,42],["أَجَلٖ","срока",39,42],["مُّسَمًّىۚ","назначенного",39,42],["إِنَّ","поистине",39,42],["فِي","в",39,42],["ذَٰلِكَ","этом",39,42],["لَأٓيَٰتٖ","непременно знамения",39,42]],[["لِّقَوۡمٖ","для людей",39,42],["يَتَفَكَّرُونَ","размышляющих",39,42],[42],["أَمِ","или",39,43],["ٱتَّخَذُواْ","взяли они",39,43],["مِن","кроме",39,43],["دُونِ","помимо",39,43],["ٱللَّهِ","Аллаха",39,43],["شُفَعَآءَۚ","заступников",39,43]],[["قُلۡ","Скажи",39,43],["أَوَلَوۡ","даже если",39,43],["كَانُواْ","были они",39,43],["لَا","не",39,43],["يَمۡلِكُونَ","владеют",39,43],["شَيۡـٔٗا","ничем",39,43],["وَلَا","и не",39,43],["يَعۡقِلُونَ","разумеют",39,43],[43]],[["قُل","Скажи",39,44],["لِّلَّهِ","Аллаху",39,44],["ٱلشَّفَٰعَةُ","заступничество",39,44],["جَمِيعٗاۖ","целиком",39,44],["لَّهُۥ","Ему",39,44],["مُلۡكُ","власть",39,44],["ٱلسَّمَٰوَٰتِ","небес",39,44],["وَٱلۡأَرۡضِۖ","и земли",39,44],["ثُمَّ","затем",39,44]],[["إِلَيۡهِ","к Нему",39,44],["تُرۡجَعُونَ","будете возвращены вы",39,44],[44],["وَإِذَا","и когда",39,45],["ذُكِرَ","упомянут",39,45],["ٱللَّهُ","Аллах",39,45],["وَحۡدَهُ","Его одного",39,45],["ٱشۡمَأَزَّتۡ","содрогнулись с отвращением",39,45]],[["قُلُوبُ","сердца",39,45],["ٱلَّذِينَ","тех, которые",39,45],["لَا","не",39,45],["يُؤۡمِنُونَ","веруют",39,45],["بِٱلۡأٓخِرَةِۖ","в Последнюю жизнь",39,45],["وَإِذَا","а когда",39,45],["ذُكِرَ","упомянуты",39,45],["ٱلَّذِينَ","те, которые",39,45],["مِن","кроме",39,45]],[["دُونِهِۦٓ","помимо Него",39,45],["إِذَا","вот",39,45],["هُمۡ","они",39,45],["يَسۡتَبۡشِرُونَ","радуются",39,45],[45],["قُلِ","Скажи",39,46],["ٱللَّهُمَّ","о Аллах",39,46],["فَاطِرَ","Творец",39,46],["ٱلسَّمَٰوَٰتِ","небес",39,46]],[["وَٱلۡأَرۡضِ","и земли",39,46],["عَٰلِمَ","Знающий",39,46],["ٱلۡغَيۡبِ","сокровенное",39,46],["وَٱلشَّهَٰدَةِ","и явное",39,46],["أَنتَ","Ты",39,46],["تَحۡ