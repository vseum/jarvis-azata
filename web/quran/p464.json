{"p":464,"j":24,"a":[[39,48,["وَبَدَا","لَهُمۡ","سَيِّـَٔاتُ","مَا","كَسَبُواْ","وَحَاقَ","بِهِم","مَّا","كَانُواْ","بِهِۦ","يَسۡتَهۡزِءُونَ"],"вабада лахум саййиату ма касабуу вахаḳа бихим ма кануу бихии йастахзиуун","Им откроются злые деяния, которые они приобрели, а то, над чем они издевались, окружит (или поразит) их.",["и открылись","им","злые деяния","того, что","приобрели они","и окружило","их","то, что","они","над ним","насмехались"]],[39,49,["فَإِذَا","مَسَّ","ٱلۡإِنسَٰنَ","ضُرّٞ","دَعَانَا","ثُمَّ","إِذَا","خَوَّلۡنَٰهُ","نِعۡمَةٗ","مِّنَّا","قَالَ","إِنَّمَآ","أُوتِيتُهُۥ","عَلَىٰ","عِلۡمِۭۚ","بَلۡ","هِيَ","فِتۡنَةٞ","وَلَٰكِنَّ","أَكۡثَرَهُمۡ","لَا","يَعۡلَمُونَ"],"фа'иза массал инсана дуррун да`ана сумма иза хаввалнаху ни`матам минна ḳала иннама уутиитухуу `ала `илми бал хийа фитнатун валакинна аксарахум ла йа`ламуун","Когда человека касается вред, он взывает к Нам. Когда же Мы предоставляем ему благо от Нас, он говорит: «Воистину, это даровано мне благодаря знанию (знанию Аллаха о моих заслугах или моему знанию)». О нет, это - искушение, но большинство их не знает этого.",["и когда","касается","человека","вред","он взывает к Нам","затем","когда","Мы даруем ему","благо","от Нас","он говорит","лишь","даровано мне это","благодаря","знанию","нет же","это","испытание","но","большинство их","не","знают"]],[39,50,["قَدۡ","قَالَهَا","ٱلَّذِينَ","مِن","قَبۡلِهِمۡ","فَمَآ","أَغۡنَىٰ","عَنۡهُم","مَّا","كَانُواْ","يَكۡسِبُونَ"],"ḳад ḳалахал лазиина мин ḳаблихим фама агна `анхум ма кануу йаксибуун","Так уже говорили их предшественники, но их не спасло то, что они приобретали.",["уже","говорили это","те, которые","(из)","до них","но не","помогло","им","то, что","они","приобретали"]],[39,51,["فَأَصَابَهُمۡ","سَيِّـَٔاتُ","مَا","كَسَبُواْۚ","وَٱلَّذِينَ","ظَلَمُواْ","مِنۡ","هَٰٓؤُلَآءِ","سَيُصِيبُهُمۡ","سَيِّـَٔاتُ","مَا","كَسَبُواْ","وَمَا","هُم","بِمُعۡجِزِينَ"],"фа'асабахум саййиату ма касабуу валлазиина заламуу мин ха'улаи сайусиибухум саййиату ма касабуу вама хум биму`жизиин","Их поразили злые деяния, которые они приобрели. Тех, которые поступали несправедливо, из этих также поразят злые деяния, которые они приобрели, и им не удастся спастись.",["и поразили их","злые (деяния)","того, что","они приобрели","а те, которые","поступили несправедливо","из","этих","поразят их","злые (деяния)","того, что","они приобрели","и не","они","ускользнут"]],[39,52,["أَوَلَمۡ","يَعۡلَمُوٓاْ","أَنَّ","ٱللَّهَ","يَبۡسُطُ","ٱلرِّزۡقَ","لِمَن","يَشَآءُ","وَيَقۡدِرُۚ","إِنَّ","فِي","ذَٰلِكَ","لَأٓيَٰتٖ","لِّقَوۡمٖ","يُؤۡمِنُونَ"],"авалам йа`ламуу анналлаха йабсутур ризḳа лиман йашау вайаḳдиру инна фии залика ла'айатил лиḳаумин йу'минуун","Разве они не знают, что Аллах увеличивает или ограничивает удел, кому пожелает? Воистину, в этом - знамения для верующих людей.",["разве не","знают они","что","Аллах","расширяет","удел","тому, кому","Он пожелает","и ограничивает","поистине","в","этом","непременно знамения","для людей","которые веруют"]],[39,53,["قُلۡ","يَٰعِبَادِيَ","ٱلَّذِينَ","أَسۡرَفُواْ","عَلَىٰٓ","أَنفُسِهِمۡ","لَا","تَقۡنَطُواْ","مِن","رَّحۡمَةِ","ٱللَّهِۚ","إِنَّ","ٱللَّهَ","يَغۡفِرُ","ٱلذُّنُوبَ","جَمِيعًاۚ","إِنَّهُۥ","هُوَ","ٱلۡغَفُورُ","ٱلرَّحِيمُ"],"ḳул йа`ибадийал лазиина асрафуу `ала анфусихим ла таḳнатуу мир рахматиллахи инналлаха йагфируз зунууба жамии`ан иннахуу хуал гафуурур рахиим","Скажи Моим рабам, которые излишествовали во вред самим себе: «Не отчаивайтесь в милости Аллаха. Воистину, Аллах прощает грехи полностью, ибо Он - Прощающий, Милосердный».",["скажи","о рабы Мои","которые","излишествовали","против","самих себя","не","отчаивайтесь","в","милости","Аллаха","поистине","Аллах","прощает","грехи","все","поистине Он","Он","Прощающий","Милосердный"]],[39,54,["وَأَنِيبُوٓاْ","إِلَىٰ","رَبِّكُمۡ","وَأَسۡلِمُواْ","لَهُۥ","مِن","قَبۡلِ","أَن","يَأۡتِيَكُمُ","ٱلۡعَذَابُ","ثُمَّ","لَا","تُنصَرُونَ"],"ва'аниибуу ила раббикум ва'аслимуу лахуу мин ḳабли ан йа'тийакумул `азабу сумма ла тунсаруун","Обратитесь к вашему Господу и покоритесь Ему до того, как мучения явятся к вам, ведь тогда вам уже не будет оказана помощь.",["и обратитесь","к","Господу вашему","и покоритесь","Ему","(из)","прежде","чем","придёт к вам","наказание","затем","не","будет вам помощи"]],[39,55,["وَٱتَّبِعُوٓاْ","أَحۡسَنَ","مَآ","أُنزِلَ","إِلَيۡكُم","مِّن","رَّبِّكُم","مِّن","قَبۡلِ","أَن","يَأۡتِيَكُمُ","ٱلۡعَذَابُ","بَغۡتَةٗ","وَأَنتُمۡ","لَا","تَشۡعُرُونَ"],"ваттаби`уу ахсана ма унзила илайкум мир раббикум мин ḳабли ан йа'тийакумул `азабу багтатан ва'антум ла таш`уруун","Следуйте за наилучшим из того, что ниспослано вам вашим Господом, прежде чем мучения явятся к вам внезапно, когда вы даже не почувствуете их приближения.",["и следуйте","наилучшему","(из) того, что","ниспослано","вам","от","Господа вашего","(из)","прежде","чем","придёт к вам","наказание","внезапно","и вы","не","почувствуете"]],[39,56,["أَن","تَقُولَ","نَفۡسٞ","يَٰحَسۡرَتَىٰ","عَلَىٰ","مَا","فَرَّطتُ","فِي","جَنۢبِ","ٱللَّهِ","وَإِن","كُنتُ","لَمِنَ","ٱلسَّٰخِرِينَ"],"ан таḳуула нафсун йахасрата `ала ма фарратту фии жамбиллахи ва'ин кунту ламинас сахириин","Чтобы не пришлось человеку говорить: «О горе мне за то, что я был нерадив по отношению к Аллаху! Я был всего лишь одним из насмехающихся!».",["чтобы не","сказала","душа","о горе мне","за","то, что","я упустил","в","отношении","Аллаха","и ведь","я был","непременно из","насмехающихся"]]],"m":[[["وَبَدَا","и открылись",39,48],["لَهُمۡ","им",39,48],["سَيِّـَٔاتُ","злые деяния",39,48],["مَا","того, что",39,48],["كَسَبُواْ","приобрели они",39,48],["وَحَاقَ","и окружило",39,48],["بِهِم","их",39,48],["مَّا","то, что",39,48],["كَانُواْ","они",39,48],["بِهِۦ","над ним",39,48]],[["يَسۡتَهۡزِءُونَ","насмехались",39,48],[48],["فَإِذَا","и когда",39,49],["مَسَّ","касается",39,49],["ٱلۡإِنسَٰنَ","человека",39,49],["ضُرّٞ","вред",39,49],["دَعَانَا","он взывает к Нам",39,49],["ثُمَّ","затем",39,49],["إِذَا","когда",39,49],["خَوَّلۡنَٰهُ","Мы даруем ему",39,49]],[["نِعۡمَةٗ","благо",39,49],["مِّنَّا","от Нас",39,49],["قَالَ","он говорит",39,49],["إِنَّمَآ","лишь",39,49],["أُوتِيتُهُۥ","даровано мне это",39,49],["عَلَىٰ","благодаря",39,49],["عِلۡمِۭۚ","знанию",39,49],["بَلۡ","нет же",39,49],["هِيَ","это",39,49],["فِتۡنَةٞ","испытание",39,49],["وَلَٰكِنَّ","но",39,49]],[["أَكۡثَرَهُمۡ","большинство их",39,49],["لَا","не",39,49],["يَعۡلَمُونَ","знают",39,49],[49],["قَدۡ","уже",39,50],["قَالَهَا","говорили это",39,50],["ٱلَّذِينَ","те, которые",39,50],["مِن","(из)",39,50],["قَبۡلِهِمۡ","до них",39,50],["فَمَآ","но не",39,50],["أَغۡنَىٰ","помогло",39,50]],[["عَنۡهُم","им",39,50],["مَّا","то, что",39,50],["كَانُواْ","они",39,50],["يَكۡسِبُونَ","приобретали",39,50],[50],["فَأَصَابَهُمۡ","и поразили их",39,51],["سَيِّـَٔاتُ","злые (деяния)",39,51],["مَا","того, что",39,51],["كَسَبُواْۚ","они приобрели",39,51]],[["وَٱلَّذِينَ","а те, которые",39,51],["ظَلَمُواْ","поступили несправедливо",39,51],["مِنۡ","из",39,51],["هَٰٓؤُلَآءِ","этих",39,51],["سَيُصِيبُهُمۡ","поразят их",39,51],["سَيِّـَٔاتُ","злые (деяния)",39,51],["مَا","того, что",39,51],["كَسَبُواْ","они приобрели",39,51]],[["وَمَا","и не",39,51],["هُم","они",39,51],["بِمُعۡجِزِينَ","ускользнут",39,51],[51],["أَوَلَمۡ","разве не",39,52],["يَعۡلَمُوٓاْ","знают они",39,52],["أَنَّ","что",39,52],["ٱللَّهَ","Аллах",39,52],["يَبۡسُطُ","расширяет",39,52],["ٱلرِّزۡقَ","удел",39,52]],[["لِمَن","тому, кому",39,52],["يَشَآءُ","Он пожелает",39,52],["وَيَقۡدِرُۚ","и ограничивает",39,52],["إِنَّ","поистине",39,52],["فِي","в",39,52],["ذَٰلِكَ","этом",39,52],["لَأٓيَٰتٖ","непременно знамения",39,52],["لِّقَوۡمٖ","для людей",39,52],["يُؤۡمِنُونَ","которые веруют",39,52],[52]],[["۞ قُلۡ","скажи",39,53],["يَٰعِبَادِيَ","о рабы Мои",39,53],["ٱلَّذِينَ","которые",39,53],["أَسۡرَفُواْ","излишествовали",39,53],["عَلَىٰٓ","против",39,53],["أَنفُسِهِمۡ","самих себя",39,53],["لَا","не",39,53],["تَقۡنَطُواْ","отчаивайтесь",39,53],["مِن","в",39,53]],[["رَّحۡمَةِ","милости",39,53],["ٱللَّهِۚ","Аллаха",39,53],["إِنَّ","поистине",39,53],["ٱللَّهَ","Аллах",39,53],["يَغۡفِرُ","прощает",39,53],["ٱلذُّنُوبَ","грехи",39,53],["جَمِيعًاۚ","все",39,53],["إِنَّهُۥ","поистине Он",39,53],["هُوَ","Он",39,53],["ٱلۡغَفُورُ","Прощающий",39,53],["ٱلرَّحِيمُ","Милосердный",39,53]],[[53],["وَأَنِيبُوٓاْ","и обратитесь",39,54],["إِلَىٰ","к",39,54],["رَبِّكُمۡ","Господу вашему",39,54],["وَأَسۡلِمُواْ","и покоритесь",39,54],["لَهُۥ","Ему",39,54],["مِن","(из)",39,54],["قَبۡلِ","прежде",39,54],["أَن","чем",39,54],["يَأۡتِيَكُمُ","придёт к вам",39,54]],[["ٱلۡعَذَابُ","наказание",39,54],["ثُمَّ","затем",39,54],["لَا","не",39,54],["تُنصَرُونَ","будет вам помощи",39,54],[54],["وَٱتَّبِعُوٓاْ","и следуйте",39,55],["أَحۡسَنَ","наилучшему",39,55],["مَآ","(из) того, что",39,55],["أُنزِلَ","ниспослано",39,55]],[["إِلَيۡكُم","вам",39,55],["مِّن","от",39,55],["رَّبِّكُم","Господа вашего",39,55],["مِّن","(из)",39,55],["قَبۡلِ","прежде",39,55],["أَن","чем",39,55],["يَأۡتِيَكُمُ","придёт к вам",39,55],["ٱلۡعَذَابُ","наказание",39,55]],[["بَغۡتَةٗ","внезапно",39,55],["وَأَنتُمۡ","и вы",39,55],["لَا","не",39,55],["تَشۡعُرُونَ","почувствуете",39,55],[55],["أَن","чтобы не",39,56],["تَقُولَ","сказала",39,56],["نَفۡسٞ","душа",39,56],["يَٰحَسۡرَتَىٰ","о горе мне",39,56]],[["عَلَىٰ","за",39,56],["مَا","то, что",39,56],["فَرَّطتُ","я упустил",39,56],["فِي","в",39,56],["جَنۢبِ","отношении",39,56],["ٱللَّهِ","Аллаха",39,56],["وَإِن","и ведь",39,56],["كُنتُ","я был",39,56],["لَمِنَ","непременно из",39,56],["ٱلسَّٰخِرِينَ","насмехающихся",39,56],[56]]]}