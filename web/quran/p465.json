{"p":465,"j":24,"a":[[39,57,["أَوۡ","تَقُولَ","لَوۡ","أَنَّ","ٱللَّهَ","هَدَىٰنِي","لَكُنتُ","مِنَ","ٱلۡمُتَّقِينَ"],"ау таḳуула лау анналлаха хадании лакунту минал муттаḳиин","Или чтобы не пришлось ему говорить: «Если бы Аллах наставил меня на прямой путь, то я был бы одним из богобоязненных».",["или","сказала","если бы","что","Аллах","наставил меня","непременно я был бы","из","богобоязненных"]],[39,58,["أَوۡ","تَقُولَ","حِينَ","تَرَى","ٱلۡعَذَابَ","لَوۡ","أَنَّ","لِي","كَرَّةٗ","فَأَكُونَ","مِنَ","ٱلۡمُحۡسِنِينَ"],"ау таḳуула хиина тарал `азаба лау анна лии карратан фа'акууна минал мухсиниин","Или чтобы не пришлось ему говорить, когда он увидит мучения: «Если бы у меня была еще одна возможность, то я стал бы одним из творящих добро».",["или","сказала","когда","увидит","наказание","если бы","что","у меня","возвращение","то я стал бы","из","творящих добро"]],[39,59,["بَلَىٰ","قَدۡ","جَآءَتۡكَ","ءَايَٰتِي","فَكَذَّبۡتَ","بِهَا","وَٱسۡتَكۡبَرۡتَ","وَكُنتَ","مِنَ","ٱلۡكَٰفِرِينَ"],"бала ḳад жаатка айатии факаззабта биха вастакбарта вакунта минал кафириин","О нет! К тебе явились Мои знамения, но ты счел их ложью, возгордился и был одним из неверующих.",["нет же","уже","пришли к тебе","знамения Мои","но ты счёл ложью","их","и возгордился","и был ты","из","неверующих"]],[39,60,["وَيَوۡمَ","ٱلۡقِيَٰمَةِ","تَرَى","ٱلَّذِينَ","كَذَبُواْ","عَلَى","ٱللَّهِ","وُجُوهُهُم","مُّسۡوَدَّةٌۚ","أَلَيۡسَ","فِي","جَهَنَّمَ","مَثۡوٗى","لِّلۡمُتَكَبِّرِينَ"],"вайаумал ḳийамати тарал лазиина казабуу `алаллахи вужуухухум мусваддатун алайса фии жаханнама масвал лилмутакаббириин","В День воскресения ты увидишь тех, которые возводили навет на Аллаха, с почерневшими лицами. Разве не в Геенне обитель возгордившихся?",["и в день","воскресения","увидишь","тех, которые","возвели ложь","на","Аллаха","лица их","почерневшие","разве не","в","Геенне","обитель","для возгордившихся"]],[39,61,["وَيُنَجِّي","ٱللَّهُ","ٱلَّذِينَ","ٱتَّقَوۡاْ","بِمَفَازَتِهِمۡ","لَا","يَمَسُّهُمُ","ٱلسُّوٓءُ","وَلَا","هُمۡ","يَحۡزَنُونَ"],"вайунажжиллахул лазиинаттаḳау бимафазатихим ла йамассухумус су'уу вала хум йахзануун","Аллах спасет богобоязненных, и они обретут успех (или по причине их успеха). Зло не коснется их, и они не будут опечалены.",["и спасёт","Аллах","тех, которые","были богобоязненны","благодаря их успеху","не","коснётся их","зло","и не","они","опечалятся"]],[39,62,["ٱللَّهُ","خَٰلِقُ","كُلِّ","شَيۡءٖۖ","وَهُوَ","عَلَىٰ","كُلِّ","شَيۡءٖ","وَكِيلٞ"],"аллаху халиḳу кулли шай'ин вахуа `ала кулли шай'ин вакиил","Аллах - Творец всякой вещи. Он - Попечитель и Хранитель всякой вещи.",["Аллах","Творец","всякой","вещи","и Он","над","всякой","вещью","Попечитель"]],[39,63,["لَّهُۥ","مَقَالِيدُ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِۗ","وَٱلَّذِينَ","كَفَرُواْ","بِـَٔايَٰتِ","ٱللَّهِ","أُوْلَٰٓئِكَ","هُمُ","ٱلۡخَٰسِرُونَ"],"ллахуу маḳалиидус самавати вал'арди валлазиина кафаруу би'айатиллахи улаика хумул хасируун","Ему принадлежат ключи небес и земли. А те, которые не веруют в знамения Аллаха, являются потерпевшими убыток.",["Ему (принадлежат)","ключи","небес","и земли","а те, которые","не уверовали","в знамения","Аллаха","те","они","потерпевшие убыток"]],[39,64,["قُلۡ","أَفَغَيۡرَ","ٱللَّهِ","تَأۡمُرُوٓنِّيٓ","أَعۡبُدُ","أَيُّهَا","ٱلۡجَٰهِلُونَ"],"ḳул афагайраллахи та'мурууннии а`буду аййухал жахилуун","Скажи: «Неужели вы повелеваете мне поклоняться кому-либо другому вместо Аллаха, о невежды?».",["скажи","неужели иному, чем","Аллах","вы велите мне","поклоняться","о","невежды"]],[39,65,["وَلَقَدۡ","أُوحِيَ","إِلَيۡكَ","وَإِلَى","ٱلَّذِينَ","مِن","قَبۡلِكَ","لَئِنۡ","أَشۡرَكۡتَ","لَيَحۡبَطَنَّ","عَمَلُكَ","وَلَتَكُونَنَّ","مِنَ","ٱلۡخَٰسِرِينَ"],"валаḳад уухийа илайка ва'илал лазиина мин ḳаблика ла'ин ашракта лайахбатанна `амалука валатакуунанна минал хасириин","Тебе и твоим предшественникам уже было внушено: «Если ты станешь приобщать сотоварищей, то тщетными будут твои деяния и ты непременно окажешься одним из потерпевших убыток».",["и уже","внушено","тебе","и","тем, которые","(были) до","тебя","если","ты придашь сотоварищей","непременно тщетным станет","дело твоё","и непременно станешь","из","потерпевших убыток"]],[39,66,["بَلِ","ٱللَّهَ","فَٱعۡبُدۡ","وَكُن","مِّنَ","ٱلشَّٰكِرِينَ"],"балиллаха фа`буд вакум минаш шакириин","Поклоняйся же одному Аллаху и будь в числе благодарных.",["нет же","Аллаху","поклоняйся же","и будь","из","благодарных"]],[39,67,["وَمَا","قَدَرُواْ","ٱللَّهَ","حَقَّ","قَدۡرِهِۦ","وَٱلۡأَرۡضُ","جَمِيعٗا","قَبۡضَتُهُۥ","يَوۡمَ","ٱلۡقِيَٰمَةِ","وَٱلسَّمَٰوَٰتُ","مَطۡوِيَّٰتُۢ","بِيَمِينِهِۦۚ","سُبۡحَٰنَهُۥ","وَتَعَٰلَىٰ","عَمَّا","يُشۡرِكُونَ"],"вама ḳадаруллаха хаḳḳа ḳадрихии вал'арду жамии`ан ḳабдатухуу йаумал ḳийамати вассамавату матвиййату бийамиинихии субханахуу вата`ала `амма йушрикуун","Не ценили они Аллаха должным образом, а ведь вся земля в День воскресения будет всего лишь Пригоршней Его, а небеса будут свернуты Его Десницей. Пречист Он и превыше того, что они приобщают к Нему в сотоварищи.",["и не","оценили они","Аллаха","истинной","оценкой Его","а земля","вся","в горсти Его","в день","воскресения","и небеса","свёрнуты","Десницей Его","пречист Он","и превыше","того, что","они приобщают"]]],"m":[[["أَوۡ","или",39,57],["تَقُولَ","сказала",39,57],["لَوۡ","если бы",39,57],["أَنَّ","что",39,57],["ٱللَّهَ","Аллах",39,57],["هَدَىٰنِي","наставил меня",39,57],["لَكُنتُ","непременно я был бы",39,57],["مِنَ","из",39,57],["ٱلۡمُتَّقِينَ","богобоязненных",39,57],[57]],[["أَوۡ","или",39,58],["تَقُولَ","сказала",39,58],["حِينَ","когда",39,58],["تَرَى","увидит",39,58],["ٱلۡعَذَابَ","наказание",39,58],["لَوۡ","если бы",39,58],["أَنَّ","что",39,58],["لِي","у меня",39,58],["كَرَّةٗ","возвращение",39,58],["فَأَكُونَ","то я стал бы",39,58]],[["مِنَ","из",39,58],["ٱلۡمُحۡسِنِينَ","творящих добро",39,58],[58],["بَلَىٰ","нет же",39,59],["قَدۡ","уже",39,59],["جَآءَتۡكَ","пришли к тебе",39,59],["ءَايَٰتِي","знамения Мои",39,59],["فَكَذَّبۡتَ","но ты счёл ложью",39,59],["بِهَا","их",39,59]],[["وَٱسۡتَكۡبَرۡتَ","и возгордился",39,59],["وَكُنتَ","