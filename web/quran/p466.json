{"p":466,"j":24,"a":[[39,68,["وَنُفِخَ","فِي","ٱلصُّورِ","فَصَعِقَ","مَن","فِي","ٱلسَّمَٰوَٰتِ","وَمَن","فِي","ٱلۡأَرۡضِ","إِلَّا","مَن","شَآءَ","ٱللَّهُۖ","ثُمَّ","نُفِخَ","فِيهِ","أُخۡرَىٰ","فَإِذَا","هُمۡ","قِيَامٞ","يَنظُرُونَ"],"вануфиха фис суури фаса`иḳа ман фис самавати ваман фил арди илла ман шааллаху сумма нуфиха фиихи ухра фа'иза хум ḳийамун йанзуруун","Но подуют в Рог, и тогда потеряют сознание (или умрут) те, кто на небесах, и те, кто на земле, кроме тех, кого Аллах пожелает оставить. Потом в нее подуют еще раз, и тогда они встанут и будут смотреть.",["и подуют","в","Рог","и падут бездыханными","те, кто","на","небесах","и те, кто","на","земле","кроме","тех, кого","пожелал","Аллах","затем","подуют","в него","ещё раз","и вот","они","стоят","смотрят"]],[39,69,["وَأَشۡرَقَتِ","ٱلۡأَرۡضُ","بِنُورِ","رَبِّهَا","وَوُضِعَ","ٱلۡكِتَٰبُ","وَجِاْيٓءَ","بِٱلنَّبِيِّـۧنَ","وَٱلشُّهَدَآءِ","وَقُضِيَ","بَيۡنَهُم","بِٱلۡحَقِّ","وَهُمۡ","لَا","يُظۡلَمُونَ"],"ва'ашраḳатил арду бинуури раббиха вавуди`ал китабу важий'а биннабиййиина вашшухадаи ваḳудийа байнахум билхаḳḳи вахум ла йузламуун","Земля озарится светом своего Господа. Будет положено Писание, и будут приведены пророки и свидетели. Между ними рассудят по справедливости, и с ними не поступят несправедливо.",["и озарится","земля","светом","Господа её","и положено будет","Писание","и приведены будут","пророки","и свидетели","и рассужено будет","между ними","по истине","и они","не","будут обижены"]],[39,70,["وَوُفِّيَتۡ","كُلُّ","نَفۡسٖ","مَّا","عَمِلَتۡ","وَهُوَ","أَعۡلَمُ","بِمَا","يَفۡعَلُونَ"],"вавуффийат куллу нафсим ма `амилат вахуа а`ламу бима йаф`алуун","Каждой душе воздастся сполна за то, что она совершила. Ему лучше знать о том, что они делают.",["и сполна воздастся","каждой","душе","(за) то, что","она совершила","и Он","лучше знает","о том, что","они делают"]],[39,71,["وَسِيقَ","ٱلَّذِينَ","كَفَرُوٓاْ","إِلَىٰ","جَهَنَّمَ","زُمَرًاۖ","حَتَّىٰٓ","إِذَا","جَآءُوهَا","فُتِحَتۡ","أَبۡوَٰبُهَا","وَقَالَ","لَهُمۡ","خَزَنَتُهَآ","أَلَمۡ","يَأۡتِكُمۡ","رُسُلٞ","مِّنكُمۡ","يَتۡلُونَ","عَلَيۡكُمۡ","ءَايَٰتِ","رَبِّكُمۡ","وَيُنذِرُونَكُمۡ","لِقَآءَ","يَوۡمِكُمۡ","هَٰذَاۚ","قَالُواْ","بَلَىٰ","وَلَٰكِنۡ","حَقَّتۡ","كَلِمَةُ","ٱلۡعَذَابِ","عَلَى","ٱلۡكَٰفِرِينَ"],"васииḳал лазиина кафаруу ила жаханнама зумаран хатта иза жаууха футихат абвабуха ваḳала лахум хазанатуха алам йа'тикум русулум минкум йатлууна `алайкум айати раббикум вайунзируунакум лиḳаа йаумикум хаза ḳалуу бала валакин хаḳḳат калиматул `азаби `алал кафириин","Тех, которые не уверовали, толпами погонят в Геенну. Когда они подойдут в ней, ее врата будут распахнуты, и ее стражи скажут им: «Разве не приходили к вам посланники из вас самих, которые читали вам аяты вашего Господа и предупреждали вас о встрече с этим днем вашим?». Они скажут: «Конечно!». Но сбылось относительно неверующих Слово о мучениях.",["и пригнаны будут","те, которые","не уверовали","в","Геенну","толпами","пока","когда","придут к ней","открыты будут","врата её","и скажут","им","стражи её","разве не","приходили к вам","посланники","из вас","читающие","вам","знамения","Господа вашего","и предостерегающие вас","(о) встрече","дня вашего","этого","скажут они","да","но","сбылось","слово","наказания","над","неверующими"]],[39,72,["قِيلَ","ٱدۡخُلُوٓاْ","أَبۡوَٰبَ","جَهَنَّمَ","خَٰلِدِينَ","فِيهَاۖ","فَبِئۡسَ","مَثۡوَى","ٱلۡمُتَكَبِّرِينَ"],"ḳииладхулуу абваба жаханнама халидиина фииха фаби'са масвал мутакаббириин","Будет сказано: «Войдите во врата Геенны и пребудьте там вечно!». Как же скверна обитель возгордившихся!",["сказано будет","войдите","(во) врата","Геенны","вечно пребывая","в ней","и как скверна","обитель","возгордившихся"]],[39,73,["وَسِيقَ","ٱلَّذِينَ","ٱتَّقَوۡاْ","رَبَّهُمۡ","إِلَى","ٱلۡجَنَّةِ","زُمَرًاۖ","حَتَّىٰٓ","إِذَا","جَآءُوهَا","وَفُتِحَتۡ","أَبۡوَٰبُهَا","وَقَالَ","لَهُمۡ","خَزَنَتُهَا","سَلَٰمٌ","عَلَيۡكُمۡ","طِبۡتُمۡ","فَٱدۡخُلُوهَا","خَٰلِدِينَ"],"васииḳал лазиинаттаḳау раббахум илал жаннати зумаран хатта иза жаууха вафутихат абвабуха ваḳала лахум хазанатуха саламун `алайкум тибтум фадхулууха халидиин","А тех, которые боялись своего Господа, толпами проводят в Рай. Когда они приблизятся, и его врата распахнутся, его стражи скажут им: «Мир вам! Вы были хороши. Входите же сюда навечно!».",["и проведены будут","те, которые","боялись","Господа своего","в","Рай","толпами","пока","когда","придут к нему","и открыты будут","врата его","и скажут","им","стражи его","мир","вам","вы были хороши","входите же в него","вечно пребывая"]],[39,74,["وَقَالُواْ","ٱلۡحَمۡدُ","لِلَّهِ","ٱلَّذِي","صَدَقَنَا","وَعۡدَهُۥ","وَأَوۡرَثَنَا","ٱلۡأَرۡضَ","نَتَبَوَّأُ","مِنَ","ٱلۡجَنَّةِ","حَيۡثُ","نَشَآءُۖ","فَنِعۡمَ","أَجۡرُ","ٱلۡعَٰمِلِينَ"],"ваḳалул хамду лиллахил лазии садаḳана ва`дахуу ва'аурасанал арда натабаввау минал жаннати хайсу нашау фани`ма ажрул `амилиин","Они скажут: «Хвала Аллаху, Который дал нам правдивое обещание и позволил нам унаследовать райскую землю. Мы можем поселиться в Раю, где пожелаем. Как же прекрасна награда тружеников!».",["и скажут они","хвала","Аллаху","Который","оправдал нам","обещание Его","и дал нам в наследие","землю","селимся мы","в","Раю","где","пожелаем","и прекрасна же","награда","трудящихся"]]],"m":[[["وَنُفِخَ","и подуют",39,68],["فِي","в",39,68],["ٱلصُّورِ","Рог",39,68],["فَصَعِقَ","и падут бездыханными",39,68],["مَن","те, кто",39,68],["فِي","на",39,68],["ٱلسَّمَٰوَٰتِ","небесах",39,68],["وَمَن","и те, кто",39,68],["فِي","на",39,68],["ٱلۡأَرۡضِ","земле",39,68]],[["إِلَّا","кроме",39,68],["مَن","тех, кого",39,68],["شَآءَ","пожелал",39,68],["ٱللَّهُۖ","Аллах",39,68],["ثُمَّ","затем",39,68],["نُفِخَ","подуют",39,68],["فِيهِ","в него",39,68],["أُخۡرَىٰ","ещё раз",39,68],["فَإِذَا","и вот",39,68],["هُمۡ","они",39,68],["قِيَامٞ","стоят",39,68],["يَنظُرُونَ","смотрят",39,68]],[[68],["وَأَشۡرَقَتِ","и озарится",39,69],["ٱلۡأَرۡضُ","земля",39,69],["بِنُورِ","светом",39,69],["رَبِّهَا","Господа её",39,69],["وَوُضِعَ","и положено будет",39,69],["ٱلۡكِتَٰبُ","Писание",39,69],["وَجِاْيٓءَ","и приведены будут",39,69]],[["بِٱلنَّبِيِّـۧنَ","пророки",39,69],["وَٱلشُّهَدَآءِ","и свидетели",39,69],["وَقُضِيَ","и рассужено будет",39,69],["بَيۡنَهُم","между ними",39,69],["بِٱلۡحَقِّ","по истине",39,69],["وَهُمۡ","и они",39,69],["لَا","не",39,69],["يُظۡلَمُونَ","будут обижены",39,69]],[[69],["وَوُفِّيَتۡ","и сполна воздастся",39,70],["كُلُّ","каждой",39,70],["نَفۡسٖ","душе",39,70],["مَّا","(за) то, что",39,70],["عَمِلَتۡ","она совершила",39,70],["وَهُوَ","и Он",39,70],["أَعۡلَمُ","лучше знает",39,70],["بِمَا","о том, что",39,70],["يَفۡعَلُونَ","они делают",39,70],[70]],[["وَسِيقَ","и пригнаны будут",39,71],["ٱلَّذِينَ","те, которые",39,71],["كَفَرُوٓاْ","не уверовали",39,71],["إِلَىٰ","в",39,71],["جَهَنَّمَ","Геенну",39,71],["زُمَرًاۖ","толпами",39,71],["حَتَّىٰٓ","пока",39,71],["إِذَا","когда",39,71],["جَآءُوهَا","придут к ней",39,71]],[["فُتِحَتۡ","открыты будут",39,71],["أَبۡوَٰبُهَا","врата её",39,71],["وَقَالَ","и скажут",39,71],["لَهُمۡ","им",39,71],["خَزَنَتُهَآ","стражи её",39,71],["أَلَمۡ","разве не",39,71],["يَأۡتِكُمۡ","приходили к вам",39,71],["رُسُلٞ","посланники",39,71],["مِّنكُمۡ","из вас",39,71]],[["يَتۡلُونَ","читающие",39,71],["عَلَيۡكُمۡ","вам",39,71],["ءَايَٰتِ","знамения",39,71],["رَبِّكُمۡ","Господа вашего",39,71],["وَيُنذِرُونَكُمۡ","и предостерегающие вас",39,71],["لِقَآءَ","(о) встрече",39,71],["يَوۡمِكُمۡ","дня вашего",39,71]],[["هَٰذَاۚ","этого",39,71],["قَالُواْ","скажут они",39,71],["بَلَىٰ","да",39,71],["وَلَٰكِنۡ","но",39,71],["حَقَّتۡ","сбылось",39,71],["كَلِمَةُ","слово",39,71],["ٱلۡعَذَابِ","наказания",39,71],["عَلَى","над",39,71],["ٱلۡكَٰفِرِينَ","неверующими",39,71]],[[71],["قِيلَ","сказано будет",39,72],["ٱدۡخُلُوٓاْ","войдите",39,72],["أَبۡوَٰبَ","(во) врата",39,72],["جَهَنَّمَ","Геенны",39,72],["خَٰلِدِينَ","вечно пребывая",39,72],["فِيهَاۖ","в ней",39,72],["فَبِئۡسَ","и как скверна",39,72],["مَثۡوَى","обитель",39,72]],[["ٱلۡمُتَكَبِّرِينَ","возгордившихся",39,72],[72],["وَسِيقَ","и проведены будут",39,73],["ٱلَّذِينَ","те, которые",39,73],["ٱتَّقَوۡاْ","боялись",39,73],["رَبَّهُمۡ","Господа своего",39,73],["إِلَى","в",39,73]],[["ٱلۡجَنَّةِ","Рай",39,73],["زُمَرًاۖ","толпами",39,73],["حَتَّىٰٓ","пока",39,73],["إِذَا","когда",39,73],["جَآءُوهَا","придут к нему",39,73],["وَفُتِحَتۡ","и открыты будут",39,73],["أَبۡوَٰبُهَا","врата его",39,73],["وَقَالَ","и скажут",39,73],["لَهُمۡ","им",39,73]],[["خَزَنَتُهَا","стражи его",39,73],["سَلَٰمٌ","мир",39,73],["عَلَيۡكُمۡ","вам",39,73],["طِبۡتُمۡ","вы были хороши",39,73],["فَٱدۡخُلُوهَا","входите же в него",39,73],["خَٰلِدِينَ","вечно пребывая",39,73],[73]],[["وَقَالُواْ","и скажут они",39,74],["ٱلۡحَمۡدُ","хвала",39,74],["لِلَّهِ","Аллаху",39,74],["ٱلَّذِي","Который",39,74],["صَدَقَنَا","оправдал нам",39,74],["وَعۡدَهُۥ","обещание Его",39,74],["وَأَوۡرَثَنَا","и дал нам в наследие",39,74],["ٱلۡأَرۡضَ","землю",39,74]],[["نَتَبَوَّأُ","селимся мы",39,74],["مِنَ","в",39,74],["ٱلۡجَنَّةِ","Раю",39,74],["حَيۡثُ","где",39,74],["نَشَآءُۖ","пожелаем",39,74],["فَنِعۡمَ","и прекрасна же",39,74],["أَجۡرُ","награда",39,74],["ٱلۡعَٰمِلِينَ","трудящихся",39,74],[74]]]}