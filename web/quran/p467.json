{"p":467,"j":24,"a":[[39,75,["وَتَرَى","ٱلۡمَلَٰٓئِكَةَ","حَآفِّينَ","مِنۡ","حَوۡلِ","ٱلۡعَرۡشِ","يُسَبِّحُونَ","بِحَمۡدِ","رَبِّهِمۡۚ","وَقُضِيَ","بَيۡنَهُم","بِٱلۡحَقِّۚ","وَقِيلَ","ٱلۡحَمۡدُ","لِلَّهِ","رَبِّ","ٱلۡعَٰلَمِينَ"],"ватарал малаиката хаффиина мин хаулил `арши йусаббихууна бихамди раббихим ваḳудийа байнахум билхаḳḳи ваḳиилал хамду лиллахи раббил `аламиин","Ты увидишь ангелов, окружающих Трон и прославляющих хвалой своего Господа. Между ними рассудят по справедливости, и будет сказано: «Хвала Аллаху, Господу миров!».",["и увидишь","ангелов","окружающих","(из)","вокруг","Трона","славя","хвалою","Господа их","и рассужено будет","между ними","по истине","и сказано будет","хвала","Аллаху","Господу","миров"]],[40,1,["حمٓ"],"хм","Ха. Мим.",["Ха Мим"]],[40,2,["تَنزِيلُ","ٱلۡكِتَٰبِ","مِنَ","ٱللَّهِ","ٱلۡعَزِيزِ","ٱلۡعَلِيمِ"],"танзиилул китаби миналлахил `азиизил `алиим","Писание ниспослано от Аллаха Могущественного, Знающего,",["ниспослание","Писания","от","Аллаха","Могущественного","Знающего"]],[40,3,["غَافِرِ","ٱلذَّنۢبِ","وَقَابِلِ","ٱلتَّوۡبِ","شَدِيدِ","ٱلۡعِقَابِ","ذِي","ٱلطَّوۡلِۖ","لَآ","إِلَٰهَ","إِلَّا","هُوَۖ","إِلَيۡهِ","ٱلۡمَصِيرُ"],"гафириз замби ваḳабилит тауби шадиидил `иḳаби зит таули ла илаха илла хуа илайхил масиир","Прощающего грехи, Принимающего покаяния, Сурового в наказании, Обладающего милостью. Нет божества, кроме Него, и к Нему предстоит прибытие.",["Прощающего","грех","и Принимающего","покаяние","Сурового","(в) наказании","Обладателя","милости","нет","божества","кроме","Него","к Нему","возвращение"]],[40,4,["مَا","يُجَٰدِلُ","فِيٓ","ءَايَٰتِ","ٱللَّهِ","إِلَّا","ٱلَّذِينَ","كَفَرُواْ","فَلَا","يَغۡرُرۡكَ","تَقَلُّبُهُمۡ","فِي","ٱلۡبِلَٰدِ"],"ма йужадилу фии айатиллахи иллал лазиина кафаруу фала йагрурка таḳаллубухум фил билад","Знамения Аллаха оспаривают только неверующие. Пусть не обольщает тебя то, как они мечутся на земле.",["не","спорят","о","знамениях","Аллаха","кроме","тех, которые","не уверовали","так пусть не","обольщает тебя","их хождение","по","странам"]],[40,5,["كَذَّبَتۡ","قَبۡلَهُمۡ","قَوۡمُ","نُوحٖ","وَٱلۡأَحۡزَابُ","مِنۢ","بَعۡدِهِمۡۖ","وَهَمَّتۡ","كُلُّ","أُمَّةِۭ","بِرَسُولِهِمۡ","لِيَأۡخُذُوهُۖ","وَجَٰدَلُواْ","بِٱلۡبَٰطِلِ","لِيُدۡحِضُواْ","بِهِ","ٱلۡحَقَّ","فَأَخَذۡتُهُمۡۖ","فَكَيۡفَ","كَانَ","عِقَابِ"],"каззабат ḳаблахум ḳауму нуухин вал'ахзабу мим ба`дихим вахаммат куллу уммати бирасуулихим лийа'хузууху важадалуу билбатили лийудхидуу бихил хаḳḳа фа'ахазтухум факайфа кана `иḳаб","До них сочли лжецами посланников народ Нуха (Ноя) и соумышленники после них. Каждый народ намеревался схватить своего посланника. Они спорили, прибегая ко лжи, чтобы опровергнуть ею истину. Но Я схватил их, и каким же было Мое наказание!",["отвергли","до них","народ","Нуха","и сонмища","(из)","после них","и замыслила","каждая","община","против посланника своего","чтобы схватить его","и спорили они","ложью","чтобы опровергнуть","ею","истину","и Я схватил их","и каким же","было","наказание Моё"]],[40,6,["وَكَذَٰلِكَ","حَقَّتۡ","كَلِمَتُ","رَبِّكَ","عَلَى","ٱلَّذِينَ","كَفَرُوٓاْ","أَنَّهُمۡ","أَصۡحَٰبُ","ٱلنَّارِ"],"ваказалика хаḳḳат калимату раббика `алал лазиина кафаруу аннахум асхабун нар","Так сбылось Слово твоего Господа относительно того, что неверующие окажутся обитателями Огня.",["и так","сбылось","слово","Господа твоего","относительно","тех, которые","не уверовали","что они","обитатели","Огня"]],[40,7,["ٱلَّذِينَ","يَحۡمِلُونَ","ٱلۡعَرۡشَ","وَمَنۡ","حَوۡلَهُۥ","يُسَبِّحُونَ","بِحَمۡدِ","رَبِّهِمۡ","وَيُؤۡمِنُونَ","بِهِۦ","وَيَسۡتَغۡفِرُونَ","لِلَّذِينَ","ءَامَنُواْۖ","رَبَّنَا","وَسِعۡتَ","كُلَّ","شَيۡءٖ","رَّحۡمَةٗ","وَعِلۡمٗا","فَٱغۡفِرۡ","لِلَّذِينَ","تَابُواْ","وَٱتَّبَعُواْ","سَبِيلَكَ","وَقِهِمۡ","عَذَابَ","ٱلۡجَحِيمِ"],"аллазиина йахмилуунал `арша ваман хаулахуу йусаббихууна бихамди раббихим вайу'минууна бихии вайастагфирууна лиллазиина амануу раббана васи`та кулла шай'ир рахматан ва`илман фагфир лиллазиина табуу ваттаба`уу сабиилака ваḳихим `азабал жахиим","Те, которые несут Трон, и те, которые вокруг него, прославляют хвалой своего Господа, веруют в Него и просят прощения для верующих: «Господь наш! Ты объял всякую вещь милостью и знанием. Прости же тех, которые раскаялись и последовали Твоим путем, и защити их от мучений в Аду.",["те, которые","несут","Трон","и те, кто","вокруг него","славят","хвалою","Господа своего","и веруют","в Него","и просят прощения","для тех, которые","уверовали","Господь наш","Ты объял","всякую","вещь","милостью","и знанием","так прости","тем, которые","покаялись","и последовали","путём Твоим","и защити их","(от) наказания","Ада"]]],"m":[[["وَتَرَى","и увидишь",39,75],["ٱلۡمَلَٰٓئِكَةَ","ангелов",39,75],["حَآفِّينَ","окружающих",39,75],["مِنۡ","(из)",39,75],["حَوۡلِ","вокруг",39,75],["ٱلۡعَرۡشِ","Трона",39,75],["يُسَبِّحُونَ","славя",39,75],["بِحَمۡدِ","хвалою",39,75]],[["رَبِّهِمۡۚ","Господа их",39,75],["وَقُضِيَ","и рассужено будет",39,75],["بَيۡنَهُم","между ними",39,75],["بِٱلۡحَقِّۚ","по истине",39,75],["وَقِيلَ","и сказано будет",39,75],["ٱلۡحَمۡدُ","хвала",39,75],["لِلَّهِ","Аллаху",39,75],["رَبِّ","Господу",39,75],["ٱلۡعَٰلَمِينَ","миров",39,75],[75]],["h",40],["b"],[["حمٓ","Ха Мим",40,1],[1],["تَنزِيلُ","ниспослание",40,2],["ٱلۡكِتَٰبِ","Писания",40,2],["مِنَ","от",40,2],["ٱللَّهِ","Аллаха",40,2],["ٱلۡعَزِيزِ","Могущественного",40,2],["ٱلۡعَلِيمِ","Знающего",40,2],[2],["غَافِرِ","Прощающего",40,3]],[["ٱلذَّنۢبِ","грех",40,3],["وَقَابِلِ","и Принимающего",40,3],["ٱلتَّوۡبِ","покаяние",40,3],["شَدِيدِ","Сурового",40,3],["ٱلۡعِقَابِ","(в) наказании",40,3],["ذِي","Обладателя",40,3],["ٱلطَّوۡلِۖ","милости",40,3],["لَآ","нет",40,3],["إِلَٰهَ","божества",40,3],["إِلَّا","кроме",40,3],["هُوَۖ","Него",40,3]],[["إِلَيۡهِ","к Нему",40,3],["ٱلۡمَصِيرُ","возвращение",40,3],[3],["مَا","не",40,4],["يُجَٰدِلُ","спорят",40,4],["فِيٓ","о",40,4],["ءَايَٰتِ","знамениях",40,4],["ٱللَّهِ","Аллаха",40,4],["إِلَّا","кроме",40,4],["ٱلَّذِينَ","тех, которые",40,4],["كَفَرُواْ","не уверовали",40,4]],[["فَلَا","так пусть не",40,4]