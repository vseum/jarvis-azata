{"p":468,"j":24,"a":[[40,8,["رَبَّنَا","وَأَدۡخِلۡهُمۡ","جَنَّٰتِ","عَدۡنٍ","ٱلَّتِي","وَعَدتَّهُمۡ","وَمَن","صَلَحَ","مِنۡ","ءَابَآئِهِمۡ","وَأَزۡوَٰجِهِمۡ","وَذُرِّيَّٰتِهِمۡۚ","إِنَّكَ","أَنتَ","ٱلۡعَزِيزُ","ٱلۡحَكِيمُ"],"раббана ва'адхилхум жаннати `аднинил латии ва`адттахум ваман салаха мин абаихим ва'азважихим вазурриййатихим иннака антал `азиизул хакиим","Господь наш! Введи их в сады Эдема, которые Ты обещал им, а также праведников из числа их отцов, супруг и потомков. Воистину, Ты - Могущественный, Мудрый.",["Господь наш","и введи их","(в) сады","Эдема","которые","Ты обещал им","и тех, кто","был праведен","из","отцов их","и супругов их","и потомков их","поистине Ты","Ты","Могущественный","Мудрый"]],[40,9,["وَقِهِمُ","ٱلسَّيِّـَٔاتِۚ","وَمَن","تَقِ","ٱلسَّيِّـَٔاتِ","يَوۡمَئِذٖ","فَقَدۡ","رَحِمۡتَهُۥۚ","وَذَٰلِكَ","هُوَ","ٱلۡفَوۡزُ","ٱلۡعَظِيمُ"],"ваḳихимус саййиати ваман таḳис саййиати йаумаизин фаḳад рахимтахуу вазалика хуал фаузул `азиим","Защити их от грехов, ведь только тот, кого Ты защитишь в тот день от грехов, будет помилован Тобой. Это и есть великое преуспеяние».",["и защити их","(от) зол","и кого","Ты защитишь","(от) зол","в тот день","то уже","Ты помиловал его","и это","оно","преуспеяние","великое"]],[40,10,["إِنَّ","ٱلَّذِينَ","كَفَرُواْ","يُنَادَوۡنَ","لَمَقۡتُ","ٱللَّهِ","أَكۡبَرُ","مِن","مَّقۡتِكُمۡ","أَنفُسَكُمۡ","إِذۡ","تُدۡعَوۡنَ","إِلَى","ٱلۡإِيمَٰنِ","فَتَكۡفُرُونَ"],"иннал лазиина кафаруу йунадауна ламаḳтуллахи акбару мим маḳтикум анфусакум из туд`ауна илал иимани фатакфуруун","Воистину, к неверующим воззовут: «Ненависть Аллаха к вам тогда, когда вас призывали к вере, а вы не веровали, была сильнее, чем ваша ненависть к самим себе».",["поистине","те, которые","не уверовали","к ним воззовут","непременно ненависть","Аллаха","сильнее","чем","ваша ненависть","к самим себе","когда","вас призывали","к","вере","а вы не веровали"]],[40,11,["قَالُواْ","رَبَّنَآ","أَمَتَّنَا","ٱثۡنَتَيۡنِ","وَأَحۡيَيۡتَنَا","ٱثۡنَتَيۡنِ","فَٱعۡتَرَفۡنَا","بِذُنُوبِنَا","فَهَلۡ","إِلَىٰ","خُرُوجٖ","مِّن","سَبِيلٖ"],"ḳалуу раббана аматтанаснатайни ва'ахйайтанаснатайни фа`тарафна бизунуубина фахал ила хуруужим мин сабиил","Они скажут: «Господь наш! По Твоей воле дважды мы были мертвы, и дважды Ты оживил нас. Мы признались в своих грехах. Нет ли пути к выходу?».",["скажут они","Господь наш","Ты умертвил нас","дважды","и Ты оживил нас","дважды","и признали мы","грехи наши","так есть ли","к","выходу","какой-либо","путь"]],[40,12,["ذَٰلِكُم","بِأَنَّهُۥٓ","إِذَا","دُعِيَ","ٱللَّهُ","وَحۡدَهُۥ","كَفَرۡتُمۡ","وَإِن","يُشۡرَكۡ","بِهِۦ","تُؤۡمِنُواْۚ","فَٱلۡحُكۡمُ","لِلَّهِ","ٱلۡعَلِيِّ","ٱلۡكَبِيرِ"],"заликум би'аннахуу иза ду`ийаллаху вахдахуу кафартум ва'ин йушрак бихии ту'минуу фалхукму лиллахил `алиййил кабиир","Это потому, что когда призывали одного Аллаха, вы не веровали. Если же к Нему приобщали сотоварищей, вы верили. Решение принимает только Аллах, Возвышенный, Большой».",["это","потому, что","когда","призывали","Аллаха","одного","вы не веровали","а если","придавали сотоварищей","Ему","вы веровали","решение же","у Аллаха","Возвышенного","Великого"]],[40,13,["هُوَ","ٱلَّذِي","يُرِيكُمۡ","ءَايَٰتِهِۦ","وَيُنَزِّلُ","لَكُم","مِّنَ","ٱلسَّمَآءِ","رِزۡقٗاۚ","وَمَا","يَتَذَكَّرُ","إِلَّا","مَن","يُنِيبُ"],"хуал лазии йуриикум айатихии вайуназзилу лакум минас самаи ризḳан вама йатазаккару илла ман йунииб","Он - Тот, Кто показывает вам Свои знамения и ниспосылает вам с неба удел, но поминают назидание только обращающиеся к Аллаху.",["Он","Тот, Кто","показывает вам","знамения Его","и ниспосылает","вам","с","неба","удел","и не","внемлет назиданию","кроме","того, кто","обращается"]],[40,14,["فَٱدۡعُواْ","ٱللَّهَ","مُخۡلِصِينَ","لَهُ","ٱلدِّينَ","وَلَوۡ","كَرِهَ","ٱلۡكَٰفِرُونَ"],"фад`уллаха мухлисиина лахуд диина валау карихал кафируун","Взывайте же к Аллаху, очищая перед Ним веру, даже если это ненавистно неверующим.",["так взывайте","(к) Аллаху","очищая","Ему","веру","даже если","не по нраву","неверующим"]],[40,15,["رَفِيعُ","ٱلدَّرَجَٰتِ","ذُو","ٱلۡعَرۡشِ","يُلۡقِي","ٱلرُّوحَ","مِنۡ","أَمۡرِهِۦ","عَلَىٰ","مَن","يَشَآءُ","مِنۡ","عِبَادِهِۦ","لِيُنذِرَ","يَوۡمَ","ٱلتَّلَاقِ"],"рафии`уд даражати зул `арши йулḳир рууха мин амрихии `ала ман йашау мин `ибадихии лийунзира йаумат талаḳ","Он обладает возвышенными качествами (или возвышает по степеням) и владеет Троном. Он ниспосылает дух (откровение) со Своими велениями тем из Своих рабов, кому пожелает, чтобы предупредить о Дне встречи.",["Высокий","степенями","Обладатель","Трона","Он ниспосылает","дух","из","повеления Его","на","того, кого","Он пожелает","из","рабов Его","чтобы предостеречь","(о) дне","встречи"]],[40,16,["يَوۡمَ","هُم","بَٰرِزُونَۖ","لَا","يَخۡفَىٰ","عَلَى","ٱللَّهِ","مِنۡهُمۡ","شَيۡءٞۚ","لِّمَنِ","ٱلۡمُلۡكُ","ٱلۡيَوۡمَۖ","لِلَّهِ","ٱلۡوَٰحِدِ","ٱلۡقَهَّارِ"],"йаума хум баризууна ла йахфа `алаллахи минхум шай'ул лиманил мулкул йаума лиллахил вахидил ḳаххар","В тот день, когда они появятся на поверхности земли после воскрешения, ничто о них не скроется от Аллаха. Кому же принадлежит власть сегодня? Аллаху, Единственному, Всемогущему.",["в день, когда","они","предстанут","не","скроется","от","Аллаха","о них","ничто","кому","власть","сегодня","Аллаху","Единому","Всепобеждающему"]]],"m":[[["رَبَّنَا","Господь наш",40,8],["وَأَدۡخِلۡهُمۡ","и введи их",40,8],["جَنَّٰتِ","(в) сады",40,8],["عَدۡنٍ","Эдема",40,8],["ٱلَّتِي","которые",40,8],["وَعَدتَّهُمۡ","Ты обещал им",40,8],["وَمَن","и тех, кто",40,8],["صَلَحَ","был праведен",40,8]],[["مِنۡ","из",40,8],["ءَابَآئِهِمۡ","отцов их",40,8],["وَأَزۡوَٰجِهِمۡ","и супругов их",40,8],["وَذُرِّيَّٰتِهِمۡۚ","и потомков их",40,8],["إِنَّكَ","поистине Ты",40,8],["أَنتَ","Ты",40,8],["ٱلۡعَزِيزُ","Могущественный",40,8]],[["ٱلۡحَكِيمُ","Мудрый",40,8],[8],["وَقِهِمُ","и защити их",40,9],["ٱلسَّيِّـَٔاتِۚ","(от) зол",40,9],["وَمَن","и кого",40,9],["تَقِ","Ты защитишь",40,9],["ٱلسَّيِّـَٔاتِ","(от) зол",40,9]],[["يَوۡمَئِذٖ","в тот день",40,9],["فَقَدۡ","то уже",40,9],["رَحِمۡتَهُۥۚ","Ты помиловал его",40,9],["وَذَٰلِكَ","и это",40,9],["هُوَ","оно",40,9],["ٱلۡفَوۡزُ","преуспеяние",40,9],["ٱلۡعَظِيمُ","великое",40,9],[9],["إِنَّ","поистине",40,10]],[["ٱلَّذِينَ","те, которые",40,10],["كَفَرُواْ","не уверовали",40,10],["يُنَادَوۡنَ","к ним воззовут",40,10],["لَمَقۡتُ","непременно ненависть",40,10],["ٱللَّهِ","Аллаха",40,10],["أَكۡبَرُ","сильнее",40,10],["مِن","чем",40,10],["مَّقۡتِكُمۡ","ваша ненависть",40,10]],[["أَنفُسَكُمۡ","к самим себе",40,10],["إِذۡ","когда",40,10],["تُدۡعَوۡنَ","вас призывали",40,10],["إِلَى","к",40,10],["ٱلۡإِيمَٰنِ","вере",40,10],["فَتَكۡفُرُونَ","а вы не веровали",40,10],[10]],[["قَالُواْ","скажут они",40,11],["رَبَّنَآ","Господь наш",40,11],["أَمَتَّنَا","Ты умертвил нас",40,11],["ٱثۡنَتَيۡنِ","дважды",40,11],["وَأَحۡيَيۡتَنَا","и Ты оживил нас",40,11],["ٱثۡنَتَيۡنِ","дважды",40,11],["فَٱعۡتَرَفۡنَا","и признали мы",40,11],["بِذُنُوبِنَا","грехи наши",40,11]],[["فَهَلۡ","так есть ли",40,11],["إِلَىٰ","к",40,11],["خُرُوجٖ","выходу",40,11],["مِّن","какой-либо",40,11],["سَبِيلٖ","путь",40,11],[11],["ذَٰلِكُم","это",40,12],["بِأَنَّهُۥٓ","потому, что",40,12],["إِذَا","когда",40,12],["دُعِيَ","призывали",40,12]],[["ٱللَّهُ","Аллаха",40,12],["وَحۡدَهُۥ","одного",40,12],["كَفَرۡتُمۡ","вы не веровали",40,12],["وَإِن","а если",40,12],["يُشۡرَكۡ","придавали сотоварищей",40,12],["بِهِۦ","Ему",40,12],["تُؤۡمِنُواْۚ","вы веровали",40,12],["فَٱلۡحُكۡمُ","решение же",40,12],["لِلَّهِ","у Аллаха",40,12]],[["ٱلۡعَلِيِّ","Возвышенного",40,12],["ٱلۡكَبِيرِ","Великого",40,12],[12],["هُوَ","Он",40,13],["ٱلَّذِي","Тот, Кто",40,13],["يُرِيكُمۡ","показывает вам",40,13],["ءَايَٰتِهِۦ","знамения Его",40,13],["وَيُنَزِّلُ","и ниспосылает",40,13]],[["لَكُم","вам",40,13],["مِّنَ","с",40,13],["ٱلسَّمَآءِ","неба",40,13],["رِزۡقٗاۚ","удел",40,13],["وَمَا","и не",40,13],["يَتَذَكَّرُ","внемлет назиданию",40,13],["إِلَّا","кроме",40,13],["مَن","того, кто",40,13],["يُنِيبُ","обращается",40,13],[13]],[["فَٱدۡعُواْ","так взывайте",40,14],["ٱللَّهَ","(к) Аллаху",40,14],["مُخۡ