{"p":469,"j":24,"a":[[40,17,["ٱلۡيَوۡمَ","تُجۡزَىٰ","كُلُّ","نَفۡسِۭ","بِمَا","كَسَبَتۡۚ","لَا","ظُلۡمَ","ٱلۡيَوۡمَۚ","إِنَّ","ٱللَّهَ","سَرِيعُ","ٱلۡحِسَابِ"],"алйаума тужза куллу нафси бима касабат ла зулмал йаума инналлаха сарии`ул хисаб","Сегодня каждая душа получит только то, что она приобрела, и не будет сегодня несправедливости. Воистину, Аллах скор в расчете!",["сегодня","будет воздано","каждой","душе","за то, что","она приобрела","нет","несправедливости","сегодня","поистине","Аллах","скор","в расчёте"]],[40,18,["وَأَنذِرۡهُمۡ","يَوۡمَ","ٱلۡأٓزِفَةِ","إِذِ","ٱلۡقُلُوبُ","لَدَى","ٱلۡحَنَاجِرِ","كَٰظِمِينَۚ","مَا","لِلظَّٰلِمِينَ","مِنۡ","حَمِيمٖ","وَلَا","شَفِيعٖ","يُطَاعُ"],"ва'анзирхум йаумал азифати изил ḳулуубу ладал ханажири казимиина ма лиззалимиина мин хамиимин вала шафии`ин йута`","Предупреди их о приближающемся дне, когда сердца подступят к горлу, и они будут опечалены. Не будет у беззаконников ни любящего родственника, ни заступника, которому подчиняются.",["и предостереги их","о дне","приближающегося","когда","сердца","у","гортаней","сдавленные","нет","у беззаконников","никакого","близкого друга","и ни","заступника","которому повинуются"]],[40,19,["يَعۡلَمُ","خَآئِنَةَ","ٱلۡأَعۡيُنِ","وَمَا","تُخۡفِي","ٱلصُّدُورُ"],"йа`ламу хаинатал а`йуни вама тухфис судуур","Он знает о предательском взгляде и том, что скрывают груди.",["знает","предательство","глаз","и то, что","скрывают","груди"]],[40,20,["وَٱللَّهُ","يَقۡضِي","بِٱلۡحَقِّۖ","وَٱلَّذِينَ","يَدۡعُونَ","مِن","دُونِهِۦ","لَا","يَقۡضُونَ","بِشَيۡءٍۗ","إِنَّ","ٱللَّهَ","هُوَ","ٱلسَّمِيعُ","ٱلۡبَصِيرُ"],"валлаху йаḳдии билхаḳḳи валлазиина йад`ууна мин дуунихии ла йаḳдууна бишай'ин инналлаха хуас самии`ул басиир","Аллах решает по справедливости, а те, которых призывают вместо Него, не решают ничего. Воистину, Аллах - Слышащий, Видящий.",["и Аллах","решает","по истине","а те, которых","они призывают","помимо","Него","не","решают они","ничего","поистине","Аллах","Он","Слышащий","Видящий"]],[40,21,["أَوَلَمۡ","يَسِيرُواْ","فِي","ٱلۡأَرۡضِ","فَيَنظُرُواْ","كَيۡفَ","كَانَ","عَٰقِبَةُ","ٱلَّذِينَ","كَانُواْ","مِن","قَبۡلِهِمۡۚ","كَانُواْ","هُمۡ","أَشَدَّ","مِنۡهُمۡ","قُوَّةٗ","وَءَاثَارٗا","فِي","ٱلۡأَرۡضِ","فَأَخَذَهُمُ","ٱللَّهُ","بِذُنُوبِهِمۡ","وَمَا","كَانَ","لَهُم","مِّنَ","ٱللَّهِ","مِن","وَاقٖ"],"авалам йасиируу фил арди файанзуруу кайфа кана `аḳибатул лазиина кануу мин ḳаблихим кануу хум ашадда минхум ḳувватан ва'асаран фил арди фа'ахазахумуллаху бизунуубихим вама кана лахум миналлахи мин ваḳ","Разве они не странствовали по земле и не видели, каким был конец их предшественников? А ведь они превосходили их силой и оставили больше следов на земле, но Аллах схватил их за их грехи, и никто не защитил их от Аллаха.",["разве не","странствовали они","по","земле","и не видели","каким","был","конец","тех, которые","были","до","них","были","они","сильнее","их","мощью","и следами","на","земле","и схватил их","Аллах","за их грехи","и не","было","у них","от","Аллаха","никакого","защитника"]],[40,22,["ذَٰلِكَ","بِأَنَّهُمۡ","كَانَت","تَّأۡتِيهِمۡ","رُسُلُهُم","بِٱلۡبَيِّنَٰتِ","فَكَفَرُواْ","فَأَخَذَهُمُ","ٱللَّهُۚ","إِنَّهُۥ","قَوِيّٞ","شَدِيدُ","ٱلۡعِقَابِ"],"залика би'аннахум канат та'тиихим русулухум билбаййинати факафаруу фа'ахазахумуллаху иннахуу ḳавиййун шадиидул `иḳаб","Это произошло потому, что они не веровали, когда их посланники приходили к ним с ясными знамениями. Аллах схватил их, ведь Он - Всесильный, Суровый в наказании.",["это","потому что они","приходили","к ним","их посланники","с ясными знамениями","но они не уверовали","и схватил их","Аллах","поистине, Он","Сильный","суров","в наказании"]],[40,23,["وَلَقَدۡ","أَرۡسَلۡنَا","مُوسَىٰ","بِـَٔايَٰتِنَا","وَسُلۡطَٰنٖ","مُّبِينٍ"],"валаḳад арсална мууса би'айатина васултаним мубиин","Мы послали Мусу (Моисея) с Нашими знамениями и ясным доказательством",["и уже","Мы послали","Мусу","с Нашими знамениями","и доводом","ясным"]],[40,24,["إِلَىٰ","فِرۡعَوۡنَ","وَهَٰمَٰنَ","وَقَٰرُونَ","فَقَالُواْ","سَٰحِرٞ","كَذَّابٞ"],"ила фир`ауна вахамана ваḳарууна фаḳалуу сахирун каззаб","к Фараону, Хаману и Каруну (Корею). Они сказали: «Он - лживый колдун!».",["к","Фараону","и Хаману","и Каруну","и они сказали","колдун","лжец"]],[40,25,["فَلَمَّا","جَآءَهُم","بِٱلۡحَقِّ","مِنۡ","عِندِنَا","قَالُواْ","ٱقۡتُلُوٓاْ","أَبۡنَآءَ","ٱلَّذِينَ","ءَامَنُواْ","مَعَهُۥ","وَٱسۡتَحۡيُواْ","نِسَآءَهُمۡۚ","وَمَا","كَيۡدُ","ٱلۡكَٰفِرِينَ","إِلَّا","فِي","ضَلَٰلٖ"],"фаламма жаахум билхаḳḳи мин `индина ḳалуḳтулуу абнаал лазиина амануу ма`ахуу вастахйуу нисаахум вама кайдул кафириина илла фии далал","Когда он принес им истину от Нас, они сказали: «Убивайте сыновей тех, кто уверовал вместе с ним, и оставляйте в живых их женщин!». Но козни неверующих безуспешны.",["и когда","он пришёл к ним","с истиной","от","Нас","они сказали","убивайте","сыновей","тех, которые","уверовали","с ним","и оставляйте в живых","их женщин","и не","хитрость","неверующих","кроме как","в","заблуждении"]]],"m":[[["ٱلۡيَوۡمَ","сегодня",40,17],["تُجۡزَىٰ","будет воздано",40,17],["كُلُّ","каждой",40,17],["نَفۡسِۭ","душе",40,17],["بِمَا","за то, что",40,17],["كَسَبَتۡۚ","она приобрела",40,17],["لَا","нет",40,17],["ظُلۡمَ","несправедливости",40,17],["ٱلۡيَوۡمَۚ","сегодня",40,17],["إِنَّ","поистине",40,17]],[["ٱللَّهَ","Аллах",40,17],["سَرِيعُ","скор",40,17],["ٱلۡحِسَابِ","в расчёте",40,17],[17],["وَأَنذِرۡهُمۡ","и предостереги их",40,18],["يَوۡمَ","о дне",40,18],["ٱلۡأٓزِفَةِ","приближающегося",40,18],["إِذِ","когда",40,18],["ٱلۡقُلُوبُ","сердца",40,18]],[["لَدَى","у",40,18],["ٱلۡحَنَاجِرِ","гортаней",40,18],["كَٰظِمِينَۚ","сдавленные",40,18],["مَا","нет",40,18],["لِلظَّٰلِمِينَ","у беззаконников",40,18],["مِنۡ","никакого",40,18],["حَمِيمٖ","близкого друга",40,18],["وَلَا","и ни",40,18],["شَفِيعٖ","заступника",40,18]],[["يُطَاعُ","которому повинуются",40,18],[18],["يَعۡلَمُ","знает",40,19],["خَآئِنَةَ","предательство",40,19],["ٱلۡأَعۡيُنِ","глаз",40,19],["وَمَا","и то, что",40,19],["تُخۡفِي","скрывают",40,19],["ٱلصُّدُورُ","груди",40,19],[19]],[["وَٱللَّهُ","и Аллах",40,20],["يَقۡضِي","решает",40,20],["بِٱلۡحَقِّۖ","по истине",40,20],["وَٱلَّذِينَ","а те, которых",40,20],["يَدۡعُونَ","они призывают",40,20],["مِن","помимо",40,20],["دُونِهِۦ","Него",40,20],["لَا","не",40,20],["يَقۡضُونَ","решают они",40,20]],[["بِشَيۡءٍۗ","ничего",40,20],["إِنَّ","поистине",40,20],["ٱللَّهَ","Аллах",40,20],["هُوَ","Он",40,20],["ٱلسَّمِيعُ","Слышащий",40,20],["ٱلۡبَصِيرُ","Видящий",40,20],[20],["۞ أَوَلَمۡ","разве не",40,21],["يَسِيرُواْ","странствовали они",40,21],["فِي","по",40,21]],[["ٱلۡأَرۡضِ","земле",40,21],["فَيَنظُرُواْ","и не видели",40,21],["كَيۡفَ","каким",40,21],["كَانَ","был",40,21],["عَٰقِبَةُ","конец",40,21],["ٱلَّذِينَ","тех, которые",40,21],["كَانُواْ","были",40,21],["مِن","до",40,21],["قَبۡلِهِمۡۚ","них",40,21]],[["كَانُواْ","были",40,21],["هُمۡ","они",40,21],["أَشَدَّ","сильнее",40,21],["مِنۡهُمۡ","их",40,21],["قُوَّةٗ","мощью",40,21],["وَءَاثَارٗا","и следами",40,21],["فِي","на",40,21],["ٱلۡأَرۡضِ","земле",40,21],["فَأَخَذَهُمُ","и схватил их",40,21],["ٱللَّهُ","Аллах",40,21]],[["بِذُنُوبِهِمۡ","за их грехи",40,21],["وَمَا","и не",40,21],["كَانَ","было",40,21],["لَهُم","у них",40,21],["مِّنَ","от",40,21],["ٱللَّهِ","Аллаха",40,21],["مِن","никакого",40,21],["وَاقٖ","защитника",40,21],[21],["ذَٰلِكَ","это",40,22],["بِأَنَّهُمۡ","потому что они",40,22]],[["كَانَت","приходили",40,22],["تَّأۡتِيهِمۡ","к ним",40,22],["رُسُلُهُم","их посланники",40,22],["بِٱلۡبَيِّنَٰتِ","с ясными знамениями",40,22],["فَكَفَرُواْ","но они не уверовали",40,22],["فَأَخَذَهُمُ","и схватил их",40,22],["ٱللَّهُۚ","Аллах",40,22],["إِنَّهُۥ","поистине, Он",40,22]],[["قَوِيّٞ","Сильный",40,22],["شَدِيدُ","суров",40,22],["ٱلۡعِقَابِ","в наказании",40,22],[22],["وَلَقَدۡ","и уже",40,23],["أَرۡسَلۡنَا","Мы послали",40,23],["مُوسَىٰ","Мусу",40,23],["بِـَٔايَٰتِنَا","с Нашими знамениями",40,23]],[["وَسُلۡطَٰنٖ","и доводом",40,23],["مُّبِينٍ","ясным",40,23],[23],["إِلَىٰ","к",40,24],["فِرۡعَوۡنَ","Фараону",40,24],["وَهَٰمَٰنَ","и Хаману",40,24],["وَقَٰرُونَ","и Каруну",40,24]],[["فَقَالُواْ","и они сказали",40,24],["سَٰحِرٞ","колдун",40,24],["كَذَّابٞ","лжец",40,24],[24],["فَلَمَّا","и когда",40,25],["جَآءَهُم","он пришёл к ним",40,25],["بِٱلۡحَقِّ","с истиной",40,25],["مِنۡ","от",40,25]],[["عِندِنَا","Нас",40,25],["قَالُواْ","они сказали",40,25],["ٱقۡتُلُوٓاْ","убивайте",40,25],["أَبۡنَآءَ","сыновей",40,25],["ٱلَّذِينَ","тех, которые",40,25],["ءَامَنُواْ","уверовали",40,25],["مَعَهُۥ","с ним",40,25],["وَٱسۡتَحۡيُواْ","и оставляйте в живых",40,25]],[["نِسَآءَهُمۡۚ","их женщин",40,25],["وَمَا","и не",40,25],["كَيۡدُ","хитрость",40,25],["ٱلۡكَٰفِرِينَ","неверующих",40,25],["إِلَّا","кроме как",40,25],["فِي","в",40,25],["ضَلَٰلٖ","заблуждении",40,25],[25]]]}