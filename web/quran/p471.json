{"p":471,"j":24,"a":[[40,34,["وَلَقَدۡ","جَآءَكُمۡ","يُوسُفُ","مِن","قَبۡلُ","بِٱلۡبَيِّنَٰتِ","فَمَا","زِلۡتُمۡ","فِي","شَكّٖ","مِّمَّا","جَآءَكُم","بِهِۦۖ","حَتَّىٰٓ","إِذَا","هَلَكَ","قُلۡتُمۡ","لَن","يَبۡعَثَ","ٱللَّهُ","مِنۢ","بَعۡدِهِۦ","رَسُولٗاۚ","كَذَٰلِكَ","يُضِلُّ","ٱللَّهُ","مَنۡ","هُوَ","مُسۡرِفٞ","مُّرۡتَابٌ"],"валаḳад жаакум йуусуфу мин ḳаблу билбаййинати фама зилтум фии шакким мимма жаакум бихии хатта иза халака ḳултум лан йаб`асаллаху мим ба`дихии расуулан казалика йудиллуллаху ман хуа мусрифум муртаб","Прежде к вам явился с ясными знамениями Йусуф (Иосиф), но вы до сих пор сомневаетесь в том, что он вам принес. Когда же он умер, вы сказали: «Аллах не отправит посланника после него». Так Аллах вводит в заблуждение того, кто излишествует и сомневается».",["и уже","приходил к вам","Йусуф","до","этого","с ясными знамениями","но не","переставали вы","в","сомнении","о том, что","он пришёл к вам","с ним","пока","когда","он умер","вы сказали","никогда не","пошлёт","Аллах","после","него","посланника","так","вводит в заблуждение","Аллах","того, кто","он","излишествующий","сомневающийся"]],[40,35,["ٱلَّذِينَ","يُجَٰدِلُونَ","فِيٓ","ءَايَٰتِ","ٱللَّهِ","بِغَيۡرِ","سُلۡطَٰنٍ","أَتَىٰهُمۡۖ","كَبُرَ","مَقۡتًا","عِندَ","ٱللَّهِ","وَعِندَ","ٱلَّذِينَ","ءَامَنُواْۚ","كَذَٰلِكَ","يَطۡبَعُ","ٱللَّهُ","عَلَىٰ","كُلِّ","قَلۡبِ","مُتَكَبِّرٖ","جَبَّارٖ"],"аллазиина йужадилууна фии айатиллахи бигайри султанин атахум кабура маḳтан `индаллахи ва`индал лазиина амануу казалика йатба`уллаху `ала кулли ḳалби мутакаббирин жаббар","Препирательство тех, которые оспаривают знамения Аллаха без всякого довода, явившегося к ним, весьма ненавистно Аллаху и верующим. Так Аллах накладывает печать на сердце каждого возгордившегося тирана.",["те, которые","препираются","о","знамениях","Аллаха","без","довода","пришедшего к ним","велико","ненавистью","у","Аллаха","и у","тех, которые","уверовали","так","налагает печать","Аллах","на","всякое","сердце","высокомерного","тирана"]],[40,36,["وَقَالَ","فِرۡعَوۡنُ","يَٰهَٰمَٰنُ","ٱبۡنِ","لِي","صَرۡحٗا","لَّعَلِّيٓ","أَبۡلُغُ","ٱلۡأَسۡبَٰبَ"],"ваḳала фир`ауну йахаманубни лии сархал ла`аллии аблугул асбаб","Фараон сказал: «О Хаман! Построй для меня башню. Быть может, я достигну путей,",["и сказал","Фараон","о Хаман","построй","для меня","башню","быть может, я","достигну","путей"]],[40,37,["أَسۡبَٰبَ","ٱلسَّمَٰوَٰتِ","فَأَطَّلِعَ","إِلَىٰٓ","إِلَٰهِ","مُوسَىٰ","وَإِنِّي","لَأَظُنُّهُۥ","كَٰذِبٗاۚ","وَكَذَٰلِكَ","زُيِّنَ","لِفِرۡعَوۡنَ","سُوٓءُ","عَمَلِهِۦ","وَصُدَّ","عَنِ","ٱلسَّبِيلِۚ","وَمَا","كَيۡدُ","فِرۡعَوۡنَ","إِلَّا","فِي","تَبَابٖ"],"асбабас самавати фа'аттали`а ила илахи мууса ва'иннии ла'азуннухуу казибан ваказалика зуййина лифир`ауна су'уу `амалихии васудда `анис сабиили вама кайду фир`ауна илла фии табаб","путей небесных, и взгляну на Бога Мусы (Моисея). Воистину, я считаю его лжецом». Вот так Фараону представилось прекрасным зло его деяний, и он был сбит с пути. А козни Фараона оказались безуспешными.",["путей","небес","и взгляну","на","Бога","Мусы","и поистине, я","непременно считаю его","лжецом","и так","было разукрашено","Фараону","зло","его деяния","и он был отвращён","от","пути","и не","хитрость","Фараона","кроме как","в","гибели"]],[40,38,["وَقَالَ","ٱلَّذِيٓ","ءَامَنَ","يَٰقَوۡمِ","ٱتَّبِعُونِ","أَهۡدِكُمۡ","سَبِيلَ","ٱلرَّشَادِ"],"ваḳалал лазии амана йаḳаумиттаби`ууни ахдикум сабиилар рашад","Тот, кто уверовал, сказал: «О мой народ! Последуйте за мной, и я поведу вас правильным путем.",["и сказал","тот, который","уверовал","о мой народ","последуйте за мной","я поведу вас","путём","правильным"]],[40,39,["يَٰقَوۡمِ","إِنَّمَا","هَٰذِهِ","ٱلۡحَيَوٰةُ","ٱلدُّنۡيَا","مَتَٰعٞ","وَإِنَّ","ٱلۡأٓخِرَةَ","هِيَ","دَارُ","ٱلۡقَرَارِ"],"йаḳауми иннама хазихил хайаватуд дунйа мата`ун ва'иннал ахирата хийа дарул ḳарар","О мой народ! Мирская жизнь - не что иное, как предмет пользования, а Последняя жизнь является Обителью пребывания.",["о мой народ","лишь","эта","жизнь","ближняя","пользование","а поистине"