{"p":472,"j":24,"a":[[40,41,["وَيَٰقَوۡمِ","مَا","لِيٓ","أَدۡعُوكُمۡ","إِلَى","ٱلنَّجَوٰةِ","وَتَدۡعُونَنِيٓ","إِلَى","ٱلنَّارِ"],"вайаḳауми ма лии ад`уукум илан нажавати ватад`уунании илан нар","О мой народ! Почему я зову вас к спасению, а вы зовете меня в Огонь?",["и о мой народ","что","со мной","зову я вас","к","спасению","а вы зовёте меня","к","Огню"]],[40,42,["تَدۡعُونَنِي","لِأَكۡفُرَ","بِٱللَّهِ","وَأُشۡرِكَ","بِهِۦ","مَا","لَيۡسَ","لِي","بِهِۦ","عِلۡمٞ","وَأَنَا۠","أَدۡعُوكُمۡ","إِلَى","ٱلۡعَزِيزِ","ٱلۡغَفَّٰرِ"],"тад`уунании ли'акфура биллахи ва'ушрика бихии ма лайса лии бихии `илмун ва'ана ад`уукум илал `азиизил гаффар","Вы призываете меня не веровать в Аллаха и приобщать к Нему в сотоварищи то, о чем у меня нет знания. Я же призываю вас к Могущественному, Всепрощающему.",["вы зовёте меня","чтобы я не веровал","в Аллаха","и приобщал","к Нему","то, о чём","нет","у меня","о нём","знания","а я","зову вас","к","Могущественному","Всепрощающему"]],[40,43,["لَا","جَرَمَ","أَنَّمَا","تَدۡعُونَنِيٓ","إِلَيۡهِ","لَيۡسَ","لَهُۥ","دَعۡوَةٞ","فِي","ٱلدُّنۡيَا","وَلَا","فِي","ٱلۡأٓخِرَةِ","وَأَنَّ","مَرَدَّنَآ","إِلَى","ٱللَّهِ","وَأَنَّ","ٱلۡمُسۡرِفِينَ","هُمۡ","أَصۡحَٰبُ","ٱلنَّارِ"],"ла жарама аннама тад`уунании илайхи лайса лахуу да`ватун фид дунйа вала фил ахирати ва'анна мараддана илаллахи ва'аннал мусрифиина хум асхабун нар","Нет сомнения в том, что то, к чему вы меня призываете, не заслуживает молитв ни в этом мире, ни в Последней жизни, и что нам предстоит вернуться к Аллаху, и что излишествующие окажутся обитателями Огня.",["нет","сомнения","что то, что","вы зовёте меня","к нему","нет","у него","права на призыв","в","этом мире","и не","в","Последней жизни","и что","наше возвращение","к","Аллаху","и что","излишествующие","они","обитатели","Огня"]],[40,44,["فَسَتَذۡكُرُونَ","مَآ","أَقُولُ","لَكُمۡۚ","وَأُفَوِّضُ","أَمۡرِيٓ","إِلَى","ٱللَّهِۚ","إِنَّ","ٱللَّهَ","بَصِيرُۢ","بِٱلۡعِبَادِ"],"фасатазкурууна ма аḳуулу лакум ва'уфаввиду амрии илаллахи инналлаха басииру бил`ибад","Вы вспомните то, о чем я вам говорю. Я вверяю свое дело Аллаху. Воистину, Аллах видит рабов».",["и вы вспомните","то, что","я говорю","вам","и я вверяю","своё дело","к","Аллаху","поистине","Аллах","видит","рабов"]],[40,45,["فَوَقَىٰهُ","ٱللَّهُ","سَيِّـَٔاتِ","مَا","مَكَرُواْۖ","وَحَاقَ","بِـَٔالِ","فِرۡعَوۡنَ","سُوٓءُ","ٱلۡعَذَابِ"],"фаваḳахуллаху саййиати ма макаруу вахаḳа би'али фир`ауна суул `азаб","Аллах защитил его от зла того, что они замыслили, а род Фараона окружили (или поразили) скверные мучения -",["и уберёг его","Аллах","от зол","того, что","они замыслили","и окружило","род","Фараона","злое","наказание"]],[40,46,["ٱلنَّارُ","يُعۡرَضُونَ","عَلَيۡهَا","غُدُوّٗا","وَعَشِيّٗاۚ","وَيَوۡمَ","تَقُومُ","ٱلسَّاعَةُ","أَدۡخِلُوٓاْ","ءَالَ","فِرۡعَوۡنَ","أَشَدَّ","ٱلۡعَذَابِ"],"аннару йу`радууна `алайха гудувван ва`ашиййан вайаума таḳуумус са`ату адхилуу ала фир`ауна ашаддал `азаб","Огонь, в который их ввергают утром и после полудня. А в День наступления Часа подвергните род Фараона самым жестоким мучениям!",["Огонь","их представляют","ему","утром","и вечером","а в день","наступит","Час","введите","род","Фараона","в самое тяжкое","наказание"]],[40,47,["وَإِذۡ","يَتَحَآجُّونَ","فِي","ٱلنَّارِ","فَيَقُولُ","ٱلضُّعَفَٰٓؤُاْ","لِلَّذِينَ","ٱسۡتَكۡبَرُوٓاْ","إِنَّا","كُنَّا","لَكُمۡ","تَبَعٗا","فَهَلۡ","أَنتُم","مُّغۡنُونَ","عَنَّا","نَصِيبٗا","مِّنَ","ٱلنَّارِ"],"ва'из йатахажжууна фин нари файаḳуулуд ду`афау лиллазиинастакбаруу инна кунна лакум таба`ан фахал антум мугнууна `анна насиибам минан нар","Когда они будут препираться друг с другом в Огне, слабые скажут тем, которые превозносились: «Мы следовали за вами. Не избавите ли вы нас от доли Огня?».",["и вот","препираются они","в","Огне","и скажут","слабые","тем, которые","превозносились","поистине, мы","были","для вас","последователями","так разве","вы","избавите","от нас","долю","из","Огня"]],[40,48,["قَالَ","ٱلَّذِينَ","ٱسۡتَكۡبَرُوٓاْ","إِنَّا","كُلّٞ","فِيهَآ","إِنَّ","ٱللَّهَ","قَدۡ","حَكَمَ","بَيۡنَ","ٱلۡعِبَادِ"],"ḳалал лазиинастакбаруу инна куллун фииха инналлаха ḳад хакама байнал `ибад","Те, которые превозносились, скажут: «Все мы - в нем. Воистину, Аллах уже рассудил между рабами».",["сказали","те, которые","превозносились","поистине, мы","все","в нём","поистине","Аллах","уже","рассудил","между","рабами"]],[40,49,["وَقَالَ","ٱلَّذِينَ","فِي","ٱلنَّارِ","لِخَزَنَةِ","جَهَنَّمَ","ٱدۡعُواْ","رَبَّكُمۡ","يُخَفِّفۡ","عَنَّا","يَوۡمٗا","مِّنَ","ٱلۡعَذَابِ"],"ваḳалал лазиина фин нари лихазанати жаханнамад`уу раббакум йухаффиф `анна йаумам минал `азаб","Те, которые попали в Огонь, скажут стражам Геенны: «Помолитесь вашему Господа, пусть Он облегчит наши мучения хотя бы на день».",["и сказали","те, которые","в","Огне","стражам","Геенны","взмолитесь","вашему Господу","пусть облегчит","нам","на день","из","наказания"]]],"m":[[["۞ وَيَٰقَوۡمِ","и о мой народ",40,41],["مَا","что",40,41],["لِيٓ","со мной",40,41],["أَدۡعُوكُمۡ","зову я вас",40,41],["إِلَى","к",40,41],["ٱلنَّجَوٰةِ","спасению",40,41],["وَتَدۡعُونَنِيٓ","а вы зовёте меня",40,41],["إِلَى","к",40,41]],[["ٱلنَّارِ","Огню",40,41],[41],["تَدۡعُونَنِي","вы зовёте меня",40,42],["لِأَكۡفُرَ","чтобы я не веровал",40,42],["بِٱللَّهِ","в Аллаха",40,42],["وَأُشۡرِكَ","и приобщал",40,42],["بِهِۦ","к Нему",40,42],["مَا","то, о чём",40,42],["لَيۡسَ","нет",40,42]],[["لِي","у меня",40,42],["بِهِۦ","о нём",40,42],["عِلۡمٞ","знания",40,42],["وَأَنَا۠","а я",40,42],["أَدۡعُوكُمۡ","зову вас",40,42],["إِلَى","к",40,42],["ٱلۡعَزِيزِ","Могущественному",40,42],["ٱلۡغَفَّٰرِ","Всепрощающему",40,42],[42],["لَا","нет",40,43],["جَرَمَ","сомнения",40,43]],[["أَنَّمَا","что то, что",40,43],["تَدۡعُونَنِيٓ","вы зовёте меня",40,43],["إِلَيۡهِ","к нему",40,43],["لَيۡسَ","нет",40,43],["لَهُۥ","у него",40,43],["دَعۡوَةٞ","права на призыв",40,43],["فِي","в",40,43],["ٱلدُّنۡيَا","этом мире",40,43],["وَلَا","и не",40,43],["فِي","в",40,43],["ٱلۡأٓخِرَةِ","Последней жизни",40,43]],[["وَأَنَّ","и что",40,43],["مَرَدَّنَآ","наше возвращение"