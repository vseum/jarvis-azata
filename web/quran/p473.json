{"p":473,"j":24,"a":[[40,50,["قَالُوٓاْ","أَوَلَمۡ","تَكُ","تَأۡتِيكُمۡ","رُسُلُكُم","بِٱلۡبَيِّنَٰتِۖ","قَالُواْ","بَلَىٰۚ","قَالُواْ","فَٱدۡعُواْۗ","وَمَا","دُعَٰٓؤُاْ","ٱلۡكَٰفِرِينَ","إِلَّا","فِي","ضَلَٰلٍ"],"ḳалуу авалам таку та'тиикум русулукум билбаййинати ḳалуу бала ḳалуу фад`уу вама ду`аул кафириина илла фии далал","Они скажут: «Разве ваши посланники не приходили к вам с ясными знамениями?». Они ответят: «Конечно». Они скажут: «Тогда молите сами». Но мольбы неверующих безуспешны.",["они сказали","разве не","были","приходили к вам","ваши посланники","с ясными знамениями","они сказали","да","они сказали","так взывайте","и не","мольба","неверующих","кроме как","в","заблуждении"]],[40,51,["إِنَّا","لَنَنصُرُ","رُسُلَنَا","وَٱلَّذِينَ","ءَامَنُواْ","فِي","ٱلۡحَيَوٰةِ","ٱلدُّنۡيَا","وَيَوۡمَ","يَقُومُ","ٱلۡأَشۡهَٰدُ"],"инна ланансуру русулана валлазиина амануу фил хайаватид дунйа вайаума йаḳуумул ашхад","Воистину, Мы окажем помощь Нашим посланникам и верующим в мирской жизни и в тот день, когда предстанут свидетели.",["поистине, Мы","непременно поможем","Нашим посланникам","и тем, которые","уверовали","в","жизни","ближней","и в день","встанут","свидетели"]],[40,52,["يَوۡمَ","لَا","يَنفَعُ","ٱلظَّٰلِمِينَ","مَعۡذِرَتُهُمۡۖ","وَلَهُمُ","ٱللَّعۡنَةُ","وَلَهُمۡ","سُوٓءُ","ٱلدَّارِ"],"йаума ла йанфа`уз залимиина ма`зиратухум валахумул ла`нату валахум сууд дар","В тот день извинения (или оправдания) не помогут беззаконникам. На них лежит проклятие, и им уготована Скверная обитель.",["в день","не","поможет","беззаконникам","их оправдание","и им","проклятие","и им","злая","обитель"]],[40,53,["وَلَقَدۡ","ءَاتَيۡنَا","مُوسَى","ٱلۡهُدَىٰ","وَأَوۡرَثۡنَا","بَنِيٓ","إِسۡرَٰٓءِيلَ","ٱلۡكِتَٰبَ"],"валаḳад атайна муусал худа ва'аурасна бании исраиилал китаб","Мы даровали Мусе (Моисею) верное руководство и дали в наследство сынам Исраила (Израиля) Писание",["и уже","Мы даровали","Мусе","руководство","и Мы дали в наследство","сынам","Исраила","Писание"]],[40,54,["هُدٗى","وَذِكۡرَىٰ","لِأُوْلِي","ٱلۡأَلۡبَٰبِ"],"худан вазикра ли'улил албаб","как верное руководство и напоминание для обладающих разумом.",["руководством","и напоминанием","для обладающих","разумом"]],[40,55,["فَٱصۡبِرۡ","إِنَّ","وَعۡدَ","ٱللَّهِ","حَقّٞ","وَٱسۡتَغۡفِرۡ","لِذَنۢبِكَ","وَسَبِّحۡ","بِحَمۡدِ","رَبِّكَ","بِٱلۡعَشِيِّ","وَٱلۡإِبۡكَٰرِ"],"фасбир инна ва`даллахи хаḳḳун вастагфир лизамбика васаббих бихамди раббика бил`ашиййи вал'ибкар","Будь же терпелив, ибо обещание Аллаха истинно. Проси прощения за свой грех и прославляй хвалой своего Господа после полудня и утром.",["так терпи","поистине","обещание","Аллаха","истинно","и проси прощения","за свой грех","и прославляй","хвалой","твоего Господа","вечером","и утром"]],[40,56,["إِنَّ","ٱلَّذِينَ","يُجَٰدِلُونَ","فِيٓ","ءَايَٰتِ","ٱللَّهِ","بِغَيۡرِ","سُلۡطَٰنٍ","أَتَىٰهُمۡ","إِن","فِي","صُدُورِهِمۡ","إِلَّا","كِبۡرٞ","مَّا","هُم","بِبَٰلِغِيهِۚ","فَٱسۡتَعِذۡ","بِٱللَّهِۖ","إِنَّهُۥ","هُوَ","ٱلسَّمِيعُ","ٱلۡبَصِيرُ"],"иннал лазиина йужадилууна фии айатиллахи бигайри султанин атахум ин фии судуурихим илла кибрум ма хум бибалигиихи фаста`из биллахи иннахуу хуас самии`ул басиир","Воистину, в сердцах тех, которые препираются относительно знамений Аллаха без всякого довода, явившегося к ним, нет ничего, кроме высокомерия. Они не достигнут этого (своей цели). Прибегай же к защите Аллаха. Воистину, Он - Слышащий, Видящий.",["поистине","те, которые","препираются","о","знамениях","Аллаха","без","довода","пришедшего к ним","нет","в","их грудях","кроме","высокомерия","не","они","достигнут его","так прибегай к защите","Аллаха","поистине, Он","Он","Слышащий","Видящий"]],[40,57,["لَخَلۡقُ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِ","أَكۡبَرُ","مِنۡ","خَلۡقِ","ٱلنَّاسِ","وَلَٰكِنَّ","أَكۡثَرَ","ٱلنَّاسِ","لَا","يَعۡلَمُونَ"],"лахалḳус самавати вал'арди акбару мин халḳин наси валакинна аксаран наси ла йа`ламуун","Воистину, сотворение небес и земли есть нечто более великое, чем сотворение людей, но большинство людей не знает этого.",["непременно сотворение","небес","и земли","более велико","чем","сотворение","людей","но","большинство","людей","не","знают"]],[40,58,["وَمَا","يَسۡتَوِي","ٱلۡأَعۡمَىٰ","وَٱلۡبَصِيرُ","وَٱلَّذِينَ","ءَامَنُواْ","وَعَمِلُواْ","ٱلصَّٰلِحَٰتِ","وَلَا","ٱلۡمُسِيٓءُۚ","قَلِيلٗا","مَّا","تَتَذَكَّرُونَ"],"вама йаставил а`ма валбасииру валлазиина амануу ва`амилус салихати валал мусииу ḳалиилам ма татазаккаруун","Не равны слепой и зрячий, а также те, которые уверовали и совершали праведные деяния, и творящие зло. Как же мало вы поминаете назидания!",["и не","равны","слепой","и зрячий","и те, которые","уверовали","и совершали","праведные деяния","и не","творящий зло","мало","что","вы поминаете"]]],"m":[[["قَالُوٓاْ","они сказали",40,50],["أَوَلَمۡ","разве не",40,50],["تَكُ","были",40,50],["تَأۡتِيكُمۡ","приходили к вам",40,50],["رُسُلُكُم","ваши посланники",40,50],["بِٱلۡبَيِّنَٰتِۖ","с ясными знамениями",40,50],["قَالُواْ","они сказали",40,50]],[["بَلَىٰۚ","да",40,50],["قَالُواْ","они сказали",40,50],["فَٱدۡعُواْۗ","так взывайте",40,50],["وَمَا","и не",40,50],["دُعَٰٓؤُاْ","мольба",40,50],["ٱلۡكَٰفِرِينَ","неверующих",40,50],["إِلَّا","кроме как",40,50],["فِي","в",40,50],["ضَلَٰلٍ","заблуждении",40,50]],[[50],["إِنَّا","поистине, Мы",40,51],["لَنَنصُرُ","непременно поможем",40,51],["رُسُلَنَا","Нашим посланникам",40,51],["وَٱلَّذِينَ","и тем, которые",40,51],["ءَامَنُواْ","уверовали",40,51],["فِي","в",40,51],["ٱلۡحَيَوٰةِ","жизни",40,51],["ٱلدُّنۡيَا","ближней",40,51]],[["وَيَوۡمَ","и в день",40,51],["يَقُومُ","встанут",40,51],["ٱلۡأَشۡهَٰدُ","свидетели",40,51],[51],["يَوۡمَ","в день",40,52],["لَا","не",40,52],["يَنفَعُ","поможет",40,52],["ٱلظَّٰلِمِينَ","беззаконникам",40,52],["مَعۡذِرَتُهُمۡۖ","их оправдание",40,52]],[["وَلَهُمُ","и им",40,52],["ٱللَّعۡنَةُ","проклятие",40,52],["وَلَهُمۡ","и им",40,52],["سُوٓءُ","злая",40,52],["ٱلدَّارِ","обитель",40,52],[52],["وَلَقَدۡ","и уже",40,53],["ءَاتَيۡنَا","Мы даровали",40,53],["مُوسَى","Мусе",40,53]],[["ٱلۡهُدَىٰ","руководство",40,53],["وَأَوۡرَثۡن