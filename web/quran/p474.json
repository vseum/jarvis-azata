{"p":474,"j":24,"a":[[40,59,["إِنَّ","ٱلسَّاعَةَ","لَأٓتِيَةٞ","لَّا","رَيۡبَ","فِيهَا","وَلَٰكِنَّ","أَكۡثَرَ","ٱلنَّاسِ","لَا","يُؤۡمِنُونَ"],"иннас са`ата ла'атийатул ла райба фииха валакинна аксаран наси ла йу'минуун","Час непременно наступит, и в нем нет сомнения. Однако большинство людей не верует.",["поистине","Час","непременно наступит","нет","сомнения","в нём","но","большинство","людей","не","веруют"]],[40,60,["وَقَالَ","رَبُّكُمُ","ٱدۡعُونِيٓ","أَسۡتَجِبۡ","لَكُمۡۚ","إِنَّ","ٱلَّذِينَ","يَسۡتَكۡبِرُونَ","عَنۡ","عِبَادَتِي","سَيَدۡخُلُونَ","جَهَنَّمَ","دَاخِرِينَ"],"ваḳала раббукумуд`уунии астажиб лакум иннал лазиина йастакбирууна `ан `ибадатии сайадхулууна жаханнама дахириин","Ваш Господь сказал: «Взывайте ко Мне, и Я отвечу вам. Воистину, те, которые превозносятся над поклонением Мне, войдут в Геенну униженными».",["и сказал","Господь ваш","взывайте ко Мне","Я отвечу","вам","поистине","те, которые","превозносятся","над","поклонением Мне","войдут","в Геенну","униженными"]],[40,61,["ٱللَّهُ","ٱلَّذِي","جَعَلَ","لَكُمُ","ٱلَّيۡلَ","لِتَسۡكُنُواْ","فِيهِ","وَٱلنَّهَارَ","مُبۡصِرًاۚ","إِنَّ","ٱللَّهَ","لَذُو","فَضۡلٍ","عَلَى","ٱلنَّاسِ","وَلَٰكِنَّ","أَكۡثَرَ","ٱلنَّاسِ","لَا","يَشۡكُرُونَ"],"аллахул лазии жа`ала лакумул лайла литаскунуу фиихи ваннахара мубсиран инналлаха лазуу фадлин `алан наси валакинна аксаран наси ла йашкуруун","Аллах - Тот, Кто сотворил для вас ночь, чтобы вы отдыхали в течение нее, и день для освещения. Воистину, Аллах оказывает людям милость, но большинство людей неблагодарны.",["Аллах","Тот, Который","сделал","для вас","ночь","чтобы вы покоились","в ней","и день","освещающим","поистине","Аллах","непременно Обладатель","милости","к","людям","но","большинство","людей","не","благодарят"]],[40,62,["ذَٰلِكُمُ","ٱللَّهُ","رَبُّكُمۡ","خَٰلِقُ","كُلِّ","شَيۡءٖ","لَّآ","إِلَٰهَ","إِلَّا","هُوَۖ","فَأَنَّىٰ","تُؤۡفَكُونَ"],"заликумуллаху раббукум халиḳу кулли шай'ил ла илаха илла хуа фа'анна ту'факуун","Таков Аллах - ваш Господь, Творец всякой вещи. Нет божества, кроме Него. До чего же вы отвращены от истины!",["таков","Аллах","Господь ваш","Творец","всякой","вещи","нет","божества","кроме","Него","так куда же","вы отвращаетесь"]],[40,63,["كَذَٰلِكَ","يُؤۡفَكُ","ٱلَّذِينَ","كَانُواْ","بِـَٔايَٰتِ","ٱللَّهِ","يَجۡحَدُونَ"],"казалика йу'факул лазиина кануу би'айатиллахи йажхадуун","Таким же образом отвращаются те, которые отвергают знамения Аллаха.",["так","отвращаются","те, которые","были","знамения","Аллаха","отвергающими"]],[40,64,["ٱللَّهُ","ٱلَّذِي","جَعَلَ","لَكُمُ","ٱلۡأَرۡضَ","قَرَارٗا","وَٱلسَّمَآءَ","بِنَآءٗ","وَصَوَّرَكُمۡ","فَأَحۡسَنَ","صُوَرَكُمۡ","وَرَزَقَكُم","مِّنَ","ٱلطَّيِّبَٰتِۚ","ذَٰلِكُمُ","ٱللَّهُ","رَبُّكُمۡۖ","فَتَبَارَكَ","ٱللَّهُ","رَبُّ","ٱلۡعَٰلَمِينَ"],"аллахул лазии жа`ала лакумул арда ḳараран вассамаа бинаан васавваракум фа'ахсана суаракум варазаḳакум минат таййибати заликумуллаху раббукум фатабаракаллаху раббул `аламиин","Аллах - Тот, Кто сотворил для вас землю местом пребывания, а небо - кровлей. Он придал вам облик и сделал ваш облик прекрасным. Он наделил вас благами. Таков Аллах, ваш Господь. Благословен Аллах, Господь миров!",["Аллах","Тот, Который","сделал","для вас","землю","местом пребывания","и небо","кровлей","и Он придал вам облик","и сделал прекрасными","облики ваши","и наделил вас","из","благ","таков","Аллах","Господь ваш","так благословен","Аллах","Господь","миров"]],[40,65,["هُوَ","ٱلۡحَيُّ","لَآ","إِلَٰهَ","إِلَّا","هُوَ","فَٱدۡعُوهُ","مُخۡلِصِينَ","لَهُ","ٱلدِّينَۗ","ٱلۡحَمۡدُ","لِلَّهِ","رَبِّ","ٱلۡعَٰلَمِينَ"],"хуал хаййу ла илаха илла хуа фад`ууху мухлисиина лахуд диинал хамду лиллахи раббил `аламиин","Он - Живой, и нет божества, кроме Него. Взывайте же к Нему, очищая перед Ним веру. Хвала Аллаху, Господу миров!",["Он","Живой","нет","божества","кроме","Него","так взывайте к Нему","очищающими","для Него","веру","хвала","Аллаху","Господу","миров"]],[40,66,["قُلۡ","إِنِّي","نُهِيتُ","أَنۡ","أَعۡبُدَ","ٱلَّذِينَ","تَدۡعُونَ","مِن","دُونِ","ٱللَّهِ","لَمَّا",