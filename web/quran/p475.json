{"p":475,"j":24,"a":[[40,67,["هُوَ","ٱلَّذِي","خَلَقَكُم","مِّن","تُرَابٖ","ثُمَّ","مِن","نُّطۡفَةٖ","ثُمَّ","مِنۡ","عَلَقَةٖ","ثُمَّ","يُخۡرِجُكُمۡ","طِفۡلٗا","ثُمَّ","لِتَبۡلُغُوٓاْ","أَشُدَّكُمۡ","ثُمَّ","لِتَكُونُواْ","شُيُوخٗاۚ","وَمِنكُم","مَّن","يُتَوَفَّىٰ","مِن","قَبۡلُۖ","وَلِتَبۡلُغُوٓاْ","أَجَلٗا","مُّسَمّٗى","وَلَعَلَّكُمۡ","تَعۡقِلُونَ"],"хуал лазии халаḳакум мин турабин сумма мин нутфатин сумма мин `алаḳатин сумма йухрижукум тифлан сумма литаблугуу ашуддакум сумма литакуунуу шуйуухан ваминкум ман йутаваффа мин ḳаблу валитаблугуу ажалам мусамман вала`аллакум та`ḳилуун","Он - Тот, Кто сотворил вас из земли, потом - из капли, потом - из сгустка крови. Потом Он выводит вас младенцами, чтобы потом вы могли достигнуть зрелого возраста и чтобы потом вы стали стариками, хотя среди вас есть такие, которых умерщвляют раньше, и чтобы вы достигли назначенного срока. Быть может, вы уразумеете.",["Он","Тот, Который","сотворил вас","из","праха","затем","из","капли","затем","из","сгустка","затем","Он выводит вас","младенцем","затем","чтобы вы достигли","зрелости вашей","затем","чтобы вы стали","старцами","и среди вас","тот, кто","умерщвляется","из","прежде","и чтобы вы достигли","срока","назначенного","и, может быть, вы","уразумеете"]],[40,68,["هُوَ","ٱلَّذِي","يُحۡيِۦ","وَيُمِيتُۖ","فَإِذَا","قَضَىٰٓ","أَمۡرٗا","فَإِنَّمَا","يَقُولُ","لَهُۥ","كُن","فَيَكُونُ"],"хуал лазии йухйии вайумииту фа'иза ḳада амран фа'иннама йаḳуулу лахуу кун файакуун","Он - Тот, Кто дарует жизнь и умерщвляет. Когда же Он принимает решение, то стоит Ему сказать: «Будь!». - как это сбывается.",["Он","Тот, Который","оживляет","и умерщвляет","и когда","Он решит","дело","то лишь","Он говорит","ему","будь","и оно сбывается"]],[40,69,["أَلَمۡ","تَرَ","إِلَى","ٱلَّذِينَ","يُجَٰدِلُونَ","فِيٓ","ءَايَٰتِ","ٱللَّهِ","أَنَّىٰ","يُصۡرَفُونَ"],"алам тара илал лазиина йужадилууна фии айатиллахи анна йусрафуун","Разве ты не видел тех, которые препираются относительно знамений Аллаха? До чего же они отвращены от истины?",["разве не","ты видел","на","тех, которые","препираются","о","знамениях","Аллаха","куда","они отвращаются"]],[40,70,["ٱلَّذِينَ","كَذَّبُواْ","بِٱلۡكِتَٰبِ","وَبِمَآ","أَرۡسَلۡنَا","بِهِۦ","رُسُلَنَاۖ","فَسَوۡفَ","يَعۡلَمُونَ"],"аллазиина каззабуу билкитаби вабима арсална бихии русулана фасауфа йа`ламуун","Они сочли ложью Писание и то, с чем Мы отправили Наших посланников. Но они узнают,",["те, которые","сочли ложью","Писание","и то, что","Мы послали","с ним","Наших посланников","но скоро","они узнают"]],[40,71,["إِذِ","ٱلۡأَغۡلَٰلُ","فِيٓ","أَعۡنَٰقِهِمۡ","وَٱلسَّلَٰسِلُ","يُسۡحَبُونَ"],"изил аглалу фии а`наḳихим вассаласилу йусхабуун","когда с оковами на шеях и в цепях их поволокут",["когда","оковы","на","шеях их","и цепи","их поволокут"]],[40,72,["فِي","ٱلۡحَمِيمِ","ثُمَّ","فِي","ٱلنَّارِ","يُسۡجَرُونَ"],"фил хамиими сумма фин нари йусжаруун","в кипяток, а потом разожгут в Огне.",["в","кипяток","затем","в","Огне","их разожгут"]],[40,73,["ثُمَّ","قِيلَ","لَهُمۡ","أَيۡنَ","مَا","كُنتُمۡ","تُشۡرِكُونَ"],"сумма ḳиила лахум айна ма кунтум тушрикуун","Потом им скажут: «Где те, кого вы приобщали в сотоварищи",["затем","будет сказано","им","где","то, что","вы были","приобщаете в сотоварищи"]],[40,74,["مِن","دُونِ","ٱللَّهِۖ","قَالُواْ","ضَلُّواْ","عَنَّا","بَل","لَّمۡ","نَكُن","نَّدۡعُواْ","مِن","قَبۡلُ","شَيۡـٔٗاۚ","كَذَٰلِكَ","يُضِلُّ","ٱللَّهُ","ٱلۡكَٰفِرِينَ"],"мин дууниллахи ḳалуу даллуу `анна бал лам накун над`уу мин ḳаблу шай'ан казалика йудиллуллахул кафириин","к Аллаху?». Они скажут: «Они скрылись от нас. Да и не молились мы раньше никому». Так Аллах вводит в заблуждение неверующих.",["из","помимо","Аллаха","они скажут","они скрылись","от нас","нет же","не","были мы","мы взываем","из","прежде","ни к чему","так","сбивает с пути","Аллах","неверующих"]],[40,75,["ذَٰلِكُم","بِمَا","كُنتُمۡ","تَفۡرَحُونَ","فِي","ٱلۡأَرۡضِ","بِغَيۡرِ","ٱلۡحَقِّ","وَبِمَا","كُنتُمۡ","تَمۡرَحُونَ"],"заликум бима кунтум тафрахууна фил арди бигайрил хаḳḳи вабима кунтум там