{"p":476,"j":24,"a":[[40,78,["وَلَقَدۡ","أَرۡسَلۡنَا","رُسُلٗا","مِّن","قَبۡلِكَ","مِنۡهُم","مَّن","قَصَصۡنَا","عَلَيۡكَ","وَمِنۡهُم","مَّن","لَّمۡ","نَقۡصُصۡ","عَلَيۡكَۗ","وَمَا","كَانَ","لِرَسُولٍ","أَن","يَأۡتِيَ","بِـَٔايَةٍ","إِلَّا","بِإِذۡنِ","ٱللَّهِۚ","فَإِذَا","جَآءَ","أَمۡرُ","ٱللَّهِ","قُضِيَ","بِٱلۡحَقِّ","وَخَسِرَ","هُنَالِكَ","ٱلۡمُبۡطِلُونَ"],"валаḳад арсална русулам мин ḳаблика минхум ман ḳасасна `алайка ваминхум мал лам наḳсус `алайка вама кана лирасуулин ан йа'тийа би'айатин илла би'изниллахи фа'иза жаа амруллахи ḳудийа билхаḳḳи вахасира хуналикал мубтилуун","Мы уже отправляли посланников до тебя. Среди них есть такие, о которых Мы рассказали тебе, и такие, о которых Мы не рассказывали тебе. Все посланники показывали знамения только с дозволения Аллаха. Когда же явится веление Аллаха, будет вынесен истинный приговор, и там приверженцы лжи окажутся в убытке.",["и уже","Мы послали","посланников","из","до тебя","из них","те, о которых","Мы рассказали","тебе","и из них","те, о которых","не","Мы рассказали","тебе","и не","было","посланнику","чтобы","он пришёл","со знамением","кроме как","с дозволения","Аллаха","и когда","придёт","веление","Аллаха","будет решено","по истине","и потерпят убыток","там","приверженцы лжи"]],[40,79,["ٱللَّهُ","ٱلَّذِي","جَعَلَ","لَكُمُ","ٱلۡأَنۡعَٰمَ","لِتَرۡكَبُواْ","مِنۡهَا","وَمِنۡهَا","تَأۡكُلُونَ"],"аллахул лазии жа`ала лакумул ан`ама литаркабуу минха ваминха та'кулуун","Аллах - Тот, Кто создал для вас скотину, чтобы на некоторых из них вы ездили верхом, а другими питались.",["Аллах","Тот, Который","сделал","для вас","скот","чтобы вы ездили","на некоторых из них","и некоторых из них","вы едите"]],[40,80,["وَلَكُمۡ","فِيهَا","مَنَٰفِعُ","وَلِتَبۡلُغُواْ","عَلَيۡهَا","حَاجَةٗ","فِي","صُدُورِكُمۡ","وَعَلَيۡهَا","وَعَلَى","ٱلۡفُلۡكِ","تُحۡمَلُونَ"],"валакум фииха манафи`у валитаблугуу `алайха хажатан фии судуурикум ва`алайха ва`алал фулки тухмалуун","Они приносят вам пользу, и на них вы достигаете того, чего желают ваши сердца. На них и на кораблях вас перевозят.",["и для вас","в них","польза","и чтобы вы достигали","на них","нужды","что в","груди ваших","и на них","и на","кораблях","вы переносимы"]],[40,81,["وَيُرِيكُمۡ","ءَايَٰتِهِۦ","فَأَيَّ","ءَايَٰتِ","ٱللَّهِ","تُنكِرُونَ"],"вайуриикум айатихии фа'аййа айатиллахи тункируун","Он показывает вам Свои знамения. Какие же знамения Аллаха вы отрицаете?",["и показывает вам","знамения Свои","так какие же","знамения","Аллаха","отрицаете"]],[40,82,["أَفَلَمۡ","يَسِيرُواْ","فِي","ٱلۡأَرۡضِ","فَيَنظُرُواْ","كَيۡفَ","كَانَ","عَٰقِبَةُ","ٱلَّذِينَ","مِن","قَبۡلِهِمۡۚ","كَانُوٓاْ","أَكۡثَرَ","مِنۡهُمۡ","وَأَشَدَّ","قُوَّةٗ","وَءَاثَارٗا","فِي","ٱلۡأَرۡضِ","فَمَآ","أَغۡنَىٰ","عَنۡهُم","مَّا","كَانُواْ","يَكۡسِبُونَ"],"афалам йасиируу фил арди файанзуруу кайфа кана `аḳибатул лазиина мин ḳаблихим кануу аксара минхум ва'ашадда ḳувватан ва'асаран фил арди фама агна `анхум ма кануу йаксибуун","Разве они не странствовали по земле и не видели, каким был конец их предшественников? Они превосходили их числом и силой и оставили больше следов на земле, но не спасло их то, что они приобретали.",["разве же не","странствовали они","по","земле","и не посмотрели","каким","был","конец","тех, которые","из","до них","они были","больше","их","и сильнее","мощью","и следами","на","земле","но не","избавило","их","то, что","они были","приобретают"]],[40,83,["فَلَمَّا","جَآءَتۡهُمۡ","رُسُلُهُم","بِٱلۡبَيِّنَٰتِ","فَرِحُواْ","بِمَا","عِندَهُم","مِّنَ","ٱلۡعِلۡمِ","وَحَاقَ","بِهِم","مَّا","كَانُواْ","بِهِۦ","يَسۡتَهۡزِءُونَ"],"фаламма жаатхум русулухум билбаййинати фарихуу бима `индахум минал `илми вахаḳа бихим ма кануу бихии йастахзиуун","Когда их посланники приходили к ним с ясными знамениями, они радовались тому знанию, которое было у них, и тогда их окружило (или поразило) то, над чем они издевались.",["и когда","пришли к ним","посланники их","с ясными знамениями","они радовались","тому, что","у них","из","знания","и окружило","их","то, над чем","они были","над ним","насмехаются"]],[40,84,["فَلَمَّا","رَأَوۡاْ","بَأۡسَنَا","قَالُوٓاْ","ءَامَنَّا","بِٱللَّهِ","وَحۡدَهُۥ","وَكَفَرۡنَا","بِمَا","كُنَّا","بِهِۦ","مُشۡرِكِينَ"],"фаламма ра'ау ба'сана ḳалуу аманна биллахи вахдахуу вакафарна бима кунна бихии мушрикиин","Когда они узрели Наше наказание, они сказали: «Мы уверовали в Единственного Аллаха и не веруем в тех, кого мы приобщали в сотоварищи к Нему!».",["и когда","они увидели","Нашу ярость","они сказали","мы уверовали","в Аллаха","Одного","и мы не уверовали","в то, что","мы были","с Ним","приобщающими в сотоварищи"]],[40,85,["فَلَمۡ","يَكُ","يَنفَعُهُمۡ","إِيمَٰنُهُمۡ","لَمَّا","رَأَوۡاْ","بَأۡسَنَاۖ","سُنَّتَ","ٱللَّهِ","ٱلَّتِي","قَدۡ","خَلَتۡ","فِي","عِبَادِهِۦۖ","وَخَسِرَ","هُنَالِكَ","ٱلۡكَٰفِرُونَ"],"фалам йаку йанфа`ухум ииманухум ламма ра'ау ба'сана суннаталлахил латии ḳад халат фии `ибадихии вахасира хуналикал кафируун","Но не помогла им вера, когда они увидели Наше наказание. Таким всегда было установление Аллаха для Его рабов. Вот тогда неверующие оказались в убытке.",["но не","было","полезна им","вера их","когда","они увидели","Нашу ярость","таков обычай","Аллаха","который","уже","прошёл","среди","рабов Его","и потерпели убыток","там","неверующие"]]],"m":[[["وَلَقَدۡ","и уже",40,78],["أَرۡسَلۡنَا","Мы послали",40,78],["رُسُلٗا","посланников",40,78],["مِّن","из",40,78],["قَبۡلِكَ","до тебя",40,78],["مِنۡهُم","из них",40,78],["مَّن","те, о которых",40,78],["قَصَصۡنَا","Мы рассказали",40,78],["عَلَيۡكَ","тебе",40,78]],[["وَمِنۡهُم","и из них",40,78],["مَّن","те, о которых",40,78],["لَّمۡ","не",40,78],["نَقۡصُصۡ","Мы рассказали",40,78],["عَلَيۡكَۗ","тебе",40,78],["وَمَا","и не",40,78],["كَانَ","было",40,78],["لِرَسُولٍ","посланнику",40,78],["أَن","чтобы",40,78],["يَأۡتِيَ","он пришёл",40,78]],[["بِـَٔايَةٍ","со знамением",40,78],["إِلَّا","кроме как",40,78],["بِإِذۡنِ","с дозволения",40,78],["ٱللَّهِۚ","Аллаха",40,78],["فَإِذَا","и когда",40,78],["جَآءَ","придёт",40,78],["أَمۡرُ","веление",40,78],["ٱللَّهِ","Аллаха",40,78],["قُضِيَ","будет решено",40,78],["بِٱلۡحَقِّ","по истине",40,78],["وَخَسِرَ","и потерпят убыток",40,78]],[["هُنَالِكَ","там",40,78],["ٱلۡمُبۡطِلُونَ","приверженцы лжи",40,78],[78],["ٱللَّهُ","Аллах",40,79],["ٱلَّذِي","Тот, Который",40,79],["جَعَلَ","сделал",40,79],["لَكُمُ","для вас",40,79],["ٱلۡأَنۡعَٰمَ","скот",40,79]],[["لِتَرۡكَبُواْ","чтобы вы ездили",40,79],["مِنۡهَا","на некоторых из них",40,79],["وَمِنۡهَا","и некоторых из них",40,79],["تَأۡكُلُونَ","вы едите",40,79],[79],["وَلَكُمۡ","и для вас",40,80],["فِيهَا","в них",40,80]],[["مَنَٰفِعُ","польза",40,80],["وَلِتَبۡلُغُواْ","и чтобы вы достигали",40,80],["عَلَيۡهَا","на них",40,80],["حَاجَةٗ","нужды",40,80],["فِي","что в",40,80],["صُدُورِكُمۡ","груди ваших",40,80],["وَعَلَيۡهَا","и на них",40,80],["وَعَلَى","и на",40,80]],[["ٱلۡفُلۡكِ","кораблях",40,80],["تُحۡمَلُونَ","вы переносимы",40,80],[80],["وَيُرِيكُمۡ","и показывает вам",40,81],["ءَايَٰتِهِۦ","знамения Свои",40,81],["فَأَيَّ","так какие же",40,81],["ءَايَٰتِ","знамения",40,81]],[["ٱللَّهِ","Аллаха",40,81],["تُنكِرُونَ","отрицаете",40,81],[81],["أَفَلَمۡ","разве же не",40,82],["يَسِيرُواْ","странствовали они",40,82],["فِي","по",40,82],["ٱلۡأَرۡضِ","земле",40,82],["فَيَنظُرُواْ","и не посмотрели",40,82],["كَيۡفَ","каким",40,82]],[["كَانَ","был",40,82],["عَٰقِبَةُ","конец",40,82],["ٱلَّذِينَ","тех, которые",40,82],["مِن","из",40,82],["قَبۡلِهِمۡۚ","до них",40,82],["كَانُوٓاْ","они были",40,82],["أَكۡثَرَ","больше",40,82],["مِنۡهُمۡ","их",40,82],["وَأَشَدَّ","и сильнее",40,82]],[["قُوَّةٗ","мощью",40,82],["وَءَاثَارٗا","и следами",40,82],["فِي","на",40,82],["ٱلۡأَرۡضِ","земле",40,82],["فَمَآ","но не",40,82],["أَغۡنَىٰ","избавило",40,82],["عَنۡهُم","их",40,82],["مَّا","то, что",40,82],["كَانُواْ","они были",40,82],["يَكۡسِبُونَ","приобретают",40,82]],[[82],["فَلَمَّا","и когда",40,83],["جَآءَتۡهُمۡ","пришли к ним",40,83],["رُسُلُهُم","посланники их",40,83],["بِٱلۡبَيِّنَٰتِ","с ясными знамениями",40,83],["فَرِحُواْ","они радовались",40,83],["