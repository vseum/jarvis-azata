{"p":477,"j":24,"a":[[41,1,["حمٓ"],"хм","Ха. Мим.",["Ха Мим"]],[41,2,["تَنزِيلٞ","مِّنَ","ٱلرَّحۡمَٰنِ","ٱلرَّحِيمِ"],"танзиилум минар рахманир рахиим","Ниспосланное от Милостивого, Милосердного",["ниспослание","от","Милостивого","Милосердного"]],[41,3,["كِتَٰبٞ","فُصِّلَتۡ","ءَايَٰتُهُۥ","قُرۡءَانًا","عَرَبِيّٗا","لِّقَوۡمٖ","يَعۡلَمُونَ"],"китабун фуссилат айатухуу ḳур'анан `арабиййал лиḳаумин йа`ламуун","является Писанием, аяты которого разъяснены в виде Корана на арабском языке для людей знающих.",["Писание","разъяснены","аяты его","Кораном","арабским","для людей","знающих"]],[41,4,["بَشِيرٗا","وَنَذِيرٗا","فَأَعۡرَضَ","أَكۡثَرُهُمۡ","فَهُمۡ","لَا","يَسۡمَعُونَ"],"башииран ваназииран фа'а`рада аксарухум фахум ла йасма`уун","Оно возвещает благую весть и предостерегает, однако большинство их отворачивается и не слышит.",["благовестником","и предостерегающим","но отвернулось","большинство их","и они","не","слышат"]],[41,5,["وَقَالُواْ","قُلُوبُنَا","فِيٓ","أَكِنَّةٖ","مِّمَّا","تَدۡعُونَآ","إِلَيۡهِ","وَفِيٓ","ءَاذَانِنَا","وَقۡرٞ","وَمِنۢ","بَيۡنِنَا","وَبَيۡنِكَ","حِجَابٞ","فَٱعۡمَلۡ","إِنَّنَا","عَٰمِلُونَ"],"ваḳалуу ḳулуубуна фии акиннатим мимма тад`ууна илайхи вафии азанина ваḳрун вамим байнина вабайника хижабун фа`мал иннана `амилуун","Они говорят: «Наши сердца закрыты для того, к чему ты призываешь нас, наши уши поражены глухотой, а между нами и тобой - завеса. Трудись же, и мы будем трудиться».",["и сказали они","сердца наши","в","покровах","от того, что","ты зовёшь нас","к нему","и в","ушах наших","глухота","и из","между нами","и между тобой","завеса","так действуй","поистине, мы","действующие"]],[41,6,["قُلۡ","إِنَّمَآ","أَنَا۠","بَشَرٞ","مِّثۡلُكُمۡ","يُوحَىٰٓ","إِلَيَّ","أَنَّمَآ","إِلَٰهُكُمۡ","إِلَٰهٞ","وَٰحِدٞ","فَٱسۡتَقِيمُوٓاْ","إِلَيۡهِ","وَٱسۡتَغۡفِرُوهُۗ","وَوَيۡلٞ","لِّلۡمُشۡرِكِينَ"],"ḳул иннама ана башарум мислукум йууха илаййа аннама илахукум илахун вахидун фастаḳиимуу илайхи вастагфирууху вавайлул лилмушрикиин","Скажи: «Я - такой же человек, как и вы. Мне внушено в откровении, что ваш бог - Бог Единственный. Идите к Нему прямым путем и просите у Него прощения. И горе многобожникам,",["скажи","лишь","я","человек","подобный вам","внушается","мне","что лишь","бог ваш","Бог","Единый","так держитесь прямо","к Нему","и просите у Него прощения","и горе","многобожникам"]],[41,7,["ٱلَّذِينَ","لَا","يُؤۡتُونَ","ٱلزَّكَوٰةَ","وَهُم","بِٱلۡأٓخِرَةِ","هُمۡ","كَٰفِرُونَ"],"аллазиина ла йу'тууназ закавата вахум бил'ахирати хум кафируун","которые не выплачивают закята и не веруют в Последнюю жизнь».",["те, которые","не","дают","закят","и они","в Последнюю жизнь","они","неверующие"]],[41,8,["إِنَّ","ٱلَّذِينَ","ءَامَنُواْ","وَعَمِلُواْ","ٱلصَّٰلِحَٰتِ","لَهُمۡ","أَجۡرٌ","غَيۡرُ","مَمۡنُونٖ"],"иннал лазиина амануу ва`амилус салихати лахум ажрун гайру мамнуун","Воистину, тем, которые уверовали и совершали праведные деяния, уготована неиссякаемая награда.",["поистине","те, которые","уверовали","и совершали","праведные деяния","для них","награда","не","иссякающая"]],[41,9,["قُلۡ","أَئِنَّكُمۡ","لَتَكۡفُرُونَ","بِٱلَّذِي","خَلَقَ","ٱلۡأَرۡضَ","فِي","يَوۡمَيۡنِ","وَتَجۡعَلُونَ","لَهُۥٓ","أَندَادٗاۚ","ذَٰلِكَ","رَبُّ","ٱلۡعَٰلَمِينَ"],"ḳул а'иннакум латакфурууна биллазии халаḳал арда фии йаумайни ватаж`алууна лахуу андадан залика раббул `аламиин","Скажи: «Неужели вы не веруете в Того, Кто создал землю за два дня, и равняете с Ним других? Он же - Господь миров.",["скажи","неужели вы","непременно не веруете","в Того, Который","сотворил","землю","за","два дня","и делаете","Ему","равных","Тот","Господь","миров"]],[41,10,["وَجَعَلَ","فِيهَا","رَوَٰسِيَ","مِن","فَوۡقِهَا","وَبَٰرَكَ","فِيهَا","وَقَدَّرَ","فِيهَآ","أَقۡوَٰتَهَا","فِيٓ","أَرۡبَعَةِ","أَيَّامٖ","سَوَآءٗ","لِّلسَّآئِلِينَ"],"важа`ала фииха равасийа мин фауḳиха вабарака фииха ваḳаддара фииха аḳватаха фии арба`ати аййамин саваал лиссаилиин","Он воздвиг над землей незыблемые горы, наделил ее благодатью и распределил на ней пропитание для страждущих (или для тех, кто спрашивает) за четыре полных дня.",["и Он поместил","на ней","незыблемые горы","из","над ней","и благословил","её","и определил","на ней","пропитание её","за","четыре","дня","равно","для спрашивающих"]],[41,11,["ثُمَّ","ٱسۡتَوَىٰٓ","إِلَى","ٱلسَّمَآءِ","وَهِيَ","دُخَانٞ","فَقَالَ","لَهَا","وَلِلۡأَرۡضِ","ٱئۡتِيَا","طَوۡعًا","أَوۡ","كَرۡهٗا","قَالَتَآ","أَتَيۡنَا","طَآئِعِينَ"],"суммастава илас самаи вахийа духанун фаḳала лаха валил'ардитийа тау`ан ау кархан ḳалата атайна таи`иин","Потом Он обратился к небу, которое было дымом, и сказал ему и земле: «Придите по доброй воле или по принуждению». Они сказали: «Мы пришли по доброй воле».",["затем","Он обратился","к","небу","а оно","дым","и сказал","ему","и земле","придите оба","добровольно","или","принуждённо","сказали оба","мы пришли","добровольно покорными"]]],"m":[["h",41],["b"],[["حمٓ","Ха Мим",41,1],[1],["تَنزِيلٞ","ниспослание",41,2],["مِّنَ","от",41,2],["ٱلرَّحۡمَٰنِ","Милостивого",41,2],["ٱلرَّحِيمِ","Милосердного",41,2],[2],["كِتَٰبٞ","Писание",41,3],["فُصِّلَتۡ","разъяснены",41,3]],[["ءَايَٰتُهُۥ","аяты его",41,3],["قُرۡءَانًا","Кораном",41,3],["عَرَبِيّٗا","арабским",41,3],["لِّقَوۡمٖ","для людей",41,3],["يَعۡلَمُونَ","знающих",41,3],[3],["بَشِيرٗا","благовестником",41,4],["وَنَذِيرٗا","и предостерегающим",41,4],["فَأَعۡرَضَ","но отвернулось",41,4]],[["أَكۡثَرُهُمۡ","большинство их",41,4],["فَهُمۡ","и они",41,4],["لَا","не",41,4],["يَسۡمَعُونَ","слышат",41,4],[4],["وَقَالُواْ","и сказали они",41,5],["قُلُوبُنَا","сердца наши",41,5],["فِيٓ","в",41,5],["أَكِنَّةٖ","покровах",41,5]],[["مِّمَّا","от того, что",41,5],["تَدۡعُونَآ","ты зовёшь нас",41,5],["إِلَيۡهِ","к нему",41,5],["وَفِيٓ","и в",41,5],["ءَاذَانِنَا","ушах наших",41,5],["وَقۡرٞ","глухота",41,5],["وَمِنۢ","и из",41,5],["بَيۡنِنَا","между нами",41,5],["وَبَيۡنِكَ","и между тобой",41,5],["حِجَابٞ","завеса",41,5]],[["فَٱعۡمَلۡ","так действуй",41,5],["إِنَّنَا","поистине, мы",41,5],["عَٰمِلُونَ","действующие",41,5],[5],["قُلۡ","скажи",41,6],["إِنَّمَآ","лишь",41,6],["أَنَا۠","я",41,6],["بَشَرٞ","человек",41,6],["مِّثۡلُكُمۡ","подобный вам",41,6],["يُوحَىٰٓ","внушается",41,6],["إِلَيَّ","мне",41,6]],[["أَنَّمَآ","что лишь",41,6],["إِلَٰهُكُمۡ","бог ваш",41,6],["إِلَٰهٞ","Бог",41,6],["وَٰحِدٞ","Единый",41,6],["فَٱسۡتَقِيمُوٓاْ","так держитесь прямо",41,6],["إِلَيۡهِ","к Нему",41,6],["وَٱسۡتَغۡفِرُوهُۗ","и просите у Него прощения",41,6],["وَوَيۡلٞ","и горе",41,6]],[["لِّلۡمُشۡرِكِينَ","многобожникам",41,6],[6],["ٱلَّذِينَ","те, которые",41,7],["لَا","не",41,7],["يُؤۡتُونَ","дают",41,7],["ٱلزَّكَوٰةَ","закят",41,7],["وَهُم","и они",41,7],["بِٱلۡأٓخِرَةِ","в Последнюю жизнь",41,7]],[["هُمۡ","они",41,7],["كَٰفِرُونَ","неверующие",41,7],[7],["إِنَّ","поистине",41,8],["ٱلَّذِينَ","те, которые",41,8],["ءَامَنُواْ","уверовали",41,8],["وَعَمِلُواْ","и совершали",41,8],["ٱلصَّٰلِحَٰتِ","праведные деяния",41,8],["لَهُمۡ","для них",41,8]],[["أَجۡرٌ","награда",41,8],["غَيۡرُ","не",41,8],["مَمۡنُونٖ","иссякающая",41,8],[8],["۞ قُلۡ","скажи",41,9],["أَئِنَّكُمۡ","неужели вы",41,9],["لَتَكۡفُرُونَ","непременно не веруете",41,9],["بِٱلَّذِي","в Того, Который",41,9],["خَلَقَ","сотворил",41,9]],[["ٱلۡأَرۡضَ","землю",41,9],["فِي","за",41,9],["يَوۡمَيۡنِ","два дня",41,9],["وَتَجۡعَلُونَ","и делаете",41,9],["لَهُۥٓ","Ему",41,9],["أَندَادٗاۚ","равных",41,9],["ذَٰلِكَ","Тот",41,9],["رَبُّ","Господь",41,9],["ٱلۡعَٰلَمِينَ","миров",41,9],[9]],[["وَجَعَلَ","и Он поместил",41,10],["فِيهَا","на ней",41,10],["رَوَٰسِيَ","незыблемые горы",41,10],["مِن","из",41,10],["فَوۡقِهَا","над ней",41,10],["وَبَٰرَكَ","и благословил",41,10],["فِيهَا","её",41,10],["وَقَدَّرَ","и определил",41,10],["فِيهَآ","на ней",41,10],["أَقۡوَٰتَهَا","пропитание её",41,10],["فِيٓ","за",41,10]],[["أَرۡبَعَةِ","четыре",41,10],["أَيَّامٖ","дня",41,10],["سَوَآءٗ","равно",41,10],["لِّلسَّآئِلِينَ","для спрашивающих",41,10],[10],["ثُمَّ","затем",41,11],["ٱسۡتَوَىٰٓ","Он обратился",41,11],["إِلَى","к",41,11],["ٱلسَّمَآءِ","небу",41,11],["وَهِيَ","а оно",41,11],["دُخَانٞ","дым",41,11]],[["فَقَالَ","и сказал",41,11],["لَهَا","ему",41,11],["وَلِلۡأَرۡضِ","и земле",41,11],["ٱئۡتِيَا","придите оба",41,11],["طَوۡعًا","добровольно",41,11],["أَوۡ","или",41,11],["كَرۡهٗا","принуждённо",41,11],["قَالَتَآ","сказали оба",41,11],["أَتَيۡنَا","мы пришли",41,11],["طَآئِعِينَ","добровольно покорными",41,11],[11]]]}