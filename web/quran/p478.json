{"p":478,"j":24,"a":[[41,12,["فَقَضَىٰهُنَّ","سَبۡعَ","سَمَٰوَاتٖ","فِي","يَوۡمَيۡنِ","وَأَوۡحَىٰ","فِي","كُلِّ","سَمَآءٍ","أَمۡرَهَاۚ","وَزَيَّنَّا","ٱلسَّمَآءَ","ٱلدُّنۡيَا","بِمَصَٰبِيحَ","وَحِفۡظٗاۚ","ذَٰلِكَ","تَقۡدِيرُ","ٱلۡعَزِيزِ","ٱلۡعَلِيمِ"],"фаḳадахунна саб`а самаватин фии йаумайни ва'ауха фии кулли самаин амраха вазаййаннас самаад дунйа бимасабииха вахифзан залика таḳдиирул `азиизил `алиим","Он сотворил их семью небесами за два дня и внушил каждому небу его обязанности. Мы украсили нижнее небо светильниками и оберегаем его (или для оберегания его). Таково предопределение Могущественного, Знающего».",["и Он завершил их","семью","небесами","за","два дня","и внушил","в","каждое","небо","его веление","и Мы украсили","небо","ближнее","светильниками","и для охраны","это","предопределение","Могущественного","Знающего"]],[41,13,["فَإِنۡ","أَعۡرَضُواْ","فَقُلۡ","أَنذَرۡتُكُمۡ","صَٰعِقَةٗ","مِّثۡلَ","صَٰعِقَةِ","عَادٖ","وَثَمُودَ"],"фа'ин а`радуу фаḳул анзартукум са`иḳатам мисла са`иḳати `адин васамууд","Если же они отвернутся, то скажи: «Я предостерегаю вас от мучений, подобных мучениям адитов и самудян».",["а если","отвернутся они","то скажи","я предостерёг вас","о молнии","подобной","молнии","адитов","и самудян"]],[41,14,["إِذۡ","جَآءَتۡهُمُ","ٱلرُّسُلُ","مِنۢ","بَيۡنِ","أَيۡدِيهِمۡ","وَمِنۡ","خَلۡفِهِمۡ","أَلَّا","تَعۡبُدُوٓاْ","إِلَّا","ٱللَّهَۖ","قَالُواْ","لَوۡ","شَآءَ","رَبُّنَا","لَأَنزَلَ","مَلَٰٓئِكَةٗ","فَإِنَّا","بِمَآ","أُرۡسِلۡتُم","بِهِۦ","كَٰفِرُونَ"],"из жаатхумур русулу мим байни айдиихим вамин халфихим алла та`будуу иллаллаха ḳалуу лау шаа раббуна ла'анзала малаикатан фа'инна бима урсилтум бихии кафируун","Посланники приходили к ним спереди и сзади: «Не поклоняйтесь никому, кроме Аллаха». Они же говорили: «Если бы наш Господь захотел, то ниспослал бы ангелов. Воистину, Мы не веруем в то, с чем вы посланы».",["когда","пришли к ним","посланники","из","между","руками их","и из","позади них","чтобы не","вы поклонялись","кроме","Аллаха","они сказали","если бы","пожелал","Господь наш","непременно Он ниспослал бы","ангелов","и поистине, мы","в то, что","вы посланы","с ним","неверующие"]],[41,15,["فَأَمَّا","عَادٞ","فَٱسۡتَكۡبَرُواْ","فِي","ٱلۡأَرۡضِ","بِغَيۡرِ","ٱلۡحَقِّ","وَقَالُواْ","مَنۡ","أَشَدُّ","مِنَّا","قُوَّةًۖ","أَوَلَمۡ","يَرَوۡاْ","أَنَّ","ٱللَّهَ","ٱلَّذِي","خَلَقَهُمۡ","هُوَ","أَشَدُّ","مِنۡهُمۡ","قُوَّةٗۖ","وَكَانُواْ","بِـَٔايَٰتِنَا","يَجۡحَدُونَ"],"фа'амма `адун фастакбаруу фил арди бигайрил хаḳḳи ваḳалуу ман ашадду минна ḳувватан авалам йарау анналлахал лазии халаḳахум хуа ашадду минхум ḳувватан вакануу би'айатина йажхадуун","Что касается адитов, то они возгордились на земле без всякого права и сказали: «Кто может превзойти нас силой?». Неужели они не видели, что Аллах, Который сотворил их, превосходит их силой? Они отвергали Наши знамения.",["что же касается","адитов","то они возгордились","на","земле","без","права","и сказали","кто","сильнее","нас","мощью","разве же не","видели они","что","Аллах","Который","сотворил их","Он","сильнее","их","мощью","и они были","Наши знамения","отвергают"]],[41,16,["فَأَرۡسَلۡنَا","عَلَيۡهِمۡ","رِيحٗا","صَرۡصَرٗا","فِيٓ","أَيَّامٖ","نَّحِسَاتٖ","لِّنُذِيقَهُمۡ","عَذَابَ","ٱلۡخِزۡيِ","فِي","ٱلۡحَيَوٰةِ","ٱلدُّنۡيَاۖ","وَلَعَذَابُ","ٱلۡأٓخِرَةِ","أَخۡزَىٰۖ","وَهُمۡ","لَا","يُنصَرُونَ"],"фа'арсална `алайхим риихан сарсаран фии аййамин нахисатил линузииḳахум `азабал хизйи фил хайаватид дунйа вала`азабул ахирати ахза вахум ла йунсаруун","Мы наслали на них морозный (или завывающий) ветер в злополучные дни, чтобы дать им вкусить муки позора в мирской жизни. А мучения в Последней жизни будут еще более позорными, и им не будет оказана помощь.",["И Мы наслали","на них","ветер","ледяной (ревущий)","в","дни","злополучные","чтобы Нам дать им вкусить","наказание","позора","в","жизни","мирской","а наказание","Последней жизни","позорнее","и они","не","получат помощи"]],[41,17,["وَأَمَّا","ثَمُودُ","فَهَدَيۡنَٰهُمۡ","فَٱسۡتَحَبُّواْ","ٱلۡعَمَىٰ","عَلَى","ٱلۡهُدَىٰ","فَأَخَذَتۡهُمۡ","صَٰعِقَةُ","ٱلۡعَذَابِ","ٱلۡهُونِ","بِمَا","كَانُواْ","يَكۡسِبُونَ"],"ва'амма самууду фахадайнахум фастахаббул `ама `алал худа фа'ахазатхум са`иḳатул `азабил хууни бима кануу йаксибуун","Что же касается самудян, то Мы указали им на прямой путь, но они предпочли слепоту верному руководству, и их поразила молния унизительных мучений за то, что они приобретали.",["А что касается","самудян","то Мы указали им путь","но они предпочли","слепоту","над","верным путём","и постигла их","молния","наказания","унизительного","за то, что","они","приобретали"]],[41,18,["وَنَجَّيۡنَا","ٱلَّذِينَ","ءَامَنُواْ","وَكَانُواْ","يَتَّقُونَ"],"ванажжайнал лазиина амануу вакануу йаттаḳуун","А тех, которые уверовали и были богобоязненны, Мы спасли.",["И Мы спасли","тех, которые","уверовали","и","были богобоязненны"]],[41,19,["وَيَوۡمَ","يُحۡشَرُ","أَعۡدَآءُ","ٱللَّهِ","إِلَى","ٱلنَّارِ","فَهُمۡ","يُوزَعُونَ"],"вайаума йухшару а`дауллахи илан нари фахум йууза`уун","В тот день, когда враги Аллаха будут собраны перед Огнем, их задержат.",["И в день, (когда)","будут собраны","враги","Аллаха","к","Огню","и они","будут построены рядами"]],[41,20,["حَتَّىٰٓ","إِذَا","مَا","جَآءُوهَا","شَهِدَ","عَلَيۡهِمۡ","سَمۡعُهُمۡ","وَأَبۡصَٰرُهُمۡ","وَجُلُودُهُم","بِمَا","كَانُواْ","يَعۡمَلُونَ"],"хатта иза ма жаууха шахида `алайхим сам`ухум ва'абсарухум важулуудухум бима кануу йа`малуун","Когда же они достигнут его, их слух, их взоры и их кожа станут свидетельствовать против них о том, что они совершали.",["Пока","когда","(лишь)","придут к нему","засвидетельствует","против них","их слух","и их взоры","и их кожа","о том, что","они","совершали"]]],"m":[[["فَقَضَىٰهُنَّ","и Он завершил их",41,12],["سَبۡعَ","семью",41,12],["سَمَٰوَاتٖ","небесами",41,12],["فِي","за",41,12],["يَوۡمَيۡنِ","два дня",41,12],["وَأَوۡحَىٰ","и внушил",41,12],["فِي","в",41,12],["كُلِّ","каждое",41,12],["سَمَآءٍ","небо",41,12],["أَمۡرَهَاۚ","его веление",41,12]],[["وَزَيَّنَّا","и Мы украсили",41,12],["ٱلسَّمَآءَ","небо",4