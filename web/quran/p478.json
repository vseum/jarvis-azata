فَأَرۡسَلۡنَا","И Мы наслали",41,16],["عَلَيۡهِمۡ","на них",41,16],["رِيحٗا","ветер",41,16],["صَرۡصَرٗا","ледяной (ревущий)",41,16],["فِيٓ","в",41,16],["أَيَّامٖ","дни",41,16],["نَّحِسَاتٖ","злополучные",41,16],["لِّنُذِيقَهُمۡ","чтобы Нам дать им вкусить",41,16]],[["عَذَابَ","наказание",41,16],["ٱلۡخِزۡيِ","позора",41,16],["فِي","в",41,16],["ٱلۡحَيَوٰةِ","жизни",41,16],["ٱلدُّنۡيَاۖ","мирской",41,16],["وَلَعَذَابُ","а наказание",41,16],["ٱلۡأٓخِرَةِ","Последней жизни",41,16],["أَخۡزَىٰۖ","позорнее",41,16],["وَهُمۡ","и они",41,16]],[["لَا","не",41,16],["يُنصَرُونَ","получат помощи",41,16],[16],["وَأَمَّا","А что касается",41,17],["ثَمُودُ","самудян",41,17],["فَهَدَيۡنَٰهُمۡ","то Мы указали им путь",41,17],["فَٱسۡتَحَبُّواْ","но они предпочли",41,17],["ٱلۡعَمَىٰ","слепоту",41,17],["عَلَى","над",41,17]],[["ٱلۡهُدَىٰ","верным путём",41,17],["فَأَخَذَتۡهُمۡ","и постигла их",41,17],["صَٰعِقَةُ","молния",41,17],["ٱلۡعَذَابِ","наказания",41,17],["ٱلۡهُونِ","унизительного",41,17],["بِمَا","за то, что",41,17],["كَانُواْ","они",41,17],["يَكۡسِبُونَ","приобретали",41,17]],[[17],["وَنَجَّيۡنَا","И Мы спасли",41,18],["ٱلَّذِينَ","тех, которые",41,18],["ءَامَنُواْ","уверовали",41,18],["وَكَانُواْ","и",41,18],["يَتَّقُونَ","были богобоязненны",41,18],[18],["وَيَوۡمَ","И в день, (когда)",41,19],["يُحۡشَرُ","будут собраны",41,19]],[["أَعۡدَآءُ","враги",41,19],["ٱللَّهِ","Аллаха",41,19],["إِلَى","к",41,19],["ٱلنَّارِ","Огню",41,19],["فَهُمۡ","и они",41,19],["يُوزَعُونَ","будут построены рядами",41,19],[19],["حَتَّىٰٓ","Пока",41,20],["إِذَا","когда",41,20],["مَا","(лишь)",41,20],["جَآءُوهَا","придут к нему",41,20],["شَهِدَ","засвидетельствует",41,20]],[["عَلَيۡهِمۡ","против них",41,20],["سَمۡعُهُمۡ","их слух",41,20],["وَأَبۡصَٰرُهُمۡ","и их взоры",41,20],["وَجُلُودُهُم","и их кожа",41,20],["بِمَا","о том, что",41,20],["كَانُواْ","они",41,20],["يَعۡمَلُونَ","совершали",41,20],[20]]]}