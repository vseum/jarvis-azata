{"p":479,"j":24,"a":[[41,21,["وَقَالُواْ","لِجُلُودِهِمۡ","لِمَ","شَهِدتُّمۡ","عَلَيۡنَاۖ","قَالُوٓاْ","أَنطَقَنَا","ٱللَّهُ","ٱلَّذِيٓ","أَنطَقَ","كُلَّ","شَيۡءٖۚ","وَهُوَ","خَلَقَكُمۡ","أَوَّلَ","مَرَّةٖ","وَإِلَيۡهِ","تُرۡجَعُونَ"],"ваḳалуу лижулуудихим лима шахидттум `алайна ḳалуу антаḳаналлахул лазии антаḳа кулла шай'ин вахуа халаḳакум аввала марратин ва'илайхи туржа`уун","Они скажут своей коже: «Почему вы стали свидетельствовать против нас?». Они скажут: «Нас заставил говорить Аллах, Который заставил говорить всякую вещь». Он сотворил вас в первый раз, и к Нему вы будете возвращены.",["И скажут они","своей коже","Почему","вы засвидетельствовали","против нас","Скажут они","заставил говорить нас","Аллах","Который","заставил говорить","всякую","вещь","и Он","сотворил вас","в первый","раз","и к Нему","вы будете возвращены"]],[41,22,["وَمَا","كُنتُمۡ","تَسۡتَتِرُونَ","أَن","يَشۡهَدَ","عَلَيۡكُمۡ","سَمۡعُكُمۡ","وَلَآ","أَبۡصَٰرُكُمۡ","وَلَا","جُلُودُكُمۡ","وَلَٰكِن","ظَنَنتُمۡ","أَنَّ","ٱللَّهَ","لَا","يَعۡلَمُ","كَثِيرٗا","مِّمَّا","تَعۡمَلُونَ"],"вама кунтум тастатирууна ан йашхада `алайкум сам`укум вала абсарукум вала жулуудукум валакин занантум анналлаха ла йа`ламу касиирам мимма та`малуун","Вы не укрывались от свидетельств вашего слуха, ваших взоров и вашей кожи. Но вы предполагали, что Аллах не знает многого из того, что вы совершали.",["И не","вы","укрывались","чтобы (не)","свидетельствовал","против вас","ваш слух","и не","ваши взоры","и не","ваша кожа","но","вы предполагали","что","Аллах","не","знает","многого","из того, что","вы делаете"]],[41,23,["وَذَٰلِكُمۡ","ظَنُّكُمُ","ٱلَّذِي","ظَنَنتُم","بِرَبِّكُمۡ","أَرۡدَىٰكُمۡ","فَأَصۡبَحۡتُم","مِّنَ","ٱلۡخَٰسِرِينَ"],"вазаликум заннукумул лазии занантум бираббикум ардакум фа'асбахтум минал хасириин","Эти ваши предположения, которые вы делали о вашем Господе, погубили вас, и вы оказались одними из потерпевших убыток.",["И это","ваше предположение","которое","вы предполагали","о вашем Господе","погубило вас","и вы оказались","из числа","потерпевших убыток"]],[41,24,["فَإِن","يَصۡبِرُواْ","فَٱلنَّارُ","مَثۡوٗى","لَّهُمۡۖ","وَإِن","يَسۡتَعۡتِبُواْ","فَمَا","هُم","مِّنَ","ٱلۡمُعۡتَبِينَ"],"фа'ин йасбируу фаннару масвал лахум ва'ин йаста`тибуу фама хум минал му`табиин","Если даже они проявят терпение, их обителью будет Огонь. Если же они попросят о благосклонности, то к ним не будут благосклонны (или если к ним проявят благосклонность, то они не станут искать благосклонности).",["И если","они проявят терпение","то Огонь","обитель","для них","а если","они попросят благосклонности","то не","они","из числа","получивших благосклонность"]],[41,25,["وَقَيَّضۡنَا","لَهُمۡ","قُرَنَآءَ","فَزَيَّنُواْ","لَهُم","مَّا","بَيۡنَ","أَيۡدِيهِمۡ","وَمَا","خَلۡفَهُمۡ","وَحَقَّ","عَلَيۡهِمُ","ٱلۡقَوۡلُ","فِيٓ","أُمَمٖ","قَدۡ","خَلَتۡ","مِن","قَبۡلِهِم","مِّنَ","ٱلۡجِنِّ","وَٱلۡإِنسِۖ","إِنَّهُمۡ","كَانُواْ","خَٰسِرِينَ"],"ваḳаййадна лахум ḳуранаа фазаййануу лахум ма байна айдиихим вама халфахум вахаḳḳа `алайхимул ḳаулу фии умамин ḳад халат мин ḳаблихим минал жинни вал'инси иннахум кануу хасириин","Мы приставили к ним товарищей, которые представили им прекрасным их настоящее и будущее, и сбылось Слово относительно них и относительно живших до них народов из числа джиннов и людей. Воистину, они были потерпевшими убыток.",["И Мы приставили","к ним","спутников","и они приукрасили","им","то, что","перед","ними","и то, что","позади них","и сбылось","над ними","Слово","среди","народов","уже","прошедших","из","прежде них","из числа","джиннов","и людей","поистине, они","были","потерпевшими убыток"]],[41,26,["وَقَالَ","ٱلَّذِينَ","كَفَرُواْ","لَا","تَسۡمَعُواْ","لِهَٰذَا","ٱلۡقُرۡءَانِ","وَٱلۡغَوۡاْ","فِيهِ","لَعَلَّكُمۡ","تَغۡلِبُونَ"],"ваḳалал лазиина кафаруу ла тасма`уу лихазал ḳур'ани валгау фиихи ла`аллакум таглибуун","Неверующие сказали: «Не слушайте этот Коран, а начинайте говорить вздор (опровергайте его любым способом или шумите во время его чтения). Быть может, вы одержите верх».",["И сказали","те, которые","не уверовали","Не","слушайте","этот","Коран","и шумите","при нём","может быть, вы","одержите верх"]],[41,27,["فَلَنُذِيقَنَّ","ٱلَّذِينَ","كَفَرُواْ","عَذَابٗا","شَدِيدٗا","وَلَنَجۡزِيَنَّهُمۡ","أَسۡوَأَ","ٱلَّذِي","كَانُواْ","يَعۡمَلُونَ"],"фаланузииḳаннал лазиина кафаруу `азабан шадиидан валанажзийаннахум асваал лазии кануу йа`малуун","Мы непременно дадим неверующим вкусить тяжкие мучения и воздадим им за наихудшее из того, что они совершали.",["И Мы непременно дадим вкусить","тем, которые","не уверовали","наказание","суровое","и непременно воздадим им","худшим","из того, что","они","совершали"]],[41,28,["ذَٰلِكَ","جَزَآءُ","أَعۡدَآءِ","ٱللَّهِ","ٱلنَّارُۖ","لَهُمۡ","فِيهَا","دَارُ","ٱلۡخُلۡدِ","جَزَآءَۢ","بِمَا","كَانُواْ","بِـَٔايَٰتِنَا","يَجۡحَدُونَ"],"залика жазау а`даиллахин нару лахум фииха дарул хулди жазаа бима кануу би'айатина йажхадуун","Таково воздаяние врагам Аллаха! Огонь! В нем будет их Вечная обитель в воздаяние за то, что они отвергали Наши знамения.",["Это","воздаяние","врагов","Аллаха","Огонь","им","в нём","обитель","вечности","в воздаяние","за то, что","они","Наши знамения","отвергали"]],[41,29,["وَقَالَ","ٱلَّذِينَ","كَفَرُواْ","رَبَّنَآ","أَرِنَا","ٱلَّذَيۡنِ","أَضَلَّانَا","مِنَ","ٱلۡجِنِّ","وَٱلۡإِنسِ","نَجۡعَلۡهُمَا","تَحۡتَ","أَقۡدَامِنَا","لِيَكُونَا","مِنَ","ٱلۡأَسۡفَلِينَ"],"ваḳалал лазиина кафаруу раббана аринал лазайни адаллана минал жинни вал'инси наж`алхума тахта аḳдамина лийакууна минал асфалиин","Неверующие скажут: «Господь наш! Покажи нам тех джиннов и людей, которые ввели нас в заблуждение. Мы бросим их себе под ноги, чтобы они были самыми низкими».",["И скажут","те, которые","не уверовали","Господь наш","Покажи нам","тех двоих, которые","сбили нас с пути","из","джиннов","и людей","мы поместим их","под","нашими ногами","чтобы были они","из","самых низших"]]],"m":[[["وَقَالُواْ","И скажут они",41,21],["لِجُلُودِهِمۡ","своей коже",41,21],["لِمَ","Почему",41,21],["شَهِدتُّمۡ","вы засвидетельствовали",41,21],["عَلَيۡنَاۖ","против нас",41,21],["قَالُوٓاْ","Скажут они",41,21],["أَنطَقَنَا","заставил говорить нас",41,21],["ٱللَّهُ","Аллах",41,21],["ٱلَّذِيٓ","Который",41,21]],[["أَنطَقَ","заставил говорить",41,21],["كُلَّ","всякую",41,21],["شَيۡءٖۚ","вещь",41,21],["وَهُوَ","и Он",41,21],["خَلَقَكُمۡ","сотворил вас",41,21],["أَوَّلَ","в первый",41,21],["مَرَّةٖ","раз",41,21],["وَإِلَيۡهِ","и к Нему",41,21],["تُرۡجَعُونَ","вы будете возвращены",41,21],[21]],[["وَمَا","И не",41,22],["كُنتُمۡ","вы",41,22],["تَسۡتَتِرُونَ","укрывались",41,22],["أَن","чтобы (не)",41,22],["يَشۡهَدَ","свидетельствовал",41,22],["عَلَيۡكُمۡ","против вас",41,22],["سَمۡعُكُمۡ","ваш слух",41,22],["وَلَآ","и не",41,22],["أَبۡصَٰرُكُمۡ","ваши взоры",41,22]],[["وَلَا","и не",41,22],["جُلُودُكُمۡ","ваша кожа",41,22],["وَلَٰكِن","но",41,22],["ظَنَنتُمۡ","вы предполагали",41,22],["أَنَّ","что",41,22],["ٱللَّهَ","Аллах",41,22],["لَا","не",41,22],["يَعۡلَمُ","знает",41,22],["كَثِيرٗا","многого",41,22],["مِّمَّا","из того, что",41,22],["تَعۡمَلُونَ","вы делаете",41,22]],[[22],["وَذَٰلِكُمۡ","И это",41,23],["ظَنُّكُمُ","ваше предположение",41,23],["ٱلَّذِي","которое",41,23],["ظَنَنتُم","вы предполагали",41,23],["بِرَبِّكُمۡ","о вашем Господе",41,23],["أَرۡدَىٰكُمۡ","погубило вас",41,23],["فَأَصۡبَحۡتُم","и вы оказались",41,23]],[["مِّنَ","из числа",41,23],["ٱلۡخَٰسِرِينَ","потерпевших убыток",41,23],[23],["فَإِن","И если",41,24],["يَصۡبِرُواْ","они проявят терпение",41,24],["فَٱلنَّارُ","то Огонь",41,24],["مَثۡوٗى","обитель",41,24],["لَّهُمۡۖ","для них",41,24],["وَإِن","а если",41,24]],[["يَسۡتَعۡتِبُواْ","они попросят благосклонности",41,24],["فَمَا","то не",41,24],["هُم","они",41,24],["مِّنَ","из числа",41,24],["ٱلۡمُعۡتَبِينَ","получивших благосклонность",41,24],[24],["۞ وَقَيَّضۡنَا","И Мы приставили",41,25],["لَهُمۡ","к ним",41,25]],[["قُرَنَآءَ","спутников",41,25],["فَزَيَّنُواْ","и они приукрасили",41,25],["لَهُم","им",41,25],["مَّا","то, что",41,25],["بَيۡنَ","перед",41,25],["أَيۡدِيهِمۡ","ними",41,25],["وَمَا","и то, что",41,25],["خَلۡفَهُمۡ","позади них",41,25],["وَحَقَّ","и сбылось",41,25],["عَلَيۡهِمُ","над ними",41,25]],[["ٱلۡقَوۡلُ","Слово",41,25],["فِيٓ","среди",41,25],["أُمَمٖ","народов",41,25],["قَدۡ","уже",41,25],["خَلَتۡ","прошедших",41,25],["مِن","из",41,25],["قَبۡلِهِم","прежде них",41,25],["مِّنَ","из числа",41,25],["ٱلۡجِنِّ","джиннов",41,25],["وَٱلۡإِنسِۖ","и людей",41,25],["إِنَّهُمۡ","поистине, они",41,25]],[["كَانُواْ","были",41,25],["خَٰسِرِينَ","потерпевшими убыток",41,25],[25],["وَقَالَ","И сказали",41,26],["ٱلَّذِينَ","те, которые",41,26],["كَفَرُواْ","не уверовали",41,26],["لَا","Не",41,26],["تَسۡمَعُواْ","слушайте",41,26],["لِهَٰذَا","этот",41,26],["ٱلۡقُرۡءَانِ","Коран",41,26]],[["وَٱلۡغَوۡاْ","и шумите",41,26],["فِيهِ","при нём",41,26],["لَعَلَّكُمۡ","может быть, вы",41,26],["تَغۡلِبُونَ","одержите верх",41,26],[26],["فَلَنُذِيقَنَّ","И Мы непременно дадим вкусить",41,27],["ٱلَّذِينَ","тем, которые",41,27],["كَفَرُواْ","не уверовали",41,27],["عَذَابٗا","наказание",41,27]],[["شَدِيدٗا","суровое",41,27],["وَلَنَجۡزِيَنَّهُمۡ","и непременно воздадим им",41,27],["أَسۡوَأَ","худшим",41,27],["ٱلَّذِي","из того, что",41,27],["كَانُواْ","они",41,27],["يَعۡمَلُونَ","совершали",41,27],[27],["ذَٰلِكَ","Это",41,28],["جَزَآءُ","воздаяние",41,28]],[["أَعۡدَآءِ","врагов",41,28],["ٱللَّهِ","Аллаха",41,28],["ٱلنَّارُۖ","Огонь",41,28],["لَهُمۡ","им",41,28],["فِيهَا","в нём",41,28],["دَارُ","обитель",41,28],["ٱلۡخُلۡدِ","вечности",41,28],["جَزَآءَۢ","в воздаяние",41,28],["بِمَا","за то, что",41,28],["كَانُواْ","они",41,28],["بِـَٔايَٰتِنَا","Наши знамения",41,28],["يَجۡحَدُونَ","отвергали",41,28]],[[28],["وَقَالَ","И скажут",41,29],["ٱلَّذِينَ","те, которые",41,29],["كَفَرُواْ","не уверовали",41,29],["رَبَّنَآ","Господь наш",41,29],["أَرِنَا","Покажи нам",41,29],["ٱلَّذَيۡنِ","тех двоих, которые",41,29],["أَضَلَّانَا","сбили нас с пути",41,29],["مِنَ","из",41,29],["ٱلۡجِنِّ","джиннов",41,29]],[["وَٱلۡإِنسِ","и людей",41,29],["نَجۡعَلۡهُمَا","мы поместим их",41,29],["تَحۡتَ","под",41,29],["أَقۡدَامِنَا","нашими ногами",41,29],["لِيَكُونَا","чтобы были они",41,29],["مِنَ","из",41,29],["ٱلۡأَسۡفَلِينَ","самых низших",41,29],[29]]]}