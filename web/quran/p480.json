{"p":480,"j":24,"a":[[41,30,["إِنَّ","ٱلَّذِينَ","قَالُواْ","رَبُّنَا","ٱللَّهُ","ثُمَّ","ٱسۡتَقَٰمُواْ","تَتَنَزَّلُ","عَلَيۡهِمُ","ٱلۡمَلَٰٓئِكَةُ","أَلَّا","تَخَافُواْ","وَلَا","تَحۡزَنُواْ","وَأَبۡشِرُواْ","بِٱلۡجَنَّةِ","ٱلَّتِي","كُنتُمۡ","تُوعَدُونَ"],"иннал лазиина ḳалуу раббуналлаху суммастаḳамуу татаназзалу `алайхимул малаикату алла тахафуу вала тахзануу ва'абшируу билжаннатил латии кунтум туу`адуун","Воистину, к тем, которые сказали: «Наш Господь - Аллах», - а потом были стойки, нисходят ангелы: «Не бойтесь и не печальтесь, а возрадуйтесь Раю, который был обещан вам.",["Поистине","те, которые","сказали","Господь наш","Аллах","затем","были стойки","нисходят","на них","ангелы","Не","бойтесь","и не","печальтесь","и радуйтесь","Раю","который","вам были","обещаны"]],[41,31,["نَحۡنُ","أَوۡلِيَآؤُكُمۡ","فِي","ٱلۡحَيَوٰةِ","ٱلدُّنۡيَا","وَفِي","ٱلۡأٓخِرَةِۖ","وَلَكُمۡ","فِيهَا","مَا","تَشۡتَهِيٓ","أَنفُسُكُمۡ","وَلَكُمۡ","فِيهَا","مَا","تَدَّعُونَ"],"нахну аулийаукум фил хайаватид дунйа вафил ахирати валакум фииха ма таштахии анфусукум валакум фииха ма тадда`уун","Мы - ваши помощники (или хранители) в мирской жизни и Последней жизни. Вам там уготовано все, чего пожелают ваши души! Вам там уготовано все, о чем вы попросите!",["Мы","ваши покровители","в","жизни","мирской","и в","Последней жизни","и для вас","в нём","то, что","пожелают","ваши души","и для вас","в нём","то, что","вы попросите"]],[41,32,["نُزُلٗا","مِّنۡ","غَفُورٖ","رَّحِيمٖ"],"нузулам мин гафуурир рахиим","Таково угощение от Прощающего, Милосердного».",["Угощение","от","Прощающего","Милосердного"]],[41,33,["وَمَنۡ","أَحۡسَنُ","قَوۡلٗا","مِّمَّن","دَعَآ","إِلَى","ٱللَّهِ","وَعَمِلَ","صَٰلِحٗا","وَقَالَ","إِنَّنِي","مِنَ","ٱلۡمُسۡلِمِينَ"],"ваман ахсану ḳаулам мимман да`а илаллахи ва`амила салихан ваḳала иннании минал муслимиин","Чья речь прекраснее, чем речь того, кто призывает к Аллаху, поступает праведно и говорит: «Воистину, я - один из мусульман»?",["И кто","прекраснее","речью","чем тот, кто","призывает","к","Аллаху","и совершает","праведное","и говорит","Поистине, я","из","мусульман"]],[41,34,["وَلَا","تَسۡتَوِي","ٱلۡحَسَنَةُ","وَلَا","ٱلسَّيِّئَةُۚ","ٱدۡفَعۡ","بِٱلَّتِي","هِيَ","أَحۡسَنُ","فَإِذَا","ٱلَّذِي","بَيۡنَكَ","وَبَيۡنَهُۥ","عَدَٰوَةٞ","كَأَنَّهُۥ","وَلِيٌّ","حَمِيمٞ"],"вала таставил хасанату валас саййиатудфа` биллатии хийа ахсану фа'изал лазии байнака вабайнахуу `адаватун ка'аннахуу валиййун хамиим","Не равны добро и зло. Оттолкни зло тем, что лучше, и тогда тот, с кем ты враждуешь, станет для тебя словно близкий любящий родственник.",["И не","равны","добро","и не","зло","Отталкивай","тем, что","оно","лучше","и вот","тот, у кого","между тобой","и между ним","вражда","словно он","друг","близкий"]],[41,35,["وَمَا","يُلَقَّىٰهَآ","إِلَّا","ٱلَّذِينَ","صَبَرُواْ","وَمَا","يُلَقَّىٰهَآ","إِلَّا","ذُو","حَظٍّ","عَظِيمٖ"],"вама йулаḳḳаха иллал лазиина сабаруу вама йулаḳḳаха илла зуу хаззин `азиим","Но не будет это даровано никому, кроме тех, кто проявляет терпение, и не будет это даровано никому, кроме тех, кто обладает великой долей.",["И не","даруется это","кроме как","тем, которые","проявили терпение","и не","даруется это","кроме как","обладателю","доли","великой"]],[41,36,["وَإِمَّا","يَنزَغَنَّكَ","مِنَ","ٱلشَّيۡطَٰنِ","نَزۡغٞ","فَٱسۡتَعِذۡ","بِٱللَّهِۖ","إِنَّهُۥ","هُوَ","ٱلسَّمِيعُ","ٱلۡعَلِيمُ"],"ва'имма йанзаганнака минаш шайтани назгун фаста`из биллахи иннахуу хуас самии`ул `алиим","А если тебя коснется наваждение от дьявола, то прибегай к защите Аллаха, ибо Он - Слышащий, Знающий.",["А если","коснётся тебя","от","сатаны","наваждение","то ищи защиты","у Аллаха","поистине, Он","Он","Слышащий","Знающий"]],[41,37,["وَمِنۡ","ءَايَٰتِهِ","ٱلَّيۡلُ","وَٱلنَّهَارُ","وَٱلشَّمۡسُ","وَٱلۡقَمَرُۚ","لَا","تَسۡجُدُواْ","لِلشَّمۡسِ","وَلَا","لِلۡقَمَرِ","وَٱسۡجُدُواْۤ","لِلَّهِۤ","ٱلَّذِي","خَلَقَهُنَّ","إِن","كُنتُمۡ","إِيَّاهُ","تَعۡبُدُونَ"],"вамин айатихил лайлу ваннахару вашшамсу валḳамару ла тасжудуу лишшамси вала лилḳамари васжудуу лиллахил лазии халаḳахунна ин кунтум иййаху та`будуун","Среди Его знамений - ночь и день, солнце и луна. Не падайте ниц перед солнцем и луной, а падайте ниц перед Аллахом, Который сотворил их, если Ему вы поклоняетесь.",["И из","Его знамений","ночь","и день","и солнце","и луна","Не","падайте ниц","перед солнцем","и не","перед луной","и падайте ниц","перед Аллахом","Который","сотворил их","если","вы","Ему (одному)","поклоняетесь"]],[41,38,["فَإِنِ","ٱسۡتَكۡبَرُواْ","فَٱلَّذِينَ","عِندَ","رَبِّكَ","يُسَبِّحُونَ","لَهُۥ","بِٱلَّيۡلِ","وَٱلنَّهَارِ","وَهُمۡ","لَا","يَسۡـَٔمُونَ ۩"],"фа'инистакбаруу фаллазиина `инда раббика йусаббихууна лахуу биллайли ваннахари вахум ла йас'амуун","Если же они возгордятся, то ведь находящиеся возле твоего Господа прославляют Его ночью и днем, и им это не наскучивает.",["А если","они возгордились","то те, которые","у","твоего Господа","прославляют","Его","ночью","и днём","и они","не","утомляются"]]],"m":[[["إِنَّ","Поистине",41,30],["ٱلَّذِينَ","те, которые",41,30],["قَالُواْ","сказали",41,30],["رَبُّنَا","Господь наш",41,30],["ٱللَّهُ","Аллах",41,30],["ثُمَّ","затем",41,30],["ٱسۡتَقَٰمُواْ","были стойки",41,30],["تَتَنَزَّلُ","нисходят",41,30],["عَلَيۡهِمُ","на них",41,30]],[["ٱلۡمَلَٰٓئِكَةُ","ангелы",41,30],["أَلَّا","Не",41,30],["تَخَافُواْ","бойтесь",41,30],["وَلَا","и не",41,30],["تَحۡزَنُواْ","печальтесь",41,30],["وَأَبۡشِرُواْ","и радуйтесь",41,30],["بِٱلۡجَنَّةِ","Раю",41,30]],[["ٱلَّتِي","который",41,30],["كُنتُمۡ","вам были",41,30],["تُوعَدُونَ","обещаны",41,30],[30],["نَحۡنُ","Мы",41,31],["أَوۡلِيَآؤُكُمۡ","ваши покровители",41,31],["فِي","в",41,31],["ٱلۡحَيَوٰةِ","жизни",41,31]],[["ٱلدُّنۡيَا","мирской",41,31],["وَفِي","и в",41,31],["ٱلۡأٓخِرَةِۖ","Последней жизни",41,31],["وَلَكُمۡ","и для вас",41,31],["فِيهَا","в нём",41,31],["مَا","то, что",41,31],["تَشۡتَهِيٓ","пожелают",41,31],["أَنفُسُكُمۡ","ваши души",41,31]],[["وَلَكُمۡ","и для вас",41,31],["فِيهَا","в нём",41,31],["مَا","то, что",41,31],["تَدَّعُونَ","вы попросите",41,31],[31],["نُزُلٗا","Угощение",41,32],["مِّنۡ","от",41,32],["غَفُورٖ","Прощающего",41,32],["رَّحِيمٖ","Милосердного",41,32],[32]],[["وَمَنۡ","И кто",41,33],["أَحۡسَنُ","прекраснее",41,33],["قَوۡلٗا","речью",41,33],["مِّمَّن","чем тот, кто",41,33],["دَعَآ","призывает",41,33],["إِلَى","к",41,33],["ٱللَّهِ","Аллаху",41,33],["وَعَمِلَ","и совершает",41,33],["صَٰلِحٗا","праведное",41,33],["وَقَالَ","и говорит",41,33]],[["إِنَّنِي","Поистине, я",41,33],["مِنَ","из",41,33],["ٱلۡمُسۡلِمِينَ","мусульман",41,33],[33],["وَلَا","И не",41,34],["تَسۡتَوِي","равны",41,34],["ٱلۡحَسَنَةُ","добро",41,34],["وَلَا","и не",41,34],["ٱلسَّيِّئَةُۚ","зло",41,34]],[["ٱدۡفَعۡ","Отталкивай",41,34],["بِٱلَّتِي","тем, что",41,34],["هِيَ","оно",41,34],["أَحۡسَنُ","лучше",41,34],["فَإِذَا","и вот",41,34],["ٱلَّذِي","тот, у кого",41,34],["بَيۡنَكَ","между тобой",41,34],["وَبَيۡنَهُۥ","и между ним",41,34],["عَدَٰوَةٞ","вражда",41,34],["كَأَنَّهُۥ","словно он",41,34]],[["وَلِيٌّ","друг",41,34],["حَمِيمٞ","близкий",41,34],[34],["وَمَا","И не",41,35],["يُلَقَّىٰهَآ","даруется это",41,35],["إِلَّا","кроме как",41,35],["ٱلَّذِينَ","тем, которые",41,35],["صَبَرُواْ","проявили терпение",41,35],["وَمَا","и не",41,35],["يُلَقَّىٰهَآ","даруется это",41,35]],[["إِلَّا","кроме как",41,35],["ذُو","обладателю",41,35],["حَظٍّ","доли",41,35],["عَظِيمٖ","великой",41,35],[35],["وَإِمَّا","А если",41,36],["يَنزَغَنَّكَ","коснётся тебя",41,36],["مِنَ","от",41,36],["ٱلشَّيۡطَٰنِ","сатаны",41,36],["نَزۡغٞ","наваждение",41,36]],[["فَٱسۡتَعِذۡ","то ищи защиты",41,36],["بِٱللَّهِۖ","у Аллаха",41,36],["إِنَّهُۥ","поистине, Он",41,36],["هُوَ","Он",41,36],["ٱلسَّمِيعُ","Слышащий",41,36],["ٱلۡعَلِيمُ","Знающий",41,36],[36],["وَمِنۡ","И из",41,37],["ءَايَٰتِهِ","Его знамений",41,37]],[["ٱلَّيۡلُ","ночь",41,37],["وَٱلنَّهَارُ","и день",41,37],["وَٱلشَّمۡسُ","и солнце",41,37],["وَٱلۡقَمَرُۚ","и луна",41,37],["لَا","Не",41,37],["تَسۡجُدُواْ","падайте ниц",41,37],["لِلشَّمۡسِ","перед солнцем",41,37]],[["وَلَا","и не",41,37],["لِلۡقَمَرِ","перед луной",41,37],["وَٱسۡجُدُواْۤ","и падайте ниц",41,37],["لِلَّهِۤ","перед Аллахом",41,37],["ٱلَّذِي","Который",41,37],["خَلَقَهُنَّ","сотворил их",41,37],["إِن","если",41,37],["كُنتُمۡ","вы",41,37]],[["إِيَّاهُ","Ему (одному)",41,37],["تَعۡبُدُونَ","поклоняетесь",41,37],[37],["فَإِنِ","А если",41,38],["ٱسۡتَكۡبَرُواْ","они возгордились",41,38],["فَٱلَّذِينَ","то те, которые",41,38],["عِندَ","у",41,38]],[["رَبِّكَ","твоего Господа",41,38],["يُسَبِّحُونَ","прославляют",41,38],["لَهُۥ","Его",41,38],["بِٱلَّيۡلِ","ночью",41,38],["وَٱلنَّهَارِ","и днём",41,38],["وَهُمۡ","и они",41,38],["لَا","не",41,38],["يَسۡـَٔمُونَ ۩","утомляются",41,38],[38]]]}