{"p":481,"j":24,"a":[[41,39,["وَمِنۡ","ءَايَٰتِهِۦٓ","أَنَّكَ","تَرَى","ٱلۡأَرۡضَ","خَٰشِعَةٗ","فَإِذَآ","أَنزَلۡنَا","عَلَيۡهَا","ٱلۡمَآءَ","ٱهۡتَزَّتۡ","وَرَبَتۡۚ","إِنَّ","ٱلَّذِيٓ","أَحۡيَاهَا","لَمُحۡيِ","ٱلۡمَوۡتَىٰٓۚ","إِنَّهُۥ","عَلَىٰ","كُلِّ","شَيۡءٖ","قَدِيرٌ"],"вамин айатихии аннака тарал арда хаши`атан фа'иза анзална `алайхал маахтаззат варабат иннал лазии ахйаха ламухйил маута иннахуу `ала кулли шай'ин ḳадиир","Среди Его знамений - то, что ты видишь землю иссохшей, но когда Мы ниспосылаем на нее воду, она приходит в движение и набухает. Воистину, Тот, Кто оживил ее, непременно оживит мертвецов. Он способен на всякую вещь.",["И из","Его знамений","что ты","видишь","землю","смиренной (иссохшей)","но когда","Мы ниспослали","на неё","воду","она пришла в движение","и набухла","Поистине","Тот, Кто","оживил её","непременно оживит","мёртвых","поистине, Он","над","всякой","вещью","Всемогущ"]],[41,40,["إِنَّ","ٱلَّذِينَ","يُلۡحِدُونَ","فِيٓ","ءَايَٰتِنَا","لَا","يَخۡفَوۡنَ","عَلَيۡنَآۗ","أَفَمَن","يُلۡقَىٰ","فِي","ٱلنَّارِ","خَيۡرٌ","أَم","مَّن","يَأۡتِيٓ","ءَامِنٗا","يَوۡمَ","ٱلۡقِيَٰمَةِۚ","ٱعۡمَلُواْ","مَا","شِئۡتُمۡ","إِنَّهُۥ","بِمَا","تَعۡمَلُونَ","بَصِيرٌ"],"иннал лазиина йулхидууна фии айатина ла йахфауна `алайна афаман йулḳа фин нари хайрун ам ман йа'тии аминан йаумал ḳийамати`малуу ма ши'тум иннахуу бима та`малууна басиир","Воистину, те, которые уклоняются от истины в отношении Наших аятов, не сокрыты от Нас. Тот, кто будет брошен в Огонь, лучше или тот, кто в День воскресения явится, будучи в безопасности? Поступайте, как пожелаете! Он видит то, что вы совершаете.",["Поистине","те, которые","уклоняются","в","Наших знамениях","не","сокрыты","от Нас","Разве тот, кто","брошен будет","в","Огонь","лучше","или","тот, кто","придёт","в безопасности","в День","воскресения","Делайте","что","пожелали","поистине, Он","то, что","вы делаете","Видящий"]],[41,41,["إِنَّ","ٱلَّذِينَ","كَفَرُواْ","بِٱلذِّكۡرِ","لَمَّا","جَآءَهُمۡۖ","وَإِنَّهُۥ","لَكِتَٰبٌ","عَزِيزٞ"],"иннал лазиина кафаруу биззикри ламма жаахум ва'иннахуу лакитабун `азииз","Воистину, те, которые не уверовали в Напоминание, когда оно дошло до них, будут наказаны. Воистину, это - могущественное Писание.",["Поистине","те, которые","не уверовали","в Напоминание","когда","оно пришло к ним","и поистине, оно","непременно Писание","могущественное"]],[41,42,["لَّا","يَأۡتِيهِ","ٱلۡبَٰطِلُ","مِنۢ","بَيۡنِ","يَدَيۡهِ","وَلَا","مِنۡ","خَلۡفِهِۦۖ","تَنزِيلٞ","مِّنۡ","حَكِيمٍ","حَمِيدٖ"],"лла йа'тиихил батилу мим байни йадайхи вала мин халфихии танзиилум мин хакиимин хамиид","Ложь не подберется к нему ни спереди, ни сзади. Оно ниспослано от Мудрого, Достохвального.",["Не","придёт к нему","ложь","ни с","перед","ним","и не","с","тыла его","Ниспослание","от","Мудрого","Достохвального"]],[41,43,["مَّا","يُقَالُ","لَكَ","إِلَّا","مَا","قَدۡ","قِيلَ","لِلرُّسُلِ","مِن","قَبۡلِكَۚ","إِنَّ","رَبَّكَ","لَذُو","مَغۡفِرَةٖ","وَذُو","عِقَابٍ","أَلِيمٖ"],"мма йуḳалу лака илла ма ḳад ḳиила лиррусули мин ḳаблика инна раббака лазуу магфиратин вазуу `иḳабин алиим","Тебе будет сказано только то, что было сказано посланникам до тебя. Воистину, твой Господь обладает прощением и обладает мучительным наказанием.",["Не","говорится","тебе","кроме","того, что","уже","было сказано","посланникам","из","прежде тебя","Поистине","твой Господь","непременно Обладатель","прощения","и Обладатель","наказания","мучительного"]],[41,44,["وَلَوۡ","جَعَلۡنَٰهُ","قُرۡءَانًا","أَعۡجَمِيّٗا","لَّقَالُواْ","لَوۡلَا","فُصِّلَتۡ","ءَايَٰتُهُۥٓۖ","ءَا۬عۡجَمِيّٞ","وَعَرَبِيّٞۗ","قُلۡ","هُوَ","لِلَّذِينَ","ءَامَنُواْ","هُدٗى","وَشِفَآءٞۚ","وَٱلَّذِينَ","لَا","يُؤۡمِنُونَ","فِيٓ","ءَاذَانِهِمۡ","وَقۡرٞ","وَهُوَ","عَلَيۡهِمۡ","عَمًىۚ","أُوْلَٰٓئِكَ","يُنَادَوۡنَ","مِن","مَّكَانِۭ","بَعِيدٖ"],"валау жа`алнаху ḳур'анан а`жамиййал лаḳалуу лаула фуссилат айатухуу а`жамиййун ва`арабиййун ḳул хуа лиллазиина амануу худан вашифаун валлазиина ла йу'минууна фии азанихим ваḳрун вахуа `алайхим `аман улаика йунадауна мим макани ба`иид","Если бы Мы сделали его Кораном не на арабском языке, то они непременно сказали бы: «Почему его аяты не разъяснены? Неарабская речь и араб?». Скажи: «Он является верным руководством и исцелением для тех, которые уверовали. А уши неверующих поражены глухотой, и они слепы к нему. Это - те, к которым взывают издалека».",["И если бы","Мы сделали его","Кораном","неарабским","непременно сказали бы они","Почему не","разъяснены","его аяты","Неарабский","и арабский","Скажи","Он","для тех, которые","уверовали","верное руководство","и исцеление","а те, которые","не","веруют","в","их ушах","глухота","и он","для них","слепота","Те","призываемы","из","места","далёкого"]],[41,45,["وَلَقَدۡ","ءَاتَيۡنَا","مُوسَى","ٱلۡكِتَٰبَ","فَٱخۡتُلِفَ","فِيهِۚ","وَلَوۡلَا","كَلِمَةٞ","سَبَقَتۡ","مِن","رَّبِّكَ","لَقُضِيَ","بَيۡنَهُمۡۚ","وَإِنَّهُمۡ","لَفِي","شَكّٖ","مِّنۡهُ","مُرِيبٖ"],"валаḳад атайна муусал китаба фахтулифа фиихи валаула калиматун сабаḳат мир раббика лаḳудийа байнахум ва'иннахум лафии шакким минху мурииб","Мы даровали Мусе (Моисею) Писание, но по его поводу возникли разногласия. И если бы не было прежде Слова от твоего Господа, то спор их был бы решен. Воистину, они испытывают смутные сомнения относительно него (Корана).",["И уже","Мы дали","Мусе","Писание","но возникли разногласия","о нём","и если бы не","слово","предшествовавшее","от","твоего Господа","непременно было бы решено","между ними","и поистине, они","непременно в","сомнении","о нём","тревожном"]],[41,46,["مَّنۡ","عَمِلَ","صَٰلِحٗا","فَلِنَفۡسِهِۦۖ","وَمَنۡ","أَسَآءَ","فَعَلَيۡهَاۗ","وَمَا","رَبُّكَ","بِظَلَّٰمٖ","لِّلۡعَبِيدِ"],"мман `амила салихан фалинафсихии ваман асаа фа`алайха вама раббука бизалламил лил`абиид","Кто поступает праведно, тот поступает во благо себе. А кто творит зло, тот поступает во вред себе. Господь твой не поступает несправедливо со Своими рабами.",["Кто","совершил","праведное","то для его же души","а кто","сотворил зло","то против неё","И не","твой Господь","несправедлив","к рабам"]]],"m":[[["وَمِنۡ","И из",41,39],["ءَايَٰتِهِۦٓ","Его знамений",41,39],["أَنَّكَ","что ты",41,39],["تَرَى","видишь",41,39],["ٱلۡأَرۡضَ","землю",41,39],["خَٰشِعَةٗ","смиренной (иссохшей)",41,39],["فَإِذَآ","но когда",41,39],["أَنزَلۡنَا","Мы ниспослали",41,39],["عَلَيۡهَا","на неё",41,39],["ٱلۡمَآءَ","воду",41,39]],[["ٱهۡتَزَّتۡ","она пришла в движение",41,39],["وَرَبَتۡۚ","и набухла",41,39],["إِنَّ","Поистине",41,39],["ٱلَّذِيٓ","Тот, Кто",41,39],["أَحۡيَاهَا","оживил её",41,39],["لَمُحۡيِ","непременно оживит",41,39],["ٱلۡمَوۡتَىٰٓۚ","мёртвых",41,39],["إِنَّهُۥ","поистине, Он",41,39],["عَلَىٰ","над",41,39],["كُلِّ","всякой",41,39],["شَيۡءٖ","вещью",41,39]],[["قَدِيرٌ","Всемогущ",41,39],[39],["إِنَّ","Поистине",41,40],["ٱلَّذِينَ","те, которые",41,40],["يُلۡحِدُونَ","уклоняются",41,40],["فِيٓ","в",41,40],["ءَايَٰتِنَا","Наших знамениях",41,40],["لَا","не",41,40],["يَخۡفَوۡنَ","сокрыты",41,40],["عَلَيۡنَآۗ","от Нас",41,40],["أَفَمَن","Разве тот, кто",41,40]],[["يُلۡقَىٰ","брошен будет",41,40],["فِي","в",41,40],["ٱلنَّارِ","Огонь",41,40],["خَيۡرٌ","лучше",41,40],["أَم","или",41,40],["مَّن","тот, кто",41,40],["يَأۡتِيٓ","придёт",41,40],["ءَامِنٗا","в безопасности",41,40],["يَوۡمَ","в День",41,40],["ٱلۡقِيَٰمَةِۚ","воскресения",41,40],["ٱعۡمَلُواْ","Делайте",41,40],["مَا","что",41,40],["شِئۡتُمۡ","пожелали",41,40]],[["إِنَّهُۥ","поистине, Он",41,40],["بِمَا","то, что",41,40],["تَعۡمَلُونَ","вы делаете",41,40],["بَصِيرٌ","Видящий",41,40],[40],["إِنَّ","Поистине",41,41],["ٱلَّذِينَ","те, которые",41,41],["كَفَرُواْ","не уверовали",41,41],["بِٱلذِّكۡرِ","в Напоминание",41,41],["لَمَّا","когда",41,41],["جَآءَهُمۡۖ","оно пришло к ним",41,41]],[["وَإِنَّهُۥ","и поистине, оно",41,41],["لَكِتَٰبٌ","непременно Писание",41,41],["عَزِيزٞ","могущественное",41,41],[41],["لَّا","Не",41,42],["يَأۡتِيهِ","придёт к нему",41,42],["ٱلۡبَٰطِلُ","ложь",41,42],["مِنۢ","ни с",41,42],["بَيۡنِ","перед",41,42],["يَدَيۡهِ","ним",41,42],["وَلَا","и не",41,42],["مِنۡ","с",41,42]],[["خَلۡفِهِۦۖ","тыла его",41,42],["تَنزِيلٞ","Ниспослание",41,42],["مِّنۡ","от",41,42],["حَكِيمٍ","Мудрого",41,42],["حَمِيدٖ","Достохвального",41,42],[42],["مَّا","Не",41,43],["يُقَالُ","говорится",41,43],["لَكَ","тебе",41,43],["إِلَّا","кроме",41,43],["مَا","того, что",41,43],["قَدۡ","уже",41,43],["قِيلَ","было сказано",41,43]],[["لِلرُّسُلِ","посланникам",41,43],["مِن","из",41,43],["قَبۡلِكَۚ","прежде тебя",41,43],["إِنَّ","Поистине",41,43],["رَبَّكَ","твой Господь",41,43],["لَذُو","непременно Обладатель",41,43],["مَغۡفِرَةٖ","прощения",41,43],["وَذُو","и Обладатель",41,43],["عِقَابٍ","наказания",41,43],["أَلِيمٖ","мучительного",41,43],[43]],[["وَلَوۡ","И если бы",41,44],["جَعَلۡنَٰهُ","Мы сделали его",41,44],["قُرۡءَانًا","Кораном",41,44],["أَعۡجَمِيّٗا","неарабским",41,44],["لَّقَالُواْ","непременно сказали бы они",41,44],["لَوۡلَا","Почему не",41,44],["فُصِّلَتۡ","разъяснены",41,44],["ءَايَٰتُهُۥٓۖ","его аяты",41,44],["ءَا۬عۡجَمِيّٞ","Неарабский",41,44]],[["وَعَرَبِيّٞۗ","и арабский",41,44],["قُلۡ","Скажи",41,44],["هُوَ","Он",41,44],["لِلَّذِينَ","для тех, которые",41,44],["ءَامَنُواْ","уверовали",41,44],["هُدٗى","верное руководство",41,44],["وَشِفَآءٞۚ","и исцеление",41,44],["وَٱلَّذِينَ","а те, которые",41,44]],[["لَا","не",41,44],["يُؤۡمِنُونَ","веруют",41,44],["فِيٓ","в",41,44],["ءَاذَانِهِمۡ","их ушах",41,44],["وَقۡرٞ","глухота",41,44],["وَهُوَ","и он",41,44],["عَلَيۡهِمۡ","для них",41,44],["عَمًىۚ","слепота",41,44],["أُوْلَٰٓئِكَ","Те",41,44]],[["يُنَادَوۡنَ","призываемы",41,44],["مِن","из",41,44],["مَّكَانِۭ","места",41,44],["بَعِيدٖ","далёкого",41,44],[44],["وَلَقَدۡ","И уже",41,45],["ءَاتَيۡنَا","Мы дали",41,45],["مُوسَى","Мусе",41,45],["ٱلۡكِتَٰبَ","Писание",41,45]],[["فَٱخۡتُلِفَ","но возникли разногласия",41,45],["فِيهِۚ","о нём",41,45],["وَلَوۡلَا","и если бы не",41,45],["كَلِمَةٞ","слово",41,45],["سَبَقَتۡ","предшествовавшее",41,45],["مِن","от",41,45],["رَّبِّكَ","твоего Господа",41,45],["لَقُضِيَ","непременно было бы решено",41,45]],[["بَيۡنَهُمۡۚ","между ними",41,