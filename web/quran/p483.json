{"p":483,"j":25,"a":[[42,1,["حمٓ"],"хм","Ха. Мим.",["Ха Мим"]],[42,2,["عٓسٓقٓ"],"`сḳ","Айн. Син. Каф.",["Айн Син Каф"]],[42,3,["كَذَٰلِكَ","يُوحِيٓ","إِلَيۡكَ","وَإِلَى","ٱلَّذِينَ","مِن","قَبۡلِكَ","ٱللَّهُ","ٱلۡعَزِيزُ","ٱلۡحَكِيمُ"],"казалика йуухии илайка ва'илал лазиина мин ḳабликаллахул `азиизул хакиим","Так внушает откровение тебе и твоим предшественникам Аллах Могущественный, Мудрый.",["так","внушает","тебе","и к","тем, которые","из","прежде тебя","Аллах","Могущественный","Мудрый"]],[42,4,["لَهُۥ","مَا","فِي","ٱلسَّمَٰوَٰتِ","وَمَا","فِي","ٱلۡأَرۡضِۖ","وَهُوَ","ٱلۡعَلِيُّ","ٱلۡعَظِيمُ"],"лахуу ма фис самавати вама фил арди вахуал `алиййул `азиим","Ему принадлежит то, что на небесах, и то, что на земле. Он - Возвышенный, Великий.",["Ему","то, что","на","небесах","и то, что","на","земле","и Он","Высочайший","Великий"]],[42,5,["تَكَادُ","ٱلسَّمَٰوَٰتُ","يَتَفَطَّرۡنَ","مِن","فَوۡقِهِنَّۚ","وَٱلۡمَلَٰٓئِكَةُ","يُسَبِّحُونَ","بِحَمۡدِ","رَبِّهِمۡ","وَيَسۡتَغۡفِرُونَ","لِمَن","فِي","ٱلۡأَرۡضِۗ","أَلَآ","إِنَّ","ٱللَّهَ","هُوَ","ٱلۡغَفُورُ","ٱلرَّحِيمُ"],"такадус самавату йатафаттарна мин фауḳихинна валмалаикату йусаббихууна бихамди раббихим вайастагфирууна лиман фил арди ала инналлаха хуал гафуурур рахиим","Небеса готовы разверзнуться сверху (от величия Аллаха; или от многочисленных ангелов; или от слов многобожников). Ангелы прославляют хвалой своего Господа и просят прощения для тех, кто на земле. Воистину, Аллах - Прощающий, Милосердный.",["почти","небеса","раскалываются","с","верха их","а ангелы","прославляют","хвалою","Господа их","и просят прощения","для тех, кто","на","земле","о да","поистине","Аллах","Он","Прощающий","Милосердный"]],[42,6,["وَٱلَّذِينَ","ٱتَّخَذُواْ","مِن","دُونِهِۦٓ","أَوۡلِيَآءَ","ٱللَّهُ","حَفِيظٌ","عَلَيۡهِمۡ","وَمَآ","أَنتَ","عَلَيۡهِم","بِوَكِيلٖ"],"валлазиинаттахазуу мин дуунихии аулийааллаху хафиизун `алайхим вама анта `алайхим бивакиил","Аллах является Хранителем для тех, которые взяли себе иных покровителей и помощников помимо Него (сохраняет их злодеяния для того, чтобы они получили воздаяние), и ты не являешься их попечителем и хранителем.",["а те, которые","взяли","помимо","Него","покровителей","Аллах","Хранитель","над ними","и не","ты","над ними","попечитель"]],[42,7,["وَكَذَٰلِكَ","أَوۡحَيۡنَآ","إِلَيۡكَ","قُرۡءَانًا","عَرَبِيّٗا","لِّتُنذِرَ","أُمَّ","ٱلۡقُرَىٰ","وَمَنۡ","حَوۡلَهَا","وَتُنذِرَ","يَوۡمَ","ٱلۡجَمۡعِ","لَا","رَيۡبَ","فِيهِۚ","فَرِيقٞ","فِي","ٱلۡجَنَّةِ","وَفَرِيقٞ","فِي","ٱلسَّعِيرِ"],"ваказалика аухайна илайка ḳур'анан `арабиййал литунзира уммал ḳура ваман хаулаха ватунзира йаумал жам`и ла райба фиихи фарииḳун фил жаннати вафарииḳун фис са`иир","Так Мы внушили тебе в откровении Коран на арабском языке, чтобы ты предостерегал Мать селений (жителей Мекки) и тех, кто вокруг нее, и предостерегал от Дня собрания, в котором нет сомнения. Одна часть людей окажется в Раю, а другая часть окажется в Пламени.",["и так","Мы внушили","тебе","Коран","арабский","чтобы ты предостерёг","мать","селений","и тех, кто","вокруг неё","и предостерёг","о Дне","собрания","нет","сомнения","в нём","часть","в","Раю","и часть","в","Пламени"]],[42,8,["وَلَوۡ","شَآءَ","ٱللَّهُ","لَجَعَلَهُمۡ","أُمَّةٗ","وَٰحِدَةٗ","وَلَٰكِن","يُدۡخِلُ","مَن","يَشَآءُ","فِي","رَحۡمَتِهِۦۚ","وَٱلظَّٰلِمُونَ","مَا","لَهُم","مِّن","وَلِيّٖ","وَلَا","نَصِيرٍ"],"валау шааллаху лажа`алахум умматан вахидатан валакин йудхилу ман йашау фии рахматихии ваззалимууна ма лахум мин валиййин вала насиир","Если бы Аллах пожелал, то сделал бы их одной общиной верующих. Однако Он вводит в Свою милость того, кого пожелает. А у беззаконников не будет ни покровителя, ни помощника.",["и если бы","пожелал","Аллах","непременно сделал бы их","общиной","единой","но","Он вводит","кого","пожелает","в","милость Свою","а беззаконники","нет","у них","никакого","покровителя","и не","помощника"]],[42,9,["أَمِ","ٱتَّخَذُواْ","مِن","دُونِهِۦٓ","أَوۡلِيَآءَۖ","فَٱللَّهُ","هُوَ","ٱلۡوَلِيُّ","وَهُوَ","يُحۡيِ","ٱلۡمَوۡتَىٰ","وَهُوَ","عَلَىٰ","كُلِّ","شَيۡءٖ","قَدِيرٞ"],"амиттахазуу мин дуунихии аулийаа фаллаху хуал валиййу вахуа йухйил маута вахуа `ала кулли шай'ин ḳадиир","Неужели они взяли себе покровителей и помощников вместо Него? Аллах является Покровителем. Он оживляет мертвых, и Он способен на всякую вещь.",["или же","взяли они","помимо","Него","покровителей","но Аллах","Он","Покровитель","и Он","оживляет","мёртвых","и Он","над","всякой","вещью","Всемогущ"]],[42,10,["وَمَا","ٱخۡتَلَفۡتُمۡ","فِيهِ","مِن","شَيۡءٖ","فَحُكۡمُهُۥٓ","إِلَى","ٱللَّهِۚ","ذَٰلِكُمُ","ٱللَّهُ","رَبِّي","عَلَيۡهِ","تَوَكَّلۡتُ","وَإِلَيۡهِ","أُنِيبُ"],"вамахталафтум фиихи мин шай'ин фахукмухуу илаллахи заликумуллаху раббии `алайхи таваккалту ва'илайхи унииб","Решение всего, в чем вы расходитесь во мнениях, остается за Аллахом. Скажи: «Таков Аллах, мой Господь! Я уповаю только на Него и к Нему обращаюсь».",["и то, в чём","разошлись вы","в нём","из","чего-либо","то решение его","за","Аллахом","таков","Аллах","Господь мой","на Него","я уповаю","и к Нему","я обращаюсь"]]],"m":[["h",42],["b"],[["حمٓ","Ха Мим",42,1],[1],["عٓسٓقٓ","Айн Син Каф",42,2],[2],["كَذَٰلِكَ","так",42,3],["يُوحِيٓ","внушает",42,3],["إِلَيۡكَ","тебе",42,3],["وَإِلَى","и к",42,3],["ٱلَّذِينَ","тем, которые",42,3],["مِن","из",42,3],["قَبۡلِكَ","прежде тебя",42,3]],[["ٱللَّهُ","Аллах",42,3],["ٱلۡعَزِيزُ","Могущественный",42,3],["ٱلۡحَكِيمُ","Мудрый",42,3],[3],["لَهُۥ","Ему",42,4],["مَا","то, что",42,4],["فِي","на",42,4],["ٱلسَّمَٰوَٰتِ","небесах",42,4],["وَمَا","и то, что",42,4],["فِي","на",42,4],["ٱلۡأَرۡضِۖ","земле",42,4],["وَهُوَ","и Он",42,4]],[["ٱلۡعَلِيُّ","Высочайший",42,4],["ٱلۡعَظِيمُ","Великий",42,4],[4],["تَكَادُ","почти",42,5],["ٱلسَّمَٰوَٰتُ","небеса",42,5],["يَتَفَطَّرۡنَ","раскалываются",42,5],["مِن","с",42,5],["فَوۡقِهِنَّۚ","верха их",42,5]],[["وَٱلۡمَلَٰٓئِكَةُ","а ангелы",42,5],["يُسَبِّحُونَ","прославляют",42,5],["بِحَمۡدِ","хвалою",42,5],["رَبِّهِمۡ","Господа их",42,5],["وَيَسۡتَغۡفِرُونَ","и просят прощения",42,5],["لِمَن","для тех, кто",42,5],["فِي","на",42,5]],[["ٱلۡأَرۡضِۗ","земле",42,5],["أَلَآ","о да",42,5],["إِنَّ","поистине",42,5],["ٱللَّهَ","Аллах",42,5],["هُوَ","Он",42,5],["ٱلۡغَفُورُ","Прощающий",42,5],["ٱلرَّحِيمُ","Милосердный",42,5],[5],["وَٱلَّذِينَ","а те, которые",42,6],["ٱتَّخَذُواْ","взяли",42,6]],[["مِن","помимо",42,6],["دُونِهِۦٓ","Него",42,6],["أَوۡلِيَآءَ","покровителей",42,6],["ٱللَّهُ","Аллах",42,6],["حَفِيظٌ","Хранитель",42,6],["عَلَيۡهِمۡ","над ними",42,6],["وَمَآ","и не",42,6],["أَنتَ","ты",42,6],["عَلَيۡهِم","над ними",42,6],["بِوَكِيلٖ","попечитель",42,6]],[[6],["وَكَذَٰلِكَ","и так",42,7],["أَوۡحَيۡنَآ","Мы внушили",42,7],["إِلَيۡكَ","тебе",42,7],["قُرۡءَانًا","Коран",42,7],["عَرَبِيّٗا","арабский",42,7],["لِّتُنذِرَ","чтобы ты предостерёг",42,7],["أُمَّ","мать",42,7],["ٱلۡقُرَىٰ","селений",42,7],["وَمَنۡ","и тех, кто",42,7]],[["حَوۡلَهَا","вокруг неё",42,7],["وَتُنذِرَ","и предостерёг",42,7],["يَوۡمَ","о Дне",42,7],["ٱلۡجَمۡعِ","собрания",42,7],["لَا","нет",42,7],["رَيۡبَ","сомнения",42,7],["فِيهِۚ","в нём",42,7],["فَرِيقٞ","часть",42,7],["فِي","в",42,7],["ٱلۡجَنَّةِ","Раю",42,7],["وَفَرِيقٞ","и часть",42,7],["فِي","в",42,7]],[["ٱلسَّعِيرِ","Пламени",42,7],[7],["وَلَوۡ","и если бы",42,8],["شَآءَ","пожелал",42,8],["ٱللَّهُ","Аллах",42,8],["لَجَعَلَهُمۡ","непременно сделал бы их",42,8],["أُمَّةٗ","общиной",42,8],["وَٰحِدَةٗ","единой",42,8],["وَلَٰكِن","но",42,8],["يُدۡخِلُ","Он вводит",42,8]],[["مَن","кого",42,8],["يَشَآءُ","пожелает",42,8],["فِي","в",42,8],["رَحۡمَتِهِۦۚ","милость Свою",42,8],["وَٱلظَّٰلِمُونَ","а беззаконники",42,8],["مَا","нет",42,8],["لَهُم","у них",42,8],["مِّن","никакого",42,8],["وَلِيّٖ","покровителя",42,8],["وَلَا","и не",42,8],["نَصِيرٍ","помощника",42,8],[8]],[["أَمِ","или же",42,9],["ٱتَّخَذُواْ","взяли они",42,9],["مِن","помимо",42,9],["دُونِهِۦٓ","Него",42,9],["أَوۡلِيَآءَۖ","покровителей",42,9],["فَٱللَّهُ","но Аллах",42,9],["هُوَ","Он",42,9],["ٱلۡوَلِيُّ","Покровитель",42,9],["وَهُوَ","и Он",42,9],["يُحۡيِ","оживляет",42,9],["ٱلۡمَوۡتَىٰ","мёртвых",42,9],["وَهُوَ","и Он",42,9]],[["عَلَىٰ","над",42,9],["كُلِّ","всякой",42,9],["شَيۡءٖ","вещью",42,9],["قَدِيرٞ","Всемогущ",42,9],[9],["وَمَا","и то, в чём",42,10],["ٱخۡتَلَفۡتُمۡ","разошлись вы",42,10],["فِيهِ","в нём",42,10],["مِن","из",42,10],["شَيۡءٖ","чего-либо",42,10],["فَحُكۡمُهُۥٓ","то решение его",42,10]],[["إِلَى","за",42,10],["ٱللَّهِۚ","Аллахом",42,10],["ذَٰلِكُمُ","таков",42,10],["ٱللَّهُ","Аллах",42,10],["رَبِّي","Господь мой",42,10],["عَلَيۡهِ","на Него",42,10],["تَوَكَّلۡتُ","я уповаю",42,10],["وَإِلَيۡهِ","и к Нему",42,10],["أُنِيبُ","я обращаюсь",42,10],[10]]]}