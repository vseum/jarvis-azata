{"p":485,"j":25,"a":[[42,16,["وَٱلَّذِينَ","يُحَآجُّونَ","فِي","ٱللَّهِ","مِنۢ","بَعۡدِ","مَا","ٱسۡتُجِيبَ","لَهُۥ","حُجَّتُهُمۡ","دَاحِضَةٌ","عِندَ","رَبِّهِمۡ","وَعَلَيۡهِمۡ","غَضَبٞ","وَلَهُمۡ","عَذَابٞ","شَدِيدٌ"],"валлазиина йухажжууна филлахи мим ба`ди мастужииба лахуу хужжатухум дахидатун `инда раббихим ва`алайхим гадабун валахум `азабун шадиид","Доводы тех, которые препираются относительно Аллаха после того, как Ему ответили верующие, бесполезны перед их Господом. На них падет гнев, и им уготованы тяжкие мучения.",["а те, которые","препираются","об","Аллахе","после","того","как","ответили","Ему","довод их","несостоятелен","у","Господа их","и на них","гнев","и им","наказание","суровое"]],[42,17,["ٱللَّهُ","ٱلَّذِيٓ","أَنزَلَ","ٱلۡكِتَٰبَ","بِٱلۡحَقِّ","وَٱلۡمِيزَانَۗ","وَمَا","يُدۡرِيكَ","لَعَلَّ","ٱلسَّاعَةَ","قَرِيبٞ"],"аллахул лазии анзалал китаба билхаḳḳи валмиизана вама йудриика ла`аллас са`ата ḳарииб","Аллах - Тот, Кто ниспослал Писание с истиной и Весы. Откуда тебе знать, возможно, Час близок!",["Аллах","Тот, Который","ниспослал","Писание","с истиной","и Весы","и что","даст знать тебе","возможно","Час","близок"]],[42,18,["يَسۡتَعۡجِلُ","بِهَا","ٱلَّذِينَ","لَا","يُؤۡمِنُونَ","بِهَاۖ","وَٱلَّذِينَ","ءَامَنُواْ","مُشۡفِقُونَ","مِنۡهَا","وَيَعۡلَمُونَ","أَنَّهَا","ٱلۡحَقُّۗ","أَلَآ","إِنَّ","ٱلَّذِينَ","يُمَارُونَ","فِي","ٱلسَّاعَةِ","لَفِي","ضَلَٰلِۭ","بَعِيدٍ"],"йаста`жилу бихал лазиина ла йу'минууна биха валлазиина амануу мушфиḳууна минха вайа`ламууна аннахал хаḳḳу ала иннал лазиина йумарууна фис са`ати лафии далали ба`иид","Торопят с ним те, которые не веруют в него. А верующие трепещут перед ним и знают, что он является истиной. Воистину, те, которые препираются по поводу Часа, находятся в далеком заблуждении.",["торопят","его","те, которые","не","веруют","в него","а те, которые","уверовали","трепещут","перед ним","и знают","что он","истина","о да","поистине","те, которые","препираются","о","Часе","непременно в","заблуждении","далёком"]],[42,19,["ٱللَّهُ","لَطِيفُۢ","بِعِبَادِهِۦ","يَرۡزُقُ","مَن","يَشَآءُۖ","وَهُوَ","ٱلۡقَوِيُّ","ٱلۡعَزِيزُ"],"аллаху латиифу би`ибадихии йарзуḳу ман йашау вахуал ḳавиййул `азииз","Аллах добр к Своим рабам и наделяет уделом, кого пожелает. Он - Всесильный, Могущественный.",["Аллах","добр","к рабам Своим","наделяет уделом","кого","пожелает","и Он","Сильный","Могущественный"]],[42,20,["مَن","كَانَ","يُرِيدُ","حَرۡثَ","ٱلۡأٓخِرَةِ","نَزِدۡ","لَهُۥ","فِي","حَرۡثِهِۦۖ","وَمَن","كَانَ","يُرِيدُ","حَرۡثَ","ٱلدُّنۡيَا","نُؤۡتِهِۦ","مِنۡهَا","وَمَا","لَهُۥ","فِي","ٱلۡأٓخِرَةِ","مِن","نَّصِيبٍ"],"ман кана йурииду харсал ахирати назид лахуу фии харсихии ваман кана йурииду харсад дунйа ну'тихии минха вама лахуу фил ахирати мин насииб","Тому, кто пожелал нивы Последней жизни, Мы увеличим его ниву. Тому же, кто пожелал нивы мирской жизни, Мы дадим из нее, но ему не будет доли в жизни Последней.",["кто","будет","желать","нивы","Последней жизни","Мы прибавим","ему","в","ниве его","а кто","будет","желать","нивы","мира этого","Мы дадим ему","из неё","и нет","ему","в","Последней жизни","никакой","доли"]],[42,21,["أَمۡ","لَهُمۡ","شُرَكَٰٓؤُاْ","شَرَعُواْ","لَهُم","مِّنَ","ٱلدِّينِ","مَا","لَمۡ","يَأۡذَنۢ","بِهِ","ٱللَّهُۚ","وَلَوۡلَا","كَلِمَةُ","ٱلۡفَصۡلِ","لَقُضِيَ","بَيۡنَهُمۡۗ","وَإِنَّ","ٱلظَّٰلِمِينَ","لَهُمۡ","عَذَابٌ","أَلِيمٞ"],"ам лахум шуракау шара`уу лахум минад диини ма лам йа'зам бихиллаху валаула калиматул фасли лаḳудийа байнахум ва'инназ залимиина лахум `азабун алиим","Или же у них есть сотоварищи, которые узаконили для них в религии то, чего не дозволил Аллах? Если бы не решающее Слово, то их спор был бы уже решен. Воистину, беззаконникам уготованы мучительные страдания.",["или","у них","сотоварищи","узаконили","для них","из","религии","то, что","не","дозволил","это","Аллах","и если бы не","слово","решающее","непременно было бы решено","между ними","и поистине","беззаконникам","им","наказание","мучительное"]],[42,22,["تَرَى","ٱلظَّٰلِمِينَ","مُشۡفِقِينَ","مِمَّا","كَسَبُواْ","وَهُوَ","وَاقِعُۢ","بِهِمۡۗ","وَٱلَّذِينَ","ءَامَنُواْ","وَعَمِلُواْ","ٱلصَّٰلِحَٰتِ","فِي","رَوۡضَاتِ","ٱلۡجَنَّاتِۖ","لَهُم","مَّا","يَشَآءُونَ","عِندَ","رَبِّهِمۡۚ","ذَٰلِكَ","هُوَ","ٱلۡفَضۡلُ","ٱلۡكَبِيرُ"],"тараз залимиина мушфиḳиина мимма касабуу вахуа ваḳи`у бихим валлазиина амануу ва`амилус салихати фии раудатил жаннати лахум ма йашаууна `инда раббихим залика хуал фадлул кабиир","Ты увидишь, как беззаконники будут трепетать от того, что они приобрели, когда это падет на них. А те, которые уверовали и совершали праведные деяния, пребудут в Райских садах. Им уготовано у их Господа все, что они пожелают. Это и есть великая милость.",["ты увидишь","беззаконников","трепещущими","от того, что","они приобрели","а оно","падёт","на них","а те, которые","уверовали","и совершали","праведные деяния","в","цветущих лугах","садов","им","то, что","они пожелают","у","Господа их","это","оно","милость","великая"]]],"m":[[["وَٱلَّذِينَ","а те, которые",42,16],["يُحَآجُّونَ","препираются",42,16],["فِي","об",42,16],["ٱللَّهِ","Аллахе",42,16],["مِنۢ","после",42,16],["بَعۡدِ","того",42,16],["مَا","как",42,16],["ٱسۡتُجِيبَ","ответили",42,16],["لَهُۥ","Ему",42,16],["حُجَّتُهُمۡ","довод их",42,16]],[["دَاحِضَةٌ","несостоятелен",42,16],["عِندَ","у",42,16],["رَبِّهِمۡ","Господа их",42,16],["وَعَلَيۡهِمۡ","и на них",42,16],["غَضَبٞ","гнев",42,16],["وَلَهُمۡ","и им",42,16],["عَذَابٞ","наказание",42,16],["شَدِيدٌ","суровое",42,16]],[[16],["ٱللَّهُ","Аллах",42,17],["ٱلَّذِيٓ","Тот, Который",42,17],["أَنزَلَ","ниспослал",42,17],["ٱلۡكِتَٰبَ","Писание",42,17],["بِٱلۡحَقِّ","с истиной",42,17],["وَٱلۡمِيزَانَۗ","и Весы",42,17],["وَمَا","и что",42,17],["يُدۡرِيكَ","даст знать тебе",42,17]],[["لَعَلَّ","возможно",42,17],["ٱلسَّاعَةَ","Час",42,17],["قَرِيبٞ","близок",42,17],[17],["يَسۡتَعۡجِلُ","торопят",42,18],["بِهَا","его",42,18],["ٱلَّذِينَ","те, которые",42,18],["لَا","не",42,18],["يُؤۡمِنُونَ","веруют",42,18]],[["بِهَاۖ","в него",42,18],["وَٱلَّذِينَ","а те, которые",42,18],["ءَامَنُواْ","уве