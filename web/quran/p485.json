لِمِينَ","беззаконников",42,22]],[["مُشۡفِقِينَ","трепещущими",42,22],["مِمَّا","от того, что",42,22],["كَسَبُواْ","они приобрели",42,22],["وَهُوَ","а оно",42,22],["وَاقِعُۢ","падёт",42,22],["بِهِمۡۗ","на них",42,22],["وَٱلَّذِينَ","а те, которые",42,22]],[["ءَامَنُواْ","уверовали",42,22],["وَعَمِلُواْ","и совершали",42,22],["ٱلصَّٰلِحَٰتِ","праведные деяния",42,22],["فِي","в",42,22],["رَوۡضَاتِ","цветущих лугах",42,22],["ٱلۡجَنَّاتِۖ","садов",42,22]],[["لَهُم","им",42,22],["مَّا","то, что",42,22],["يَشَآءُونَ","они пожелают",42,22],["عِندَ","у",42,22],["رَبِّهِمۡۚ","Господа их",42,22],["ذَٰلِكَ","это",42,22],["هُوَ","оно",42,22],["ٱلۡفَضۡلُ","милость",42,22],["ٱلۡكَبِيرُ","великая",42,22],[22]]]}