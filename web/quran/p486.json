{"p":486,"j":25,"a":[[42,23,["ذَٰلِكَ","ٱلَّذِي","يُبَشِّرُ","ٱللَّهُ","عِبَادَهُ","ٱلَّذِينَ","ءَامَنُواْ","وَعَمِلُواْ","ٱلصَّٰلِحَٰتِۗ","قُل","لَّآ","أَسۡـَٔلُكُمۡ","عَلَيۡهِ","أَجۡرًا","إِلَّا","ٱلۡمَوَدَّةَ","فِي","ٱلۡقُرۡبَىٰۗ","وَمَن","يَقۡتَرِفۡ","حَسَنَةٗ","نَّزِدۡ","لَهُۥ","فِيهَا","حُسۡنًاۚ","إِنَّ","ٱللَّهَ","غَفُورٞ","شَكُورٌ"],"заликал лазии йубашшируллаху `ибадахул лазиина амануу ва`амилус салихати ḳул ла ас'алукум `алайхи ажран иллал маваддата фил ḳурба ваман йаḳтариф хасанатан назид лахуу фииха хуснан инналлаха гафуурун шакуур","Это - то, чем Аллах радует Своих рабов, которые уверовали и совершали праведные деяния. Скажи: «Я не прошу у вас за это никакой награды, кроме любви ради близости (ради моей близости к вам, или ради вашей близости к Аллаху, или любви к моим близким родственникам)». Тому, кто приобретет добро, Мы увеличим его. Воистину, Аллах - Прощающий, Благодарный.",["это","то, что","радует вестью","Аллах","рабов Своих","которые","уверовали","и совершали","праведные деяния","скажи","не","прошу я у вас","за это","награды","кроме","любви","в","родстве","и кто","приобретёт","добро","Мы прибавим","ему","в нём","добра","поистине","Аллах","Прощающий","Благодарный"]],[42,24,["أَمۡ","يَقُولُونَ","ٱفۡتَرَىٰ","عَلَى","ٱللَّهِ","كَذِبٗاۖ","فَإِن","يَشَإِ","ٱللَّهُ","يَخۡتِمۡ","عَلَىٰ","قَلۡبِكَۗ","وَيَمۡحُ","ٱللَّهُ","ٱلۡبَٰطِلَ","وَيُحِقُّ","ٱلۡحَقَّ","بِكَلِمَٰتِهِۦٓۚ","إِنَّهُۥ","عَلِيمُۢ","بِذَاتِ","ٱلصُّدُورِ"],"ам йаḳуулуунафтара `алаллахи казибан фа'ин йашаиллаху йахтим `ала ḳалбика вайамхуллахул батила вайухиḳḳул хаḳḳа бикалиматихии иннахуу `алииму бизатис судуур","Или же они говорят, что он возвел навет на Аллаха? Если бы Аллах пожелал, то наложил бы печать на твое сердце. Своими Словами Аллах стирает ложь и утверждает истину. Воистину, Он знает о том, что в груди.",["или","говорят они","он измыслил","на","Аллаха","ложь","но если","пожелает","Аллах","Он запечатает","на","сердце твоём","и стирает","Аллах","ложь","и утверждает","истину","Словами Своими","поистине, Он","Знающий","о том, что в","груди"]],[42,25,["وَهُوَ","ٱلَّذِي","يَقۡبَلُ","ٱلتَّوۡبَةَ","عَنۡ","عِبَادِهِۦ","وَيَعۡفُواْ","عَنِ","ٱلسَّيِّـَٔاتِ","وَيَعۡلَمُ","مَا","تَفۡعَلُونَ"],"вахуал лазии йаḳбалут таубата `ан `ибадихии вайа`фуу `анис саййиати вайа`ламу ма таф`алуун","Он - Тот, Кто принимает покаяния Своих рабов, прощает злодеяния и знает то, что вы совершаете.",["и Он","Тот, Который","принимает","покаяние","от","рабов Своих","и прощает","(от)","злодеяния","и знает","то, что","вы делаете"]],[42,26,["وَيَسۡتَجِيبُ","ٱلَّذِينَ","ءَامَنُواْ","وَعَمِلُواْ","ٱلصَّٰلِحَٰتِ","وَيَزِيدُهُم","مِّن","فَضۡلِهِۦۚ","وَٱلۡكَٰفِرُونَ","لَهُمۡ","عَذَابٞ","شَدِيدٞ"],"вайастажиибул лазиина амануу ва`амилус салихати вайазиидухум мин фадлихии валкафирууна лахум `азабун шадиид","Он отвечает тем, которые уверовали и совершают праведные деяния, и приумножает им из Своей милости. А неверующим уготованы тяжкие мучения.",["и Он отвечает","тем, которые","уверовали","и совершали","праведные деяния","и прибавляет им","из","милости Своей","а неверующие","им","наказание","суровое"]],[42,27,["وَلَوۡ","بَسَطَ","ٱللَّهُ","ٱلرِّزۡقَ","لِعِبَادِهِۦ","لَبَغَوۡاْ","فِي","ٱلۡأَرۡضِ","وَلَٰكِن","يُنَزِّلُ","بِقَدَرٖ","مَّا","يَشَآءُۚ","إِنَّهُۥ","بِعِبَادِهِۦ","خَبِيرُۢ","بَصِيرٞ"],"валау басаталлахур ризḳа ли`ибадихии лабагау фил арди валакин йуназзилу биḳадарим ма йашау иннахуу би`ибадихии хабииру басиир","Если бы Аллах увеличил удел Своим рабам, они стали бы бесчинствовать на земле. Однако Он ниспосылает его в меру, как пожелает. Воистину, Он ведает о Своих рабах и видит их.",["и если бы","простёр","Аллах","удел","рабам Своим","непременно бесчинствовали бы","на","земле","но","Он ниспосылает","в меру","что","пожелает","поистине, Он","о рабах Своих","Ведающий","Видящий"]],[42,28,["وَهُوَ","ٱلَّذِي","يُنَزِّلُ","ٱلۡغَيۡثَ","مِنۢ","بَعۡدِ","مَا","قَنَطُواْ","وَيَنشُرُ","رَحۡمَتَهُۥۚ","وَهُوَ","ٱلۡوَلِيُّ","ٱلۡحَمِيدُ"],"вахуал лазии йуназзилул гайса мим ба`ди ма ḳанатуу вайаншуру рахматахуу вахуал валиййул хамиид","Он - Тот, Кто ниспосылает дождь после того, как они отчаиваются, и распространяет Свою милость. Он - Достохвальный Покровитель.",["и Он","Тот, Который","ниспосылает","дождь","после","того","как","они отчаялись","и распространяет","милость Свою","и Он","Покровитель","Достохвальный"]],[42,29,["وَمِنۡ","ءَايَٰتِهِۦ","خَلۡقُ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِ","وَمَا","بَثَّ","فِيهِمَا","مِن","دَآبَّةٖۚ","وَهُوَ","عَلَىٰ","جَمۡعِهِمۡ","إِذَا","يَشَآءُ","قَدِيرٞ"],"вамин айатихии халḳус самавати вал'арди вама басса фиихима мин даббатин вахуа `ала жам`ихим иза йашау ḳадиир","Среди Его знамений - создание небес и земли, а также тех живых существ (или те живые существа), которых Он расселил на них. Он способен собрать их, когда пожелает.",["и из","знамений Его","сотворение","небес","и земли","и того, что","Он расселил","в них обоих","из","живых существ","и Он","в","собирании их","когда","пожелает","Всемогущ"]],[42,30,["وَمَآ","أَصَٰبَكُم","مِّن","مُّصِيبَةٖ","فَبِمَا","كَسَبَتۡ","أَيۡدِيكُمۡ","وَيَعۡفُواْ","عَن","كَثِيرٖ"],"вама асабакум мим мусиибатин фабима касабат айдиикум вайа`фуу `ан касиир","Любое бедствие постигает вас лишь за то, что приобрели ваши руки, и Он прощает вам многое.",["и то, что","постигло вас","из","бедствия","то за то, что","приобрели","руки ваши","и Он прощает","(за)","многого"]],[42,31,["وَمَآ","أَنتُم","بِمُعۡجِزِينَ","فِي","ٱلۡأَرۡضِۖ","وَمَا","لَكُم","مِّن","دُونِ","ٱللَّهِ","مِن","وَلِيّٖ","وَلَا","نَصِيرٖ"],"вама антум биму`жизиина фил арди вама лакум мин дууниллахи мин валиййин вала насиир","Вы не спасетесь бегством на земле, и нет у вас, помимо Аллаха, ни покровителя, ни помощника.",["и не","вы","способны ускользнуть","на","земле","и нет","у вас","из","помимо","Аллаха","никакого","покровителя","и не","помощника"]]],"m":[[["ذَٰلِكَ","это",42,23],["ٱلَّذِي","то, что",42,23],["يُبَشِّرُ","радует вестью",42,23],["ٱللَّهُ","Аллах",42,23],["عِبَادَهُ","рабов Своих",42,23],["ٱلَّذِينَ","которые",42,23],["ءَام