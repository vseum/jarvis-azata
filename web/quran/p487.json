{"p":487,"j":25,"a":[[42,32,["وَمِنۡ","ءَايَٰتِهِ","ٱلۡجَوَارِ","فِي","ٱلۡبَحۡرِ","كَٱلۡأَعۡلَٰمِ"],"вамин айатихил жавари фил бахри кал'а`лам","Среди Его знамений - плывущие по морю корабли, подобные горам.",["и из","знамений Его","плывущие","в","море","как горы"]],[42,33,["إِن","يَشَأۡ","يُسۡكِنِ","ٱلرِّيحَ","فَيَظۡلَلۡنَ","رَوَاكِدَ","عَلَىٰ","ظَهۡرِهِۦٓۚ","إِنَّ","فِي","ذَٰلِكَ","لَأٓيَٰتٖ","لِّكُلِّ","صَبَّارٖ","شَكُورٍ"],"ин йаша' йускинир рииха файазлална равакида `ала захрихии инна фии залика ла'айатил ликулли саббарин шакуур","Если Он пожелает, то успокоит ветер, и тогда они останутся неподвижными на его (моря) поверхности. Воистину, в этом - знамения для каждого терпеливого, благодарного.",["если","Он пожелает","Он успокоит","ветер","и останутся они","неподвижными","на","спине его","поистине","в","этом","непременно знамения","для всякого","терпеливого","благодарного"]],[42,34,["أَوۡ","يُوبِقۡهُنَّ","بِمَا","كَسَبُواْ","وَيَعۡفُ","عَن","كَثِيرٖ"],"ау йуубиḳхунна бима касабуу вайа`фу `ан касиир","Он может погубить их (корабли) за то, что они (люди) приобрели, но Он прощает многих.",["или","погубит их","за то, что","приобрели","и простит","из","многого"]],[42,35,["وَيَعۡلَمَ","ٱلَّذِينَ","يُجَٰدِلُونَ","فِيٓ","ءَايَٰتِنَا","مَا","لَهُم","مِّن","مَّحِيصٖ"],"вайа`ламал лазиина йужадилууна фии айатина ма лахум мим махиис","Те, которые препираются относительно Наших знамений, знают, что они не смогут сбежать.",["и чтобы знали","те, которые","препираются","о","знамениях Наших","нет","им","никакого","убежища"]],[42,36,["فَمَآ","أُوتِيتُم","مِّن","شَيۡءٖ","فَمَتَٰعُ","ٱلۡحَيَوٰةِ","ٱلدُّنۡيَاۚ","وَمَا","عِندَ","ٱللَّهِ","خَيۡرٞ","وَأَبۡقَىٰ","لِلَّذِينَ","ءَامَنُواْ","وَعَلَىٰ","رَبِّهِمۡ","يَتَوَكَّلُونَ"],"фама уутиитум мин шай'ин фамата`ул хайаватид дунйа вама `индаллахи хайрун ва'абḳа лиллазиина амануу ва`ала раббихим йатаваккалуун","Все, что даровано вам, является преходящим благом мирской жизни. А то, что есть у Аллаха, будет лучше и долговечнее для тех, которые уверовали и уповают на своего Господа,",["и что","дано вам","из","чего-либо","то пользование","жизни","мирской","а то, что","у","Аллаха","лучше","и долговечнее","для тех, которые","уверовали","и на","Господа их","уповают"]],[42,37,["وَٱلَّذِينَ","يَجۡتَنِبُونَ","كَبَٰٓئِرَ","ٱلۡإِثۡمِ","وَٱلۡفَوَٰحِشَ","وَإِذَا","مَا","غَضِبُواْ","هُمۡ","يَغۡفِرُونَ"],"валлазиина йажтанибууна кабаирал исми валфавахиша ва'иза ма гадибуу хум йагфируун","которые избегают великих грехов и мерзостей и прощают, когда гневаются,",["и те, которые","избегают","больших","грехов","и мерзостей","и когда","лишь","гневаются они","они","прощают"]],[42,38,["وَٱلَّذِينَ","ٱسۡتَجَابُواْ","لِرَبِّهِمۡ","وَأَقَامُواْ","ٱلصَّلَوٰةَ","وَأَمۡرُهُمۡ","شُورَىٰ","بَيۡنَهُمۡ","وَمِمَّا","رَزَقۡنَٰهُمۡ","يُنفِقُونَ"],"валлазиинастажабуу лираббихим ва'аḳамус салавата ва'амрухум шуура байнахум вамимма разаḳнахум йунфиḳуун","которые отвечают своему Господу, совершают намаз, совещаются между собой о делах и расходуют из того, чем Мы их наделили,",["и те, которые","ответили","своему Господу","и выстаивали","намаз","и дело их","совещание","между ними","и из того, что","Мы наделили их","расходуют"]],[42,39,["وَٱلَّذِينَ","إِذَآ","أَصَابَهُمُ","ٱلۡبَغۡيُ","هُمۡ","يَنتَصِرُونَ"],"валлазиина иза асабахумул багйу хум йантасируун","которые мстят, когда против них поступают несправедливо.",["и те, которые","когда","постигает их","несправедливость","они","защищаются"]],[42,40,["وَجَزَٰٓؤُاْ","سَيِّئَةٖ","سَيِّئَةٞ","مِّثۡلُهَاۖ","فَمَنۡ","عَفَا","وَأَصۡلَحَ","فَأَجۡرُهُۥ","عَلَى","ٱللَّهِۚ","إِنَّهُۥ","لَا","يُحِبُّ","ٱلظَّٰلِمِينَ"],"важазау саййиатин саййиатум мислуха фаман `афа ва'аслаха фа'ажрухуу `алаллахи иннахуу ла йухиббуз залимиин","Воздаянием за зло является равноценное зло. Но если кто простит и установит мир, то его награда будет за Аллахом. Воистину, Он не любит беззаконников.",["и воздаяние","за зло","зло","подобное ему","а кто","простил","и примирил","то награда его","на","Аллахе","поистине, Он","не","любит","несправедливых"]],[42,41,["وَلَمَنِ","ٱنتَصَرَ","بَعۡدَ","ظُلۡمِهِۦ","فَأُوْلَٰٓئِكَ","مَا","عَلَيۡهِم","مِّن","سَبِيلٍ"],"валаманинтасара ба`да зулмихии фа'улаика ма `алайхим мин сабиил","Нет укора тем, которые мстят после того, как с ними поступили несправедливо.",["и тот, кто","защитился","после","притеснения его","то те","не","на них","никакого","пути (упрёка)"]],[42,42,["إِنَّمَا","ٱلسَّبِيلُ","عَلَى","ٱلَّذِينَ","يَظۡلِمُونَ","ٱلنَّاسَ","وَيَبۡغُونَ","فِي","ٱلۡأَرۡضِ","بِغَيۡرِ","ٱلۡحَقِّۚ","أُوْلَٰٓئِكَ","لَهُمۡ","عَذَابٌ","أَلِيمٞ"],"иннамас сабиилу `алал лазиина йазлимуунан наса вайабгууна фил арди бигайрил хаḳḳи улаика лахум `азабун алиим","Укора заслуживают только те, которые поступают несправедливо с людьми и бесчинствуют на земле без всякого права. Им уготованы мучительные страдания.",["лишь","путь (упрёка)","на","тех, которые","притесняют","людей","и бесчинствуют","на","земле","без","права","те","им","наказание","мучительное"]],[42,43,["وَلَمَن","صَبَرَ","وَغَفَرَ","إِنَّ","ذَٰلِكَ","لَمِنۡ","عَزۡمِ","ٱلۡأُمُورِ"],"валаман сабара вагафара инна залика ламин `азмил умуур","А если кто проявит терпение и простит, то ведь в этих делах надлежит проявлять решимость.",["а тот, кто","проявил терпение","и простил","поистине","это","непременно из","решимости","дел"]],[42,44,["وَمَن","يُضۡلِلِ","ٱللَّهُ","فَمَا","لَهُۥ","مِن","وَلِيّٖ","مِّنۢ","بَعۡدِهِۦۗ","وَتَرَى","ٱلظَّٰلِمِينَ","لَمَّا","رَأَوُاْ","ٱلۡعَذَابَ","يَقُولُونَ","هَلۡ","إِلَىٰ","مَرَدّٖ","مِّن","سَبِيلٖ"],"ваман йудлилиллаху фама лахуу мин валиййим мим ба`дихии ватараз залимиина ламма ра'авул `азаба йаḳуулууна хал ила мараддим мин сабиил","У того, кого Аллах ввел в заблуждение, после этого не будет покровителя. Ты увидишь, как беззаконники, увидев мучения, скажут: «Нет ли пути для возвращения?».",["и кого","сбивает с пути","Аллах","то не","ему","никакого","покровителя","после","Него","и увидишь ты","несправедливых","когда","увидят они","наказание","говорящими","разве","к","возвращению","какой-либо","путь"]]],"m":[[["وَمِنۡ","и из",42,32],["ءَايَٰتِهِ","знамений Его",42,32],["ٱلۡجَوَارِ","плывущие",42,32],["فِي","в",42,32],["ٱلۡبَحۡرِ","море",42,32],["كَٱلۡأَعۡلَٰمِ","как горы",42,32],[32],["إِن","если",42,33],["يَشَأۡ","Он пожелает",42,33],["يُسۡكِنِ","Он успокоит",42,33],["ٱلرِّيحَ","ветер",42,33]],[["فَيَظۡلَلۡنَ","и останутся они",42,33],["رَوَاكِدَ","неподвижными",42,33],["عَلَىٰ","на",42,33],["ظَهۡرِهِۦٓۚ","спине его",42,33],["إِنَّ","поистине",42,33],["فِي","в",42,33],["ذَٰلِكَ","этом",42,33],["لَأٓيَٰتٖ","непременно знамения",42,33],["لِّكُلِّ","для всякого",42,33],["صَبَّارٖ","терпеливого",42,33],["شَكُورٍ","благодарного",42,33]],[[33],["أَوۡ","или",42,34],["يُوبِقۡهُنَّ","погубит их",42,34],["بِمَا","за то, что",42,34],["كَسَبُواْ","приобрели",42,34],["وَيَعۡفُ","и простит",42,34],["عَن","из",42,34],["كَثِيرٖ","многого",42,34],[34],["وَيَعۡلَمَ","и чтобы знали",42,35],["ٱلَّذِينَ","те, которые",42,35]],[["يُجَٰدِلُونَ","препираются",42,35],["فِيٓ","о",42,35],["ءَايَٰتِنَا","знамениях Наших",42,35],["مَا","нет",42,35],["لَهُم","им",42,35],["مِّن","никакого",42,35],["مَّحِيصٖ","убежища",42,35],[35],["فَمَآ","и что",42,36],["أُوتِيتُم","дано вам",42,36],["مِّن","из",42,36],["شَيۡءٖ","чего-либо",42,36],["فَمَتَٰعُ","то пользование",42,36]],[["ٱلۡحَيَوٰةِ","жизни",42,36],["ٱلدُّنۡيَاۚ","мирской",42,36],["وَمَا","а то, что",42,36],["عِندَ","у",42,36],["ٱللَّهِ","Аллаха",42,36],["خَيۡرٞ","лучше",42,36],["وَأَبۡقَىٰ","и долговечнее",42,36],["لِلَّذِينَ","для тех, которые",42,36],["ءَامَنُواْ","уверовали",42,36],["وَعَلَىٰ","и на",42,36],["رَبِّهِمۡ","Господа их",42,36]],[["يَتَوَكَّلُونَ","уповают",42,36],[36],["وَٱلَّذِينَ","и те, которые",42,37],["يَجۡتَنِبُونَ","избегают",42,37],["كَبَٰٓئِرَ","больших",42,37],["ٱلۡإِثۡمِ","грехов",42,37],["وَٱلۡفَوَٰحِشَ","и мерзостей",42,37],["وَإِذَا","и когда",42,37],["مَا","лишь",42,37]],[["غَضِبُواْ","гневаются они",42,37],["هُمۡ","они",42,37],["يَغۡفِرُونَ","прощают",42,37],[37],["وَٱلَّذِينَ","и те, которые",42,38],["ٱسۡتَجَابُواْ","ответили",42,38],["لِرَبِّهِمۡ","своему Господу",42,38],["وَأَقَامُواْ","и выстаивали",42,38],["ٱلصَّلَوٰةَ","намаз",42,38]],[["وَأَمۡرُهُمۡ","и дело их",42,38],["شُورَىٰ","совещание",42,38],["بَيۡنَهُمۡ","между ними",42,38],["وَمِمَّا","и из того, что",42,38],["رَزَقۡنَٰهُمۡ","Мы наделили их",42,38],["يُنفِقُونَ","расходуют",42,38],[38],["وَٱلَّذِينَ","и те, которые",42,39],["إِذَآ","когда",42,39],["أَصَابَهُمُ","постигает их",42,39]],[["ٱلۡبَغۡيُ","несправедливость",42,39],["هُمۡ","они",42,39],["يَنتَصِرُونَ","защищаются",42,39],[39],["وَجَزَٰٓؤُاْ","и воздаяние",42,40],["سَيِّئَةٖ","за зло",42,40],["سَيِّئَةٞ","зло",42,40],["مِّثۡلُهَاۖ","подобное ему",42,40],["فَمَنۡ","а кто",42,40],["عَفَا","простил",42,40]],[["وَأَصۡلَحَ","и примирил",42,40],["فَأَجۡرُهُۥ","то награда его",42,40],["عَلَى","на",42,40],["ٱللَّهِۚ","Аллахе",42,40],["إِنَّهُۥ","поистине, Он",42,40],["لَا","не",42,40],["يُحِبُّ","любит",42,40],["ٱلظَّٰلِمِينَ","несправедливых",42,40],[40],["وَلَمَنِ","и тот, кто",42,41],["ٱنتَصَرَ","защитился",42,41]],[["بَعۡدَ","после",42,41],["ظُلۡمِهِۦ","притеснения его",42,41],["فَأُوْلَٰٓئِكَ","то те",42,41],["مَا","не",42,41],["عَلَيۡهِم","на них",42,41],["مِّن","никакого",42,41],["سَبِيلٍ","пути (упрёка)",42,41],[41],["إِنَّمَا","лишь",42,42],["ٱلسَّبِيلُ","путь (упрёка)",42,42],["عَلَى","на",42,42],["ٱلَّذِينَ","тех, которые",42,42]],[["يَظۡلِمُونَ","притесняют",42,42],["ٱلنَّاسَ","людей",42,42],["وَيَبۡغُونَ","и бесчинствуют",42,42],["فِي","на",42,42],["ٱلۡأَرۡضِ","земле",42,42],["بِغَيۡرِ","без",42,42],["ٱلۡحَقِّۚ","права",42,42],["أُوْلَٰٓئِكَ","те",42,42],["لَهُمۡ","им",42,42]],[["عَذَابٌ","наказание",42,42],["أَلِيمٞ","мучительное",42,42],[42],["وَلَمَن","а тот, кто",42,43],["صَبَرَ","проявил терпение",42,43],["وَغَفَرَ","и простил",42,43],["إِنَّ","поистине",42,43],["ذَٰلِكَ","это",42,43],["لَمِنۡ","непременно из",42,43],["عَزۡمِ","решимости",42,43],["ٱلۡأُمُورِ","дел",42,43]],[[43],["وَمَن","и кого",42,44],["يُضۡلِلِ","сбивает с пути",42,44],["ٱللَّهُ","Аллах",42,44],["فَمَا","то не",42,44],["لَهُۥ","ему",42,44],["مِن","никакого",42,44],["وَلِيّٖ","покровителя",42,44],["مِّنۢ","после",42,44],["بَعۡدِهِۦۗ","Него",42,44],["وَتَرَى","и увидишь ты",42,44],["ٱلظَّٰلِمِينَ","несправедливых",42,44]],[["لَمَّا","когда",42,44],["رَأَوُاْ","увидят они",42,44],["ٱلۡعَذَابَ","наказание",42,44],["يَقُولُونَ","говорящими",42,44],["هَلۡ","разве",42,44],["إِلَىٰ","к",42,44],["مَرَدّٖ","возвращению",42,44],["مِّن","какой-либо",42,44],["سَبِيلٖ","путь",42,44],[44]]]}