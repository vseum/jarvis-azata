{"p":488,"j":25,"a":[[42,45,["وَتَرَىٰهُمۡ","يُعۡرَضُونَ","عَلَيۡهَا","خَٰشِعِينَ","مِنَ","ٱلذُّلِّ","يَنظُرُونَ","مِن","طَرۡفٍ","خَفِيّٖۗ","وَقَالَ","ٱلَّذِينَ","ءَامَنُوٓاْ","إِنَّ","ٱلۡخَٰسِرِينَ","ٱلَّذِينَ","خَسِرُوٓاْ","أَنفُسَهُمۡ","وَأَهۡلِيهِمۡ","يَوۡمَ","ٱلۡقِيَٰمَةِۗ","أَلَآ","إِنَّ","ٱلظَّٰلِمِينَ","فِي","عَذَابٖ","مُّقِيمٖ"],"ватарахум йу`радууна `алайха хаши`иина миназ зулли йанзурууна мин тарфин хафиййин ваḳалал лазиина амануу иннал хасириинал лазиина хасируу анфусахум ва'ахлиихим йаумал ḳийамати ала инназ залимиина фии `азабим муḳиим","Ты увидишь, как их представят ему (Аду) смиренными от унижения и поглядывающими на него искоса. Те же, которые уверовали, скажут: «Воистину, потерпевшими убыток являются те, которые потеряли самих себя и свои семьи в День воскресения». Воистину, беззаконники пребудут в вечных мучениях.",["и увидишь ты их","их представляют","ему (Огню)","смиренными","от","унижения","смотрят","с","взглядом","скрытым","и сказали","те, которые","уверовали","поистине","потерпевшие убыток","те, которые","потеряли","самих себя","и семьи свои","в День","воскресения","о да","поистине","несправедливые","в","наказании","постоянном"]],[42,46,["وَمَا","كَانَ","لَهُم","مِّنۡ","أَوۡلِيَآءَ","يَنصُرُونَهُم","مِّن","دُونِ","ٱللَّهِۗ","وَمَن","يُضۡلِلِ","ٱللَّهُ","فَمَا","لَهُۥ","مِن","سَبِيلٍ"],"вама кана лахум мин аулийаа йансуруунахум мин дууниллахи ваман йудлилиллаху фама лахуу мин сабиил","У них не будет покровителей и помощников, которые бы помогли им вместо Аллаха. Нет пути тому, кого Аллах ввел в заблуждение.",["и не","было","у них","никаких","покровителей","помогают им","из","помимо","Аллаха","а кого","сбивает с пути","Аллах","то не","ему","никакого","пути"]],[42,47,["ٱسۡتَجِيبُواْ","لِرَبِّكُم","مِّن","قَبۡلِ","أَن","يَأۡتِيَ","يَوۡمٞ","لَّا","مَرَدَّ","لَهُۥ","مِنَ","ٱللَّهِۚ","مَا","لَكُم","مِّن","مَّلۡجَإٖ","يَوۡمَئِذٖ","وَمَا","لَكُم","مِّن","نَّكِيرٖ"],"истажиибуу лираббикум мин ḳабли ан йа'тийа йаумул ла марадда лахуу миналлахи ма лакум мим малжаин йаумаизин вама лакум мин накиир","Ответьте вашему Господу прежде, чем наступит день от Аллаха, который невозможно отвратить (или день, который Аллах не отвратит). В тот день не будет для вас убежища, и вы не сможете отрицать свои грехи.",["ответьте","вашему Господу","из","прежде","чем","придёт","день","нет","отвращения","ему","от","Аллаха","не","у вас","никакого","убежища","в тот день","и не","у вас","никакого","отрицания"]],[42,48,["فَإِنۡ","أَعۡرَضُواْ","فَمَآ","أَرۡسَلۡنَٰكَ","عَلَيۡهِمۡ","حَفِيظًاۖ","إِنۡ","عَلَيۡكَ","إِلَّا","ٱلۡبَلَٰغُۗ","وَإِنَّآ","إِذَآ","أَذَقۡنَا","ٱلۡإِنسَٰنَ","مِنَّا","رَحۡمَةٗ","فَرِحَ","بِهَاۖ","وَإِن","تُصِبۡهُمۡ","سَيِّئَةُۢ","بِمَا","قَدَّمَتۡ","أَيۡدِيهِمۡ","فَإِنَّ","ٱلۡإِنسَٰنَ","كَفُورٞ"],"фа'ин а`радуу фама арсалнака `алайхим хафиизан ин `алайка иллал балагу ва'инна иза азаḳнал инсана минна рахматан фариха биха ва'ин тусибхум саййиату бима ḳаддамат айдиихим фа'иннал инсана кафуур","Если же они отвернутся, то ведь Мы не посылали тебя их хранителем. На тебя возложена только передача откровения. Когда Мы даем человеку вкусить Нашу милость, он радуется ей. Когда же его поражает зло за то, что приготовили его руки, то человек становится неблагодарен.",["а если","отвернулись они","то не","Мы послали тебя","над ними","хранителем","не","на тебе","кроме","передачи","и поистине, Мы","когда","Мы дали вкусить","человеку","от Нас","милость","радуется он","ей","а если","постигнет их","зло","за то, что","уготовили","их руки","то поистине","человек","неблагодарен"]],[42,49,["لِّلَّهِ","مُلۡكُ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِۚ","يَخۡلُقُ","مَا","يَشَآءُۚ","يَهَبُ","لِمَن","يَشَآءُ","إِنَٰثٗا","وَيَهَبُ","لِمَن","يَشَآءُ","ٱلذُّكُورَ"],"ллиллахи мулкус самавати вал'арди йахлуḳу ма йашау йахабу лиман йашау инасан вайахабу лиман йашауз зукуур","Аллаху принадлежит власть над небесами и землей. Он творит, что пожелает. Он одаряет, кого пожелает, потомством женского пола, а кого пожелает - мужского.",["Аллаху","власть","небес","и земли","Он творит","что","пожелает","Он дарует","кому","пожелает","девочек","и дарует","кому","пожелает","мальчиков"]],[42,50,["أَوۡ","يُزَوِّجُهُمۡ","ذُكۡرَانٗا","وَإِنَٰثٗاۖ","وَيَجۡعَلُ","مَن","يَشَآءُ","عَقِيمًاۚ","إِنَّهُۥ","عَلِيمٞ","قَدِيرٞ"],"ау йузаввижухум зукранан ва'инасан вайаж`алу ман йашау `аḳииман иннахуу `алиимун ḳадиир","Или же Он сочетает потомство мужского и женского полов, а того, кого пожелает, Он делает бесплодным. Воистину, Он - Знающий, Всемогущий.",["или","Он сочетает им","мальчиков","и девочек","и делает","кого","пожелает","бесплодным","поистине, Он","Знающий","Всемогущий"]],[42,51,["وَمَا","كَانَ","لِبَشَرٍ","أَن","يُكَلِّمَهُ","ٱللَّهُ","إِلَّا","وَحۡيًا","أَوۡ","مِن","وَرَآيِٕ","حِجَابٍ","أَوۡ","يُرۡسِلَ","رَسُولٗا","فَيُوحِيَ","بِإِذۡنِهِۦ","مَا","يَشَآءُۚ","إِنَّهُۥ","عَلِيٌّ","حَكِيمٞ"],"вама кана либашарин ан йукаллимахуллаху илла вахйан ау мин варайи хижабин ау йурсила расуулан файуухийа би'изнихии ма йашау иннахуу `алиййун хакиим","Человек не достоин того, чтобы Аллах разговаривал с ним иначе, как посредством откровения или через завесу. Или же Он отправляет посланца, который с Его позволения внушает посредством откровения то, что Он желает. Воистину, Он - Возвышенный, Мудрый.",["и не","было","для человека","чтобы","заговорил с ним","Аллах","кроме как","откровением","или","из","за","завесы","или","пошлёт","посланника","и внушит","с Его дозволения","что","Он пожелает","поистине, Он","Высокий","Мудрый"]]],"m":[[["وَتَرَىٰهُمۡ","и увидишь ты их",42,45],["يُعۡرَضُونَ","их представляют",42,45],["عَلَيۡهَا","ему (Огню)",42,45],["خَٰشِعِينَ","смиренными",42,45],["مِنَ","от",42,45],["ٱلذُّلِّ","унижения",42,45],["يَنظُرُونَ","смотрят",42,45]],[["مِن","с",42,45],["طَرۡفٍ","взглядом",42,45],["خَفِيّٖۗ","скрытым",42,45],["وَقَالَ","и сказали",42,45],["ٱلَّذِينَ","те, которые",42,45],["ءَامَنُوٓاْ","уверовали",42,45],["إِنَّ","поистине",42,45],["ٱلۡخَٰسِرِينَ","потерпевшие убыток",42,45],["ٱلَّذِينَ","те, которые",42,45]],[["خَسِرُوٓاْ","поте