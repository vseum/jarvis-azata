{"p":489,"j":25,"a":[[42,52,["وَكَذَٰلِكَ","أَوۡحَيۡنَآ","إِلَيۡكَ","رُوحٗا","مِّنۡ","أَمۡرِنَاۚ","مَا","كُنتَ","تَدۡرِي","مَا","ٱلۡكِتَٰبُ","وَلَا","ٱلۡإِيمَٰنُ","وَلَٰكِن","جَعَلۡنَٰهُ","نُورٗا","نَّهۡدِي","بِهِۦ","مَن","نَّشَآءُ","مِنۡ","عِبَادِنَاۚ","وَإِنَّكَ","لَتَهۡدِيٓ","إِلَىٰ","صِرَٰطٖ","مُّسۡتَقِيمٖ"],"ваказалика аухайна илайка руухам мин амрина ма кунта тадрии мал китабу валал ииману валакин жа`алнаху нууран нахдии бихии ман нашау мин `ибадина ва'иннака латахдии ила сиратим мустаḳиим","Таким же образом Мы внушили тебе в откровении дух (Коран) из Нашего повеления. Ты не знал, что такое Писание и что такое вера. Но Мы сделали его светом, посредством которого Мы ведем прямым путем того из Наших рабов, кого пожелаем. Воистину, ты указываешь на прямой путь -",["и так","Мы внушили","тебе","дух","из","Нашего повеления","не","был ты","знаешь","что","Писание","и не","вера","но","Мы сделали его","светом","Мы ведём прямо","им","кого","пожелаем","из","Наших рабов","и поистине, ты","непременно ведёшь","к","пути","прямому"]],[42,53,["صِرَٰطِ","ٱللَّهِ","ٱلَّذِي","لَهُۥ","مَا","فِي","ٱلسَّمَٰوَٰتِ","وَمَا","فِي","ٱلۡأَرۡضِۗ","أَلَآ","إِلَى","ٱللَّهِ","تَصِيرُ","ٱلۡأُمُورُ"],"сиратиллахил лазии лахуу ма фис самавати вама фил арди ала илаллахи тасиирул умуур","путь Аллаха, Которому принадлежит то, что на небесах, и то, что на земле. Воистину, к Аллаху возвращаются дела.",["пути","Аллаха","Которому","принадлежит","то, что","на","небесах","и то, что","на","земле","о да","к","Аллаху","приходят","дела"]],[43,1,["حمٓ"],"хм","Ха. Мим.",["Ха. Мим"]],[43,2,["وَٱلۡكِتَٰبِ","ٱلۡمُبِينِ"],"валкитабил мубиин","Клянусь ясным Писанием!",["клянусь Писанием","ясным"]],[43,3,["إِنَّا","جَعَلۡنَٰهُ","قُرۡءَٰنًا","عَرَبِيّٗا","لَّعَلَّكُمۡ","تَعۡقِلُونَ"],"инна жа`алнаху ḳур'анан `арабиййал ла`аллакум та`ḳилуун","Воистину, Мы сделали его Кораном на арабском языке, чтобы вы могли уразуметь.",["поистине, Мы","сделали его","Кораном","арабским","чтобы вы","уразумели"]],[43,4,["وَإِنَّهُۥ","فِيٓ","أُمِّ","ٱلۡكِتَٰبِ","لَدَيۡنَا","لَعَلِيٌّ","حَكِيمٌ"],"ва'иннахуу фии уммил китаби ладайна ла`алиййун хакиим","Воистину, он находится у Нас в Матери Писания (Хранимой скрижали). Он возвышен, преисполнен мудрости.",["и поистине, он","в","Матери","Писания","у Нас","непременно возвышенный","мудрый"]],[43,5,["أَفَنَضۡرِبُ","عَنكُمُ","ٱلذِّكۡرَ","صَفۡحًا","أَن","كُنتُمۡ","قَوۡمٗا","مُّسۡرِفِينَ"],"афанадрибу `анкумуз зикра сафхан ан кунтум ḳаумам мусрифиин","Неужели Мы отвратим от вас Напоминание (Коран) из-за того, что вы - народ излишествующий?",["неужели Мы отвратим","от вас","Напоминание","отвернувшись","за то, что","были вы","народом","излишествующим"]],[43,6,["وَكَمۡ","أَرۡسَلۡنَا","مِن","نَّبِيّٖ","فِي","ٱلۡأَوَّلِينَ"],"вакам арсална мин набиййин фил аввалиин","Сколько пророков Мы отправляли к первым поколениям!",["и сколько","Мы отправили","из","пророков","среди","первых"]],[43,7,["وَمَا","يَأۡتِيهِم","مِّن","نَّبِيٍّ","إِلَّا","كَانُواْ","بِهِۦ","يَسۡتَهۡزِءُونَ"],"вама йа'тиихим мин набиййин илла кануу бихии йастахзиуун","Но какой бы пророк ни приходил к ним, они издевались над ним.",["и не","приходил к ним","ни один","пророк","без того, чтобы","были они","над ним","насмехаются"]],[43,8,["فَأَهۡلَكۡنَآ","أَشَدَّ","مِنۡهُم","بَطۡشٗا","وَمَضَىٰ","مَثَلُ","ٱلۡأَوَّلِينَ"],"фа'ахлакна ашадда минхум батшан вамада масалул аввалиин","Мы погубили тех, которые превосходили их мощью, и уже миновали примеры прежних поколений.",["и Мы погубили","более сильных","чем они","мощью","и прошёл","пример","первых"]],[43,9,["وَلَئِن","سَأَلۡتَهُم","مَّنۡ","خَلَقَ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضَ","لَيَقُولُنَّ","خَلَقَهُنَّ","ٱلۡعَزِيزُ","ٱلۡعَلِيمُ"],"валаин са'алтахум ман халаḳас самавати вал'арда лайаḳуулунна халаḳахуннал `азиизул `алиим","Если ты спросишь их: «Кто сотворил небеса и землю?». - они непременно скажут: «Их сотворил Могущественный, Знающий».",["и если","ты спросишь их","кто","сотворил","небеса","и землю","непременно скажут они","сотворил их","Могущественный","Знающий"]],[43,10,["ٱلَّذِي","جَعَلَ","لَكُمُ","ٱلۡأَرۡضَ","مَهۡدٗا","وَجَعَلَ","لَكُمۡ","فِيهَا","سُبُلٗا","لَّعَلَّكُمۡ","تَهۡتَدُونَ"],"аллазии жа`ала лакумул арда махдан важа`ала лакум фииха субулал ла`аллакум тахтадуун","Он сделал для вас землю колыбелью и создал для вас на ней дороги, чтобы вы могли следовать прямым путем.",["Тот, Который","сделал","для вас","землю","колыбелью","и сделал","для вас","на ней","дороги","чтобы вы","следовали прямым путём"]]],"m":[[["وَكَذَٰلِكَ","и так",42,52],["أَوۡحَيۡنَآ","Мы внушили",42,52],["إِلَيۡكَ","тебе",42,52],["رُوحٗا","дух",42,52],["مِّنۡ","из",42,52],["أَمۡرِنَاۚ","Нашего повеления",42,52],["مَا","не",42,52],["كُنتَ","был ты",42,52],["تَدۡرِي","знаешь",42,52],["مَا","что",42,52],["ٱلۡكِتَٰبُ","Писание",42,52]],[["وَلَا","и не",42,52],["ٱلۡإِيمَٰنُ","вера",42,52],["وَلَٰكِن","но",42,52],["جَعَلۡنَٰهُ","Мы сделали его",42,52],["نُورٗا","светом",42,52],["نَّهۡدِي","Мы ведём прямо",42,52],["بِهِۦ","им",42,52],["مَن","кого",42,52],["نَّشَآءُ","пожелаем",42,52],["مِنۡ","из",42,52],["عِبَادِنَاۚ","Наших рабов",42,52]],[["وَإِنَّكَ","и поистине, ты",42,52],["لَتَهۡدِيٓ","непременно ведёшь",42,52],["إِلَىٰ","к",42,52],["صِرَٰطٖ","пути",42,52],["مُّسۡتَقِيمٖ","прямому",42,52],[52],["صِرَٰطِ","пути",42,53],["ٱللَّهِ","Аллаха",42,53],["ٱلَّذِي","Которому",42,53],["لَهُۥ","принадлежит",42,53]],[["مَا","то, что",42,53],["فِي","на",42,53],["ٱلسَّمَٰوَٰتِ","небесах",42,53],["وَمَا","и то, что",42,53],["فِي","на",42,53],["ٱلۡأَرۡضِۗ","земле",42,53],["أَلَآ","о да",42,53],["إِلَى","к",42,53],["ٱللَّهِ","Аллаху",42,53],["تَصِيرُ","приходят",42,53],["ٱلۡأُمُورُ","дела",42,53],[53]],["h",43],["b"],[["حمٓ","Ха. Мим",43,1],[1],["وَٱلۡكِتَٰبِ","клянусь Писанием",43,2],["ٱلۡمُبِينِ","ясным",43,2],[2],["إِنَّا","поистине, Мы",43,3],["جَعَلۡنَٰهُ","сделали его",43,3],["قُرۡءَٰنًا","Кораном",43,3],["عَرَبِيّٗا","арабским",43,3]],[["لَّعَلَّكُمۡ","чтобы вы",43,3],["تَعۡقِلُونَ","уразумели",43,3],[3],["وَإِنَّهُۥ","и поистине, он",43,4],["فِيٓ