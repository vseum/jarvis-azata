{"p":490,"j":25,"a":[[43,11,["وَٱلَّذِي","نَزَّلَ","مِنَ","ٱلسَّمَآءِ","مَآءَۢ","بِقَدَرٖ","فَأَنشَرۡنَا","بِهِۦ","بَلۡدَةٗ","مَّيۡتٗاۚ","كَذَٰلِكَ","تُخۡرَجُونَ"],"валлазии наззала минас самаи маа биḳадарин фа'аншарна бихии балдатам майтан казалика тухражуун","Он ниспослал с неба воду в меру, и ею Мы оживили мертвую землю. Таким же образом вы будете выведены из могил.",["и Тот, Который","ниспослал","с","неба","воду","в меру","и Мы оживили","ею","край","мёртвый","так","вы будете выведены"]],[43,12,["وَٱلَّذِي","خَلَقَ","ٱلۡأَزۡوَٰجَ","كُلَّهَا","وَجَعَلَ","لَكُم","مِّنَ","ٱلۡفُلۡكِ","وَٱلۡأَنۡعَٰمِ","مَا","تَرۡكَبُونَ"],"валлазии халаḳал азважа куллаха важа`ала лакум минал фулки вал'ан`ами ма таркабуун","Он сотворил всякие пары животных и растений и создал для вас среди кораблей и скотины те, на которых вы ездите,",["и Тот, Который","сотворил","пары","все их","и сделал","для вас","из","кораблей","и скота","то, что","вы ездите"]],[43,13,["لِتَسۡتَوُۥاْ","عَلَىٰ","ظُهُورِهِۦ","ثُمَّ","تَذۡكُرُواْ","نِعۡمَةَ","رَبِّكُمۡ","إِذَا","ٱسۡتَوَيۡتُمۡ","عَلَيۡهِ","وَتَقُولُواْ","سُبۡحَٰنَ","ٱلَّذِي","سَخَّرَ","لَنَا","هَٰذَا","وَمَا","كُنَّا","لَهُۥ","مُقۡرِنِينَ"],"литаставуу `ала зухуурихии сумма тазкуруу ни`мата раббикум изаставайтум `алайхи ватаḳуулуу субханал лазии саххара лана хаза вама кунна лахуу муḳриниин","чтобы вы поднимались на их спины (или палубы), а затем поминали милость вашего Господа после того, как поднялись на них, и говорили: «Пречист Тот, Кто подчинил нам это, ведь мы сами на такое были неспособны.",["чтобы вы утвердились","на","спинах его","затем","поминали","милость","вашего Господа","когда","утвердились вы","на нём","и говорили","пречист","Тот, Который","подчинил","нам","это","и не","были мы","ему","в силах (подчинить)"]],[43,14,["وَإِنَّآ","إِلَىٰ","رَبِّنَا","لَمُنقَلِبُونَ"],"ва'инна ила раббина ламунḳалибуун","Воистину, мы вернемся к нашему Господу».",["и поистине, мы","к","нашему Господу","непременно возвратимся"]],[43,15,["وَجَعَلُواْ","لَهُۥ","مِنۡ","عِبَادِهِۦ","جُزۡءًاۚ","إِنَّ","ٱلۡإِنسَٰنَ","لَكَفُورٞ","مُّبِينٌ"],"важа`алуу лахуу мин `ибадихии жуз'ан иннал инсана лакафуурум мубиин","Они (многобожники) сделали некоторых из Его рабов частью Его (приписали Ему детей и сотоварищей). Воистину, человек явно неблагодарен.",["и они сделали","Ему","из","Его рабов","частицу","поистине","человек","непременно неблагодарен","явно"]],[43,16,["أَمِ","ٱتَّخَذَ","مِمَّا","يَخۡلُقُ","بَنَاتٖ","وَأَصۡفَىٰكُم","بِٱلۡبَنِينَ"],"амиттахаза мимма йахлуḳу банатин ва'асфакум билбаниин","Неужели из Своих творений Он взял Себе дочерей, а вас почтил сыновьями?",["или","взял Он","из того, что","Он творит","дочерей","а избрал вам","сыновей"]],[43,17,["وَإِذَا","بُشِّرَ","أَحَدُهُم","بِمَا","ضَرَبَ","لِلرَّحۡمَٰنِ","مَثَلٗا","ظَلَّ","وَجۡهُهُۥ","مُسۡوَدّٗا","وَهُوَ","كَظِيمٌ"],"ва'иза бушшира ахадухум бима дараба лиррахмани масалан залла важхухуу мусваддан вахуа казиим","Когда кому-либо из них сообщают весть о рождении той, которую они приписывают Милостивому, его лицо чернеет, и он сдерживает свой гнев.",["и когда","извещён","кто-либо из них","тем, что","он привёл","Милостивому","в пример","становится","лицо его","почерневшим","и он","подавляет гнев"]],[43,18,["أَوَمَن","يُنَشَّؤُاْ","فِي","ٱلۡحِلۡيَةِ","وَهُوَ","فِي","ٱلۡخِصَامِ","غَيۡرُ","مُبِينٖ"],"аваман йунашшау фил хилйати вахуа фил хисами гайру мубиин","Неужели они приписывают Аллаху ту, которую растят в нарядах и которая не способна ясно говорить при тяжбе?",["разве тот, кто","воспитывается","в","украшениях","и он","в","споре","не","ясен (речью)"]],[43,19,["وَجَعَلُواْ","ٱلۡمَلَٰٓئِكَةَ","ٱلَّذِينَ","هُمۡ","عِبَٰدُ","ٱلرَّحۡمَٰنِ","إِنَٰثًاۚ","أَشَهِدُواْ","خَلۡقَهُمۡۚ","سَتُكۡتَبُ","شَهَٰدَتُهُمۡ","وَيُسۡـَٔلُونَ"],"важа`алул малаикатал лазиина хум `ибадур рахмани инасан ашахидуу халḳахум сатуктабу шахадатухум вайус'алуун","Они сделали ангелов, которые являются рабами Милостивого, женщинами. Разве они присутствовали при их сотворении? Их свидетельство будет записано, и они будут спрошены.",["и они сделали","ангелов","которые","они","рабы","Милостивого","женщинами","разве присутствовали они","при сотворении их","будет записано","свидетельство их","и будут они спрошены"]],[43,20,["وَقَالُواْ","لَوۡ","شَآءَ","ٱلرَّحۡمَٰنُ","مَا","عَبَدۡنَٰهُمۗ","مَّا","لَهُم","بِذَٰلِكَ","مِنۡ","عِلۡمٍۖ","إِنۡ","هُمۡ","إِلَّا","يَخۡرُصُونَ"],"ваḳалуу лау шаар рахману ма `абаднахум ма лахум бизалика мин `илмин ин хум илла йахрусуун","Они сказали: «Если бы Милостивый пожелал, то мы не поклонялись бы им». У них нет об этом никакого знания, и они всего лишь лгут.",["и сказали они","если бы","пожелал","Милостивый","не","поклонялись бы мы им","нет","у них","об этом","никакого","знания","не","они","кроме как","лгут"]],[43,21,["أَمۡ","ءَاتَيۡنَٰهُمۡ","كِتَٰبٗا","مِّن","قَبۡلِهِۦ","فَهُم","بِهِۦ","مُسۡتَمۡسِكُونَ"],"ам атайнахум китабам мин ḳаблихии фахум бихии мустамсикуун","Разве Мы даровали им до этого Писание, которого они придерживаются?",["или","Мы дали им","Писание","до","него","и они","его","придерживаются"]],[43,22,["بَلۡ","قَالُوٓاْ","إِنَّا","وَجَدۡنَآ","ءَابَآءَنَا","عَلَىٰٓ","أُمَّةٖ","وَإِنَّا","عَلَىٰٓ","ءَاثَٰرِهِم","مُّهۡتَدُونَ"],"бал ḳалуу инна важадна абаана `ала умматин ва'инна `ала асарихим мухтадуун","О нет! Они сказали: «Воистину, мы нашли своих отцов на этом пути, и мы верно следуем по их стопам».",["нет","сказали они","поистине, мы","нашли","наших отцов","на","вере","и поистине, мы","по","их следам","идём прямым путём"]]],"m":[[["وَٱلَّذِي","и Тот, Который",43,11],["نَزَّلَ","ниспослал",43,11],["مِنَ","с",43,11],["ٱلسَّمَآءِ","неба",43,11],["مَآءَۢ","воду",43,11],["بِقَدَرٖ","в меру",43,11],["فَأَنشَرۡنَا","и Мы оживили",43,11],["بِهِۦ","ею",43,11],["بَلۡدَةٗ","край",43,11],["مَّيۡتٗاۚ","мёртвый",43,11]],[["كَذَٰلِكَ","так",43,11],["تُخۡرَجُونَ","вы будете выведены",43,11],[11],["وَٱلَّذِي","и Тот, Который",43,12],["خَلَقَ","сотворил",43,12],["ٱلۡأَزۡوَٰجَ","пары",43,12],["كُلَّهَا","все их",43,12],["وَجَعَلَ","и сделал",43,12]],[["لَكُم","для вас",43,12],["مِّنَ","из",43,12],["ٱلۡفُلۡكِ","кораблей",43,12],["وَٱلۡأَنۡعَٰمِ","и скота",43,12],["مَا","то, что",43,12],["تَرۡكَبُونَ","вы ездите",43,12],[12],["لِتَسۡتَوُۥاْ","чтобы вы утвердились",43,13],["عَلَىٰ","на",43,13],["ظُهُورِهِۦ","спинах его",43,13]],[["ثُمَّ","затем",43,13],["تَذۡكُرُواْ","поминали",43,13],["نِعۡمَةَ","милость",43,13],["رَبِّكُمۡ","вашего Господа",43,13],["إِذَا","когда",43,13],["ٱسۡتَوَيۡتُمۡ","утвердились вы",43,13],["عَلَيۡهِ","на нём",43,13],["وَتَقُولُواْ","и говорили",43,13],["سُبۡحَٰنَ","пречист",43,13]],[["ٱلَّذِي","Тот, Который",43,13],["سَخَّرَ","подчинил",43,13],["لَنَا","нам",43,13],["هَٰذَا","это",43,13],["وَمَا","и не",43,13],["كُنَّا","были мы",43,13],["لَهُۥ","ему",43,13],["مُقۡرِنِينَ","в силах (подчинить)",43,13],[13],["وَإِنَّآ","и поистине, мы",43,14],["إِلَىٰ","к",43,14],["رَبِّنَا","нашему Господу",43,14]],[["لَمُنقَلِبُونَ","непременно возвратимся",43,14],[14],["وَجَعَلُواْ","и они сделали",43,15],["لَهُۥ","Ему",43,15],["مِنۡ","из",43,15],["عِبَادِهِۦ","Его рабов",43,15],["جُزۡءًاۚ","частицу",43,15],["إِنَّ","поистине",43,15],["ٱلۡإِنسَٰنَ","человек",43,15]],[["لَكَفُورٞ","непременно неблагодарен",43,15],["مُّبِينٌ","явно",43,15],[15],["أَمِ","или",43,16],["ٱتَّخَذَ","взял Он",43,16],["مِمَّا","из того, что",43,16],["يَخۡلُقُ","Он творит",43,16],["بَنَاتٖ","дочерей",43,16],["وَأَصۡفَىٰكُم","а избрал вам",43,16]],[["بِٱلۡبَنِينَ","сыновей",43,16],[16],["وَإِذَا","и когда",43,17],["بُشِّرَ","извещён",43,17],["أَحَدُهُم","кто-либо из них",43,17],["بِمَا","тем, что",43,17],["ضَرَبَ","он привёл",43,17],["لِلرَّحۡمَٰنِ","Милостивому",43,17],["مَثَلٗا","в пример",43,17]],[["ظَلَّ","становится",43,17],["وَجۡهُهُۥ","лицо его",43,17],["مُسۡوَدّٗا","почерневшим",43,17],["وَهُوَ","и он",43,17],["كَظِيمٌ","подавляет гнев",43,17],[17],["أَوَمَن","разве тот, кто",43,18],["يُنَشَّؤُاْ","воспитывается",43,18],["فِي","в",43,18]],[["ٱلۡحِلۡيَةِ","украшениях",43,18],["وَهُوَ","и он",43,18],["فِي","в",43,18],["ٱلۡ