{"p":491,"j":25,"a":[[43,23,["وَكَذَٰلِكَ","مَآ","أَرۡسَلۡنَا","مِن","قَبۡلِكَ","فِي","قَرۡيَةٖ","مِّن","نَّذِيرٍ","إِلَّا","قَالَ","مُتۡرَفُوهَآ","إِنَّا","وَجَدۡنَآ","ءَابَآءَنَا","عَلَىٰٓ","أُمَّةٖ","وَإِنَّا","عَلَىٰٓ","ءَاثَٰرِهِم","مُّقۡتَدُونَ"],"ваказалика ма арсална мин ḳаблика фии ḳарйатим мин назиирин илла ḳала мутрафууха инна важадна абаана `ала умматин ва'инна `ала асарихим муḳтадуун","Таким же образом, какого бы предостерегающего увещевателя Мы ни отправляли до тебя в какое-либо селение, его изнеженные роскошью жители обязательно говорили: «Воистину, мы нашли своих отцов на этом пути, и мы верно следуем по их стопам».",["и так","не","Мы посылали","из","прежде тебя","в","селение","никакого","увещевателя","без того, чтобы","сказали","изнеженные его","поистине, мы","нашли","наших отцов","на","вере","и поистине, мы","по","их следам","следуем"]],[43,24,["قَٰلَ","أَوَلَوۡ","جِئۡتُكُم","بِأَهۡدَىٰ","مِمَّا","وَجَدتُّمۡ","عَلَيۡهِ","ءَابَآءَكُمۡۖ","قَالُوٓاْ","إِنَّا","بِمَآ","أُرۡسِلۡتُم","بِهِۦ","كَٰفِرُونَ"],"ḳала авалау жи'тукум би'ахда мимма важадттум `алайхи абаакум ḳалуу инна бима урсилтум бихии кафируун","Он сказал: «А если я принес вам то, что более верно, чем то, на чем вы нашли ваших отцов?». Они сказали: «Мы не веруем в то, с чем вы посланы».",["он сказал","а если даже","я принёс вам","более верное","чем то, что","вы нашли","на нём","ваших отцов","сказали они","поистине, мы","в то, что","вы посланы","с ним","неверующие"]],[43,25,["فَٱنتَقَمۡنَا","مِنۡهُمۡۖ","فَٱنظُرۡ","كَيۡفَ","كَانَ","عَٰقِبَةُ","ٱلۡمُكَذِّبِينَ"],"фантаḳамна минхум фанзур кайфа кана `аḳибатул муказзибиин","Мы отомстили им. Посмотри же, каким был конец тех, кто считает истину ложью.",["и Мы отомстили","им","посмотри же","каким","был","конец","обвинявших во лжи"]],[43,26,["وَإِذۡ","قَالَ","إِبۡرَٰهِيمُ","لِأَبِيهِ","وَقَوۡمِهِۦٓ","إِنَّنِي","بَرَآءٞ","مِّمَّا","تَعۡبُدُونَ"],"ва'из ḳала ибрахииму ли'абиихи ваḳаумихии иннании бараум мимма та`будуун","Вот Ибрахим (Авраам) сказал своему отцу и народу: «Воистину, я не имею отношения к тому, чему вы поклоняетесь,",["и вот","сказал","Ибрахим","своему отцу","и своему народу","поистине, я","непричастен","к тому, чему","вы поклоняетесь"]],[43,27,["إِلَّا","ٱلَّذِي","فَطَرَنِي","فَإِنَّهُۥ","سَيَهۡدِينِ"],"иллал лазии фатарании фа'иннахуу сайахдиин","кроме Того, Кто сотворил меня. Воистину, Он поведет меня прямым путем».",["кроме","Того, Который","сотворил меня","и поистине, Он","поведёт меня прямым путём"]],[43,28,["وَجَعَلَهَا","كَلِمَةَۢ","بَاقِيَةٗ","فِي","عَقِبِهِۦ","لَعَلَّهُمۡ","يَرۡجِعُونَ"],"важа`алаха калимата баḳийатан фии `аḳибихии ла`аллахум йаржи`уун","Он сделал это (свидетельство о том, что нет божества, кроме Аллаха) словом, пребывающим в его потомстве, чтобы они могли вернуться на прямой путь.",["и он сделал его","словом","остающимся","в","его потомстве","чтобы они","вернулись"]],[43,29,["بَلۡ","مَتَّعۡتُ","هَٰٓؤُلَآءِ","وَءَابَآءَهُمۡ","حَتَّىٰ","جَآءَهُمُ","ٱلۡحَقُّ","وَرَسُولٞ","مُّبِينٞ"],"бал матта`ту ха'улаи ва'абаахум хатта жаахумул хаḳḳу варасуулум мубиин","Но Я позволил им и их отцам пользоваться благами до тех пор, пока к ним не явились истина и разъясняющий посланник.",["но","Я дал пользоваться","этим","и их отцам","пока не","пришли к ним","истина","и посланник","разъясняющий"]],[43,30,["وَلَمَّا","جَآءَهُمُ","ٱلۡحَقُّ","قَالُواْ","هَٰذَا","سِحۡرٞ","وَإِنَّا","بِهِۦ","كَٰفِرُونَ"],"валамма жаахумул хаḳḳу ḳалуу хаза сихрун ва'инна бихии кафируун","Когда же истина явилась к ним, они сказали: «Это - колдовство, и мы не веруем в него».",["и когда","пришла к ним","истина","сказали они","это","колдовство","и поистине, мы","в него","неверующие"]],[43,31,["وَقَالُواْ","لَوۡلَا","نُزِّلَ","هَٰذَا","ٱلۡقُرۡءَانُ","عَلَىٰ","رَجُلٖ","مِّنَ","ٱلۡقَرۡيَتَيۡنِ","عَظِيمٍ"],"ваḳалуу лаула нуззила хазал ḳур'ану `ала ражулим минал ḳарйатайни `азиим","Они также сказали: «Почему этот Коран не был ниспослан великому мужу из двух городов (Мекки и Таифа)?».",["и сказали они","почему не","был ниспослан","этот","Коран","на","мужа","из","двух селений","великого"]],[43,32,["أَهُمۡ","يَقۡسِمُونَ","رَحۡمَتَ","رَبِّكَۚ","نَحۡنُ","قَسَمۡنَا","بَيۡنَهُم","مَّعِيشَتَهُمۡ","فِي","ٱلۡحَيَوٰةِ","ٱلدُّنۡيَاۚ","وَرَفَعۡنَا","بَعۡضَهُمۡ","فَوۡقَ","بَعۡضٖ","دَرَجَٰتٖ","لِّيَتَّخِذَ","بَعۡضُهُم","بَعۡضٗا","سُخۡرِيّٗاۗ","وَرَحۡمَتُ","رَبِّكَ","خَيۡرٞ","مِّمَّا","يَجۡمَعُونَ"],"ахум йаḳсимууна рахмата раббика нахну ḳасамна байнахум ма`иишатахум фил хайаватид дунйа варафа`на ба`дахум фауḳа ба`дин даражатил лийаттахиза ба`духум ба`дан сухриййан варахмату раббика хайрум мимма йажма`уун","Разве это они распределяют милость твоего Господа? Мы распределили между ними их средства к существованию в мирской жизни и возвысили одних из них над другими по степеням, чтобы одни из них брали в услужение себе других. Милость твоего Господа лучше того, что они собирают.",["разве они","распределяют","милость","твоего Господа","Мы","распределили","между ними","их пропитание","в","жизни","ближней","и возвысили","одних из них","над","другими","степенями","чтобы взяли","одни из них","других","в услужение","а милость","твоего Господа","лучше","того, что","они собирают"]],[43,33,["وَلَوۡلَآ","أَن","يَكُونَ","ٱلنَّاسُ","أُمَّةٗ","وَٰحِدَةٗ","لَّجَعَلۡنَا","لِمَن","يَكۡفُرُ","بِٱلرَّحۡمَٰنِ","لِبُيُوتِهِمۡ","سُقُفٗا","مِّن","فِضَّةٖ","وَمَعَارِجَ","عَلَيۡهَا","يَظۡهَرُونَ"],"валаула ан йакуунан насу умматан вахидатал лажа`ална лиман йакфуру биррахмани либуйуутихим суḳуфам мин фиддатин вама`арижа `алайха йазхаруун","Если бы люди не могли стать одной общиной неверующих, то Мы сделали бы в домах тех, которые не веруют в Милостивого, серебряные крыши и лестницы, на которые они бы взбирались,",["и если бы не","что","стали бы","люди","общиной","единой","непременно Мы сделали бы","для тех, кто","не верует","в Милостивого","для их домов","крыши","из","серебра","и лестницы","по которым","они поднимаются"]]],"m":[[["وَكَذَٰلِكَ","и так",43,23],["مَآ","не",43,23],["أَرۡسَلۡنَا","Мы посылали",43,23],["مِن","из",43,23],["قَبۡلِكَ","прежде тебя",43,23],["فِي","в",43,23],["قَرۡيَةٖ","селение",43,23],["مِّن","никакого",43,23],["نَّذِيرٍ","увещевателя",43,23],["إِلَّا","без того, чтобы",43,23],["قَالَ","сказали",43,23],["مُتۡرَفُوهَآ","изнеженные его",43,23]],[["إِنَّا","поистине, мы",43,23],["وَجَدۡنَآ","нашли",43,23],["ءَابَآءَنَا","наших отцов",43,23],["عَلَىٰٓ","на",43,23],["أُمَّةٖ","вере",43,23],["وَإِنَّا","и поистине, мы",43,23],["عَلَىٰٓ","по",43,23],["ءَاثَٰرِهِم","их следам",43,23],["مُّقۡتَدُونَ","следуем",43,23],[23]],[["۞ قَٰلَ","он сказал",43,24],["أَوَلَوۡ","а если даже",43,24],["جِئۡتُكُم","я принёс вам",43,24],["بِأَهۡدَىٰ","более верное",43,24],["مِمَّا","чем то, что",43,24],["وَجَدتُّمۡ","вы нашли",43,24],["عَلَيۡهِ","на нём",43,24],["ءَابَآءَكُمۡۖ","ваших отцов",43,24],["قَالُوٓاْ","сказали они",43,24]],[["إِنَّا","поистине, мы",43,24],["بِمَآ","в то, что",43,24],["أُرۡسِلۡتُم","вы посланы",43,24],["بِهِۦ","с ним",43,24],["كَٰفِرُونَ","неверующие",43,24],[24],["فَٱنتَقَمۡنَا","и Мы отомстили",43,25],["مِنۡهُمۡۖ","им",43,25],["فَٱنظُرۡ","посмотри же",43,25],["كَيۡفَ","каким",43,25]],[["كَانَ","был",43,25],["عَٰقِبَةُ","конец",43,25],["ٱلۡمُكَذِّبِينَ","обвинявших во лжи",43,25],[25],["وَإِذۡ","и вот",43,26],["قَالَ","сказал",43,26],["إِبۡرَٰهِيمُ","Ибрахим",43,26],["لِأَبِيهِ","своему отцу",43,26],["وَقَوۡمِهِۦٓ","и своему народу",43,26]],[["إِنَّنِي","поистине, я",43,26],["بَرَآءٞ","непричастен",43,26],["مِّمَّا","к тому, чему",43,26],["تَعۡبُدُونَ","вы поклоняетесь",43,26],[26],["إِلَّا","кроме",43,27],["ٱلَّذِي","Того, Который",43,27],["فَطَرَنِي","сотворил меня",43,27],["فَإِنَّهُۥ","и поистине, Он",43,27],["سَيَهۡدِينِ","поведёт меня прямым путём",43,27]],[[27],["وَجَعَلَهَا","и он сделал его",43,28],["كَلِمَةَۢ","словом",43,28],["بَاقِيَةٗ","остающимся",43,28],["فِي","в",43,28],["عَقِبِهِۦ","его потомстве",43,28],["لَعَلَّهُمۡ","чтобы они",43,28],["يَرۡجِعُونَ","вернулись",43,28],[28],["بَلۡ","но",43,29]],[["مَتَّعۡتُ","Я дал пользоваться",43,29],["هَٰٓؤُلَآءِ","этим",43,29],["وَءَابَآءَهُمۡ","и их отцам",43,29],["حَتَّىٰ","пока не",43,29],["جَآءَهُمُ","пришли к ним",43,29],["ٱلۡحَقُّ","истина",43,29],["وَرَسُولٞ","и посланник",43,29],["مُّبِينٞ","разъясняющий",43,29],[29]],[["وَلَمَّا","и когда",43,30],["جَآءَهُمُ","пришла к ним",43,30],["ٱلۡحَقُّ","истина",43,30],["قَالُواْ","сказали они",43,30],["هَٰذَا","это",43,30],["سِحۡرٞ","колдовство",43,30],["وَإِنَّا","и поистине, мы",43,30],["بِهِۦ","в него",43,30],["كَٰفِرُونَ","неверующие",43,30],[30],["وَقَالُواْ","и сказали они",43,31]],[["لَوۡلَا","почему не",43,31],["نُزِّلَ","был ниспослан",43,31],["هَٰذَا","этот",43,31],["ٱلۡقُرۡءَانُ","Коран",43,31],["عَلَىٰ","на",43,31],["رَجُلٖ","мужа",43,31],["مِّنَ","из",43,31],["ٱلۡقَرۡيَتَيۡنِ","двух селений",43,31],["عَظِيمٍ","великого",43,31],[31],["أَهُمۡ","разве они",43,32]],[["يَقۡسِمُونَ","распределяют",43,32],["رَحۡمَتَ","милость",43,32],["رَبِّكَۚ","твоего Господа",43,32],["نَحۡنُ","Мы",43,32],["قَسَمۡنَا","распределили",43,32],["بَيۡنَهُم","между ними",43,32],["مَّعِيشَتَهُمۡ","их пропитание",43,32],["فِي","в",43,32],["ٱلۡحَيَوٰةِ","жизни",43,32]],[["ٱلدُّنۡيَاۚ","ближней",43,32],["وَرَفَعۡنَا","и возвысили",43,32],["بَعۡضَهُمۡ","одних из них",43,32],["فَوۡقَ","над",43,32],["بَعۡضٖ","другими",43,32],["دَرَجَٰتٖ","степенями",43,32],["لِّيَتَّخِذَ","чтобы взяли",43,32],["بَعۡضُهُم","одни из них",43,32]],[["بَعۡضٗا","других",43,32],["سُخۡرِيّٗاۗ","в услужение",43,32],["وَرَحۡمَتُ","а милость",43,32],["رَبِّكَ","твоего Господа",43,32],["خَيۡرٞ","лучше",43,32],["مِّمَّا","того, что",43,32],["يَجۡمَعُونَ","они собирают",43,32],[32],["وَلَوۡلَآ","и если бы не",43,33]],[["أَن","что",43,33],["يَكُونَ","стали бы",43,33],["ٱلنَّاسُ","люди",43,33],["أُمَّةٗ","общиной",43,33],["وَٰحِدَةٗ","единой",43,33],["لَّجَعَلۡنَا","непременно Мы сделали бы",43,33],["لِمَن","для тех, кто",43,33],["يَكۡفُرُ","не верует",43,33],["بِٱلرَّحۡمَٰنِ","в Милостивого",43,33]],[["لِبُيُوتِهِمۡ","для их домов",43,33],["سُقُفٗا","крыши",43,33],["مِّن","из",43,33],["فِضَّةٖ","серебра",43,33],["وَمَعَارِجَ","и лестницы",43,33],["عَلَيۡهَا","по которым",43,33],["يَظۡهَرُونَ","они поднимаются",43,33],[33]]]}