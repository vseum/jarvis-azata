{"p":492,"j":25,"a":[[43,34,["وَلِبُيُوتِهِمۡ","أَبۡوَٰبٗا","وَسُرُرًا","عَلَيۡهَا","يَتَّكِـُٔونَ"],"валибуйуутихим абвабан васуруран `алайха йаттакиуун","а также серебряные двери и ложа в их домах, на которых они бы лежали, прислонившись,",["и для их домов","двери","и ложа","на которых","они возлежат"]],[43,35,["وَزُخۡرُفٗاۚ","وَإِن","كُلُّ","ذَٰلِكَ","لَمَّا","مَتَٰعُ","ٱلۡحَيَوٰةِ","ٱلدُّنۡيَاۚ","وَٱلۡأٓخِرَةُ","عِندَ","رَبِّكَ","لِلۡمُتَّقِينَ"],"вазухруфан ва'ин куллу залика ламма мата`ул хайаватид дунйа вал'ахирату `инда раббика лилмуттаḳиин","а также украшения. Все это - всего лишь преходящие блага мирской жизни, а Последняя жизнь у твоего Господа уготована для богобоязненных.",["и украшения","и не","всё","это","лишь","утеха","жизни","мирской","а Последняя жизнь","у","твоего Господа","для богобоязненных"]],[43,36,["وَمَن","يَعۡشُ","عَن","ذِكۡرِ","ٱلرَّحۡمَٰنِ","نُقَيِّضۡ","لَهُۥ","شَيۡطَٰنٗا","فَهُوَ","لَهُۥ","قَرِينٞ"],"ваман йа`шу `ан зикрир рахмани нуḳаййид лахуу шайтанан фахуа лахуу ḳариин","К тем, кто отвращается от поминания Милостивого (или кто слеп к Нему), Мы приставим дьявола, и он станет его товарищем.",["а кто","отвращается","от","поминания","Милостивого","Мы приставим","к нему","дьявола","и он","ему","товарищ"]],[43,37,["وَإِنَّهُمۡ","لَيَصُدُّونَهُمۡ","عَنِ","ٱلسَّبِيلِ","وَيَحۡسَبُونَ","أَنَّهُم","مُّهۡتَدُونَ"],"ва'иннахум лайасуддуунахум `анис сабиили вайахсабууна аннахум мухтадуун","Они не будут пускать их на путь Аллаха, а те будут считать, что они следуют прямым путем.",["и поистине они","непременно отвращают их","от","пути","и считают","что они","на прямом пути"]],[43,38,["حَتَّىٰٓ","إِذَا","جَآءَنَا","قَالَ","يَٰلَيۡتَ","بَيۡنِي","وَبَيۡنَكَ","بُعۡدَ","ٱلۡمَشۡرِقَيۡنِ","فَبِئۡسَ","ٱلۡقَرِينُ"],"хатта иза жаана ḳала йалайта байнии вабайнака бу`дал машриḳайни фаби'сал ḳариин","Когда же неверующий явится к Нам, он скажет дьяволу: «Лучше бы между мной и тобой было расстояние от запада до востока! Какой же ты плохой товарищ!».",["пока","когда","он придёт к Нам","он скажет","о, если бы","между мной","и между тобой","расстояние","двух востоков","и как скверен","товарищ"]],[43,39,["وَلَن","يَنفَعَكُمُ","ٱلۡيَوۡمَ","إِذ","ظَّلَمۡتُمۡ","أَنَّكُمۡ","فِي","ٱلۡعَذَابِ","مُشۡتَرِكُونَ"],"валан йанфа`акумул йаума из заламтум аннакум фил `азаби муштарикуун","Им будет сказано: «Вы поступали несправедливо, и сегодня вам не поможет то, что вы разделяете мучения».",["и не","поможет вам","сегодня","раз уж","вы были несправедливы","что вы","в","мучениях","соучастники"]],[43,40,["أَفَأَنتَ","تُسۡمِعُ","ٱلصُّمَّ","أَوۡ","تَهۡدِي","ٱلۡعُمۡيَ","وَمَن","كَانَ","فِي","ضَلَٰلٖ","مُّبِينٖ"],"афаанта тусми`ус сумма ау тахдил `умйа ваман кана фии далалим мубиин","Разве ты можешь заставить слышать глухих или наставить на прямой путь слепых и того, кто находится в очевидном заблуждении?",["разве ты","заставишь слышать","глухих","или","наставишь","слепых","и того, кто","находится","в","заблуждении","очевидном"]],[43,41,["فَإِمَّا","نَذۡهَبَنَّ","بِكَ","فَإِنَّا","مِنۡهُم","مُّنتَقِمُونَ"],"фа'имма назхабанна бика фа'инна минхум мунтаḳимуун","Мы можем забрать тебя, но Мы все равно непременно отомстим им.",["и если же","Мы непременно заберём","тебя","то поистине Мы","им","отомстим"]],[43,42,["أَوۡ","نُرِيَنَّكَ","ٱلَّذِي","وَعَدۡنَٰهُمۡ","فَإِنَّا","عَلَيۡهِم","مُّقۡتَدِرُونَ"],"ау нурийаннакал лазии ва`аднахум фа'инна `алайхим муḳтадируун","Мы также может показать тебе то, что обещали им, ведь Мы властны над ними.",["или","Мы непременно покажем тебе","то, что","Мы обещали им","то поистине Мы","над ними","властны"]],[43,43,["فَٱسۡتَمۡسِكۡ","بِٱلَّذِيٓ","أُوحِيَ","إِلَيۡكَۖ","إِنَّكَ","عَلَىٰ","صِرَٰطٖ","مُّسۡتَقِيمٖ"],"фастамсик биллазии уухийа илайка иннака `ала сиратим мустаḳиим","Придерживайся того, что внушено тебе в откровении. Воистину, ты - на прямом пути.",["так держись","того, что","внушено","тебе","поистине ты","на","пути","прямом"]],[43,44,["وَإِنَّهُۥ","لَذِكۡرٞ","لَّكَ","وَلِقَوۡمِكَۖ","وَسَوۡفَ","تُسۡـَٔلُونَ"],"ва'иннахуу лазикрул лака валиḳаумика васауфа тус'алуун","Это - Напоминание о тебе и твоем народе (или для тебя и твоего народа), и вы будете спрошены.",["и поистине, он","непременно напоминание","для тебя","и для народа твоего","и вскоре","будете спрошены"]],[43,45,["وَسۡـَٔلۡ","مَنۡ","أَرۡسَلۡنَا","مِن","قَبۡلِكَ","مِن","رُّسُلِنَآ","أَجَعَلۡنَا","مِن","دُونِ","ٱلرَّحۡمَٰنِ","ءَالِهَةٗ","يُعۡبَدُونَ"],"вас'ал ман арсална мин ḳаблика мир русулина ажа`ална мин дуунир рахмани алихатан йу`бадуун","Спроси тех посланников, которых Мы отправили до тебя, сделали ли Мы помимо Милостивого других богов, которым можно поклоняться?",["и спроси","тех, кого","Мы отправили","до","тебя","из","Наших посланников","разве Мы сделали","(из)","помимо","Милостивого","богов","которым поклоняются"]],[43,46,["وَلَقَدۡ","أَرۡسَلۡنَا","مُوسَىٰ","بِـَٔايَٰتِنَآ","إِلَىٰ","فِرۡعَوۡنَ","وَمَلَإِيْهِۦ","فَقَالَ","إِنِّي","رَسُولُ","رَبِّ","ٱلۡعَٰلَمِينَ"],"валаḳад арсална мууса би'айатина ила фир`ауна вамалаихии фаḳала иннии расуулу раббил `аламиин","Мы уже отправили Мусу (Моисея) с Нашими знамениями к Фараону и его знати, и он сказал: «Воистину, я - посланник Господа миров».",["и уже","Мы отправили","Мусу","с Нашими знамениями","к","Фараону","и его знати","и он сказал","поистине я","посланник","Господа","миров"]],[43,47,["فَلَمَّا","جَآءَهُم","بِـَٔايَٰتِنَآ","إِذَا","هُم","مِّنۡهَا","يَضۡحَكُونَ"],"фаламма жаахум би'айатина иза хум минха йадхакуун","Когда же он явился к ним с Нашими знамениями, они стали смеяться над ними.",["когда же","он пришёл к ним","с Нашими знамениями","тотчас","они","над ними","смеются"]]],"m":[[["وَلِبُيُوتِهِمۡ","и для их домов",43,34],["أَبۡوَٰبٗا","двери",43,34],["وَسُرُرًا","и ложа",43,34],["عَلَيۡهَا","на которых",43,34],["يَتَّكِـُٔونَ","они возлежат",43,34],[34],["وَزُخۡرُفٗاۚ","и украшения",43,35],["وَإِن","и не",43,35]],[["كُلُّ","всё",43,35],["ذَٰلِكَ","это",43,35],["لَمَّا","лишь",43,35],["مَتَٰعُ","утеха",43,35],["ٱلۡحَيَوٰةِ","жизни",43,35],["ٱلدُّنۡيَاۚ","мирской",43,35],["وَٱلۡأٓخِرَةُ","а Последняя жизнь",43,35],["عِندَ","у",43,35],["رَبِّكَ","твоего Господа",43,35]],[["لِلۡمُتَّقِينَ","для богобоязненных",43,35],[35],["وَمَن","а кто",43,36],["يَعۡشُ","отвращается",43,36],["عَن","от",43,36],["ذِكۡرِ","поминания",43,36],["ٱلرَّحۡمَٰنِ","Милостивого",43,36],["نُقَيِّضۡ","Мы приставим",43,36],["لَهُۥ","к нему",43,36],["شَيۡطَٰنٗا","дьявола",43,36]],[["فَهُوَ","и он",43,36],["لَهُۥ","ему",43,36],["قَرِينٞ","товарищ",43,36],[36],["وَإِنَّهُمۡ","и поистине они",43,37],["لَيَصُدُّونَهُمۡ","непременно отвращают их",43,37],["عَنِ","от",43,37],["ٱلسَّبِيلِ","пути",43,37],["وَيَحۡسَبُونَ","и считают",43,37]],[["أَنَّهُم","что они",43,37],["مُّهۡتَدُونَ","на прямом пути",43,37],[37],["حَتَّىٰٓ","пока",43,38],["إِذَا","когда",43,38],["جَآءَنَا","он придёт к Нам",43,38],["قَالَ","он скажет",43,38],["يَٰلَيۡتَ","о, если бы",43,38],["بَيۡنِي","между мной",43,38],["وَبَيۡنَكَ","и между тобой",43,38]],[["بُعۡدَ","расстояние",43,38],["ٱلۡمَشۡرِقَيۡنِ","двух востоков",43,38],["فَبِئۡسَ","и как скверен",43,38],["ٱلۡقَرِينُ","товарищ",43,38],[38],["وَلَن","и не",43,39],["يَنفَعَكُمُ","поможет вам",43,39],["ٱلۡيَوۡمَ","сегодня",43,39]],[["إِذ","раз уж",43,39],["ظَّلَمۡتُمۡ","вы были несправедливы",43,39],["أَنَّكُمۡ","что вы",43,39],["فِي","в",43,39],["ٱلۡعَذَابِ","мучениях",43,39],["مُشۡتَرِكُونَ","соучастники",43,39],[39],["أَفَأَنتَ","разве ты",43,40],["تُسۡمِعُ","заставишь слышать",43,40]],[["ٱلصُّمَّ","глухих",43,40],["أَوۡ","или",43,40],["تَهۡدِي","наставишь",43,40],["ٱلۡعُمۡيَ","слепых",43,40],["وَمَن","и того, кто",43,40],["كَانَ","находится",43,40],["فِي","в",43,40],["ضَلَٰلٖ","заблуждении",43,40],["مُّبِينٖ","очевидном",43,40],[40]],[["فَإِمَّا","и если же",43,41],["نَذۡهَبَنَّ","Мы непременно заберём",43,41],["بِكَ","тебя",43,41],["فَإِنَّا","то поистине Мы",43,41],["مِنۡهُم","им",43,41],["مُّنتَقِمُونَ","отомстим",43,41],[41],["أَوۡ","или",43,42],["نُرِيَنَّكَ","Мы непременно покажем тебе",43,42],["ٱلَّذِي","то, что",43,42]],[["وَعَدۡنَٰهُمۡ","Мы обещали им",43,42],["فَإِنَّا","то поистине Мы",43,42],["عَلَيۡهِم","над ними",43,42],["مُّقۡتَدِرُونَ","властны",43,42],[42],["فَٱسۡتَمۡسِكۡ","так держись",43,43],["بِٱلَّذِيٓ","того, что",43,43],["أُوحِيَ","внушено",43,43]],[["إِلَيۡكَۖ","тебе",43,43],["إِنَّكَ","поистине ты",43,43],["عَلَىٰ","на",43,43],["صِرَٰطٖ","пути",43,43],["مُّسۡتَقِيمٖ","прямом",43,43],[43],["وَإِنَّهُۥ","и поистине, он",43,44],["لَذِكۡرٞ","непременно напоминание",43,44],["لَّكَ","для тебя",43,44],["وَلِقَوۡمِكَۖ","и для народа твоего",43,44]],[["وَسَوۡفَ","и вскоре",43,44],["تُسۡـَٔلُونَ","будете спрошены",43,44],[44],["وَسۡـَٔلۡ","и спроси",43,45],["مَنۡ","тех, кого",43,45],["أَرۡسَلۡنَا","Мы отправили",43,45],["مِن","до",43,45],["قَبۡلِكَ","тебя",43,45],["مِن","из",43,45],["رُّسُلِنَآ","Наших посланников",43,45]],[["أَجَعَلۡنَا","разве Мы сделали",43,45],["مِن","(из)",43,45],["دُونِ","помимо",43,45],["ٱلرَّحۡمَٰنِ","Милостивого",43,45],["ءَالِهَةٗ","богов",43,45],["يُعۡبَدُونَ","которым поклоняются",43,45],[45],["وَلَقَدۡ","и уже",43,46],["أَرۡسَلۡنَا","Мы отправили",43,46]],[["مُوسَىٰ","Мусу",43,46],["بِـَٔايَٰتِنَآ","с Нашими знамениями",43,46],["إِلَىٰ","к",43,46],["فِرۡعَوۡنَ","Фараону",43,46],["وَمَلَإِيْهِۦ","и его знати",43,46],["فَقَالَ","и он сказал",43,46],["إِنِّي","поистине я",43,46],["رَسُولُ","посланник",43,46]],[["رَبِّ","Господа",43,46],["ٱلۡعَٰلَمِينَ","миров",43,46],[46],["فَلَمَّا","когда же",43,47],["جَآءَهُم","он пришёл к ним",43,47],["بِـَٔايَٰتِنَآ","с Нашими знамениями",43,47],["إِذَا","тотчас",43,47],["هُم","они",43,47],["مِّنۡهَا","над ними",43,47],["يَضۡحَكُونَ","смеются",43,47],[47]]]}