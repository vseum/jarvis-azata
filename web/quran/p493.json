{"p":493,"j":25,"a":[[43,48,["وَمَا","نُرِيهِم","مِّنۡ","ءَايَةٍ","إِلَّا","هِيَ","أَكۡبَرُ","مِنۡ","أُخۡتِهَاۖ","وَأَخَذۡنَٰهُم","بِٱلۡعَذَابِ","لَعَلَّهُمۡ","يَرۡجِعُونَ"],"вама нуриихим мин айатин илла хийа акбару мин ухтиха ва'ахазнахум бил`азаби ла`аллахум йаржи`уун","Какое бы из знамений Мы ни показывали им, оно превосходило предыдущее. Мы подвергли их мучениям, чтобы они могли вернуться на прямой путь.",["и не","Мы показывали им","(никакого)","знамения","кроме (того, что)","оно","больше","чем","его сестра","и Мы схватили их","мучением","чтобы они","вернулись"]],[43,49,["وَقَالُواْ","يَٰٓأَيُّهَ","ٱلسَّاحِرُ","ٱدۡعُ","لَنَا","رَبَّكَ","بِمَا","عَهِدَ","عِندَكَ","إِنَّنَا","لَمُهۡتَدُونَ"],"ваḳалуу йа'аййухас сахируд`у лана раббака бима `ахида `индака иннана ламухтадуун","Они сказали: «О колдун! Помолись за нас твоему Господу согласно завету, который Он заключил с тобой, и тогда мы обязательно последуем прямым путем».",["и они сказали","о","колдун","помолись","за нас","твоему Господу","тем, что","Он заключил","с тобой","поистине мы","непременно пойдём прямым путём"]],[43,50,["فَلَمَّا","كَشَفۡنَا","عَنۡهُمُ","ٱلۡعَذَابَ","إِذَا","هُمۡ","يَنكُثُونَ"],"фаламма кашафна `анхумул `азаба иза хум йанкусуун","Когда же Мы спасли их от мучений, они тотчас нарушили данное слово.",["когда же","Мы удалили","от них","мучение","тотчас","они","нарушают (слово)"]],[43,51,["وَنَادَىٰ","فِرۡعَوۡنُ","فِي","قَوۡمِهِۦ","قَالَ","يَٰقَوۡمِ","أَلَيۡسَ","لِي","مُلۡكُ","مِصۡرَ","وَهَٰذِهِ","ٱلۡأَنۡهَٰرُ","تَجۡرِي","مِن","تَحۡتِيٓۚ","أَفَلَا","تُبۡصِرُونَ"],"ванада фир`ауну фии ḳаумихии ḳала йаḳауми алайса лии мулку мисра вахазихил анхару тажрии мин тахтии афала тубсируун","Фараон воззвал к своему народу и сказал: «О мой народ! Разве не мне принадлежит власть над Египтом и эти реки, что текут подо мною? Разве вы не видите?",["и воззвал","Фараон","к","своему народу","он сказал","о мой народ","разве не","мне (принадлежит)","власть","Египта","и эти","реки","текут","из","под мною","разве не","вы видите"]],[43,52,["أَمۡ","أَنَا۠","خَيۡرٞ","مِّنۡ","هَٰذَا","ٱلَّذِي","هُوَ","مَهِينٞ","وَلَا","يَكَادُ","يُبِينُ"],"ам ана хайрум мин хазал лазии хуа махиинун вала йакаду йубиин","Разве я не лучше этого презренного, который едва объясняется?",["или","я","лучше","чем","этот","который","он","презренный","и не","почти (может)","изъясниться"]],[43,53,["فَلَوۡلَآ","أُلۡقِيَ","عَلَيۡهِ","أَسۡوِرَةٞ","مِّن","ذَهَبٍ","أَوۡ","جَآءَ","مَعَهُ","ٱلۡمَلَٰٓئِكَةُ","مُقۡتَرِنِينَ"],"фалаула улḳийа `алайхи асвиратум мин захабин ау жаа ма`ахул малаикату муḳтариниин","И почему на него не надеты браслеты из золота? И почему с ним не явились сопутствующие ангелы?».",["почему же не","надеты","на него","браслеты","из","золота","или (не)","пришли","с ним","ангелы","сопровождая"]],[43,54,["فَٱسۡتَخَفَّ","قَوۡمَهُۥ","فَأَطَاعُوهُۚ","إِنَّهُمۡ","كَانُواْ","قَوۡمٗا","فَٰسِقِينَ"],"фастахаффа ḳаумахуу фа'ата`ууху иннахум кануу ḳауман фасиḳиин","Он обманул свой народ (или счел свой народ легкомысленным), и они подчинились ему. Воистину, они были людьми нечестивыми.",["и он одурачил","свой народ","и они подчинились ему","поистине они","были","людьми","нечестивыми"]],[43,55,["فَلَمَّآ","ءَاسَفُونَا","ٱنتَقَمۡنَا","مِنۡهُمۡ","فَأَغۡرَقۡنَٰهُمۡ","أَجۡمَعِينَ"],"фаламма асафуунантаḳамна минхум фа'аграḳнахум ажма`иин","Когда же они разгневали Нас, Мы отомстили им и потопили их всех.",["и когда","разгневали Нас","Мы отомстили","им","и Мы потопили их","всех"]],[43,56,["فَجَعَلۡنَٰهُمۡ","سَلَفٗا","وَمَثَلٗا","لِّلۡأٓخِرِينَ"],"фажа`алнахум салафан вамасалал лил'ахириин","Мы сделали их предшественниками и назидательным примером для остальных.",["и Мы сделали их","предшественниками","и примером","для последующих"]],[43,57,["وَلَمَّا","ضُرِبَ","ٱبۡنُ","مَرۡيَمَ","مَثَلًا","إِذَا","قَوۡمُكَ","مِنۡهُ","يَصِدُّونَ"],"валамма дурибабну марйама масалан иза ḳаумука минху йасиддуун","А когда приводят в пример сына Марьям (Марии), твой народ радостно восклицает.",["и когда","приведен","сын","Марьям","примером","вот","народ твой","от этого","шумно восклицают"]],[43,58,["وَقَالُوٓاْ","ءَأَٰلِهَتُنَا","خَيۡرٌ","أَمۡ","هُوَۚ","مَا","ضَرَبُوهُ","لَكَ","إِلَّا","جَدَلَۢاۚ","بَلۡ","هُمۡ","قَوۡمٌ","خَصِمُونَ"],"ваḳалуу а'алихатуна хайрун ам хуа ма дарабууху лака илла жадала бал хум ḳаумун хасимуун","Они говорят: «Наши боги лучше или он?». Они приводят его тебе в пример только для того, чтобы поспорить. Они являются людьми препирающимися!",["и они сказали","разве наши боги","лучше","или","он","не","они привели его","тебе","кроме как","ради спора","нет же","они","люди","препирающиеся"]],[43,59,["إِنۡ","هُوَ","إِلَّا","عَبۡدٌ","أَنۡعَمۡنَا","عَلَيۡهِ","وَجَعَلۡنَٰهُ","مَثَلٗا","لِّبَنِيٓ","إِسۡرَٰٓءِيلَ"],"ин хуа илла `абдун ан`амна `алайхи важа`алнаху масалал либании исраиил","Он - всего лишь раб, которого Мы облагодетельствовали и сделали примером для сынов Исраила (Израиля).",["не","он","кроме","раб","Мы оказали милость","ему","и сделали его","примером","для сынов","Исраила"]],[43,60,["وَلَوۡ","نَشَآءُ","لَجَعَلۡنَا","مِنكُم","مَّلَٰٓئِكَةٗ","فِي","ٱلۡأَرۡضِ","يَخۡلُفُونَ"],"валау нашау лажа`ална минкум малаикатан фил арди йахлуфуун","Если бы Мы пожелали, то заменили бы вас на земле ангелами, которые бы стали вашими преемниками.",["и если бы","Мы пожелали","непременно сделали бы","из вас","ангелов","на","земле","наследующих"]]],"m":[[["وَمَا","и не",43,48],["نُرِيهِم","Мы показывали им",43,48],["مِّنۡ","(никакого)",43,48],["ءَايَةٍ","знамения",43,48],["إِلَّا","кроме (того, что)",43,48],["هِيَ","оно",43,48],["أَكۡبَرُ","больше",43,48],["مِنۡ","чем",43,48],["أُخۡتِهَاۖ","его сестра",43,48],["وَأَخَذۡنَٰهُم","и Мы схватили их",43,48]],[["بِٱلۡعَذَابِ","мучением",43,48],["لَعَلَّهُمۡ","чтобы они",43,48],["يَرۡجِعُونَ","вернулись",43,48],[48],["وَقَالُواْ","и они сказали",43,49],["يَٰٓأَيُّهَ","о",43,49],["ٱلسَّاحِرُ","колдун",43,49],["ٱدۡعُ","помолись",43,49],["لَنَا","за нас",43,49]],[["رَبَّكَ","твоему Господу",43,49],["بِمَا","тем, что",43,49],["عَهِدَ","Он заключил",43,49]