{"p":494,"j":25,"a":[[43,61,["وَإِنَّهُۥ","لَعِلۡمٞ","لِّلسَّاعَةِ","فَلَا","تَمۡتَرُنَّ","بِهَا","وَٱتَّبِعُونِۚ","هَٰذَا","صِرَٰطٞ","مُّسۡتَقِيمٞ"],"ва'иннахуу ла`илмул лисса`ати фала тамтарунна биха ваттаби`ууни хаза сиратум мустаḳиим","Воистину, он (Иса, или Коран, или Мухаммад) является признаком Часа. Нисколько не препирайтесь по поводу него (Часа) и следуйте за Мной! Это - прямой путь.",["и поистине он","непременно признак","Часа","так не","сомневайтесь","в нём","и следуйте за Мной","это","путь","прямой"]],[43,62,["وَلَا","يَصُدَّنَّكُمُ","ٱلشَّيۡطَٰنُۖ","إِنَّهُۥ","لَكُمۡ","عَدُوّٞ","مُّبِينٞ"],"вала йасудданнакумуш шайтану иннахуу лакум `адуввум мубиин","И пусть дьявол не отвратит вас, ведь он является вашим явным врагом.",["и пусть не","отвратит вас","дьявол","поистине он","для вас","враг","явный"]],[43,63,["وَلَمَّا","جَآءَ","عِيسَىٰ","بِٱلۡبَيِّنَٰتِ","قَالَ","قَدۡ","جِئۡتُكُم","بِٱلۡحِكۡمَةِ","وَلِأُبَيِّنَ","لَكُم","بَعۡضَ","ٱلَّذِي","تَخۡتَلِفُونَ","فِيهِۖ","فَٱتَّقُواْ","ٱللَّهَ","وَأَطِيعُونِ"],"валамма жаа `ииса билбаййинати ḳала ḳад жи'тукум билхикмати валиубаййина лакум ба`дал лазии тахталифууна фиихи фаттаḳуллаха ва'атии`уун","Когда Иса (Иисус) явился с ясными знамениями, он сказал: «Я пришел к вам с мудростью и для того, чтобы разъяснить вам часть того, относительно чего вы расходитесь во мнениях. Бойтесь же Аллаха и повинуйтесь мне!",["и когда","пришёл","Иса","с ясными знамениями","он сказал","уже","я пришёл к вам","с мудростью","и чтобы разъяснить","вам","часть","того, что","вы расходитесь","в нём","так бойтесь","Аллаха","и повинуйтесь мне"]],[43,64,["إِنَّ","ٱللَّهَ","هُوَ","رَبِّي","وَرَبُّكُمۡ","فَٱعۡبُدُوهُۚ","هَٰذَا","صِرَٰطٞ","مُّسۡتَقِيمٞ"],"инналлаха хуа раббии вараббукум фа`будууху хаза сиратум мустаḳиим","Воистину, Аллах - мой Господь и ваш Господь. Поклоняйтесь же Ему. Это - прямой путь».",["поистине","Аллах","Он","мой Господь","и ваш Господь","так поклоняйтесь Ему","это","путь","прямой"]],[43,65,["فَٱخۡتَلَفَ","ٱلۡأَحۡزَابُ","مِنۢ","بَيۡنِهِمۡۖ","فَوَيۡلٞ","لِّلَّذِينَ","ظَلَمُواْ","مِنۡ","عَذَابِ","يَوۡمٍ","أَلِيمٍ"],"фахталафал ахзабу мим байнихим фавайлул лиллазиина заламуу мин `азаби йаумин алиим","Но секты разошлись во мнениях между собой. Горе же тем, которые поступали несправедливо, от страданий в Мучительный день!",["и разошлись","партии","из","среды их","так горе","тем, которые","поступали несправедливо","от","мучения","дня","мучительного"]],[43,66,["هَلۡ","يَنظُرُونَ","إِلَّا","ٱلسَّاعَةَ","أَن","تَأۡتِيَهُم","بَغۡتَةٗ","وَهُمۡ","لَا","يَشۡعُرُونَ"],"хал йанзурууна иллас са`ата ан та'тийахум багтатан вахум ла йаш`уруун","Неужели они ожидают чего-либо, кроме Часа, который наступит для них внезапно, так что они даже не почувствуют его приближения?",["разве","они ждут","кроме","Часа","что","он придёт к ним","внезапно","а они","не","почувствуют"]],[43,67,["ٱلۡأَخِلَّآءُ","يَوۡمَئِذِۭ","بَعۡضُهُمۡ","لِبَعۡضٍ","عَدُوٌّ","إِلَّا","ٱلۡمُتَّقِينَ"],"ал'ахиллау йаумаизи ба`духум либа`дин `адуввун иллал муттаḳиин","В тот день врагами станут все любящие друзья, кроме богобоязненных.",["друзья","в тот день","одни из них","для других","враг","кроме","богобоязненных"]],[43,68,["يَٰعِبَادِ","لَا","خَوۡفٌ","عَلَيۡكُمُ","ٱلۡيَوۡمَ","وَلَآ","أَنتُمۡ","تَحۡزَنُونَ"],"йа`ибади ла хауфун `алайкумул йаума вала антум тахзануун","О рабы Мои! Сегодня вы не познаете страха и не будете опечалены.",["о рабы Мои","нет","страха","над вами","сегодня","и не","вы","будете печалиться"]],[43,69,["ٱلَّذِينَ","ءَامَنُواْ","بِـَٔايَٰتِنَا","وَكَانُواْ","مُسۡلِمِينَ"],"аллазиина амануу би'айатина вакануу муслимиин","Вы были теми, которые уверовали в Наши знамения и были мусульманами.",["те, которые","уверовали","в Наши знамения","и были","мусульманами"]],[43,70,["ٱدۡخُلُواْ","ٱلۡجَنَّةَ","أَنتُمۡ","وَأَزۡوَٰجُكُمۡ","تُحۡبَرُونَ"],"идхулул жанната антум ва'азважукум тухбаруун","Войдите же в Рай радостными вместе со своими женами (или вместе с себе подобными).",["войдите","в Рай","вы","и ваши супруги","радуемые"]],[43,71,["يُطَافُ","عَلَيۡهِم","بِصِحَافٖ","مِّن","ذَهَبٖ","وَأَكۡوَابٖۖ","وَفِيهَا","مَا","تَشۡتَهِيهِ","ٱلۡأَنفُسُ","وَتَلَذُّ","ٱلۡأَعۡيُنُۖ","وَأَنتُمۡ","فِيهَا","خَٰلِدُونَ"],"йутафу `алайхим бисихафим мин захабин ва'аквабин вафииха ма таштахиихил анфусу ваталаззул а`йуну ва'антум фииха халидуун","Их будут обносить блюдами из золота и чашами. Там будет то, чего жаждут души и чем услаждаются глаза. Вы пребудете там вечно.",["будут обносить","их","блюдами","из","золота","и кубками","и там","то, что","желают","души","и услаждает","глаза","и вы","там","вечно пребывающие"]],[43,72,["وَتِلۡكَ","ٱلۡجَنَّةُ","ٱلَّتِيٓ","أُورِثۡتُمُوهَا","بِمَا","كُنتُمۡ","تَعۡمَلُونَ"],"ватилкал жаннатул латии ууристумууха бима кунтум та`малуун","Этот Рай дан вам в наследство за то, что вы совершали.",["и это","Рай","который","вам дан в наследство","за то, что","вы","совершали"]],[43,73,["لَكُمۡ","فِيهَا","فَٰكِهَةٞ","كَثِيرَةٞ","مِّنۡهَا","تَأۡكُلُونَ"],"лакум фииха факихатун касииратум минха та'кулуун","Для вас там уготованы многочисленные фрукты, которые вы будете есть.",["для вас","там","плоды","многочисленные","из них","вы будете есть"]]],"m":[[["وَإِنَّهُۥ","и поистине он",43,61],["لَعِلۡمٞ","непременно признак",43,61],["لِّلسَّاعَةِ","Часа",43,61],["فَلَا","так не",43,61],["تَمۡتَرُنَّ","сомневайтесь",43,61],["بِهَا","в нём",43,61],["وَٱتَّبِعُونِۚ","и следуйте за Мной",43,61],["هَٰذَا","это",43,61],["صِرَٰطٞ","путь",43,61]],[["مُّسۡتَقِيمٞ","прямой",43,61],[61],["وَلَا","и пусть не",43,62],["يَصُدَّنَّكُمُ","отвратит вас",43,62],["ٱلشَّيۡطَٰنُۖ","дьявол",43,62],["إِنَّهُۥ","поистине он",43,62],["لَكُمۡ","для вас",43,62],["عَدُوّٞ","враг",43,62],["مُّبِينٞ","явный",43,62]],[[62],["وَلَمَّا","и когда",43,63],["جَآءَ","пришёл",43,63],["عِيسَىٰ","Иса",43,63],["بِٱلۡبَيِّنَٰتِ","с ясными знамениями",43,63],["قَالَ","он сказал",43,63],["قَدۡ","уже",43,63],["جِئۡتُكُم","я пришёл к вам",43,63],["بِٱلۡحِكۡمَةِ","с мудростью",43,63]],[["وَلِأُبَيِّنَ","и чтобы разъяснить",43,63],["لَكُم","вам",43,63],["بَعۡضَ","часть",43,63],["ٱلَّذِي","того, что",43,63],["تَخۡتَلِفُونَ","вы расходитесь",43,63],["فِيهِۖ","в нём",43,63],["فَٱتَّقُواْ","так бойтесь",43,63],["ٱللَّهَ","Аллаха",43,63],["وَأَطِيعُونِ","и повинуйтесь мне",43,63]],[[63],["إِنَّ","поистине",43,64],["ٱللَّهَ","Аллах",43,64],["هُوَ","Он",43,64],["رَبِّي","мой Господь",43,64],["وَرَبُّكُمۡ","и ваш Господь",43,64],["فَٱعۡبُدُوهُۚ","так поклоняйтесь Ему",43,64],["هَٰذَا","это",43,64],["صِرَٰطٞ","путь",43,64],["مُّسۡتَقِيمٞ","прямой",43,64]],[[64],["فَٱخۡتَلَفَ","и разошлись",43,65],["ٱلۡأَحۡزَابُ","партии",43,65],["مِنۢ","из",43,65],["بَيۡنِهِمۡۖ","среды их",43,65],["فَوَيۡلٞ","так горе",43,65],["لِّلَّذِينَ","тем, которые",43,65],["ظَلَمُواْ","поступали несправедливо",43,65]],[["مِنۡ","от",43,65],["عَذَابِ","мучения",43,65],["يَوۡمٍ","дня",43,65],["أَلِيمٍ","мучительного",43,65],[65],["هَلۡ","разве",43,66],["يَنظُرُونَ","они ждут",43,66],["إِلَّا","кроме",43,66],["ٱلسَّاعَةَ","Часа",43,66],["أَن","что",43,66]],[["تَأۡتِيَهُم","он придёт к ним",43,66],["بَغۡتَةٗ","внезапно",43,66],["وَهُمۡ","а они",43,66],["لَا","не",43,66],["يَشۡعُرُونَ","почувствуют",43,66],[66],["ٱلۡأَخِلَّآءُ","друзья",43,67],["يَوۡمَئِذِۭ","в тот день",43,67]],[["بَعۡضُهُمۡ","одни из них",43,67],["لِبَعۡضٍ","для других",43,67],["عَدُوٌّ","враг",43,67],["إِلَّا","кроме",43,67],["ٱلۡمُتَّقِينَ","богобоязненных",43,67],[67],["يَٰعِبَادِ","о рабы Мои",43,68],["لَا","нет",43,68],["خَوۡفٌ","страха",43,68]],[["عَلَيۡكُمُ","над вами",43,68],["ٱلۡيَوۡمَ","сегодня",43,68],["وَلَآ","и не",43,68],["أَنتُمۡ","вы",43,68],["تَحۡزَنُونَ","будете печалиться",43,68],[68],["ٱلَّذِينَ","те, которые",43,69],["ءَامَنُواْ","уверовали",43,69],["بِـَٔايَٰتِنَا","в Наши знамения",43,69]],[["وَكَانُواْ","и были",43,69],["مُسۡلِمِينَ","мусульманами",43,69],[69],["ٱدۡخُلُواْ","войдите",43,70],["ٱلۡجَنَّةَ","в Рай",43,70],["أَنتُمۡ","вы",43,70],["وَأَزۡوَٰجُكُمۡ","и ваши супруги",43,70]],[["تُحۡبَرُونَ","радуемые",43,70],[70],["يُطَافُ","будут обносить",4