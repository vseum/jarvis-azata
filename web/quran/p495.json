["ٱلَّذِي","который",43,83],["يُوعَدُونَ","им обещан",43,83],[83],["وَهُوَ","и Он",43,84],["ٱلَّذِي","Тот, Кто",43,84],["فِي","на",43,84],["ٱلسَّمَآءِ","небе",43,84],["إِلَٰهٞ","Бог",43,84],["وَفِي","и на",43,84],["ٱلۡأَرۡضِ","земле",43,84]],[["إِلَٰهٞۚ","Бог",43,84],["وَهُوَ","и Он",43,84],["ٱلۡحَكِيمُ","Мудрый",43,84],["ٱلۡعَلِيمُ","Знающий",43,84],[84],["وَتَبَارَكَ","и благословен",43,85],["ٱلَّذِي","Тот",43,85],["لَهُۥ","Которому",43,85],["مُلۡكُ","власть",43,85],["ٱلسَّمَٰوَٰتِ","небес",43,85]],[["وَٱلۡأَرۡضِ","и земли",43,85],["وَمَا","и того, что",43,85],["بَيۡنَهُمَا","между ними",43,85],["وَعِندَهُۥ","и у Него",43,85],["عِلۡمُ","знание",43,85],["ٱلسَّاعَةِ","Часа",43,85],["وَإِلَيۡهِ","и к Нему",43,85],["تُرۡجَعُونَ","вы будете возвращены",43,85]],[[85],["وَلَا","и не",43,86],["يَمۡلِكُ","владеют",43,86],["ٱلَّذِينَ","те, которых",43,86],["يَدۡعُونَ","они призывают",43,86],["مِن","(из)",43,86],["دُونِهِ","помимо Него",43,86],["ٱلشَّفَٰعَةَ","заступничеством",43,86],["إِلَّا","кроме",43,86],["مَن","тех, кто",43,86]],[["شَهِدَ","засвидетельствовал",43,86],["بِٱلۡحَقِّ","истину",43,86],["وَهُمۡ","и они",43,86],["يَعۡلَمُونَ","знают",43,86],[86],["وَلَئِن","и если",43,87],["سَأَلۡتَهُم","ты спросишь их",43,87],["مَّنۡ","кто",43,87],["خَلَقَهُمۡ","сотворил их",43,87]],[["لَيَقُولُنَّ","они непременно скажут",43,87],["ٱللَّهُۖ","Аллах",43,87],["فَأَنَّىٰ","так до чего же",43,87],["يُؤۡفَكُونَ","они отвращены",43,87],[87],["وَقِيلِهِۦ","и его слова",43,88],["يَٰرَبِّ","о Господь мой",43,88],["إِنَّ","поистине",43,88],["هَٰٓؤُلَآءِ","эти",43,88],["قَوۡمٞ","люди",43,88]],[["لَّا","не",43,88],["يُؤۡمِنُونَ","веруют",43,88],[88],["فَٱصۡفَحۡ","так отвернись",43,89],["عَنۡهُمۡ","от них",43,89],["وَقُلۡ","и скажи",43,89],["سَلَٰمٞۚ","мир",43,89],["فَسَوۡفَ","и скоро",43,89],["يَعۡلَمُونَ","они узнают",43,89],[89]]]}