{"p":495,"j":25,"a":[[43,74,["إِنَّ","ٱلۡمُجۡرِمِينَ","فِي","عَذَابِ","جَهَنَّمَ","خَٰلِدُونَ"],"иннал мужримиина фии `азаби жаханнама халидуун","Воистину, грешники вечно будут мучаться в Геенне.",["поистине","грешники","в","мучении","Геенны","вечно пребывающие"]],[43,75,["لَا","يُفَتَّرُ","عَنۡهُمۡ","وَهُمۡ","فِيهِ","مُبۡلِسُونَ"],"ла йуфаттару `анхум вахум фиихи мублисуун","Им не будет дано передышки, и там они придут в отчаяние.",["не","облегчается","им","и они","в нём","в отчаянии"]],[43,76,["وَمَا","ظَلَمۡنَٰهُمۡ","وَلَٰكِن","كَانُواْ","هُمُ","ٱلظَّٰلِمِينَ"],"вама заламнахум валакин кануу хумуз залимиин","Мы не поступили с ними несправедливо - они сами поступали несправедливо.",["и не","Мы обидели их","но","были","они","несправедливыми"]],[43,77,["وَنَادَوۡاْ","يَٰمَٰلِكُ","لِيَقۡضِ","عَلَيۡنَا","رَبُّكَۖ","قَالَ","إِنَّكُم","مَّٰكِثُونَ"],"ванадау йамалику лийаḳди `алайна раббука ḳала иннакум макисуун","Они воззовут: «О Малик! Пусть твой Господь покончит с нами». Он скажет: «Вы останетесь здесь навечно».",["и воззовут они","о Малик","пусть прикончит","нас","твой Господь","он скажет","поистине вы","пребудете (здесь)"]],[43,78,["لَقَدۡ","جِئۡنَٰكُم","بِٱلۡحَقِّ","وَلَٰكِنَّ","أَكۡثَرَكُمۡ","لِلۡحَقِّ","كَٰرِهُونَ"],"лаḳад жи'накум билхаḳḳи валакинна аксаракум лилхаḳḳи карихуун","Мы принесли вам истину, но большинство из вас не любят ее.",["поистине, уже","Мы пришли к вам","с истиной","но","большинство из вас","к истине","испытывают отвращение"]],[43,79,["أَمۡ","أَبۡرَمُوٓاْ","أَمۡرٗا","فَإِنَّا","مُبۡرِمُونَ"],"ам абрамуу амран фа'инна мубримуун","Приняли ли язычники окончательное решение? Мы уже приняли окончательное решение.",["или","они решили окончательно","дело","то ведь Мы","решаем окончательно"]],[43,80,["أَمۡ","يَحۡسَبُونَ","أَنَّا","لَا","نَسۡمَعُ","سِرَّهُمۡ","وَنَجۡوَىٰهُمۚ","بَلَىٰ","وَرُسُلُنَا","لَدَيۡهِمۡ","يَكۡتُبُونَ"],"ам йахсабууна анна ла насма`у сиррахум ванажвахум бала варусулуна ладайхим йактубуун","Неужели они полагают, что Мы не слышим их секретов и тайных переговоров? О нет! При них находятся Наши посланцы, которые записывают.",["или","они думают","что Мы","не","слышим","их тайну","и их перешёптывание","напротив","и Наши посланцы","при них","записывают"]],[43,81,["قُلۡ","إِن","كَانَ","لِلرَّحۡمَٰنِ","وَلَدٞ","فَأَنَا۠","أَوَّلُ","ٱلۡعَٰبِدِينَ"],"ḳул ин кана лиррахмани валадун фа'ана аввалул `абидиин","Скажи: «Если бы у Милостивого был сын, то я первым стал бы поклоняться (Аллаху или Его сыну)».",["скажи","если","был бы","у Милостивого","сын","то я","первый","из поклоняющихся"]],[43,82,["سُبۡحَٰنَ","رَبِّ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِ","رَبِّ","ٱلۡعَرۡشِ","عَمَّا","يَصِفُونَ"],"субхана раббис самавати вал'арди раббил `арши `амма йасифуун","Пречист Господь небес и земли, Господь Трона, и далек от того, что они приписывают.",["пречист","Господь","небес","и земли","Господь","Трона","от того, что","они приписывают"]],[43,83,["فَذَرۡهُمۡ","يَخُوضُواْ","وَيَلۡعَبُواْ","حَتَّىٰ","يُلَٰقُواْ","يَوۡمَهُمُ","ٱلَّذِي","يُوعَدُونَ"],"фазархум йахуудуу вайал`абуу хатта йулаḳуу йаумахумул лазии йуу`адуун","Оставь же их погружаться в словоблудие и забавляться, пока они не встретят тот день их, который им обещан.",["так оставь их","погружаться в пустое","и забавляться","пока не","встретят","свой день","который","им обещан"]],[43,84,["وَهُوَ","ٱلَّذِي","فِي","ٱلسَّمَآءِ","إِلَٰهٞ","وَفِي","ٱلۡأَرۡضِ","إِلَٰهٞۚ","وَهُوَ","ٱلۡحَكِيمُ","ٱلۡعَلِيمُ"],"вахуал лазии фис самаи илахун вафил арди илахун вахуал хакиимул `алиим","Он - Тот, Кто является Богом на небесах и на земле. Он - Мудрый, Знающий.",["и Он","Тот, Кто","на","небе","Бог","и на","земле","Бог","и Он","Мудрый","Знающий"]],[43,85,["وَتَبَارَكَ","ٱلَّذِي","لَهُۥ","مُلۡكُ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِ","وَمَا","بَيۡنَهُمَا","وَعِندَهُۥ","عِلۡمُ","ٱلسَّاعَةِ","وَإِلَيۡهِ","تُرۡجَعُونَ"],"ватабаракал лазии лахуу мулкус самавати вал'арди вама байнахума ва`индахуу `илмус са`ати ва'илайхи туржа`уун","Благословен Тот, Кому принадлежит власть над небесами, землей и тем, что между ними. У Него - знание о Часе, и к Нему вы будете возвращены.",["и благословен","Тот","Которому","власть","небес","и земли","и того, что","между ними","и у Него","знание","Часа","и к Нему","вы будете возвращены"]],[43,86,["وَلَا","يَمۡلِكُ","ٱلَّذِينَ","يَدۡعُونَ","مِن","دُونِهِ","ٱلشَّفَٰعَةَ","إِلَّا","مَن","شَهِدَ","بِٱلۡحَقِّ","وَهُمۡ","يَعۡلَمُونَ"],"вала йамликул лазиина йад`ууна мин дуунихиш шафа`ата илла ман шахида билхаḳḳи вахум йа`ламуун","Те, к кому вы взываете помимо Него, не владеют заступничеством. Заступаться будут только за тех или только те, которые осознанно засвидетельствовали истину.",["и не","владеют","те, которых","они призывают","(из)","помимо Него","заступничеством","кроме","тех, кто","засвидетельствовал","истину","и они","знают"]],[43,87,["وَلَئِن","سَأَلۡتَهُم","مَّنۡ","خَلَقَهُمۡ","لَيَقُولُنَّ","ٱللَّهُۖ","فَأَنَّىٰ","يُؤۡفَكُونَ"],"валаин са'алтахум ман халаḳахум лайаḳуулунналлаху фа'анна йу'факуун","Если ты спросишь у них, кто сотворил их, они непременно скажут: «Аллах». До чего же они отвращены от истины!",["и если","ты спросишь их","кто","сотворил их","они непременно скажут","Аллах","так до чего же","они отвращены"]],[43,88,["وَقِيلِهِۦ","يَٰرَبِّ","إِنَّ","هَٰٓؤُلَآءِ","قَوۡمٞ","لَّا","يُؤۡمِنُونَ"],"ваḳиилихии йарабби инна ха'улаи ḳаумул ла йу'минуун","Он сказал: «Господи! Воистину, они - люди неверующие».",["и его слова","о Господь мой","поистине","эти","люди","не","веруют"]],[43,89,["فَٱصۡفَحۡ","عَنۡهُمۡ","وَقُلۡ","سَلَٰمٞۚ","فَسَوۡفَ","يَعۡلَمُونَ"],"фасфах `анхум ваḳул саламун фасауфа йа`ламуун","Отвернись же от них и скажи: «Мир!». Скоро они узнают.",["так отвернись","от них","и скажи","мир","и скоро","они узнают"]]],"m":[[["إِنَّ","поистине",43,74],["ٱلۡمُجۡرِمِينَ","грешники",43,74],["فِي","в",43,74],["عَذَابِ","мучении",43,74],["جَهَنَّمَ","Геенны",43,74],["خَٰلِدُونَ","вечно пребывающие",43,74],[74],["لَا","не",43,75],["يُفَتَّرُ","облегчается",43,75],["عَنۡهُمۡ","им",43,75],["وَهُمۡ","и они",43,75]],[["فِيهِ"