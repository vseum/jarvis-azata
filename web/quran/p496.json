{"p":496,"j":25,"a":[[44,1,["حمٓ"],"хм","Ха. Мим.",["Ха. Мим"]],[44,2,["وَٱلۡكِتَٰبِ","ٱلۡمُبِينِ"],"валкитабил мубиин","Клянусь ясным Писанием!",["клянусь Писанием","ясным"]],[44,3,["إِنَّآ","أَنزَلۡنَٰهُ","فِي","لَيۡلَةٖ","مُّبَٰرَكَةٍۚ","إِنَّا","كُنَّا","مُنذِرِينَ"],"инна анзалнаху фии лайлатим мубаракатин инна кунна мунзириин","Мы ниспослали его в благословенную ночь, и Мы предостерегаем.",["поистине Мы","ниспослали его","в","ночь","благословенную","поистине Мы","были","предостерегающими"]],[44,4,["فِيهَا","يُفۡرَقُ","كُلُّ","أَمۡرٍ","حَكِيمٍ"],"фииха йуфраḳу куллу амрин хакиим","В нее решаются все мудрые дела",["в неё","решается","всякое","дело","мудрое"]],[44,5,["أَمۡرٗا","مِّنۡ","عِندِنَآۚ","إِنَّا","كُنَّا","مُرۡسِلِينَ"],"амрам мин `индина инна кунна мурсилиин","по повелению от Нас. Мы посылаем пророков и Писания",["по повелению","от","Нас","поистине Мы","были","посылающими"]],[44,6,["رَحۡمَةٗ","مِّن","رَّبِّكَۚ","إِنَّهُۥ","هُوَ","ٱلسَّمِيعُ","ٱلۡعَلِيمُ"],"рахматам мир раббика иннахуу хуас самии`ул `алиим","по милости твоего Господа, Слышащего, Знающего,",["по милости","от","твоего Господа","поистине Он","Он","Слышащий","Знающий"]],[44,7,["رَبِّ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِ","وَمَا","بَيۡنَهُمَآۖ","إِن","كُنتُم","مُّوقِنِينَ"],"раббис самавати вал'арди вама байнахума ин кунтум мууḳиниин","Господа небес, земли и того, что между ними, если только вы обладаете убежденностью.",["Господа","небес","и земли","и того, что","между ними","если","вы","убеждены"]],[44,8,["لَآ","إِلَٰهَ","إِلَّا","هُوَ","يُحۡيِۦ","وَيُمِيتُۖ","رَبُّكُمۡ","وَرَبُّ","ءَابَآئِكُمُ","ٱلۡأَوَّلِينَ"],"ла илаха илла хуа йухйии вайумииту раббукум вараббу абаикумул аввалиин","Нет божества, кроме Него. Он оживляет и умерщвляет. Он - ваш Господь и Господь ваших праотцев.",["нет","божества","кроме","Него","Он оживляет","и умерщвляет","ваш Господь","и Господь","ваших отцов","первых"]],[44,9,["بَلۡ","هُمۡ","فِي","شَكّٖ","يَلۡعَبُونَ"],"бал хум фии шаккин йал`абуун","Но они забавляются, испытывая сомнения.",["нет же","они","в","сомнении","забавляются"]],[44,10,["فَٱرۡتَقِبۡ","يَوۡمَ","تَأۡتِي","ٱلسَّمَآءُ","بِدُخَانٖ","مُّبِينٖ"],"фартаḳиб йаума та'тис самау бидуханим мубиин","Подожди же того дня, когда небо принесет ясный дым,",["так жди","дня","принесёт","небо","дым","явный"]],[44,11,["يَغۡشَى","ٱلنَّاسَۖ","هَٰذَا","عَذَابٌ","أَلِيمٞ"],"йагшан наса хаза `азабун алиим","который окутает людей. Это будут мучительные страдания!",["окутает","людей","это","мучение","мучительное"]],[44,12,["رَّبَّنَا","ٱكۡشِفۡ","عَنَّا","ٱلۡعَذَابَ","إِنَّا","مُؤۡمِنُونَ"],"рраббанакшиф `аннал `азаба инна му'минуун","Они скажут: «Господь наш! Избавь нас от страданий, ведь мы уверовали».",["Господь наш","удали","от нас","мучение","поистине мы","верующие"]],[44,13,["أَنَّىٰ","لَهُمُ","ٱلذِّكۡرَىٰ","وَقَدۡ","جَآءَهُمۡ","رَسُولٞ","مُّبِينٞ"],"анна лахумуз зикра ваḳад жаахум расуулум мубиин","Но как они могут помянуть такое назидание, если к ним уже приходил разъясняющий посланник.",["откуда","у них","назидание","а ведь уже","пришёл к ним","посланник","разъясняющий"]],[44,14,["ثُمَّ","تَوَلَّوۡاْ","عَنۡهُ","وَقَالُواْ","مُعَلَّمٞ","مَّجۡنُونٌ"],"сумма таваллау `анху ваḳалуу му`алламум мажнуун","Затем они отвернулись от него и сказали: «Он - обученный, одержимый».",["затем","они отвернулись","от него","и сказали","обученный","одержимый"]],[44,15,["إِنَّا","كَاشِفُواْ","ٱلۡعَذَابِ","قَلِيلًاۚ","إِنَّكُمۡ","عَآئِدُونَ"],"инна кашифул `азаби ḳалиилан иннакум `аидуун","Мы избавим вас от страданий ненадолго, но ведь вы вернетесь к неверию.",["поистине, Мы","снимем","наказание","ненадолго","поистине, вы","вернетесь"]],[44,16,["يَوۡمَ","نَبۡطِشُ","ٱلۡبَطۡشَةَ","ٱلۡكُبۡرَىٰٓ","إِنَّا","مُنتَقِمُونَ"],"йаума набтишул батшатал кубра инна мунтаḳимуун","В тот день, когда Мы схватим вас величайшей Хваткой, Мы будем мстить.",["в день","Мы схватим","хваткой","величайшей","поистине Мы","отомстим"]],[44,17,["وَلَقَدۡ","فَتَنَّا","قَبۡلَهُمۡ","قَوۡمَ","فِرۡعَوۡنَ","وَجَآءَهُمۡ","رَسُولٞ","كَرِيمٌ"],"валаḳад фатанна ḳаблахум ḳаума фир`ауна важаахум расуулун кариим","До вас Мы уже испытали народ Фараона, и к ним явился благородный посланник.",["и уже","Мы испытали","до них","народ","Фараона","и пришёл к ним","посланник","благородный"]],[44,18,["أَنۡ","أَدُّوٓاْ","إِلَيَّ","عِبَادَ","ٱللَّهِۖ","إِنِّي","لَكُمۡ","رَسُولٌ","أَمِينٞ"],"ан аддуу илаййа `ибадаллахи иннии лакум расуулун амиин","Он сказал: «Верните мне рабов Аллаха. Я являюсь посланником к вам, заслуживающим доверия.",["(говоря:)","отдайте","мне","рабов","Аллаха","поистине, я","к вам","посланник","верный"]]],"m":[["h",44],["b"],[["حمٓ","Ха. Мим",44,1],[1],["وَٱلۡكِتَٰبِ","клянусь Писанием",44,2],["ٱلۡمُبِينِ","ясным",44,2],[2],["إِنَّآ","поистине Мы",44,3],["أَنزَلۡنَٰهُ","ниспослали его",44,3],["فِي","в",44,3],["لَيۡلَةٖ","ночь",44,3]],[["مُّبَٰرَكَةٍۚ","благословенную",44,3],["إِنَّا","поистине Мы",44,3],["كُنَّا","были",44,3],["مُنذِرِينَ","предостерегающими",44,3],[3],["فِيهَا","в неё",44,4],["يُفۡرَقُ","решается",44,4],["كُلُّ","всякое",44,4],["أَمۡرٍ","дело",44,4],["حَكِيمٍ","мудрое",44,4],[4]],[["أَمۡرٗا","по повелению",44,5],["مِّنۡ","от",44,5],["عِندِنَآۚ","Нас",44,5],["إِنَّا","поистине Мы",44,5],["كُنَّا","были",44,5],["مُرۡسِلِينَ","посылающими",44,5],[5],["رَحۡمَةٗ","по милости",44,6],["مِّن","от",44,6],["رَّبِّكَۚ","твоего Господа",44,6],["إِنَّهُۥ","поистине Он",44,6],["هُوَ","Он",44,6]],[["ٱلسَّمِيعُ","Слышащий",44,6],["ٱلۡعَلِيمُ","Знающий",44,6],[6],["رَبِّ","Господа",44,7],["ٱلسَّمَٰوَٰتِ","небес",44,7],["وَٱلۡأَرۡضِ","и земли",44,7],["وَمَا","и того, что",44,7],["بَيۡنَهُمَآۖ","между ними",44,7]],[["إِن","если",44,7],["كُنتُم","вы",44,7],["مُّوقِنِينَ","убеждены",44,7],[7],["لَآ","нет",44,8],["إِلَٰهَ","божества",44,8],["إِلَّا","кроме",44,8],["هُوَ","Него",44,8],["يُحۡيِۦ","Он оживляет",44,8],["وَيُمِيتُۖ","и умерщвляет",44,8],["رَبُّكُمۡ","ваш Господь",44,8]],[["وَرَبُّ","и Господь",44,8],["ءَابَآئِكُمُ","ваших отцов",44,8],["ٱلۡأَوَّلِينَ","первых",44,8],[8],["بَلۡ","н