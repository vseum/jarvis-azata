{"p":497,"j":25,"a":[[44,19,["وَأَن","لَّا","تَعۡلُواْ","عَلَى","ٱللَّهِۖ","إِنِّيٓ","ءَاتِيكُم","بِسُلۡطَٰنٖ","مُّبِينٖ"],"ва'ал ла та`луу `алаллахи иннии атиикум бисултаним мубиин","Не превозноситесь над Аллахом, ведь я принес вам явное доказательство.",["и чтобы","не","превозноситесь","над","Аллахом","поистине, я","прихожу к вам","с доводом","ясным"]],[44,20,["وَإِنِّي","عُذۡتُ","بِرَبِّي","وَرَبِّكُمۡ","أَن","تَرۡجُمُونِ"],"ва'иннии `узту бираббии вараббикум ан таржумуун","Я прибег к защите моего Господа и вашего Господа, чтобы вы не побили меня камнями.",["и поистине, я","прибег к защите","у моего Господа","и вашего Господа","чтобы (не)","побили вы меня камнями"]],[44,21,["وَإِن","لَّمۡ","تُؤۡمِنُواْ","لِي","فَٱعۡتَزِلُونِ"],"ва'ил лам ту'минуу лии фа`тазилуун","Если же вы не верите мне, то оставьте меня».",["и если","не","уверовали вы","мне","то отойдите от меня"]],[44,22,["فَدَعَا","رَبَّهُۥٓ","أَنَّ","هَٰٓؤُلَآءِ","قَوۡمٞ","مُّجۡرِمُونَ"],"фада`а раббахуу анна ха'улаи ḳаумум мужримуун","Затем он воззвал к своему Господу: «Они являются грешными людьми».",["и он воззвал","к своему Господу","что","эти","люди","грешники"]],[44,23,["فَأَسۡرِ","بِعِبَادِي","لَيۡلًا","إِنَّكُم","مُّتَّبَعُونَ"],"фа'асри би`ибадии лайлан иннакум муттаба`уун","Аллах сказал: «Выступи с Моими рабами ночью. Воистину, вас будут преследовать.",["так выступи","с Моими рабами","ночью","поистине, вы","преследуемы"]],[44,24,["وَٱتۡرُكِ","ٱلۡبَحۡرَ","رَهۡوًاۖ","إِنَّهُمۡ","جُندٞ","مُّغۡرَقُونَ"],"ватрукил бахра рахван иннахум жундум муграḳуун","Оставь море в покое - их воинство будет потоплено».",["и оставь","море","спокойным","поистине, они","войско","будут потоплены"]],[44,25,["كَمۡ","تَرَكُواْ","مِن","جَنَّٰتٖ","وَعُيُونٖ"],"кам таракуу мин жаннатин ва`уйуун","Сколько они оставили садов, источников,",["сколько","оставили они","из","садов","и источников"]],[44,26,["وَزُرُوعٖ","وَمَقَامٖ","كَرِيمٖ"],"вазуруу`ин вамаḳамин кариим","посевов, благородных мест",["и посевов","и мест","благородных"]],[44,27,["وَنَعۡمَةٖ","كَانُواْ","فِيهَا","فَٰكِهِينَ"],"вана`матин кануу фииха факихиин","и блаженства, в котором они наслаждались!",["и благ","были они","в них","наслаждающимися"]],[44,28,["كَذَٰلِكَۖ","وَأَوۡرَثۡنَٰهَا","قَوۡمًا","ءَاخَرِينَ"],"казалика ва'аураснаха ḳауман ахариин","Вот так! Мы позволили унаследовать это другому народу.",["так","и Мы дали унаследовать это","народу","другому"]],[44,29,["فَمَا","بَكَتۡ","عَلَيۡهِمُ","ٱلسَّمَآءُ","وَٱلۡأَرۡضُ","وَمَا","كَانُواْ","مُنظَرِينَ"],"фама бакат `алайхимус самау вал'арду вама кануу мунзариин","Ни небо, ни земля не оплакивали их, и им не была предоставлена отсрочка.",["и не","заплакали","по ним","небо","и земля","и не","были они","получившими отсрочку"]],[44,30,["وَلَقَدۡ","نَجَّيۡنَا","بَنِيٓ","إِسۡرَٰٓءِيلَ","مِنَ","ٱلۡعَذَابِ","ٱلۡمُهِينِ"],"валаḳад нажжайна бании исраиила минал `азабил мухиин","Мы уже спасли сынов Исраила (Израиля) от унизительных страданий -",["и уже","Мы спасли","сынов","Исраила","от","наказания","унизительного"]],[44,31,["مِن","فِرۡعَوۡنَۚ","إِنَّهُۥ","كَانَ","عَالِيٗا","مِّنَ","ٱلۡمُسۡرِفِينَ"],"мин фир`ауна иннахуу кана `алийам минал мусрифиин","от Фараона. Воистину, он был надменен и был одним из преступающих границы дозволенного.",["от","Фараона","поистине, он","был","надменным","из","преступающих меру"]],[44,32,["وَلَقَدِ","ٱخۡتَرۡنَٰهُمۡ","عَلَىٰ","عِلۡمٍ","عَلَى","ٱلۡعَٰلَمِينَ"],"валаḳадихтарнахум `ала `илмин `алал `аламиин","Мы избрали их и возвысили их над мирами на основании знания.",["и уже","Мы избрали их","на основании","знания","над","мирами"]],[44,33,["وَءَاتَيۡنَٰهُم","مِّنَ","ٱلۡأٓيَٰتِ","مَا","فِيهِ","بَلَٰٓؤٞاْ","مُّبِينٌ"],"ва'атайнахум минал айати ма фиихи балаум мубиин","Мы даровали им знамения, в которых было заключено явное испытание (или явная милость).",["и Мы дали им","из","знамений","то, что","в нём","испытание","явное"]],[44,34,["إِنَّ","هَٰٓؤُلَآءِ","لَيَقُولُونَ"],"инна ха'улаи лайаḳуулуун","Воистину, они непременно скажут:",["поистине","эти","непременно говорят"]],[44,35,["إِنۡ","هِيَ","إِلَّا","مَوۡتَتُنَا","ٱلۡأُولَىٰ","وَمَا","نَحۡنُ","بِمُنشَرِينَ"],"ин хийа илла маутатунал уула вама нахну бимуншариин","«Для нас есть только одна смерть, и мы не будем воскрешены.",["не","она","кроме","наша смерть","первая","и не","мы","будем воскрешены"]],[44,36,["فَأۡتُواْ","بِـَٔابَآئِنَآ","إِن","كُنتُمۡ","صَٰدِقِينَ"],"фа'туу би'абаина ин кунтум садиḳиин","Приведите же наших отцов, если вы говорите правду».",["так приведите","наших отцов","если","являетесь вы","правдивыми"]],[44,37,["أَهُمۡ","خَيۡرٌ","أَمۡ","قَوۡمُ","تُبَّعٖ","وَٱلَّذِينَ","مِن","قَبۡلِهِمۡ","أَهۡلَكۡنَٰهُمۡۚ","إِنَّهُمۡ","كَانُواْ","مُجۡرِمِينَ"],"ахум хайрун ам ḳауму тубба`ин валлазиина мин ḳаблихим ахлакнахум иннахум кануу мужримиин","Они лучше или же народ Тубба (Тобба) и их предшественники? Мы погубили их. Воистину, они были грешниками.",["разве они","лучше","или","народ","Тубба","и те, которые","до","них","Мы погубили их","поистине, они","были","грешниками"]],[44,38,["وَمَا","خَلَقۡنَا","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضَ","وَمَا","بَيۡنَهُمَا","لَٰعِبِينَ"],"вама халаḳнас самавати вал'арда вама байнахума ла`ибиин","Мы не сотворили небеса, землю и то, что между ними, забавляясь.",["и не","Мы сотворили","небеса","и землю","и то, что","между ними","забавляясь"]],[44,39,["مَا","خَلَقۡنَٰهُمَآ","إِلَّا","بِٱلۡحَقِّ","وَلَٰكِنَّ","أَكۡثَرَهُمۡ","لَا","يَعۡلَمُونَ"],"ма халаḳнахума илла билхаḳḳи валакинна аксарахум ла йа`ламуун","Мы сотворили их (небеса и землю) только ради истины, но большинство их не знает этого.",["не","Мы сотворили их обоих","кроме как","с истиной","но","большинство их","не","знают"]]],"m":[[["وَأَن","и чтобы",44,19],["لَّا","не",44,19],["تَعۡلُواْ","превозноситесь",44,19],["عَلَى","над",44,19],["ٱللَّهِۖ","Аллахом",44,19],["إِنِّيٓ","поистине, я",44,19],["ءَاتِيكُم","прихожу к вам",44,19],["بِسُلۡطَٰنٖ","с доводом",44,19],["مُّبِينٖ","ясным",44,19],[19],["وَإِنِّي","и поистине, я",44,20],["عُذۡتُ","прибег к защите",44,20]],[["بِرَبِّي"