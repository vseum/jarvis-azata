{"p":498,"j":25,"a":[[44,40,["إِنَّ","يَوۡمَ","ٱلۡفَصۡلِ","مِيقَٰتُهُمۡ","أَجۡمَعِينَ"],"инна йаумал фасли мииḳатухум ажма`иин","Воистину, День различения - это срок, установленный для каждого из них.",["поистине","день","различения","их срок","всех"]],[44,41,["يَوۡمَ","لَا","يُغۡنِي","مَوۡلًى","عَن","مَّوۡلٗى","شَيۡـٔٗا","وَلَا","هُمۡ","يُنصَرُونَ"],"йаума ла йугнии маулан `ам маулан шай'ан вала хум йунсаруун","Это будет день, когда близкий ничем не поможет своему близкому и когда помощь не будет оказана никому,",["в день, когда","не","избавит","близкий","от","близкого","ничем","и не","они","получат помощь"]],[44,42,["إِلَّا","مَن","رَّحِمَ","ٱللَّهُۚ","إِنَّهُۥ","هُوَ","ٱلۡعَزِيزُ","ٱلرَّحِيمُ"],"илла мар рахималлаху иннахуу хуал `азиизур рахиим","кроме тех, над кем смилостивится Аллах. Воистину, Он - Могущественный, Милосердный.",["кроме","того, кого","помиловал","Аллах","поистине, Он","Он","Могущественный","Милосердный"]],[44,43,["إِنَّ","شَجَرَتَ","ٱلزَّقُّومِ"],"инна шажаратаз заḳḳуум","Воистину, дерево заккум будет",["поистине","дерево","заккум"]],[44,44,["طَعَامُ","ٱلۡأَثِيمِ"],"та`амул асиим","пищей грешника.",["пища","грешника"]],[44,45,["كَٱلۡمُهۡلِ","يَغۡلِي","فِي","ٱلۡبُطُونِ"],"калмухли йаглии фил бутуун","Подобно осадку масла (или расплавленной меди), оно будет кипеть в животах так,",["как осадок масла","кипит","в","животах"]],[44,46,["كَغَلۡيِ","ٱلۡحَمِيمِ"],"кагалйил хамиим","как кипит кипяток.",["как кипение","кипятка"]],[44,47,["خُذُوهُ","فَٱعۡتِلُوهُ","إِلَىٰ","سَوَآءِ","ٱلۡجَحِيمِ"],"хузууху фа`тилууху ила саваил жахиим","Схватите его и волоките (или несите) до самой середины Ада.",["схватите его","и волоките его","в","середину","Ада"]],[44,48,["ثُمَّ","صُبُّواْ","فَوۡقَ","رَأۡسِهِۦ","مِنۡ","عَذَابِ","ٱلۡحَمِيمِ"],"сумма суббуу фауḳа ра'сихии мин `азабил хамиим","Затем налейте ему на голову кипяток, причиняющий страдания.",["затем","лейте","на","его голову","из","наказания","кипятка"]],[44,49,["ذُقۡ","إِنَّكَ","أَنتَ","ٱلۡعَزِيزُ","ٱلۡكَرِيمُ"],"зуḳ иннака антал `азиизул кариим","Вкушай, ведь ты - могущественный, благородный!",["вкуси","поистине, ты","ты","могущественный","благородный"]],[44,50,["إِنَّ","هَٰذَا","مَا","كُنتُم","بِهِۦ","تَمۡتَرُونَ"],"инна хаза ма кунтум бихии тамтаруун","Вот то, в чем вы сомневались!",["поистине","это","то, что","были вы","о нём","сомневаетесь"]],[44,51,["إِنَّ","ٱلۡمُتَّقِينَ","فِي","مَقَامٍ","أَمِينٖ"],"иннал муттаḳиина фии маḳамин амиин","Воистину, богобоязненные пребудут в безопасном месте,",["поистине","богобоязненные","в","месте","безопасном"]],[44,52,["فِي","جَنَّٰتٖ","وَعُيُونٖ"],"фии жаннатин ва`уйуун","в Райских садах и среди источников.",["в","садах","и источниках"]],[44,53,["يَلۡبَسُونَ","مِن","سُندُسٖ","وَإِسۡتَبۡرَقٖ","مُّتَقَٰبِلِينَ"],"йалбасууна мин сундусин ва'истабраḳим мутаḳабилиин","Они будут облачены в атлас и парчу и будут восседать друг против друга.",["облачаются","в","атлас","и парчу","друг против друга"]],[44,54,["كَذَٰلِكَ","وَزَوَّجۡنَٰهُم","بِحُورٍ","عِينٖ"],"казалика вазавважнахум бихуурин `иин","Вот так! Мы сочетаем их с черноокими, большеглазыми девами.",["так","и Мы сочетали их","с черноокими","большеглазыми"]],[44,55,["يَدۡعُونَ","فِيهَا","بِكُلِّ","فَٰكِهَةٍ","ءَامِنِينَ"],"йад`ууна фииха бикулли факихатин аминиин","Там они будут просить любые фрукты, будучи в безопасности.",["просят","там","всякие","плоды","будучи в безопасности"]],[44,56,["لَا","يَذُوقُونَ","فِيهَا","ٱلۡمَوۡتَ","إِلَّا","ٱلۡمَوۡتَةَ","ٱلۡأُولَىٰۖ","وَوَقَىٰهُمۡ","عَذَابَ","ٱلۡجَحِيمِ"],"ла йазууḳууна фиихал маута иллал маутатал уула ваваḳахум `азабал жахиим","Там они не вкусят смерти после первой смерти. Он защитил их от мучений в Аду",["не","вкусят","там","смерти","кроме","смерти","первой","и Он уберёг их","от наказания","Ада"]],[44,57,["فَضۡلٗا","مِّن","رَّبِّكَۚ","ذَٰلِكَ","هُوَ","ٱلۡفَوۡزُ","ٱلۡعَظِيمُ"],"фадлам мир раббика залика хуал фаузул `азиим","по милости от твоего Господа. Это и есть великое преуспеяние.",["по милости","от","твоего Господа","это","оно","успех","великий"]],[44,58,["فَإِنَّمَا","يَسَّرۡنَٰهُ","بِلِسَانِكَ","لَعَلَّهُمۡ","يَتَذَكَّرُونَ"],"фа'иннама йассарнаху билисаника ла`аллахум йатазаккаруун","Мы облегчили его (Коран) на твоем языке, чтобы они могли помянуть назидание.",["ведь лишь","Мы облегчили его","твоим языком","чтобы они","помянули назидание"]],[44,59,["فَٱرۡتَقِبۡ","إِنَّهُم","مُّرۡتَقِبُونَ"],"фартаḳиб иннахум муртаḳибуун","Подожди же, ведь они тоже ждут.",["так жди","поистине, они","ждущие"]]]}