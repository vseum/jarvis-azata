{"p":499,"j":25,"a":[[45,1,["حمٓ"],"хм","Ха. Мим.",["Ха. Мим"]],[45,2,["تَنزِيلُ","ٱلۡكِتَٰبِ","مِنَ","ٱللَّهِ","ٱلۡعَزِيزِ","ٱلۡحَكِيمِ"],"танзиилул китаби миналлахил `азиизил хакиим","Писание ниспослано от Аллаха Могущественного, Мудрого.",["ниспослание","Писания","от","Аллаха","Могущественного","Мудрого"]],[45,3,["إِنَّ","فِي","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِ","لَأٓيَٰتٖ","لِّلۡمُؤۡمِنِينَ"],"инна фис самавати вал'арди ла'айатил лилму'миниин","Воистину, на небесах и на земле есть знамения для верующих.",["поистине","в","небесах","и земле","непременно знамения","для верующих"]],[45,4,["وَفِي","خَلۡقِكُمۡ","وَمَا","يَبُثُّ","مِن","دَآبَّةٍ","ءَايَٰتٞ","لِّقَوۡمٖ","يُوقِنُونَ"],"вафии халḳикум вама йабуссу мин даббатин айатул лиḳаумин йууḳинуун","В сотворении вас и живых тварей, которых Он расселил, есть знамения для людей убежденных.",["и в","сотворении вас","и том, что","Он рассеивает","из","живых существ","знамения","для людей","которые убеждены"]],[45,5,["وَٱخۡتِلَٰفِ","ٱلَّيۡلِ","وَٱلنَّهَارِ","وَمَآ","أَنزَلَ","ٱللَّهُ","مِنَ","ٱلسَّمَآءِ","مِن","رِّزۡقٖ","فَأَحۡيَا","بِهِ","ٱلۡأَرۡضَ","بَعۡدَ","مَوۡتِهَا","وَتَصۡرِيفِ","ٱلرِّيَٰحِ","ءَايَٰتٞ","لِّقَوۡمٖ","يَعۡقِلُونَ"],"вахтилафил лайли ваннахари вама анзалаллаху минас самаи мир ризḳин фа'ахйа бихил арда ба`да маутиха ватасриифир рийахи айатул лиḳаумин йа`ḳилуун","В смене ночи и дня, в уделе, который Аллах ниспосылает с неба и посредством которого Он оживляет землю после ее смерти, и в смене ветров есть знамения для людей разумеющих.",["и в смене","ночи","и дня","и в том, что","ниспослал","Аллах","с","неба","из","удела","и оживил","им","землю","после","её смерти","и в смене","ветров","знамения","для людей","которые разумеют"]],[45,6,["تِلۡكَ","ءَايَٰتُ","ٱللَّهِ","نَتۡلُوهَا","عَلَيۡكَ","بِٱلۡحَقِّۖ","فَبِأَيِّ","حَدِيثِۭ","بَعۡدَ","ٱللَّهِ","وَءَايَٰتِهِۦ","يُؤۡمِنُونَ"],"тилка айатуллахи натлууха `алайка билхаḳḳи фабиаййи хадииси ба`даллахи ва'айатихии йу'минуун","Вот аяты Аллаха, которые Мы читаем тебе истинно. В какой же рассказ после рассказа об Аллахе и его знамениях они верят?",["это","аяты","Аллаха","Мы читаем их","тебе","с истиной","в какой же","рассказ","после","Аллаха","и Его аятов","они уверуют"]],[45,7,["وَيۡلٞ","لِّكُلِّ","أَفَّاكٍ","أَثِيمٖ"],"вайлул ликулли аффакин асиим","Горе всякому лживому грешнику!",["горе","всякому","лжецу","грешному"]],[45,8,["يَسۡمَعُ","ءَايَٰتِ","ٱللَّهِ","تُتۡلَىٰ","عَلَيۡهِ","ثُمَّ","يُصِرُّ","مُسۡتَكۡبِرٗا","كَأَن","لَّمۡ","يَسۡمَعۡهَاۖ","فَبَشِّرۡهُ","بِعَذَابٍ","أَلِيمٖ"],"йасма`у айатиллахи тутла `алайхи сумма йусирру мустакбиран ка'ал лам йасма`ха фабашширху би`азабин алиим","Он выслушивает аяты Аллаха, которые читаются ему, а затем надменно упорствует, словно он вовсе не слышал их. Обрадуй же его вестью о мучительных страданиях.",["слышит","аяты","Аллаха","читаемые","ему","затем","упорствует","превозносясь","как будто","не","слышал их","так обрадуй его","наказанием","мучительным"]],[45,9,["وَإِذَا","عَلِمَ","مِنۡ","ءَايَٰتِنَا","شَيۡـًٔا","ٱتَّخَذَهَا","هُزُوًاۚ","أُوْلَٰٓئِكَ","لَهُمۡ","عَذَابٞ","مُّهِينٞ"],"ва'иза `алима мин айатина шай'аниттахазаха хузуан улаика лахум `азабум мухиин","Когда он узнает о чем-либо из Наших знамений, он начинает насмехаться над ними. Таким уготованы унизительные мучения.",["и когда","узнаёт","из","Наших аятов","что-либо","берёт их","в насмешку","те","им","наказание","унизительное"]],[45,10,["مِّن","وَرَآئِهِمۡ","جَهَنَّمُۖ","وَلَا","يُغۡنِي","عَنۡهُم","مَّا","كَسَبُواْ","شَيۡـٔٗا","وَلَا","مَا","ٱتَّخَذُواْ","مِن","دُونِ","ٱللَّهِ","أَوۡلِيَآءَۖ","وَلَهُمۡ","عَذَابٌ","عَظِيمٌ"],"ммин вараихим жаханнаму вала йугнии `анхум ма касабуу шай'ан вала маттахазуу мин дууниллахи аулийаа валахум `азабун `азиим","Перед ними - Геенна. Не спасут их то, что они приобрели, и те, кого они взяли себе в покровители и помощники вместо Аллаха. Им уготованы великие мучения.",["из","впереди них","Геенна","и не","избавит","их","то, что","приобрели они","ничем","и не","то, что","взяли они","из","помимо","Аллаха","покровителями","и им","наказание","великое"]],[45,11,["هَٰذَا","هُدٗىۖ","وَٱلَّذِينَ","كَفَرُواْ","بِـَٔايَٰتِ","رَبِّهِمۡ","لَهُمۡ","عَذَابٞ","مِّن","رِّجۡزٍ","أَلِيمٌ"],"хаза худан валлазиина кафаруу би'айати раббихим лахум `азабум мир рижзин алиим","Это - верное руководство. А тем, которые не уверовали в знамения своего Господа, уготованы мучения от великого наказания.",["это","руководство","а те, которые","не уверовали","в аяты","своего Господа","им","наказание","из","кары","мучительное"]],[45,12,["ٱللَّهُ","ٱلَّذِي","سَخَّرَ","لَكُمُ","ٱلۡبَحۡرَ","لِتَجۡرِيَ","ٱلۡفُلۡكُ","فِيهِ","بِأَمۡرِهِۦ","وَلِتَبۡتَغُواْ","مِن","فَضۡلِهِۦ","وَلَعَلَّكُمۡ","تَشۡكُرُونَ"],"аллахул лазии саххара лакумул бахра литажрийал фулку фиихи би'амрихии валитабтагуу мин фадлихии вала`аллакум ташкуруун","Аллах - Тот, Кто подчинил вам море, чтобы корабли плыли по нему по Его воле и чтобы вы искали Его милость. Быть может, вы будете благодарны.",["Аллах","Тот, Который","подчинил","вам","море","чтобы плыли","корабли","по нему","по Его повелению","и чтобы вы искали","из","Его милости","и, быть может, вы","будете благодарны"]],[45,13,["وَسَخَّرَ","لَكُم","مَّا","فِي","ٱلسَّمَٰوَٰتِ","وَمَا","فِي","ٱلۡأَرۡضِ","جَمِيعٗا","مِّنۡهُۚ","إِنَّ","فِي","ذَٰلِكَ","لَأٓيَٰتٖ","لِّقَوۡمٖ","يَتَفَكَّرُونَ"],"васаххара лакум ма фис самавати вама фил арди жамии`ам минху инна фии залика ла'айатил лиḳаумин йатафаккаруун","Он подчинил вам то, что на небесах, и то, что на земле. Воистину, в этом - знамения для людей размышляющих.",["и подчинил","вам","то, что","на","небесах","и то, что","на","земле","всё","от Него","поистине","в","этом","непременно знамения","для людей","которые размышляют"]]],"m":[["b"],[["حمٓ","Ха. Мим",45,1],[1],["تَنزِيلُ","ниспослание",45,2],["ٱلۡكِتَٰبِ","Писания",45,2],["مِنَ","от",45,2],["ٱللَّهِ","Аллаха",45,2],["ٱلۡعَزِيزِ","Могущественного",45,2],["ٱلۡحَكِيمِ","Мудрого",45,2],[2],["إِنَّ","поистине",45,3],["فِي","в",45,3],["ٱلسَّمَٰوَٰتِ","небесах",45,3]],[["وَٱلۡأَرۡضِ","и земле",