{"p":500,"j":25,"a":[[45,14,["قُل","لِّلَّذِينَ","ءَامَنُواْ","يَغۡفِرُواْ","لِلَّذِينَ","لَا","يَرۡجُونَ","أَيَّامَ","ٱللَّهِ","لِيَجۡزِيَ","قَوۡمَۢا","بِمَا","كَانُواْ","يَكۡسِبُونَ"],"ḳул лиллазиина амануу йагфируу лиллазиина ла йаржууна аййамаллахи лийажзийа ḳаума бима кануу йаксибуун","Скажи верующим, чтобы они простили тех, которые не надеются на дни Аллаха, дабы Он воздал людям за то, что они приобретали.",["скажи","тем, которые","уверовали","(пусть) простят","тем, которые","не","надеются на","дни","Аллаха","чтобы Он воздал","людям","за то, что","они","приобретали"]],[45,15,["مَنۡ","عَمِلَ","صَٰلِحٗا","فَلِنَفۡسِهِۦۖ","وَمَنۡ","أَسَآءَ","فَعَلَيۡهَاۖ","ثُمَّ","إِلَىٰ","رَبِّكُمۡ","تُرۡجَعُونَ"],"ман `амила салихан фалинафсихии ваман асаа фа`алайха сумма ила раббикум туржа`уун","Кто поступает праведно, тот поступает во благо себе. А кто творит зло, тот поступает во вред себе. А затем вы будете возвращены к вашему Господу.",["кто","сделал","праведное","то для себя самого","а кто","сотворил зло","то против себя","затем","к","вашему Господу","вы будете возвращены"]],[45,16,["وَلَقَدۡ","ءَاتَيۡنَا","بَنِيٓ","إِسۡرَٰٓءِيلَ","ٱلۡكِتَٰبَ","وَٱلۡحُكۡمَ","وَٱلنُّبُوَّةَ","وَرَزَقۡنَٰهُم","مِّنَ","ٱلطَّيِّبَٰتِ","وَفَضَّلۡنَٰهُمۡ","عَلَى","ٱلۡعَٰلَمِينَ"],"валаḳад атайна бании исраиилал китаба валхукма ваннубуввата варазаḳнахум минат таййибати вафаддалнахум `алал `аламиин","Мы уже даровали сынам Исраила (Израиля) Писание, власть и пророчество, наделили их благами и предпочли их мирам.",["и уже","Мы дали","сынам","Исраила","Писание","и власть","и пророчество","и Мы наделили их","из","благ","и Мы предпочли их","над","мирами"]],[45,17,["وَءَاتَيۡنَٰهُم","بَيِّنَٰتٖ","مِّنَ","ٱلۡأَمۡرِۖ","فَمَا","ٱخۡتَلَفُوٓاْ","إِلَّا","مِنۢ","بَعۡدِ","مَا","جَآءَهُمُ","ٱلۡعِلۡمُ","بَغۡيَۢا","بَيۡنَهُمۡۚ","إِنَّ","رَبَّكَ","يَقۡضِي","بَيۡنَهُمۡ","يَوۡمَ","ٱلۡقِيَٰمَةِ","فِيمَا","كَانُواْ","فِيهِ","يَخۡتَلِفُونَ"],"ва'атайнахум баййинатим минал амри фамахталафуу илла мим ба`ди ма жаахумул `илму багйа байнахум инна раббака йаḳдии байнахум йаумал ḳийамати фиима кануу фиихи йахталифуун","Мы даровали им ясные знамения из повеления. Они же разошлись во мнениях лишь после того, как к ним явилось знание, по причине зависти и несправедливого отношения друг к другу. Воистину, твой Господь рассудит их в День воскресения в том, в чем они расходились во мнениях.",["и Мы дали им","ясные знамения","из","повеления","и не","разошлись они","кроме как","из","после","того как","пришло к ним","знание","из зависти","между собой","поистине","твой Господь","рассудит","между ними","в день","воскресения","в том, что","они","в нём","расходились"]],[45,18,["ثُمَّ","جَعَلۡنَٰكَ","عَلَىٰ","شَرِيعَةٖ","مِّنَ","ٱلۡأَمۡرِ","فَٱتَّبِعۡهَا","وَلَا","تَتَّبِعۡ","أَهۡوَآءَ","ٱلَّذِينَ","لَا","يَعۡلَمُونَ"],"сумма жа`алнака `ала шарии`атим минал амри фаттаби`ха вала таттаби` ахваал лазиина ла йа`ламуун","Потом Мы наставили тебя на путь из повеления. Следуй им и не потакай желаниям тех, которые не обладают знанием.",["затем","Мы поставили тебя","на","путь","из","повеления","так следуй ему","и не","следуй","страстям","тех, которые","не","знают"]],[45,19,["إِنَّهُمۡ","لَن","يُغۡنُواْ","عَنكَ","مِنَ","ٱللَّهِ","شَيۡـٔٗاۚ","وَإِنَّ","ٱلظَّٰلِمِينَ","بَعۡضُهُمۡ","أَوۡلِيَآءُ","بَعۡضٖۖ","وَٱللَّهُ","وَلِيُّ","ٱلۡمُتَّقِينَ"],"иннахум лан йугнуу `анка миналлахи шай'ан ва'инназ залимиина ба`духум аулийау ба`дин валлаху валиййул муттаḳиин","Они нисколько не спасут тебя от Аллаха. Воистину, беззаконники являются помощниками и друзьями друг другу, а Аллах является Покровителем богобоязненных.",["поистине, они","никак не","избавят","тебя","от","Аллаха","ничем","и поистине","беззаконники","одни из них","помощники","других","а Аллах","Покровитель","богобоязненных"]],[45,20,["هَٰذَا","بَصَٰٓئِرُ","لِلنَّاسِ","وَهُدٗى","وَرَحۡمَةٞ","لِّقَوۡمٖ","يُوقِنُونَ"],"хаза басаиру линнаси вахудан варахматул лиḳаумин йууḳинуун","Это - наглядное наставление для людей, верное руководство и милость для людей убежденных.",["это","прозрения","для людей","и руководство","и милость","для людей","которые убеждены"]],[45,21,["أَمۡ","حَسِبَ","ٱلَّذِينَ","ٱجۡتَرَحُواْ","ٱلسَّيِّـَٔاتِ","أَن","نَّجۡعَلَهُمۡ","كَٱلَّذِينَ","ءَامَنُواْ","وَعَمِلُواْ","ٱلصَّٰلِحَٰتِ","سَوَآءٗ","مَّحۡيَاهُمۡ","وَمَمَاتُهُمۡۚ","سَآءَ","مَا","يَحۡكُمُونَ"],"ам хасибал лазиинажтарахус саййиати ан наж`алахум каллазиина амануу ва`амилус салихати саваам махйахум вамаматухум саа ма йахкумуун","Неужели те, которые приобретали зло, полагали, что Мы полностью приравняем их к тем, которые уверовали и совершали праведные деяния, как при жизни, так и после смерти? Как же скверны их суждения!",["неужели","думали","те, которые","совершали","злодеяния","что","Мы сделаем их","как тех, которые","уверовали","и совершали","праведные дела","равными","их жизнь","и их смерть","скверно","то, что","они судят"]],[45,22,["وَخَلَقَ","ٱللَّهُ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضَ","بِٱلۡحَقِّ","وَلِتُجۡزَىٰ","كُلُّ","نَفۡسِۭ","بِمَا","كَسَبَتۡ","وَهُمۡ","لَا","يُظۡلَمُونَ"],"вахалаḳаллахус самавати вал'арда билхаḳḳи валитужза куллу нафси бима касабат вахум ла йузламуун","Аллах сотворил небеса и землю ради истины и для того, чтобы каждая душа получила воздаяние за то, что она приобрела, и с ними не поступят несправедливо.",["и сотворил","Аллах","небеса","и землю","с истиной","и чтобы получила воздаяние","каждая","душа","за то, что","приобрела","и они","не","будут обижены"]]],"m":[[["قُل","скажи",45,14],["لِّلَّذِينَ","тем, которые",45,14],["ءَامَنُواْ","уверовали",45,14],["يَغۡفِرُواْ","(пусть) простят",45,14],["لِلَّذِينَ","тем, которые",45,14],["لَا","не",45,14],["يَرۡجُونَ","надеются на",45,14],["أَيَّامَ","дни",45,14],["ٱللَّهِ","Аллаха",45,14],["لِيَجۡزِيَ","чтобы Он воздал",45,14]],[["قَوۡمَۢا","людям",45,14],["بِمَا","за то, что",45,14],["كَانُواْ","они",45,14],["يَكۡسِبُونَ","приобретали",45,14],[14],["مَنۡ","кто",45,15],["عَمِلَ","сделал",45,15],["صَٰلِحٗا","праведное",45,15],["فَلِنَفۡسِهِۦۖ","то для себя самого",45,15]],[["وَمَنۡ","а кто",45,15],["أَسَآءَ","сотворил зло",45,15],["فَعَلَيۡهَاۖ","то против себя",45,15],["ثُمَّ","затем",45,15],["إِلَىٰ","к",45,15],["رَبِّكُمۡ","вашему Господу",45,15],["تُرۡجَعُونَ","вы будете возвращены",45,15],[15],["وَلَقَدۡ","и уже",45,16],["ءَاتَيۡنَا","Мы дали",45,16]],[["بَنِيٓ","сынам",45,16],["إِسۡرَٰٓءِيلَ","Исраила",45,16],["ٱلۡكِتَٰبَ","Писание",45,16],["وَٱلۡحُكۡمَ","и власть",45,16],["وَٱلنُّبُوَّةَ","и пророчество",45,16],["وَرَزَقۡنَٰهُم","и Мы наделили их",45,16],["مِّنَ","из",45,16],["ٱلطَّيِّبَٰتِ","благ",45,16]],[["وَفَضَّلۡنَٰهُمۡ","и Мы предпочли их",45,16],["عَلَى","над",45,16],["ٱلۡعَٰلَمِينَ","мирами",45,16],[16],["وَءَاتَيۡنَٰهُم","и Мы дали им",45,17],["بَيِّنَٰتٖ","ясные знамения",45,17],["مِّنَ","из",45,17],["ٱلۡأَمۡرِۖ","повеления",45,17]],[["فَمَا","и не",45,17],["ٱخۡتَلَفُوٓاْ","разошлись они",45,17],["إِلَّا","кроме как",45,17],["مِنۢ","из",45,17],["بَعۡدِ","после",45,17],["مَا","того как",45,17],["جَآءَهُمُ","пришло к ним",45,17],["ٱلۡعِلۡمُ","знание",45,17],["بَغۡيَۢا","из зависти",45,17],["بَيۡنَهُمۡۚ","между собой",45,17],["إِنَّ","поистине",45,17]],[["رَبَّكَ","твой Господь",45,17],["يَقۡضِي","рассудит",45,17],["بَيۡنَهُمۡ","между ними",45,17],["يَوۡمَ","в день",45,17],["ٱلۡقِيَٰمَةِ","воскресения",45,17],["فِيمَا","в том, что",45,17],["كَانُواْ","они",45,17],["فِيهِ","в нём",45,17],["يَخۡتَلِفُونَ","расходились",45,17]],[[17],["ثُمَّ","затем",45,18],["جَعَلۡنَٰكَ","Мы поставили тебя",45,18],["عَلَىٰ","на",45,18],["شَرِيعَةٖ","путь",45,18],["مِّنَ","из",45,18],["ٱلۡأَمۡرِ","повеления",45,18],["فَٱتَّبِعۡهَا","так следуй ему",45,18],["وَلَا","и не",45,18],["تَتَّبِعۡ","следуй",45,18]],[["أَهۡوَآءَ","страстям",45,18],["ٱلَّذِينَ","тех, которые",45,18],["لَا","не",45,18],["يَعۡلَمُونَ","знают",45,18],[18],["إِنَّهُمۡ","поистине, они",45,19],["لَن","никак не",45,19],["يُغۡنُواْ","избавят",45,19],["عَنكَ","тебя",45,19],["مِنَ","от",45,19],["ٱللَّهِ","Аллаха",45,19]],[["شَيۡـٔٗاۚ","ничем",45,19],["وَإِنَّ","и поистине",45,19],["ٱلظَّٰلِمِينَ","беззаконники",45,19],["بَعۡضُهُمۡ","одни из них",45,19],["أَوۡلِيَآءُ","помощники",45,19],["بَعۡضٖۖ","других",45,19],["وَٱللَّهُ","а Аллах",45,19],["وَلِيُّ","Покровитель",45,19],["ٱلۡمُتَّقِينَ","богобоязненных",45,19]],[[19],["هَٰذَا","это",45,20],["بَصَٰٓئِرُ","прозрения",45,20],["لِلنَّاسِ","для людей",45,20],["وَهُدٗى","и руководство",45,20],["وَرَحۡمَةٞ","и милость",45,20],["لِّقَوۡمٖ","для людей",45,20],["يُوقِنُونَ","которые убеждены",45,20]],[[20],["أَمۡ","неужели",45,21],["حَسِبَ","думали",45,21],["ٱلَّذِينَ","те, которые",45,21],["ٱجۡتَرَحُواْ","совершали",45,21],["ٱلسَّيِّـَٔاتِ","злодеяния",45,21],["أَن","что",45,21],["نَّجۡعَلَهُمۡ","Мы сделаем их",45,21],["كَٱلَّذِينَ","как тех, которые",45,21]],[["ءَامَنُواْ","уверовали",45,21],["وَعَمِلُواْ","и совершали",45,21],["ٱلصَّٰلِحَٰتِ","праведные дела",45,21],["سَوَآءٗ","равными",45,21],["مَّحۡيَاهُمۡ","их жизнь",45,21],["وَمَمَاتُهُمۡۚ","и их смерть",45,21],["سَآءَ","скверно",45,21]],[["مَا","то, что",45,21],["يَحۡكُمُونَ","они судят",45,21],[21],["وَخَلَقَ","и сотворил",45,22],["ٱللَّهُ","Аллах",45,22],["ٱلسَّمَٰوَٰتِ","небеса",45,22],["وَٱلۡأَرۡضَ","и землю",45,22],["بِٱلۡحَقِّ","с истиной",45,22]],[["وَلِتُجۡزَىٰ","и чтобы получила воздаяние",45,22],["كُلُّ","каждая",45,22],["نَفۡسِۭ","душа",45,22],["بِمَا","за то, что",45,22],["كَسَبَتۡ","приобрела",45,22],["وَهُمۡ","и они",45,22],["لَا","не",45,22],["يُظۡلَمُونَ","будут обижены",45,22],[22]]]}