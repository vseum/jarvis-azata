{"p":501,"j":25,"a":[[45,23,["أَفَرَءَيۡتَ","مَنِ","ٱتَّخَذَ","إِلَٰهَهُۥ","هَوَىٰهُ","وَأَضَلَّهُ","ٱللَّهُ","عَلَىٰ","عِلۡمٖ","وَخَتَمَ","عَلَىٰ","سَمۡعِهِۦ","وَقَلۡبِهِۦ","وَجَعَلَ","عَلَىٰ","بَصَرِهِۦ","غِشَٰوَةٗ","فَمَن","يَهۡدِيهِ","مِنۢ","بَعۡدِ","ٱللَّهِۚ","أَفَلَا","تَذَكَّرُونَ"],"афараайта маниттахаза илахахуу хаваху ва'адаллахуллаху `ала `илмин вахатама `ала сам`ихии ваḳалбихии важа`ала `ала басарихии гишаватан фаман йахдиихи мим ба`диллахи афала тазаккаруун","Видел ли ты того, кто обожествил свою прихоть? Аллах ввел его в заблуждение на основании знания, запечатал его слух и сердце и бросил на его взор покрывало. Кто же наставит его на прямой путь после Аллаха? Неужели вы не помяните назидание?",["видел ли ты","того, кто","сделал","своим богом","свою прихоть","и сбил его","Аллах","при","знании","и запечатал","на","его слух","и его сердце","и положил","на","его взор","покров","кто же","наставит его","из","после","Аллаха","разве не","помянете"]],[45,24,["وَقَالُواْ","مَا","هِيَ","إِلَّا","حَيَاتُنَا","ٱلدُّنۡيَا","نَمُوتُ","وَنَحۡيَا","وَمَا","يُهۡلِكُنَآ","إِلَّا","ٱلدَّهۡرُۚ","وَمَا","لَهُم","بِذَٰلِكَ","مِنۡ","عِلۡمٍۖ","إِنۡ","هُمۡ","إِلَّا","يَظُنُّونَ"],"ваḳалуу ма хийа илла хайатунад дунйа намууту ванахйа вама йухликуна иллад дахру вама лахум бизалика мин `илмин ин хум илла йазуннуун","Они сказали: «Есть только наша мирская жизнь. Мы умираем и рождаемся, и нас не губит ничто, кроме времени». У них нет об этом никакого знания. Они лишь делают предположения.",["и сказали они","не","она","кроме","наша жизнь","мирская","умираем мы","и живём","и не","губит нас","кроме","время","и нет","у них","об этом","никакого","знания","не","они","лишь","предполагают"]],[45,25,["وَإِذَا","تُتۡلَىٰ","عَلَيۡهِمۡ","ءَايَٰتُنَا","بَيِّنَٰتٖ","مَّا","كَانَ","حُجَّتَهُمۡ","إِلَّآ","أَن","قَالُواْ","ٱئۡتُواْ","بِـَٔابَآئِنَآ","إِن","كُنتُمۡ","صَٰدِقِينَ"],"ва'иза тутла `алайхим айатуна баййинатим ма кана хужжатахум илла ан ḳалутуу би'абаина ин кунтум садиḳиин","Когда им читают Наши ясные аяты, их единственным доводом оказываются слова: «Приведите наших отцов, если вы говорите правду».",["и когда","читаются","им","Наши аяты","ясными","не","было","их доводом","кроме","того, что","сказали они","приведите","наших отцов","если","являетесь вы","правдивыми"]],[45,26,["قُلِ","ٱللَّهُ","يُحۡيِيكُمۡ","ثُمَّ","يُمِيتُكُمۡ","ثُمَّ","يَجۡمَعُكُمۡ","إِلَىٰ","يَوۡمِ","ٱلۡقِيَٰمَةِ","لَا","رَيۡبَ","فِيهِ","وَلَٰكِنَّ","أَكۡثَرَ","ٱلنَّاسِ","لَا","يَعۡلَمُونَ"],"ḳулиллаху йухйиикум сумма йумиитукум сумма йажма`укум ила йаумил ḳийамати ла райба фиихи валакинна аксаран наси ла йа`ламуун","Скажи: «Аллах дарует вам жизнь, затем умерщвляет вас, а затем Он соберет вас ко Дню воскресения, в котором нет сомнения». Однако большинство людей не знает этого.",["скажи","Аллах","оживляет вас","затем","умерщвляет вас","затем","соберёт вас","к","дню","воскресения","нет","сомнения","в нём","но","большинство","людей","не","знают"]],[45,27,["وَلِلَّهِ","مُلۡكُ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِۚ","وَيَوۡمَ","تَقُومُ","ٱلسَّاعَةُ","يَوۡمَئِذٖ","يَخۡسَرُ","ٱلۡمُبۡطِلُونَ"],"валиллахи мулкус самавати вал'арди вайаума таḳуумус са`ату йаумаизин йахсарул мубтилуун","Аллаху принадлежит власть над небесами и землей. В тот день, когда настанет Час, приверженцы лжи окажутся в убытке.",["и Аллаху (принадлежит)","власть","(над) небесами","и землёй","и в день (когда)","настанет","Час","в тот день","понесут убыток","приверженцы лжи"]],[45,28,["وَتَرَىٰ","كُلَّ","أُمَّةٖ","جَاثِيَةٗۚ","كُلُّ","أُمَّةٖ","تُدۡعَىٰٓ","إِلَىٰ","كِتَٰبِهَا","ٱلۡيَوۡمَ","تُجۡزَوۡنَ","مَا","كُنتُمۡ","تَعۡمَلُونَ"],"ватара кулла умматин жасийатан куллу умматин туд`а ила китабихал йаума тужзауна ма кунтум та`малуун","Ты увидишь все общины коленопреклоненными. Каждую общину призовут к ее Писанию (Книге деяний): «Сегодня вам воздастся за то, что вы совершали».",["и ты увидишь","каждую","общину","коленопреклонённой","каждая","община","будет призвана","к","её книге","сегодня","вам воздастся","(за) то, что","вы","совершали"]],[45,29,["هَٰذَا","كِتَٰبُنَا","يَنطِقُ","عَلَيۡكُم","بِٱلۡحَقِّۚ","إِنَّا","كُنَّا","نَسۡتَنسِخُ","مَا","كُنتُمۡ","تَعۡمَلُونَ"],"хаза китабуна йантиḳу `алайкум билхаḳḳи инна кунна настансиху ма кунтум та`малуун","Это Писание Наше (Книга деяний) говорит против вас по справедливости. Мы приказали записывать все, что вы совершали.",["это","Наша книга","говорит","против вас","по истине","поистине, Мы","(Мы) были","записывающими","то, что","вы","совершали"]],[45,30,["فَأَمَّا","ٱلَّذِينَ","ءَامَنُواْ","وَعَمِلُواْ","ٱلصَّٰلِحَٰتِ","فَيُدۡخِلُهُمۡ","رَبُّهُمۡ","فِي","رَحۡمَتِهِۦۚ","ذَٰلِكَ","هُوَ","ٱلۡفَوۡزُ","ٱلۡمُبِينُ"],"фа'аммал лазиина амануу ва`амилус салихати файудхилухум раббухум фии рахматихии залика хуал фаузул мубиин","Что касается тех, которые уверовали и совершали праведные деяния, то их Господь введет их в Свою милость. Это и есть явное преуспеяние.",["и что касается","тех, которые","уверовали","и совершали","праведные деяния","то введёт их","их Господь","в","Свою милость","это","оно (и есть)","успех","явный"]],[45,31,["وَأَمَّا","ٱلَّذِينَ","كَفَرُوٓاْ","أَفَلَمۡ","تَكُنۡ","ءَايَٰتِي","تُتۡلَىٰ","عَلَيۡكُمۡ","فَٱسۡتَكۡبَرۡتُمۡ","وَكُنتُمۡ","قَوۡمٗا","مُّجۡرِمِينَ"],"ва'аммал лазиина кафаруу афалам такун айатии тутла `алайкум фастакбартум вакунтум ḳаумам мужримиин","А что касается тех, которые не уверовали, то им будет сказано: «Разве вам не читались Мои аяты? Вы возгордились и были людьми грешными.",["а что касается","тех, которые","не уверовали","разве же не","были","Мои аяты","читаемы","вам","но вы возгордились","и были вы","людьми","грешными"]],[45,32,["وَإِذَا","قِيلَ","إِنَّ","وَعۡدَ","ٱللَّهِ","حَقّٞ","وَٱلسَّاعَةُ","لَا","رَيۡبَ","فِيهَا","قُلۡتُم","مَّا","نَدۡرِي","مَا","ٱلسَّاعَةُ","إِن","نَّظُنُّ","إِلَّا","ظَنّٗا","وَمَا","نَحۡنُ","بِمُسۡتَيۡقِنِينَ"],"ва'иза ḳиила инна ва`даллахи хаḳḳун васса`ату ла райба фииха ḳултум ма надрии мас са`ату ин назунну илла заннан вама нахну бимустайḳиниин","Когда вам говорили, что обещание Аллаха истинно и что в Часе нет сомнения, вы говорили: «Мы не знаем, что такое Час. Мы полагаем, что это - всего лишь предположения. Мы не имеем твердой убежденности»».",["и когда","было сказано","поистине","обещание","Аллаха","истинно","и Час","нет","сомнения","в нём","вы сказали","не","знаем мы","что (такое)","Час","не","мы полагаем","кроме","предположения","и не","мы","убеждённые"]]],"m":[[["أَفَرَءَيۡتَ","видел ли ты",45,23],["مَنِ","того, кто",45,23],["ٱتَّخَذَ","сделал",45,23],["إِلَٰهَهُۥ","своим богом",45,23],["هَوَىٰهُ","свою прихоть",45,23],["وَأَضَلَّهُ","и сбил его",45,23],["ٱللَّهُ","Аллах",45,23],["عَلَىٰ","при",45,23],["عِلۡمٖ","знании",45,23],["وَخَتَمَ","и запечатал",45,23],["عَلَىٰ","на",45,23],["سَمۡعِهِۦ","его слух",45,23]],[["وَقَلۡبِهِۦ","и его сердце",45,23],["وَجَعَلَ","и положил",45,23],["عَلَىٰ","на",45,23],["بَصَرِهِۦ","его взор",45,23],["غِشَٰوَةٗ","покров",45,23],["فَمَن","кто же",45,23],["يَهۡدِيهِ","наставит его",45,23],["مِنۢ","из",45,23],["بَعۡدِ","после",45,23],["ٱللَّهِۚ","Аллаха",45,23],["أَفَلَا","разве не",45,23]],[["تَذَكَّرُونَ","помянете",45,23],[23],["وَقَالُواْ","и сказали они",45,24],["مَا","не",45,24],["هِيَ","она",45,24],["إِلَّا","кроме",45,24],["حَيَاتُنَا","наша жизнь",45,24],["ٱلدُّنۡيَا","мирская",45,24],["نَمُوتُ","умираем мы",45,24],["وَنَحۡيَا","и живём",45,24],["وَمَا","и не",45,24],["يُهۡلِكُنَآ","губит нас",45,24]],[["إِلَّا","кроме",45,24],["ٱلدَّهۡرُۚ","время",45,24],["وَمَا","и нет",45,24],["لَهُم","у них",45,24],["بِذَٰلِكَ","об этом",45,24],["مِنۡ","никакого",45,24],["عِلۡمٍۖ","знания",45,24],["إِنۡ","не",45,24],["هُمۡ","они",45,24],["إِلَّا","лишь",45,24],["يَظُنُّونَ","предполагают",45,24],[24],["وَإِذَا","и когда",45,25],["تُتۡلَىٰ","читаются",45,25]],[["عَلَيۡهِمۡ","им",45,25],["ءَايَٰتُنَا","Наши аяты",45,25],["بَيِّنَٰتٖ","ясными",45,25],["مَّا","не",45,25],["كَانَ","было",45,25],["حُجَّتَهُمۡ","их доводом",45,25],["إِلَّآ","кроме",45,25],["أَن","того, что",45,25],["قَالُواْ","сказали они",45,25],["ٱئۡتُواْ","приведите",45,25],["بِـَٔابَآئِنَآ","наших отцов",45,25],["إِن","если",45,25]],[["كُنتُمۡ","являетесь вы",45,25],["صَٰدِقِينَ","правдивыми",45,25],[25],["قُلِ","скажи",45,26],["ٱللَّهُ","Аллах",45,26],["يُحۡيِيكُمۡ","оживляет вас",45,26],["ثُمَّ","затем",45,26],["يُمِيتُكُمۡ","умерщвляет вас",45,26],["ثُمَّ","затем",45,26],["يَجۡمَعُكُمۡ","соберёт вас",45,26],["إِلَىٰ","к",45,26],["يَوۡمِ","дню",45,26]],[["ٱلۡقِيَٰمَةِ","воскресения",45,26],["لَا","нет",45,26],["رَيۡبَ","сомнения",45,26],["فِيهِ","в нём",45,26],["وَلَٰكِنَّ","но",45,26],["أَكۡثَرَ","большинство",45,26],["ٱلنَّاسِ","людей",45,26],["لَا","не",45,26],["يَعۡلَمُونَ","знают",45,26],[26],["وَلِلَّهِ","и Аллаху (принадлежит)",45,27],["مُلۡكُ","власть",45,27]],[["ٱلسَّمَٰوَٰتِ","(над) небесами",45,27],["وَٱلۡأَرۡضِۚ","и землёй",45,27],["وَيَوۡمَ","и в день (когда)",45,27],["تَقُومُ","настанет",45,27],["ٱلسَّاعَةُ","Час",45,27],["يَوۡمَئِذٖ","в тот день",45,27],["يَخۡسَرُ","понесут убыток",45,27],["ٱلۡمُبۡطِلُونَ","приверженцы лжи",45,27]],[[27],["وَتَرَىٰ","и ты увидишь",45,28],["كُلَّ","каждую",45,28],["أُمَّةٖ","общину",45,28],["جَاثِيَةٗۚ","коленопреклонённой",45,28],["كُلُّ","каждая",45,28],["أُمَّةٖ","община",45,28],["تُدۡعَىٰٓ","будет призвана",45,28],["إِلَىٰ","к",45,28],["كِتَٰبِهَا","её книге",45,28],["ٱلۡيَوۡمَ","сегодня",45,28],["تُجۡزَوۡنَ","вам воздастся",45,28],["مَا","(за) то, что",45,28],["كُنتُمۡ","вы",45,28]],[["تَعۡمَلُونَ","совершали",45,28],[28],["هَٰذَا","это",45,29],["كِتَٰبُنَا","Наша книга",45,29],["يَنطِقُ","говорит",45,29],["عَلَيۡكُم","против вас",45,29],["بِٱلۡحَقِّۚ","по истине",45,29],["إِنَّا","поистине, Мы",45,29],["كُنَّا","(Мы) были",45,29],["نَسۡتَنسِخُ","записывающими",45,29]],[["مَا","то, что",45,29],["كُنتُمۡ","вы",45,29],["تَعۡمَلُونَ","совершали",45,29],[29],["فَأَمَّا","и что касается",45,30],["ٱلَّذِينَ","тех, которые",45,30],["ءَامَنُواْ","уверовали",45,30],["وَعَمِلُواْ","и совершали",45,30],["ٱلصَّٰلِحَٰتِ","праведные деяния",45,30]],[["فَيُدۡخِلُهُمۡ","то вве