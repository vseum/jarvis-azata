{"p":502,"j":26,"a":[[45,33,["وَبَدَا","لَهُمۡ","سَيِّـَٔاتُ","مَا","عَمِلُواْ","وَحَاقَ","بِهِم","مَّا","كَانُواْ","بِهِۦ","يَسۡتَهۡزِءُونَ"],"вабада лахум саййиату ма `амилуу вахаḳа бихим ма кануу бихии йастахзиуун","Им открылось зло, которое они совершили, и их окружило (или поразило) то, над чем они насмехались.",["и открылись","им","злые (деяния)","(того) что","они совершили","и окружило","их","то, что","они","над ним","насмехались"]],[45,34,["وَقِيلَ","ٱلۡيَوۡمَ","نَنسَىٰكُمۡ","كَمَا","نَسِيتُمۡ","لِقَآءَ","يَوۡمِكُمۡ","هَٰذَا","وَمَأۡوَىٰكُمُ","ٱلنَّارُ","وَمَا","لَكُم","مِّن","نَّٰصِرِينَ"],"ваḳиилал йаума нансакум кама насиитум лиḳаа йаумикум хаза вама'вакумун нару вама лакум мин насириин","Будет сказано: «Сегодня Мы предадим вас забвению, подобно тому, как вы предали забвению встречу с этим днем вашим. Вашим пристанищем будет Огонь, и не будет у вас помощников.",["и сказано будет","сегодня","Мы забудем вас","как","вы забыли","встречу","вашего дня","этого","и пристанище ваше","Огонь","и нет","у вас","никаких","помощников"]],[45,35,["ذَٰلِكُم","بِأَنَّكُمُ","ٱتَّخَذۡتُمۡ","ءَايَٰتِ","ٱللَّهِ","هُزُوٗا","وَغَرَّتۡكُمُ","ٱلۡحَيَوٰةُ","ٱلدُّنۡيَاۚ","فَٱلۡيَوۡمَ","لَا","يُخۡرَجُونَ","مِنۡهَا","وَلَا","هُمۡ","يُسۡتَعۡتَبُونَ"],"заликум би'аннакумуттахазтум айатиллахи хузуан вагарраткумул хайаватуд дунйа фалйаума ла йухражууна минха вала хум йуста`табуун","Это вам - за то, что вы насмехались над знамениями Аллаха и обольстились мирской жизнью. Сегодня они не выйдут оттуда, и от них не потребуют покаяния».",["это вам","за то, что вы","взяли","аяты","Аллаха","(для) насмешки","и обольстила вас","жизнь","мирская","и сегодня","не","будут выведены они","из него","и не","они","будут прощены по просьбе"]],[45,36,["فَلِلَّهِ","ٱلۡحَمۡدُ","رَبِّ","ٱلسَّمَٰوَٰتِ","وَرَبِّ","ٱلۡأَرۡضِ","رَبِّ","ٱلۡعَٰلَمِينَ"],"фалиллахил хамду раббис самавати вараббил арди раббил `аламиин","Хвала Аллаху, Господу небес и земли, Господу миров!",["и Аллаху (принадлежит)","хвала","Господу","небес","и Господу","земли","Господу","миров"]],[45,37,["وَلَهُ","ٱلۡكِبۡرِيَآءُ","فِي","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِۖ","وَهُوَ","ٱلۡعَزِيزُ","ٱلۡحَكِيمُ"],"валахул кибрийау фис самавати вал'арди вахуал `азиизул хакиим","Ему принадлежит величие на небесах и на земле. Он - Могущественный, Мудрый.",["и Ему (принадлежит)","величие","на","небесах","и земле","и Он","Могущественный","Мудрый"]],[46,1,["حمٓ"],"хм","Ха. Мим.",["Ха Мим"]],[46,2,["تَنزِيلُ","ٱلۡكِتَٰبِ","مِنَ","ٱللَّهِ","ٱلۡعَزِيزِ","ٱلۡحَكِيمِ"],"танзиилул китаби миналлахил `азиизил хакиим","Писание ниспослано от Аллаха Могущественного, Знающего.",["ниспослание","Писания","от","Аллаха","Могущественного","Мудрого"]],[46,3,["مَا","خَلَقۡنَا","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضَ","وَمَا","بَيۡنَهُمَآ","إِلَّا","بِٱلۡحَقِّ","وَأَجَلٖ","مُّسَمّٗىۚ","وَٱلَّذِينَ","كَفَرُواْ","عَمَّآ","أُنذِرُواْ","مُعۡرِضُونَ"],"ма халаḳнас самавати вал'арда вама байнахума илла билхаḳḳи ва'ажалим мусамман валлазиина кафаруу `амма унзируу му`ридуун","Мы сотворили небеса, землю и то, что между ними, только ради истины и на определенный срок. Но те, которые не веруют, отворачиваются от того, от чего их предостерегают.",["не","сотворили Мы","небеса","и землю","и то, что","между ними","кроме как","по истине","и (на) срок","назначенный","а те, которые","не уверовали","от того, о чём","их предостерегли","отворачиваются"]],[46,4,["قُلۡ","أَرَءَيۡتُم","مَّا","تَدۡعُونَ","مِن","دُونِ","ٱللَّهِ","أَرُونِي","مَاذَا","خَلَقُواْ","مِنَ","ٱلۡأَرۡضِ","أَمۡ","لَهُمۡ","شِرۡكٞ","فِي","ٱلسَّمَٰوَٰتِۖ","ٱئۡتُونِي","بِكِتَٰبٖ","مِّن","قَبۡلِ","هَٰذَآ","أَوۡ","أَثَٰرَةٖ","مِّنۡ","عِلۡمٍ","إِن","كُنتُمۡ","صَٰدِقِينَ"],"ḳул араайтум ма тад`ууна мин дууниллахи аруунии маза халаḳуу минал арди ам лахум ширкун фис самаватитуунии бикитабим мин ḳабли хаза ау асаратим мин `илмин ин кунтум садиḳиин","Скажи: «Видели ли вы тех, к кому взываете помимо Аллаха? Покажите мне, какую часть земли они сотворили? Или же они являются совладельцами небес? Принесите мне Писание, предшествовавшее этому, или хоть какой след знания, если вы говорите правду».",["скажи","видели ли вы","то, что","вы призываете","из","помимо","Аллаха","покажите мне","что","сотворили они","из","земли","или","у них","доля","в","небесах","принесите мне","писание","из","прежде","этого","или","след","из","знания","если","вы","правдивы"]],[46,5,["وَمَنۡ","أَضَلُّ","مِمَّن","يَدۡعُواْ","مِن","دُونِ","ٱللَّهِ","مَن","لَّا","يَسۡتَجِيبُ","لَهُۥٓ","إِلَىٰ","يَوۡمِ","ٱلۡقِيَٰمَةِ","وَهُمۡ","عَن","دُعَآئِهِمۡ","غَٰفِلُونَ"],"ваман адаллу мимман йад`уу мин дууниллахи мал ла йастажиибу лахуу ила йаумил ḳийамати вахум `ан ду`аихим гафилуун","Кто же находится в большем заблуждении, чем те, которые взывают вместо Аллаха к тем, которые не ответят им до Дня воскресения и которые не ведают об их зове?!",["и кто","более заблудший","чем тот, кто","призывает","из","помимо","Аллаха","того, кто","не","ответит","ему","до","Дня","воскресения","а они","о","их мольбе","не ведают"]]],"m":[[["وَبَدَا","и открылись",45,33],["لَهُمۡ","им",45,33],["سَيِّـَٔاتُ","злые (деяния)",45,33],["مَا","(того) что",45,33],["عَمِلُواْ","они совершили",45,33],["وَحَاقَ","и окружило",45,33],["بِهِم","их",45,33],["مَّا","то, что",45,33],["كَانُواْ","они",45,33],["بِهِۦ","над ним",45,33],["يَسۡتَهۡزِءُونَ","насмехались",45,33],[33]],[["وَقِيلَ","и сказано будет",45,34],["ٱلۡيَوۡمَ","сегодня",45,34],["نَنسَىٰكُمۡ","Мы забудем вас",45,34],["كَمَا","как",45,34],["نَسِيتُمۡ","вы забыли",45,34],["لِقَآءَ","встречу",45,34],["يَوۡمِكُمۡ","вашего дня",45,34],["هَٰذَا","этого",45,34],["وَمَأۡوَىٰكُمُ","и пристанище ваше",45,34],["ٱلنَّارُ","Огонь",45,34],["وَمَا","и нет",45,34]],[["لَكُم","у вас",45,34],["مِّن","никаких",45,34],["نَّٰصِرِينَ","помощников",45,34],[34],["ذَٰلِكُم","это вам",45,35],["بِأَنَّكُمُ","за то, что вы",45,35],["ٱتَّخَذۡتُمۡ","взяли",45,35],["ءَايَٰتِ","аяты",45,35],["ٱللَّهِ","Аллаха",45,35],["هُزُوٗا","(для) насмешки",45,35],["وَغَرَّتۡكُمُ","и обольстила вас",45,35]],[["ٱلۡحَيَوٰةُ","жизнь",45,35],["ٱل