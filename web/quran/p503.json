{"p":503,"j":26,"a":[[46,6,["وَإِذَا","حُشِرَ","ٱلنَّاسُ","كَانُواْ","لَهُمۡ","أَعۡدَآءٗ","وَكَانُواْ","بِعِبَادَتِهِمۡ","كَٰفِرِينَ"],"ва'иза хуширан насу кануу лахум а`даан вакануу би`ибадатихим кафириин","А когда люди будут собраны, они станут их врагами и будут отвергать их поклонение.",["и когда","будут собраны","люди","станут они","им","врагами","и станут они","их поклонение","отвергающими"]],[46,7,["وَإِذَا","تُتۡلَىٰ","عَلَيۡهِمۡ","ءَايَٰتُنَا","بَيِّنَٰتٖ","قَالَ","ٱلَّذِينَ","كَفَرُواْ","لِلۡحَقِّ","لَمَّا","جَآءَهُمۡ","هَٰذَا","سِحۡرٞ","مُّبِينٌ"],"ва'иза тутла `алайхим айатуна баййинатин ḳалал лазиина кафаруу лилхаḳḳи ламма жаахум хаза сихрум мубиин","Когда им читаются Наши ясные аяты, то те, которые не уверовали в истину, когда она явилась к ним, говорят: «Это - очевидное колдовство».",["и когда","читаются","им","Наши аяты","ясными","говорят","те, которые","не уверовали","об истине","когда","пришла она к ним","это","колдовство","явное"]],[46,8,["أَمۡ","يَقُولُونَ","ٱفۡتَرَىٰهُۖ","قُلۡ","إِنِ","ٱفۡتَرَيۡتُهُۥ","فَلَا","تَمۡلِكُونَ","لِي","مِنَ","ٱللَّهِ","شَيۡـًٔاۖ","هُوَ","أَعۡلَمُ","بِمَا","تُفِيضُونَ","فِيهِۚ","كَفَىٰ","بِهِۦ","شَهِيدَۢا","بَيۡنِي","وَبَيۡنَكُمۡۖ","وَهُوَ","ٱلۡغَفُورُ","ٱلرَّحِيمُ"],"ам йаḳуулуунафтараху ḳул инифтарайтухуу фала тамликууна лии миналлахи шай'ан хуа а`ламу бима туфиидууна фиихи кафа бихии шахиида байнии вабайнакум вахуал гафуурур рахиим","Или же они говорят: «Он измыслил его». Скажи: «Если я измыслил его, то вы нисколько не защитите меня от Аллаха. Ему лучше знать о том, о чем вы разглагольствуете. Довольно того, что Он является Свидетелем между мною и вами. Он - Прощающий, Милосердный».",["или","говорят они","он измыслил его","скажи","если","я измыслил его","то не","властны вы","для меня","от","Аллаха","ничего","Он","лучше знает","о том, что","вы рассуждаете","о нём","достаточно","Его","Свидетелем","между мной","и между вами","и Он","Прощающий","Милосердный"]],[46,9,["قُلۡ","مَا","كُنتُ","بِدۡعٗا","مِّنَ","ٱلرُّسُلِ","وَمَآ","أَدۡرِي","مَا","يُفۡعَلُ","بِي","وَلَا","بِكُمۡۖ","إِنۡ","أَتَّبِعُ","إِلَّا","مَا","يُوحَىٰٓ","إِلَيَّ","وَمَآ","أَنَا۠","إِلَّا","نَذِيرٞ","مُّبِينٞ"],"ḳул ма кунту бид`ам минар русули вама адрии ма йуф`алу бии вала бикум ин аттаби`у илла ма йууха илаййа вама ана илла назиирум мубиин","Скажи: «Я не являюсь первым из посланников и не знаю, что произойдет со мной и с вами. Я следую только тому, что внушается мне в откровении. Я - всего лишь разъясняющий и предостерегающий увещеватель».",["скажи","не","был я","новым","из","посланников","и не","знаю я","что","будет сделано","со мной","и не","с вами","не","следую я","кроме","того, что","внушается","мне","и не","я","кроме как","увещеватель","явный"]],[46,10,["قُلۡ","أَرَءَيۡتُمۡ","إِن","كَانَ","مِنۡ","عِندِ","ٱللَّهِ","وَكَفَرۡتُم","بِهِۦ","وَشَهِدَ","شَاهِدٞ","مِّنۢ","بَنِيٓ","إِسۡرَٰٓءِيلَ","عَلَىٰ","مِثۡلِهِۦ","فَـَٔامَنَ","وَٱسۡتَكۡبَرۡتُمۡۚ","إِنَّ","ٱللَّهَ","لَا","يَهۡدِي","ٱلۡقَوۡمَ","ٱلظَّٰلِمِينَ"],"ḳул араайтум ин кана мин `индиллахи вакафартум бихии вашахида шахидум мим бании исраиила `ала мислихии фа'амана вастакбартум инналлаха ла йахдил ḳаумаз залимиин","Скажи: «А что, если Коран - от Аллаха, а вы не уверовали в него? Свидетель из числа сынов Исраила (Израиля) засвидетельствовал о том, что было подобно ему, и уверовал в него, а вы возгордились. Воистину, Аллах не наставляет на прямой путь беззаконников!».",["скажи","видели ли вы","если","был он","от","(стороны)","Аллаха","а вы не уверовали","в него","и засвидетельствовал","свидетель","из","сынов","Исраила","о","подобном ему","и уверовал","а вы возгордились","поистине","Аллах","не","наставляет","людей","беззаконных"]],[46,11,["وَقَالَ","ٱلَّذِينَ","كَفَرُواْ","لِلَّذِينَ","ءَامَنُواْ","لَوۡ","كَانَ","خَيۡرٗا","مَّا","سَبَقُونَآ","إِلَيۡهِۚ","وَإِذۡ","لَمۡ","يَهۡتَدُواْ","بِهِۦ","فَسَيَقُولُونَ","هَٰذَآ","إِفۡكٞ","قَدِيمٞ"],"ваḳалал лазиина кафаруу лиллазиина амануу лау кана хайрам ма сабаḳууна илайхи ва'из лам йахтадуу бихии фасайаḳуулууна хаза ифкун ḳадиим","Неверующие сказали верующим: «Если бы это было благом, то они не опередили бы нас в этом». Они не стали руководствоваться им, и поэтому они скажут: «Это - старое измышление».",["и сказали","те, которые","не уверовали","о тех, которые","уверовали","если бы","было (это)","благом","не","опередили бы они нас","к нему","и раз","не","последовали они прямым путём","им","то скажут они","это","ложь","старая"]],[46,12,["وَمِن","قَبۡلِهِۦ","كِتَٰبُ","مُوسَىٰٓ","إِمَامٗا","وَرَحۡمَةٗۚ","وَهَٰذَا","كِتَٰبٞ","مُّصَدِّقٞ","لِّسَانًا","عَرَبِيّٗا","لِّيُنذِرَ","ٱلَّذِينَ","ظَلَمُواْ","وَبُشۡرَىٰ","لِلۡمُحۡسِنِينَ"],"вамин ḳаблихии китабу мууса имаман варахматан вахаза китабум мусаддиḳул лисанан `арабиййал лийунзирал лазиина заламуу вабушра лилмухсиниин","До него было Писание Мусы (Моисея), которое было руководством и милостью. А это Писание на арабском языке, подтверждающее предыдущие Писания, ниспослано для того, чтобы предостеречь тех, которые поступают несправедливо, и обрадовать творящих добро.",["и до","него","Писание","Мусы","руководством","и милостью","а это","Писание","подтверждающее","языком","арабским","чтобы предостеречь","тех, которые","поступили несправедливо","и благая весть","творящим добро"]],[46,13,["إِنَّ","ٱلَّذِينَ","قَالُواْ","رَبُّنَا","ٱللَّهُ","ثُمَّ","ٱسۡتَقَٰمُواْ","فَلَا","خَوۡفٌ","عَلَيۡهِمۡ","وَلَا","هُمۡ","يَحۡزَنُونَ"],"иннал лазиина ḳалуу раббуналлаху суммастаḳамуу фала хауфун `алайхим вала хум йахзануун","Воистину, те, которые сказали: «Наш Господь - Аллах», - и последовали прямым путем, не познают страха и не будут опечалены.",["поистине","те, которые","сказали","Господь наш","Аллах","затем","держались прямо","то нет","страха","над ними","и не","они","будут опечалены"]],[46,14,["أُوْلَٰٓئِكَ","أَصۡحَٰبُ","ٱلۡجَنَّةِ","خَٰلِدِينَ","فِيهَا","جَزَآءَۢ","بِمَا","كَانُواْ","يَعۡمَلُونَ"],"улаика асхабул жаннати халидиина фииха жазаа бима кануу йа`малуун","Они являются обитателями Рая, в котором они пребудут вечно в воздаяние за то, что они совершали.",["те","обитатели","Рая","вечно пребывающие","в нём","воздаянием","за то, что","они","совершали"]]],"m":[[["وَإِذَا","и когда",46,6],["حُشِرَ","будут собраны",46,6],["ٱلنَّاسُ","люди",46,6],["كَانُواْ","станут они",46,6],["لَهُمۡ","им",46,6],["أَعۡدَآءٗ","врагами",46,6],["وَكَانُواْ","и станут они",46,6],["بِعِبَادَتِهِمۡ","их поклонение",46,6],["كَٰفِرِينَ","отвергающими",46,6],[6],["وَإِذَا","и когда",46,7]],[["تُتۡلَىٰ","читаются",46,7],["عَلَيۡهِمۡ","им",46,7],["ءَايَٰتُنَا","Наши аяты",46,7],["بَيِّنَٰتٖ","ясными",46,7],["قَالَ","говорят",46,7],["ٱلَّذِينَ","те, которые",46,7],["كَفَرُواْ","не уверовали",46,7],["لِلۡحَقِّ","об истине",46,7],["لَمَّا","когда",46,7],["جَآءَهُمۡ","пришла она к ним",46,7],["هَٰذَا","это",46,7]],[["سِحۡرٞ","колдовство",46,7],["مُّبِينٌ","явное",46,7],[7],["أَمۡ","или",46,8],["يَقُولُونَ","говорят они",46,8],["ٱفۡتَرَىٰهُۖ","он измыслил его",46,8],["قُلۡ","скажи",46,8],["إِنِ","если",46,8],["ٱفۡتَرَيۡتُهُۥ","я измыслил его",46,8],["فَلَا","то не",46,8],["تَمۡلِكُونَ","властны вы",46,8]],[["لِي","для меня",46,8],["مِنَ","от",46,8],["ٱللَّهِ","Аллаха",46,8],["شَيۡـًٔاۖ","ничего",46,8],["هُوَ","Он",46,8],["أَعۡلَمُ","лучше знает",46,8],["بِمَا","о том, что",46,8],["تُفِيضُونَ","вы рассуждаете",46,8],["فِيهِۚ","о нём",46,8],["كَفَىٰ","достаточно",46,8],["بِهِۦ","Его",46,8],["شَهِيدَۢا","Свидетелем",46,8],["بَيۡنِي","между мной",46,8]],[["وَبَيۡنَكُمۡۖ","и между вами",46,8],["وَهُوَ","и Он",46,8],["ٱلۡغَفُورُ","Прощающий",46,8],["ٱلرَّحِيمُ","Милосердный",46,8],[8],["قُلۡ","скажи",46,9],["مَا","не",46,9],["كُنتُ","был я",46,9],["بِدۡعٗا","новым",46,9],["مِّنَ","из",46,9],["ٱلرُّسُلِ","посланников",46,9]],[["وَمَآ","и не",46,9],["أَدۡرِي","знаю я",46,9],["مَا","что",46,9],["يُفۡعَلُ","будет сделано",46,9],["بِي","со мной",46,9],["وَلَا","и не",46,9],["بِكُمۡۖ","с вами",46,9],["إِنۡ","не",46,9],["أَتَّبِعُ","следую я",46,9],["إِلَّا","кроме",46,9],["مَا","того, что",46,9],["يُوحَىٰٓ","внушается",46,9],["إِلَيَّ","мне",46,9],["وَمَآ","и не",46,9],["أَنَا۠","я",46,9]],[["إِلَّا","кроме как",46,9],["نَذِيرٞ","увещеватель",46,9],["مُّبِينٞ","явный",46,9],[9],["قُلۡ","скажи",46,10],["أَرَءَيۡتُمۡ","видели ли вы",46,10],["إِن","если",46,10],["كَانَ","был он",46,10],["مِنۡ","от",46,10],["عِندِ","(стороны)",46,10],["ٱللَّهِ","Аллаха",46,10],["وَكَفَرۡتُم","а вы не уверовали",46,10],["بِهِۦ","в него",46,10]],[["وَشَهِدَ","и засвидетельствовал",46,10],["شَاهِدٞ","свидетель",46,10],["مِّنۢ","из",46,10],["بَنِيٓ","сынов",46,10],["إِسۡرَٰٓءِيلَ","Исраила",46,10],["عَلَىٰ","о",46,10],["مِثۡلِهِۦ","подобном ему",46,10],["فَـَٔامَنَ","и уверовал",46,10],["وَٱسۡتَكۡبَرۡتُمۡۚ","а вы возгордились",46,10]],[["إِنَّ","поистине",46,10],["ٱللَّهَ","Аллах",46,10],["لَا","не",46,10],["يَهۡدِي","наставляет",46,10],["ٱلۡقَوۡمَ","людей",46,10],["ٱلظَّٰلِمِينَ","беззаконных",46,10],[10],["وَقَالَ","и сказали",46,11],["ٱلَّذِينَ","те, которые",46,11],["كَفَرُواْ","не уверовали",46,11]],[["لِلَّذِينَ","о тех, которые",46,11],["ءَامَنُواْ","уверовали",46,11],["لَوۡ","если бы",46,11],["كَانَ","было (это)",46,11],["خَيۡرٗا","благом",46,11],["مَّا","не",46,11],["سَبَقُونَآ","опередили бы они нас",46,11],["إِلَيۡهِۚ","к нему",46,11],["وَإِذۡ","и раз",46,11],["لَمۡ","не",46,11],["يَهۡتَدُواْ","последовали они прямым путём",46,11],["بِهِۦ","им",46,11]],[["فَسَيَقُولُونَ","то скажут они",46,11],["هَٰذَآ","это",46,11],["إِفۡكٞ","ложь",46,11],["قَدِيمٞ","старая",46,11],[11],["وَمِن","и до",46,12],["قَبۡلِهِۦ","него",46,12],["كِتَٰبُ","Писание",46,12],["مُوسَىٰٓ","Мусы",46,12]],[["إِمَامٗا","руководством",46,12],["وَرَحۡمَةٗۚ","и милостью",46,12],["وَهَٰذَا","а это",46,12],["كِتَٰبٞ","Писание",46,12],["مُّصَدِّقٞ","подтверждающее",46,12],["لِّسَانًا","языком",46,12],["عَرَبِيّٗا","арабским",46,12],["لِّيُنذِرَ","чтобы предостеречь",46,12]],[["ٱلَّذِينَ","тех, которые",46,12],["ظَلَمُواْ","поступили несправедливо",46,12],["وَبُشۡرَىٰ","и благая весть",46,12],["لِلۡمُحۡسِنِينَ","творящим добро",46,12],[12],["إِنَّ","поисти