{"p":504,"j":26,"a":[[46,15,["وَوَصَّيۡنَا","ٱلۡإِنسَٰنَ","بِوَٰلِدَيۡهِ","إِحۡسَٰنًاۖ","حَمَلَتۡهُ","أُمُّهُۥ","كُرۡهٗا","وَوَضَعَتۡهُ","كُرۡهٗاۖ","وَحَمۡلُهُۥ","وَفِصَٰلُهُۥ","ثَلَٰثُونَ","شَهۡرًاۚ","حَتَّىٰٓ","إِذَا","بَلَغَ","أَشُدَّهُۥ","وَبَلَغَ","أَرۡبَعِينَ","سَنَةٗ","قَالَ","رَبِّ","أَوۡزِعۡنِيٓ","أَنۡ","أَشۡكُرَ","نِعۡمَتَكَ","ٱلَّتِيٓ","أَنۡعَمۡتَ","عَلَيَّ","وَعَلَىٰ","وَٰلِدَيَّ","وَأَنۡ","أَعۡمَلَ","صَٰلِحٗا","تَرۡضَىٰهُ","وَأَصۡلِحۡ","لِي","فِي","ذُرِّيَّتِيٓۖ","إِنِّي","تُبۡتُ","إِلَيۡكَ","وَإِنِّي","مِنَ","ٱلۡمُسۡلِمِينَ"],"вавассайнал инсана бивалидайхи ихсанан хамалатху уммухуу курхан вавада`атху курхан вахамлухуу вафисалухуу саласууна шахран хатта иза балага ашуддахуу вабалага арба`иина санатан ḳала рабби аузи`нии ан ашкура ни`матакал латии ан`амта `алаййа ва`ала валидаййа ва'ан а`мала салихан тардаху ва'аслих лии фии зурриййатии иннии тубту илайка ва'иннии минал муслимиин","Мы заповедали человеку делать добро его родителям. Матери тяжело носить его и рожать его, а беременность и кормление до отнятия его от груди продолжаются тридцать месяцев. Когда же он достигает зрелого возраста и достигает сорока лет, то говорит: «Господи! Внуши мне благодарность за милость, которой Ты облагодетельствовал меня и моих родителей, и помоги мне совершать праведные деяния, которыми Ты доволен. Сделай для меня моих потомков праведниками. Я раскаиваюсь перед Тобой. Воистину, я - один из мусульман».",["и заповедали Мы","человеку","его родителям","добро","носила его","мать его","с тяготой","и родила его","с тяготой","и вынашивание его","и отнятие его от груди","тридцать","месяцев","пока","когда","достигнет он","своей зрелости","и достигнет","сорока","лет","скажет он","Господи","побуди меня","чтобы","я благодарил","Твою милость","которой","Ты облагодетельствовал","меня","и","моих родителей","и чтобы","я совершал","праведное","(которым) Ты доволен","и сделай праведным","для меня","в","моём потомстве","поистине, я","покаялся","Тебе","и поистине, я","из","мусульман"]],[46,16,["أُوْلَٰٓئِكَ","ٱلَّذِينَ","نَتَقَبَّلُ","عَنۡهُمۡ","أَحۡسَنَ","مَا","عَمِلُواْ","وَنَتَجَاوَزُ","عَن","سَيِّـَٔاتِهِمۡ","فِيٓ","أَصۡحَٰبِ","ٱلۡجَنَّةِۖ","وَعۡدَ","ٱلصِّدۡقِ","ٱلَّذِي","كَانُواْ","يُوعَدُونَ"],"улаикал лазиина натаḳаббалу `анхум ахсана ма `амилуу ванатажавазу `ан саййиатихим фии асхабил жаннати ва`дас сидḳил лазии кануу йуу`адуун","Они являются теми из обитателей Рая, от которых Мы принимаем наилучшее из того, что они совершили, и которым Мы прощаем их злодеяния согласно истинному обещанию, которое им было дано.",["те","те, которых","Мы примем","от них","наилучшее","(из) того, что","они совершили","и Мы простим","от","их злые деяния","среди","обитателей","Рая","обещанием","истинным","которое","были они","обещаемы"]],[46,17,["وَٱلَّذِي","قَالَ","لِوَٰلِدَيۡهِ","أُفّٖ","لَّكُمَآ","أَتَعِدَانِنِيٓ","أَنۡ","أُخۡرَجَ","وَقَدۡ","خَلَتِ","ٱلۡقُرُونُ","مِن","قَبۡلِي","وَهُمَا","يَسۡتَغِيثَانِ","ٱللَّهَ","وَيۡلَكَ","ءَامِنۡ","إِنَّ","وَعۡدَ","ٱللَّهِ","حَقّٞ","فَيَقُولُ","مَا","هَٰذَآ","إِلَّآ","أَسَٰطِيرُ","ٱلۡأَوَّلِينَ"],"валлазии ḳала ливалидайхи уффил лакума ата`иданинии ан ухража ваḳад халатил ḳурууну мин ḳаблии вахума йастагиисаниллаха вайлака амин инна ва`даллахи хаḳḳун файаḳуулу ма хаза илла асатиирул аввалиин","А есть такой, который говорит своим родителям: «Тьфу вам! Неужели вы угрожаете мне тем, что меня вытащат из могилы, в то время как до меня уже прошло много поколений?». Они просят Аллаха о помощи: «Горе тебе! Уверуй, ведь обещание Аллаха истинно!». Он же говорит: «Это - всего лишь легенды древних народов».",["а тот, который","сказал","своим родителям","тьфу","вам обоим","неужели вы обещаете мне","что","я буду выведен","а уже","прошли","поколения","до","меня","а они оба","просят о помощи","Аллаха","горе тебе","уверуй","поистине","обещание","Аллаха","истинно","а он говорит","не","это","кроме","сказки","древних"]],[46,18,["أُوْلَٰٓئِكَ","ٱلَّذِينَ","حَقَّ","عَلَيۡهِمُ","ٱلۡقَوۡلُ","فِيٓ","أُمَمٖ","قَدۡ","خَلَتۡ","مِن","قَبۡلِهِم","مِّنَ","ٱلۡجِنِّ","وَٱلۡإِنسِۖ","إِنَّهُمۡ","كَانُواْ","خَٰسِرِينَ"],"улаикал лазиина хаḳḳа `алайхимул ḳаулу фии умамин ḳад халат мин ḳаблихим минал жинни вал'инси иннахум кануу хасириин","Сбылось Слово относительно них и живших до них народов из числа джиннов и людей. Воистину, они были потерпевшими убыток.",["те","те, которых","сбылось","на них","слово","среди","общин","уже","прошедших","до","них","из","джиннов","и людей","поистине, они","были","потерпевшими убыток"]],[46,19,["وَلِكُلّٖ","دَرَجَٰتٞ","مِّمَّا","عَمِلُواْۖ","وَلِيُوَفِّيَهُمۡ","أَعۡمَٰلَهُمۡ","وَهُمۡ","لَا","يُظۡلَمُونَ"],"валикуллин даражатум мимма `амилуу валийуаффийахум а`малахум вахум ла йузламуун","Для всех будут ступени, соответствующие тому, что они совершили, дабы Аллах воздал им сполна за их деяния, и с ними не поступят несправедливо.",["и для всех","степени","по тому, что","они совершили","и чтобы Он воздал им сполна","их деяния","и они","не","будут обижены"]],[46,20,["وَيَوۡمَ","يُعۡرَضُ","ٱلَّذِينَ","كَفَرُواْ","عَلَى","ٱلنَّارِ","أَذۡهَبۡتُمۡ","طَيِّبَٰتِكُمۡ","فِي","حَيَاتِكُمُ","ٱلدُّنۡيَا","وَٱسۡتَمۡتَعۡتُم","بِهَا","فَٱلۡيَوۡمَ","تُجۡزَوۡنَ","عَذَابَ","ٱلۡهُونِ","بِمَا","كُنتُمۡ","تَسۡتَكۡبِرُونَ","فِي","ٱلۡأَرۡضِ","بِغَيۡرِ","ٱلۡحَقِّ","وَبِمَا","كُنتُمۡ","تَفۡسُقُونَ"],"вайаума йу`радул лазиина кафаруу `алан нари азхабтум таййибатикум фии хайатикумуд дунйа вастамта`тум биха фалйаума тужзауна `азабал хууни бима кунтум тастакбирууна фил арди бигайрил хаḳḳи вабима кунтум тафсуḳуун","В тот день, когда неверующих представят Огню, им скажут: «Вы растратили свои блага в свой мирской жизни и попользовались ими. Сегодня вашим воздаянием будут унизительные мучения за то, что вы превозносились на земле без всякого права, и за то, что вы были нечестивцами».",["и в день (когда)","будут представлены","те, которые","не уверовали","к","Огню","вы растратили","ваши блага","в","вашей жизни","мирской","и вы наслаждались","ими","и сегодня","вам воздастся","наказанием","унизительным","за то, что","вы","превозносились","на","земле","без","права","и за то, что","вы","нечестиво поступали"]]],"m":[[["وَوَصَّيۡنَا","и заповедали Мы",46,15],["ٱلۡإِنسَٰنَ","человеку",46,15],["بِوَٰلِدَيۡهِ","его родителям",46,15],["إِحۡسَٰنًاۖ","добро",46,15],["حَمَلَتۡهُ","носила его",46,15],["أُمُّهُۥ","мать его",46,15],["كُرۡهٗا","с тяготой",46,15],["وَوَضَعَتۡهُ","и родила его",46,15]],[["كُرۡهٗاۖ","с тяготой",46,15],["وَحَمۡلُهُۥ","и вынашивание его",46,15],["وَفِصَٰلُهُۥ","и отнятие его от груди",46,15],["ثَلَٰثُونَ","тридцать",46,15],["شَهۡرًاۚ","месяцев",46,15],["حَتَّىٰٓ","пока",46,15],["إِذَا","когда",46,15],["بَلَغَ","достигнет он",46,15],["أَشُدَّهُۥ","своей зрелости",46,15],["وَبَلَغَ","и достигнет",46,15]],[["أَرۡبَعِينَ","сорока",46,15],["سَنَةٗ","лет",46,15],["قَالَ","скажет он",46,15],["رَبِّ","Господи",46,15],["أَوۡزِعۡنِيٓ","побуди меня",46,15],["أَنۡ","чтобы",46,15],["أَشۡكُرَ","я благодарил",46,15],["نِعۡمَتَكَ","Твою милость",46,15],["ٱلَّتِيٓ","которой",46,15],["أَنۡعَمۡتَ","Ты облагодетельствовал",46,15]],[["عَلَيَّ","меня",46,15],["وَعَلَىٰ","и",46,15],["وَٰلِدَيَّ","моих родителей",46,15],["وَأَنۡ","и чтобы",46,15],["أَعۡمَلَ","я совершал",46,15],["صَٰلِحٗا","праведное",46,15],["تَرۡضَىٰهُ","(которым) Ты доволен",46,15],["وَأَصۡلِحۡ","и сделай праведным",46,15],["لِي","для меня",46,15],["فِي","в",46,15]],[["ذُرِّيَّتِيٓۖ","моём потомстве",46,15],["إِنِّي","поистине, я",46,15],["تُبۡتُ","покаялся",46,15],["إِلَيۡكَ","Тебе",46,15],["وَإِنِّي","и поистине, я",46,15],["مِنَ","из",46,15],["ٱلۡمُسۡلِمِينَ","мусульман",46,15],[15],["أُوْلَٰٓئِكَ","те",46,16],["ٱلَّذِينَ","те, которых",46,16]],[["نَتَقَبَّلُ","Мы примем",46,16],["عَنۡهُمۡ","от них",46,16],["أَحۡسَنَ","наилучшее",46,16],["مَا","(из) того, что",46,16],["عَمِلُواْ","они совершили",46,16],["وَنَتَجَاوَزُ","и Мы простим",46,16],["عَن","от",46,16],["سَيِّـَٔاتِهِمۡ","их злые деяния",46,16],["فِيٓ","среди",46,16],["أَصۡحَٰبِ","обитателей",46,16]],[["ٱلۡجَنَّةِۖ","Рая",46,16],["وَعۡدَ","обещанием",46,16],["ٱلصِّدۡق