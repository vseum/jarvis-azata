{"p":505,"j":26,"a":[[46,21,["وَٱذۡكُرۡ","أَخَا","عَادٍ","إِذۡ","أَنذَرَ","قَوۡمَهُۥ","بِٱلۡأَحۡقَافِ","وَقَدۡ","خَلَتِ","ٱلنُّذُرُ","مِنۢ","بَيۡنِ","يَدَيۡهِ","وَمِنۡ","خَلۡفِهِۦٓ","أَلَّا","تَعۡبُدُوٓاْ","إِلَّا","ٱللَّهَ","إِنِّيٓ","أَخَافُ","عَلَيۡكُمۡ","عَذَابَ","يَوۡمٍ","عَظِيمٖ"],"вазкур аха `адин из анзара ḳаумахуу бил'ахḳафи ваḳад халатин нузуру мим байни йадайхи вамин халфихии алла та`будуу иллаллаха иннии ахафу `алайкум `азаба йаумин `азиим","Помяни брата адитов. Вот он предостерег свой народ среди барханов, хотя перед ним и позади него уже были предостережения: «Не поклоняйтесь никому, кроме Аллаха! Воистину, я боюсь, что вас постигнут мучения в Великий день».",["и помяни","брата","адитов","когда","он предостерёг","свой народ","в Ахкафе","а уже","прошли","предостерегающие","из","перед","ним","и из","позади него","чтобы не","поклонялись вы","кроме","Аллаха","поистине, я","боюсь","за вас","наказания","дня","великого"]],[46,22,["قَالُوٓاْ","أَجِئۡتَنَا","لِتَأۡفِكَنَا","عَنۡ","ءَالِهَتِنَا","فَأۡتِنَا","بِمَا","تَعِدُنَآ","إِن","كُنتَ","مِنَ","ٱلصَّٰدِقِينَ"],"ḳалуу ажи'тана лита'фикана `ан алихатина фа'тина бима та`идуна ин кунта минас садиḳиин","Они сказали: «Неужели ты пришел для того, чтобы отвратить нас от наших богов? Яви же нам то, чем ты нам угрожаешь, если ты - один из тех, кто говорит правду».",["они сказали","неужели ты пришёл к нам","чтобы отвратить нас","от","наших богов","так приведи нам","то, что","ты обещаешь нам","если","ты","из","правдивых"]],[46,23,["قَالَ","إِنَّمَا","ٱلۡعِلۡمُ","عِندَ","ٱللَّهِ","وَأُبَلِّغُكُم","مَّآ","أُرۡسِلۡتُ","بِهِۦ","وَلَٰكِنِّيٓ","أَرَىٰكُمۡ","قَوۡمٗا","تَجۡهَلُونَ"],"ḳала иннамал `илму `индаллахи ва'убаллигукум ма урсилту бихии валакиннии аракум ḳауман тажхалуун","Он сказал: «Знание - у Аллаха, а я лишь довожу до вашего сведения то, с чем я послан. Но я вижу, что вы являетесь невежественными людьми».",["он сказал","лишь","знание","у","Аллаха","и я довожу до вас","то, что","я послан","с ним","но я","вижу вас","людьми","невежественными"]],[46,24,["فَلَمَّا","رَأَوۡهُ","عَارِضٗا","مُّسۡتَقۡبِلَ","أَوۡدِيَتِهِمۡ","قَالُواْ","هَٰذَا","عَارِضٞ","مُّمۡطِرُنَاۚ","بَلۡ","هُوَ","مَا","ٱسۡتَعۡجَلۡتُم","بِهِۦۖ","رِيحٞ","فِيهَا","عَذَابٌ","أَلِيمٞ"],"фаламма ра'ауху `аридам мустаḳбила аудийатихим ḳалуу хаза `аридум мумтируна бал хуа маста`жалтум бихии риихун фииха `азабун алиим","Когда же они увидели его (наказание) в виде тучи, надвигающейся на их долины, они сказали: «Это - туча, которая прольет на нас дождь». О нет! Вот то, что вы торопили, - ветер, несущий с собой мучительные страдания.",["и когда","увидели они его","тучей","надвигающейся (на)","их долины","они сказали","это","туча","прольющая нам дождь","нет же","оно","то, что","вы торопили","его","ветер","в нём","наказание","мучительное"]],[46,25,["تُدَمِّرُ","كُلَّ","شَيۡءِۭ","بِأَمۡرِ","رَبِّهَا","فَأَصۡبَحُواْ","لَا","يُرَىٰٓ","إِلَّا","مَسَٰكِنُهُمۡۚ","كَذَٰلِكَ","نَجۡزِي","ٱلۡقَوۡمَ","ٱلۡمُجۡرِمِينَ"],"тудаммиру кулла шай'и би'амри раббиха фа'асбахуу ла йура илла масакинухум казалика нажзил ḳаумал мужримиин","Он уничтожает всякую вещь по велению своего Господа. А на утро от них остались видны только их жилища. Так Мы воздаем грешным людям.",["уничтожает он","всякую","вещь","по велению","своего Господа","и наутро они стали","не","видно","кроме","их жилищ","так","Мы воздаём","людям","грешным"]],[46,26,["وَلَقَدۡ","مَكَّنَّٰهُمۡ","فِيمَآ","إِن","مَّكَّنَّٰكُمۡ","فِيهِ","وَجَعَلۡنَا","لَهُمۡ","سَمۡعٗا","وَأَبۡصَٰرٗا","وَأَفۡـِٔدَةٗ","فَمَآ","أَغۡنَىٰ","عَنۡهُمۡ","سَمۡعُهُمۡ","وَلَآ","أَبۡصَٰرُهُمۡ","وَلَآ","أَفۡـِٔدَتُهُم","مِّن","شَيۡءٍ","إِذۡ","كَانُواْ","يَجۡحَدُونَ","بِـَٔايَٰتِ","ٱللَّهِ","وَحَاقَ","بِهِم","مَّا","كَانُواْ","بِهِۦ","يَسۡتَهۡزِءُونَ"],"валаḳад макканнахум фиима им макканнакум фиихи важа`ална лахум сам`ан ва'абсаран ва'аф'идатан фама агна `анхум сам`ухум вала абсарухум вала аф'идатухум мин шай'ин из кануу йажхадууна би'айатиллахи вахаḳа бихим ма кануу бихии йастахзиуун","Мы укрепили их в том, в чем не укрепляли вас, и даровали им слух, зрение и сердца. Но ни их слух, ни их зрение, ни их сердца нисколько не помогли им, поскольку они отвергали знамения Аллаха, и их окружило (или поразило) то, над чем они насмехались.",["и уже","Мы укрепили их","в том, в чём","не","Мы укрепляли вас","в нём","и сделали Мы","для них","слух","и зрение","и сердца","но не","помогли","им","их слух","и не","их зрение","и не","их сердца","ни в","чём","когда","они","отвергали","знамения","Аллаха","и окружило","их","то, что","они","над ним","насмехались"]],[46,27,["وَلَقَدۡ","أَهۡلَكۡنَا","مَا","حَوۡلَكُم","مِّنَ","ٱلۡقُرَىٰ","وَصَرَّفۡنَا","ٱلۡأٓيَٰتِ","لَعَلَّهُمۡ","يَرۡجِعُونَ"],"валаḳад ахлакна ма хаулакум минал ḳура васаррафнал айати ла`аллахум йаржи`уун","Мы уже погубили селения, которые были вокруг вас, и разъяснили знамения, чтобы они могли вернуться на прямой путь.",["и уже","Мы погубили","то, что","вокруг вас","из","селений","и Мы разъяснили","знамения","чтобы они","вернулись"]],[46,28,["فَلَوۡلَا","نَصَرَهُمُ","ٱلَّذِينَ","ٱتَّخَذُواْ","مِن","دُونِ","ٱللَّهِ","قُرۡبَانًا","ءَالِهَةَۢۖ","بَلۡ","ضَلُّواْ","عَنۡهُمۡۚ","وَذَٰلِكَ","إِفۡكُهُمۡ","وَمَا","كَانُواْ","يَفۡتَرُونَ"],"фалаула насарахумул лазиинаттахазуу мин дууниллахи ḳурбанан алихата бал даллуу `анхум вазалика ифкухум вама кануу йафтаруун","Почему же им не помогли, те божества, которым они поклонялись вместо Аллаха для того, чтобы приблизиться к Нему? Напротив, они скрылись от них. Вот их ложь и то, что они измышляли!",["почему же не","помогли им","те, которых","они взяли","из","помимо","Аллаха","для приближения","божествами","напротив","они исчезли","от них","и это","их ложь","и то, что","они","измышляли"]]],"m":[[["۞ وَٱذۡكُرۡ","и помяни",46,21],["أَخَا","брата",46,21],["عَادٍ","адитов",46,21],["إِذۡ","когда",46,21],["أَنذَرَ","он предостерёг",46,21],["قَوۡمَهُۥ","свой народ",46,21],["بِٱلۡأَحۡقَافِ","в Ахкафе",46,21],["وَقَدۡ","а уже",46,21],["خَلَتِ","прошли",46,21],["ٱلنُّذُرُ","предостерегающие",46,21]],[["مِنۢ","из",46,21],["بَيۡنِ","перед",46,21],["يَدَيۡهِ","ним",46,21],["وَمِنۡ","и из",46,21],["خَلۡفِهِۦٓ","позади него",46,21],["أَلَّا","чтобы не",46,21],["تَعۡبُدُوٓاْ","поклонялись вы",46,21],["إِلَّا","кроме",46,21],["ٱللَّهَ","Аллаха",46,21],["إِنِّيٓ","поистине, я",46,21],["أَخَافُ","боюсь",46,21],["عَلَيۡكُمۡ","за вас",46,21]],[["عَذَابَ","наказания",46,21],["يَوۡمٍ","дня",46,21],["عَظِيمٖ","великого",46,21],[21],["قَالُوٓاْ","они сказали",46,22],["أَجِئۡتَنَا","неужели ты пришёл к нам",46,22],["لِتَأۡفِكَنَا","чтобы отвратить нас",46,22],["عَنۡ","от",46,22],["ءَالِهَتِنَا","наших богов",46,22],["فَأۡتِنَا","так приведи нам",46,22]],[["بِمَا","то, что",46,22],["تَعِدُنَآ","ты обещаешь нам",46,22],["إِن","если",46,22],["كُنتَ","ты",46,22],["مِنَ","из",46,22],["ٱلصَّٰدِقِينَ","правдивых",46,22],[22],["قَالَ","он сказал",46,23],["إِنَّمَا","лишь",46,23],["ٱلۡعِلۡمُ","знание",46,23],["عِندَ","у",46,23],["ٱللَّهِ","Аллаха",46,23]],[["وَأُبَلِّغُكُم","и я довожу до вас",46,23],["مَّآ","то, что",46,23],["أُرۡسِلۡتُ","я послан",46,23],["بِهِۦ","с ним",46,23],["وَلَٰكِنِّيٓ","но я",46,23],["أَرَىٰكُمۡ","вижу вас",46,23],["قَوۡمٗا","людьми",46,23],["تَجۡهَلُونَ","невежественными",46,23],[23]],[["فَلَمَّا","и когда",46,24],["رَأَوۡهُ","увидели они его",46,24],["عَارِضٗا","тучей",46,24],["مُّسۡتَقۡبِلَ","надвигающейся (на)",46,24],["أَوۡدِيَتِهِمۡ","их долины",46,24],["قَالُواْ","они сказали",46,24],["هَٰذَا","это",46,24],["عَارِضٞ","туча",46,24],["مُّمۡطِرُنَاۚ","прольющая нам дождь",46,24]],[["بَلۡ","нет же",46,24],["هُوَ","оно",46,24],["مَا","то, что",46,24],["ٱسۡتَعۡجَلۡتُم","вы торопили",46,24],["بِهِۦۖ","его",46,24],["رِيحٞ","ветер",46,24],["فِيهَا","в нём",46,24],["عَذَابٌ","наказание",46,24],["أَلِيمٞ","мучительное",46,24],[24],["تُدَمِّرُ","уничтожает он",46,25],["كُلَّ","всякую",46,25]],[["شَيۡءِۭ","вещь",46,25],["بِأَمۡرِ","по велению",46,25],["رَبِّهَا","своего Господа",46,25],["فَأَصۡبَحُواْ","и наутро они стали",46,25],["لَا","не",46,25],["يُرَىٰٓ","видно",46,25],["إِلَّا","кроме",46,25],["مَسَٰكِنُهُمۡۚ","их жилищ",46,25],["كَذَٰلِكَ","так",46,25],["نَجۡزِي","Мы воздаём",46,25]],[["ٱلۡقَوۡمَ","людям",46,25],["ٱلۡمُجۡرِمِينَ","грешным",46,25],[25],["وَلَقَدۡ","и уже",46,26],["مَكَّنَّٰهُمۡ","Мы укрепили их",46,26],["فِيمَآ","в том, в чём",46,26],["إِن","не",46,26],["مَّكَّنَّٰكُمۡ","Мы укрепляли вас",46,26],["فِيهِ","в нём",46,26]],[["وَجَعَلۡنَا","и сделали Мы",46,26],["لَهُمۡ","для них",46,26],["سَمۡعٗا","слух",46,26],["وَأَبۡصَٰرٗا","и зрение",46,26],["وَأَفۡـِٔدَةٗ","и сердца",46,26],["فَمَآ","но не",46,26],["أَغۡنَىٰ","помогли",46,26],["عَنۡهُمۡ","им",46,26],["سَمۡعُهُمۡ","их слух",46,26]],[["وَلَآ","и не",46,26],["أَبۡصَٰرُهُمۡ","их зрение",46,26],["وَلَآ","и не",46,26],["أَفۡـِٔدَتُهُم","их сердца",46,26],["مِّن","ни в",46,26],["شَيۡءٍ","чём",46,26],["إِذۡ","когда",46,26],["كَانُواْ","они",46,26],["يَجۡحَدُونَ","отвергали",46,26]],[["بِـَٔايَٰتِ","знамения",46,26],["ٱللَّهِ","Аллаха",46,26],["وَحَاقَ","и окружило",46,26],["بِهِم","их",46,26],["مَّا","то, что",46,26],["كَانُواْ","они",46,26],["بِهِۦ","над ним",46,26],["يَسۡتَهۡزِءُونَ","насмехались",46,26],[26],["وَلَقَدۡ","и уже",46,27]],[["أَهۡلَكۡنَا","Мы погубили",46,27],["مَا","то, что",46,27],["حَوۡلَكُم","вокруг вас",46,27],["مِّنَ","из",46,27],["ٱلۡقُرَىٰ","селений",46,27],["وَصَرَّفۡنَا","и Мы разъяснили",46,27],["ٱلۡأٓيَٰتِ","знамения",46,27],["لَعَلَّهُمۡ","чтобы они",46,27],["يَرۡجِعُونَ","вернулись",46,27]],[[27],["فَلَوۡلَا","почему же не",46,28],["نَصَرَهُمُ","помогли им",46,28],["ٱلَّذِينَ","те, которых",46,28],["ٱتَّخَذُواْ","они взяли",46,28],["مِن","из",46,28],["دُونِ","помимо",46,28],["ٱللَّهِ","Аллаха",46,28],["قُرۡبَانًا","для приближения",46,28],["ءَالِهَةَۢۖ","божествами",46,28]],[["بَلۡ","напротив",46,28],["ضَلُّواْ","они исчезли",46,28],["عَنۡهُمۡۚ","от них",46,28],["وَذَٰلِكَ","и это",46,28],["إِفۡكُهُمۡ","их ложь",46,28],["وَمَا","и то, что",46,28],["كَانُواْ","они",46,28],["يَفۡتَرُونَ","измышляли",46,28],[28]]]}