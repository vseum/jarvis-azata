{"p":506,"j":26,"a":[[46,29,["وَإِذۡ","صَرَفۡنَآ","إِلَيۡكَ","نَفَرٗا","مِّنَ","ٱلۡجِنِّ","يَسۡتَمِعُونَ","ٱلۡقُرۡءَانَ","فَلَمَّا","حَضَرُوهُ","قَالُوٓاْ","أَنصِتُواْۖ","فَلَمَّا","قُضِيَ","وَلَّوۡاْ","إِلَىٰ","قَوۡمِهِم","مُّنذِرِينَ"],"ва'из сарафна илайка нафарам минал жинни йастами`уунал ḳур'ана фаламма хадарууху ḳалуу анситуу фаламма ḳудийа валлау ила ḳаумихим мунзириин","Вот Мы направили к тебе нескольких джиннов, чтобы они послушали Коран. Когда они пришли к нему, то сказали: «Молчите и слушайте!». Когда же оно (чтение Корана) было завершено, они вернулись к своему народу, чтобы предостеречь его.",["и вот","Мы направили","к тебе","группу","из","джиннов","слушающих","Коран","и когда","они явились к нему","они сказали","молчите (и слушайте)","а когда","было завершено","они повернули","к","своему народу","увещевателями"]],[46,30,["قَالُواْ","يَٰقَوۡمَنَآ","إِنَّا","سَمِعۡنَا","كِتَٰبًا","أُنزِلَ","مِنۢ","بَعۡدِ","مُوسَىٰ","مُصَدِّقٗا","لِّمَا","بَيۡنَ","يَدَيۡهِ","يَهۡدِيٓ","إِلَى","ٱلۡحَقِّ","وَإِلَىٰ","طَرِيقٖ","مُّسۡتَقِيمٖ"],"ḳалуу йаḳаумана инна сами`на китабан унзила мим ба`ди мууса мусаддиḳал лима байна йадайхи йахдии илал хаḳḳи ва'ила тарииḳим мустаḳиим","Они сказали: «О народ наш! Воистину, мы услышали Писание, ниспосланное после Мусы (Моисея), подтверждающее то, что было до него. Оно направляет к истине и прямому пути.",["они сказали","о народ наш","поистине, мы","услышали","Писание","ниспосланное","из","после","Мусы","подтверждающее","то, что","между","руками его (до него)","ведущее","к","истине","и к","пути","прямому"]],[46,31,["يَٰقَوۡمَنَآ","أَجِيبُواْ","دَاعِيَ","ٱللَّهِ","وَءَامِنُواْ","بِهِۦ","يَغۡفِرۡ","لَكُم","مِّن","ذُنُوبِكُمۡ","وَيُجِرۡكُم","مِّنۡ","عَذَابٍ","أَلِيمٖ"],"йаḳаумана ажиибуу да`ийаллахи ва'аминуу бихии йагфир лакум мин зунуубикум вайужиркум мин `азабин алиим","О народ наш! Ответьте проповеднику Аллаха и уверуйте в него, и тогда Он простит вам некоторые из ваших грехов и спасет вас от мучительных страданий».",["о народ наш","ответьте","призывающему","Аллаха","и уверуйте","в него","Он простит","вам","из","ваших грехов","и спасёт вас","от","наказания","мучительного"]],[46,32,["وَمَن","لَّا","يُجِبۡ","دَاعِيَ","ٱللَّهِ","فَلَيۡسَ","بِمُعۡجِزٖ","فِي","ٱلۡأَرۡضِ","وَلَيۡسَ","لَهُۥ","مِن","دُونِهِۦٓ","أَوۡلِيَآءُۚ","أُوْلَٰٓئِكَ","فِي","ضَلَٰلٖ","مُّبِينٍ"],"вамал ла йужиб да`ийаллахи фалайса биму`жизин фил арди валайса лахуу мин дуунихии аулийау улаика фии далалим мубиин","А тот, кто не ответит проповеднику Аллаха, не спасется на земле, и не будет у него покровителей и помощников вместо Него. Такие находятся в очевидном заблуждении.",["а кто","не","ответит","призывающему","Аллаха","то не","ускользнёт","на","земле","и нет","у него","из","помимо Него","покровителей","те","в","заблуждении","явном"]],[46,33,["أَوَلَمۡ","يَرَوۡاْ","أَنَّ","ٱللَّهَ","ٱلَّذِي","خَلَقَ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضَ","وَلَمۡ","يَعۡيَ","بِخَلۡقِهِنَّ","بِقَٰدِرٍ","عَلَىٰٓ","أَن","يُحۡـِۧيَ","ٱلۡمَوۡتَىٰۚ","بَلَىٰٓۚ","إِنَّهُۥ","عَلَىٰ","كُلِّ","شَيۡءٖ","قَدِيرٞ"],"авалам йарау анналлахал лазии халаḳас самавати вал'арда валам йа`йа бихалḳихинна биḳадирин `ала ан йухиийал маута бала иннахуу `ала кулли шай'ин ḳадиир","Разве они не видят, что Аллах, Который сотворил небеса и землю и не утомился от их сотворения, способен оживить мертвых? О да! Он способен на всякую вещь.",["разве не","видят они","что","Аллах","Который","сотворил","небеса","и землю","и не","утомился","их сотворением","способен","на","то, чтобы","оживить","мёртвых","да","поистине, Он","на","всякую","вещь","Всемогущ"]],[46,34,["وَيَوۡمَ","يُعۡرَضُ","ٱلَّذِينَ","كَفَرُواْ","عَلَى","ٱلنَّارِ","أَلَيۡسَ","هَٰذَا","بِٱلۡحَقِّۖ","قَالُواْ","بَلَىٰ","وَرَبِّنَاۚ","قَالَ","فَذُوقُواْ","ٱلۡعَذَابَ","بِمَا","كُنتُمۡ","تَكۡفُرُونَ"],"вайаума йу`радул лазиина кафаруу `алан нари алайса хаза билхаḳḳи ḳалуу бала вараббина ḳала фазууḳул `азаба бима кунтум такфуруун","В тот день, когда неверующих представят Огню, им скажут: «Разве это не есть истина?». Они скажут: «Да! Клянемся нашим Господом!». Он скажет: «Вкусите же мучения за то, что вы не верили».",["и в день","будут представлены","те, которые","не уверовали","перед","Огнём","разве не","это","истина","они скажут","да","клянёмся нашим Господом","Он скажет","вкусите же","наказание","за то, что","вы","не веровали"]],[46,35,["فَٱصۡبِرۡ","كَمَا","صَبَرَ","أُوْلُواْ","ٱلۡعَزۡمِ","مِنَ","ٱلرُّسُلِ","وَلَا","تَسۡتَعۡجِل","لَّهُمۡۚ","كَأَنَّهُمۡ","يَوۡمَ","يَرَوۡنَ","مَا","يُوعَدُونَ","لَمۡ","يَلۡبَثُوٓاْ","إِلَّا","سَاعَةٗ","مِّن","نَّهَارِۭۚ","بَلَٰغٞۚ","فَهَلۡ","يُهۡلَكُ","إِلَّا","ٱلۡقَوۡمُ","ٱلۡفَٰسِقُونَ"],"фасбир кама сабара улул `азми минар русули вала таста`жил лахум ка'аннахум йаума йарауна ма йуу`адууна лам йалбасуу илла са`атам мин нахари балагун фахал йухлаку иллал ḳаумул фасиḳуун","Терпи же, как терпели твердые духом посланники, и не торопи Меня с наказанием для них. В тот день, когда они увидят то, что им обещано, им покажется, что они пробыли на земле всего лишь час дня. Таково послание! Разве будет погублен кто-либо, кроме нечестивых людей?",["терпи же","как","терпели","обладающие","твёрдостью","из","посланников","и не","торопи (наказание)","для них","словно они","в день","увидят","то, что","им обещано","не","пробыли","лишь","час","из","дня","(это) послание","разве же","будет погублен","кроме","народа","нечестивого"]]],"m":[[["وَإِذۡ","и вот",46,29],["صَرَفۡنَآ","Мы направили",46,29],["إِلَيۡكَ","к тебе",46,29],["نَفَرٗا","группу",46,29],["مِّنَ","из",46,29],["ٱلۡجِنِّ","джиннов",46,29],["يَسۡتَمِعُونَ","слушающих",46,29],["ٱلۡقُرۡءَانَ","Коран",46,29],["فَلَمَّا","и когда",46,29]],[["حَضَرُوهُ","они явились к нему",46,29],["قَالُوٓاْ","они сказали",46,29],["أَنصِتُواْۖ","молчите (и слушайте)",46,29],["فَلَمَّا","а когда",46,29],["قُضِيَ","было завершено",46,29],["وَلَّوۡاْ","они повернули",46,29],["إِلَىٰ","к",46,29],["قَوۡمِهِم","своему народу",46,29],["مُّنذِرِينَ","увещевателями",46,29]],[[29],["قَالُواْ","они сказали",46,30],["يَٰقَوۡمَنَآ","о народ наш",46,30],["إِنَّا","поистине, мы",46,30],["سَمِعۡنَا","услышали",46,30],["كِتَٰبًا","Писание",46,30],["أُنزِلَ","ниспосланное",46,30],["مِنۢ","из",46,30],["بَعۡدِ","после",46,30],["مُوسَىٰ","Мусы",46,30]],[["مُصَدِّقٗا","подтверждающее",46,30],["لِّمَا","то, что",46,30],["بَيۡنَ","между",46,30],["يَدَيۡهِ","руками его (до него)",46,30],["يَهۡدِيٓ","ведущее",46,30],["إِلَى","к",46,30],["ٱلۡحَقِّ","истине",46,30],["وَإِلَىٰ","и к",46,30],["طَرِيقٖ","пути",46,30],["مُّسۡتَقِيمٖ","прямому",46,30]],[[30],["يَٰقَوۡمَنَآ","о народ наш",46,31],["أَجِيبُواْ","ответьте",46,31],["دَاعِيَ","призывающему",46,31],["ٱللَّهِ","Аллаха",46,31],["وَءَامِنُواْ","и уверуйте",46,31],["بِهِۦ","в него",46,31],["يَغۡفِرۡ","Он простит",46,31],["لَكُم","вам",46,31],["مِّن","из",46,31]],[["ذُنُوبِكُمۡ","ваших грехов",46,31],["وَيُجِرۡكُم","и спасёт вас",46,31],["مِّنۡ","от",46,31],["عَذَابٍ","наказания",46,31],["أَلِيمٖ","мучительного",46,31],[31],["وَمَن","а кто",46,32],["لَّا","не",46,32],["يُجِبۡ","ответит",46,32],["دَاعِيَ","призывающему",46,32],["ٱللَّهِ","Аллаха",46,32]],[["فَلَيۡسَ","то не",46,32],["بِمُعۡجِزٖ","ускользнёт",46,32],["فِي","на",46,32],["ٱلۡأَرۡضِ","земле",46,32],["وَلَيۡسَ","и нет",46,32],["لَهُۥ","у него",46,32],["مِن","из",46,32],["دُونِهِۦٓ","помимо Него",46,32],["أَوۡلِيَآءُۚ","покровителей",46,32],["أُوْلَٰٓئِكَ","те",46,32]],[["فِي","в",46,32],["ضَلَٰلٖ","заблуждении",46,32],["مُّبِينٍ","явном",46,32],[32],["أَوَلَمۡ","разве не",46,33],["يَرَوۡاْ","видят они",46,33],["أَنَّ","что",46,33],["ٱللَّهَ","Аллах",46,33],["ٱلَّذِي","Который",46,33],["خَلَقَ","сотворил",46,33],["ٱلسَّمَٰوَٰتِ","небеса",46,33]],[["وَٱلۡأَرۡضَ","и землю",46,33],["وَلَمۡ","и не",46,33],["يَعۡيَ","утомился",46,33],["بِخَلۡقِهِنَّ","их сотворением",46,33],["بِقَٰدِرٍ","способен",46,33],["عَلَىٰٓ","на",46,33],["أَن","то, чтобы",46,33],["يُحۡـِۧيَ","оживить",46,33],["ٱلۡمَوۡتَىٰۚ","мёртвых",46,33],["بَلَىٰٓۚ","да",46,33]],[["إِنَّهُۥ","поистине, Он",46,33],["عَلَىٰ","на",46,33],["كُلِّ","всякую",46,33],["شَيۡءٖ","вещь",46,33],["قَدِيرٞ","Всемогущ",46,33],[33],["وَيَوۡمَ","и в день",46,34],["يُعۡرَضُ","будут представлены",46,34],["ٱلَّذِينَ","те, которые",46,34],["كَفَرُواْ","не уверовали",46,34],["عَلَى","перед",46,34],["ٱلنَّارِ","Огнём",46,34]],[["أَلَيۡسَ","разве не",46,34],["هَٰذَا","это",46,34],["بِٱلۡحَقِّۖ","истина",46,34],["قَالُواْ","они скажут",46,34],["بَلَىٰ","да",46,34],["وَرَبِّنَاۚ","клянёмся нашим Господом",46,34],["قَالَ","Он скажет",46,34],["فَذُوقُواْ","вкусите же",46,34],["ٱلۡعَذَابَ","наказание",46,34],["بِمَا","за то, что",46,34]],[["كُنتُمۡ","вы",46,34],["تَكۡفُرُونَ","не веровали",46,34],[34],["فَٱصۡبِرۡ","терпи же",46,35],["كَمَا","как",46,35],["صَبَرَ","терпели",46,35],["أُوْلُواْ","обладающие",46,35],["ٱلۡعَزۡمِ","твёрдостью",46,35],["مِنَ","из",46,35],["ٱلرُّسُلِ","посланников",46,35]],[["وَلَا","и не",46,35],["تَسۡتَعۡجِل","торопи (наказание)",46,35],["لَّهُمۡۚ","для них",46,35],["كَأَنَّهُمۡ","словно они",46,35],["يَوۡمَ","в день",46,35],["يَرَوۡنَ","увидят",46,35],["مَا","то, что",46,35],["يُوعَدُونَ","им обещано",46,35],["لَمۡ","не",46,35],["يَلۡبَثُوٓاْ","пробыли",46,35],["إِلَّا","лишь",46,35]],[["سَاعَةٗ","час",46,35],["مِّن","из",46,35],["نَّهَارِۭۚ","дня",46,35],["بَلَٰغٞۚ","(это) послание",46,35],["فَهَلۡ","разве же",46,35],["يُهۡلَكُ","будет погублен",46,35],["إِلَّا","кроме",46,35],["ٱلۡقَوۡمُ","народа",46,35],["ٱلۡفَٰسِقُونَ","нечестивого",46,35],[35]],["h",47]]}