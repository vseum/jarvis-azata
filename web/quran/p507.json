ах",47,11],["مَوۡلَى","Покровитель",47,11],["ٱلَّذِينَ","тех, которые",47,11],["ءَامَنُواْ","уверовали",47,11],["وَأَنَّ","и (потому) что",47,11],["ٱلۡكَٰفِرِينَ","неверующие",47,11],["لَا","нет",47,11],["مَوۡلَىٰ","покровителя",47,11],["لَهُمۡ","у них",47,11],[11]]]}