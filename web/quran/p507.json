{"p":507,"j":26,"a":[[47,1,["ٱلَّذِينَ","كَفَرُواْ","وَصَدُّواْ","عَن","سَبِيلِ","ٱللَّهِ","أَضَلَّ","أَعۡمَٰلَهُمۡ"],"аллазиина кафаруу васаддуу `ан сабиилиллахи адалла а`малахум","Он сделал тщетными деяния тех, которые не уверовали и сбивали других с пути Аллаха.",["те, которые","не уверовали","и отвращали","от","пути","Аллаха","Он сделал тщетными","их деяния"]],[47,2,["وَٱلَّذِينَ","ءَامَنُواْ","وَعَمِلُواْ","ٱلصَّٰلِحَٰتِ","وَءَامَنُواْ","بِمَا","نُزِّلَ","عَلَىٰ","مُحَمَّدٖ","وَهُوَ","ٱلۡحَقُّ","مِن","رَّبِّهِمۡ","كَفَّرَ","عَنۡهُمۡ","سَيِّـَٔاتِهِمۡ","وَأَصۡلَحَ","بَالَهُمۡ"],"валлазиина амануу ва`амилус салихати ва'амануу бима нуззила `ала мухаммадин вахуал хаḳḳу мир раббихим каффара `анхум саййиатихим ва'аслаха балахум","Он простил грехи и исправил положение тех, которые уверовали, совершали праведные деяния и уверовали в истину, ниспосланную Мухаммаду от их Господа.",["а те, которые","уверовали","и совершали","праведные деяния","и уверовали","в то, что","ниспослано","на","Мухаммада","и оно","истина","от","их Господа","Он загладил","с них","их дурные дела","и исправил","их положение"]],[47,3,["ذَٰلِكَ","بِأَنَّ","ٱلَّذِينَ","كَفَرُواْ","ٱتَّبَعُواْ","ٱلۡبَٰطِلَ","وَأَنَّ","ٱلَّذِينَ","ءَامَنُواْ","ٱتَّبَعُواْ","ٱلۡحَقَّ","مِن","رَّبِّهِمۡۚ","كَذَٰلِكَ","يَضۡرِبُ","ٱللَّهُ","لِلنَّاسِ","أَمۡثَٰلَهُمۡ"],"залика би'аннал лазиина кафаруттаба`ул батила ва'аннал лазиина амануттаба`ул хаḳḳа мир раббихим казалика йадрибуллаху линнаси амсалахум","Это - за то, что неверующие последовали за ложью, а верующие последовали за истиной от их Господа. Так Аллах приводит людям их притчи.",["это","потому, что","те, которые","не уверовали","последовали","за ложью","и (потому) что","те, которые","уверовали","последовали","за истиной","от","их Господа","так","приводит","Аллах","людям","их притчи"]],[47,4,["فَإِذَا","لَقِيتُمُ","ٱلَّذِينَ","كَفَرُواْ","فَضَرۡبَ","ٱلرِّقَابِ","حَتَّىٰٓ","إِذَآ","أَثۡخَنتُمُوهُمۡ","فَشُدُّواْ","ٱلۡوَثَاقَ","فَإِمَّا","مَنَّۢا","بَعۡدُ","وَإِمَّا","فِدَآءً","حَتَّىٰ","تَضَعَ","ٱلۡحَرۡبُ","أَوۡزَارَهَاۚ","ذَٰلِكَۖ","وَلَوۡ","يَشَآءُ","ٱللَّهُ","لَٱنتَصَرَ","مِنۡهُمۡ","وَلَٰكِن","لِّيَبۡلُوَاْ","بَعۡضَكُم","بِبَعۡضٖۗ","وَٱلَّذِينَ","قُتِلُواْ","فِي","سَبِيلِ","ٱللَّهِ","فَلَن","يُضِلَّ","أَعۡمَٰلَهُمۡ"],"фа'иза лаḳиитумул лазиина кафаруу фадарбар риḳаби хатта иза асхантумуухум фашуддул васаḳа фа'имма манна ба`ду ва'имма фидаан хатта тада`ал харбу аузараха залика валау йашауллаху лантасара минхум валакил лийаблуа ба`дакум биба`дин валлазиина ḳутилуу фии сабиилиллахи фалан йудилла а`малахум","Когда вы встречаетесь с неверующими на поле боя, то рубите головы. Когда же вы ослабите их, то крепите оковы. А потом или милуйте, или же берите выкуп до тех пор, пока война не сложит свое бремя. Вот так! Если бы Аллах пожелал, то отомстил бы им сам, но Он пожелал испытать одних из вас посредством других. Он никогда не сделает тщетными деяния тех, кто был убит на пути Аллаха.",["и когда","вы встретите","тех, которые","не уверовали","то рубите","шеи","пока","когда","вы ослабите их","то крепите","оковы","затем либо","милость","после","либо","выкуп","пока","не сложит","война","свои бремена","так","и если бы","пожелал","Аллах","непременно Он отомстил бы","им","но","чтобы испытать","одних из вас","другими","а те, которые","убиты","на","пути","Аллаха","то никогда не","Он сделает тщетными","их деяния"]],[47,5,["سَيَهۡدِيهِمۡ","وَيُصۡلِحُ","بَالَهُمۡ"],"сайахдиихим вайуслиху балахум","Он поведет их прямым путем, исправит их положение",["Он поведёт их","и исправит","их положение"]],[47,6,["وَيُدۡخِلُهُمُ","ٱلۡجَنَّةَ","عَرَّفَهَا","لَهُمۡ"],"вайудхилухумул жанната `аррафаха лахум","и введет их в Рай, с которым Он их ознакомил (или который Он умастил для них благовониями).",["и введёт их","в Рай","который Он сделал известным","им"]],[47,7,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُوٓاْ","إِن","تَنصُرُواْ","ٱللَّهَ","يَنصُرۡكُمۡ","وَيُثَبِّتۡ","أَقۡدَامَكُمۡ"],"йа'аййухал лазиина амануу ин тансуруллаха йансуркум вайусаббит аḳдамакум","О те, которые уверовали! Если вы поможете Аллаху, то и Он поможет вам и утвердит ваши стопы.",["о","те, которые","уверовали","если","вы поможете","Аллаху","Он поможет вам","и утвердит","ваши стопы"]],[47,8,["وَٱلَّذِينَ","كَفَرُواْ","فَتَعۡسٗا","لَّهُمۡ","وَأَضَلَّ","أَعۡمَٰلَهُمۡ"],"валлазиина кафаруу фата`сал лахум ва'адалла а`малахум","Гибель тем, которые не уверовали! Он сделает тщетными их деяния.",["а те, которые","не уверовали","то гибель","им","и Он сделал тщетными","их деяния"]],[47,9,["ذَٰلِكَ","بِأَنَّهُمۡ","كَرِهُواْ","مَآ","أَنزَلَ","ٱللَّهُ","فَأَحۡبَطَ","أَعۡمَٰلَهُمۡ"],"залика би'аннахум карихуу ма анзалаллаху фа'ахбата а`малахум","Это потому, что они возненавидели ниспосланное Аллахом, и Он сделал тщетными их деяния!",["это","потому, что они","возненавидели","то, что","ниспослал","Аллах","и Он сделал тщетными","их деяния"]],[47,10,["أَفَلَمۡ","يَسِيرُواْ","فِي","ٱلۡأَرۡضِ","فَيَنظُرُواْ","كَيۡفَ","كَانَ","عَٰقِبَةُ","ٱلَّذِينَ","مِن","قَبۡلِهِمۡۖ","دَمَّرَ","ٱللَّهُ","عَلَيۡهِمۡۖ","وَلِلۡكَٰفِرِينَ","أَمۡثَٰلُهَا"],"афалам йасиируу фил арди файанзуруу кайфа кана `аḳибатул лазиина мин ḳаблихим даммараллаху `алайхим валилкафириина амсалуха","Неужели они не странствовали по земле и не видели, каким был конец их предшественников? Аллах уничтожил их, и неверующих ожидает подобное этому.",["разве же не","странствовали они","по","земле","и (не) видели","каким","был","конец","тех, которые","из","до них","уничтожил","Аллах","их","и неверующим","подобное этому"]],[47,11,["ذَٰلِكَ","بِأَنَّ","ٱللَّهَ","مَوۡلَى","ٱلَّذِينَ","ءَامَنُواْ","وَأَنَّ","ٱلۡكَٰفِرِينَ","لَا","مَوۡلَىٰ","لَهُمۡ"],"залика би'анналлаха маулал лазиина амануу ва'аннал кафириина ла маула лахум","Это потому, что Аллах является Покровителем верующих, а у неверующих нет покровителя.",["это","потому, что","Аллах","Покровитель","тех, которые","уверовали","и (потому) что","неверующие","нет","покровителя","у них"]]],"m":[["b"],[["ٱلَّذِينَ","те, которые",47,1],["كَفَرُواْ","не уверовали",47,1],["وَصَدُّواْ","и отвращали",47,1],["عَن","от",47,1],["سَبِيلِ","пути",47,1],["ٱللَّهِ","Аллаха",47,1],["أَضَلَّ","Он сделал тщетными",47,1],["أَعۡمَٰلَهُمۡ","их деяния",47,1],[1],["وَٱلَّذِينَ","а те, которые",47,2]],[["ءَامَنُواْ","уверовали",47,2],["وَعَمِلُواْ","и совершали",47,2],["ٱلصَّٰلِحَٰتِ","праведные деяния",47,2],["وَءَامَنُواْ","и уверовали",47,2],["بِمَا","в то, что",47,2],["نُزِّلَ","ниспослано",47,2],["عَلَىٰ","на",47,2],["مُحَمَّدٖ","Мухаммада",47,2],["وَهُوَ","и оно",47,2],["ٱلۡحَقُّ","истина",47,2],["مِن","от",47,2]],[["رَّبِّهِمۡ","их Господа",47,2],["كَفَّرَ","Он загладил",47,2],["عَنۡهُمۡ","с них",47,2],["سَيِّـَٔاتِهِمۡ","их дурные дела",47,2],["وَأَصۡلَحَ","и исправил",47,2],["بَالَهُمۡ","их положение",47,2],[2],["ذَٰلِكَ","это",47,3],["بِأَنَّ","потому, что",47,3],["ٱلَّذِينَ","те, которые",47,3],["كَفَرُواْ","не уверовали",47,3]],[["ٱتَّبَعُواْ","последовали",47,3],["ٱلۡبَٰطِلَ","за ложью",47,3],["وَأَنَّ","и (потому) что",47,3],["ٱلَّذِينَ","те, которые",47,3],["ءَامَنُواْ","уверовали",47,3],["ٱتَّبَعُواْ","последовали",47,3],["ٱلۡحَقَّ","за истиной",47,3],["مِن","от",47,3],["رَّبِّهِمۡۚ","их Господа",47,3],["كَذَٰلِكَ","так",47,3],["يَضۡرِبُ","приводит",47,3]],[["ٱللَّهُ","Аллах",47,3],["لِلنَّاسِ","людям",47,3],["أَمۡثَٰلَهُمۡ","их притчи",47,3],[3],["فَإِذَا","и когда",47,4],["لَقِيتُمُ","вы встретите",47,4],["ٱلَّذِينَ","тех, которые",47,4],["كَفَرُواْ","не уверовали",47,4],["فَضَرۡبَ","то рубите",47,4],["ٱلرِّقَابِ","шеи",47,4],["حَتَّىٰٓ","пока",47,4]],[["إِذَآ","когда",47,4],["أَثۡخَنتُمُوهُمۡ","вы ослабите их",47,4],["فَشُدُّواْ","то крепите",47,4],["ٱلۡوَثَاقَ","оковы",47,4],["فَإِمَّا","затем либо",47,4],["مَنَّۢا","милость",47,4],["بَعۡدُ","после",47,4],["وَإِمَّا","либо",47,4],["فِدَآءً","выкуп",47,4],["حَتَّىٰ","пока",47,4],["تَضَعَ","не сложит",47,4],["ٱلۡحَرۡبُ","война",47,4]],[["أَوۡزَارَهَاۚ","свои бремена",47,4],["ذَٰلِكَۖ","так",47,4],["وَلَوۡ","и если бы",47,4],["يَشَآءُ","пожелал",47,4],["ٱللَّهُ","Аллах",47,4],["لَٱنتَصَرَ