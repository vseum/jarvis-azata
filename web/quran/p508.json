{"p":508,"j":26,"a":[[47,12,["إِنَّ","ٱللَّهَ","يُدۡخِلُ","ٱلَّذِينَ","ءَامَنُواْ","وَعَمِلُواْ","ٱلصَّٰلِحَٰتِ","جَنَّٰتٖ","تَجۡرِي","مِن","تَحۡتِهَا","ٱلۡأَنۡهَٰرُۖ","وَٱلَّذِينَ","كَفَرُواْ","يَتَمَتَّعُونَ","وَيَأۡكُلُونَ","كَمَا","تَأۡكُلُ","ٱلۡأَنۡعَٰمُ","وَٱلنَّارُ","مَثۡوٗى","لَّهُمۡ"],"инналлаха йудхилул лазиина амануу ва`амилус салихати жаннатин тажрии мин тахтихал анхару валлазиина кафаруу йатаматта`ууна вайа'кулууна кама та'кулул ан`аму ваннару масвал лахум","Воистину, Аллах введет тех, которые уверовали и совершали праведные деяния, в Райские сады, в которых текут реки. А неверующие пользуются благами и едят, подобно скоту. Их обителью будет Огонь.",["поистине","Аллах","введёт","тех, которые","уверовали","и совершали","праведные деяния","в сады","текут","из","под ними","реки","а те, которые","не уверовали","наслаждаются","и едят","как","ест","скот","и Огонь","обитель","для них"]],[47,13,["وَكَأَيِّن","مِّن","قَرۡيَةٍ","هِيَ","أَشَدُّ","قُوَّةٗ","مِّن","قَرۡيَتِكَ","ٱلَّتِيٓ","أَخۡرَجَتۡكَ","أَهۡلَكۡنَٰهُمۡ","فَلَا","نَاصِرَ","لَهُمۡ"],"вакааййим мин ḳарйатин хийа ашадду ḳувватам мин ḳарйатикал латии ахражатка ахлакнахум фала насира лахум","Сколько же селений, которые превосходили силой твое селение, изгнавшее тебя, Мы погубили! У них не было помощников.",["и сколько","из","селений","которые","сильнее","мощью","чем","твоё селение","которое","изгнало тебя","Мы погубили их","и нет","помощника","у них"]],[47,14,["أَفَمَن","كَانَ","عَلَىٰ","بَيِّنَةٖ","مِّن","رَّبِّهِۦ","كَمَن","زُيِّنَ","لَهُۥ","سُوٓءُ","عَمَلِهِۦ","وَٱتَّبَعُوٓاْ","أَهۡوَآءَهُم"],"афаман кана `ала баййинатим мир раббихии каман зуййина лахуу су'уу `амалихии ваттаба`уу ахваахум","Разве тот, кто следует ясному доказательству от своего Господа, подобен тем, которым представилось прекрасным зло их деяний и которые потакали своим желаниям?",["разве тот, кто","находится","на","ясном доказательстве","от","своего Господа","как тот","приукрашено","для которого","зло","его деяния","и (которые) последовали","своим страстям"]],[47,15,["مَّثَلُ","ٱلۡجَنَّةِ","ٱلَّتِي","وُعِدَ","ٱلۡمُتَّقُونَۖ","فِيهَآ","أَنۡهَٰرٞ","مِّن","مَّآءٍ","غَيۡرِ","ءَاسِنٖ","وَأَنۡهَٰرٞ","مِّن","لَّبَنٖ","لَّمۡ","يَتَغَيَّرۡ","طَعۡمُهُۥ","وَأَنۡهَٰرٞ","مِّنۡ","خَمۡرٖ","لَّذَّةٖ","لِّلشَّٰرِبِينَ","وَأَنۡهَٰرٞ","مِّنۡ","عَسَلٖ","مُّصَفّٗىۖ","وَلَهُمۡ","فِيهَا","مِن","كُلِّ","ٱلثَّمَرَٰتِ","وَمَغۡفِرَةٞ","مِّن","رَّبِّهِمۡۖ","كَمَنۡ","هُوَ","خَٰلِدٞ","فِي","ٱلنَّارِ","وَسُقُواْ","مَآءً","حَمِيمٗا","فَقَطَّعَ","أَمۡعَآءَهُمۡ"],"ммасалул жаннатил латии ву`идал муттаḳууна фииха анхарум мим маин гайри асинин ва'анхарум мил лабанил лам йатагаййар та`мухуу ва'анхарум мин хамрил лаззатил лишшарибиина ва'анхарум мин `асалим мусаффан валахум фииха мин куллис самарати вамагфиратум мир раббихим каман хуа халидун фин нари васуḳуу маан хамииман фаḳатта`а ам`аахум","Вот описание Рая, обещанного богобоязненным! В нем текут реки из воды, которая не застаивается, реки из молока, вкус которого не изменяется, реки из вина, дарующего наслаждение пьющим, и реки из очищенного меда. В нем для них уготованы любые фрукты и прощение от их Господа. Неужели они подобны тем, которые вечно пребывают в Огне и которых поят кипящей водой, разрывающей их кишки?",["описание","Рая","который","обещан","богобоязненным","в нём","реки","из","воды","не","застаивающейся","и реки","из","молока","не","меняется","вкус которого","и реки","из","вина","наслаждения","для пьющих","и реки","из","мёда","очищенного","и для них","в нём","из","всех","плодов","и прощение","от","их Господа","как тот, кто","он","вечно пребывает","в","Огне","и напоены они","водой","кипящей","и она разорвала","их кишки"]],[47,16,["وَمِنۡهُم","مَّن","يَسۡتَمِعُ","إِلَيۡكَ","حَتَّىٰٓ","إِذَا","خَرَجُواْ","مِنۡ","عِندِكَ","قَالُواْ","لِلَّذِينَ","أُوتُواْ","ٱلۡعِلۡمَ","مَاذَا","قَالَ","ءَانِفًاۚ","أُوْلَٰٓئِكَ","ٱلَّذِينَ","طَبَعَ","ٱللَّهُ","عَلَىٰ","قُلُوبِهِمۡ","وَٱتَّبَعُوٓاْ","أَهۡوَآءَهُمۡ"],"ваминхум ман йастами`у илайка хатта иза харажуу мин `индика ḳалуу лиллазиина уутул `илма маза ḳала анифан улаикал лазиина таба`аллаху `ала ḳулуубихим ваттаба`уу ахваахум","Среди них есть такие, которые слушают тебя. Когда они вышли от тебя, то сказали тем, которым было даровано знание: «Что он сказал только что?». Это - те, сердца которых Аллах запечатал и которые потакают своим желаниям.",["и среди них","(есть) тот, кто","слушает","тебя","а затем","когда","они вышли","от","тебя","они сказали","тем, которым","было дано","знание","что","он сказал","только что","это","те, которые","запечатал","Аллах","на","их сердцах","и последовали","своим страстям"]],[47,17,["وَٱلَّذِينَ","ٱهۡتَدَوۡاْ","زَادَهُمۡ","هُدٗى","وَءَاتَىٰهُمۡ","تَقۡوَىٰهُمۡ"],"валлазиинахтадау задахум худан ва'атахум таḳвахум","Тем, кто следует прямым путем, Он увеличивает их приверженность прямому пути и дарует их богобоязненность.",["а те, которые","последовали прямым путем","Он увеличил им","руководство","и даровал им","их богобоязненность"]],[47,18,["فَهَلۡ","يَنظُرُونَ","إِلَّا","ٱلسَّاعَةَ","أَن","تَأۡتِيَهُم","بَغۡتَةٗۖ","فَقَدۡ","جَآءَ","أَشۡرَاطُهَاۚ","فَأَنَّىٰ","لَهُمۡ","إِذَا","جَآءَتۡهُمۡ","ذِكۡرَىٰهُمۡ"],"фахал йанзурууна иллас са`ата ан та'тийахум багтатан фаḳад жаа ашратуха фа'анна лахум иза жаатхум зикрахум","Неужели они ожидают чего-либо, кроме Часа, который явится к ним внезапно? Ведь уже явились его приметы. Разве они смогут помянуть назидание, когда он явится к ним?",["разве же","ждут они","кроме","Часа","что","он придёт к ним","внезапно","ведь уже","пришли","его признаки","как же (поможет)","им","когда","он придёт к ним","их поминание"]],[47,19,["فَٱعۡلَمۡ","أَنَّهُۥ","لَآ","إِلَٰهَ","إِلَّا","ٱللَّهُ","وَٱسۡتَغۡفِرۡ","لِذَنۢبِكَ","وَلِلۡمُؤۡمِنِينَ","وَٱلۡمُؤۡمِنَٰتِۗ","وَٱللَّهُ","يَعۡلَمُ","مُتَقَلَّبَكُمۡ","وَمَثۡوَىٰكُمۡ"],"фа`лам аннахуу ла илаха иллаллаху вастагфир лизамбика валилму'миниина валму'минати валлаху йа`ламу мутаḳаллабакум вамасвакум","Знай же, что нет божества, кроме Аллаха, и проси прощения за свой грех и за верующих мужчин и верующих женщин. Аллах знает о ваших передвижениях и вашей обители.",["знай же","что","нет","божества","кроме","Аллаха","и проси прощения","за свой грех","и за верующих мужчин","и верующих женщин","и Аллах","знает","ваше передвижение","и вашу обитель"]]],"m":[[["إِنَّ","поистине",47,12],["ٱللَّهَ","Аллах",47,12],["يُدۡخِلُ","введёт",47,12],["ٱلَّذِينَ","тех, которые",47,12],["ءَامَنُواْ","уверовали",47,12],["وَعَمِلُواْ","и совершали",47,12],["ٱلصَّٰلِحَٰتِ","праведные деяния",47,12],["جَنَّٰتٖ","в сады",47,12],["تَجۡرِي","текут",47,12],["مِن","из",47,12]],[["تَحۡتِهَا","под ними",47,12],["ٱلۡأَنۡهَٰرُۖ","реки",47,12],["وَٱلَّذِينَ","а те, которые",47,12],["كَفَرُواْ","не уверовали",47,12],["يَتَمَتَّعُونَ","наслаждаются",47,12],["وَيَأۡكُلُونَ","и едят",47,12],["كَمَا","как",47,12],["تَأۡكُلُ","ест",47,12],["ٱلۡأَنۡعَٰمُ","скот",47,12]],[["وَٱلنَّارُ","и Огонь",47,12],["مَثۡوٗى","обитель",47,12],["لَّهُمۡ","для них",47,12],[12],["وَكَأَيِّن","и сколько",47,13],["مِّن","из",47,13],["قَرۡيَةٍ","селений",47,13],["هِيَ","которые",47,13],["أَشَدُّ","сильнее",47,13],["قُوَّةٗ","мощью",47,13],["مِّن","чем",47,13],["قَرۡيَتِكَ","твоё селение",47,13]],[["ٱلَّتِيٓ","которое",47,13],["أَخۡرَجَتۡكَ","изгнало тебя",47,13],["أَهۡلَكۡنَٰهُمۡ","Мы погубили их",47,13],["فَلَا","и нет",47,13],["نَاصِرَ","помощника",47,13],["لَهُمۡ","у них",47,13],[13],["أَفَمَن","разве тот, кто",47,14],["كَانَ","находится",47,14],["عَلَىٰ","на",47,14],["بَيِّنَةٖ","ясном доказательстве",47,14]],[["مِّن","от",47,14],["رَّبِّهِۦ","своего Господа",47,14],["كَمَن","как тот",47,14],["زُيِّنَ","приукрашено",47,14],["لَهُۥ","для которого",47,14],["سُوٓءُ","зло",47,14],["عَمَلِهِۦ","его деяния",47,14],["وَٱتَّبَعُوٓاْ","и (которые) последовали",47,14],["أَهۡوَآءَهُم","своим страстям",47,14],[14],["مَّثَلُ","описание",47,15],["ٱلۡجَنَّةِ","Рая",47,15]],[["ٱلَّتِي","который",47,15],["وُعِدَ","обещан",47,15],["ٱلۡمُتَّقُونَۖ","богобоязненным",47,15],["فِيهَآ","в нём",47,15],["أَنۡهَٰرٞ","реки",47,15],["مِّن