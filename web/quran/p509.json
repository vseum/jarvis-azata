{"p":509,"j":26,"a":[[47,20,["وَيَقُولُ","ٱلَّذِينَ","ءَامَنُواْ","لَوۡلَا","نُزِّلَتۡ","سُورَةٞۖ","فَإِذَآ","أُنزِلَتۡ","سُورَةٞ","مُّحۡكَمَةٞ","وَذُكِرَ","فِيهَا","ٱلۡقِتَالُ","رَأَيۡتَ","ٱلَّذِينَ","فِي","قُلُوبِهِم","مَّرَضٞ","يَنظُرُونَ","إِلَيۡكَ","نَظَرَ","ٱلۡمَغۡشِيِّ","عَلَيۡهِ","مِنَ","ٱلۡمَوۡتِۖ","فَأَوۡلَىٰ","لَهُمۡ"],"вайаḳуулул лазиина амануу лаула нуззилат сууратун фа'иза унзилат сууратум мухкаматун вазукира фиихал ḳиталу ра'айтал лазиина фии ḳулуубихим марадун йанзурууна илайка назарал магшиййи `алайхи минал маути фа'аула лахум","Верующие говорят: «Почему не ниспослана сура о джихаде?». Когда же ясная сура, в которой упоминалось сражение, была ниспослана, ты увидел, что те, чьи сердца поражены недугом, смотрят на тебя взглядом потерявших сознание перед смертью. Для них предпочтительнее было бы",["и говорят","те, которые","уверовали","почему не","ниспослана","сура","но когда","ниспослана","сура","ясная","и упомянуто","в ней","сражение","ты увидел","тех, у которых","в","их сердцах","болезнь","смотрят","на тебя","взглядом","объятого","беспамятством","от","смерти","лучше же","для них"]],[47,21,["طَاعَةٞ","وَقَوۡلٞ","مَّعۡرُوفٞۚ","فَإِذَا","عَزَمَ","ٱلۡأَمۡرُ","فَلَوۡ","صَدَقُواْ","ٱللَّهَ","لَكَانَ","خَيۡرٗا","لَّهُمۡ"],"та`атун ваḳаулум ма`рууфун фа'иза `азамал амру фалау садаḳуллаха лакана хайрал лахум","повиноваться и говорить слово доброе. Если же дело решено, то для них лучше быть верными Аллаху.",["покорность","и слово","доброе","а когда","решено","дело","то если бы","они были верны","Аллаху","непременно было бы","лучше","для них"]],[47,22,["فَهَلۡ","عَسَيۡتُمۡ","إِن","تَوَلَّيۡتُمۡ","أَن","تُفۡسِدُواْ","فِي","ٱلۡأَرۡضِ","وَتُقَطِّعُوٓاْ","أَرۡحَامَكُمۡ"],"фахал `асайтум ин таваллайтум ан туфсидуу фил арди ватуḳатти`уу архамакум","Может быть, если вы станете руководить (или отвернетесь от веры; или откажетесь повиноваться), то распространите нечестие на земле и разорвете родственные связи.",["разве же","может быть, вы","если","придёте к власти","что","будете сеять порчу","на","земле","и разорвёте","ваши родственные связи"]],[47,23,["أُوْلَٰٓئِكَ","ٱلَّذِينَ","لَعَنَهُمُ","ٱللَّهُ","فَأَصَمَّهُمۡ","وَأَعۡمَىٰٓ","أَبۡصَٰرَهُمۡ"],"улаикал лазиина ла`анахумуллаху фа'асаммахум ва'а`ма абсарахум","Таких Аллах проклял и лишил слуха и ослепил их взоры.",["это","те, которые","проклял их","Аллах","и Он сделал их глухими","и ослепил","их взоры"]],[47,24,["أَفَلَا","يَتَدَبَّرُونَ","ٱلۡقُرۡءَانَ","أَمۡ","عَلَىٰ","قُلُوبٍ","أَقۡفَالُهَآ"],"афала йатадаббаруунал ḳур'ана ам `ала ḳулуубин аḳфалуха","Неужели они не размышляют над Кораном? Или же на их сердцах замки?",["разве же не","размышляют они","над Кораном","или","на","сердцах","их замки"]],[47,25,["إِنَّ","ٱلَّذِينَ","ٱرۡتَدُّواْ","عَلَىٰٓ","أَدۡبَٰرِهِم","مِّنۢ","بَعۡدِ","مَا","تَبَيَّنَ","لَهُمُ","ٱلۡهُدَى","ٱلشَّيۡطَٰنُ","سَوَّلَ","لَهُمۡ","وَأَمۡلَىٰ","لَهُمۡ"],"иннал лазиинартаддуу `ала адбарихим мим ба`ди ма табаййана лахумул худаш шайтану саввала лахум ва'амла лахум","Воистину, тех, которые обратились вспять после того, как им стал ясен прямой путь, дьявол обольстил и обещал им долгую жизнь.",["поистине","те, которые","обратились","на","свои спины (вспять)","из","после","того, как","стал ясен","им","прямой путь","шайтан","обольстил","их","и продлил (надежды)","им"]],[47,26,["ذَٰلِكَ","بِأَنَّهُمۡ","قَالُواْ","لِلَّذِينَ","كَرِهُواْ","مَا","نَزَّلَ","ٱللَّهُ","سَنُطِيعُكُمۡ","فِي","بَعۡضِ","ٱلۡأَمۡرِۖ","وَٱللَّهُ","يَعۡلَمُ","إِسۡرَارَهُمۡ"],"залика би'аннахум ḳалуу лиллазиина карихуу ма наззалаллаху санутии`укум фии ба`дил амри валлаху йа`ламу исрарахум","Это потому, что они сказали тем, которые возненавидели ниспосланное Аллахом: «Мы будем повиноваться вам в некоторых делах». Аллах знает то, что они скрывают.",["это","потому, что они","сказали","тем, которые","возненавидели","то, что","ниспослал","Аллах","мы будем повиноваться вам","в","некоторых","делах","и Аллах","знает","их тайны"]],[47,27,["فَكَيۡفَ","إِذَا","تَوَفَّتۡهُمُ","ٱلۡمَلَٰٓئِكَةُ","يَضۡرِبُونَ","وُجُوهَهُمۡ","وَأَدۡبَٰرَهُمۡ"],"факайфа иза таваффатхумул малаикату йадрибууна вужуухахум ва'адбарахум","Но что же будет, когда ангелы станут умерщвлять их, ударяя по их лицам и спинам?",["каково же (будет)","когда","умертвят их","ангелы","ударяя","по их лицам","и спинам"]],[47,28,["ذَٰلِكَ","بِأَنَّهُمُ","ٱتَّبَعُواْ","مَآ","أَسۡخَطَ","ٱللَّهَ","وَكَرِهُواْ","رِضۡوَٰنَهُۥ","فَأَحۡبَطَ","أَعۡمَٰلَهُمۡ"],"залика би'аннахумуттаба`уу ма асхаталлаха вакарихуу ридванахуу фа'ахбата а`малахум","Это - за то, что они последовали за тем, что вызвало ярость Аллаха, и возненавидели то, чем Он доволен, и поэтому Он сделал тщетными их деяния.",["это","потому, что они","последовали","за тем, что","разгневало","Аллаха","и возненавидели","Его довольство","и Он сделал тщетными","их деяния"]],[47,29,["أَمۡ","حَسِبَ","ٱلَّذِينَ","فِي","قُلُوبِهِم","مَّرَضٌ","أَن","لَّن","يُخۡرِجَ","ٱللَّهُ","أَضۡغَٰنَهُمۡ"],"ам хасибал лазиина фии ḳулуубихим марадун ал лан йухрижаллаху адганахум","Неужели те, чьи сердца поражены недугом, полагали, что Аллах не выведет наружу их злобу (или зависть)?",["или","полагали","те, у которых","в","их сердцах","болезнь","что","никогда не","выведет наружу","Аллах","их злобу"]]],"m":[[["وَيَقُولُ","и говорят",47,20],["ٱلَّذِينَ","те, которые",47,20],["ءَامَنُواْ","уверовали",47,20],["لَوۡلَا","почему не",47,20],["نُزِّلَتۡ","ниспослана",47,20],["سُورَةٞۖ","сура",47,20],["فَإِذَآ","но когда",47,20],["أُنزِلَتۡ","ниспослана",47,20],["سُورَةٞ","сура",47,20]],[["مُّحۡكَمَةٞ","ясная",47,20],["وَذُكِرَ","и упомянуто",47,20],["فِيهَا","в ней",47,20],["ٱلۡقِتَالُ","сражение",47,20],["رَأَيۡتَ","ты увидел",47,20],["ٱلَّذِينَ","тех, у которых",47,20],["فِي","в",47,20],["قُلُوبِهِم","их сердцах",47,20],["مَّرَضٞ","болезнь",47,20]],[["يَنظُرُونَ","смотрят",47,20],["إِلَيۡكَ","на тебя",47,20],["نَظَرَ","взглядом",47,20],["ٱلۡمَغۡشِيِّ","объятого",47,20],["عَلَيۡهِ","беспамятством",47,20],["مِنَ","от",47,20],["ٱلۡمَوۡتِۖ","смерти",47,20],["فَأَوۡلَىٰ","лучше же",47,20],["لَه