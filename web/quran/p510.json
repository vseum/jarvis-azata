{"p":510,"j":26,"a":[[47,30,["وَلَوۡ","نَشَآءُ","لَأَرَيۡنَٰكَهُمۡ","فَلَعَرَفۡتَهُم","بِسِيمَٰهُمۡۚ","وَلَتَعۡرِفَنَّهُمۡ","فِي","لَحۡنِ","ٱلۡقَوۡلِۚ","وَٱللَّهُ","يَعۡلَمُ","أَعۡمَٰلَكُمۡ"],"валау нашау ла'арайнакахум фала`арафтахум бисиимахум валата`рифаннахум фии лахнил ḳаули валлаху йа`ламу а`малакум","Если бы Мы пожелали, то показали бы их тебе, и тогда ты узнавал бы их по их приметам. Но ты непременно узнаешь их по оговоркам. Аллах знает о ваших деяниях.",["и если бы","Мы пожелали","Мы показали бы их тебе","и ты узнал бы их","по их приметам","и ты непременно узнаешь их","по","манере","речи","и Аллах","знает","ваши деяния"]],[47,31,["وَلَنَبۡلُوَنَّكُمۡ","حَتَّىٰ","نَعۡلَمَ","ٱلۡمُجَٰهِدِينَ","مِنكُمۡ","وَٱلصَّٰبِرِينَ","وَنَبۡلُوَاْ","أَخۡبَارَكُمۡ"],"валанаблуаннакум хатта на`ламал мужахидиина минкум вассабириина ванаблуа ахбаракум","Мы непременно подвергнем вас испытанию до тех пор, пока не узнаем тех из вас, кто сражается и проявляет терпение, и пока не проверим ваши вести.",["и Мы непременно испытаем вас","пока","не узнаем Мы","усердствующих","из вас","и терпеливых","и (не) проверим","ваши вести"]],[47,32,["إِنَّ","ٱلَّذِينَ","كَفَرُواْ","وَصَدُّواْ","عَن","سَبِيلِ","ٱللَّهِ","وَشَآقُّواْ","ٱلرَّسُولَ","مِنۢ","بَعۡدِ","مَا","تَبَيَّنَ","لَهُمُ","ٱلۡهُدَىٰ","لَن","يَضُرُّواْ","ٱللَّهَ","شَيۡـٔٗا","وَسَيُحۡبِطُ","أَعۡمَٰلَهُمۡ"],"иннал лазиина кафаруу васаддуу `ан сабиилиллахи вашаḳḳур расуула мим ба`ди ма табаййана лахумул худа лан йадурруллаха шай'ан васайухбиту а`малахум","Воистину, те, которые не уверовали, сбивали других с пути Аллаха и откололись от Посланника после того, как им стал ясен прямой путь, нисколько не навредят Аллаху, а Он сделает тщетными их деяния.",["поистине","те, которые","не уверовали","и отвращали","от","пути","Аллаха","и противились","Посланнику","после","того","как","стал ясен","им","прямой путь","никогда не","навредят они","Аллаху","ничем","и Он сделает тщетными","их деяния"]],[47,33,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُوٓاْ","أَطِيعُواْ","ٱللَّهَ","وَأَطِيعُواْ","ٱلرَّسُولَ","وَلَا","تُبۡطِلُوٓاْ","أَعۡمَٰلَكُمۡ"],"йа'аййухал лазиина амануу атии`уллаха ва'атии`ур расуула вала тубтилуу а`малакум","О те, которые уверовали! Повинуйтесь Аллаху, повинуйтесь Посланнику и не делайте тщетными ваши деяния.",["о","те, которые","уверовали","повинуйтесь","Аллаху","и повинуйтесь","Посланнику","и не","делайте тщетными","ваши деяния"]],[47,34,["إِنَّ","ٱلَّذِينَ","كَفَرُواْ","وَصَدُّواْ","عَن","سَبِيلِ","ٱللَّهِ","ثُمَّ","مَاتُواْ","وَهُمۡ","كُفَّارٞ","فَلَن","يَغۡفِرَ","ٱللَّهُ","لَهُمۡ"],"иннал лазиина кафаруу васаддуу `ан сабиилиллахи сумма матуу вахум куффарун фалан йагфираллаху лахум","Воистину, Аллах не простит тех, которые не уверовали и сбивали других с пути Аллаха, а потом умерли неверующими.",["поистине","те, которые","не уверовали","и отвращали","от","пути","Аллаха","затем","умерли","будучи они","неверующими","то никогда не","простит","Аллах","им"]],[47,35,["فَلَا","تَهِنُواْ","وَتَدۡعُوٓاْ","إِلَى","ٱلسَّلۡمِ","وَأَنتُمُ","ٱلۡأَعۡلَوۡنَ","وَٱللَّهُ","مَعَكُمۡ","وَلَن","يَتِرَكُمۡ","أَعۡمَٰلَكُمۡ"],"фала тахинуу ватад`уу илас салми ва'антумул а`лауна валлаху ма`акум валан йатиракум а`малакум","Не проявляйте слабости и не призывайте к миру, поскольку вы - выше остальных. Аллах - с вами и не умалит ваших деяний.",["так не","слабейте","и (не) призывайте","к","миру","ведь вы","высшие","и Аллах","с вами","и никогда не","умалит Он вам","ваших деяний"]],[47,36,["إِنَّمَا","ٱلۡحَيَوٰةُ","ٱلدُّنۡيَا","لَعِبٞ","وَلَهۡوٞۚ","وَإِن","تُؤۡمِنُواْ","وَتَتَّقُواْ","يُؤۡتِكُمۡ","أُجُورَكُمۡ","وَلَا","يَسۡـَٔلۡكُمۡ","أَمۡوَٰلَكُمۡ"],"иннамал хайаватуд дунйа ла`ибун валахвун ва'ин ту'минуу вататтаḳуу йу'тикум ужууракум вала йас'алкум амвалакум","Мирская жизнь - всего лишь игра и потеха. Если вы уверуете и будете богобоязненны, Он дарует вам вашу награду и не попросит у вас вашего имущества.",["лишь","жизнь","мирская","игра","и забава","и если","вы уверуете","и будете богобоязненны","Он даст вам","ваши награды","и не","попросит у вас","ваше имущество"]],[47,37,["إِن","يَسۡـَٔلۡكُمُوهَا","فَيُحۡفِكُمۡ","تَبۡخَلُواْ","وَيُخۡرِجۡ","أَضۡغَٰنَكُمۡ"],"ин йас'алкумууха файухфикум табхалуу вайухриж адганакум","Если же Он попросит у вас его и проявит настойчивость, то вы поскупитесь, и Он выведет наружу вашу злобу (или зависть).",["если","Он попросит у вас его","и будет настаивать","вы поскупитесь","и Он выведет","вашу злобу"]],[47,38,["هَٰٓأَنتُمۡ","هَٰٓؤُلَآءِ","تُدۡعَوۡنَ","لِتُنفِقُواْ","فِي","سَبِيلِ","ٱللَّهِ","فَمِنكُم","مَّن","يَبۡخَلُۖ","وَمَن","يَبۡخَلۡ","فَإِنَّمَا","يَبۡخَلُ","عَن","نَّفۡسِهِۦۚ","وَٱللَّهُ","ٱلۡغَنِيُّ","وَأَنتُمُ","ٱلۡفُقَرَآءُۚ","وَإِن","تَتَوَلَّوۡاْ","يَسۡتَبۡدِلۡ","قَوۡمًا","غَيۡرَكُمۡ","ثُمَّ","لَا","يَكُونُوٓاْ","أَمۡثَٰلَكُم"],"ха'антум ха'улаи туд`ауна литунфиḳуу фии сабиилиллахи фаминкум ман йабхалу ваман йабхал фа'иннама йабхалу `ан нафсихии валлахул ганиййу ва'антумул фуḳарау ва'ин татаваллау йастабдил ḳауман гайракум сумма ла йакуунуу амсалакум","Вот вас призывают делать пожертвования на пути Аллаха, и среди вас находятся такие, которые скупятся. Кто скупится, тот скупится только во вред себе. Аллах - богат, а вы - бедны. И если вы отвернетесь, Он заменит вас другими людьми, и они не будут подобны вам.",["вот вы","эти","вас призывают","чтобы вы расходовали","на","пути","Аллаха","и среди вас","тот, кто","скупится","а кто","скупится","то лишь","скупится","во вред","себе","и Аллах","Богатый","а вы","бедные","и если","вы отвернётесь","Он заменит","людьми","другими, чем вы","затем","не","будут они","подобными вам"]]],"m":[[["وَلَوۡ","и если бы",47,30],["نَشَآءُ","Мы пожелали",47,30],["لَأَرَيۡنَٰكَهُمۡ","Мы показали бы их тебе",47,30],["فَلَعَرَفۡتَهُم","и ты узнал бы их",47,30],["بِسِيمَٰهُمۡۚ","по их приметам",47,30],["وَلَتَعۡرِفَنَّهُمۡ","и ты непременно узнаешь их",47,30],["فِي","по",47,30]],[["لَحۡنِ","манере",47,30],["ٱلۡقَوۡلِۚ","речи",47,30],["وَٱللَّهُ","и Аллах",47,30],["يَعۡلَمُ","знает",47,30],["أَعۡمَٰلَكُمۡ","ваши деяния",47,30],[30],["وَلَنَبۡلُوَنَّكُمۡ","и Мы непременно испытаем вас",47,31],["حَتَّىٰ","пока",47,31],["نَعۡلَمَ","не узнаем Мы",47,31]],[["ٱلۡمُجَٰهِدِينَ","усердствующих",47,31],["مِنكُمۡ","из вас",47,31],["وَٱلصَّٰبِرِينَ","и терпеливых",47,31],["وَنَبۡلُوَاْ","и (не) проверим",47,31],["أَخۡبَارَكُمۡ","ваши вести",47,31],[31],["إِنَّ","поистине",47,32],["ٱلَّذِينَ","те, которые",47,32]],[["كَفَرُواْ","не уверовали",47,32],["وَصَدُّواْ","и отвращали",47,32],["عَن","от",47,32],["سَبِيلِ","пути",47,32],["ٱللَّهِ","Аллаха",47,32],["وَشَآقُّواْ","и противились",47,32],["ٱلرَّسُولَ","Посланнику",47,32],["مِنۢ","после",47,32],["بَعۡدِ","того",47,32],["مَا","как",47,32],["تَبَيَّنَ","стал ясен",47,32]],[["لَهُمُ","им",47,32],["ٱلۡهُدَىٰ","прямой путь",47,32],["لَن","никогда не",47,32],["يَضُرُّواْ","навредят они",47,32],["ٱللَّهَ","Аллаху",47,32],["شَيۡـٔٗا","ничем",47,32],["وَسَيُحۡبِطُ","и Он сделает тщетными",47,32],["أَعۡمَٰلَهُمۡ","их деяния",47,32],[32]],[["۞ يَٰٓأَيُّهَا","о",47,33],["ٱلَّذِينَ","те, которые",47,33],["ءَامَنُوٓاْ","уверовали",47,33],["أَطِيعُواْ","повинуйтесь",47,33],["ٱللَّهَ","Аллаху",47,33],["وَأَطِيعُواْ","и повинуйтесь",47,33],["ٱلرَّسُولَ","Посланнику",47,33],["وَلَا","и не",47,33],["تُبۡطِلُوٓاْ","делайте тщетными",47,33]],[["أَعۡمَٰلَكُمۡ","ваши деяния",47,33],[33],["إِنَّ","поистине",47,34],["ٱلَّذِينَ","те, которые",47,34],["كَفَرُواْ","не уверовали",47,34],["وَصَدُّواْ","и отвращали",47,34],["عَن","от",47,34],["سَبِيلِ","пути",47,34],["ٱللَّهِ","Аллаха",47,34],["ثُمَّ","затем",47,34],["مَاتُواْ","умерли",47,34]],[["وَهُمۡ","будучи они",47,34],["كُفَّارٞ","неверующими",47,34],["فَلَن","то никогда не",47,34],["يَغۡفِرَ","простит",47,34],["ٱللَّهُ","Аллах",47,34],["لَهُمۡ","им",47,34],[34],["فَلَا","так не",47,35],["تَهِنُواْ","слабейте",47,35],["وَتَدۡعُوٓاْ","и (не) призывайте",47,35],["إِلَى","к",47,35],["ٱلسَّلۡمِ","миру",47,35]],[["وَأَنتُمُ","ведь вы",47,35],["ٱلۡأَعۡلَوۡنَ","высшие",47,35],["وَٱللَّهُ","и Аллах",47,35],["مَعَكُمۡ","с вами",47,35],["وَلَن","и никогда не",47,35],["يَتِرَكُمۡ","умалит Он вам",47,35],["أَعۡمَٰلَكُمۡ","ваших деяний",47,35],[35],["إِنَّمَا","лишь",47,36]],[["ٱلۡحَيَوٰةُ","жизнь",47,36],["ٱلدُّنۡيَا","мирская",47,36],["لَعِبٞ","игра",47,36],["وَلَهۡوٞۚ","и забава",47,36],["وَإِن","и если",47,36],["تُؤۡمِنُواْ","вы уверуете",47,36],["وَتَتَّقُواْ","и будете богобоязненны",47,36],["يُؤۡتِكُمۡ","Он даст вам",47,36],["أُجُورَكُمۡ","ваши награды",47,36]],[["وَلَا","и не",47,36],["يَسۡـَٔلۡكُمۡ","попросит у вас",47,36],["أَمۡوَٰلَكُمۡ","ваше имущество",47,36],[36],["إِن","если",47,37],["يَسۡـَٔلۡكُمُوهَا","Он попросит у вас его",47,37],["فَيُحۡفِكُمۡ","и будет настаивать",47,37]],[["تَبۡخَلُواْ","вы поскупитесь",47,37],["وَيُخۡرِجۡ","и Он выведет",47,37],["أَضۡغَٰنَكُمۡ","вашу злобу",47,37],[37],["هَٰٓأَنتُمۡ","вот вы",47,38],["هَٰٓؤُلَآءِ","эти",47,38],["تُدۡعَوۡنَ","вас призывают",47,38]],[["لِتُنفِقُواْ","чтобы вы расходовали",47,38],["فِي","на",47,38],["سَبِيلِ","пути",47,38],["ٱللَّهِ","Аллаха",47,38],["فَمِنكُم","и среди вас",47,38],["مَّن","тот, кто",47,38],["يَبۡخَلُۖ","скупится",47,38],["وَمَن","а кто",47,38],["يَبۡخَلۡ","скупится",47,38]],[["فَإِنَّمَا","то лишь",47,38],["يَبۡخَلُ","скупится",47,38],["عَن","во вред",47,38],["نَّفۡسِهِۦۚ","себе",47,38],["وَٱللَّهُ","и Аллах",47,38],["ٱلۡغَنِيُّ","Богатый",47,38],["وَأَنتُمُ","а вы",47,38],["ٱلۡفُقَرَآءُۚ","бедные",47,38],["وَإِن","и если",47,38]],[["تَتَوَلَّوۡاْ","вы отвернётесь",47,38],["يَسۡتَبۡدِلۡ","Он заменит",47,38],["قَوۡمًا","людьми",47,38],["غَيۡرَكُمۡ","другими, чем вы",47,38],["ثُمَّ","затем",47,38],["لَا","не",47,38],["يَكُونُوٓاْ","будут они",47,38],["أَمۡثَٰلَكُم","подобными вам",47,38],[38]]]}