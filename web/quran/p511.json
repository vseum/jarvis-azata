{"p":511,"j":26,"a":[[48,1,["إِنَّا","فَتَحۡنَا","لَكَ","فَتۡحٗا","مُّبِينٗا"],"инна фатахна лака фатхам мубиина","Воистину, Мы даровали тебе явную победу,",["поистине, Мы","Мы даровали победу","тебе","победу","явную"]],[48,2,["لِّيَغۡفِرَ","لَكَ","ٱللَّهُ","مَا","تَقَدَّمَ","مِن","ذَنۢبِكَ","وَمَا","تَأَخَّرَ","وَيُتِمَّ","نِعۡمَتَهُۥ","عَلَيۡكَ","وَيَهۡدِيَكَ","صِرَٰطٗا","مُّسۡتَقِيمٗا"],"ллийагфира лакаллаху ма таḳаддама мин замбика вама та'аххара вайутимма ни`матахуу `алайка вайахдийака сиратам мустаḳиима","чтобы Аллах простил тебе грехи, которые были прежде и которые будут впоследствии, чтобы Он довел до конца Свою милость к тебе и провел тебя прямым путем",["чтобы простил","тебе","Аллах","то, что","предшествовало","из","твоих грехов","и то, что","последовало","и завершил","Свою милость","к тебе","и повёл тебя","путём","прямым"]],[48,3,["وَيَنصُرَكَ","ٱللَّهُ","نَصۡرًا","عَزِيزًا"],"вайансуракаллаху насран `азииза","и чтобы Аллах оказал тебе великую помощь.",["и чтобы помог тебе","Аллах","помощью","могучей"]],[48,4,["هُوَ","ٱلَّذِيٓ","أَنزَلَ","ٱلسَّكِينَةَ","فِي","قُلُوبِ","ٱلۡمُؤۡمِنِينَ","لِيَزۡدَادُوٓاْ","إِيمَٰنٗا","مَّعَ","إِيمَٰنِهِمۡۗ","وَلِلَّهِ","جُنُودُ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِۚ","وَكَانَ","ٱللَّهُ","عَلِيمًا","حَكِيمٗا"],"хуал лазии анзалас сакиината фии ḳулуубил му'миниина лийаздадуу ииманам ма`а ииманихим валиллахи жунуудус самавати вал'арди ваканаллаху `алииман хакиима","Он - Тот, Кто ниспослал покой в сердца верующих, чтобы их вера увеличилась. Аллаху принадлежит воинство небес и земли. Аллах - Знающий, Мудрый.",["Он","Тот, Кто","ниспослал","покой","в","сердца","верующих","чтобы увеличились они","верой","вместе с","их верой","и Аллаху принадлежат","воинства","небес","и земли","и есть","Аллах","Знающий","Мудрый"]],[48,5,["لِّيُدۡخِلَ","ٱلۡمُؤۡمِنِينَ","وَٱلۡمُؤۡمِنَٰتِ","جَنَّٰتٖ","تَجۡرِي","مِن","تَحۡتِهَا","ٱلۡأَنۡهَٰرُ","خَٰلِدِينَ","فِيهَا","وَيُكَفِّرَ","عَنۡهُمۡ","سَيِّـَٔاتِهِمۡۚ","وَكَانَ","ذَٰلِكَ","عِندَ","ٱللَّهِ","فَوۡزًا","عَظِيمٗا"],"ллийудхилал му'миниина валму'минати жаннатин тажрии мин тахтихал анхару халидиина фииха вайукаффира `анхум саййиатихим вакана залика `индаллахи фаузан `азиима","И чтобы ввести верующих мужчин и верующих женщин в Райские сады, в которых текут реки, где они пребудут вечно, и чтобы простить им их злодеяния. Это перед Аллахом является великим преуспеянием.",["чтобы ввёл Он","верующих мужчин","и верующих женщин","в сады","текут","из","под ними","реки","вечно пребывающими","в них","и избавил","от них","их злодеяния","и есть","это","у","Аллаха","успех","великий"]],[48,6,["وَيُعَذِّبَ","ٱلۡمُنَٰفِقِينَ","وَٱلۡمُنَٰفِقَٰتِ","وَٱلۡمُشۡرِكِينَ","وَٱلۡمُشۡرِكَٰتِ","ٱلظَّآنِّينَ","بِٱللَّهِ","ظَنَّ","ٱلسَّوۡءِۚ","عَلَيۡهِمۡ","دَآئِرَةُ","ٱلسَّوۡءِۖ","وَغَضِبَ","ٱللَّهُ","عَلَيۡهِمۡ","وَلَعَنَهُمۡ","وَأَعَدَّ","لَهُمۡ","جَهَنَّمَۖ","وَسَآءَتۡ","مَصِيرٗا"],"вайу`аззибал мунафиḳиина валмунафиḳати валмушрикиина валмушрикатиз занниина биллахи заннас сауи `алайхим даиратус сауи вагадибаллаху `алайхим вала`анахум ва'а`адда лахум жаханнама васаат масиира","И чтобы подвергнуть мучениям лицемеров и лицемерок, многобожников и многобожниц, думающих об Аллахе дурное. Их постигнут превратности судьбы. Аллах разгневался на них, проклял их и приготовил для них Геенну. Как же скверно это место прибытия!",["и чтобы наказал","лицемеров","и лицемерок","и многобожников","и многобожниц","думающих","об Аллахе","мнение","дурное","на них","превратность","зла","и разгневался","Аллах","на них","и проклял их","и приготовил","для них","Геенну","и скверна она","как место прибытия"]],[48,7,["وَلِلَّهِ","جُنُودُ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِۚ","وَكَانَ","ٱللَّهُ","عَزِيزًا","حَكِيمًا"],"валиллахи жунуудус самавати вал'арди ваканаллаху `азиизан хакиима","Аллаху принадлежит воинство небес и земли, и Аллах - Могущественный, Мудрый.",["и Аллаху принадлежат","воинства","небес","и земли","и есть","Аллах","Могущественный","Мудрый"]],[48,8,["إِنَّآ","أَرۡسَلۡنَٰكَ","شَٰهِدٗا","وَمُبَشِّرٗا","وَنَذِيرٗا"],"и