{"p":512,"j":26,"a":[[48,10,["إِنَّ","ٱلَّذِينَ","يُبَايِعُونَكَ","إِنَّمَا","يُبَايِعُونَ","ٱللَّهَ","يَدُ","ٱللَّهِ","فَوۡقَ","أَيۡدِيهِمۡۚ","فَمَن","نَّكَثَ","فَإِنَّمَا","يَنكُثُ","عَلَىٰ","نَفۡسِهِۦۖ","وَمَنۡ","أَوۡفَىٰ","بِمَا","عَٰهَدَ","عَلَيۡهُ","ٱللَّهَ","فَسَيُؤۡتِيهِ","أَجۡرًا","عَظِيمٗا"],"иннал лазиина йубайи`уунака иннама йубайи`ууналлаха йадуллахи фауḳа айдиихим фаман накаса фа'иннама йанкусу `ала нафсихии ваман ауфа бима `ахада `алайхуллаха фасайу'тиихи ажран `азиима","Воистину, те, которые присягают тебе, присягают Аллаху. Рука Аллаха - над их руками. Кто нарушил присягу, тот поступил во вред себе. А кто был верен тому, о чем он заключил завет с Аллахом, тому Он дарует великую награду.",["поистине","те, которые","присягают тебе","лишь","присягают","Аллаху","рука","Аллаха","над","их руками","и кто","нарушил","то лишь","нарушает","против","себя","а кто","исполнил","то, что","обязался","в том","перед Аллахом","то Он дарует ему","награду","великую"]],[48,11,["سَيَقُولُ","لَكَ","ٱلۡمُخَلَّفُونَ","مِنَ","ٱلۡأَعۡرَابِ","شَغَلَتۡنَآ","أَمۡوَٰلُنَا","وَأَهۡلُونَا","فَٱسۡتَغۡفِرۡ","لَنَاۚ","يَقُولُونَ","بِأَلۡسِنَتِهِم","مَّا","لَيۡسَ","فِي","قُلُوبِهِمۡۚ","قُلۡ","فَمَن","يَمۡلِكُ","لَكُم","مِّنَ","ٱللَّهِ","شَيۡـًٔا","إِنۡ","أَرَادَ","بِكُمۡ","ضَرًّا","أَوۡ","أَرَادَ","بِكُمۡ","نَفۡعَۢاۚ","بَلۡ","كَانَ","ٱللَّهُ","بِمَا","تَعۡمَلُونَ","خَبِيرَۢا"],"сайаḳуулу лакал мухаллафууна минал а`раби шагалатна амвалуна ва'ахлууна фастагфир лана йаḳуулууна би'алсинатихим ма лайса фии ḳулуубихим ḳул фаман йамлику лакум миналлахи шай'ан ин арада бикум дарран ау арада бикум наф`а бал каналлаху бима та`малууна хабиира","Бедуины, оставшиеся позади, скажут тебе: «Наше имущество и наши семьи отвлекли нас (или помешали нам). Попроси же для нас прощения». Они произносят своими языками то, чего нет в их сердцах. Скажи: «Кто властен помочь вам чем-нибудь перед Аллахом, если Он захочет навредить вам или захочет принести вам пользу?». О нет! Аллах ведает о том, что вы совершаете.",["скажут","тебе","оставшиеся позади","из","бедуинов","отвлекли нас","наше имущество","и наши семьи","так попроси прощения","для нас","говорят они","своими языками","то, чего","нет","в","их сердцах","скажи","так кто","властен","для вас","перед","Аллахом","хоть в чём-то","если","пожелает Он","вам","вреда","или","пожелает Он","вам","пользы","нет же","есть","Аллах","о том, что","вы делаете","Ведающий"]],[48,12,["بَلۡ","ظَنَنتُمۡ","أَن","لَّن","يَنقَلِبَ","ٱلرَّسُولُ","وَٱلۡمُؤۡمِنُونَ","إِلَىٰٓ","أَهۡلِيهِمۡ","أَبَدٗا","وَزُيِّنَ","ذَٰلِكَ","فِي","قُلُوبِكُمۡ","وَظَنَنتُمۡ","ظَنَّ","ٱلسَّوۡءِ","وَكُنتُمۡ","قَوۡمَۢا","بُورٗا"],"бал занантум ал лан йанḳалибар расуулу валму'минууна ила ахлиихим абадан вазуййина залика фии ḳулуубикум вазанантум заннас сауи вакунтум ḳаума буура","Но вы предположили, что Посланник и верующие никогда не вернутся к своим семьям. Это было разукрашено в ваших сердцах, и вы сделали дурные предположения. Вы были пропащими людьми.",["нет же","вы подумали","что","никогда не","вернётся","Посланник","и верующие","к","своим семьям","вовеки","и разукрашено было","это","в","ваших сердцах","и подумали вы","мысль","дурную","и были вы","людьми","погибшими"]],[48,13,["وَمَن","لَّمۡ","يُؤۡمِنۢ","بِٱللَّهِ","وَرَسُولِهِۦ","فَإِنَّآ","أَعۡتَدۡنَا","لِلۡكَٰفِرِينَ","سَعِيرٗا"],"вамал лам йу'мим биллахи варасуулихии фа'инна а`тадна лилкафириина са`иира","Если кто не уверует в Аллаха и Его Посланника, то ведь Мы приготовили неверующим Пламя.",["а кто","не","уверовал","в Аллаха","и Его Посланника","то поистине, Мы","Мы приготовили","для неверующих","Пламя"]],[48,14,["وَلِلَّهِ","مُلۡكُ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِۚ","يَغۡفِرُ","لِمَن","يَشَآءُ","وَيُعَذِّبُ","مَن","يَشَآءُۚ","وَكَانَ","ٱللَّهُ","غَفُورٗا","رَّحِيمٗا"],"валиллахи мулкус самавати вал'арди йагфиру лиман йашау вайу`аззибу ман йашау ваканаллаху гафуурар рахиима","Аллаху принадлежит власть над небесами и землей. Он прощает, кого пожелает, и причиняет мучения, кому пожелает. Аллах - Прощающий, Милосердный.",["и Аллаху принадлежит","власть","небес","и земли","Он прощает","кому","пожелает","и наказывает","кого","пожелает","и есть","Аллах","Прощающий","Милосердный"]],[48,15,["سَيَقُولُ","ٱلۡمُخَلَّفُونَ","إِذَا","ٱنطَلَقۡتُمۡ","إِلَىٰ","مَغَانِمَ","لِتَأۡخُذُوهَا","ذَرُونَا","نَتَّبِعۡكُمۡۖ","يُرِيدُونَ","أَن","يُبَدِّلُواْ","كَلَٰمَ","ٱللَّهِۚ","قُل","لَّن","تَتَّبِعُونَا","كَذَٰلِكُمۡ","قَالَ","ٱللَّهُ","مِن","قَبۡلُۖ","فَسَيَقُولُونَ","بَلۡ","تَحۡسُدُونَنَاۚ","بَلۡ","كَانُواْ","لَا","يَفۡقَهُونَ","إِلَّا","قَلِيلٗا"],"сайаḳуулул мухаллафууна изанталаḳтум ила маганима лита'хузууха зарууна наттаби`кум йуриидууна ан йубаддилуу каламаллахи ḳул лан таттаби`ууна казаликум ḳалаллаху мин ḳаблу фасайаḳуулууна бал тахсудуунана бал кануу ла йафḳахууна илла ḳалиила","Когда вы отправитесь за трофеями, чтобы взять их, оставшиеся позади скажут: «Дайте нам последовать за вами». Они хотят изменить Слово Аллаха. Скажи: «Вы не последуете за нами. Так сказал Аллах прежде». Тогда они скажут: «Нет, вы завидуете нам». Но они мало что смыслят.",["скажут","оставшиеся позади","когда","вы отправитесь","к","трофеям","чтобы взять их","оставьте нас","мы последуем за вами","хотят они","чтобы","изменить","слово","Аллаха","скажи","никогда не","последуете вы за нами","так","сказал","Аллах","из","прежде","и скажут они","нет же","вы завидуете нам","нет же","были они","не","понимают","кроме","немногого"]]],"m":[[["إِنَّ","поистине",48,10],["ٱلَّذِينَ","те, которые",48,10],["يُبَايِعُونَكَ","присягают тебе",48,10],["إِنَّمَا","лишь",48,10],["يُبَايِعُونَ","присягают",48,10],["ٱللَّهَ","Аллаху",48,10],["يَدُ","рука",48,10],["ٱللَّهِ","Аллаха",48,10],["فَوۡقَ","над",48,10],["أَيۡدِيهِمۡۚ","их руками",48,10]],[["فَمَن","и кто",48,10],["نَّكَثَ","нарушил",48,10],["فَإِنَّمَا","то лишь",48,10],["يَنكُثُ","нарушает",48,10],["عَلَىٰ","против",48,10],["نَفۡسِهِۦۖ","себя",48,10],["وَمَنۡ","а кто",48,10],["أَوۡفَىٰ","исполнил",48,10],["بِمَا","то, что",48,10],["عَٰهَدَ","обязался",48,10],["عَلَيۡهُ","в том",4