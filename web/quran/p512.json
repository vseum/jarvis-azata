],["فَإِنَّآ","то поистине, Мы",48,13]],[["أَعۡتَدۡنَا","Мы приготовили",48,13],["لِلۡكَٰفِرِينَ","для неверующих",48,13],["سَعِيرٗا","Пламя",48,13],[13],["وَلِلَّهِ","и Аллаху принадлежит",48,14],["مُلۡكُ","власть",48,14],["ٱلسَّمَٰوَٰتِ","небес",48,14],["وَٱلۡأَرۡضِۚ","и земли",48,14]],[["يَغۡفِرُ","Он прощает",48,14],["لِمَن","кому",48,14],["يَشَآءُ","пожелает",48,14],["وَيُعَذِّبُ","и наказывает",48,14],["مَن","кого",48,14],["يَشَآءُۚ","пожелает",48,14],["وَكَانَ","и есть",48,14],["ٱللَّهُ","Аллах",48,14],["غَفُورٗا","Прощающий",48,14]],[["رَّحِيمٗا","Милосердный",48,14],[14],["سَيَقُولُ","скажут",48,15],["ٱلۡمُخَلَّفُونَ","оставшиеся позади",48,15],["إِذَا","когда",48,15],["ٱنطَلَقۡتُمۡ","вы отправитесь",48,15],["إِلَىٰ","к",48,15]],[["مَغَانِمَ","трофеям",48,15],["لِتَأۡخُذُوهَا","чтобы взять их",48,15],["ذَرُونَا","оставьте нас",48,15],["نَتَّبِعۡكُمۡۖ","мы последуем за вами",48,15],["يُرِيدُونَ","хотят они",48,15],["أَن","чтобы",48,15],["يُبَدِّلُواْ","изменить",48,15]],[["كَلَٰمَ","слово",48,15],["ٱللَّهِۚ","Аллаха",48,15],["قُل","скажи",48,15],["لَّن","никогда не",48,15],["تَتَّبِعُونَا","последуете вы за нами",48,15],["كَذَٰلِكُمۡ","так",48,15],["قَالَ","сказал",48,15],["ٱللَّهُ","Аллах",48,15],["مِن","из",48,15],["قَبۡلُۖ","прежде",48,15]],[["فَسَيَقُولُونَ","и скажут они",48,15],["بَلۡ","нет же",48,15],["تَحۡسُدُونَنَاۚ","вы завидуете нам",48,15],["بَلۡ","нет же",48,15],["كَانُواْ","были они",48,15],["لَا","не",48,15],["يَفۡقَهُونَ","понимают",48,15],["إِلَّا","кроме",48,15],["قَلِيلٗا","немногого",48,15],[15]]]}