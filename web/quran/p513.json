{"p":513,"j":26,"a":[[48,16,["قُل","لِّلۡمُخَلَّفِينَ","مِنَ","ٱلۡأَعۡرَابِ","سَتُدۡعَوۡنَ","إِلَىٰ","قَوۡمٍ","أُوْلِي","بَأۡسٖ","شَدِيدٖ","تُقَٰتِلُونَهُمۡ","أَوۡ","يُسۡلِمُونَۖ","فَإِن","تُطِيعُواْ","يُؤۡتِكُمُ","ٱللَّهُ","أَجۡرًا","حَسَنٗاۖ","وَإِن","تَتَوَلَّوۡاْ","كَمَا","تَوَلَّيۡتُم","مِّن","قَبۡلُ","يُعَذِّبۡكُمۡ","عَذَابًا","أَلِيمٗا"],"ḳул лилмухаллафиина минал а`раби сатуд`ауна ила ḳаумин улии ба'син шадиидин туḳатилуунахум ау йуслимууна фа'ин тутии`уу йу'тикумуллаху ажран хасанан ва'ин татаваллау кама таваллайтум мин ḳаблу йу`аззибкум `азабан алиима","Скажи бедуинам, оставшимся позади: «Вас еще призовут воевать против людей, обладающих суровой мощью. Вы сразитесь с ними, или же они обратятся в ислам. Если вы подчинитесь, то Аллах дарует вам прекрасную награду. Если же вы отвернетесь, как отвернулись прежде, то Аллах причинит вам мучительные страдания».",["скажи","оставшимся позади","из","бедуинов","вас призовут","к","людям","обладающим","мощью","суровой","вы будете сражаться с ними","или","они покорятся","и если","вы повинуетесь","даст вам","Аллах","награду","прекрасную","а если","вы отвернётесь","как","отвернулись вы","из","прежде","Он накажет вас","наказанием","мучительным"]],[48,17,["لَّيۡسَ","عَلَى","ٱلۡأَعۡمَىٰ","حَرَجٞ","وَلَا","عَلَى","ٱلۡأَعۡرَجِ","حَرَجٞ","وَلَا","عَلَى","ٱلۡمَرِيضِ","حَرَجٞۗ","وَمَن","يُطِعِ","ٱللَّهَ","وَرَسُولَهُۥ","يُدۡخِلۡهُ","جَنَّٰتٖ","تَجۡرِي","مِن","تَحۡتِهَا","ٱلۡأَنۡهَٰرُۖ","وَمَن","يَتَوَلَّ","يُعَذِّبۡهُ","عَذَابًا","أَلِيمٗا"],"ллайса `алал а`ма харажун вала `алал а`ражи харажун вала `алал марииди харажун ваман йути`иллаха варасуулахуу йудхилху жаннатин тажрии мин тахтихал анхару ваман йатавалла йу`аззибху `азабан алиима","Нет греха на слепом, и нет греха на хромом, и нет греха на больном. Кто подчинится Аллаху и Его Посланнику, того Он введет в Райские сады, в которых текут реки. А кто отвернется, того Он подвергнет мучительным страданиям.",["нет","на","слепом","греха","и нет","на","хромом","греха","и нет","на","больном","греха","и кто","повинуется","Аллаху","и Его Посланнику","Он введёт его","в сады","текут","из","под ними","реки","а кто","отвернётся","Он накажет его","наказанием","мучительным"]],[48,18,["لَّقَدۡ","رَضِيَ","ٱللَّهُ","عَنِ","ٱلۡمُؤۡمِنِينَ","إِذۡ","يُبَايِعُونَكَ","تَحۡتَ","ٱلشَّجَرَةِ","فَعَلِمَ","مَا","فِي","قُلُوبِهِمۡ","فَأَنزَلَ","ٱلسَّكِينَةَ","عَلَيۡهِمۡ","وَأَثَٰبَهُمۡ","فَتۡحٗا","قَرِيبٗا"],"ллаḳад радийаллаху `анил му'миниина из йубайи`уунака тахташ шажарати фа`алима ма фии ḳулуубихим фа'анзалас сакиината `алайхим ва'асабахум фатхан ḳарииба","Аллах остался доволен верующими, когда они присягали тебе под деревом в Худейбии. Он знал, что у них в сердцах, и ниспослал им покой и вознаградил их близкой победой",["действительно","остался доволен","Аллах","(от)","верующими","когда","присягали они тебе","под","деревом","и Он знал","то, что","в","их сердцах","и ниспослал Он","покой","на них","и наградил их","победой","близкой"]],[48,19,["وَمَغَانِمَ","كَثِيرَةٗ","يَأۡخُذُونَهَاۗ","وَكَانَ","ٱللَّهُ","عَزِيزًا","حَكِيمٗا"],"вамаганима касииратан йа'хузуунаха ваканаллаху `азиизан хакиима","и многочисленными трофеями, которые они возьмут. Аллах - Могущественный, Мудрый.",["и трофеями","многочисленными","которые они возьмут","и есть","Аллах","Могущественный","Мудрый"]],[48,20,["وَعَدَكُمُ","ٱللَّهُ","مَغَانِمَ","كَثِيرَةٗ","تَأۡخُذُونَهَا","فَعَجَّلَ","لَكُمۡ","هَٰذِهِۦ","وَكَفَّ","أَيۡدِيَ","ٱلنَّاسِ","عَنكُمۡ","وَلِتَكُونَ","ءَايَةٗ","لِّلۡمُؤۡمِنِينَ","وَيَهۡدِيَكُمۡ","صِرَٰطٗا","مُّسۡتَقِيمٗا"],"ва`адакумуллаху маганима касииратан та'хузуунаха фа`ажжала лакум хазихии вакаффа айдийан наси `анкум валитакууна айатал лилму'миниина вайахдийакум сиратам мустаḳиима","Аллах обещал вам многочисленные трофеи, которые вы возьмете. Он ускорил для вас это и убрал от вас руки людей, чтобы это стало знамением для верующих и чтобы наставить вас на прямой путь.",["обещал вам","Аллах","трофеи","многочисленные","которые вы возьмёте","и ускорил Он","для вас","это","и удержал","руки","людей","от вас","и чтобы стало это","знамением","для верующих","и повёл вас","путём","прямым"]],[48,21,["وَأُخۡرَىٰ","لَمۡ","تَقۡدِرُواْ","عَلَيۡهَا","قَدۡ","أَحَاطَ","ٱللَّهُ","بِهَاۚ","وَكَانَ","ٱللَّهُ","عَلَىٰ","كُلِّ","شَيۡءٖ","قَدِيرٗا"],"ва'ухра лам таḳдируу `алайха ḳад ахаталлаху биха ваканаллаху `ала кулли шай'ин ḳадиира","Будут и другие трофеи и города, которыми вы еще не овладели. Аллах уже окружил их, ведь Аллах способен на всякую вещь.",["и другие","не","смогли вы","овладеть ими","уже","объял","Аллах","их","и есть","Аллах","над","всякой","вещью","Всемогущий"]],[48,22,["وَلَوۡ","قَٰتَلَكُمُ","ٱلَّذِينَ","كَفَرُواْ","لَوَلَّوُاْ","ٱلۡأَدۡبَٰرَ","ثُمَّ","لَا","يَجِدُونَ","وَلِيّٗا","وَلَا","نَصِيرٗا"],"валау ḳаталакумул лазиина кафаруу лаваллавул адбара сумма ла йажидууна валиййан вала насиира","Если неверующие сразятся с вами, то они непременно обратятся вспять и затем не найдут ни покровителя, ни помощника.",["и если бы","сразились с вами","те, которые","не уверовали","непременно обратили бы они","спины","затем","не","найдут они","покровителя","и не","помощника"]],[48,23,["سُنَّةَ","ٱللَّهِ","ٱلَّتِي","قَدۡ","خَلَتۡ","مِن","قَبۡلُۖ","وَلَن","تَجِدَ","لِسُنَّةِ","ٱللَّهِ","تَبۡدِيلٗا"],"суннаталлахил латии ḳад халат мин ḳаблу валан тажида лисуннатиллахи табдиила","Таково установление Аллаха, которое уже свершалось ранее, и ты не найдешь замены установлению Аллаха.",["установление","Аллаха","которое","уже","прошло","из","прежде","и никогда не","найдёшь ты","для установления","Аллаха","замены"]]],"m":[[["قُل","скажи",48,16],["لِّلۡمُخَلَّفِينَ","оставшимся позади",48,16],["مِنَ","из",48,16],["ٱلۡأَعۡرَابِ","бедуинов",48,16],["سَتُدۡعَوۡنَ","вас призовут",48,16],["إِلَىٰ","к",48,16],["قَوۡمٍ","людям",48,16],["أُوْلِي","обладающим",48,16],["بَأۡسٖ","мощью",48,16],["شَدِيدٖ","суровой",48,16]],[["تُقَٰتِلُونَهُمۡ","вы будете сражаться с ними",48,16],["أَوۡ","или",48,16],["يُسۡلِمُونَۖ","они покорятся",48,16],["فَإِن","и если",48,16],["تُطِيعُواْ","вы по