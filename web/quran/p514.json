{"p":514,"j":26,"a":[[48,24,["وَهُوَ","ٱلَّذِي","كَفَّ","أَيۡدِيَهُمۡ","عَنكُمۡ","وَأَيۡدِيَكُمۡ","عَنۡهُم","بِبَطۡنِ","مَكَّةَ","مِنۢ","بَعۡدِ","أَنۡ","أَظۡفَرَكُمۡ","عَلَيۡهِمۡۚ","وَكَانَ","ٱللَّهُ","بِمَا","تَعۡمَلُونَ","بَصِيرًا"],"вахуал лазии каффа айдийахум `анкум ва'айдийакум `анхум бибатни макката мим ба`ди ан азфаракум `алайхим ваканаллаху бима та`малууна басиира","Он - Тот, Кто убрал их руки от вас и ваши руки от них в долине Мекки после того, как Он позволил вам одержать над ними верх. Аллах видит то, что вы совершаете.",["и Он","Тот, Кто","удержал","их руки","от вас","и ваши руки","от них","в долине","Мекки","после","того","как","Он дал вам победу","над ними","и есть","Аллах","то, что","вы делаете","Видящий"]],[48,25,["هُمُ","ٱلَّذِينَ","كَفَرُواْ","وَصَدُّوكُمۡ","عَنِ","ٱلۡمَسۡجِدِ","ٱلۡحَرَامِ","وَٱلۡهَدۡيَ","مَعۡكُوفًا","أَن","يَبۡلُغَ","مَحِلَّهُۥۚ","وَلَوۡلَا","رِجَالٞ","مُّؤۡمِنُونَ","وَنِسَآءٞ","مُّؤۡمِنَٰتٞ","لَّمۡ","تَعۡلَمُوهُمۡ","أَن","تَطَـُٔوهُمۡ","فَتُصِيبَكُم","مِّنۡهُم","مَّعَرَّةُۢ","بِغَيۡرِ","عِلۡمٖۖ","لِّيُدۡخِلَ","ٱللَّهُ","فِي","رَحۡمَتِهِۦ","مَن","يَشَآءُۚ","لَوۡ","تَزَيَّلُواْ","لَعَذَّبۡنَا","ٱلَّذِينَ","كَفَرُواْ","مِنۡهُمۡ","عَذَابًا","أَلِيمًا"],"хумул лазиина кафаруу васаддуукум `анил масжидил харами валхадйа ма`кууфан ан йаблуга махиллахуу валаула рижалум му'минууна ванисаум му'минатул лам та`ламуухум ан татауухум фатусиибакум минхум ма`аррату бигайри `илмил лийудхилаллаху фии рахматихии ман йашау лау тазаййалуу ла`аззабнал лазиина кафаруу минхум `азабан алиима","Они - те, которые не уверовали, не впустили вас в Заповедную мечеть и задержали жертвенных животных, не позволив им достичь места заклания. И если бы в Мекке не было верующих мужчин и верующих женщин, которых вы не знали и могли затоптать по незнанию так, что они поставили бы вас в затруднительное положение (или вы бы оказались опозорены перед ними; или вы совершили бы грех перед ними), то Аллах позволил бы вам вторгнуться в Мекку, но Он не сделал этого, чтобы ввести в Свою милость тех, кого пожелает. Но если бы они отделились друг от друга, то Мы подвергли бы неверующих из них мучительным страданиям.",["они","те, которые","не уверовали","и отвратили вас","от","мечети","Заповедной","и жертвенных животных","задержанных","от того, чтобы","достигли","места их заклания","и если бы не","мужчины","верующие","и женщины","верующие","не","знали вы их","что","вы растопчете их","и постигло бы вас","из-за них","бесчестье","без","знания","чтобы ввёл","Аллах","в","Свою милость","кого","пожелает","если бы","они разделились","непременно наказали бы Мы","тех, которые","не уверовали","из них","наказанием","мучительным"]],[48,26,["إِذۡ","جَعَلَ","ٱلَّذِينَ","كَفَرُواْ","فِي","قُلُوبِهِمُ","ٱلۡحَمِيَّةَ","حَمِيَّةَ","ٱلۡجَٰهِلِيَّةِ","فَأَنزَلَ","ٱللَّهُ","سَكِينَتَهُۥ","عَلَىٰ","رَسُولِهِۦ","وَعَلَى","ٱلۡمُؤۡمِنِينَ","وَأَلۡزَمَهُمۡ","كَلِمَةَ","ٱلتَّقۡوَىٰ","وَكَانُوٓاْ","أَحَقَّ","بِهَا","وَأَهۡلَهَاۚ","وَكَانَ","ٱللَّهُ","بِكُلِّ","شَيۡءٍ","عَلِيمٗا"],"из жа`алал лазиина кафаруу фии ḳулуубихимул хамиййата хамиййатал жахилиййати фа'анзалаллаху сакиинатахуу `ала расуулихии ва`алал му'миниина ва'алзамахум калиматат таḳва вакануу ахаḳḳа биха ва'ахлаха ваканаллаху бикулли шай'ин `алиима","Вот неверующие поместили в своих сердцах заносчивость - заносчивость времен невежества, а Аллах ниспослал Своему Посланнику и верующим покой и возложил на них (или сделал неразлучным с ними) слово богобоязненности (свидетельство о том, что нет божества, кроме Аллаха). Они заслуживали его более других и были достойны его. Аллах же знает о всякой вещи.",["когда","поместили","те, которые","не уверовали","в","свои сердца","заносчивость","заносчивость","невежества","и ниспослал","Аллах","Свой покой","на","Своего Посланника","и на","верующих","и обязал их","словом","богобоязненности","и были они","достойнее","его","и обладателями его","и есть","Аллах","о всякой","вещи","Знающий"]],[48,27,["لَّقَدۡ","صَدَقَ","ٱللَّهُ","رَسُولَهُ","ٱلرُّءۡيَا","بِٱلۡحَقِّۖ","لَتَدۡخُلُنَّ","ٱلۡمَسۡجِدَ","ٱلۡحَرَامَ","إِن","شَآءَ","ٱللَّهُ","ءَامِنِينَ","مُحَلِّقِينَ","رُءُوسَكُمۡ","وَمُقَصِّرِينَ","لَا","تَخَافُونَۖ","فَعَلِمَ","مَا","لَمۡ","تَعۡلَمُواْ","فَجَعَلَ","مِن","دُونِ","ذَٰلِكَ","فَتۡحٗا","قَرِيبًا"],"ллаḳад садаḳаллаху расуулахур ру'йа билхаḳḳи латадхулуннал масжидал харама ин шааллаху аминиина мухаллиḳиина ру'уусакум вамуḳассириина ла тахафууна фа`алима ма лам та`ламуу фажа`ала мин дууни залика фатхан ḳарииба","Воистину, Аллах показал Своему Посланнику правдивый сон (или Аллах доподлинно исполнит сон, который увидел Его Посланник). Вы непременно войдете в Заповедную мечеть, если пожелает Аллах, будучи в безопасности. Вы побреете головы и подстрижетесь, не испытывая страха. Он знал то, чего вы не знали, и предопределил перед этим близкую победу.",["действительно","сделал правдивым","Аллах","Своему Посланнику","сон","по истине","непременно войдёте вы","в мечеть","Заповедную","если","пожелает","Аллах","в безопасности","обрив","ваши головы","и подстригши","не","боясь","и знал Он","то, что","не","знали вы","и сделал Он","ещё","до","этого","победу","близкую"]],[48,28,["هُوَ","ٱلَّذِيٓ","أَرۡسَلَ","رَسُولَهُۥ","بِٱلۡهُدَىٰ","وَدِينِ","ٱلۡحَقِّ","لِيُظۡهِرَهُۥ","عَلَى","ٱلدِّينِ","كُلِّهِۦۚ","وَكَفَىٰ","بِٱللَّهِ","شَهِيدٗا"],"хуал лазии арсала расуулахуу билхуда вадиинил хаḳḳи лийузхирахуу `алад диини куллихии вакафа биллахи шахиида","Он - Тот, Кто отправил Своего Посланника с верным руководством и религией истины, чтобы превознести ее над всеми остальными религиями. Довольно того, что Аллах является Свидетелем.",["Он","Тот, Который","отправил","Своего Посланника","с руководством","и религией","истины","чтобы возвысить её","над","религиями","всеми","и достаточно","Аллаха","Свидетелем"]]],"m":[[["وَهُوَ","и Он",48,24],["ٱلَّذِي","Тот, Кто",48,24],["كَفَّ","удержал",48,24],["أَيۡدِيَهُمۡ","их руки",48,24],["عَنكُمۡ","от вас",48,24],["وَأَيۡدِيَكُمۡ","и ваши руки",48,24],["عَنۡهُم","от них",48,24],["بِبَطۡنِ","в долине",48,24],["مَكَّةَ","Мекки",48,24],["مِنۢ","после",48,24]],[["بَعۡدِ","того",48,24],["أَنۡ","как",48,24],["أَظۡفَرَكُمۡ","Он дал вам победу",48,24],["عَلَيۡهِمۡۚ","над ними",48,24],["وَكَانَ","и есть",48,24],["ٱللَّهُ","Аллах",48,24],["بِمَا","то, что",48,24],["تَعۡمَلُونَ","вы делаете",48,24],["بَصِيرًا","Видящий",48,24],[24],["هُمُ","они",48,25]],[["ٱلَّذِينَ","те, которые",48,25],["كَفَرُواْ","не уверовали",48,25],["وَصَدُّوكُمۡ","и отвратили вас",48,25],["عَنِ","от",48,25],["ٱلۡمَسۡجِدِ","мечети",48,25],["ٱلۡحَرَامِ","Заповедной",48,25],["وَٱلۡهَدۡيَ","и жертвенных животных",48,25]],[["مَعۡكُوفًا","задержанных",48,25],["أَن","от того, чтобы",48,25],["يَبۡلُغَ","достигли",48,25],["مَحِلَّهُۥۚ","места их заклания",48,25],["وَلَوۡلَا","и если бы не",48,25],["رِجَالٞ","мужчины",48,25],["مُّؤۡمِنُونَ","верующие",48,25],["وَنِسَآءٞ","и женщины",48,25],["مُّؤۡمِنَٰتٞ","верующие",48,25]],[["لَّمۡ","не",48,25],["تَعۡلَمُوهُمۡ","знали вы их",48,25],["أَن","что",48,25],["تَطَـُٔوهُمۡ","вы растопчете их",48,25],["فَتُصِيبَكُم","и постигло бы вас",48,25],["مِّنۡهُم","из-за них",48,25],["مَّعَرَّةُۢ","бесчестье",48,25],["بِغَيۡرِ","без",48,25],["عِلۡمٖۖ","знания",48,25]],[["لِّيُدۡخِلَ","чтобы ввёл",48,25],["ٱللَّهُ","Аллах",48,25],["فِي","в",48,25],["رَحۡمَتِهِۦ","Свою милость",48,25],["مَن","кого",48,25],["يَشَآءُۚ","пожелает",48,25],["لَوۡ","если бы",48,25],["تَزَيَّلُواْ","они разделились",48,25],["لَعَذَّبۡنَا","непременно наказали бы Мы",48,25],["ٱلَّذِينَ","тех, которые",48,25]],[["كَفَرُواْ","не уверовали",48,25],["مِنۡهُمۡ","из них",48,25],["عَذَابًا","наказанием",48,25],["أَلِيمًا","мучительным",48,25],[25],["إِذۡ","когда",48,26],["جَعَلَ","поместили",48,26],["ٱلَّذِينَ","те, которые",48,26],["كَفَرُواْ","не уверовали",48,26]],[["فِي","в",48,26],["قُلُوبِهِمُ","свои сердца",48,26],["ٱلۡحَمِيَّةَ","заносчивость",48,26],["حَمِيَّةَ","заносчивость",48,26],["ٱلۡجَٰهِلِيَّةِ","невежества",48,26],["فَأَنزَلَ","и ниспослал",48,26],["ٱللَّهُ","Аллах",48,26],["سَكِينَتَهُۥ","Свой покой",48,26]],[["عَلَىٰ","на",48,26],["رَسُولِهِۦ","Своего Посланника",48,26],["وَعَلَى","и на",48,26],["ٱلۡمُؤۡمِنِينَ","верующих",48,26],["وَأَلۡزَمَهُمۡ","и обязал их",48,26],["كَلِمَةَ","словом",48,26],["ٱلتَّقۡوَىٰ","богобоязненности",48,26]],[["وَكَانُوٓاْ","и были они",48,26],["أَحَقَّ","достойнее",48,26],["بِهَا","его",48,26],["وَأَهۡلَهَاۚ","и обладателями его",48,26],["وَكَانَ","и есть",48,26],["ٱللَّهُ","Аллах",48,26],["بِكُلِّ","о всякой",48,26],["شَيۡءٍ","вещи",48,26],["عَلِيمٗا","Знающий",48,26],[26]],[["لَّقَدۡ","действительно",48,27],["صَدَقَ","сделал правдивым",48,27],["ٱللَّهُ","Аллах",48,27],["رَسُولَهُ","Своему Посланнику",48,27],["ٱلرُّءۡيَا","сон",48,27],["بِٱلۡحَقِّۖ","по истине",48,27],["لَتَدۡخُلُنَّ","непременно войдёте вы",48,27],["ٱلۡمَسۡجِدَ","в мечеть",48,27]],[["ٱلۡحَرَامَ","Заповедную",48,27],["إِن","если",48,27],["شَآءَ","пожелает",48,27],["ٱللَّهُ","Аллах",48,27],["ءَامِنِينَ","в безопасности",48,27],["مُحَلِّقِينَ","обрив",48,27],["رُءُوسَكُمۡ","ваши головы",48,27],["وَمُقَصِّرِينَ","и подстригши",48,27]],[["لَا","не",48,27],["تَخَافُونَۖ","боясь",48,27],["فَعَلِمَ","и знал Он",48,27],["مَا","то, что",48,27],["لَمۡ","не",48,27],["تَعۡلَمُواْ","знали вы",48,27],["فَجَعَلَ","и сделал Он",48,27],["مِن","ещё",48,27],["دُونِ","до",48,27],["ذَٰلِكَ","этого",48,27]],[["فَتۡحٗا","победу",48,27],["قَرِيبًا","близкую",48,27],[27],["هُوَ","Он",48,28],["ٱلَّذِيٓ","Тот, Который",48,28],["أَرۡسَلَ","отправил",48,28],["رَسُولَهُۥ","Своего Посланника",48,28],["بِٱلۡهُدَىٰ","с руководством",48,28],["وَدِينِ","и религией",48,28]],[["ٱلۡحَقِّ","истины",48,28],["لِيُظۡهِرَهُۥ","чтобы возвысить её",48,28],["عَلَى","над",48,28],["ٱلدِّينِ","религиями",48,28],["كُلِّهِۦۚ","всеми",48,28],["وَكَفَىٰ","и достаточно",48,28],["بِٱللَّهِ","Аллаха",48,28],["شَهِيدٗا","Свидетелем",48,28],[28]]]}