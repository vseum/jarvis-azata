{"p":516,"j":26,"a":[[49,5,["وَلَوۡ","أَنَّهُمۡ","صَبَرُواْ","حَتَّىٰ","تَخۡرُجَ","إِلَيۡهِمۡ","لَكَانَ","خَيۡرٗا","لَّهُمۡۚ","وَٱللَّهُ","غَفُورٞ","رَّحِيمٞ"],"валау аннахум сабаруу хатта тахружа илайхим лакана хайрал лахум валлаху гафуурур рахиим","Если бы они потерпели, пока ты выйдешь к ним, это было бы лучше для них. Аллах - Прощающий, Милосердный.",["и если бы","они","потерпели","пока","ты выйдешь","к ним","то было бы","лучше","для них","и Аллах","Прощающий","Милосердный"]],[49,6,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُوٓاْ","إِن","جَآءَكُمۡ","فَاسِقُۢ","بِنَبَإٖ","فَتَبَيَّنُوٓاْ","أَن","تُصِيبُواْ","قَوۡمَۢا","بِجَهَٰلَةٖ","فَتُصۡبِحُواْ","عَلَىٰ","مَا","فَعَلۡتُمۡ","نَٰدِمِينَ"],"йа'аййухал лазиина амануу ин жаакум фасиḳу бинабаин фатабаййануу ан тусиибуу ḳаума бижахалатин фатусбихуу `ала ма фа`алтум надимиин","О те, которые уверовали! Если нечестивец принесет вам весть, то разузнайте, чтобы не поразить по незнанию невинных людей, а не то вы будете сожалеть о содеянном.",["о","те, которые","уверовали","если","придёт к вам","нечестивец","с вестью","то выясняйте","чтобы не","поразили вы","людей","по незнанию","и станете вы","о","том, что","сделали вы","сожалеющими"]],[49,7,["وَٱعۡلَمُوٓاْ","أَنَّ","فِيكُمۡ","رَسُولَ","ٱللَّهِۚ","لَوۡ","يُطِيعُكُمۡ","فِي","كَثِيرٖ","مِّنَ","ٱلۡأَمۡرِ","لَعَنِتُّمۡ","وَلَٰكِنَّ","ٱللَّهَ","حَبَّبَ","إِلَيۡكُمُ","ٱلۡإِيمَٰنَ","وَزَيَّنَهُۥ","فِي","قُلُوبِكُمۡ","وَكَرَّهَ","إِلَيۡكُمُ","ٱلۡكُفۡرَ","وَٱلۡفُسُوقَ","وَٱلۡعِصۡيَانَۚ","أُوْلَٰٓئِكَ","هُمُ","ٱلرَّٰشِدُونَ"],"ва`ламуу анна фиикум расуулаллахи лау йутии`укум фии касиирим минал амри ла`аниттум валакинналлаха хаббаба илайкумул иимана вазаййанахуу фии ḳулуубикум вакарраха илайкумул куфра валфусууḳа вал`исйана улаика хумур рашидуун","Знайте, что среди вас находится Посланник Аллаха. Если бы он подчинялся вам во многих делах, то вы непременно попали бы в затруднительное положение. Но Аллах привил вам любовь к вере, и представил ее прекрасной вашим сердцам, и сделал ненавистными вам неверие, нечестие и неповиновение. Таковы идущие правым путем",["и знайте","что","среди вас","Посланник","Аллаха","если бы","он повиновался вам","в","многом","из","дела","непременно пострадали бы вы","но","Аллах","сделал любимой","вам","веру","и украсил её","в","сердцах ваших","и сделал ненавистным","вам","неверие","и нечестие","и ослушание","те","они","идущие прямо"]],[49,8,["فَضۡلٗا","مِّنَ","ٱللَّهِ","وَنِعۡمَةٗۚ","وَٱللَّهُ","عَلِيمٌ","حَكِيمٞ"],"фадлам миналлахи вани`матан валлаху `алиимун хакиим","по милосердию и милости Аллаха. Аллах - Знающий, Мудрый.",["милостью","от","Аллаха","и благом","и Аллах","Знающий","Мудрый"]],[49,9,["وَإِن","طَآئِفَتَانِ","مِنَ","ٱلۡمُؤۡمِنِينَ","ٱقۡتَتَلُواْ","فَأَصۡلِحُواْ","بَيۡنَهُمَاۖ","فَإِنۢ","بَغَتۡ","إِحۡدَىٰهُمَا","عَلَى","ٱلۡأُخۡرَىٰ","فَقَٰتِلُواْ","ٱلَّتِي","تَبۡغِي","حَتَّىٰ","تَفِيٓءَ","إِلَىٰٓ","أَمۡرِ","ٱللَّهِۚ","فَإِن","فَآءَتۡ","فَأَصۡلِحُواْ","بَيۡنَهُمَا","بِٱلۡعَدۡلِ","وَأَقۡسِطُوٓاْۖ","إِنَّ","ٱللَّهَ","يُحِبُّ","ٱلۡمُقۡسِطِينَ"],"ва'ин таифатани минал му'миниинаḳтаталуу фа'аслихуу байнахума фа'им багат ихдахума `алал ухра фаḳатилул латии табгии хатта тафииа ила амриллахи фа'ин фаат фа'аслихуу байнахума бил`адли ва'аḳситуу инналлаха йухиббул муḳситиин","Если две группы верующих сражаются между собой, то примирите их. Если же одна из них притесняет на другую, то сражайтесь против той, которая притесняет, пока она не вернется к повелению Аллаха. Когда же она вернется, то примирите их по справедливости и будьте беспристрастны. Воистину, Аллах любит беспристрастных.",["и если","две группы","из","верующих","сразятся","то примирите","между ними","если же","притеснит","одна из них","против","другой","то сражайтесь","с той, которая","притесняет","пока","не вернётся она","к","повелению","Аллаха","и если","вернётся она","то примирите","между ними","по справедливости","и будьте беспристрастны","поистине","Аллах","любит","беспристрастных"]],[49,10,["إِنَّمَا","ٱلۡمُؤۡمِنُونَ","إِخۡوَةٞ","فَأَصۡلِحُواْ","بَيۡنَ","أَخَوَيۡكُمۡۚ","وَٱتَّقُواْ","ٱللَّهَ","لَعَلَّكُمۡ","تُرۡحَمُونَ"],"иннамал му'минууна ихватун фа'аслихуу байна ахавайкум ваттаḳуллаха ла`аллакум турхамуун","Воистину, верующие - братья. Посему примиряйте братьев и бойтесь Аллаха, - быть может, вы будете помилованы.",["лишь","верующие","братья","так примиряйте","между","двумя братьями вашими","и бойтесь","Аллаха","быть может, вы","будете помилованы"]],[49,11,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُواْ","لَا","يَسۡخَرۡ","قَوۡمٞ","مِّن","قَوۡمٍ","عَسَىٰٓ","أَن","يَكُونُواْ","خَيۡرٗا","مِّنۡهُمۡ","وَلَا","نِسَآءٞ","مِّن","نِّسَآءٍ","عَسَىٰٓ","أَن","يَكُنَّ","خَيۡرٗا","مِّنۡهُنَّۖ","وَلَا","تَلۡمِزُوٓاْ","أَنفُسَكُمۡ","وَلَا","تَنَابَزُواْ","بِٱلۡأَلۡقَٰبِۖ","بِئۡسَ","ٱلِٱسۡمُ","ٱلۡفُسُوقُ","بَعۡدَ","ٱلۡإِيمَٰنِۚ","وَمَن","لَّمۡ","يَتُبۡ","فَأُوْلَٰٓئِكَ","هُمُ","ٱلظَّٰلِمُونَ"],"йа'аййухал лазиина амануу ла йасхар ḳаумум мин ḳаумин `аса ан йакуунуу хайрам минхум вала нисаум мин нисаин `аса ан йакунна хайрам минхунна вала талмизуу анфусакум вала танабазуу бил'алḳаби би'сал исмул фусууḳу ба`дал иимани вамал лам йатуб фа'улаика хумуз залимуун","О те, которые уверовали! Пусть одни люди не насмехаются над другими, ведь может быть, что те лучше них. И пусть одни женщины не насмехаются над другими женщинами, ведь может быть, что те лучше них. Не обижайте самих себя (друг друга) и не называйте друг друга оскорбительными прозвищами. Скверно называться нечестивцем после того, как уверовал. А те, которые не раскаются, окажутся беззаконниками.",["о","те, которые","уверовали","пусть не","насмехаются","люди","над","людьми","может быть","что","будут они","лучше","чем они","и не","женщины","над","женщинами","может быть","что","будут они","лучше","чем они","и не","порочьте","самих себя","и не","называйте друг друга","прозвищами","скверно","имя","нечестие","после","веры","и кто","не","покается","то те","они","беззаконники"]]],"m":[[["وَلَوۡ","и если бы",49,5],["أَنَّهُمۡ","они",49,5],["صَبَرُواْ","потерпели",49,5],["حَتَّىٰ","пока",49,5],