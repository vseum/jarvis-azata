{"p":517,"j":26,"a":[[49,12,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُواْ","ٱجۡتَنِبُواْ","كَثِيرٗا","مِّنَ","ٱلظَّنِّ","إِنَّ","بَعۡضَ","ٱلظَّنِّ","إِثۡمٞۖ","وَلَا","تَجَسَّسُواْ","وَلَا","يَغۡتَب","بَّعۡضُكُم","بَعۡضًاۚ","أَيُحِبُّ","أَحَدُكُمۡ","أَن","يَأۡكُلَ","لَحۡمَ","أَخِيهِ","مَيۡتٗا","فَكَرِهۡتُمُوهُۚ","وَٱتَّقُواْ","ٱللَّهَۚ","إِنَّ","ٱللَّهَ","تَوَّابٞ","رَّحِيمٞ"],"йа'аййухал лазиина аманужтанибуу касиирам миназ занни инна ба`даз занни исмун вала тажассасуу вала йагтаб ба`дукум ба`дан айухиббу ахадукум ан йа'кула лахма ахиихи майтан факарихтумууху ваттаḳуллаха инналлаха таввабур рахиим","О те, которые уверовали! Избегайте многих предположений, ибо некоторые предположения являются грехом. Не следите друг за другом и не злословьте за спиной друг друга. Разве понравится кому-либо из вас есть мясо своего покойного брата, если вы чувствуете к этому отвращение? Бойтесь Аллаха! Воистину, Аллах - Принимающий покаяния, Милосердный.",["о","те, которые","уверовали","избегайте","многого","из","предположений","поистине","некоторые","предположения","грех","и не","шпионьте","и пусть не","злословит","одни из вас","о других","разве любит","кто-либо из вас","чтобы","есть","мясо","брата своего","мёртвого","и вы возненавидели это","и бойтесь","Аллаха","поистине","Аллах","Принимающий покаяние","Милосердный"]],[49,13,["يَٰٓأَيُّهَا","ٱلنَّاسُ","إِنَّا","خَلَقۡنَٰكُم","مِّن","ذَكَرٖ","وَأُنثَىٰ","وَجَعَلۡنَٰكُمۡ","شُعُوبٗا","وَقَبَآئِلَ","لِتَعَارَفُوٓاْۚ","إِنَّ","أَكۡرَمَكُمۡ","عِندَ","ٱللَّهِ","أَتۡقَىٰكُمۡۚ","إِنَّ","ٱللَّهَ","عَلِيمٌ","خَبِيرٞ"],"йа'аййухан насу инна халаḳнакум мин закарин ва'унса важа`алнакум шу`уубан ваḳабаила лита`арафуу инна акрамакум `индаллахи атḳакум инналлаха `алиимун хабиир","О люди! Воистину, Мы создали вас из мужчины и женщины и сделали вас народами и племенами, чтобы вы узнавали друг друга, и самый почитаемый перед Аллахом среди вас - наиболее богобоязненный. Воистину, Аллах - Знающий, Ведающий.",["о","люди","поистине, Мы","создали вас","из","мужчины","и женщины","и сделали Мы вас","народами","и племенами","чтобы узнавали вы друг друга","поистине","самый почитаемый из вас","у","Аллаха","самый богобоязненный из вас","поистине","Аллах","Знающий","Ведающий"]],[49,14,["قَالَتِ","ٱلۡأَعۡرَابُ","ءَامَنَّاۖ","قُل","لَّمۡ","تُؤۡمِنُواْ","وَلَٰكِن","قُولُوٓاْ","أَسۡلَمۡنَا","وَلَمَّا","يَدۡخُلِ","ٱلۡإِيمَٰنُ","فِي","قُلُوبِكُمۡۖ","وَإِن","تُطِيعُواْ","ٱللَّهَ","وَرَسُولَهُۥ","لَا","يَلِتۡكُم","مِّنۡ","أَعۡمَٰلِكُمۡ","شَيۡـًٔاۚ","إِنَّ","ٱللَّهَ","غَفُورٞ","رَّحِيمٌ"],"ḳалатил а`рабу аманна ḳул лам ту'минуу валакин ḳуулуу асламна валамма йадхулил ииману фии ḳулуубикум ва'ин тутии`уллаха варасуулахуу ла йалиткум мин а`маликум шай'ан инналлаха гафуурур рахиим","Бедуины сказали: «Мы уверовали». Скажи: «Вы не уверовали. Посему говорите: «Мы покорились». Вера еще не вошла в ваши сердца. Если вы подчинитесь Аллаху и Его Посланнику, Он нисколько не умалит ваших деяний. Воистину, Аллах - Прощающий, Милосердный».",["сказали","бедуины","мы уверовали","скажи","не","уверовали вы","но","говорите","мы покорились","и ещё не","вошла","вера","в","сердца ваши","и если","будете повиноваться вы","Аллаху","и Его Посланнику","не","умалит Он вам","из","деяний ваших","ничего","поистине","Аллах","Прощающий","Милосердный"]],[49,15,["إِنَّمَا","ٱلۡمُؤۡمِنُونَ","ٱلَّذِينَ","ءَامَنُواْ","بِٱللَّهِ","وَرَسُولِهِۦ","ثُمَّ","لَمۡ","يَرۡتَابُواْ","وَجَٰهَدُواْ","بِأَمۡوَٰلِهِمۡ","وَأَنفُسِهِمۡ","فِي","سَبِيلِ","ٱللَّهِۚ","أُوْلَٰٓئِكَ","هُمُ","ٱلصَّٰدِقُونَ"],"иннамал му'минуунал лазиина амануу биллахи варасуулихии сумма лам йартабуу важахадуу би'амвалихим ва'анфусихим фии сабиилиллахи улаика хумус садиḳуун","Верующими являются только те, которые уверовали в Аллаха и Его Посланника, а потом не испытывали сомнений и сражались на пути Аллаха своим имуществом и своими душами. Именно они являются правдивыми.",["лишь","верующие","те, которые","уверовали","в Аллаха","и Его Посланника","затем","не","усомнились","и боролись","имуществом своим","и душами своими","на","пути","Аллаха","те","они","правдивые"]],[49,16,["قُلۡ","أَتُعَلِّمُونَ","ٱللَّهَ","بِدِينِكُمۡ","وَٱللَّهُ","يَعۡلَمُ","مَا","فِي","ٱلسَّمَٰوَٰتِ","وَمَا","فِي","ٱلۡأَرۡضِۚ","وَٱللَّهُ","بِكُلِّ","شَيۡءٍ","عَلِيمٞ"],"ḳул ату`аллимууналлаха бидииникум валлаху йа`ламу ма фис самавати вама фил арди валлаху бикулли шай'ин `алиим","Скажи: «Неужели вы хотите уведомить Аллаха о вашей вере, тогда как Аллах знает то, что на небесах, и то, что на земле? Аллах знает о всякой вещи».",["скажи","разве вы сообщаете","Аллаху","о религии вашей","тогда как Аллах","знает","то, что","на","небесах","и то, что","на","земле","и Аллах","о всякой","вещи","Знающий"]],[49,17,["يَمُنُّونَ","عَلَيۡكَ","أَنۡ","أَسۡلَمُواْۖ","قُل","لَّا","تَمُنُّواْ","عَلَيَّ","إِسۡلَٰمَكُمۖ","بَلِ","ٱللَّهُ","يَمُنُّ","عَلَيۡكُمۡ","أَنۡ","هَدَىٰكُمۡ","لِلۡإِيمَٰنِ","إِن","كُنتُمۡ","صَٰدِقِينَ"],"йамуннууна `алайка ан асламуу ḳул ла тамуннуу `алаййа исламакум балиллаху йамунну `алайкум ан хадакум лил'иимани ин кунтум садиḳиин","Они попрекают тебя тем, что обратились в ислам. Скажи: «Не попрекайте меня вашим обращением в ислам. Это Аллах оказал вам милость тем, что привел вас к вере, если вы вообще говорите правду».",["они попрекают","тебя","тем, что","приняли они ислам","скажи","не","попрекайте","меня","исламом вашим","напротив","Аллах","оказывает милость","вам","тем, что","Он повёл вас","к вере","если","являетесь вы","правдивыми"]],[49,18,["إِنَّ","ٱللَّهَ","يَعۡلَمُ","غَيۡبَ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِۚ","وَٱللَّهُ","بَصِيرُۢ","بِمَا","تَعۡمَلُونَ"],"инналлаха йа`ламу гайбас самавати вал'арди валлаху басииру бима та`малуун","Воистину, Аллах знает сокровенное небес и земли. Аллах видит то, что вы совершаете.",["поистине","Аллах","знает","сокровенное","небес","и земли","и Аллах","Видящий","то, что","делаете вы"]]],"m":[[["يَٰٓأَيُّهَا","о",49,12],["ٱلَّذِينَ","те, которые",49,12],["ءَامَنُواْ","уверовали",49,12],["ٱجۡتَنِبُواْ","избегайте",49,12],["كَثِيرٗا","многого",49,12],["مِّنَ","из",49,12],["ٱلظَّنِّ","предположений",49,12],["إِنَّ","поистине",49,12],["بَعۡضَ","некоторые",49,12],["ٱلظَّنِّ","предположения",49,12],["إِثۡمٞۖ","грех",49,12]],[["وَلَا","и не",49,12],["تَجَسَّسُواْ","шпионьте",49,12],["وَلَا","и пусть не",49,12],["يَغۡتَب","злословит",49,12],["بَّعۡضُكُم","одни из вас",49,12],["بَعۡضًاۚ","о других",49,12],["أَيُحِبُّ","разве любит",49,12],["أَحَدُكُمۡ","кто-либо из вас",49,12],["أَن","чтобы",49,12]],[["يَأۡكُلَ","есть",49,12],["لَحۡمَ","мясо",49,12],["أَخِيهِ","брата своего",49,12],["مَيۡتٗا","мёртвого",49,12],["فَكَرِهۡتُمُوهُۚ","и вы возненавидели это",49,12],["وَٱتَّقُواْ","и бойтесь",49,12],["ٱللَّهَۚ","Аллаха",49,12],["إِنَّ","поистине",49,12],["ٱللَّهَ","Аллах",49,12],["تَوَّابٞ","Принимающий покаяние",49,12]],[["رَّحِيمٞ","Милосердный",49,12],[12],["يَٰٓأَيُّهَا","о",49,13],["ٱلنَّاسُ","люди",49,13],["إِنَّا","поистине, Мы",49,13],["خَلَقۡنَٰكُم","создали вас",49,13],["مِّن","из",49,13],["ذَكَرٖ","мужчины",49,13],["وَأُنثَىٰ","и женщины",49,13],["وَجَعَلۡنَٰكُمۡ","и сделали Мы вас",49,13]],[["شُعُوبٗا","народами",49,13],["وَقَبَآئِلَ","и племенами",49,13],["لِتَعَارَفُوٓاْۚ","чтобы узнавали вы друг друга",49,13],["إِنَّ","поистине",49,13],["أَكۡرَمَكُمۡ","самый почитаемый из вас",49,13],["عِندَ","у",49,13],["ٱللَّهِ","Аллаха",49,13],["أَتۡقَىٰكُمۡۚ","самый богобоязненный из вас",49,13],["إِنَّ","поистине",49,13],["ٱللَّهَ","Аллах",49,13]],[["عَلِيمٌ","Знающий",49,13],["خَبِيرٞ","Ведающий",49,13],[13],["۞ قَالَتِ","сказали",49,14],["ٱلۡأَعۡرَابُ","бедуины",49,14],["ءَامَنَّاۖ","мы уверовали",49,14],["قُل","скажи",49,14],["لَّمۡ","не",49,14],["تُؤۡمِنُواْ","уверовали вы",49,14],["وَلَٰكِن","но",49,14]],[["قُولُوٓاْ","говорите",49,14],["أَسۡلَمۡنَا","мы покорились",49,14],["وَلَمَّا","и ещё не",49,14],["يَدۡخُلِ","вошла",49,14],["ٱلۡإِيمَٰنُ","вера",49,14],["فِي","в",49,14],["قُلُوبِكُمۡۖ","сердца ваши",49,14],["وَإِن","и если",49,14],["تُطِيعُواْ","будете повиноваться вы",49,14],["ٱللَّهَ","Аллаху",49,14]],[["وَرَسُولَهُۥ","и Его Посланник