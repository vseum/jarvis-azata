{"p":518,"j":26,"a":[[50,1,["قٓۚ","وَٱلۡقُرۡءَانِ","ٱلۡمَجِيدِ"],"ḳ валḳур'анил мажиид","Каф. Клянусь славным Кораном!",["Каф","клянусь Кораном","славным"]],[50,2,["بَلۡ","عَجِبُوٓاْ","أَن","جَآءَهُم","مُّنذِرٞ","مِّنۡهُمۡ","فَقَالَ","ٱلۡكَٰفِرُونَ","هَٰذَا","شَيۡءٌ","عَجِيبٌ"],"бал `ажибуу ан жаахум мунзирум минхум фаḳалал кафирууна хаза шай'ун `ажииб","Но удивились они тому, что к ним явился предостерегающий увещеватель из них самих, и неверующие сказали: «Это - нечто удивительное!",["но","удивились они","что","пришёл к ним","увещеватель","из них","и сказали","неверующие","это","вещь","удивительная"]],[50,3,["أَءِذَا","مِتۡنَا","وَكُنَّا","تُرَابٗاۖ","ذَٰلِكَ","رَجۡعُۢ","بَعِيدٞ"],"а'иза митна вакунна турабан залика раж`у ба`иид","Неужели это (воскрешение) произойдет после того, как умрем и станем прахом? Это возвращение невероятно!».",["разве когда","умрём мы","и станем","прахом","это","возвращение","далёкое"]],[50,4,["قَدۡ","عَلِمۡنَا","مَا","تَنقُصُ","ٱلۡأَرۡضُ","مِنۡهُمۡۖ","وَعِندَنَا","كِتَٰبٌ","حَفِيظُۢ"],"ḳад `алимна ма танḳусул арду минхум ва`индана китабун хафииз","Мы знаем, что земля отнимает от них, и у Нас есть сохраняющее (или хранимое) Писание.",["уже","знаем Мы","то, что","убавляет","земля","от них","и у Нас","Книга","хранящая"]],[50,5,["بَلۡ","كَذَّبُواْ","بِٱلۡحَقِّ","لَمَّا","جَآءَهُمۡ","فَهُمۡ","فِيٓ","أَمۡرٖ","مَّرِيجٍ"],"бал каззабуу билхаḳḳи ламма жаахум фахум фии амрим марииж","Но они сочли ложью истину, когда она явилась к ним, и теперь они находятся в замешательстве.",["но","сочли ложью они","истину","когда","пришла она к ним","и они","в","положении","смутном"]],[50,6,["أَفَلَمۡ","يَنظُرُوٓاْ","إِلَى","ٱلسَّمَآءِ","فَوۡقَهُمۡ","كَيۡفَ","بَنَيۡنَٰهَا","وَزَيَّنَّٰهَا","وَمَا","لَهَا","مِن","فُرُوجٖ"],"афалам йанзуруу илас самаи фауḳахум кайфа банайнаха вазаййаннаха вама лаха мин фурууж","Неужели они не смотрели на то, как Мы построили и украсили небо над ними? В нем нет расщелин.",["разве не","посмотрели они","на","небо","над ними","как","Мы построили его","и украсили Мы его","и нет","у него","никаких","трещин"]],[50,7,["وَٱلۡأَرۡضَ","مَدَدۡنَٰهَا","وَأَلۡقَيۡنَا","فِيهَا","رَوَٰسِيَ","وَأَنۢبَتۡنَا","فِيهَا","مِن","كُلِّ","زَوۡجِۭ","بَهِيجٖ"],"вал'арда мададнаха ва'алḳайна фииха равасийа ва'амбатна фииха мин кулли заужи бахииж","Мы простерли землю, установили на ней незыблемые горы и взрастили на ней всякие великолепные пары растений",["и землю","Мы простёрли её","и водрузили Мы","на ней","твёрдые горы","и взрастили Мы","на ней","из","всякой","пары","великолепной"]],[50,8,["تَبۡصِرَةٗ","وَذِكۡرَىٰ","لِكُلِّ","عَبۡدٖ","مُّنِيبٖ"],"табсиратан вазикра ликулли `абдим мунииб","для разъяснения и напоминания каждому рабу, который обращается к Аллаху.",["для прозрения","и напоминания","для всякого","раба","обращающегося (к Аллаху)"]],[50,9,["وَنَزَّلۡنَا","مِنَ","ٱلسَّمَآءِ","مَآءٗ","مُّبَٰرَكٗا","فَأَنۢبَتۡنَا","بِهِۦ","جَنَّٰتٖ","وَحَبَّ","ٱلۡحَصِيدِ"],"ваназзална минас самаи маам мубаракан фа'амбатна бихии жаннатин вахаббал хасиид","Мы ниспослали с неба благословенную воду и взрастили посредством нее сады и зерна собранного урожая,",["и ниспослали Мы","с","неба","воду","благословенную","и взрастили Мы","ею","сады","и зёрна","жатвы"]],[50,10,["وَٱلنَّخۡلَ","بَاسِقَٰتٖ","لَّهَا","طَلۡعٞ","نَّضِيدٞ"],"ваннахла басиḳатил лаха тал`ун надиид","и высокие финиковые пальмы с висящими рядами плодами.",["и пальмы","высокие","у них","завязи","наслоённые"]],[50,11,["رِّزۡقٗا","لِّلۡعِبَادِۖ","وَأَحۡيَيۡنَا","بِهِۦ","بَلۡدَةٗ","مَّيۡتٗاۚ","كَذَٰلِكَ","ٱلۡخُرُوجُ"],"рризḳал лил`ибади ва'ахйайна бихии балдатам майтан казаликал хурууж","Таково пропитание для рабов. Мы оживили ею мертвую землю. Таким же будет выход из могил!",["пропитанием","для рабов","и оживили Мы","ею","местность","мёртвую","так же","выход (из могил)"]],[50,12,["كَذَّبَتۡ","قَبۡلَهُمۡ","قَوۡمُ","نُوحٖ","وَأَصۡحَٰبُ","ٱلرَّسِّ","وَثَمُودُ"],"каззабат ḳаблахум ḳауму нуухин ва'асхабур расси васамууд","До них сочли лжецами посланников народ Нуха (Ноя), жители Расса и самудяне,",["сочли лжецами","до них","народ","Нуха","и обитатели","ар-Расса","и самуд"]],[50,13,["وَعَادٞ","وَفِرۡعَوۡنُ","وَإِخۡوَٰنُ","لُوطٖ"],"ва`адун вафир`ауну ва'ихвану луут","адиты, народ Фараона и братья Лута (Лота),",["и адиты","и Фараон","и братья","Лута"]],[50,14,["وَأَصۡحَٰبُ","ٱلۡأَيۡكَةِ","وَقَوۡمُ","تُبَّعٖۚ","كُلّٞ","كَذَّبَ","ٱلرُّسُلَ","فَحَقَّ","وَعِيدِ"],"ва'асхабул айкати ваḳауму тубба`ин куллун каззабар русула фахаḳḳа ва`иид","жители Айки и народ Тубба (Тобба). Все они сочли лжецами посланников, и сбылась Моя угроза.",["и обитатели","Айки (рощи)","и народ","Туббы","все","сочли лжецами","посланников","и сбылась","угроза Моя"]],[50,15,["أَفَعَيِينَا","بِٱلۡخَلۡقِ","ٱلۡأَوَّلِۚ","بَلۡ","هُمۡ","فِي","لَبۡسٖ","مِّنۡ","خَلۡقٖ","جَدِيدٖ"],"афа`айиина билхалḳил аввали бал хум фии лабсим мин халḳин жадиид","Разве Мы изнемогли после первого сотворения? Но они сомневаются в новом сотворении (воскрешении).",["разве изнемогли Мы","творением","первым","напротив","они","в","сомнении","о","творении","новом"]]],"m":[["h",50],["b"],[["قٓۚ","Каф",50,1],["وَٱلۡقُرۡءَانِ","клянусь Кораном",50,1],["ٱلۡمَجِيدِ","славным",50,1],[1],["بَلۡ","но",50,2],["عَجِبُوٓاْ","удивились они",50,2],["أَن","что",50,2],["جَآءَهُم","пришёл к ним",50,2],["مُّنذِرٞ","увещеватель",50,2],["مِّنۡهُمۡ","из них",50,2]],[["فَقَالَ","и сказали",50,2],["ٱلۡكَٰفِرُونَ","неверующие",50,2],["هَٰذَا","это",50,2],["شَيۡءٌ","вещь",50,2],["عَجِيبٌ","удивительная",50,2],[2],["أَءِذَا","разве когда",50,3],["مِتۡنَا","умрём мы",50,3],["وَكُنَّا","и станем",50,3],["تُرَابٗاۖ","прахом",50,3],["ذَٰلِكَ","это",50,3]],[["رَجۡعُۢ","возвращение",50,3],["بَعِيدٞ","далёкое",50,3],[3],["قَدۡ","уже",50,4],["عَلِمۡنَا","знаем Мы",50,4],["مَا","то, что",50,4],["تَنقُصُ","убавляет",50,4],["ٱلۡأَرۡضُ","земля",50,4],["مِنۡهُمۡۖ","от них",50,4],["وَعِندَنَا","и у Нас",50,4],["كِتَٰبٌ","Книга",50,4]],[["حَفِيظُۢ","хранящая",50,4],[4],["بَلۡ","но",50,5],["كَذَّبُواْ","сочли ложью они",50,5],["بِٱلۡحَقِّ",