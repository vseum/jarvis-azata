{"p":519,"j":26,"a":[[50,16,["وَلَقَدۡ","خَلَقۡنَا","ٱلۡإِنسَٰنَ","وَنَعۡلَمُ","مَا","تُوَسۡوِسُ","بِهِۦ","نَفۡسُهُۥۖ","وَنَحۡنُ","أَقۡرَبُ","إِلَيۡهِ","مِنۡ","حَبۡلِ","ٱلۡوَرِيدِ"],"валаḳад халаḳнал инсана вана`ламу ма туасвису бихии нафсухуу ванахну аḳрабу илайхи мин хаблил вариид","Мы сотворили человека и знаем, что нашептывает ему душа. Мы ближе к нему, чем яремная вена.",["и уже","Мы создали","человека","и знаем Мы","то, что","нашёптывает","ему","душа его","и Мы","ближе","к нему","чем","вена","яремная"]],[50,17,["إِذۡ","يَتَلَقَّى","ٱلۡمُتَلَقِّيَانِ","عَنِ","ٱلۡيَمِينِ","وَعَنِ","ٱلشِّمَالِ","قَعِيدٞ"],"из йаталаḳḳал муталаḳḳийани `анил йамиини ва`аниш шимали ḳа`иид","Двое ангелов сидят справа и слева и принимают (записывают деяния).",["когда","принимают","двое принимающих","с","правой стороны","и с","левой стороны","сидящий"]],[50,18,["مَّا","يَلۡفِظُ","مِن","قَوۡلٍ","إِلَّا","لَدَيۡهِ","رَقِيبٌ","عَتِيدٞ"],"мма йалфизу мин ḳаулин илла ладайхи раḳиибун `атиид","Стоит ему произнести слово, как при нем оказывается готовый наблюдатель.",["не","произносит он","никакого","слова","кроме как","при нём","наблюдатель","готовый"]],[50,19,["وَجَآءَتۡ","سَكۡرَةُ","ٱلۡمَوۡتِ","بِٱلۡحَقِّۖ","ذَٰلِكَ","مَا","كُنتَ","مِنۡهُ","تَحِيدُ"],"важаат сакратул маути билхаḳḳи залика ма кунта минху тахиид","Смертельная агония явится с истиной. Вот то, чего ты избегал!",["и придёт","агония","смерти","с истиной","это","то, что","был ты","от него","уклоняющимся"]],[50,20,["وَنُفِخَ","فِي","ٱلصُّورِۚ","ذَٰلِكَ","يَوۡمُ","ٱلۡوَعِيدِ"],"вануфиха фис суури залика йаумул ва`иид","И подуют в Рог. Это - День угрозы!",["и подуют","в","Рог","это","День","угрозы"]],[50,21,["وَجَآءَتۡ","كُلُّ","نَفۡسٖ","مَّعَهَا","سَآئِقٞ","وَشَهِيدٞ"],"важаат куллу нафсим ма`аха саиḳун вашахиид","И каждая душа явится вместе с погонщиком и свидетелем.",["и явится","каждая","душа","с ней","погонщик","и свидетель"]],[50,22,["لَّقَدۡ","كُنتَ","فِي","غَفۡلَةٖ","مِّنۡ","هَٰذَا","فَكَشَفۡنَا","عَنكَ","غِطَآءَكَ","فَبَصَرُكَ","ٱلۡيَوۡمَ","حَدِيدٞ"],"ллаḳад кунта фии гафлатим мин хаза факашафна `анка гитаака фабасарукал йаума хадиид","Ты был беспечен к этому, но Мы сорвали с тебя твое покрывало, и острым является сегодня твой взор.",["уже","был ты","в","беспечности","о","этом","и сняли Мы","с тебя","покрывало твоё","и зрение твоё","сегодня","остро"]],[50,23,["وَقَالَ","قَرِينُهُۥ","هَٰذَا","مَا","لَدَيَّ","عَتِيدٌ"],"ваḳала ḳариинухуу хаза ма ладаййа `атиид","Его товарищ (ангел) скажет: «Вот то, что подготовлено у меня».",["и скажет","спутник его","это","то, что","у меня","приготовлено"]],[50,24,["أَلۡقِيَا","فِي","جَهَنَّمَ","كُلَّ","كَفَّارٍ","عَنِيدٖ"],"алḳийа фии жаханнама кулла каффарин `аниид","Вдвоем бросайте в Геенну каждого упрямого неверующего,",["бросьте (вдвоём)","в","Геенну","всякого","неверующего","упрямого"]],[50,25,["مَّنَّاعٖ","لِّلۡخَيۡرِ","مُعۡتَدٖ","مُّرِيبٍ"],"мманна`ил лилхайри му`тадим мурииб","который отказывал в добре, совершал преступления и терзался сомнениями,",["препятствующего","добру","преступника","сомневающегося"]],[50,26,["ٱلَّذِي","جَعَلَ","مَعَ","ٱللَّهِ","إِلَٰهًا","ءَاخَرَ","فَأَلۡقِيَاهُ","فِي","ٱلۡعَذَابِ","ٱلشَّدِيدِ"],"аллазии жа`ала ма`аллахи илахан ахара фа'алḳийаху фил `азабиш шадиид","который признавал наряду с Аллахом другого бога. Бросайте их в тяжкие мучения!».",["который","сделал","с","Аллахом","бога","другого","и бросьте его","в","наказание","суровое"]],[50,27,["قَالَ","قَرِينُهُۥ","رَبَّنَا","مَآ","أَطۡغَيۡتُهُۥ","وَلَٰكِن","كَانَ","فِي","ضَلَٰلِۭ","بَعِيدٖ"],"ḳала ḳариинухуу раббана ма атгайтухуу валакин кана фии далали ба`иид","Его товарищ (дьявол) скажет: «Господь наш! Я не сбивал его с пути. Он сам находился в глубоком заблуждении».",["скажет","спутник его","Господь наш","не","я ввёл его в бесчинство","но","был он","в","заблуждении","далёком"]],[50,28,["قَالَ","لَا","تَخۡتَصِمُواْ","لَدَيَّ","وَقَدۡ","قَدَّمۡتُ","إِلَيۡكُم","بِٱلۡوَعِيدِ"],"ḳала ла тахтасимуу ладаййа ваḳад ḳаддамту илайкум билва`иид","Он скажет: «Не препирайтесь предо Мной. Я предупреждал вас заранее.",["Он скажет","не","препирайтесь","предо Мной","и уже","Я заранее направил","к вам","угрозу"]],[50,29,["مَا","يُبَدَّلُ","ٱلۡقَوۡلُ","لَدَيَّ","وَمَآ","أَنَا۠","بِظَلَّٰمٖ","لِّلۡعَبِيدِ"],"ма йубаддалул ḳаулу ладаййа вама ана бизалламил лил`абиид","Мое Слово неизменно, и Я не поступаю несправедливо с рабами».",["не","изменяется","слово","у Меня","и не","Я","несправедлив","к рабам"]],[50,30,["يَوۡمَ","نَقُولُ","لِجَهَنَّمَ","هَلِ","ٱمۡتَلَأۡتِ","وَتَقُولُ","هَلۡ","مِن","مَّزِيدٖ"],"йаума наḳуулу лижаханнама халимтала'ти ватаḳуулу хал мим мазиид","В тот день Мы скажем Геенне: «Заполнилась ли ты?». Она скажет: «Нет ли добавки?».",["в день, когда","Мы скажем","Геенне","разве","заполнилась ты","и скажет она","есть ли","какая-нибудь","добавка"]],[50,31,["وَأُزۡلِفَتِ","ٱلۡجَنَّةُ","لِلۡمُتَّقِينَ","غَيۡرَ","بَعِيدٍ"],"ва'узлифатил жаннату лилмуттаḳиина гайра ба`иид","А Рай приблизится к богобоязненным и окажется неподалеку.",["и приближен будет","Рай","к богобоязненным","не","далеко"]],[50,32,["هَٰذَا","مَا","تُوعَدُونَ","لِكُلِّ","أَوَّابٍ","حَفِيظٖ"],"хаза ма туу`адууна ликулли аввабин хафииз","Вот то, что обещано вам для каждого обращающегося к Аллаху и помнящего (помнящего свои грехи и предписания религии или соблюдающего предписания религии),",["это","то, что","вам обещано","для всякого","обращающегося","оберегающего"]],[50,33,["مَّنۡ","خَشِيَ","ٱلرَّحۡمَٰنَ","بِٱلۡغَيۡبِ","وَجَآءَ","بِقَلۡبٖ","مُّنِيبٍ"],"мман хашийар рахмана билгайби важаа биḳалбим мунииб","который боялся Милостивого, не видя Его воочию, и явился с обращающимся сердцем.",["кто","боялся","Милостивого","не видя Его","и пришёл","с сердцем","обращающимся"]],[50,34,["ٱدۡخُلُوهَا","بِسَلَٰمٖۖ","ذَٰلِكَ","يَوۡمُ","ٱلۡخُلُودِ"],"идхулууха бисаламин залика йаумул хулууд","Им будет сказано: «Входите сюда с миром. Это - День вечности!».",["войдите в него","с миром","это","день","вечности"]],[50,35,["لَهُم","مَّا","يَشَآءُونَ","فِيهَا","وَلَدَيۡنَا","مَزِيدٞ"],