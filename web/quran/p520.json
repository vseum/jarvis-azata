{"p":520,"j":26,"a":[[50,36,["وَكَمۡ","أَهۡلَكۡنَا","قَبۡلَهُم","مِّن","قَرۡنٍ","هُمۡ","أَشَدُّ","مِنۡهُم","بَطۡشٗا","فَنَقَّبُواْ","فِي","ٱلۡبِلَٰدِ","هَلۡ","مِن","مَّحِيصٍ"],"вакам ахлакна ḳаблахум мин ḳарнин хум ашадду минхум батшан фанаḳḳабуу фил билади хал мим махиис","Сколько же Мы истребили до них поколений, которые превосходили их мощью! Они странствовали по земле. Но разве они могли сбежать?",["и сколько","Мы погубили","до них","из","поколений","они","сильнее","их","мощью","и они рыскали","по","странам","есть ли","какое-либо","убежище"]],[50,37,["إِنَّ","فِي","ذَٰلِكَ","لَذِكۡرَىٰ","لِمَن","كَانَ","لَهُۥ","قَلۡبٌ","أَوۡ","أَلۡقَى","ٱلسَّمۡعَ","وَهُوَ","شَهِيدٞ"],"инна фии залика лазикра лиман кана лахуу ḳалбун ау алḳас сам`а вахуа шахиид","Воистину, в этом заключено напоминание для тех, у кого есть сердце, кто прислушивается и присутствует при этом.",["поистине","в","этом","непременно напоминание","для того, кто","есть","у него","сердце","или","приклонил","слух","и он","присутствует"]],[50,38,["وَلَقَدۡ","خَلَقۡنَا","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضَ","وَمَا","بَيۡنَهُمَا","فِي","سِتَّةِ","أَيَّامٖ","وَمَا","مَسَّنَا","مِن","لُّغُوبٖ"],"валаḳад халаḳнас самавати вал'арда вама байнахума фии ситтати аййамин вама массана мил лугууб","Мы сотворили небеса, землю и то, что между ними, за шесть дней, и Нас ничуть не коснулась усталость.",["и уже","Мы сотворили","небеса","и землю","и то, что","между ними","за","шесть","дней","и не","коснулась Нас","никакая","усталость"]],[50,39,["فَٱصۡبِرۡ","عَلَىٰ","مَا","يَقُولُونَ","وَسَبِّحۡ","بِحَمۡدِ","رَبِّكَ","قَبۡلَ","طُلُوعِ","ٱلشَّمۡسِ","وَقَبۡلَ","ٱلۡغُرُوبِ"],"фасбир `ала ма йаḳуулууна васаббих бихамди раббика ḳабла тулуу`иш шамси ваḳаблал гурууб","Терпеливо сноси то, что они говорят, и прославляй хвалой твоего Господа перед восходом солнца и перед закатом.",["терпи же","на","то, что","говорят они","и славь","хвалой","Господа твоего","до","восхода","солнца","и до","заката"]],[50,40,["وَمِنَ","ٱلَّيۡلِ","فَسَبِّحۡهُ","وَأَدۡبَٰرَ","ٱلسُّجُودِ"],"ваминал лайли фасаббихху ва'адбарас сужууд","Прославляй Его в некоторые часы ночи и после земных поклонов.",["и из","ночи","славь Его","и после","земных поклонов"]],[50,41,["وَٱسۡتَمِعۡ","يَوۡمَ","يُنَادِ","ٱلۡمُنَادِ","مِن","مَّكَانٖ","قَرِيبٖ"],"вастами` йаума йунадил мунади мим маканин ḳарииб","Слушай! В тот день глашатай воззовет поблизости (или прислушайся в тот день, когда глашатай воззовет поблизости).",["и слушай","в день, когда","воззовёт","глашатай","из","места","близкого"]],[50,42,["يَوۡمَ","يَسۡمَعُونَ","ٱلصَّيۡحَةَ","بِٱلۡحَقِّۚ","ذَٰلِكَ","يَوۡمُ","ٱلۡخُرُوجِ"],"йаума йасма`уунас сайхата билхаḳḳи залика йаумул хурууж","В тот день они услышат звук истинно. Это - День выхода из могил.",["в день, когда","услышат они","клич","истинно","это","день","выхода"]],[50,43,["إِنَّا","نَحۡنُ","نُحۡيِۦ","وَنُمِيتُ","وَإِلَيۡنَا","ٱلۡمَصِيرُ"],"инна нахну нухйии ванумииту ва'илайнал масиир","Воистину, Мы оживляем и умерщвляем, и к Нам предстоит прибытие.",["поистине, Мы","Мы","оживляем","и умерщвляем","и к Нам","возвращение"]],[50,44,["يَوۡمَ","تَشَقَّقُ","ٱلۡأَرۡضُ","عَنۡهُمۡ","سِرَاعٗاۚ","ذَٰلِكَ","حَشۡرٌ","عَلَيۡنَا","يَسِيرٞ"],"йаума ташаḳḳаḳул арду `анхум сира`ан залика хашрун `алайна йасиир","В тот день земля разверзнется для них, когда они будут спешить. Нам легко собрать их таким образом.",["в день, когда","расколется","земля","над ними","спешащими","это","собирание","для Нас","лёгкое"]],[50,45,["نَّحۡنُ","أَعۡلَمُ","بِمَا","يَقُولُونَۖ","وَمَآ","أَنتَ","عَلَيۡهِم","بِجَبَّارٖۖ","فَذَكِّرۡ","بِٱلۡقُرۡءَانِ","مَن","يَخَافُ","وَعِيدِ"],"ннахну а`ламу бима йаḳуулууна вама анта `алайхим бижаббарин фазаккир билḳур'ани ман йахафу ва`иид","Нам лучше знать, что они говорят, и тебе не надо принуждать их. Увещевай же Кораном тех, кто страшится Моей угрозы.",["Мы","лучше знаем","то, что","говорят они","и не","ты","над ними","принуждающий","так напоминай","Кораном","тому, кто","боится","угрозы Моей"]],[51,1,["وَٱلذَّٰرِيَٰتِ","ذَرۡوٗا"],"ваззарийати