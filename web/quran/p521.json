{"p":521,"j":26,"a":[[51,7,["وَٱلسَّمَآءِ","ذَاتِ","ٱلۡحُبُكِ"],"вассамаи затил хубук","Клянусь небом, обладающим прекрасным обликом (или небом, обладающим мощью; или небом со звездами)!",["клянусь небом","обладающим","путями"]],[51,8,["إِنَّكُمۡ","لَفِي","قَوۡلٖ","مُّخۡتَلِفٖ"],"иннакум лафии ḳаулим мухталиф","Ваши (неверующих) слова противоречивы.",["поистине, вы","непременно в","речи","разноречивой"]],[51,9,["يُؤۡفَكُ","عَنۡهُ","مَنۡ","أُفِكَ"],"йу'факу `анху ман уфик","Отвращен от него (Мухаммада или Корана) тот, кто был отвращен.",["отвращается","от него","тот, кто","отвращён"]],[51,10,["قُتِلَ","ٱلۡخَرَّٰصُونَ"],"ḳутилал харрасуун","Да будут убиты лжецы,",["да будут убиты","лжецы"]],[51,11,["ٱلَّذِينَ","هُمۡ","فِي","غَمۡرَةٖ","سَاهُونَ"],"аллазиина хум фии гамратин сахуун","которые окутаны невежеством и беспечны!",["те, которые","они","в","пучине (невежества)","беспечны"]],[51,12,["يَسۡـَٔلُونَ","أَيَّانَ","يَوۡمُ","ٱلدِّينِ"],"йас'алууна аййана йаумуд диин","Они спрашивают, когда же настанет День воздаяния?",["спрашивают они","когда","день","воздаяния"]],[51,13,["يَوۡمَ","هُمۡ","عَلَى","ٱلنَّارِ","يُفۡتَنُونَ"],"йаума хум `алан нари йуфтануун","В тот день они будут гореть в Огне.",["в день, когда","они","на","Огне","будут мучимы"]],[51,14,["ذُوقُواْ","فِتۡنَتَكُمۡ","هَٰذَا","ٱلَّذِي","كُنتُم","بِهِۦ","تَسۡتَعۡجِلُونَ"],"зууḳуу фитнатакум хазал лазии кунтум бихии таста`жилуун","Вкусите ваше наказание, которое вы торопили.",["вкусите","мучение ваше","это","то, что","вы были","его","торопили"]],[51,15,["إِنَّ","ٱلۡمُتَّقِينَ","فِي","جَنَّٰتٖ","وَعُيُونٍ"],"иннал муттаḳиина фии жаннатин ва`уйуун","Воистину, богобоязненные пребудут в Райских садах и среди источников,",["поистине","богобоязненные","в","садах","и источниках"]],[51,16,["ءَاخِذِينَ","مَآ","ءَاتَىٰهُمۡ","رَبُّهُمۡۚ","إِنَّهُمۡ","كَانُواْ","قَبۡلَ","ذَٰلِكَ","مُحۡسِنِينَ"],"ахизиина ма атахум раббухум иннахум кануу ḳабла залика мухсиниин","получая то, что даровал им их Господь. До этого они были творящими добро.",["берущие","то, что","даровал им","Господь их","поистине, они","были","до","этого","творящими добро"]],[51,17,["كَانُواْ","قَلِيلٗا","مِّنَ","ٱلَّيۡلِ","مَا","يَهۡجَعُونَ"],"кануу ḳалиилам минал лайли ма йахжа`уун","Они спали лишь малую часть ночи,",["были они","немного","из","ночи","(что)","спали"]],[51,18,["وَبِٱلۡأَسۡحَارِ","هُمۡ","يَسۡتَغۡفِرُونَ"],"вабил'асхари хум йастагфируун","а перед рассветом они молили о прощении.",["и перед рассветами","они","просили прощения"]],[51,19,["وَفِيٓ","أَمۡوَٰلِهِمۡ","حَقّٞ","لِّلسَّآئِلِ","وَٱلۡمَحۡرُومِ"],"вафии амвалихим хаḳḳул лиссаили валмахруум","Они выделяли известную долю своего имущества для просящих и обездоленных.",["и в","имуществе их","право","просящего","и лишённого"]],[51,20,["وَفِي","ٱلۡأَرۡضِ","ءَايَٰتٞ","لِّلۡمُوقِنِينَ"],"вафил арди айатул лилмууḳиниин","На земле есть знамения для людей убежденных,",["и на","земле","знамения","для убеждённых"]],[51,21,["وَفِيٓ","أَنفُسِكُمۡۚ","أَفَلَا","تُبۡصِرُونَ"],"вафии анфусикум афала тубсируун","а также в вас самих. Неужели вы не видите?",["и в","вас самих","разве не","видите вы"]],[51,22,["وَفِي","ٱلسَّمَآءِ","رِزۡقُكُمۡ","وَمَا","تُوعَدُونَ"],"вафис самаи ризḳукум вама туу`адуун","На небе находится ваш удел и то, что вам обещано.",["и на","небе","удел ваш","и то, что","вам обещано"]],[51,23,["فَوَرَبِّ","ٱلسَّمَآءِ","وَٱلۡأَرۡضِ","إِنَّهُۥ","لَحَقّٞ","مِّثۡلَ","مَآ","أَنَّكُمۡ","تَنطِقُونَ"],"фавараббис самаи вал'арди иннахуу лахаḳḳум мисла ма аннакум тантиḳуун","Клянусь Господом неба и земли, что это является истиной, подобно тому, что вы обладаете даром речи.",["клянусь же Господом","неба","и земли","поистине, это","непременно истина","подобно","тому, что","вы","говорите"]],[51,24,["هَلۡ","أَتَىٰكَ","حَدِيثُ","ضَيۡفِ","إِبۡرَٰهِيمَ","ٱلۡمُكۡرَمِينَ"],"хал атака хадиису дайфи ибрахиимал мукрамиин","Дошел ли до тебя рассказ о почтенных гостях Ибрахима (Авраама)?",["разве","дошел до тебя","рассказ","о гостях","Ибрахима","почтенных"]],[51,25,["إِذۡ","د