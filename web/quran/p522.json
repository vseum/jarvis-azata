{"p":522,"j":27,"a":[[51,31,["قَالَ","فَمَا","خَطۡبُكُمۡ","أَيُّهَا","ٱلۡمُرۡسَلُونَ"],"ḳала фама хатбукум аййухал мурсалуун","Он сказал: «Какова же ваша миссия, о посланцы?».",["сказал он","так каково","дело ваше","о","посланные"]],[51,32,["قَالُوٓاْ","إِنَّآ","أُرۡسِلۡنَآ","إِلَىٰ","قَوۡمٖ","مُّجۡرِمِينَ"],"ḳалуу инна урсилна ила ḳаумим мужримиин","Они сказали: «Мы посланы к грешным людям,",["сказали они","поистине, мы","посланы мы","к","людям","грешным"]],[51,33,["لِنُرۡسِلَ","عَلَيۡهِمۡ","حِجَارَةٗ","مِّن","طِينٖ"],"линурсила `алайхим хижаратам мин тиин","чтобы наслать на них каменья из глины,",["чтобы наслать нам","на них","камни","из","глины"]],[51,34,["مُّسَوَّمَةً","عِندَ","رَبِّكَ","لِلۡمُسۡرِفِينَ"],"ммусавваматан `инда раббика лилмусрифиин","помеченные у твоего Господа для тех, кто излишествовал».",["помеченные","у","Господа твоего","для излишествующих"]],[51,35,["فَأَخۡرَجۡنَا","مَن","كَانَ","فِيهَا","مِنَ","ٱلۡمُؤۡمِنِينَ"],"фа'ахражна ман кана фииха минал му'миниин","Мы вывели оттуда всех уверовавших,",["и вывели Мы","того, кто","был","там","из","верующих"]],[51,36,["فَمَا","وَجَدۡنَا","فِيهَا","غَيۡرَ","بَيۡتٖ","مِّنَ","ٱلۡمُسۡلِمِينَ"],"фама важадна фииха гайра байтим минал муслимиин","но нашли там только один дом с мусульманами.",["и не","нашли Мы","там","кроме","дома","из","мусульман"]],[51,37,["وَتَرَكۡنَا","فِيهَآ","ءَايَةٗ","لِّلَّذِينَ","يَخَافُونَ","ٱلۡعَذَابَ","ٱلۡأَلِيمَ"],"ватаракна фииха айатал лиллазиина йахафуунал `азабал алиим","Мы оставили там знамение для тех, которые боятся мучительных страданий.",["и оставили Мы","там","знамение","для тех, которые","боятся","наказания","мучительного"]],[51,38,["وَفِي","مُوسَىٰٓ","إِذۡ","أَرۡسَلۡنَٰهُ","إِلَىٰ","فِرۡعَوۡنَ","بِسُلۡطَٰنٖ","مُّبِينٖ"],"вафии мууса из арсалнаху ила фир`ауна бисултаним мубиин","Знамение было и в рассказе о Мусе (Моисее). Вот Мы отправили его к Фараону с явным доводом.",["и в","Мусе","когда","Мы послали его","к","Фараону","с доводом","ясным"]],[51,39,["فَتَوَلَّىٰ","بِرُكۡنِهِۦ","وَقَالَ","سَٰحِرٌ","أَوۡ","مَجۡنُونٞ"],"фатавалла бирукнихии ваḳала сахирун ау мажнуун","Он отвернулся в сторону (или вместе со своим окружением) и сказал: «Колдун или одержимый!».",["и отвернулся он","со своей опорой","и сказал","колдун","или","одержимый"]],[51,40,["فَأَخَذۡنَٰهُ","وَجُنُودَهُۥ","فَنَبَذۡنَٰهُمۡ","فِي","ٱلۡيَمِّ","وَهُوَ","مُلِيمٞ"],"фа'ахазнаху важунуудахуу фанабазнахум фил йамми вахуа мулиим","Мы схватили его вместе с войском и бросили их в море, и он был достоин порицания.",["и схватили Мы его","и войска его","и бросили Мы их","в","море","и он","достоин порицания"]],[51,41,["وَفِي","عَادٍ","إِذۡ","أَرۡسَلۡنَا","عَلَيۡهِمُ","ٱلرِّيحَ","ٱلۡعَقِيمَ"],"вафии `адин из арсална `алайхимур риихал `аḳиим","Знамение было и в рассказе об адитах. Вот Мы наслали на них недобрый ветер.",["и в","адитах","когда","Мы наслали","на них","ветер","бесплодный"]],[51,42,["مَا","تَذَرُ","مِن","شَيۡءٍ","أَتَتۡ","عَلَيۡهِ","إِلَّا","جَعَلَتۡهُ","كَٱلرَّمِيمِ"],"ма тазару мин шай'ин атат `алайхи илла жа`алатху каррамиим","Он обращал в подобие праха все, на что налетал.",["не","оставлял он","ни одной","вещи","налетал он","на неё","без того, чтобы","сделать её","как истлевшее"]],[51,43,["وَفِي","ثَمُودَ","إِذۡ","قِيلَ","لَهُمۡ","تَمَتَّعُواْ","حَتَّىٰ","حِينٖ"],"вафии самууда из ḳиила лахум таматта`уу хатта хиин","Знамение было и в рассказе о самудянах. Им было сказано: «Пользуйтесь благами до определенного времени».",["и в","самудянах","когда","было сказано","им","наслаждайтесь","до","времени"]],[51,44,["فَعَتَوۡاْ","عَنۡ","أَمۡرِ","رَبِّهِمۡ","فَأَخَذَتۡهُمُ","ٱلصَّٰعِقَةُ","وَهُمۡ","يَنظُرُونَ"],"фа`атау `ан амри раббихим фа'ахазатхумус са`иḳату вахум йанзуруун","Они ослушались веления своего Господа, и их поразило губительное наказание, пока они наблюдали за этим.",["и ослушались они","от","веления","Господа их","и постигла их","молния","и они","смотрели"]],[51,45,["فَمَا","ٱسۡتَطَٰعُواْ","مِن","قِيَامٖ","وَمَا","كَانُواْ","مُنتَصِرِينَ"],"фамастата`уу мин ḳийамин вама кануу мунтасириин","Они не смогли даже подняться, и никто не помог им.",["и не","смогли они","даже","подняться","и не","были они","способны защититься"]],[51,46,["وَقَوۡمَ","نُوحٖ","مِّن","قَبۡلُۖ","إِنَّهُمۡ","كَانُواْ","قَوۡمٗا","فَٰسِقِينَ"],"ваḳаума нуухим мин ḳаблу иннахум кануу ḳауман фасиḳиин","Мы уничтожили народ Нуха (Ноя) еще раньше, ибо они были людьми нечестивыми.",["и народ","Нуха","ещё","прежде","поистине, они","были","народом","нечестивым"]],[51,47,["وَٱلسَّمَآءَ","بَنَيۡنَٰهَا","بِأَيۡيْدٖ","وَإِنَّا","لَمُوسِعُونَ"],"вассамаа банайнаха би'айдин ва'инна ламууси`уун","Мы воздвигли небо благодаря могуществу, и Мы его расширяем (или даруем пропитание; или обладаем мощью).",["и небо","Мы воздвигли его","мощью","и поистине, Мы","непременно расширяющие"]],[51,48,["وَٱلۡأَرۡضَ","فَرَشۡنَٰهَا","فَنِعۡمَ","ٱلۡمَٰهِدُونَ"],"вал'арда фарашнаха фани`мал махидуун","Мы разостлали землю, и как же прекрасно Мы расстилаем!",["и землю","Мы постлали её","и как прекрасны","расстилающие"]],[51,49,["وَمِن","كُلِّ","شَيۡءٍ","خَلَقۡنَا","زَوۡجَيۡنِ","لَعَلَّكُمۡ","تَذَكَّرُونَ"],"вамин кулли шай'ин халаḳна заужайни ла`аллакум тазаккаруун","Мы сотворили все сущее парами, - быть может, вы помяните назидание.",["и из","всякой","вещи","Мы сотворили","пары","может быть, вы","помянете назидание"]],[51,50,["فَفِرُّوٓاْ","إِلَى","ٱللَّهِۖ","إِنِّي","لَكُم","مِّنۡهُ","نَذِيرٞ","مُّبِينٞ"],"фафирруу илаллахи иннии лакум минху назиирум мубиин","Скажи: «Бегите же к Аллаху. Воистину, я являюсь для вас предостерегающим и разъясняющим увещевателем от Него.",["бегите же","к","Аллаху","поистине, я","для вас","от Него","увещеватель","ясный"]],[51,51,["وَلَا","تَجۡعَلُواْ","مَعَ","ٱللَّهِ","إِلَٰهًا","ءَاخَرَۖ","إِنِّي","لَكُم","مِّنۡهُ","نَذِيرٞ","مُّبِينٞ"],"вала таж`алуу ма`аллахи илахан ахара иннии лакум минху назиирум мубиин","Не поклоняйтесь наряду с Аллахом другому божеству. Воистину, я являюсь для вас предостерегающим и разъясняющим увещевателем от Него».",["и не","делайте","с","Аллахом","бога","другого","поистине, я","для вас","от Него","увещеватель","ясный"]]],"m":[[["۞ قَالَ","сказал он",51,31],["فَمَا","так каково",51,31],["خَطۡبُكُمۡ","дело ваше",51,31],["أَيُّهَا","о",51,31],["ٱلۡمُرۡسَلُونَ","посланные",51,31],[31],["قَالُوٓاْ","сказали они",51,32],["إِنَّآ","поистине, мы",51,32],["أُرۡسِلۡنَآ","посланы мы",51,32],["إِلَىٰ","к",51,32],["قَوۡمٖ","людям",51,32]],[["مُّجۡرِمِينَ","грешным",51,32],[32],["لِنُرۡسِلَ","чтобы наслать нам",51,33],["عَلَيۡهِمۡ","на них",51,33],["حِجَارَةٗ","камни",51,33],["مِّن","из",51,33],["طِينٖ","глины",51,33],[33],["مُّسَوَّمَةً","помеченные",51,34],["عِندَ","у",51,34],["رَبِّكَ","Господа твоего",51,34]],[["لِلۡمُسۡرِفِينَ","для излишествующих",51,34],[34],["فَأَخۡرَجۡنَا","и вывели Мы",51,35],["مَن","того, кто",51,35],["كَانَ","был",51,35],["فِيهَا","там",51,35],["مِنَ","из",51,35],["ٱلۡمُؤۡمِنِينَ","верующих",51,35],[35],["فَمَا","и не",51,36],["وَجَدۡنَا","нашли Мы",51,36]],[["فِيهَا","там",51,36],["غَيۡرَ","кроме",51,36],["بَيۡتٖ","дома",51,36],["مِّنَ","из",51,36],["ٱلۡمُسۡلِمِينَ","мусульман",51,36],[36],["وَتَرَكۡنَا","и оставили Мы",51,37],["فِيهَآ","там",51,37],["ءَايَةٗ","знамение",51,37],["لِّلَّذِينَ","для тех, которые",51,37],["يَخَافُونَ","боятся",51,37]],[["ٱلۡعَذَابَ","наказания",51,37],["ٱلۡأَلِيمَ","мучительного",51,37],[37],["وَفِي","и в",51,38],["مُوسَىٰٓ","Мусе",51,38],["إِذۡ","когда",51,38],["أَرۡسَلۡنَٰهُ","Мы послали его",51,38],["إِلَىٰ","к",51,38],["فِرۡعَوۡنَ","Фараону",51,38],["بِسُلۡطَٰنٖ","с доводом",51,38]],[["مُّبِينٖ","ясным",51,38],[38],["فَتَوَلَّىٰ","и отвернулся он",51,39],["بِرُكۡنِهِۦ","со своей опорой",51,39],["وَقَالَ","и сказал",51,39],["سَٰحِرٌ","колдун",51,39],["أَوۡ","или",51,39],["مَجۡنُونٞ","одержимый",51,39],[39],["فَأَخَذۡنَٰهُ","и схватили Мы его",51,40],["وَجُنُودَهُۥ","и войска его",51,40]],[["فَنَبَذۡنَٰهُمۡ","и бросили Мы их",51,40],["فِي","в",51,40],["ٱلۡيَمِّ","море",51,40],["وَهُوَ","и он",51,40],["مُلِيمٞ","достоин порицания",51,40],[40],["وَفِي","и в",51,41],["عَادٍ","адитах",51,41],["إِذۡ","когда",51,41],["أَرۡسَلۡنَا","Мы наслали",51,41],["عَلَيۡهِمُ","на них",51,41],["ٱلرِّيحَ","ветер",51,41]],[["ٱلۡعَقِيمَ","бесплодный",51,41],[41],["مَا","не",51,42],["تَذَرُ","оставлял он",51,42],["مِن","ни одной",51,42],["شَيۡءٍ","вещи",51,42],["أَتَتۡ","налетал он",51,42],["عَلَيۡهِ","на неё",51,42],["إِلَّا","без того, чтобы",51,42],["جَعَلَتۡهُ","сделать её",51,42],["كَٱلرَّمِيمِ","как истлевшее",51,42],[42]],[["وَفِي","и в",51,43],["ثَمُودَ","самудянах",51,43],["إِذۡ","когда",51,43],["قِيلَ","было сказано",51,43],["لَهُمۡ","им",51,43],["تَمَتَّعُواْ","наслаждайтесь",51,43],["حَتَّىٰ","до",51,43],["حِينٖ","времени",51,43],[43],["فَعَتَوۡاْ","и ослушались они",51,44],["عَنۡ","от",51,44],["أَمۡرِ","веления",51,44],["رَبِّهِمۡ","Господа их",51,44]],[["فَأَخَذَتۡهُمُ","и постигла их",51,44],["ٱلصَّٰعِقَةُ","молния",51,44],["وَهُمۡ","и они",51,44],["يَنظُرُونَ","смотрели",51,44],[44],["فَمَا","и не",51,45],["ٱسۡتَطَٰعُواْ","смогли они",51,45],["مِن","даже",51,45],["قِيَامٖ","подняться",51,45]],[["وَمَا","и не",51,45],["كَانُواْ","были они",51,45],["مُنتَصِرِينَ","способны защититься",51,45],[45],["وَقَوۡمَ","и народ",51,46],["نُوحٖ","Нуха",51,46],["مِّن","ещё",51,46],["قَبۡلُۖ","прежде",51,46],["إِنَّهُمۡ","поистине, они",51,46],["كَانُواْ","были",51,46],["قَوۡمٗا","народом",51,46]],[["فَٰسِقِينَ","нечестивым",51,46],[46],["وَٱلسَّمَآءَ","и небо",51,47],["بَنَيۡنَٰهَا","Мы воздвигли его",51,47],["بِأَيۡيْدٖ","мощью",51,47],["وَإِنَّا","и поистине, Мы",51,47],["لَمُوسِعُونَ","непременно расширяющие",51,47],[47],["وَٱلۡأَرۡضَ","и землю",51,48]],[["فَرَشۡنَٰهَا","Мы постлали её",51,48],["فَنِعۡمَ","и как прекрасны",51,48],["ٱلۡمَٰهِدُونَ","расстилающие",51,48],[48],["وَمِن","и из",51,49],["كُلِّ","всякой",51,49],["شَيۡءٍ","вещи",51,49],["خَلَقۡنَا","Мы сотворили",51,49],["زَوۡجَيۡنِ","пары",51,49]],[["لَعَلَّكُمۡ","может быть, вы",51,49],["تَذَكَّرُونَ","помянете назидание",51,49],[49],["فَفِرُّوٓاْ","бегите же",51,50],["إِلَى","к",51,50],["ٱللَّهِۖ","Аллаху",51,50],["إِنِّي","поистине, я",51,50],["لَكُم","для вас",51,50],["مِّنۡهُ","от Него",51,50],["نَذِيرٞ","увещеватель",51,50],["مُّبِينٞ","ясный",51,50],[50]],[["وَلَا","и не",51,51],["تَجۡعَلُواْ","делайте",51,51],["مَعَ","с",51,51],["ٱللَّهِ","Аллахом",51,51],["إِلَٰهًا","бога",51,51],["ءَاخَرَۖ","другого",51,51],["إِنِّي","поистине, я",51,51],["لَكُم","для вас",51,51],["مِّنۡهُ","от Него",51,51],["نَذِيرٞ","увещеватель",51,51],["مُّبِينٞ","ясный",51,51],[51]]]}