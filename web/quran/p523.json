{"p":523,"j":27,"a":[[51,52,["كَذَٰلِكَ","مَآ","أَتَى","ٱلَّذِينَ","مِن","قَبۡلِهِم","مِّن","رَّسُولٍ","إِلَّا","قَالُواْ","سَاحِرٌ","أَوۡ","مَجۡنُونٌ"],"казалика ма атал лазиина мин ḳаблихим мир расуулин илла ḳалуу сахирун ау мажнуун","Таким же образом, какой бы посланник ни приходил к их предшественникам, они обязательно говорили: «Он - колдун или одержимый!».",["так же","не","приходил","к тем, которые","(были) до","них","никакой","посланник","без того, чтобы","сказали они","колдун","или","одержимый"]],[51,53,["أَتَوَاصَوۡاْ","بِهِۦۚ","بَلۡ","هُمۡ","قَوۡمٞ","طَاغُونَ"],"атавасау бихии бал хум ḳаумун тагуун","Неужели они заповедали это друг другу? О нет! Они являются людьми, преступающими границы дозволенного.",["разве заповедали друг другу","это","нет","они","люди","бесчинствующие"]],[51,54,["فَتَوَلَّ","عَنۡهُمۡ","فَمَآ","أَنتَ","بِمَلُومٖ"],"фатавалла `анхум фама анта бималуум","Отвратись же от них, и тебя не будут порицать.",["отвернись же","от них","и не","ты","порицаем"]],[51,55,["وَذَكِّرۡ","فَإِنَّ","ٱلذِّكۡرَىٰ","تَنفَعُ","ٱلۡمُؤۡمِنِينَ"],"вазаккир фа'инназ зикра танфа`ул му'миниин","И напоминай, ибо напоминание приносит пользу верующим.",["и напоминай","ибо поистине","напоминание","приносит пользу","верующим"]],[51,56,["وَمَا","خَلَقۡتُ","ٱلۡجِنَّ","وَٱلۡإِنسَ","إِلَّا","لِيَعۡبُدُونِ"],"вама халаḳтул жинна вал'инса илла лийа`будуун","Я сотворил джиннов и людей только для того, чтобы они поклонялись Мне.",["и не","сотворил Я","джиннов","и людей","кроме как","чтобы поклонялись они Мне"]],[51,57,["مَآ","أُرِيدُ","مِنۡهُم","مِّن","رِّزۡقٖ","وَمَآ","أُرِيدُ","أَن","يُطۡعِمُونِ"],"ма урииду минхум мир ризḳин вама урииду ан йут`имуун","Я не хочу от них никакого удела и не хочу, чтобы они кормили Меня.",["не","хочу Я","от них","никакого","удела","и не","хочу Я","чтобы","кормили они Меня"]],[51,58,["إِنَّ","ٱللَّهَ","هُوَ","ٱلرَّزَّاقُ","ذُو","ٱلۡقُوَّةِ","ٱلۡمَتِينُ"],"инналлаха хуар раззаḳу зул ḳувватил матиин","Воистину, Аллах является Наделяющим уделом, Обладающим могуществом, Крепким.",["поистине","Аллах","Он","Наделяющий уделом","Обладатель","силы","Крепкий"]],[51,59,["فَإِنَّ","لِلَّذِينَ","ظَلَمُواْ","ذَنُوبٗا","مِّثۡلَ","ذَنُوبِ","أَصۡحَٰبِهِمۡ","فَلَا","يَسۡتَعۡجِلُونِ"],"фа'инна лиллазиина заламуу зануубам мисла занууби асхабихим фала йаста`жилуун","Воистину, тем, которые поступали несправедливо, уготована доля наказания, подобная доле их товарищей. Пусть же они не торопят Меня.",["и поистине","для тех, которые","поступали несправедливо","доля","подобная","доле","товарищей их","пусть же не","торопят они Меня"]],[51,60,["فَوَيۡلٞ","لِّلَّذِينَ","كَفَرُواْ","مِن","يَوۡمِهِمُ","ٱلَّذِي","يُوعَدُونَ"],"фавайлул лиллазиина кафаруу мин йаумихимул лазии йуу`адуун","Горе неверующим от того дня их, который им обещан!",["так горе","тем, которые","не уверовали","от","их дня","который","им обещан"]],[52,1,["وَٱلطُّورِ"],"ваттуур","Клянусь горой!",["клянусь горой (Тур)"]],[52,2,["وَكِتَٰبٖ","مَّسۡطُورٖ"],"вакитабим мастуур","Клянусь Писанием, начертанным",["и Писанием","начертанным"]],[52,3,["فِي","رَقّٖ","مَّنشُورٖ"],"фии раḳḳим маншуур","на развернутой нежной коже!",["на","свитке","развёрнутом"]],[52,4,["وَٱلۡبَيۡتِ","ٱلۡمَعۡمُورِ"],"валбайтил ма`муур","Клянусь домом наполненным (храмом на седьмом небе)!",["и Домом","посещаемым"]],[52,5,["وَٱلسَّقۡفِ","ٱلۡمَرۡفُوعِ"],"вассаḳфил марфуу`","Клянусь кровлей возведенной!",["и кровлей","вознесённой"]],[52,6,["وَٱلۡبَحۡرِ","ٱلۡمَسۡجُورِ"],"валбахрил масжуур","Клянусь морем разожженным (или переполненным; или опустевшим; или перемешанным; или удерживаемым)!",["и морем","разожжённым"]],[52,7,["إِنَّ","عَذَابَ","رَبِّكَ","لَوَٰقِعٞ"],"инна `азаба раббика лаваḳи`","Наказание твоего Господа непременно наступит,",["поистине","наказание","Господа твоего","непременно наступит"]],[52,8,["مَّا","لَهُۥ","مِن","دَافِعٖ"],"мма лахуу мин дафи`","и ничто не отвратит его.",["нет","для него","никакого","отвращающего"]],[52,9,["يَوۡمَ","تَمُورُ","ٱلسَّمَآءُ","مَوۡرٗا"],"йаума тамуурус самау маура","В тот день небо содрогнется от колебаний,",["в день, когда","заколеблется","небо","колебанием"]],[52,10,["وَتَسِيرُ","ٱلۡجِبَالُ","سَيۡرٗا"],"ватасиирул жибалу сайра","а горы придут в движение.",["и сдвинутся","горы","движением"]],[52,11,["فَوَيۡلٞ","يَوۡمَئِذٖ","لِّلۡمُكَذِّبِينَ"],"фавайлун йаумаизил лилмуказзибиин","Горе в тот день тем, кто считает истину ложью,",["и горе","в тот день","считающим ложью"]],[52,12,["ٱلَّذِينَ","هُمۡ","فِي","خَوۡضٖ","يَلۡعَبُونَ"],"аллазиина хум фии хаудин йал`абуун","кто забавляется, предаваясь празднословию.",["те, которые","они","в","празднословии","забавляются"]],[52,13,["يَوۡمَ","يُدَعُّونَ","إِلَىٰ","نَارِ","جَهَنَّمَ","دَعًّا"],"йаума йуда``ууна ила нари жаханнама да``а","В тот день они будут нещадно ввергнуты в огонь Геенны.",["в день, когда","будут толкаемы они","в","огонь","Геенны","толчком"]],[52,14,["هَٰذِهِ","ٱلنَّارُ","ٱلَّتِي","كُنتُم","بِهَا","تُكَذِّبُونَ"],"хазихин нарул латии кунтум биха туказзибуун","Это - тот самый Огонь, который вы считали ложью.",["этот","Огонь","который","вы были","его","считаете ложью"]]],"m":[[["كَذَٰلِكَ","так же",51,52],["مَآ","не",51,52],["أَتَى","приходил",51,52],["ٱلَّذِينَ","к тем, которые",51,52],["مِن","(были) до",51,52],["قَبۡلِهِم","них",51,52],["مِّن","никакой",51,52],["رَّسُولٍ","посланник",51,52],["إِلَّا","без того, чтобы",51,52],["قَالُواْ","сказали они",51,52],["سَاحِرٌ","колдун",51,52],["أَوۡ","или",51,52],["مَجۡنُونٌ","одержимый",51,52]],[[52],["أَتَوَاصَوۡاْ","разве заповедали друг другу",51,53],["بِهِۦۚ","это",51,53],["بَلۡ","нет",51,53],["هُمۡ","они",51,53],["قَوۡمٞ","люди",51,53],["طَاغُونَ","бесчинствующие",51,53],[53],["فَتَوَلَّ","отвернись же",51,54],["عَنۡهُمۡ","от них",51,54],["فَمَآ","и не",51,54],["أَنتَ","ты",51,54]],[["بِمَلُومٖ","порицаем",51,54],[54],["وَذَكِّرۡ","и напоминай",51,55],["فَإِنَّ","ибо поистине",51,55],["ٱلذِّكۡرَىٰ","напоминание",51,55],["تَنفَعُ","приносит пользу",51,55],["ٱلۡمُؤۡمِنِينَ","верующим",51,55],[55],["وَمَا","и не",51,56