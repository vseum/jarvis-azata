{"p":524,"j":27,"a":[[52,15,["أَفَسِحۡرٌ","هَٰذَآ","أَمۡ","أَنتُمۡ","لَا","تُبۡصِرُونَ"],"афасихрун хаза ам антум ла тубсируун","Неужели это колдовство? Или же вы не видите?",["разве колдовство","это","или","вы","не","видите"]],[52,16,["ٱصۡلَوۡهَا","فَٱصۡبِرُوٓاْ","أَوۡ","لَا","تَصۡبِرُواْ","سَوَآءٌ","عَلَيۡكُمۡۖ","إِنَّمَا","تُجۡزَوۡنَ","مَا","كُنتُمۡ","تَعۡمَلُونَ"],"ислауха фасбируу ау ла тасбируу саваун `алайкум иннама тужзауна ма кунтум та`малуун","Горите в нем! Вам все равно, будете вы терпеть или не станете проявлять терпения. Вам воздается только за то, что вы совершали.",["горите в нём","и терпите","или","не","терпите","одинаково","для вас","лишь","воздаётся вам","за то, что","вы были","совершаете"]],[52,17,["إِنَّ","ٱلۡمُتَّقِينَ","فِي","جَنَّٰتٖ","وَنَعِيمٖ"],"иннал муттаḳиина фии жаннатин вана`иим","Воистину, богобоязненные пребудут в Райских садах и блаженстве.",["поистине","богобоязненные","в","садах","и блаженстве"]],[52,18,["فَٰكِهِينَ","بِمَآ","ءَاتَىٰهُمۡ","رَبُّهُمۡ","وَوَقَىٰهُمۡ","رَبُّهُمۡ","عَذَابَ","ٱلۡجَحِيمِ"],"факихиина бима атахум раббухум ваваḳахум раббухум `азабал жахиим","Они будут радоваться тому, чем их одарит их Господь. Господь их уберег их от мучений в Аду.",["наслаждаясь","тем, что","даровал им","их Господь","и уберёг их","их Господь","от наказания","Ада"]],[52,19,["كُلُواْ","وَٱشۡرَبُواْ","هَنِيٓـَٔۢا","بِمَا","كُنتُمۡ","تَعۡمَلُونَ"],"кулуу вашрабуу ханииа бима кунтум та`малуун","Ешьте и пейте во здравие за то, что вы совершали!",["ешьте","и пейте","во здравие","за то, что","вы были","совершаете"]],[52,20,["مُتَّكِـِٔينَ","عَلَىٰ","سُرُرٖ","مَّصۡفُوفَةٖۖ","وَزَوَّجۡنَٰهُم","بِحُورٍ","عِينٖ"],"муттаки'иина `ала сурурим масфууфатин вазавважнахум бихуурин `иин","Они будут, прислонившись, возлежать на ложах, выстроенных в ряд, и Мы сочетаем их с черноокими, большеглазыми гуриями.",["возлежа","на","ложах","выстроенных в ряд","и Мы сочетали их","с черноокими","большеглазыми"]],[52,21,["وَٱلَّذِينَ","ءَامَنُواْ","وَٱتَّبَعَتۡهُمۡ","ذُرِّيَّتُهُم","بِإِيمَٰنٍ","أَلۡحَقۡنَا","بِهِمۡ","ذُرِّيَّتَهُمۡ","وَمَآ","أَلَتۡنَٰهُم","مِّنۡ","عَمَلِهِم","مِّن","شَيۡءٖۚ","كُلُّ","ٱمۡرِيِٕۭ","بِمَا","كَسَبَ","رَهِينٞ"],"валлазиина амануу ваттаба`атхум зурриййатухум би'ииманин алхаḳна бихим зурриййатахум вама алатнахум мин `амалихим мин шай'ин куллумрийи бима касаба рахиин","Мы воссоединим верующих с их потомками, которые последовали за ними в вере, и нисколько не умалим их деяний. Каждый человек является заложником того, что он приобрел.",["и те, которые","уверовали","и последовало за ними","их потомство","в вере","Мы присоединим","к ним","их потомство","и не","умалили Мы им","из","их деяний","ничего из","чего-либо","каждый","человек","за то, что","приобрёл","заложник"]],[52,22,["وَأَمۡدَدۡنَٰهُم","بِفَٰكِهَةٖ","وَلَحۡمٖ","مِّمَّا","يَشۡتَهُونَ"],"ва'амдаднахум бифакихатин валахмим мимма йаштахуун","Мы наделим их фруктами и мясом таким, какое они пожелают.",["и Мы снабдили их","фруктами","и мясом","из того, что","они желают"]],[52,23,["يَتَنَٰزَعُونَ","فِيهَا","كَأۡسٗا","لَّا","لَغۡوٞ","فِيهَا","وَلَا","تَأۡثِيمٞ"],"йатаназа`ууна фииха ка'сал ла лагвун фииха вала та'сиим","Они будут передавать друг другу чашу с вином, которое не принесет ни празднословия, ни греха.",["передают друг другу","там","чашу","нет","пустословия","в ней","и нет","греха"]],[52,24,["وَيَطُوفُ","عَلَيۡهِمۡ","غِلۡمَانٞ","لَّهُمۡ","كَأَنَّهُمۡ","لُؤۡلُؤٞ","مَّكۡنُونٞ"],"вайатууфу `алайхим гилманул лахум ка'аннахум лу'луум макнуун","Их будут обходить их юные слуги, подобные сокрытому жемчугу.",["и обходят","их","юноши","их","словно они","жемчуг","сокрытый"]],[52,25,["وَأَقۡبَلَ","بَعۡضُهُمۡ","عَلَىٰ","بَعۡضٖ","يَتَسَآءَلُونَ"],"ва'аḳбала ба`духум `ала ба`дин йатасаалуун","Они будут расспрашивать друг друга.",["и обратятся","одни из них","к","другим","расспрашивая друг друга"]],[52,26,["قَالُوٓاْ","إِنَّا","كُنَّا","قَبۡلُ","فِيٓ","أَهۡلِنَا","مُشۡفِقِينَ"],"ḳалуу инна кунна ḳаблу фии ахлина мушфиḳиин","Они скажут: «Прежде, находясь в кругу своих семей, мы трепетали от страха.",["сказали они","поистине, мы","были","прежде","среди","наших семей","трепещущими"]],[52,27,["فَمَنَّ","ٱللَّهُ","عَلَيۡنَا","وَوَقَىٰنَا","عَذَابَ","ٱلسَّمُومِ"],"фаманналлаху `алайна ваваḳана `азабас самуум","Аллах же оказал нам милость и уберег нас от мучений знойного ветра (или мучений в Аду).",["и оказал милость","Аллах","нам","и уберёг нас","от наказания","знойного ветра"]],[52,28,["إِنَّا","كُنَّا","مِن","قَبۡلُ","نَدۡعُوهُۖ","إِنَّهُۥ","هُوَ","ٱلۡبَرُّ","ٱلرَّحِيمُ"],"инна кунна мин ḳаблу над`ууху иннахуу хуал баррур рахиим","Мы взывали к Нему прежде. Воистину, Он - Добродетельный, Милосердный».",["поистине, мы","были","из","прежде","взываем к Нему","поистине, Он","Он","Добродетельный","Милосердный"]],[52,29,["فَذَكِّرۡ","فَمَآ","أَنتَ","بِنِعۡمَتِ","رَبِّكَ","بِكَاهِنٖ","وَلَا","مَجۡنُونٍ"],"фазаккир фама анта бини`мати раббика бикахинин вала мажнуун","Напоминай же! По милости своего Господа ты не являешься ни прорицателем, ни одержимым.",["напоминай же","и не","ты","по милости","твоего Господа","прорицатель","и не","одержимый"]],[52,30,["أَمۡ","يَقُولُونَ","شَاعِرٞ","نَّتَرَبَّصُ","بِهِۦ","رَيۡبَ","ٱلۡمَنُونِ"],"ам йаḳуулууна ша`ирун натараббасу бихии райбал мануун","Или же они говорят: «Он - поэт! Давайте же подождем, пока время не разберется с ним».",["или","говорят они","поэт","выжидаем мы","для него","превратностей","судьбы (смерти)"]],[52,31,["قُلۡ","تَرَبَّصُواْ","فَإِنِّي","مَعَكُم","مِّنَ","ٱلۡمُتَرَبِّصِينَ"],"ḳул тараббасуу фа'иннии ма`акум минал мутараббисиин","Скажи: «Ждите, и я подожду вместе с вами».",["скажи","выжидайте","и поистине, я","с вами","из","выжидающих"]]],"m":[[["أَفَسِحۡرٌ","разве колдовство",52,15],["هَٰذَآ","это",52,15],["أَمۡ","или",52,15],["أَنتُمۡ","вы",52,15],["لَا","не",52,15],["تُبۡصِرُونَ","видите",52,15],[15],["ٱصۡلَوۡهَا","горите в нём",52,16],["فَٱصۡبِرُوٓاْ","и терпите",52,16]],[["أَوۡ","или",52,16],["لَا","не",52,16],["تَصۡبِرُواْ","терпите",52,16],["سَوَآءٌ","одинаково",5