{"p":525,"j":27,"a":[[52,32,["أَمۡ","تَأۡمُرُهُمۡ","أَحۡلَٰمُهُم","بِهَٰذَآۚ","أَمۡ","هُمۡ","قَوۡمٞ","طَاغُونَ"],"ам та'мурухум ахламухум бихаза ам хум ḳаумун тагуун","Неужели умы повелевают им такое? Или же они являются людьми преступными?",["или","повелевают им","их умы","это","или","они","народ","преступающие"]],[52,33,["أَمۡ","يَقُولُونَ","تَقَوَّلَهُۥۚ","بَل","لَّا","يُؤۡمِنُونَ"],"ам йаḳуулууна таḳаввалахуу бал ла йу'минуун","Или же они говорят: «Он выдумал его!». О нет! Просто они не веруют.",["или","говорят они","выдумал он его","нет же","не","веруют они"]],[52,34,["فَلۡيَأۡتُواْ","بِحَدِيثٖ","مِّثۡلِهِۦٓ","إِن","كَانُواْ","صَٰدِقِينَ"],"фалйа'туу бихадиисим мислихии ин кануу садиḳиин","Пусть приведут подобное ему (Корану) повествование, если они говорят правду.",["так пусть приведут","повествование","подобное ему","если","они являются","правдивыми"]],[52,35,["أَمۡ","خُلِقُواْ","مِنۡ","غَيۡرِ","شَيۡءٍ","أَمۡ","هُمُ","ٱلۡخَٰلِقُونَ"],"ам хулиḳуу мин гайри шай'ин ам хумул халиḳуун","Неужели они были сотворены сами по себе (или просто так)? Или же они сами являются творцами?",["или","сотворены они","из","ничего","чего-либо","или","они","творцы"]],[52,36,["أَمۡ","خَلَقُواْ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضَۚ","بَل","لَّا","يُوقِنُونَ"],"ам халаḳус самавати вал'арда бал ла йууḳинуун","Или же это они сотворили небеса и землю? О нет! Просто они лишены убежденности.",["или","сотворили они","небеса","и землю","нет же","не","убеждены они"]],[52,37,["أَمۡ","عِندَهُمۡ","خَزَآئِنُ","رَبِّكَ","أَمۡ","هُمُ","ٱلۡمُصَۜيۡطِرُونَ"],"ам `индахум хазаину раббика ам хумул мусайтируун","Неужели у них находятся сокровищницы твоего Господа? Или же они сами являются владыками?",["или","у них","сокровищницы","твоего Господа","или","они","властители"]],[52,38,["أَمۡ","لَهُمۡ","سُلَّمٞ","يَسۡتَمِعُونَ","فِيهِۖ","فَلۡيَأۡتِ","مُسۡتَمِعُهُم","بِسُلۡطَٰنٖ","مُّبِينٍ"],"ам лахум сулламун йастами`ууна фиихи фалйа'ти мустами`ухум бисултаним мубиин","Или же у них есть лестница, на которой они подслушивают разговоры ангелов? Пусть тот из них, кто подслушивал, приведет ясное доказательство.",["или","у них","лестница","подслушивают они","на ней","пусть же приведёт","подслушивающий из них","доказательство","ясное"]],[52,39,["أَمۡ","لَهُ","ٱلۡبَنَٰتُ","وَلَكُمُ","ٱلۡبَنُونَ"],"ам лахул банату валакумул бануун","Неужели у Него - дочери, а у вас - сыновья?",["или","у Него","дочери","а у вас","сыновья"]],[52,40,["أَمۡ","تَسۡـَٔلُهُمۡ","أَجۡرٗا","فَهُم","مِّن","مَّغۡرَمٖ","مُّثۡقَلُونَ"],"ам тас'алухум ажран фахум мим маграмим мусḳалуун","Или же ты просишь у них вознаграждения, и они обременены обязательствами?",["или","просишь ты у них","платы","и они","от","долга","обременены"]],[52,41,["أَمۡ","عِندَهُمُ","ٱلۡغَيۡبُ","فَهُمۡ","يَكۡتُبُونَ"],"ам `индахумул гайбу фахум йактубуун","Или же они владеют сокровенным и записывают его?",["или","у них","сокровенное","и они","записывают"]],[52,42,["أَمۡ","يُرِيدُونَ","كَيۡدٗاۖ","فَٱلَّذِينَ","كَفَرُواْ","هُمُ","ٱلۡمَكِيدُونَ"],"ам йуриидууна кайдан фаллазиина кафаруу хумул макиидуун","Или же они желают замыслить козни? Но ведь неверующие сами станут жертвой козней.",["или","желают они","козни","но те, которые","не уверовали","они","жертвы козней"]],[52,43,["أَمۡ","لَهُمۡ","إِلَٰهٌ","غَيۡرُ","ٱللَّهِۚ","سُبۡحَٰنَ","ٱللَّهِ","عَمَّا","يُشۡرِكُونَ"],"ам лахум илахун гайруллахи субханаллахи `амма йушрикуун","Или же у них есть другой бог наряду с Аллахом? Аллах пречист и далек от тех, кого они приобщают в сотоварищи!",["или","у них","бог","кроме","Аллаха","пречист","Аллах","от того, что","они приобщают"]],[52,44,["وَإِن","يَرَوۡاْ","كِسۡفٗا","مِّنَ","ٱلسَّمَآءِ","سَاقِطٗا","يَقُولُواْ","سَحَابٞ","مَّرۡكُومٞ"],"ва'ин йарау кисфам минас самаи саḳитан йаḳуулуу сахабум маркуум","Даже если они увидят куски неба падающими, они скажут: «Это скопились облака!».",["и если","увидят они","кусок","из","неба","падающим","скажут они","облака","нагромождённые"]],[52,45,["فَذَرۡهُمۡ","حَتَّىٰ","يُلَٰقُواْ","يَوۡمَهُمُ","ٱلَّذِي","فِيهِ","يُصۡعَقُونَ"],"фазархум хатта йулаḳуу йаумахумул лазии фиихи йус`аḳуун","Оставь же их, пока они не встретят тот день их, когда их постигнет погибель.",["оставь же их","пока не","встретят они","свой день","который","в него","будут поражены они"]],[52,46,["يَوۡمَ","لَا","يُغۡنِي","عَنۡهُمۡ","كَيۡدُهُمۡ","شَيۡـٔٗا","وَلَا","هُمۡ","يُنصَرُونَ"],"йаума ла йугнии `анхум кайдухум шай'ан вала хум йунсаруун","В тот день их козни не принесут им никакой пользы, и никто не поможет им.",["в день","не","избавят","от них","их козни","ничуть","и не","они","будут помогать им"]],[52,47,["وَإِنَّ","لِلَّذِينَ","ظَلَمُواْ","عَذَابٗا","دُونَ","ذَٰلِكَ","وَلَٰكِنَّ","أَكۡثَرَهُمۡ","لَا","يَعۡلَمُونَ"],"ва'инна лиллазиина заламуу `азабан дууна залика валакинна аксарахум ла йа`ламуун","Воистину, беззаконникам уготованы мучения и перед этим, но большинство их не знает этого.",["и поистине","для тех, которые","поступали несправедливо","наказание","помимо","этого","но","большинство их","не","знают"]],[52,48,["وَٱصۡبِرۡ","لِحُكۡمِ","رَبِّكَ","فَإِنَّكَ","بِأَعۡيُنِنَاۖ","وَسَبِّحۡ","بِحَمۡدِ","رَبِّكَ","حِينَ","تَقُومُ"],"васбир лихукми раббика фа'иннака би'а`йунина васаббих бихамди раббика хиина таḳуум","Потерпи же до решения твоего Господа, ведь ты - у Нас на Глазах. Прославляй хвалой своего Господа, когда поднимаешься ото сна.",["и терпи","до решения","твоего Господа","ведь поистине, ты","пред Нашими Глазами","и прославляй","с хвалой","твоего Господа","когда","встаёшь"]],[52,49,["وَمِنَ","ٱلَّيۡلِ","فَسَبِّحۡهُ","وَإِدۡبَٰرَ","ٱلنُّجُومِ"],"ваминал лайли фасаббихху ва'идбаран нужуум","Среди ночи восхваляй Его и при исчезновении звезд.",["и из","ночи","так славь Его","и при исчезновении","звезд"]]],"m":[[["أَمۡ","или",52,32],["تَأۡمُرُهُمۡ","повелевают им",52,32],["أَحۡلَٰمُهُم","их умы",52,32],["بِهَٰذَآۚ","это",52,32],["أَمۡ","или",52,32],["هُمۡ","они",52,32],["قَوۡمٞ","народ",52,32],["طَاغُونَ","преступающие",52,32],[32],["أَمۡ","или",52,33],["يَقُولُونَ","говорят они",52,33],["تَقَوَّلَهُۥۚ",