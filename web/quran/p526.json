{"p":526,"j":27,"a":[[53,1,["وَٱلنَّجۡمِ","إِذَا","هَوَىٰ"],"ваннажми иза хава","Клянусь звездой, когда она падает (или частью Корана, когда она нисходит)!",["клянусь звездой","когда","падает"]],[53,2,["مَا","ضَلَّ","صَاحِبُكُمۡ","وَمَا","غَوَىٰ"],"ма далла сахибукум вама гава","Не заблудился ваш товарищ и не сошел с пути.",["не","заблудился","ваш товарищ","и не","сбился с пути"]],[53,3,["وَمَا","يَنطِقُ","عَنِ","ٱلۡهَوَىٰٓ"],"вама йантиḳу `анил хава","Он не говорит по прихоти.",["и не","говорит он","по","прихоти"]],[53,4,["إِنۡ","هُوَ","إِلَّا","وَحۡيٞ","يُوحَىٰ"],"ин хуа илла вахйун йууха","Это - всего лишь внушаемое ему откровение.",["не","это","кроме","откровение","внушаемое"]],[53,5,["عَلَّمَهُۥ","شَدِيدُ","ٱلۡقُوَىٰ"],"`алламахуу шадиидул ḳуа","Научил его обладающий могучей силой",["научил его","сильный","мощью"]],[53,6,["ذُو","مِرَّةٖ","فَٱسۡتَوَىٰ"],"зуу мирратин фастава","и прекрасным сложением (или благоразумием). Он вознесся (или выпрямился)",["обладатель","крепости","и выпрямился он"]],[53,7,["وَهُوَ","بِٱلۡأُفُقِ","ٱلۡأَعۡلَىٰ"],"вахуа бил'уфуḳил а`ла","на наивысшем горизонте.",["и он","на горизонте","высшем"]],[53,8,["ثُمَّ","دَنَا","فَتَدَلَّىٰ"],"сумма дана фатадалла","Потом он приблизился и спустился.",["затем","приблизился он","и спустился"]],[53,9,["فَكَانَ","قَابَ","قَوۡسَيۡنِ","أَوۡ","أَدۡنَىٰ"],"факана ḳаба ḳаусайни ау адна","Он находился от него (Джибрил от Мухаммада или Мухаммад от Аллаха) на расстоянии двух луков или даже ближе.",["и был он","на расстоянии","двух луков","или","ближе"]],[53,10,["فَأَوۡحَىٰٓ","إِلَىٰ","عَبۡدِهِۦ","مَآ","أَوۡحَىٰ"],"фа'ауха ила `абдихии ма ауха","Он внушил Его рабу откровение,",["и внушил он","к","Его рабу","то, что","внушил"]],[53,11,["مَا","كَذَبَ","ٱلۡفُؤَادُ","مَا","رَأَىٰٓ"],"ма казабал фуаду ма ра'а","и сердце не солгало о том, что он увидел.",["не","солгало","сердце","о том, что","увидело"]],[53,12,["أَفَتُمَٰرُونَهُۥ","عَلَىٰ","مَا","يَرَىٰ"],"афатумаруунахуу `ала ма йара","Неужели вы будете препираться с ним о том, что он увидел?",["разве препираетесь вы с ним","о","том, что","он видит"]],[53,13,["وَلَقَدۡ","رَءَاهُ","نَزۡلَةً","أُخۡرَىٰ"],"валаḳад ра'аху назлатан ухра","Он уже видел его другое нисхождение",["и уже","видел он его","при нисхождении","другом"]],[53,14,["عِندَ","سِدۡرَةِ","ٱلۡمُنتَهَىٰ"],"`инда сидратил мунтаха","у Лотоса крайнего предела,",["у","лотоса","крайнего предела"]],[53,15,["عِندَهَا","جَنَّةُ","ٱلۡمَأۡوَىٰٓ"],"`индаха жаннатул ма'ва","возле которого находится Сад пристанища.",["возле него","Сад","Пристанища"]],[53,16,["إِذۡ","يَغۡشَى","ٱلسِّدۡرَةَ","مَا","يَغۡشَىٰ"],"из йагшас сидрата ма йагша","Тогда Лотос покрыло то, что покрыло (золотая саранча, или группы ангелов, или повеление Аллаха).",["когда","покрывало","лотос","то, что","покрывало"]],[53,17,["مَا","زَاغَ","ٱلۡبَصَرُ","وَمَا","طَغَىٰ"],"ма загал басару вама тага","Его же взор не уклонился в сторону и не излишествовал,",["не","уклонился","взор","и не","преступил"]],[53,18,["لَقَدۡ","رَأَىٰ","مِنۡ","ءَايَٰتِ","رَبِّهِ","ٱلۡكُبۡرَىٰٓ"],"лаḳад ра'а мин айати раббихил кубра","и он увидел величайшие из знамений своего Господа.",["уже","увидел он","из","знамений","своего Господа","величайшие"]],[53,19,["أَفَرَءَيۡتُمُ","ٱللَّٰتَ","وَٱلۡعُزَّىٰ"],"афараайтумул лата вал`узза","Не видели ли вы аль-Лат и аль-Уззу,",["видели ли вы","аль-Лат","и аль-Уззу"]],[53,20,["وَمَنَوٰةَ","ٱلثَّالِثَةَ","ٱلۡأُخۡرَىٰٓ"],"ваманаватас салисатал ухра","и еще третью - Манат?",["и Манат","третью","другую"]],[53,21,["أَلَكُمُ","ٱلذَّكَرُ","وَلَهُ","ٱلۡأُنثَىٰ"],"алакумуз закару валахул унса","Неужели у вас - потомки мужского пола, а у Него - женского?",["разве у вас","мужской пол","а у Него","женский пол"]],[53,22,["تِلۡكَ","إِذٗا","قِسۡمَةٞ","ضِيزَىٰٓ"],"тилка изан ḳисматун дииза","Это было бы несправедливым распределением.",["это","тогда","раздел","несправедливый"]],[53,23,["إِنۡ","هِيَ","إِلَّآ","أَسۡمَآءٞ","سَمَّيۡتُمُوهَآ","أَنتُمۡ","وَءَابَآؤُكُم","مَّآ","أَنزَلَ","ٱللَّهُ","بِهَا","مِن","سُلۡطَٰنٍۚ","إِن","يَتَّبِعُونَ","إِلَّا","ٱلظَّنَّ","وَمَا","تَهۡوَى","ٱلۡأَنفُسُۖ","وَلَقَدۡ","جَآءَهُم","مِّن","رَّبِّهِمُ","ٱلۡهُدَىٰٓ"],"ин хийа илла асмаун саммайтумууха антум ва'абаукум ма анзалаллаху биха мин султанин ин йаттаби`ууна иллаз занна вама тахвал анфусу валаḳад жаахум мир раббихимул худа","Они - всего лишь имена, которыми нарекли их вы и ваши отцы, относительно которых Аллах не ниспослал никакого доказательства. Они следуют лишь предположениям и тому, чего желают души, хотя верное руководство от их Господа уже явилось к ним.",["не","они","кроме","имена","назвали вы их","вы","и ваши отцы","не","ниспослал","Аллах","о них","никакого","доказательства","не","следуют они","кроме","предположения","и того, чего","желают","души","и уже","пришло к ним","от","их Господа","руководство"]],[53,24,["أَمۡ","لِلۡإِنسَٰنِ","مَا","تَمَنَّىٰ"],"ам лил'инсани ма таманна","Или же для человека уготовано то, чего он желает?",["или","у человека","то, что","пожелал он"]],[53,25,["فَلِلَّهِ","ٱلۡأٓخِرَةُ","وَٱلۡأُولَىٰ"],"фалиллахил ахирату вал'уула","Аллаху принадлежит Последняя жизнь и жизнь первая.",["ведь Аллаху","последняя (жизнь)","и первая"]],[53,26,["وَكَم","مِّن","مَّلَكٖ","فِي","ٱلسَّمَٰوَٰتِ","لَا","تُغۡنِي","شَفَٰعَتُهُمۡ","شَيۡـًٔا","إِلَّا","مِنۢ","بَعۡدِ","أَن","يَأۡذَنَ","ٱللَّهُ","لِمَن","يَشَآءُ","وَيَرۡضَىٰٓ"],"вакам мим малакин фис самавати ла тугнии шафа`атухум шай'ан илла мим ба`ди ан йа'заналлаху лиман йашау вайарда","Сколько же на небесах ангелов, заступничество которых не принесет никакой пользы, пока Аллах не позволит заступиться за тех, за кого Он пожелает и кем Он доволен!",["и сколько","из","ангелов","в","небесах","не","поможет","их заступничество","ничуть","кроме как","после","после","того, как","позволит","Аллах","кому","пожелает Он","и будет доволен"]]],"m":[["b"],[["وَٱلنَّجۡمِ","клянусь звездой",53,1],["إِذَا","когда",53,1],["هَوَىٰ","падает",53,1],[1],["مَا","не",53,2],["ضَلَّ","заблудился",53,2],["صَاحِبُكُمۡ","ваш товарищ",53,2],["وَمَا","и не",