{"p":526,"j":27,"a":[[53,1,["وَٱلنَّجۡمِ","إِذَا","هَوَىٰ"],"уаннаджми изаа хауаа","Клянусь звездой, когда она падает (или частью Корана, когда она нисходит)!",["клянусь звездой","когда","падает"]],[53,2,["مَا","ضَلَّ","صَاحِبُكُمۡ","وَمَا","غَوَىٰ"],"маа далла саахибукум уамаа гауаа","Не заблудился ваш товарищ и не сошел с пути.",["не","заблудился","ваш товарищ","и не","сбился с пути"]],[53,3,["وَمَا","يَنطِقُ","عَنِ","ٱلۡهَوَىٰٓ"],"уамаа йантику `ани лхауаа","Он не говорит по прихоти.",["и не","говорит он","по","прихоти"]],[53,4,["إِنۡ","هُوَ","إِلَّا","وَحۡيٞ","يُوحَىٰ"],"ин хууа иллаа уахйун йуухаа","Это - всего лишь внушаемое ему откровение.",["не","это","кроме","откровение","внушаемое"]],[53,5,["عَلَّمَهُۥ","شَدِيدُ","ٱلۡقُوَىٰ"],"`алламахуу шадииду лкууаа","Научил его обладающий могучей силой",["научил его","сильный","мощью"]],[53,6,["ذُو","مِرَّةٖ","فَٱسۡتَوَىٰ"],"зуу мирратин фастауаа","и прекрасным сложением (или благоразумием). Он вознесся (или выпрямился)",["обладатель","крепости","и выпрямился он"]],[53,7,["وَهُوَ","بِٱلۡأُفُقِ","ٱلۡأَعۡلَىٰ"],"уахууа бил'уфуки л'а`лаа","на наивысшем горизонте.",["и он","на горизонте","высшем"]],[53,8,["ثُمَّ","دَنَا","فَتَدَلَّىٰ"],"сумма данаа фатадаллаа","Потом он приблизился и спустился.",["затем","приблизился он","и спустился"]],[53,9,["فَكَانَ","قَابَ","قَوۡسَيۡنِ","أَوۡ","أَدۡنَىٰ"],"факаана кааба каусайни ау аднаа","Он находился от него (Джибрил от Мухаммада или Мухаммад от Аллаха) на расстоянии двух луков или даже ближе.",["и был он","на расстоянии","двух луков","или","ближе"]],[53,10,["فَأَوۡحَىٰٓ","إِلَىٰ","عَبۡدِهِۦ","مَآ","أَوۡحَىٰ"],"фа'аухаа илаа `абдихии маа аухаа","Он внушил Его рабу откровение,",["и внушил он","к","Его рабу","то, что","внушил"]],[53,11,["مَا","كَذَبَ","ٱلۡفُؤَادُ","مَا","رَأَىٰٓ"],"маа казаба лфу'ааду маа ра'аа","и сердце не солгало о том, что он увидел.",["не","солгало","сердце","о том, что","увидело"]],[53,12,["أَفَتُمَٰرُونَهُۥ","عَلَىٰ","مَا","يَرَىٰ"],"афатумааруунахуу `алаа маа йараа","Неужели вы будете препираться с ним о том, что он увидел?",["разве препираетесь вы с ним","о","том, что","он видит"]],[53,13,["وَلَقَدۡ","رَءَاهُ","نَزۡلَةً","أُخۡرَىٰ"],"уалакад ра'ааху назлатан ухраа","Он уже видел его другое нисхождение",["и уже","видел он его","при нисхождении","другом"]],[53,14,["عِندَ","سِدۡرَةِ","ٱلۡمُنتَهَىٰ"],"`инда сидрати лмунтахаа","у Лотоса крайнего предела,",["у","лотоса","крайнего предела"]],[53,15,["عِندَهَا","جَنَّةُ","ٱلۡمَأۡوَىٰٓ"],"`индахаа джаннату лма'уаа","возле которого находится Сад пристанища.",["возле него","Сад","Пристанища"]],[53,16,["إِذۡ","يَغۡشَى","ٱلسِّدۡرَةَ","مَا","يَغۡشَىٰ"],"из йагшаа ссидрата маа йагшаа","Тогда Лотос покрыло то, что покрыло (золотая саранча, или группы ангелов, или повеление Аллаха).",["когда","покрывало","лотос","то, что","покрывало"]],[53,17,["مَا","زَاغَ","ٱلۡبَصَرُ","وَمَا","طَغَىٰ"],"маа заага лбасару уамаа тагаа","Его же взор не уклонился в сторону и не излишествовал,",["не","уклонился","взор","и не","преступил"]],[53,18,["لَقَدۡ","رَأَىٰ","مِنۡ","ءَايَٰتِ","رَبِّهِ","ٱلۡكُبۡرَىٰٓ"],"лакад ра'аа мин аайаати раббихи лкубраа","и он увидел величайшие из знамений своего Господа.",["уже","увидел он","из","знамений","своего Господа","величайшие"]],[53,19,["أَفَرَءَيۡتُمُ","ٱللَّٰتَ","وَٱلۡعُزَّىٰ"],"афара'айтуму ллаата уал`уззаа","Не видели ли вы аль-Лат и аль-Уззу,",["видели ли вы","аль-Лат","и аль-Уззу"]],[53,20,["وَمَنَوٰةَ","ٱلثَّالِثَةَ","ٱلۡأُخۡرَىٰٓ"],"уаманауаата ссаалисата л'ухраа","и еще третью - Манат?",["и Манат","третью","другую"]],[53,21,["أَلَكُمُ","ٱلذَّكَرُ","وَلَهُ","ٱلۡأُنثَىٰ"],"алакуму ззакару уалаху л'унсаа","Неужели у вас - потомки мужского пола, а у Него - женского?",["разве у вас","мужской пол","а у Него","женский пол"]],[53,22,["تِلۡكَ","إِذٗا","قِسۡمَةٞ","ضِيزَىٰٓ"],"тилка изан кисматун диизаа","Это было бы несправедливым распределением.",["это","тогда","раздел","несправедливый"]],[53,23,["إِنۡ","هِيَ","إِلَّآ","أَسۡمَآءٞ","سَمَّيۡتُمُوهَآ","أَنتُمۡ","وَءَابَآؤُكُم","مَّآ","أَنزَلَ","ٱللَّهُ","بِهَا","مِن","سُلۡطَٰنٍۚ","إِن","يَتَّبِعُونَ","إِلَّا","ٱلظَّنَّ","وَمَا","تَهۡوَى","ٱلۡأَنفُسُۖ","وَلَقَدۡ","جَآءَهُم","مِّن","رَّبِّهِمُ","ٱلۡهُدَىٰٓ"],"ин хийа иллаа асмаа'ун саммайтумуухаа антум уа'аабаа'укум ммаа анзала ллаху бихаа мин султаанин ин йаттаби`ууна иллаа ззанна уамаа тахуаа л'анфусу уалакад джаа'ахум ммир раббихиму лхудаа","Они - всего лишь имена, которыми нарекли их вы и ваши отцы, относительно которых Аллах не ниспослал никакого доказательства. Они следуют лишь предположениям и тому, чего желают души, хотя верное руководство от их Господа уже явилось к ним.",["не","они","кроме","имена","назвали вы их","вы","и ваши отцы","не","ниспослал","Аллах","о них","никакого","доказательства","не","следуют они","кроме","предположения","и того, чего","желают","души","и уже","пришло к ним","от","их Господа","руководство"]],[53,24,["أَمۡ","لِلۡإِنسَٰنِ","مَا","تَمَنَّىٰ"],"ам лил'инсаани маа таманнаа","Или же для человека уготовано то, чего он желает?",["или","у человека","то, что","пожелал он"]],[53,25,["فَلِلَّهِ","ٱلۡأٓخِرَةُ","وَٱلۡأُولَىٰ"],"фалиллахи л'хирату уал'уулаа","Аллаху принадлежит Последняя жизнь и жизнь первая.",["ведь Аллаху","последняя (жизнь)","и первая"]],[53,26,["وَكَم","مِّن","مَّلَكٖ","فِي","ٱلسَّمَٰوَٰتِ","لَا","تُغۡنِي","شَفَٰعَتُهُمۡ","شَيۡـًٔا","إِلَّا","مِنۢ","بَعۡدِ","أَن","يَأۡذَنَ","ٱللَّهُ","لِمَن","يَشَآءُ","وَيَرۡضَىٰٓ"],"уакам ммим малакин фии ссамаауаати лаа тугнии шафаа`атухум шай'ан иллаа мим ба`ди ан йа'зана ллаху лиман йашаа'у уайардаа","Сколько же на небесах ангелов, заступничество которых не принесет никакой пользы, пока Аллах не позволит заступиться за тех, за кого Он пожелает и кем Он доволен!",["и сколько","из","ангелов","в","небесах","не","поможет","их заступничество","ничуть","кроме как","после","после","того, как","позволит","Аллах","кому","пожелает Он","и будет доволен"]]]}