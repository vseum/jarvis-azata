{"p":527,"j":27,"a":[[53,27,["إِنَّ","ٱلَّذِينَ","لَا","يُؤۡمِنُونَ","بِٱلۡأٓخِرَةِ","لَيُسَمُّونَ","ٱلۡمَلَٰٓئِكَةَ","تَسۡمِيَةَ","ٱلۡأُنثَىٰ"],"иннал лазиина ла йу'минууна бил'ахирати лайусаммуунал малаиката тасмийатал унса","Воистину, те, которые не веруют в Последнюю жизнь, называют ангелов женщинами.",["поистине","те, которые","не","веруют","в Последнюю жизнь","непременно называют","ангелов","именами","женского пола"]],[53,28,["وَمَا","لَهُم","بِهِۦ","مِنۡ","عِلۡمٍۖ","إِن","يَتَّبِعُونَ","إِلَّا","ٱلظَّنَّۖ","وَإِنَّ","ٱلظَّنَّ","لَا","يُغۡنِي","مِنَ","ٱلۡحَقِّ","شَيۡـٔٗا"],"вама лахум бихии мин `илмин ин йаттаби`ууна иллаз занна ва'инназ занна ла йугнии минал хаḳḳи шай'а","У них нет об этом никакого знания. Они следуют лишь предположениям, хотя предположения не могут заменить истину.",["и нет","у них","об этом","никакого","знания","не","следуют они","кроме","предположения","и поистине","предположение","не","заменяет","от","истины","ничуть"]],[53,29,["فَأَعۡرِضۡ","عَن","مَّن","تَوَلَّىٰ","عَن","ذِكۡرِنَا","وَلَمۡ","يُرِدۡ","إِلَّا","ٱلۡحَيَوٰةَ","ٱلدُّنۡيَا"],"фа'а`рид `ам ман тавалла `ан зикрина валам йурид иллал хайаватад дунйа","Отвернись же от того, кто отвернулся от Нашего Напоминания и не пожелал ничего, кроме мирской жизни.",["отвернись же","от","того, кто","отвернулся","от","Нашего Напоминания","и не","пожелал","кроме","жизни","мирской"]],[53,30,["ذَٰلِكَ","مَبۡلَغُهُم","مِّنَ","ٱلۡعِلۡمِۚ","إِنَّ","رَبَّكَ","هُوَ","أَعۡلَمُ","بِمَن","ضَلَّ","عَن","سَبِيلِهِۦ","وَهُوَ","أَعۡلَمُ","بِمَنِ","ٱهۡتَدَىٰ"],"залика маблагухум минал `илми инна раббака хуа а`ламу биман далла `ан сабиилихии вахуа а`ламу биманихтада","Таков предел их познаний. Воистину, твоему Господу лучше знать тех, кто сбился с Его пути, и лучше знать тех, кто последовал прямым путем.",["это","предел их","из","знания","поистине","твой Господь","Он","лучше знает","тех, кто","сбился","с","Его пути","и Он","лучше знает","тех, кто","последовал прямым путём"]],[53,31,["وَلِلَّهِ","مَا","فِي","ٱلسَّمَٰوَٰتِ","وَمَا","فِي","ٱلۡأَرۡضِ","لِيَجۡزِيَ","ٱلَّذِينَ","أَسَٰٓـُٔواْ","بِمَا","عَمِلُواْ","وَيَجۡزِيَ","ٱلَّذِينَ","أَحۡسَنُواْ","بِٱلۡحُسۡنَى"],"валиллахи ма фис самавати вама фил арди лийажзийал лазиина асауу бима `амилуу вайажзийал лазиина ахсануу билхусна","Аллаху принадлежит то, что на небесах, и то, что на земле, дабы Он воздал злодеям за то, что они совершили, и воздал творившим добро Наилучшим (Раем).",["и Аллаху","то, что","в","небесах","и то, что","на","земле","чтобы воздал Он","тем, которые","творили зло","за то, что","совершили они","и воздал","тем, которые","творили добро","наилучшим"]],[53,32,["ٱلَّذِينَ","يَجۡتَنِبُونَ","كَبَٰٓئِرَ","ٱلۡإِثۡمِ","وَٱلۡفَوَٰحِشَ","إِلَّا","ٱللَّمَمَۚ","إِنَّ","رَبَّكَ","وَٰسِعُ","ٱلۡمَغۡفِرَةِۚ","هُوَ","أَعۡلَمُ","بِكُمۡ","إِذۡ","أَنشَأَكُم","مِّنَ","ٱلۡأَرۡضِ","وَإِذۡ","أَنتُمۡ","أَجِنَّةٞ","فِي","بُطُونِ","أُمَّهَٰتِكُمۡۖ","فَلَا","تُزَكُّوٓاْ","أَنفُسَكُمۡۖ","هُوَ","أَعۡلَمُ","بِمَنِ","ٱتَّقَىٰٓ"],"аллазиина йажтанибууна кабаирал исми валфавахиша иллал ламама инна раббака васи`ул магфирати хуа а`ламу бикум из аншаакум минал арди ва'из антум ажиннатун фии бутууни уммахатикум фала тузаккуу анфусакум хуа а`ламу биманиттаḳа","Они избегают великих грехов и мерзостей, кроме мелких и немногочисленных проступков. Воистину, твой Господь обладает необъятным прощением. Ему было лучше знать о вас, когда Он сотворил вас из земли и когда вы были зародышами в утробах ваших матерей. Не восхваляйте самих себя, ибо Ему лучше знать тех, кто богобоязнен.",["те, которые","избегают","великих","грехов","и мерзостей","кроме","мелких проступков","поистине","твой Господь","обширен","прощением","Он","лучше знает","о вас","когда","Он сотворил вас","из","земли","и когда","вы","зародыши","в","утробах","ваших матерей","так не","очищайте (хваля)","самих себя","Он","лучше знает","того, кто","богобоязнен"]],[53,33,["أَفَرَءَيۡتَ","ٱلَّذِي","تَوَلَّىٰ"],"афараайтал лазии тавалла","Видел ли ты того, кто отвернулся,",["видел ли ты","того, который","отвернулся"]],[53,34,["وَأَعۡطَىٰ","قَلِيلٗا","وَأَكۡدَىٰٓ"],"ва'а`та ḳалиилан ва'акда","дал мало и прекратил давать вовсе?",["и дал","мало","и прекратил"]],[53,35,["أَعِندَهُۥ","عِلۡمُ","ٱلۡغَيۡبِ","فَهُوَ","يَرَىٰٓ"],"а`индахуу `илмул гайби фахуа йара","Разве он обладает таким знанием о сокровенном, что он видит его?",["разве у него","знание","сокровенного","и он","видит"]],[53,36,["أَمۡ","لَمۡ","يُنَبَّأۡ","بِمَا","فِي","صُحُفِ","مُوسَىٰ"],"ам лам йунабба' бима фии сухуфи мууса","Разве ему не поведали о том, что было в свитках Мусы (Моисея)",["или","не","сообщено ему","о том, что","в","свитках","Мусы"]],[53,37,["وَإِبۡرَٰهِيمَ","ٱلَّذِي","وَفَّىٰٓ"],"ва'ибрахиимал лазии ваффа","и Ибрахима (Авраама), который выполнил повеления Аллаха полностью?",["и Ибрахима","который","исполнил сполна"]],[53,38,["أَلَّا","تَزِرُ","وَازِرَةٞ","وِزۡرَ","أُخۡرَىٰ"],"алла тазиру вазиратун визра ухра","Ни одна душа не понесет чужого бремени.",["что не","понесёт","несущая бремя","бремени","другой"]],[53,39,["وَأَن","لَّيۡسَ","لِلۡإِنسَٰنِ","إِلَّا","مَا","سَعَىٰ"],"ва'ал лайса лил'инсани илла ма са`а","Человек получит только то, к чему он стремился.",["и что","нет","для человека","кроме","того, что","он стремился"]],[53,40,["وَأَنَّ","سَعۡيَهُۥ","سَوۡفَ","يُرَىٰ"],"ва'анна са`йахуу сауфа йура","Его устремления будут увидены,",["и что","его стремление","вскоре","будет увидено"]],[53,41,["ثُمَّ","يُجۡزَىٰهُ","ٱلۡجَزَآءَ","ٱلۡأَوۡفَىٰ"],"сумма йужзахул жазаал ауфа","а затем он получит воздаяние сполна.",["затем","будет воздано ему за него","воздаянием","полнейшим"]],[53,42,["وَأَنَّ","إِلَىٰ","رَبِّكَ","ٱلۡمُنتَهَىٰ"],"ва'анна ила раббикал мунтаха","К твоему Господу предстоит конечный исход (или твоему Господу принадлежит конечный предел).",["и что","к","твоему Господу","конечный предел"]],[53,43,["وَأَنَّهُۥ","هُوَ","أَضۡحَكَ","وَأَبۡكَىٰ"],"ва'аннахуу хуа адхака ва'абка","Он заставляет смеяться и плакать.",["и что Он","Он","рассмешил","и заставил плакать"]],[53,44,["وَأَنَّهُۥ","هُوَ