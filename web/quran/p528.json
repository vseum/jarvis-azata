{"p":528,"j":27,"a":[[53,45,["وَأَنَّهُۥ","خَلَقَ","ٱلزَّوۡجَيۡنِ","ٱلذَّكَرَ","وَٱلۡأُنثَىٰ"],"ва'аннахуу халаḳаз заужайниз закара вал'унса","Он сотворил пару - мужчину и женщину (или самца и самку) -",["и что Он","сотворил","пару","мужской пол","и женский"]],[53,46,["مِن","نُّطۡفَةٍ","إِذَا","تُمۡنَىٰ"],"мин нутфатин иза тумна","из капли, которая извергается.",["из","капли","когда","извергается"]],[53,47,["وَأَنَّ","عَلَيۡهِ","ٱلنَّشۡأَةَ","ٱلۡأُخۡرَىٰ"],"ва'анна `алайхин наш'атал ухра","На Нем лежит сотворение в другой раз.",["и что","на Нём","создание","другое"]],[53,48,["وَأَنَّهُۥ","هُوَ","أَغۡنَىٰ","وَأَقۡنَىٰ"],"ва'аннахуу хуа агна ва'аḳна","Он избавляет от нужды (или дарует богатство) и наделяет собственностью (или удовлетворяет).",["и что Он","Он","обогатил","и наделил имуществом"]],[53,49,["وَأَنَّهُۥ","هُوَ","رَبُّ","ٱلشِّعۡرَىٰ"],"ва'аннахуу хуа раббуш ши`ра","Он - Господь Сириуса.",["и что Он","Он","Господь","Сириуса"]],[53,50,["وَأَنَّهُۥٓ","أَهۡلَكَ","عَادًا","ٱلۡأُولَىٰ"],"ва'аннахуу ахлака `аданил уула","Он погубил первых адитов,",["и что Он","погубил","адитов","первых"]],[53,51,["وَثَمُودَاْ","فَمَآ","أَبۡقَىٰ"],"васамууда фама абḳа","ничего не оставил от самудян,",["и самудян","и не","оставил"]],[53,52,["وَقَوۡمَ","نُوحٖ","مِّن","قَبۡلُۖ","إِنَّهُمۡ","كَانُواْ","هُمۡ","أَظۡلَمَ","وَأَطۡغَىٰ"],"ваḳаума нуухим мин ḳаблу иннахум кануу хум азлама ва'атга","а еще раньше погубил народ Нуха (Ноя). Воистину, они были еще более несправедливы и непокорны.",["и народ","Нуха","из","прежде","поистине, они","были","они","несправедливее","и непокорнее"]],[53,53,["وَٱلۡمُؤۡتَفِكَةَ","أَهۡوَىٰ"],"валму'тафиката ахва","Он низверг опрокинутые селения (селения народа Лута),",["и опрокинутые (селения)","Он низверг"]],[53,54,["فَغَشَّىٰهَا","مَا","غَشَّىٰ"],"фагашшаха ма гашша","которые покрыло то, что покрыло.",["и покрыло их","то, что","покрыло"]],[53,55,["فَبِأَيِّ","ءَالَآءِ","رَبِّكَ","تَتَمَارَىٰ"],"фабиаййи алаи раббика татамара","В каких же милостях твоего Господа ты сомневаешься?",["в какой же из","милостей","Господа твоего","ты сомневаешься"]],[53,56,["هَٰذَا","نَذِيرٞ","مِّنَ","ٱلنُّذُرِ","ٱلۡأُولَىٰٓ"],"хаза назиирум минан нузурил уула","Этот предостерегающий увещеватель такой же, как и первые предостерегающие увещеватели.",["этот","увещеватель","из","увещевателей","прежних"]],[53,57,["أَزِفَتِ","ٱلۡأٓزِفَةُ"],"азифатил азифах","Приближающееся (День воскресения) приблизилось,",["приблизилось","Приближающееся"]],[53,58,["لَيۡسَ","لَهَا","مِن","دُونِ","ٱللَّهِ","كَاشِفَةٌ"],"лайса лаха мин дууниллахи кашифах","и никто, кроме Аллаха, не способен отвратить его.",["нет","для него","из (кого-либо)","помимо","Аллаха","отводящего"]],[53,59,["أَفَمِنۡ","هَٰذَا","ٱلۡحَدِيثِ","تَعۡجَبُونَ"],"афамин хазал хадииси та`жабуун","Неужели вы удивляетесь этому повествованию,",["неужели же","этому","повествованию","вы удивляетесь"]],[53,60,["وَتَضۡحَكُونَ","وَلَا","تَبۡكُونَ"],"ватадхакууна вала табкуун","смеетесь, а не плачете,",["и вы смеётесь","и не","плачете"]],[53,61,["وَأَنتُمۡ","سَٰمِدُونَ"],"ва'антум самидуун","и забавляетесь (или поете; или надменно задираете головы)?",["тогда как вы","беспечно забавляетесь"]],[53,62,["فَٱسۡجُدُواْۤ","لِلَّهِۤ","وَٱعۡبُدُواْ۩"],"фасжудуу лиллахи ва`будуу","Падите же ниц перед Аллахом и поклоняйтесь!",["падите же ниц","перед Аллахом","и поклоняйтесь"]],[54,1,["ٱقۡتَرَبَتِ","ٱلسَّاعَةُ","وَٱنشَقَّ","ٱلۡقَمَرُ"],"иḳтарабатис са`ату ваншаḳḳал ḳамар","Приблизился Час, и раскололся месяц.",["приблизился","Час","и раскололся","месяц"]],[54,2,["وَإِن","يَرَوۡاْ","ءَايَةٗ","يُعۡرِضُواْ","وَيَقُولُواْ","سِحۡرٞ","مُّسۡتَمِرّٞ"],"ва'ин йарау айатан йу`ридуу вайаḳуулуу сихрум мустамирр","Когда они видят знамение, то отворачиваются и говорят: «Это - преходящее (или крепкое; или лживое) колдовство!».",["и если","они видят","знамение","они отворачиваются","и говорят","колдовство","преходящее"]],[54,3,["وَكَذَّبُواْ","وَٱتَّبَعُوٓاْ","أَهۡوَآءَهُمۡۚ","وَكُلُّ","أَمۡرٖ","مُّسۡتَقِرّٞ"],"ваказзабуу ваттаба`уу ахваахум вакуллу амрим мустаḳирр","Они сочли лжецами посланников и потакали своим желаниям, но каждый поступок утвердится (творения получат вознаграждение за добро и наказание за зло).",["и они сочли ложью","и последовали","своим страстям","и всякое","дело","утвердится"]],[54,4,["وَلَقَدۡ","جَآءَهُم","مِّنَ","ٱلۡأَنۢبَآءِ","مَا","فِيهِ","مُزۡدَجَرٌ"],"валаḳад жаахум минал амбаи ма фиихи муздажар","До них уже дошли известия, которые удерживали от неверия.",["и уже","пришли к ним","из","вестей","то, что","в нём","удерживающее"]],[54,5,["حِكۡمَةُۢ","بَٰلِغَةٞۖ","فَمَا","تُغۡنِ","ٱلنُّذُرُ"],"хикмату балигатун фама тугнин нузур","Это является совершенной мудростью, но какую пользу приносят предостережения (или предостережения не принесли им никакой пользы)?",["мудрость","совершенная","но не","помогают","предостережения"]],[54,6,["فَتَوَلَّ","عَنۡهُمۡۘ","يَوۡمَ","يَدۡعُ","ٱلدَّاعِ","إِلَىٰ","شَيۡءٖ","نُّكُرٍ"],"фатавалла `анхум йаума йад`уд да`и ила шай'ин нукур","Отвернись же от них. В тот день, когда глашатай призовет к неприятной вещи,",["отвернись же","от них","в день, когда","призовёт","призывающий","к","вещи","ужасной"]]]}