{"p":528,"j":27,"a":[[53,45,["وَأَنَّهُۥ","خَلَقَ","ٱلزَّوۡجَيۡنِ","ٱلذَّكَرَ","وَٱلۡأُنثَىٰ"],"ва'аннахуу халаḳаз заужайниз закара вал'унса","Он сотворил пару - мужчину и женщину (или самца и самку) -",["и что Он","сотворил","пару","мужской пол","и женский"]],[53,46,["مِن","نُّطۡفَةٍ","إِذَا","تُمۡنَىٰ"],"мин нутфатин иза тумна","из капли, которая извергается.",["из","капли","когда","извергается"]],[53,47,["وَأَنَّ","عَلَيۡهِ","ٱلنَّشۡأَةَ","ٱلۡأُخۡرَىٰ"],"ва'анна `алайхин наш'атал ухра","На Нем лежит сотворение в другой раз.",["и что","на Нём","создание","другое"]],[53,48,["وَأَنَّهُۥ","هُوَ","أَغۡنَىٰ","وَأَقۡنَىٰ"],"ва'аннахуу хуа агна ва'аḳна","Он избавляет от нужды (или дарует богатство) и наделяет собственностью (или удовлетворяет).",["и что Он","Он","обогатил","и наделил имуществом"]],[53,49,["وَأَنَّهُۥ","هُوَ","رَبُّ","ٱلشِّعۡرَىٰ"],"ва'аннахуу хуа раббуш ши`ра","Он - Господь Сириуса.",["и что Он","Он","Господь","Сириуса"]],[53,50,["وَأَنَّهُۥٓ","أَهۡلَكَ","عَادًا","ٱلۡأُولَىٰ"],"ва'аннахуу ахлака `аданил уула","Он погубил первых адитов,",["и что Он","погубил","адитов","первых"]],[53,51,["وَثَمُودَاْ","فَمَآ","أَبۡقَىٰ"],"васамууда фама абḳа","ничего не оставил от самудян,",["и самудян","и не","оставил"]],[53,52,["وَقَوۡمَ","نُوحٖ","مِّن","قَبۡلُۖ","إِنَّهُمۡ","كَانُواْ","هُمۡ","أَظۡلَمَ","وَأَطۡغَىٰ"],"ваḳаума нуухим мин ḳаблу иннахум кануу хум азлама ва'атга","а еще раньше погубил народ Нуха (Ноя). Воистину, они были еще более несправедливы и непокорны.",["и народ","Нуха","из","прежде","поистине, они","были","они","несправедливее","и непокорнее"]],[53,53,["وَٱلۡمُؤۡتَفِكَةَ","أَهۡوَىٰ"],"валму'тафиката ахва","Он низверг опрокинутые селения (селения народа Лута),",["и опрокинутые (селения)","Он низверг"]],[53,54,["فَغَشَّىٰهَا","مَا","غَشَّىٰ"],"фагашшаха ма гашша","которые покрыло то, что покрыло.",["и покрыло их","то, что","покрыло"]],[53,55,["فَبِأَيِّ","ءَالَآءِ","رَبِّكَ","تَتَمَارَىٰ"],"фабиаййи алаи раббика татамара","В каких же милостях твоего Г