{"p":528,"j":27,"a":[[53,45,["وَأَنَّهُۥ","خَلَقَ","ٱلزَّوۡجَيۡنِ","ٱلذَّكَرَ","وَٱلۡأُنثَىٰ"],"уа'аннахуу халака ззауджайни ззакара уал'унсаа","Он сотворил пару - мужчину и женщину (или самца и самку) -",["и что Он","сотворил","пару","мужской пол","и женский"]],[53,46,["مِن","نُّطۡفَةٍ","إِذَا","تُمۡنَىٰ"],"мин нутфатин изаа тумнаа","из капли, которая извергается.",["из","капли","когда","извергается"]],[53,47,["وَأَنَّ","عَلَيۡهِ","ٱلنَّشۡأَةَ","ٱلۡأُخۡرَىٰ"],"уа'анна `алайхи ннаш'ата л'ухраа","На Нем лежит сотворение в другой раз.",["и что","на Нём","создание","другое"]],[53,48,["وَأَنَّهُۥ","هُوَ","أَغۡنَىٰ","وَأَقۡنَىٰ"],"уа'аннахуу хууа агнаа уа'акнаа","Он избавляет от нужды (или дарует богатство) и наделяет собственностью (или удовлетворяет).",["и что Он","Он","обогатил","и наделил имуществом"]],[53,49,["وَأَنَّهُۥ","هُوَ","رَبُّ","ٱلشِّعۡرَىٰ"],"уа'аннахуу хууа раббу шши`раа","Он - Господь Сириуса.",["и что Он","Он","Господь","Сириуса"]],[53,50,["وَأَنَّهُۥٓ","أَهۡلَكَ","عَادًا","ٱلۡأُولَىٰ"],"уа'аннахуу ахлака `аадан л'уулаа","Он погубил первых адитов,",["и что Он","погубил","адитов","первых"]],[53,51,["وَثَمُودَاْ","فَمَآ","أَبۡقَىٰ"],"уасамууда фамаа абкаа","ничего не оставил от самудян,",["и самудян","и не","оставил"]],[53,52,["وَقَوۡمَ","نُوحٖ","مِّن","قَبۡلُۖ","إِنَّهُمۡ","كَانُواْ","هُمۡ","أَظۡلَمَ","وَأَطۡغَىٰ"],"уакаума нуухим мин каблу иннахум каануу хум азлама уа'атгаа","а еще раньше погубил народ Нуха (Ноя). Воистину, они были еще более несправедливы и непокорны.",["и народ","Нуха","из","прежде","поистине, они","были","они","несправедливее","и непокорнее"]],[53,53,["وَٱلۡمُؤۡتَفِكَةَ","أَهۡوَىٰ"],"уалму'тафиката ахуаа","Он низверг опрокинутые селения (селения народа Лута),",["и опрокинутые (селения)","Он низверг"]],[53,54,["فَغَشَّىٰهَا","مَا","غَشَّىٰ"],"фагашшаахаа маа гашшаа","которые покрыло то, что покрыло.",["и покрыло их","то, что","покрыло"]],[53,55,["فَبِأَيِّ","ءَالَآءِ","رَبِّكَ","تَتَمَارَىٰ"],"фаби'аййи аалаа'и раббика татамаараа","В каких же милостях твоего Господа ты сомневаешься?",["в какой же из","милостей","Господа твоего","ты сомневаешься"]],[53,56,["هَٰذَا","نَذِيرٞ","مِّنَ","ٱلنُّذُرِ","ٱلۡأُولَىٰٓ"],"хаазаа назиирум мина ннузури л'уулаа","Этот предостерегающий увещеватель такой же, как и первые предостерегающие увещеватели.",["этот","увещеватель","из","увещевателей","прежних"]],[53,57,["أَزِفَتِ","ٱلۡأٓزِفَةُ"],"азифати л'зифах","Приближающееся (День воскресения) приблизилось,",["приблизилось","Приближающееся"]],[53,58,["لَيۡسَ","لَهَا","مِن","دُونِ","ٱللَّهِ","كَاشِفَةٌ"],"лайса лахаа мин дууни ллахи каашифах","и никто, кроме Аллаха, не способен отвратить его.",["нет","для него","из (кого-либо)","помимо","Аллаха","отводящего"]],[53,59,["أَفَمِنۡ","هَٰذَا","ٱلۡحَدِيثِ","تَعۡجَبُونَ"],"афамин хаазаа лхадииси та`джабуун","Неужели вы удивляетесь этому повествованию,",["неужели же","этому","повествованию","вы удивляетесь"]],[53,60,["وَتَضۡحَكُونَ","وَلَا","تَبۡكُونَ"],"уатадхакууна уалаа табкуун","смеетесь, а не плачете,",["и вы смеётесь","и не","плачете"]],[53,61,["وَأَنتُمۡ","سَٰمِدُونَ"],"уа'антум саамидуун","и забавляетесь (или поете; или надменно задираете головы)?",["тогда как вы","беспечно забавляетесь"]],[53,62,["فَٱسۡجُدُواْۤ","لِلَّهِۤ","وَٱعۡبُدُواْ۩"],"фасджудуу лиллахи уа`будуу","Падите же ниц перед Аллахом и поклоняйтесь!",["падите же ниц","перед Аллахом","и поклоняйтесь"]],[54,1,["ٱقۡتَرَبَتِ","ٱلسَّاعَةُ","وَٱنشَقَّ","ٱلۡقَمَرُ"],"иктарабати ссаа`ату уаншакка лкамар","Приблизился Час, и раскололся месяц.",["приблизился","Час","и раскололся","месяц"]],[54,2,["وَإِن","يَرَوۡاْ","ءَايَةٗ","يُعۡرِضُواْ","وَيَقُولُواْ","سِحۡرٞ","مُّسۡتَمِرّٞ"],"уа'ин йарау аайатан йу`ридуу уайакуулуу сихрум мустамирр","Когда они видят знамение, то отворачиваются и говорят: «Это - преходящее (или крепкое; или лживое) колдовство!».",["и если","они видят","знамение","они отворачиваются","и говорят","колдовство","преходящее"]],[54,3,["وَكَذَّبُواْ","وَٱتَّبَعُوٓاْ","أَهۡوَآءَهُمۡۚ","وَكُلُّ","أَمۡرٖ","مُّسۡتَقِرّٞ"],"уаказзабуу уаттаба`уу ахуаа'ахум уакуллу амрим мустакирр","Они сочли лжецами посланников и потакали своим желаниям, но каждый поступок утвердится (творения получат вознаграждение за добро и наказание за зло).",["и они сочли ложью","и последовали","своим страстям","и всякое","дело","утвердится"]],[54,4,["وَلَقَدۡ","جَآءَهُم","مِّنَ","ٱلۡأَنۢبَآءِ","مَا","فِيهِ","مُزۡدَجَرٌ"],"уалакад джаа'ахум ммина л'амбаа'и маа фиихи муздаджар","До них уже дошли известия, которые удерживали от неверия.",["и уже","пришли к ним","из","вестей","то, что","в нём","удерживающее"]],[54,5,["حِكۡمَةُۢ","بَٰلِغَةٞۖ","فَمَا","تُغۡنِ","ٱلنُّذُرُ"],"хикмату баалигатун фамаа тугни ннузур","Это является совершенной мудростью, но какую пользу приносят предостережения (или предостережения не принесли им никакой пользы)?",["мудрость","совершенная","но не","помогают","предостережения"]],[54,6,["فَتَوَلَّ","عَنۡهُمۡۘ","يَوۡمَ","يَدۡعُ","ٱلدَّاعِ","إِلَىٰ","شَيۡءٖ","نُّكُرٍ"],"фатауалла `анхум йаума йад`у ддаа`и илаа шай'ин нукур","Отвернись же от них. В тот день, когда глашатай призовет к неприятной вещи,",["отвернись же","от них","в день, когда","призовёт","призывающий","к","вещи","ужасной"]]]}