{"p":529,"j":27,"a":[[54,7,["خُشَّعًا","أَبۡصَٰرُهُمۡ","يَخۡرُجُونَ","مِنَ","ٱلۡأَجۡدَاثِ","كَأَنَّهُمۡ","جَرَادٞ","مُّنتَشِرٞ"],"хушша`ан абсарухум йахружууна минал аждаси ка'аннахум жарадум мунташир","они с униженными взорами выйдут из могил, словно рассеянная саранча.",["униженными","взоры их","они выйдут","из","могил","как будто они","саранча","рассеянная"]],[54,8,["مُّهۡطِعِينَ","إِلَى","ٱلدَّاعِۖ","يَقُولُ","ٱلۡكَٰفِرُونَ","هَٰذَا","يَوۡمٌ","عَسِرٞ"],"ммухти`иина илад да`и йаḳуулул кафирууна хаза йаумун `асир","Они устремятся к глашатаю, и неверующие скажут: «Это - Тяжкий день!».",["спеша","к","призывающему","скажут","неверующие","это","день","тяжкий"]],[54,9,["كَذَّبَتۡ","قَبۡلَهُمۡ","قَوۡمُ","نُوحٖ","فَكَذَّبُواْ","عَبۡدَنَا","وَقَالُواْ","مَجۡنُونٞ","وَٱزۡدُجِرَ"],"каззабат ḳаблахум ḳауму нуухин факаззабуу `абдана ваḳалуу мажнуунун ваздужир","До них счел лжецами посланников народ Нуха (Ноя). Они сочли лжецом Нашего раба и сказали: «Он - одержимый!». Они ругали его и угрожали ему.",["сочёл лжецами","до них","народ","Нуха","и сочли лжецом","раба Нашего","и сказали","одержимый","и ему угрожали"]],[54,10,["فَدَعَا","رَبَّهُۥٓ","أَنِّي","مَغۡلُوبٞ","فَٱنتَصِرۡ"],"фада`а раббахуу аннии маглуубун фантасир","Тогда он воззвал к своему Господу: «Меня одолели. Помоги же мне!».",["и воззвал он","к Господу своему","что я","побеждён","помоги же"]],[54,11,["فَفَتَحۡنَآ","أَبۡوَٰبَ","ٱلسَّمَآءِ","بِمَآءٖ","مُّنۡهَمِرٖ"],"фафатахна абвабас самаи бимаим мунхамир","Мы открыли врата неба, откуда стала изливаться вода,",["и Мы открыли","врата","неба","водой","изливающейся"]],[54,12,["وَفَجَّرۡنَا","ٱلۡأَرۡضَ","عُيُونٗا","فَٱلۡتَقَى","ٱلۡمَآءُ","عَلَىٰٓ","أَمۡرٖ","قَدۡ","قُدِرَ"],"вафажжарнал арда `уйуунан фалтаḳал мау `ала амрин ḳад ḳудир","и разверзли землю, из которой забили ключи. Воды небес и земли слились для дела, которое было предопределено.",["и Мы заставили забить","землю","источниками","и встретилась","вода","для","дела","уже","предопределённого"]],[54,13,["وَحَمَلۡنَٰهُ","عَلَىٰ","ذَاتِ","أَلۡوَٰحٖ","وَدُسُرٖ"],"вахамалнаху `ала зати алвахин вадусур","Мы понесли его в ковчеге из досок и гвоздей.",["и Мы понесли его","на","сделанном из","досок","и гвоздей"]],[54,14,["تَجۡرِي","بِأَعۡيُنِنَا","جَزَآءٗ","لِّمَن","كَانَ","كُفِرَ"],"тажрии би'а`йунина жазаал лиман кана куфир","Ковчег поплыл у Нас на Глазах в воздаяние тому, в кого не уверовали (или тем, которые не уверовали).",["плывущем","пред Нашими очами","в воздаяние","тому, кто","был","отвергнут"]],[54,15,["وَلَقَد","تَّرَكۡنَٰهَآ","ءَايَةٗ","فَهَلۡ","مِن","مُّدَّكِرٖ"],"валаḳад ттаракнаха айатан фахал мим муддакир","Мы оставили его (корабль или рассказ о Нухе) в качестве знамения. Но есть ли среди вас вспоминающие?",["и уже","Мы оставили ее","знамением","так есть ли","хоть какой-то","вспоминающий"]],[54,16,["فَكَيۡفَ","كَانَ","عَذَابِي","وَنُذُرِ"],"факайфа кана `азабии ванузур","Какими же были мучения от Меня и предостережения Мои!",["так каким же","было","мучение Моё","и предостережения Мои"]],[54,17,["وَلَقَدۡ","يَسَّرۡنَا","ٱلۡقُرۡءَانَ","لِلذِّكۡرِ","فَهَلۡ","مِن","مُّدَّكِرٖ"],"валаḳад йассарнал ḳур'ана лиззикри фахал мим муддакир","Мы облегчили Коран для поминания. Но есть ли среди вас вспоминающие?",["и уже","Мы облегчили","Коран","для поминания","так есть ли","хоть один","вспоминающий"]],[54,18,["كَذَّبَتۡ","عَادٞ","فَكَيۡفَ","كَانَ","عَذَابِي","وَنُذُرِ"],"каззабат `адун факайфа кана `азабии ванузур","Адиты сочли лжецами посланников. Какими же были мучения от Меня и предостережения Мои!",["сочли ложью","адиты","и каким","было","Мое наказание","и Мои предостережения"]],[54,19,["إِنَّآ","أَرۡسَلۡنَا","عَلَيۡهِمۡ","رِيحٗا","صَرۡصَرٗا","فِي","يَوۡمِ","نَحۡسٖ","مُّسۡتَمِرّٖ"],"инна арсална `алайхим риихан сарсаран фии йауми нахсим мустамирр","Мы наслали на них морозный (или завывающий) ветер в день, злосчастье которого продолжалось.",["поистине, Мы","наслали","на них","ветер","свирепый","в","день","злосчастья","непрерывного"]],[54,20,["تَنزِعُ","ٱلنَّاسَ","كَأَنَّه