{"p":530,"j":27,"a":[[54,28,["وَنَبِّئۡهُمۡ","أَنَّ","ٱلۡمَآءَ","قِسۡمَةُۢ","بَيۡنَهُمۡۖ","كُلُّ","شِرۡبٖ","مُّحۡتَضَرٞ"],"ванабби'хум аннал маа ḳисмату байнахум куллу ширбим мухтадар","Сообщи им, что вода поделена между ними и верблюдицей. Пусть же они приходят попить каждый раз в отведенное для них время».",["и сообщи им","что","вода","разделена","между ними","каждое","питьё","в свой черёд"]],[54,29,["فَنَادَوۡاْ","صَاحِبَهُمۡ","فَتَعَاطَىٰ","فَعَقَرَ"],"фанадау сахибахум фата`ата фа`аḳар","Они позвали своего товарища, и тот схватил верблюдицу и перерезал ей поджилки.",["и позвали они","товарища своего","и он взялся","и подрезал (поджилки)"]],[54,30,["فَكَيۡفَ","كَانَ","عَذَابِي","وَنُذُرِ"],"факайфа кана `азабии ванузур","Какими же были мучения от Меня и предостережения Мои!",["так каким же","было","мучение Моё","и предостережения Мои"]],[54,31,["إِنَّآ","أَرۡسَلۡنَا","عَلَيۡهِمۡ","صَيۡحَةٗ","وَٰحِدَةٗ","فَكَانُواْ","كَهَشِيمِ","ٱلۡمُحۡتَظِرِ"],"инна арсална `алайхим сайхатан вахидатан факануу кахашиимил мухтазир","Воистину, Мы наслали на них всего лишь один вопль, и они уподобились сену хозяина загона.",["поистине, Мы","наслали","на них","вопль","единый","и стали они","как сухие стебли","строящего загон"]],[54,32,["وَلَقَدۡ","يَسَّرۡنَا","ٱلۡقُرۡءَانَ","لِلذِّكۡرِ","فَهَلۡ","مِن","مُّدَّكِرٖ"],"валаḳад йассарнал ḳур'ана лиззикри фахал мим муддакир","Мы облегчили Коран для поминания. Но есть ли среди вас вспоминающие?",["и уже","Мы облегчили","Коран","для поминания","так есть ли","хоть один","вспоминающий"]],[54,33,["كَذَّبَتۡ","قَوۡمُ","لُوطِۭ","بِٱلنُّذُرِ"],"каззабат ḳауму луути биннузур","Народ Лута (Лота) счел ложью предостережения.",["сочёл ложью","народ","Лута","предостережения"]],[54,34,["إِنَّآ","أَرۡسَلۡنَا","عَلَيۡهِمۡ","حَاصِبًا","إِلَّآ","ءَالَ","لُوطٖۖ","نَّجَّيۡنَٰهُم","بِسَحَرٖ"],"инна арсална `алайхим хасибан илла ала луутин нажжайнахум бисахар","Мы наслали на них ураган с камнями, и только семью Лута (Лота) Мы спасли перед рассветом",["поистине, Мы","наслали","на них","каменный ураган","кроме","семьи","Лута","Мы спасли их","перед рассветом"]],[54,35,["نِّعۡمَةٗ","مِّنۡ","عِندِنَاۚ","كَذَٰلِكَ","نَجۡزِي","مَن","شَكَرَ"],"нни`матам мин `индина казалика нажзии ман шакар","по милости от Нас. Так Мы воздаем тем, кто благодарен.",["по милости","от","Нас","так","Мы воздаём","тому, кто","благодарил"]],[54,36,["وَلَقَدۡ","أَنذَرَهُم","بَطۡشَتَنَا","فَتَمَارَوۡاْ","بِٱلنُّذُرِ"],"валаḳад анзарахум батшатана фатамарау биннузур","Он предостерег их от Нашей Хватки, но они усомнились в его предостережениях.",["и уже","он предостерёг их","о Нашей хватке","но они усомнились","в предостережениях"]],[54,37,["وَلَقَدۡ","رَٰوَدُوهُ","عَن","ضَيۡفِهِۦ","فَطَمَسۡنَآ","أَعۡيُنَهُمۡ","فَذُوقُواْ","عَذَابِي","وَنُذُرِ"],"валаḳад равадууху `ан дайфихии фатамасна а`йунахум фазууḳуу `азабии ванузур","Они настойчиво требовали от него его гостей, и тогда Мы лишили их зрения. Вкусите же мучения от Меня и предостережения Мои!",["и уже","добивались они от него","насчёт","гостей его","и Мы ослепили","глаза их","вкусите же","мучение Моё","и предостережения Мои"]],[54,38,["وَلَقَدۡ","صَبَّحَهُم","بُكۡرَةً","عَذَابٞ","مُّسۡتَقِرّٞ"],"валаḳад саббахахум букратан `азабум мустаḳирр","На утро их постигли неотвратимые мучения.",["и уже","постигло их утром","рано","наказание","неотступное"]],[54,39,["فَذُوقُواْ","عَذَابِي","وَنُذُرِ"],"фазууḳуу `азабии ванузур","Вкусите же мучения от Меня и предостережения Мои!",["вкусите же","мучение Моё","и предостережения Мои"]],[54,40,["وَلَقَدۡ","يَسَّرۡنَا","ٱلۡقُرۡءَانَ","لِلذِّكۡرِ","فَهَلۡ","مِن","مُّدَّكِرٖ"],"валаḳад йассарнал ḳур'ана лиззикри фахал мим муддакир","Мы облегчили Коран для поминания. Но есть ли среди вас вспоминающие?",["и уже","Мы облегчили","Коран","для поминания","так есть ли","хоть один","вспоминающий"]],[54,41,["وَلَقَدۡ","جَآءَ","ءَالَ","فِرۡعَوۡنَ","ٱلنُّذُرُ"],"валаḳад жаа ала фир`аунан нузур","Предостережения также явились к роду Фараона.",["и уже","пришли","к роду","Фараона","предостережения"]],[54,42,["كَذَّبُواْ","بِـَٔايَٰتِنَا","كُلِّهَا","فَأَخَذۡنَٰهُمۡ","أَخۡذَ","عَزِيزٖ","مُّقۡتَدِرٍ"],"каззабуу би'айатина куллиха фа'ахазнахум ахза `азиизим муḳтадир","Они сочли ложью все Наши знамения, и Мы схватили их Хваткой Могущественного, Всемогущего.",["они сочли ложью","Наши знамения","все их","и Мы схватили их","хваткой","Могущественного","Всемогущего"]],[54,43,["أَكُفَّارُكُمۡ","خَيۡرٞ","مِّنۡ","أُوْلَٰٓئِكُمۡ","أَمۡ","لَكُم","بَرَآءَةٞ","فِي","ٱلزُّبُرِ"],"акуффарукум хайрум мин улаикум ам лакум бараатун физ зубур","Разве ваши неверующие лучше тех? Или же у вас есть неприкосновенность, упомянутая в Писаниях?",["неужели ваши неверующие","лучше","чем","те","или","у вас","непричастность","в","Писаниях"]],[54,44,["أَمۡ","يَقُولُونَ","نَحۡنُ","جَمِيعٞ","مُّنتَصِرٞ"],"ам йаḳуулууна нахну жамии`ум мунтасир","Или же они говорят: «Мы являемся победоносной группой».",["или","говорят они","мы","сообщество","победоносное"]],[54,45,["سَيُهۡزَمُ","ٱلۡجَمۡعُ","وَيُوَلُّونَ","ٱلدُّبُرَ"],"сайухзамул жам`у вайуаллуунад дубур","Эта группа будет разбита, и они обратятся вспять!",["будет разбито","сборище","и обратят они","тыл"]],[54,46,["بَلِ","ٱلسَّاعَةُ","مَوۡعِدُهُمۡ","وَٱلسَّاعَةُ","أَدۡهَىٰ","وَأَمَرُّ"],"балис са`ату мау`идухум васса`ату адха ва'амарр","Час является назначенным для них сроком, и Час этот - самый тяжкий, самый горький.",["нет же","Час","их назначенный срок","и Час","тяжелее","и горше"]],[54,47,["إِنَّ","ٱلۡمُجۡرِمِينَ","فِي","ضَلَٰلٖ","وَسُعُرٖ"],"иннал мужримиина фии далалин васу`ур","Воистину, грешники сбились с пути и страдают (или отдалились от истины).",["поистине","грешники","в","заблуждении","и безумии"]],[54,48,["يَوۡمَ","يُسۡحَبُونَ","فِي","ٱلنَّارِ","عَلَىٰ","وُجُوهِهِمۡ","ذُوقُواْ","مَسَّ","سَقَرَ"],"йаума йусхабууна фин нари `ала вужуухихим зууḳуу масса саḳар","В тот день их ничком поволокут в Огонь: «Вкусите прикосновение Преисподней!».",["в день, когда","их поволокут","в","Огонь","на","лицах их","вкусите","прикосновен