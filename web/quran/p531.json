{"p":531,"j":27,"a":[[54,50,["وَمَآ","أَمۡرُنَآ","إِلَّا","وَٰحِدَةٞ","كَلَمۡحِۭ","بِٱلۡبَصَرِ"],"уамаа амрунаа иллаа уаахидатун каламхи билбасар","Мы повелеваем только один раз, и повеление исполняется в мгновение ока.",["и не","Наше повеление","кроме","одно","как мгновение","оком"]],[54,51,["وَلَقَدۡ","أَهۡلَكۡنَآ","أَشۡيَاعَكُمۡ","فَهَلۡ","مِن","مُّدَّكِرٖ"],"уалакад ахлакнаа ашйаа`акум фахал мим муддакир","Мы уже погубили подобных вам. Но есть ли среди вас вспоминающие?",["и уже","Мы погубили","подобных вам","так есть ли","хоть какой-то","вспоминающий"]],[54,52,["وَكُلُّ","شَيۡءٖ","فَعَلُوهُ","فِي","ٱلزُّبُرِ"],"уакуллу шай'ин фа`алууху фии ззубур","Все, что они совершили, есть в книгах деяний.",["и всякая","вещь","которую они сделали","в","свитках"]],[54,53,["وَكُلُّ","صَغِيرٖ","وَكَبِيرٖ","مُّسۡتَطَرٌ"],"уакуллу сагиирин уакабиирим мустатар","Все малое и великое уже начертано.",["и всякое","малое","и великое","записано"]],[54,54,["إِنَّ","ٱلۡمُتَّقِينَ","فِي","جَنَّٰتٖ","وَنَهَرٖ"],"инна лмуттакиина фии джаннаатин уанахар","Воистину, богобоязненные пребудут в Райских садах и среди рек",["поистине","богобоязненные","в","садах","и реках"]],[54,55,["فِي","مَقۡعَدِ","صِدۡقٍ","عِندَ","مَلِيكٖ","مُّقۡتَدِرِۭ"],"фии мак`ади сидкин `инда малииким муктадир","на седалище истины возле Всемогущего Властелина.",["на","седалище","истины","у","Властелина","Всемогущего"]],[55,1,["ٱلرَّحۡمَٰنُ"],"аррахмаан","Милостивый",["Милостивый"]],[55,2,["عَلَّمَ","ٱلۡقُرۡءَانَ"],"`аллама лкур'аан","научил Корану,",["Он научил","Корану"]],[55,3,["خَلَقَ","ٱلۡإِنسَٰنَ"],"халака л'инсаан","создал человека",["Он создал","человека"]],[55,4,["عَلَّمَهُ","ٱلۡبَيَانَ"],"`алламаху лбайаан","и научил его изъясняться.",["Он научил его","изъяснению"]],[55,5,["ٱلشَّمۡسُ","وَٱلۡقَمَرُ","بِحُسۡبَانٖ"],"ашшамсу уалкамару бихусбаан","Солнце и луна движутся согласно рассчитанному порядку.",["солнце","и луна","по расчёту"]],[55,6,["وَٱلنَّجۡمُ","وَٱلشَّجَرُ","يَسۡجُدَانِ"],"уаннаджму уашшаджару йасджудаан","Травы (или звезды) и деревья совершают поклоны.",["и травы (звёзды)","и деревья","оба склоняются ниц"]],[55,7,["وَٱلسَّمَآءَ","رَفَعَهَا","وَوَضَعَ","ٱلۡمِيزَانَ"],"уассамаа'а рафа`ахаа уауада`а лмиизаан","Он возвысил небо и установил весы,",["и небо","Он вознёс его","и установил","весы"]],[55,8,["أَلَّا","تَطۡغَوۡاْ","فِي","ٱلۡمِيزَانِ"],"аллаа татгау фии лмиизаан","чтобы вы не преступали границы дозволенного на весах.",["чтобы не","вы преступали","в","весах"]],[55,9,["وَأَقِيمُواْ","ٱلۡوَزۡنَ","بِٱلۡقِسۡطِ","وَلَا","تُخۡسِرُواْ","ٱلۡمِيزَانَ"],"уа'акиимуу луазна билкисти уалаа тухсируу лмиизаан","Взвешивайте беспристрастно и не занижайте вес.",["и соблюдайте","вес","справедливо","и не","занижайте","весы"]],[55,10,["وَٱلۡأَرۡضَ","وَضَعَهَا","لِلۡأَنَامِ"],"уал'арда уада`ахаа лил'анаам","Он установил землю для тварей.",["и землю","Он установил её","для тварей"]],[55,11,["فِيهَا","فَٰكِهَةٞ","وَٱلنَّخۡلُ","ذَاتُ","ٱلۡأَكۡمَامِ"],"фиихаа фаакихатун уаннахлу заату л'акмаам","На ней есть фрукты и финиковые пальмы с чашечками (или волокнами),",["на ней","плоды","и финиковые пальмы","обладающие","чашечками"]],[55,12,["وَٱلۡحَبُّ","ذُو","ٱلۡعَصۡفِ","وَٱلرَّيۡحَانُ"],"уалхаббу зуу л`асфи уаррайхаан","а также злаки с листьями и травы благоуханные.",["и злаки","обладающие","листьями","и благоуханные травы"]],[55,13,["فَبِأَيِّ","ءَالَآءِ","رَبِّكُمَا","تُكَذِّبَانِ"],"фаби'аййи аалаа'и раббикумаа туказзибаан","Какую же из милостей вашего Господа вы считаете ложью?",["так какую же","из милостей","вашего Господа","вы оба считаете ложью"]],[55,14,["خَلَقَ","ٱلۡإِنسَٰنَ","مِن","صَلۡصَٰلٖ","كَٱلۡفَخَّارِ"],"халака л'инсаана мин салсаалин калфаххаар","Он создал человека из сухой (или звенящей) глины, подобной гончарной,",["Он создал","человека","из","звонкой глины","как гончарная"]],[55,15,["وَخَلَقَ","ٱلۡجَآنَّ","مِن","مَّارِجٖ","مِّن","نَّارٖ"],"уахалака лджаанна мим маариджим мин наар","и создал джиннов из чистого пламени (или из пламени, смешанного с дымом).",["и Он создал","джиннов","из","чистого пламени","из","огня"]],[55,16,["فَبِأَيِّ","ءَالَآءِ","رَبِّكُمَا","تُكَذِّبَانِ"],"фаби'аййи аалаа'и раббикумаа туказзибаан","Какую же из милостей вашего Господа вы считаете ложью?",["так какую же из","милостей","Господа вашего (двоих)","вы оба считаете ложью"]]]}