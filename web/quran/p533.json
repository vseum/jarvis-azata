{"p":533,"j":27,"a":[[55,41,["يُعۡرَفُ","ٱلۡمُجۡرِمُونَ","بِسِيمَٰهُمۡ","فَيُؤۡخَذُ","بِٱلنَّوَٰصِي","وَٱلۡأَقۡدَامِ"],"йу`рафул мужримууна бисиимахум файу'хазу биннавасии вал'аḳдам","Грешников будут узнавать по их признакам, а затем хватать за хохлы и стопы.",["будут узнаны","грешники","по их приметам","и будут схвачены","за хохлы","и стопы"]],[55,42,["فَبِأَيِّ","ءَالَآءِ","رَبِّكُمَا","تُكَذِّبَانِ"],"фабиаййи алаи раббикума туказзибан","Какую же из милостей вашего Господа вы считаете ложью?",["так какую же из","милостей","Господа вашего (двоих)","вы оба считаете ложью"]],[55,43,["هَٰذِهِۦ","جَهَنَّمُ","ٱلَّتِي","يُكَذِّبُ","بِهَا","ٱلۡمُجۡرِمُونَ"],"хазихии жаханнамул латии йуказзибу бихал мужримуун","Вот Геенна, которую грешники считали ложью.",["это","Геенна","которую","считают ложью","её","грешники"]],[55,44,["يَطُوفُونَ","بَيۡنَهَا","وَبَيۡنَ","حَمِيمٍ","ءَانٖ"],"йатууфууна байнаха вабайна хамиимин ан","Они будут ходить между нею и кипящей водой.",["будут ходить","между нею","и между","кипятком","кипящим"]],[55,45,["فَبِأَيِّ","ءَالَآءِ","رَبِّكُمَا","تُكَذِّبَانِ"],"фабиаййи алаи раббикума туказзибан","Какую же из милостей вашего Господа вы считаете ложью?",["так какую же из","милостей","Господа вашего (двоих)","вы оба считаете ложью"]],[55,46,["وَلِمَنۡ","خَافَ","مَقَامَ","رَبِّهِۦ","جَنَّتَانِ"],"валиман хафа маḳама раббихии жаннатан","Тем же, которые боялись предстать перед своим Господом, уготовано два сада.",["а для того, кто","боялся","стояния","перед его Господом","два сада"]],[55,47,["فَبِأَيِّ","ءَالَآءِ","رَبِّكُمَا","تُكَذِّبَانِ"],"фабиаййи алаи раббикума туказзибан","Какую же из милостей вашего Господа вы считаете ложью?",["какую же","из милостей","вашего Господа","вы оба отвергаете"]],[55,48,["ذَوَاتَآ","أَفۡنَانٖ"],"завата афнан","В них обоих есть ветви.",["обладающие","ветвями"]],[55,49,["فَبِأَيِّ","ءَالَآءِ","رَبِّكُمَا","تُكَذِّبَانِ"],"фабиаййи алаи раббикума туказзибан","Какую же из милостей вашего Господа вы считаете ложью?",["какую же","из милостей","вашего Господа","вы оба отвергаете"]],[55,50,["فِيهِمَا","عَيۡنَانِ","تَجۡرِيَانِ"],"фиихима `айнани тажрийан","В них обоих текут два источника.",["в них обоих","два источника","текущие"]],[55,51,["فَبِأَيِّ","ءَالَآءِ","رَبِّكُمَا","تُكَذِّبَانِ"],"фабиаййи алаи раббикума туказзибан","Какую же из милостей вашего Господа вы считаете ложью?",["какую же","из милостей","вашего Господа","вы оба отвергаете"]],[55,52,["فِيهِمَا","مِن","كُلِّ","فَٰكِهَةٖ","زَوۡجَانِ"],"фиихима мин кулли факихатин заужан","В них обоих есть от всех фруктов по паре.",["в них обоих","из","всех","фруктов","по паре"]],[55,53,["فَبِأَيِّ","ءَالَآءِ","رَبِّكُمَا","تُكَذِّبَانِ"],"фабиаййи алаи раббикума туказзибан","Какую же из милостей вашего Господа вы считаете ложью?",["какую же","из милостей","вашего Господа","вы оба отвергаете"]],[55,54,["مُتَّكِـِٔينَ","عَلَىٰ","فُرُشِۭ","بَطَآئِنُهَا","مِنۡ","إِسۡتَبۡرَقٖۚ","وَجَنَى","ٱلۡجَنَّتَيۡنِ","دَانٖ"],"муттаки'иина `ала фуруши батаинуха мин истабраḳин важанал жаннатайни дан","Они будут лежать, прислонившись, на матрацах, выстланных снизу парчой, а свежие плоды этих двух садов будут склоняться низко.",["возлежа","на","ложах","подкладка их","из","парчи","и плоды","обоих садов","близки"]],[55,55,["فَبِأَيِّ","ءَالَآءِ","رَبِّكُمَا","تُكَذِّبَانِ"],"фабиаййи алаи раббикума туказзибан","Какую же из милостей вашего Господа вы считаете ложью?",["какую же","из милостей","вашего Господа","вы оба отвергаете"]],[55,56,["فِيهِنَّ","قَٰصِرَٰتُ","ٱلطَّرۡفِ","لَمۡ","يَطۡمِثۡهُنَّ","إِنسٞ","قَبۡلَهُمۡ","وَلَا","جَآنّٞ"],"фиихинна ḳасиратут тарфи лам йатмисхунна инсун ḳаблахум вала жанн","Там будут девы, потупляющие взоры, с которыми прежде не имели близости ни человек, ни джинн.",["в них","потупившие","взоры","не","касался их","человек","до них","и не","джинн"]],[55,57,["فَبِأَيِّ","ءَالَآءِ","رَبِّكُمَا","تُكَذِّبَانِ"],"фабиаййи алаи раббикума туказзибан","Какую же из милостей вашего Господа вы считаете ложью?",["какую же","из милостей","вашего Господа","вы оба отвергаете"]],[55,58,["كَأَنَّهُنَّ","ٱلۡيَاقُوتُ","وَٱلۡمَرۡجَانُ"],"ка'аннахуннал йаḳууту валмаржан","Они подобны рубинам и кораллам.",["как будто они","яхонт","и кораллы"]],[55,59,["فَبِأَيِّ","ءَالَآءِ","رَبِّكُمَا","تُكَذِّبَانِ"],"фабиаййи алаи раббикума туказзибан","Какую же из милостей вашего Господа вы считаете ложью?",["какую же","из милостей","вашего Господа","вы оба отвергаете"]],[55,60,["هَلۡ","جَزَآءُ","ٱلۡإِحۡسَٰنِ","إِلَّا","ٱلۡإِحۡسَٰنُ"],"хал жазаул ихсани иллал ихсан","Воздают ли за добро иначе, чем добром?",["разве","воздаяние","за добро","кроме","добро"]],[55,61,["فَبِأَيِّ","ءَالَآءِ","رَبِّكُمَا","تُكَذِّبَانِ"],"фабиаййи алаи раббикума туказзибан","Какую же из милостей вашего Господа вы считаете ложью?",["какую же","из милостей","вашего Господа","вы оба отвергаете"]],[55,62,["وَمِن","دُونِهِمَا","جَنَّتَانِ"],"вамин дуунихима жаннатан","А перед теми двумя есть еще два сада.",["и помимо","этих двух","два сада"]],[55,63,["فَبِأَيِّ","ءَالَآءِ","رَبِّكُمَا","تُكَذِّبَانِ"],"фабиаййи алаи раббикума туказзибан","Какую же из милостей вашего Господа вы считаете ложью?",["какую же","из милостей","вашего Господа","вы оба отвергаете"]],[55,64,["مُدۡهَآمَّتَانِ"],"мудхамматан","Они оба - темно-зеленые.",["тёмно-зелёные"]],[55,65,["فَبِأَيِّ","ءَالَآءِ","رَبِّكُمَا","تُكَذِّبَانِ"],"фабиаййи алаи раббикума туказзибан","Какую же из милостей вашего Господа вы считаете ложью?",["какую же","из милостей","вашего Господа","вы оба отвергаете"]],[55,66,["فِيهِمَا","عَيۡنَانِ","نَضَّاخَتَانِ"],"фиихима `айнани наддахатан","В них обоих бурлят два источника.",["в них обоих","два источника","бьющие ключом"]],[55,67,["فَبِأَيِّ","ءَالَآءِ","رَبِّكُمَا","تُكَذِّبَانِ"],"фабиаййи алаи раббикума туказзибан","Какую же из милостей вашего Господа вы считаете ложью?",["какую же","из милостей","вашего Господа","вы оба отвергаете"]]]}