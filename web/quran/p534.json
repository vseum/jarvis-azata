{"p":534,"j":27,"a":[[55,68,["فِيهِمَا","فَٰكِهَةٞ","وَنَخۡلٞ","وَرُمَّانٞ"],"фиихимаа фаакихатун уанахлун уаруммаан","В них обоих есть фрукты, финиковые пальмы, гранаты.",["в них обоих","плоды","и пальмы","и гранаты"]],[55,69,["فَبِأَيِّ","ءَالَآءِ","رَبِّكُمَا","تُكَذِّبَانِ"],"фаби'аййи аалаа'и раббикумаа туказзибаан","Какую же из милостей вашего Господа вы считаете ложью?",["какую же","из милостей","вашего Господа","вы оба отвергаете"]],[55,70,["فِيهِنَّ","خَيۡرَٰتٌ","حِسَانٞ"],"фиихинна хайраатун хисаан","Там есть девы хорошие, прекрасные.",["в них","добрые","прекрасные"]],[55,71,["فَبِأَيِّ","ءَالَآءِ","رَبِّكُمَا","تُكَذِّبَانِ"],"фаби'аййи аалаа'и раббикумаа туказзибаан","Какую же из милостей вашего Господа вы считаете ложью?",["какую же","из милостей","вашего Господа","вы оба отвергаете"]],[55,72,["حُورٞ","مَّقۡصُورَٰتٞ","فِي","ٱلۡخِيَامِ"],"хуурум максуураатун фии лхийаам","Они - черноокие и большеглазые, удерживаемые в шатрах.",["черноокие","укрытые","в","шатрах"]],[55,73,["فَبِأَيِّ","ءَالَآءِ","رَبِّكُمَا","تُكَذِّبَانِ"],"фаби'аййи аалаа'и раббикумаа туказзибаан","Какую же из милостей вашего Господа вы считаете ложью?",["какую же","из милостей","вашего Господа","вы оба отвергаете"]],[55,74,["لَمۡ","يَطۡمِثۡهُنَّ","إِنسٞ","قَبۡلَهُمۡ","وَلَا","جَآنّٞ"],"лам йатмисхунна инсун каблахум уалаа джаанн","С ними прежде не имели близости ни человек, ни джинн.",["не","касался их","человек","до них","и не","джинн"]],[55,75,["فَبِأَيِّ","ءَالَآءِ","رَبِّكُمَا","تُكَذِّبَانِ"],"фаби'аййи аалаа'и раббикумаа туказзибаан","Какую же из милостей вашего Господа вы считаете ложью?",["какую же","из милостей","вашего Господа","вы оба отвергаете"]],[55,76,["مُتَّكِـِٔينَ","عَلَىٰ","رَفۡرَفٍ","خُضۡرٖ","وَعَبۡقَرِيٍّ","حِسَانٖ"],"муттаки'иина `алаа рафрафин худрин уа`абкариййин хисаан","Они будут лежать, прислонившись, на зеленых подушках и прекрасных матрацах.",["возлежа","на","подушках","зеленых","и коврах","прекрасных"]],[55,77,["فَبِأَيِّ","ءَالَآءِ","رَبِّكُمَا","تُكَذِّبَانِ"],"фаби'аййи аалаа'и раббикумаа туказзибаан","Какую же из милостей вашего Господа вы считаете ложью?",["какую же","из милостей","вашего Господа","вы оба отвергаете"]],[55,78,["تَبَٰرَكَ","ٱسۡمُ","رَبِّكَ","ذِي","ٱلۡجَلَٰلِ","وَٱلۡإِكۡرَامِ"],"табаарака сму раббика зии лджалаали уал'икраам","Благословенно имя Господа твоего, Обладающего величием и великодушием!",["благословенно","имя","твоего Господа","Обладателя","величия","и великодушия"]],[56,1,["إِذَا","وَقَعَتِ","ٱلۡوَاقِعَةُ"],"изаа уака`ати луааки`ах","Когда наступит Событие (День воскресения),",["когда","наступит","Событие"]],[56,2,["لَيۡسَ","لِوَقۡعَتِهَا","كَاذِبَةٌ"],"лайса лиуак`атихаа каазибах","никто не сочтет его наступление ложью.",["нет","для наступления его","отрицающего"]],[56,3,["خَافِضَةٞ","رَّافِعَةٌ"],"хаафидатур раафи`ах","Оно унижает и возвышает.",["унижающее","возвышающее"]],[56,4,["إِذَا","رُجَّتِ","ٱلۡأَرۡضُ","رَجّٗا"],"изаа руджджати л'арду раджджа","Когда земля сильно содрогнется,",["когда","будет сотрясена","земля","сотрясением"]],[56,5,["وَبُسَّتِ","ٱلۡجِبَالُ","بَسّٗا"],"уабуссати лджибаалу басса","когда горы раскрошатся на мелкие кусочки,",["и будут раскрошены","горы","раскрошиванием"]],[56,6,["فَكَانَتۡ","هَبَآءٗ","مُّنۢبَثّٗا"],"факаанат хабаа'ам мумбасса","а затем превратятся в развеянный прах,",["и станут","пылью","развеянной"]],[56,7,["وَكُنتُمۡ","أَزۡوَٰجٗا","ثَلَٰثَةٗ"],"уакунтум азуааджан салаасаха","вы разделитесь на три группы.",["и станете вы","группами","тремя"]],[56,8,["فَأَصۡحَٰبُ","ٱلۡمَيۡمَنَةِ","مَآ","أَصۡحَٰبُ","ٱلۡمَيۡمَنَةِ"],"фа'асхаабу лмайманати маа асхаабу лмайманах","Одни будут по правую сторону. Кто же будет по правую сторону?",["и обитатели","правой стороны","кто (такие)","обитатели","правой стороны"]],[56,9,["وَأَصۡحَٰبُ","ٱلۡمَشۡـَٔمَةِ","مَآ","أَصۡحَٰبُ","ٱلۡمَشۡـَٔمَةِ"],"уа'асхаабу лмаш'амати маа асхаабу лмаш'амах","Другие же будут по левую сторону. Кто же будет по левую сторону?",["и обитатели","левой стороны","кто (такие)","обитатели","левой стороны"]],[56,10,["وَٱلسَّٰبِقُونَ","ٱلسَّٰبِقُونَ"],"уассаабикууна ссаабикуун","И будут опередившие их всех в добре, которые опередят их и в Раю.",["и опередившие","опередившие"]],[56,11,["أُوْلَٰٓئِكَ","ٱلۡمُقَرَّبُونَ"],"улаа'ика лмукаррабуун","Это будут приближенные,",["они","приближённые"]],[56,12,["فِي","جَنَّٰتِ","ٱلنَّعِيمِ"],"фии джаннаати нна`иим","которые пребудут в Садах блаженства.",["в","садах","блаженства"]],[56,13,["ثُلَّةٞ","مِّنَ","ٱلۡأَوَّلِينَ"],"суллатум мина л'аууалиин","Многие из них - из первых поколений,",["множество","из","первых"]],[56,14,["وَقَلِيلٞ","مِّنَ","ٱلۡأٓخِرِينَ"],"уакалиилум мина л'хириин","и лишь немногие - из последних.",["и немного","из","последних"]],[56,15,["عَلَىٰ","سُرُرٖ","مَّوۡضُونَةٖ"],"`алаа сурурим маудуунах","Они будут лежать на расшитых ложах",["на","ложах","расшитых"]],[56,16,["مُّتَّكِـِٔينَ","عَلَيۡهَا","مُتَقَٰبِلِينَ"],"ммуттаки'иина `алайхаа мутакаабилиин","друг против друга, прислонившись.",["возлежа","на них","друг против друга"]]]}