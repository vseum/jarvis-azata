{"p":534,"j":27,"a":[[55,68,["فِيهِمَا","فَٰكِهَةٞ","وَنَخۡلٞ","وَرُمَّانٞ"],"фиихима факихатун ванахлун варумман","В них обоих есть фрукты, финиковые пальмы, гранаты.",["в них обоих","плоды","и пальмы","и гранаты"]],[55,69,["فَبِأَيِّ","ءَالَآءِ","رَبِّكُمَا","تُكَذِّبَانِ"],"фабиаййи алаи раббикума туказзибан","Какую же из милостей вашего Господа вы считаете ложью?",["какую же","из милостей","вашего Господа","вы оба отвергаете"]],[55,70,["فِيهِنَّ","خَيۡرَٰتٌ","حِسَانٞ"],"фиихинна хайратун хисан","Там есть девы хорошие, прекрасные.",["в них","добрые","прекрасные"]],[55,71,["فَبِأَيِّ","ءَالَآءِ","رَبِّكُمَا","تُكَذِّبَانِ"],"фабиаййи алаи раббикума туказзибан","Какую же из милостей вашего Господа вы считаете ложью?",["какую же","из милостей","вашего Господа","вы оба отвергаете"]],[55,72,["حُورٞ","مَّقۡصُورَٰتٞ","فِي","ٱلۡخِيَامِ"],"хуурум маḳсууратун фил хийам","Они - черноокие и большеглазые, удерживаемые в шатрах.",["черноокие","укрытые","в","шатрах"]],[55,73,["فَبِأَيِّ","ءَالَآءِ","رَبِّكُمَا","تُكَذِّبَانِ"],"фабиаййи алаи раббикума туказзибан","Какую же из милостей вашего Господа вы считаете ложью?",["какую же","из милостей","вашего Господа","вы оба отвергаете"]],[55,74,["لَمۡ","يَطۡمِثۡهُنَّ","إِنسٞ","قَبۡلَهُمۡ","وَلَا","جَآنّٞ"],"лам йатмисхунна инсун ḳаблахум вала жанн","С ними прежде не имели близости ни человек, ни джинн.",["не","касался их","человек","до них","и не","джинн"]],[55,75,["فَبِأَيِّ","ءَالَآءِ","رَبِّكُمَا","تُكَذِّبَانِ"],"фабиаййи алаи раббикума туказзибан","Какую же из милостей вашего Господа вы считаете ложью?",["какую же","из милостей","вашего Господа","вы оба отвергаете"]],[55,76,["مُتَّكِـِٔينَ","عَلَىٰ","رَفۡرَفٍ","خُضۡرٖ","وَعَبۡقَرِيٍّ","حِسَانٖ"],"муттаки'иина `ала рафрафин худрин ва`абḳариййин хисан","Они будут лежать, прислонившись, на зеленых подушках и прекрасных матрацах.",["возлежа","на","подушках","зеленых","и коврах","прекрасных"]],[55,77,["فَبِأَيِّ","ءَالَآءِ","رَبِّكُمَا","تُكَذِّبَانِ"],"фабиаййи алаи раббикума туказзибан","Какую же из милостей вашего Господа вы считаете ложью?",["какую же","из милостей","вашего Господа","вы оба отвергаете"]],[55,78,["تَبَٰرَكَ","ٱسۡمُ","رَبِّكَ","ذِي","ٱلۡجَلَٰلِ","وَٱلۡإِكۡرَامِ"],"табаракасму раббика зил жалали вал'икрам","Благословенно имя Господа твоего, Обладающего величием и великодушием!",["благословенно","имя","твоего Господа","Обладателя","величия","и великодушия"]],[56,1,["إِذَا","وَقَعَتِ","ٱلۡوَاقِعَةُ"],"иза ваḳа`атил ваḳи`ах","Когда наступит Событие (День воскресения),",["когда","наступит","Событие"]],[56,2,["لَيۡسَ","لِوَقۡعَتِهَا","كَاذِبَةٌ"],"лайса ливаḳ`атиха казибах","никто не сочтет его наступление ложью.",["нет","для наступления его","отрицающего"]],[56,3,["خَافِضَةٞ","رَّافِعَةٌ"],"хафидатур рафи`ах","Оно унижает и возвышает.",["унижающее","возвышающее"]],[56,4,["إِذَا","رُجَّتِ","ٱلۡأَرۡضُ","رَجّٗا"],"иза ружжатил арду ражжа","Когда земля сильно содрогнется,",["когда","будет сотрясена","земля","сотрясением"]],[56,5,["وَبُسَّتِ","ٱلۡجِبَالُ","بَسّٗا"],"вабуссатил жибалу басса","когда горы раскрошатся на мелкие кусочки,",["и будут раскрошены","горы","раскрошиванием"]],[56,6,["فَكَانَتۡ","هَبَآءٗ","مُّنۢبَثّٗا"],"факанат хабаам мумбасса","а затем превратятся в развеянный прах,",["и станут","пылью","развеянной"]],[56,7,["وَكُنتُمۡ","أَزۡوَٰجٗا","ثَلَٰثَةٗ"],"вакунтум азважан саласаха","вы разделитесь на три группы.",["и станете вы","группами","тремя"]],[56,8,["فَأَصۡحَٰبُ","ٱلۡمَيۡمَنَةِ","مَآ","أَصۡحَٰبُ","ٱلۡمَيۡمَنَةِ"],"фа'асхабул майманати ма асхабул майманах","Одни будут по правую сторону. Кто же будет по правую сторону?",["и обитатели","правой стороны","кто (такие)","обитатели","правой стороны"]],[56,9,["وَأَصۡحَٰبُ","ٱلۡمَشۡـَٔمَةِ","مَآ","أَصۡحَٰبُ","ٱلۡمَشۡـَٔمَةِ"],"ва'асхабул маш'амати ма асхабул маш'амах","Другие же будут по левую сторону. Кто же будет по левую сторону?",["и обитатели","левой стороны","кто (такие)","обитатели","левой стороны"]],[56,10,["وَٱلسَّٰبِقُونَ","ٱلسَّٰبِقُونَ"],"вассабиḳуунас 