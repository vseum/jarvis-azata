{"p":535,"j":27,"a":[[56,17,["يَطُوفُ","عَلَيۡهِمۡ","وِلۡدَٰنٞ","مُّخَلَّدُونَ"],"йатууфу `алайхим вилданум мухалладуун","Вечно юные отроки будут обходить их",["обходят","их","юноши","вечно юные"]],[56,18,["بِأَكۡوَابٖ","وَأَبَارِيقَ","وَكَأۡسٖ","مِّن","مَّعِينٖ"],"би'аквабин ва'абарииḳа вака'сим мим ма`иин","с чашами, кувшинами и кубками с родниковым напитком (вином),",["с чашами","и кувшинами","и кубком","из","источника"]],[56,19,["لَّا","يُصَدَّعُونَ","عَنۡهَا","وَلَا","يُنزِفُونَ"],"лла йусадда`ууна `анха вала йунзифуун","от которого не болит голова и не теряют рассудок,",["не","будет болеть голова у них","от него","и не","будут пьянеть"]],[56,20,["وَفَٰكِهَةٖ","مِّمَّا","يَتَخَيَّرُونَ"],"вафакихатим мимма йатахаййаруун","с фруктами, которые они выбирают,",["и плодами","из того, что","они выбирают"]],[56,21,["وَلَحۡمِ","طَيۡرٖ","مِّمَّا","يَشۡتَهُونَ"],"валахми тайрим мимма йаштахуун","и мясом птиц, которое они желают.",["и мясом","птиц","из того, что","они пожелают"]],[56,22,["وَحُورٌ","عِينٞ"],"вахуурун `иин","Их женами будут черноокие, большеглазые девы,",["и черноокие","большеглазые"]],[56,23,["كَأَمۡثَٰلِ","ٱللُّؤۡلُوِٕ","ٱلۡمَكۡنُونِ"],"ка'амсалил лу'луил макнуун","подобные сокрытым жемчужинам.",["подобные","жемчугу","хранимому"]],[56,24,["جَزَآءَۢ","بِمَا","كَانُواْ","يَعۡمَلُونَ"],"жазаа бима кануу йа`малуун","Таково воздаяние за то, что они совершали.",["в воздаяние","за то, что","были они","делают"]],[56,25,["لَا","يَسۡمَعُونَ","فِيهَا","لَغۡوٗا","وَلَا","تَأۡثِيمًا"],"ла йасма`ууна фииха лагван вала та'сиима","Они не услышат там ни празднословия, ни греховных речей,",["не","услышат они","там","пустословия","и не","греховного"]],[56,26,["إِلَّا","قِيلٗا","سَلَٰمٗا","سَلَٰمٗا"],"илла ḳиилан саламан салама","а только слова: «Мир! Мир!».",["кроме","слова","мир","мир"]],[56,27,["وَأَصۡحَٰبُ","ٱلۡيَمِينِ","مَآ","أَصۡحَٰبُ","ٱلۡيَمِينِ"],"ва'асхабул йамиини ма асхабул йамиин","И будут те, кто по правую сторону. Кто же будет по правую сторону?",["и люди","правой стороны","кто","люди","правой стороны"]],[56,28,["فِي","سِدۡرٖ","مَّخۡضُودٖ"],"фии сидрим махдууд","Они пребудут среди лотосов, лишенных шипов,",["среди","лотосов","без шипов"]],[56,29,["وَطَلۡحٖ","مَّنضُودٖ"],"ваталхим мандууд","под бананами (или акациями камеденосными) с висящими рядами плодами,",["и бананов","уложенных рядами"]],[56,30,["وَظِلّٖ","مَّمۡدُودٖ"],"вазиллим мамдууд","в распростертой тени,",["и тени","протяжённой"]],[56,31,["وَمَآءٖ","مَّسۡكُوبٖ"],"вамаим маскууб","среди разлитых вод",["и воды","льющейся"]],[56,32,["وَفَٰكِهَةٖ","كَثِيرَةٖ"],"вафакихатин касиирах","и многочисленных фруктов,",["и плодов","многочисленных"]],[56,33,["لَّا","مَقۡطُوعَةٖ","وَلَا","مَمۡنُوعَةٖ"],"лла маḳтуу`атин вала мамнуу`ах","которые не кончаются и доступны.",["не","иссякающих","и не","запретных"]],[56,34,["وَفُرُشٖ","مَّرۡفُوعَةٍ"],"вафурушим марфуу`ах","Они будут лежать на приподнятых матрацах.",["и ложа","возвышенные"]],[56,35,["إِنَّآ","أَنشَأۡنَٰهُنَّ","إِنشَآءٗ"],"инна анша'нахунна иншаа","Мы сотворим их в новом облике (совершенными)",["поистине, Мы","создали их","созданием"]],[56,36,["فَجَعَلۡنَٰهُنَّ","أَبۡكَارًا"],"фажа`алнахунна абкара","и сделаем их девственницами,",["и сделали Мы их","девственницами"]],[56,37,["عُرُبًا","أَتۡرَابٗا"],"`урубан атраба","любящими и равными по возрасту.",["любящими","сверстницами"]],[56,38,["لِّأَصۡحَٰبِ","ٱلۡيَمِينِ"],"лли'асхабил йамиин","Это - для тех, кто по правую сторону.",["для обитателей","правой стороны"]],[56,39,["ثُلَّةٞ","مِّنَ","ٱلۡأَوَّلِينَ"],"суллатум минал аввалиин","Многие из них - из первых поколений,",["множество","из","первых"]],[56,40,["وَثُلَّةٞ","مِّنَ","ٱلۡأٓخِرِينَ"],"васуллатум минал ахириин","а многие - из последних.",["и множество","из","последних"]],[56,41,["وَأَصۡحَٰبُ","ٱلشِّمَالِ","مَآ","أَصۡحَٰبُ","ٱلشِّمَالِ"],"ва'асхабуш шимали ма асхабуш шимал","И будут те, кто по левую сторону. Кто же будет по левую сторону?",["и обитатели","левой стороны","кто (такие)","обитатели","левой стороны"]],[56,42,["فِي","سَمُومٖ","وَحَمِيمٖ"],"фии самуумин вахамиим","Они окажутся под знойным ветром и в кипятке,",["в","знойном ветре","и кипятке"]],[56,43,["وَظِلّٖ","مِّن","يَحۡمُومٖ"],"вазиллим мин йахмуум","в тени черного дыма,",["и тени","из","чёрного дыма"]],[56,44,["لَّا","بَارِدٖ","وَلَا","كَرِيمٍ"],"лла баридин вала кариим","которая не приносит ни прохлады, ни добра.",["не","прохладной","и не","благой"]],[56,45,["إِنَّهُمۡ","كَانُواْ","قَبۡلَ","ذَٰلِكَ","مُتۡرَفِينَ"],"иннахум кануу ḳабла залика мутрафиин","Прежде они нежились роскошью,",["поистине, они","были","до","этого","изнежены роскошью"]],[56,46,["وَكَانُواْ","يُصِرُّونَ","عَلَى","ٱلۡحِنثِ","ٱلۡعَظِيمِ"],"вакануу йусиррууна `алал хинсил `азиим","упорствовали в великом грехе",["и были","упорствуют","в","грехе","великом"]],[56,47,["وَكَانُواْ","يَقُولُونَ","أَئِذَا","مِتۡنَا","وَكُنَّا","تُرَابٗا","وَعِظَٰمًا","أَءِنَّا","لَمَبۡعُوثُونَ"],"вакануу йаḳуулууна а'иза митна вакунна турабан ва`изаман а'инна ламаб`уусуун","и говорили: «Неужели мы будем воскрешены после того, как мы умрем и станем прахом и костями?",["и были","говорят","неужели когда","мы умрём","и станем","прахом","и костями","неужели мы","непременно воскрешены"]],[56,48,["أَوَءَابَآؤُنَا","ٱلۡأَوَّلُونَ"],"аваабаунал аввалуун","Или же наши праотцы?».",["и неужели отцы наши","первые"]],[56,49,["قُلۡ","إِنَّ","ٱلۡأَوَّلِينَ","وَٱلۡأٓخِرِينَ"],"ḳул иннал аввалиина вал'ахириин","Скажи: «Воистину, как первые, так и последние поколения",["скажи","поистине","первые","и последние"]],[56,50,["لَمَجۡمُوعُونَ","إِلَىٰ","مِيقَٰتِ","يَوۡمٖ","مَّعۡلُومٖ"],"ламажмуу`ууна ила мииḳати йаумим ма`луум","будут собраны в определенном месте в известный день.",["непременно собраны","к","сроку","дня","известного"]]],"m":[[["يَطُوفُ","обходят",56,17],["عَلَيۡهِمۡ","их",56,17],["وِلۡدَٰنٞ","юноши",56,17],["مُّخَلَّدُونَ","вечно юные",56,17],[17],["بِأَكۡوَابٖ","с чашами",56,18],["وَأَبَارِيقَ","и кувшинами",56,18],["وَكَأۡسٖ","и кубком",56,18],["مِّن","из",56,18],["مَّ