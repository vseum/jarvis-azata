{"p":536,"j":27,"a":[[56,51,["ثُمَّ","إِنَّكُمۡ","أَيُّهَا","ٱلضَّآلُّونَ","ٱلۡمُكَذِّبُونَ"],"сумма иннакум аййухад даллуунал муказзибуун","Тогда вы, о заблудшие, считающие лжецами посланников,",["затем","поистине, вы","о","заблудшие","отвергающие"]],[56,52,["لَأٓكِلُونَ","مِن","شَجَرٖ","مِّن","زَقُّومٖ"],"ла'акилууна мин шажарим мин заḳḳуум","непременно вкусите от дерева заккум.",["непременно будете есть","с","дерева","из","заккума"]],[56,53,["فَمَالِـُٔونَ","مِنۡهَا","ٱلۡبُطُونَ"],"фамалиууна минхал бутуун","Вы будете набивать ими животы",["и наполните","им","животы"]],[56,54,["فَشَٰرِبُونَ","عَلَيۡهِ","مِنَ","ٱلۡحَمِيمِ"],"фашарибууна `алайхи минал хамиим","и запивать их кипятком,",["и будете пить","поверх него","из","кипятка"]],[56,55,["فَشَٰرِبُونَ","شُرۡبَ","ٱلۡهِيمِ"],"фашарибууна шурбал хиим","как пьют больные верблюды, которые не могут спастись от жажды».",["и будете пить","питьём","жаждущих верблюдов"]],[56,56,["هَٰذَا","نُزُلُهُمۡ","يَوۡمَ","ٱلدِّينِ"],"хаза нузулухум йаумад диин","Таким для них будет угощение в День воздаяния.",["это","угощение их","в День","Суда"]],[56,57,["نَحۡنُ","خَلَقۡنَٰكُمۡ","فَلَوۡلَا","تُصَدِّقُونَ"],"нахну халаḳнакум фалаула тусаддиḳуун","Мы сотворили вас. Почему же вы не признаете воскрешения?",["Мы","сотворили вас","почему же не","признаёте истину"]],[56,58,["أَفَرَءَيۡتُم","مَّا","تُمۡنُونَ"],"афараайтум ма тумнуун","Видели ли вы семя, которое вы извергаете?",["видели ли вы","то, что","извергаете"]],[56,59,["ءَأَنتُمۡ","تَخۡلُقُونَهُۥٓ","أَمۡ","نَحۡنُ","ٱلۡخَٰلِقُونَ"],"а'антум тахлуḳуунахуу ам нахнул халиḳуун","Вы создаете его или Мы создаем?",["разве вы","творите его","или","Мы","Творцы"]],[56,60,["نَحۡنُ","قَدَّرۡنَا","بَيۡنَكُمُ","ٱلۡمَوۡتَ","وَمَا","نَحۡنُ","بِمَسۡبُوقِينَ"],"нахну ḳаддарна байнакумул маута вама нахну бимасбууḳиин","Мы распределили между вами смерть, и ничто не может помешать Нам",["Мы","предопределили","среди вас","смерть","и не","Мы","опережаемы"]],[56,61,["عَلَىٰٓ","أَن","نُّبَدِّلَ","أَمۡثَٰلَكُمۡ","وَنُنشِئَكُمۡ","فِي","مَا","لَا","تَعۡلَمُونَ"],"`ала ан нубаддила амсалакум вануншиакум фии ма ла та`ламуун","заменить вас подобными вам (или изменить ваше обличие) и создать вас такими, какими вы себе и не представляете.",["в том","чтобы","Мы заменили","подобных вам","и создали вас","в","том, что","не","знаете вы"]],[56,62,["وَلَقَدۡ","عَلِمۡتُمُ","ٱلنَّشۡأَةَ","ٱلۡأُولَىٰ","فَلَوۡلَا","تَذَكَّرُونَ"],"валаḳад `алимтумун наш'атал уула фалаула тазаккаруун","Вы уже знаете о первом сотворении. Почему же вы не помяните назидание?",["и уже","вы узнали","сотворение","первое","так почему бы не","вы помните"]],[56,63,["أَفَرَءَيۡتُم","مَّا","تَحۡرُثُونَ"],"афараайтум ма тахрусуун","Видели ли вы то, что вы сеете?",["видели ли вы","то, что","вы сеете"]],[56,64,["ءَأَنتُمۡ","تَزۡرَعُونَهُۥٓ","أَمۡ","نَحۡنُ","ٱلزَّٰرِعُونَ"],"а'антум тазра`уунахуу ам нахнуз зари`уун","Вы ли заставляете его произрасти или Мы заставляем?",["разве вы","выращиваете его","или","Мы","Выращивающие"]],[56,65,["لَوۡ","نَشَآءُ","لَجَعَلۡنَٰهُ","حُطَٰمٗا","فَظَلۡتُمۡ","تَفَكَّهُونَ"],"лау нашау лажа`алнаху хутаман фазалтум тафаккахуун","Если Мы пожелаем, то превратим его в труху, и тогда вы останетесь удивленными",["если бы","Мы пожелали","непременно сделали бы его","трухой","и остались бы вы","изумляться"]],[56,66,["إِنَّا","لَمُغۡرَمُونَ"],"инна ламуграмуун","и скажите: «Воистину, мы потерпели убыток.",["поистине, мы","непременно в убытке"]],[56,67,["بَلۡ","نَحۡنُ","مَحۡرُومُونَ"],"бал нахну махруумуун","Более того, мы лишились пропитания».",["нет","мы","лишены"]],[56,68,["أَفَرَءَيۡتُمُ","ٱلۡمَآءَ","ٱلَّذِي","تَشۡرَبُونَ"],"афараайтумул маал лазии ташрабуун","Видели ли вы воду, которую вы пьете?",["видели ли вы","воду","которую","вы пьёте"]],[56,69,["ءَأَنتُمۡ","أَنزَلۡتُمُوهُ","مِنَ","ٱلۡمُزۡنِ","أَمۡ","نَحۡنُ","ٱلۡمُنزِلُونَ"],"а'антум анзалтумууху минал музни ам нахнул мунзилуун","Вы ли ниспосылаете ее из дождевых туч или Мы ниспосылаем?",["разве вы","ниспослали её","из","дождевых облаков","или","Мы","Ниспосылающие"]],[56,70,["لَوۡ","نَشَآءُ","جَعَلۡنَٰهُ","أُجَاجٗا","فَلَوۡلَا","تَشۡكُرُونَ"],"лау нашау жа`алнаху ужажан фалаула ташкуруун","Если бы Мы пожелали, то сделали бы ее горькой. Почему же вы неблагодарны?",["если бы","Мы пожелали","Мы сделали бы её","горько-солёной","почему же не","благодарите вы"]],[56,71,["أَفَرَءَيۡتُمُ","ٱلنَّارَ","ٱلَّتِي","تُورُونَ"],"афараайтумун нарал латии тууруун","Видели ли вы огонь, который вы высекаете?",["видели ли вы","огонь","который","высекаете"]],[56,72,["ءَأَنتُمۡ","أَنشَأۡتُمۡ","شَجَرَتَهَآ","أَمۡ","نَحۡنُ","ٱلۡمُنشِـُٔونَ"],"а'антум анша'тум шажаратаха ам нахнул муншиуун","Вы ли создаете деревья для него или Мы создаем?",["разве вы","создали","дерево его","или","Мы","Создающие"]],[56,73,["نَحۡنُ","جَعَلۡنَٰهَا","تَذۡكِرَةٗ","وَمَتَٰعٗا","لِّلۡمُقۡوِينَ"],"нахну жа`алнаха тазкиратан вамата`ал лилмуḳвиин","Мы сделали его напоминанием и предметом пользования для путников.",["Мы","сделали его","напоминанием","и пользой","для путников"]],[56,74,["فَسَبِّحۡ","بِٱسۡمِ","رَبِّكَ","ٱلۡعَظِيمِ"],"фасаббих бисми раббикал `азиим","Прославляй же имя Великого Господа твоего!",["так славь","имя","твоего Господа","Великого"]],[56,75,["فَلَآ","أُقۡسِمُ","بِمَوَٰقِعِ","ٱلنُّجُومِ"],"фала уḳсиму бимаваḳи`ин нужуум","Но нет! Клянусь местами заката звезд (или ниспослания частей Корана)!",["но нет","клянусь","местами заката","звёзд"]],[56,76,["وَإِنَّهُۥ","لَقَسَمٞ","لَّوۡ","تَعۡلَمُونَ","عَظِيمٌ"],"ва'иннахуу лаḳасамул лау та`ламууна `азиим","Если бы вы только знали, что это - клятва великая.",["и поистине, это","непременно клятва","если бы","вы знали","великая"]]]}