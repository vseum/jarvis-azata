{"p":536,"j":27,"a":[[56,51,["ثُمَّ","إِنَّكُمۡ","أَيُّهَا","ٱلضَّآلُّونَ","ٱلۡمُكَذِّبُونَ"],"сумма иннакум аййухаа ддааллууна лмуказзибуун","Тогда вы, о заблудшие, считающие лжецами посланников,",["затем","поистине, вы","о","заблудшие","отвергающие"]],[56,52,["لَأٓكِلُونَ","مِن","شَجَرٖ","مِّن","زَقُّومٖ"],"ла'килууна мин шаджарим мин заккуум","непременно вкусите от дерева заккум.",["непременно будете есть","с","дерева","из","заккума"]],[56,53,["فَمَالِـُٔونَ","مِنۡهَا","ٱلۡبُطُونَ"],"фамаали'ууна минхаа лбутуун","Вы будете набивать ими животы",["и наполните","им","животы"]],[56,54,["فَشَٰرِبُونَ","عَلَيۡهِ","مِنَ","ٱلۡحَمِيمِ"],"фашаарибууна `алайхи мина лхамиим","и запивать их кипятком,",["и будете пить","поверх него","из","кипятка"]],[56,55,["فَشَٰرِبُونَ","شُرۡبَ","ٱلۡهِيمِ"],"фашаарибууна шурба лхиим","как пьют больные верблюды, которые не могут спастись от жажды».",["и будете пить","питьём","жаждущих верблюдов"]],[56,56,["هَٰذَا","نُزُلُهُمۡ","يَوۡمَ","ٱلدِّينِ"],"хаазаа нузулухум йаума ддиин","Таким для них будет угощение в День воздаяния.",["это","угощение их","в День","Суда"]],[56,57,["نَحۡنُ","خَلَقۡنَٰكُمۡ","فَلَوۡلَا","تُصَدِّقُونَ"],"нахну халакнаакум фалаулаа тусаддикуун","Мы сотворили вас. Почему же вы не признаете воскрешения?",["Мы","сотворили вас","почему же не","признаёте истину"]],[56,58,["أَفَرَءَيۡتُم","مَّا","تُمۡنُونَ"],"афара'айтум ммаа тумнуун","Видели ли вы семя, которое вы извергаете?",["видели ли вы","то, что","извергаете"]],[56,59,["ءَأَنتُمۡ","تَخۡلُقُونَهُۥٓ","أَمۡ","نَحۡنُ","ٱلۡخَٰلِقُونَ"],"а'антум тахлукуунахуу ам нахну лхааликуун","Вы создаете его или Мы создаем?",["разве вы","творите его","или","Мы","Творцы"]],[56,60,["نَحۡنُ","قَدَّرۡنَا","بَيۡنَكُمُ","ٱلۡمَوۡتَ","وَمَا","نَحۡنُ","بِمَسۡبُوقِينَ"],"нахну каддарнаа байнакуму лмаута уамаа нахну бимасбуукиин","Мы распределили между вами смерть, и ничто не может помешать Нам",["Мы","предопределили","среди вас","смерть","и не","Мы","опережаемы"]],[56,61,["عَلَىٰٓ","أَن","نُّبَدِّلَ","أَمۡثَٰلَكُمۡ","وَنُنشِئَكُمۡ","فِي","مَا","لَا","تَعۡلَمُونَ"],"`алаа ан нубаддила амсаалакум уанунши'акум фии маа лаа та`ламуун","заменить вас подобными вам (или изменить ваше обличие) и создать вас такими, какими вы себе и не представляете.",["в том","чтобы","Мы заменили","подобных вам","и создали вас","в","том, что","не","знаете вы"]],[56,62,["وَلَقَدۡ","عَلِمۡتُمُ","ٱلنَّشۡأَةَ","ٱلۡأُولَىٰ","فَلَوۡلَا","تَذَكَّرُونَ"],"уалакад `алимтуму ннаш'ата л'уулаа фалаулаа тазаккаруун","Вы уже знаете о первом сотворении. Почему же вы не помяните назидание?",["и уже","вы узнали","сотворение","первое","так почему бы не","вы помните"]],[56,63,["أَفَرَءَيۡتُم","مَّا","تَحۡرُثُونَ"],"афара'айтум ммаа тахрусуун","Видели ли вы то, что вы сеете?",["видели ли вы","то, что","вы сеете"]],[56,64,["ءَأَنتُمۡ","تَزۡرَعُونَهُۥٓ","أَمۡ","نَحۡنُ","ٱلزَّٰرِعُونَ"],"а'антум тазра`уунахуу ам нахну ззаари`уун","Вы ли заставляете его произрасти или Мы заставляем?",["разве вы","выращиваете его","или","Мы","Выращивающие"]],[56,65,["لَوۡ","نَشَآءُ","لَجَعَلۡنَٰهُ","حُطَٰمٗا","فَظَلۡتُمۡ","تَفَكَّهُونَ"],"лау нашаа'у ладжа`алнааху хутааман фазалтум тафаккахуун","Если Мы пожелаем, то превратим его в труху, и тогда вы останетесь удивленными",["если бы","Мы пожелали","непременно сделали бы его","трухой","и остались бы вы","изумляться"]],[56,66,["إِنَّا","لَمُغۡرَمُونَ"],"иннаа ламуграмуун","и скажите: «Воистину, мы потерпели убыток.",["поистине, мы","непременно в убытке"]],[56,67,["بَلۡ","نَحۡنُ","مَحۡرُومُونَ"],"бал нахну махруумуун","Более того, мы лишились пропитания».",["нет","мы","лишены"]],[56,68,["أَفَرَءَيۡتُمُ","ٱلۡمَآءَ","ٱلَّذِي","تَشۡرَبُونَ"],"афара'айтуму лмаа'а ллазии ташрабуун","Видели ли вы воду, которую вы пьете?",["видели ли вы","воду","которую","вы пьёте"]],[56,69,["ءَأَنتُمۡ","أَنزَلۡتُمُوهُ","مِنَ","ٱلۡمُزۡنِ","أَمۡ","نَحۡنُ","ٱلۡمُنزِلُونَ"],"а'антум анзалтумууху мина лмузни ам нахну лмунзилуун","Вы ли ниспосылаете ее из дождевых туч или Мы ниспосылаем?",["разве вы","ниспослали её","из","дождевых облаков","или","Мы","Ниспосылающие"]],[56,70,["لَوۡ","نَشَآءُ","جَعَلۡنَٰهُ","أُجَاجٗا","فَلَوۡلَا","تَشۡكُرُونَ"],"лау нашаа'у джа`алнааху уджааджан фалаулаа ташкуруун","Если бы Мы пожелали, то сделали бы ее горькой. Почему же вы неблагодарны?",["если бы","Мы пожелали","Мы сделали бы её","горько-солёной","почему же не","благодарите вы"]],[56,71,["أَفَرَءَيۡتُمُ","ٱلنَّارَ","ٱلَّتِي","تُورُونَ"],"афара'айтуму ннаара ллатии тууруун","Видели ли вы огонь, который вы высекаете?",["видели ли вы","огонь","который","высекаете"]],[56,72,["ءَأَنتُمۡ","أَنشَأۡتُمۡ","شَجَرَتَهَآ","أَمۡ","نَحۡنُ","ٱلۡمُنشِـُٔونَ"],"а'антум анша'тум шаджаратахаа ам нахну лмунши'уун","Вы ли создаете деревья для него или Мы создаем?",["разве вы","создали","дерево его","или","Мы","Создающие"]],[56,73,["نَحۡنُ","جَعَلۡنَٰهَا","تَذۡكِرَةٗ","وَمَتَٰعٗا","لِّلۡمُقۡوِينَ"],"нахну джа`алнаахаа тазкиратан уаматаа`ал лилмукуиин","Мы сделали его напоминанием и предметом пользования для путников.",["Мы","сделали его","напоминанием","и пользой","для путников"]],[56,74,["فَسَبِّحۡ","بِٱسۡمِ","رَبِّكَ","ٱلۡعَظِيمِ"],"фасаббих бисми раббика л`азиим","Прославляй же имя Великого Господа твоего!",["так славь","имя","твоего Господа","Великого"]],[56,75,["فَلَآ","أُقۡسِمُ","بِمَوَٰقِعِ","ٱلنُّجُومِ"],"фалаа уксиму бимауааки`и ннуджуум","Но нет! Клянусь местами заката звезд (или ниспослания частей Корана)!",["но нет","клянусь","местами заката","звёзд"]],[56,76,["وَإِنَّهُۥ","لَقَسَمٞ","لَّوۡ","تَعۡلَمُونَ","عَظِيمٌ"],"уа'иннахуу лакасамул лау та`ламууна `азиим","Если бы вы только знали, что это - клятва великая.",["и поистине, это","непременно клятва","если бы","вы знали","великая"]]]}