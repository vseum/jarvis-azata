{"p":537,"j":27,"a":[[56,77,["إِنَّهُۥ","لَقُرۡءَانٞ","كَرِيمٞ"],"иннахуу лакур'аанун кариим","Воистину, это - благородный Коран,",["поистине, это","непременно Коран","благородный"]],[56,78,["فِي","كِتَٰبٖ","مَّكۡنُونٖ"],"фии китаабим макнуун","находящийся в Хранимом Писании.",["в","Писании","хранимом"]],[56,79,["لَّا","يَمَسُّهُۥٓ","إِلَّا","ٱلۡمُطَهَّرُونَ"],"ллаа йамассухуу иллаа лмутаххаруун","К нему прикасаются только очищенные.",["не","касаются его","кроме","очищенных"]],[56,80,["تَنزِيلٞ","مِّن","رَّبِّ","ٱلۡعَٰلَمِينَ"],"танзиилум мир рабби л`ааламиин","Он ниспослан Господом миров.",["ниспосланный","от","Господа","миров"]],[56,81,["أَفَبِهَٰذَا","ٱلۡحَدِيثِ","أَنتُم","مُّدۡهِنُونَ"],"афабихаазаа лхадииси антум ммудхинуун","Неужели вы не веруете в это повествование (или отворачиваетесь от него)",["неужели к этому","повествованию","вы","пренебрежительны"]],[56,82,["وَتَجۡعَلُونَ","رِزۡقَكُمۡ","أَنَّكُمۡ","تُكَذِّبُونَ"],"уатадж`алууна ризкакум аннакум туказзибуун","и делаете ваш удел тем, что считаете ложью истину?",["и делаете","удел ваш","в том, что вы","считаете ложью"]],[56,83,["فَلَوۡلَآ","إِذَا","بَلَغَتِ","ٱلۡحُلۡقُومَ"],"фалаулаа изаа балагати лхулкуум","А когда душа подступает к горлу",["почему же не","когда","дойдёт (душа)","до горла"]],[56,84,["وَأَنتُمۡ","حِينَئِذٖ","تَنظُرُونَ"],"уа'антум хиина'изин танзуруун","и вы смотрите на умирающего,",["и вы","тогда","смотрите"]],[56,85,["وَنَحۡنُ","أَقۡرَبُ","إِلَيۡهِ","مِنكُمۡ","وَلَٰكِن","لَّا","تُبۡصِرُونَ"],"уанахну акрабу илайхи минкум уалаакил лаа тубсируун","Мы находимся ближе вас к нему, хотя вы не видите этого.",["а Мы","ближе","к нему","чем вы","но","не","видите вы"]],[56,86,["فَلَوۡلَآ","إِن","كُنتُمۡ","غَيۡرَ","مَدِينِينَ"],"фалаулаа ин кунтум гайра мадииниин","Почему же вы, если вы действительно не получите воздаяние",["почему же не","если","вы","не","подлежащие воздаянию"]],[56,87,["تَرۡجِعُونَهَآ","إِن","كُنتُمۡ","صَٰدِقِينَ"],"тарджи`уунахаа ин кунтум саадикиин","не вернете ее, если вы говорите правду?",["вернёте её","если","вы","правдивы"]],[56,88,["فَأَمَّآ","إِن","كَانَ","مِنَ","ٱلۡمُقَرَّبِينَ"],"фа'аммаа ин каана мина лмукаррабиин","Если он будет одним из приближенных,",["и если же","если","был он","из","приближённых"]],[56,89,["فَرَوۡحٞ","وَرَيۡحَانٞ","وَجَنَّتُ","نَعِيمٖ"],"фараухун уарайхаанун уаджаннату на`иим","то обретет покой (или радость; или милость), удел (или базилик) и Сад блаженства.",["то отдых","и благоухание","и Сад","блаженства"]],[56,90,["وَأَمَّآ","إِن","كَانَ","مِنۡ","أَصۡحَٰبِ","ٱلۡيَمِينِ"],"уа'аммаа ин каана мин асхааби лйамиин","Если он будет одним из тех, кто по правую сторону,",["а если же","если","был он","из","обитателей","правой стороны"]],[56,91,["فَسَلَٰمٞ","لَّكَ","مِنۡ","أَصۡحَٰبِ","ٱلۡيَمِينِ"],"фасалаамул лака мин асхааби лйамиин","то ему скажут: «Мир тебе! Ты являешься одним из тех, кто на правой стороне».",["то мир","тебе","от","обитателей","правой стороны"]],[56,92,["وَأَمَّآ","إِن","كَانَ","مِنَ","ٱلۡمُكَذِّبِينَ","ٱلضَّآلِّينَ"],"уа'аммаа ин каана мина лмуказзибиина ддааллиин","Если же он будет одним из заблудших, считавших лжецами посланников,",["а если же","если","был он","из","отвергавших","заблудших"]],[56,93,["فَنُزُلٞ","مِّنۡ","حَمِيمٖ"],"фанузулум мин хамиим","то угощением для него будет кипяток,",["то угощение","из","кипятка"]],[56,94,["وَتَصۡلِيَةُ","جَحِيمٍ"],"уатаслийату джахиим","и он будет гореть в Аду.",["и сожжение","в Аду"]],[56,95,["إِنَّ","هَٰذَا","لَهُوَ","حَقُّ","ٱلۡيَقِينِ"],"инна хаазаа лахууа хакку лйакиин","Это и есть истина!",["поистине","это","непременно оно","истина","достоверная"]],[56,96,["فَسَبِّحۡ","بِٱسۡمِ","رَبِّكَ","ٱلۡعَظِيمِ"],"фасаббих бисми раббика л`азиим","Прославляй же имя Господа твоего Великого!",["славь же","именем","твоего Господа","Великого"]],[57,1,["سَبَّحَ","لِلَّهِ","مَا","فِي","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِۖ","وَهُوَ","ٱلۡعَزِيزُ","ٱلۡحَكِيمُ"],"саббаха лиллахи маа фии ссамаауаати уал'арди уахууа л`азиизу лхакиим","Славит Аллаха то, что на небесах и на земле. Он - Могущественный, Мудрый.",["славит","Аллаха","то, что","на","небесах","и на земле","и Он","Могущественный","Мудрый"]],[57,2,["لَهُۥ","مُلۡكُ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِۖ","يُحۡيِۦ","وَيُمِيتُۖ","وَهُوَ","عَلَىٰ","كُلِّ","شَيۡءٖ","قَدِيرٌ"],"лахуу мулку ссамаауаати уал'арди йухйии уайумииту уахууа `алаа кулли шай'ин кадиир","Ему принадлежит власть над небесами и землей. Он оживляет и умерщвляет, и Он способен на всякую вещь.",["Ему","власть","небес","и земли","Он оживляет","и умерщвляет","и Он","над","всякой","вещью","Всемогущ"]],[57,3,["هُوَ","ٱلۡأَوَّلُ","وَٱلۡأٓخِرُ","وَٱلظَّٰهِرُ","وَٱلۡبَاطِنُۖ","وَهُوَ","بِكُلِّ","شَيۡءٍ","عَلِيمٌ"],"хууа л'аууалу уал'хиру уаззаахиру уалбаатину уахууа бикулли шай'ин `алиим","Он - Первый и Последний, Высочайший и Ближайший. Он знает о всякой вещи.",["Он","Первый","и Последний","и Явный","и Скрытый","и Он","о всякой","вещи","Знающий"]]]}