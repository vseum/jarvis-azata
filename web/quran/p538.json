{"p":538,"j":27,"a":[[57,4,["هُوَ","ٱلَّذِي","خَلَقَ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضَ","فِي","سِتَّةِ","أَيَّامٖ","ثُمَّ","ٱسۡتَوَىٰ","عَلَى","ٱلۡعَرۡشِۖ","يَعۡلَمُ","مَا","يَلِجُ","فِي","ٱلۡأَرۡضِ","وَمَا","يَخۡرُجُ","مِنۡهَا","وَمَا","يَنزِلُ","مِنَ","ٱلسَّمَآءِ","وَمَا","يَعۡرُجُ","فِيهَاۖ","وَهُوَ","مَعَكُمۡ","أَيۡنَ","مَا","كُنتُمۡۚ","وَٱللَّهُ","بِمَا","تَعۡمَلُونَ","بَصِيرٞ"],"хуал лазии халаḳас самавати вал'арда фии ситтати аййамин суммастава `алал `арши йа`ламу ма йалижу фил арди вама йахружу минха вама йанзилу минас самаи вама йа`ружу фииха вахуа ма`акум айна ма кунтум валлаху бима та`малууна басиир","Он - Тот, Кто сотворил небеса и землю за шесть дней, а затем вознесся на Трон (или утвердился на Троне). Он знает то, что проникает в землю, и то, что выходит из нее, и то, что нисходит с неба, и то, что восходит к нему. Он с вами, где бы вы ни были. Аллах видит все, что вы совершаете.",["Он","Тот, Который","сотворил","небеса","и землю","за","шесть","дней","затем","вознёсся","на","Трон","Он знает","то, что","проникает","в","землю","и то, что","выходит","из неё","и то, что","нисходит","с","неба","и то, что","восходит","туда","и Он","с вами","где бы","ни","были вы","и Аллах","то, что","вы делаете","Видящий"]],[57,5,["لَّهُۥ","مُلۡكُ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِۚ","وَإِلَى","ٱللَّهِ","تُرۡجَعُ","ٱلۡأُمُورُ"],"ллахуу мулкус самавати вал'арди ва'илаллахи туржа`ул умуур","Ему принадлежит власть над небесами и землей, и к Аллаху возвращаются дела.",["Ему","власть","небес","и земли","и к","Аллаху","возвращаются","дела"]],[57,6,["يُولِجُ","ٱلَّيۡلَ","فِي","ٱلنَّهَارِ","وَيُولِجُ","ٱلنَّهَارَ","فِي","ٱلَّيۡلِۚ","وَهُوَ","عَلِيمُۢ","بِذَاتِ","ٱلصُّدُورِ"],"йуулижул лайла фин нахари вайуулижун нахара фил лайли вахуа `алииму бизатис судуур","Он увеличивает день за счет ночи и увеличивает ночь за счет дня. Он знает о том, что в груди.",["Он вводит","ночь","в","день","и вводит","день","в","ночь","и Он","Знающий","о том, что в","груди"]],[57,7,["ءَامِنُواْ","بِٱللَّهِ","وَرَسُولِهِۦ","وَأَنفِقُواْ","مِمَّا","جَعَلَكُم","مُّسۡتَخۡلَفِينَ","فِيهِۖ","فَٱلَّذِينَ","ءَامَنُواْ","مِنكُمۡ","وَأَنفَقُواْ","لَهُمۡ","أَجۡرٞ","كَبِيرٞ"],"аминуу биллахи варасуулихии ва'анфиḳуу мимма жа`алакум мустахлафиина фиихи фаллазиина амануу минкум ва'анфаḳуу лахум ажрун кабиир","Веруйте в Аллаха и Его Посланника и расходуйте из того, что Он дал вам в распоряжение. Тем же из вас, которые уверовали и расходовали, уготована великая награда.",["Веруйте","в Аллаха","и Его Посланника","и расходуйте","из того, что","Он сделал вас","преемниками","в нём","И те, которые","уверовали","из вас","и расходовали","им","награда","великая"]],[57,8,["وَمَا","لَكُمۡ","لَا","تُؤۡمِنُونَ","بِٱللَّهِ","وَٱلرَّسُولُ","يَدۡعُوكُمۡ","لِتُؤۡمِنُواْ","بِرَبِّكُمۡ","وَقَدۡ","أَخَذَ","مِيثَٰقَكُمۡ","إِن","كُنتُم","مُّؤۡمِنِينَ"],"вама лакум ла ту'минууна биллахи варрасуулу йад`уукум литу'минуу бираббикум ваḳад ахаза миисаḳакум ин кунтум му'миниин","Что с вами? Почему вы не веруете в Аллаха, тогда как Посланник призывает вас уверовать в вашего Господа? Он уже взял с вас завет, если только вы действительно являетесь верующими.",["И что","с вами","не","веруете","в Аллаха","а Посланник","призывает вас","чтобы вы уверовали","в вашего Господа","и уже","Он взял","ваш завет","если","вы являетесь","верующими"]],[57,9,["هُوَ","ٱلَّذِي","يُنَزِّلُ","عَلَىٰ","عَبۡدِهِۦٓ","ءَايَٰتِۭ","بَيِّنَٰتٖ","لِّيُخۡرِجَكُم","مِّنَ","ٱلظُّلُمَٰتِ","إِلَى","ٱلنُّورِۚ","وَإِنَّ","ٱللَّهَ","بِكُمۡ","لَرَءُوفٞ","رَّحِيمٞ"],"хуал лазии йуназзилу `ала `абдихии айати баййинатил лийухрижакум миназ зулумати илан нуури ва'инналлаха бикум лараууфур рахиим","Он - Тот, Кто ниспосылает Своему рабу ясные знамения, чтобы вывести вас из мраков к свету. Воистину, Аллах сострадателен и милосерден к вам.",["Он","Тот, Который","ниспосылает","на","Своего раба","знамения","ясные","чтобы вывести вас","из","мраков","к","свету","И поистине","Аллах","к вам","непременно Сострадателен","Милосерден"]],[57,10,["وَمَا","لَكُمۡ","أَلَّا","تُنفِقُواْ","فِي","سَبِيلِ","ٱللَّهِ","وَلِلَّهِ","مِيرَٰثُ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِۚ","لَا","يَسۡتَوِي","مِنكُم","مَّنۡ","أَنفَقَ","مِن","قَبۡلِ","ٱلۡفَتۡحِ","وَقَٰتَلَۚ","أُوْلَٰٓئِكَ","أَعۡظَمُ","دَرَجَةٗ","مِّنَ","ٱلَّذِينَ","أَنفَقُواْ","مِنۢ","بَعۡدُ","وَقَٰتَلُواْۚ","وَكُلّٗا","وَعَدَ","ٱللَّهُ","ٱلۡحُسۡنَىٰۚ","وَٱللَّهُ","بِمَا","تَعۡمَلُونَ","خَبِيرٞ"],"вама лакум алла тунфиḳуу фии сабиилиллахи валиллахи миирасус самавати вал'арди ла йаставии минкум ман анфаḳа мин ḳаблил фатхи ваḳатала улаика а`заму даражатам минал лазиина анфаḳуу мим ба`ду ваḳаталуу вакуллан ва`адаллахул хусна валлаху бима та`малууна хабиир","Что с вами? Почему вы не расходуете на пути Аллаха, тогда как Аллаху принадлежит наследство небес и земли. Не сравнятся люди с теми из вас, кто расходовал и сражался до победы над Меккой. Эти выше степенью, чем те, которые расходовали и сражались после этого. Но каждому из них Аллах обещал наилучшее, и Аллах ведает о том, что вы совершаете.",["И что","с вами","что не","расходуете","на","пути","Аллаха","а Аллаху","наследие","небес","и земли","Не","равны","из вас","кто","расходовал","ещё","до","победы","и сражался","Те","выше","степенью","чем","те, которые","расходовали","уже","после","и сражались","И каждому","обещал","Аллах","наилучшее","И Аллах","о том, что","вы делаете","Сведущ"]],[57,11,["مَّن","ذَا","ٱلَّذِي","يُقۡرِضُ","ٱللَّهَ","قَرۡضًا","حَسَنٗا","فَيُضَٰعِفَهُۥ","لَهُۥ","وَلَهُۥٓ","أَجۡرٞ","كَرِيمٞ"],"мман зал лазии йуḳридуллаха ḳардан хасанан файуда`ифахуу лахуу валахуу ажрун кариим","Если кто одолжит Аллаху прекрасный заем, то Аллах увеличит его для него. Ему уготована щедрая награда.",["Кто","это","тот, который","одолжит","Аллаху","заём","прекрасный","и Он умножит его","ему","и ему","награда","щедрая"]]],"m":[[["هُوَ","Он",57,4],["ٱلَّذِي","Тот, Который",57,4],["خَلَقَ","сотворил",57,4],["ٱلسَّمَٰوَٰتِ","небеса",57,4],["وَٱلۡأَرۡضَ","и землю",57,4],["فِي","за",57,4],["سِتَّةِ","шесть",57,4],["أَيَّامٖ","дней",57,4],["ثُمَّ","затем",57,4],["ٱ