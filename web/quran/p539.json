4]],[["ٱللَّهِ","Аллаха",57,14],["وَغَرَّكُم","и обольстил вас",57,14],["بِٱللَّهِ","относительно Аллаха",57,14],["ٱلۡغَرُورُ","обольститель",57,14],[14],["فَٱلۡيَوۡمَ","И сегодня",57,15],["لَا","не",57,15],["يُؤۡخَذُ","будет принят",57,15],["مِنكُمۡ","от вас",57,15],["فِدۡيَةٞ","выкуп",57,15],["وَلَا","и не",57,15]],[["مِنَ","от",57,15],["ٱلَّذِينَ","тех, которые",57,15],["كَفَرُواْۚ","не уверовали",57,15],["مَأۡوَىٰكُمُ","Ваше пристанище",57,15],["ٱلنَّارُۖ","Огонь",57,15],["هِيَ","он",57,15],["مَوۡلَىٰكُمۡۖ","ваш покровитель",57,15],["وَبِئۡسَ","и скверно",57,15],["ٱلۡمَصِيرُ","место прибытия",57,15]],[[15],["۞ أَلَمۡ","Разве не",57,16],["يَأۡنِ","пришло время",57,16],["لِلَّذِينَ","для тех, которые",57,16],["ءَامَنُوٓاْ","уверовали",57,16],["أَن","чтобы",57,16],["تَخۡشَعَ","смирились",57,16],["قُلُوبُهُمۡ","их сердца",57,16],["لِذِكۡرِ","при поминании",57,16],["ٱللَّهِ","Аллаха",57,16]],[["وَمَا","и того, что",57,16],["نَزَلَ","сошло",57,16],["مِنَ","из",57,16],["ٱلۡحَقِّ","истины",57,16],["وَلَا","и не",57,16],["يَكُونُواْ","были",57,16],["كَٱلَّذِينَ","как те, которые",57,16],["أُوتُواْ","получили",57,16],["ٱلۡكِتَٰبَ","Писание",57,16],["مِن","ещё",57,16],["قَبۡلُ","прежде",57,16]],[["فَطَالَ","и стал долгим",57,16],["عَلَيۡهِمُ","для них",57,16],["ٱلۡأَمَدُ","срок",57,16],["فَقَسَتۡ","и ожесточились",57,16],["قُلُوبُهُمۡۖ","их сердца",57,16],["وَكَثِيرٞ","и многие",57,16],["مِّنۡهُمۡ","из них",57,16],["فَٰسِقُونَ","нечестивцы",57,16],[16]],[["ٱعۡلَمُوٓاْ","Знайте",57,17],["أَنَّ","что",57,17],["ٱللَّهَ","Аллах",57,17],["يُحۡيِ","оживляет",57,17],["ٱلۡأَرۡضَ","землю",57,17],["بَعۡدَ","после",57,17],["مَوۡتِهَاۚ","её смерти",57,17],["قَدۡ","Уже",57,17],["بَيَّنَّا","Мы разъяснили",57,17],["لَكُمُ","вам",57,17],["ٱلۡأٓيَٰتِ","знамения",57,17]],[["لَعَلَّكُمۡ","может быть, вы",57,17],["تَعۡقِلُونَ","уразумеете",57,17],[17],["إِنَّ","Поистине",57,18],["ٱلۡمُصَّدِّقِينَ","раздающие милостыню мужчины",57,18],["وَٱلۡمُصَّدِّقَٰتِ","и раздающие милостыню женщины",57,1