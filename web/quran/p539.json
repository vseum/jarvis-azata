{"p":539,"j":27,"a":[[57,12,["يَوۡمَ","تَرَى","ٱلۡمُؤۡمِنِينَ","وَٱلۡمُؤۡمِنَٰتِ","يَسۡعَىٰ","نُورُهُم","بَيۡنَ","أَيۡدِيهِمۡ","وَبِأَيۡمَٰنِهِمۖ","بُشۡرَىٰكُمُ","ٱلۡيَوۡمَ","جَنَّٰتٞ","تَجۡرِي","مِن","تَحۡتِهَا","ٱلۡأَنۡهَٰرُ","خَٰلِدِينَ","فِيهَاۚ","ذَٰلِكَ","هُوَ","ٱلۡفَوۡزُ","ٱلۡعَظِيمُ"],"йаума тарал му'миниина валму'минати йас`а нуурухум байна айдиихим вабиайманихим бушракумул йаума жаннатун тажрии мин тахтихал анхару халидиина фииха залика хуал фаузул `азиим","в тот день, когда ты увидишь, как перед верующими мужчинами и верующими женщинами и справа от них будет распространяться их свет. Возрадуйтесь сегодня Райским садам, в которых текут реки. Вы пребудете в них вечно. Это и есть великое преуспеяние.",["В тот день","увидишь","верующих мужчин","и верующих женщин","устремляется","их свет","перед","ними (букв. руками их)","и справа от них","Радостная весть вам","сегодня","сады","текут","из","под ними","реки","пребывая вечно","в них","Это","оно","успех","великий"]],[57,13,["يَوۡمَ","يَقُولُ","ٱلۡمُنَٰفِقُونَ","وَٱلۡمُنَٰفِقَٰتُ","لِلَّذِينَ","ءَامَنُواْ","ٱنظُرُونَا","نَقۡتَبِسۡ","مِن","نُّورِكُمۡ","قِيلَ","ٱرۡجِعُواْ","وَرَآءَكُمۡ","فَٱلۡتَمِسُواْ","نُورٗاۖ","فَضُرِبَ","بَيۡنَهُم","بِسُورٖ","لَّهُۥ","بَابُۢ","بَاطِنُهُۥ","فِيهِ","ٱلرَّحۡمَةُ","وَظَٰهِرُهُۥ","مِن","قِبَلِهِ","ٱلۡعَذَابُ"],"йаума йаḳуулул мунафиḳууна валмунафиḳату лиллазиина аманунзурууна наḳтабис мин нуурикум ḳииларжи`уу вараакум фалтамисуу нууран фадуриба байнахум бисуурил лахуу бабу батинухуу фиихир рахмату вазахирухуу мин ḳибалихил `азаб","В тот день лицемеры и лицемерки скажут верующим: «Погодите, мы позаимствуем у вас немного света». Им будет сказано: «Возвращайтесь назад и ищите свет». Между ними будет возведен забор с вратами, с внутренней стороны которого будет милость, а снаружи - мучения.",["В тот день","скажут","лицемеры","и лицемерки","тем, которые","уверовали","Подождите нас","мы позаимствуем","от","вашего света","Будет сказано","Возвращайтесь","назад","и ищите","свет","И воздвигнута","между ними","стена","у которой","врата","внутренняя сторона его","в ней","милость","а внешняя сторона его","с","её стороны","мучение"]],[57,14,["يُنَادُونَهُمۡ","أَلَمۡ","نَكُن","مَّعَكُمۡۖ","قَالُواْ","بَلَىٰ","وَلَٰكِنَّكُمۡ","فَتَنتُمۡ","أَنفُسَكُمۡ","وَتَرَبَّصۡتُمۡ","وَٱرۡتَبۡتُمۡ","وَغَرَّتۡكُمُ","ٱلۡأَمَانِيُّ","حَتَّىٰ","جَآءَ","أَمۡرُ","ٱللَّهِ","وَغَرَّكُم","بِٱللَّهِ","ٱلۡغَرُورُ"],"йунадуунахум алам накум ма`акум ḳалуу бала валакиннакум фатантум анфусакум ватараббастум вартабтум вагарраткумул аманиййу хатта жаа амруллахи вагарракум биллахил гаруур","Они будут взывать к ним: «Разве мы не были с вами?». Они скажут: «Да, но вы соблазняли самих себя, выжидали, сомневались и обольщались надеждами до тех пор, пока не явилось повеление Аллаха. Соблазнитель (дьявол) обманул вас относительно Аллаха.",["Они будут звать их","Разве не","были мы","с вами","Скажут","Да","но вы","искусили","самих себя","и выжидали","и сомневались","и обольстили вас","мечтания","пока не","пришло","повеление","Аллаха","и обольстил вас","относительно Аллаха","обольститель"]],[57,15,["فَٱلۡيَوۡمَ","لَا","يُؤۡخَذُ","مِنكُمۡ","فِدۡيَةٞ","وَلَا","مِنَ","ٱلَّذِينَ","كَفَرُواْۚ","مَأۡوَىٰكُمُ","ٱلنَّارُۖ","هِيَ","مَوۡلَىٰكُمۡۖ","وَبِئۡسَ","ٱلۡمَصِيرُ"],"фалйаума ла йу'хазу минкум фидйатун вала минал лазиина кафаруу ма'вакумун нару хийа маулакум ваби'сал масиир","Сегодня ни от вас, ни от неверующих не примут выкупа. Вашим пристанищем будет Огонь, который более всего подобает вам. Как же скверно это место прибытия!».",["И сегодня","не","будет принят","от вас","выкуп","и не","от","тех, которые","не уверовали","Ваше пристанище","Огонь","он","ваш покровитель","и скверно","место прибытия"]],[57,16,["أَلَمۡ","يَأۡنِ","لِلَّذِينَ","ءَامَنُوٓاْ","أَن","تَخۡشَعَ","قُلُوبُهُمۡ","لِذِكۡرِ","ٱللَّهِ","وَمَا","نَزَلَ","مِنَ","ٱلۡحَقِّ","وَلَا","يَكُونُواْ","كَٱلَّذِينَ","أُوتُواْ","ٱلۡكِتَٰبَ","مِن","قَبۡلُ","فَطَالَ","عَلَيۡهِمُ","ٱلۡأَمَدُ","فَقَسَتۡ","قُلُوبُهُمۡۖ","وَكَثِيرٞ","مِّنۡهُمۡ","فَٰسِقُونَ"],"алам йа'ни лиллазиина амануу ан тахша`а ḳулуубухум лизикриллахи вама назала минал хаḳḳи вала йакуунуу каллазиина уутул китаба мин ḳаблу фатала `алайхимул амаду фаḳасат ḳулуубухум вакасиирум минхум фасиḳуун","Разве не пришло время для того, чтобы сердца верующих смирились при упоминании Аллаха и того, что ниспослано из истины, и чтобы не уподоблялись они тем, которым Писание было даровано прежде, чьи сердца почерствели по прошествии долгого времени и многие из которых являются нечестивцами?",["Разве не","пришло время","для тех, которые","уверовали","чтобы","смирились","их сердца","при поминании","Аллаха","и того, что","сошло","из","истины","и не","были","как те, которые","получили","Писание","ещё","прежде","и стал долгим","для них","срок","и ожесточились","их сердца","и многие","из них","нечестивцы"]],[57,17,["ٱعۡلَمُوٓاْ","أَنَّ","ٱللَّهَ","يُحۡيِ","ٱلۡأَرۡضَ","بَعۡدَ","مَوۡتِهَاۚ","قَدۡ","بَيَّنَّا","لَكُمُ","ٱلۡأٓيَٰتِ","لَعَلَّكُمۡ","تَعۡقِلُونَ"],"и`ламуу анналлаха йухйил арда ба`да маутиха ḳад баййанна лакумул айати ла`аллакум та`ḳилуун","Знайте, что Аллах оживляет землю после ее смерти. Мы уже разъяснили вам знамения, - может быть, вы уразумеете.",["Знайте","что","Аллах","оживляет","землю","после","её смерти","Уже","Мы разъяснили","вам","знамения","может быть, вы","уразумеете"]],[57,18,["إِنَّ","ٱلۡمُصَّدِّقِينَ","وَٱلۡمُصَّدِّقَٰتِ","وَأَقۡرَضُواْ","ٱللَّهَ","قَرۡضًا","حَسَنٗا","يُضَٰعَفُ","لَهُمۡ","وَلَهُمۡ","أَجۡرٞ","كَرِيمٞ"],"иннал муссаддиḳиина валмуссаддиḳати ва'аḳрадуллаха ḳардан хасанан йуда`афу лахум валахум ажрун кариим","Воистину, для мужчин и женщин, которые раздавали милостыню и одолжили Аллаху прекрасный заем, он будет увеличен. Им уготована щедрая награда.",["Поистине","раздающие милостыню мужчины","и раздающие милостыню женщины","и одолжили","Аллаху","заём","прекрасный","будет умножено","им","и им","награда","щедрая"]]],"m":[[["يَوۡمَ","В тот день",57,12],["تَرَى","увидишь",57,12],["ٱلۡمُؤۡمِنِينَ","верующих мужчин",57,12],["وَٱلۡمُؤۡمِنَ