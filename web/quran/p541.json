{"p":541,"j":27,"a":[[57,25,["لَقَدۡ","أَرۡسَلۡنَا","رُسُلَنَا","بِٱلۡبَيِّنَٰتِ","وَأَنزَلۡنَا","مَعَهُمُ","ٱلۡكِتَٰبَ","وَٱلۡمِيزَانَ","لِيَقُومَ","ٱلنَّاسُ","بِٱلۡقِسۡطِۖ","وَأَنزَلۡنَا","ٱلۡحَدِيدَ","فِيهِ","بَأۡسٞ","شَدِيدٞ","وَمَنَٰفِعُ","لِلنَّاسِ","وَلِيَعۡلَمَ","ٱللَّهُ","مَن","يَنصُرُهُۥ","وَرُسُلَهُۥ","بِٱلۡغَيۡبِۚ","إِنَّ","ٱللَّهَ","قَوِيٌّ","عَزِيزٞ"],"лаḳад арсална русулана билбаййинати ва'анзална ма`ахумул китаба валмиизана лийаḳууман насу билḳисти ва'анзалнал хадиида фиихи ба'сун шадиидун ваманафи`у линнаси валийа`ламаллаху ман йансурухуу варусулахуу билгайби инналлаха ḳавиййун `азииз","Мы уже отправили Наших посланников с ясными знамениями и ниспослали с ними Писание и Весы, чтобы люди придерживались справедливости. Мы также ниспослали железо, в котором заключается могучая сила и польза для людей, для того, чтобы Аллах узнал тех, кто помогает Ему и Его посланникам, хотя и не видит Его воочию. Воистину, Аллах - Всесильный, Могущественный.",["Уже","Мы отправили","Наших посланников","с ясными знамениями","и Мы ниспослали","с ними","Писание","и Весы","чтобы придерживались","люди","справедливости","И Мы ниспослали","железо","в нём","сила","могучая","и польза","для людей","и чтобы узнал","Аллах","кто","помогает Ему","и Его посланникам","не видя (Его)","Поистине","Аллах","Сильный","Могущественный"]],[57,26,["وَلَقَدۡ","أَرۡسَلۡنَا","نُوحٗا","وَإِبۡرَٰهِيمَ","وَجَعَلۡنَا","فِي","ذُرِّيَّتِهِمَا","ٱلنُّبُوَّةَ","وَٱلۡكِتَٰبَۖ","فَمِنۡهُم","مُّهۡتَدٖۖ","وَكَثِيرٞ","مِّنۡهُمۡ","فَٰسِقُونَ"],"валаḳад арсална нуухан ва'ибрахиима важа`ална фии зурриййатихиман нубуввата валкитаба фаминхум мухтадин вакасиирум минхум фасиḳуун","Мы уже отправили Нуха (Ноя) и Ибрахима (Авраама) и установили пророчество и Писание в их потомстве. Среди них есть такие, которые следуют прямым путем, но многие из них являются нечестивцами.",["И уже","Мы отправили","Нуха","и Ибрахима","и Мы установили","в","их потомстве","пророчество","и Писание","И среди них","идущий прямым путём","но многие","из них","нечестивцы"]],[57,27,["ثُمَّ","قَفَّيۡنَا","عَلَىٰٓ","ءَاثَٰرِهِم","بِرُسُلِنَا","وَقَفَّيۡنَا","بِعِيسَى","ٱبۡنِ","مَرۡيَمَ","وَءَاتَيۡنَٰهُ","ٱلۡإِنجِيلَۖ","وَجَعَلۡنَا","فِي","قُلُوبِ","ٱلَّذِينَ","ٱتَّبَعُوهُ","رَأۡفَةٗ","وَرَحۡمَةٗۚ","وَرَهۡبَانِيَّةً","ٱبۡتَدَعُوهَا","مَا","كَتَبۡنَٰهَا","عَلَيۡهِمۡ","إِلَّا","ٱبۡتِغَآءَ","رِضۡوَٰنِ","ٱللَّهِ","فَمَا","رَعَوۡهَا","حَقَّ","رِعَايَتِهَاۖ","فَـَٔاتَيۡنَا","ٱلَّذِينَ","ءَامَنُواْ","مِنۡهُمۡ","أَجۡرَهُمۡۖ","وَكَثِيرٞ","مِّنۡهُمۡ","فَٰسِقُونَ"],"сумма ḳаффайна `ала асарихим бирусулина ваḳаффайна би`иисабни марйама ва'атайнахул инжиила важа`ална фии ḳулуубил лазиинаттаба`ууху ра'фатан варахматан варахбаниййатанибтада`ууха ма катабнаха `алайхим иллабтигаа ридваниллахи фама ра`ауха хаḳḳа ри`айатиха фа'атайнал лазиина амануу минхум ажрахум вакасиирум минхум фасиḳуун","Потом Мы отправили по их следам Наших посланников, и отправили Ису (Иисуса), сына Марьям (Марии), и даровали ему Инджил (Евангелие). В сердца тех, которые последовали за ним, Мы вселили сострадание и милосердие, а монашество они выдумали сами. Мы не предписывали им этого, но они поступили так, дабы снискать довольство Аллаха (или Мы предписали им только стремиться к довольству Аллаха). Но они не соблюли его должным образом. Тем из них, которые уверовали, Мы даровали их награду, но многие из них являются нечестивцами.",["Затем","Мы отправили вслед","по","их следам","Наших посланников","и Мы отправили вслед","Ису","сына","Марьям","и Мы даровали ему","Инджил","И Мы вселили","в","сердца","тех, которые","последовали за ним","сострадание","и милосердие","А монашество","они выдумали его","не","Мы предписали его","им","лишь","стремясь к","довольству","Аллаха","но не","соблюли они его","должным","соблюдением","И Мы даровали","тем, которые","уверовали","из них","их награду","но многие","из них","нечестивцы"]],[57,28,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُواْ","ٱتَّقُواْ","ٱللَّهَ","وَءَامِنُواْ","بِرَسُولِهِۦ","يُؤۡتِكُمۡ","كِفۡلَيۡنِ","مِن","رَّحۡمَتِهِۦ","وَيَجۡعَل","لَّكُمۡ","نُورٗا","تَمۡشُونَ","بِهِۦ","وَيَغۡفِرۡ","لَكُمۡۚ","وَٱللَّهُ","غَفُورٞ","رَّحِيمٞ"],"йа'аййухал лазиина амануттаḳуллаха ва'аминуу бирасуулихии йу'тикум кифлайни мир рахматихии вайаж`ал лакум нууран тамшууна бихии вайагфир лакум валлаху гафуурур рахиим","О те, которые уверовали! Бойтесь Аллаха и веруйте в Его Посланника, и тогда Он одарит вас вдвойне из Своей милости, и дарует вам свет, при котором вы будете идти, и простит вас. Аллах - Прощающий, Милосердный.",["О","те, которые","уверовали","Бойтесь","Аллаха","и уверуйте","в Его Посланника","Он даст вам","двойную долю","из","Своей милости","и сделает","вам","свет","вы будете ходить","с ним","и простит","вас","И Аллах","Прощающий","Милосердный"]],[57,29,["لِّئَلَّا","يَعۡلَمَ","أَهۡلُ","ٱلۡكِتَٰبِ","أَلَّا","يَقۡدِرُونَ","عَلَىٰ","شَيۡءٖ","مِّن","فَضۡلِ","ٱللَّهِ","وَأَنَّ","ٱلۡفَضۡلَ","بِيَدِ","ٱللَّهِ","يُؤۡتِيهِ","مَن","يَشَآءُۚ","وَٱللَّهُ","ذُو","ٱلۡفَضۡلِ","ٱلۡعَظِيمِ"],"лли'алла йа`лама ахлул китаби алла йаḳдирууна `ала шай'им мин фадлиллахи ва'аннал фадла бийадиллахи йу'тиихи ман йашау валлаху зул фадлил `азиим","Аллах одарит вас для того, чтобы люди Писания знали, что они ничего не способны приобрести из милости Аллаха и что милость находится в Руке Аллаха, Который дарует ее тому, кому пожелает. Аллах обладает великой милостью.",["Дабы","знали","люди","Писания","что не","властны они","над","чем-либо","из","милости","Аллаха","и что","милость","в Руке","Аллаха","Он дарует её","кому","пожелает","И Аллах","Обладатель","милости","великой"]]],"m":[[["لَقَدۡ","Уже",57,25],["أَرۡسَلۡنَا","Мы отправили",57,25],["رُسُلَنَا","Наших посланников",57,25],["بِٱلۡبَيِّنَٰتِ","с ясными знамениями",57,25],["وَأَنزَلۡنَا","и Мы ниспослали",57,25],["مَعَهُمُ","с ними",57,25],["ٱلۡكِتَٰبَ","Писание",57,25]],[["وَٱلۡمِيزَانَ","и Весы",57,25],["لِيَقُومَ","чтобы придерживались",57,25],["ٱلنَّاسُ","люди",57,25],["بِٱلۡقِسۡطِۖ","справедливости",57,25],["وَأَنزَلۡنَا","И Мы ниспослали",57,25],["ٱلۡحَدِيدَ","железо",57,25],["فِيهِ","в нём",57,25]],[["بَأۡسٞ","сила",57,25],["شَدِيدٞ","могучая",57,25],["وَمَنَٰفِعُ","и польза",57,25],["لِلنَّاسِ","для людей",57,25],["وَلِيَعۡلَمَ","и чтобы узнал",57,25],["ٱللَّهُ","Аллах",57,25],["مَن","кто",57,25],["يَنصُرُهُۥ","помогает Ему",57,25],["وَرُسُلَهُۥ","и Его посланникам",57,25]],[["بِٱلۡغَيۡبِۚ","не видя (Его)",57,25],["إِنَّ","Поистине",57,25],["ٱللَّهَ","Аллах",57,25],["قَوِيٌّ","Сильный",57,25],["عَزِيزٞ","Могущественный",57,25],[25],["وَلَقَدۡ","И уже",57,26],["أَرۡسَلۡنَا","Мы отправили",57,26],["نُوحٗا","Нуха",57,26],["وَإِبۡرَٰهِيمَ","и Ибрахима",57,26]],[["وَجَعَلۡنَا","и Мы установили",57,26],["فِي","в",57,26],["ذُرِّيَّتِهِمَا","их потомстве",57,26],["ٱلنُّبُوَّةَ","пророчество",57,26],["وَٱلۡكِتَٰبَۖ","и Писание",57,26],["فَمِنۡهُم","И среди них",57,26],["مُّهۡتَدٖۖ","идущий прямым путём",57,26]],[["وَكَثِيرٞ","но многие",57,26],["مِّنۡهُمۡ","из них",57,26],["فَٰسِقُونَ","нечестивцы",57,26],[26],["ثُمَّ","Затем",57,27],["قَفَّيۡنَا","Мы отправили вслед",57,27],["عَلَىٰٓ","по",57,27],["ءَاثَٰرِهِم","их следам",57,27]],[["بِرُسُلِنَا","Наших посланников",57,27],["وَقَفَّيۡنَا","и Мы отправили вслед",57,27],["بِعِيسَى","Ису",57,27],["ٱبۡنِ","сына",57,27],["مَرۡيَمَ","Марьям",57,27],["وَءَاتَيۡنَٰهُ","и Мы даровали ему",57,27],["ٱلۡإِنجِيلَۖ","Инджил",57,27]],[["وَجَعَلۡنَا","И Мы вселили",57,27],["فِي","в",57,27],["قُلُوبِ","сердца",57,27],["ٱلَّذِينَ","тех, которые",57,27],["ٱتَّبَعُوهُ","последовали за ним",57,27],["رَأۡفَةٗ","сострадание",57,27],["وَرَحۡمَةٗۚ","и милосердие",57,27],["وَرَهۡبَانِيَّةً","А монашество",57,27]],[["ٱبۡتَدَعُوهَا","они выдумали его",57,27],["مَا","не",57,27],["كَتَبۡنَٰهَا","Мы предписали его",57,27],["عَلَيۡهِمۡ","им",57,27],["إِلَّا","лишь",57,27],["ٱبۡتِغَآءَ","стремясь к",57,27],["رِضۡوَٰنِ","довольству",57,27],["ٱللَّهِ","Аллаха",57,27],["فَمَا","но не",57,27]],[["رَعَوۡهَا","соблюли они его",57,27],["حَقَّ","должным",57,27],["رِعَايَتِهَاۖ","соблюдением",57,27],["فَـَٔاتَيۡنَا