{"p":542,"j":28,"a":[[58,1,["قَدۡ","سَمِعَ","ٱللَّهُ","قَوۡلَ","ٱلَّتِي","تُجَٰدِلُكَ","فِي","زَوۡجِهَا","وَتَشۡتَكِيٓ","إِلَى","ٱللَّهِ","وَٱللَّهُ","يَسۡمَعُ","تَحَاوُرَكُمَآۚ","إِنَّ","ٱللَّهَ","سَمِيعُۢ","بَصِيرٌ"],"ḳад сами`аллаху ḳаулал латии тужадилука фии заужиха ваташтакии илаллахи валлаху йасма`у тахавуракума инналлаха самии`у басиир","Аллах уже услышал слова женщины, которая вступила с тобой в пререкания относительно своего мужа и пожаловалась Аллаху. Аллах слышал ваш спор, ведь Аллах - Слышащий, Видящий.",["Уже","услышал","Аллах","слова","той, которая","препирается с тобой","о","своём муже","и жалуется","перед","Аллахом","И Аллах","слышит","ваш разговор (двоих)","Поистине","Аллах","Слышащий","Видящий"]],[58,2,["ٱلَّذِينَ","يُظَٰهِرُونَ","مِنكُم","مِّن","نِّسَآئِهِم","مَّا","هُنَّ","أُمَّهَٰتِهِمۡۖ","إِنۡ","أُمَّهَٰتُهُمۡ","إِلَّا","ٱلَّٰٓـِٔي","وَلَدۡنَهُمۡۚ","وَإِنَّهُمۡ","لَيَقُولُونَ","مُنكَرٗا","مِّنَ","ٱلۡقَوۡلِ","وَزُورٗاۚ","وَإِنَّ","ٱللَّهَ","لَعَفُوٌّ","غَفُورٞ"],"аллазиина йузахирууна минкум мин нисаихим ма хунна уммахатихим ин уммахатухум иллал лаии валаднахум ва'иннахум лайаḳуулууна мункарам минал ḳаули вазууран ва'инналлаха ла`афуввун гафуур","Те из вас, которые объявляют своих жен запретными для себя, говорят слова предосудительные и лживые. Их жены - не матери им, ведь их матерями являются только женщины, которые их родили. Воистину, Аллах - Снисходительный, Прощающий.",["Те, которые","совершают зихар","из вас","с","своими жёнами","не","они","их матери","Не","их матери","кроме","тех, которые","родили их","И поистине, они","непременно говорят","мерзкое","из","слов","и ложь","И поистине","Аллах","непременно Снисходительный","Прощающий"]],[58,3,["وَٱلَّذِينَ","يُظَٰهِرُونَ","مِن","نِّسَآئِهِمۡ","ثُمَّ","يَعُودُونَ","لِمَا","قَالُواْ","فَتَحۡرِيرُ","رَقَبَةٖ","مِّن","قَبۡلِ","أَن","يَتَمَآسَّاۚ","ذَٰلِكُمۡ","تُوعَظُونَ","بِهِۦۚ","وَٱللَّهُ","بِمَا","تَعۡمَلُونَ","خَبِيرٞ"],"валлазиина йузахирууна мин нисаихим сумма йа`уудууна лима ḳалуу фатахрииру раḳабатим мин ḳабли ан йатамасса заликум туу`азууна бихии валлаху бима та`малууна хабиир","Те, которые объявляют своих жен запретными для себя, а потом отрекаются от сказанного, должны освободить одного раба прежде, чем они прикоснутся друг к другу. Этим вас увещевают, и Аллах ведает о том, что вы совершаете.",["А те, которые","совершают зихар","с","своими жёнами","затем","возвращаются","к тому, что","они сказали","то освобождение","раба","ещё","до","того как","они коснутся друг друга","Это","вас увещевают","им","И Аллах","о том, что","вы делаете","Сведущ"]],[58,4,["فَمَن","لَّمۡ","يَجِدۡ","فَصِيَامُ","شَهۡرَيۡنِ","مُتَتَابِعَيۡنِ","مِن","قَبۡلِ","أَن","يَتَمَآسَّاۖ","فَمَن","لَّمۡ","يَسۡتَطِعۡ","فَإِطۡعَامُ","سِتِّينَ","مِسۡكِينٗاۚ","ذَٰلِكَ","لِتُؤۡمِنُواْ","بِٱللَّهِ","وَرَسُولِهِۦۚ","وَتِلۡكَ","حُدُودُ","ٱللَّهِۗ","وَلِلۡكَٰفِرِينَ","عَذَابٌ","أَلِيمٌ"],"фамал лам йажид фасийаму шахрайни мутатаби`айни мин ḳабли ан йатамасса фамал лам йастати` фа'ит`аму ситтиина мискиинан залика литу'минуу биллахи варасуулихии ватилка худуудуллахи валилкафириина `азабун алиим","Если кто-либо не сможет сделать этого, то он должен поститься в течение двух месяцев без перерыва прежде, чем они прикоснутся друг к другу. А кто не способен на это, тому надлежит накормить шестьдесят бедняков. Это делается для того, чтобы вы уверовали в Аллаха и Его Посланника. Таковы ограничения Аллаха, а для неверующих уготованы мучительные страдания.",["А кто","не","найдёт","то пост","двух месяцев","подряд","ещё","до","того как","они коснутся друг друга","А кто","не","сможет","то кормление","шестидесяти","бедняков","Это","чтобы вы уверовали","в Аллаха","и Его Посланника","И это","ограничения","Аллаха","а неверующим","мучение","мучительное"]],[58,5,["إِنَّ","ٱلَّذِينَ","يُحَآدُّونَ","ٱللَّهَ","وَرَسُولَهُۥ","كُبِتُواْ","كَمَا","كُبِتَ","ٱلَّذِينَ","مِن","قَبۡلِهِمۡۚ","وَقَدۡ","أَنزَلۡنَآ","ءَايَٰتِۭ","بَيِّنَٰتٖۚ","وَلِلۡكَٰفِرِينَ","عَذَابٞ","مُّهِينٞ"],"иннал лазиина йухаддууналлаха варасуулахуу кубитуу кама кубитал лазиина мин ḳаблихим ваḳад анзална айати баййинатин валилкафириина `азабум мухиин","Те, которые враждуют с Аллахом и Его Посланником, будут унижены, как были унижены их предшественники. Мы уже ниспослали ясные знамения, а для неверующих уготованы унизительные мучения.",["Поистине","те, которые","противятся","Аллаху","и Его Посланнику","унижены","как","были унижены","те, которые","до","них","И уже","Мы ниспослали","знамения","ясные","а неверующим","мучение","унизительное"]],[58,6,["يَوۡمَ","يَبۡعَثُهُمُ","ٱللَّهُ","جَمِيعٗا","فَيُنَبِّئُهُم","بِمَا","عَمِلُوٓاْۚ","أَحۡصَىٰهُ","ٱللَّهُ","وَنَسُوهُۚ","وَٱللَّهُ","عَلَىٰ","كُلِّ","شَيۡءٖ","شَهِيدٌ"],"йаума йаб`асухумуллаху жамии`ан файунаббиухум бима `амилуу ахсахуллаху ванасууху валлаху `ала кулли шай'ин шахиид","В тот день Аллах воскресит их всех и поведает им о том, что они совершили. Аллах исчислил это, а они забыли. Аллах - Свидетель всякой вещи.",["В день","воскресит их","Аллах","всех","и сообщит им","о том, что","они совершили","исчислил это","Аллах","а они забыли это","И Аллах","над","всякой","вещью","Свидетель"]]],"m":[["h",58],["b"],[["قَدۡ","Уже",58,1],["سَمِعَ","услышал",58,1],["ٱللَّهُ","Аллах",58,1],["قَوۡلَ","слова",58,1],["ٱلَّتِي","той, которая",58,1],["تُجَٰدِلُكَ","препирается с тобой",58,1],["فِي","о",58,1],["زَوۡجِهَا","своём муже",58,1],["وَتَشۡتَكِيٓ","и жалуется",58,1],["إِلَى","перед",58,1],["ٱللَّهِ","Аллахом",58,1]],[["وَٱللَّهُ","И Аллах",58,1],["يَسۡمَعُ","слышит",58,1],["تَحَاوُرَكُمَآۚ","ваш разговор (двоих)",58,1],["إِنَّ","Поистине",58,1],["ٱللَّهَ","Аллах",58,1],["سَمِيعُۢ","Слышащий",58,1],["بَصِيرٌ","Видящий",58,1],[1],["ٱلَّذِينَ","Те, которые",58,2],["يُظَٰهِرُونَ","совершают зихар",58,2]],[["مِنكُم","из вас",58,2],["مِّن","с",58,2],["نِّسَآئِهِم","своими жёнами",58,2],["مَّا","не",58,2],["هُنَّ","они",58,2],["أُمَّهَٰتِهِمۡۖ","их матери",58,2],["إِنۡ","Не",58,2],["أُمَّهَٰتُهُمۡ","их матери",58,2],["إِلَّا","кроме",58,2],["ٱلَّٰٓـِٔي","тех, которые",58