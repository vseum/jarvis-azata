{"p":543,"j":28,"a":[[58,7,["أَلَمۡ","تَرَ","أَنَّ","ٱللَّهَ","يَعۡلَمُ","مَا","فِي","ٱلسَّمَٰوَٰتِ","وَمَا","فِي","ٱلۡأَرۡضِۖ","مَا","يَكُونُ","مِن","نَّجۡوَىٰ","ثَلَٰثَةٍ","إِلَّا","هُوَ","رَابِعُهُمۡ","وَلَا","خَمۡسَةٍ","إِلَّا","هُوَ","سَادِسُهُمۡ","وَلَآ","أَدۡنَىٰ","مِن","ذَٰلِكَ","وَلَآ","أَكۡثَرَ","إِلَّا","هُوَ","مَعَهُمۡ","أَيۡنَ","مَا","كَانُواْۖ","ثُمَّ","يُنَبِّئُهُم","بِمَا","عَمِلُواْ","يَوۡمَ","ٱلۡقِيَٰمَةِۚ","إِنَّ","ٱللَّهَ","بِكُلِّ","شَيۡءٍ","عَلِيمٌ"],"алам тара анналлаха йа`ламу ма фис самавати вама фил арди ма йакууну мин нажва саласатин илла хуа раби`ухум вала хамсатин илла хуа садисухум вала адна мин залика вала аксара илла хуа ма`ахум айна ма кануу сумма йунаббиухум бима `амилуу йаумал ḳийамати инналлаха бикулли шай'ин `алиим","Разве ты не знаешь, что Аллаху ведомо то, что на небесах, и то, что на земле? Не бывает тайной беседы между тремя, чтобы Он не был четвертым; или между пятью, чтобы Он не был шестым. Больше их или меньше - Он всегда с ними, где бы они ни были. А потом, в День воскресения, Он поведает им о том, что они совершили. Воистину, Аллах знает о всякой вещи.",["Разве не","видишь ты","что","Аллах","знает","то, что","на","небесах","и то, что","на","земле","Не","бывает","(никакой)","тайной беседы","троих","кроме (как)","Он","четвёртый их","и не","пятерых","кроме (как)","Он","шестой их","и не","меньше","чем","это","и не","больше","кроме (как)","Он","с ними","где","бы ни","были они","Затем","сообщит Он им","о том, что","они совершили","в День","Воскресения","Поистине","Аллах","о всякой","вещи","Знающий"]],[58,8,["أَلَمۡ","تَرَ","إِلَى","ٱلَّذِينَ","نُهُواْ","عَنِ","ٱلنَّجۡوَىٰ","ثُمَّ","يَعُودُونَ","لِمَا","نُهُواْ","عَنۡهُ","وَيَتَنَٰجَوۡنَ","بِٱلۡإِثۡمِ","وَٱلۡعُدۡوَٰنِ","وَمَعۡصِيَتِ","ٱلرَّسُولِۖ","وَإِذَا","جَآءُوكَ","حَيَّوۡكَ","بِمَا","لَمۡ","يُحَيِّكَ","بِهِ","ٱللَّهُ","وَيَقُولُونَ","فِيٓ","أَنفُسِهِمۡ","لَوۡلَا","يُعَذِّبُنَا","ٱللَّهُ","بِمَا","نَقُولُۚ","حَسۡبُهُمۡ","جَهَنَّمُ","يَصۡلَوۡنَهَاۖ","فَبِئۡسَ","ٱلۡمَصِيرُ"],"алам тара илал лазиина нухуу `анин нажва сумма йа`уудууна лима нухуу `анху вайатанажауна бил'исми вал`удвани вама`сийатир расуули ва'иза жауука хаййаука бима лам йухаййика бихиллаху вайаḳуулууна фии анфусихим лаула йу`аззибуналлаху бима наḳуулу хасбухум жаханнаму йаслаунаха фаби'сал масиир","Разве ты не видел тех, кому были запрещены тайные беседы. Они возвращаются к тому, что было им запрещено, и тайно переговариваются о грехах, посягательстве и неповиновении Посланнику. Когда они приходят к тебе, то приветствуют тебя не так, как приветствует тебя Аллах, говоря в душе: «Почему бы Аллаху не наказать нас за то, что мы говорим?». Довольно с них Геенны! Туда они попадут, и как же скверно это место прибытия!",["Разве не","видел ты","на","тех, которые","были удержаны","от","тайных бесед","затем","они возвращаются","к тому, от чего","они были удержаны","(от) него","и тайно переговариваются","о грехе","и посягательстве","и неповиновении","Посланнику","И когда","приходят к тебе","приветствуют тебя","тем, чем","не","приветствовал тебя","этим","Аллах","и говорят","в","душах своих","Почему не","наказывает нас","Аллах","за то, что","мы говорим","Довольно с них","Геенны","будут гореть в ней","и скверно же","это место прибытия"]],[58,9,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُوٓاْ","إِذَا","تَنَٰجَيۡتُمۡ","فَلَا","تَتَنَٰجَوۡاْ","بِٱلۡإِثۡمِ","وَٱلۡعُدۡوَٰنِ","وَمَعۡصِيَتِ","ٱلرَّسُولِ","وَتَنَٰجَوۡاْ","بِٱلۡبِرِّ","وَٱلتَّقۡوَىٰۖ","وَٱتَّقُواْ","ٱللَّهَ","ٱلَّذِيٓ","إِلَيۡهِ","تُحۡشَرُونَ"],"йа'аййухал лазиина амануу иза танажайтум фала татанажау бил'исми вал`удвани вама`сийатир расуули ватанажау билбирри ваттаḳва ваттаḳуллахал лазии илайхи тухшаруун","О те, которые уверовали! Если уж вы тайно переговариваетесь, то не говорите о грехах, посягательстве и неповиновении Посланнику, а говорите о благочестии и богобоязненности и бойтесь Аллаха, к Которому вы будете собраны.",["О","те, которые","уверовали","Когда","вы тайно беседуете","то не","беседуйте тайно","о грехе","и посягательстве","и неповиновении","Посланнику","а беседуйте тайно","о благочестии","и богобоязненности","И бойтесь","Аллаха","Который","к Нему","вы будете собраны"]],[58,10,["إِنَّمَا","ٱلنَّجۡوَىٰ","مِنَ","ٱلشَّيۡطَٰنِ","لِيَحۡزُنَ","ٱلَّذِينَ","ءَامَنُواْ","وَلَيۡسَ","بِضَآرِّهِمۡ","شَيۡـًٔا","إِلَّا","بِإِذۡنِ","ٱللَّهِۚ","وَعَلَى","ٱللَّهِ","فَلۡيَتَوَكَّلِ","ٱلۡمُؤۡمِنُونَ"],"иннаман нажва минаш шайтани лийахзунал лазиина амануу валайса бидаррихим шай'ан илла би'изниллахи ва`алаллахи фалйатаваккалил му'минуун","Тайная беседа - от дьявола, стремящегося опечалить тех, которые уверовали. Но это нисколько не повредит им, если на то не будет соизволения Аллаха. Пусть же верующие уповают только на Аллаха.",["Лишь","тайная беседа","от","шайтана","чтобы опечалить","тех, которые","уверовали","но не","вредит он им","ничуть","кроме как","с дозволения","Аллаха","И на","Аллаха","пусть уповают","верующие"]],[58,11,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُوٓاْ","إِذَا","قِيلَ","لَكُمۡ","تَفَسَّحُواْ","فِي","ٱلۡمَجَٰلِسِ","فَٱفۡسَحُواْ","يَفۡسَحِ","ٱللَّهُ","لَكُمۡۖ","وَإِذَا","قِيلَ","ٱنشُزُواْ","فَٱنشُزُواْ","يَرۡفَعِ","ٱللَّهُ","ٱلَّذِينَ","ءَامَنُواْ","مِنكُمۡ","وَٱلَّذِينَ","أُوتُواْ","ٱلۡعِلۡمَ","دَرَجَٰتٖۚ","وَٱللَّهُ","بِمَا","تَعۡمَلُونَ","خَبِيرٞ"],"йа'аййухал лазиина амануу иза ḳиила лакум тафассахуу фил мажалиси фафсахуу йафсахиллаху лакум ва'иза ḳииланшузуу фаншузуу йарфа`иллахул лазиина амануу минкум валлазиина уутул `илма даражатин валлаху бима та`малууна хабиир","О те, которые уверовали! Когда вас просят на собраниях сесть пошире, то садитесь пошире, и Аллах одарит вас местом просторным. Когда же вам велят подняться, то поднимайтесь. Аллах возвышает по степеням тех из вас, кто уверовал, и тех, кому даровано знание. Аллах ведает о том, что вы совершаете.",["О","те, которые","уверовали","Когда","сказано","вам","Потеснитесь","на","собраниях","то потеснитесь","даст простор","Аллах","вам","И когда","сказано","Поднимитесь","то поднимайтесь","возвысит","Аллах","тех, которые","уверовали","из вас","и тех, которым","даровано","знание","степенями","И Аллах","о том, что","вы делаете","Сведущ"]]],"m":[[["أَلَمۡ","Разве не",58,7],["تَرَ","видишь ты",58,7],["أَنَّ","что",58,7],["ٱللَّهَ","Аллах",58,7],["يَعۡلَمُ","знает",58,7],["مَا","то, что",58,7],["فِي","на",58,7],["ٱلسَّمَٰوَٰتِ","небесах",58,7],["وَمَا","и то, что",58,7],["فِي","на",58,7],["ٱلۡأَرۡضِۖ","земле",58,7],["مَا","Не",58,7],["يَكُونُ","бывает",58,7]],[["مِن","(никакой)",58,7],["نَّجۡوَىٰ","тайной беседы",58,7],["ثَلَٰثَةٍ","троих",58,7],["إِلَّا","кроме (как)",58,7],["هُوَ","Он",58,7],["رَابِعُهُمۡ","четвёртый их",58,7],["وَلَا","и не",58,7],["خَمۡسَةٍ","пятерых",58,7],["إِلَّا","кроме (как)",58,7],["هُوَ","Он",58,7],["سَادِسُهُمۡ","шестой их",58,7]],[["وَلَآ","и не",58,7],["أَدۡنَىٰ","меньше",58,7],["مِن","чем",58,7],["ذَٰلِكَ","это",58,7],["وَلَآ","и не",58,7],["أَكۡثَرَ","больше",58,7],["إِلَّا","кроме (как)",58,7],["هُوَ","Он",58,7],["مَعَهُمۡ","с ними",58,7],["أَيۡنَ","где",58,7],["مَا","бы ни",58,7],["كَانُواْۖ","были они",58,7],["ثُمَّ","Затем",58,7],["يُنَبِّئُهُم","сообщит Он им",58,7]],[["بِمَا","о том, что",58,7],["عَمِلُواْ","они совершили",58,7],["يَوۡمَ","в День",58,7],["ٱلۡقِيَٰمَةِۚ","Воскресения",58,7],["إِنَّ","Поистине",58,7],["ٱللَّهَ","Аллах",58,7],["بِكُلِّ","о всякой",58,7],["شَيۡءٍ","вещи",58,7],["عَلِيمٌ","Знающий",58,7],[7],["أَلَمۡ","Разве не",58,8],["تَرَ","видел ты",58,8],["إِلَى","на",58,8],["ٱلَّذِينَ","тех, которые",58,8]],[["نُهُواْ","были удержаны",58,8],["عَنِ","от",58,8],["ٱلنَّجۡوَىٰ","тайных бесед",58,8],["ثُمَّ","затем",58,8],["يَعُودُونَ","они возвращаются",58,8],["لِمَا","к тому, от чего",58,8],["نُهُواْ","они были удержаны",58,8],["عَنۡهُ","(от) него",58,8],["وَيَتَنَٰجَوۡنَ","и тайно переговариваются",58,8],["بِٱلۡإِثۡمِ","о грехе",58,8]],[["وَٱلۡعُدۡوَٰنِ","и посягательстве",58,8],["وَمَعۡصِيَتِ","и неповиновении",58,8],["ٱلرَّسُولِۖ","Посланнику",58,8],["وَإِذَا","И когда",58,8],["جَآءُوكَ","приходят к тебе",58,8],["حَيَّوۡكَ","приветствуют