{"p":544,"j":28,"a":[[58,12,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُوٓاْ","إِذَا","نَٰجَيۡتُمُ","ٱلرَّسُولَ","فَقَدِّمُواْ","بَيۡنَ","يَدَيۡ","نَجۡوَىٰكُمۡ","صَدَقَةٗۚ","ذَٰلِكَ","خَيۡرٞ","لَّكُمۡ","وَأَطۡهَرُۚ","فَإِن","لَّمۡ","تَجِدُواْ","فَإِنَّ","ٱللَّهَ","غَفُورٞ","رَّحِيمٌ"],"йа'аййухал лазиина амануу иза нажайтумур расуула фаḳаддимуу байна йадай нажвакум садаḳатан залика хайрул лакум ва'атхару фа'ил лам тажидуу фа'инналлаха гафуурур рахиим","О те, которые уверовали! Если вы беседуете с Посланником в тайне, то предварите вашу тайную беседу милостыней. Так будет лучше для вас и чище. Но если вы ничего не найдете, то ведь Аллах - Прощающий, Милосердный.",["О","те, которые","уверовали","Когда","вы тайно беседуете с","Посланником","то предваряйте","перед","(руками)","вашей тайной беседы","милостыней","Это","лучше","для вас","и чище","А если","не","найдёте","то поистине","Аллах","Прощающий","Милосердный"]],[58,13,["ءَأَشۡفَقۡتُمۡ","أَن","تُقَدِّمُواْ","بَيۡنَ","يَدَيۡ","نَجۡوَىٰكُمۡ","صَدَقَٰتٖۚ","فَإِذۡ","لَمۡ","تَفۡعَلُواْ","وَتَابَ","ٱللَّهُ","عَلَيۡكُمۡ","فَأَقِيمُواْ","ٱلصَّلَوٰةَ","وَءَاتُواْ","ٱلزَّكَوٰةَ","وَأَطِيعُواْ","ٱللَّهَ","وَرَسُولَهُۥۚ","وَٱللَّهُ","خَبِيرُۢ","بِمَا","تَعۡمَلُونَ"],"а'ашфаḳтум ан туḳаддимуу байна йадай нажвакум садаḳатин фа'из лам таф`алуу ватабаллаху `алайкум фа'аḳиимус салавата ва'атуз закавата ва'атии`уллаха варасуулахуу валлаху хабииру бима та`малуун","Неужели вы боялись предварять вашу тайную беседу милостыней? Если вы не сделали этого и Аллах принял ваше покаяние, то совершайте намаз, выплачивайте закят и повинуйтесь Аллаху и Его Посланнику. Аллах ведает о том, что вы совершаете.",["Неужели вы побоялись","что","предварите","перед","(руками)","вашей тайной беседы","милостынями","И раз","не","сделали вы","и простил","Аллах","вас","то совершайте","намаз","и давайте","закят","и повинуйтесь","Аллаху","и Его Посланнику","И Аллах","Сведущ","о том, что","вы делаете"]],[58,14,["أَلَمۡ","تَرَ","إِلَى","ٱلَّذِينَ","تَوَلَّوۡاْ","قَوۡمًا","غَضِبَ","ٱللَّهُ","عَلَيۡهِم","مَّا","هُم","مِّنكُمۡ","وَلَا","مِنۡهُمۡ","وَيَحۡلِفُونَ","عَلَى","ٱلۡكَذِبِ","وَهُمۡ","يَعۡلَمُونَ"],"алам тара илал лазиина таваллау ḳауман гадибаллаху `алайхим ма хум минкум вала минхум вайахлифууна `алал казиби вахум йа`ламуун","Разве ты не видел тех, которые дружат с людьми, на которых разгневался Аллах? Они не относятся ни к вам, ни к ним. Они дают заведомо ложные клятвы.",["Разве не","видел ты","на","тех, которые","взяли в союзники","людей","разгневался","Аллах","на них","Не","они","из вас","и не","из них","и клянутся","в","лжи","и они","знают"]],[58,15,["أَعَدَّ","ٱللَّهُ","لَهُمۡ","عَذَابٗا","شَدِيدًاۖ","إِنَّهُمۡ","سَآءَ","مَا","كَانُواْ","يَعۡمَلُونَ"],"а`аддаллаху лахум `азабан шадиидан иннахум саа ма кануу йа`малуун","Аллах приготовил для них тяжкие мучения. Воистину, скверно то, что они совершают!",["Приготовил","Аллах","для них","наказание","суровое","Поистине, они","скверно","то, что","они","делали"]],[58,16,["ٱتَّخَذُوٓاْ","أَيۡمَٰنَهُمۡ","جُنَّةٗ","فَصَدُّواْ","عَن","سَبِيلِ","ٱللَّهِ","فَلَهُمۡ","عَذَابٞ","مُّهِينٞ"],"иттахазуу айманахум жуннатан фасаддуу `ан сабиилиллахи фалахум `азабум мухиин","Они сделали свои клятвы щитом и сбили других с пути Аллаха. Им уготованы унизительные мучения.",["Они сделали","свои клятвы","щитом","и отвратили","от","пути","Аллаха","и им","наказание","унизительное"]],[58,17,["لَّن","تُغۡنِيَ","عَنۡهُمۡ","أَمۡوَٰلُهُمۡ","وَلَآ","أَوۡلَٰدُهُم","مِّنَ","ٱللَّهِ","شَيۡـًٔاۚ","أُوْلَٰٓئِكَ","أَصۡحَٰبُ","ٱلنَّارِۖ","هُمۡ","فِيهَا","خَٰلِدُونَ"],"ллан тугнийа `анхум амвалухум вала ауладухум миналлахи шай'ан улаика асхабун нари хум фииха халидуун","Ни имущество, ни дети ничем не помогут им пред Аллахом. Они являются обитателями Огня и пребудут там вечно.",["Никогда не","избавят","их","их имущество","и не","их дети","от","Аллаха","ничуть","Те","обитатели","Огня","они","в нём","вечно пребывающие"]],[58,18,["يَوۡمَ","يَبۡعَثُهُمُ","ٱللَّهُ","جَمِيعٗا","فَيَحۡلِفُونَ","لَهُۥ","كَمَا","يَحۡلِفُونَ","لَكُمۡ","وَيَحۡسَبُونَ","أَنَّهُمۡ","عَلَىٰ","شَيۡءٍۚ","أَلَآ","إِنَّهُمۡ","هُمُ","ٱلۡكَٰذِبُونَ"],"йаума йаб`асухумуллаху жамии`ан файахлифууна лахуу кама йахлифууна лакум вайахсабууна аннахум `ала шай'ин ала иннахум хумул казибуун","В тот день, когда Аллах воскресит их всех, они станут клясться перед Ним, подобно тому, как клянутся перед вами, полагая, что это поможет им. Воистину, они - лжецы.",["В день","воскресит их","Аллах","всех","и будут клясться","Ему","как","клянутся они","вам","и думают","что они","на","чём-то","Знайте же","поистине, они","(именно) они","лжецы"]],[58,19,["ٱسۡتَحۡوَذَ","عَلَيۡهِمُ","ٱلشَّيۡطَٰنُ","فَأَنسَىٰهُمۡ","ذِكۡرَ","ٱللَّهِۚ","أُوْلَٰٓئِكَ","حِزۡبُ","ٱلشَّيۡطَٰنِۚ","أَلَآ","إِنَّ","حِزۡبَ","ٱلشَّيۡطَٰنِ","هُمُ","ٱلۡخَٰسِرُونَ"],"истахваза `алайхимуш шайтану фа'ансахум зикраллахи улаика хизбуш шайтани ала инна хизбаш шайтани хумул хасируун","Дьявол одолел их и заставил их забыть о поминании Аллаха. Они являются партией дьявола. Воистину, партия дьявола - это потерпевшие убыток.",["Овладел","ими","шайтан","и заставил их забыть","поминание","Аллаха","Те","партия","шайтана","Знайте же","поистине","партия","шайтана","они","потерпевшие убыток"]],[58,20,["إِنَّ","ٱلَّذِينَ","يُحَآدُّونَ","ٱللَّهَ","وَرَسُولَهُۥٓ","أُوْلَٰٓئِكَ","فِي","ٱلۡأَذَلِّينَ"],"иннал лазиина йухаддууналлаха варасуулахуу улаика фил азаллиин","Те, которые враждуют с Аллахом и Его Посланником, окажутся в числе самых униженных.",["Поистине","те, которые","противятся","Аллаху","и Его Посланнику","те","среди","самых униженных"]],[58,21,["كَتَبَ","ٱللَّهُ","لَأَغۡلِبَنَّ","أَنَا۠","وَرُسُلِيٓۚ","إِنَّ","ٱللَّهَ","قَوِيٌّ","عَزِيزٞ"],"катабаллаху ла'аглибанна ана варусулии инналлаха ḳавиййун `азииз","Аллах предписал: «Победу непременно одержим Я и Мои посланники!». Воистину, Аллах - Всесильный, Могущественный.",["Предписал","Аллах","Непременно одержу победу","Я","и Мои посланники","Поистине","Аллах","Сильный","Могущественный"]]],"m":[[["يَٰٓأَيُّهَا","О",58,12],["ٱلَّذِي