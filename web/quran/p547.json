{"p":547,"j":28,"a":[[59,10,["وَٱلَّذِينَ","جَآءُو","مِنۢ","بَعۡدِهِمۡ","يَقُولُونَ","رَبَّنَا","ٱغۡفِرۡ","لَنَا","وَلِإِخۡوَٰنِنَا","ٱلَّذِينَ","سَبَقُونَا","بِٱلۡإِيمَٰنِ","وَلَا","تَجۡعَلۡ","فِي","قُلُوبِنَا","غِلّٗا","لِّلَّذِينَ","ءَامَنُواْ","رَبَّنَآ","إِنَّكَ","رَءُوفٞ","رَّحِيمٌ"],"валлазиина жауу мим ба`дихим йаḳуулууна раббанагфир лана валиихванинал лазиина сабаḳууна бил'иимани вала таж`ал фии ḳулуубина гиллал лиллазиина амануу раббана иннака ра'ууфур рахиим","А те, которые пришли после них, говорят: «Господь наш! Прости нас и наших братьев, которые уверовали раньше нас! Не насаждай в наших сердцах ненависти и зависти к тем, кто уверовал. Господь наш! Воистину, Ты - Сострадательный, Милосердный».",["И те, которые","пришли","после","них","говорят","Господь наш","прости","нам","и нашим братьям","которые","опередили нас","в вере","и не","помещай","в","наших сердцах","злобы","к тем, которые","уверовали","Господь наш","поистине, Ты","Сострадательный","Милосердный"]],[59,11,["أَلَمۡ","تَرَ","إِلَى","ٱلَّذِينَ","نَافَقُواْ","يَقُولُونَ","لِإِخۡوَٰنِهِمُ","ٱلَّذِينَ","كَفَرُواْ","مِنۡ","أَهۡلِ","ٱلۡكِتَٰبِ","لَئِنۡ","أُخۡرِجۡتُمۡ","لَنَخۡرُجَنَّ","مَعَكُمۡ","وَلَا","نُطِيعُ","فِيكُمۡ","أَحَدًا","أَبَدٗا","وَإِن","قُوتِلۡتُمۡ","لَنَنصُرَنَّكُمۡ","وَٱللَّهُ","يَشۡهَدُ","إِنَّهُمۡ","لَكَٰذِبُونَ"],"алам тара илал лазиина нафаḳуу йаḳуулууна ли'ихванихимул лазиина кафаруу мин ахлил китаби ла'ин ухрижтум ланахружанна ма`акум вала нутии`у фиикум ахадан абадан ва'ин ḳуутилтум ланансураннакум валлаху йашхаду иннахум лаказибуун","Разве ты не видишь, что лицемеры говорят своим неверующим братьям из числа людей Писания: «Если вас изгонят, то мы уйдем вместе с вами и никогда никому не подчинимся против вас. А если с вами сразятся, то мы обязательно поможем вам». Аллах свидетельствует о том, что они являются лжецами.",["Разве не","видел ты","на","тех, которые","лицемерили","говорят","своим братьям","тем, которые","не уверовали","из","людей","Писания","Если","будете изгнаны вы","непременно выйдем мы","с вами","и не","подчинимся мы","против вас","никому","никогда","и если","сразятся с вами","непременно поможем вам","И Аллах","свидетельствует","поистине, они","непременно лжецы"]],[59,12,["لَئِنۡ","أُخۡرِجُواْ","لَا","يَخۡرُجُونَ","مَعَهُمۡ","وَلَئِن","قُوتِلُواْ","لَا","يَنصُرُونَهُمۡ","وَلَئِن","نَّصَرُوهُمۡ","لَيُوَلُّنَّ","ٱلۡأَدۡبَٰرَ","ثُمَّ","لَا","يُنصَرُونَ"],"ла'ин ухрижуу ла йахружууна ма`ахум валаин ḳуутилуу ла йансуруунахум валаин насаруухум лайуаллуннал адбара сумма ла йунсаруун","Если они будут изгнаны, то те не уйдут вместе с ними. Если с ними сразятся, то они не помогут им. А если даже они помогут им, то повернут вспять, после чего уже никто не поможет им.",["Если","будут изгнаны они","не","выйдут они","с ними","и если","сразятся с ними","не","помогут они им","и если","помогут они им","непременно обратят они","спины","затем","не","получат они помощи"]],[59,13,["لَأَنتُمۡ","أَشَدُّ","رَهۡبَةٗ","فِي","صُدُورِهِم","مِّنَ","ٱللَّهِۚ","ذَٰلِكَ","بِأَنَّهُمۡ","قَوۡمٞ","لَّا","يَفۡقَهُونَ"],"ла'антум ашадду рахбатан фии судуурихим миналлахи залика би'аннахум ḳаумул ла йафḳахуун","Воистину, они страшатся вас в сердцах сильнее, чем Аллаха, поскольку они являются людьми непонимающими.",["Непременно вы","сильнее","страхом","в","их груди","чем","Аллах","Это","потому что они","люди","не","понимают"]],[59,14,["لَا","يُقَٰتِلُونَكُمۡ","جَمِيعًا","إِلَّا","فِي","قُرٗى","مُّحَصَّنَةٍ","أَوۡ","مِن","وَرَآءِ","جُدُرِۭۚ","بَأۡسُهُم","بَيۡنَهُمۡ","شَدِيدٞۚ","تَحۡسَبُهُمۡ","جَمِيعٗا","وَقُلُوبُهُمۡ","شَتَّىٰۚ","ذَٰلِكَ","بِأَنَّهُمۡ","قَوۡمٞ","لَّا","يَعۡقِلُونَ"],"ла йуḳатилуунакум жамии`ан илла фии ḳурам мухассанатин ау мин вараи жудури ба'сухум байнахум шадиидун тахсабухум жамии`ан ваḳулуубухум шатта залика би'аннахум ḳаумул ла йа`ḳилуун","Они не станут сражаться с вами вместе, разве что в укрепленных селениях или из-за стен. Меж собой у них жестокая вражда. Ты полагаешь, что они едины, но сердца их разобщены. Это потому, что они - люди неразумные.",["Не","сразятся они с вами","все вместе","кроме как","в","селениях","укреплённых","или","из","за","стен","Их ярость","между ними","сильна","Ты считаешь их","едиными","а сердца их","разрознены","Это","потому что они","люди","не","разумеют"]],[59,15,["كَمَثَلِ","ٱلَّذِينَ","مِن","قَبۡلِهِمۡ","قَرِيبٗاۖ","ذَاقُواْ","وَبَالَ","أَمۡرِهِمۡ","وَلَهُمۡ","عَذَابٌ","أَلِيمٞ"],"камасалил лазиина мин ḳаблихим ḳариибан заḳуу вабала амрихим валахум `азабун алиим","Они подобны своим недавним предшественникам, которые вкусили пагубность своих деяний и которым уготованы мучительные страдания.",["Подобно примеру","тех, которые","из","прежде них","недавно","вкусили","пагубность","их дела","и для них","наказание","мучительное"]],[59,16,["كَمَثَلِ","ٱلشَّيۡطَٰنِ","إِذۡ","قَالَ","لِلۡإِنسَٰنِ","ٱكۡفُرۡ","فَلَمَّا","كَفَرَ","قَالَ","إِنِّي","بَرِيٓءٞ","مِّنكَ","إِنِّيٓ","أَخَافُ","ٱللَّهَ","رَبَّ","ٱلۡعَٰلَمِينَ"],"камасалиш шайтани из ḳала лил'инсаникфур фаламма кафара ḳала иннии барииум минка иннии ахафуллаха раббал `аламиин","Они подобны дьяволу, который говорит человеку: «Не веруй!». Когда же тот становится неверующим, он говорит: «Я не причастен к тебе! Я боюсь Аллаха, Господа миров».",["Подобно примеру","шайтана","когда","сказал он","человеку","Отвергни веру","А когда","отверг веру он","сказал он","Поистине, я","непричастен","к тебе","Поистине, я","боюсь","Аллаха","Господа","миров"]]],"m":[[["وَٱلَّذِينَ","И те, которые",59,10],["جَآءُو","пришли",59,10],["مِنۢ","после",59,10],["بَعۡدِهِمۡ","них",59,10],["يَقُولُونَ","говорят",59,10],["رَبَّنَا","Господь наш",59,10],["ٱغۡفِرۡ","прости",59,10],["لَنَا","нам",59,10]],[["وَلِإِخۡوَٰنِنَا","и нашим братьям",59,10],["ٱلَّذِينَ","которые",59,10],["سَبَقُونَا","опередили нас",59,10],["بِٱلۡإِيمَٰنِ","в вере",59,10],["وَلَا","и не",59,10],["تَجۡعَلۡ","помещай",59,10],["فِي","в",59,10],["قُلُوبِنَا","наших сердцах",59,10]],[["غِلّٗا","злобы",59,10],["لِّلَّذِينَ","к тем, которые",59,10],["ءَامَنُواْ","уверовали",59,10],["رَبَّنَآ","Господь наш",59,10],["إِنَّكَ","поистине, Ты",59,10],["رَءُوفٞ","Сострадательный",59,10],["رَّحِيمٌ","Милосердный",59,10],[10],["۞ أَلَمۡ","Разве не",59,11],["تَرَ","видел ты",59,11],["إِلَى","на",59,11]],[["ٱلَّذِينَ","тех, которые",59,11],["نَافَقُواْ","лицемерили",59,11],["يَقُولُونَ","говорят",59,11],["لِإِخۡوَٰنِهِمُ","своим братьям",59,11],["ٱلَّذِينَ","тем, которые",59,11],["كَفَرُواْ","не уверовали",59,11],["مِنۡ","из",59,11],["أَهۡلِ","людей",59,11]],[["ٱلۡكِتَٰبِ","Писания",59,11],["لَئِنۡ","Если",59,11],["أُخۡرِجۡتُمۡ","будете изгнаны вы",59,11],["لَنَخۡرُجَنَّ","непременно выйдем мы",59,11],["مَعَكُمۡ","с вами",59,11],["وَلَا","и не",59,11],["نُطِيعُ","подчинимся мы",59,11],["فِيكُمۡ","против вас",59,11]],[["أَحَدًا","никому",59,11],["أَبَدٗا","никогда",59,11],["وَإِن","и если",59,11],["قُوتِلۡتُمۡ","сразятся с вами",59,11],["لَنَنصُرَنَّكُمۡ","непременно поможем вам",59,11],["وَٱللَّهُ","И Аллах",59,11],["يَشۡهَدُ","свидетельствует",59,11],["إِنَّهُمۡ","поистине, они",59,11],["لَكَٰذِبُونَ","непременно лжецы",59,11]],[[11],["لَئِنۡ","Если",59,12],["أُخۡرِجُواْ","будут изгнаны они",59,12],["لَا","не",59,12],["يَخۡرُجُونَ","выйдут они",59,12],["مَعَهُمۡ","с ними",59,12],["وَلَئِن","и если",59,12],["قُوتِلُواْ","сразятся с ними",59,12],["لَا","не",59,12],["يَنصُرُونَهُمۡ","помогут они им",59,12]],[["وَلَئِن","и если",59,12],["نَّصَرُوهُمۡ","помогут они им",59,12],["لَيُوَلُّنَّ","непременно обратят они",59,12],["ٱلۡأَدۡبَٰرَ","спины",59,12],["ثُمَّ","затем",59,12],["لَا","не",59,12],["يُنصَرُونَ","получат они помощи",59,12],[12]],[["لَأَنتُمۡ","Непременно вы",59,13],["أَشَدُّ","сильнее",59,13],["رَهۡبَةٗ","страхом",59,13],["فِي","в",59,13],["صُدُورِهِم","их груди",59,13],["مِّنَ","чем",59,13],["ٱللَّهِۚ","Аллах",59,13],["ذَٰلِكَ","Это",59,13],["بِأَنَّهُمۡ","потому что они",59,13],["قَوۡمٞ","люди",59,13]],[["لَّا","не",59,13],["يَفۡقَهُونَ","понимают",59,13],[13],["لَا","Не",59,14],["يُقَٰتِلُونَكُمۡ","сразятся они с вами",59,14],["جَمِيعًا","все вместе",59,14],["إِلَّا","кроме как",59,14],["فِي","в",59,14],["قُرٗى","селениях",59,14]],[["مُّحَصَّنَةٍ","укреплённых",59,14],["أَوۡ","или",59,14],["مِن","из",59,14],["وَرَآءِ","за",59,14],["جُدُرِۭۚ","стен",59,14],["بَأۡسُهُم","Их ярость",59,14],["بَيۡنَهُمۡ","между ними",59,14],["شَدِيدٞۚ","сильна",59,14],["تَحۡسَبُهُمۡ","Ты считаешь их",59,14]],[["جَمِيعٗا","едиными",59,14],["وَقُلُوبُهُمۡ","а сердца их",59,14],["شَتَّىٰۚ","разрознены",59,14],["ذَٰلِكَ","Это",59,14],["بِأَنَّهُمۡ","потому что они",59,14],["قَوۡمٞ","люди",59,14],["لَّا","не",59,14],["يَعۡقِلُونَ","разумеют",59,14],[14]],[["كَمَثَلِ","Подобно примеру",59,15],["ٱلَّذِينَ","тех, которые",59,15],["مِن","из",59,15],["قَبۡلِهِمۡ","прежде них",59,15],["قَرِيبٗاۖ","недавно",59,15],["ذَاقُواْ","вкусили",59,15],["وَبَالَ","пагубность",59,15],["أَمۡرِهِمۡ","их дела",59,15],["وَلَهُمۡ","и для них",59,15],["عَذَابٌ","наказание",59,15]],[["أَلِيمٞ","мучительное",59,15],[15],["كَمَثَلِ","Подобно примеру",59,16],["ٱلشَّيۡطَٰنِ","шайтана",59,16],["إِذۡ","когда",59,16],["قَالَ","сказал он",59,16],["لِلۡإِنسَٰنِ","человеку",59,16],["ٱكۡفُرۡ","Отвергни веру",59,16],["فَلَمَّا","А когда",59,16],["كَفَرَ","отверг веру он",59,16]],[["قَالَ","сказал он",59,16],["إِنِّي","Поистине, я",59,16],["بَرِيٓءٞ","непричастен",59,16],["مِّنكَ","к тебе",59,16],["إِنِّيٓ","Поистине, я",59,16],["أَخَافُ","боюсь",59,16],["ٱللَّهَ","Аллаха",59,16],["رَبَّ","Господа",59,16],["ٱلۡعَٰلَمِينَ","миров",59,16],[16]]]}