{"p":548,"j":28,"a":[[59,17,["فَكَانَ","عَٰقِبَتَهُمَآ","أَنَّهُمَا","فِي","ٱلنَّارِ","خَٰلِدَيۡنِ","فِيهَاۚ","وَذَٰلِكَ","جَزَٰٓؤُاْ","ٱلظَّٰلِمِينَ"],"факана `аḳибатахума аннахума фин нари халидайни фииха вазалика жазауз залимиин","Концом тех и других станет попадание в Огонь, в котором они пребудут вечно. Таково воздаяние беззаконникам!",["И стал","исход их обоих","что они оба","в","Огне","вечно пребывающие","в нём","И это","воздаяние","беззаконников"]],[59,18,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُواْ","ٱتَّقُواْ","ٱللَّهَ","وَلۡتَنظُرۡ","نَفۡسٞ","مَّا","قَدَّمَتۡ","لِغَدٖۖ","وَٱتَّقُواْ","ٱللَّهَۚ","إِنَّ","ٱللَّهَ","خَبِيرُۢ","بِمَا","تَعۡمَلُونَ"],"йа'аййухал лазиина амануттаḳуллаха валтанзур нафсум ма ḳаддамат лигадин ваттаḳуллаха инналлаха хабииру бима та`малуун","О те, которые уверовали! Бойтесь Аллаха, и пусть душа посмотрит, что она приготовила на завтрашний день. Бойтесь Аллаха, ведь Аллах ведает о том, что вы совершаете.",["О","те, которые","уверовали","Бойтесь","Аллаха","и пусть посмотрит","душа","что","уготовила она","на завтра","и бойтесь","Аллаха","Поистине","Аллах","Ведающий","о том, что","вы делаете"]],[59,19,["وَلَا","تَكُونُواْ","كَٱلَّذِينَ","نَسُواْ","ٱللَّهَ","فَأَنسَىٰهُمۡ","أَنفُسَهُمۡۚ","أُوْلَٰٓئِكَ","هُمُ","ٱلۡفَٰسِقُونَ"],"вала такуунуу каллазиина насуллаха фа'ансахум анфусахум улаика хумул фасиḳуун","Не будьте подобны тем, которые забыли Аллаха, и Он заставил забыть самих себя. Они являются нечестивцами.",["И не","будьте","как те, которые","забыли","Аллаха","и Он заставил их забыть","самих себя","Те","они","нечестивцы"]],[59,20,["لَا","يَسۡتَوِيٓ","أَصۡحَٰبُ","ٱلنَّارِ","وَأَصۡحَٰبُ","ٱلۡجَنَّةِۚ","أَصۡحَٰبُ","ٱلۡجَنَّةِ","هُمُ","ٱلۡفَآئِزُونَ"],"ла йаставии асхабун нари ва'асхабул жаннати асхабул жаннати хумул фаизуун","Обитатели Огня не равны обитателям Рая. Обитатели Рая являются преуспевшими.",["Не","равны","обитатели","Огня","и обитатели","Рая","Обитатели","Рая","они","преуспевшие"]],[59,21,["لَوۡ","أَنزَلۡنَا","هَٰذَا","ٱلۡقُرۡءَانَ","عَلَىٰ","جَبَلٖ","لَّرَأَيۡتَهُۥ","خَٰشِعٗا","مُّتَصَدِّعٗا","مِّنۡ","خَشۡيَةِ","ٱللَّهِۚ","وَتِلۡكَ","ٱلۡأَمۡثَٰلُ","نَضۡرِبُهَا","لِلنَّاسِ","لَعَلَّهُمۡ","يَتَفَكَّرُونَ"],"лау анзална хазал ḳур'ана `ала жабалил лараайтахуу хаши`ам мутасадди`ам мин хашйатиллахи ватилкал амсалу надрибуха линнаси ла`аллахум йатафаккаруун","Если бы Мы ниспослали этот Коран горе, то ты увидел бы, как она смиренно раскалывается от страха перед Аллахом. Такие притчи Мы приводим людям для того, чтобы они поразмыслили.",["Если бы","ниспослали Мы","этот","Коран","на","гору","непременно увидел бы ты её","смиренной","раскалывающейся","от","страха","Аллаха","И эти","притчи","приводим Мы их","людям","чтобы они","размышляли"]],[59,22,["هُوَ","ٱللَّهُ","ٱلَّذِي","لَآ","إِلَٰهَ","إِلَّا","هُوَۖ","عَٰلِمُ","ٱلۡغَيۡبِ","وَٱلشَّهَٰدَةِۖ","هُوَ","ٱلرَّحۡمَٰنُ","ٱلرَّحِيمُ"],"хуаллахул лазии ла илаха илла хуа `алимул гайби вашшахадати хуар рахманур рахиим","Он - Аллах, и нет божества, кроме Него, Ведающего сокровенное и явное. Он - Милостивый, Милосердный.",["Он","Аллах","Тот, Который","нет","божества","кроме","Него","Знающий","сокровенное","и явное","Он","Милостивый","Милосердный"]],[59,23,["هُوَ","ٱللَّهُ","ٱلَّذِي","لَآ","إِلَٰهَ","إِلَّا","هُوَ","ٱلۡمَلِكُ","ٱلۡقُدُّوسُ","ٱلسَّلَٰمُ","ٱلۡمُؤۡمِنُ","ٱلۡمُهَيۡمِنُ","ٱلۡعَزِيزُ","ٱلۡجَبَّارُ","ٱلۡمُتَكَبِّرُۚ","سُبۡحَٰنَ","ٱللَّهِ","عَمَّا","يُشۡرِكُونَ"],"хуаллахул лазии ла илаха илла хуал маликул ḳуддуусус саламул му'минул мухайминул `азиизул жаббарул мутакаббиру субханаллахи `амма йушрикуун","Он - Аллах, и нет божества, кроме Него, Властелина, Святого, Пречистого, Оберегающего, Хранителя, Могущественного, Могучего, Гордого. Пречист Аллах и далек от того, что они приобщают в сотоварищи.",["Он","Аллах","Тот, Который","нет","божества","кроме","Него","Властелин","Святой","Мир (Пречистый)","Оберегающий","Хранитель","Могущественный","Могучий","Превознесённый","Пречист","Аллах","от того, что","они приобщают"]],[59,24,["هُوَ","ٱللَّهُ","ٱلۡخَٰلِقُ","ٱلۡبَارِئُ","ٱلۡمُصَوِّرُۖ","لَهُ","ٱلۡأَسۡمَآءُ","ٱلۡحُسۡنَىٰۚ","يُسَبِّحُ","لَهُۥ","مَا","فِي","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِۖ","وَهُوَ","ٱلۡعَزِيزُ","ٱلۡحَكِيمُ"],"хуаллахул халиḳул бариул мусаввиру лахул асмаул хусна йусаббиху лахуу ма фис самавати вал'арди вахуал `азиизул хакиим","Он - Аллах, Творец, Создатель, Дарующий облик. У Него - самые прекрасные имена. Славит Его то, что на небесах и на земле. Он - Могущественный, Мудрый.",["Он","Аллах","Творец","Создатель","Дающий облик","У Него","имена","прекраснейшие","славит","Его","то, что","в","небесах","и земле","И Он","Могущественный","Мудрый"]]],"m":[[["فَكَانَ","И стал",59,17],["عَٰقِبَتَهُمَآ","исход их обоих",59,17],["أَنَّهُمَا","что они оба",59,17],["فِي","в",59,17],["ٱلنَّارِ","Огне",59,17],["خَٰلِدَيۡنِ","вечно пребывающие",59,17],["فِيهَاۚ","в нём",59,17],["وَذَٰلِكَ","И это",59,17],["جَزَٰٓؤُاْ","воздаяние",59,17]],[["ٱلظَّٰلِمِينَ","беззаконников",59,17],[17],["يَٰٓأَيُّهَا","О",59,18],["ٱلَّذِينَ","те, которые",59,18],["ءَامَنُواْ","уверовали",59,18],["ٱتَّقُواْ","Бойтесь",59,18],["ٱللَّهَ","Аллаха",59,18],["وَلۡتَنظُرۡ","и пусть посмотрит",59,18]],[["نَفۡسٞ","душа",59,18],["مَّا","что",59,18],["قَدَّمَتۡ","уготовила она",59,18],["لِغَدٖۖ","на завтра",59,18],["وَٱتَّقُواْ","и бойтесь",59,18],["ٱللَّهَۚ","Аллаха",59,18],["إِنَّ","Поистине",59,18],["ٱللَّهَ","Аллах",59,18],["خَبِيرُۢ","Ведающий",59,18],["بِمَا","о том, что",59,18],["تَعۡمَلُونَ","вы делаете",59,18]],[[18],["وَلَا","И не",59,19],["تَكُونُواْ","будьте",59,19],["كَٱلَّذِينَ","как те, которые",59,19],["نَسُواْ","забыли",59,19],["ٱللَّهَ","Аллаха",59,19],["فَأَنسَىٰهُمۡ","и Он заставил их забыть",59,19],["أَنفُسَهُمۡۚ","самих себя",59,19],["أُوْلَٰٓئِكَ","Те",59,19]],[["هُمُ","они",59,19],["ٱلۡفَٰسِقُونَ","нечестивцы",59,19],[19],["لَا","Не",59,20],["يَسۡتَوِيٓ","равны",59,20],["أَصۡحَٰبُ","обитатели",59,20],["ٱلنَّارِ","Огня",59,20],["وَأَصۡحَٰبُ","и обитатели",59,20]],[["ٱلۡجَنَّةِۚ","Рая",59,20],["أَصۡحَٰبُ","Обитатели",59,20],["ٱلۡجَ