{"p":550,"j":28,"a":[[60,6,["لَقَدۡ","كَانَ","لَكُمۡ","فِيهِمۡ","أُسۡوَةٌ","حَسَنَةٞ","لِّمَن","كَانَ","يَرۡجُواْ","ٱللَّهَ","وَٱلۡيَوۡمَ","ٱلۡأٓخِرَۚ","وَمَن","يَتَوَلَّ","فَإِنَّ","ٱللَّهَ","هُوَ","ٱلۡغَنِيُّ","ٱلۡحَمِيدُ"],"лаḳад кана лакум фиихим усватун хасанатул лиман кана йаржуллаха валйаумал ахира ваман йатавалла фа'инналлаха хуал ганиййул хамиид","Они были прекрасным примером для вас - для тех, кто надеется на Аллаха и на Последний день. А если кто-либо отвернется, то ведь Аллах - Богатый, Достохвальный.",["Непременно уже","был","для вас","в них","пример","прекрасный","для того, кто","был","надеется на","Аллаха","и День","Последний","И кто","отвернётся","то поистине","Аллах","Он","Богатый","Достохвальный"]],[60,7,["عَسَى","ٱللَّهُ","أَن","يَجۡعَلَ","بَيۡنَكُمۡ","وَبَيۡنَ","ٱلَّذِينَ","عَادَيۡتُم","مِّنۡهُم","مَّوَدَّةٗۚ","وَٱللَّهُ","قَدِيرٞۚ","وَٱللَّهُ","غَفُورٞ","رَّحِيمٞ"],"`асаллаху ан йаж`ала байнакум вабайнал лазиина `адайтум минхум маваддатан валлаху ḳадиирун валлаху гафуурур рахиим","Может быть, Аллах установит дружбу между вами и теми, с кем вы враждуете. Аллах - Всемогущий. Аллах - Прощающий, Милосердный.",["Быть может","Аллах","что","установит","между вами","и между","теми, которым","вы враждовали","из них","любовь","И Аллах","Всемогущ","И Аллах","Прощающий","Милосердный"]],[60,8,["لَّا","يَنۡهَىٰكُمُ","ٱللَّهُ","عَنِ","ٱلَّذِينَ","لَمۡ","يُقَٰتِلُوكُمۡ","فِي","ٱلدِّينِ","وَلَمۡ","يُخۡرِجُوكُم","مِّن","دِيَٰرِكُمۡ","أَن","تَبَرُّوهُمۡ","وَتُقۡسِطُوٓاْ","إِلَيۡهِمۡۚ","إِنَّ","ٱللَّهَ","يُحِبُّ","ٱلۡمُقۡسِطِينَ"],"лла йанхакумуллаху `анил лазиина лам йуḳатилуукум фид диини валам йухрижуукум мин дийарикум ан табарруухум ватуḳситуу илайхим инналлаха йухиббул муḳситиин","Аллах не запрещает вам быть добрыми и справедливыми с теми, которые не сражались с вами из-за религии и не изгоняли вас из ваших жилищ. Воистину, Аллах любит беспристрастных.",["Не","запрещает вам","Аллах","в отношении","тех, которые","не","сражались с вами","из-за","религии","и не","изгоняли вас","из","ваших жилищ","чтобы","вы были добры к ним","и были справедливы","к ним","Поистине","Аллах","любит","справедливых"]],[60,9,["إِنَّمَا","يَنۡهَىٰكُمُ","ٱللَّهُ","عَنِ","ٱلَّذِينَ","قَٰتَلُوكُمۡ","فِي","ٱلدِّينِ","وَأَخۡرَجُوكُم","مِّن","دِيَٰرِكُمۡ","وَظَٰهَرُواْ","عَلَىٰٓ","إِخۡرَاجِكُمۡ","أَن","تَوَلَّوۡهُمۡۚ","وَمَن","يَتَوَلَّهُمۡ","فَأُوْلَٰٓئِكَ","هُمُ","ٱلظَّٰلِمُونَ"],"иннама йанхакумуллаху `анил лазиина ḳаталуукум фид диини ва'ахражуукум мин дийарикум вазахаруу `ала ихражикум ан таваллаухум ваман йатаваллахум фа'улаика хумуз залимуун","Аллах запрещает вам дружить только с теми, которые сражались с вами из-за религии, выгоняли вас из ваших жилищ и способствовали вашему изгнанию. А те, которые берут их себе в помощники и друзья, являются беззаконниками.",["Лишь","запрещает вам","Аллах","в отношении","тех, которые","сражались с вами","из-за","религии","и изгнали вас","из","ваших жилищ","и помогали","в","вашем изгнании","чтобы","вы дружили с ними","И кто","дружит с ними","то те","они","беззаконники"]],[60,10,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُوٓاْ","إِذَا","جَآءَكُمُ","ٱلۡمُؤۡمِنَٰتُ","مُهَٰجِرَٰتٖ","فَٱمۡتَحِنُوهُنَّۖ","ٱللَّهُ","أَعۡلَمُ","بِإِيمَٰنِهِنَّۖ","فَإِنۡ","عَلِمۡتُمُوهُنَّ","مُؤۡمِنَٰتٖ","فَلَا","تَرۡجِعُوهُنَّ","إِلَى","ٱلۡكُفَّارِۖ","لَا","هُنَّ","حِلّٞ","لَّهُمۡ","وَلَا","هُمۡ","يَحِلُّونَ","لَهُنَّۖ","وَءَاتُوهُم","مَّآ","أَنفَقُواْۚ","وَلَا","جُنَاحَ","عَلَيۡكُمۡ","أَن","تَنكِحُوهُنَّ","إِذَآ","ءَاتَيۡتُمُوهُنَّ","أُجُورَهُنَّۚ","وَلَا","تُمۡسِكُواْ","بِعِصَمِ","ٱلۡكَوَافِرِ","وَسۡـَٔلُواْ","مَآ","أَنفَقۡتُمۡ","وَلۡيَسۡـَٔلُواْ","مَآ","أَنفَقُواْۚ","ذَٰلِكُمۡ","حُكۡمُ","ٱللَّهِ","يَحۡكُمُ","بَيۡنَكُمۡۖ","وَٱللَّهُ","عَلِيمٌ","حَكِيمٞ"],"йа'аййухал лазиина амануу иза жаакумул му'минату мухажиратин фамтахинуухунналлаху а`ламу би'ииманихинна фа'ин `алимтумуухунна му'минатин фала таржи`уухунна илал куффари ла хунна хиллул лахум вала хум йахиллууна лахунна ва'атуухум ма анфаḳуу вала жунаха `алайкум ан танкихуухунна иза атайтумуухунна ужуурахунна вала тумсикуу би`исамил кавафири вас'алуу ма анфаḳтум валйас'алуу ма анфаḳуу заликум хукмуллахи йахкуму байнакум валлаху `алиимун хакиим","О те, которые уверовали! Когда к вам прибывают переселившиеся верующие женщины, то подвергайте их испытанию. Аллаху лучше знать об их вере. Если вы узнаете, что они являются верующими, то не возвращайте их неверующим, ибо им не дозволено жениться на них, а им не дозволено выходить замуж за них. Возвращайте им (неверующим) то, что они потратили на брачный дар. На вас не будет греха, если вы женитесь на них после уплаты их вознаграждения (брачного дара). Не держитесь за узы с неверующими женами и требуйте назад то, что вы потратили на брачный дар. И пусть они (неверующие) требуют то, что они потратили на брачный дар. Таково решение Аллаха. Он решает между вами. Аллах - Знающий, Мудрый.",["О","те, которые","уверовали","Когда","придут к вам","верующие женщины","переселившимися","то испытайте их","Аллах","лучше знает","об их вере","И если","узнали вы их","верующими","то не","возвращайте их","к","неверным","Не","они","дозволены","им","и не","они","дозволены","им","И дайте им","то, что","потратили они","И нет","греха","на вас","чтобы","вы женились на них","когда","дали вы им","их вознаграждение","И не","держитесь","за узы","неверных жён","и просите","то, что","потратили вы","и пусть просят они","то, что","потратили они","Это","решение","Аллаха","Он решает","между вами","И Аллах","Знающий","Мудрый"]],[60,11,["وَإِن","فَاتَكُمۡ","شَيۡءٞ","مِّنۡ","أَزۡوَٰجِكُمۡ","إِلَى","ٱلۡكُفَّارِ","فَعَاقَبۡتُمۡ","فَـَٔاتُواْ","ٱلَّذِينَ","ذَهَبَتۡ","أَزۡوَٰجُهُم","مِّثۡلَ","مَآ","أَنفَقُواْۚ","وَٱتَّقُواْ","ٱللَّهَ","ٱلَّذِيٓ","أَنتُم","بِهِۦ","مُؤۡمِنُونَ"],"ва'ин фатакум шай'ум мин азважикум илал куффари фа`аḳабтум фа'атул лазиина захабат азважухум мисла ма анфаḳуу ваттаḳуллахал лазии антум бихии му'минуун","Если какая-либо из ваших жен ушла от вас к неверующим, после чего вы получили военную добычу, то отдайте тем, жены которых ушли, потраченное ими на брачный дар. Бойтесь Аллаха, в Которого вы веруете.",["И если","ушла от вас","какая-либо","из","ваших жён","к","неверным","а затем добыли вы","то дайте","тем, у которых","ушли","жёны их","подобное","тому, что","потратили они","И бойтесь","Аллаха","Которого","вы","в Него","верующие"]]],"m":[[["لَقَدۡ","Непременно уже",60,6],["كَانَ","был",60,6],["لَكُمۡ","для вас",60,6],["فِيهِمۡ","в них",60,6],["أُسۡوَةٌ","пример",60,6],["حَسَنَةٞ","прекрасный",60,6],["لِّمَن","для того, кто",60,6],["كَانَ","был",60,6],["يَرۡجُواْ","надеется на",60,6],["ٱللَّهَ","Аллаха",60,6],["وَٱلۡيَوۡمَ","и День",60,6],["ٱلۡأٓخِرَۚ","Последний",60,6]],[["وَمَن","И кто",60,6],["يَتَوَلَّ","отвернётся",60,6],["فَإِنَّ","то поистине",60,6],["ٱللَّهَ","Аллах",60,6],["هُوَ","Он",60,6],["ٱلۡغَنِيُّ","Богатый",60,6],["ٱلۡحَمِيدُ","Достохвальный",60,6],[6],["۞ عَسَى","Быть может",60,7],["ٱللَّهُ","Аллах",60,7],["أَن","что",60,7],["يَجۡعَلَ","установит",60,7]],[["بَيۡنَكُمۡ","между вами",60,7],["وَبَيۡنَ","и между",60,7],["ٱلَّذِينَ","теми, которым",60,7],["عَادَيۡتُم","вы враждовали",60,7],["مِّنۡهُم","из них",60,7],["مَّوَدَّةٗۚ","любовь",60,7],["وَٱللَّهُ","И Аллах",60,7],["قَدِيرٞۚ","Всемогущ",60,7],["وَٱللَّهُ","И Аллах",60,7],["غَفُورٞ","Прощающий",60,7],["رَّحِيمٞ","Милосердный",60,7]],[[7],["لَّا","Не",60,8],["يَنۡهَىٰكُمُ","запрещает вам",60,8],["ٱللَّهُ","Аллах",60,8],["عَنِ","в отношении",60,8],["ٱلَّذِينَ","тех, которые",60,8],["لَمۡ","не",60,8],["يُقَٰتِلُوكُمۡ","сражались с вами",60,8],["فِي","из-за",60,8],["ٱلدِّينِ","религии",60,8],["وَلَمۡ","и не",60,8],["يُخۡرِجُوكُم","изгоняли вас",60,8]],[["مِّن","из",60,8],["دِيَٰرِكُمۡ","ваших жилищ",60,8],["أَن","чтобы",60,8],["تَبَرُّوهُمۡ","вы были добры к ним",60,8],["وَتُقۡسِطُوٓاْ","и были справедливы",60,8],["إِلَيۡهِمۡۚ","к ним",60,8],["إِنَّ","Поистине",60,8],["ٱللَّهَ","Аллах",60,8],["يُحِبُّ","любит",60,8],["ٱلۡمُقۡسِطِينَ","справедливых",60,8]],[[8],["إِنَّمَا","Лишь",60,9],["يَنۡهَىٰكُمُ","запрещает вам",60,9