{"p":551,"j":28,"a":[[60,12,["يَٰٓأَيُّهَا","ٱلنَّبِيُّ","إِذَا","جَآءَكَ","ٱلۡمُؤۡمِنَٰتُ","يُبَايِعۡنَكَ","عَلَىٰٓ","أَن","لَّا","يُشۡرِكۡنَ","بِٱللَّهِ","شَيۡـٔٗا","وَلَا","يَسۡرِقۡنَ","وَلَا","يَزۡنِينَ","وَلَا","يَقۡتُلۡنَ","أَوۡلَٰدَهُنَّ","وَلَا","يَأۡتِينَ","بِبُهۡتَٰنٖ","يَفۡتَرِينَهُۥ","بَيۡنَ","أَيۡدِيهِنَّ","وَأَرۡجُلِهِنَّ","وَلَا","يَعۡصِينَكَ","فِي","مَعۡرُوفٖ","فَبَايِعۡهُنَّ","وَٱسۡتَغۡفِرۡ","لَهُنَّ","ٱللَّهَۚ","إِنَّ","ٱللَّهَ","غَفُورٞ","رَّحِيمٞ"],"йа'аййухан набиййу иза жаакал му'минату йубайи`нака `ала ал ла йушрикна биллахи шай'ан вала йасриḳна вала йазниина вала йаḳтулна ауладахунна вала йа'тиина бибухтанин йафтариинахуу байна айдиихинна ва'аржулихинна вала йа`сиинака фии ма`рууфин фабайи`хунна вастагфир лахунналлаха инналлаха гафуурур рахиим","О Пророк! Если к тебе придут верующие женщины, чтобы присягнуть в том, что они не будут приобщать сотоварищей к Аллаху, красть, прелюбодействовать, убивать своих детей, покрывать клеветой то, что между их руками и ногами, и ослушаться тебя в благих делах, то прими у них присягу и попроси у Аллаха прощения для них. Воистину, Аллах - Прощающий, Милосердный.",["О","Пророк","Когда","придут к тебе","верующие женщины","присягая тебе","на том","что","не","будут приобщать","к Аллаху","что-либо","и не","будут красть","и не","будут прелюбодействовать","и не","будут убивать","своих детей","и не","будут приходить","с клеветой","измышляя её","между","их руками","и их ногами","и не","будут ослушиваться тебя","в","благом","то прими их присягу","и попроси прощения","для них","у Аллаха","Поистине","Аллах","Прощающий","Милосердный"]],[60,13,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُواْ","لَا","تَتَوَلَّوۡاْ","قَوۡمًا","غَضِبَ","ٱللَّهُ","عَلَيۡهِمۡ","قَدۡ","يَئِسُواْ","مِنَ","ٱلۡأٓخِرَةِ","كَمَا","يَئِسَ","ٱلۡكُفَّارُ","مِنۡ","أَصۡحَٰبِ","ٱلۡقُبُورِ"],"йа'аййухал лазиина амануу ла татаваллау ḳауман гадибаллаху `алайхим ḳад йа'исуу минал ахирати кама йа'исал куффару мин асхабил ḳубуур","О те, которые уверовали! Не дружите с теми, на кого разгневался Аллах. Они потеряли надежду на Последнюю жизнь, как потеряли ее неверующие обитатели могил (или как неверующие потеряли надежду на воскрешение обитателей могил).",["О","те, которые","уверовали","не","дружите","с народом","разгневался","Аллах","на них","уже","отчаялись они","в","Последней жизни","как","отчаялись","неверные","из","обитателей","могил"]],[61,1,["سَبَّحَ","لِلَّهِ","مَا","فِي","ٱلسَّمَٰوَٰتِ","وَمَا","فِي","ٱلۡأَرۡضِۖ","وَهُوَ","ٱلۡعَزِيزُ","ٱلۡحَكِيمُ"],"саббаха лиллахи ма фис самавати вама фил арди вахуал `азиизул хакиим","Славит Аллаха то, что на небесах, и то, что на земле. Он - Могущественный, Мудрый.",["Славит","Аллаха","то, что","в","небесах","и то, что","в","земле","И Он","Могущественный","Мудрый"]],[61,2,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُواْ","لِمَ","تَقُولُونَ","مَا","لَا","تَفۡعَلُونَ"],"йа'аййухал лазиина амануу лима таḳуулууна ма ла таф`алуун","О те, которые уверовали! Почему вы говорите то, чего не делаете?",["О","те, которые","уверовали","почему","говорите вы","то, что","не","делаете вы"]],[61,3,["كَبُرَ","مَقۡتًا","عِندَ","ٱللَّهِ","أَن","تَقُولُواْ","مَا","لَا","تَفۡعَلُونَ"],"кабура маḳтан `индаллахи ан таḳуулуу ма ла таф`алуун","Велика ненависть Аллаха к тому, что вы говорите то, чего не делаете.",["Велико","ненавистью","у","Аллаха","что","говорите вы","то, что","не","делаете вы"]],[61,4,["إِنَّ","ٱللَّهَ","يُحِبُّ","ٱلَّذِينَ","يُقَٰتِلُونَ","فِي","سَبِيلِهِۦ","صَفّٗا","كَأَنَّهُم","بُنۡيَٰنٞ","مَّرۡصُوصٞ"],"инналлаха йухиббул лазиина йуḳатилууна фии сабиилихии саффан ка'аннахум бунйанум марсуус","Воистину, Аллах любит тех, которые сражаются на Его пути рядами, словно они - прочное строение.",["поистине","Аллах","любит","тех, которые","сражаются","на","пути Его","рядами","словно они","строение","скреплённое"]],[61,5,["وَإِذۡ","قَالَ","مُوسَىٰ","لِقَوۡمِهِۦ","يَٰقَوۡمِ","لِمَ","تُؤۡذُونَنِي","وَقَد","تَّعۡلَمُونَ","أَنِّي","رَسُولُ","ٱللَّهِ","إِلَيۡكُمۡۖ","فَلَمَّا","زَاغُوٓاْ","أَزَاغَ","ٱللَّهُ","قُلُوبَهُمۡۚ","وَٱللَّهُ","لَا","يَهۡدِي","ٱلۡقَوۡمَ","ٱلۡفَٰسِقِينَ"],"ва'из ḳала мууса лиḳаумихии йаḳауми лима ту'зуунании ваḳад тта`ламууна аннии расуулуллахи илайкум фаламма загуу азагаллаху ḳулуубахум валлаху ла йахдил ḳаумал фасиḳиин","Вот сказал Муса (Моисей) своему народу: «О мой народ! Почему вы причиняете мне страдания, зная, что я послан к вам Аллахом?». Когда же они уклонились, Аллах совратил их сердца. Аллах не ведет прямым путем людей нечестивых.",["и вот","сказал","Муса","своему народу","о мой народ","почему","вы обижаете меня","и ведь уже","вы знаете","что я","посланник","Аллаха","к вам","когда же","они уклонились","уклонил","Аллах","их сердца","и Аллах","не","ведёт прямо","людей","нечестивых"]]],"m":[[["يَٰٓأَيُّهَا","О",60,12],["ٱلنَّبِيُّ","Пророк",60,12],["إِذَا","Когда",60,12],["جَآءَكَ","придут к тебе",60,12],["ٱلۡمُؤۡمِنَٰتُ","верующие женщины",60,12],["يُبَايِعۡنَكَ","присягая тебе",60,12],["عَلَىٰٓ","на том",60,12],["أَن","что",60,12],["لَّا","не",60,12],["يُشۡرِكۡنَ","будут приобщать",60,12]],[["بِٱللَّهِ","к Аллаху",60,12],["شَيۡـٔٗا","что-либо",60,12],["وَلَا","и не",60,12],["يَسۡرِقۡنَ","будут красть",60,12],["وَلَا","и не",60,12],["يَزۡنِينَ","будут прелюбодействовать",60,12],["وَلَا","и не",60,12],["يَقۡتُلۡنَ","будут убивать",60,12],["أَوۡلَٰدَهُنَّ","своих детей",60,12],["وَلَا","и не",60,12],["يَأۡتِينَ","будут приходить",60,12]],[["بِبُهۡتَٰنٖ","с клеветой",60,12],["يَفۡتَرِينَهُۥ","измышляя её",60,12],["بَيۡنَ","между",60,12],["أَيۡدِيهِنَّ","их руками",60,12],["وَأَرۡجُلِهِنَّ","и их ногами",60,12],["وَلَا","и не",60,12],["يَعۡصِينَكَ","будут ослушиваться тебя",60,12]],[["فِي","в",60,12],["مَعۡرُوفٖ","благом",60,12],["فَبَايِعۡهُنَّ","то прими их присягу",60,12],["وَٱسۡتَغۡفِرۡ","и попроси прощения",60,12],["لَهُنَّ","для них",60,12],["ٱللَّهَۚ","у Аллаха",60,12],["إِنَّ","Поистине",60,12],["ٱللَّهَ","Аллах",60,12],["غَفُورٞ","Прощающий",60,12],["رَّحِيمٞ","Милосердный",60,12]],[[12],["يَٰٓأَيُّهَا","О",60,13],["ٱلَّذِينَ","те, которые"