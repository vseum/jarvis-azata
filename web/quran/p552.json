{"p":552,"j":28,"a":[[61,6,["وَإِذۡ","قَالَ","عِيسَى","ٱبۡنُ","مَرۡيَمَ","يَٰبَنِيٓ","إِسۡرَٰٓءِيلَ","إِنِّي","رَسُولُ","ٱللَّهِ","إِلَيۡكُم","مُّصَدِّقٗا","لِّمَا","بَيۡنَ","يَدَيَّ","مِنَ","ٱلتَّوۡرَىٰةِ","وَمُبَشِّرَۢا","بِرَسُولٖ","يَأۡتِي","مِنۢ","بَعۡدِي","ٱسۡمُهُۥٓ","أَحۡمَدُۖ","فَلَمَّا","جَآءَهُم","بِٱلۡبَيِّنَٰتِ","قَالُواْ","هَٰذَا","سِحۡرٞ","مُّبِينٞ"],"ва'из ḳала `иисабну марйама йабании исраиила иннии расуулуллахи илайкум мусаддиḳал лима байна йадаййа минат таурати вамубашшира бирасуулин йа'тии мим ба`дисмухуу ахмаду фаламма жаахум билбаййинати ḳалуу хаза сихрум мубиин","А вот Иса (Иисус), сын Марьям (Марии), сказал: «О сыны Исраила (Израиля)! Я послан к вам Аллахом, чтобы подтвердить правдивость того, что было в Таурате (Торе) до меня, и чтобы сообщить благую весть о Посланнике, который придет после меня, имя которого будет Ахмад (Мухаммад)». Когда же он явился к ним с ясными знамениями, они сказали: «Это - очевидное колдовство».",["и вот","сказал","Иса","сын","Марьям","о сыны","Исраила","поистине, я","посланник","Аллаха","к вам","подтверждающий","то, что","между","руками моими","из","Таурата","и благовествующий","о посланнике","придёт","от","после меня","имя его","Ахмад","когда же","он пришёл к ним","с ясными знамениями","они сказали","это","колдовство","явное"]],[61,7,["وَمَنۡ","أَظۡلَمُ","مِمَّنِ","ٱفۡتَرَىٰ","عَلَى","ٱللَّهِ","ٱلۡكَذِبَ","وَهُوَ","يُدۡعَىٰٓ","إِلَى","ٱلۡإِسۡلَٰمِۚ","وَٱللَّهُ","لَا","يَهۡدِي","ٱلۡقَوۡمَ","ٱلظَّٰلِمِينَ"],"ваман азламу мимманифтара `алаллахил казиба вахуа йуд`а илал ислами валлаху ла йахдил ḳаумаз залимиин","Кто же может быть несправедливее того, кто измышляет ложь об Аллахе, когда его призывают к исламу? Аллах не ведет прямым путем несправедливых людей.",["и кто","несправедливее","того, кто","измыслил","на","Аллаха","ложь","в то время как он","призывается","к","исламу","и Аллах","не","ведёт прямо","людей","несправедливых"]],[61,8,["يُرِيدُونَ","لِيُطۡفِـُٔواْ","نُورَ","ٱللَّهِ","بِأَفۡوَٰهِهِمۡ","وَٱللَّهُ","مُتِمُّ","نُورِهِۦ","وَلَوۡ","كَرِهَ","ٱلۡكَٰفِرُونَ"],"йуриидууна лийутфиуу нуураллахи би'афвахихим валлаху мутимму нуурихии валау карихал кафируун","Они хотят погасить свет Аллаха своими ртами, но Аллах сохранит Свой свет, даже если это ненавистно неверующим.",["они хотят","чтобы погасить","свет","Аллаха","ртами своими","но Аллах","довершит","Свой свет","даже если","возненавидели (это)","неверующие"]],[61,9,["هُوَ","ٱلَّذِيٓ","أَرۡسَلَ","رَسُولَهُۥ","بِٱلۡهُدَىٰ","وَدِينِ","ٱلۡحَقِّ","لِيُظۡهِرَهُۥ","عَلَى","ٱلدِّينِ","كُلِّهِۦ","وَلَوۡ","كَرِهَ","ٱلۡمُشۡرِكُونَ"],"хуал лазии арсала расуулахуу билхуда вадиинил хаḳḳи лийузхирахуу `алад диини куллихии валау карихал мушрикуун","Он - Тот, Кто отправил Своего Посланника с верным руководством и религией истины, чтобы превознести ее над всеми остальными религиями, даже если это ненавистно многобожникам.",["Он","Тот, Который","отправил","Своего Посланника","с руководством","и религией","истины","чтобы возвысить её","над","религией","всей","даже если","возненавидели (это)","многобожники"]],[61,10,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُواْ","هَلۡ","أَدُلُّكُمۡ","عَلَىٰ","تِجَٰرَةٖ","تُنجِيكُم","مِّنۡ","عَذَابٍ","أَلِيمٖ"],"йа'аййухал лазиина амануу хал адуллукум `ала тижаратин тунжиикум мин `азабин алиим","О те, которые уверовали! Указать ли вам на торговлю, которая спасет вас от мучительных страданий?",["о","те, которые","уверовали","ли","укажу я вам","на","торговлю","которая спасёт вас","от","наказания","мучительного"]],[61,11,["تُؤۡمِنُونَ","بِٱللَّهِ","وَرَسُولِهِۦ","وَتُجَٰهِدُونَ","فِي","سَبِيلِ","ٱللَّهِ","بِأَمۡوَٰلِكُمۡ","وَأَنفُسِكُمۡۚ","ذَٰلِكُمۡ","خَيۡرٞ","لَّكُمۡ","إِن","كُنتُمۡ","تَعۡلَمُونَ"],"ту'минууна биллахи варасуулихии ватужахидууна фии сабиилиллахи би'амваликум ва'анфусикум заликум хайрул лакум ин кунтум та`ламуун","Веруйте в Аллаха и Его Посланника и сражайтесь на пути Аллаха своим имуществом и своими душами. Так будет лучше для вас, если бы вы только знали.",["веруйте","в Аллаха","и Его Посланника","и усердствуйте","на","пути","Аллаха","имуществом вашим","и душами вашими","это","лучше","для вас","если","вы","знаете"]],[61,12,["يَغۡفِرۡ","لَكُمۡ","ذُنُوبَكُمۡ","وَيُدۡخِلۡكُمۡ","جَنَّٰتٖ","تَجۡرِي","مِن","تَحۡتِهَا","ٱلۡأَنۡهَٰرُ","وَمَسَٰكِنَ","طَيِّبَةٗ","فِي","جَنَّٰتِ","عَدۡنٖۚ","ذَٰلِكَ","ٱلۡفَوۡزُ","ٱلۡعَظِيمُ"],"йагфир лакум зунуубакум вайудхилкум жаннатин тажрии мин тахтихал анхару вамасакина таййибатан фии жаннати `аднин заликал фаузул `азиим","Он простит вам ваши грехи, введет вас в Райские сады, в которых текут реки, и в прекрасные жилища в садах Эдема. Это - великое преуспеяние.",["Он простит","вам","грехи ваши","и введёт вас","в сады","текут","из","под ними","реки","и в жилища","прекрасные","в","садах","вечности","это","успех","великий"]],[61,13,["وَأُخۡرَىٰ","تُحِبُّونَهَاۖ","نَصۡرٞ","مِّنَ","ٱللَّهِ","وَفَتۡحٞ","قَرِيبٞۗ","وَبَشِّرِ","ٱلۡمُؤۡمِنِينَ"],"ва'ухра тухиббуунаха насрум миналлахи вафатхун ḳариибун вабашширил му'миниин","Будет еще то, что вы любите: помощь от Аллаха и близкая победа. Сообщи же благую весть верующим!",["и другое","которое вы любите","помощь","от","Аллаха","и победа","близкая","и обрадуй","верующих"]],[61,14,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُواْ","كُونُوٓاْ","أَنصَارَ","ٱللَّهِ","كَمَا","قَالَ","عِيسَى","ٱبۡنُ","مَرۡيَمَ","لِلۡحَوَارِيِّـۧنَ","مَنۡ","أَنصَارِيٓ","إِلَى","ٱللَّهِۖ","قَالَ","ٱلۡحَوَارِيُّونَ","نَحۡنُ","أَنصَارُ","ٱللَّهِۖ","فَـَٔامَنَت","طَّآئِفَةٞ","مِّنۢ","بَنِيٓ","إِسۡرَٰٓءِيلَ","وَكَفَرَت","طَّآئِفَةٞۖ","فَأَيَّدۡنَا","ٱلَّذِينَ","ءَامَنُواْ","عَلَىٰ","عَدُوِّهِمۡ","فَأَصۡبَحُواْ","ظَٰهِرِينَ"],"йа'аййухал лазиина амануу куунуу ансараллахи кама ḳала `иисабну марйама лилхавариййиина ман ансарии илаллахи ḳалал хавариййууна нахну ансаруллахи фа'аманат таифатум мим бании исраиила вакафарат таифатун фа'аййаднал лазиина амануу `ала `адуввихим фа'асбахуу захириин","О те, которые уверовали! Будьте помощниками Аллаха. Иса (Иисус), сын Марьям (Марии), сказал апостолам: «Кто будет моим помощником на пути к Аллаху?». Апостолы ответили: «Мы - помощники Аллаха». Часть сынов Исраила (Израиля) уверовала, а другая часть не уверовала. Мы поддержали тех, которые уверовали, в борьбе с их врагами, и они вышли победителями.",["о","те, которые","уверовали","будьте","помощниками","Аллаха","как","сказал","Иса","сын","Марьям","апостолам","кто","помощники мои","к","Аллаху","сказали","апостолы","мы","помощники","Аллаха","и уверовала","часть","из","сынов","Исраила","и не уверовала","часть","и Мы поддержали","тех, которые","уверовали","против","их врага","и они стали","одолевшими"]]],"m":[[["وَإِذۡ","и вот",61,6],["قَالَ","сказал",61,6],["عِيسَى","Иса",61,6],["ٱبۡنُ","сын",61,6],["مَرۡيَمَ","Марьям",61,6],["يَٰبَنِيٓ","о сыны",61,6],["إِسۡرَٰٓءِيلَ","Исраила",61,6],["إِنِّي","поистине, я",61,6],["رَسُولُ","посланник",61,6],["ٱللَّهِ","Аллаха",61,6],["إِلَيۡكُم","к вам",61,6],["مُّصَدِّقٗا","подтверждающий",61,6]],[["لِّمَا","то, что",61,6],["بَيۡنَ","между",61,6],["يَدَيَّ","руками моими",61,6],["مِنَ","из",61,6],["ٱلتَّوۡرَىٰةِ","Таурата",61,6],["وَمُبَشِّرَۢا","и благовествующий",61,6],["بِرَسُولٖ","о посланнике",61,6],["يَأۡتِي","придёт",61,6],["مِنۢ","от",61,6],["بَعۡدِي","после меня",61,6],["ٱسۡمُهُۥٓ","имя его",61,6],["أَحۡمَدُۖ","Ахмад",61,6],["فَلَمَّا","когда же",61,6]],[["جَآءَهُم","он пришёл к ним",61,6],["بِٱلۡبَيِّنَٰتِ","с ясными знамениями",61,6],["قَالُواْ","они сказали",61,6],["هَٰذَا","это",61,6],["سِحۡرٞ","колдовство",61,6],["مُّبِينٞ","явное",61,6],[6],["وَمَنۡ","и кто",61,7],["أَظۡلَمُ","несправедливее",61,7],["مِمَّنِ","того, кто",61,7],["ٱفۡتَرَىٰ","измыслил",61,7]],[["عَلَى","на",61,7],["ٱللَّهِ","Аллаха",61,7],["ٱلۡكَذِبَ","ложь",61,7],["وَهُوَ","в то время как он",61,7],["يُدۡعَىٰٓ","призывается",61,7],["إِلَى","к",61,7],["ٱلۡإِسۡلَٰمِۚ","исламу",61,7],["وَٱللَّهُ","и Аллах",61,7],["لَا","не",61,7],["يَهۡدِي","ведёт прямо",61,7],["ٱلۡقَوۡمَ","людей",61,7],["ٱلظَّٰلِمِينَ","несправедливых",61,7]],[[7],["يُرِيدُونَ","они хотят",61,8],["لِيُطۡفِـُٔواْ","чтобы погасить",61,8],