َظِيمُ","великий",61,12],[12],["وَأُخۡرَىٰ","и другое",61,13],["تُحِبُّونَهَاۖ","которое вы любите",61,13],["نَصۡرٞ","помощь",61,13]],[["مِّنَ","от",61,13],["ٱللَّهِ","Аллаха",61,13],["وَفَتۡحٞ","и победа",61,13],["قَرِيبٞۗ","близкая",61,13],["وَبَشِّرِ","и обрадуй",61,13],["ٱلۡمُؤۡمِنِينَ","верующих",61,13],[13],["يَٰٓأَيُّهَا","о",61,14],["ٱلَّذِينَ","те, которые",61,14],["ءَامَنُواْ","уверовали",61,14],["كُونُوٓاْ","будьте",61,14]],[["أَنصَارَ","помощниками",61,14],["ٱللَّهِ","Аллаха",61,14],["كَمَا","как",61,14],["قَالَ","сказал",61,14],["عِيسَى","Иса",61,14],["ٱبۡنُ","сын",61,14],["مَرۡيَمَ","Марьям",61,14],["لِلۡحَوَارِيِّـۧنَ","апостолам",61,14],["مَنۡ","кто",61,14],["أَنصَارِيٓ","помощники мои",61,14],["إِلَى","к",61,14],["ٱللَّهِۖ","Аллаху",61,14]],[["قَالَ","сказали",61,14],["ٱلۡحَوَارِيُّونَ","апостолы",61,14],["نَحۡنُ","мы",61,14],["أَنصَارُ","помощники",61,14],["ٱللَّهِۖ","Аллаха",61,14],["فَـَٔامَنَت","и уверовала",61,14],["طَّآئِفَةٞ","часть",61,14],["مِّنۢ","из",61,14],["بَنِيٓ","сынов",61,14],["إِسۡرَٰٓءِيلَ","Исраила",61,14]],[["وَكَفَرَت","и не уверовала",61,14],["طَّآئِفَةٞۖ","часть",61,14],["فَأَيَّدۡنَا","и Мы поддержали",61,14],["ٱلَّذِينَ","тех, которые",61,14],["ءَامَنُواْ","уверовали",61,14],["عَلَىٰ","против",61,14],["عَدُوِّهِمۡ","их врага",61,14],["فَأَصۡبَحُواْ","и они стали",61,14],["ظَٰهِرِينَ","одолевшими",61,14],[14]]]}