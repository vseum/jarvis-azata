{"p":553,"j":28,"a":[[62,1,["يُسَبِّحُ","لِلَّهِ","مَا","فِي","ٱلسَّمَٰوَٰتِ","وَمَا","فِي","ٱلۡأَرۡضِ","ٱلۡمَلِكِ","ٱلۡقُدُّوسِ","ٱلۡعَزِيزِ","ٱلۡحَكِيمِ"],"йусаббиху лиллахи ма фис самавати вама фил ардил маликил ḳуддуусил `азиизил хакиим","То, что на небесах, и то, что на земле, славит Аллаха - Властелина, Святого, Могущественного, Мудрого.",["славит","Аллаха","то, что","на","небесах","и то, что","на","земле","Царя","Святого","Могущественного","Мудрого"]],[62,2,["هُوَ","ٱلَّذِي","بَعَثَ","فِي","ٱلۡأُمِّيِّـۧنَ","رَسُولٗا","مِّنۡهُمۡ","يَتۡلُواْ","عَلَيۡهِمۡ","ءَايَٰتِهِۦ","وَيُزَكِّيهِمۡ","وَيُعَلِّمُهُمُ","ٱلۡكِتَٰبَ","وَٱلۡحِكۡمَةَ","وَإِن","كَانُواْ","مِن","قَبۡلُ","لَفِي","ضَلَٰلٖ","مُّبِينٖ"],"хуал лазии ба`аса фил уммиййиина расуулам минхум йатлуу `алайхим айатихии вайузаккиихим вайу`аллимухумул китаба валхикмата ва'ин кануу мин ḳаблу лафии далалим мубиин","Он - Тот, Кто отправил к неграмотным людям Посланника из их среды. Он читает им Его аяты, очищает их и обучает их Писанию и мудрости, хотя прежде они пребывали в очевидном заблуждении.",["Он","Тот, Который","направил","среди","неграмотных","посланника","из них самих","он читает","им","Его аяты","и очищает их","и обучает их","Писанию","и мудрости","и хотя","они были","до","этого","непременно в","заблуждении","явном"]],[62,3,["وَءَاخَرِينَ","مِنۡهُمۡ","لَمَّا","يَلۡحَقُواْ","بِهِمۡۚ","وَهُوَ","ٱلۡعَزِيزُ","ٱلۡحَكِيمُ"],"ва'ахариина минхум ламма йалхаḳуу бихим вахуал `азиизул хакиим","А также к тем, которые не застали их. Он - Могущественный, Мудрый.",["и к другим","из них","ещё не","присоединились","к ним","и Он","Могущественный","Мудрый"]],[62,4,["ذَٰلِكَ","فَضۡلُ","ٱللَّهِ","يُؤۡتِيهِ","مَن","يَشَآءُۚ","وَٱللَّهُ","ذُو","ٱلۡفَضۡلِ","ٱلۡعَظِيمِ"],"залика фадлуллахи йу'тиихи ман йашау валлаху зул фадлил `азиим","Такова милость Аллаха. Он дарует ее, кому пожелает. Аллах обладает великой милостью.",["это","милость","Аллаха","Он даёт её","кому","пожелает","и Аллах","обладатель","милости","великой"]],[62,5,["مَثَلُ","ٱلَّذِينَ","حُمِّلُواْ","ٱلتَّوۡرَىٰةَ","ثُمَّ","لَمۡ","يَحۡمِلُوهَا","كَمَثَلِ","ٱلۡحِمَارِ","يَحۡمِلُ","أَسۡفَارَۢاۚ","بِئۡسَ","مَثَلُ","ٱلۡقَوۡمِ","ٱلَّذِينَ","كَذَّبُواْ","بِـَٔايَٰتِ","ٱللَّهِۚ","وَٱللَّهُ","لَا","يَهۡدِي","ٱلۡقَوۡمَ","ٱلظَّٰلِمِينَ"],"масалул лазиина хуммилут таурата сумма лам йахмилууха камасалил химари йахмилу асфара би'са масалул ḳаумил лазиина каззабуу би'айатиллахи валлаху ла йахдил ḳаумаз залимиин","Те, кому было поручено придерживаться Таурата (Торы) и которые не придерживались его, подобны ослу, который везет на себе много книг. Как же скверно сравнение с людьми, которые считают ложью знамения Аллаха! Аллах не ведет прямым путем несправедливых людей.",["пример","тех, которые","были нагружены","Тауратом","затем","не","понесли его","как пример","осла","несёт","книги","скверен","пример","людей","которые","сочли ложью","знамения","Аллаха","и Аллах","не","ведёт прямо","людей","несправедливых"]],[62,6,["قُلۡ","يَٰٓأَيُّهَا","ٱلَّذِينَ","هَادُوٓاْ","إِن","زَعَمۡتُمۡ","أَنَّكُمۡ","أَوۡلِيَآءُ","لِلَّهِ","مِن","دُونِ","ٱلنَّاسِ","فَتَمَنَّوُاْ","ٱلۡمَوۡتَ","إِن","كُنتُمۡ","صَٰدِقِينَ"],"ḳул йа'аййухал лазиина хадуу ин за`амтум аннакум аулийау лиллахи мин дуунин наси фатаманнавул маута ин кунтум садиḳиин","Скажи: «О исповедующие иудаизм! Если вы полагаете, что только вы среди людей являетесь угодниками Аллаха, то пожелайте себе смерти, если вы говорите правду».",["скажи","о","те, которые","стали иудеями","если","вы утверждаете","что вы","приближённые","Аллаха","от","помимо","людей","то пожелайте","смерти","если","вы","правдивы"]],[62,7,["وَلَا","يَتَمَنَّوۡنَهُۥٓ","أَبَدَۢا","بِمَا","قَدَّمَتۡ","أَيۡدِيهِمۡۚ","وَٱللَّهُ","عَلِيمُۢ","بِٱلظَّٰلِمِينَ"],"вала йатаманнаунахуу абада бима ḳаддамат айдиихим валлаху `алииму биззалимиин","Но они никогда не пожелают этого из-за того, что приготовили их руки. Аллаху известно о беззаконниках.",["и не","пожелают её","никогда","из-за того, что","уготовили","руки их","и Аллах","знающий","о несправедливых"]],[62,8,["قُلۡ","إِنَّ","ٱلۡمَوۡتَ","ٱلَّذِي","تَفِرُّونَ","مِنۡهُ","فَإِنَّهُۥ","مُلَٰقِيكُمۡۖ","ثُمَّ","تُرَدُّونَ","إِلَىٰ","عَٰلِمِ","ٱلۡغَيۡبِ","وَٱلشَّهَٰدَةِ","فَيُنَبِّئُكُم","بِمَا","كُنتُمۡ","تَعۡمَلُونَ"],"ḳул иннал маутал лазии тафиррууна минху фа'иннахуу мулаḳиикум сумма тураддууна ила `алимил гайби вашшахадати файунаббиукум бима кунтум та`малуун","Скажи: «Смерть, от которой вы убегаете, настигнет вас, после чего вы вернетесь к Ведающему сокровенное и явное, и Он сообщит вам о том, что вы совершали».",["скажи","поистине","смерть","которая","вы бежите","от неё","то поистине она","встретит вас","затем","вы будете возвращены","к","Знающему","сокровенное","и явное","и Он сообщит вам","о том, что","вы","делали"]]],"m":[["h",62],["b"],[["يُسَبِّحُ","славит",62,1],["لِلَّهِ","Аллаха",62,1],["مَا","то, что",62,1],["فِي","на",62,1],["ٱلسَّمَٰوَٰتِ","небесах",62,1],["وَمَا","и то, что",62,1],["فِي","на",62,1],["ٱلۡأَرۡضِ","земле",62,1],["ٱلۡمَلِكِ","Царя",62,1],["ٱلۡقُدُّوسِ","Святого",62,1],["ٱلۡعَزِيزِ","Могущественного",62,1]],[["ٱلۡحَكِيمِ","Мудрого",62,1],[1],["هُوَ","Он",62,2],["ٱلَّذِي","Тот, Который",62,2],["بَعَثَ","направил",62,2],["فِي","среди",62,2],["ٱلۡأُمِّيِّـۧنَ","неграмотных",62,2],["رَسُولٗا","посланника",62,2],["مِّنۡهُمۡ","из них самих",62,2],["يَتۡلُواْ","он читает",62,2]],[["عَلَيۡهِمۡ","им",62,2],["ءَايَٰتِهِۦ","Его аяты",62,2],["وَيُزَكِّيهِمۡ","и очищает их",62,2],["وَيُعَلِّمُهُمُ","и обучает их",62,2],["ٱلۡكِتَٰبَ","Писанию",62,2],["وَٱلۡحِكۡمَةَ","и мудрости",62,2],["وَإِن","и хотя",62,2],["كَانُواْ","они были",62,2]],[["مِن","до",62,2],["قَبۡلُ","этого",62,2],["لَفِي","непременно в",62,2],["ضَلَٰلٖ","заблуждении",62,2],["مُّبِينٖ","явном",62,2],[2],["وَءَاخَرِينَ","и к другим",62,3],["مِنۡهُمۡ","из них",62,3],["لَمَّا","ещё не",62,3],["يَلۡحَقُواْ","присоединились",62,3],["بِهِمۡۚ","к ним",62,3]],[["وَهُوَ","и Он",62,3],["ٱلۡعَزِيزُ","Могущественный",62,3],["ٱلۡحَكِيمُ","Мудрый",62,3],[3],["ذَٰلِكَ","это",62,4],["فَضۡلُ","милос