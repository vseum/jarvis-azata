{"p":554,"j":28,"a":[[62,9,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُوٓاْ","إِذَا","نُودِيَ","لِلصَّلَوٰةِ","مِن","يَوۡمِ","ٱلۡجُمُعَةِ","فَٱسۡعَوۡاْ","إِلَىٰ","ذِكۡرِ","ٱللَّهِ","وَذَرُواْ","ٱلۡبَيۡعَۚ","ذَٰلِكُمۡ","خَيۡرٞ","لَّكُمۡ","إِن","كُنتُمۡ","تَعۡلَمُونَ"],"йа'аййухал лазиина амануу иза нуудийа лиссалавати мин йаумил жуму`ати фас`ау ила зикриллахи вазарул бай`а заликум хайрул лакум ин кунтум та`ламуун","О те, которые уверовали! Когда призывают на намаз в пятничный день, то устремляйтесь к поминанию Аллаха и оставьте торговлю. Так будет лучше для вас, если бы вы только знали.",["о","те, которые","уверовали","когда","призвано","на намаз","в","день","пятницы","то устремитесь","к","поминанию","Аллаха","и оставьте","торговлю","это","лучше","для вас","если","вы","знаете"]],[62,10,["فَإِذَا","قُضِيَتِ","ٱلصَّلَوٰةُ","فَٱنتَشِرُواْ","فِي","ٱلۡأَرۡضِ","وَٱبۡتَغُواْ","مِن","فَضۡلِ","ٱللَّهِ","وَٱذۡكُرُواْ","ٱللَّهَ","كَثِيرٗا","لَّعَلَّكُمۡ","تُفۡلِحُونَ"],"фа'иза ḳудийатис салавату фанташируу фил арди вабтагуу мин фадлиллахи вазкуруллаха касиирал ла`аллакум туфлихуун","Когда же намаз завершится, то разойдитесь по земле, ищите милость Аллаха и часто поминайте Его, - быть может, вы преуспеете.",["а когда","завершён","намаз","то расходитесь","по","земле","и ищите","из","милости","Аллаха","и поминайте","Аллаха","много","чтобы вы","преуспели"]],[62,11,["وَإِذَا","رَأَوۡاْ","تِجَٰرَةً","أَوۡ","لَهۡوًا","ٱنفَضُّوٓاْ","إِلَيۡهَا","وَتَرَكُوكَ","قَآئِمٗاۚ","قُلۡ","مَا","عِندَ","ٱللَّهِ","خَيۡرٞ","مِّنَ","ٱللَّهۡوِ","وَمِنَ","ٱلتِّجَٰرَةِۚ","وَٱللَّهُ","خَيۡرُ","ٱلرَّٰزِقِينَ"],"ва'иза ра'ау тижаратан ау лахванинфаддуу илайха ватаракуука ḳаиман ḳул ма `индаллахи хайрум миналлахви ваминат тижарати валлаху хайрур разиḳиин","Когда же они увидели торговлю или забаву, они разошлись, бросившись к ней, и оставили тебя стоять во время пятничной проповеди. Скажи: «То, что у Аллаха, лучше забавы и торговли, и Аллах - Наилучший из дарующих удел».",["а когда","они увидели","торговлю","или","забаву","разбежались","к ней","и оставили тебя","стоящим","скажи","то, что","у","Аллаха","лучше","чем","забава","и чем","торговля","и Аллах","лучший","из дающих удел"]],[63,1,["إِذَا","جَآءَكَ","ٱلۡمُنَٰفِقُونَ","قَالُواْ","نَشۡهَدُ","إِنَّكَ","لَرَسُولُ","ٱللَّهِۗ","وَٱللَّهُ","يَعۡلَمُ","إِنَّكَ","لَرَسُولُهُۥ","وَٱللَّهُ","يَشۡهَدُ","إِنَّ","ٱلۡمُنَٰفِقِينَ","لَكَٰذِبُونَ"],"иза жаакал мунафиḳууна ḳалуу нашхаду иннака ларасуулуллахи валлаху йа`ламу иннака ларасуулухуу валлаху йашхаду иннал мунафиḳиина лаказибуун","Когда лицемеры приходят к тебе, они говорят: «Свидетельствуем, что ты - Посланник Аллаха». Аллах знает, что ты - Его Посланник, и Аллах свидетельствует, что лицемеры являются лжецами.",["когда","приходят к тебе","лицемеры","они говорят","свидетельствуем","что ты","непременно Посланник","Аллаха","и Аллах","знает","что ты","непременно Его Посланник","и Аллах","свидетельствует","что","лицемеры","непременно лжецы"]],[63,2,["ٱتَّخَذُوٓاْ","أَيۡمَٰنَهُمۡ","جُنَّةٗ","فَصَدُّواْ","عَن","سَبِيلِ","ٱللَّهِۚ","إِنَّهُمۡ","سَآءَ","مَا","كَانُواْ","يَعۡمَلُونَ"],"иттахазуу айманахум жуннатан фасаддуу `ан сабиилиллахи иннахум саа ма кануу йа`малуун","Они сделали свои клятвы щитом и сбили других с пути Аллаха. Воистину, скверно то, что они совершают!",["они сделали","клятвы свои","щитом","и отвратили","от","пути","Аллаха","поистине, они","скверно","то, что","они","делали"]],[63,3,["ذَٰلِكَ","بِأَنَّهُمۡ","ءَامَنُواْ","ثُمَّ","كَفَرُواْ","فَطُبِعَ","عَلَىٰ","قُلُوبِهِمۡ","فَهُمۡ","لَا","يَفۡقَهُونَ"],"залика би'аннахум амануу сумма кафаруу фатуби`а `ала ḳулуубихим фахум ла йафḳахуун","Это потому, что они уверовали, а затем стали неверующими. Затем их сердца были запечатаны, и теперь они не разумеют.",["это","потому, что они","уверовали","затем","не уверовали","и наложена печать","на","сердца их","и они","не","понимают"]],[63,4,["وَإِذَا","رَأَيۡتَهُمۡ","تُعۡجِبُكَ","أَجۡسَامُهُمۡۖ","وَإِن","يَقُولُواْ","تَسۡمَعۡ","لِقَوۡلِهِمۡۖ","كَأَنَّهُمۡ","خُشُبٞ","مُّسَنَّدَةٞۖ","يَحۡسَبُونَ","كُلَّ","صَيۡحَةٍ","عَلَيۡهِمۡۚ","هُمُ","ٱلۡعَدُوُّ","فَٱحۡذَرۡهُمۡۚ","قَٰتَلَهُمُ","ٱللَّهُۖ","أَنَّىٰ","يُؤۡفَكُونَ"],"ва'иза ра'айтахум ту`жибука ажсамухум ва'ин йаḳуулуу тасма` лиḳаулихим ка'аннахум хушубум мусаннадатун йахсабууна кулла сайхатин `алайхим хумул `адувву фахзархум ḳаталахумуллаху анна йу'факуун","Когда ты смотришь на них, их тела восхищают тебя. Когда они говорят, ты слушаешь их слова. Они подобны прислоненным бревнам. Всякий крик они считают обращенным против них. Они являются врагами - остерегайся же их. Да погубит их Аллах! До чего же они отвращены от истины!",["и когда","ты видишь их","восхищают тебя","тела их","и если","они говорят","ты слушаешь","речь их","словно они","брёвна","прислонённые","они считают","всякий","крик","против них","они","враги","так остерегайся их","да погубит их","Аллах","до чего","они отвращены"]]],"m":[[["يَٰٓأَيُّهَا","о",62,9],["ٱلَّذِينَ","те, которые",62,9],["ءَامَنُوٓاْ","уверовали",62,9],["إِذَا","когда",62,9],["نُودِيَ","призвано",62,9],["لِلصَّلَوٰةِ","на намаз",62,9],["مِن","в",62,9],["يَوۡمِ","день",62,9],["ٱلۡجُمُعَةِ","пятницы",62,9]],[["فَٱسۡعَوۡاْ","то устремитесь",62,9],["إِلَىٰ","к",62,9],["ذِكۡرِ","поминанию",62,9],["ٱللَّهِ","Аллаха",62,9],["وَذَرُواْ","и оставьте",62,9],["ٱلۡبَيۡعَۚ","торговлю",62,9],["ذَٰلِكُمۡ","это",62,9],["خَيۡرٞ","лучше",62,9],["لَّكُمۡ","для вас",62,9],["إِن","если",62,9],["كُنتُمۡ","вы",62,9]],[["تَعۡلَمُونَ","знаете",62,9],[9],["فَإِذَا","а когда",62,10],["قُضِيَتِ","завершён",62,10],["ٱلصَّلَوٰةُ","намаз",62,10],["فَٱنتَشِرُواْ","то расходитесь",62,10],["فِي","по",62,10],["ٱلۡأَرۡضِ","земле",62,10]],[["وَٱبۡتَغُواْ","и ищите",62,10],["مِن","из",62,10],["فَضۡلِ","милости",62,10],["ٱللَّهِ","Аллаха",62,10],["وَٱذۡكُرُواْ","и поминайте",62,10],["ٱللَّهَ","Аллаха",62,10],["كَثِيرٗا","много",62,10],["لَّعَلَّكُمۡ","чтобы вы",62,10],["تُفۡلِحُونَ","преуспели",62,10]],[[10],["وَإِذَا","а когда",62,11],["رَأَوۡاْ","они увидели",62,11],["تِجَٰرَةً","торговлю",62,11],["أَوۡ","или",62,11],["لَهۡوًا","забаву",62,11],["ٱنفَضُّوٓاْ","разбежались",62,11],["إِلَيۡهَا","к ней",62,11],["وَتَرَكُوكَ","и оставили тебя",62,11],["قَآئِمٗاۚ","стоящим",62,11],["قُلۡ","скажи",62,11]],[["مَا","то, что",62,11],["عِندَ","у",62,11],["ٱللَّهِ","Аллаха",62,11],["خَيۡرٞ","лучше",62,11],["مِّنَ","чем",62,11],["ٱللَّهۡوِ","забава",62,11],["وَمِنَ","и чем",62,11],["ٱلتِّجَٰرَةِۚ","торговля",62,11],["وَٱللَّهُ","и Аллах",62,11],["خَيۡرُ","лучший",62,11],["ٱلرَّٰزِقِينَ","из дающих удел",62,11],[11]],["h",63],["b"],[["إِذَا","когда",63,1],["جَآءَكَ","приходят к тебе",63,1],["ٱلۡمُنَٰفِقُونَ","лицемеры",63,1],["قَالُواْ","они говорят",63,1],["نَشۡهَدُ","свидетельствуем",63,1],["إِنَّكَ","что ты",63,1],["لَرَسُولُ","непременно Посланник",63,1],["ٱللَّهِۗ","Аллаха",63,1],["وَٱللَّهُ","и Аллах",63,1],["يَعۡلَمُ","знает",63,1]],[["إِنَّكَ","что ты",63,1],["لَرَسُولُهُۥ","непременно Его Посланник",63,1],["وَٱللَّهُ","и Аллах",63,1],["يَشۡهَدُ","свидетельствует",63,1],["إِنَّ","что",63,1],["ٱلۡمُنَٰفِقِينَ","лицемеры",63,1],["لَكَٰذِبُونَ","непременно лжецы",63,1],[1]],[["ٱتَّخَذُوٓاْ","они сделали",63,2],["أَيۡمَٰنَهُمۡ","клятвы свои",63,2],["جُنَّةٗ","щитом",63,2],["فَصَدُّواْ","и отвратили",63,2],["عَن","от",63,2],["سَبِيلِ","пути",63,2],["ٱللَّهِۚ","Аллаха",63,2],["إِنَّهُمۡ","поистине, они",63,2],["سَآءَ","скверно",63,2],["مَا","то, что",63,2],["كَانُواْ","они",63,2]],[["يَعۡمَلُونَ","делали",63,2],[2],["ذَٰلِكَ","это",63,3],["بِأَنَّهُمۡ","потому, что они",63,3],["ءَامَنُواْ","уверовали",63,3],["ثُمَّ","затем",63,3],["كَفَرُواْ","не уверовали",63,3],["فَطُبِعَ","и наложена печать",63,3],["عَلَىٰ","на",63,3],["قُلُوبِهِمۡ","сердца их",63,3]],[["فَهُمۡ","и они",63,3],["لَا","не",63,3],["يَفۡقَهُونَ","понимают",63,3],[3],["۞ وَإِذَا","и когда",63,4],["رَأَيۡتَهُمۡ","ты видишь их",63,4],["تُعۡجِبُكَ","восхищают тебя",63,4],["أَجۡسَامُهُمۡۖ","тела их",63,4]],[["وَإِن","и если",63,4],["يَقُولُواْ","они говорят",63,4],["تَسۡمَعۡ","ты слушаешь",63,4],["لِقَوۡلِهِمۡ