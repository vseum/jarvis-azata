{"p":555,"j":28,"a":[[63,5,["وَإِذَا","قِيلَ","لَهُمۡ","تَعَالَوۡاْ","يَسۡتَغۡفِرۡ","لَكُمۡ","رَسُولُ","ٱللَّهِ","لَوَّوۡاْ","رُءُوسَهُمۡ","وَرَأَيۡتَهُمۡ","يَصُدُّونَ","وَهُم","مُّسۡتَكۡبِرُونَ"],"ва'иза ḳиила лахум та`алау йастагфир лакум расуулуллахи лаввау ру'уусахум вараайтахум йасуддууна вахум мустакбируун","Когда им говорят: «Придите, чтобы Посланник Аллаха попросил для вас прощения», - они качают головой, и ты видишь, как они надменно отворачиваются.",["и когда","сказано","им","придите","попросит прощения","для вас","Посланник","Аллаха","они отворачивают","головы свои","и ты видишь их","отворачиваются","и они","надменны"]],[63,6,["سَوَآءٌ","عَلَيۡهِمۡ","أَسۡتَغۡفَرۡتَ","لَهُمۡ","أَمۡ","لَمۡ","تَسۡتَغۡفِرۡ","لَهُمۡ","لَن","يَغۡفِرَ","ٱللَّهُ","لَهُمۡۚ","إِنَّ","ٱللَّهَ","لَا","يَهۡدِي","ٱلۡقَوۡمَ","ٱلۡفَٰسِقِينَ"],"саваун `алайхим астагфарта лахум ам лам тастагфир лахум лан йагфираллаху лахум инналлаха ла йахдил ḳаумал фасиḳиин","Попросишь ты для них прощения или не станешь просить для них прощения - им все равно. Аллах не простит их. Воистину, Аллах не ведет прямым путем нечестивых людей.",["одинаково","для них","просил ли ты прощения","для них","или","не","просил прощения","для них","никогда не","простит","Аллах","им","поистине","Аллах","не","ведёт прямо","людей","нечестивых"]],[63,7,["هُمُ","ٱلَّذِينَ","يَقُولُونَ","لَا","تُنفِقُواْ","عَلَىٰ","مَنۡ","عِندَ","رَسُولِ","ٱللَّهِ","حَتَّىٰ","يَنفَضُّواْۗ","وَلِلَّهِ","خَزَآئِنُ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِ","وَلَٰكِنَّ","ٱلۡمُنَٰفِقِينَ","لَا","يَفۡقَهُونَ"],"хумул лазиина йаḳуулууна ла тунфиḳуу `ала ман `инда расуулиллахи хатта йанфаддуу валиллахи хазаинус самавати вал'арди валакиннал мунафиḳиина ла йафḳахуун","Именно они говорят: «Ничего не тратьте на тех, кто возле Посланника Аллаха, пока они не покинут его». Аллаху принадлежат сокровищницы небес и земли, но лицемеры не понимают этого.",["они","те, которые","говорят","не","расходуйте","на","тех, кто","у","Посланника","Аллаха","пока не","разойдутся","а Аллаху","сокровищницы","небес","и земли","но","лицемеры","не","понимают"]],[63,8,["يَقُولُونَ","لَئِن","رَّجَعۡنَآ","إِلَى","ٱلۡمَدِينَةِ","لَيُخۡرِجَنَّ","ٱلۡأَعَزُّ","مِنۡهَا","ٱلۡأَذَلَّۚ","وَلِلَّهِ","ٱلۡعِزَّةُ","وَلِرَسُولِهِۦ","وَلِلۡمُؤۡمِنِينَ","وَلَٰكِنَّ","ٱلۡمُنَٰفِقِينَ","لَا","يَعۡلَمُونَ"],"йаḳуулууна ла'ир ража`на илал мадиинати лайухрижаннал а`аззу минхал азалла валиллахил `иззату валирасуулихии валилму'миниина валакиннал мунафиḳиина ла йа`ламуун","Они говорят: «Когда мы вернемся в Медину, то могущественные среди нас непременно изгонят оттуда презренных». Могущество присуще Аллаху, Его Посланнику и верующим, но лицемеры не знают этого.",["они говорят","если","мы вернёмся","в","Медину","непременно изгонит","более могущественный","из неё","более униженного","а Аллаху","могущество","и Его Посланнику","и верующим","но","лицемеры","не","знают"]],[63,9,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُواْ","لَا","تُلۡهِكُمۡ","أَمۡوَٰلُكُمۡ","وَلَآ","أَوۡلَٰدُكُمۡ","عَن","ذِكۡرِ","ٱللَّهِۚ","وَمَن","يَفۡعَلۡ","ذَٰلِكَ","فَأُوْلَٰٓئِكَ","هُمُ","ٱلۡخَٰسِرُونَ"],"йа'аййухал лазиина амануу ла тулхикум амвалукум вала ауладукум `ан зикриллахи ваман йаф`ал залика фа'улаика хумул хасируун","О те, которые уверовали! Пусть ваше имущество и ваши дети не отвлекают вас от поминания Аллаха. А те, которые поступают таким образом, окажутся потерпевшими убыток.",["о","те, которые","уверовали","пусть не","отвлекают вас","имущество ваше","и не","дети ваши","от","поминания","Аллаха","а кто","сделает","это","то те","они","потерпевшие убыток"]],[63,10,["وَأَنفِقُواْ","مِن","مَّا","رَزَقۡنَٰكُم","مِّن","قَبۡلِ","أَن","يَأۡتِيَ","أَحَدَكُمُ","ٱلۡمَوۡتُ","فَيَقُولَ","رَبِّ","لَوۡلَآ","أَخَّرۡتَنِيٓ","إِلَىٰٓ","أَجَلٖ","قَرِيبٖ","فَأَصَّدَّقَ","وَأَكُن","مِّنَ","ٱلصَّٰلِحِينَ"],"ва'анфиḳуу мим ма разаḳнакум мин ḳабли ан йа'тийа ахадакумул мауту файаḳуула рабби лаула аххартании ила ажалин ḳариибин фа'ассаддаḳа ва'акум минас салихиин","Расходуйте из того, чем Мы вас наделили, до того, как вас постигнет смерть и вы скажете: «Господи! Предоставь мне недолгую отсрочку, и я буду раздавать милостыню и стану одним из праведников».",["и расходуйте","из","того, что","Мы даровали вам","до","того","как","придёт","к одному из вас","смерть","и он скажет","Господи","почему бы не","отсрочил Ты мне","до","срока","близкого","и я раздал бы милостыню","и стал бы","из","праведных"]],[63,11,["وَلَن","يُؤَخِّرَ","ٱللَّهُ","نَفۡسًا","إِذَا","جَآءَ","أَجَلُهَاۚ","وَٱللَّهُ","خَبِيرُۢ","بِمَا","تَعۡمَلُونَ"],"валан йу'аххираллаху нафсан иза жаа ажалуха валлаху хабииру бима та`малуун","Аллах не предоставит отсрочки душе, если наступил ее срок. Аллах ведает о том, что вы совершаете.",["и никогда не","отсрочит","Аллах","душе","когда","пришёл","её срок","и Аллах","ведающий","о том, что","вы делаете"]]],"m":[[["وَإِذَا","и когда",63,5],["قِيلَ","сказано",63,5],["لَهُمۡ","им",63,5],["تَعَالَوۡاْ","придите",63,5],["يَسۡتَغۡفِرۡ","попросит прощения",63,5],["لَكُمۡ","для вас",63,5],["رَسُولُ","Посланник",63,5],["ٱللَّهِ","Аллаха",63,5],["لَوَّوۡاْ","они отворачивают",63,5],["رُءُوسَهُمۡ","головы свои",63,5]],[["وَرَأَيۡتَهُمۡ","и ты видишь их",63,5],["يَصُدُّونَ","отворачиваются",63,5],["وَهُم","и они",63,5],["مُّسۡتَكۡبِرُونَ","надменны",63,5],[5],["سَوَآءٌ","одинаково",63,6],["عَلَيۡهِمۡ","для них",63,6]],[["أَسۡتَغۡفَرۡتَ","просил ли ты прощения",63,6],["لَهُمۡ","для них",63,6],["أَمۡ","или",63,6],["لَمۡ","не",63,6],["تَسۡتَغۡفِرۡ","просил прощения",63,6],["لَهُمۡ","для них",63,6],["لَن","никогда не",63,6],["يَغۡفِرَ","простит",63,6],["ٱللَّهُ","Аллах",63,6],["لَهُمۡۚ","им",63,6],["إِنَّ","поистине",63,6]],[["ٱللَّهَ","Аллах",63,6],["لَا","не",63,6],["يَهۡدِي","ведёт прямо",63,6],["ٱلۡقَوۡمَ","людей",63,6],["ٱلۡفَٰسِقِينَ","нечестивых",63,6],[6],["هُمُ","они",63,7],["ٱلَّذِينَ","те, которые",63,7],["يَقُولُونَ","говорят",63,7]],[["لَا","не",63,7],["تُنفِقُواْ","расходуйте",63,7],["عَلَىٰ","на",63,7],["مَنۡ","тех, кто",63,7],["عِندَ","у",63,7],["رَسُولِ","Посланника",63,7],["ٱللَّهِ","Аллаха",63,7],["حَتَّىٰ","пока не",63,7],["يَنفَضُّواْۗ","разойдутся",63,7],["وَلِلَّهِ","а Аллаху",63,7]],[["خَزَآئِنُ","сокровищницы",63,7],["ٱلسَّمَٰوَٰتِ","небес",63,7],["وَٱلۡأَرۡضِ","и земли",63,7],["وَلَٰكِنَّ","но",63,7],["ٱلۡمُنَٰفِقِينَ","лицемеры",63,7],["لَا","не",63,7],["يَفۡقَهُونَ","понимают",63,7]],[[7],["يَقُولُونَ","они говорят",63,8],["لَئِن","если",63,8],["رَّجَعۡنَآ","мы вернёмся",63,8],["إِلَى","в",63,8],["ٱلۡمَدِينَةِ","Медину",63,8],["لَيُخۡرِجَنَّ","непременно изгонит",63,8],["ٱلۡأَعَزُّ","более могущественный",63,8]],[["مِنۡهَا","из неё",63,8],["ٱلۡأَذَلَّۚ","более униженного",63,8],["وَلِلَّهِ","а Аллаху",63,8],["ٱلۡعِزَّةُ","могущество",63,8],["وَلِرَسُولِهِۦ","и Его Посланнику",63,8],["وَلِلۡمُؤۡمِنِينَ","и верующим",63,8],["وَلَٰكِنَّ","но",63,8]],[["ٱلۡمُنَٰفِقِينَ","лицемеры",63,8],["لَا","не",63,8],["يَعۡلَمُونَ","знают",63,8],[8],["يَٰٓأَيُّهَا","о",63,9],["ٱلَّذِينَ","те, которые",63,9],["ءَامَنُواْ","уверовали",63,9],["لَا","пусть не",63,9],["تُلۡهِكُمۡ","отвлекают вас",63,9]],[["أَمۡوَٰلُكُمۡ","имущество ваше",63,9],["وَلَآ","и не",63,9],["أَوۡلَٰدُكُمۡ","дети ваши",63,9],["عَن","от",63,9],["ذِكۡرِ","поминания",63,9],["ٱللَّهِۚ","Аллаха",63,9],["وَمَن","а кто",63,9],["يَفۡعَلۡ","сделает",63,9]],[["ذَٰلِكَ","это",63,9],["فَأُوْلَٰٓئِكَ","то те",63,9],["هُمُ","они",63,9],["ٱلۡخَٰسِرُونَ","потерпевшие убыток",63,9],[9],["وَأَنفِقُواْ","и расходуйте",63,10],["مِن","из",63,10],["مَّا","того, что",63,10],["رَزَقۡنَٰكُم","Мы даровали вам",63,10]],[["مِّن","до",63,10],["قَبۡلِ","того",63,10],["أَن","как",63,10],["يَأۡتِيَ","придёт",63,10],["أَحَدَكُمُ","к одному из вас",63,10],["ٱلۡمَوۡتُ","смерть",63,10],["فَيَقُولَ","и он скажет",63,10],["رَبِّ","Господи",63,10],["لَوۡلَآ","почему бы не",63,10],["أَخَّرۡتَنِيٓ","отсрочил Ты мне",63,10]],[["إِلَىٰٓ","до",63,10],["أَجَلٖ","срока",63,10],["قَرِيبٖ","близкого",63,10],["فَأَصَّدَّقَ","и я раздал бы милостыню",63,10],["وَأَكُن","и стал бы",63,10],["مِّنَ","из",63,10],["ٱلصَّٰلِحِينَ","праведных",63,10],[10],["وَلَن","и никогда не",63,11]],[["يُؤَخِّرَ","отсрочит",63,11],["ٱللَّهُ","Аллах",63,11],["نَفۡسًا","душе",63,11],["إِذَا","когда",63,11],["جَآءَ","пришёл",63,11],["أَجَلُهَاۚ","её срок",63,11],["وَٱللَّهُ","и Аллах",63,11],["خَبِيرُۢ","ведающий",63,11],["بِمَا","о том, что",63,11],["تَعۡمَلُونَ","вы делаете",63,11],[11]],["h",64]]}