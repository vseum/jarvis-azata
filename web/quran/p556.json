али они",64,6],["وَتَوَلَّواْۖ","и отвернулись",64,6],["وَّٱسۡتَغۡنَى","и обошёлся без них",64,6]],[["ٱللَّهُۚ","Аллах",64,6],["وَٱللَّهُ","И Аллах",64,6],["غَنِيٌّ","Богатый",64,6],["حَمِيدٞ","Достохвальный",64,6],[6],["زَعَمَ","Утверждают",64,7],["ٱلَّذِينَ","те, которые",64,7],["كَفَرُوٓاْ","не уверовали",64,7],["أَن","что",64,7],["لَّن","никогда не",64,7],["يُبۡعَثُواْۚ","будут воскрешены они",64,7],["قُلۡ","Скажи",64,7],["بَلَىٰ","Напротив",64,7],["وَرَبِّي","клянусь моим Господом",64,7]],[["لَتُبۡعَثُنَّ","непременно будете воскрешены вы",64,7],["ثُمَّ","затем",64,7],["لَتُنَبَّؤُنَّ","непременно вам сообщат",64,7],["بِمَا","о том, что",64,7],["عَمِلۡتُمۡۚ","вы совершили",64,7],["وَذَٰلِكَ","И это",64,7],["عَلَى","для",64,7],["ٱللَّهِ","Аллаха",64,7],["يَسِيرٞ","легко",64,7],[7],["فَـَٔامِنُواْ","так уверуйте",64,8],["بِٱللَّهِ","в Аллаха",64,8]],[["وَرَسُولِهِۦ","и Его Посланника",64,8],["وَٱلنُّورِ","и свет",64,8],["ٱلَّذِيٓ","который",64,8],["أَنزَلۡنَاۚ","Мы ниспослали",64,8],["وَٱللَّهُ","и Аллах",64,8],["بِمَا","о том, что",64,8],["تَعۡمَلُونَ","вы делаете",64,8],["خَبِيرٞ","Сведущ",64,8],[8],["يَوۡمَ","В день, когда",64,9]],[["يَجۡمَعُكُمۡ","Он соберёт вас",64,9],["لِيَوۡمِ","для Дня",64,9],["ٱلۡجَمۡعِۖ","сбора",64,9],["ذَٰلِكَ","это",64,9],["يَوۡمُ","день",64,9],["ٱلتَّغَابُنِۗ","взаимного обделения",64,9],["وَمَن","И кто",64,9],["يُؤۡمِنۢ","уверует",64,9],["بِٱللَّهِ","в Аллаха",64,9],["وَيَعۡمَلۡ","и совершает",64,9]],[["صَٰلِحٗا","праведное",64,9],["يُكَفِّرۡ","Он загладит",64,9],["عَنۡهُ","с него",64,9],["سَيِّـَٔاتِهِۦ","его злые деяния",64,9],["وَيُدۡخِلۡهُ","и введёт его",64,9],["جَنَّٰتٖ","в сады",64,9],["تَجۡرِي","текут",64,9],["مِن","из",64,9],["تَحۡتِهَا","под ними",64,9]],[["ٱلۡأَنۡهَٰرُ","реки",64,9],["خَٰلِدِينَ","вечно пребывая",64,9],["فِيهَآ","в них",64,9],["أَبَدٗاۚ","навечно",64,9],["ذَٰلِكَ","Это",64,9],["ٱلۡفَوۡزُ","успех",64,9],["ٱلۡعَظِيمُ","великий",64,9],[9]]]}