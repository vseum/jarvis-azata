{"p":556,"j":28,"a":[[64,1,["يُسَبِّحُ","لِلَّهِ","مَا","فِي","ٱلسَّمَٰوَٰتِ","وَمَا","فِي","ٱلۡأَرۡضِۖ","لَهُ","ٱلۡمُلۡكُ","وَلَهُ","ٱلۡحَمۡدُۖ","وَهُوَ","عَلَىٰ","كُلِّ","شَيۡءٖ","قَدِيرٌ"],"йусаббиху лиллахи ма фис самавати вама фил арди лахул мулку валахул хамду вахуа `ала кулли шай'ин ḳадиир","Славит Аллаха то, что на небесах, и то, что на земле. Ему принадлежит власть и надлежит хвала. Он способен на всякую вещь.",["славит","Аллаха","то, что","на","небесах","и то, что","на","земле","Ему","власть","и Ему","хвала","и Он","на","всякую","вещь","способен"]],[64,2,["هُوَ","ٱلَّذِي","خَلَقَكُمۡ","فَمِنكُمۡ","كَافِرٞ","وَمِنكُم","مُّؤۡمِنٞۚ","وَٱللَّهُ","بِمَا","تَعۡمَلُونَ","بَصِيرٌ"],"хуал лазии халаḳакум фаминкум кафирун ваминкум му'минун валлаху бима та`малууна басиир","Он - Тот, Кто сотворил вас. Среди вас есть неверующие, и среди вас есть верующие. Аллах видит то, что вы совершаете.",["Он","Тот, Который","сотворил вас","и среди вас","неверующий","и среди вас","верующий","и Аллах","то, что","вы делаете","видящий"]],[64,3,["خَلَقَ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضَ","بِٱلۡحَقِّ","وَصَوَّرَكُمۡ","فَأَحۡسَنَ","صُوَرَكُمۡۖ","وَإِلَيۡهِ","ٱلۡمَصِيرُ"],"халаḳас самавати вал'арда билхаḳḳи васавваракум фа'ахсана суаракум ва'илайхил масиир","Он создал небеса и землю ради истины, придал вам облик и сделал ваш облик прекрасным. К Нему предстоит прибытие.",["Он сотворил","небеса","и землю","с истиной","и придал вам облик","и сделал прекрасными","облики ваши","и к Нему","возвращение"]],[64,4,["يَعۡلَمُ","مَا","فِي","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِ","وَيَعۡلَمُ","مَا","تُسِرُّونَ","وَمَا","تُعۡلِنُونَۚ","وَٱللَّهُ","عَلِيمُۢ","بِذَاتِ","ٱلصُّدُورِ"],"йа`ламу ма фис самавати вал'арди вайа`ламу ма тусиррууна вама ту`линууна валлаху `алииму бизатис судуур","Он знает о том, что на небесах и на земле, и знает о том, что вы скрываете и что обнародуете. Аллах ведает о том, что в груди.",["Он знает","то, что","на","небесах","и земле","и Он знает","то, что","вы скрываете","и то, что","вы обнаруживаете","и Аллах","знающий","о том, что в","груди"]],[64,5,["أَلَمۡ","يَأۡتِكُمۡ","نَبَؤُاْ","ٱلَّذِينَ","كَفَرُواْ","مِن","قَبۡلُ","فَذَاقُواْ","وَبَالَ","أَمۡرِهِمۡ","وَلَهُمۡ","عَذَابٌ","أَلِيمٞ"],"алам йа'тикум набаул лазиина кафаруу мин ḳаблу фазаḳуу вабала амрихим валахум `азабун алиим","Разве до вас не дошли рассказы о тех, которые не уверовали в прошлом и вкусили пагубные последствия своих деяний? Им уготованы мучительные страдания.",["Разве не","пришла к вам","весть","о тех, которые","не уверовали","из","прежде","и вкусили они","пагубность","их дела","и для них","наказание","мучительное"]],[64,6,["ذَٰلِكَ","بِأَنَّهُۥ","كَانَت","تَّأۡتِيهِمۡ","رُسُلُهُم","بِٱلۡبَيِّنَٰتِ","فَقَالُوٓاْ","أَبَشَرٞ","يَهۡدُونَنَا","فَكَفَرُواْ","وَتَوَلَّواْۖ","وَّٱسۡتَغۡنَى","ٱللَّهُۚ","وَٱللَّهُ","غَنِيٌّ","حَمِيدٞ"],"залика би'аннахуу канат та'тиихим русулухум билбаййинати фаḳалуу абашарун йахдуунана факафаруу ватаваллав вастагналлаху валлаху ганиййун хамиид","Это - за то, что посланники приходили к ним с ясными знамениями, а они говорили: «Неужели люди поведут нас прямым путем?». Они не уверовали и отвернулись. Аллах обошелся без них, ведь Аллах - Богатый, Достохвальный.",["Это","потому что","бывало","приходили к ним","их посланники","с ясными знамениями","и сказали они","Неужели человек","поведёт нас","и не уверовали они","и отвернулись","и обошёлся без них","Аллах","И Аллах","Богатый","Достохвальный"]],[64,7,["زَعَمَ","ٱلَّذِينَ","كَفَرُوٓاْ","أَن","لَّن","يُبۡعَثُواْۚ","قُلۡ","بَلَىٰ","وَرَبِّي","لَتُبۡعَثُنَّ","ثُمَّ","لَتُنَبَّؤُنَّ","بِمَا","عَمِلۡتُمۡۚ","وَذَٰلِكَ","عَلَى","ٱللَّهِ","يَسِيرٞ"],"за`амал лазиина кафаруу ал лан йуб`асуу ḳул бала вараббии латуб`асунна сумма латунаббаунна бима `амилтум вазалика `алаллахи йасиир","Неверующие полагают, что они не будут воскрешены. Скажи: «Напротив, клянусь моим Господом, вы непременно будете воскрешены, а затем вам непременно сообщат о том, что вы совершили. Это для Аллаха легко».",["Утверждают","те, которые","не уверовали","что","никогда не","будут воскрешены они","Скажи","Напротив","клянусь моим Господом","непременно будете воскрешены вы","затем","непременно вам сообщат","о том, что","вы совершили","И это","для","Аллаха","легко"]],[64,8,["فَـَٔامِنُواْ","بِٱللَّهِ","وَرَسُولِهِۦ","وَٱلنُّورِ","ٱلَّذِيٓ","أَنزَلۡنَاۚ","وَٱللَّهُ","بِمَا","تَعۡمَلُونَ","خَبِيرٞ"],"фа'аминуу биллахи варасуулихии ваннуурил лазии анзална валлаху бима та`малууна хабиир","Уверуйте же в Аллаха, Его Посланника и свет, который Мы ниспослали. Аллах ведает о том, что вы совершаете.",["так уверуйте","в Аллаха","и Его Посланника","и свет","который","Мы ниспослали","и Аллах","о том, что","вы делаете","Сведущ"]],[64,9,["يَوۡمَ","يَجۡمَعُكُمۡ","لِيَوۡمِ","ٱلۡجَمۡعِۖ","ذَٰلِكَ","يَوۡمُ","ٱلتَّغَابُنِۗ","وَمَن","يُؤۡمِنۢ","بِٱللَّهِ","وَيَعۡمَلۡ","صَٰلِحٗا","يُكَفِّرۡ","عَنۡهُ","سَيِّـَٔاتِهِۦ","وَيُدۡخِلۡهُ","جَنَّٰتٖ","تَجۡرِي","مِن","تَحۡتِهَا","ٱلۡأَنۡهَٰرُ","خَٰلِدِينَ","فِيهَآ","أَبَدٗاۚ","ذَٰلِكَ","ٱلۡفَوۡزُ","ٱلۡعَظِيمُ"],"йаума йажма`укум лийаумил жам`и залика йаумут тагабуни ваман йу'мим биллахи вайа`мал салихан йукаффир `анху саййиатихии вайудхилху жаннатин тажрии мин тахтихал анхару халидиина фииха абадан заликал фаузул `азиим","В тот день Он соберет вас для Дня сбора. Это будет День взаимного обделения. Тем, кто уверовал в Аллаха и поступал праведно, Он простит злодеяния и введет их в Райские сады, в которых текут реки. Они пребудут там вечно. Это - великое преуспеяние!",["В день, когда","Он соберёт вас","для Дня","сбора","это","день","взаимного обделения","И кто","уверует","в Аллаха","и совершает","праведное","Он загладит","с него","его злые деяния","и введёт его","в сады","текут","из","под ними","реки","вечно пребывая","в них","навечно","Это","успех","великий"]]],"m":[["b"],[["يُسَبِّحُ","славит",64,1],["لِلَّهِ","Аллаха",64,1],["مَا","то, что",64,1],["فِي","на",64,1],["ٱلسَّمَٰوَٰتِ","небесах",64,1],["وَمَا","и то, что",64,1],["فِي","на",64,1],["ٱلۡأَرۡضِۖ","земле",64,1],["لَهُ","Ему",64,1],["ٱلۡمُل