{"p":558,"j":28,"a":[[65,1,["يَٰٓأَيُّهَا","ٱلنَّبِيُّ","إِذَا","طَلَّقۡتُمُ","ٱلنِّسَآءَ","فَطَلِّقُوهُنَّ","لِعِدَّتِهِنَّ","وَأَحۡصُواْ","ٱلۡعِدَّةَۖ","وَٱتَّقُواْ","ٱللَّهَ","رَبَّكُمۡۖ","لَا","تُخۡرِجُوهُنَّ","مِنۢ","بُيُوتِهِنَّ","وَلَا","يَخۡرُجۡنَ","إِلَّآ","أَن","يَأۡتِينَ","بِفَٰحِشَةٖ","مُّبَيِّنَةٖۚ","وَتِلۡكَ","حُدُودُ","ٱللَّهِۚ","وَمَن","يَتَعَدَّ","حُدُودَ","ٱللَّهِ","فَقَدۡ","ظَلَمَ","نَفۡسَهُۥۚ","لَا","تَدۡرِي","لَعَلَّ","ٱللَّهَ","يُحۡدِثُ","بَعۡدَ","ذَٰلِكَ","أَمۡرٗا"],"йа'аййухан набиййу иза таллаḳтумун нисаа фаталлиḳуухунна ли`иддатихинна ва'ахсул `иддата ваттаḳуллаха раббакум ла тухрижуухунна мим буйуутихинна вала йахружна илла ан йа'тиина бифахишатим мубаййинатин ватилка худуудуллахи ваман йата`адда худуудаллахи фаḳад залама нафсахуу ла тадрии ла`аллаллаха йухдису ба`да залика амра","О Пророк! Когда вы даете женам развод, то разводитесь в течение установленного срока, ведите счет этому сроку и бойтесь Аллаха, вашего Господа. Не выгоняйте их из их домов, и пусть они не выходят из них, если только они не совершат явную мерзость. Таковы ограничения Аллаха. Кто преступает ограничения Аллаха, тот поступает несправедливо по отношению к себе. Ты не знаешь, что Аллах, возможно, после этого решит иначе.",["О","Пророк","Когда","разводитесь вы с","жёнами","то разводитесь с ними","к их сроку","и считайте","срок","и бойтесь","Аллаха","вашего Господа","Не","выгоняйте их","из","их домов","и пусть не","выходят они","кроме","как","совершат они","мерзость","явную","И это","границы","Аллаха","И кто","преступит","границы","Аллаха","то уже","притеснил он","самого себя","Не","знаешь ты","может быть","Аллах","произведёт","после","этого","дело"]],[65,2,["فَإِذَا","بَلَغۡنَ","أَجَلَهُنَّ","فَأَمۡسِكُوهُنَّ","بِمَعۡرُوفٍ","أَوۡ","فَارِقُوهُنَّ","بِمَعۡرُوفٖ","وَأَشۡهِدُواْ","ذَوَيۡ","عَدۡلٖ","مِّنكُمۡ","وَأَقِيمُواْ","ٱلشَّهَٰدَةَ","لِلَّهِۚ","ذَٰلِكُمۡ","يُوعَظُ","بِهِۦ","مَن","كَانَ","يُؤۡمِنُ","بِٱللَّهِ","وَٱلۡيَوۡمِ","ٱلۡأٓخِرِۚ","وَمَن","يَتَّقِ","ٱللَّهَ","يَجۡعَل","لَّهُۥ","مَخۡرَجٗا"],"фа'иза балагна ажалахунна фа'амсикуухунна бима`рууфин ау фариḳуухунна бима`рууфин ва'ашхидуу завай `адлим минкум ва'аḳиимуш шахадата лиллахи заликум йуу`азу бихии ман кана йу'мину биллахи валйаумил ахири ваман йаттаḳиллаха йаж`ал лахуу махража","Когда для них наступит установленный срок, оставьте их у себя по-хорошему или же отпустите по-хорошему. Призовите свидетелями двух справедливых мужей из вас и будьте свидетелями ради Аллаха. Таково увещевание для тех, кто верует в Аллаха и в Последний день. Тому, кто боится Аллаха, Он создает выход из положения",["А когда","достигнут они","их срока","то удерживайте их","по-доброму","или","расставайтесь с ними","по-доброму","и призовите в свидетели","двух обладателей","справедливости","из вас","и выполняйте","свидетельство","ради Аллаха","Это","увещевается","этим","тот, кто","есть","верует","в Аллаха","и в День","Последний","И кто","побоится","Аллаха","Он сделает","ему","выход"]],[65,3,["وَيَرۡزُقۡهُ","مِنۡ","حَيۡثُ","لَا","يَحۡتَسِبُۚ","وَمَن","يَتَوَكَّلۡ","عَلَى","ٱللَّهِ","فَهُوَ","حَسۡبُهُۥٓۚ","إِنَّ","ٱللَّهَ","بَٰلِغُ","أَمۡرِهِۦۚ","قَدۡ","جَعَلَ","ٱللَّهُ","لِكُلِّ","شَيۡءٖ","قَدۡرٗا"],"вайарзуḳху мин хайсу ла йахтасибу ваман йатаваккал `алаллахи фахуа хасбухуу инналлаха балигу амрихии ḳад жа`алаллаху ликулли шай'ин ḳадра","и наделяет его уделом оттуда, откуда он даже не предполагает. Тому, кто уповает на Аллаха, достаточно Его. Аллах доводит до конца Свое дело. Аллах установил меру для каждой вещи.",["и Он наделит его","из","откуда","не","рассчитывает он","И кто","уповает","на","Аллаха","то Он","достаточен ему","Поистине","Аллах","доводит до конца","Своё дело","Уже","установил","Аллах","для всякой","вещи","меру"]],[65,4,["وَٱلَّٰٓـِٔي","يَئِسۡنَ","مِنَ","ٱلۡمَحِيضِ","مِن","نِّسَآئِكُمۡ","إِنِ","ٱرۡتَبۡتُمۡ","فَعِدَّتُهُنَّ","ثَلَٰثَةُ","أَشۡهُرٖ","وَٱلَّٰٓـِٔي","لَمۡ","يَحِضۡنَۚ","وَأُوْلَٰتُ","ٱلۡأَحۡمَالِ","أَجَلُهُنَّ","أَن","يَضَعۡنَ","حَمۡلَهُنَّۚ","وَمَن","يَتَّقِ","ٱللَّهَ","يَجۡعَل","لَّهُۥ","مِنۡ","أَمۡرِهِۦ","يُسۡرٗا"],"валлаии йа'исна минал махииди мин нисаикум иниртабтум фа`иддатухунна саласату ашхурин валлаии лам йахидна ва'улатул ахмали ажалухунна ан йада`на хамлахунна ваман йаттаḳиллаха йаж`ал лахуу мин амрихии йусра","Для тех из ваших женщин, у которых прекратились менструации, если вы сомневаетесь, установленный для развода срок равен трем месяцам, как и для тех, у которых не было менструаций. Для беременных срок установлен до тех пор, пока они не разрешатся от бремени. Тому, кто боится Аллаха, Он облегчает дела.",["И те, которые","отчаялись","в","месячных","из","ваших женщин","если","сомневаетесь вы","то их срок","три","месяца","и те, которые","не","имели месячных","А обладательницы","бремени","их срок","когда","разрешатся они","их бременем","И кто","побоится","Аллаха","Он сделает","ему","в","его деле","лёгкость"]],[65,5,["ذَٰلِكَ","أَمۡرُ","ٱللَّهِ","أَنزَلَهُۥٓ","إِلَيۡكُمۡۚ","وَمَن","يَتَّقِ","ٱللَّهَ","يُكَفِّرۡ","عَنۡهُ","سَيِّـَٔاتِهِۦ","وَيُعۡظِمۡ","لَهُۥٓ","أَجۡرًا"],"залика амруллахи анзалахуу илайкум ваман йаттаḳиллаха йукаффир `анху саййиатихии вайу`зим лахуу ажра","Таково повеление Аллаха, которое Он ниспослал вам. Тому, кто боится Аллаха, Он простит злодеяния и увеличит награду.",["Это","повеление","Аллаха","Он ниспослал его","вам","И кто","побоится","Аллаха","Он загладит","с него","его злые деяния","и увеличит","ему","награду"]]],"m":[["b"],[["يَٰٓأَيُّهَا","О",65,1],["ٱلنَّبِيُّ","Пророк",65,1],["إِذَا","Когда",65,1],["طَلَّقۡتُمُ","разводитесь вы с",65,1],["ٱلنِّسَآءَ","жёнами",65,1],["فَطَلِّقُوهُنَّ","то разводитесь с ними",65,1],["لِعِدَّتِهِنَّ","к их сроку",65,1],["وَأَحۡصُواْ","и считайте",65,1]],[["ٱلۡعِدَّةَۖ","срок",65,1],["وَٱتَّقُواْ","и бойтесь",65,1],["ٱللَّهَ","Аллаха",65,1],["رَبَّكُمۡۖ","вашего Господа",65,1],["لَا","Не",65,1],["تُخۡرِجُوهُنَّ","выгоняйте их",65,1],["مِنۢ","из",65,1],["بُيُوتِهِنَّ","их домов",65,1]],[["وَلَا","и пусть не",65,1],["يَخۡرُجۡنَ","выходят они",65,1],["إِلَّآ","кроме"