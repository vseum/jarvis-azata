{"p":559,"j":28,"a":[[65,6,["أَسۡكِنُوهُنَّ","مِنۡ","حَيۡثُ","سَكَنتُم","مِّن","وُجۡدِكُمۡ","وَلَا","تُضَآرُّوهُنَّ","لِتُضَيِّقُواْ","عَلَيۡهِنَّۚ","وَإِن","كُنَّ","أُوْلَٰتِ","حَمۡلٖ","فَأَنفِقُواْ","عَلَيۡهِنَّ","حَتَّىٰ","يَضَعۡنَ","حَمۡلَهُنَّۚ","فَإِنۡ","أَرۡضَعۡنَ","لَكُمۡ","فَـَٔاتُوهُنَّ","أُجُورَهُنَّ","وَأۡتَمِرُواْ","بَيۡنَكُم","بِمَعۡرُوفٖۖ","وَإِن","تَعَاسَرۡتُمۡ","فَسَتُرۡضِعُ","لَهُۥٓ","أُخۡرَىٰ"],"аскинуухунна мин хайсу сакантум мин вуждикум вала тударруухунна литудаййиḳуу `алайхинна ва'ин кунна улати хамлин фа'анфиḳуу `алайхинна хатта йада`на хамлахунна фа'ин арда`на лакум фа'атуухунна ужуурахунна ва'тамируу байнакум бима`рууфин ва'ин та`асартум фасатурди`у лахуу ухра","Поселяйте их там, где вы живете сами - по вашему достатку. Не причиняйте им вреда, желая стеснить их. Если они беременны, то содержите их, пока они не разрешатся от бремени. Если они кормят грудью для вас, то платите им вознаграждение и советуйтесь между собой по-хорошему. Если же вы станете обременять друг друга, то кормить для него будет другая женщина.",["Поселяйте их","там","где","живёте вы","по","вашему достатку","и не","притесняйте их","чтобы стеснить","их","И если","будут они","обладательницами","бремени","то расходуйте","на них","пока","разрешатся они","их бременем","А если","кормят грудью они","для вас","то давайте им","их плату","и советуйтесь","между собой","по-доброму","А если","затрудните друг друга","то будет кормить","для него","другая"]],[65,7,["لِيُنفِقۡ","ذُو","سَعَةٖ","مِّن","سَعَتِهِۦۖ","وَمَن","قُدِرَ","عَلَيۡهِ","رِزۡقُهُۥ","فَلۡيُنفِقۡ","مِمَّآ","ءَاتَىٰهُ","ٱللَّهُۚ","لَا","يُكَلِّفُ","ٱللَّهُ","نَفۡسًا","إِلَّا","مَآ","ءَاتَىٰهَاۚ","سَيَجۡعَلُ","ٱللَّهُ","بَعۡدَ","عُسۡرٖ","يُسۡرٗا"],"лийунфиḳ зуу са`атим мин са`атихии ваман ḳудира `алайхи ризḳухуу фалйунфиḳ мимма атахуллаху ла йукаллифуллаху нафсан илла ма атаха сайаж`алуллаху ба`да `усрин йусра","Пусть обладающий достатком расходует согласно своему достатку. А тот, кто стеснен в средствах, пусть расходует из того, чем его одарил Аллах. Аллах не возлагает на человека сверх того, что Он даровал ему. После тяготы Аллах создает облегчение.",["Пусть расходует","обладатель","достатка","из","своего достатка","А тот, кто","ограничен","ему","его удел","пусть расходует","из того, что","дал ему","Аллах","Не","обременяет","Аллах","душу","кроме как","тем, что","Он дал ей","Сотворит","Аллах","после","тягости","лёгкость"]],[65,8,["وَكَأَيِّن","مِّن","قَرۡيَةٍ","عَتَتۡ","عَنۡ","أَمۡرِ","رَبِّهَا","وَرُسُلِهِۦ","فَحَاسَبۡنَٰهَا","حِسَابٗا","شَدِيدٗا","وَعَذَّبۡنَٰهَا","عَذَابٗا","نُّكۡرٗا"],"вакааййим мин ḳарйатин `атат `ан амри раббиха варусулихии фахасабнаха хисабан шадиидан ва`аззабнаха `азабан нукра","Сколько городов ослушались повелений своего Господа и Его посланников! Мы представили им суровый счет и подвергли их ужасным мучениям.",["И сколько","из","селений","ослушалось","против","повеления","своего Господа","и Его посланников","и Мы рассчитали его","расчётом","суровым","и Мы наказали его","наказанием","ужасным"]],[65,9,["فَذَاقَتۡ","وَبَالَ","أَمۡرِهَا","وَكَانَ","عَٰقِبَةُ","أَمۡرِهَا","خُسۡرًا"],"фазаḳат вабала амриха вакана `аḳибату амриха хусра","Они вкусили пагубные последствия своих деяний, и исходом их деяний стал убыток.",["и вкусило оно","пагубность","своего дела","и был","исход","его дела","убыток"]],[65,10,["أَعَدَّ","ٱللَّهُ","لَهُمۡ","عَذَابٗا","شَدِيدٗاۖ","فَٱتَّقُواْ","ٱللَّهَ","يَٰٓأُوْلِي","ٱلۡأَلۡبَٰبِ","ٱلَّذِينَ","ءَامَنُواْۚ","قَدۡ","أَنزَلَ","ٱللَّهُ","إِلَيۡكُمۡ","ذِكۡرٗا"],"а`аддаллаху лахум `азабан шадиидан фаттаḳуллаха йа'улил албабил лазиина амануу ḳад анзалаллаху илайкум зикра","Аллах приготовил для них тяжкие мучения. Бойтесь же Аллаха, о обладающие разумом, которые уверовали. Аллах уже ниспослал вам напоминание -",["Приготовил","Аллах","для них","наказание","суровое","Бойтесь же","Аллаха","о обладатели","разума","те, которые","уверовали","Уже","ниспослал","Аллах","вам","напоминание"]],[65,11,["رَّسُولٗا","يَتۡلُواْ","عَلَيۡكُمۡ","ءَايَٰتِ","ٱللَّهِ","مُبَيِّنَٰتٖ","لِّيُخۡرِجَ","ٱلَّذِينَ","ءَامَنُواْ","وَعَمِلُواْ","ٱلصَّٰلِحَٰتِ","مِنَ","ٱلظُّلُمَٰتِ","إِلَى","ٱلنُّورِۚ","وَمَن","يُؤۡمِنۢ","بِٱللَّهِ","وَيَعۡمَلۡ","صَٰلِحٗا","يُدۡخِلۡهُ","جَنَّٰتٖ","تَجۡرِي","مِن","تَحۡتِهَا","ٱلۡأَنۡهَٰرُ","خَٰلِدِينَ","فِيهَآ","أَبَدٗاۖ","قَدۡ","أَحۡسَنَ","ٱللَّهُ","لَهُۥ","رِزۡقًا"],"ррасуулан йатлуу `алайкум айатиллахи мубаййинатил лийухрижал лазиина амануу ва`амилус салихати миназ зулумати илан нуури ваман йу'мим биллахи вайа`мал салихан йудхилху жаннатин тажрии мин тахтихал анхару халидиина фииха абадан ḳад ахсаналлаху лахуу ризḳа","Посланника, который читает вам ясные аяты Аллаха, чтобы вывести тех, которые уверовали и совершали праведные деяния, из мраков к свету. Тех, которые уверовали в Аллаха и поступали праведно, Аллах введет в Райские сады, в которых текут реки. Они пребудут там вечно. Аллах уже сделал их удел прекрасным!",["Посланника","читающего","вам","аяты","Аллаха","ясные","чтобы вывести","тех, которые","уверовали","и совершали","праведные деяния","из","мраков","к","свету","И кто","уверует","в Аллаха","и совершает","праведное","Он введёт его","в сады","текут","из","под ними","реки","вечно пребывая","в них","навечно","Уже","сделал прекрасным","Аллах","ему","удел"]],[65,12,["ٱللَّهُ","ٱلَّذِي","خَلَقَ","سَبۡعَ","سَمَٰوَٰتٖ","وَمِنَ","ٱلۡأَرۡضِ","مِثۡلَهُنَّۖ","يَتَنَزَّلُ","ٱلۡأَمۡرُ","بَيۡنَهُنَّ","لِتَعۡلَمُوٓاْ","أَنَّ","ٱللَّهَ","عَلَىٰ","كُلِّ","شَيۡءٖ","قَدِيرٞ","وَأَنَّ","ٱللَّهَ","قَدۡ","أَحَاطَ","بِكُلِّ","شَيۡءٍ","عِلۡمَۢا"],"аллахул лазии халаḳа саб`а самаватин ваминал арди мислахунна йатаназзалул амру байнахунна лита`ламуу анналлаха `ала кулли шай'ин ḳадиирун ва'анналлаха ḳад ахата бикулли шай'ин `илма","Аллах - Тот, Кто сотворил семь небес и столько же земель. Повеление нисходит между ними, чтобы вы знали, что Аллах способен на всякую вещь и что Аллах объемлет знанием всякую вещь.",["Аллах","Тот, Который","сотворил","семь","небес","и из","земли","подобное им","Нисходит","повеление","между ними","чтобы вы знали","что","Аллах","над","всякой","вещью","Всемогущ","и что","Аллах","уже","объял","всякую","вещь","знанием"]]],"m":[[["أَسۡكِنُوهُنَّ","Поселяйте их",65,6],["مِنۡ","там",65,6],["حَيۡثُ","где",65,6],["سَكَنتُم","живёте вы",65,6],["مِّن","по",65,6],["وُجۡدِكُمۡ","вашему достатку",65,6],["وَلَا","и не",65,6],["تُضَآرُّوهُنَّ","притесняйте их",65,6],["لِتُضَيِّقُواْ","чтобы стеснить",65,6]],[["عَلَيۡهِنَّۚ","их",65,6],["وَإِن","И если",65,6],["كُنَّ","будут они",65,6],["أُوْلَٰتِ","обладательницами",65,6],["حَمۡلٖ","бремени",65,6],["فَأَنفِقُواْ","то расходуйте",65,6],["عَلَيۡهِنَّ","на них",65,6],["حَتَّىٰ","пока",65,6],["يَضَعۡنَ","разрешатся они",65,6],["حَمۡلَهُنَّۚ","их бременем",65,6]],[["فَإِنۡ","А если",65,6],["أَرۡضَعۡنَ","кормят грудью они",65,6],["لَكُمۡ","для вас",65,6],["فَـَٔاتُوهُنَّ","то давайте им",65,6],["أُجُورَهُنَّ","их плату",65,6],["وَأۡتَمِرُواْ","и советуйтесь",65,6],["بَيۡنَكُم","между собой",65,6],["بِمَعۡرُوفٖۖ","по-доброму",65,6],["وَإِن","А если",65,6]],[["تَعَاسَرۡتُمۡ","затрудните друг друга",65,6],["فَسَتُرۡضِعُ","то будет кормить",65,6],["لَهُۥٓ","для него",65,6],["أُخۡرَىٰ","другая",65,6],[6],["لِيُنفِقۡ","Пусть расходует",65,7],["ذُو","обладатель",65,7],["سَعَةٖ","достатка",65,7],["مِّن","из",65,7],["سَعَتِهِۦۖ","своего достатка",65,7]],[["وَمَن","А тот, кто",65,7],["قُدِرَ","ограничен",65,7],["عَلَيۡهِ","ему",65,7],["رِزۡقُهُۥ","его удел",65,7],["فَلۡيُنفِقۡ","пусть расходует",65,7],["مِمَّآ","из того, что",65,7],["ءَاتَىٰهُ","дал ему",65,7],["ٱللَّهُۚ","Аллах",65,7],["لَا","Не",65,7],["يُكَلِّفُ","обременяет",65,7],["ٱللَّهُ","Аллах",65,7],["نَفۡسًا","душу",65,7]],[["إِلَّا","кроме как",65,7],["مَآ","тем, что",65,7],["ءَاتَىٰهَاۚ","Он дал ей",65,7],["سَيَجۡعَلُ","Сотворит",65,7],["ٱللَّهُ","Аллах",65,7],["بَعۡدَ","после",65,7],["عُسۡرٖ","тягости",65,7],["يُسۡرٗا","лёгкость",65,7],[7],["وَكَأَيِّن","И сколько",65,8],["مِّن","из",65,8],["قَرۡيَةٍ","селений",65,8]],[["عَتَتۡ","ослушалось",65,8],["عَنۡ","против",65