{"p":560,"j":28,"a":[[66,1,["يَٰٓأَيُّهَا","ٱلنَّبِيُّ","لِمَ","تُحَرِّمُ","مَآ","أَحَلَّ","ٱللَّهُ","لَكَۖ","تَبۡتَغِي","مَرۡضَاتَ","أَزۡوَٰجِكَۚ","وَٱللَّهُ","غَفُورٞ","رَّحِيمٞ"],"йа'аййухан набиййу лима тухарриму ма ахаллаллаху лака табтагии мардата азважика валлаху гафуурур рахиим","О Пророк! Почему ты запрещаешь себе то, что позволил тебе Аллах, стремясь угодить своим женам? Аллах - Прощающий, Милосердный.",["О","Пророк","Почему","запрещаешь ты","то, что","дозволил","Аллах","тебе","стремясь к","угождению","твоих жён","И Аллах","Прощающий","Милосердный"]],[66,2,["قَدۡ","فَرَضَ","ٱللَّهُ","لَكُمۡ","تَحِلَّةَ","أَيۡمَٰنِكُمۡۚ","وَٱللَّهُ","مَوۡلَىٰكُمۡۖ","وَهُوَ","ٱلۡعَلِيمُ","ٱلۡحَكِيمُ"],"ḳад фарадаллаху лакум тахиллата айманикум валлаху маулакум вахуал `алиимул хакиим","Аллах установил для вас путь освобождения от ваших клятв. Аллах - ваш Покровитель. Он - Знающий, Мудрый.",["Уже","установил","Аллах","вам","освобождение","от ваших клятв","И Аллах","ваш Покровитель","и Он","Знающий","Мудрый"]],[66,3,["وَإِذۡ","أَسَرَّ","ٱلنَّبِيُّ","إِلَىٰ","بَعۡضِ","أَزۡوَٰجِهِۦ","حَدِيثٗا","فَلَمَّا","نَبَّأَتۡ","بِهِۦ","وَأَظۡهَرَهُ","ٱللَّهُ","عَلَيۡهِ","عَرَّفَ","بَعۡضَهُۥ","وَأَعۡرَضَ","عَنۢ","بَعۡضٖۖ","فَلَمَّا","نَبَّأَهَا","بِهِۦ","قَالَتۡ","مَنۡ","أَنۢبَأَكَ","هَٰذَاۖ","قَالَ","نَبَّأَنِيَ","ٱلۡعَلِيمُ","ٱلۡخَبِيرُ"],"ва'из асарран набиййу ила ба`ди азважихии хадиисан фаламма наббаат бихии ва'азхарахуллаху `алайхи `аррафа ба`дахуу ва'а`рада `ам ба`дин фаламма наббааха бихии ḳалат ман амбаака хаза ḳала наббаанийал `алиимул хабиир","Вот Пророк открыл тайну одной из своих жен. Когда же она рассказала ее, и Аллах открыл это ему, он дал знать о части этого и утаил другую часть. Она сказала: «Кто сообщил тебе об этом?». Он сказал: «Мне сообщил Знающий, Ведающий».",["И вот","тайно сообщил","Пророк","к","одной из","своих жён","рассказ","И когда","сообщила она","о нём","и открыл это","Аллах","ему","он дал знать","часть этого","и уклонился","от","части","И когда","сообщил он ей","о нём","сказала она","Кто","сообщил тебе","это","Сказал он","Сообщил мне","Знающий","Ведающий"]],[66,4,["إِن","تَتُوبَآ","إِلَى","ٱللَّهِ","فَقَدۡ","صَغَتۡ","قُلُوبُكُمَاۖ","وَإِن","تَظَٰهَرَا","عَلَيۡهِ","فَإِنَّ","ٱللَّهَ","هُوَ","مَوۡلَىٰهُ","وَجِبۡرِيلُ","وَصَٰلِحُ","ٱلۡمُؤۡمِنِينَۖ","وَٱلۡمَلَٰٓئِكَةُ","بَعۡدَ","ذَٰلِكَ","ظَهِيرٌ"],"ин татууба илаллахи фаḳад сагат ḳулуубукума ва'ин тазахара `алайхи фа'инналлаха хуа маулаху важибриилу васалихул му'миниина валмалаикату ба`да залика захиир","Если вы обе покаетесь перед Аллахом, то ведь ваши сердца уже уклонились в сторону. Если же вы станете поддерживать друг друга против него, то ведь ему покровительствует Аллах, а Джибрил (Гавриил) и праведные верующие являются его друзьями. А, кроме того, ангелы помогают ему.",["Если","покаетесь вы обе","перед","Аллахом","то ведь уже","уклонились","ваши сердца","А если","поддержите друг друга","против него","то поистине","Аллах","Он","его Покровитель","и Джибрил","и праведные","из верующих","и ангелы","после","этого","помощники"]],[66,5,["عَسَىٰ","رَبُّهُۥٓ","إِن","طَلَّقَكُنَّ","أَن","يُبۡدِلَهُۥٓ","أَزۡوَٰجًا","خَيۡرٗا","مِّنكُنَّ","مُسۡلِمَٰتٖ","مُّؤۡمِنَٰتٖ","قَٰنِتَٰتٖ","تَٰٓئِبَٰتٍ","عَٰبِدَٰتٖ","سَٰٓئِحَٰتٖ","ثَيِّبَٰتٖ","وَأَبۡكَارٗا"],"`аса раббухуу ин таллаḳакунна ан йубдилахуу азважан хайрам минкунна муслиматим му'минатин ḳанитатин та'ибатин `абидатин са'ихатин саййибатин ва'абкара","Если он разведется с вами, то его Господь может заменить вас женами, которые будут лучше вас, и будут мусульманками, верующими, покорными, кающимися, поклоняющимися, постящимися, как побывавшими замужем, так и девственницами.",["Возможно","его Господь","если","он разведётся с вами","что","Он заменит ему","жёнами","лучшими","чем вы","мусульманками","верующими","покорными","кающимися","поклоняющимися","постящимися","бывшими замужем","и девственницами"]],[66,6,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُواْ","قُوٓاْ","أَنفُسَكُمۡ","وَأَهۡلِيكُمۡ","نَارٗا","وَقُودُهَا","ٱلنَّاسُ","وَٱلۡحِجَارَةُ","عَلَيۡهَا","مَلَٰٓئِكَةٌ","غِلَاظٞ","شِدَادٞ","لَّا","يَعۡصُونَ","ٱللَّهَ","مَآ","أَمَرَهُمۡ","وَيَفۡعَلُونَ","مَا","يُؤۡمَرُونَ"],"йа'аййухал лазиина амануу ḳуу анфусакум ва'ахлиикум наран ваḳуудухан насу валхижарату `алайха малаикатун гилазун шидадул ла йа`сууналлаха ма амарахум вайаф`алууна ма йу'маруун","О те, которые уверовали! Оберегайте себя и свои семьи от Огня, растопкой которого будут люди и камни. Над ним есть ангелы суровые и сильные. Они не отступают от повелений Аллаха и выполняют все, что им велено.",["О","те, которые","уверовали","Оберегайте","себя","и ваши семьи","от огня","растопка которого","люди","и камни","над ним","ангелы","грубые","суровые","не","ослушаются они","Аллаха","в том, что","Он повелел им","и делают","то, что","им велено"]],[66,7,["يَٰٓأَيُّهَا","ٱلَّذِينَ","كَفَرُواْ","لَا","تَعۡتَذِرُواْ","ٱلۡيَوۡمَۖ","إِنَّمَا","تُجۡزَوۡنَ","مَا","كُنتُمۡ","تَعۡمَلُونَ"],"йа'аййухал лазиина кафаруу ла та`тазирул йаума иннама тужзауна ма кунтум та`малуун","О те, которые не уверовали! Не оправдывайтесь сегодня. Вам воздают только за то, что вы совершали.",["О","те, которые","не уверовали","не","оправдывайтесь","сегодня","лишь","воздаётся вам","за то, что","вы были","совершаете"]]],"m":[["h",66],["b"],[["يَٰٓأَيُّهَا","О",66,1],["ٱلنَّبِيُّ","Пророк",66,1],["لِمَ","Почему",66,1],["تُحَرِّمُ","запрещаешь ты",66,1],["مَآ","то, что",66,1],["أَحَلَّ","дозволил",66,1],["ٱللَّهُ","Аллах",66,1],["لَكَۖ","тебе",66,1],["تَبۡتَغِي","стремясь к",66,1],["مَرۡضَاتَ","угождению",66,1],["أَزۡوَٰجِكَۚ","твоих жён",66,1],["وَٱللَّهُ","И Аллах",66,1]],[["غَفُورٞ","Прощающий",66,1],["رَّحِيمٞ","Милосердный",66,1],[1],["قَدۡ","Уже",66,2],["فَرَضَ","установил",66,2],["ٱللَّهُ","Аллах",66,2],["لَكُمۡ","вам",66,2],["تَحِلَّةَ","освобождение",66,2],["أَيۡمَٰنِكُمۡۚ","от ваших клятв",66,2],["وَٱللَّهُ","И Аллах",66,2],["مَوۡلَىٰكُمۡۖ","ваш Покровитель",66,2]],[["وَهُوَ","и Он",66,2],["ٱلۡعَلِيمُ","Знающий",66,2],["ٱلۡحَكِيمُ","Мудрый",66,2],[2],["وَإِذۡ","И вот",66,3],["أَسَرَّ","тайно сообщил",66,3],["ٱلنَّبِيُّ","Пророк",66,3],["إِلَىٰ","к",66,3],["بَعۡضِ","одной из",66,3],["أَزۡوَٰجِهِۦ","своих жён",66,3],["حَدِيثٗا","рассказ",66,3]],[["فَلَمَّا","И когда",66,3],["نَبَّأَتۡ","сообщила она",66,3],["بِهِۦ","о нём",66,3],["وَأَظۡهَرَهُ","и открыл это",66,3],["ٱللَّهُ","Аллах",66,3],["عَلَيۡهِ","ему",66,3],["عَرَّفَ","он дал знать",66,3],["بَعۡضَهُۥ","часть этого",66,3],["وَأَعۡرَضَ","и уклонился",66,3],["عَنۢ","от",66,3],["بَعۡضٖۖ","части",66,3]],[["فَلَمَّا","И когда",66,3],["نَبَّأَهَا","сообщил он ей",66,3],["بِهِۦ","о нём",66,3],["قَالَتۡ","сказала она",66,3],["مَنۡ","Кто",66,3],["أَنۢبَأَكَ","сообщил тебе",66,3],["هَٰذَاۖ","это",66,3],["قَالَ","Сказал он",66,3],["نَبَّأَنِيَ","Сообщил мне",66,3],["ٱلۡعَلِيمُ","Знающий",66,3],["ٱلۡخَبِيرُ","Ведающий",66,3]],[[3],["إِن","Если",66,4],["تَتُوبَآ","покаетесь вы обе",66,4],["إِلَى","перед",66,4],["ٱللَّهِ","Аллахом",66,4],["فَقَدۡ","то ведь уже",66,4],["صَغَتۡ","уклонились",66,4],["قُلُوبُكُمَاۖ","ваши сердца",66,4],["وَإِن","А если",66,4],["تَظَٰهَرَا","поддержите друг друга",66,4],["عَلَيۡهِ","против него",66,4]],[["فَإِنَّ","то поистине",66,4],["ٱللَّهَ","Аллах",66,4],["هُوَ","Он",66,4],["مَوۡلَىٰهُ","его Покровитель",66,4],["وَجِبۡرِيلُ","и Джибрил",66,4],["وَصَٰلِحُ","и праведные",66,4],["ٱلۡمُؤۡمِنِينَۖ","из верующих",66,4],["وَٱلۡمَلَٰٓئِكَةُ","и ангелы",66,4]],[["بَعۡدَ","после",66,4],["ذَٰلِكَ","этого",66,4],["ظَهِيرٌ","помощники",66,4],[4],["عَسَىٰ","Возможно",66,5],["رَبُّهُۥٓ","его Господь",66,5],["إِن","если",66,5],["طَلَّقَكُنَّ","он разведётся с вами",66,5],["أَن","что",66,5],["يُبۡدِلَهُۥٓ","Он заменит ему",66,5],["أَزۡوَٰجًا","жёнами",66,5]],[["خَيۡرٗا","лучшими",66,5],["مِّنكُنَّ","чем вы",66,5],["مُسۡلِمَٰتٖ","мусульманками",66,5],["مُّؤۡمِنَٰتٖ","верующими",66,5],["قَٰنِتَٰتٖ","покорными",66,5],["تَٰٓئِبَٰتٍ","кающимися",66,5],["عَٰبِدَٰتٖ","поклоняющимися",66,5],["سَٰٓئِحَٰتٖ","постящимися",66,5]],[["ثَيِّبَٰتٖ","бывшими замужем",66,5],["وَأَبۡكَارٗا","и девс