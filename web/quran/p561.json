{"p":561,"j":28,"a":[[66,8,["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُواْ","تُوبُوٓاْ","إِلَى","ٱللَّهِ","تَوۡبَةٗ","نَّصُوحًا","عَسَىٰ","رَبُّكُمۡ","أَن","يُكَفِّرَ","عَنكُمۡ","سَيِّـَٔاتِكُمۡ","وَيُدۡخِلَكُمۡ","جَنَّٰتٖ","تَجۡرِي","مِن","تَحۡتِهَا","ٱلۡأَنۡهَٰرُ","يَوۡمَ","لَا","يُخۡزِي","ٱللَّهُ","ٱلنَّبِيَّ","وَٱلَّذِينَ","ءَامَنُواْ","مَعَهُۥۖ","نُورُهُمۡ","يَسۡعَىٰ","بَيۡنَ","أَيۡدِيهِمۡ","وَبِأَيۡمَٰنِهِمۡ","يَقُولُونَ","رَبَّنَآ","أَتۡمِمۡ","لَنَا","نُورَنَا","وَٱغۡفِرۡ","لَنَآۖ","إِنَّكَ","عَلَىٰ","كُلِّ","شَيۡءٖ","قَدِيرٞ"],"йа'аййухал лазиина амануу туубуу илаллахи таубатан насуухан `аса раббукум ан йукаффира `анкум саййиатикум вайудхилакум жаннатин тажрии мин тахтихал анхару йаума ла йухзиллахун набиййа валлазиина амануу ма`ахуу нуурухум йас`а байна айдиихим вабиайманихим йаḳуулууна раббана атмим лана нуурана вагфир лана иннака `ала кулли шай'ин ḳадиир","О те, которые уверовали! Раскаивайтесь перед Аллахом искренне! Может быть, ваш Господь простит ваши злодеяния и введет вас в Райские сады, в которых текут реки, в тот день, когда Аллах не опозорит Пророка и тех, кто уверовал вместе с ним. Их свет будет сиять перед ними и справа. Они скажут: «Господь наш! Дай нам света сполна и прости нас. Воистину, Ты способен на всякую вещь».",["О","те, которые","уверовали","обратитесь с покаянием","к","Аллаху","покаянием","искренним","может быть","ваш Господь","что","загладит","с вас","ваши злодеяния","и введёт вас","в сады","текут","из","под ними","реки","в день, когда","не","опозорит","Аллах","Пророка","и тех, которые","уверовали","с ним","их свет","будет бежать","перед","ними","и справа от них","они скажут","Господь наш","дополни","нам","наш свет","и прости","нам","поистине, Ты","над","всякой","вещью","Всемогущ"]],[66,9,["يَٰٓأَيُّهَا","ٱلنَّبِيُّ","جَٰهِدِ","ٱلۡكُفَّارَ","وَٱلۡمُنَٰفِقِينَ","وَٱغۡلُظۡ","عَلَيۡهِمۡۚ","وَمَأۡوَىٰهُمۡ","جَهَنَّمُۖ","وَبِئۡسَ","ٱلۡمَصِيرُ"],"йа'аййухан набиййу жахидил куффара валмунафиḳиина ваглуз `алайхим вама'вахум жаханнаму ваби'сал масиир","О Пророк! Сражайся с неверующими и лицемерами и будь суров с ними. Их пристанищем будет Геенна. Как же скверно это место прибытия!",["О","Пророк","сражайся","с неверующими","и лицемерами","и будь суров","с ними","и их пристанище","Геенна","и скверно","место прибытия"]],[66,10,["ضَرَبَ","ٱللَّهُ","مَثَلٗا","لِّلَّذِينَ","كَفَرُواْ","ٱمۡرَأَتَ","نُوحٖ","وَٱمۡرَأَتَ","لُوطٖۖ","كَانَتَا","تَحۡتَ","عَبۡدَيۡنِ","مِنۡ","عِبَادِنَا","صَٰلِحَيۡنِ","فَخَانَتَاهُمَا","فَلَمۡ","يُغۡنِيَا","عَنۡهُمَا","مِنَ","ٱللَّهِ","شَيۡـٔٗا","وَقِيلَ","ٱدۡخُلَا","ٱلنَّارَ","مَعَ","ٱلدَّٰخِلِينَ"],"дарабаллаху масалал лиллазиина кафарумраата нуухин вамраата луутин каната тахта `абдайни мин `ибадина салихайни фаханатахума фалам йугнийа `анхума миналлахи шай'ан ваḳииладхулан нара ма`ад дахилиин","Аллах привел в качестве примера о неверующих жену Нуха (Ноя) и жену Лута (Лота). Обе были замужем за рабами из числа Наших праведных рабов. Они предали своих мужей, и те не спасли их от Аллаха. Им было сказано: «Войдите в Огонь вместе с теми, кто входит туда».",["привёл","Аллах","пример","для тех, которые","не уверовали","жену","Нуха","и жену","Лута","они обе были","под","двумя рабами","из","Наших рабов","праведных","и обе предали их","и не","помогли они","им обеим","от","Аллаха","ничем","и сказано было","войдите обе","в Огонь","с","входящими"]],[66,11,["وَضَرَبَ","ٱللَّهُ","مَثَلٗا","لِّلَّذِينَ","ءَامَنُواْ","ٱمۡرَأَتَ","فِرۡعَوۡنَ","إِذۡ","قَالَتۡ","رَبِّ","ٱبۡنِ","لِي","عِندَكَ","بَيۡتٗا","فِي","ٱلۡجَنَّةِ","وَنَجِّنِي","مِن","فِرۡعَوۡنَ","وَعَمَلِهِۦ","وَنَجِّنِي","مِنَ","ٱلۡقَوۡمِ","ٱلظَّٰلِمِينَ"],"вадарабаллаху масалал лиллазиина аманумраата фир`ауна из ḳалат раббибни лии `индака байтан фил жаннати ванажжинии мин фир`ауна ва`амалихии ванажжинии минал ḳаумиз залимиин","А в качестве примера о верующих Аллах привел жену Фараона. Вот она сказала: «Господи! Спаси меня от Фараона и его деяний! Возведи для меня дом в Раю возле Тебя и спаси меня от несправедливых людей!».",["и привёл","Аллах","пример","для тех, которые","уверовали","жену","Фараона","вот","сказала она","Господи","построй","для меня","у Тебя","дом","в","Раю","и спаси меня","от","Фараона","и его деяний","и спаси меня","от","людей","несправедливых"]],[66,12,["وَمَرۡيَمَ","ٱبۡنَتَ","عِمۡرَٰنَ","ٱلَّتِيٓ","أَحۡصَنَتۡ","فَرۡجَهَا","فَنَفَخۡنَا","فِيهِ","مِن","رُّوحِنَا","وَصَدَّقَتۡ","بِكَلِمَٰتِ","رَبِّهَا","وَكُتُبِهِۦ","وَكَانَتۡ","مِنَ","ٱلۡقَٰنِتِينَ"],"вамарйамабната `имранал латии ахсанат фаржаха фанафахна фиихи мир руухина васаддаḳат бикалимати раббиха вакутубихии ваканат минал ḳанитиин","А также Марьям (Марию), дочь Имрана, которая сберегла целомудрие, и Мы вдохнули в него (в вырез на ее одежде) от Нашего духа. Она уверовала в Слова своего Господа и Его Писания и была одной из покорных.",["и Марьям","дочь","Имрана","которая","оберегла","своё целомудрие","и Мы вдохнули","в него","от","Нашего духа","и она признала истинными","Слова","своего Господа","и Его Писания","и была она","из","покорных"]]],"m":[[["يَٰٓأَيُّهَا","О",66,8],["ٱلَّذِينَ","те, которые",66,8],["ءَامَنُواْ","уверовали",66,8],["تُوبُوٓاْ","обратитесь с покаянием",66,8],["إِلَى","к",66,8],["ٱللَّهِ","Аллаху",66,8],["تَوۡبَةٗ","покаянием",66,8],["نَّصُوحًا","искренним",66,8],["عَسَىٰ","может быть",66,8],["رَبُّكُمۡ","ваш Господь",66,8]],[["أَن","что",66,8],["يُكَفِّرَ","загладит",66,8],["عَنكُمۡ","с вас",66,8],["سَيِّـَٔاتِكُمۡ","ваши злодеяния",66,8],["وَيُدۡخِلَكُمۡ","и введёт вас",66,8],["جَنَّٰتٖ","в сады",66,8],["تَجۡرِي","текут",66,8]],[["مِن","из",66,8],["تَحۡتِهَا","под ними",66,8],["ٱلۡأَنۡهَٰرُ","реки",66,8],["يَوۡمَ","в день, когда",66,8],["لَا","не",66,8],["يُخۡزِي","опозорит",66,8],["ٱللَّهُ","Аллах",66,8],["ٱلنَّبِيَّ","Пророка",66,8],["وَٱلَّذِينَ","и тех, которые",66,8],["ءَامَنُواْ","уверовали",66,8]],[["مَعَهُۥۖ","с ним",66,8],["نُورُهُمۡ","их свет",66,8],["يَسۡعَىٰ","будет бежать",66,8],["بَيۡنَ","перед",66,8],["أَيۡدِيهِمۡ","ними",66,8],["وَبِأَيۡمَٰنِهِمۡ","и справа от них",66,8],["يَقُولُونَ","они скажут",66,8],["رَبَّنَآ","Господь наш",66,8]],[["أَتۡمِمۡ","дополни",66,8],["لَنَا","нам",66,8],["نُورَنَا","наш свет",66,8],["وَٱغۡفِرۡ","и прости",66,8],["لَنَآۖ","нам",66,8],["إِنَّكَ","поистине, Ты",66,8],["عَلَىٰ","над",66,8],["كُلِّ","всякой",66,8],["شَيۡءٖ","вещью",66,8],["قَدِيرٞ","Всемогущ",66,8],[8]],[["يَٰٓأَيُّهَا","О",66,9],["ٱلنَّبِيُّ","Пророк",66,9],["جَٰهِدِ","сражайся",66,9],["ٱلۡكُفَّارَ","с неверующими",66,9],["وَٱلۡمُنَٰفِقِينَ","и лицемерами",66,9],["وَٱغۡلُظۡ","и будь суров",66,9],["عَلَيۡهِمۡۚ","с ними",66,9]],[["وَمَأۡوَىٰهُمۡ","и их пристанище",66,9],["جَهَنَّمُۖ","Геенна",66,9],["وَبِئۡسَ","и скверно",66,9],["ٱلۡمَصِيرُ","место прибытия",66,9],[9],["ضَرَبَ","привёл",66,10],["ٱللَّهُ","Аллах",66,10],["مَثَلٗا","пример",66,10]],[["لِّلَّذِينَ","для тех, которые",66,10],["كَفَرُواْ","не уверовали",66,10],["ٱمۡرَأَتَ","жену",66,10],["نُوحٖ","Нуха",66,10],["وَٱمۡرَأَتَ","и жену",66,10],["لُوطٖۖ","Лута",66,10],["كَانَتَا","они обе были",66,10],["تَحۡتَ","под",66,10]],[["عَبۡدَيۡنِ","двумя рабами",66,10],["مِنۡ","из",66,10],["عِبَادِنَا","Наших рабов",66,10],["صَٰلِحَيۡنِ","праведных",66,10],["فَخَانَتَاهُمَا","и обе предали их",66,10],["فَلَمۡ","и не",66,10],["يُغۡنِيَا","помогли они",66,10],["عَنۡهُمَا","им обеим",66,10]],[["مِنَ","от",66,10],["ٱللَّهِ","Аллаха",66,10],["شَيۡـٔٗا","ничем",66,10],["وَقِيلَ","и сказано было",66,10],["ٱدۡخُلَا","войдите обе",66,10],["ٱلنَّارَ","в Огонь",66,10],["مَعَ","с",66,10],["ٱلدَّٰخِلِينَ","входящими",66,10],[10]],[["وَضَرَبَ","и привёл",66,11],["ٱللَّهُ","Аллах",66,11],["مَثَلٗا","пример",66,11],["لِّلَّذِينَ","для тех, которые",66,11],["ءَامَنُواْ","уверовали",66,11],["ٱمۡرَأَتَ","жену",66,11],["فِرۡعَوۡنَ","Фараона",66,11],["إِذۡ","вот",66,11]],[["قَالَتۡ","сказала она",66,11],["رَبِّ","Господи",66,11],["ٱبۡنِ","построй",66,11],["لِي","для меня",66,11],["عِندَكَ","у Тебя",66,11],["بَيۡتٗا","дом",66,11],["فِي","в",66,11],["ٱلۡجَنَّةِ","Раю",66,11],["وَنَجِّنِي","и спаси меня",66,11],["مِن","от",66,11],["فِرۡعَو