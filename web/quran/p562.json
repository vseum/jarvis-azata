{"p":562,"j":29,"a":[[67,1,["تَبَٰرَكَ","ٱلَّذِي","بِيَدِهِ","ٱلۡمُلۡكُ","وَهُوَ","عَلَىٰ","كُلِّ","شَيۡءٖ","قَدِيرٌ"],"табаракал лазии бийадихил мулку вахуа `ала кулли шай'ин ḳадиир","Благословен Тот, в Чьей Руке власть, Кто способен на всякую вещь,",["благословен","Тот, Который","в Чьей Руке","власть","и Он","на","всякую","вещь","способен"]],[67,2,["ٱلَّذِي","خَلَقَ","ٱلۡمَوۡتَ","وَٱلۡحَيَوٰةَ","لِيَبۡلُوَكُمۡ","أَيُّكُمۡ","أَحۡسَنُ","عَمَلٗاۚ","وَهُوَ","ٱلۡعَزِيزُ","ٱلۡغَفُورُ"],"аллазии халаḳал маута валхайавата лийаблуакум аййукум ахсану `амалан вахуал `азиизул гафуур","Кто сотворил смерть и жизнь, чтобы испытать вас и увидеть, чьи деяния окажутся лучше. Он - Могущественный, Прощающий.",["Тот, Который","сотворил","смерть","и жизнь","чтобы испытать вас","кто из вас","лучше","деянием","и Он","Могущественный","Прощающий"]],[67,3,["ٱلَّذِي","خَلَقَ","سَبۡعَ","سَمَٰوَٰتٖ","طِبَاقٗاۖ","مَّا","تَرَىٰ","فِي","خَلۡقِ","ٱلرَّحۡمَٰنِ","مِن","تَفَٰوُتٖۖ","فَٱرۡجِعِ","ٱلۡبَصَرَ","هَلۡ","تَرَىٰ","مِن","فُطُورٖ"],"аллазии халаḳа саб`а самаватин тибаḳам ма тара фии халḳир рахмани мин тафавутин фаржи`ил басара хал тара мин футуур","Он создал семь небес одно над другим. В творении Милостивого ты не увидишь никакой несообразности. Взгляни еще раз. Видишь ли ты какую-нибудь трещину?",["Тот, Который","сотворил","семь","небес","ярусами","не","увидишь ты","в","творении","Милостивого","никакой","несоразмерности","так верни","взор","разве","видишь ты","какую-либо","трещину"]],[67,4,["ثُمَّ","ٱرۡجِعِ","ٱلۡبَصَرَ","كَرَّتَيۡنِ","يَنقَلِبۡ","إِلَيۡكَ","ٱلۡبَصَرُ","خَاسِئٗا","وَهُوَ","حَسِيرٞ"],"суммаржи`ил басара карратайни йанḳалиб илайкал басару хасиан вахуа хасиир","Потом взгляни еще раз и еще раз, и твой взор вернется к тебе униженным, утомленным.",["затем","верни","взор","дважды","вернётся","к тебе","взор","униженным","и он","утомлён"]],[67,5,["وَلَقَدۡ","زَيَّنَّا","ٱلسَّمَآءَ","ٱلدُّنۡيَا","بِمَصَٰبِيحَ","وَجَعَلۡنَٰهَا","رُجُومٗا","لِّلشَّيَٰطِينِۖ","وَأَعۡتَدۡنَا","لَهُمۡ","عَذَابَ","ٱلسَّعِيرِ"],"валаḳад заййаннас самаад дунйа бимасабииха важа`алнаха ружуумал лишшайатиини ва'а`тадна лахум `азабас са`иир","Воистину, Мы украсили ближайшее небо светильниками и установили их для метания в дьяволов. Мы приготовили для них мучения в Пламени.",["и действительно","украсили Мы","небо","ближнее","светильниками","и сделали Мы их","метательными снарядами","для дьяволов","и приготовили Мы","для них","наказание","Пламени"]],[67,6,["وَلِلَّذِينَ","كَفَرُواْ","بِرَبِّهِمۡ","عَذَابُ","جَهَنَّمَۖ","وَبِئۡسَ","ٱلۡمَصِيرُ"],"валиллазиина кафаруу бираббихим `азабу жаханнама ваби'сал масиир","Для тех, кто не уверовал в своего Господа, приготовлены мучения в Геенне. Как же скверно это место прибытия!",["и для тех, которые","не уверовали","в их Господа","наказание","Геенны","и скверно","место прибытия"]],[67,7,["إِذَآ","أُلۡقُواْ","فِيهَا","سَمِعُواْ","لَهَا","شَهِيقٗا","وَهِيَ","تَفُورُ"],"иза улḳуу фииха сами`уу лаха шахииḳан вахийа тафуур","Когда их бросят туда, они услышат, как она ревет, когда кипит.",["когда","брошены будут они","туда","услышат они","от неё","рёв","а она","кипит"]],[67,8,["تَكَادُ","تَمَيَّزُ","مِنَ","ٱلۡغَيۡظِۖ","كُلَّمَآ","أُلۡقِيَ","فِيهَا","فَوۡجٞ","سَأَلَهُمۡ","خَزَنَتُهَآ","أَلَمۡ","يَأۡتِكُمۡ","نَذِيرٞ"],"такаду тамаййазу минал гайзи куллама улḳийа фииха фаужун са'алахум хазанатуха алам йа'тикум назиир","Она готова разорваться от ярости. Каждый раз, когда туда будут бросать толпу, ее стражи будут спрашивать их: «Разве к вам не приходил предостерегающий увещеватель?».",["почти готова","разорваться","от","ярости","всякий раз, когда","брошена будет","туда","толпа","спросят их","её стражи","разве не","приходил к вам","увещеватель"]],[67,9,["قَالُواْ","بَلَىٰ","قَدۡ","جَآءَنَا","نَذِيرٞ","فَكَذَّبۡنَا","وَقُلۡنَا","مَا","نَزَّلَ","ٱللَّهُ","مِن","شَيۡءٍ","إِنۡ","أَنتُمۡ","إِلَّا","فِي","ضَلَٰلٖ","كَبِيرٖ"],"ḳалуу бала ḳад жаана назиирун факаззабна ваḳулна ма наззалаллаху мин шай'ин ин антум илла фии далалин кабиир","Они скажут: «Конечно, предостерегающий увещеватель приходил к нам, но мы сочли его лжецом и сказали: «Аллах ничего не ниспосылал, а вы лишь пребываете в большом заблуждении»».",["скажут они","да","уже","приходил к нам","увещеватель","но мы сочли лжецом","и сказали мы","не","ниспослал","Аллах","ни","одной вещи","не","вы","лишь","в","заблуждении","великом"]],[67,10,["وَقَالُواْ","لَوۡ","كُنَّا","نَسۡمَعُ","أَوۡ","نَعۡقِلُ","مَا","كُنَّا","فِيٓ","أَصۡحَٰبِ","ٱلسَّعِيرِ"],"ваḳалуу лау кунна насма`у ау на`ḳилу ма кунна фии асхабис са`иир","Они скажут: «Если бы мы прислушивались и были рассудительны, то не оказались бы среди обитателей Пламени».",["и скажут они","если бы","были мы","слушаем","или","разумеем","не","были бы мы","среди","обитателей","Пламени"]],[67,11,["فَٱعۡتَرَفُواْ","بِذَنۢبِهِمۡ","فَسُحۡقٗا","لِّأَصۡحَٰبِ","ٱلسَّعِيرِ"],"фа`тарафуу бизамбихим фасухḳал ли'асхабис са`иир","Они признаются в своем грехе. Прочь же, обитатели Пламени!",["и они признали","свой грех","так прочь","обитателям","Пламени"]],[67,12,["إِنَّ","ٱلَّذِينَ","يَخۡشَوۡنَ","رَبَّهُم","بِٱلۡغَيۡبِ","لَهُم","مَّغۡفِرَةٞ","وَأَجۡرٞ","كَبِيرٞ"],"иннал лазиина йахшауна раббахум билгайби лахум магфиратун ва'ажрун кабиир","Воистину, тем, которые боятся своего Господа, не видя Его воочию, уготованы прощение и великая награда.",["поистине","те, которые","боятся","своего Господа","не видя Его","для них","прощение","и награда","великая"]]],"m":[["h",67],["b"],[["تَبَٰرَكَ","благословен",67,1],["ٱلَّذِي","Тот, Который",67,1],["بِيَدِهِ","в Чьей Руке",67,1],["ٱلۡمُلۡكُ","власть",67,1],["وَهُوَ","и Он",67,1],["عَلَىٰ","на",67,1],["كُلِّ","всякую",67,1],["شَيۡءٖ","вещь",67,1],["قَدِيرٌ","способен",67,1],[1],["ٱلَّذِي","Тот, Который",67,2],["خَلَقَ","сотворил",67,2]],[["ٱلۡمَوۡتَ","смерть",67,2],["وَٱلۡحَيَوٰةَ","и жизнь",67,2],["لِيَبۡلُوَكُمۡ","чтобы испытать вас",67,2],["أَيُّكُمۡ","кто из вас",67,2],["أَحۡسَنُ","лучше",67,2],["عَمَلٗاۚ","деянием",67,2],["وَهُوَ","и Он",67,2],["ٱلۡعَزِيزُ","Могущественный",67,2],["ٱلۡغَف