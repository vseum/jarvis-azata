{"p":563,"j":29,"a":[[67,13,["وَأَسِرُّواْ","قَوۡلَكُمۡ","أَوِ","ٱجۡهَرُواْ","بِهِۦٓۖ","إِنَّهُۥ","عَلِيمُۢ","بِذَاتِ","ٱلصُّدُورِ"],"ва'асирруу ḳаулакум авижхаруу бихии иннахуу `алииму бизатис судуур","Храните ли вы свои речи в секрете или же говорите о них вслух, Он ведает о том, что в груди.",["и скрывайте","вашу речь","или","оглашайте","её","поистине, Он","Знающий","о том, что в","груди"]],[67,14,["أَلَا","يَعۡلَمُ","مَنۡ","خَلَقَ","وَهُوَ","ٱللَّطِيفُ","ٱلۡخَبِيرُ"],"ала йа`ламу ман халаḳа вахуал латиифул хабиир","Неужели этого не будет знать Тот, Кто сотворил, если Он - Проницательный (или Добрый), Ведающий?",["разве не","знает","Тот, Кто","сотворил","и Он","Проницательный","Сведущий"]],[67,15,["هُوَ","ٱلَّذِي","جَعَلَ","لَكُمُ","ٱلۡأَرۡضَ","ذَلُولٗا","فَٱمۡشُواْ","فِي","مَنَاكِبِهَا","وَكُلُواْ","مِن","رِّزۡقِهِۦۖ","وَإِلَيۡهِ","ٱلنُّشُورُ"],"хуал лазии жа`ала лакумул арда залуулан фамшуу фии манакибиха вакулуу мир ризḳихии ва'илайхин нушуур","Он - Тот, Кто сделал для вас землю покорной. Ступайте же по свету и вкушайте из Его удела, и к Нему вы явитесь после воскрешения.",["Он","Тот, Который","сделал","для вас","землю","покорной","так ходите","по","её просторам","и ешьте","из","Его удела","и к Нему","воскрешение"]],[67,16,["ءَأَمِنتُم","مَّن","فِي","ٱلسَّمَآءِ","أَن","يَخۡسِفَ","بِكُمُ","ٱلۡأَرۡضَ","فَإِذَا","هِيَ","تَمُورُ"],"а'аминтум ман фис самаи ан йахсифа бикумул арда фа'иза хийа тамуур","Неужели вы уверены, что Тот, Кто на небе, не заставит землю поглотить вас? Ведь тогда она заколеблется.",["разве уверены вы","в Том, Кто","на","небе","что не","заставит поглотить","вас","землю","и вот","она","колеблется"]],[67,17,["أَمۡ","أَمِنتُم","مَّن","فِي","ٱلسَّمَآءِ","أَن","يُرۡسِلَ","عَلَيۡكُمۡ","حَاصِبٗاۖ","فَسَتَعۡلَمُونَ","كَيۡفَ","نَذِيرِ"],"ам аминтум ман фис самаи ан йурсила `алайкум хасибан фасата`ламууна кайфа назиир","Неужели вы уверены, что Тот, Кто на небе, не нашлет на вас ураган с камнями? Скоро вы узнаете, каково Мое предостережение!",["или","уверены вы","в Том, Кто","на","небе","что не","нашлёт","на вас","ураган с камнями","и узнаете вы","каково","Моё предостережение"]],[67,18,["وَلَقَدۡ","كَذَّبَ","ٱلَّذِينَ","مِن","قَبۡلِهِمۡ","فَكَيۡفَ","كَانَ","نَكِيرِ"],"валаḳад каззабал лазиина мин ḳаблихим факайфа кана накиир","Жившие до них сочли это ложью. Каким же было Мое обличение!",["и уже","сочли ложью","те, которые","из","до них","и каким","было","Мое обличение"]],[67,19,["أَوَلَمۡ","يَرَوۡاْ","إِلَى","ٱلطَّيۡرِ","فَوۡقَهُمۡ","صَٰٓفَّٰتٖ","وَيَقۡبِضۡنَۚ","مَا","يُمۡسِكُهُنَّ","إِلَّا","ٱلرَّحۡمَٰنُۚ","إِنَّهُۥ","بِكُلِّ","شَيۡءِۭ","بَصِيرٌ"],"авалам йарау илат тайри фауḳахум саффатин вайаḳбидна ма йумсикухунна иллар рахману иннахуу бикулли шай'и басиир","Неужели они не видели над собой птиц, которые простирают и складывают крылья? Никто не удерживает их, кроме Милостивого. Воистину, Он видит всякую вещь.",["разве не","видели они","на","птиц","над ними","распростёрших крылья","и складывающих","не","удерживает их","кроме","Милостивый","поистине, Он","всякую","вещь","Видящий"]],[67,20,["أَمَّنۡ","هَٰذَا","ٱلَّذِي","هُوَ","جُندٞ","لَّكُمۡ","يَنصُرُكُم","مِّن","دُونِ","ٱلرَّحۡمَٰنِۚ","إِنِ","ٱلۡكَٰفِرُونَ","إِلَّا","فِي","غُرُورٍ"],"амман хазал лазии хуа жундул лакум йансурукум мин дуунир рахмани инил кафирууна илла фии гуруур","Кто может стать вашим войском и помочь вам без Милостивого? Воистину, неверующие обольщены!",["или кто","этот","тот, который","он","войско","для вас","поможет вам","из","помимо","Милостивого","не","неверующие","лишь","в","обольщении"]],[67,21,["أَمَّنۡ","هَٰذَا","ٱلَّذِي","يَرۡزُقُكُمۡ","إِنۡ","أَمۡسَكَ","رِزۡقَهُۥۚ","بَل","لَّجُّواْ","فِي","عُتُوّٖ","وَنُفُورٍ"],"амман хазал лазии йарзуḳукум ин амсака ризḳахуу бал лажжуу фии `утуввин вануфуур","Кто может наделить вас уделом, если Он перестанет наделять вас Своим уделом? Но они продолжают ослушаться и убегать.",["или кто","этот","тот, который","наделит вас уделом","если","удержит Он","Свой удел","нет же","упорствуют они","в","надменности","и отвращении"]],[67,22,["أَفَمَن","يَمۡشِي","مُكِبًّا","عَلَىٰ","وَجۡهِهِۦٓ","أَهۡدَىٰٓ","أَمَّن","يَمۡشِي","سَوِيًّا","عَلَىٰ","صِرَٰطٖ","مُّسۡتَقِيمٖ"],"афаман йамшии мукиббан `ала важхихии ахда амман йамшии савиййан `ала сиратим мустаḳиим","Кто же следует более правильным путем: блуждающий с опущенным лицом или идущий по прямому пути, выпрямившись?",["разве тот, кто","идёт","поникнув","на","своё лицо","вернее на пути","или тот, кто","идёт","выпрямившись","по","пути","прямому"]],[67,23,["قُلۡ","هُوَ","ٱلَّذِيٓ","أَنشَأَكُمۡ","وَجَعَلَ","لَكُمُ","ٱلسَّمۡعَ","وَٱلۡأَبۡصَٰرَ","وَٱلۡأَفۡـِٔدَةَۚ","قَلِيلٗا","مَّا","تَشۡكُرُونَ"],"ḳул хуал лазии аншаакум важа`ала лакумус сам`а вал'абсара вал'аф'идата ḳалиилам ма ташкуруун","Скажи: «Он - Тот, Кто создал вас и наделил вас слухом, зрением и сердцами. Как же мала ваша благодарность!».",["скажи","Он","Тот, Который","создал вас","и сделал","для вас","слух","и зрение","и сердца","мало","что","благодарите вы"]],[67,24,["قُلۡ","هُوَ","ٱلَّذِي","ذَرَأَكُمۡ","فِي","ٱلۡأَرۡضِ","وَإِلَيۡهِ","تُحۡشَرُونَ"],"ḳул хуал лазии зараакум фил арди ва'илайхи тухшаруун","Скажи: «Он - Тот, Кто расселил вас по земле, и к Нему вы будете собраны».",["скажи","Он","Тот, Который","расселил вас","по","земле","и к Нему","будете собраны вы"]],[67,25,["وَيَقُولُونَ","مَتَىٰ","هَٰذَا","ٱلۡوَعۡدُ","إِن","كُنتُمۡ","صَٰدِقِينَ"],"вайаḳуулууна мата хазал ва`ду ин кунтум садиḳиин","Они говорят: «Когда же наступит обещанное, если вы говорите правду?».",["и они говорят","когда","это","обещание","если","вы являетесь","правдивыми"]],[67,26,["قُلۡ","إِنَّمَا","ٱلۡعِلۡمُ","عِندَ","ٱللَّهِ","وَإِنَّمَآ","أَنَا۠","نَذِيرٞ","مُّبِينٞ"],"ḳул иннамал `илму `индаллахи ва'иннама ана назиирум мубиин","Скажи: «Знание об этом - у Аллаха, а я - всего лишь предостерегающий и разъясняющий увещеватель».",["скажи","лишь","знание","у","Аллаха","и лишь","я","увещеватель","ясный"]]],"m":[[["وَأَسِرُّواْ","и скрывайте",67,13],["قَوۡلَكُمۡ","вашу речь",67,13],["أَوِ","или",67,13],