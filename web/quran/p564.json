َآءِۭ","разносящему",68,11],["بِنَمِيمٖ","сплетни",68,11],[11],["مَّنَّاعٖ","удерживающему",68,12],["لِّلۡخَيۡرِ","благо",68,12],["مُعۡتَدٍ","преступнику",68,12]],[["أَثِيمٍ","грешному",68,12],[12],["عُتُلِّۭ","грубому",68,13],["بَعۡدَ","после",68,13],["ذَٰلِكَ","этого",68,13],["زَنِيمٍ","безродному",68,13],[13],["أَن","оттого что",68,14],["كَانَ","был он",68,14],["ذَا","обладателем",68,14],["مَالٖ","богатства",68,14],["وَبَنِينَ","и сыновей",68,14]],[[14],["إِذَا","когда",68,15],["تُتۡلَىٰ","читаются",68,15],["عَلَيۡهِ","ему",68,15],["ءَايَٰتُنَا","Наши аяты",68,15],["قَالَ","говорит он",68,15],["أَسَٰطِيرُ","сказки",68,15],["ٱلۡأَوَّلِينَ","древних",68,15],[15]]]}