{"p":564,"j":29,"a":[[67,27,["فَلَمَّا","رَأَوۡهُ","زُلۡفَةٗ","سِيٓـَٔتۡ","وُجُوهُ","ٱلَّذِينَ","كَفَرُواْ","وَقِيلَ","هَٰذَا","ٱلَّذِي","كُنتُم","بِهِۦ","تَدَّعُونَ"],"фаламма ра'ауху зулфатан сииат вужуухул лазиина кафаруу ваḳиила хазал лазии кунтум бихии тадда`уун","Когда они увидят его (наказание в День воскресения) вблизи от себя, лица неверующих опечалятся, и тогда им скажут: «Вот то, что вы призывали!».",["и когда","увидят они его","близко","омрачатся","лица","тех, которые","не уверовали","и скажут им","это","то, что","вы были","его","призывали"]],[67,28,["قُلۡ","أَرَءَيۡتُمۡ","إِنۡ","أَهۡلَكَنِيَ","ٱللَّهُ","وَمَن","مَّعِيَ","أَوۡ","رَحِمَنَا","فَمَن","يُجِيرُ","ٱلۡكَٰفِرِينَ","مِنۡ","عَذَابٍ","أَلِيمٖ"],"ḳул араайтум ин ахлаканийаллаху вамам ма`ийа ау рахимана фаман йужиирул кафириина мин `азабин алиим","Скажи: «Как вы думаете, кто защитит от мучительных страданий неверующих, если Аллах погубит меня и тех, кто со мной, или помилует нас?».",["скажи","думали ли вы","если","погубит меня","Аллах","и тех, кто","со мной","или","помилует нас","то кто","защитит","неверующих","от","наказания","мучительного"]],[67,29,["قُلۡ","هُوَ","ٱلرَّحۡمَٰنُ","ءَامَنَّا","بِهِۦ","وَعَلَيۡهِ","تَوَكَّلۡنَاۖ","فَسَتَعۡلَمُونَ","مَنۡ","هُوَ","فِي","ضَلَٰلٖ","مُّبِينٖ"],"ḳул хуар рахману аманна бихии ва`алайхи таваккална фасата`ламууна ман хуа фии далалим мубиин","Скажи: «Он - Милостивый! Мы уверовали в Него и уповаем только на Него, и вы узнаете, кто пребывает в очевидном заблуждении».",["скажи","Он","Милостивый","уверовали мы","в Него","и на Него","уповаем мы","и узнаете вы","кто","он","в","заблуждении","явном"]],[67,30,["قُلۡ","أَرَءَيۡتُمۡ","إِنۡ","أَصۡبَحَ","مَآؤُكُمۡ","غَوۡرٗا","فَمَن","يَأۡتِيكُم","بِمَآءٖ","مَّعِينِۭ"],"ḳул араайтум ин асбаха маукум гауран фаман йа'тиикум бимаим ма`иин","Скажи: «Как вы думаете, кто одарит вас родниковой водой, если ваша вода уйдет под землю?».",["скажи","думали ли вы","если","станет","ваша вода","ушедшей в землю","то кто","принесёт вам","воду","родниковую"]],[68,1,["نٓۚ","وَٱلۡقَلَمِ","وَمَا","يَسۡطُرُونَ"],"н валḳалами вама йастуруун","Нун. Клянусь письменной тростью и тем, что они пишут!",["Нун","клянусь пером","и тем, что","пишут они"]],[68,2,["مَآ","أَنتَ","بِنِعۡمَةِ","رَبِّكَ","بِمَجۡنُونٖ"],"ма анта бини`мати раббика бимажнуун","Ты по милости своего Господа не являешься одержимым.",["не","ты","по милости","твоего Господа","одержимый"]],[68,3,["وَإِنَّ","لَكَ","لَأَجۡرًا","غَيۡرَ","مَمۡنُونٖ"],"ва'инна лака ла'ажран гайра мамнуун","Воистину, награда твоя неиссякаема.",["и поистине","тебе","непременно награда","не","иссякающая"]],[68,4,["وَإِنَّكَ","لَعَلَىٰ","خُلُقٍ","عَظِيمٖ"],"ва'иннака ла`ала хулуḳин `азиим","Воистину, твой нрав превосходен.",["и поистине, ты","непременно на","нраве","великом"]],[68,5,["فَسَتُبۡصِرُ","وَيُبۡصِرُونَ"],"фасатубсиру вайубсируун","Ты увидишь, и они тоже увидят,",["и увидишь ты","и увидят они"]],[68,6,["بِأَييِّكُمُ","ٱلۡمَفۡتُونُ"],"би'аййикумул мафтуун","кто из вас - бесноватый.",["кто из вас","одержимый"]],[68,7,["إِنَّ","رَبَّكَ","هُوَ","أَعۡلَمُ","بِمَن","ضَلَّ","عَن","سَبِيلِهِۦ","وَهُوَ","أَعۡلَمُ","بِٱلۡمُهۡتَدِينَ"],"инна раббака хуа а`ламу биман далла `ан сабиилихии вахуа а`ламу билмухтадиин","Твой Господь лучше знает тех, кто сбился с Его пути, и лучше знает тех, кто следует прямым путем.",["поистине","твой Господь","Он","лучше знает","о тех, кто","сбился","с","Его пути","и Он","лучше знает","о следующих прямым путём"]],[68,8,["فَلَا","تُطِعِ","ٱلۡمُكَذِّبِينَ"],"фала тути`ил муказзибиин","Посему не повинуйся тем, кто считает истину ложью!",["так не","повинуйся","считающим ложью"]],[68,9,["وَدُّواْ","لَوۡ","تُدۡهِنُ","فَيُدۡهِنُونَ"],"ваддуу лау тудхину файудхинуун","Они хотели бы, чтобы ты был уступчив, и тогда они тоже стали бы уступчивы.",["хотели бы они","чтобы","ты уступал","и они уступали бы"]],[68,10,["وَلَا","تُطِعۡ","كُلَّ","حَلَّافٖ","مَّهِينٍ"],"вала тути` кулла халлафим махиин","Не повинуйся всякому расточителю клятв, презренному,",["и не","повинуйся","всякому","клятвеннику","презренному"]],[68,11,["هَمَّازٖ","مَّشَّآءِۭ","بِنَمِيمٖ"],"хаммазим машшаи бинамиим","хулителю, разносящему сплетни,",["хулителю","разносящему","сплетни"]],[68,12,["مَّنَّاعٖ","لِّلۡخَيۡرِ","مُعۡتَدٍ","أَثِيمٍ"],"мманна`ил лилхайри му`тадин асиим","скупящемуся на добро, преступнику, грешнику,",["удерживающему","благо","преступнику","грешному"]],[68,13,["عُتُلِّۭ","بَعۡدَ","ذَٰلِكَ","زَنِيمٍ"],"`утулли ба`да залика заниим","жестокому, к тому же самозванцу,",["грубому","после","этого","безродному"]],[68,14,["أَن","كَانَ","ذَا","مَالٖ","وَبَنِينَ"],"ан кана за малин вабаниин","даже если он будет богат и будет иметь сыновей.",["оттого что","был он","обладателем","богатства","и сыновей"]],[68,15,["إِذَا","تُتۡلَىٰ","عَلَيۡهِ","ءَايَٰتُنَا","قَالَ","أَسَٰطِيرُ","ٱلۡأَوَّلِينَ"],"иза тутла `алайхи айатуна ḳала асатиирул аввалиин","Когда ему читают Наши аяты, он говорит: «Это - легенды древних народов!».",["когда","читаются","ему","Наши аяты","говорит он","сказки","древних"]]],"m":[[["فَلَمَّا","и когда",67,27],["رَأَوۡهُ","увидят они его",67,27],["زُلۡفَةٗ","близко",67,27],["سِيٓـَٔتۡ","омрачатся",67,27],["وُجُوهُ","лица",67,27],["ٱلَّذِينَ","тех, которые",67,27],["كَفَرُواْ","не уверовали",67,27],["وَقِيلَ","и скажут им",67,27],["هَٰذَا","это",67,27],["ٱلَّذِي","то, что",67,27]],[["كُنتُم","вы были",67,27],["بِهِۦ","его",67,27],["تَدَّعُونَ","призывали",67,27],[27],["قُلۡ","скажи",67,28],["أَرَءَيۡتُمۡ","думали ли вы",67,28],["إِنۡ","если",67,28],["أَهۡلَكَنِيَ","погубит меня",67,28],["ٱللَّهُ","Аллах",67,28],["وَمَن","и тех, кто",67,28],["مَّعِيَ","со мной",67,28]],[["أَوۡ","или",67,28],["رَحِمَنَا","помилует нас",67,28],["فَمَن","то кто",67,28],["يُجِيرُ","защитит",67,28],["ٱلۡكَٰفِرِينَ","неверующих",67,28],["مِنۡ","от",67,28],["عَذَابٍ","наказания",67,28],["أَلِيمٖ","мучительного",67,28],[28],["قُلۡ","скажи",67,29],["هُوَ","Он",67,29]],[["ٱلرَّحۡمَٰنُ","Милостивый",67,29],["ءَامَنَّا","уверовали мы",67,29],["بِهِۦ","в Него",67,2