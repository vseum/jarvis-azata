{"p":565,"j":29,"a":[[68,16,["سَنَسِمُهُۥ","عَلَى","ٱلۡخُرۡطُومِ"],"санасимухуу `алал хуртуум","Мы заклеймим его хобот (нос).",["Мы заклеймим его","на","хоботе"]],[68,17,["إِنَّا","بَلَوۡنَٰهُمۡ","كَمَا","بَلَوۡنَآ","أَصۡحَٰبَ","ٱلۡجَنَّةِ","إِذۡ","أَقۡسَمُواْ","لَيَصۡرِمُنَّهَا","مُصۡبِحِينَ"],"инна балаунахум кама балауна асхабал жаннати из аḳсамуу лайасримуннаха мусбихиин","Воистину, мы подвергли их испытанию, подобно тому, как мы подвергли испытанию владельцев сада, когда они поклялись, что утром они непременно сорвут их (плоды),",["поистине, Мы","испытали их","как","испытали Мы","владельцев","сада","когда","поклялись они","непременно сорвут его плоды","утром"]],[68,18,["وَلَا","يَسۡتَثۡنُونَ"],"вала йастаснуун","но не сделали оговорки (не сказали: «Если того пожелает Аллах»).",["и не","делали оговорки"]],[68,19,["فَطَافَ","عَلَيۡهَا","طَآئِفٞ","مِّن","رَّبِّكَ","وَهُمۡ","نَآئِمُونَ"],"фатафа `алайха таифум мир раббика вахум наимуун","Ночью же, пока они спали, их сад поразила кара от твоего Господа.",["и обошла","его","кара","от","твоего Господа","а они","спали"]],[68,20,["فَأَصۡبَحَتۡ","كَٱلصَّرِيمِ"],"фа'асбахат кассариим","К утру сад был подобен мрачной ночи (был погублен).",["и стал он","словно сжатый"]],[68,21,["فَتَنَادَوۡاْ","مُصۡبِحِينَ"],"фатанадау мусбихиин","А на рассвете они стали звать друг друга:",["и стали звать друг друга","поутру"]],[68,22,["أَنِ","ٱغۡدُواْ","عَلَىٰ","حَرۡثِكُمۡ","إِن","كُنتُمۡ","صَٰرِمِينَ"],"анигдуу `ала харсикум ин кунтум саримиин","«Ступайте на вашу пашню, если вы хотите сорвать плоды!».",["что","отправляйтесь рано","на","вашу пашню","если","вы","собираете урожай"]],[68,23,["فَٱنطَلَقُواْ","وَهُمۡ","يَتَخَٰفَتُونَ"],"фанталаḳуу вахум йатахафатуун","Они отправились туда, разговаривая шепотом:",["и отправились они","а они","перешёптывались"]],[68,24,["أَن","لَّا","يَدۡخُلَنَّهَا","ٱلۡيَوۡمَ","عَلَيۡكُم","مِّسۡكِينٞ"],"ал ла йадхуланнахал йаума `алайкум мискиин","«Не впускайте сегодня к себе бедняка».",["что","не","войдёт непременно туда","сегодня","к вам","бедняк"]],[68,25,["وَغَدَوۡاْ","عَلَىٰ","حَرۡدٖ","قَٰدِرِينَ"],"вагадау `ала хардин ḳадириин","Они шли с твердым намерением и полагали, что у них достаточно сил.",["и отправились рано","с","решимостью","способные"]],[68,26,["فَلَمَّا","رَأَوۡهَا","قَالُوٓاْ","إِنَّا","لَضَآلُّونَ"],"фаламма ра'ауха ḳалуу инна ладаллуун","Когда же они увидели его, они сказали: «Мы сбились с пути!",["и когда","увидели они его","сказали они","поистине, мы","непременно сбились"]],[68,27,["بَلۡ","نَحۡنُ","مَحۡرُومُونَ"],"бал нахну махруумуун","О нет! Мы лишились этого».",["нет же","мы","лишены"]],[68,28,["قَالَ","أَوۡسَطُهُمۡ","أَلَمۡ","أَقُل","لَّكُمۡ","لَوۡلَا","تُسَبِّحُونَ"],"ḳала аусатухум алам аḳул лакум лаула тусаббихуун","Лучший из них сказал: «Разве я не говорил вам, что надо было прославить Аллаха?».",["сказал","средний (лучший) из них","разве не","я говорил","вам","почему бы не","вы прославляете"]],[68,29,["قَالُواْ","سُبۡحَٰنَ","رَبِّنَآ","إِنَّا","كُنَّا","ظَٰلِمِينَ"],"ḳалуу субхана раббина инна кунна залимиин","Они сказали: «Пречист наш Господь! Мы были несправедливы».",["сказали","пречист","наш Господь","поистине, мы","были","несправедливыми"]],[68,30,["فَأَقۡبَلَ","بَعۡضُهُمۡ","عَلَىٰ","بَعۡضٖ","يَتَلَٰوَمُونَ"],"фа'аḳбала ба`духум `ала ба`дин йаталавамуун","Они стали попрекать друг друга",["и обратились","одни из них","к","другим","упрекая друг друга"]],[68,31,["قَالُواْ","يَٰوَيۡلَنَآ","إِنَّا","كُنَّا","طَٰغِينَ"],"ḳалуу йавайлана инна кунна тагиин","и сказали: «Горе нам! Мы преступили границы дозволенного.",["сказали они","о горе нам","поистине, мы","были мы","преступившими"]],[68,32,["عَسَىٰ","رَبُّنَآ","أَن","يُبۡدِلَنَا","خَيۡرٗا","مِّنۡهَآ","إِنَّآ","إِلَىٰ","رَبِّنَا","رَٰغِبُونَ"],"`аса раббуна ан йубдилана хайрам минха инна ила раббина рагибуун","Быть может, Господь наш даст нам взамен нечто лучшее. Воистину, мы обращаемся к нашему Господу».",["быть может","Господь наш","что","заменит нам","лучшим","чем он","поистине, мы","к","Господу нашему","устремляемся"]],[68,33,["كَذَٰلِكَ","ٱلۡعَذَابُۖ","وَلَعَذَابُ","ٱلۡأٓخِرَةِ","أَكۡبَرُۚ","لَوۡ","كَانُواْ","يَعۡلَمُونَ"],"казаликал `азабу вала`азабул ахирати акбару лау кануу йа`ламуун","Такими были мучения, а мучения в Последней жизни будут еще ужаснее! Если бы только они знали!",["таково","наказание","а наказание непременно","последней жизни","больше","если бы","были они","знают"]],[68,34,["إِنَّ","لِلۡمُتَّقِينَ","عِندَ","رَبِّهِمۡ","جَنَّٰتِ","ٱلنَّعِيمِ"],"инна лилмуттаḳиина `инда раббихим жаннатин на`иим","Воистину, для богобоязненных у их Господа приготовлены Сады блаженства.",["поистине","для богобоязненных","у","их Господа","Сады","блаженства"]],[68,35,["أَفَنَجۡعَلُ","ٱلۡمُسۡلِمِينَ","كَٱلۡمُجۡرِمِينَ"],"афанаж`алул муслимиина калмужримиин","Неужели Мы мусульман уравняем с грешниками?",["разве сделаем Мы","покорившихся","подобными грешникам"]],[68,36,["مَا","لَكُمۡ","كَيۡفَ","تَحۡكُمُونَ"],"ма лакум кайфа тахкумуун","Что с вами? Как вы судите?",["что","с вами","как","вы судите"]],[68,37,["أَمۡ","لَكُمۡ","كِتَٰبٞ","فِيهِ","تَدۡرُسُونَ"],"ам лакум китабун фиихи тадрусуун","Или у вас есть Писание, из которого вы узнали,",["или","у вас","писание","в котором","вы изучаете"]],[68,38,["إِنَّ","لَكُمۡ","فِيهِ","لَمَا","تَخَيَّرُونَ"],"инна лакум фиихи лама тахаййаруун","что там у вас будет все, что вы выберете?",["поистине","у вас","в нём","непременно то, что","вы выбираете"]],[68,39,["أَمۡ","لَكُمۡ","أَيۡمَٰنٌ","عَلَيۡنَا","بَٰلِغَةٌ","إِلَىٰ","يَوۡمِ","ٱلۡقِيَٰمَةِ","إِنَّ","لَكُمۡ","لَمَا","تَحۡكُمُونَ"],"ам лакум айманун `алайна балигатун ила йаумил ḳийамати инна лакум лама тахкумуун","Или у вас есть Наши клятвы, которые сохранятся до Дня воскресения, о том, что у вас будет все, что вы присудите?",["или","у вас","клятвы","от Нас","действующие","до","дня","воскресения","поистине","у вас","непременно то, что","вы решаете"]],[68,40,["سَلۡهُمۡ","أَيُّهُم","بِذَٰلِكَ","زَعِيمٌ"],"салхум аййухум бизалика за`иим","Спроси их, кто из них пору