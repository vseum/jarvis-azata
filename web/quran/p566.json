{"p":566,"j":29,"a":[[68,43,["خَٰشِعَةً","أَبۡصَٰرُهُمۡ","تَرۡهَقُهُمۡ","ذِلَّةٞۖ","وَقَدۡ","كَانُواْ","يُدۡعَوۡنَ","إِلَى","ٱلسُّجُودِ","وَهُمۡ","سَٰلِمُونَ"],"хаши`атан абсарухум тархаḳухум зиллатун ваḳад кануу йуд`ауна илас сужууди вахум салимуун","Их взоры потупятся, и унижение покроет их. А ведь их призывали пасть ниц, когда они пребывали в здравии.",["потуплены","взоры их","покроет их","унижение","и ведь уже","были они","призываемы","к","поклону ниц","когда они","здоровы"]],[68,44,["فَذَرۡنِي","وَمَن","يُكَذِّبُ","بِهَٰذَا","ٱلۡحَدِيثِۖ","سَنَسۡتَدۡرِجُهُم","مِّنۡ","حَيۡثُ","لَا","يَعۡلَمُونَ"],"фазарнии ваман йуказзибу бихазал хадииси санастадрижухум мин хайсу ла йа`ламуун","Оставь же Меня с теми, кто считает ложью это повествование. Мы завлечем их так, что они даже не осознают этого.",["оставь же Меня","и тех, кто","отвергает","этим","повествованием","постепенно приблизим Мы их","оттуда","откуда","не","знают они"]],[68,45,["وَأُمۡلِي","لَهُمۡۚ","إِنَّ","كَيۡدِي","مَتِينٌ"],"ва'умлии лахум инна кайдии матиин","Я даю им отсрочку, ведь хитрость Моя несокрушима.",["и даю отсрочку Я","им","поистине","замысел Мой","прочен"]],[68,46,["أَمۡ","تَسۡـَٔلُهُمۡ","أَجۡرٗا","فَهُم","مِّن","مَّغۡرَمٖ","مُّثۡقَلُونَ"],"ам тас'алухум ажран фахум мим маграмим мусḳалуун","Или же ты просишь у них вознаграждения, и они обременены обязательствами?",["или","ты просишь у них","платы","и они","от","долга","обременены"]],[68,47,["أَمۡ","عِندَهُمُ","ٱلۡغَيۡبُ","فَهُمۡ","يَكۡتُبُونَ"],"ам `индахумул гайбу фахум йактубуун","Или же они владеют сокровенным и записывают его?",["или","у них","сокровенное","и они","записывают"]],[68,48,["فَٱصۡبِرۡ","لِحُكۡمِ","رَبِّكَ","وَلَا","تَكُن","كَصَاحِبِ","ٱلۡحُوتِ","إِذۡ","نَادَىٰ","وَهُوَ","مَكۡظُومٞ"],"фасбир лихукми раббика вала такун касахибил хуути из нада вахуа макзуум","Потерпи же до решения твоего Господа и не уподобляйся человеку в рыбе (Йунусу), который обратился с мольбой вслух, сдерживая свою печаль.",["терпи же","до решения","Господа твоего","и не","будь","как обладатель","рыбы","когда","воззвал он","и он","угнетён (печалью)"]],[68,49,["لَّوۡلَآ","أَن","تَدَٰرَكَهُۥ","نِعۡمَةٞ","مِّن","رَّبِّهِۦ","لَنُبِذَ","بِٱلۡعَرَآءِ","وَهُوَ","مَذۡمُومٞ"],"ллаула ан тадаракахуу ни`матум мир раббихии ланубиза бил`араи вахуа мазмуум","Если бы его не постигла милость Господа, то он был бы выброшен на открытую местность постыженным.",["если бы не","что","постигла его","милость","от","Господа его","непременно был бы выброшен","на голую землю","и он","порицаемый"]],[68,50,["فَٱجۡتَبَٰهُ","رَبُّهُۥ","فَجَعَلَهُۥ","مِنَ","ٱلصَّٰلِحِينَ"],"фажтабаху раббухуу фажа`алахуу минас салихиин","Но его Господь избрал его и сделал одним из праведников.",["и избрал его","Господь его","и сделал его","из","праведных"]],[68,51,["وَإِن","يَكَادُ","ٱلَّذِينَ","كَفَرُواْ","لَيُزۡلِقُونَكَ","بِأَبۡصَٰرِهِمۡ","لَمَّا","سَمِعُواْ","ٱلذِّكۡرَ","وَيَقُولُونَ","إِنَّهُۥ","لَمَجۡنُونٞ"],"ва'ин йакадул лазиина кафаруу лайузлиḳуунака би'абсарихим ламма сами`уз зикра вайаḳуулууна иннахуу ламажнуун","Воистину, неверующие готовы заставить тебя поскользнуться своими взглядами, когда они слышат Напоминание, и говорят: «Воистину, он - одержимый!».",["и поистине","почти","те, которые","не уверовали","непременно сбивают тебя","взорами своими","когда","услышали","напоминание","и говорят","поистине, он","непременно одержимый"]],[68,52,["وَمَا","هُوَ","إِلَّا","ذِكۡرٞ","لِّلۡعَٰلَمِينَ"],"вама хуа илла зикрул лил`аламиин","Но это - не что иное, как Напоминание для миров.",["и не","оно","кроме (как)","напоминание","для миров"]],[69,1,["ٱلۡحَآقَّةُ"],"алхаḳḳах","Неминуемое (День воскресения)!",["неминуемое"]],[69,2,["مَا","ٱلۡحَآقَّةُ"],"мал хаḳḳах","Что такое Неминуемое (День воскресения)?",["что такое","неминуемое"]],[69,3,["وَمَآ","أَدۡرَىٰكَ","مَا","ٱلۡحَآقَّةُ"],"вама адрака мал хаḳḳах","Откуда ты мог знать, что такое Неминуемое (День воскресения)?",["и что","дало знать тебе","что такое","неминуемое"]],[69,4,["كَذَّبَتۡ","ثَمُودُ","وَعَادُۢ","بِٱلۡقَارِعَةِ"],"каззабат самууду ва`аду билḳари`ах","Самудяне и адиты отрицали Великое бедствие (День воскресения).",["сочли ложью","самуд","и ад","сокрушающее"]],[69,5,["فَأَمَّا","ثَمُودُ","فَأُهۡلِكُواْ","بِٱلطَّاغِيَةِ"],"фа'амма самууду фа'ухликуу биттагийах","Самудяне были истреблены неистовым воплем.",["и что до","самуда","то были истреблены они","неистовым (воплем)"]],[69,6,["وَأَمَّا","عَادٞ","فَأُهۡلِكُواْ","بِرِيحٖ","صَرۡصَرٍ","عَاتِيَةٖ"],"ва'амма `адун фа'ухликуу бириихин сарсарин `атийах","Адиты же были истреблены ветром морозным (или завывающим), лютым.",["а что до","ада","то были истреблены они","ветром","ревущим (холодным)","буйным"]],[69,7,["سَخَّرَهَا","عَلَيۡهِمۡ","سَبۡعَ","لَيَالٖ","وَثَمَٰنِيَةَ","أَيَّامٍ","حُسُومٗاۖ","فَتَرَى","ٱلۡقَوۡمَ","فِيهَا","صَرۡعَىٰ","كَأَنَّهُمۡ","أَعۡجَازُ","نَخۡلٍ","خَاوِيَةٖ"],"саххараха `алайхим саб`а лайалин васаманийата аййамин хусууман фатарал ḳаума фииха сар`а ка'аннахум а`жазу нахлин хавийах","Он заставил его бушевать над ними в течение семи ночей и восьми дней без перерыва, и ты мог бы увидеть людей, которые были повержены, словно рухнувшие сгнившие пальмовые стволы.",["подчинил Он его","над ними","семь","ночей","и восемь","дней","непрерывно","и видишь ты","людей","в нём","поверженными","как будто они","стволы","пальм","опустевшие"]],[69,8,["فَهَلۡ","تَرَىٰ","لَهُم","مِّنۢ","بَاقِيَةٖ"],"фахал тара лахум мим баḳийах","Видишь ли ты что-либо оставшееся от них?",["разве же","видишь ты","у них","из","оставшегося"]]],"m":[[["خَٰشِعَةً","потуплены",68,43],["أَبۡصَٰرُهُمۡ","взоры их",68,43],["تَرۡهَقُهُمۡ","покроет их",68,43],["ذِلَّةٞۖ","унижение",68,43],["وَقَدۡ","и ведь уже",68,43],["كَانُواْ","были они",68,43],["يُدۡعَوۡنَ","призываемы",68,43],["إِلَى","к",68,43],["ٱلسُّجُودِ","поклону ниц",68,43],["وَهُمۡ","когда они",68,43],["سَٰلِمُونَ","здоровы",68,43]],[[43],["فَذَرۡنِي","оставь же Меня",68,44],["وَمَن","и тех, кто",68,44],["يُكَذِّبُ","отвергает",68,44],["بِهَٰذَا","этим",68,44],["ٱلۡحَدِيثِۖ","повествова