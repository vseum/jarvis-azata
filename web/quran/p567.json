{"p":567,"j":29,"a":[[69,9,["وَجَآءَ","فِرۡعَوۡنُ","وَمَن","قَبۡلَهُۥ","وَٱلۡمُؤۡتَفِكَٰتُ","بِٱلۡخَاطِئَةِ"],"важаа фир`ауну ваман ḳаблахуу валму'тафикату билхатиах","Фараон, его предшественники и опрокинутые селения (селения народа Лута) совершали грехи.",["и пришёл","Фир'аун","и те, кто","до него","и опрокинутые (селения)","с грехом"]],[69,10,["فَعَصَوۡاْ","رَسُولَ","رَبِّهِمۡ","فَأَخَذَهُمۡ","أَخۡذَةٗ","رَّابِيَةً"],"фа`асау расуула раббихим фа'ахазахум ахзатар рабийаха","Они ослушались посланника своего Господа, и Он схватил их Хваткой превосходящей.",["и ослушались они","посланника","Господа их","и схватил Он их","хваткой","возрастающей"]],[69,11,["إِنَّا","لَمَّا","طَغَا","ٱلۡمَآءُ","حَمَلۡنَٰكُمۡ","فِي","ٱلۡجَارِيَةِ"],"инна ламма тагал мау хамалнакум фил жарийах","Когда вода стала разливаться, Мы повезли вас в плавучем ковчеге,",["поистине, Мы","когда","разлилась","вода","понесли Мы вас","в","плывущем (ковчеге)"]],[69,12,["لِنَجۡعَلَهَا","لَكُمۡ","تَذۡكِرَةٗ","وَتَعِيَهَآ","أُذُنٞ","وَٰعِيَةٞ"],"линаж`алаха лакум тазкиратан вата`ийаха узунун ва`ийах","чтобы он стал для вас напоминанием и чтобы запоминающее ухо запомнило это.",["чтобы сделать Нам его","для вас","напоминанием","и чтобы запомнило его","ухо","запоминающее"]],[69,13,["فَإِذَا","نُفِخَ","فِي","ٱلصُّورِ","نَفۡخَةٞ","وَٰحِدَةٞ"],"фа'иза нуфиха фис суури нафхатун вахидах","Когда же подуют в Рог всего один раз,",["и когда","будет подуто","в","Рог","дуновением","единым"]],[69,14,["وَحُمِلَتِ","ٱلۡأَرۡضُ","وَٱلۡجِبَالُ","فَدُكَّتَا","دَكَّةٗ","وَٰحِدَةٗ"],"вахумилатил арду валжибалу фадукката даккатан вахидаха","когда земля и горы будут подняты и разобьются, превратившись в песок за один раз,",["и будут подняты","земля","и горы","и будут сокрушены обе","сокрушением","единым"]],[69,15,["فَيَوۡمَئِذٖ","وَقَعَتِ","ٱلۡوَاقِعَةُ"],"файаумаизин ваḳа`атил ваḳи`ах","в тот день наступит Событие (День воскресения).",["то в тот день","наступит","событие"]],[69,16,["وَٱنشَقَّتِ","ٱلسَّمَآءُ","فَهِيَ","يَوۡمَئِذٖ","وَاهِيَةٞ"],"ваншаḳḳатис самау фахийа йаумаизин вахийах","Небо разверзнется, ибо оно в тот день будет слабым.",["и расколется","небо","и оно","в тот день","непрочное"]],[69,17,["وَٱلۡمَلَكُ","عَلَىٰٓ","أَرۡجَآئِهَاۚ","وَيَحۡمِلُ","عَرۡشَ","رَبِّكَ","فَوۡقَهُمۡ","يَوۡمَئِذٖ","ثَمَٰنِيَةٞ"],"валмалаку `ала аржаиха вайахмилу `арша раббика фауḳахум йаумаизин саманийах","Ангелы будут находиться по его краю, и восьмеро понесут над собой Трон твоего Господа.",["и ангелы","на","краях его","и понесут","Трон","Господа твоего","над ними","в тот день","восемь"]],[69,18,["يَوۡمَئِذٖ","تُعۡرَضُونَ","لَا","تَخۡفَىٰ","مِنكُمۡ","خَافِيَةٞ"],"йаумаизин ту`радууна ла тахфа минкум хафийах","В тот день вы предстанете, и ни одна ваша тайна не останется сокрытой.",["в тот день","будете представлены вы","не","скроется","из вас","тайна"]],[69,19,["فَأَمَّا","مَنۡ","أُوتِيَ","كِتَٰبَهُۥ","بِيَمِينِهِۦ","فَيَقُولُ","هَآؤُمُ","ٱقۡرَءُواْ","كِتَٰبِيَهۡ"],"фа'амма ман уутийа китабахуу бийамиинихии файаḳуулу хаумуḳрауу китабийах","Тот, кому его книга будет дана в правую руку, скажет: «Вот! Прочтите мою книгу!",["и что до","того, кто","дана","книга его","в правую руку его","то скажет он","вот, возьмите","читайте","книгу мою"]],[69,20,["إِنِّي","ظَنَنتُ","أَنِّي","مُلَٰقٍ","حِسَابِيَهۡ"],"иннии зананту аннии мулаḳин хисабийах","Я верил в то, что мне предъявят счет».",["поистине, я","был уверен","что я","встречу","свой расчет"]],[69,21,["فَهُوَ","فِي","عِيشَةٖ","رَّاضِيَةٖ"],"фахуа фии `иишатир радийах","Для него будет отрадная жизнь",["и он","в","жизни","довольной"]],[69,22,["فِي","جَنَّةٍ","عَالِيَةٖ"],"фии жаннатин `алийах","в вышнем саду,",["в","саду","высоком"]],[69,23,["قُطُوفُهَا","دَانِيَةٞ"],"ḳутууфуха данийах","где плоды склоняются низко.",["плоды его","близки"]],[69,24,["كُلُواْ","وَٱشۡرَبُواْ","هَنِيٓـَٔۢا","بِمَآ","أَسۡلَفۡتُمۡ","فِي","ٱلۡأَيَّامِ","ٱلۡخَالِيَةِ"],"кулуу вашрабуу ханииа бима аслафтум фил аййамил халийах","Ешьте и пейте во здравие за то, что вы совершили в минувшие дни!",["ешьте","и пейте","во здравие","за то, что","совершили вы заранее","в","дни","минувшие"]],[69,25,["وَأَمَّا","مَنۡ","أُوتِيَ","كِتَٰبَهُۥ","بِشِمَالِهِۦ","فَيَقُولُ","يَٰلَيۡتَنِي","لَمۡ","أُوتَ","كِتَٰبِيَهۡ"],"ва'амма ман уутийа китабахуу бишималихии файаḳуулу йалайтании лам уута китабийах","Тот же, кому его книга будет дана в левую руку, скажет: «Лучше бы мне не вручали моей книги!",["а что до","того, кто","дана","книга его","в левую руку его","то скажет он","о, если бы мне","не","была дана","книга моя"]],[69,26,["وَلَمۡ","أَدۡرِ","مَا","حِسَابِيَهۡ"],"валам адри ма хисабийах","Не знать бы мне, каков мой счет!",["и не","знал бы я","каков","расчёт мой"]],[69,27,["يَٰلَيۡتَهَا","كَانَتِ","ٱلۡقَاضِيَةَ"],"йалайтаха канатил ḳадийах","Лучше бы она была концом всего!",["о, если бы она","была","концом"]],[69,28,["مَآ","أَغۡنَىٰ","عَنِّي","مَالِيَهۡۜ"],"ма агна `аннии малийах","Не помогло мне мое богатство!",["не","помогло","мне","богатство моё"]],[69,29,["هَلَكَ","عَنِّي","سُلۡطَٰنِيَهۡ"],"халака `аннии султанийах","Лишился я своей власти!».",["исчезла","от меня","власть моя"]],[69,30,["خُذُوهُ","فَغُلُّوهُ"],"хузууху фагуллуух","Схватите его и закуйте,",["схватите его","и закуйте его"]],[69,31,["ثُمَّ","ٱلۡجَحِيمَ","صَلُّوهُ"],"суммал жахиима саллуух","потом бросьте его в Ад",["затем","в Ад","ввергните его"]],[69,32,["ثُمَّ","فِي","سِلۡسِلَةٖ","ذَرۡعُهَا","سَبۡعُونَ","ذِرَاعٗا","فَٱسۡلُكُوهُ"],"сумма фии силсилатин зар`уха саб`ууна зира`ан фаслукуух","и нанизьте его на цепь длиной в семьдесят локтей!",["затем","в","цепь","длина её","семьдесят","локтей","вденьте его"]],[69,33,["إِنَّهُۥ","كَانَ","لَا","يُؤۡمِنُ","بِٱللَّهِ","ٱلۡعَظِيمِ"],"иннахуу кана ла йу'мину биллахил `азиим","Он не веровал в Великого Аллаха",["поистине, он","был","не","верующим","в Аллаха","Великого"]],[69,34,["وَلَا","يَحُضُّ","عَلَىٰ","طَعَامِ","ٱلۡمِسۡكِينِ"],"вала йахудду `ала та`амил мискиин","и не призывал кормить бедняка.",["и не","побуждал","к","кормлению","бедняка"]]],"m":[[["وَج