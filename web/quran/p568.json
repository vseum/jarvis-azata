{"p":568,"j":29,"a":[[69,35,["فَلَيۡسَ","لَهُ","ٱلۡيَوۡمَ","هَٰهُنَا","حَمِيمٞ"],"фалайса лахул йаума хахуна хамиим","Сегодня здесь у него нет любящего родственника,",["и нет","у него","сегодня","здесь","близкого друга"]],[69,36,["وَلَا","طَعَامٌ","إِلَّا","مِنۡ","غِسۡلِينٖ"],"вала та`амун илла мин гислиин","и нет пищи, кроме кровавого гноя.",["и нет","пищи","кроме","из","гноя"]],[69,37,["لَّا","يَأۡكُلُهُۥٓ","إِلَّا","ٱلۡخَٰطِـُٔونَ"],"лла йа'кулухуу иллал хатиуун","Едят его только грешники.",["не","ест его","кроме","грешники"]],[69,38,["فَلَآ","أُقۡسِمُ","بِمَا","تُبۡصِرُونَ"],"фала уḳсиму бима тубсируун","О да! Клянусь тем, что вы видите,",["так нет же","клянусь","тем, что","вы видите"]],[69,39,["وَمَا","لَا","تُبۡصِرُونَ"],"вама ла тубсируун","и тем, чего вы не видите!",["и тем, что","не","вы видите"]],[69,40,["إِنَّهُۥ","لَقَوۡلُ","رَسُولٖ","كَرِيمٖ"],"иннахуу лаḳаулу расуулин кариим","Это - слова благородного посланца (Мухаммада или Джибрила).",["поистине, это","непременно слово","посланника","благородного"]],[69,41,["وَمَا","هُوَ","بِقَوۡلِ","شَاعِرٖۚ","قَلِيلٗا","مَّا","تُؤۡمِنُونَ"],"вама хуа биḳаули ша`ирин ḳалиилам ма ту'минуун","Это - не слова поэта. Мало же вы веруете!",["и не","оно","слово","поэта","мало","что","вы веруете"]],[69,42,["وَلَا","بِقَوۡلِ","كَاهِنٖۚ","قَلِيلٗا","مَّا","تَذَكَّرُونَ"],"вала биḳаули кахинин ḳалиилам ма тазаккаруун","Это - не слова прорицателя. Мало же вы поминаете назидания!",["и не","словом","прорицателя","мало","же","вы поминаете"]],[69,43,["تَنزِيلٞ","مِّن","رَّبِّ","ٱلۡعَٰلَمِينَ"],"танзиилум мир раббил `аламиин","Это - Ниспослание от Господа миров.",["ниспослание","от","Господа","миров"]],[69,44,["وَلَوۡ","تَقَوَّلَ","عَلَيۡنَا","بَعۡضَ","ٱلۡأَقَاوِيلِ"],"валау таḳаввала `алайна ба`дал аḳавиил","Если бы он приписал Нам некоторые слова,",["и если бы","приписал он","Нам","некоторые","изречения"]],[69,45,["لَأَخَذۡنَا","مِنۡهُ","بِٱلۡيَمِينِ"],"ла'ахазна минху билйамиин","то Мы схватили бы его за правую руку (или схватили бы его крепко),",["непременно схватили бы Мы","его","за правую руку"]],[69,46,["ثُمَّ","لَقَطَعۡنَا","مِنۡهُ","ٱلۡوَتِينَ"],"сумма лаḳата`на минхул ватиин","а потом перерезали бы ему аорту,",["затем","непременно перерезали бы Мы","у него","аорту"]],[69,47,["فَمَا","مِنكُم","مِّنۡ","أَحَدٍ","عَنۡهُ","حَٰجِزِينَ"],"фама минкум мин ахадин `анху хажизиин","и никто из вас не избавил бы его.",["и не","из вас","ни","один","от него","удерживающими"]],[69,48,["وَإِنَّهُۥ","لَتَذۡكِرَةٞ","لِّلۡمُتَّقِينَ"],"ва'иннахуу латазкиратул лилмуттаḳиин","Воистину, это - Назидание для богобоязненных.",["и поистине, это","непременно напоминание","для богобоязненных"]],[69,49,["وَإِنَّا","لَنَعۡلَمُ","أَنَّ","مِنكُم","مُّكَذِّبِينَ"],"ва'инна лана`ламу анна минкум муказзибиин","Нам известно, что среди вас есть считающие его ложью.",["и поистине, Мы","непременно знаем","что","среди вас","отвергающие"]],[69,50,["وَإِنَّهُۥ","لَحَسۡرَةٌ","عَلَى","ٱلۡكَٰفِرِينَ"],"ва'иннахуу лахасратун `алал кафириин","Воистину, это - горе для неверующих.",["и поистине, это","непременно сожаление","для","неверующих"]],[69,51,["وَإِنَّهُۥ","لَحَقُّ","ٱلۡيَقِينِ"],"ва'иннахуу лахаḳḳул йаḳиин","Воистину, это - убедительная истина.",["и поистине, это","непременно истина","достоверная"]],[69,52,["فَسَبِّحۡ","بِٱسۡمِ","رَبِّكَ","ٱلۡعَظِيمِ"],"фасаббих бисми раббикал `азиим","Прославляй же имя Господа твоего Великого!",["прославляй же","именем","Господа твоего","Великого"]],[70,1,["سَأَلَ","سَآئِلُۢ","بِعَذَابٖ","وَاقِعٖ"],"са'ала саилу би`азабин ваḳи`","Просящий просил мучения, которые постигают",["просил","просящий","о наказании","наступающем"]],[70,2,["لِّلۡكَٰفِرِينَ","لَيۡسَ","لَهُۥ","دَافِعٞ"],"ллилкафириина лайса лахуу дафи`","неверующих. Никто не сможет предотвратить его",["для неверующих","нет","у него","отвращающего"]],[70,3,["مِّنَ","ٱللَّهِ","ذِي","ٱلۡمَعَارِجِ"],"мминаллахи зил ма`ариж","вопреки Аллаху, Владыке ступеней.",["от","Аллаха","Обладателя","ступеней"]],[70,4,["تَعۡرُجُ","ٱلۡمَلَٰٓئِكَةُ","وَٱلرُّوحُ","إِلَيۡهِ","فِي","يَوۡمٖ","كَانَ","مِقۡدَارُهُۥ","خَمۡسِينَ","أَلۡفَ","سَنَةٖ"],"та`ружул малаикату варрууху илайхи фии йаумин кана миḳдарухуу хамсиина алфа санах","Ангелы и Дух (Джибрил) восходят к Нему в течение дня, равного пятидесяти тысячам лет.",["восходят","ангелы","и Дух","к Нему","в","день","был","мера его","пятьдесят","тысяч","лет"]],[70,5,["فَٱصۡبِرۡ","صَبۡرٗا","جَمِيلًا"],"фасбир сабран жамиила","Прояви же красивое терпение.",["терпи же","терпением","прекрасным"]],[70,6,["إِنَّهُمۡ","يَرَوۡنَهُۥ","بَعِيدٗا"],"иннахум йараунахуу ба`иида","Они считают его далеким.",["поистине, они","видят его","далёким"]],[70,7,["وَنَرَىٰهُ","قَرِيبٗا"],"ванараху ḳарииба","Мы же видим, что оно близко.",["а Мы видим его","близким"]],[70,8,["يَوۡمَ","تَكُونُ","ٱلسَّمَآءُ","كَٱلۡمُهۡلِ"],"йаума такуунус самау калмухл","В тот день, когда небо станет подобно расплавленному металлу (или осадку масла; или кровавому гною),",["в день","станет","небо","как расплавленный металл"]],[70,9,["وَتَكُونُ","ٱلۡجِبَالُ","كَٱلۡعِهۡنِ"],"ватакуунул жибалу кал`ихн","а горы станут подобны шерсти,",["и станут","горы","как шерсть"]],[70,10,["وَلَا","يَسۡـَٔلُ","حَمِيمٌ","حَمِيمٗا"],"вала йас'алу хамиимун хамиима","родственник не станет расспрашивать родственника,",["и не","спросит","близкий друг","близкого друга"]]]}