{"p":569,"j":29,"a":[[70,11,["يُبَصَّرُونَهُمۡۚ","يَوَدُّ","ٱلۡمُجۡرِمُ","لَوۡ","يَفۡتَدِي","مِنۡ","عَذَابِ","يَوۡمِئِذِۭ","بِبَنِيهِ"],"йубассаруунахум йаваддул мужриму лау йафтадии мин `азаби йаумиизи бибаниих","хотя они будут видеть друг друга. Грешник пожелает откупиться от мучений того дня своими сыновьями,",["будут показаны им","пожелает","грешник","чтобы","откупился он","от","наказания","того дня","сыновьями своими"]],[70,12,["وَصَٰحِبَتِهِۦ","وَأَخِيهِ"],"васахибатихии ва'ахиих","своей супругой и своим братом,",["и супругой своей","и братом своим"]],[70,13,["وَفَصِيلَتِهِ","ٱلَّتِي","تُـٔۡوِيهِ"],"вафасиилатихил латии ту'виих","своим родом, который укрывал его,",["и родом своим","который","укрывал его"]],[70,14,["وَمَن","فِي","ٱلۡأَرۡضِ","جَمِيعٗا","ثُمَّ","يُنجِيهِ"],"ваман фил арди жамии`ан сумма йунжиих","и всеми обитателями земли, чтобы затем спастись.",["и теми, кто","на","земле","все","затем","спасло бы его"]],[70,15,["كـَلَّآۖ","إِنَّهَا","لَظَىٰ"],"калла иннаха лаза","Но нет! Это - Адское пламя,",["так нет же","поистине, это","пламя (Лаза)"]],[70,16,["نَزَّاعَةٗ","لِّلشَّوَىٰ"],"назза`атал лишшава","сдирающее кожу с головы,",["сдирающее","кожу (головы)"]],[70,17,["تَدۡعُواْ","مَنۡ","أَدۡبَرَ","وَتَوَلَّىٰ"],"тад`уу ман адбара ватавалла","зовущее тех, кто повернулся спиной и отвернулся,",["зовёт","того, кто","повернулся спиной","и отвернулся"]],[70,18,["وَجَمَعَ","فَأَوۡعَىٰٓ"],"важама`а фа'ау`а","кто копил и прятал.",["и собирал","и копил"]],[70,19,["إِنَّ","ٱلۡإِنسَٰنَ","خُلِقَ","هَلُوعًا"],"иннал инсана хулиḳа халуу`а","Воистину, человек создан нетерпеливым,",["поистине","человек","сотворён","нетерпеливым"]],[70,20,["إِذَا","مَسَّهُ","ٱلشَّرُّ","جَزُوعٗا"],"иза массахуш шарру жазуу`а","беспокойным, когда его касается беда,",["когда","коснётся его","зло","беспокойным"]],[70,21,["وَإِذَا","مَسَّهُ","ٱلۡخَيۡرُ","مَنُوعًا"],"ва'иза массахул хайру мануу`а","и скупым, когда его касается добро.",["и когда","коснётся его","добро","скупым"]],[70,22,["إِلَّ