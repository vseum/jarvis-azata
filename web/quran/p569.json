{"p":569,"j":29,"a":[[70,11,["يُبَصَّرُونَهُمۡۚ","يَوَدُّ","ٱلۡمُجۡرِمُ","لَوۡ","يَفۡتَدِي","مِنۡ","عَذَابِ","يَوۡمِئِذِۭ","بِبَنِيهِ"],"йубассаруунахум йауадду лмуджриму лау йафтадии мин `азааби йауми'изи бибаниих","хотя они будут видеть друг друга. Грешник пожелает откупиться от мучений того дня своими сыновьями,",["будут показаны им","пожелает","грешник","чтобы","откупился он","от","наказания","того дня","сыновьями своими"]],[70,12,["وَصَٰحِبَتِهِۦ","وَأَخِيهِ"],"уасаахибатихии уа'ахиих","своей супругой и своим братом,",["и супругой своей","и братом своим"]],[70,13,["وَفَصِيلَتِهِ","ٱلَّتِي","تُـٔۡوِيهِ"],"уафасиилатихи ллатии ту'уиих","своим родом, который укрывал его,",["и родом своим","который","укрывал его"]],[70,14,["وَمَن","فِي","ٱلۡأَرۡضِ","جَمِيعٗا","ثُمَّ","يُنجِيهِ"],"уаман фии л'арди джамии`ан сумма йунджиих","и всеми обитателями земли, чтобы затем спастись.",["и теми, кто","на","земле","все","затем","спасло бы его"]],[70,15,["كـَلَّآۖ","إِنَّهَا","لَظَىٰ"],"каллаа иннахаа лазаа","Но нет! Это - Адское пламя,",["так нет же","поистине, это","пламя (Лаза)"]],[70,16,["نَزَّاعَةٗ","لِّلشَّوَىٰ"],"наззаа`атал лилшшауаа","сдирающее кожу с головы,",["сдирающее","кожу (головы)"]],[70,17,["تَدۡعُواْ","مَنۡ","أَدۡبَرَ","وَتَوَلَّىٰ"],"тад`уу ман адбара уатауаллаа","зовущее тех, кто повернулся спиной и отвернулся,",["зовёт","того, кто","повернулся спиной","и отвернулся"]],[70,18,["وَجَمَعَ","فَأَوۡعَىٰٓ"],"уаджама`а фа'ау`аа","кто копил и прятал.",["и собирал","и копил"]],[70,19,["إِنَّ","ٱلۡإِنسَٰنَ","خُلِقَ","هَلُوعًا"],"инна л'инсаана хулика халуу`а","Воистину, человек создан нетерпеливым,",["поистине","человек","сотворён","нетерпеливым"]],[70,20,["إِذَا","مَسَّهُ","ٱلشَّرُّ","جَزُوعٗا"],"изаа массаху шшарру джазуу`а","беспокойным, когда его касается беда,",["когда","коснётся его","зло","беспокойным"]],[70,21,["وَإِذَا","مَسَّهُ","ٱلۡخَيۡرُ","مَنُوعًا"],"уа'изаа массаху лхайру мануу`а","и скупым, когда его касается добро.",["и когда","коснётся его","добро","скупым"]],[70,22,["إِلَّا","ٱلۡمُصَلِّينَ"],"иллаа лмусаллиин","Это не относится к молящимся,",["кроме","молящихся"]],[70,23,["ٱلَّذِينَ","هُمۡ","عَلَىٰ","صَلَاتِهِمۡ","دَآئِمُونَ"],"аллазиина хум `алаа салаатихим даа'имуун","которые регулярно совершают свой намаз,",["те, которые","они","за","молитвой своей","постоянны"]],[70,24,["وَٱلَّذِينَ","فِيٓ","أَمۡوَٰلِهِمۡ","حَقّٞ","مَّعۡلُومٞ"],"уаллазиина фии амуаалихим хаккум ма`луум","которые выделяют известную долю своего имущества",["и те, которые","в","имуществе их","право (доля)","известное"]],[70,25,["لِّلسَّآئِلِ","وَٱلۡمَحۡرُومِ"],"ллилссаа'или уалмахруум","для просящих и обездоленных,",["для просящего","и обездоленного"]],[70,26,["وَٱلَّذِينَ","يُصَدِّقُونَ","بِيَوۡمِ","ٱلدِّينِ"],"уаллазиина йусаддикууна бийауми ддиин","которые веруют в День воздаяния,",["и те, которые","признают истинным","день","воздаяния"]],[70,27,["وَٱلَّذِينَ","هُم","مِّنۡ","عَذَابِ","رَبِّهِم","مُّشۡفِقُونَ"],"уаллазиина хум ммин `азааби раббихим ммушфикуун","которые трепещут перед мучениями от своего Господа,",["и те, которые","они","перед","наказанием","Господа их","трепещущие"]],[70,28,["إِنَّ","عَذَابَ","رَبِّهِمۡ","غَيۡرُ","مَأۡمُونٖ"],"инна `азааба раббихим гайру ма'муун","ведь мучения от их Господа небезопасны,",["поистине","наказание","Господа их","не","безопасно"]],[70,29,["وَٱلَّذِينَ","هُمۡ","لِفُرُوجِهِمۡ","حَٰفِظُونَ"],"уаллазиина хум лифурууджихим хаафизуун","которые оберегают свои половые органы от всех,",["и те, которые","они","срамные места свои","хранящие"]],[70,30,["إِلَّا","عَلَىٰٓ","أَزۡوَٰجِهِمۡ","أَوۡ","مَا","مَلَكَتۡ","أَيۡمَٰنُهُمۡ","فَإِنَّهُمۡ","غَيۡرُ","مَلُومِينَ"],"иллаа `алаа азуааджихим ау маа малакат аймаанухум фа'иннахум гайру малуумиин","кроме своих жен и невольниц, которыми овладели их десницы, за что они не заслуживают порицания,",["кроме","от","жён их","или","того, чем","овладели","десницы их","то поистине, они","не","порицаемы"]],[70,31,["فَمَنِ","ٱبۡتَغَىٰ","وَرَآءَ","ذَٰلِكَ","فَأُوْلَٰٓئِكَ","هُمُ","ٱلۡعَادُونَ"],"фамани бтагаа уараа'а заалика фа'улаа'ика хуму л`аадуун","тогда как желающие сверх этого являются преступниками;",["а кто же","пожелал","сверх","этого","то те","они","преступающие"]],[70,32,["وَٱلَّذِينَ","هُمۡ","لِأَمَٰنَٰتِهِمۡ","وَعَهۡدِهِمۡ","رَٰعُونَ"],"уаллазиина хум ли'амаанаатихим уа`ахдихим раа`уун","которые сохраняют доверенное им и соблюдают договоры,",["и те, которые","они","доверенное им","и договор их","соблюдающие"]],[70,33,["وَٱلَّذِينَ","هُم","بِشَهَٰدَٰتِهِمۡ","قَآئِمُونَ"],"уаллазиина хум бишахаадаатихим каа'имуун","которые стойки в своих свидетельствах",["и те, которые","они","в свидетельствах своих","стойки"]],[70,34,["وَٱلَّذِينَ","هُمۡ","عَلَىٰ","صَلَاتِهِمۡ","يُحَافِظُونَ"],"уаллазиина хум `алаа салаатихим йухаафизуун","и которые оберегают свой намаз.",["и те, которые","они","над","молитвой своей","оберегают"]],[70,35,["أُوْلَٰٓئِكَ","فِي","جَنَّٰتٖ","مُّكۡرَمُونَ"],"улаа'ика фии джаннаатим мукрамуун","Им будет оказано почтение в Райских садах.",["те","в","садах","почитаемы"]],[70,36,["فَمَالِ","ٱلَّذِينَ","كَفَرُواْ","قِبَلَكَ","مُهۡطِعِينَ"],"фамаали ллазиина кафаруу кибалака мухти`иин","Что же с теми, которые не уверовали и бегут перед тобой",["что же с","теми, которые","не уверовали","в твою сторону","бегут (вытянув шеи)"]],[70,37,["عَنِ","ٱلۡيَمِينِ","وَعَنِ","ٱلشِّمَالِ","عِزِينَ"],"`ани лйамиини уа`ани шшимаали `изиин","толпами справа и слева?",["с","правой стороны","и с","левой стороны","толпами"]],[70,38,["أَيَطۡمَعُ","كُلُّ","ٱمۡرِيٕٖ","مِّنۡهُمۡ","أَن","يُدۡخَلَ","جَنَّةَ","نَعِيمٖ"],"айатма`у куллу мрийим минхум ан йудхала джанната на`иим","Неужели каждый из них надеется, что его введут в Сад блаженства?",["неужели надеется","каждый","человек","из них","что","будет введён","(в) Сад","блаженства"]],[70,39,["كـَلَّآۖ","إِنَّا","خَلَقۡنَٰهُم","مِّمَّا","يَعۡلَمُونَ"],"каллаа иннаа халакнаахум ммиммаа йа`ламуун","Но нет! Мы сотворили их из того, что им известно.",["Но нет!","поистине, Мы","Мы сотворили их","из того, что","они знают"]]]}