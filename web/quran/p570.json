{"p":570,"j":29,"a":[[70,40,["فَلَآ","أُقۡسِمُ","بِرَبِّ","ٱلۡمَشَٰرِقِ","وَٱلۡمَغَٰرِبِ","إِنَّا","لَقَٰدِرُونَ"],"фала уḳсиму бираббил машариḳи валмагариби инна лаḳадируун","Клянусь Господом востоков и западов! Мы способны",["Но нет,","клянусь","Господом","востоков","и западов","поистине, Мы","непременно способны"]],[70,41,["عَلَىٰٓ","أَن","نُّبَدِّلَ","خَيۡرٗا","مِّنۡهُمۡ","وَمَا","نَحۡنُ","بِمَسۡبُوقِينَ"],"`ала ан нубаддила хайрам минхум вама нахну бимасбууḳиин","заменить их теми, кто лучше них, и никто не превзойдет Нас.",["на то","чтобы","Мы заменили","лучшими","чем они","и не","Мы","опережаемы"]],[70,42,["فَذَرۡهُمۡ","يَخُوضُواْ","وَيَلۡعَبُواْ","حَتَّىٰ","يُلَٰقُواْ","يَوۡمَهُمُ","ٱلَّذِي","يُوعَدُونَ"],"фазархум йахуудуу вайал`абуу хатта йулаḳуу йаумахумул лазии йуу`адуун","Оставь же их погружаться в словоблудие и забавляться, пока они не встретят тот день их, который им обещан.",["Оставь же их","пусть погружаются","и забавляются","пока не","встретят","свой день","который","им обещан"]],[70,43,["يَوۡمَ","يَخۡرُجُونَ","مِنَ","ٱلۡأَجۡدَاثِ","سِرَاعٗا","كَأَنَّهُمۡ","إِلَىٰ","نُصُبٖ","يُوفِضُونَ"],"йаума йахружууна минал аждаси сира`ан ка'аннахум ила нусубин йууфидуун","В тот день они торопливо выйдут из могил, словно устремляясь к воздвигнутой цели (или идолам; или охотничьей сети).",["(в) день","(когда) они выйдут","из","могил","спешно","словно они","к","цели","устремляются"]],[70,44,["خَٰشِعَةً","أَبۡصَٰرُهُمۡ","تَرۡهَقُهُمۡ","ذِلَّةٞۚ","ذَٰلِكَ","ٱلۡيَوۡمُ","ٱلَّذِي","كَانُواْ","يُوعَدُونَ"],"хаши`атан абсарухум тархаḳухум зиллатун заликал йаумул лазии кануу йуу`адуун","Их взоры потупятся, и унижение покроет их. Это будет тот день, который им обещан!",["потуплены","их взоры","покроет их","унижение","Это","день","который","был","им обещан"]],[71,1,["إِنَّآ","أَرۡسَلۡنَا","نُوحًا","إِلَىٰ","قَوۡمِهِۦٓ","أَنۡ","أَنذِرۡ","قَوۡمَكَ","مِن","قَبۡلِ","أَن","يَأۡتِيَهُمۡ","عَذَابٌ","أَلِيمٞ"],"инна арсална нуухан ила ḳаумихии ан анзир ḳаумака мин ḳабли ан йа'тийахум `азабун алиим","Мы отправили Нуха (Ноя) к его народу: «Предостереги свой народ прежде, чем их постигнут мучительные страдания».",["Поистине, Мы","Мы отправили","Нуха","к","его народу","что","предостерегай","свой народ","ещё","до","того как","придёт к ним","наказание","мучительное"]],[71,2,["قَالَ","يَٰقَوۡمِ","إِنِّي","لَكُمۡ","نَذِيرٞ","مُّبِينٌ"],"ḳала йаḳауми иннии лакум назиирум мубиин","Он сказал: «О мой народ! Воистину, я для вас - предостерегающий и разъясняющий увещеватель.",["Он сказал","О мой народ","поистине, я","для вас","увещеватель","ясный"]],[71,3,["أَنِ","ٱعۡبُدُواْ","ٱللَّهَ","وَٱتَّقُوهُ","وَأَطِيعُونِ"],"ани`будуллаха ваттаḳууху ва'атии`уун","Поклоняйтесь Аллаху, бойтесь Его и повинуйтесь мне!",["чтобы","поклоняйтесь","Аллаху","и бойтесь Его","и повинуйтесь мне"]],[71,4,["يَغۡفِرۡ","لَكُم","مِّن","ذُنُوبِكُمۡ","وَيُؤَخِّرۡكُمۡ","إِلَىٰٓ","أَجَلٖ","مُّسَمًّىۚ","إِنَّ","أَجَلَ","ٱللَّهِ","إِذَا","جَآءَ","لَا","يُؤَخَّرُۚ","لَوۡ","كُنتُمۡ","تَعۡلَمُونَ"],"йагфир лакум мин зунуубикум вайуаххиркум ила ажалим мусамман инна ажалаллахи иза жаа ла йу'аххару лау кунтум та`ламуун","Он простит вам ваши грехи и предоставит вам отсрочку до назначенного срока. Воистину, когда срок Аллаха наступает, он уже не откладывается. Если бы вы только знали!».",["Он простит","вам","из","ваших грехов","и отсрочит вам","до","срока","назначенного","Поистине","срок","Аллаха","когда","придёт","не","откладывается","если бы","вы","знали"]],[71,5,["قَالَ","رَبِّ","إِنِّي","دَعَوۡتُ","قَوۡمِي","لَيۡلٗا","وَنَهَارٗا"],"ḳала рабби иннии да`ауту ḳаумии лайлан ванахара","Он сказал: «Господи! Я призывал мой народ ночью и днем,",["Он сказал","Господи","поистине, я","призывал","мой народ","ночью","и днём"]],[71,6,["فَلَمۡ","يَزِدۡهُمۡ","دُعَآءِيٓ","إِلَّا","فِرَارٗا"],"фалам йазидхум ду`аии илла фирара","но мои проповеди лишь ускорили их бегство.",["но не","прибавил им","мой призыв","кроме","бегства"]],[71,7,["وَإِنِّي","كُلَّمَا","دَعَوۡتُهُمۡ","لِتَغۡفِرَ","لَهُمۡ","جَعَلُوٓاْ","أَصَٰبِعَهُمۡ","فِيٓ","ءَاذَانِهِمۡ","وَٱسۡتَغۡشَوۡاْ","ثِيَابَهُمۡ","وَأَصَرُّواْ","وَٱسۡتَكۡبَرُواْ","ٱسۡتِكۡبَارٗا"],"ва'иннии куллама да`аутухум литагфира лахум жа`алуу асаби`ахум фии азанихим вастагшау сийабахум ва'асарруу вастакбарустикбара","Каждый раз, когда я призывал их, чтобы Ты простил их, они затыкали пальцами уши и укрывались одеждами. Они упорствовали и надменно превозносились.",["И поистине, я","всякий раз, когда","я призывал их","чтобы Ты простил","им","они вкладывали","свои пальцы","в","свои уши","и закрывались","своими одеждами","и упорствовали","и превозносились","надменно"]],[71,8,["ثُمَّ","إِنِّي","دَعَوۡتُهُمۡ","جِهَارٗا"],"сумма иннии да`аутухум жихара","Затем я призывал их открыто.",["Затем","поистине, я","призывал их","открыто"]],[71,9,["ثُمَّ","إِنِّيٓ","أَعۡلَنتُ","لَهُمۡ","وَأَسۡرَرۡتُ","لَهُمۡ","إِسۡرَارٗا"],"сумма иннии а`ланту лахум ва'асрарту лахум исрара","Затем я обращался к ним всенародно и говорил с ними наедине.",["Затем","поистине, я","объявлял","им","и тайно говорил","им","втайне"]],[71,10,["فَقُلۡتُ","ٱسۡتَغۡفِرُواْ","رَبَّكُمۡ","إِنَّهُۥ","كَانَ","غَفَّارٗا"],"фаḳултустагфируу раббакум иннахуу кана гаффара","Я говорил: «Просите у вашего Господа прощения, ведь Он - Всепрощающий.",["и я сказал","просите прощения","у вашего Господа","поистине, Он","является","Прощающим"]]],"m":[[["فَلَآ","Но нет,",70,40],["أُقۡسِمُ","клянусь",70,40],["بِرَبِّ","Господом",70,40],["ٱلۡمَشَٰرِقِ","востоков",70,40],["وَٱلۡمَغَٰرِبِ","и западов",70,40],["إِنَّا","поистине, Мы",70,40],["لَقَٰدِرُونَ","непременно способны",70,40],[40],["عَلَىٰٓ","на то",70,41],["أَن","чтобы",70,41],["نُّبَدِّلَ","Мы заменили",70,41],["خَيۡرٗا","лучшими",70,41],["مِّنۡهُمۡ","чем они",70,41]],[["وَمَا","и не",70,41],["نَحۡنُ","Мы",70,41],["بِمَسۡبُوقِينَ","опережаемы",70,41],[41],["فَذَرۡهُمۡ","Оставь же их",70,42],["يَخُوضُواْ","пусть погружаются",70,42],["وَيَلۡعَبُواْ","и забавляются",70,42],["حَتَّىٰ","пока не",70,42],["يُلَٰقُواْ","встретят",70,42],["يَوۡمَهُمُ","