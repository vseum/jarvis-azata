{"p":571,"j":29,"a":[[71,11,["يُرۡسِلِ","ٱلسَّمَآءَ","عَلَيۡكُم","مِّدۡرَارٗا"],"йурсилис самаа `алайкум мидрара","Он ниспошлет вам с неба обильные дожди,",["Он пошлёт","небо","на вас","обильным (дождём)"]],[71,12,["وَيُمۡدِدۡكُم","بِأَمۡوَٰلٖ","وَبَنِينَ","وَيَجۡعَل","لَّكُمۡ","جَنَّٰتٖ","وَيَجۡعَل","لَّكُمۡ","أَنۡهَٰرٗا"],"вайумдидкум би'амвалин вабаниина вайаж`ал лакум жаннатин вайаж`ал лакум анхара","поддержит вас имуществом и детьми, взрастит для вас сады и создаст для вас реки.",["и поддержит вас","имуществом","и сыновьями","и сделает","для вас","сады","и сделает","для вас","реки"]],[71,13,["مَّا","لَكُمۡ","لَا","تَرۡجُونَ","لِلَّهِ","وَقَارٗا"],"мма лакум ла таржууна лиллахи ваḳара","Почему вы не чтите величия Аллаха?",["Что","с вами","не","вы признаёте","за Аллахом","величия"]],[71,14,["وَقَدۡ","خَلَقَكُمۡ","أَطۡوَارًا"],"ваḳад халаḳакум атвара","Он ведь создавал вас по этапам.",["И ведь","Он сотворил вас","этапами"]],[71,15,["أَلَمۡ","تَرَوۡاْ","كَيۡفَ","خَلَقَ","ٱللَّهُ","سَبۡعَ","سَمَٰوَٰتٖ","طِبَاقٗا"],"алам тарау кайфа халаḳаллаху саб`а самаватин тибаḳа","Неужели вы не видели, как Аллах создал семь небес одно над другим,",["Разве не","видели вы","как","сотворил","Аллах","семь","небес","ярусами"]],[71,16,["وَجَعَلَ","ٱلۡقَمَرَ","فِيهِنَّ","نُورٗا","وَجَعَلَ","ٱلشَّمۡسَ","سِرَاجٗا"],"важа`алал ḳамара фиихинна нууран важа`алаш шамса сиража","сделал луну светлой, а солнце сделал светильником?",["и сделал","луну","в них","светом","и сделал","солнце","светильником"]],[71,17,["وَٱللَّهُ","أَنۢبَتَكُم","مِّنَ","ٱلۡأَرۡضِ","نَبَاتٗا"],"валлаху амбатакум минал арди набата","Аллах вырастил вас из земли, словно растения.",["И Аллах","вырастил вас","из","земли","растением"]],[71,18,["ثُمَّ","يُعِيدُكُمۡ","فِيهَا","وَيُخۡرِجُكُمۡ","إِخۡرَاجٗا"],"сумма йу`иидукум фииха вайухрижукум ихража","Потом Он вернет вас туда и вновь выведет оттуда.",["затем","Он вернет вас","в нее","и выведет вас","выведением"]],[71,19,["وَٱللَّهُ","جَعَلَ","لَكُمُ","ٱلۡأَرۡضَ","بِسَاطٗا"],"валлаху жа`ала лакумул арда бисата","Аллах сделал для вас землю ковром,",["И Аллах","сделал","для вас","землю","ковром"]],[71,20,["لِّتَسۡلُكُواْ","مِنۡهَا","سُبُلٗا","فِجَاجٗا"],"ллитаслукуу минха субулан фижажа","чтобы вы ходили по ней широкими дорогами»».",["чтобы вы ходили","по ней","дорогами","широкими"]],[71,21,["قَالَ","نُوحٞ","رَّبِّ","إِنَّهُمۡ","عَصَوۡنِي","وَٱتَّبَعُواْ","مَن","لَّمۡ","يَزِدۡهُ","مَالُهُۥ","وَوَلَدُهُۥٓ","إِلَّا","خَسَارٗا"],"ḳала нуухур рабби иннахум `асаунии ваттаба`уу мал лам йазидху малухуу ваваладухуу илла хасара","Нух (Ной) сказал: «Господи! Они ослушались меня и последовали за тем, чье богатство и чьи дети приносят им только убыток.",["Сказал","Нух","Господи","поистине, они","ослушались меня","и последовали","(за) тем, кому","не","прибавило ему","его богатство","и его дети","кроме","убытка"]],[71,22,["وَمَكَرُواْ","مَكۡرٗا","كُبَّارٗا"],"вамакаруу макран куббара","Они замыслили тяжкую хитрость",["И они хитрили","хитростью","огромной"]],[71,23,["وَقَالُواْ","لَا","تَذَرُنَّ","ءَالِهَتَكُمۡ","وَلَا","تَذَرُنَّ","وَدّٗا","وَلَا","سُوَاعٗا","وَلَا","يَغُوثَ","وَيَعُوقَ","وَنَسۡرٗا"],"ваḳалуу ла тазарунна алихатакум вала тазарунна ваддан вала суа`ан вала йагууса вайа`ууḳа ванасра","и сказали: «Не отрекайтесь от ваших богов: Вадда, Сувы, Йагуса, Йаука и Насра».",["И они сказали","не","оставляйте","ваших богов","и не","оставляйте","Вадда","и не","Сувы","и не","Йагуса","и Йаука","и Насра"]],[71,24,["وَقَدۡ","أَضَلُّواْ","كَثِيرٗاۖ","وَلَا","تَزِدِ","ٱلظَّٰلِمِينَ","إِلَّا","ضَلَٰلٗا"],"ваḳад адаллуу касииран вала тазидиз залимиина илла далала","Они уже ввели в заблуждение многих. Не приумножай же беззаконникам ничего, кроме заблуждения!».",["И уже","они сбили с пути","многих","и не","прибавляй","беззаконникам","кроме","заблуждения"]],[71,25,["مِّمَّا","خَطِيٓـَٰٔتِهِمۡ","أُغۡرِقُواْ","فَأُدۡخِلُواْ","نَارٗا","فَلَمۡ","يَجِدُواْ","لَهُم","مِّن","دُونِ","ٱللَّهِ","أَنصَارٗا"],"ммимма хатииатихим угриḳуу фа'удхилуу наран фалам йажидуу лахум мин дууниллахи ансара","За свои грехи они были потоплены и ввергнуты в Огонь. Они не нашли себе помощников вместо Аллаха.",["Из-за","их грехов","они были потоплены","и были введены","(в) Огонь","и не","они нашли","для себя","из","помимо","Аллаха","помощников"]],[71,26,["وَقَالَ","نُوحٞ","رَّبِّ","لَا","تَذَرۡ","عَلَى","ٱلۡأَرۡضِ","مِنَ","ٱلۡكَٰفِرِينَ","دَيَّارًا"],"ваḳала нуухур рабби ла тазар `алал арди минал кафириина даййара","Нух (Ной) сказал: «Господи! Не оставь на земле ни одного неверующего жителя!",["И сказал","Нух","Господи","не","оставляй","на","земле","из","неверующих","(ни одного) жителя"]],[71,27,["إِنَّكَ","إِن","تَذَرۡهُمۡ","يُضِلُّواْ","عِبَادَكَ","وَلَا","يَلِدُوٓاْ","إِلَّا","فَاجِرٗا","كَفَّارٗا"],"иннака ин тазархум йудиллуу `ибадака вала йалидуу илла фажиран каффара","Если ты оставишь их, они введут в заблуждение Твоих рабов и породят только грешных неверующих.",["Поистине, Ты","если","Ты оставишь их","они собьют с пути","Твоих рабов","и не","они родят","кроме","нечестивца","неверующего"]],[71,28,["رَّبِّ","ٱغۡفِرۡ","لِي","وَلِوَٰلِدَيَّ","وَلِمَن","دَخَلَ","بَيۡتِيَ","مُؤۡمِنٗا","وَلِلۡمُؤۡمِنِينَ","وَٱلۡمُؤۡمِنَٰتِۖ","وَلَا","تَزِدِ","ٱلظَّٰلِمِينَ","إِلَّا","تَبَارَۢا"],"рраббигфир лии валивалидаййа валиман дахала байтийа му'минан валилму'миниина валму'минати вала тазидиз залимиина илла табара","Господи! Прости меня и моих родителей и тех, кто вошел в мой дом верующим, а также верующих мужчин и женщин. А беззаконникам не приумножай ничего, кроме погибели!».",["Господи","прости","мне","и моим родителям","и тому, кто","вошёл","в мой дом","верующим","и верующим мужчинам","и верующим женщинам","и не","прибавляй","беззаконникам","кроме","погибели"]]],"m":[[["يُرۡسِلِ","Он пошлёт",71,11],["ٱلسَّمَآءَ","небо",71,11],["عَلَيۡكُم","на вас",71,11],["مِّدۡرَارٗا","обильным (дождём)",71,11],[11],["وَيُمۡدِدۡكُم","и поддержит вас",71,12],["بِأَمۡوَٰلٖ","имуществом",71,12],["وَبَنِينَ","и сыновьями",71,12],["وَيَجۡعَل","и сделает",71,12]],[["لَّكُمۡ","для вас",71,12],["جَنَّٰتٖ","сады",71,12],["وَيَجۡعَل","и сделает",71,12],["لَّكُمۡ","для вас",71,12],["أَنۡهَٰرٗا","реки",71,12],[12],["مَّا","Что",71,13],["لَكُمۡ","с вами",71,13],["لَا","не",71,13],["تَرۡجُونَ","вы признаёте",71,13],["لِلَّهِ","за Аллахом",71,13],["وَقَارٗا","величия",71,13],[13]],[["وَقَدۡ","И ведь",71,14],["خَلَقَكُمۡ","Он сотворил вас",71,14],["أَطۡوَارًا","этапами",71,14],[14],["أَلَمۡ","Разве не",71,15],["تَرَوۡاْ","видели вы",71,15],["كَيۡفَ","как",71,15],["خَلَقَ","сотворил",71,15],["ٱللَّهُ","Аллах",71,15],["سَبۡعَ","семь",71,15],["سَمَٰوَٰتٖ","небес",71,15]],[["طِبَاقٗا","ярусами",71,15],[15],["وَجَعَلَ","и сделал",71,16],["ٱلۡقَمَرَ","луну",71,16],["فِيهِنَّ","в них",71,16],["نُورٗا","светом",71,16],["وَجَعَلَ","и сделал",71,16],["ٱلشَّمۡسَ","солнце",71,16],["سِرَاجٗا","светильником",71,16],[16]],[["وَٱللَّهُ","И Аллах",71,17],["أَنۢبَتَكُم","вырастил вас",71,17],["مِّنَ","из",71,17],["ٱلۡأَرۡضِ","земли",71,17],["نَبَاتٗا","растением",71,17],[17],["ثُمَّ","затем",71,18],["يُعِيدُكُمۡ","Он вернет вас",71,18],["فِيهَا","в нее",71,18],["وَيُخۡرِجُكُمۡ","и выведет вас",71,18]],[["إِخۡرَاجٗا","выведением",71,18],[18],["وَٱللَّهُ","И Аллах",71,19],["جَعَلَ","сделал",71,19],["لَكُمُ","для вас",71,19],["ٱلۡأَرۡضَ","землю",71,19],["بِسَاطٗا","ковром",71,19],[19],["لِّتَسۡلُكُواْ","чтобы вы ходили",71,20],["مِنۡهَا","по ней",71,20]],[["سُبُلٗا","дорогами",71,20],["فِجَاجٗا","широкими",71,20],[20],["قَالَ","Сказал",71,21],["نُوحٞ","Нух",71,21],["رَّبِّ","Господи",71,21],["إِنَّهُمۡ","поистине, они",71,21],["عَصَوۡنِي","ослушались меня",71,21],["وَٱتَّبَعُواْ","и последовали",71,21],["مَن","(за) тем, кому",71,21],["لَّمۡ","не",71,21],["يَزِدۡهُ","прибавило ему",71,21]],[["مَالُهُۥ","его богатство",71,21],["وَوَلَدُهُۥٓ","и его дети",71,21],["إِلَّا","кроме",71,21],["خَسَارٗا","убытка",71,21],[21],["وَمَكَرُواْ","И они хитрили",71,22],["مَكۡرٗا","хитростью",71,22],["كُبَّارٗا","огромной",71,22],[22],["وَقَالُواْ","И они сказали",71,23]],[["لَا","не",71,23],["تَذَرُنَّ","оставляйте",71,23],["ءَالِهَتَكُمۡ","ваших богов",71,23],["وَلَا","и не",71,23],["تَذَرُنَّ","оставляйте",71,23],["وَدّٗا","Вадда",71,23],["وَلَا","и не",71,23],["سُوَاعٗا","Сувы",71,23],["وَلَا","и не",71,23],["يَغُوثَ","Йагуса",71,23],["وَيَعُوقَ","и Йаука",71,23]],[["وَنَسۡرٗا","и Насра",71,23],[23],["وَقَدۡ","И уже",71,24],["أَضَلُّواْ","они сбили с пути",71,24],["كَثِيرٗاۖ","многих",71,24],["وَلَا","и не",71,24],["تَزِدِ","прибавляй",71,24],["ٱلظَّٰلِمِينَ","беззаконникам",71,24],["إِلَّا","кроме",71,24],["ضَلَٰلٗا","заблуждения",71,24],[24]],[["مِّمَّا","Из-за",71,25],["خَطِيٓـَٰٔتِهِمۡ","их грехов",71,25],["أُغۡرِقُواْ","они были потоплены",71,25],["فَأُدۡخِلُواْ","и были введены",71,25],["نَارٗا","(в) Огонь",71,25],["فَلَمۡ","и не",71,25],["يَجِدُواْ","они нашли",71,25],["لَهُم","для себя",71,25],["مِّن","из",71,25],["دُونِ","помимо",71,25]],[["ٱللَّهِ","Аллаха",71,25],["أَنصَارٗا","помощников",71,25],[25],["وَقَالَ","И сказал",71,26],["نُوحٞ","Нух",71,26],["رَّبِّ","Господи",71,26],["لَا","не",71,26],["تَذَرۡ","оставляй",71,26],["عَلَى","на",71,26],["ٱلۡأَرۡضِ","земле",71,26],["مِنَ","из",71,26],["ٱلۡكَٰفِرِينَ","неверующих",71,26]],[["دَيَّارًا","(ни одного) жителя",71,26],[26],["إِنَّكَ","Поистине, Ты",71,27],["إِن","если",71,27],["تَذَرۡهُمۡ","Ты оставишь их",71,27],["يُضِلُّواْ","они собьют с пути",71,27],["عِبَادَكَ","Твоих рабов",71,27],["وَلَا","и не",71,27],["يَلِدُوٓاْ","они родят",71,27],["إِلَّا","кроме",71,27],["فَاجِرٗا","нечестивца",71,27]],[["كَفَّارٗا","неверующего",71,27],[27],["رَّبِّ","Господи",71,28],["ٱغۡفِرۡ","прости",71,28],["لِي","мне",71,28],["وَلِوَٰلِدَيَّ","и моим родителям",71,28],["وَلِمَن","и тому, кто",71,28],["دَخَلَ","вошёл",71,28],["بَيۡتِيَ","в мой дом",71,28]],[["مُؤۡمِنٗا","верующим",71,28],["وَلِلۡمُؤۡمِنِينَ","и верующим мужчинам",71,28],["وَٱلۡمُؤۡمِنَٰتِۖ","и верующим женщинам",71,28],["وَلَا","и не",71,28],["تَزِدِ","прибавляй",71,28],["ٱلظَّٰلِمِينَ","беззаконникам",71,28],["إِلَّا","кроме",71,28]