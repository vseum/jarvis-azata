{"p":572,"j":29,"a":[[72,1,["قُلۡ","أُوحِيَ","إِلَيَّ","أَنَّهُ","ٱسۡتَمَعَ","نَفَرٞ","مِّنَ","ٱلۡجِنِّ","فَقَالُوٓاْ","إِنَّا","سَمِعۡنَا","قُرۡءَانًا","عَجَبٗا"],"ḳул уухийа илаййа аннахустама`а нафарум минал жинни фаḳалуу инна сами`на ḳур'анан `ажаба","Скажи: «Мне было открыто, что несколько джиннов послушали чтение Корана и сказали: «Воистину, мы слышали удивительный Коран.",["Скажи","было внушено","мне","что","прислушалась","группа","из","джиннов","и они сказали","поистине, мы","слышали","Коран","удивительный"]],[72,2,["يَهۡدِيٓ","إِلَى","ٱلرُّشۡدِ","فَـَٔامَنَّا","بِهِۦۖ","وَلَن","نُّشۡرِكَ","بِرَبِّنَآ","أَحَدٗا"],"йахдии илар рушди фа'аманна бихии валан нушрика бираббина ахада","Он наставляет на прямой путь, и мы уверовали в него и не будем приобщать сотоварищей к нашему Господу.",["Он ведёт","к","правильному пути","и мы уверовали","в него","и никогда не","мы приобщим","к нашему Господу","никого"]],[72,3,["وَأَنَّهُۥ","تَعَٰلَىٰ","جَدُّ","رَبِّنَا","مَا","ٱتَّخَذَ","صَٰحِبَةٗ","وَلَا","وَلَدٗا"],"ва'аннахуу та`ала жадду раббина маттахаза сахибатан вала валада","Величие (или богатство) нашего Господа превысокое, и Он не взял Себе ни супруги, ни сына.",["И что (поистине)","превыше","величие","нашего Господа","не","Он взял","супругу","и не","сына"]],[72,4,["وَأَنَّهُۥ","كَانَ","يَقُولُ","سَفِيهُنَا","عَلَى","ٱللَّهِ","شَطَطٗا"],"ва'аннахуу кана йаḳуулу сафиихуна `алаллахи шатата","Глупец среди нас (Иблис) наговаривал на Аллаха чрезмерное.",["И что (поистине)","бывало","говорил","глупец наш","на","Аллаха","несусветное"]],[72,5,["وَأَنَّا","ظَنَنَّآ","أَن","لَّن","تَقُولَ","ٱلۡإِنسُ","وَٱلۡجِنُّ","عَلَى","ٱللَّهِ","كَذِبٗا"],"ва'анна зананна ал лан таḳуулал инсу валжинну `алаллахи казиба","Мы же думали, что ни люди, ни джинны не станут говорить об Аллахе ложь.",["И что мы","думали","что","никогда не","скажут","люди","и джинны","на","Аллаха","ложь"]],[72,6,["وَأَنَّهُۥ","كَانَ","رِجَالٞ","مِّنَ","ٱلۡإِنسِ","يَعُوذُونَ","بِرِجَالٖ","مِّنَ","ٱلۡجِنِّ","فَزَادُوهُمۡ","رَهَقٗا"],"ва'аннахуу кана рижалум минал инси йа`уузууна бирижалим минал жинни фазадуухум рахаḳа","Мужи из числа людей искали покровительства мужей из числа джиннов, но они только увеличивали в них страх (или беззаконие).",["И что (поистине)","были","мужи","из","людей","искавшие защиты","у мужей","из","джиннов","и они прибавили им","тягости"]],[72,7,["وَأَنَّهُمۡ","ظَنُّواْ","كَمَا","ظَنَنتُمۡ","أَن","لَّن","يَبۡعَثَ","ٱللَّهُ","أَحَدٗا"],"ва'аннахум заннуу кама занантум ал лан йаб`асаллаху ахада","Они думали так же, как и вы, что Аллах никого не воскресит.",["И что они","думали","как","вы думали","что","никогда не","воскресит","Аллах","никого"]],[72,8,["وَأَنَّا","لَمَسۡنَا","ٱلسَّمَآءَ","فَوَجَدۡنَٰهَا","مُلِئَتۡ","حَرَسٗا","شَدِيدٗا","وَشُهُبٗا"],"ва'анна ламаснас самаа фаважаднаха мулиат харасан шадиидан вашухуба","Мы достигли неба, но обнаружили, что оно заполнено суровыми стражами и пылающими огнями.",["И что мы","коснулись","неба","и нашли его","наполненным","стражей","суровой","и пылающими огнями"]],[72,9,["وَأَنَّا","كُنَّا","نَقۡعُدُ","مِنۡهَا","مَقَٰعِدَ","لِلسَّمۡعِۖ","فَمَن","يَسۡتَمِعِ","ٱلۡأٓنَ","يَجِدۡ","لَهُۥ","شِهَابٗا","رَّصَدٗا"],"ва'анна кунна наḳ`уду минха маḳа`ида лиссам`и фаман йастами`ил ана йажид лахуу шихабар расада","Прежде мы садились там на седалищах, чтобы подслушивать. Но тот, кто подслушает сейчас, обнаружит, что его подстерегает пылающий огонь.",["И что мы","бывало","садились","в нём","на местах","для подслушивания","но кто","подслушает","теперь","найдёт","для себя","пылающий огонь","подстерегающий"]],[72,10,["وَأَنَّا","لَا","نَدۡرِيٓ","أَشَرٌّ","أُرِيدَ","بِمَن","فِي","ٱلۡأَرۡضِ","أَمۡ","أَرَادَ","بِهِمۡ","رَبُّهُمۡ","رَشَدٗا"],"ва'анна ла надрии ашаррун уриида биман фил арди ам арада бихим раббухум рашада","Мы не знаем, зло ли задумано для тех, кто на земле, или Господь пожелал направить их на прямой путь.",["И что мы","не","мы знаем","зло ли","задумано","для тех, кто","на","земле","или","пожелал","для них","их Господь","правильного пути"]],[72,11,["وَأَنَّا","مِنَّا","ٱلصَّٰلِحُونَ","وَمِنَّا","دُونَ","ذَٰلِكَۖ","كُنَّا","طَرَآئِقَ","قِدَدٗا"],"ва'анна миннас салихууна ваминна дууна залика кунна тараиḳа ḳидада","Среди нас есть праведные и те, которые ниже этого. Мы были разрозненными группами.",["И что мы","среди нас","праведные","и среди нас","ниже","этого","мы были","путями","разными"]],[72,12,["وَأَنَّا","ظَنَنَّآ","أَن","لَّن","نُّعۡجِزَ","ٱللَّهَ","فِي","ٱلۡأَرۡضِ","وَلَن","نُّعۡجِزَهُۥ","هَرَبٗا"],"ва'анна зананна ал лан ну`жизаллаха фил арди валан ну`жизахуу хараба","Мы знали, что не спасемся от Аллаха на земле и не спасемся от Него бегством.",["И что мы","убедились","что","никогда не","ускользнём от","Аллаха","на","земле","и никогда не","ускользнём от Него","бегством"]],[72,13,["وَأَنَّا","لَمَّا","سَمِعۡنَا","ٱلۡهُدَىٰٓ","ءَامَنَّا","بِهِۦۖ","فَمَن","يُؤۡمِنۢ","بِرَبِّهِۦ","فَلَا","يَخَافُ","بَخۡسٗا","وَلَا","رَهَقٗا"],"ва'анна ламма сами`нал худа аманна бихии фаман йу'мим бираббихии фала йахафу бахсан вала рахаḳа","Когда же мы услышали верное руководство, то уверовали в него. А тот, кто верует в своего Господа, не должен бояться ни обиды, ни притеснения.",["И что мы","когда","мы услышали","руководство","мы уверовали","в него","И кто","уверует","в своего Господа","то не","он боится","ущерба","и не","притеснения"]]],"m":[["h",72],["b"],[["قُلۡ","Скажи",72,1],["أُوحِيَ","было внушено",72,1],["إِلَيَّ","мне",72,1],["أَنَّهُ","что",72,1],["ٱسۡتَمَعَ","прислушалась",72,1],["نَفَرٞ","группа",72,1],["مِّنَ","из",72,1],["ٱلۡجِنِّ","джиннов",72,1],["فَقَالُوٓاْ","и они сказали",72,1],["إِنَّا","поистине, мы",72,1],["سَمِعۡنَا","слышали",72,1],["قُرۡءَانًا","Коран",72,1]],[["عَجَبٗا","удивительный",72,1],[1],["يَهۡدِيٓ","Он ведёт",72,2],["إِلَى","к",72,2],["ٱلرُّشۡدِ","правильному пути",72,2],["فَـَٔامَنَّا","и мы уверовали",72,2],["بِهِۦۖ","в него",72,2],["وَلَن","и никогда не",72,2],["نُّشۡرِكَ","мы приобщим",72,2],["بِرَبِّنَآ","к нашему Господу",72,2],["أَحَدٗا","никого",72,2],[