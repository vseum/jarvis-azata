{"p":573,"j":29,"a":[[72,14,["وَأَنَّا","مِنَّا","ٱلۡمُسۡلِمُونَ","وَمِنَّا","ٱلۡقَٰسِطُونَۖ","فَمَنۡ","أَسۡلَمَ","فَأُوْلَٰٓئِكَ","تَحَرَّوۡاْ","رَشَدٗا"],"ва'анна миннал муслимууна ваминнал ḳаситууна фаман аслама фа'улаика тахаррау рашада","Среди нас есть мусульмане и уклонившиеся. Те, которые стали мусульманами, последовали прямым путем.",["И что мы","среди нас","покорившиеся","и среди нас","уклонившиеся","И кто","покорился","то те","стремились","к правильному пути"]],[72,15,["وَأَمَّا","ٱلۡقَٰسِطُونَ","فَكَانُواْ","لِجَهَنَّمَ","حَطَبٗا"],"ва'аммал ḳаситууна факануу лижаханнама хатаба","Уклонившиеся же будут дровами для Геенны»».",["А что до","уклонившихся","то они будут","для Геенны","дровами"]],[72,16,["وَأَلَّوِ","ٱسۡتَقَٰمُواْ","عَلَى","ٱلطَّرِيقَةِ","لَأَسۡقَيۡنَٰهُم","مَّآءً","غَدَقٗا"],"ва'аллавистаḳамуу `алат тарииḳати ла'асḳайнахум маан гадаḳа","Если бы они устояли на прямом пути, то Мы напоили бы их водой вволю,",["И что если бы","устояли они","на","пути","непременно Мы напоили бы их","водой","обильной"]],[72,17,["لِّنَفۡتِنَهُمۡ","فِيهِۚ","وَمَن","يُعۡرِضۡ","عَن","ذِكۡرِ","رَبِّهِۦ","يَسۡلُكۡهُ","عَذَابٗا","صَعَدٗا"],"ллинафтинахум фиихи ваман йу`рид `ан зикри раббихии йаслукху `азабан са`ада","чтобы этим подвергнуть их испытанию. А тех, кто отвращается от Напоминания своего Господа, Он ввергает в тяжкие мучения.",["чтобы Нам испытать их","в этом","И кто","отвернётся","от","поминания","своего Господа","Он введёт его","(в) наказание","тяжкое"]],[72,18,["وَأَنَّ","ٱلۡمَسَٰجِدَ","لِلَّهِ","فَلَا","تَدۡعُواْ","مَعَ","ٱللَّهِ","أَحَدٗا"],"ва'аннал масажида лиллахи фала тад`уу ма`аллахи ахада","Мечети принадлежат Аллаху. Не взывайте же ни к кому наряду с Аллахом.",["И что","мечети","Аллаху","так не","взывайте","с","Аллахом","ни к кому"]],[72,19,["وَأَنَّهُۥ","لَمَّا","قَامَ","عَبۡدُ","ٱللَّهِ","يَدۡعُوهُ","كَادُواْ","يَكُونُونَ","عَلَيۡهِ","لِبَدٗا"],"ва'аннахуу ламма ḳама `абдуллахи йад`ууху кадуу йакуунууна `алайхи либада","Когда раб Аллаха встал, обращаясь с мольбой к Нему, они столпились вокруг него (джинны столпились вокруг Пророка, чтобы послушать Коран, или неверующие ополчились против него, чтобы помешать ему).",["И что (поистине)","когда","встал","раб","Аллаха","взывая к Нему","они чуть не","стали","вокруг него","толпой"]],[72,20,["قُلۡ","إِنَّمَآ","أَدۡعُواْ","رَبِّي","وَلَآ","أُشۡرِكُ","بِهِۦٓ","أَحَدٗا"],"ḳул иннама ад`уу раббии вала ушрику бихии ахада","Скажи: «Я взываю только к своему Господу и никого не приобщаю в сотоварищи к Нему».",["Скажи","лишь","я взываю","к моему Господу","и не","я приобщаю","к Нему","никого"]],[72,21,["قُلۡ","إِنِّي","لَآ","أَمۡلِكُ","لَكُمۡ","ضَرّٗا","وَلَا","رَشَدٗا"],"ḳул иннии ла амлику лакум дарран вала рашада","Скажи: «Не в моей власти навредить вам или наставить вас на прямой путь».",["скажи","поистине, я","не","владею","для вас","вредом","и не","прямым путем"]],[72,22,["قُلۡ","إِنِّي","لَن","يُجِيرَنِي","مِنَ","ٱللَّهِ","أَحَدٞ","وَلَنۡ","أَجِدَ","مِن","دُونِهِۦ","مُلۡتَحَدًا"],"ḳул иннии лан йужиирании миналлахи ахадун валан ажида мин дуунихии мултахада","Скажи: «Никто не защитит меня от Аллаха, и мне не найти помимо Него прибежища.",["Скажи","поистине, я","никогда не","защитит меня","от","Аллаха","никто","и никогда не","я найду","из","помимо Него","прибежища"]],[72,23,["إِلَّا","بَلَٰغٗا","مِّنَ","ٱللَّهِ","وَرِسَٰلَٰتِهِۦۚ","وَمَن","يَعۡصِ","ٱللَّهَ","وَرَسُولَهُۥ","فَإِنَّ","لَهُۥ","نَارَ","جَهَنَّمَ","خَٰلِدِينَ","فِيهَآ","أَبَدًا"],"илла балагам миналлахи варисалатихии ваман йа`силлаха варасуулахуу фа'инна лахуу нара жаханнама халидиина фииха абада","Мне остается лишь доносить истину от Аллаха и Его послания. Кто же ослушается Аллаха и Его Посланника, тому уготован огонь Геенны, в котором они пребудут вечно».",["кроме","донесения","от","Аллаха","и Его посланий","И кто","ослушается","Аллаха","и Его Посланника","то поистине","для него","огонь","Геенны","вечно пребывающими","в нём","навеки"]],[72,24,["حَتَّىٰٓ","إِذَا","رَأَوۡاْ","مَا","يُوعَدُونَ","فَسَيَعۡلَمُو