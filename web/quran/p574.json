{"p":574,"j":29,"a":[[73,1,["يَٰٓأَيُّهَا","ٱلۡمُزَّمِّلُ"],"йа'аййухал муззаммил","О закутавшийся!",["О","закутавшийся"]],[73,2,["قُمِ","ٱلَّيۡلَ","إِلَّا","قَلِيلٗا"],"ḳумил лайла илла ḳалиила","Простаивай ночь без малого,",["Простаивай","ночь","кроме","немногого"]],[73,3,["نِّصۡفَهُۥٓ","أَوِ","ٱنقُصۡ","مِنۡهُ","قَلِيلًا"],"ннисфахуу авинḳус минху ḳалиила","половину ночи или чуть меньше того,",["половину её","или","убавь","от неё","немного"]],[73,4,["أَوۡ","زِدۡ","عَلَيۡهِ","وَرَتِّلِ","ٱلۡقُرۡءَانَ","تَرۡتِيلًا"],"ау зид `алайхи вараттилил ḳур'ана тартиила","или чуть больше того, и читай Коран размеренным чтением.",["или","прибавь","к ней","и читай","Коран","размеренным чтением"]],[73,5,["إِنَّا","سَنُلۡقِي","عَلَيۡكَ","قَوۡلٗا","ثَقِيلًا"],"инна санулḳии `алайка ḳаулан саḳиила","Мы непременно ниспошлем тебе весомые слова.",["Поистине, Мы","Мы возложим","на тебя","слово","тяжёлое"]],[73,6,["إِنَّ","نَاشِئَةَ","ٱلَّيۡلِ","هِيَ","أَشَدُّ","وَطۡـٔٗا","وَأَقۡوَمُ","قِيلًا"],"инна нашиатал лайли хийа ашадду ват'ан ва'аḳваму ḳиила","Воистину, молитвы после пробуждения среди ночи тяжелее и яснее по изложению.",["поистине","вставание","ночью","оно","сильнее","по воздействию","и вернее","по слову"]],[73,7,["إِنَّ","لَكَ","فِي","ٱلنَّهَارِ","سَبۡحٗا","طَوِيلٗا"],"инна лака фин нахари сабхан тавиила","Воистину, днем ты бываешь подолгу занят.",["поистине","у тебя","в","дне","занятие","долгое"]],[73,8,["وَٱذۡكُرِ","ٱسۡمَ","رَبِّكَ","وَتَبَتَّلۡ","إِلَيۡهِ","تَبۡتِيلٗا"],"вазкурисма раббика ватабаттал илайхи табтиила","Поминай же имя Господа твоего и посвяти себя Ему полностью.",["и поминай","имя","Господа твоего","и посвяти себя","Ему","всецело"]],[73,9,["رَّبُّ","ٱلۡمَشۡرِقِ","وَٱلۡمَغۡرِبِ","لَآ","إِلَٰهَ","إِلَّا","هُوَ","فَٱتَّخِذۡهُ","وَكِيلٗا"],"рраббул машриḳи валмагриби ла илаха илла хуа фаттахизху вакиила","Господь востока и запада - нет божества, кроме Него. Сделай же Его своим Попечителем и Хранителем.",["Господь","востока","и запада","нет","божества","кроме","Него","так возьми Его","Попечителем"]],[73,10,["وَٱصۡبِرۡ","عَلَىٰ","مَا","يَقُولُونَ","وَٱهۡجُرۡهُمۡ","هَجۡرٗا","جَمِيلٗا"],"васбир `ала ма йаḳуулууна вахжурхум хажран жамиила","Терпимо относись к их словам и сторонись их красиво.",["и терпи","на","то, что","говорят","и оставь их","оставлением","прекрасным"]],[73,11,["وَذَرۡنِي","وَٱلۡمُكَذِّبِينَ","أُوْلِي","ٱلنَّعۡمَةِ","وَمَهِّلۡهُمۡ","قَلِيلًا"],"вазарнии валмуказзибиина улин на`мати вамаххилхум ḳалиила","Оставь Меня с теми, кто считает истину ложью, но пользуется мирскими благами, и предоставь им небольшую отсрочку.",["и оставь Меня","и отвергающих","обладателей","благ","и дай им отсрочку","немного"]],[73,12,["إِنَّ","لَدَيۡنَآ","أَنكَالٗا","وَجَحِيمٗا"],"инна ладайна анкалан важахиима","Воистину, есть у Нас оковы и Ад,",["поистине","у Нас","оковы","и Ад"]],[73,13,["وَطَعَامٗا","ذَا","غُصَّةٖ","وَعَذَابًا","أَلِيمٗا"],"вата`аман за гуссатин ва`азабан алиима","еда, которой давятся, и мучительные страдания.",["и пища","с","застреванием в горле","и наказание","мучительное"]],[73,14,["يَوۡمَ","تَرۡجُفُ","ٱلۡأَرۡضُ","وَٱلۡجِبَالُ","وَكَانَتِ","ٱلۡجِبَالُ","كَثِيبٗا","مَّهِيلًا"],"йаума таржуфул арду валжибалу ваканатил жибалу касиибам махиила","В тот день земля и горы сотрясутся, и горы превратятся в холмы сыпучего песка.",["в день, когда","сотрясётся","земля","и горы","и станут","горы","песчаным холмом","сыпучим"]],[73,15,["إِنَّآ","أَرۡسَلۡنَآ","إِلَيۡكُمۡ","رَسُولٗا","شَٰهِدًا","عَلَيۡكُمۡ","كَمَآ","أَرۡسَلۡنَآ","إِلَىٰ","فِرۡعَوۡنَ","رَسُولٗا"],"инна арсална илайкум расуулан шахидан `алайкум кама арсална ила фир`ауна расуула","Мы отправили к вам Посланника свидетелем против вас, подобно тому, как отправили посланника к Фараону.",["поистине, Мы","Мы отправили","к вам","посланника","свидетелем","над вами","как","Мы отправили","к","Фараону","посланника"]],[73,16,["فَعَصَىٰ","فِرۡعَوۡنُ","ٱلرَّسُولَ","فَأَخَذۡنَٰهُ","أَخۡذٗا","وَبِيلٗا"],"фа`аса фир`аунур расуула фа'ахазнаху ахзан вабиила","Фараон ослушался посланника, и Мы схватили его Хваткой суровой.",["и ослушался","Фараон","посланника","и Мы схватили его","хваткой","тяжкой"]],[73,17,["فَكَيۡفَ","تَتَّقُونَ","إِن","كَفَرۡتُمۡ","يَوۡمٗا","يَجۡعَلُ","ٱلۡوِلۡدَٰنَ","شِيبًا"],"факайфа таттаḳууна ин кафартум йауман йаж`алул вилдана шииба","Как же вы спасетесь, если не уверуете, в тот день, который заставит поседеть младенцев?",["так как же","вы убережётесь","если","вы не уверовали","в день","который сделает","детей","седыми"]],[73,18,["ٱلسَّمَآءُ","مُنفَطِرُۢ","بِهِۦۚ","كَانَ","وَعۡدُهُۥ","مَفۡعُولًا"],"ассамау мунфатиру бихии кана ва`духуу маф`уула","Небо тогда будет расколото, и обещание Его непременно исполнится.",["небо","расколется","от него","было","обещание Его","исполненным"]],[73,19,["إِنَّ","هَٰذِهِۦ","تَذۡكِرَةٞۖ","فَمَن","شَآءَ","ٱتَّخَذَ","إِلَىٰ","رَبِّهِۦ","سَبِيلًا"],"инна хазихии тазкиратун фаман шааттахаза ила раббихии сабиила","Воистину, это - Назидание, и всякий, кто пожелает, встанет на путь к своему Господу.",["поистине","это","напоминание","и кто","пожелал","возьмёт","к","Господу своему","путь"]]],"m":[["h",73],["b"],[["يَٰٓأَيُّهَا","О",73,1],["ٱلۡمُزَّمِّلُ","закутавшийся",73,1],[1],["قُمِ","Простаивай",73,2],["ٱلَّيۡلَ","ночь",73,2],["إِلَّا","кроме",73,2],["قَلِيلٗا","немногого",73,2],[2],["نِّصۡفَهُۥٓ","половину её",73,3],["أَوِ","или",73,3],["ٱنقُصۡ","убавь",73,3],["مِنۡهُ","от неё",73,3],["قَلِيلًا","немного",73,3]],[[3],["أَوۡ","или",73,4],["زِدۡ","прибавь",73,4],["عَلَيۡهِ","к ней",73,4],["وَرَتِّلِ","и читай",73,4],["ٱلۡقُرۡءَانَ","Коран",73,4],["تَرۡتِيلًا","размеренным чтением",73,4],[4],["إِنَّا","Поистине, Мы",73,5],["سَنُلۡقِي","Мы возложим",73,5],["عَلَيۡكَ","на тебя",73,5],["قَوۡلٗا","слово",73,5]],[["ثَقِيلًا","тяжёлое",73,5],[5],["إِنَّ","поистине",73,6],["نَاشِئَةَ","вставание",73,6],["ٱلَّيۡلِ","ночью",73,6],["هِيَ","оно",73,6],["أَشَدُّ","сильнее",73,6],["وَطۡـٔٗا","по воздействию",73,6],["وَأَقۡوَمُ","и вернее",73,6],["قِيلًا","по слову",73,6],[6],["إِنَّ","поистине",73,7],["لَ