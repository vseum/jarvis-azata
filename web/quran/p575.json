{"p":575,"j":29,"a":[[73,20,["إِنَّ","رَبَّكَ","يَعۡلَمُ","أَنَّكَ","تَقُومُ","أَدۡنَىٰ","مِن","ثُلُثَيِ","ٱلَّيۡلِ","وَنِصۡفَهُۥ","وَثُلُثَهُۥ","وَطَآئِفَةٞ","مِّنَ","ٱلَّذِينَ","مَعَكَۚ","وَٱللَّهُ","يُقَدِّرُ","ٱلَّيۡلَ","وَٱلنَّهَارَۚ","عَلِمَ","أَن","لَّن","تُحۡصُوهُ","فَتَابَ","عَلَيۡكُمۡۖ","فَٱقۡرَءُواْ","مَا","تَيَسَّرَ","مِنَ","ٱلۡقُرۡءَانِۚ","عَلِمَ","أَن","سَيَكُونُ","مِنكُم","مَّرۡضَىٰ","وَءَاخَرُونَ","يَضۡرِبُونَ","فِي","ٱلۡأَرۡضِ","يَبۡتَغُونَ","مِن","فَضۡلِ","ٱللَّهِ","وَءَاخَرُونَ","يُقَٰتِلُونَ","فِي","سَبِيلِ","ٱللَّهِۖ","فَٱقۡرَءُواْ","مَا","تَيَسَّرَ","مِنۡهُۚ","وَأَقِيمُواْ","ٱلصَّلَوٰةَ","وَءَاتُواْ","ٱلزَّكَوٰةَ","وَأَقۡرِضُواْ","ٱللَّهَ","قَرۡضًا","حَسَنٗاۚ","وَمَا","تُقَدِّمُواْ","لِأَنفُسِكُم","مِّنۡ","خَيۡرٖ","تَجِدُوهُ","عِندَ","ٱللَّهِ","هُوَ","خَيۡرٗا","وَأَعۡظَمَ","أَجۡرٗاۚ","وَٱسۡتَغۡفِرُواْ","ٱللَّهَۖ","إِنَّ","ٱللَّهَ","غَفُورٞ","رَّحِيمُۢ"],"инна раббака йа`ламу аннака таḳууму адна мин сулусайил лайли ванисфахуу васулусахуу ватаифатум минал лазиина ма`ака валлаху йуḳаддирул лайла ваннахара `алима ал лан тухсууху фатаба `алайкум фаḳрауу ма тайассара минал ḳур'ани `алима ан сайакууну минкум марда ва'ахарууна йадрибууна фил арди йабтагууна мин фадлиллахи ва'ахарууна йуḳатилууна фии сабиилиллахи фаḳрауу ма тайассара минху ва'аḳиимус салавата ва'атуз закавата ва'аḳридуллаха ḳардан хасанан вама туḳаддимуу ли'анфусикум мин хайрин тажидууху `индаллахи хуа хайран ва'а`зама ажран вастагфируллаха инналлаха гафуурур рахиим","Воистину, твой Господь знает, что ты и часть тех, кто с тобой, простаиваете менее двух третей ночи, или половину ее, или треть ее. Аллах определяет меру дня и ночи. Он знает, что вам не сосчитать этого, и принимает ваши покаяния. Читайте же из Корана то, что необременительно для вас. Он знает, что среди вас будут больные, что одни странствуют по земле в поисках милости Аллаха, а другие сражаются на пути Аллаха. Читайте же из него то, что необременительно для вас, совершайте намаз, раздавайте закят и одолжите Аллаху прекрасный заем. Какое бы добро вы ни приготовили для себя заранее, вы найдете его у Аллаха в виде лучшего и большего вознаграждения. Просите же у Аллаха прощения, ведь Аллах - Прощающий, Милосердный.",["поистине","Господь твой","знает","что ты","простаиваешь","меньше","чем","две трети","ночи","и половину её","и треть её","и группа","из","тех, которые","с тобой","и Аллах","определяет меру","ночи","и дня","Он знал","что","никогда не","вы исчислите это","и Он простил","вас","так читайте","то, что","легко","из","Корана","Он знал","что","будут","среди вас","больные","и другие","странствуют","по","земле","ищут","из","щедрот","Аллаха","и другие","сражаются","на","пути","Аллаха","так читайте","то, что","легко","из него","и выстаивайте","молитву","и давайте","закят","и одолжите","Аллаху","заём","прекрасный","и что","вы предпошлёте","для себя","из","добра","найдёте это","у","Аллаха","оно","лучшим","и бо́льшим","наградой","и просите прощения","у Аллаха","поистине","Аллах","Прощающий","Милосердный"]],[74,1,["يَٰٓأَيُّهَا","ٱلۡمُدَّثِّرُ"],"йа'аййухал муддассир","О завернувшийся!",["о","завернувшийся"]],[74,2,["قُمۡ","فَأَنذِرۡ"],"ḳум фа'анзир","Встань и увещевай!",["встань","и предостерегай"]],[74,3,["وَرَبَّكَ","فَكَبِّرۡ"],"вараббака факаббир","Господа своего величай!",["и Господа твоего","возвеличивай"]],[74,4,["وَثِيَابَكَ","فَطَهِّرۡ"],"васийабака фатаххир","Одежды свои очищай!",["и одежды твои","очищай"]],[74,5,["وَٱلرُّجۡزَ","فَٱهۡجُرۡ"],"варружза фахжур","Скверны (идолов) сторонись!",["и скверны","сторонись"]],[74,6,["وَلَا","تَمۡنُن","تَسۡتَكۡثِرُ"],"вала тамнун тастаксир","Не оказывай милости, чтобы получить большее!",["и не","оказывай милость","желая большего"]],[74,7,["وَلِرَبِّكَ","فَٱصۡبِرۡ"],"валираббика фасбир","Ради Господа твоего будь терпелив!",["и ради Господа твоего","терпи"]],[74,8,["فَإِذَا","نُقِرَ","فِي","ٱلنَّاقُورِ"],"фа'иза нуḳира фин наḳуур","Когда же протрубят в рог,",["и когда","протрубят","в","рог"]],[74,9,["فَذَٰلِكَ","يَوۡمَئِذٖ","يَوۡمٌ","عَسِيرٌ"],"фазалика йаумаизин йаумун `асиир","то день тот будет Днем тяжким,",["то это","в тот день","день","тяжкий"]],[74,10,["عَلَى","ٱلۡكَٰفِرِينَ","غَيۡرُ","يَسِيرٖ"],"`алал кафириина гайру йасиир","нелегким для неверующих.",["для","неверующих","не","лёгкий"]],[74,11,["ذَرۡنِي","وَمَنۡ","خَلَقۡتُ","وَحِيدٗا"],"зарнии ваман халаḳту вахиида","Оставь Меня с тем, кого Я сотворил одиноким,",["оставь Меня","и того, кого","Я сотворил","одиноким"]],[74,12,["وَجَعَلۡتُ","لَهُۥ","مَالٗا","مَّمۡدُودٗا"],"важа`алту лахуу малам мамдууда","даровал ему большое богатство",["и Я дал","ему","богатство","обширное"]],[74,13,["وَبَنِينَ","شُهُودٗا"],"вабаниина шухууда","и сыновей, которые находились рядом с ним,",["и сыновей","присутствующих"]],[74,14,["وَمَهَّدتُّ","لَهُۥ","تَمۡهِيدٗا"],"вамаххадтту лахуу тамхиида","и распростер перед ним этот мир полностью.",["и Я уготовил","ему","уготовлением"]],[74,15,["ثُمَّ","يَطۡمَعُ","أَنۡ","أَزِيدَ"],"сумма йатма`у ан азиид","После всего этого он желает, чтобы Я добавил ему.",["затем","жаждет","чтобы","Я добавил"]],[74,16,["كـَلَّآۖ","إِنَّهُۥ","كَانَ","لِأٓيَٰتِنَا","عَنِيدٗا"],"калла иннахуу кана ли'айатина `аниида","Но нет! Он упрямо отрицает Наши знамения.",["так нет же","поистине, он","был","к знамениям Нашим","упорен"]],[74,17,["سَأُرۡهِقُهُۥ","صَعُودًا"],"са'урхиḳухуу са`ууда","Я возложу на него подъем (восхождение на гору в Аду).",["Я обременю его","подъёмом"]]],"m":[[["۞ إِنَّ","поистине",73,20],["رَبَّكَ","Господь твой",73,20],["يَعۡلَمُ","знает",73,20],["أَنَّكَ","что ты",73,20],["تَقُومُ","простаиваешь",73,20],["أَدۡنَىٰ","меньше",73,20],["مِن","чем",73,20],["ثُلُثَيِ","две трети",73,20],["ٱلَّيۡلِ","ночи",73,20],["وَنِصۡفَهُۥ","и половину её",73,20],["وَثُلُثَهُۥ","и треть её",73,20],["وَطَآئِفَةٞ","и группа",73,20]],[["مِّنَ","из",73,20],["ٱلَّذِينَ","тех, которые",73,20],["مَعَكَۚ","с тобой",73,20],["وَٱللَّهُ","и Аллах",73,20],["يُقَدِّرُ","определяет меру",73,20],["ٱلَّيۡلَ","ночи",73,20],["وَٱلنَّهَارَۚ","и дня",73,20],["عَلِمَ",