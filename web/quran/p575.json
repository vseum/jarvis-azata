ай",74,4],[4]],[["وَٱلرُّجۡزَ","и скверны",74,5],["فَٱهۡجُرۡ","сторонись",74,5],[5],["وَلَا","и не",74,6],["تَمۡنُن","оказывай милость",74,6],["تَسۡتَكۡثِرُ","желая большего",74,6],[6],["وَلِرَبِّكَ","и ради Господа твоего",74,7],["فَٱصۡبِرۡ","терпи",74,7],[7]],[["فَإِذَا","и когда",74,8],["نُقِرَ","протрубят",74,8],["فِي","в",74,8],["ٱلنَّاقُورِ","рог",74,8],[8],["فَذَٰلِكَ","то это",74,9],["يَوۡمَئِذٖ","в тот день",74,9],["يَوۡمٌ","день",74,9],["عَسِيرٌ","тяжкий",74,9],[9],["عَلَى","для",74,10],["ٱلۡكَٰفِرِينَ","неверующих",74,10]],[["غَيۡرُ","не",74,10],["يَسِيرٖ","лёгкий",74,10],[10],["ذَرۡنِي","оставь Меня",74,11],["وَمَنۡ","и того, кого",74,11],["خَلَقۡتُ","Я сотворил",74,11],["وَحِيدٗا","одиноким",74,11],[11],["وَجَعَلۡتُ","и Я дал",74,12],["لَهُۥ","ему",74,12],["مَالٗا","богатство",74,12]],[["مَّمۡدُودٗا","обширное",74,12],[12],["وَبَنِينَ","и сыновей",74,13],["شُهُودٗا","присутствующих",74,13],[13],["وَمَهَّدتُّ","и Я уготовил",74,14],["لَهُۥ","ему",74,14],["تَمۡهِيدٗا","уготовлением",74,14],[14],["ثُمَّ","затем",74,15],["يَطۡمَعُ","жаждет",74,15]],[["أَنۡ","чтобы",74,15],["أَزِيدَ","Я добавил",74,15],[15],["كـَلَّآۖ","так нет же",74,16],["إِنَّهُۥ","поистине, он",74,16],["كَانَ","был",74,16],["لِأٓيَٰتِنَا","к знамениям Нашим",74,16],["عَنِيدٗا","упорен",74,16],[16],["سَأُرۡهِقُهُۥ","Я обременю его",74,17],["صَعُودًا","подъёмом",74,17],[17]]]}