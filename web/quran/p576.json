{"p":576,"j":29,"a":[[74,18,["إِنَّهُۥ","فَكَّرَ","وَقَدَّرَ"],"иннахуу факкара ваḳаддар","Он подумал и рассчитал.",["поистине, он","обдумал","и прикинул"]],[74,19,["فَقُتِلَ","كَيۡفَ","قَدَّرَ"],"фаḳутила кайфа ḳаддар","Да сгинет он! Как он рассчитал?!",["да будет он убит","как","он прикинул"]],[74,20,["ثُمَّ","قُتِلَ","كَيۡفَ","قَدَّرَ"],"сумма ḳутила кайфа ḳаддар","Да сгинет он еще раз! Как он рассчитал?!",["затем","да будет он убит","как","он прикинул"]],[74,21,["ثُمَّ","نَظَرَ"],"сумма назар","Затем он задумался.",["затем","он посмотрел"]],[74,22,["ثُمَّ","عَبَسَ","وَبَسَرَ"],"сумма `абаса вабасар","Затем он нахмурился и насупился.",["затем","он нахмурился","и насупился"]],[74,23,["ثُمَّ","أَدۡبَرَ","وَٱسۡتَكۡبَرَ"],"сумма адбара вастакбар","Затем он повернулся спиной и возгордился",["затем","он отвернулся","и возгордился"]],[74,24,["فَقَالَ","إِنۡ","هَٰذَآ","إِلَّا","سِحۡرٞ","يُؤۡثَرُ"],"фаḳала ин хаза илла сихрун йу'сар","и сказал: «Это - не что иное, как пересказанное колдовство.",["и он сказал","не","это","кроме","колдовство","перенимаемое"]],[74,25,["إِنۡ","هَٰذَآ","إِلَّا","قَوۡلُ","ٱلۡبَشَرِ"],"ин хаза илла ḳаулул башар","Это - не что иное, как слова человека».",["не","это","кроме","слово","человека"]],[74,26,["سَأُصۡلِيهِ","سَقَرَ"],"са'услиихи саḳар","Я брошу его в Преисподнюю.",["Я ввергну его","в Сакар"]],[74,27,["وَمَآ","أَدۡرَىٰكَ","مَا","سَقَرُ"],"вама адрака ма саḳар","Откуда ты мог знать, что такое Преисподняя?",["и что","дало тебе знать","что","Сакар"]],[74,28,["لَا","تُبۡقِي","وَلَا","تَذَرُ"],"ла тубḳии вала тазар","Она не щадит и не оставляет.",["не","она щадит","и не","она оставляет"]],[74,29,["لَوَّاحَةٞ","لِّلۡبَشَرِ"],"лаввахатул лилбашар","Она сжигает кожу.",["опаляющая","кожу"]],[74,30,["عَلَيۡهَا","تِسۡعَةَ","عَشَرَ"],"`алайха тис`ата `ашар","Их (ангелов) над ней - девятнадцать.",["над ней","девять","-надцать"]],[74,31,["وَمَا","جَعَلۡنَآ","أَصۡحَٰبَ","ٱلنَّارِ","إِلَّا","مَلَٰٓئِكَةٗۖ","وَمَا","جَعَلۡنَا","عِدَّتَهُمۡ","إِلَّا","فِتۡنَةٗ","لِّلَّذِينَ","كَفَرُواْ","لِيَسۡتَيۡقِنَ","ٱلَّذِينَ","أُوتُواْ","ٱلۡكِتَٰبَ","وَيَزۡدَادَ","ٱلَّذِينَ","ءَامَنُوٓاْ","إِيمَٰنٗا","وَلَا","يَرۡتَابَ","ٱلَّذِينَ","أُوتُواْ","ٱلۡكِتَٰبَ","وَٱلۡمُؤۡمِنُونَ","وَلِيَقُولَ","ٱلَّذِينَ","فِي","قُلُوبِهِم","مَّرَضٞ","وَٱلۡكَٰفِرُونَ","مَاذَآ","أَرَادَ","ٱللَّهُ","بِهَٰذَا","مَثَلٗاۚ","كَذَٰلِكَ","يُضِلُّ","ٱللَّهُ","مَن","يَشَآءُ","وَيَهۡدِي","مَن","يَشَآءُۚ","وَمَا","يَعۡلَمُ","جُنُودَ","رَبِّكَ","إِلَّا","هُوَۚ","وَمَا","هِيَ","إِلَّا","ذِكۡرَىٰ","لِلۡبَشَرِ"],"вама жа`ална асхабан нари илла малаикатан вама жа`ална `иддатахум илла фитнатал лиллазиина кафаруу лийастайḳинал лазиина уутул китаба вайаздадал лазиина амануу ииманан вала йартабал лазиина уутул китаба валму'минууна валийаḳуулал лазиина фии ḳулуубихим марадун валкафирууна маза арадаллаху бихаза масалан казалика йудиллуллаху ман йашау вайахдии ман йашау вама йа`ламу жунууда раббика илла хуа вама хийа илла зикра лилбашар","Стражами Огня мы сделали только ангелов, а количество их сделали искушением для неверующих, чтобы удостоверились те, кому было даровано Писание, чтобы усилилась вера у верующих, чтобы не сомневались те, кому было даровано Писание, и верующие, и чтобы спросили те, чьи сердца поражены недугом, и неверующие: «Что хотел Аллах этой притчей?». Так Аллах вводит в заблуждение, кого пожелает, и ведет прямым путем, кого пожелает. Воинство твоего Господа не знает никто, кроме Него. Это же - не что иное, как Напоминание для человечества.",["и не","Мы сделали","стражами","Огня","кроме","ангелов","и не","Мы сделали","число их","кроме","испытанием","для тех, которые","не уверовали","чтобы убедились","те, которым","было даровано","Писание","и чтобы усилили","те, которые","уверовали","веру","и чтобы не","усомнились","те, которым","было даровано","Писание","и верующие","и чтобы сказали","те, у которых","в","сердцах их","болезнь","и неверующие","что","хотел","Аллах","этим","как притчей","так","вводит в заблуждение","Аллах","кого","Он пожелает","и ведёт прямым путём","кого","Он пожелает","и не","знает","воинства","Господа твоего","кроме","Него","и не","она","кроме","напоминание","для людей"]],[74,32,["كـَلَّا","وَٱلۡقَمَرِ"],"калла валḳамар","О да! Клянусь луной!",["так нет же","клянусь луной"]],[74,33,["وَٱلَّيۡلِ","إِذۡ","أَدۡبَرَ"],"валлайли из адбар","Клянусь ночью, когда она отступает!",["клянусь ночью","когда","она отступила"]],[74,34,["وَٱلصُّبۡحِ","إِذَآ","أَسۡفَرَ"],"вассубхи иза асфар","Клянусь зарей, когда она занимается!",["клянусь утром","когда","оно забрезжило"]],[74,35,["إِنَّهَا","لَإِحۡدَى","ٱلۡكُبَرِ"],"иннаха ла'ихдал кубар","Это есть одно из величайших явлений,",["поистине, она","непременно одна","из величайших"]],[74,36,["نَذِيرٗا","لِّلۡبَشَرِ"],"назиирал лилбашар","предостерегающее человечество -",["предостережением","для людей"]],[74,37,["لِمَن","شَآءَ","مِنكُمۡ","أَن","يَتَقَدَّمَ","أَوۡ","يَتَأَخَّرَ"],"лиман шаа минкум ан йатаḳаддама ау йатааххар","тех из вас, кто желает продвигаться вперед благодаря праведным деяниям или отступать назад, совершая грехи.",["для того, кто","пожелал","из вас","чтобы","продвинуться вперёд","или","отстать"]],[74,38,["كُلُّ","نَفۡسِۭ","بِمَا","كَسَبَتۡ","رَهِينَةٌ"],"куллу нафси бима касабат рахиинах","Каждый человек является заложником того, что он приобрел,",["каждая","душа","за то, что","она приобрела","заложница"]],[74,39,["إِلَّآ","أَصۡحَٰبَ","ٱلۡيَمِينِ"],"илла асхабал йамиин","кроме людей правой стороны.",["кроме","людей","правой стороны"]],[74,40,["فِي","جَنَّٰتٖ","يَتَسَآءَلُونَ"],"фии жаннатин йатасаалуун","В Райских садах они будут расспрашивать друг друга",["в","садах","они расспрашивают друг друга"]],[74,41,["عَنِ","ٱلۡمُجۡرِمِينَ"],"`анил мужримиин","о грешниках.",["о","грешниках"]],[74,42,["مَا","سَلَكَكُمۡ","فِي","سَقَرَ"],"ма салакакум фии саḳар","Что привело вас в Преисподнюю?",["что","ввело вас","в","Сакар"]],[74,43,["قَالُواْ","لَمۡ","نَكُ","مِنَ","ٱلۡمُصَلِّينَ"],"ḳалуу лам наку минал мусаллиин","Они скажут: «Мы не были в числе тех, 