{"p":576,"j":29,"a":[[74,18,["إِنَّهُۥ","فَكَّرَ","وَقَدَّرَ"],"иннахуу факкара уакаддар","Он подумал и рассчитал.",["поистине, он","обдумал","и прикинул"]],[74,19,["فَقُتِلَ","كَيۡفَ","قَدَّرَ"],"факутила кайфа каддар","Да сгинет он! Как он рассчитал?!",["да будет он убит","как","он прикинул"]],[74,20,["ثُمَّ","قُتِلَ","كَيۡفَ","قَدَّرَ"],"сумма кутила кайфа каддар","Да сгинет он еще раз! Как он рассчитал?!",["затем","да будет он убит","как","он прикинул"]],[74,21,["ثُمَّ","نَظَرَ"],"сумма назар","Затем он задумался.",["затем","он посмотрел"]],[74,22,["ثُمَّ","عَبَسَ","وَبَسَرَ"],"сумма `абаса уабасар","Затем он нахмурился и насупился.",["затем","он нахмурился","и насупился"]],[74,23,["ثُمَّ","أَدۡبَرَ","وَٱسۡتَكۡبَرَ"],"сумма адбара уастакбар","Затем он повернулся спиной и возгордился",["затем","он отвернулся","и возгордился"]],[74,24,["فَقَالَ","إِنۡ","هَٰذَآ","إِلَّا","سِحۡرٞ","يُؤۡثَرُ"],"факаала ин хаазаа иллаа сихрун йу'сар","и сказал: «Это - не что иное, как пересказанное колдовство.",["и он сказал","не","это","кроме","колдовство","перенимаемое"]],[74,25,["إِنۡ","هَٰذَآ","إِلَّا","قَوۡلُ","ٱلۡبَشَرِ"],"ин хаазаа иллаа каулу лбашар","Это - не что иное, как слова человека».",["не","это","кроме","слово","человека"]],[74,26,["سَأُصۡلِيهِ","سَقَرَ"],"са'услиихи сакар","Я брошу его в Преисподнюю.",["Я ввергну его","в Сакар"]],[74,27,["وَمَآ","أَدۡرَىٰكَ","مَا","سَقَرُ"],"уамаа адраака маа сакар","Откуда ты мог знать, что такое Преисподняя?",["и что","дало тебе знать","что","Сакар"]],[74,28,["لَا","تُبۡقِي","وَلَا","تَذَرُ"],"лаа тубкии уалаа тазар","Она не щадит и не оставляет.",["не","она щадит","и не","она оставляет"]],[74,29,["لَوَّاحَةٞ","لِّلۡبَشَرِ"],"лаууаахатул лилбашар","Она сжигает кожу.",["опаляющая","кожу"]],[74,30,["عَلَيۡهَا","تِسۡعَةَ","عَشَرَ"],"`алайхаа тис`ата `ашар","Их (ангелов) над ней - девятнадцать.",["над ней","девять","-надцать"]],[74,31,["وَمَا","جَعَلۡنَآ","أَصۡحَٰبَ","ٱلنَّارِ","إِلَّا","مَلَٰٓئِكَةٗۖ","وَمَا","جَعَلۡنَا","عِدَّتَهُمۡ","إِلَّا","فِتۡنَةٗ","لِّلَّذِينَ","كَفَرُواْ","لِيَسۡتَيۡقِنَ","ٱلَّذِينَ","أُوتُواْ","ٱلۡكِتَٰبَ","وَيَزۡدَادَ","ٱلَّذِينَ","ءَامَنُوٓاْ","إِيمَٰنٗا","وَلَا","يَرۡتَابَ","ٱلَّذِينَ","أُوتُواْ","ٱلۡكِتَٰبَ","وَٱلۡمُؤۡمِنُونَ","وَلِيَقُولَ","ٱلَّذِينَ","فِي","قُلُوبِهِم","مَّرَضٞ","وَٱلۡكَٰفِرُونَ","مَاذَآ","أَرَادَ","ٱللَّهُ","بِهَٰذَا","مَثَلٗاۚ","كَذَٰلِكَ","يُضِلُّ","ٱللَّهُ","مَن","يَشَآءُ","وَيَهۡدِي","مَن","يَشَآءُۚ","وَمَا","يَعۡلَمُ","جُنُودَ","رَبِّكَ","إِلَّا","هُوَۚ","وَمَا","هِيَ","إِلَّا","ذِكۡرَىٰ","لِلۡبَشَرِ"],"уамаа джа`алнаа асхааба ннаари иллаа малаа'икатан уамаа джа`алнаа `иддатахум иллаа фитнатал лиллазиина кафаруу лийастайкина ллазиина уутуу лкитааба уайаздаада ллазиина аамануу иимаанан уалаа йартааба ллазиина уутуу лкитааба уалму'минууна уалийакуула ллазиина фии кулуубихим ммарадун уалкаафирууна маазаа араада ллаху бихаазаа масалан казаалика йудиллу ллаху ман йашаа'у уайахдии ман йашаа'у уамаа йа`ламу джунууда раббика иллаа хууа уамаа хийа иллаа зикраа лилбашар","Стражами Огня мы сделали только ангелов, а количество их сделали искушением для неверующих, чтобы удостоверились те, кому было даровано Писание, чтобы усилилась вера у верующих, чтобы не сомневались те, кому было даровано Писание, и верующие, и чтобы спросили те, чьи сердца поражены недугом, и неверующие: «Что хотел Аллах этой притчей?». Так Аллах вводит в заблуждение, кого пожелает, и ведет прямым путем, кого пожелает. Воинство твоего Господа не знает никто, кроме Него. Это же - не что иное, как Напоминание для человечества.",["и не","Мы сделали","стражами","Огня","кроме","ангелов","и не","Мы сделали","число их","кроме","испытанием","для тех, которые","не уверовали","чтобы убедились","те, которым","было даровано","Писание","и чтобы усилили","те, которые","уверовали","веру","и чтобы не","усомнились","те, которым","было даровано","Писание","и верующие","и чтобы сказали","те, у которых","в","сердцах их","болезнь","и неверующие","что","хотел","Аллах","этим","как притчей","так","вводит в заблуждение","Аллах","кого","Он пожелает","и ведёт прямым путём","кого","Он пожелает","и не","знает","воинства","Господа твоего","кроме","Него","и не","она","кроме","напоминание","для людей"]],[74,32,["كـَلَّا","وَٱلۡقَمَرِ"],"каллаа уалкамар","О да! Клянусь луной!",["так нет же","клянусь луной"]],[74,33,["وَٱلَّيۡلِ","إِذۡ","أَدۡبَرَ"],"уаллайли из адбар","Клянусь ночью, когда она отступает!",["клянусь ночью","когда","она отступила"]],[74,34,["وَٱلصُّبۡحِ","إِذَآ","أَسۡفَرَ"],"уассубхи изаа асфар","Клянусь зарей, когда она занимается!",["клянусь утром","когда","оно забрезжило"]],[74,35,["إِنَّهَا","لَإِحۡدَى","ٱلۡكُبَرِ"],"иннахаа ла'ихдаа лкубар","Это есть одно из величайших явлений,",["поистине, она","непременно одна","из величайших"]],[74,36,["نَذِيرٗا","لِّلۡبَشَرِ"],"назиирал лилбашар","предостерегающее человечество -",["предостережением","для людей"]],[74,37,["لِمَن","شَآءَ","مِنكُمۡ","أَن","يَتَقَدَّمَ","أَوۡ","يَتَأَخَّرَ"],"лиман шаа'а минкум ан йатакаддама ау йата'аххар","тех из вас, кто желает продвигаться вперед благодаря праведным деяниям или отступать назад, совершая грехи.",["для того, кто","пожелал","из вас","чтобы","продвинуться вперёд","или","отстать"]],[74,38,["كُلُّ","نَفۡسِۭ","بِمَا","كَسَبَتۡ","رَهِينَةٌ"],"куллу нафси бимаа касабат рахиинах","Каждый человек является заложником того, что он приобрел,",["каждая","душа","за то, что","она приобрела","заложница"]],[74,39,["إِلَّآ","أَصۡحَٰبَ","ٱلۡيَمِينِ"],"иллаа асхааба лйамиин","кроме людей правой стороны.",["кроме","людей","правой стороны"]],[74,40,["فِي","جَنَّٰتٖ","يَتَسَآءَلُونَ"],"фии джаннаатин йатасаа'алуун","В Райских садах они будут расспрашивать друг друга",["в","садах","они расспрашивают друг друга"]],[74,41,["عَنِ","ٱلۡمُجۡرِمِينَ"],"`ани лмуджримиин","о грешниках.",["о","грешниках"]],[74,42,["مَا","سَلَكَكُمۡ","فِي","سَقَرَ"],"маа салакакум фии сакар","Что привело вас в Преисподнюю?",["что","ввело вас","в","Сакар"]],[74,43,["قَالُواْ","لَمۡ","نَكُ","مِنَ","ٱلۡمُصَلِّينَ"],"каалуу лам наку мина лмусаллиин","Они скажут: «Мы не были в числе тех, которые совершали намаз.",["они сказали","не","мы были","из","молящихся"]],[74,44,["وَلَمۡ","نَكُ","نُطۡعِمُ","ٱلۡمِسۡكِينَ"],"уалам наку нут`иму лмискиин","Мы не кормили бедняков.",["и не","мы были","кормим","бедняка"]],[74,45,["وَكُنَّا","نَخُوضُ","مَعَ","ٱلۡخَآئِضِينَ"],"уакуннаа нахууду ма`а лхаа'идиин","Мы погружались в словоблудие вместе с погружавшимися.",["и были мы","погружаемся","вместе с","погружающимися"]],[74,46,["وَكُنَّا","نُكَذِّبُ","بِيَوۡمِ","ٱلدِّينِ"],"уакуннаа нуказзибу бийауми ддиин","Мы считали ложью Последний день,",["и были мы","считаем ложью","День","Суда"]],[74,47,["حَتَّىٰٓ","أَتَىٰنَا","ٱلۡيَقِينُ"],"хаттаа атаанаа лйакиин","пока к нам не явилась убежденность (смерть)».",["пока не","пришла к нам","убеждённость"]]]}