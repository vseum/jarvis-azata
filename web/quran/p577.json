{"p":577,"j":29,"a":[[74,48,["فَمَا","تَنفَعُهُمۡ","شَفَٰعَةُ","ٱلشَّٰفِعِينَ"],"фамаа танфа`ухум шафаа`ату шшаафи`иин","Заступничество заступников не поможет им.",["и не","поможет им","заступничество","заступников"]],[74,49,["فَمَا","لَهُمۡ","عَنِ","ٱلتَّذۡكِرَةِ","مُعۡرِضِينَ"],"фамаа лахум `ани ттазкирати му`ридиин","Что же с ними? Почему они отворачиваются от Напоминания,",["и что же","с ними","от","напоминания","отворачивающиеся"]],[74,50,["كَأَنَّهُمۡ","حُمُرٞ","مُّسۡتَنفِرَةٞ"],"ка'аннахум хумурум мустанфирах","словно напуганные ослы,",["словно они","ослы","испуганные"]],[74,51,["فَرَّتۡ","مِن","قَسۡوَرَةِۭ"],"фаррат мин касуарах","бегущие от стрелка (или льва)?",["бежавшие","от","льва"]],[74,52,["بَلۡ","يُرِيدُ","كُلُّ","ٱمۡرِيٕٖ","مِّنۡهُمۡ","أَن","يُؤۡتَىٰ","صُحُفٗا","مُّنَشَّرَةٗ"],"бал йурииду куллу мрийим минхум ан йу'таа сухуфам мунашшараха","Но ведь каждый из них желает получить развернутые свитки.",["нет же","желает","каждый","человек","из них","чтобы","ему было дано","свитки","развёрнутые"]],[74,53,["كـَلَّاۖ","بَل","لَّا","يَخَافُونَ","ٱلۡأٓخِرَةَ"],"каллаа бал ллаа йахаафууна л'хирах","Но нет! Они не боятся Последней жизни.",["так нет же","напротив","не","они боятся","последней жизни"]],[74,54,["كـَلَّآ","إِنَّهُۥ","تَذۡكِرَةٞ"],"каллаа иннахуу тазкирах","Но нет! Это есть Назидание.",["так нет же","поистине, оно","напоминание"]],[74,55,["فَمَن","شَآءَ","ذَكَرَهُۥ"],"фаман шаа'а закараху","Помянет его тот, кто захочет.",["и кто","пожелал","вспомнил его"]],[74,56,["وَمَا","يَذۡكُرُونَ","إِلَّآ","أَن","يَشَآءَ","ٱللَّهُۚ","هُوَ","أَهۡلُ","ٱلتَّقۡوَىٰ","وَأَهۡلُ","ٱلۡمَغۡفِرَةِ"],"уамаа йазкурууна иллаа ан йашаа'а ллаху хууа ахлу ттакуаа уа'ахлу лмагфирах","Но они не помянут его, если этого не пожелает Аллах. Он - Тот, Кто достоин страха и способен на прощение.",["и не","они вспомнят","кроме","как","пожелает","Аллах","Он","достоин","богобоязненности","и достоин","прощения"]],[75,1,["لَآ","أُقۡسِمُ","بِيَوۡمِ","ٱلۡقِيَٰمَةِ"],"лаа уксиму бийауми лкийаамах","Нет, клянусь Днем воскресения!",["нет","клянусь","Днём","воскресения"]],[75,2,["وَلَآ","أُقۡسِمُ","بِٱلنَّفۡسِ","ٱللَّوَّامَةِ"],"уалаа уксиму биннафси ллаууаамах","Клянусь душой попрекающей!",["и нет","клянусь","душой","попрекающей"]],[75,3,["أَيَحۡسَبُ","ٱلۡإِنسَٰنُ","أَلَّن","نَّجۡمَعَ","عِظَامَهُۥ"],"айахсабу л'инсаану аллан наджма`а `изаамаху","Неужели человек полагает, что Мы не соберем его костей?",["разве думает","человек","что не","Мы соберем","кости его"]],[75,4,["بَلَىٰ","قَٰدِرِينَ","عَلَىٰٓ","أَن","نُّسَوِّيَ","بَنَانَهُۥ"],"балаа каадириина `алаа ан нусаууийа банаанаху","Конечно! Мы способны восстановить даже кончики его пальцев (или сделать всего его пальцы одинаковыми, так что он не сможет пользоваться ими, как прежде).",["конечно же","способные (Мы)","на","то, чтобы","Мы выровняли","кончики пальцев его"]],[75,5,["بَلۡ","يُرِيدُ","ٱلۡإِنسَٰنُ","لِيَفۡجُرَ","أَمَامَهُۥ"],"бал йурииду л'инсаану лийафджура амаамаху","Но человек желает и впредь совершать грехи.",["напротив","желает","человек","чтобы грешить","впереди себя"]],[75,6,["يَسۡـَٔلُ","أَيَّانَ","يَوۡمُ","ٱلۡقِيَٰمَةِ"],"йас'алу аййаана йауму лкийаамах","Он спрашивает, когда же наступит День воскресения?",["он спрашивает","когда же","день","воскресения"]],[75,7,["فَإِذَا","بَرِقَ","ٱلۡبَصَرُ"],"фа'изаа барика лбасар","Когда взор будет ошеломлен,",["и когда","помутится","взор"]],[75,8,["وَخَسَفَ","ٱلۡقَمَرُ"],"уахасафа лкамар","луна затмится,",["и затмится","луна"]],[75,9,["وَجُمِعَ","ٱلشَّمۡسُ","وَٱلۡقَمَرُ"],"уаджуми`а шшамсу уалкамар","а солнце и луна сойдутся.",["и соединены","солнце","и луна"]],[75,10,["يَقُولُ","ٱلۡإِنسَٰنُ","يَوۡمَئِذٍ","أَيۡنَ","ٱلۡمَفَرُّ"],"йакуулу л'инсаану йаума'изин айна лмафарр","В тот день человек скажет: «Куда бежать?».",["скажет","человек","в тот день","где","бегство"]],[75,11,["كـَلَّا","لَا","وَزَرَ"],"каллаа лаа уазар","О нет! Не будет убежища!",["так нет же","нет","убежища"]],[75,12,["إِلَىٰ","رَبِّكَ","يَوۡمَئِذٍ","ٱلۡمُسۡتَقَرُّ"],"илаа раббика йаума'изин лмустакарр","В тот день возвращение будет к твоему Господу.",["к","Господу твоему","в тот день","пристанище"]],[75,13,["يُنَبَّؤُاْ","ٱلۡإِنسَٰنُ","يَوۡمَئِذِۭ","بِمَا","قَدَّمَ","وَأَخَّرَ"],"йунабба'у л'инсаану йаума'изи бимаа каддама уа'аххар","В тот день человеку возвестят о том, что он совершил заранее и что оставил после себя.",["будет извещен","человек","в тот день","о том, что","он отправил вперед","и оставил позади"]],[75,14,["بَلِ","ٱلۡإِنسَٰنُ","عَلَىٰ","نَفۡسِهِۦ","بَصِيرَةٞ"],"бали л'инсаану `алаа нафсихии басиирах","Но человек будет свидетельствовать против самого себя,",["напротив","человек","против","самого себя","очевидец"]],[75,15,["وَلَوۡ","أَلۡقَىٰ","مَعَاذِيرَهُۥ"],"уалау алкаа ма`аазиираху","даже если он будет оправдываться.",["и даже если","он выставит","оправдания свои"]],[75,16,["لَا","تُحَرِّكۡ","بِهِۦ","لِسَانَكَ","لِتَعۡجَلَ","بِهِۦٓ"],"лаа тухаррик бихии лисаанака лита`джала бихи","Не шевели своим языком, повторяя его (Коран), чтобы поскорее запомнить.",["не","двигай","им","языком твоим","чтобы поспешить","с ним"]],[75,17,["إِنَّ","عَلَيۡنَا","جَمۡعَهُۥ","وَقُرۡءَانَهُۥ"],"инна `алайнаа джам`ахуу уакур'аанаху","Нам надлежит собрать его и прочесть.",["поистине","на Нас","собирание его","и чтение его"]],[75,18,["فَإِذَا","قَرَأۡنَٰهُ","فَٱتَّبِعۡ","قُرۡءَانَهُۥ"],"фа'изаа кара'нааху фаттаби` кур'аанаху","Когда же Мы прочтем его, то читай его следом.",["и когда","Мы прочитали его","то следуй","чтению его"]],[75,19,["ثُمَّ","إِنَّ","عَلَيۡنَا","بَيَانَهُۥ"],"сумма инна `алайнаа байаанаху","Нам надлежит разъяснять его.",["затем","поистине","на Нас","разъяснение его"]]]}