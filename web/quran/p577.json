{"p":577,"j":29,"a":[[74,48,["فَمَا","تَنفَعُهُمۡ","شَفَٰعَةُ","ٱلشَّٰفِعِينَ"],"фама танфа`ухум шафа`атуш шафи`иин","Заступничество заступников не поможет им.",["и не","поможет им","заступничество","заступников"]],[74,49,["فَمَا","لَهُمۡ","عَنِ","ٱلتَّذۡكِرَةِ","مُعۡرِضِينَ"],"фама лахум `анит тазкирати му`ридиин","Что же с ними? Почему они отворачиваются от Напоминания,",["и что же","с ними","от","напоминания","отворачивающиеся"]],[74,50,["كَأَنَّهُمۡ","حُمُرٞ","مُّسۡتَنفِرَةٞ"],"ка'аннахум хумурум мустанфирах","словно напуганные ослы,",["словно они","ослы","испуганные"]],[74,51,["فَرَّتۡ","مِن","قَسۡوَرَةِۭ"],"фаррат мин ḳасварах","бегущие от стрелка (или льва)?",["бежавшие","от","льва"]],[74,52,["بَلۡ","يُرِيدُ","كُلُّ","ٱمۡرِيٕٖ","مِّنۡهُمۡ","أَن","يُؤۡتَىٰ","صُحُفٗا","مُّنَشَّرَةٗ"],"бал йурииду куллумрийим минхум ан йу'та сухуфам мунашшараха","Но ведь каждый из них желает получить развернутые свитки.",["нет же","желает","каждый","человек","из них","чтобы","ему было дано","свитки","развёрнутые"]],[74,53,["كـَلَّاۖ","بَل","لَّا","يَخَافُونَ","ٱلۡأٓخِرَةَ"],"калла бал ла йахафуунал ахирах","Но нет! Они не боятся Последней жизни.",["так нет же","напротив","не","они боятся","последней жизни"]],[74,54,["كـَلَّآ","إِنَّهُۥ","تَذۡكِرَةٞ"],"калла иннахуу тазкирах","Но нет! Это есть Назидание.",["так нет же","поистине, оно","напоминание"]],[74,55,["فَمَن","شَآءَ","ذَكَرَهُۥ"],"фаман шаа закараху","Помянет его тот, кто захочет.",["и кто","пожелал","вспомнил его"]],[74,56,["وَمَا","يَذۡكُرُونَ","إِلَّآ","أَن","يَشَآءَ","ٱللَّهُۚ","هُوَ","أَهۡلُ","ٱلتَّقۡوَىٰ","وَأَهۡلُ","ٱلۡمَغۡفِرَةِ"],"вама йазкурууна илла ан йашааллаху хуа ахлут таḳва ва'ахлул магфирах","Но они не помянут его, если этого не пожелает Аллах. Он - Тот, Кто достоин страха и способен на прощение.",["и не","они вспомнят","кроме","как","пожелает","Аллах","Он","достоин","богобоязненности","и достоин","прощения"]],[75,1,["لَآ","أُقۡسِمُ","بِيَوۡمِ","ٱلۡقِيَٰمَةِ"],"ла уḳсиму бийаумил ḳийамах","Нет, клянусь Днем воскресения!",["нет","клянусь","Днём","воскресения"]],[75,2,["وَلَآ","أُقۡسِمُ","بِٱلنَّفۡسِ","ٱللَّوَّامَةِ"],"вала уḳсиму биннафсил лаввамах","Клянусь душой попрекающей!",["и нет","клянусь","душой","попрекающей"]],[75,3,["أَيَحۡسَبُ","ٱلۡإِنسَٰنُ","أَلَّن","نَّجۡمَعَ","عِظَامَهُۥ"],"айахсабул инсану аллан нажма`а `изамаху","Неужели человек полагает, что Мы не соберем его костей?",["разве думает","человек","что не","Мы соберем","кости его"]],[75,4,["بَلَىٰ","قَٰدِرِينَ","عَلَىٰٓ","أَن","نُّسَوِّيَ","بَنَانَهُۥ"],"бала ḳадириина `ала ан нусаввийа бананаху","Конечно! Мы способны восстановить даже кончики его пальцев (или сделать всего его пальцы одинаковыми, так что он не сможет пользоваться ими, как прежде).",["конечно же","способные (Мы)","на","то, чтобы","Мы выровняли","кончики пальцев его"]],[75,5,["بَلۡ","يُرِيدُ","ٱلۡإِنسَٰنُ","لِيَفۡجُرَ","أَمَامَهُۥ"],"бал йуриидул инсану лийафжура амамаху","Но человек желает и впредь совершать грехи.",["напротив","желает","человек","чтобы грешить","впереди себя"]],[75,6,["يَسۡـَٔلُ","أَيَّانَ","يَوۡمُ","ٱلۡقِيَٰمَةِ"],"йас'алу аййана йаумул ḳийамах","Он спрашивает, когда же наступит День воскресения?",["он спрашивает","когда же","день","воскресения"]],[75,7,["فَإِذَا","بَرِقَ","ٱلۡبَصَرُ"],"фа'иза бариḳал басар","Когда взор будет ошеломлен,",["и когда","помутится","взор"]],[75,8,["وَخَسَفَ","ٱلۡقَمَرُ"],"вахасафал ḳамар","луна затмится,",["и затмится","луна"]],[75,9,["وَجُمِعَ","ٱلشَّمۡسُ","وَٱلۡقَمَرُ"],"важуми`аш шамсу валḳамар","а солнце и луна сойдутся.",["и соединены","солнце","и луна"]],[75,10,["يَقُولُ","ٱلۡإِنسَٰنُ","يَوۡمَئِذٍ","أَيۡنَ","ٱلۡمَفَرُّ"],"йаḳуулул инсану йаумаизин айнал мафарр","В тот день человек скажет: «Куда бежать?».",["скажет","человек","в тот день","где","бегство"]],[75,11,["كـَلَّا","لَا","وَزَرَ"],"калла ла вазар","О нет! Не будет убежища!",["так нет же","нет","убежища"]],[75,12,["إِلَىٰ","رَبِّكَ","يَوۡمَئِذٍ","ٱلۡمُسۡتَقَرُّ"],"ила раббика йаумаизинил мустаḳарр","В тот день возвращение будет к твоему Господу.",["к","Господу твоему","в тот день","пристанище"]],[75,13,["يُنَبَّؤُاْ","ٱلۡإِنسَٰنُ","يَوۡمَئِذِۭ","بِمَا","قَدَّمَ","وَأَخَّرَ"],"йунаббаул инсану йаумаизи бима ḳаддама ва'аххар","В тот день человеку возвестят о том, что он совершил заранее и что оставил после себя.",["будет извещен","человек","в тот день","о том, что","он отправил вперед","и оставил позади"]],[75,14,["بَلِ","ٱلۡإِنسَٰنُ","عَلَىٰ","نَفۡسِهِۦ","بَصِيرَةٞ"],"балил инсану `ала нафсихии басиирах","Но человек будет свидетельствовать против самого себя,",["напротив","человек","против","самого себя","очевидец"]],[75,15,["وَلَوۡ","أَلۡقَىٰ","مَعَاذِيرَهُۥ"],"валау алḳа ма`азиираху","даже если он будет оправдываться.",["и даже если","он выставит","оправдания свои"]],[75,16,["لَا","تُحَرِّكۡ","بِهِۦ","لِسَانَكَ","لِتَعۡجَلَ","بِهِۦٓ"],"ла тухаррик бихии лисанака лита`жала бихи","Не шевели своим языком, повторяя его (Коран), чтобы поскорее запомнить.",["не","двигай","им","языком твоим","чтобы поспешить","с ним"]],[75,17,["إِنَّ","عَلَيۡنَا","جَمۡعَهُۥ","وَقُرۡءَانَهُۥ"],"инна `алайна жам`ахуу ваḳур'анаху","Нам надлежит собрать его и прочесть.",["поистине","на Нас","собирание его","и чтение его"]],[75,18,["فَإِذَا","قَرَأۡنَٰهُ","فَٱتَّبِعۡ","قُرۡءَانَهُۥ"],"фа'иза ḳара'наху фаттаби` ḳур'анаху","Когда же Мы прочтем его, то читай его следом.",["и когда","Мы прочитали его","то следуй","чтению его"]],[75,19,["ثُمَّ","إِنَّ","عَلَيۡنَا","بَيَانَهُۥ"],"сумма инна `алайна байанаху","Нам надлежит разъяснять его.",["затем","поистине","на Нас","разъяснение его"]]],"m":[[["فَمَا","и не",74,48],["تَنفَعُهُمۡ","поможет им",74,48],["شَفَٰعَةُ","заступничество",74,48],["ٱلشَّٰفِعِينَ","заступников",74,48],[48],["فَمَا","и что же",74,49],["لَهُمۡ","с ними",74,49],["عَنِ","от",74,49],["ٱلتَّذۡكِرَةِ","напоминания",74,49],["مُعۡرِضِينَ","отворачивающиеся",74,49]],[[49],["كَأَنَّهُمۡ","словно они",74,50],["حُمُرٞ","ослы",74,50],["مُّسۡتَنفِرَةٞ","испуганные",74,50],[50],["فَرَّتۡ","бежавшие",74,51],["