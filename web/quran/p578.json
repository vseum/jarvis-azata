{"p":578,"j":29,"a":[[75,20,["كـَلَّا","بَلۡ","تُحِبُّونَ","ٱلۡعَاجِلَةَ"],"калла бал тухиббуунал `ажилах","Но нет! Вы любите жизнь ближнюю",["так нет же","напротив","вы любите","скоротечное"]],[75,21,["وَتَذَرُونَ","ٱلۡأٓخِرَةَ"],"ватазаруунал ахирах","и пренебрегаете Последней жизнью.",["и оставляете","последнюю жизнь"]],[75,22,["وُجُوهٞ","يَوۡمَئِذٖ","نَّاضِرَةٌ"],"вужуухун йаумаизин надирах","Одни лица в тот день будут сиять",["лица","в тот день","сияющие"]],[75,23,["إِلَىٰ","رَبِّهَا","نَاظِرَةٞ"],"ила раббиха назирах","и взирать на своего Господа.",["к","Господу своему","взирающие"]],[75,24,["وَوُجُوهٞ","يَوۡمَئِذِۭ","بَاسِرَةٞ"],"вавужуухун йаумаизи басирах","Другие же лица в тот день будут омрачены.",["и лица","в тот день","омрачённые"]],[75,25,["تَظُنُّ","أَن","يُفۡعَلَ","بِهَا","فَاقِرَةٞ"],"тазунну ан йуф`ала биха фаḳирах","Они убедятся о том, что их поразит беда.",["полагают","что","будет сделано","с ними","сокрушающее"]],[75,26,["كـَلَّآ","إِذَا","بَلَغَتِ","ٱلتَّرَاقِيَ"],"калла иза балагатит тараḳий","Но нет! Когда душа достигнет ключицы,",["так нет же","когда","дойдёт она","до ключиц"]],[75,27,["وَقِيلَ","مَنۡۜ","رَاقٖ"],"ваḳиила ман раḳ","будет сказано: «Кто же прочтет заклинание?».",["и будет сказано","кто","заклинатель"]],[75,28,["وَظَنَّ","أَنَّهُ","ٱلۡفِرَاقُ"],"вазанна аннахул фираḳ","Умирающий поймет, что наступило расставание.",["и он уверился","что это","расставание"]],[75,29,["وَٱلۡتَفَّتِ","ٱلسَّاقُ","بِٱلسَّاقِ"],"валтаффатис саḳу биссаḳ","Голень сойдется с голенью (тяготы мирской жизни объединятся с тяготами последней жизни или голени человека будут сложены вместе в саване),",["и сплелась","голень","с голенью"]],[75,30,["إِلَىٰ","رَبِّكَ","يَوۡمَئِذٍ","ٱلۡمَسَاقُ"],"ила раббика йаумаизинил масаḳ","и в тот день его пригонят к твоему Господу.",["к","Господу твоему","в тот день","пригон"]],[75,31,["فَلَا","صَدَّقَ","وَلَا","صَلَّىٰ"],"фала саддаḳа вала салла","Он не уверовал и не совершал намаз.",["и не","он уверовал","и не","он молился"]],[75,32,["وَلَٰكِن","كَذَّبَ","وَتَوَلَّىٰ"],"валакин каззаба ватавалла","Напротив, он счел это ложью и отвернулся,",["но","он счёл ложью","и отвернулся"]],[75,33,["ثُمَّ","ذَهَبَ","إِلَىٰٓ","أَهۡلِهِۦ","يَتَمَطَّىٰٓ"],"сумма захаба ила ахлихии йатаматта","а затем горделиво отправился к своей семье.",["затем","он пошёл","к","семье своей","важничая"]],[75,34,["أَوۡلَىٰ","لَكَ","فَأَوۡلَىٰ"],"аула лака фа'аула","Горе тебе, горе!",["горе","тебе","и горе"]],[75,35,["ثُمَّ","أَوۡلَىٰ","لَكَ","فَأَوۡلَىٰٓ"],"сумма аула лака фа'аула","Еще раз горе тебе, горе!",["затем","горе","тебе","и горе"]],[75,36,["أَيَحۡسَبُ","ٱلۡإِنسَٰنُ","أَن","يُتۡرَكَ","سُدًى"],"айахсабул инсану ан йутрака суда","Неужели человек полагает, что он будет оставлен без присмотра?",["неужели думает","человек","что","он будет оставлен","без присмотра"]],[75,37,["أَلَمۡ","يَكُ","نُطۡفَةٗ","مِّن","مَّنِيّٖ","يُمۡنَىٰ"],"алам йаку нутфатам мим маниййин йумна","Разве он не был каплей из семени источаемого?",["разве не","был он","каплей","из","семени","изливаемого"]],[75,38,["ثُمَّ","كَانَ","عَلَقَةٗ","فَخَلَقَ","فَسَوَّىٰ"],"сумма кана `алаḳатан фахалаḳа фасавва","Потом он превратился в сгусток крови, после чего Он создал его и придал ему соразмерный облик.",["затем","он был","сгустком","и Он сотворил","и соразмерил"]],[75,39,["فَجَعَلَ","مِنۡهُ","ٱلزَّوۡجَيۡنِ","ٱلذَّكَرَ","وَٱلۡأُنثَىٰٓ"],"фажа`ала минхуз заужайниз закара вал'унса","Он сотворил из него чету: мужчину и женщину.",["и Он сделал","из него","пару","мужчину","и женщину"]],[75,40,["أَلَيۡسَ","ذَٰلِكَ","بِقَٰدِرٍ","عَلَىٰٓ","أَن","يُحۡـِۧيَ","ٱلۡمَوۡتَىٰ"],"алайса залика биḳадирин `ала ан йухиийал маута","Неужели Он не способен воскресить мертвых?",["разве не","Тот","способен","на","то, чтобы","Он оживил","мёртвых"]],[76,1,["هَلۡ","أَتَىٰ","عَلَى","ٱلۡإِنسَٰنِ","حِينٞ","مِّنَ","ٱلدَّهۡرِ","لَمۡ","يَكُن","شَيۡـٔٗا","مَّذۡكُورًا"],"хал ата `алал инсани хиинум минад дахри лам йакун шай'ам мазкуура","Неужели не прошло то время, когда человек был безвестен?",["Разве","прошло","над","человеком","время","из","вечности","не","был он","чем-то","упоминаемым"]],[76,2,["إِنَّا","خَلَقۡنَا","ٱلۡإِنسَٰنَ","مِن","نُّطۡفَةٍ","أَمۡشَاجٖ","نَّبۡتَلِيهِ","فَجَعَلۡنَٰهُ","سَمِيعَۢا","بَصِيرًا"],"инна халаḳнал инсана мин нутфатин амшажин набталиихи фажа`алнаху самии`а басиира","Мы создали человека из смешанной капли, подвергая его испытанию, и сделали его слышащим и зрячим.",["Поистине, Мы","сотворили Мы","человека","из","капли","смешанной","испытывая его","и сделали Мы его","слышащим","зрячим"]],[76,3,["إِنَّا","هَدَيۡنَٰهُ","ٱلسَّبِيلَ","إِمَّا","شَاكِرٗا","وَإِمَّا","كَفُورًا"],"инна хадайнахус сабиила имма шакиран ва'имма кафуура","Мы повели его путем либо благодарным, либо неблагодарным.",["Поистине, Мы","указали Мы ему","путь","либо","благодарным","и либо","неблагодарным"]],[76,4,["إِنَّآ","أَعۡتَدۡنَا","لِلۡكَٰفِرِينَ","سَلَٰسِلَاْ","وَأَغۡلَٰلٗا","وَسَعِيرًا"],"инна а`тадна лилкафириина саласила ва'аглалан васа`иира","Мы приготовили для неверующих цепи, оковы и пламя.",["поистине, Мы","Мы приготовили","для неверующих","цепи","и оковы","и пламя"]],[76,5,["إِنَّ","ٱلۡأَبۡرَارَ","يَشۡرَبُونَ","مِن","كَأۡسٖ","كَانَ","مِزَاجُهَا","كَافُورًا"],"иннал абрара йашрабууна мин ка'син кана мизажуха кафуура","А благочестивые будут пить из чаши вино, смешанное с камфарой.",["Поистине","благочестивые","будут пить","из","чаши","является","примесь её","камфара"]]]}