{"p":578,"j":29,"a":[[75,20,["كـَلَّا","بَلۡ","تُحِبُّونَ","ٱلۡعَاجِلَةَ"],"каллаа бал тухиббууна л`ааджилах","Но нет! Вы любите жизнь ближнюю",["так нет же","напротив","вы любите","скоротечное"]],[75,21,["وَتَذَرُونَ","ٱلۡأٓخِرَةَ"],"уатазарууна л'хирах","и пренебрегаете Последней жизнью.",["и оставляете","последнюю жизнь"]],[75,22,["وُجُوهٞ","يَوۡمَئِذٖ","نَّاضِرَةٌ"],"ууджуухун йаума'изин наадирах","Одни лица в тот день будут сиять",["лица","в тот день","сияющие"]],[75,23,["إِلَىٰ","رَبِّهَا","نَاظِرَةٞ"],"илаа раббихаа наазирах","и взирать на своего Господа.",["к","Господу своему","взирающие"]],[75,24,["وَوُجُوهٞ","يَوۡمَئِذِۭ","بَاسِرَةٞ"],"уаууджуухун йаума'изи баасирах","Другие же лица в тот день будут омрачены.",["и лица","в тот день","омрачённые"]],[75,25,["تَظُنُّ","أَن","يُفۡعَلَ","بِهَا","فَاقِرَةٞ"],"тазунну ан йуф`ала бихаа фаакирах","Они убедятся о том, что их поразит беда.",["полагают","что","будет сделано","с ними","сокрушающее"]],[75,26,["كـَلَّآ","إِذَا","بَلَغَتِ","ٱلتَّرَاقِيَ"],"каллаа изаа балагати ттараакий","Но нет! Когда душа достигнет ключицы,",["так нет же","когда","дойдёт она","до ключиц"]],[75,27,["وَقِيلَ","مَنۡۜ","رَاقٖ"],"уакиила ман раак","будет сказано: «Кто же прочтет заклинание?».",["и будет сказано","кто","заклинатель"]],[75,28,["وَظَنَّ","أَنَّهُ","ٱلۡفِرَاقُ"],"уазанна аннаху лфираак","Умирающий поймет, что наступило расставание.",["и он уверился","что это","расставание"]],[75,29,["وَٱلۡتَفَّتِ","ٱلسَّاقُ","بِٱلسَّاقِ"],"уалтаффати ссааку биссаак","Голень сойдется с голенью (тяготы мирской жизни объединятся с тяготами последней жизни или голени человека будут сложены вместе в саване),",["и сплелась","голень","с голенью"]],[75,30,["إِلَىٰ","رَبِّكَ","يَوۡمَئِذٍ","ٱلۡمَسَاقُ"],"илаа раббика йаума'изин лмасаак","и в тот день его пригонят к твоему Господу.",["к","Господу твоему","в тот день","пригон"]],[75,31,["فَلَا","صَدَّقَ","وَلَا","صَلَّىٰ"],"фалаа саддака уалаа саллаа","Он не уверовал и не совершал намаз.",["и не","он уверовал","и не","он молился"]],[75,32,["وَلَٰكِن","كَذَّبَ","وَتَوَلَّىٰ"],"уалаакин каззаба уатауаллаа","Напротив, он счел это ложью и отвернулся,",["но","он счёл ложью","и отвернулся"]],[75,33,["ثُمَّ","ذَهَبَ","إِلَىٰٓ","أَهۡلِهِۦ","يَتَمَطَّىٰٓ"],"сумма захаба илаа ахлихии йатаматтаа","а затем горделиво отправился к своей семье.",["затем","он пошёл","к","семье своей","важничая"]],[75,34,["أَوۡلَىٰ","لَكَ","فَأَوۡلَىٰ"],"аулаа лака фа'аулаа","Горе тебе, горе!",["горе","тебе","и горе"]],[75,35,["ثُمَّ","أَوۡلَىٰ","لَكَ","فَأَوۡلَىٰٓ"],"сумма аулаа лака фа'аулаа","Еще раз горе тебе, горе!",["затем","горе","тебе","и горе"]],[75,36,["أَيَحۡسَبُ","ٱلۡإِنسَٰنُ","أَن","يُتۡرَكَ","سُدًى"],"айахсабу л'инсаану ан йутрака суда","Неужели человек полагает, что он будет оставлен без присмотра?",["неужели думает","человек","что","он будет оставлен","без присмотра"]],[75,37,["أَلَمۡ","يَكُ","نُطۡفَةٗ","مِّن","مَّنِيّٖ","يُمۡنَىٰ"],"алам йаку нутфатам мим маниййин йумнаа","Разве он не был каплей из семени источаемого?",["разве не","был он","каплей","из","семени","изливаемого"]],[75,38,["ثُمَّ","كَانَ","عَلَقَةٗ","فَخَلَقَ","فَسَوَّىٰ"],"сумма каана `алакатан фахалака фасаууаа","Потом он превратился в сгусток крови, после чего Он создал его и придал ему соразмерный облик.",["затем","он был","сгустком","и Он сотворил","и соразмерил"]],[75,39,["فَجَعَلَ","مِنۡهُ","ٱلزَّوۡجَيۡنِ","ٱلذَّكَرَ","وَٱلۡأُنثَىٰٓ"],"фаджа`ала минху ззауджайни ззакара уал'унсаа","Он сотворил из него чету: мужчину и женщину.",["и Он сделал","из него","пару","мужчину","и женщину"]],[75,40,["أَلَيۡسَ","ذَٰلِكَ","بِقَٰدِرٍ","عَلَىٰٓ","أَن","يُحۡـِۧيَ","ٱلۡمَوۡتَىٰ"],"алайса заалика бикаадирин `алаа ан йухиийа лмаутаа","Неужели Он не способен воскресить мертвых?",["разве не","Тот","способен","на","то, чтобы","Он оживил","мёртвых"]],[76,1,["هَلۡ","أَتَىٰ","عَلَى","ٱلۡإِنسَٰنِ","حِينٞ","مِّنَ","ٱلدَّهۡرِ","لَمۡ","يَكُن","شَيۡـٔٗا","مَّذۡكُورًا"],"хал атаа `алаа л'инсаани хиинум мина ддахри лам йакун шай'ам мазкуура","Неужели не прошло то время, когда человек был безвестен?",["Разве","прошло","над","человеком","время","из","вечности","не","был он","чем-то","упоминаемым"]],[76,2,["إِنَّا","خَلَقۡنَا","ٱلۡإِنسَٰنَ","مِن","نُّطۡفَةٍ","أَمۡشَاجٖ","نَّبۡتَلِيهِ","فَجَعَلۡنَٰهُ","سَمِيعَۢا","بَصِيرًا"],"иннаа халакнаа л'инсаана мин нутфатин амшааджин набталиихи фаджа`алнааху самии`аа басиира","Мы создали человека из смешанной капли, подвергая его испытанию, и сделали его слышащим и зрячим.",["Поистине, Мы","сотворили Мы","человека","из","капли","смешанной","испытывая его","и сделали Мы его","слышащим","зрячим"]],[76,3,["إِنَّا","هَدَيۡنَٰهُ","ٱلسَّبِيلَ","إِمَّا","شَاكِرٗا","وَإِمَّا","كَفُورًا"],"иннаа хадайнааху ссабиила иммаа шаакиран уа'иммаа кафуура","Мы повели его путем либо благодарным, либо неблагодарным.",["Поистине, Мы","указали Мы ему","путь","либо","благодарным","и либо","неблагодарным"]],[76,4,["إِنَّآ","أَعۡتَدۡنَا","لِلۡكَٰفِرِينَ","سَلَٰسِلَاْ","وَأَغۡلَٰلٗا","وَسَعِيرًا"],"иннаа а`таднаа лилкаафириина салаасила уа'аглаалан уаса`иира","Мы приготовили для неверующих цепи, оковы и пламя.",["поистине, Мы","Мы приготовили","для неверующих","цепи","и оковы","и пламя"]],[76,5,["إِنَّ","ٱلۡأَبۡرَارَ","يَشۡرَبُونَ","مِن","كَأۡسٖ","كَانَ","مِزَاجُهَا","كَافُورًا"],"инна л'абраара йашрабууна мин ка'син каана мизааджухаа каафуура","А благочестивые будут пить из чаши вино, смешанное с камфарой.",["Поистине","благочестивые","будут пить","из","чаши","является","примесь её","камфара"]]]}