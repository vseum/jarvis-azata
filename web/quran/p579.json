{"p":579,"j":29,"a":[[76,6,["عَيۡنٗا","يَشۡرَبُ","بِهَا","عِبَادُ","ٱللَّهِ","يُفَجِّرُونَهَا","تَفۡجِيرٗا"],"`айнан йашрабу биха `ибадуллахи йуфажжируунаха тафжиира","Рабы Аллаха будут пить из источника, давая ему течь полноводными ручьями.",["источник","пьют","из него","рабы","Аллаха","заставляя его течь","потоками"]],[76,7,["يُوفُونَ","بِٱلنَّذۡرِ","وَيَخَافُونَ","يَوۡمٗا","كَانَ","شَرُّهُۥ","مُسۡتَطِيرٗا"],"йууфууна бинназри вайахафууна йауман кана шаррухуу мустатиира","Они исполняют обеты и боятся дня, зло которого разлетается.",["Исполняют они","обеты","и боятся","дня","является","зло его","распространяющимся"]],[76,8,["وَيُطۡعِمُونَ","ٱلطَّعَامَ","عَلَىٰ","حُبِّهِۦ","مِسۡكِينٗا","وَيَتِيمٗا","وَأَسِيرًا"],"вайут`имуунат та`ама `ала хуббихии мискиинан вайатииман ва'асиира","Они дают пищу беднякам, сиротам и пленникам, несмотря на то, что она желанна и для них самих.",["И кормят они","едой","несмотря на","любовь к ней","бедняка","и сироту","и пленника"]],[76,9,["إِنَّمَا","نُطۡعِمُكُمۡ","لِوَجۡهِ","ٱللَّهِ","لَا","نُرِيدُ","مِنكُمۡ","جَزَآءٗ","وَلَا","شُكُورًا"],"иннама нут`имукум ливажхиллахи ла нурииду минкум жазаан вала шукуура","Они говорят: «Мы кормим вас лишь ради Лика Аллаха и не хотим от вас ни награды, ни благодарности!",["Лишь","кормим мы вас","ради Лика","Аллаха","не","желаем мы","от вас","воздаяния","и не","благодарности"]],[76,10,["إِنَّا","نَخَافُ","مِن","رَّبِّنَا","يَوۡمًا","عَبُوسٗا","قَمۡطَرِيرٗا"],"инна нахафу мир раббина йауман `абуусан ḳамтариира","Мы боимся от своего Господа того Мрачного и Томительного дня».",["Поистине, мы","боимся","от","Господа нашего","дня","мрачного","тяжкого"]],[76,11,["فَوَقَىٰهُمُ","ٱللَّهُ","شَرَّ","ذَٰلِكَ","ٱلۡيَوۡمِ","وَلَقَّىٰهُمۡ","نَضۡرَةٗ","وَسُرُورٗا"],"фаваḳахумуллаху шарра заликал йауми валаḳḳахум надратан васуруура","Аллах защитит их от зла того дня и одарит их процветанием и радостью.",["И уберёг их","Аллах","от зла","того","дня","и даровал им","сияние","и радость"]],[76,12,["وَجَزَىٰهُم","بِمَا","صَبَرُواْ","جَنَّةٗ","وَحَرِيرٗا"],"важазахум бима сабаруу жаннатан вахариира","А за то, что они проявили терпение, Он воздаст им Райскими садами и шелками.",["И воздал им","за то, что","терпели они","садом","и шёлком"]],[76,13,["مُّتَّكِـِٔينَ","فِيهَا","عَلَى","ٱلۡأَرَآئِكِۖ","لَا","يَرَوۡنَ","فِيهَا","شَمۡسٗا","وَلَا","زَمۡهَرِيرٗا"],"ммуттаки'иина фииха `алал араики ла йарауна фииха шамсан вала замхариира","Они будут лежать на ложах, прислонившись, и не увидят там ни солнца, ни стужи.",["Возлежащие","там","на","ложах","не","увидят они","там","солнца","и не","стужи"]],[76,14,["وَدَانِيَةً","عَلَيۡهِمۡ","ظِلَٰلُهَا","وَذُلِّلَتۡ","قُطُوفُهَا","تَذۡلِيلٗا"],"ваданийатан `алайхим зилалуха вазуллилат ḳутууфуха тазлиила","Тени будут близки к ним, и плоды будут подчинены им полностью.",["И близки","над ними","тени его","и подчинены","плоды его","покорно"]],[76,15,["وَيُطَافُ","عَلَيۡهِم","بِـَٔانِيَةٖ","مِّن","فِضَّةٖ","وَأَكۡوَابٖ","كَانَتۡ","قَوَارِيرَا۠"],"вайутафу `алайхим би'анийатим мин фиддатин ва'аквабин канат ḳавариир","Обходить их будут с сосудами из серебра и кубками из хрусталя -",["И будут обносить","вокруг них","сосудами","из","серебра","и кубками","являющимися","хрусталём"]],[76,16,["قَوَارِيرَاْ","مِن","فِضَّةٖ","قَدَّرُوهَا","تَقۡدِيرٗا"],"ḳавариира мин фиддатин ḳаддарууха таḳдиира","хрусталя серебряного, соразмерных размеров.",["хрусталём","из","серебра","отмерили они их","мерой"]],[76,17,["وَيُسۡقَوۡنَ","فِيهَا","كَأۡسٗا","كَانَ","مِزَاجُهَا","زَنجَبِيلًا"],"вайусḳауна фииха ка'сан кана мизажуха занжабиила","Поить их там будут из чаш вином, смешанным с имбирем,",["И будут напоены они","там","чашей","является","примесь её","имбирь"]],[76,18,["عَيۡنٗا","فِيهَا","تُسَمَّىٰ","سَلۡسَبِيلٗا"],"`айнан фииха тусамма салсабиила","из источника, названного Салсабилем.",["источником","там","называется","Салсабилем"]],[76,19,["وَيَطُوفُ","عَلَيۡهِمۡ","وِلۡدَٰنٞ","مُّخَلَّدُونَ","إِذَا","رَأَيۡتَهُمۡ","حَسِبۡتَهُمۡ","لُؤۡلُؤٗا","مَّنثُورٗا"],"вайатууфу `алайхим вилданум мухалладууна иза ра'айтахум хасибтахум лу'луам мансуура","Их будут обходить вечно юные отроки. Взглянув на них, ты примешь их за рассыпанный жемчуг.",["И обходят","вокруг них","отроки","вечно юные","когда","увидишь ты их","сочтёшь ты их","жемчугом","рассыпанным"]],[76,20,["وَإِذَا","رَأَيۡتَ","ثَمَّ","رَأَيۡتَ","نَعِيمٗا","وَمُلۡكٗا","كَبِيرًا"],"ва'иза ра'айта самма ра'айта на`ииман вамулкан кабиира","Взглянув же, ты увидишь там благодать и великую власть.",["и когда","ты посмотришь","там","ты увидишь","блаженство","и царство","великое"]],[76,21,["عَٰلِيَهُمۡ","ثِيَابُ","سُندُسٍ","خُضۡرٞ","وَإِسۡتَبۡرَقٞۖ","وَحُلُّوٓاْ","أَسَاوِرَ","مِن","فِضَّةٖ","وَسَقَىٰهُمۡ","رَبُّهُمۡ","شَرَابٗا","طَهُورًا"],"`алийахум сийабу сундусин худрун ва'истабраḳун вахуллуу асавира мин фиддатин васаḳахум раббухум шарабан тахуура","На них будут зеленые одеяния из атласа и парчи. Они будут украшены серебряными браслетами, а Господь их напоит их чистым напитком.",["Поверх них","одежды","из атласа","зелёные","и парча","и украшены они","браслетами","из","серебра","и напоил их","Господь их","питьём","чистым"]],[76,22,["إِنَّ","هَٰذَا","كَانَ","لَكُمۡ","جَزَآءٗ","وَكَانَ","سَعۡيُكُم","مَّشۡكُورًا"],"инна хаза кана лакум жазаан вакана са`йукум машкуура","Таково ваше воздаяние, и ваше усердие отблагодарено.",["Поистине","это","является","для вас","воздаянием","и было","усердие ваше","отблагодарённым"]],[76,23,["إِنَّا","نَحۡنُ","نَزَّلۡنَا","عَلَيۡكَ","ٱلۡقُرۡءَانَ","تَنزِيلٗا"],"инна нахну наззална `алайкал ḳур'ана танзиила","Воистину, Мы ниспослали тебе Коран частями.",["поистине, Мы","Мы","ниспослали","тебе","Коран","постепенно"]],[76,24,["فَٱصۡبِرۡ","لِحُكۡمِ","رَبِّكَ","وَلَا","تُطِعۡ","مِنۡهُمۡ","ءَاثِمًا","أَوۡ","كَفُورٗا"],"фасбир лихукми раббика вала тути` минхум асиман ау кафуура","Потерпи же до решения твоего Господа и не повинуйся грешникам и неверующим среди них.",["Так терпи","решения","Господа твоего","и не","повинуйся","из них","грешнику","или","неверному"]],[76,25,["وَٱذۡكُرِ","ٱسۡمَ","رَبِّكَ","بُكۡرَةٗ","وَأَصِيلٗا"],"вазкурисма раббика букратан ва'асиила","Поминай имя твоего Господа утром и перед закатом,",["И поминай","имя","Господа твоего","утром","и вечером"]]],"m":[[["عَيۡنٗا","источник",76,6],["يَشۡرَبُ","пьют",76,6],["بِهَا","из него",76,6],["عِبَادُ","рабы",76,6],["ٱللَّهِ","Аллаха",76,6],["يُفَجِّرُونَهَا","заставляя его течь",76,6],["تَفۡجِيرٗا","потоками",76,6],[6],["يُوفُونَ","Исполняют они",76,7],["بِٱلنَّذۡرِ","обеты",76,7],["وَيَخَافُونَ","и боятся",76,7]],[["يَوۡمٗا","дня",76,7],["كَانَ","является",76,7],["شَرُّهُۥ","зло его",76,7],["مُسۡتَطِيرٗا","распространяющимся",76,7],[7],["وَيُطۡعِمُونَ","И кормят они",76,8],["ٱلطَّعَامَ","едой",76,8],["عَلَىٰ","несмотря на",76,8],["حُبِّهِۦ","любовь к ней",76,8],["مِسۡكِينٗا","бедняка",76,8]],[["وَيَتِيمٗا","и сироту",76,8],["وَأَسِيرًا","и пленника",76,8],[8],["إِنَّمَا","Лишь",76,9],["نُطۡعِمُكُمۡ","кормим мы вас",76,9],["لِوَجۡهِ","ради Лика",76,9],["ٱللَّهِ","Аллаха",76,9],["لَا","не",76,9],["نُرِيدُ","желаем мы",76,9],["مِنكُمۡ","от вас",76,9],["جَزَآءٗ","воздаяния",76,9],["وَلَا","и не",76,9],["شُكُورًا","благодарности",76,9]],[[9],["إِنَّا","Поистине, мы",76,10],["نَخَافُ","боимся",76,10],["مِن","от",76,10],["رَّبِّنَا","Господа нашего",76,10],["يَوۡمًا","дня",76,10],["عَبُوسٗا","мрачного",76,10],["قَمۡطَرِيرٗا","тяжкого",76,10],[10],["فَوَقَىٰهُمُ","И уберёг их",76,11],["ٱللَّهُ","Аллах",76,11],["شَرَّ","от зла",76,11],["ذَٰلِكَ","того",76,11]],[["ٱلۡيَوۡمِ","дня",76,11],["وَلَقَّىٰهُمۡ","и даровал им",76,11],["نَضۡرَةٗ","сияние",76,11],["وَسُرُورٗا","и радость",76,11],[11],["وَجَزَىٰهُم","И воздал им",76,12],["بِمَا","за то, что",76,12],["صَبَرُواْ","терпели они",76,12],["جَنَّةٗ","садом",76,12],["وَحَرِيرٗا","и шёлком",76,12]],[[12],["مُّتَّكِـِٔينَ","Возлежащие",76,13],["فِيهَا","там",76,13],["عَلَى","на",76,13],["ٱلۡأَرَآئِكِۖ","ложах",76,13],["لَا","не",76,13],["يَرَوۡنَ","увидят они",76,13],["فِيهَا","там",76,13],["شَمۡسٗا","солнца",76,13],["وَلَا","и не",76,13],["زَمۡهَرِيرٗا","стужи",76,13],[13]],[["وَدَانِيَةً","И близки",76,14],["عَلَيۡهِمۡ","над ними",76,14],["ظِلَٰلُهَا","тени его",76,14],["وَذُلِّلَتۡ","и подчинены",76,14],["قُطُوفُهَا","плоды его",76,14],["تَذۡلِيلٗا","покорно",76,14],[14],["وَيُطَافُ","И будут обносить",76,15],["عَلَيۡهِم","вокруг них",76,15],["بِـَٔانِيَةٖ","сосудами",76,15]],[["مِّن","из",76,15],["فِضَّةٖ","серебра",76,15],["وَأَكۡوَابٖ","и кубками",76,15],["كَانَتۡ","являющимися",76,15],["قَوَارِيرَا۠","хрусталём",76,15],[15],["قَوَارِيرَاْ","хрусталём",76,16],["مِن","из",76,16],["فِضَّةٖ","серебра",76,16],["قَدَّرُوهَا","отмерили они их",76,16],["تَقۡدِيرٗا","мерой",76,16],[16]],[["وَيُسۡقَوۡنَ","И будут напоены они",76,17],["فِيهَا","там",76,17],["كَأۡسٗا","чашей",76,17],["كَانَ","является",76,17],["مِزَاجُهَا","примесь её",76,17],["زَنجَبِيلًا","имбирь",76,17],[17],["عَيۡنٗا","источником",76,18],["فِيهَا","там",76,18],["تُسَمَّىٰ","называется",76,18],["سَلۡسَبِيلٗا","Салсабилем",76,18]],[[18],["۞ وَيَطُوفُ","И обходят",76,19],["عَلَيۡهِمۡ","вокруг них",76,19],["وِلۡدَٰنٞ","отроки",76,19],["مُّخَلَّدُونَ","вечно юные",76,19],["إِذَا","когда",76,19],["رَأَيۡتَهُمۡ","увидишь ты их",76,19],["حَسِبۡتَهُمۡ","сочтёшь ты их",76,19],["لُؤۡلُؤٗا","жемчугом",76,19],["مَّنثُورٗا","рассыпанным",76,19]],[[19],["وَإِذَا","и когда",76,20],["رَأَيۡتَ","ты посмотришь",76,20],["ثَمَّ","там",76,20],["رَأَيۡتَ","ты увидишь",76,20],["نَعِيمٗا","блаженство",76,20],["وَمُلۡكٗا","и царство",76,20],["كَبِيرًا","великое",76,20],[20],["عَٰلِيَهُمۡ","Поверх них",76,21],["ثِيَابُ","одежды",76,21],["سُندُسٍ","из атласа",76,21]],[["خُضۡرٞ","зелёные",76,21],["وَإِسۡتَبۡرَقٞۖ","и парча",76,21],["وَحُلُّوٓاْ","и украшены они",76,21],["أَسَاوِرَ","браслетами",76,21],["مِن","из",76,21],["فِضَّةٖ","серебра",76,21],["وَسَقَىٰهُمۡ","и напоил их",76,21],["رَبُّهُمۡ","Господь их",76,21],["شَرَابٗا","питьём",76,21]],[["طَهُورًا","чистым",76,21],[21],["إِنَّ","Поистине",76,22],["هَٰذَا","это",76,22],["كَانَ","является",76,22],["لَ