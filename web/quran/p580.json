{"p":580,"j":29,"a":[[76,26,["وَمِنَ","ٱلَّيۡلِ","فَٱسۡجُدۡ","لَهُۥ","وَسَبِّحۡهُ","لَيۡلٗا","طَوِيلًا"],"ваминал лайли фасжуд лахуу васаббихху лайлан тавиила","а также ночью. Падай ниц пред Ним и славь Его долгой ночью.",["И из","ночи","падай ниц","Ему","и прославляй Его","ночью","долгой"]],[76,27,["إِنَّ","هَٰٓؤُلَآءِ","يُحِبُّونَ","ٱلۡعَاجِلَةَ","وَيَذَرُونَ","وَرَآءَهُمۡ","يَوۡمٗا","ثَقِيلٗا"],"инна ха'улаи йухиббуунал `ажилата вайазарууна вараахум йауман саḳиила","Воистину, эти любят жизнь ближнюю и оставляют позади себя Тяжкий день.",["поистине","эти","любят","преходящее","и оставляют","позади себя","день","тяжкий"]],[76,28,["نَّحۡنُ","خَلَقۡنَٰهُمۡ","وَشَدَدۡنَآ","أَسۡرَهُمۡۖ","وَإِذَا","شِئۡنَا","بَدَّلۡنَآ","أَمۡثَٰلَهُمۡ","تَبۡدِيلًا"],"ннахну халаḳнахум вашададна асрахум ва'иза ши'на баддална амсалахум табдиила","Мы создали их и укрепили их суставы. Но если Мы пожелаем, то заменим их подобными им.",["Мы","сотворили Мы их","и укрепили Мы","строение их","и когда","пожелаем Мы","заменим Мы","подобными им","заменой"]],[76,29,["إِنَّ","هَٰذِهِۦ","تَذۡكِرَةٞۖ","فَمَن","شَآءَ","ٱتَّخَذَ","إِلَىٰ","رَبِّهِۦ","سَبِيلٗا"],"инна хазихии тазкиратун фаман шааттахаза ила раббихии сабиила","Воистину, это есть Назидание, и тот, кто желает, становится на путь к своему Господу.",["Поистине","это","напоминание","и кто","пожелает","изберёт","к","Господу своему","путь"]],[76,30,["وَمَا","تَشَآءُونَ","إِلَّآ","أَن","يَشَآءَ","ٱللَّهُۚ","إِنَّ","ٱللَّهَ","كَانَ","عَلِيمًا","حَكِيمٗا"],"вама ташаууна илла ан йашааллаху инналлаха кана `алииман хакиима","Но вы не пожелаете этого, если не пожелает Аллах. Воистину, Аллах - Знающий, Мудрый.",["И не","пожелаете вы","кроме","как","пожелает","Аллах","Поистине","Аллах","является","Знающим","Мудрым"]],[76,31,["يُدۡخِلُ","مَن","يَشَآءُ","فِي","رَحۡمَتِهِۦۚ","وَٱلظَّٰلِمِينَ","أَعَدَّ","لَهُمۡ","عَذَابًا","أَلِيمَۢا"],"йудхилу ман йашау фии рахматихии ваззалимиина а`адда лахум `азабан алиима","Он вводит в Свою милость, кого пожелает, а для беззаконников Он приготовил мучительные страдания.",["Вводит Он","кого","пожелает Он","в","милость Свою","а беззаконникам","приготовил Он","для них","наказание","мучительное"]],[77,1,["وَٱلۡمُرۡسَلَٰتِ","عُرۡفٗا"],"валмурсалати `урфа","Клянусь посылаемыми с добром,",["Клянусь посылаемыми","чередой"]],[77,2,["فَٱلۡعَٰصِفَٰتِ","عَصۡفٗا"],"фал`асифати `асфа","несущимися быстро,",["и бурными","порывисто"]],[77,3,["وَٱلنَّٰشِرَٰتِ","نَشۡرٗا"],"ваннаширати нашра","распространяющими бурно,",["и распространяющими","широко"]],[77,4,["فَٱلۡفَٰرِقَٰتِ","فَرۡقٗا"],"фалфариḳати фарḳа","различающими твердо,",["и различающими","различением"]],[77,5,["فَٱلۡمُلۡقِيَٰتِ","ذِكۡرًا"],"фалмулḳийати зикра","и передающими Напоминание",["и доставляющими","напоминание"]],[77,6,["عُذۡرًا","أَوۡ","نُذۡرًا"],"`узран ау нузра","для оправдания или предостережения.",["оправданием","или","предостережением"]],[77,7,["إِنَّمَا","تُوعَدُونَ","لَوَٰقِعٞ"],"иннама туу`адууна лаваḳи`","Обещанное вам непременно сбудется.",["Поистине, то что","обещано вам","непременно сбудется"]],[77,8,["فَإِذَا","ٱلنُّجُومُ","طُمِسَتۡ"],"фа'изан нужууму тумисат","Когда погаснут звезды,",["И когда","звёзды","будут погашены"]],[77,9,["وَإِذَا","ٱلسَّمَآءُ","فُرِجَتۡ"],"ва'изас самау фурижат","когда расколется небо,",["И когда","небо","расколется"]],[77,10,["وَإِذَا","ٱلۡجِبَالُ","نُسِفَتۡ"],"ва'изал жибалу нусифат","когда развеются горы,",["И когда","горы","будут развеяны"]],[77,11,["وَإِذَا","ٱلرُّسُلُ","أُقِّتَتۡ"],"ва'изар русулу уḳḳитат","когда посланникам будет установлен срок.",["И когда","посланникам","будет назначен срок"]],[77,12,["لِأَيِّ","يَوۡمٍ","أُجِّلَتۡ"],"ли'аййи йаумин ужжилат","До какого дня отсрочено?",["Для какого","дня","отсрочено"]],[77,13,["لِيَوۡمِ","ٱلۡفَصۡلِ"],"лийаумил фасл","До Дня различения!",["Для дня","различения"]],[77,14,["وَمَآ","أَدۡرَىٰكَ","مَا","يَوۡمُ","ٱلۡفَصۡلِ"],"вама адрака ма йаумул фасл","Откуда ты мог знать, что такое День различения?",["И что","дало знать тебе","что","день","различения"]],[77,15,["وَيۡلٞ","يَوۡمَئِذٖ","لِّلۡمُكَذِّبِينَ"],"вайлун йаумаизил лилмуказзибиин","Горе в тот день тем, кто считает истину ложью!",["Горе","в тот день","отвергающим"]],[77,16,["أَلَمۡ","نُهۡلِكِ","ٱلۡأَوَّلِينَ"],"алам нухликил аввалиин","Разве мы не погубили первые поколения?",["Разве не","погубили Мы","первых"]],[77,17,["ثُمَّ","نُتۡبِعُهُمُ","ٱلۡأٓخِرِينَ"],"сумма нутби`ухумул ахириин","Вслед за ними Мы отправили последующие поколения.",["Затем","пускаем Мы вслед им","последних"]],[77,18,["كَذَٰلِكَ","نَفۡعَلُ","بِٱلۡمُجۡرِمِينَ"],"казалика наф`алу билмужримиин","Так поступаем Мы с грешниками.",["Так","поступаем Мы","с грешниками"]],[77,19,["وَيۡلٞ","يَوۡمَئِذٖ","لِّلۡمُكَذِّبِينَ"],"вайлун йаумаизил лилмуказзибиин","Горе в тот день тем, кто считает истину ложью!",["Горе","в тот день","отвергающим"]]]}