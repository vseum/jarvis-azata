{"p":581,"j":29,"a":[[77,20,["أَلَمۡ","نَخۡلُقكُّم","مِّن","مَّآءٖ","مَّهِينٖ"],"алам нахлуḳккум мим маим махиин","Разве Мы не сотворили вас из презренной жидкости",["Разве не","сотворили Мы вас","из","воды","презренной"]],[77,21,["فَجَعَلۡنَٰهُ","فِي","قَرَارٖ","مَّكِينٍ"],"фажа`алнаху фии ḳарарим макиин","и не поместили ее в надежном месте",["И поместили Мы её","в","место пребывания","надёжное"]],[77,22,["إِلَىٰ","قَدَرٖ","مَّعۡلُومٖ"],"ила ḳадарим ма`луум","до известного срока?",["до","срока","известного"]],[77,23,["فَقَدَرۡنَا","فَنِعۡمَ","ٱلۡقَٰدِرُونَ"],"фаḳадарна фани`мал ḳадируун","Мы предопределили меру, и как прекрасно Мы предопределяем!",["И определили Мы","и прекрасны же","определяющие"]],[77,24,["وَيۡلٞ","يَوۡمَئِذٖ","لِّلۡمُكَذِّبِينَ"],"вайлун йаумаизил лилмуказзибиин","Горе в тот день тем, кто считает истину ложью!",["Горе","в тот день","отвергающим"]],[77,25,["أَلَمۡ","نَجۡعَلِ","ٱلۡأَرۡضَ","كِفَاتًا"],"алам наж`алил арда кифата","Разве Мы не сделали землю вместилищем",["Разве не","сделали Мы","землю","вместилищем"]],[77,26,["أَحۡيَآءٗ","وَأَمۡوَٰتٗا"],"ахйаан ва'амвата","для живых и мертвых?",["живых","и мёртвых"]],[77,27,["وَجَعَلۡنَا","فِيهَا","رَوَٰسِيَ","شَٰمِخَٰتٖ","وَأَسۡقَيۡنَٰكُم","مَّآءٗ","فُرَاتٗا"],"важа`ална фииха равасийа шамихатин ва'асḳайнакум маан фурата","Разве Мы не воздвигли на ней незыблемые и высокие горы и не напоили вас пресной водой?",["И сделали Мы","на ней","горы незыблемые","высокие","и напоили Мы вас","водой","пресной"]],[77,28,["وَيۡلٞ","يَوۡمَئِذٖ","لِّلۡمُكَذِّبِينَ"],"вайлун йаумаизил лилмуказзибиин","Горе в тот день тем, кто считает истину ложью!",["Горе","в тот день","отвергающим"]],[77,29,["ٱنطَلِقُوٓاْ","إِلَىٰ","مَا","كُنتُم","بِهِۦ","تُكَذِّبُونَ"],"инталиḳуу ила ма кунтум бихии туказзибуун","Ступайте к тому, что вы считали ложью!",["ступайте","к","тому, что","вы были","его","считаете ложью"]],[77,30,["ٱنطَلِقُوٓاْ","إِلَىٰ","ظِلّٖ","ذِي","ثَلَٰثِ","شُعَبٖ"],"инталиḳуу ила зиллин зии саласи шу`аб","Ступайте 