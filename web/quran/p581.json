{"p":581,"j":29,"a":[[77,20,["أَلَمۡ","نَخۡلُقكُّم","مِّن","مَّآءٖ","مَّهِينٖ"],"алам нахлукккум ммим маа'им махиин","Разве Мы не сотворили вас из презренной жидкости",["Разве не","сотворили Мы вас","из","воды","презренной"]],[77,21,["فَجَعَلۡنَٰهُ","فِي","قَرَارٖ","مَّكِينٍ"],"фаджа`алнааху фии караарим макиин","и не поместили ее в надежном месте",["И поместили Мы её","в","место пребывания","надёжное"]],[77,22,["إِلَىٰ","قَدَرٖ","مَّعۡلُومٖ"],"илаа кадарим ма`луум","до известного срока?",["до","срока","известного"]],[77,23,["فَقَدَرۡنَا","فَنِعۡمَ","ٱلۡقَٰدِرُونَ"],"факадарнаа фани`ма лкаадируун","Мы предопределили меру, и как прекрасно Мы предопределяем!",["И определили Мы","и прекрасны же","определяющие"]],[77,24,["وَيۡلٞ","يَوۡمَئِذٖ","لِّلۡمُكَذِّبِينَ"],"уайлун йаума'изил лилмуказзибиин","Горе в тот день тем, кто считает истину ложью!",["Горе","в тот день","отвергающим"]],[77,25,["أَلَمۡ","نَجۡعَلِ","ٱلۡأَرۡضَ","كِفَاتًا"],"алам надж`али л'арда кифаата","Разве Мы не сделали землю вместилищем",["Разве не","сделали Мы","землю","вместилищем"]],[77,26,["أَحۡيَآءٗ","وَأَمۡوَٰتٗا"],"ахйаа'ан уа'амуаата","для живых и мертвых?",["живых","и мёртвых"]],[77,27,["وَجَعَلۡنَا","فِيهَا","رَوَٰسِيَ","شَٰمِخَٰتٖ","وَأَسۡقَيۡنَٰكُم","مَّآءٗ","فُرَاتٗا"],"уаджа`алнаа фиихаа рауаасийа шаамихаатин уа'аскайнаакум ммаа'ан фураата","Разве Мы не воздвигли на ней незыблемые и высокие горы и не напоили вас пресной водой?",["И сделали Мы","на ней","горы незыблемые","высокие","и напоили Мы вас","водой","пресной"]],[77,28,["وَيۡلٞ","يَوۡمَئِذٖ","لِّلۡمُكَذِّبِينَ"],"уайлун йаума'изил лилмуказзибиин","Горе в тот день тем, кто считает истину ложью!",["Горе","в тот день","отвергающим"]],[77,29,["ٱنطَلِقُوٓاْ","إِلَىٰ","مَا","كُنتُم","بِهِۦ","تُكَذِّبُونَ"],"инталикуу илаа маа кунтум бихии туказзибуун","Ступайте к тому, что вы считали ложью!",["ступайте","к","тому, что","вы были","его","считаете ложью"]],[77,30,["ٱنطَلِقُوٓاْ","إِلَىٰ","ظِلّٖ","ذِي","ثَلَٰثِ","شُعَبٖ"],"инталикуу илаа зиллин зии салааси шу`аб","Ступайте к тени с тремя разветвлениями.",["Ступайте","к","тени","имеющей","три","ответвления"]],[77,31,["لَّا","ظَلِيلٖ","وَلَا","يُغۡنِي","مِنَ","ٱللَّهَبِ"],"ллаа залиилин уалаа йугнии мина ллахаб","Не прохладна она и от пламени не избавляет,",["не","затеняющей","и не","избавляющей","от","пламени"]],[77,32,["إِنَّهَا","تَرۡمِي","بِشَرَرٖ","كَٱلۡقَصۡرِ"],"иннахаа тармии бишарарин калкаср","а он бросает искры, подобные замку,",["Поистине, она","бросает","искрами","как замок"]],[77,33,["كَأَنَّهُۥ","جِمَٰلَتٞ","صُفۡرٞ"],"ка'аннахуу джимаалатун суфр","который выглядит словно желтые верблюды.",["Словно они","верблюды","жёлтые"]],[77,34,["وَيۡلٞ","يَوۡمَئِذٖ","لِّلۡمُكَذِّبِينَ"],"уайлун йаума'изил лилмуказзибиин","Горе в тот день тем, кто считает истину ложью!",["Горе","в тот день","отвергающим"]],[77,35,["هَٰذَا","يَوۡمُ","لَا","يَنطِقُونَ"],"хаазаа йауму лаа йантикуун","В тот день они будут безмолвствовать,",["Это","день","не","говорят они"]],[77,36,["وَلَا","يُؤۡذَنُ","لَهُمۡ","فَيَعۡتَذِرُونَ"],"уалаа йу'зану лахум файа`тазируун","и не будет им дозволено оправдываться.",["И не","позволяется","им","чтобы оправдываться"]],[77,37,["وَيۡلٞ","يَوۡمَئِذٖ","لِّلۡمُكَذِّبِينَ"],"уайлун йаума'изил лилмуказзибиин","Горе в тот день тем, кто считает истину ложью!",["Горе","в тот день","отвергающим"]],[77,38,["هَٰذَا","يَوۡمُ","ٱلۡفَصۡلِۖ","جَمَعۡنَٰكُمۡ","وَٱلۡأَوَّلِينَ"],"хаазаа йауму лфасли джама`наакум уал'аууалиин","Вот День различения! Мы собрали вас и тех, кто был прежде.",["Это","день","различения","собрали Мы вас","и первых"]],[77,39,["فَإِن","كَانَ","لَكُمۡ","كَيۡدٞ","فَكِيدُونِ"],"фа'ин каана лакум кайдун факиидуун","Если у вас есть какая-нибудь хитрость, то ухитритесь против Меня!",["И если","есть","у вас","хитрость","то хитрите против Меня"]],[77,40,["وَيۡلٞ","يَوۡمَئِذٖ","لِّلۡمُكَذِّبِينَ"],"уайлун йаума'изил лилмуказзибиин","Горе в тот день тем, кто считает истину ложью!",["Горе","в тот день","отвергающим"]],[77,41,["إِنَّ","ٱلۡمُتَّقِينَ","فِي","ظِلَٰلٖ","وَعُيُونٖ"],"инна лмуттакиина фии зилаалин уа`уйуун","А богобоязненные, воистину, пребудут среди сеней и источников",["Поистине","богобоязненные","среди","теней","и источников"]],[77,42,["وَفَوَٰكِهَ","مِمَّا","يَشۡتَهُونَ"],"уафауаакиха миммаа йаштахуун","и плодов, каких только пожелают.",["И плодов","из того, что","пожелают они"]],[77,43,["كُلُواْ","وَٱشۡرَبُواْ","هَنِيٓـَٔۢا","بِمَا","كُنتُمۡ","تَعۡمَلُونَ"],"кулуу уашрабуу хании'аа бимаа кунтум та`малуун","Ешьте и пейте во здравие за то, что вы совершали!",["Ешьте","и пейте","во здравие","за то, что","были вы","делали"]],[77,44,["إِنَّا","كَذَٰلِكَ","نَجۡزِي","ٱلۡمُحۡسِنِينَ"],"иннаа казаалика наджзии лмухсиниин","Так Мы вознаграждаем творящих добро.",["Поистине, Мы","так","воздаём Мы","творящим добро"]],[77,45,["وَيۡلٞ","يَوۡمَئِذٖ","لِّلۡمُكَذِّبِينَ"],"уайлун йаума'изил лилмуказзибиин","Горе в тот день тем, кто считает истину ложью!",["Горе","в тот день","отвергающим"]],[77,46,["كُلُواْ","وَتَمَتَّعُواْ","قَلِيلًا","إِنَّكُم","مُّجۡرِمُونَ"],"кулуу уатаматта`уу калиилан иннакум ммуджримуун","Вкушайте и наслаждайтесь недолго, ведь вы являетесь грешниками.",["Ешьте","и наслаждайтесь","немного","поистине, вы","грешники"]],[77,47,["وَيۡلٞ","يَوۡمَئِذٖ","لِّلۡمُكَذِّبِينَ"],"уайлун йаума'изил лилмуказзибиин","Горе в тот день тем, кто считает истину ложью!",["Горе","в тот день","отвергающим"]],[77,48,["وَإِذَا","قِيلَ","لَهُمُ","ٱرۡكَعُواْ","لَا","يَرۡكَعُونَ"],"уа'изаа киила лахуму рка`уу лаа йарка`уун","Когда им говорят: «Поклонитесь!». - они не кланяются.",["И когда","сказано","им","кланяйтесь","не","кланяются они"]],[77,49,["وَيۡلٞ","يَوۡمَئِذٖ","لِّلۡمُكَذِّبِينَ"],"уайлун йаума'изил лилмуказзибиин","Горе в тот день тем, кто считает истину ложью!",["Горе","в тот день","отвергающим"]],[77,50,["فَبِأَيِّ","حَدِيثِۭ","بَعۡدَهُۥ","يُؤۡمِنُونَ"],"фаби'аййи хадииси ба`дахуу йу'минуун","В какой же рассказ после этого вы уверуете?",["Так в какой же","рассказ","после него","уверуют они"]]]}