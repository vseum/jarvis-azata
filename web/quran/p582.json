{"p":582,"j":30,"a":[[78,1,["عَمَّ","يَتَسَآءَلُونَ"],"`амма йатасаалуун","О чем они расспрашивают друг друга?",["О чём","расспрашивают они друг друга"]],[78,2,["عَنِ","ٱلنَّبَإِ","ٱلۡعَظِيمِ"],"`анин набаил `азиим","О великой вести,",["О","вести","великой"]],[78,3,["ٱلَّذِي","هُمۡ","فِيهِ","مُخۡتَلِفُونَ"],"аллазии хум фиихи мухталифуун","относительно которой они расходятся во мнениях.",["которой","они","о ней","расходятся во мнениях"]],[78,4,["كـَلَّا","سَيَعۡلَمُونَ"],"калла сайа`ламуун","Но нет, они узнают!",["Так нет же","скоро узнают они"]],[78,5,["ثُمَّ","كـَلَّا","سَيَعۡلَمُونَ"],"сумма калла сайа`ламуун","Еще раз нет, они узнают!",["Затем","так нет же","скоро узнают они"]],[78,6,["أَلَمۡ","نَجۡعَلِ","ٱلۡأَرۡضَ","مِهَٰدٗا"],"алам наж`алил арда михада","Разве Мы не сделали землю ложем,",["Разве не","сделали Мы","землю","ложем"]],[78,7,["وَٱلۡجِبَالَ","أَوۡتَادٗا"],"валжибала аутада","а горы - колышками?",["И горы","колышками"]],[78,8,["وَخَلَقۡنَٰكُمۡ","أَزۡوَٰجٗا"],"вахалаḳнакум азважа","Мы сотворили вас парами,",["И сотворили Мы вас","парами"]],[78,9,["وَجَعَلۡنَا","نَوۡمَكُمۡ","سُبَاتٗا"],"важа`ална наумакум субата","и сделали ваш сон отдыхом,",["И сделали Мы","сон ваш","отдыхом"]],[78,10,["وَجَعَلۡنَا","ٱلَّيۡلَ","لِبَاسٗا"],"важа`алнал лайла либаса","и сделали ночь покрывалом,",["И сделали Мы","ночь","покровом"]],[78,11,["وَجَعَلۡنَا","ٱلنَّهَارَ","مَعَاشٗا"],"важа`алнан нахара ма`аша","и сделали день жалованием,",["И сделали Мы","день","средством к жизни"]],[78,12,["وَبَنَيۡنَا","فَوۡقَكُمۡ","سَبۡعٗا","شِدَادٗا"],"вабанайна фауḳакум саб`ан шидада","и воздвигли над вами семь твердынь,",["И воздвигли Мы","над вами","семь","прочных"]],[78,13,["وَجَعَلۡنَا","سِرَاجٗا","وَهَّاجٗا"],"важа`ална сиражан ваххажа","и установили пылающий светильник,",["И сделали Мы","светильник","пылающий"]],[78,14,["وَأَنزَلۡنَا","مِنَ","ٱلۡمُعۡصِرَٰتِ","مَآءٗ","ثَجَّاجٗا"],"ва'анзална минал му`сирати маан сажжажа","и низвели из облаков обильно льющуюся воду,",["И низвели Мы","из","дождевых облаков","воду","обильно льющуюся"]],[78,15,["لِّنُخۡرِجَ","بِهِۦ","حَبّٗا","وَنَبَاتٗا"],"ллинухрижа бихии хаббан ванабата","чтобы взрастить ею зерна и растения",["чтобы взрастить Нам","ею","зерно","и растения"]],[78,16,["وَجَنَّٰتٍ","أَلۡفَافًا"],"важаннатин алфафа","и густые сады.",["И сады","густые"]],[78,17,["إِنَّ","يَوۡمَ","ٱلۡفَصۡلِ","كَانَ","مِيقَٰتٗا"],"инна йаумал фасли кана мииḳата","Воистину, День различения назначен на определенное время.",["Поистине","день","различения","является","установленным сроком"]],[78,18,["يَوۡمَ","يُنفَخُ","فِي","ٱلصُّورِ","فَتَأۡتُونَ","أَفۡوَاجٗا"],"йаума йунфаху фис суури фата'тууна афважа","В тот день затрубят в Рог, и вы придете толпами,",["В день","подуют","в","Рог","и придёте вы","толпами"]],[78,19,["وَفُتِحَتِ","ٱلسَّمَآءُ","فَكَانَتۡ","أَبۡوَٰبٗا"],"вафутихатис самау факанат абваба","и небо раскроется и станет вратами,",["И раскроется","небо","и станет","вратами"]],[78,20,["وَسُيِّرَتِ","ٱلۡجِبَالُ","فَكَانَتۡ","سَرَابًا"],"васуййиратил жибалу факанат сараба","и горы придут в движение и станут маревом.",["И сдвинуты будут","горы","и станут","маревом"]],[78,21,["إِنَّ","جَهَنَّمَ","كَانَتۡ","مِرۡصَادٗا"],"инна жаханнама канат мирсада","Воистину, Геенна является засадой",["Поистине","Геенна","является","засадой"]],[78,22,["لِّلطَّٰغِينَ","مَـَٔابٗا"],"ллиттагиина ма'аба","и местом возвращения для тех, кто преступает границы дозволенного.",["для преступивших","местом возвращения"]],[78,23,["لَّٰبِثِينَ","فِيهَآ","أَحۡقَابٗا"],"ллабисиина фииха ахḳаба","Они пробудут там долгие годы,",["пребывающими","в ней","веками"]],[78,24,["لَّا","يَذُوقُونَ","فِيهَا","بَرۡدٗا","وَلَا","شَرَابًا"],"лла йазууḳууна фииха бардан вала шараба","не вкушая ни прохлады, ни питья,",["не","вкусят они","в ней","прохлады","и не","питья"]],[78,25,["إِلَّا","حَمِيمٗا","وَغَسَّاقٗا"],"илла хамииман вагассаḳа","а только кипяток и гной.",["кроме","кипятка","и гноя"]],[78,26,["جَزَآءٗ","وِفَاقًا"],"жазаан вифаḳа","Это будет подобающим возмездием.",["воздаянием","соответствующим"]],[78,27,["إِنَّهُمۡ","كَانُواْ","لَا","يَرۡجُونَ","حِسَابٗا"],"иннахум кануу ла йаржууна хисаба","Воистину, они не надеялись на расчет",["Поистине, они","были","не","ожидающими","расчёта"]],[78,28,["وَكَذَّبُواْ","بِـَٔايَٰتِنَا","كِذَّابٗا"],"ваказзабуу би'айатина киззаба","и полностью отрицали Наши знамения.",["И отвергали они","Наши знамения","полным отрицанием"]],[78,29,["وَكُلَّ","شَيۡءٍ","أَحۡصَيۡنَٰهُ","كِتَٰبٗا"],"вакулла шай'ин ахсайнаху китаба","Мы же всякую вещь подсчитали и записали.",["И всякую","вещь","исчислили Мы её","в записи"]],[78,30,["فَذُوقُواْ","فَلَن","نَّزِيدَكُمۡ","إِلَّا","عَذَابًا"],"фазууḳуу фалан назиидакум илла `азаба","Вкушайте же! Мы не прибавим вам ничего, кроме мучений.",["Так вкусите","и никак не","прибавим Мы вам","кроме","наказания"]]],"m":[["h",78],["b"],[["عَمَّ","О чём",78,1],["يَتَسَآءَلُونَ","расспрашивают они друг друга",78,1],[1],["عَنِ","О",78,2],["ٱلنَّبَإِ","вести",78,2],["ٱلۡعَظِيمِ","великой",78,2],[2],["ٱلَّذِي","которой",78,3],["هُمۡ","они",78,3],["فِيهِ","о ней",78,3],["مُخۡتَلِفُونَ","расходятся во мнениях",78,3],[3]],[["كـَلَّا","Так нет же",78,4],["سَيَعۡلَمُونَ","скоро узнают они",78,4],[4],["ثُمَّ","Затем",78,5],["كـَلَّا","так нет же",78,5],["سَيَعۡلَمُونَ","скоро узнают они",78,5],[5],["أَلَمۡ","Разве не",78,6],["نَجۡعَلِ","сделали Мы",78,6],["ٱلۡأَرۡضَ","землю",78,6],["مِهَٰدٗا","ложем",78,6],[6]],[["وَٱلۡجِبَالَ","И горы",78,7],["أَوۡتَادٗا","колышками",78,7],[7],["وَخَلَقۡنَٰكُمۡ","И сотворили Мы вас",78,8],["أَزۡوَٰجٗا","парами",78,8],[8],["وَجَعَلۡنَا","И сделали Мы",78,9],["نَوۡمَكُمۡ","сон ваш",78,9],["سُبَاتٗا","отдыхом",78,9]],[[9],["وَجَعَلۡنَا","И сделали Мы",78,10],["ٱلَّيۡلَ","ночь",78,10],["لِبَاسٗا","покровом",78,10],[10],["وَجَعَلۡنَا","И сделали Мы",78,11],["ٱلنَّهَارَ","день",78,11],["مَعَاشٗا","средством к жизни",78,11],[11],["وَبَنَيۡنَا","И воздвигли Мы",78,12]],[["فَوۡقَكُمۡ","над вами",78,12],["سَبۡعٗا","семь",78,12],["شِدَادٗا","прочных",