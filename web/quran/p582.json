{"p":582,"j":30,"a":[[78,1,["عَمَّ","يَتَسَآءَلُونَ"],"`амма йатасаа'алуун","О чем они расспрашивают друг друга?",["О чём","расспрашивают они друг друга"]],[78,2,["عَنِ","ٱلنَّبَإِ","ٱلۡعَظِيمِ"],"`ани ннаба'и л`азиим","О великой вести,",["О","вести","великой"]],[78,3,["ٱلَّذِي","هُمۡ","فِيهِ","مُخۡتَلِفُونَ"],"аллазии хум фиихи мухталифуун","относительно которой они расходятся во мнениях.",["которой","они","о ней","расходятся во мнениях"]],[78,4,["كـَلَّا","سَيَعۡلَمُونَ"],"каллаа сайа`ламуун","Но нет, они узнают!",["Так нет же","скоро узнают они"]],[78,5,["ثُمَّ","كـَلَّا","سَيَعۡلَمُونَ"],"сумма каллаа сайа`ламуун","Еще раз нет, они узнают!",["Затем","так нет же","скоро узнают они"]],[78,6,["أَلَمۡ","نَجۡعَلِ","ٱلۡأَرۡضَ","مِهَٰدٗا"],"алам надж`али л'арда михаада","Разве Мы не сделали землю ложем,",["Разве не","сделали Мы","землю","ложем"]],[78,7,["وَٱلۡجِبَالَ","أَوۡتَادٗا"],"уалджибаала аутаада","а горы - колышками?",["И горы","колышками"]],[78,8,["وَخَلَقۡنَٰكُمۡ","أَزۡوَٰجٗا"],"уахалакнаакум азуааджа","Мы сотворили вас парами,",["И сотворили Мы вас","парами"]],[78,9,["وَجَعَلۡنَا","نَوۡمَكُمۡ","سُبَاتٗا"],"уаджа`алнаа наумакум субаата","и сделали ваш сон отдыхом,",["И сделали Мы","сон ваш","отдыхом"]],[78,10,["وَجَعَلۡنَا","ٱلَّيۡلَ","لِبَاسٗا"],"уаджа`алнаа ллайла либааса","и сделали ночь покрывалом,",["И сделали Мы","ночь","покровом"]],[78,11,["وَجَعَلۡنَا","ٱلنَّهَارَ","مَعَاشٗا"],"уаджа`алнаа ннахаара ма`ааша","и сделали день жалованием,",["И сделали Мы","день","средством к жизни"]],[78,12,["وَبَنَيۡنَا","فَوۡقَكُمۡ","سَبۡعٗا","شِدَادٗا"],"уабанайнаа фаукакум саб`ан шидаада","и воздвигли над вами семь твердынь,",["И воздвигли Мы","над вами","семь","прочных"]],[78,13,["وَجَعَلۡنَا","سِرَاجٗا","وَهَّاجٗا"],"уаджа`алнаа сирааджан уаххааджа","и установили пылающий светильник,",["И сделали Мы","светильник","пылающий"]],[78,14,["وَأَنزَلۡنَا","مِنَ","ٱلۡمُعۡصِرَٰتِ","مَآءٗ","ثَجَّاجٗا"],"уа'анзалнаа мина лму`сираати маа'ан саджджааджа","и низвели из облаков обильно льющуюся воду,",["И низвели Мы","из","дождевых облаков","воду","обильно льющуюся"]],[78,15,["لِّنُخۡرِجَ","بِهِۦ","حَبّٗا","وَنَبَاتٗا"],"ллинухриджа бихии хаббан уанабаата","чтобы взрастить ею зерна и растения",["чтобы взрастить Нам","ею","зерно","и растения"]],[78,16,["وَجَنَّٰتٍ","أَلۡفَافًا"],"уаджаннаатин алфаафа","и густые сады.",["И сады","густые"]],[78,17,["إِنَّ","يَوۡمَ","ٱلۡفَصۡلِ","كَانَ","مِيقَٰتٗا"],"инна йаума лфасли каана миикаата","Воистину, День различения назначен на определенное время.",["Поистине","день","различения","является","установленным сроком"]],[78,18,["يَوۡمَ","يُنفَخُ","فِي","ٱلصُّورِ","فَتَأۡتُونَ","أَفۡوَاجٗا"],"йаума йунфаху фии ссуури фата'тууна афуааджа","В тот день затрубят в Рог, и вы придете толпами,",["В день","подуют","в","Рог","и придёте вы","толпами"]],[78,19,["وَفُتِحَتِ","ٱلسَّمَآءُ","فَكَانَتۡ","أَبۡوَٰبٗا"],"уафутихати ссамаа'у факаанат абуааба","и небо раскроется и станет вратами,",["И раскроется","небо","и станет","вратами"]],[78,20,["وَسُيِّرَتِ","ٱلۡجِبَالُ","فَكَانَتۡ","سَرَابًا"],"уасуййирати лджибаалу факаанат сарааба","и горы придут в движение и станут маревом.",["И сдвинуты будут","горы","и станут","маревом"]],[78,21,["إِنَّ","جَهَنَّمَ","كَانَتۡ","مِرۡصَادٗا"],"инна джаханнама каанат мирсаада","Воистину, Геенна является засадой",["Поистине","Геенна","является","засадой"]],[78,22,["لِّلطَّٰغِينَ","مَـَٔابٗا"],"ллилттаагиина ма'ааба","и местом возвращения для тех, кто преступает границы дозволенного.",["для преступивших","местом возвращения"]],[78,23,["لَّٰبِثِينَ","فِيهَآ","أَحۡقَابٗا"],"ллаабисиина фиихаа ахкааба","Они пробудут там долгие годы,",["пребывающими","в ней","веками"]],[78,24,["لَّا","يَذُوقُونَ","فِيهَا","بَرۡدٗا","وَلَا","شَرَابًا"],"ллаа йазуукууна фиихаа бардан уалаа шарааба","не вкушая ни прохлады, ни питья,",["не","вкусят они","в ней","прохлады","и не","питья"]],[78,25,["إِلَّا","حَمِيمٗا","وَغَسَّاقٗا"],"иллаа хамииман уагассаака","а только кипяток и гной.",["кроме","кипятка","и гноя"]],[78,26,["جَزَآءٗ","وِفَاقًا"],"джазаа'ан уифаака","Это будет подобающим возмездием.",["воздаянием","соответствующим"]],[78,27,["إِنَّهُمۡ","كَانُواْ","لَا","يَرۡجُونَ","حِسَابٗا"],"иннахум каануу лаа йарджууна хисааба","Воистину, они не надеялись на расчет",["Поистине, они","были","не","ожидающими","расчёта"]],[78,28,["وَكَذَّبُواْ","بِـَٔايَٰتِنَا","كِذَّابٗا"],"уаказзабуу би'аайаатинаа киззааба","и полностью отрицали Наши знамения.",["И отвергали они","Наши знамения","полным отрицанием"]],[78,29,["وَكُلَّ","شَيۡءٍ","أَحۡصَيۡنَٰهُ","كِتَٰبٗا"],"уакулла шай'ин ахсайнааху китааба","Мы же всякую вещь подсчитали и записали.",["И всякую","вещь","исчислили Мы её","в записи"]],[78,30,["فَذُوقُواْ","فَلَن","نَّزِيدَكُمۡ","إِلَّا","عَذَابًا"],"фазуукуу фалан назиидакум иллаа `азааба","Вкушайте же! Мы не прибавим вам ничего, кроме мучений.",["Так вкусите","и никак не","прибавим Мы вам","кроме","наказания"]]]}