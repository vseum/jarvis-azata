{"p":583,"j":30,"a":[[78,31,["إِنَّ","لِلۡمُتَّقِينَ","مَفَازًا"],"инна лилмуттаḳиина мафаза","Воистину, богобоязненных ожидает место спасения,",["Поистине","для богобоязненных","спасение"]],[78,32,["حَدَآئِقَ","وَأَعۡنَٰبٗا"],"хадаиḳа ва'а`наба","Райские сады и виноградники,",["Сады","и виноград"]],[78,33,["وَكَوَاعِبَ","أَتۡرَابٗا"],"вакава`иба атраба","и полногрудые сверстницы,",["И полногрудые","сверстницы"]],[78,34,["وَكَأۡسٗا","دِهَاقٗا"],"вака'сан дихаḳа","и полные чаши.",["И чаша","полная"]],[78,35,["لَّا","يَسۡمَعُونَ","فِيهَا","لَغۡوٗا","وَلَا","كِذَّٰبٗا"],"лла йасма`ууна фииха лагван вала киззаба","Они не услышат там ни пустословия, ни лжи.",["не","услышат","там","пустословия","и не","лжи"]],[78,36,["جَزَآءٗ","مِّن","رَّبِّكَ","عَطَآءً","حِسَابٗا"],"жазаам мир раббика `атаан хисаба","Это будет воздаянием от твоего Господа и даром исчисленным (или щедрым, или достаточным),",["воздаянием","от","Господа твоего","даром","по расчёту"]],[78,37,["رَّبِّ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِ","وَمَا","بَيۡنَهُمَا","ٱلرَّحۡمَٰنِۖ","لَا","يَمۡلِكُونَ","مِنۡهُ","خِطَابٗا"],"рраббис самавати вал'арди вама байнахумар рахмани ла йамликууна минху хитаба","Господа небес и земли и того, что между ними, Милостивого, с Которым они не посмеют даже заговорить.",["Господа","небес","и земли","и того, что","между ними","Милостивого","не","властны они","от Него","обратиться"]],[78,38,["يَوۡمَ","يَقُومُ","ٱلرُّوحُ","وَٱلۡمَلَٰٓئِكَةُ","صَفّٗاۖ","لَّا","يَتَكَلَّمُونَ","إِلَّا","مَنۡ","أَذِنَ","لَهُ","ٱلرَّحۡمَٰنُ","وَقَالَ","صَوَابٗا"],"йаума йаḳуумур рууху валмалаикату саффал ла йатакалламууна илла ман азина лахур рахману ваḳала саваба","В тот день, когда Дух (Джибрил) и ангелы станут рядами, не будет говорить никто, кроме тех, кому позволит Милостивый, и говорить они будут правду.",["В день","встанет","Дух","и ангелы","рядами","не","будут говорить они","кроме","того, кому","позволит","ему","Милостивый","и скажет он","верное"]],[78,39,["ذَٰلِكَ","ٱلۡيَوۡمُ","ٱلۡحَقُّۖ","فَمَن","شَآءَ","ٱتَّخَذَ","إِلَىٰ","رَبِّهِۦ","مَـَٔابًا"],"заликал йаумул хаḳḳу фаман шааттахаза ила раббихии ма'аба","Это будет истинный день, и всякий, кто пожелает, найдет способ вернуться к своему Господу.",["Тот","день","истинный","и кто","пожелает","изберёт","к","Господу своему","возвращение"]],[78,40,["إِنَّآ","أَنذَرۡنَٰكُمۡ","عَذَابٗا","قَرِيبٗا","يَوۡمَ","يَنظُرُ","ٱلۡمَرۡءُ","مَا","قَدَّمَتۡ","يَدَاهُ","وَيَقُولُ","ٱلۡكَافِرُ","يَٰلَيۡتَنِي","كُنتُ","تُرَٰبَۢا"],"инна анзарнакум `азабан ḳариибан йаума йанзурул мар'у ма ḳаддамат йадаху вайаḳуулул кафиру йалайтании кунту тураба","Мы предостерегли вас от наказания близкого. В тот день человек увидит, что уготовили его руки, а неверующий скажет: «Эх, если бы я был прахом!».",["Поистине, Мы","предостерегли Мы вас","о наказании","близком","в день","посмотрит","человек","на то, что","уготовили","руки его","и скажет","неверующий","О, если бы я","был","прахом"]],[79,1,["وَٱلنَّٰزِعَٰتِ","غَرۡقٗا"],"ваннази`ати гарḳа","Клянусь исторгающими души неверующих жестоко!",["Клянусь вырывающими","с силой"]],[79,2,["وَٱلنَّٰشِطَٰتِ","نَشۡطٗا"],"ваннашитати нашта","Клянусь извлекающими души верующих нежно!",["и извлекающими","легко"]],[79,3,["وَٱلسَّٰبِحَٰتِ","سَبۡحٗا"],"вассабихати сабха","Клянусь плывущими стремительно,",["и плывущими","плавно"]],[79,4,["فَٱلسَّٰبِقَٰتِ","سَبۡقٗا"],"фассабиḳати сабḳа","опережающими уверенно",["и опережающими","наперегонки"]],[79,5,["فَٱلۡمُدَبِّرَٰتِ","أَمۡرٗا"],"фалмудаббирати амра","и исполняющими повеления!",["и управляющими","делом"]],[79,6,["يَوۡمَ","تَرۡجُفُ","ٱلرَّاجِفَةُ"],"йаума таржуфур ражифах","В тот день сотрясется сотрясающаяся (раздастся первый трубный глас, после которого творения умрут),",["В день, когда","содрогнётся","сотрясающее"]],[79,7,["تَتۡبَعُهَا","ٱلرَّادِفَةُ"],"татба`ухар радифах","вслед за чем последует еще одно сотрясение (раздастся второй трубный глас, после которого начнется воскрешение),",["последует за ним","следующее"]],[79,8,["قُلُوبٞ","يَوۡمَئِذٖ","وَاجِفَةٌ"],"ḳулуубун йаумаизин важифах","В тот день затрепещут сердца,",["Сердца","в тот день","затрепещут"]],[79,9,["أَبۡصَٰرُهَا","خَٰشِعَةٞ"],"абсаруха хаши`ах","а их взоры будут смиренны.",["Взоры их","смиренно потуплены"]],[79,10,["يَقُولُونَ","أَءِنَّا","لَمَرۡدُودُونَ","فِي","ٱلۡحَافِرَةِ"],"йаḳуулууна а'инна ламардуудууна фил хафирах","Они говорят: «Неужели мы вернемся в прежнее состояние",["Они говорят","Неужели мы","непременно будем возвращены","в","прежнее состояние"]],[79,11,["أَءِذَا","كُنَّا","عِظَٰمٗا","نَّخِرَةٗ"],"а'иза кунна `изаман нахираха","после того, как станем истлевшими костями?!».",["Неужели когда","мы станем","костями","истлевшими"]],[79,12,["قَالُواْ","تِلۡكَ","إِذٗا","كَرَّةٌ","خَاسِرَةٞ"],"ḳалуу тилка изан карратун хасирах","Они говорят: «Если так, то это - невыгодное возвращение!».",["Они сказали","Это","тогда","возвращение","убыточное"]],[79,13,["فَإِنَّمَا","هِيَ","زَجۡرَةٞ","وَٰحِدَةٞ"],"фа'иннама хийа зажратун вахидах","Но раздастся лишь один глас,",["И ведь лишь","это","окрик","единственный"]],[79,14,["فَإِذَا","هُم","بِٱلسَّاهِرَةِ"],"фа'иза хум биссахирах","и все они окажутся на поверхности земли.",["и вот","они","на поверхности земли"]],[79,15,["هَلۡ","أَتَىٰكَ","حَدِيثُ","مُوسَىٰٓ"],"хал атака хадиису мууса","Дошел ли до тебя рассказ о Мусе (Моисее)?",["Дошёл ли","до тебя","рассказ","о Мусе"]]]}