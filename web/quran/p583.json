{"p":583,"j":30,"a":[[78,31,["إِنَّ","لِلۡمُتَّقِينَ","مَفَازًا"],"инна лилмуттаḳиина мафаза","Воистину, богобоязненных ожидает место спасения,",["Поистине","для богобоязненных","спасение"]],[78,32,["حَدَآئِقَ","وَأَعۡنَٰبٗا"],"хадаиḳа ва'а`наба","Райские сады и виноградники,",["Сады","и виноград"]],[78,33,["وَكَوَاعِبَ","أَتۡرَابٗا"],"вакава`иба атраба","и полногрудые сверстницы,",["И полногрудые","сверстницы"]],[78,34,["وَكَأۡسٗا","دِهَاقٗا"],"вака'сан дихаḳа","и полные чаши.",["И чаша","полная"]],[78,35,["لَّا","يَسۡمَعُونَ","فِيهَا","لَغۡوٗا","وَلَا","كِذَّٰبٗا"],"лла йасма`ууна фииха лагван вала киззаба","Они не услышат там ни пустословия, ни лжи.",["не","услышат","там","пустословия","и не","лжи"]],[78,36,["جَزَآءٗ","مِّن","رَّبِّكَ","عَطَآءً","حِسَابٗا"],"жазаам мир раббика `атаан хисаба","Это будет воздаянием от твоего Господа и даром исчисленным (или щедрым, или достаточным),",["воздаянием","от","Господа твоего","даром","по расчёту"]],[78,37,["رَّبِّ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِ","وَمَا","بَيۡنَهُمَا","ٱلرَّحۡمَٰنِۖ","لَا","يَمۡلِكُونَ","مِنۡهُ","خِطَابٗا"],"рраббис самавати вал'арди вама байнахумар рахмани ла йамликууна минху хитаба","Господа небес и земли и того, что между ними, Милостивого, с Которым они не посмеют даже заговорить.",["Господа","небес","и земли","и того, что","между ними","Милостивого","не","властны они","от Него","обратиться"]],[78,38,["يَوۡمَ","يَقُومُ","ٱلرُّوحُ","وَٱلۡمَلَٰٓئِكَةُ","صَفّٗاۖ","لَّا","يَتَكَلَّمُونَ","إِلَّا","مَنۡ","أَذِنَ","لَهُ","ٱلرَّحۡمَٰنُ","وَقَالَ","صَوَابٗا"],"йаума йаḳуумур рууху валмалаикату саффал ла йатакалламууна илла ман азина лахур рахману ваḳала саваба","В тот день, когда Дух (Джибрил) и ангелы станут рядами, не будет говорить никто, кроме тех, кому позволит Милостивый, и говорить они будут правду.",["В день","встанет","Дух","и ангелы","рядами","не","будут говорить они","кроме","того, кому","позволит","ему","Милостивый","и скажет он","верное"]],[78,39,["ذَٰلِكَ","ٱلۡيَوۡمُ","ٱلۡحَقُّۖ","فَمَن","شَآءَ","ٱتَّخَذَ","إِلَىٰ","رَبِّهِۦ","مَـَٔابًا"],"заликал йаумул хаḳḳу фаман шааттахаза ила раббихии ма'аба","Это будет истинный день, и всякий, кто пожелает, найдет способ вернуться к своему Господу.",["Тот","день","истинный","и кто","пожелает","изберёт","к","Господу своему","возвращение"]],[78,40,["إِنَّآ","أَنذَرۡنَٰكُمۡ","عَذَابٗا","قَرِيبٗا","يَوۡمَ","يَنظُرُ","ٱلۡمَرۡءُ","مَا","قَدَّمَتۡ","يَدَاهُ","وَيَقُولُ","ٱلۡكَافِرُ","يَٰلَيۡتَنِي","كُنتُ","تُرَٰبَۢا"],"инна анзарнакум `азабан ḳариибан йаума йанзурул мар'у ма ḳаддамат йадаху вайаḳуулул кафиру йалайтании кунту тураба","Мы предостерегли вас от наказания близкого. В тот день человек увидит, что уготовили его руки, а неверующий скажет: «Эх, если бы я был прахом!».",["Поистине, Мы","предостерегли Мы вас","о наказании","близком","в день","посмотрит","человек","на то, что","уготовили","руки его","и скажет","неверующий","О, если бы я","был","прахом"]],[79,1,["وَٱلنَّٰزِعَٰتِ","غَرۡقٗا"],"ваннази`ати гарḳа","Клянусь исторгающими души неверующих жестоко!",["Клянусь вырывающими","с силой"]],[79,2,["وَٱلنَّٰشِطَٰتِ","نَشۡطٗا"],"ваннашитати нашта","Клянусь извлекающими души верующих нежно!",["и извлекающими","легко"]],[79,3,["وَٱلسَّٰبِحَٰتِ","سَبۡحٗا"],"вассабихати сабха","Клянусь плывущими стремительно,",["и плывущими","плавно"]],[79,4,["فَٱلسَّٰبِقَٰتِ","سَبۡقٗا"],"фассабиḳати сабḳа","опережающими уверенно",["и опережающими","наперегонки"]],[79,5,["فَٱلۡمُدَبِّرَٰتِ","أَمۡرٗا"],"фалмудаббирати амра","и исполняющими повеления!",["и управляющими","делом"]],[79,6,["يَوۡمَ","تَرۡجُفُ","ٱلرَّاجِفَةُ"],"йаума таржуфур ражифах","В тот день сотрясется сотрясающаяся (раздастся первый трубный глас, после которого творения умрут),",["В день, когда","содрогнётся","сотрясающее"]],[79,7,["تَتۡبَعُهَا","ٱلرَّادِفَةُ"],"татба`ухар радифах","вслед за чем последует еще одно сотрясение (раздастся второй трубный глас, после которого начнется воскрешение),",["последует за ним","следующее"]],[79,8,["قُلُوبٞ","يَوۡمَئِذٖ","وَاجِفَةٌ"],"ḳулуубун йаумаизин важифах","В тот день затрепещут сердца,",["Сердца","в тот день","затрепещут"]],[79,9,["أَبۡصَٰرُهَا","خَٰشِعَةٞ"],"абсаруха хаши`ах","а их взоры будут смиренны.",["Взоры их","смиренно потуплены"]],[79,10,["يَقُولُونَ","أَءِنَّا","لَمَرۡدُودُونَ","فِي","ٱلۡحَافِرَةِ"],"йаḳуулууна а'инна ламардуудууна фил хафирах","Они говорят: «Неужели мы вернемся в прежнее состояние",["Они говорят","Неужели мы","непременно будем возвращены","в","прежнее состояние"]],[79,11,["أَءِذَا","كُنَّا","عِظَٰمٗا","نَّخِرَةٗ"],"а'иза кунна `изаман нахираха","после того, как станем истлевшими костями?!».",["Неужели когда","мы станем","костями","истлевшими"]],[79,12,["قَالُواْ","تِلۡكَ","إِذٗا","كَرَّةٌ","خَاسِرَةٞ"],"ḳалуу тилка изан карратун хасирах","Они говорят: «Если так, то это - невыгодное возвращение!».",["Они сказали","Это","тогда","возвращение","убыточное"]],[79,13,["فَإِنَّمَا","هِيَ","زَجۡرَةٞ","وَٰحِدَةٞ"],"фа'иннама хийа зажратун вахидах","Но раздастся лишь один глас,",["И ведь лишь","это","окрик","единственный"]],[79,14,["فَإِذَا","هُم","بِٱلسَّاهِرَةِ"],"фа'иза хум биссахирах","и все они окажутся на поверхности земли.",["и вот","они","на поверхности земли"]],[79,15,["هَلۡ","أَتَىٰكَ","حَدِيثُ","مُوسَىٰٓ"],"хал атака хадиису мууса","Дошел ли до тебя рассказ о Мусе (Моисее)?",["Дошёл ли","до тебя","рассказ","о Мусе"]]],"m":[[["إِنَّ","Поистине",78,31],["لِلۡمُتَّقِينَ","для богобоязненных",78,31],["مَفَازًا","спасение",78,31],[31],["حَدَآئِقَ","Сады",78,32],["وَأَعۡنَٰبٗا","и виноград",78,32],[32],["وَكَوَاعِبَ","И полногрудые",78,33],["أَتۡرَابٗا","сверстницы",78,33],[33],["وَكَأۡسٗا","И чаша",78,34]],[["دِهَاقٗا","полная",78,34],[34],["لَّا","не",78,35],["يَسۡمَعُونَ","услышат",78,35],["فِيهَا","там",78,35],["لَغۡوٗا","пустословия",78,35],["وَلَا","и не",78,35],["كِذَّٰبٗا","лжи",78,35],[35],["جَزَآءٗ","воздаянием",78,36],["مِّن","от",78,36],["رَّبِّكَ","Господа твоего",78,36],["عَطَآءً","даром",78,36]],[["حِسَابٗا","по расчёту",78,36],[36],["رَّبِّ","Господа",78,37],["ٱلسَّمَٰوَٰتِ","небес",78,37],["وَٱلۡأَرۡضِ","и земли",78,37],["وَمَا","и того, что",78,37],["بَيۡنَهُمَا","между ними",78,37],["ٱلرَّحۡمَٰنِۖ","Милостивого",78,37],["لَا","не",78,37],["يَمۡلِكُونَ","властны они",78,37]],[["مِنۡهُ","от Него",78,37],["خِطَابٗا","обратиться",78,37],[37],["يَوۡمَ","В день",78,38],["يَقُومُ","встанет",78,38],["ٱلرُّوحُ","Дух",78,38],["وَٱلۡمَلَٰٓئِكَةُ","и ангелы",78,38],["صَفّٗاۖ","рядами",78,38],["لَّا","не",78,38],["يَتَكَلَّمُونَ","будут говорить они",78,38]],[["إِلَّا","кроме",78,38],["مَنۡ","того, кому",78,38],["أَذِنَ","позволит",78,38],["لَهُ","ему",78,38],["ٱلرَّحۡمَٰنُ","Милостивый",78,38],["وَقَالَ","и скажет он",78,38],["صَوَابٗا","верное",78,38],[38],["ذَٰلِكَ","Тот",78,39],["ٱلۡيَوۡمُ","день",78,39],["ٱلۡحَقُّۖ","истинный",78,39],["فَمَن","и кто",78,39]],[["شَآءَ","пожелает",78,39],["ٱتَّخَذَ","изберёт",78,39],["إِلَىٰ","к",78,39],["رَبِّهِۦ","Господу своему",78,39],["مَـَٔابًا","возвращение",78,39],[39],["إِنَّآ","Поистине, Мы",78,40],["أَنذَرۡنَٰكُمۡ","предостерегли Мы вас",78,40],["عَذَابٗا","о наказании",78,40],["قَرِيبٗا","близком",78,40],["يَوۡمَ","в день",78,40]],[["يَنظُرُ","посмотрит",78,40],["ٱلۡمَرۡءُ","человек",78,40],["مَا","на то, что",78,40],["قَدَّمَتۡ","уготовили",78,40],["يَدَاهُ","руки его",78,40],["وَيَقُولُ","и скажет",78,40],["ٱلۡكَافِرُ","неверующий",78,40],["يَٰلَيۡتَنِي","О, если бы я",78,40],["كُنتُ","был",78,40],["تُرَٰبَۢا","прахом",78,40],[40]],["h",79],["b"],[["وَٱلنَّٰزِعَٰتِ","Клянусь вырывающими",79,1],["غَرۡقٗا","с силой",79,1],[1],["وَٱلنَّٰشِطَٰتِ","и извлекающими",79,2],["نَشۡطٗا","легко",79,2],[2],["وَٱلسَّٰبِحَٰتِ","и плывущими",79,3],["سَبۡحٗا","плавно",79,3]],[[3],["فَٱلسَّٰبِقَٰتِ","и опережающими",79,4],["سَبۡقٗا","наперегонки",79,4],[4],["فَٱلۡمُدَبِّرَٰتِ","и управляющими",79,5],["أَمۡرٗا","делом",79,5],[5],["يَوۡمَ","В день, когда",79,6],["تَرۡجُفُ","содрогнётся",79,6],["ٱلرَّاجِفَةُ","сотрясающее",79,6]],[[6],["تَتۡبَعُهَا","последует за ним",79,7],["ٱلرَّادِفَةُ","следующее",79,7],[7],["قُلُوبٞ","Сердца",79,8],["يَوۡمَئِذٖ","в тот день",79,8],["وَاجِفَةٌ","затрепещут",79,8],[8],["أَبۡصَٰرُهَا","Взоры их",79,9]],[["خَٰشِعَةٞ","смиренно потуплены",79,9],[9],["يَقُولُونَ","Они говорят",79,10],["أَءِنَّا","Неужели мы",79,10],["لَمَرۡدُودُونَ","непременно будем возвращены",79,10],["فِي","в",79,10],["ٱلۡحَافِرَةِ","прежнее состояние",79,10],[10],["أَءِذَا","Неужели когда",79,11],["كُنَّا","мы станем",79,11]],[["عِظَٰمٗا","костями",79,11],["نَّخِرَةٗ","истлевшими",79,11],[11],["قَالُواْ","Они сказали",79,12],["تِلۡكَ","Это",79,12],["إِذٗا","тогда",79,12],["كَرَّةٌ","возвращение",79,12],["خَاسِرَةٞ","убыточное",79,12],[12],["فَإِنَّمَا","И ведь лишь",79,13],["هِيَ","это",79,13],["زَجۡرَةٞ","окрик",79,13]],[["وَٰحِدَةٞ","единственный",79,13],[13],["فَإِذَا","и вот",79,14],["هُم","они",79,14],["بِٱلسَّاهِرَةِ","на поверхности земли",79,14],[14],["هَلۡ","Дошёл ли",79,15],["أَتَىٰكَ","до тебя",79,15],["حَدِيثُ","рассказ",79,15],["مُوسَىٰٓ","о Мусе",79,15],[15]]]}