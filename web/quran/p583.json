{"p":583,"j":30,"a":[[78,31,["إِنَّ","لِلۡمُتَّقِينَ","مَفَازًا"],"инна лилмуттакиина мафааза","Воистину, богобоязненных ожидает место спасения,",["Поистине","для богобоязненных","спасение"]],[78,32,["حَدَآئِقَ","وَأَعۡنَٰبٗا"],"хадаа'ика уа'а`нааба","Райские сады и виноградники,",["Сады","и виноград"]],[78,33,["وَكَوَاعِبَ","أَتۡرَابٗا"],"уакауаа`иба атрааба","и полногрудые сверстницы,",["И полногрудые","сверстницы"]],[78,34,["وَكَأۡسٗا","دِهَاقٗا"],"уака'сан дихаака","и полные чаши.",["И чаша","полная"]],[78,35,["لَّا","يَسۡمَعُونَ","فِيهَا","لَغۡوٗا","وَلَا","كِذَّٰبٗا"],"ллаа йасма`ууна фиихаа лагуан уалаа киззааба","Они не услышат там ни пустословия, ни лжи.",["не","услышат","там","пустословия","и не","лжи"]],[78,36,["جَزَآءٗ","مِّن","رَّبِّكَ","عَطَآءً","حِسَابٗا"],"джазаа'ам мир раббика `атаа'ан хисааба","Это будет воздаянием от твоего Господа и даром исчисленным (или щедрым, или достаточным),",["воздаянием","от","Господа твоего","даром","по расчёту"]],[78,37,["رَّبِّ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِ","وَمَا","بَيۡنَهُمَا","ٱلرَّحۡمَٰنِۖ","لَا","يَمۡلِكُونَ","مِنۡهُ","خِطَابٗا"],"ррабби ссамаауаати уал'арди уамаа байнахумаа ррахмаани лаа йамликууна минху хитааба","Господа небес и земли и того, что между ними, Милостивого, с Которым они не посмеют даже заговорить.",["Господа","небес","и земли","и того, что","между ними","Милостивого","не","властны они","от Него","обратиться"]],[78,38,["يَوۡمَ","يَقُومُ","ٱلرُّوحُ","وَٱلۡمَلَٰٓئِكَةُ","صَفّٗاۖ","لَّا","يَتَكَلَّمُونَ","إِلَّا","مَنۡ","أَذِنَ","لَهُ","ٱلرَّحۡمَٰنُ","وَقَالَ","صَوَابٗا"],"йаума йакууму ррууху уалмалаа'икату саффал лаа йатакалламууна иллаа ман азина лаху ррахмаану уакаала сауааба","В тот день, когда Дух (Джибрил) и ангелы станут рядами, не будет говорить никто, кроме тех, кому позволит Милостивый, и говорить они будут правду.",["В день","встанет","Дух","и ангелы","рядами","не","будут говорить они","кроме","того, кому","позволит","ему","Милостивый","и скажет он","верное"]],[78,39,["ذَٰلِكَ","ٱلۡيَوۡمُ","ٱلۡحَقُّۖ","فَمَن","شَآءَ","ٱتَّخَذَ","إِلَىٰ","رَبِّهِۦ","مَـَٔابًا"],"заалика лйауму лхакку фаман шаа'а ттахаза илаа раббихии ма'ааба","Это будет истинный день, и всякий, кто пожелает, найдет способ вернуться к своему Господу.",["Тот","день","истинный","и кто","пожелает","изберёт","к","Господу своему","возвращение"]],[78,40,["إِنَّآ","أَنذَرۡنَٰكُمۡ","عَذَابٗا","قَرِيبٗا","يَوۡمَ","يَنظُرُ","ٱلۡمَرۡءُ","مَا","قَدَّمَتۡ","يَدَاهُ","وَيَقُولُ","ٱلۡكَافِرُ","يَٰلَيۡتَنِي","كُنتُ","تُرَٰبَۢا"],"иннаа анзарнаакум `азаабан кариибан йаума йанзуру лмар'у маа каддамат йадааху уайакуулу лкаафиру йаалайтании кунту турааба","Мы предостерегли вас от наказания близкого. В тот день человек увидит, что уготовили его руки, а неверующий скажет: «Эх, если бы я был прахом!».",["Поистине, Мы","предостерегли Мы вас","о наказании","близком","в день","посмотрит","человек","на то, что","уготовили","руки его","и скажет","неверующий","О, если бы я","был","прахом"]],[79,1,["وَٱلنَّٰزِعَٰتِ","غَرۡقٗا"],"уаннаази`аати гарка","Клянусь исторгающими души неверующих жестоко!",["Клянусь вырывающими","с силой"]],[79,2,["وَٱلنَّٰشِطَٰتِ","نَشۡطٗا"],"уаннаашитаати нашта","Клянусь извлекающими души верующих нежно!",["и извлекающими","легко"]],[79,3,["وَٱلسَّٰبِحَٰتِ","سَبۡحٗا"],"уассаабихаати сабха","Клянусь плывущими стремительно,",["и плывущими","плавно"]],[79,4,["فَٱلسَّٰبِقَٰتِ","سَبۡقٗا"],"фассаабикаати сабка","опережающими уверенно",["и опережающими","наперегонки"]],[79,5,["فَٱلۡمُدَبِّرَٰتِ","أَمۡرٗا"],"фалмудаббираати амра","и исполняющими повеления!",["и управляющими","делом"]],[79,6,["يَوۡمَ","تَرۡجُفُ","ٱلرَّاجِفَةُ"],"йаума тарджуфу ррааджифах","В тот день сотрясется сотрясающаяся (раздастся первый трубный глас, после которого творения умрут),",["В день, когда","содрогнётся","сотрясающее"]],[79,7,["تَتۡبَعُهَا","ٱلرَّادِفَةُ"],"татба`ухаа рраадифах","вслед за чем последует еще одно сотрясение (раздастся второй трубный глас, после которого начнется воскрешение),",["последует за ним","следующее"]],[79,8,["قُلُوبٞ","يَوۡمَئِذٖ","وَاجِفَةٌ"],"кулуубун йаума'изин уааджифах","В тот день затрепещут сердца,",["Сердца","в тот день","затрепещут"]],[79,9,["أَبۡصَٰرُهَا","خَٰشِعَةٞ"],"абсаарухаа хааши`ах","а их взоры будут смиренны.",["Взоры их","смиренно потуплены"]],[79,10,["يَقُولُونَ","أَءِنَّا","لَمَرۡدُودُونَ","فِي","ٱلۡحَافِرَةِ"],"йакуулууна а'иннаа ламардуудууна фии лхаафирах","Они говорят: «Неужели мы вернемся в прежнее состояние",["Они говорят","Неужели мы","непременно будем возвращены","в","прежнее состояние"]],[79,11,["أَءِذَا","كُنَّا","عِظَٰمٗا","نَّخِرَةٗ"],"а'изаа куннаа `изааман нахираха","после того, как станем истлевшими костями?!».",["Неужели когда","мы станем","костями","истлевшими"]],[79,12,["قَالُواْ","تِلۡكَ","إِذٗا","كَرَّةٌ","خَاسِرَةٞ"],"каалуу тилка изан карратун хаасирах","Они говорят: «Если так, то это - невыгодное возвращение!».",["Они сказали","Это","тогда","возвращение","убыточное"]],[79,13,["فَإِنَّمَا","هِيَ","زَجۡرَةٞ","وَٰحِدَةٞ"],"фа'иннамаа хийа заджратун уаахидах","Но раздастся лишь один глас,",["И ведь лишь","это","окрик","единственный"]],[79,14,["فَإِذَا","هُم","بِٱلسَّاهِرَةِ"],"фа'изаа хум биссаахирах","и все они окажутся на поверхности земли.",["и вот","они","на поверхности земли"]],[79,15,["هَلۡ","أَتَىٰكَ","حَدِيثُ","مُوسَىٰٓ"],"хал атаака хадиису муусаа","Дошел ли до тебя рассказ о Мусе (Моисее)?",["Дошёл ли","до тебя","рассказ","о Мусе"]]]}