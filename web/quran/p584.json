{"p":584,"j":30,"a":[[79,16,["إِذۡ","نَادَىٰهُ","رَبُّهُۥ","بِٱلۡوَادِ","ٱلۡمُقَدَّسِ","طُوًى"],"из надаху раббухуу билвадил муḳаддаси туа","Вот Господь его воззвал к нему в священной долине Тува (Това):",["Вот","воззвал к нему","Господь его","в долине","священной","Тува"]],[79,17,["ٱذۡهَبۡ","إِلَىٰ","فِرۡعَوۡنَ","إِنَّهُۥ","طَغَىٰ"],"изхаб ила фир`ауна иннахуу тага","«Ступай к Фараону, ибо он преступил границы дозволенного,",["Ступай","к","Фараону","Поистине, он","преступил границы"]],[79,18,["فَقُلۡ","هَل","لَّكَ","إِلَىٰٓ","أَن","تَزَكَّىٰ"],"фаḳул хал лака ила ан тазакка","и скажи: «Не следует ли тебе очиститься?",["и скажи","не желаешь ли","ты","к тому","чтобы","очиститься"]],[79,19,["وَأَهۡدِيَكَ","إِلَىٰ","رَبِّكَ","فَتَخۡشَىٰ"],"ва'ахдийака ила раббика фатахша","Я укажу тебе путь к твоему Господу, и ты станешь богобоязнен»».",["и чтобы я повёл тебя","к","Господу твоему","и ты устрашился"]],[79,20,["فَأَرَىٰهُ","ٱلۡأٓيَةَ","ٱلۡكُبۡرَىٰ"],"фа'арахул айатал кубра","Он показал ему величайшее знамение,",["И показал он ему","знамение","великое"]],[79,21,["فَكَذَّبَ","وَعَصَىٰ"],"факаззаба ва`аса","но тот счел его ложью и ослушался,",["но он счёл ложью","и ослушался"]],[79,22,["ثُمَّ","أَدۡبَرَ","يَسۡعَىٰ"],"сумма адбара йас`а","а потом отвернулся, принявшись усердствовать.",["Затем","он отвернулся","поспешно"]],[79,23,["فَحَشَرَ","فَنَادَىٰ"],"фахашара фанада","Он собрал толпу и громко воззвал,",["и собрал (людей)","и воззвал"]],[79,24,["فَقَالَ","أَنَا۠","رَبُّكُمُ","ٱلۡأَعۡلَىٰ"],"фаḳала ана раббукумул а`ла","и сказал: «Я - ваш всевышний господь!».",["и сказал","Я","господь ваш","высочайший"]],[79,25,["فَأَخَذَهُ","ٱللَّهُ","نَكَالَ","ٱلۡأٓخِرَةِ","وَٱلۡأُولَىٰٓ"],"фа'ахазахуллаху накалал ахирати вал'уула","Тогда Аллах подверг его наказанию как в Последней жизни, так и в первой жизни.",["И схватил его","Аллах","наказанием","в последней (жизни)","и в первой"]],[79,26,["إِنَّ","فِي","ذَٰلِكَ","لَعِبۡرَةٗ","لِّمَن","يَخۡشَىٰٓ"],"инна фии залика ла`ибратал лиман йахша","Воистину, в этом было назидание для тех, кто богобоязнен.",["поистине","в","этом","непременно назидание","для того, кто","боится"]],[79,27,["ءَأَنتُمۡ","أَشَدُّ","خَلۡقًا","أَمِ","ٱلسَّمَآءُۚ","بَنَىٰهَا"],"а'антум ашадду халḳан амис самау банаха","Вас ли труднее создать или небо? Он воздвиг его,",["Разве вы","труднее","в сотворении","или","небо","Он возвёл его"]],[79,28,["رَفَعَ","سَمۡكَهَا","فَسَوَّىٰهَا"],"рафа`а самкаха фасавваха","поднял его своды и сделал его совершенным.",["Он поднял","свод его","и выровнял его"]],[79,29,["وَأَغۡطَشَ","لَيۡلَهَا","وَأَخۡرَجَ","ضُحَىٰهَا"],"ва'агташа лайлаха ва'ахража духаха","Он сделал темной ночь его (неба) и вывел его утреннюю зарю.",["И Он сделал тёмной","ночь его","и вывел","утренний свет его"]],[79,30,["وَٱلۡأَرۡضَ","بَعۡدَ","ذَٰلِكَ","دَحَىٰهَآ"],"вал'арда ба`да залика дахаха","После этого Он распростер землю,",["А землю","после","этого","Он распростёр её"]],[79,31,["أَخۡرَجَ","مِنۡهَا","مَآءَهَا","وَمَرۡعَىٰهَا"],"ахража минха мааха вамар`аха","вывел из нее воду и пастбища",["Он вывел","из неё","воду её","и пастбища её"]],[79,32,["وَٱلۡجِبَالَ","أَرۡسَىٰهَا"],"валжибала арсаха","и утвердил на ней горы",["А горы","Он утвердил их"]],[79,33,["مَتَٰعٗا","لَّكُمۡ","وَلِأَنۡعَٰمِكُمۡ"],"мата`ал лакум валиан`амикум","на пользу вам и вашему скоту.",["на пользу","вам","и скоту вашему"]],[79,34,["فَإِذَا","جَآءَتِ","ٱلطَّآمَّةُ","ٱلۡكُبۡرَىٰ"],"фа'иза жаатит тамматул кубра","Когда же наступит Величайшее бедствие (День воскресения),",["А когда","наступит","бедствие","великое"]],[79,35,["يَوۡمَ","يَتَذَكَّرُ","ٱلۡإِنسَٰنُ","مَا","سَعَىٰ"],"йаума йатазаккарул инсану ма са`а","в тот день человек вспомнит о том, в чем он усердствовал,",["в день, когда","вспомнит","человек","то, к чему","он стремился"]],[79,36,["وَبُرِّزَتِ","ٱلۡجَحِيمُ","لِمَن","يَرَىٰ"],"вабурризатил жахииму лиман йара","и Ад будет ясно виден тем, кто будет видеть.",["и выставлен будет","Ад","для того, кто","видит"]],[79,37,["فَأَمَّا","مَن","طَغَىٰ"],"фа'амма ман тага","Тому, кто преступил границы дозволенного",["То что касается","того, кто","преступил границы"]],[79,38,["وَءَاثَرَ","ٱلۡحَيَوٰةَ","ٱلدُّنۡيَا"],"ва'асарал хайаватад дунйа","и отдал предпочтение мирской жизни,",["и предпочёл","жизнь","мирскую"]],[79,39,["فَإِنَّ","ٱلۡجَحِيمَ","هِيَ","ٱلۡمَأۡوَىٰ"],"фа'иннал жахиима хийал ма'ва","пристанищем будет Ад.",["то поистине","Ад","он","обитель"]],[79,40,["وَأَمَّا","مَنۡ","خَافَ","مَقَامَ","رَبِّهِۦ","وَنَهَى","ٱلنَّفۡسَ","عَنِ","ٱلۡهَوَىٰ"],"ва'амма ман хафа маḳама раббихии ванахан нафса `анил хава","Тому же, кто боялся предстать перед своим Господом и удерживал себя от страстей,",["А что касается","того, кто","убоялся","предстояния","перед Господом своим","и удержал","душу","от","прихотей"]],[79,41,["فَإِنَّ","ٱلۡجَنَّةَ","هِيَ","ٱلۡمَأۡوَىٰ"],"фа'иннал жанната хийал ма'ва","пристанищем будет Рай.",["то поистине","Рай","он","обитель"]],[79,42,["يَسۡـَٔلُونَكَ","عَنِ","ٱلسَّاعَةِ","أَيَّانَ","مُرۡسَىٰهَا"],"йас'алуунака `анис са`ати аййана мурсаха","Тебя спрашивают о Часе: «Когда же он настанет?».",["Они спрашивают тебя","о","Часе","когда","наступление его"]],[79,43,["فِيمَ","أَنتَ","مِن","ذِكۡرَىٰهَآ"],"фиима анта мин зикраха","К чему тебе упоминать об этом?",["При чём здесь","ты","к","упоминанию о нём"]],[79,44,["إِلَىٰ","رَبِّكَ","مُنتَهَىٰهَآ"],"ила раббика мунтахаха","Только твой Господь ведает об этом.",["К","Господу твоему","предел его"]],[79,45,["إِنَّمَآ","أَنتَ","مُنذِرُ","مَن","يَخۡشَىٰهَا"],"иннама анта мунзиру ман йахшаха","Воистину, ты - всего лишь предостерегающий увещеватель для тех, кто опасается этого.",["Ведь лишь","ты","увещеватель","того, кто","страшится его"]],[79,46,["كَأَنَّهُمۡ","يَوۡمَ","يَرَوۡنَهَا","لَمۡ","يَلۡبَثُوٓاْ","إِلَّا","عَشِيَّةً","أَوۡ","ضُحَىٰهَا"],"ка'аннахум йаума йараунаха лам йалбасуу илла `ашиййатан ау духаха","В тот день, когда они увидят его, им покажется, что они провели в этом мире лишь послеполуденные часы или утро.",["Как будто они","в день, когда","увидят его","не","пробыли","лишь","вечер","или","утро его"]]]}