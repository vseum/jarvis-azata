{"p":585,"j":30,"a":[[80,1,["عَبَسَ","وَتَوَلَّىٰٓ"],"`абаса уатауаллаа","Он нахмурился и отвернулся,",["Он нахмурился","и отвернулся"]],[80,2,["أَن","جَآءَهُ","ٱلۡأَعۡمَىٰ"],"ан джаа'аху л'а`маа","потому что к нему подошел слепой.",["оттого, что","пришёл к нему","слепой"]],[80,3,["وَمَا","يُدۡرِيكَ","لَعَلَّهُۥ","يَزَّكَّىٰٓ"],"уамаа йудриика ла`аллахуу йаззаккаа","Откуда тебе знать? Возможно, он бы очистился",["А что","даст тебе знать","может, он","очистится"]],[80,4,["أَوۡ","يَذَّكَّرُ","فَتَنفَعَهُ","ٱلذِّكۡرَىٰٓ"],"ау йаззаккару фатанфа`аху ззикраа","или помянул бы наставление, и поминание принесло бы ему пользу.",["или","примет назидание","и принесло бы ему пользу","напоминание"]],[80,5,["أَمَّا","مَنِ","ٱسۡتَغۡنَىٰ"],"аммаа мани стагнаа","Тому, кто решил, что он ни в чем не нуждается,",["Что касается","того, кто","не нуждается"]],[80,6,["فَأَنتَ","لَهُۥ","تَصَدَّىٰ"],"фа'анта лахуу тасаддаа","ты уделяешь внимание,",["то ты","ему","уделяешь внимание"]],[80,7,["وَمَا","عَلَيۡكَ","أَلَّا","يَزَّكَّىٰ"],"уамаа `алайка аллаа йаззаккаа","Что же будет тебе, если он не очистится?",["А не","на тебе (вина)","что не","очистится он"]],[80,8,["وَأَمَّا","مَن","جَآءَكَ","يَسۡعَىٰ"],"уа'аммаа ман джаа'ака йас`аа","А того, кто приходит к тебе со рвением",["А что касается","того, кто","пришёл к тебе","спеша"]],[80,9,["وَهُوَ","يَخۡشَىٰ"],"уахууа йахшаа","и страшится Аллаха,",["и он","страшится"]],[80,10,["فَأَنتَ","عَنۡهُ","تَلَهَّىٰ"],"фа'анта `анху талаххаа","ты оставляешь без внимания.",["то ты","от него","отвлекаешься"]],[80,11,["كـَلَّآ","إِنَّهَا","تَذۡكِرَةٞ"],"каллаа иннахаа тазкирах","Но нет! Это есть Назидание,",["Но нет","Поистине, это","напоминание"]],[80,12,["فَمَن","شَآءَ","ذَكَرَهُۥ"],"фаман шаа'а закараху","и пусть помянет его всякий желающий.",["И кто","пожелает","помянет его"]],[80,13,["فِي","صُحُفٖ","مُّكَرَّمَةٖ"],"фии сухуфим мукаррамах","Оно записано в свитках почитаемых,",["в","свитках","почитаемых"]],[80,14,["مَّرۡفُوعَةٖ","مُّطَهَّرَةِۭ"],"ммарфуу`атим мутаххарах","вознесенных и очищенных,",["возвышенных","очищенных"]],[80,15,["بِأَيۡدِي","سَفَرَةٖ"],"би'айдии сафарах","в руках посланцев",["в руках","писцов"]],[80,16,["كِرَامِۭ","بَرَرَةٖ"],"кираами барарах","благородных и покорных.",["благородных","благочестивых"]],[80,17,["قُتِلَ","ٱلۡإِنسَٰنُ","مَآ","أَكۡفَرَهُۥ"],"кутила л'инсаану маа акфараху","Да сгинет человек! Как же он неблагодарен!",["Да будет убит","человек","как же","неблагодарен он"]],[80,18,["مِنۡ","أَيِّ","شَيۡءٍ","خَلَقَهُۥ"],"мин аййи шай'ин халакаху","Из чего Он сотворил его?",["Из","какой","вещи","Он сотворил его"]],[80,19,["مِن","نُّطۡفَةٍ","خَلَقَهُۥ","فَقَدَّرَهُۥ"],"мин нутфатин халакахуу факаддараху","Он сотворил его из капли и соразмерил (или предопределил стадии его развития),",["Из","капли семени","Он сотворил его","и соразмерил его"]],[80,20,["ثُمَّ","ٱلسَّبِيلَ","يَسَّرَهُۥ"],"сумма ссабиила йассараху","потом облегчил ему путь,",["Затем","путь","Он облегчил ему"]],[80,21,["ثُمَّ","أَمَاتَهُۥ","فَأَقۡبَرَهُۥ"],"сумма амаатахуу фа'акбараху","потом умертвил его и поместил в могилу.",["Затем","Он умертвил его","и поместил его в могилу"]],[80,22,["ثُمَّ","إِذَا","شَآءَ","أَنشَرَهُۥ"],"сумма изаа шаа'а аншараху","Потом, когда пожелает, Он воскресит его.",["Затем","когда","Он пожелает","Он воскресит его"]],[80,23,["كـَلَّا","لَمَّا","يَقۡضِ","مَآ","أَمَرَهُۥ"],"каллаа ламмаа йакди маа амараху","Но нет! Он не выполняет того, что Он приказал ему.",["так нет","еще не","исполнил","то, что","Он велел ему"]],[80,24,["فَلۡيَنظُرِ","ٱلۡإِنسَٰنُ","إِلَىٰ","طَعَامِهِۦٓ"],"фалйанзури л'инсаану илаа та`аамихи","Пусть посмотрит человек на свое пропитание!",["Пусть же посмотрит","человек","на","пищу свою"]],[80,25,["أَنَّا","صَبَبۡنَا","ٱلۡمَآءَ","صَبّٗا"],"аннаа сабабнаа лмаа'а сабба","Мы проливаем обильные ливни,",["как Мы","излили","воду","обильно"]],[80,26,["ثُمَّ","شَقَقۡنَا","ٱلۡأَرۡضَ","شَقّٗا"],"сумма шакакнаа л'арда шакка","затем рассекаем землю трещинами",["Затем","Мы рассекли","землю","трещинами"]],[80,27,["فَأَنۢبَتۡنَا","فِيهَا","حَبّٗا"],"фа'амбатнаа фиихаа хабба","и взращиваем на ней зерна,",["и взрастили","на ней","зёрна"]],[80,28,["وَعِنَبٗا","وَقَضۡبٗا"],"уа`инабан уакадба","виноград и люцерну,",["и виноград","и зелень"]],[80,29,["وَزَيۡتُونٗا","وَنَخۡلٗا"],"уазайтуунан уанахла","маслины и финиковые пальмы,",["и маслины","и пальмы"]],[80,30,["وَحَدَآئِقَ","غُلۡبٗا"],"уахадаа'ика гулба","сады густые (или с могучими деревьями),",["и сады","густые"]],[80,31,["وَفَٰكِهَةٗ","وَأَبّٗا"],"уафаакихатан уа'абба","фрукты и травы",["и плоды","и травы"]],[80,32,["مَّتَٰعٗا","لَّكُمۡ","وَلِأَنۡعَٰمِكُمۡ"],"мматаа`ал лакум уали'ан`аамикум","на пользу вам и вашей скотине.",["на пользу","вам","и скоту вашему"]],[80,33,["فَإِذَا","جَآءَتِ","ٱلصَّآخَّةُ"],"фа'изаа джаа'ати ссааххах","Когда же раздастся Оглушительный глас,",["А когда","наступит","оглушающий глас"]],[80,34,["يَوۡمَ","يَفِرُّ","ٱلۡمَرۡءُ","مِنۡ","أَخِيهِ"],"йаума йафирру лмар'у мин ахиих","в тот день человек бросит своего брата,",["в день, когда","убежит","человек","от","брата своего"]],[80,35,["وَأُمِّهِۦ","وَأَبِيهِ"],"уа'уммихии уа'абиих","свою мать и своего отца,",["и матери своей","и отца своего"]],[80,36,["وَصَٰحِبَتِهِۦ","وَبَنِيهِ"],"уасаахибатихии уабаниих","свою жену и своих сыновей,",["и жены своей","и сыновей своих"]],[80,37,["لِكُلِّ","ٱمۡرِيٕٖ","مِّنۡهُمۡ","يَوۡمَئِذٖ","شَأۡنٞ","يُغۡنِيهِ"],"ликулли мрийим минхум йаума'изин ша'нун йугниих","ибо у каждого человека своих забот будет сполна.",["У каждого","человека","из них","в тот день","дело","занимающее его"]],[80,38,["وُجُوهٞ","يَوۡمَئِذٖ","مُّسۡفِرَةٞ"],"ууджуухун йаума'изим мусфирах","В тот день одни лица будут сиять,",["Лица","в тот день","сияющие"]],[80,39,["ضَاحِكَةٞ","مُّسۡتَبۡشِرَةٞ"],"даахикатум мустабширах","смеяться и ликовать.",["смеющиеся","радующиеся"]],[80,40,["وَوُجُوهٞ","يَوۡمَئِذٍ","عَلَيۡهَا","غَبَرَةٞ"],"уаууджуухун йаума'изин `алайхаа габарах","На других же лицах в тот день будет прах,",["И лица","в тот день","на них","пыль"]],[80,41,["تَرۡهَقُهَا","قَتَرَةٌ"],"тархакухаа катарах","покрывающий их мраком.",["покроет их","мрак"]],[80,42,["أُوْلَٰٓئِكَ","هُمُ","ٱلۡكَفَرَةُ","ٱلۡفَجَرَةُ"],"улаа'ика хуму лкафарату лфаджарах","Это будут неверующие грешники.",["Те","они","неверующие","грешники"]]]}