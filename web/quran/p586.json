{"p":586,"j":30,"a":[[81,1,["إِذَا","ٱلشَّمۡسُ","كُوِّرَتۡ"],"изаш шамсу куввират","Когда солнце будет свернуто (или потеряет свое сияние, или будет выброшено),",["Когда","солнце","будет свёрнуто"]],[81,2,["وَإِذَا","ٱلنُّجُومُ","ٱنكَدَرَتۡ"],"ва'изан нужуумункадарат","когда падут звезды,",["и когда","звёзды","осыплются"]],[81,3,["وَإِذَا","ٱلۡجِبَالُ","سُيِّرَتۡ"],"ва'изал жибалу суййират","когда горы будут сдвинуты с мест (или приведены в движение),",["и когда","горы","будут сдвинуты"]],[81,4,["وَإِذَا","ٱلۡعِشَارُ","عُطِّلَتۡ"],"ва'изал `ишару `уттилат","когда верблюдицы на десятом месяце беременности останутся без присмотра,",["и когда","верблюдицы стельные","будут оставлены без присмотра"]],[81,5,["وَإِذَا","ٱلۡوُحُوشُ","حُشِرَتۡ"],"ва'изал вухуушу хушират","когда дикие звери будут собраны,",["и когда","дикие звери","будут собраны"]],[81,6,["وَإِذَا","ٱلۡبِحَارُ","سُجِّرَتۡ"],"ва'изал бихару сужжират","когда моря запылают (или переполнятся; или опустеют; или перемешаются; или станут красными),",["и когда","моря","будут разожжены"]],[81,7,["وَإِذَا","ٱلنُّفُوسُ","زُوِّجَتۡ"],"ва'изан нуфуусу зуввижат","когда души объединятся (праведники объединятся с праведниками, а грешники - с грешниками; или праведники соединятся с райскими гуриями, а неверующие - с дьяволами; или души соединятся с телами),",["и когда","души","будут соединены"]],[81,8,["وَإِذَا","ٱلۡمَوۡءُۥدَةُ","سُئِلَتۡ"],"ва'изал мау'уудату су'илат","когда зарытую живьем спросят,",["и когда","заживо погребённая","будет спрошена"]],[81,9,["بِأَيِّ","ذَنۢبٖ","قُتِلَتۡ"],"би'аййи замбин ḳутилат","за какой грех ее убили,",["за какой","грех","она была убита"]],[81,10,["وَإِذَا","ٱلصُّحُفُ","نُشِرَتۡ"],"ва'изас сухуфу нушират","когда свитки с деяниями рабов будут развернуты,",["и когда","свитки","будут раскрыты"]],[81,11,["وَإِذَا","ٱلسَّمَآءُ","كُشِطَتۡ"],"ва'изас самау кушитат","когда небо будет сдернуто,",["и когда","небо","будет сдёрнуто"]],[81,12,["وَإِذَا","ٱلۡجَحِيمُ","سُعِّرَتۡ"],"ва'изал жахииму су``ират","когда Ад будет разожжен с новой силой,",["и когда","Ад","будет разожжён"]],[81,13,["وَإِذَا","ٱلۡجَنَّةُ","أُزۡلِفَتۡ"],"ва'изал жаннату узлифат","когда Рай будет приближен к праведникам,",["и когда","Рай","будет приближен"]],[81,14,["عَلِمَتۡ","نَفۡسٞ","مَّآ","أَحۡضَرَتۡ"],"`алимат нафсум ма ахдарат","тогда познает душа, что она принесла.",["узнает","душа","то, что","она приготовила"]],[81,15,["فَلَآ","أُقۡسِمُ","بِٱلۡخُنَّسِ"],"фала уḳсиму билхуннас","Но нет! Клянусь телами небесными - отступающими,",["Но нет","клянусь","отступающими (звёздами)"]],[81,16,["ٱلۡجَوَارِ","ٱلۡكُنَّسِ"],"алжаварил куннас","передвигающимися и исчезающими!",["движущимися","скрывающимися"]],[81,17,["وَٱلَّيۡلِ","إِذَا","عَسۡعَسَ"],"валлайли иза `ас`ас","Клянусь ночью, когда она наступила (или отступила)!",["и ночью","когда","она наступает"]],[81,18,["وَٱلصُّبۡحِ","إِذَا","تَنَفَّسَ"],"вассубхи иза танаффас","Клянусь рассветом, когда он забрезжил!",["и утром","когда","оно задышит"]],[81,19,["إِنَّهُۥ","لَقَوۡلُ","رَسُولٖ","كَرِيمٖ"],"иннахуу лаḳаулу расуулин кариим","Это - слова благородного посланца,",["Поистине, это","непременно слово","посланника","благородного"]],[81,20,["ذِي","قُوَّةٍ","عِندَ","ذِي","ٱلۡعَرۡشِ","مَكِينٖ"],"зии ḳувватин `инда зил `арши макиин","обладателя силы при Владыке Трона, почитаемого,",["обладающего","силой","у","Обладателя","Трона","занимающего высокое положение"]],[81,21,["مُّطَاعٖ","ثَمَّ","أَمِينٖ"],"ммута`ин самма амиин","которому там (на небесах) повинуются, доверенного.",["повинуемого","там","надёжного"]],[81,22,["وَمَا","صَاحِبُكُم","بِمَجۡنُونٖ"],"вама сахибукум бимажнуун","Ваш товарищ (Мухаммад) не является одержимым.",["И не","ваш товарищ","одержимый"]],[81,23,["وَلَقَدۡ","رَءَاهُ","بِٱلۡأُفُقِ","ٱلۡمُبِينِ"],"валаḳад ра'аху бил'уфуḳил мубиин","Он видел его (Джибрила) на ясном горизонте",["И действительно","он видел его","на горизонте","ясном"]],[81,24,["وَمَا","هُوَ","عَلَى","ٱلۡغَيۡبِ","بِضَنِينٖ"],"вама хуа `алал гайби биданиин","и не скупится передать сокровенное.",["И не","он","в отношении","сокровенного","скупой"]],[81,25,["وَمَا","هُوَ","بِقَوۡلِ","شَيۡطَٰنٖ","رَّجِيمٖ"],"вама хуа биḳаули шайтанир ражиим","Это - не речи дьявола изгнанного, побиваемого.",["и не","он","слово","шайтана","побиваемого"]],[81,26,["فَأَيۡنَ","تَذۡهَبُونَ"],"фа'айна тазхабуун","Куда же вы направляетесь?",["Куда же","вы идёте"]],[81,27,["إِنۡ","هُوَ","إِلَّا","ذِكۡرٞ","لِّلۡعَٰلَمِينَ"],"ин хуа илла зикрул лил`аламиин","Это - лишь Напоминание мирам,",["Не","это","лишь","напоминание","для миров"]],[81,28,["لِمَن","شَآءَ","مِنكُمۡ","أَن","يَسۡتَقِيمَ"],"лиман шаа минкум ан йастаḳиим","тем из вас, кто желает следовать прямым путем.",["для того, кто","пожелал","из вас","чтобы","идти прямо"]],[81,29,["وَمَا","تَشَآءُونَ","إِلَّآ","أَن","يَشَآءَ","ٱللَّهُ","رَبُّ","ٱلۡعَٰلَمِينَ"],"вама ташаууна илла ан йашааллаху раббул `аламиин","Но вы не пожелаете этого, если этого не пожелает Аллах, Господь миров.",["Но не","вы пожелаете","кроме","если","пожелает","Аллах","Господь","миров"]]],"m":[["h",81],["b"],[["إِذَا","Когда",81,1],["ٱلشَّمۡسُ","солнце",81,1],["كُوِّرَتۡ","будет свёрнуто",81,1],[1],["وَإِذَا","и когда",81,2],["ٱلنُّجُومُ","звёзды",81,2],["ٱنكَدَرَتۡ","осыплются",81,2],[2],["وَإِذَا","и когда",81,3],["ٱلۡجِبَالُ","горы",81,3]],[["سُيِّرَتۡ","будут сдвинуты",81,3],[3],["وَإِذَا","и когда",81,4],["ٱلۡعِشَارُ","верблюдицы стельные",81,4],["عُطِّلَتۡ","будут оставлены без присмотра",81,4],[4],["وَإِذَا","и когда",81,5],["ٱلۡوُحُوشُ","дикие звери",81,5],["حُشِرَتۡ","будут собраны",81,5]],[[5],["وَإِذَا","и когда",81,6],["ٱلۡبِحَارُ","моря",81,6],["سُجِّرَتۡ","будут разожжены",81,6],[6],["وَإِذَا","и когда",81,7],["ٱلنُّفُوسُ","души",81,7],["زُوِّجَتۡ","будут соединены",81,7],[7],["وَإِذَا","и когда",81,8]],[["ٱلۡمَوۡءُۥدَةُ","заживо погребённая",81,8],["سُئِلَتۡ","будет спрошена",81,8],[8],["بِأَيِّ","за какой",81,9],["ذَنۢبٖ","грех",81,9],["قُتِلَتۡ","она была убита",81,9],[9],["وَإِذَا","и когда",81,10],["ٱلصُّحُفُ","свитки",81,10],["نُشِرَتۡ","будут раскрыты",81,10]],[[10],["وَإِذَا","и когда",81,11],["ٱلسَّمَآءُ","небо",81,11],["كُشِطَتۡ","будет сдёрнуто",81,11],[11],["وَإِذَا","и когда",81,12],["ٱلۡجَحِيمُ","Ад",81,12],["سُعِّرَتۡ","будет разожжён",81,12],[12],["وَإِذَا","и когда",81,13],["ٱلۡجَنَّةُ","Рай",81,13]],[["أُزۡلِفَتۡ","будет приближен",81,13],[13],["عَلِمَتۡ","узнает",81,14],["نَفۡسٞ","душа",81,14],["مَّآ","то, что",81,14],["أَحۡضَرَتۡ","она приготовила",81,14],[14],["فَلَآ","Но нет",81,15],["أُقۡسِمُ","клянусь",81,15],["بِٱلۡخُنَّسِ","отступающими (звёздами)",81,15],[15]],[["ٱلۡجَوَارِ","движущимися",81,16],["ٱلۡكُنَّسِ","скрывающимися",81,16],[16],["وَٱلَّيۡلِ","и ночью",81,17],["إِذَا","когда",81,17],["عَسۡعَسَ","она наступает",81,17],[17],["وَٱلصُّبۡحِ","и утром",81,18],["إِذَا","когда",81,18],["تَنَفَّسَ","оно задышит",81,18],[18]],[["إِنَّهُۥ","Поистине, это",81,19],["لَقَوۡلُ","непременно слово",81,19],["رَسُولٖ","посланника",81,19],["كَرِيمٖ","благородного",81,19],[19],["ذِي","обладающего",81,20],["قُوَّةٍ","силой",81,20],["عِندَ","у",81,20],["ذِي","Обладателя",81,20],["ٱلۡعَرۡشِ","Трона",81,20],["مَكِينٖ","занимающего высокое положение",81,20],[20],["مُّطَاعٖ","повинуемого",81,21]],[["ثَمَّ","там",81,21],["أَمِينٖ","надёжного",81,21],[21],["وَمَا","И не",81,22],["صَاحِبُكُم","ваш товарищ",81,22],["بِمَجۡنُونٖ","одержимый",81,22],[22],["وَلَقَدۡ","И действительно",81,23],["رَءَاهُ","он видел его",81,23],["بِٱلۡأُفُقِ","на горизонте",81,23],["ٱلۡمُبِينِ","ясном",81,23]],[[23],["وَمَا","И не",81,24],["هُوَ","он",81,24],["عَلَى","в отношении",81,24],["ٱلۡغَيۡبِ","сокровенного",81,24],["بِضَنِينٖ","скупой",81,24],[24],["وَمَا","и не",81,25],["هُوَ","он",81,25],["بِقَوۡلِ","слово",81,25],["شَيۡطَٰنٖ","шайтана",81,25],["رَّجِيمٖ","побиваемого",81,25],[25]],[["فَأَيۡنَ","Куда же",81,26],["تَذۡهَبُونَ","вы идёте",81,26],[26],["إِنۡ","Не",81,27],["هُوَ","это",81,27],["إِلَّا","лишь",81,27],["ذِكۡرٞ","напоминание",81,27],["لِّلۡعَٰلَمِينَ","для миров",81,27],[27],["لِمَن","для того, кто",81,28],["شَآءَ","пожелал",81,28],["مِنكُمۡ","из вас",81,28],["أَن","чтобы",81,28]],[["يَسۡتَقِيمَ","идти прямо",81,28],[28],["وَمَا","Но не",81,29],["تَشَآءُونَ","вы пожелаете",81,29],["إِلَّآ","кроме",81,29],["أَن","если",81,29],["يَشَآءَ","пожелает",81,29],["ٱللَّهُ","Аллах",81,29],["رَبُّ","Господь",81,29],["ٱلۡعَٰلَمِينَ","миров",81,29],[29]],["h",82]]}