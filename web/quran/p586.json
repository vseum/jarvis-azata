{"p":586,"j":30,"a":[[81,1,["إِذَا","ٱلشَّمۡسُ","كُوِّرَتۡ"],"изаш шамсу куввират","Когда солнце будет свернуто (или потеряет свое сияние, или будет выброшено),",["Когда","солнце","будет свёрнуто"]],[81,2,["وَإِذَا","ٱلنُّجُومُ","ٱنكَدَرَتۡ"],"ва'изан нужуумункадарат","когда падут звезды,",["и когда","звёзды","осыплются"]],[81,3,["وَإِذَا","ٱلۡجِبَالُ","سُيِّرَتۡ"],"ва'изал жибалу суййират","когда горы будут сдвинуты с мест (или приведены в движение),",["и когда","горы","будут сдвинуты"]],[81,4,["وَإِذَا","ٱلۡعِشَارُ","عُطِّلَتۡ"],"ва'изал `ишару `уттилат","когда верблюдицы на десятом месяце беременности останутся без присмотра,",["и когда","верблюдицы стельные","будут оставлены без присмотра"]],[81,5,["وَإِذَا","ٱلۡوُحُوشُ","حُشِرَتۡ"],"ва'изал вухуушу хушират","когда дикие звери будут собраны,",["и когда","дикие звери","будут собраны"]],[81,6,["وَإِذَا","ٱلۡبِحَارُ","سُجِّرَتۡ"],"ва'изал бихару сужжират","когда моря запылают (или переполнятся; или опустеют; или перемешаются; или станут красными),",["и когда","моря","будут разожжены"]],[81,7,["وَإِذَا","ٱلنُّفُوسُ","زُوِّجَتۡ"],"ва'изан нуфуусу зуввижат","когда души объединятся (праведники объединятся с праведниками, а грешники - с грешниками; или праведники соединятся с райскими гуриями, а неверующие - с дьяволами; или души соединятся с телами),",["и когда","души","будут соединены"]],[81,8,["وَإِذَا","ٱلۡمَوۡءُۥدَةُ","سُئِلَتۡ"],"ва'изал мау'уудату су'илат","когда зарытую живьем спросят,",["и когда","заживо погребённая","будет спрошена"]],[81,9,["بِأَيِّ","ذَنۢبٖ","قُتِلَتۡ"],"би'аййи замбин ḳутилат","за какой грех ее убили,",["за какой","грех","она была убита"]],[81,10,["وَإِذَا","ٱلصُّحُفُ","نُشِرَتۡ"],"ва'изас сухуфу нушират","когда свитки с деяниями рабов будут развернуты,",["и когда","свитки","будут раскрыты"]],[81,11,["وَإِذَا","ٱلسَّمَآءُ","كُشِطَتۡ"],"ва'изас самау кушитат","когда небо будет сдернуто,",["и когда","небо","будет сдёрнуто"]],[81,12,["وَإِذَا","ٱلۡجَحِيمُ","سُعِّرَتۡ"],"ва'изал жахииму су``ират","когда Ад будет разожжен с новой силой,",["и когда","Ад","будет разожжён"]],[81,13,["وَإِذَا","ٱلۡجَنَّةُ","أُزۡلِفَتۡ"],"ва'изал жаннату узлифат","когда Рай будет приближен к праведникам,",["и когда","Рай","будет приближен"]],[81,14,["عَلِمَتۡ","نَفۡسٞ","مَّآ","أَحۡضَرَتۡ"],"`алимат нафсум ма ахдарат","тогда познает душа, что она принесла.",["узнает","душа","то, что","она приготовила"]],[81,15,["فَلَآ","أُقۡسِمُ","بِٱلۡخُنَّسِ"],"фала уḳсиму билхуннас","Но нет! Клянусь телами небесными - отступающими,",["Но нет","клянусь","отступающими (звёздами)"]],[81,16,["ٱلۡجَوَارِ","ٱلۡكُنَّسِ"],"алжаварил куннас","передвигающимися и исчезающими!",["движущимися","скрывающимися"]],[81,17,["وَٱلَّيۡلِ","إِذَا","عَسۡعَسَ"],"валлайли иза `ас`ас","Клянусь ночью, когда она наступила (или отступила)!",["и ночью","когда","она наступает"]],[81,18,["وَٱلصُّبۡحِ","إِذَا","تَنَفَّسَ"],"вассубхи иза танаффас","Клянусь рассветом, когда он забрезжил!",["и утром","когда","оно задышит"]],[81,19,["إِنَّهُۥ","لَقَوۡلُ","رَسُولٖ","كَرِيمٖ"],"иннахуу лаḳаулу расуулин кариим","Это - слова благородного посланца,",["Поистине, это","непременно слово","посланника","благородного"]],[81,20,["ذِي","قُوَّةٍ","عِندَ","ذِي","ٱلۡعَرۡشِ","مَكِينٖ"],"зии ḳувватин `инда зил `арши макиин","обладателя силы при Владыке Трона, почитаемого,",["обладающего","силой","у","Обладателя","Трона","занимающего высокое положение"]],[81,21,["مُّطَاعٖ","ثَمَّ","أَمِينٖ"],"ммута`ин самма амиин","которому там (на небесах) повинуются, доверенного.",["повинуемого","там","надёжного"]],[81,22,["وَمَا","صَاحِبُكُم","بِمَجۡنُونٖ"],"вама сахибукум бимажнуун","Ваш товарищ (Мухаммад) не является одержимым.",["И не","ваш товарищ","одержимый"]],[81,23,["وَلَقَدۡ","رَءَاهُ","بِٱلۡأُفُقِ","ٱلۡمُبِينِ"],"валаḳад ра'аху бил'уфуḳил мубиин","Он видел его (Джибрила) на ясном горизонте",["И действительно","он видел его","на горизонте","ясном"]],[81,24,["وَمَا","هُوَ","عَلَى","ٱلۡغَيۡبِ","بِضَنِينٖ"],"вама хуа `алал гайби биданиин","и не скупится передать сокровенное.",["И не","он","в отношении","сокровенного","скупой"]],[81,25,["وَمَا","هُوَ","بِقَوۡلِ","شَيۡطَٰنٖ","رَّجِيمٖ"],"вама хуа биḳаули шайтанир ражиим","Это - не речи дьявола изгнанного, побиваемого.",["и не","он","слово","шайтана","побиваемого"]],[81,26,["فَأَيۡنَ","تَذۡهَبُونَ"],"фа'айна тазхабуун","Куда же вы направляетесь?",["Куда же","вы идёте"]],[81,27,["إِنۡ","هُوَ","إِلَّا","ذِكۡرٞ","لِّلۡعَٰلَمِينَ"],"ин хуа илла зикрул лил`аламиин","Это - лишь Напоминание мирам,",["Не","это","лишь","напоминание","для миров"]],[81,28,["لِمَن","شَآءَ","مِنكُمۡ","أَن","يَسۡتَقِيمَ"],"лиман шаа минкум ан йастаḳиим","тем из вас, кто желает следовать прямым путем.",["для того, кто","пожелал","из вас","чтобы","идти прямо"]],[81,29,["وَمَا","تَشَآءُونَ","إِلَّآ","أَن","يَشَآءَ","ٱللَّهُ","رَبُّ","ٱلۡعَٰلَمِينَ"],"вама ташаууна илла ан йашааллаху раббул `аламиин","Но вы не пожелаете этого, если этого не пожелает Аллах, Господь миров.",["Но не","вы пожелаете","кроме","если","пожелает","Аллах","Господь","миров"]]]}