{"p":586,"j":30,"a":[[81,1,["إِذَا","ٱلشَّمۡسُ","كُوِّرَتۡ"],"изаа шшамсу куууират","Когда солнце будет свернуто (или потеряет свое сияние, или будет выброшено),",["Когда","солнце","будет свёрнуто"]],[81,2,["وَإِذَا","ٱلنُّجُومُ","ٱنكَدَرَتۡ"],"уа'изаа ннуджууму нкадарат","когда падут звезды,",["и когда","звёзды","осыплются"]],[81,3,["وَإِذَا","ٱلۡجِبَالُ","سُيِّرَتۡ"],"уа'изаа лджибаалу суййират","когда горы будут сдвинуты с мест (или приведены в движение),",["и когда","горы","будут сдвинуты"]],[81,4,["وَإِذَا","ٱلۡعِشَارُ","عُطِّلَتۡ"],"уа'изаа л`ишаару `уттилат","когда верблюдицы на десятом месяце беременности останутся без присмотра,",["и когда","верблюдицы стельные","будут оставлены без присмотра"]],[81,5,["وَإِذَا","ٱلۡوُحُوشُ","حُشِرَتۡ"],"уа'изаа луухуушу хушират","когда дикие звери будут собраны,",["и когда","дикие звери","будут собраны"]],[81,6,["وَإِذَا","ٱلۡبِحَارُ","سُجِّرَتۡ"],"уа'изаа лбихаару суджджират","когда моря запылают (или переполнятся; или опустеют; или перемешаются; или станут красными),",["и когда","моря","будут разожжены"]],[81,7,["وَإِذَا","ٱلنُّفُوسُ","زُوِّجَتۡ"],"уа'изаа ннуфуусу зуууиджат","когда души объединятся (праведники объединятся с праведниками, а грешники - с грешниками; или праведники соединятся с райскими гуриями, а неверующие - с дьяволами; или души соединятся с телами),",["и когда","души","будут соединены"]],[81,8,["وَإِذَا","ٱلۡمَوۡءُۥدَةُ","سُئِلَتۡ"],"уа'изаа лмау'уудату су'илат","когда зарытую живьем спросят,",["и когда","заживо погребённая","будет спрошена"]],[81,9,["بِأَيِّ","ذَنۢبٖ","قُتِلَتۡ"],"би'аййи замбин кутилат","за какой грех ее убили,",["за какой","грех","она была убита"]],[81,10,["وَإِذَا","ٱلصُّحُفُ","نُشِرَتۡ"],"уа'изаа ссухуфу нушират","когда свитки с деяниями рабов будут развернуты,",["и когда","свитки","будут раскрыты"]],[81,11,["وَإِذَا","ٱلسَّمَآءُ","كُشِطَتۡ"],"уа'изаа ссамаа'у кушитат","когда небо будет сдернуто,",["и когда","небо","будет сдёрнуто"]],[81,12,["وَإِذَا","ٱلۡجَحِيمُ","سُعِّرَتۡ"],"уа'изаа лджахииму су``ират","когда Ад будет разожжен с новой силой,",["и когда","Ад","будет разожжён"]],[81,13,["وَإِذَا","ٱلۡجَنَّةُ","أُزۡلِفَتۡ"],"уа'изаа лджаннату узлифат","когда Рай будет приближен к праведникам,",["и когда","Рай","будет приближен"]],[81,14,["عَلِمَتۡ","نَفۡسٞ","مَّآ","أَحۡضَرَتۡ"],"`алимат нафсум маа ахдарат","тогда познает душа, что она принесла.",["узнает","душа","то, что","она приготовила"]],[81,15,["فَلَآ","أُقۡسِمُ","بِٱلۡخُنَّسِ"],"фалаа уксиму билхуннас","Но нет! Клянусь телами небесными - отступающими,",["Но нет","клянусь","отступающими (звёздами)"]],[81,16,["ٱلۡجَوَارِ","ٱلۡكُنَّسِ"],"алджауаари лкуннас","передвигающимися и исчезающими!",["движущимися","скрывающимися"]],[81,17,["وَٱلَّيۡلِ","إِذَا","عَسۡعَسَ"],"уаллайли изаа `ас`ас","Клянусь ночью, когда она наступила (или отступила)!",["и ночью","когда","она наступает"]],[81,18,["وَٱلصُّبۡحِ","إِذَا","تَنَفَّسَ"],"уассубхи изаа танаффас","Клянусь рассветом, когда он забрезжил!",["и утром","когда","оно задышит"]],[81,19,["إِنَّهُۥ","لَقَوۡلُ","رَسُولٖ","كَرِيمٖ"],"иннахуу лакаулу расуулин кариим","Это - слова благородного посланца,",["Поистине, это","непременно слово","посланника","благородного"]],[81,20,["ذِي","قُوَّةٍ","عِندَ","ذِي","ٱلۡعَرۡشِ","مَكِينٖ"],"зии куууатин `инда зии л`арши макиин","обладателя силы при Владыке Трона, почитаемого,",["обладающего","силой","у","Обладателя","Трона","занимающего высокое положение"]],[81,21,["مُّطَاعٖ","ثَمَّ","أَمِينٖ"],"ммутаа`ин самма амиин","которому там (на небесах) повинуются, доверенного.",["повинуемого","там","надёжного"]],[81,22,["وَمَا","صَاحِبُكُم","بِمَجۡنُونٖ"],"уамаа саахибукум бимаджнуун","Ваш товарищ (Мухаммад) не является одержимым.",["И не","ваш товарищ","одержимый"]],[81,23,["وَلَقَدۡ","رَءَاهُ","بِٱلۡأُفُقِ","ٱلۡمُبِينِ"],"уалакад ра'ааху бил'уфуки лмубиин","Он видел его (Джибрила) на ясном горизонте",["И действительно","он видел его","на горизонте","ясном"]],[81,24,["وَمَا","هُوَ","عَلَى","ٱلۡغَيۡبِ","بِضَنِينٖ"],"уамаа хууа `алаа лгайби биданиин","и не скупится передать сокровенное.",["И не","он","в отношении","сокровенного","скупой"]],[81,25,["وَمَا","هُوَ","بِقَوۡلِ","شَيۡطَٰنٖ","رَّجِيمٖ"],"уамаа хууа бикаули шайтаанир раджиим","Это - не речи дьявола изгнанного, побиваемого.",["и не","он","слово","шайтана","побиваемого"]],[81,26,["فَأَيۡنَ","تَذۡهَبُونَ"],"фа'айна тазхабуун","Куда же вы направляетесь?",["Куда же","вы идёте"]],[81,27,["إِنۡ","هُوَ","إِلَّا","ذِكۡرٞ","لِّلۡعَٰلَمِينَ"],"ин хууа иллаа зикрул лил`ааламиин","Это - лишь Напоминание мирам,",["Не","это","лишь","напоминание","для миров"]],[81,28,["لِمَن","شَآءَ","مِنكُمۡ","أَن","يَسۡتَقِيمَ"],"лиман шаа'а минкум ан йастакиим","тем из вас, кто желает следовать прямым путем.",["для того, кто","пожелал","из вас","чтобы","идти прямо"]],[81,29,["وَمَا","تَشَآءُونَ","إِلَّآ","أَن","يَشَآءَ","ٱللَّهُ","رَبُّ","ٱلۡعَٰلَمِينَ"],"уамаа ташаа'ууна иллаа ан йашаа'а ллаху раббу л`ааламиин","Но вы не пожелаете этого, если этого не пожелает Аллах, Господь миров.",["Но не","вы пожелаете","кроме","если","пожелает","Аллах","Господь","миров"]]]}