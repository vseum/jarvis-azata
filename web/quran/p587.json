{"p":587,"j":30,"a":[[82,1,["إِذَا","ٱلسَّمَآءُ","ٱنفَطَرَتۡ"],"изас самаунфатарат","Когда небо расколется,",["Когда","небо","расколется"]],[82,2,["وَإِذَا","ٱلۡكَوَاكِبُ","ٱنتَثَرَتۡ"],"ва'изал кавакибунтасарат","когда тела небесные осыплются,",["и когда","звёзды","осыплются"]],[82,3,["وَإِذَا","ٱلۡبِحَارُ","فُجِّرَتۡ"],"ва'изал бихару фужжират","когда моря перельются и смешаются (или высохнут),",["и когда","моря","будут извергнуты"]],[82,4,["وَإِذَا","ٱلۡقُبُورُ","بُعۡثِرَتۡ"],"ва'изал ḳубууру бу`сират","когда могилы перевернутся,",["и когда","могилы","будут перевёрнуты"]],[82,5,["عَلِمَتۡ","نَفۡسٞ","مَّا","قَدَّمَتۡ","وَأَخَّرَتۡ"],"`алимат нафсум ма ḳаддамат ва'аххарат","тогда каждая душа узнает, что она совершила и что оставила после себя.",["узнает","душа","то, что","она сделала прежде","и отложила"]],[82,6,["يَٰٓأَيُّهَا","ٱلۡإِنسَٰنُ","مَا","غَرَّكَ","بِرَبِّكَ","ٱلۡكَرِيمِ"],"йа'аййухал инсану ма гаррака бираббикал кариим","О человек! Что ввело тебя в заблуждение относительно твоего Великодушного Господа,",["О","человек","что","обольстило тебя","в отношении Господа твоего","Щедрого"]],[82,7,["ٱلَّذِي","خَلَقَكَ","فَسَوَّىٰكَ","فَعَدَلَكَ"],"аллазии халаḳака фасаввака фа`адалак","Который сотворил тебя и сделал твой облик совершенным и соразмеренным?",["Который","сотворил тебя","и выровнял тебя","и соразмерил тебя"]],[82,8,["فِيٓ","أَيِّ","صُورَةٖ","مَّا","شَآءَ","رَكَّبَكَ"],"фии аййи сууратим ма шаа раккабак","Он сложил тебя в том облике, в каком пожелал.",["в","каком","образе","ни","Он пожелал","Он сложил тебя"]],[82,9,["كـَلَّا","بَلۡ","تُكَذِّبُونَ","بِٱلدِّينِ"],"калла бал туказзибууна биддиин","Но нет! Вы же считаете ложью воздаяние.",["Но нет","напротив","вы считаете ложью","воздаяние"]],[82,10,["وَإِنَّ","عَلَيۡكُمۡ","لَحَٰفِظِينَ"],"ва'инна `алайкум лахафизиин","Воистину, над вами есть хранители -",["И поистине","над вами","непременно хранители"]],[82,11,["كِرَامٗا","كَٰتِبِينَ"],"кираман катибиин","благородные писцы,",["благородные","записывающие"]],[82,12,["يَعۡلَمُونَ","مَا","تَفۡعَلُونَ"],"йа`ламууна ма таф`алуун","которые знают о том, что вы совершаете.",["Они знают","то, что","вы делаете"]],[82,13,["إِنَّ","ٱلۡأَبۡرَارَ","لَفِي","نَعِيمٖ"],"иннал абрара лафии на`иим","Воистину, благочестивые окажутся в блаженстве.",["Поистине","благочестивые","непременно в","блаженстве"]],[82,14,["وَإِنَّ","ٱلۡفُجَّارَ","لَفِي","جَحِيمٖ"],"ва'иннал фужжара лафии жахиим","Воистину, грешники окажутся в Аду,",["И поистине","грешники","непременно в","Аду"]],[82,15,["يَصۡلَوۡنَهَا","يَوۡمَ","ٱلدِّينِ"],"йаслаунаха йаумад диин","куда они войдут в День воздаяния.",["Они будут гореть в нём","в день","воздаяния"]],[82,16,["وَمَا","هُمۡ","عَنۡهَا","بِغَآئِبِينَ"],"вама хум `анха бигаибиин","Они не смогут избежать этого.",["И не","они","от него","отсутствующие"]],[82,17,["وَمَآ","أَدۡرَىٰكَ","مَا","يَوۡمُ","ٱلدِّينِ"],"вама адрака ма йаумуд диин","Откуда ты мог знать, что такое День воздаяния?",["И что","даст тебе знать","что","день","воздаяния"]],[82,18,["ثُمَّ","مَآ","أَدۡرَىٰكَ","مَا","يَوۡمُ","ٱلدِّينِ"],"сумма ма адрака ма йаумуд диин","Да, откуда ты мог знать, что такое День воздаяния?",["Затем","что","даст тебе знать","что","день","воздаяния"]],[82,19,["يَوۡمَ","لَا","تَمۡلِكُ","نَفۡسٞ","لِّنَفۡسٖ","شَيۡـٔٗاۖ","وَٱلۡأَمۡرُ","يَوۡمَئِذٖ","لِّلَّهِ"],"йаума ла тамлику нафсул линафсин шай'ан вал'амру йаумаизил лиллах","В тот день ни одна душа не сможет ничем помочь другой, и власть в тот день будет принадлежать Аллаху.",["В день, когда","не","сможет","душа","для души","ничего","и повеление","в тот день","Аллаху"]],[83,1,["وَيۡلٞ","لِّلۡمُطَفِّفِينَ"],"вайлул лилмутаффифиин","Горе обвешивающим,",["Горе","обвешивающим"]],[83,2,["ٱلَّذِينَ","إِذَا","ٱكۡتَالُواْ","عَلَى","ٱلنَّاسِ","يَسۡتَوۡفُونَ"],"аллазиина изакталуу `алан наси йастауфуун","которые требуют дать им сполна, когда люди отмеривают им,",["которые","когда","берут мерой","у","людей","берут сполна"]],[83,3,["وَإِذَا","كَالُوهُمۡ","أَو","وَّزَنُوهُمۡ","يُخۡسِرُونَ"],