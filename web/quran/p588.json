{"p":588,"j":30,"a":[[83,7,["كـَلَّآ","إِنَّ","كِتَٰبَ","ٱلۡفُجَّارِ","لَفِي","سِجِّينٖ"],"калла инна китабал фужжари лафии сижжиин","Но нет! Книга грешников находится в Сиджжине.",["так нет","поистине","книга","нечестивцев","непременно в","Сиджжине"]],[83,8,["وَمَآ","أَدۡرَىٰكَ","مَا","سِجِّينٞ"],"вама адрака ма сижжиин","Откуда ты мог знать, что такое Сиджжин?",["И что","даст тебе знать","что","Сиджжин"]],[83,9,["كِتَٰبٞ","مَّرۡقُومٞ"],"китабум марḳуум","Это - книга начертанная, в которой записаны все злодеяния дьяволов, неверующих и грешников (или скала под седьмой землей, под которой находится начертанная книга с деяниями грешников).",["Книга","начертанная"]],[83,10,["وَيۡلٞ","يَوۡمَئِذٖ","لِّلۡمُكَذِّبِينَ"],"вайлун йаумаизил лилмуказзибиин","Горе в тот день тем, кто считает истину ложью,",["Горе","в тот день","отвергающим"]],[83,11,["ٱلَّذِينَ","يُكَذِّبُونَ","بِيَوۡمِ","ٱلدِّينِ"],"аллазиина йуказзибууна бийаумид диин","кто считает ложью День воздаяния!",["которые","отвергают","день","воздаяния"]],[83,12,["وَمَا","يُكَذِّبُ","بِهِۦٓ","إِلَّا","كُلُّ","مُعۡتَدٍ","أَثِيمٍ"],"вама йуказзибу бихии илла куллу му`тадин асиим","Его считает ложью только преступник и грешник.",["И не","отвергает","его","кроме","всякого","преступника","грешного"]],[83,13,["إِذَا","تُتۡلَىٰ","عَلَيۡهِ","ءَايَٰتُنَا","قَالَ","أَسَٰطِيرُ","ٱلۡأَوَّلِينَ"],"иза тутла `алайхи айатуна ḳала асатиирул аввалиин","Когда ему читают Наши аяты, он говорит: «Это - легенды древних народов!».",["Когда","читаются","ему","аяты Наши","он говорит","сказки","древних"]],[83,14,["كـَلَّاۖ","بَلۡۜ","رَانَ","عَلَىٰ","قُلُوبِهِم","مَّا","كَانُواْ","يَكۡسِبُونَ"],"калла бал рана `ала ḳулуубихим ма кануу йаксибуун","Но нет! Напротив, их сердца окутаны тем, что они приобрели.",["Но нет","напротив","покрыло ржавчиной","на","сердца их","то, что","они","приобретали"]],[83,15,["كـَلَّآ","إِنَّهُمۡ","عَن","رَّبِّهِمۡ","يَوۡمَئِذٖ","لَّمَحۡجُوبُونَ"],"калла иннахум `ар раббихим йаумаизил ламахжуубуун","Но нет! В тот 