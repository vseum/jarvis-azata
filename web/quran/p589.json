{"p":589,"j":30,"a":[[83,35,["عَلَى","ٱلۡأَرَآئِكِ","يَنظُرُونَ"],"`алал араики йанзуруун","и на ложах созерцать райские блага и то ужасное положение, в котором окажутся грешники.",["на","ложах","взирая"]],[83,36,["هَلۡ","ثُوِّبَ","ٱلۡكُفَّارُ","مَا","كَانُواْ","يَفۡعَلُونَ"],"хал суввибал куффару ма кануу йаф`алуун","Разве неверующие не получат воздаяние за то, что они совершали?",["разве","получили воздаяние","неверующие","за то, что","они были","делают"]],[84,1,["إِذَا","ٱلسَّمَآءُ","ٱنشَقَّتۡ"],"изас самауншаḳḳат","Когда небо разверзнется",["когда","небо","расколется"]],[84,2,["وَأَذِنَتۡ","لِرَبِّهَا","وَحُقَّتۡ"],"ва'азинат лираббиха вахуḳḳат","и внемлет своему Господу, как ему надлежит,",["и внемлет","своему Господу","и обязано (внимать)"]],[84,3,["وَإِذَا","ٱلۡأَرۡضُ","مُدَّتۡ"],"ва'изал арду муддат","когда земля будет распростерта,",["и когда","земля","растянута будет"]],[84,4,["وَأَلۡقَتۡ","مَا","فِيهَا","وَتَخَلَّتۡ"],"ва'алḳат ма фииха ватахаллат","извергнет то, что в ней, и опустеет,",["и выбросит","то, что","в ней","и опустеет"]],[84,5,["وَأَذِنَتۡ","لِرَبِّهَا","وَحُقَّتۡ"],"ва'азинат лираббиха вахуḳḳат","и внемлет своему Господу, как ей надлежит...",["и внемлет","своему Господу","и обязана (внимать)"]],[84,6,["يَٰٓأَيُّهَا","ٱلۡإِنسَٰنُ","إِنَّكَ","كَادِحٌ","إِلَىٰ","رَبِّكَ","كَدۡحٗا","فَمُلَٰقِيهِ"],"йа'аййухал инсану иннака кадихун ила раббика кадхан фамулаḳиих","О человек! Ты стремишься к своему Господу и встретишься с Ним.",["о","человек","поистине, ты","стремишься","к","своему Господу","стремлением","и встретишь Его"]],[84,7,["فَأَمَّا","مَنۡ","أُوتِيَ","كِتَٰبَهُۥ","بِيَمِينِهِۦ"],"фа'амма ман уутийа китабахуу бийамиинихи","Тот, кому его книга будет вручена в правую руку,",["и что до","того, кто","дана будет","книга его","в правую руку его"]],[84,8,["فَسَوۡفَ","يُحَاسَبُ","حِسَابٗا","يَسِيرٗا"],"фасауфа йухасабу хисабан йасиира","получит легкий расчет",["то вскоре","рассчитан будет","расчётом","лёгким"]],[84,9,["وَيَنقَلِبُ","إِلَىٰٓ","أَهۡلِهِۦ","مَسۡرُورٗا"],"вайанḳалибу ила ахлихии масруура","и вернется к своей семье радостным.",["и вернётся","к","своей семье","радостным"]],[84,10,["وَأَمَّا","مَنۡ","أُوتِيَ","كِتَٰبَهُۥ","وَرَآءَ","ظَهۡرِهِۦ"],"ва'амма ман уутийа китабахуу вараа захрихи","А тот, кому его книга будет вручена из-за спины,",["а что до","того, кто","дана будет","книга его","из-за","его спины"]],[84,11,["فَسَوۡفَ","يَدۡعُواْ","ثُبُورٗا"],"фасауфа йад`уу субуура","станет призывать погибель",["то вскоре","будет звать","погибель"]],[84,12,["وَيَصۡلَىٰ","سَعِيرًا"],"вайасла са`иира","и войдет в Пламень.",["и будет гореть","в Пламени"]],[84,13,["إِنَّهُۥ","كَانَ","فِيٓ","أَهۡلِهِۦ","مَسۡرُورًا"],"иннахуу кана фии ахлихии масруура","Он радовался, находясь в кругу своей семьи,",["поистине, он","был","среди","своей семьи","радостным"]],[84,14,["إِنَّهُۥ","ظَنَّ","أَن","لَّن","يَحُورَ"],"иннахуу занна ал лан йахуур","и полагал, что не вернется обратно.",["поистине, он","думал","что","никогда не","вернётся"]],[84,15,["بَلَىٰٓۚ","إِنَّ","رَبَّهُۥ","كَانَ","بِهِۦ","بَصِيرٗا"],"бала инна раббахуу кана бихии басиира","Но нет! Господь его видел его.",["да, конечно","поистине","Господь его","был","о нем","видящим"]],[84,16,["فَلَآ","أُقۡسِمُ","بِٱلشَّفَقِ"],"фала уḳсиму бишшафаḳ","Но нет! Клянусь вечерней зарею!",["но нет","клянусь","вечерней зарёй"]],[84,17,["وَٱلَّيۡلِ","وَمَا","وَسَقَ"],"валлайли вама васаḳ","Клянусь ночью и тем, что она собирает!",["и ночью","и тем, что","она собрала"]],[84,18,["وَٱلۡقَمَرِ","إِذَا","ٱتَّسَقَ"],"валḳамари изаттасаḳ","Клянусь луной в полнолуние!",["и луной","когда","она полна"]],[84,19,["لَتَرۡكَبُنَّ","طَبَقًا","عَن","طَبَقٖ"],"латаркабунна табаḳан `ан табаḳ","Вы переходите из одного состояния в другое.",["непременно перейдёте вы","из состояния","в","состояние"]],[84,20,["فَمَا","لَهُمۡ","لَا","يُؤۡمِنُونَ"],"фама лахум ла йу'минуун","Почему же они не веруют",["так что","с ними","не","веруют они"]],[84,21,["وَإِذَا","قُرِئَ","عَلَيۡهِمُ","ٱلۡقُرۡءَانُ","لَا","يَسۡجُدُونَۤ ۩"],"ва'иза ḳуриа `алайхимул ḳур'ану ла йасжудуун","и не падают ниц, когда им читают Коран?",["и когда","читается","им","Коран","не","падают ниц они"]],[84,22,["بَلِ","ٱلَّذِينَ","كَفَرُواْ","يُكَذِّبُونَ"],"балил лазиина кафаруу йуказзибуун","Но неверующие считают это ложью,",["напротив","те, которые","не уверовали","отрицают"]],[84,23,["وَٱللَّهُ","أَعۡلَمُ","بِمَا","يُوعُونَ"],"валлаху а`ламу бима йуу`уун","Аллаху же лучше знать, что они хранят (какие добрые и злые деяния они совершают).",["и Аллах","лучше знает","то, что","таят они"]],[84,24,["فَبَشِّرۡهُم","بِعَذَابٍ","أَلِيمٍ"],"фабашширхум би`азабин алиим","Обрадуй же их мучительными страданиями,",["так обрадуй их","мучением","мучительным"]],[84,25,["إِلَّا","ٱلَّذِينَ","ءَامَنُواْ","وَعَمِلُواْ","ٱلصَّٰلِحَٰتِ","لَهُمۡ","أَجۡرٌ","غَيۡرُ","مَمۡنُونِۭ"],"иллал лазиина амануу ва`амилус салихати лахум ажрун гайру мамнуун","кроме тех, которые уверовали и совершали праведные деяния. Им уготована награда неиссякаемая.",["кроме","тех, которые","уверовали","и совершали","праведные дела","им","награда","не","прекращающаяся"]]]}