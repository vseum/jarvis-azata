{"p":590,"j":30,"a":[[85,1,["وَٱلسَّمَآءِ","ذَاتِ","ٱلۡبُرُوجِ"],"вассамаи затил бурууж","Клянусь небом с созвездиями Зодиака!",["клянусь небом","обладающим","созвездиями"]],[85,2,["وَٱلۡيَوۡمِ","ٱلۡمَوۡعُودِ"],"валйаумил мау`ууд","Клянусь днем обещанным!",["и Днём","обещанным"]],[85,3,["وَشَاهِدٖ","وَمَشۡهُودٖ"],"вашахидин вамашхууд","Клянусь свидетельствующим и засвидетельствованным!",["и свидетельствующим","и засвидетельствованным"]],[85,4,["قُتِلَ","أَصۡحَٰبُ","ٱلۡأُخۡدُودِ"],"ḳутила асхабул ухдууд","Да сгинут собравшиеся у рва -",["убиты","владельцы","рва"]],[85,5,["ٱلنَّارِ","ذَاتِ","ٱلۡوَقُودِ"],"аннари затил ваḳууд","огненного, поддерживаемого растопкой!",["огня","обладающего","топливом"]],[85,6,["إِذۡ","هُمۡ","عَلَيۡهَا","قُعُودٞ"],"из хум `алайха ḳу`ууд","Вот они уселись возле него,",["вот","они","возле него","сидели"]],[85,7,["وَهُمۡ","عَلَىٰ","مَا","يَفۡعَلُونَ","بِٱلۡمُؤۡمِنِينَ","شُهُودٞ"],"вахум `ала ма йаф`алууна билму'миниина шухууд","будучи свидетелями того, что творят с верующими.",["и они","над","тем, что","делали","с верующими","свидетели"]],[85,8,["وَمَا","نَقَمُواْ","مِنۡهُمۡ","إِلَّآ","أَن","يُؤۡمِنُواْ","بِٱللَّهِ","ٱلۡعَزِيزِ","ٱلۡحَمِيدِ"],"вама наḳамуу минхум илла ан йу'минуу биллахил `азиизил хамиид","Они вымещали им только за то, что те уверовали в Аллаха Могущественного, Достохвального,",["и не","мстили они","им","кроме","за то, что","уверовали они","в Аллаха","Могущественного","Достохвального"]],[85,9,["ٱلَّذِي","لَهُۥ","مُلۡكُ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِۚ","وَٱللَّهُ","عَلَىٰ","كُلِّ","شَيۡءٖ","شَهِيدٌ"],"аллазии лахуу мулкус самавати вал'арди валлаху `ала кулли шай'ин шахиид","Которому принадлежит власть над небесами и землей. Аллах же - Свидетель всякой вещи!",["Тот, Который","Ему","власть","небес","и земли","и Аллах","над","всякой","вещью","Свидетель"]],[85,10,["إِنَّ","ٱلَّذِينَ","فَتَنُواْ","ٱلۡمُؤۡمِنِينَ","وَٱلۡمُؤۡمِنَٰتِ","ثُمَّ","لَمۡ","يَتُوبُواْ","فَلَهُمۡ","عَذَابُ","جَهَنَّمَ","وَلَهُمۡ","عَذَابُ","ٱلۡحَرِيقِ"],"иннал лазиина фатанул му'миниина валму'минати сумма лам йатуубуу фалахум `азабу жаханнама валахум `азабул харииḳ","Тем, которые подвергли искушению (или сожгли в огне) верующих мужчин и женщин и не раскаялись, уготованы мучения в Геенне, мучения от обжигающего Огня.",["поистине","те, которые","искушали","верующих","и верующих женщин","затем","не","покаялись","то им","мучение","Геенны","и им","мучение","сожжения"]],[85,11,["إِنَّ","ٱلَّذِينَ","ءَامَنُواْ","وَعَمِلُواْ","ٱلصَّٰلِحَٰتِ","لَهُمۡ","جَنَّٰتٞ","تَجۡرِي","مِن","تَحۡتِهَا","ٱلۡأَنۡهَٰرُۚ","ذَٰلِكَ","ٱلۡفَوۡزُ","ٱلۡكَبِيرُ"],"иннал лазиина амануу ва`амилус салихати лахум жаннатун тажрии мин тахтихал анхару заликал фаузул кабиир","Тем же, которые уверовали и совершали праведные деяния, уготованы Райские сады, в которых текут реки. Это - великое преуспеяние!",["поистине","те, которые","уверовали","и совершали","праведные дела","им","Сады","текут","из","под ними","реки","это","успех","великий"]],[85,12,["إِنَّ","بَطۡشَ","رَبِّكَ","لَشَدِيدٌ"],"инна батша раббика лашадиид","Воистину, Хватка твоего Господа сурова!",["поистине","хватка","Господа твоего","непременно сильна"]],[85,13,["إِنَّهُۥ","هُوَ","يُبۡدِئُ","وَيُعِيدُ"],"иннахуу хуа йубдиу вайу`иид","Воистину, Он начинает и повторяет (создает творение в первый раз и воссоздает его или начинает наказывать в этом мире и возобновляет наказание в Последней жизни).",["поистине, Он","Он","начинает","и повторяет"]],[85,14,["وَهُوَ","ٱلۡغَفُورُ","ٱلۡوَدُودُ"],"вахуал гафуурул вадууд","Он - Прощающий, Любящий (или Любимый),",["и Он","Прощающий","Любящий"]],[85,15,["ذُو","ٱلۡعَرۡشِ","ٱلۡمَجِيدُ"],"зул `аршил мажиид","Владыка Трона, Славный (или Владыка Трона славного).",["Обладатель","Трона","Славный"]],[85,16,["فَعَّالٞ","لِّمَا","يُرِيدُ"],"фа``алул лима йуриид","Он вершит то, что пожелает.",["Вершащий","то, что","Он желает"]],[85,17,["هَلۡ","أَتَىٰكَ","حَدِيثُ","ٱلۡجُنُودِ"],"хал атака хадиисул жунууд","Дошел ли до тебя рассказ о воинствах,",["разве","пришёл к тебе","рассказ","о войсках"]],[85,18,["فِرۡعَوۡنَ","وَثَمُودَ"],"фир`ауна васамууд","о Фараоне и самудянах?",["Фараона","и самудян"]],[85,19,["بَلِ","ٱلَّذِينَ","كَفَرُواْ","فِي","تَكۡذِيبٖ"],"балил лазиина кафаруу фии такзииб","Но неверующие считают это ложью,",["но","те, которые","не уверовали","в","отвержении"]],[85,20,["وَٱللَّهُ","مِن","وَرَآئِهِم","مُّحِيطُۢ"],"валлаху мин вараихим мухиит","Аллах же окружает их сзади.",["а Аллах","из","позади них","объемлющий"]],[85,21,["بَلۡ","هُوَ","قُرۡءَانٞ","مَّجِيدٞ"],"бал хуа ḳур'анум мажиид","Да, это - славный Коран",["напротив","это","Коран","славный"]],[85,22,["فِي","لَوۡحٖ","مَّحۡفُوظِۭ"],"фии лаухим махфууз","в Хранимой скрижали.",["на","Скрижали","хранимой"]]],"m":[["h",85],["b"],[["وَٱلسَّمَآءِ","клянусь небом",85,1],["ذَاتِ","обладающим",85,1],["ٱلۡبُرُوجِ","созвездиями",85,1],[1],["وَٱلۡيَوۡمِ","и Днём",85,2],["ٱلۡمَوۡعُودِ","обещанным",85,2],[2],["وَشَاهِدٖ","и свидетельствующим",85,3],["وَمَشۡهُودٖ","и засвидетельствованным",85,3]],[[3],["قُتِلَ","убиты",85,4],["أَصۡحَٰبُ","владельцы",85,4],["ٱلۡأُخۡدُودِ","рва",85,4],[4],["ٱلنَّارِ","огня",85,5],["ذَاتِ","обладающего",85,5],["ٱلۡوَقُودِ","топливом",85,5],[5],["إِذۡ","вот",85,6],["هُمۡ","они",85,6],["عَلَيۡهَا","возле него",85,6]],[["قُعُودٞ","сидели",85,6],[6],["وَهُمۡ","и они",85,7],["عَلَىٰ","над",85,7],["مَا","тем, что",85,7],["يَفۡعَلُونَ","делали",85,7],["بِٱلۡمُؤۡمِنِينَ","с верующими",85,7],["شُهُودٞ","свидетели",85,7],[7],["وَمَا","и не",85,8],["نَقَمُواْ","мстили они",85,8]],[["مِنۡهُمۡ","им",85,8],["إِلَّآ","кроме",85,8],["أَن","за то, что",85,8],["يُؤۡمِنُواْ","уверовали они",85,8],["بِٱللَّهِ","в Аллаха",85,8],["ٱلۡعَزِيزِ","Могущественного",85,8],["ٱلۡحَمِيدِ","Достохвального",85,8],[8],["ٱلَّذِي","Тот, Который",85,9],["لَهُۥ","Ему",85,9],["مُلۡكُ","власть",85,9]],[["ٱلسَّمَٰوَٰتِ","небес",85,9],["وَٱلۡأَرۡضِۚ","и земли",85,9],["وَٱللَّهُ","и Аллах",85,9],["عَلَىٰ","над",85,9],["كُلِّ","всякой",85,9],["شَيۡءٖ","вещью",85,9],["شَهِيدٌ","Свидетель",85,9]