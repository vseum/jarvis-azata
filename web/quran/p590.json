{"p":590,"j":30,"a":[[85,1,["وَٱلسَّمَآءِ","ذَاتِ","ٱلۡبُرُوجِ"],"уассамаа'и заати лбуруудж","Клянусь небом с созвездиями Зодиака!",["клянусь небом","обладающим","созвездиями"]],[85,2,["وَٱلۡيَوۡمِ","ٱلۡمَوۡعُودِ"],"уалйауми лмау`ууд","Клянусь днем обещанным!",["и Днём","обещанным"]],[85,3,["وَشَاهِدٖ","وَمَشۡهُودٖ"],"уашаахидин уамашхууд","Клянусь свидетельствующим и засвидетельствованным!",["и свидетельствующим","и засвидетельствованным"]],[85,4,["قُتِلَ","أَصۡحَٰبُ","ٱلۡأُخۡدُودِ"],"кутила асхаабу л'ухдууд","Да сгинут собравшиеся у рва -",["убиты","владельцы","рва"]],[85,5,["ٱلنَّارِ","ذَاتِ","ٱلۡوَقُودِ"],"аннаари заати луакууд","огненного, поддерживаемого растопкой!",["огня","обладающего","топливом"]],[85,6,["إِذۡ","هُمۡ","عَلَيۡهَا","قُعُودٞ"],"из хум `алайхаа ку`ууд","Вот они уселись возле него,",["вот","они","возле него","сидели"]],[85,7,["وَهُمۡ","عَلَىٰ","مَا","يَفۡعَلُونَ","بِٱلۡمُؤۡمِنِينَ","شُهُودٞ"],"уахум `алаа маа йаф`алууна билму'миниина шухууд","будучи свидетелями того, что творят с верующими.",["и они","над","тем, что","делали","с верующими","свидетели"]],[85,8,["وَمَا","نَقَمُواْ","مِنۡهُمۡ","إِلَّآ","أَن","يُؤۡمِنُواْ","بِٱللَّهِ","ٱلۡعَزِيزِ","ٱلۡحَمِيدِ"],"уамаа накамуу минхум иллаа ан йу'минуу биллахи л`азиизи лхамиид","Они вымещали им только за то, что те уверовали в Аллаха Могущественного, Достохвального,",["и не","мстили они","им","кроме","за то, что","уверовали они","в Аллаха","Могущественного","Достохвального"]],[85,9,["ٱلَّذِي","لَهُۥ","مُلۡكُ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِۚ","وَٱللَّهُ","عَلَىٰ","كُلِّ","شَيۡءٖ","شَهِيدٌ"],"аллазии лахуу мулку ссамаауаати уал'арди уаллаху `алаа кулли шай'ин шахиид","Которому принадлежит власть над небесами и землей. Аллах же - Свидетель всякой вещи!",["Тот, Который","Ему","власть","небес","и земли","и Аллах","над","всякой","вещью","Свидетель"]],[85,10,["إِنَّ","ٱلَّذِينَ","فَتَنُواْ","ٱلۡمُؤۡمِنِينَ","وَٱلۡمُؤۡمِنَٰتِ","ثُمَّ","لَمۡ","يَتُوبُواْ","فَلَهُمۡ","عَذَابُ","جَهَنَّمَ","وَلَهُمۡ","عَذَابُ","ٱلۡحَرِيقِ"],"инна ллазиина фатануу лму'миниина уалму'минаати сумма лам йатуубуу фалахум `азаабу джаханнама уалахум `азаабу лхариик","Тем, которые подвергли искушению (или сожгли в огне) верующих мужчин и женщин и не раскаялись, уготованы мучения в Геенне, мучения от обжигающего Огня.",["поистине","те, которые","искушали","верующих","и верующих женщин","затем","не","покаялись","то им","мучение","Геенны","и им","мучение","сожжения"]],[85,11,["إِنَّ","ٱلَّذِينَ","ءَامَنُواْ","وَعَمِلُواْ","ٱلصَّٰلِحَٰتِ","لَهُمۡ","جَنَّٰتٞ","تَجۡرِي","مِن","تَحۡتِهَا","ٱلۡأَنۡهَٰرُۚ","ذَٰلِكَ","ٱلۡفَوۡزُ","ٱلۡكَبِيرُ"],"инна ллазиина аамануу уа`амилуу ссаалихаати лахум джаннаатун таджрии мин тахтихаа л'анхаару заалика лфаузу лкабиир","Тем же, которые уверовали и совершали праведные деяния, уготованы Райские сады, в которых текут реки. Это - великое преуспеяние!",["поистине","те, которые","уверовали","и совершали","праведные дела","им","Сады","текут","из","под ними","реки","это","успех","великий"]],[85,12,["إِنَّ","بَطۡشَ","رَبِّكَ","لَشَدِيدٌ"],"инна батша раббика лашадиид","Воистину, Хватка твоего Господа сурова!",["поистине","хватка","Господа твоего","непременно сильна"]],[85,13,["إِنَّهُۥ","هُوَ","يُبۡدِئُ","وَيُعِيدُ"],"иннахуу хууа йубди'у уайу`иид","Воистину, Он начинает и повторяет (создает творение в первый раз и воссоздает его или начинает наказывать в этом мире и возобновляет наказание в Последней жизни).",["поистине, Он","Он","начинает","и повторяет"]],[85,14,["وَهُوَ","ٱلۡغَفُورُ","ٱلۡوَدُودُ"],"уахууа лгафууру луадууд","Он - Прощающий, Любящий (или Любимый),",["и Он","Прощающий","Любящий"]],[85,15,["ذُو","ٱلۡعَرۡشِ","ٱلۡمَجِيدُ"],"зуу л`арши лмаджиид","Владыка Трона, Славный (или Владыка Трона славного).",["Обладатель","Трона","Славный"]],[85,16,["فَعَّالٞ","لِّمَا","يُرِيدُ"],"фа``аалул лимаа йуриид","Он вершит то, что пожелает.",["Вершащий","то, что","Он желает"]],[85,17,["هَلۡ","أَتَىٰكَ","حَدِيثُ","ٱلۡجُنُودِ"],"хал атаака хадиису лджунууд","Дошел ли до тебя рассказ о воинствах,",["разве","пришёл к тебе","рассказ","о войсках"]],[85,18,["فِرۡعَوۡنَ","وَثَمُودَ"],"фир`ауна уасамууд","о Фараоне и самудянах?",["Фараона","и самудян"]],[85,19,["بَلِ","ٱلَّذِينَ","كَفَرُواْ","فِي","تَكۡذِيبٖ"],"бали ллазиина кафаруу фии такзииб","Но неверующие считают это ложью,",["но","те, которые","не уверовали","в","отвержении"]],[85,20,["وَٱللَّهُ","مِن","وَرَآئِهِم","مُّحِيطُۢ"],"уаллаху мин уараа'ихим ммухиит","Аллах же окружает их сзади.",["а Аллах","из","позади них","объемлющий"]],[85,21,["بَلۡ","هُوَ","قُرۡءَانٞ","مَّجِيدٞ"],"бал хууа кур'аанум маджиид","Да, это - славный Коран",["напротив","это","Коран","славный"]],[85,22,["فِي","لَوۡحٖ","مَّحۡفُوظِۭ"],"фии лаухим махфууз","в Хранимой скрижали.",["на","Скрижали","хранимой"]]]}