{"p":591,"j":30,"a":[[86,1,["وَٱلسَّمَآءِ","وَٱلطَّارِقِ"],"уассамаа'и уаттаарик","Клянусь небом и ночным путником!",["клянусь небом","и идущим ночью"]],[86,2,["وَمَآ","أَدۡرَىٰكَ","مَا","ٱلطَّارِقُ"],"уамаа адраака маа ттаарик","Откуда ты мог знать, что такое ночной путник?",["и что","дало тебе знать","что","идущий ночью"]],[86,3,["ٱلنَّجۡمُ","ٱلثَّاقِبُ"],"аннаджму ссаакиб","Это - звезда пронизывающая небеса своим светом.",["звезда","пронзающая"]],[86,4,["إِن","كُلُّ","نَفۡسٖ","لَّمَّا","عَلَيۡهَا","حَافِظٞ"],"ин куллу нафсил ламмаа `алайхаа хаафиз","Нет души, при которой не было бы хранителя.",["нет","всякой","души","без того, чтобы","над ней","хранитель"]],[86,5,["فَلۡيَنظُرِ","ٱلۡإِنسَٰنُ","مِمَّ","خُلِقَ"],"фалйанзури л'инсаану мимма хулик","Пусть посмотрит человек, из чего он создан.",["пусть же посмотрит","человек","из чего","создан он"]],[86,6,["خُلِقَ","مِن","مَّآءٖ","دَافِقٖ"],"хулика мим маа'ин даафик","Он создан из изливающейся жидкости,",["создан он","из","воды","изливающейся"]],[86,7,["يَخۡرُجُ","مِنۢ","بَيۡنِ","ٱلصُّلۡبِ","وَٱلتَّرَآئِبِ"],"йахруджу мим байни ссулби уаттараа'иб","которая выходит между чреслами и грудными костями.",["выходит","из","между","хребтом","и рёбрами"]],[86,8,["إِنَّهُۥ","عَلَىٰ","رَجۡعِهِۦ","لَقَادِرٞ"],"иннахуу `алаа радж`ихии лакаадир","Воистину, Он способен вернуть его.",["поистине, Он","на","возвращение его","непременно способен"]],[86,9,["يَوۡمَ","تُبۡلَى","ٱلسَّرَآئِرُ"],"йаума тублаа ссараа'ир","В тот день будут испытаны (или раскроются) тайны,",["в день, когда","испытаны будут","тайны"]],[86,10,["فَمَا","لَهُۥ","مِن","قُوَّةٖ","وَلَا","نَاصِرٖ"],"фамаа лахуу мин куууатин уалаа наасир","и тогда не будет у него ни силы, ни помощника.",["и не","у него","никакой","силы","и не","помощника"]],[86,11,["وَٱلسَّمَآءِ","ذَاتِ","ٱلرَّجۡعِ"],"уассамаа'и заати ррадж`","Клянусь небом возвращающим (возвращающим воду земле или возвращающим небесные тела, которые восходят с одной стороны и заходят в другой)!",["клянусь небом","обладающим","возвращением"]],[86,12,["وَٱلۡأَرۡضِ","ذَاتِ","ٱلصَّدۡعِ"],"уал'арди заати ссад`","Клянусь землей раскалываемой (при прорастании растений, или при выходе из земли воды, или при воскрешении мертвых)!",["и землёй","обладающей","раскалыванием"]],[86,13,["إِنَّهُۥ","لَقَوۡلٞ","فَصۡلٞ"],"иннахуу лакаулун фасл","Воистину, это - Слово различающее,",["поистине, это","непременно слово","различающее"]],[86,14,["وَمَا","هُوَ","بِٱلۡهَزۡلِ"],"уамаа хууа билхазл","а не шутка.",["и не","это","шутка"]],[86,15,["إِنَّهُمۡ","يَكِيدُونَ","كَيۡدٗا"],"иннахум йакиидууна кайда","Они замышляют козни,",["поистине, они","хитрят","хитростью"]],[86,16,["وَأَكِيدُ","كَيۡدٗا"],"уа'акииду кайда","и Я замышляю козни.",["и Я хитрю","хитростью"]],[86,17,["فَمَهِّلِ","ٱلۡكَٰفِرِينَ","أَمۡهِلۡهُمۡ","رُوَيۡدَۢا"],"фамаххили лкаафириина амхилхум рууайда","Предоставь же неверующим отсрочку, помедли с ними недолго!",["так дай отсрочку","неверным","дай отсрочку им","немного"]],[87,1,["سَبِّحِ","ٱسۡمَ","رَبِّكَ","ٱلۡأَعۡلَى"],"саббихи сма раббика л'а`ла","Славь имя Господа твоего Всевышнего,",["славь","имя","Господа твоего","Всевышнего"]],[87,2,["ٱلَّذِي","خَلَقَ","فَسَوَّىٰ"],"аллазии халака фасаууаа","Который сотворил все сущее и всему придал соразмерность,",["Который","создал","и соразмерил"]],[87,3,["وَٱلَّذِي","قَدَّرَ","فَهَدَىٰ"],"уаллазии каддара фахадаа","Который предопределил судьбу творений и указал путь,",["и Который","предопределил","и направил"]],[87,4,["وَٱلَّذِيٓ","أَخۡرَجَ","ٱلۡمَرۡعَىٰ"],"уаллазии ахраджа лмар`аа","Который взрастил пастбища,",["и Который","вывел","пастбище"]],[87,5,["فَجَعَلَهُۥ","غُثَآءً","أَحۡوَىٰ"],"фаджа`алахуу гусаа'ан ахуаа","а потом превратил их в темный сор.",["и сделал его","сором","тёмным"]],[87,6,["سَنُقۡرِئُكَ","فَلَا","تَنسَىٰٓ"],"санукри'ука фалаа тансаа","Мы позволим тебе прочесть Коран, и ты не забудешь ничего,",["Мы дадим тебе прочесть","и не","забудешь"]],[87,7,["إِلَّا","مَا","شَآءَ","ٱللَّهُۚ","إِنَّهُۥ","يَعۡلَمُ","ٱلۡجَهۡرَ","وَمَا","يَخۡفَىٰ"],"иллаа маа шаа'а ллаху иннахуу йа`ламу лджахра уамаа йахфаа","кроме того, что пожелает Аллах. Он знает явное и то, что сокрыто.",["кроме","того, что","пожелал","Аллах","поистине, Он","знает","явное","и то, что","скрыто"]],[87,8,["وَنُيَسِّرُكَ","لِلۡيُسۡرَىٰ"],"уануйассирука лилйусраа","Мы облегчим тебе путь к легчайшему.",["и Мы облегчим тебе","к лёгкому"]],[87,9,["فَذَكِّرۡ","إِن","نَّفَعَتِ","ٱلذِّكۡرَىٰ"],"фазаккир ин нафа`ати ззикраа","Наставляй же людей, если напоминание принесет пользу.",["так напоминай","если","приносит пользу","напоминание"]],[87,10,["سَيَذَّكَّرُ","مَن","يَخۡشَىٰ"],"сайаззаккару ман йахшаа","Воспримет его тот, кто страшится,",["примет назидание","тот, кто","боится"]],[87,11,["وَيَتَجَنَّبُهَا","ٱلۡأَشۡقَى"],"уайатаджаннабухаа л'ашка","и уклонится от него самый несчастный,",["и сторонится его","несчастнейший"]],[87,12,["ٱلَّذِي","يَصۡلَى","ٱلنَّارَ","ٱلۡكُبۡرَىٰ"],"аллазии йаслаа ннаара лкубраа","который войдет в Огонь величайший.",["который","будет гореть","в огне","великом"]],[87,13,["ثُمَّ","لَا","يَمُوتُ","فِيهَا","وَلَا","يَحۡيَىٰ"],"сумма лаа йамууту фиихаа уалаа йахйаа","Не умрет он там и не будет жить.",["затем","не","умрёт он","в нём","и не","будет жить"]],[87,14,["قَدۡ","أَفۡلَحَ","مَن","تَزَكَّىٰ"],"кад афлаха ман тазаккаа","Преуспел тот, кто очистился,",["уже","преуспел","тот, кто","очистился"]],[87,15,["وَذَكَرَ","ٱسۡمَ","رَبِّهِۦ","فَصَلَّىٰ"],"уазакара сма раббихии фасаллаа","поминал имя своего Господа и совершал намаз.",["и поминал","имя","Господа своего","и молился"]]]}