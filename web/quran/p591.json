{"p":591,"j":30,"a":[[86,1,["وَٱلسَّمَآءِ","وَٱلطَّارِقِ"],"вассамаи ваттариḳ","Клянусь небом и ночным путником!",["клянусь небом","и идущим ночью"]],[86,2,["وَمَآ","أَدۡرَىٰكَ","مَا","ٱلطَّارِقُ"],"вама адрака мат тариḳ","Откуда ты мог знать, что такое ночной путник?",["и что","дало тебе знать","что","идущий ночью"]],[86,3,["ٱلنَّجۡمُ","ٱلثَّاقِبُ"],"аннажмус саḳиб","Это - звезда пронизывающая небеса своим светом.",["звезда","пронзающая"]],[86,4,["إِن","كُلُّ","نَفۡسٖ","لَّمَّا","عَلَيۡهَا","حَافِظٞ"],"ин куллу нафсил ламма `алайха хафиз","Нет души, при которой не было бы хранителя.",["нет","всякой","души","без того, чтобы","над ней","хранитель"]],[86,5,["فَلۡيَنظُرِ","ٱلۡإِنسَٰنُ","مِمَّ","خُلِقَ"],"фалйанзурил инсану мимма хулиḳ","Пусть посмотрит человек, из чего он создан.",["пусть же посмотрит","человек","из чего","создан он"]],[86,6,["خُلِقَ","مِن","مَّآءٖ","دَافِقٖ"],"хулиḳа мим маин дафиḳ","Он создан из изливающейся жидкости,",["создан он","из","воды","изливающейся"]],[86,7,["يَخۡرُجُ","مِنۢ","بَيۡنِ","ٱلصُّلۡبِ","وَٱلتَّرَآئِبِ"],"йахружу мим байнис сулби ваттараиб","которая выходит между чреслами и грудными костями.",["выходит","из","между","хребтом","и рёбрами"]],[86,8,["إِنَّهُۥ","عَلَىٰ","رَجۡعِهِۦ","لَقَادِرٞ"],"иннахуу `ала раж`ихии лаḳадир","Воистину, Он способен вернуть его.",["поистине, Он","на","возвращение его","непременно способен"]],[86,9,["يَوۡمَ","تُبۡلَى","ٱلسَّرَآئِرُ"],"йаума тублас сараир","В тот день будут испытаны (или раскроются) тайны,",["в день, когда","испытаны будут","тайны"]],[86,10,["فَمَا","لَهُۥ","مِن","قُوَّةٖ","وَلَا","نَاصِرٖ"],"фама лахуу мин ḳувватин вала насир","и тогда не будет у него ни силы, ни помощника.",["и не","у него","никакой","силы","и не","помощника"]],[86,11,["وَٱلسَّمَآءِ","ذَاتِ","ٱلرَّجۡعِ"],"вассамаи затир раж`","Клянусь небом возвращающим (возвращающим воду земле или возвращающим небесные тела, которые восходят с одной стороны и заходят в другой)!",["клянусь небом","обладающим","возвращением"]],[86,12,["وَٱلۡأَرۡضِ","ذَاتِ","ٱلصَّدۡعِ"],"вал'арди затис сад`","Клянусь землей раскалываемой (при прорастании растений, или при выходе из земли воды, или при воскрешении мертвых)!",["и землёй","обладающей","раскалыванием"]],[86,13,["إِنَّهُۥ","لَقَوۡلٞ","فَصۡلٞ"],"иннахуу лаḳаулун фасл","Воистину, это - Слово различающее,",["поистине, это","непременно слово","различающее"]],[86,14,["وَمَا","هُوَ","بِٱلۡهَزۡلِ"],"вама хуа билхазл","а не шутка.",["и не","это","шутка"]],[86,15,["إِنَّهُمۡ","يَكِيدُونَ","كَيۡدٗا"],"иннахум йакиидууна кайда","Они замышляют козни,",["поистине, они","хитрят","хитростью"]],[86,16,["وَأَكِيدُ","كَيۡدٗا"],"ва'акииду кайда","и Я замышляю козни.",["и Я хитрю","хитростью"]],[86,17,["فَمَهِّلِ","ٱلۡكَٰفِرِينَ","أَمۡهِلۡهُمۡ","رُوَيۡدَۢا"],"фамаххилил кафириина амхилхум руайда","Предоставь же неверующим отсрочку, помедли с ними недолго!",["так дай отсрочку","неверным","дай отсрочку им","немного"]],[87,1,["سَبِّحِ","ٱسۡمَ","رَبِّكَ","ٱلۡأَعۡلَى"],"саббихисма раббикал а`ла","Славь имя Господа твоего Всевышнего,",["славь","имя","Господа твоего","Всевышнего"]],[87,2,["ٱلَّذِي","خَلَقَ","فَسَوَّىٰ"],"аллазии халаḳа фасавва","Который сотворил все сущее и всему придал соразмерность,",["Который","создал","и соразмерил"]],[87,3,["وَٱلَّذِي","قَدَّرَ","فَهَدَىٰ"],"валлазии ḳаддара фахада","Который предопределил судьбу творений и указал путь,",["и Который","предопределил","и направил"]],[87,4,["وَٱلَّذِيٓ","أَخۡرَجَ","ٱلۡمَرۡعَىٰ"],"валлазии ахражал мар`а","Который взрастил пастбища,",["и Который","вывел","пастбище"]],[87,5,["فَجَعَلَهُۥ","غُثَآءً","أَحۡوَىٰ"],"фажа`алахуу гусаан ахва","а потом превратил их в темный сор.",["и сделал его","сором","тёмным"]],[87,6,["سَنُقۡرِئُكَ","فَلَا","تَنسَىٰٓ"],"сануḳриука фала танса","Мы позволим тебе прочесть Коран, и ты не забудешь ничего,",["Мы дадим тебе прочесть","и не","забудешь"]],[87,7,["إِلَّا","مَا","شَآءَ","ٱللَّهُۚ","إِنَّهُۥ","يَعۡلَمُ","ٱلۡجَهۡرَ","وَمَا","يَخۡفَىٰ"],"илла ма шааллаху иннахуу йа`ламул жахра вама йахфа","кроме того, что пожелает Аллах. Он знает явное и то, что сокрыто.",["кроме","того, что","пожелал","Аллах","поистине, Он","знает","явное","и то, что","скрыто"]],[87,8,["وَنُيَسِّرُكَ","لِلۡيُسۡرَىٰ"],"вануйассирука лилйусра","Мы облегчим тебе путь к легчайшему.",["и Мы облегчим тебе","к лёгкому"]],[87,9,["فَذَكِّرۡ","إِن","نَّفَعَتِ","ٱلذِّكۡرَىٰ"],"фазаккир ин нафа`атиз зикра","Наставляй же людей, если напоминание принесет пользу.",["так напоминай","если","приносит пользу","напоминание"]],[87,10,["سَيَذَّكَّرُ","مَن","يَخۡشَىٰ"],"сайаззаккару ман йахша","Воспримет его тот, кто страшится,",["примет назидание","тот, кто","боится"]],[87,11,["وَيَتَجَنَّبُهَا","ٱلۡأَشۡقَى"],"вайатажаннабухал ашḳа","и уклонится от него самый несчастный,",["и сторонится его","несчастнейший"]],[87,12,["ٱلَّذِي","يَصۡلَى","ٱلنَّارَ","ٱلۡكُبۡرَىٰ"],"аллазии йаслан нарал кубра","который войдет в Огонь величайший.",["который","будет гореть","в огне","великом"]],[87,13,["ثُمَّ","لَا","يَمُوتُ","فِيهَا","وَلَا","يَحۡيَىٰ"],"сумма ла йамууту фииха вала йахйа","Не умрет он там и не будет жить.",["затем","не","умрёт он","в нём","и не","будет жить"]],[87,14,["قَدۡ","أَفۡلَحَ","مَن","تَزَكَّىٰ"],"ḳад афлаха ман тазакка","Преуспел тот, кто очистился,",["уже","преуспел","тот, кто","очистился"]],[87,15,["وَذَكَرَ","ٱسۡمَ","رَبِّهِۦ","فَصَلَّىٰ"],"вазакарасма раббихии фасалла","поминал имя своего Господа и совершал намаз.",["и поминал","имя","Господа своего","и молился"]]]}