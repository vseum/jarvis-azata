{"p":592,"j":30,"a":[[87,16,["بَلۡ","تُؤۡثِرُونَ","ٱلۡحَيَوٰةَ","ٱلدُّنۡيَا"],"бал ту'сируунал хайаватад дунйа","Но нет! Вы отдаете предпочтение мирской жизни,",["напротив","предпочитаете вы","жизнь","мирскую"]],[87,17,["وَٱلۡأٓخِرَةُ","خَيۡرٞ","وَأَبۡقَىٰٓ"],"вал'ахирату хайрун ва'абḳа","хотя Последняя жизнь - лучше и дольше.",["а Последняя жизнь","лучше","и долговечнее"]],[87,18,["إِنَّ","هَٰذَا","لَفِي","ٱلصُّحُفِ","ٱلۡأُولَىٰ"],"инна хаза лафис сухуфил уула","Воистину, это записано в первых свитках -",["поистине","это","непременно в","свитках","первых"]],[87,19,["صُحُفِ","إِبۡرَٰهِيمَ","وَمُوسَىٰ"],"сухуфи ибрахиима вамууса","свитках Ибрахима (Авраама) и Мусы (Моисея).",["свитках","Ибрахима","и Мусы"]],[88,1,["هَلۡ","أَتَىٰكَ","حَدِيثُ","ٱلۡغَٰشِيَةِ"],"хал атака хадиисул гашийах","Дошел ли до тебя рассказ о Покрывающем (Дне воскресения)?",["разве","пришёл к тебе","рассказ","о Покрывающем"]],[88,2,["وُجُوهٞ","يَوۡمَئِذٍ","خَٰشِعَةٌ"],"вужуухун йаумаизин хаши`ах","Одни лица в тот день будут унижены,",["лица","в тот день","смиренные"]],[88,3,["عَامِلَةٞ","نَّاصِبَةٞ"],"`амилатун насибах","изнурены и утомлены.",["трудящиеся","изнурённые"]],[88,4,["تَصۡلَىٰ","نَارًا","حَامِيَةٗ"],"тасла наран хамийаха","Они войдут в Огонь жаркий.",["будут гореть","в огне","раскалённом"]],[88,5,["تُسۡقَىٰ","مِنۡ","عَيۡنٍ","ءَانِيَةٖ"],"тусḳа мин `айнин анийах","Их будут поить из источника кипящего",["будут поить их","из","источника","кипящего"]],[88,6,["لَّيۡسَ","لَهُمۡ","طَعَامٌ","إِلَّا","مِن","ضَرِيعٖ"],"ллайса лахум та`амун илла мин дарии`","и кормить только ядовитыми колючками,",["нет","у них","пищи","кроме","из","колючки"]],[88,7,["لَّا","يُسۡمِنُ","وَلَا","يُغۡنِي","مِن","جُوعٖ"],"лла йусмину вала йугнии мин жуу`","от которых не поправляются и которые не утоляют голода.",["не","насыщает","и не","избавляет","от","голода"]],[88,8,["وُجُوهٞ","يَوۡمَئِذٖ","نَّاعِمَةٞ"],"вужуухун йаумаизин на`имах","Другие же лица в тот день будут радостны.",["лица","в тот день","блаженствующие"]],[88,9,["لِّسَعۡيِهَا","رَاضِيَةٞ"],"ллиса`йиха радийах","Они будут довольны своими стараниями",["своим стремлением","довольные"]],[88,10,["فِي","جَنَّةٍ","عَالِيَةٖ"],"фии жаннатин `алийах","в Вышних садах.",["в","саду","высоком"]],[88,11,["لَّا","تَسۡمَعُ","فِيهَا","لَٰغِيَةٗ"],"лла тасма`у фииха лагийаха","Они не услышат там словоблудия.",["не","услышишь","в нём","пустословия"]],[88,12,["فِيهَا","عَيۡنٞ","جَارِيَةٞ"],"фииха `айнун жарийах","Там есть источник текущий.",["в нём","источник","текущий"]],[88,13,["فِيهَا","سُرُرٞ","مَّرۡفُوعَةٞ"],"фииха сурурум марфуу`ах","Там воздвигнуты ложа,",["в нём","ложа","возвышенные"]],[88,14,["وَأَكۡوَابٞ","مَّوۡضُوعَةٞ"],"ва'аквабум маудуу`ах","расставлены чаши,",["и кубки","расставленные"]],[88,15,["وَنَمَارِقُ","مَصۡفُوفَةٞ"],"ванамариḳу масфууфах","разложены подушки,",["и подушки","разложенные рядами"]],[88,16,["وَزَرَابِيُّ","مَبۡثُوثَةٌ"],"вазарабиййу мабсуусах","и разостланы ковры.",["и ковры","расстеленные"]],[88,17,["أَفَلَا","يَنظُرُونَ","إِلَى","ٱلۡإِبِلِ","كَيۡفَ","خُلِقَتۡ"],"афала йанзурууна илал ибили кайфа хулиḳат","Неужели они не видят, как созданы верблюды,",["разве же не","смотрят","на","верблюдов","как","они созданы"]],[88,18,["وَإِلَى","ٱلسَّمَآءِ","كَيۡفَ","رُفِعَتۡ"],"ва'илас самаи кайфа руфи`ат","как вознесено небо,",["и на","небо","как","возвышено оно"]],[88,19,["وَإِلَى","ٱلۡجِبَالِ","كَيۡفَ","نُصِبَتۡ"],"ва'илал жибали кайфа нусибат","как водружены горы,",["и на","горы","как","воздвигнуты они"]],[88,20,["وَإِلَى","ٱلۡأَرۡضِ","كَيۡفَ","سُطِحَتۡ"],"ва'илал арди кайфа сутихат","как распростерта земля?",["и на","землю","как","распростёрта она"]],[88,21,["فَذَكِّرۡ","إِنَّمَآ","أَنتَ","مُذَكِّرٞ"],"фазаккир иннама анта музаккир","Наставляй же, ведь ты - наставник,",["так напоминай","лишь","ты","напоминающий"]],[88,22,["لَّسۡتَ","عَلَيۡهِم","بِمُصَيۡطِرٍ"],"лласта `алайхим бимусайтир","и ты не властен над ними.",["ты не","над ними","надзирающий"]],[88,23,["إِلَّا","مَن","تَوَلَّىٰ","وَكَفَرَ"],"илла ман т