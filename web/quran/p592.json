{"p":592,"j":30,"a":[[87,16,["بَلۡ","تُؤۡثِرُونَ","ٱلۡحَيَوٰةَ","ٱلدُّنۡيَا"],"бал ту'сирууна лхайауаата ддунйа","Но нет! Вы отдаете предпочтение мирской жизни,",["напротив","предпочитаете вы","жизнь","мирскую"]],[87,17,["وَٱلۡأٓخِرَةُ","خَيۡرٞ","وَأَبۡقَىٰٓ"],"уал'хирату хайрун уа'абкаа","хотя Последняя жизнь - лучше и дольше.",["а Последняя жизнь","лучше","и долговечнее"]],[87,18,["إِنَّ","هَٰذَا","لَفِي","ٱلصُّحُفِ","ٱلۡأُولَىٰ"],"инна хаазаа лафии ссухуфи л'уулаа","Воистину, это записано в первых свитках -",["поистине","это","непременно в","свитках","первых"]],[87,19,["صُحُفِ","إِبۡرَٰهِيمَ","وَمُوسَىٰ"],"сухуфи ибраахиима уамуусаа","свитках Ибрахима (Авраама) и Мусы (Моисея).",["свитках","Ибрахима","и Мусы"]],[88,1,["هَلۡ","أَتَىٰكَ","حَدِيثُ","ٱلۡغَٰشِيَةِ"],"хал атаака хадиису лгаашийах","Дошел ли до тебя рассказ о Покрывающем (Дне воскресения)?",["разве","пришёл к тебе","рассказ","о Покрывающем"]],[88,2,["وُجُوهٞ","يَوۡمَئِذٍ","خَٰشِعَةٌ"],"ууджуухун йаума'изин хааши`ах","Одни лица в тот день будут унижены,",["лица","в тот день","смиренные"]],[88,3,["عَامِلَةٞ","نَّاصِبَةٞ"],"`аамилатун наасибах","изнурены и утомлены.",["трудящиеся","изнурённые"]],[88,4,["تَصۡلَىٰ","نَارًا","حَامِيَةٗ"],"таслаа нааран хаамийаха","Они войдут в Огонь жаркий.",["будут гореть","в огне","раскалённом"]],[88,5,["تُسۡقَىٰ","مِنۡ","عَيۡنٍ","ءَانِيَةٖ"],"тускаа мин `айнин аанийах","Их будут поить из источника кипящего",["будут поить их","из","источника","кипящего"]],[88,6,["لَّيۡسَ","لَهُمۡ","طَعَامٌ","إِلَّا","مِن","ضَرِيعٖ"],"ллайса лахум та`аамун иллаа мин дарии`","и кормить только ядовитыми колючками,",["нет","у них","пищи","кроме","из","колючки"]],[88,7,["لَّا","يُسۡمِنُ","وَلَا","يُغۡنِي","مِن","جُوعٖ"],"ллаа йусмину уалаа йугнии мин джуу`","от которых не поправляются и которые не утоляют голода.",["не","насыщает","и не","избавляет","от","голода"]],[88,8,["وُجُوهٞ","يَوۡمَئِذٖ","نَّاعِمَةٞ"],"ууджуухун йаума'изин наа`имах","Другие же лица в тот день будут радостны.",["лица","в тот день","блаженствующие"]],[88,9,["لِّسَعۡيِهَا","رَاضِيَةٞ"],"ллиса`йихаа раадийах","Они будут довольны своими стараниями",["своим стремлением","довольные"]],[88,10,["فِي","جَنَّةٍ","عَالِيَةٖ"],"фии джаннатин `аалийах","в Вышних садах.",["в","саду","высоком"]],[88,11,["لَّا","تَسۡمَعُ","فِيهَا","لَٰغِيَةٗ"],"ллаа тасма`у фиихаа лаагийаха","Они не услышат там словоблудия.",["не","услышишь","в нём","пустословия"]],[88,12,["فِيهَا","عَيۡنٞ","جَارِيَةٞ"],"фиихаа `айнун джаарийах","Там есть источник текущий.",["в нём","источник","текущий"]],[88,13,["فِيهَا","سُرُرٞ","مَّرۡفُوعَةٞ"],"фиихаа сурурум марфуу`ах","Там воздвигнуты ложа,",["в нём","ложа","возвышенные"]],[88,14,["وَأَكۡوَابٞ","مَّوۡضُوعَةٞ"],"уа'акуаабум маудуу`ах","расставлены чаши,",["и кубки","расставленные"]],[88,15,["وَنَمَارِقُ","مَصۡفُوفَةٞ"],"уанамаарику масфууфах","разложены подушки,",["и подушки","разложенные рядами"]],[88,16,["وَزَرَابِيُّ","مَبۡثُوثَةٌ"],"уазараабиййу мабсуусах","и разостланы ковры.",["и ковры","расстеленные"]],[88,17,["أَفَلَا","يَنظُرُونَ","إِلَى","ٱلۡإِبِلِ","كَيۡفَ","خُلِقَتۡ"],"афалаа йанзурууна илаа л'ибили кайфа хуликат","Неужели они не видят, как созданы верблюды,",["разве же не","смотрят","на","верблюдов","как","они созданы"]],[88,18,["وَإِلَى","ٱلسَّمَآءِ","كَيۡفَ","رُفِعَتۡ"],"уа'илаа ссамаа'и кайфа руфи`ат","как вознесено небо,",["и на","небо","как","возвышено оно"]],[88,19,["وَإِلَى","ٱلۡجِبَالِ","كَيۡفَ","نُصِبَتۡ"],"уа'илаа лджибаали кайфа нусибат","как водружены горы,",["и на","горы","как","воздвигнуты они"]],[88,20,["وَإِلَى","ٱلۡأَرۡضِ","كَيۡفَ","سُطِحَتۡ"],"уа'илаа л'арди кайфа сутихат","как распростерта земля?",["и на","землю","как","распростёрта она"]],[88,21,["فَذَكِّرۡ","إِنَّمَآ","أَنتَ","مُذَكِّرٞ"],"фазаккир иннамаа анта музаккир","Наставляй же, ведь ты - наставник,",["так напоминай","лишь","ты","напоминающий"]],[88,22,["لَّسۡتَ","عَلَيۡهِم","بِمُصَيۡطِرٍ"],"лласта `алайхим бимусайтир","и ты не властен над ними.",["ты не","над ними","надзирающий"]],[88,23,["إِلَّا","مَن","تَوَلَّىٰ","وَكَفَرَ"],"иллаа ман тауаллаа уакафар","А тех, кто отвернется и не уверует,",["но","тот, кто","отвернулся","и не уверовал"]],[88,24,["فَيُعَذِّبُهُ","ٱللَّهُ","ٱلۡعَذَابَ","ٱلۡأَكۡبَرَ"],"файу`аззибуху ллаху л`азааба л'акбар","Аллах подвергнет величайшим мучениям.",["и накажет его","Аллах","наказанием","величайшим"]],[88,25,["إِنَّ","إِلَيۡنَآ","إِيَابَهُمۡ"],"инна илайнаа ийаабахум","К Нам они вернутся,",["поистине","к Нам","возвращение их"]],[88,26,["ثُمَّ","إِنَّ","عَلَيۡنَا","حِسَابَهُم"],"сумма инна `алайнаа хисаабахум","и затем Мы потребуем у них отчета.",["затем","поистине","на Нас","расчёт с ними"]]]}