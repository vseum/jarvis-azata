{"p":593,"j":30,"a":[[89,1,["وَٱلۡفَجۡرِ"],"валфажр","Клянусь зарею!",["клянусь зарёй"]],[89,2,["وَلَيَالٍ","عَشۡرٖ"],"валайалин `ашр","Клянусь десятью ночами!",["и ночами","десятью"]],[89,3,["وَٱلشَّفۡعِ","وَٱلۡوَتۡرِ"],"вашшаф`и валватр","Клянусь четом и нечетом!",["и чётным","и нечётным"]],[89,4,["وَٱلَّيۡلِ","إِذَا","يَسۡرِ"],"валлайли иза йаср","Клянусь ночью, когда она проходит!",["и ночью","когда","уходит она"]],[89,5,["هَلۡ","فِي","ذَٰلِكَ","قَسَمٞ","لِّذِي","حِجۡرٍ"],"хал фии залика ḳасамул лизии хижр","Неужели этих клятв не достаточно для обладающего разумом?",["разве","в","этом","клятва","для обладающего","разумом"]],[89,6,["أَلَمۡ","تَرَ","كَيۡفَ","فَعَلَ","رَبُّكَ","بِعَادٍ"],"алам тара кайфа фа`ала раббука би`ад","Неужели ты не видел, как Господь твой поступил с адитами -",["разве не","видел ты","как","поступил","Господь твой","с адитами"]],[89,7,["إِرَمَ","ذَاتِ","ٱلۡعِمَادِ"],"ирама затил `имад","народом Ирама, обладавшим колоннами (воздвигавшим высокие здания с колоннами или обладавшим могучим сложением и огромной силой),",["Ирама","обладателей","колонн"]],[89,8,["ٱلَّتِي","لَمۡ","يُخۡلَقۡ","مِثۡلُهَا","فِي","ٱلۡبِلَٰدِ"],"аллатии лам йухлаḳ мислуха фил билад","подобных которому не было сотворено в городах?",["которого","не","был создан","подобный ему","в","странах"]],[89,9,["وَثَمُودَ","ٱلَّذِينَ","جَابُواْ","ٱلصَّخۡرَ","بِٱلۡوَادِ"],"васамуудал лазиина жабус сахра билвад","С самудянами, рассекавшими скалы в лощине?",["и самудянами","которые","высекали","скалы","в долине"]],[89,10,["وَفِرۡعَوۡنَ","ذِي","ٱلۡأَوۡتَادِ"],"вафир`ауна зил аутад","С Фараоном, владевшим кольями (обладавшим множеством воинов, которые поддерживали его власть, подобно тому, как колышки поддерживают шатер, или привязывавшим людей к кольям во время казни)?",["и Фараоном","обладателем","кольев"]],[89,11,["ٱلَّذِينَ","طَغَوۡاْ","فِي","ٱلۡبِلَٰدِ"],"аллазиина тагау фил билад","Они преступали границы дозволенного на земле",["которые","преступили","в","странах"]],[89,12,["فَأَكۡثَرُواْ","فِيهَا","ٱلۡفَسَادَ"],"фа'аксаруу фиихал фасад","и распространяли в них много нечестия.",["и умножили","в них","нечестие"]],[89,13,["فَصَبَّ","عَلَيۡهِمۡ","رَبُّكَ","سَوۡطَ","عَذَابٍ"],"фасабба `алайхим раббука саута `азаб","Тогда твой Господь пролил на них бич мучений.",["и излил","на них","Господь твой","бич","мучения"]],[89,14,["إِنَّ","رَبَّكَ","لَبِٱلۡمِرۡصَادِ"],"инна раббака лабилмирсад","Воистину, твой Господь - в засаде (предоставляет отсрочку грешникам, чтобы затем неожиданно наказать их за ослушание).",["поистине","Господь твой","непременно в засаде"]],[89,15,["فَأَمَّا","ٱلۡإِنسَٰنُ","إِذَا","مَا","ٱبۡتَلَىٰهُ","رَبُّهُۥ","فَأَكۡرَمَهُۥ","وَنَعَّمَهُۥ","فَيَقُولُ","رَبِّيٓ","أَكۡرَمَنِ"],"фа'аммал инсану иза мабталаху раббухуу фа'акрамахуу вана``амахуу файаḳуулу раббии акраман","Когда Господь испытывает человека, оказывая ему милость и одаряя его благами, тот говорит: «Господь мой почтил меня!».",["что же до","человека","когда","лишь","испытывает его","Господь его","и почтит его","и облагодетельствует его","то говорит он","Господь мой","почтил меня"]],[89,16,["وَأَمَّآ","إِذَا","مَا","ٱبۡتَلَىٰهُ","فَقَدَرَ","عَلَيۡهِ","رِزۡقَهُۥ","فَيَقُولُ","رَبِّيٓ","أَهَٰنَنِ"],"ва'амма иза мабталаху фаḳадара `алайхи ризḳахуу файаḳуулу раббии аханан","Когда же Он испытывает его, ограничивая его в пропитании, тот говорит: «Господь мой унизил меня!».",["а","когда","лишь","испытывает его","и ограничивает","ему","удел его","то говорит он","Господь мой","унизил меня"]],[89,17,["كـَلَّاۖ","بَل","لَّا","تُكۡرِمُونَ","ٱلۡيَتِيمَ"],"калла бал ла тукримуунал йатиим","Но нет! Вы же сами не почитаете сироту,",["так нет же","напротив","не","почитаете вы","сироту"]],[89,18,["وَلَا","تَحَٰٓضُّونَ","عَلَىٰ","طَعَامِ","ٱلۡمِسۡكِينِ"],"вала тахаддууна `ала та`амил мискиин","не побуждаете друг друга кормить бедняка,",["и не","побуждаете друг друга","к","кормлению","бедняка"]],[89,19,["وَتَأۡكُلُونَ","ٱلتُّرَاثَ","أَكۡلٗا","لَّمّٗا"],"вата'кулуунат тураса аклал ламма","жадно (ил