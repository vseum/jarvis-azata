{"p":594,"j":30,"a":[[89,24,["يَقُولُ","يَٰلَيۡتَنِي","قَدَّمۡتُ","لِحَيَاتِي"],"йаḳуулу йалайтании ḳаддамту лихайатии","Он скажет: «Эх, если бы я заранее позаботился о своей жизни!».",["скажет он","о, если бы я","заранее приготовил","для жизни моей"]],[89,25,["فَيَوۡمَئِذٖ","لَّا","يُعَذِّبُ","عَذَابَهُۥٓ","أَحَدٞ"],"файаумаизил ла йу`аззибу `азабахуу ахад","В тот день никто не причинит таких мучений, как Он,",["и в тот день","не","накажет","наказанием Его","никто"]],[89,26,["وَلَا","يُوثِقُ","وَثَاقَهُۥٓ","أَحَدٞ"],"вала йуусиḳу васаḳахуу ахад","и никто не наложит таких оков, как Он.",["и не","свяжет","оковами Его","никто"]],[89,27,["يَٰٓأَيَّتُهَا","ٱلنَّفۡسُ","ٱلۡمُطۡمَئِنَّةُ"],"йа'аййатухан нафсул мутмаиннах","О обретшая покой душа!",["о","душа","успокоенная"]],[89,28,["ٱرۡجِعِيٓ","إِلَىٰ","رَبِّكِ","رَاضِيَةٗ","مَّرۡضِيَّةٗ"],"иржи`ии ила раббики радийатам мардиййаха","Вернись к своему Господу удовлетворенной и снискавшей довольство!",["вернись","к","Господу твоему","довольной","снискавшей довольство"]],[89,29,["فَٱدۡخُلِي","فِي","عِبَٰدِي"],"фадхулии фии `ибадии","Войди в круг Моих рабов!",["и войди","в число","рабов Моих"]],[89,30,["وَٱدۡخُلِي","جَنَّتِي"],"вадхулии жаннатии","Войди в Мой Рай!",["и войди","в Рай Мой"]],[90,1,["لَآ","أُقۡسِمُ","بِهَٰذَا","ٱلۡبَلَدِ"],"ла уḳсиму бихазал балад","Нет, клянусь этим городом (Меккой)!",["нет","клянусь","этим","городом"]],[90,2,["وَأَنتَ","حِلُّۢ","بِهَٰذَا","ٱلۡبَلَدِ"],"ва'анта хиллу бихазал балад","Ты обитаешь в этом городе (или Тебе будет дозволено сражаться в этом городе).",["и ты","свободно пребываешь","в этом","городе"]],[90,3,["وَوَالِدٖ","وَمَا","وَلَدَ"],"вавалидин вама валад","Клянусь родителем и тем, кого он породил (Адамом и его потомством, или Ибрахимом и его потомками, в том числе Исмаилом и Мухаммадом)!",["и (клянусь) родителем","и тем, что","он породил"]],[90,4,["لَقَدۡ","خَلَقۡنَا","ٱلۡإِنسَٰنَ","فِي","كَبَدٍ"],"лаḳад халаḳнал инсана фии кабад","Мы создали человека в тяготах.",["воистину уже","создали Мы","человека","в","тяготах"]],[90,5,["أَيَحۡسَبُ","أَن","لَّن","يَقۡدِرَ","عَلَيۡهِ","أَحَدٞ"],"айахсабу ал лан йаḳдира `алайхи ахад","Неужели он полагает, что никто не справится с ним?",["разве думает он","что","никогда не","одолеет","его","никто"]],[90,6,["يَقُولُ","أَهۡلَكۡتُ","مَالٗا","لُّبَدًا"],"йаḳуулу ахлакту малал лубада","Он говорит: «Я погубил богатство несметное!».",["говорит он","я истратил","богатство","огромное"]],[90,7,["أَيَحۡسَبُ","أَن","لَّمۡ","يَرَهُۥٓ","أَحَدٌ"],"айахсабу ал лам йарахуу ахад","Неужели он полагает, что никто не видел его?",["разве думает он","что","не","видел его","никто"]],[90,8,["أَلَمۡ","نَجۡعَل","لَّهُۥ","عَيۡنَيۡنِ"],"алам наж`ал лахуу `айнайн","Разве Мы не наделили его двумя глазами,",["разве не","сделали Мы","ему","два глаза"]],[90,9,["وَلِسَانٗا","وَشَفَتَيۡنِ"],"валисанан вашафатайн","языком и двумя устами?",["и язык","и две губы"]],[90,10,["وَهَدَيۡنَٰهُ","ٱلنَّجۡدَيۡنِ"],"вахадайнахун наждайн","Разве Мы не указали ему на две восходящие тропы?",["и указали Мы ему","два пути"]],[90,11,["فَلَا","ٱقۡتَحَمَ","ٱلۡعَقَبَةَ"],"фалаḳтахамал `аḳабах","Но он не стал преодолевать крутую тропу.",["но не","преодолел он","крутую тропу"]],[90,12,["وَمَآ","أَدۡرَىٰكَ","مَا","ٱلۡعَقَبَةُ"],"вама адрака мал `аḳабах","Откуда ты мог знать, что такое крутая тропа?",["и что","даст тебе знать","что такое","крутая тропа"]],[90,13,["فَكُّ","رَقَبَةٍ"],"факку раḳабах","Это - освобождение раба",["освобождение","шеи (раба)"]],[90,14,["أَوۡ","إِطۡعَٰمٞ","فِي","يَوۡمٖ","ذِي","مَسۡغَبَةٖ"],"ау ит`амун фии йаумин зии масгабах","или кормление в голодный день",["или","кормление","в","день","полный","голода"]],[90,15,["يَتِيمٗا","ذَا","مَقۡرَبَةٍ"],"йатииман за маḳрабах","сироту из числа родственников",["сироты","обладающего","родством"]],[90,16,["أَوۡ","مِسۡكِينٗا","ذَا","مَتۡرَبَةٖ"],"ау мискиинан за матрабах","или приникшего к земле бедняка.",["или","бедняка","лежащего","в прахе"]],[90,17,["ثُمَّ","كَانَ","مِنَ","ٱلَّذِينَ","ءَامَنُواْ","وَتَو