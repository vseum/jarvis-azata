{"p":594,"j":30,"a":[[89,24,["يَقُولُ","يَٰلَيۡتَنِي","قَدَّمۡتُ","لِحَيَاتِي"],"йакуулу йаалайтании каддамту лихайаатии","Он скажет: «Эх, если бы я заранее позаботился о своей жизни!».",["скажет он","о, если бы я","заранее приготовил","для жизни моей"]],[89,25,["فَيَوۡمَئِذٖ","لَّا","يُعَذِّبُ","عَذَابَهُۥٓ","أَحَدٞ"],"файаума'изил лаа йу`аззибу `азаабахуу ахад","В тот день никто не причинит таких мучений, как Он,",["и в тот день","не","накажет","наказанием Его","никто"]],[89,26,["وَلَا","يُوثِقُ","وَثَاقَهُۥٓ","أَحَدٞ"],"уалаа йуусику уасаакахуу ахад","и никто не наложит таких оков, как Он.",["и не","свяжет","оковами Его","никто"]],[89,27,["يَٰٓأَيَّتُهَا","ٱلنَّفۡسُ","ٱلۡمُطۡمَئِنَّةُ"],"йаа'аййатухаа ннафсу лмутма'иннах","О обретшая покой душа!",["о","душа","успокоенная"]],[89,28,["ٱرۡجِعِيٓ","إِلَىٰ","رَبِّكِ","رَاضِيَةٗ","مَّرۡضِيَّةٗ"],"ирджи`ии илаа раббики раадийатам мардиййаха","Вернись к своему Господу удовлетворенной и снискавшей довольство!",["вернись","к","Господу твоему","довольной","снискавшей довольство"]],[89,29,["فَٱدۡخُلِي","فِي","عِبَٰدِي"],"фадхулии фии `ибаадии","Войди в круг Моих рабов!",["и войди","в число","рабов Моих"]],[89,30,["وَٱدۡخُلِي","جَنَّتِي"],"уадхулии джаннатии","Войди в Мой Рай!",["и войди","в Рай Мой"]],[90,1,["لَآ","أُقۡسِمُ","بِهَٰذَا","ٱلۡبَلَدِ"],"лаа уксиму бихаазаа лбалад","Нет, клянусь этим городом (Меккой)!",["нет","клянусь","этим","городом"]],[90,2,["وَأَنتَ","حِلُّۢ","بِهَٰذَا","ٱلۡبَلَدِ"],"уа'анта хиллу бихаазаа лбалад","Ты обитаешь в этом городе (или Тебе будет дозволено сражаться в этом городе).",["и ты","свободно пребываешь","в этом","городе"]],[90,3,["وَوَالِدٖ","وَمَا","وَلَدَ"],"уауаалидин уамаа уалад","Клянусь родителем и тем, кого он породил (Адамом и его потомством, или Ибрахимом и его потомками, в том числе Исмаилом и Мухаммадом)!",["и (клянусь) родителем","и тем, что","он породил"]],[90,4,["لَقَدۡ","خَلَقۡنَا","ٱلۡإِنسَٰنَ","فِي","كَبَدٍ"],"лакад халакнаа л'инсаана фии кабад","Мы создали человека в тяготах.",["воистину уже","создали Мы","человека","в","тяготах"]],[90,5,["أَيَحۡسَبُ","أَن","لَّن","يَقۡدِرَ","عَلَيۡهِ","أَحَدٞ"],"айахсабу ал лан йакдира `алайхи ахад","Неужели он полагает, что никто не справится с ним?",["разве думает он","что","никогда не","одолеет","его","никто"]],[90,6,["يَقُولُ","أَهۡلَكۡتُ","مَالٗا","لُّبَدًا"],"йакуулу ахлакту маалал лубада","Он говорит: «Я погубил богатство несметное!».",["говорит он","я истратил","богатство","огромное"]],[90,7,["أَيَحۡسَبُ","أَن","لَّمۡ","يَرَهُۥٓ","أَحَدٌ"],"айахсабу ал лам йарахуу ахад","Неужели он полагает, что никто не видел его?",["разве думает он","что","не","видел его","никто"]],[90,8,["أَلَمۡ","نَجۡعَل","لَّهُۥ","عَيۡنَيۡنِ"],"алам надж`ал ллахуу `айнайн","Разве Мы не наделили его двумя глазами,",["разве не","сделали Мы","ему","два глаза"]],[90,9,["وَلِسَانٗا","وَشَفَتَيۡنِ"],"уалисаанан уашафатайн","языком и двумя устами?",["и язык","и две губы"]],[90,10,["وَهَدَيۡنَٰهُ","ٱلنَّجۡدَيۡنِ"],"уахадайнааху ннадждайн","Разве Мы не указали ему на две восходящие тропы?",["и указали Мы ему","два пути"]],[90,11,["فَلَا","ٱقۡتَحَمَ","ٱلۡعَقَبَةَ"],"фалаа ктахама л`акабах","Но он не стал преодолевать крутую тропу.",["но не","преодолел он","крутую тропу"]],[90,12,["وَمَآ","أَدۡرَىٰكَ","مَا","ٱلۡعَقَبَةُ"],"уамаа адраака маа л`акабах","Откуда ты мог знать, что такое крутая тропа?",["и что","даст тебе знать","что такое","крутая тропа"]],[90,13,["فَكُّ","رَقَبَةٍ"],"факку ракабах","Это - освобождение раба",["освобождение","шеи (раба)"]],[90,14,["أَوۡ","إِطۡعَٰمٞ","فِي","يَوۡمٖ","ذِي","مَسۡغَبَةٖ"],"ау ит`аамун фии йаумин зии масгабах","или кормление в голодный день",["или","кормление","в","день","полный","голода"]],[90,15,["يَتِيمٗا","ذَا","مَقۡرَبَةٍ"],"йатииман заа макрабах","сироту из числа родственников",["сироты","обладающего","родством"]],[90,16,["أَوۡ","مِسۡكِينٗا","ذَا","مَتۡرَبَةٖ"],"ау мискиинан заа матрабах","или приникшего к земле бедняка.",["или","бедняка","лежащего","в прахе"]],[90,17,["ثُمَّ","كَانَ","مِنَ","ٱلَّذِينَ","ءَامَنُواْ","وَتَوَاصَوۡاْ","بِٱلصَّبۡرِ","وَتَوَاصَوۡاْ","بِٱلۡمَرۡحَمَةِ"],"сумма каана мина ллазиина аамануу уатауаасау биссабри уатауаасау билмархамах","А после этого надо быть одним из тех, которые уверовали и заповедали друг другу терпение и заповедали друг другу милосердие.",["затем","был он","из","тех, которые","уверовали","и заповедали друг другу","терпение","и заповедали друг другу","милосердие"]],[90,18,["أُوْلَٰٓئِكَ","أَصۡحَٰبُ","ٱلۡمَيۡمَنَةِ"],"улаа'ика асхаабу лмайманах","Таковы люди правой стороны.",["те","обитатели","правой стороны"]],[90,19,["وَٱلَّذِينَ","كَفَرُواْ","بِـَٔايَٰتِنَا","هُمۡ","أَصۡحَٰبُ","ٱلۡمَشۡـَٔمَةِ"],"уаллазиина кафаруу би'аайаатинаа хум асхаабу лмаш'амах","Те же, которые не уверовали в Наши знамения, являются людьми левой стороны,",["а те, которые","не уверовали","в знамения Наши","они","обитатели","левой стороны"]],[90,20,["عَلَيۡهِمۡ","نَارٞ","مُّؤۡصَدَةُۢ"],"`алайхим наарум му'садах","над которыми сомкнется Огонь.",["над ними","Огонь","сомкнутый"]]]}