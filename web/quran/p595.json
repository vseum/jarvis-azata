{"p":595,"j":30,"a":[[91,1,["وَٱلشَّمۡسِ","وَضُحَىٰهَا"],"вашшамси вадухаха","Клянусь солнцем и его утренним сиянием!",["клянусь солнцем","и его сиянием"]],[91,2,["وَٱلۡقَمَرِ","إِذَا","تَلَىٰهَا"],"валḳамари иза талаха","Клянусь луной, когда она следует за ним!",["клянусь луной","когда","последовала за ним"]],[91,3,["وَٱلنَّهَارِ","إِذَا","جَلَّىٰهَا"],"ваннахари иза жаллаха","Клянусь днем, когда он делает его (солнце) ясным!",["клянусь днём","когда","явил его"]],[91,4,["وَٱلَّيۡلِ","إِذَا","يَغۡشَىٰهَا"],"валлайли иза йагшаха","Клянусь ночью, когда она скрывает его (солнце)!",["клянусь ночью","когда","покрывает его"]],[91,5,["وَٱلسَّمَآءِ","وَمَا","بَنَىٰهَا"],"вассамаи вама банаха","Клянусь небом и Тем, Кто его воздвиг (или тем, как Он воздвиг его)!",["клянусь небом","и Тем, Кто","воздвиг его"]],[91,6,["وَٱلۡأَرۡضِ","وَمَا","طَحَىٰهَا"],"вал'арди вама тахаха","Клянусь землей и Тем, Кто ее распростер (или тем, как Он распростер ее)!",["клянусь землёй","и Тем, Кто","распростёр её"]],[91,7,["وَنَفۡسٖ","وَمَا","سَوَّىٰهَا"],"ванафсин вама савваха","Клянусь душой и Тем, Кто придал ей совершенный облик (или тем, как Он сделал ее облик совершенным)",["клянусь душой","и Тем, Кто","соразмерил её"]],[91,8,["فَأَلۡهَمَهَا","فُجُورَهَا","وَتَقۡوَىٰهَا"],"фа'алхамаха фужуураха ватаḳваха","и внушил ей порочность ее и богобоязненность!",["и внушил ей","её нечестие","и её богобоязненность"]],[91,9,["قَدۡ","أَفۡلَحَ","مَن","زَكَّىٰهَا"],"ḳад афлаха ман заккаха","Преуспел тот, кто очистил ее,",["действительно","преуспел","тот, кто","очистил её"]],[91,10,["وَقَدۡ","خَابَ","مَن","دَسَّىٰهَا"],"ваḳад хаба ман дассаха","и понес урон тот, кто скрыл ее (опорочил, облек в несправедливость).",["и действительно","потерпел неудачу","тот, кто","погрёб её"]],[91,11,["كَذَّبَتۡ","ثَمُودُ","بِطَغۡوَىٰهَآ"],"каззабат самууду битагваха","Самудяне сочли лжецом пророка Салиха из-за своего беззакония,",["сочли ложью","самудяне","из-за своего беззакония"]],[91,12,["إِذِ","ٱنۢبَعَثَ","أَشۡقَىٰهَا"],"изимба`аса ашḳаха","и тогда самый несчастный из них вызвался убить верблюдицу.",["когда","поднялся","самый несчастный из них"]],[91,13,["فَقَالَ","لَهُمۡ","رَسُولُ","ٱللَّهِ","نَاقَةَ","ٱللَّهِ","وَسُقۡيَٰهَا"],"фаḳала лахум расуулуллахи наḳаталлахи васуḳйаха","Посланник Аллаха (Салих) сказал им: «Берегите верблюдицу и питье ее!».",["и сказал","им","посланник","Аллаха","(берегите) верблюдицу","Аллаха","и её питьё"]],[91,14,["فَكَذَّبُوهُ","فَعَقَرُوهَا","فَدَمۡدَمَ","عَلَيۡهِمۡ","رَبُّهُم","بِذَنۢبِهِمۡ","فَسَوَّىٰهَا"],"факаззабууху фа`аḳарууха фадамдама `алайхим раббухум бизамбихим фасавваха","Они сочли его лжецом и подрезали ей поджилки, и за этот грех Господь их подверг их наказанию, которое было одинаковым для всех (или сровнял над ними землю).",["но они сочли его лжецом","и подрезали ей поджилки","и обрушил гибель","на них","их Господь","за их грех","и сравнял их"]],[91,15,["وَلَا","يَخَافُ","عُقۡبَٰهَا"],"вала йахафу `уḳбаха","И не опасался Он последствий этого.",["и не","боится Он","её последствий"]],[92,1,["وَٱلَّيۡلِ","إِذَا","يَغۡشَىٰ"],"валлайли иза йагша","Клянусь ночью, когда она покрывает землю!",["клянусь ночью","когда","покрывает"]],[92,2,["وَٱلنَّهَارِ","إِذَا","تَجَلَّىٰ"],"ваннахари иза тажалла","Клянусь днем, когда он проясняется!",["и днём","когда","проясняется"]],[92,3,["وَمَا","خَلَقَ","ٱلذَّكَرَ","وَٱلۡأُنثَىٰٓ"],"вама халаḳаз закара вал'унса","Клянусь Тем, Кто создал мужчину и женщину!",["и Тем, Кто","создал","мужской пол","и женский"]],[92,4,["إِنَّ","سَعۡيَكُمۡ","لَشَتَّىٰ"],"инна са`йакум лашатта","Ваши стремления различны.",["поистине","стремления ваши","непременно различны"]],[92,5,["فَأَمَّا","مَنۡ","أَعۡطَىٰ","وَٱتَّقَىٰ"],"фа'амма ман а`та ваттаḳа","Тому, кто отдавал должное (или раздавал милостыню) и был богобоязнен,",["что же до","того, кто","дал","и был богобоязнен"]],[92,6,["وَصَدَّقَ","بِٱلۡحُسۡنَىٰ"],"васаддаḳа билхусна","кто признавал наилучшее (свидетельство единобожия или Рай),",["и признал истинным","наилучшее"]],[92,7,["فَسَنُيَسِّرُهُۥ","لِلۡيُسۡرَىٰ"],"фасануйассирухуу лилйусра","Мы облегчим путь к легчайшему (к праведным деяниям).",["то облегчим Мы ему путь","к легчайшему"]],[92,8,["وَأَمَّا","مَنۢ","بَخِلَ","وَٱسۡتَغۡنَىٰ"],"ва'амма мам бахила вастагна","А тому, кто был скуп и полагал, что ни в чем не нуждается,",["а что до","того, кто","скупился","и счёл себя не нуждающимся"]],[92,9,["وَكَذَّبَ","بِٱلۡحُسۡنَىٰ"],"ваказзаба билхусна","кто счел ложью наилучшее (свидетельство единобожия или Рай),",["и счёл ложью","наилучшее"]],[92,10,["فَسَنُيَسِّرُهُۥ","لِلۡعُسۡرَىٰ"],"фасануйассирухуу лил`усра","Мы облегчим путь к тягчайшему (к злу и наказанию).",["то облегчим Мы ему путь","к тягчайшему"]],[92,11,["وَمَا","يُغۡنِي","عَنۡهُ","مَالُهُۥٓ","إِذَا","تَرَدَّىٰٓ"],"вама йугнии `анху малухуу иза тарадда","Не спасет его достояние, когда он падет (в Геенну или погибнет).",["и не","поможет","ему","богатство его","когда","он падет"]],[92,12,["إِنَّ","عَلَيۡنَا","لَلۡهُدَىٰ"],"инна `алайна лалхуда","Воистину, Нам надлежит вести прямым путем.",["поистине","на Нас","непременно руководство"]],[92,13,["وَإِنَّ","لَنَا","لَلۡأٓخِرَةَ","وَٱلۡأُولَىٰ"],"ва'инна лана лал'ахирата вал'уула","Нам же принадлежат жизнь Последняя и первая.",["и поистине","Нам (принадлежит)","непременно последняя жизнь","и первая"]],[92,14,["فَأَنذَرۡتُكُمۡ","نَارٗا","تَلَظَّىٰ"],"фа'анзартукум наран талазза","Я предостерег вас от пылающего Огня.",["и предостерёг Я вас","об огне","пылающем"]]]}