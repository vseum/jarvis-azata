{"p":596,"j":30,"a":[[92,15,["لَا","يَصۡلَىٰهَآ","إِلَّا","ٱلۡأَشۡقَى"],"ла йаслаха иллал ашḳа","Войдет в него только самый несчастный,",["не","войдёт в него","лишь","самый несчастный"]],[92,16,["ٱلَّذِي","كَذَّبَ","وَتَوَلَّىٰ"],"аллазии каззаба ватавалла","который считает истину ложью и отворачивается.",["который","счёл ложью","и отвернулся"]],[92,17,["وَسَيُجَنَّبُهَا","ٱلۡأَتۡقَى"],"васайужаннабухал атḳа","Отдален от него будет самый богобоязненный,",["и будет отдалён от него","самый богобоязненный"]],[92,18,["ٱلَّذِي","يُؤۡتِي","مَالَهُۥ","يَتَزَكَّىٰ"],"аллазии йу'тии малахуу йатазакка","который раздает свое имущество, очищаясь,",["который","раздаёт","богатство своё","очищаясь"]],[92,19,["وَمَا","لِأَحَدٍ","عِندَهُۥ","مِن","نِّعۡمَةٖ","تُجۡزَىٰٓ"],"вама ли'ахадин `индахуу мин ни`матин тужза","и всякую милость возмещает сполна",["и нет","ни у кого","при нём","никакой","милости","для воздаяния"]],[92,20,["إِلَّا","ٱبۡتِغَآءَ","وَجۡهِ","رَبِّهِ","ٱلۡأَعۡلَىٰ"],"иллабтигаа важхи раббихил а`ла","только из стремления к Лику своего Всевышнего Господа.",["кроме","стремления к","Лику","Господа его","Всевышнего"]],[92,21,["وَلَسَوۡفَ","يَرۡضَىٰ"],"валасауфа йарда","И он непременно будет удовлетворен.",["и непременно вскоре","будет он доволен"]],[93,1,["وَٱلضُّحَىٰ"],"ваддуха","Клянусь утром!",["клянусь утренним сиянием"]],[93,2,["وَٱلَّيۡلِ","إِذَا","سَجَىٰ"],"валлайли иза сажа","Клянусь ночью, когда она успокаивается (или покрывается мраком)!",["и ночью","когда","покрывает мраком"]],[93,3,["مَا","وَدَّعَكَ","رَبُّكَ","وَمَا","قَلَىٰ"],"ма вадда`ака раббука вама ḳала","Не покинул тебя твой Господь и не возненавидел.",["не","покинул тебя","Господь твой","и не","возненавидел"]],[93,4,["وَلَلۡأٓخِرَةُ","خَيۡرٞ","لَّكَ","مِنَ","ٱلۡأُولَىٰ"],"валал'ахирату хайрул лака минал уула","Воистину, будущее для тебя лучше, чем настоящее.",["и непременно последующее","лучше","для тебя","чем","первое"]],[93,5,["وَلَسَوۡفَ","يُعۡطِيكَ","رَبُّكَ","فَتَرۡضَىٰٓ"],"валасауфа йу`тиика раббука фатарда","Господь твой непременно одарит тебя, и ты будешь удовлетворен.",["и непременно вскоре","даст тебе","Господь твой","и будешь ты доволен"]],[93,6,["أَلَمۡ","يَجِدۡكَ","يَتِيمٗا","فَـَٔاوَىٰ"],"алам йажидка йатииман фа'ава","Разве Он не нашел тебя сиротой и не дал тебе приют?",["разве не","нашел Он тебя","сиротой","и приютил"]],[93,7,["وَوَجَدَكَ","ضَآلّٗا","فَهَدَىٰ"],"ваважадака даллан фахада","Он нашел тебя заблудшим и повел прямым путем.",["и нашёл Он тебя","заблудшим","и повёл прямым путём"]],[93,8,["وَوَجَدَكَ","عَآئِلٗا","فَأَغۡنَىٰ"],"ваважадака `аилан фа'агна","Он нашел тебя бедным и обогатил.",["и нашёл Он тебя","бедным","и обогатил"]],[93,9,["فَأَمَّا","ٱلۡيَتِيمَ","فَلَا","تَقۡهَرۡ"],"фа'аммал йатиима фала таḳхар","Посему не притесняй сироту!",["что же до","сироты","то не","притесняй"]],[93,10,["وَأَمَّا","ٱلسَّآئِلَ","فَلَا","تَنۡهَرۡ"],"ва'аммас саила фала танхар","И не гони просящего!",["а что до","просящего","то не","гони"]],[93,11,["وَأَمَّا","بِنِعۡمَةِ","رَبِّكَ","فَحَدِّثۡ"],"ва'амма бини`мати раббика фахаддис","И возвещай о милости своего Господа.",["а что касается","о милости","Господа твоего","то рассказывай"]],[94,1,["أَلَمۡ","نَشۡرَحۡ","لَكَ","صَدۡرَكَ"],"алам нашрах лака садрак","Разве Мы не раскрыли для тебя грудь твою?",["разве не","раскрыли Мы","тебе","грудь твою"]],[94,2,["وَوَضَعۡنَا","عَنكَ","وِزۡرَكَ"],"вавада`на `анка визрак","и не сняли с тебя ношу,",["и сняли Мы","с тебя","ношу твою"]],[94,3,["ٱلَّذِيٓ","أَنقَضَ","ظَهۡرَكَ"],"аллазии анḳада захрак","которая отягощала твою спину?",["которая","отягощала","спину твою"]],[94,4,["وَرَفَعۡنَا","لَكَ","ذِكۡرَكَ"],"варафа`на лака зикрак","Разве Мы не возвеличили для тебя славу твою?",["и возвысили Мы","тебе","поминание тебя"]],[94,5,["فَإِنَّ","مَعَ","ٱلۡعُسۡرِ","يُسۡرًا"],"фа'инна ма`ал `усри йусра","Воистину, за каждой тягостью наступает облегчение.",["и поистине","с","тягостью","облегчение"]],[94,6,["إِنَّ","مَعَ","ٱلۡعُسۡرِ","يُسۡرٗا"],"инна ма`ал `усри йусра","За каждой тягостью наступает облегчение.",["поистине","с","трудностью","облегчение"]],[94,7,["فَإِذَا","فَرَغۡتَ","فَٱنصَبۡ"],"фа'иза фарагта фансаб","Посему, как только освободишься, будь деятелен (как только освободишься от мирских дел, усердно поклоняйся Аллаху, или как только завершишь намаз, усердно взывай к Аллаху с молитвами)",["и когда","освободишься","то трудись усердно"]],[94,8,["وَإِلَىٰ","رَبِّكَ","فَٱرۡغَب"],"ва'ила раббика фаргаб","и устремись к своему Господу.",["и к","Господу твоему","устремляйся"]]],"m":[[["لَا","не",92,15],["يَصۡلَىٰهَآ","войдёт в него",92,15],["إِلَّا","лишь",92,15],["ٱلۡأَشۡقَى","самый несчастный",92,15],[15],["ٱلَّذِي","который",92,16],["كَذَّبَ","счёл ложью",92,16],["وَتَوَلَّىٰ","и отвернулся",92,16],[16],["وَسَيُجَنَّبُهَا","и будет отдалён от него",92,17]],[["ٱلۡأَتۡقَى","самый богобоязненный",92,17],[17],["ٱلَّذِي","который",92,18],["يُؤۡتِي","раздаёт",92,18],["مَالَهُۥ","богатство своё",92,18],["يَتَزَكَّىٰ","очищаясь",92,18],[18],["وَمَا","и нет",92,19],["لِأَحَدٍ","ни у кого",92,19],["عِندَهُۥ","при нём",92,19],["مِن","никакой",92,19]],[["نِّعۡمَةٖ","милости",92,19],["تُجۡزَىٰٓ","для воздаяния",92,19],[19],["إِلَّا","кроме",92,20],["ٱبۡتِغَآءَ","стремления к",92,20],["وَجۡهِ","Лику",92,20],["رَبِّهِ","Господа его",92,20],["ٱلۡأَعۡلَىٰ","Всевышнего",92,20],[20],["وَلَسَوۡفَ","и непременно вскоре",92,21],["يَرۡضَىٰ","будет он доволен",92,21],[21]],["h",93],["b"],[["وَٱلضُّحَىٰ","клянусь утренним сиянием",93,1],[1],["وَٱلَّيۡلِ","и ночью",93,2],["إِذَا","когда",93,2],["سَجَىٰ","покрывает мраком",93,2],[2],["مَا","не",93,3],["وَدَّعَكَ","покинул тебя",93,3],["رَبُّكَ","Господь твой",93,3],["وَمَا","и не",93,3],["قَلَىٰ","возненавидел",93,3],[3]],[["وَلَلۡأٓخِرَةُ","и непременно последующее",93,4],["خَيۡرٞ","лучше",93,4],["لَّكَ","для тебя",93,4],["مِنَ","чем",93,4],["ٱلۡأُولَىٰ","первое",93,4],[4],["وَلَسَوۡفَ","и непременно вскоре",93,5],["يُعۡطِيكَ","даст тебе",93,5],["رَبُّكَ","Господь твой",93,5]],[["فَتَرۡضَىٰٓ","и будешь ты доволен",93,5],[5],["أَلَمۡ","разве не",93,6],["يَجِدۡكَ","нашел Он тебя",93,6],["يَتِيمٗا","сиротой",93,6],["فَـَٔاوَىٰ","и приютил",93,6],[6],["وَوَجَدَكَ","и нашёл Он тебя",93,7],["ضَآلّٗا","заблудшим",93,7]],[["فَهَدَىٰ","и повёл прямым путём",93,7],[7],["وَوَجَدَكَ","и нашёл Он тебя",93,8],["عَآئِلٗا","бедным",93,8],["فَأَغۡنَىٰ","и обогатил",93,8],[8],["فَأَمَّا","что же до",93,9],["ٱلۡيَتِيمَ","сироты",93,9],["فَلَا","то не",93,9],["تَقۡهَرۡ","притесняй",93,9]],[[9],["وَأَمَّا","а что до",93,10],["ٱلسَّآئِلَ","просящего",93,10],["فَلَا","то не",93,10],["تَنۡهَرۡ","гони",93,10],[10],["وَأَمَّا","а что касается",93,11],["بِنِعۡمَةِ","о милости",93,11],["رَبِّكَ","Господа твоего",93,11],["فَحَدِّثۡ","то рассказывай",93,11],[11]],["h",94],["b"],[["أَلَمۡ","разве не",94,1],["نَشۡرَحۡ","раскрыли Мы",94,1],["لَكَ","тебе",94,1],["صَدۡرَكَ","грудь твою",94,1],[1],["وَوَضَعۡنَا","и сняли Мы",94,2],["عَنكَ","с тебя",94,2],["وِزۡرَكَ","ношу твою",94,2],[2],["ٱلَّذِيٓ","которая",94,3]],[["أَنقَضَ","отягощала",94,3],["ظَهۡرَكَ","спину твою",94,3],[3],["وَرَفَعۡنَا","и возвысили Мы",94,4],["لَكَ","тебе",94,4],["ذِكۡرَكَ","поминание тебя",94,4],[4],["فَإِنَّ","и поистине",94,5],["مَعَ","с",94,5],["ٱلۡعُسۡرِ","тягостью",94,5],["يُسۡرًا","облегчение",94,5],[5],["إِنَّ","поистине",94,6]],[["مَعَ","с",94,6],["ٱلۡعُسۡرِ","трудностью",94,6],["يُسۡرٗا","облегчение",94,6],[6],["فَإِذَا","и когда",94,7],["فَرَغۡتَ","освободишься",94,7],["فَٱنصَبۡ","то трудись усердно",94,7],[7],["وَإِلَىٰ","и к",94,8],["رَبِّكَ","Господу твоему",94,8],["فَٱرۡغَب","устремляйся",94,8],[8]]]}