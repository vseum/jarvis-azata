{"p":596,"j":30,"a":[[92,15,["لَا","يَصۡلَىٰهَآ","إِلَّا","ٱلۡأَشۡقَى"],"ла йаслаха иллал ашḳа","Войдет в него только самый несчастный,",["не","войдёт в него","лишь","самый несчастный"]],[92,16,["ٱلَّذِي","كَذَّبَ","وَتَوَلَّىٰ"],"аллазии каззаба ватавалла","который считает истину ложью и отворачивается.",["который","счёл ложью","и отвернулся"]],[92,17,["وَسَيُجَنَّبُهَا","ٱلۡأَتۡقَى"],"васайужаннабухал атḳа","Отдален от него будет самый богобоязненный,",["и будет отдалён от него","самый богобоязненный"]],[92,18,["ٱلَّذِي","يُؤۡتِي","مَالَهُۥ","يَتَزَكَّىٰ"],"аллазии йу'тии малахуу йатазакка","который раздает свое имущество, очищаясь,",["который","раздаёт","богатство своё","очищаясь"]],[92,19,["وَمَا","لِأَحَدٍ","عِندَهُۥ","مِن","نِّعۡمَةٖ","تُجۡزَىٰٓ"],"вама ли'ахадин `индахуу мин ни`матин тужза","и всякую милость возмещает сполна",["и нет","ни у кого","при нём","никакой","милости","для воздаяния"]],[92,20,["إِلَّا","ٱبۡتِغَآءَ","وَجۡهِ","رَبِّهِ","ٱلۡأَعۡلَىٰ"],"иллабтигаа важхи раббихил а`ла","только из стремления к Лику своего Всевышнего Господа.",["кроме","стремления к","Лику","Господа его","Всевышнего"]],[92,21,["وَلَسَوۡفَ","يَرۡضَىٰ"],"валасауфа йарда","И он непременно будет удовлетворен.",["и непременно вскоре","будет он доволен"]],[93,1,["وَٱلضُّحَىٰ"],"ваддуха","Клянусь утром!",["клянусь утренним сиянием"]],[93,2,["وَٱلَّيۡلِ","إِذَا","سَجَىٰ"],"валлайли иза сажа","Клянусь ночью, когда она успокаивается (или покрывается мраком)!",["и ночью","когда","покрывает мраком"]],[93,3,["مَا","وَدَّعَكَ","رَبُّكَ","وَمَا","قَلَىٰ"],"ма вадда`ака раббука вама ḳала","Не покинул тебя твой Господь и не возненавидел.",["не","покинул тебя","Господь твой","и не","возненавидел"]],[93,4,["وَلَلۡأٓخِرَةُ","خَيۡرٞ","لَّكَ","مِنَ","ٱلۡأُولَىٰ"],"валал'ахирату хайрул лака минал уула","Воистину, будущее для тебя лучше, чем настоящее.",["и непременно последующее","лучше","для тебя","чем","первое"]],[93,5,["وَلَسَوۡفَ","يُعۡطِيكَ","رَبُّكَ","فَتَرۡضَىٰٓ"],"валасауфа йу`тиика раббука фатарда","Господь твой непременно одарит тебя, и ты будешь удовлетворен.",["и непременно вскоре","даст тебе","Господь твой","и будешь ты доволен"]],[93,6,["أَلَمۡ","يَجِدۡكَ","يَتِيمٗا","فَـَٔاوَىٰ"],"алам йажидка йатииман фа'ава","Разве Он не нашел тебя сиротой и не дал тебе приют?",["разве не","нашел Он тебя","сиротой","и приютил"]],[93,7,["وَوَجَدَكَ","ضَآلّٗا","فَهَدَىٰ"],"ваважадака даллан фахада","Он нашел тебя заблудшим и повел прямым путем.",["и нашёл Он тебя","заблудшим","и повёл прямым путём"]],[93,8,["وَوَجَدَكَ","عَآئِلٗا","فَأَغۡنَىٰ"],"ваважадака `аилан фа'агна","Он нашел тебя бедным и обогатил.",["и нашёл Он тебя","бедным","и обогатил"]],[93,9,["فَأَمَّا","ٱلۡيَتِيمَ","فَلَا","تَقۡهَرۡ"],"фа'аммал йатиима фала таḳхар","Посему не притесняй сироту!",["что же до","сироты","то не","притесняй"]],[93,10,["وَأَمَّا","ٱلسَّآئِلَ","فَلَا","تَنۡهَرۡ"],"ва'аммас саила фала танхар","И не гони просящего!",["а что до","просящего","то не","гони"]],[93,11,["وَأَمَّا","بِنِعۡمَةِ","رَبِّكَ","فَحَدِّثۡ"],"ва'амма бини`мати раббика фахаддис","И возвещай о милости своего Господа.",["а что касается","о милости","Господа твоего","то рассказывай"]],[94,1,["أَلَمۡ","نَشۡرَحۡ","لَكَ","صَدۡرَكَ"],"алам нашрах лака садрак","Разве Мы не раскрыли для тебя грудь твою?",["разве не","раскрыли Мы","тебе","грудь твою"]],[94,2,["وَوَضَعۡنَا","عَنكَ","وِزۡرَكَ"],"вавада`на `анка визрак","и не сняли с тебя ношу,",["и сняли Мы","с тебя","ношу твою"]],[94,3,["ٱلَّذِيٓ","أَنقَضَ","ظَهۡرَكَ"],"аллазии анḳада захрак","которая отягощала твою спину?",["которая","отягощала","спину твою"]],[94,4,["وَرَفَعۡنَا","لَكَ","ذِكۡرَكَ"],"варафа`на лака зикрак","Разве Мы не возвеличили для тебя славу твою?",["и возвысили Мы","тебе","поминание тебя"]],[94,5,["فَإِنَّ","مَعَ","ٱلۡعُسۡرِ","يُسۡرًا"],"фа'инна ма`ал `усри йусра","Воистину, за каждой тягостью наступает облегчение.",["и поистине","с","тягостью","облегчение"]],[94,6,["إِنَّ","مَعَ","ٱلۡعُسۡرِ","يُسۡرٗا"],"инна ма`ал `усри йусра","За каждой тягостью наступает облегчение.",["поистине","с","трудностью","облегчение"]],[94,7,["فَإِذَا","فَرَغۡتَ","فَٱنصَبۡ"],"фа'иза фарагта фансаб","Посему, как только освободишься, будь деятелен (как только освободишься от мирских дел, усердно поклоняйся Аллаху, или как только завершишь намаз, усердно взывай к Аллаху с молитвами)",["и когда","освободишься","то трудись усердно"]],[94,8,["وَإِلَىٰ","رَبِّكَ","فَٱرۡغَب"],"ва'ила раббика фаргаб","и устремись к своему Господу.",["и к","Господу твоему","устремляйся"]]]}