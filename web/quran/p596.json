{"p":596,"j":30,"a":[[92,15,["لَا","يَصۡلَىٰهَآ","إِلَّا","ٱلۡأَشۡقَى"],"лаа йаслаахаа иллаа л'ашка","Войдет в него только самый несчастный,",["не","войдёт в него","лишь","самый несчастный"]],[92,16,["ٱلَّذِي","كَذَّبَ","وَتَوَلَّىٰ"],"аллазии каззаба уатауаллаа","который считает истину ложью и отворачивается.",["который","счёл ложью","и отвернулся"]],[92,17,["وَسَيُجَنَّبُهَا","ٱلۡأَتۡقَى"],"уасайуджаннабухаа л'атка","Отдален от него будет самый богобоязненный,",["и будет отдалён от него","самый богобоязненный"]],[92,18,["ٱلَّذِي","يُؤۡتِي","مَالَهُۥ","يَتَزَكَّىٰ"],"аллазии йу'тии маалахуу йатазаккаа","который раздает свое имущество, очищаясь,",["который","раздаёт","богатство своё","очищаясь"]],[92,19,["وَمَا","لِأَحَدٍ","عِندَهُۥ","مِن","نِّعۡمَةٖ","تُجۡزَىٰٓ"],"уамаа ли'ахадин `индахуу мин ни`матин туджзаа","и всякую милость возмещает сполна",["и нет","ни у кого","при нём","никакой","милости","для воздаяния"]],[92,20,["إِلَّا","ٱبۡتِغَآءَ","وَجۡهِ","رَبِّهِ","ٱلۡأَعۡلَىٰ"],"иллаа бтигаа'а уаджхи раббихи л'а`лаа","только из стремления к Лику своего Всевышнего Господа.",["кроме","стремления к","Лику","Господа его","Всевышнего"]],[92,21,["وَلَسَوۡفَ","يَرۡضَىٰ"],"уаласауфа йардаа","И он непременно будет удовлетворен.",["и непременно вскоре","будет он доволен"]],[93,1,["وَٱلضُّحَىٰ"],"уаддухаа","Клянусь утром!",["клянусь утренним сиянием"]],[93,2,["وَٱلَّيۡلِ","إِذَا","سَجَىٰ"],"уаллайли изаа саджаа","Клянусь ночью, когда она успокаивается (или покрывается мраком)!",["и ночью","когда","покрывает мраком"]],[93,3,["مَا","وَدَّعَكَ","رَبُّكَ","وَمَا","قَلَىٰ"],"маа уадда`ака раббука уамаа калаа","Не покинул тебя твой Господь и не возненавидел.",["не","покинул тебя","Господь твой","и не","возненавидел"]],[93,4,["وَلَلۡأٓخِرَةُ","خَيۡرٞ","لَّكَ","مِنَ","ٱلۡأُولَىٰ"],"уалал'хирату хайрул лака мина л'уулаа","Воистину, будущее для тебя лучше, чем настоящее.",["и непременно последующее","лучше","для тебя","чем","первое"]],[93,5,["وَلَسَوۡفَ","يُعۡطِيكَ","رَبُّكَ","فَتَرۡضَىٰٓ"],"уаласауфа йу`тиика раббука фатардаа","Господь твой непременно одарит тебя, и ты будешь удовлетворен.",["и непременно вскоре","даст тебе","Господь твой","и будешь ты доволен"]],[93,6,["أَلَمۡ","يَجِدۡكَ","يَتِيمٗا","فَـَٔاوَىٰ"],"алам йаджидка йатииман фа'аауаа","Разве Он не нашел тебя сиротой и не дал тебе приют?",["разве не","нашел Он тебя","сиротой","и приютил"]],[93,7,["وَوَجَدَكَ","ضَآلّٗا","فَهَدَىٰ"],"уауаджадака дааллан фахадаа","Он нашел тебя заблудшим и повел прямым путем.",["и нашёл Он тебя","заблудшим","и повёл прямым путём"]],[93,8,["وَوَجَدَكَ","عَآئِلٗا","فَأَغۡنَىٰ"],"уауаджадака `аа'илан фа'агнаа","Он нашел тебя бедным и обогатил.",["и нашёл Он тебя","бедным","и обогатил"]],[93,9,["فَأَمَّا","ٱلۡيَتِيمَ","فَلَا","تَقۡهَرۡ"],"фа'аммаа лйатиима фалаа такхар","Посему не притесняй сироту!",["что же до","сироты","то не","притесняй"]],[93,10,["وَأَمَّا","ٱلسَّآئِلَ","فَلَا","تَنۡهَرۡ"],"уа'аммаа ссаа'ила фалаа танхар","И не гони просящего!",["а что до","просящего","то не","гони"]],[93,11,["وَأَمَّا","بِنِعۡمَةِ","رَبِّكَ","فَحَدِّثۡ"],"уа'аммаа бини`мати раббика фахаддис","И возвещай о милости своего Господа.",["а что касается","о милости","Господа твоего","то рассказывай"]],[94,1,["أَلَمۡ","نَشۡرَحۡ","لَكَ","صَدۡرَكَ"],"алам нашрах лака садрак","Разве Мы не раскрыли для тебя грудь твою?",["разве не","раскрыли Мы","тебе","грудь твою"]],[94,2,["وَوَضَعۡنَا","عَنكَ","وِزۡرَكَ"],"уауада`наа `анка уизрак","и не сняли с тебя ношу,",["и сняли Мы","с тебя","ношу твою"]],[94,3,["ٱلَّذِيٓ","أَنقَضَ","ظَهۡرَكَ"],"аллазии анкада захрак","которая отягощала твою спину?",["которая","отягощала","спину твою"]],[94,4,["وَرَفَعۡنَا","لَكَ","ذِكۡرَكَ"],"уарафа`наа лака зикрак","Разве Мы не возвеличили для тебя славу твою?",["и возвысили Мы","тебе","поминание тебя"]],[94,5,["فَإِنَّ","مَعَ","ٱلۡعُسۡرِ","يُسۡرًا"],"фа'инна ма`а л`усри йусра","Воистину, за каждой тягостью наступает облегчение.",["и поистине","с","тягостью","облегчение"]],[94,6,["إِنَّ","مَعَ","ٱلۡعُسۡرِ","يُسۡرٗا"],"инна ма`а л`усри йусра","За каждой тягостью наступает облегчение.",["поистине","с","трудностью","облегчение"]],[94,7,["فَإِذَا","فَرَغۡتَ","فَٱنصَبۡ"],"фа'изаа фарагта фансаб","Посему, как только освободишься, будь деятелен (как только освободишься от мирских дел, усердно поклоняйся Аллаху, или как только завершишь намаз, усердно взывай к Аллаху с молитвами)",["и когда","освободишься","то трудись усердно"]],[94,8,["وَإِلَىٰ","رَبِّكَ","فَٱرۡغَب"],"уа'илаа раббика фаргаб","и устремись к своему Господу.",["и к","Господу твоему","устремляйся"]]]}