{"p":597,"j":30,"a":[[95,1,["وَٱلتِّينِ","وَٱلزَّيۡتُونِ"],"уаттиини уаззайтуун","Клянусь смоковницей и оливой!",["клянусь смоковницей","и оливой"]],[95,2,["وَطُورِ","سِينِينَ"],"уатуури сииниин","Клянусь горой Синин (Синай)!",["и горой","Синин"]],[95,3,["وَهَٰذَا","ٱلۡبَلَدِ","ٱلۡأَمِينِ"],"уахаазаа лбалади л'амиин","Клянусь этим безопасным городом (Меккой)!",["и этим","городом","безопасным"]],[95,4,["لَقَدۡ","خَلَقۡنَا","ٱلۡإِنسَٰنَ","فِيٓ","أَحۡسَنِ","تَقۡوِيمٖ"],"лакад халакнаа л'инсаана фии ахсани такуиим","Мы сотворили человека в прекраснейшем облике.",["воистину уже","создали Мы","человека","в","наилучшем","облике"]],[95,5,["ثُمَّ","رَدَدۡنَٰهُ","أَسۡفَلَ","سَٰفِلِينَ"],"сумма рададнааху асфала саафилиин","Потом Мы вернем его в нижайшее из низких (продлим ему жизнь настолько, что он превратится в дряхлого старика, или бросим его на самое дно Геенны),",["затем","вернули Мы его","в нижайшее","из низких"]],[95,6,["إِلَّا","ٱلَّذِينَ","ءَامَنُواْ","وَعَمِلُواْ","ٱلصَّٰلِحَٰتِ","فَلَهُمۡ","أَجۡرٌ","غَيۡرُ","مَمۡنُونٖ"],"иллаа ллазиина аамануу уа`амилуу ссаалихаати фалахум аджрун гайру мамнуун","за исключением тех, которые уверовали и совершали праведные деяния. Им уготована награда неиссякаемая.",["кроме","тех, которые","уверовали","и совершали","праведные дела","то для них","награда","не","прерываемая"]],[95,7,["فَمَا","يُكَذِّبُكَ","بَعۡدُ","بِٱلدِّينِ"],"фамаа йуказзибука ба`ду биддиин","Что же после этого заставляет тебя считать ложью воздаяние?",["что же","заставляет тебя считать ложью","после этого","воздаяние"]],[95,8,["أَلَيۡسَ","ٱللَّهُ","بِأَحۡكَمِ","ٱلۡحَٰكِمِينَ"],"алайса ллаху би'ахками лхаакимиин","Разве Аллах не является Наимудрейшим Судьей?",["разве не","Аллах","мудрейший","из судей"]],[96,1,["ٱقۡرَأۡ","بِٱسۡمِ","رَبِّكَ","ٱلَّذِي","خَلَقَ"],"икра' бисми раббика ллазии халак","Читай во имя твоего Господа, Который сотворил все сущее,",["читай","во имя","Господа твоего","Который","сотворил"]],[96,2,["خَلَقَ","ٱلۡإِنسَٰنَ","مِنۡ","عَلَقٍ"],"халака л'инсаана мин `алак","сотворил человека из сгустка крови.",["сотворил","человека","из","сгустка"]],[96,3,["ٱقۡرَأۡ","وَرَبُّكَ","ٱلۡأَكۡرَمُ"],"икра' уараббука л'акрам","Читай, ведь твой Господь - Самый великодушный.",["читай","а Господь твой","щедрейший"]],[96,4,["ٱلَّذِي","عَلَّمَ","بِٱلۡقَلَمِ"],"аллазии `аллама билкалам","Он научил посредством письменной трости -",["Который","научил","посредством пера"]],[96,5,["عَلَّمَ","ٱلۡإِنسَٰنَ","مَا","لَمۡ","يَعۡلَمۡ"],"`аллама л'инсаана маа лам йа`лам","научил человека тому, чего тот не знал.",["научил","человека","тому, что","не","знал он"]],[96,6,["كـَلَّآ","إِنَّ","ٱلۡإِنسَٰنَ","لَيَطۡغَىٰٓ"],"каллаа инна л'инсаана лайатгаа","Но нет! Человек преступает границы дозволенного,",["так нет!","поистине","человек","непременно преступает"]],[96,7,["أَن","رَّءَاهُ","ٱسۡتَغۡنَىٰٓ"],"ар ра'ааху стагнаа","когда ему кажется, что он ни в чем не нуждается.",["оттого что","видит себя","не нуждающимся"]],[96,8,["إِنَّ","إِلَىٰ","رَبِّكَ","ٱلرُّجۡعَىٰٓ"],"инна илаа раббика ррудж`аа","Но к твоему Господу предстоит возвращение.",["поистине","к","Господу твоему","возвращение"]],[96,9,["أَرَءَيۡتَ","ٱلَّذِي","يَنۡهَىٰ"],"ара'айта ллазии йанхаа","Что ты думаешь о том, кто мешает",["видел ли ты","того, кто","запрещает"]],[96,10,["عَبۡدًا","إِذَا","صَلَّىٰٓ"],"`абдан изаа саллаа","рабу, когда тот молится?",["рабу","когда","молится он"]],[96,11,["أَرَءَيۡتَ","إِن","كَانَ","عَلَى","ٱلۡهُدَىٰٓ"],"ара'айта ин каана `алаа лхудаа","Что ты думаешь, а если он был на правом пути",["видел ли ты","если","был он","на","прямом пути"]],[96,12,["أَوۡ","أَمَرَ","بِٱلتَّقۡوَىٰٓ"],"ау амара биттакуаа","или призывал к богобоязненности?",["или","повелевал","богобоязненность"]],[96,13,["أَرَءَيۡتَ","إِن","كَذَّبَ","وَتَوَلَّىٰٓ"],"ара'айта ин каззаба уатауаллаа","Что ты думаешь, а если он счел ложью истину и отвернулся?",["видел ли ты","если","он отверг","и отвернулся"]],[96,14,["أَلَمۡ","يَعۡلَم","بِأَنَّ","ٱللَّهَ","يَرَىٰ"],"алам йа`лам би'анна ллаха йараа","Неужели он не знал, что Аллах видит его?",["разве не","знал он","что","Аллах","видит"]],[96,15,["كـَلَّا","لَئِن","لَّمۡ","يَنتَهِ","لَنَسۡفَعَۢا","بِٱلنَّاصِيَةِ"],"каллаа ла'ил лам йантахи ланасфа`аа биннаасийах","Но нет, если он не перестанет, то Мы схватим его за хохол -",["так нет!","если","не","перестанет он","непременно схватим Мы","за хохол"]],[96,16,["نَاصِيَةٖ","كَٰذِبَةٍ","خَاطِئَةٖ"],"наасийатин каазибатин хаати'ах","хохол лживый, грешный.",["хохол","лживый","грешный"]],[96,17,["فَلۡيَدۡعُ","نَادِيَهُۥ"],"фалйад`у наадийаху","Пусть он зовет свое сборище.",["пусть же зовёт","сборище своё"]],[96,18,["سَنَدۡعُ","ٱلزَّبَانِيَةَ"],"санад`у ззабаанийах","Мы же позовем адских стражей!",["позовём Мы","адских стражей"]],[96,19,["كـَلَّا","لَا","تُطِعۡهُ","وَٱسۡجُدۡۤ","وَٱقۡتَرِب۩"],"каллаа лаа тути`ху уасджуд уактариб","Так нет! Не повинуйся ему, а пади ниц и приближайся к Аллаху.",["так нет","не","повинуйся ему","и пади ниц","и приближайся"]]]}