{"p":597,"j":30,"a":[[95,1,["وَٱلتِّينِ","وَٱلزَّيۡتُونِ"],"ваттиини ваззайтуун","Клянусь смоковницей и оливой!",["клянусь смоковницей","и оливой"]],[95,2,["وَطُورِ","سِينِينَ"],"ватуури сииниин","Клянусь горой Синин (Синай)!",["и горой","Синин"]],[95,3,["وَهَٰذَا","ٱلۡبَلَدِ","ٱلۡأَمِينِ"],"вахазал баладил амиин","Клянусь этим безопасным городом (Меккой)!",["и этим","городом","безопасным"]],[95,4,["لَقَدۡ","خَلَقۡنَا","ٱلۡإِنسَٰنَ","فِيٓ","أَحۡسَنِ","تَقۡوِيمٖ"],"лаḳад халаḳнал инсана фии ахсани таḳвиим","Мы сотворили человека в прекраснейшем облике.",["воистину уже","создали Мы","человека","в","наилучшем","облике"]],[95,5,["ثُمَّ","رَدَدۡنَٰهُ","أَسۡفَلَ","سَٰفِلِينَ"],"сумма рададнаху асфала сафилиин","Потом Мы вернем его в нижайшее из низких (продлим ему жизнь настолько, что он превратится в дряхлого старика, или бросим его на самое дно Геенны),",["затем","вернули Мы его","в нижайшее","из низких"]],[95,6,["إِلَّا","ٱلَّذِينَ","ءَامَنُواْ","وَعَمِلُواْ","ٱلصَّٰلِحَٰتِ","فَلَهُمۡ","أَجۡرٌ","غَيۡرُ","مَمۡنُونٖ"],"иллал лазиина амануу ва`амилус салихати фалахум ажрун гайру мамнуун","за исключением тех, которые уверовали и совершали праведные деяния. Им уготована награда неиссякаемая.",["кроме","тех, которые","уверовали","и совершали","праведные дела","то для них","награда","не","прерываемая"]],[95,7,["فَمَا","يُكَذِّبُكَ","بَعۡدُ","بِٱلدِّينِ"],"фама йуказзибука ба`ду биддиин","Что же после этого заставляет тебя считать ложью воздаяние?",["что же","заставляет тебя считать ложью","после этого","воздаяние"]],[95,8,["أَلَيۡسَ","ٱللَّهُ","بِأَحۡكَمِ","ٱلۡحَٰكِمِينَ"],"алайсаллаху би'ахкамил хакимиин","Разве Аллах не является Наимудрейшим Судьей?",["разве не","Аллах","мудрейший","из судей"]],[96,1,["ٱقۡرَأۡ","بِٱسۡمِ","رَبِّكَ","ٱلَّذِي","خَلَقَ"],"иḳра' бисми раббикал лазии халаḳ","Читай во имя твоего Господа, Который сотворил все сущее,",["читай","во имя","Господа твоего","Который","сотворил"]],[96,2,["خَلَقَ","ٱلۡإِنسَٰنَ","مِنۡ","عَلَقٍ"],"халаḳал инсана мин `алаḳ","сотворил человека из сгустка крови.",["сотворил","человека","из","сгустка"]],[96,3,["ٱقۡرَأۡ","وَرَبُّكَ","ٱلۡأَكۡرَمُ"],"иḳра' вараббукал акрам","Читай, ведь твой Господь - Самый великодушный.",["читай","а Господь твой","щедрейший"]],[96,4,["ٱلَّذِي","عَلَّمَ","بِٱلۡقَلَمِ"],"аллазии `аллама билḳалам","Он научил посредством письменной трости -",["Который","научил","посредством пера"]],[96,5,["عَلَّمَ","ٱلۡإِنسَٰنَ","مَا","لَمۡ","يَعۡلَمۡ"],"`алламал инсана ма лам йа`лам","научил человека тому, чего тот не знал.",["научил","человека","тому, что","не","знал он"]],[96,6,["كـَلَّآ","إِنَّ","ٱلۡإِنسَٰنَ","لَيَطۡغَىٰٓ"],"калла иннал инсана лайатга","Но нет! Человек преступает границы дозволенного,",["так нет!","поистине","человек","непременно преступает"]],[96,7,["أَن","رَّءَاهُ","ٱسۡتَغۡنَىٰٓ"],"ар ра'ахустагна","когда ему кажется, что он ни в чем не нуждается.",["оттого что","видит себя","не нуждающимся"]],[96,8,["إِنَّ","إِلَىٰ","رَبِّكَ","ٱلرُّجۡعَىٰٓ"],"инна ила раббикар руж`а","Но к твоему Господу предстоит возвращение.",["поистине","к","Господу твоему","возвращение"]],[96,9,["أَرَءَيۡتَ","ٱلَّذِي","يَنۡهَىٰ"],"араайтал лазии йанха","Что ты думаешь о том, кто мешает",["видел ли ты","того, кто","запрещает"]],[96,10,["عَبۡدًا","إِذَا","صَلَّىٰٓ"],"`абдан иза салла","рабу, когда тот молится?",["рабу","когда","молится он"]],[96,11,["أَرَءَيۡتَ","إِن","كَانَ","عَلَى","ٱلۡهُدَىٰٓ"],"араайта ин кана `алал худа","Что ты думаешь, а если он был на правом пути",["видел ли ты","если","был он","на","прямом пути"]],[96,12,["أَوۡ","أَمَرَ","بِٱلتَّقۡوَىٰٓ"],"ау амара биттаḳва","или призывал к богобоязненности?",["или","повелевал","богобоязненность"]],[96,13,["أَرَءَيۡتَ","إِن","كَذَّبَ","وَتَوَلَّىٰٓ"],"араайта ин каззаба ватавалла","Что ты думаешь, а если он счел ложью истину и отвернулся?",["видел ли ты","если","он отверг","и отвернулся"]],[96,14,["أَلَمۡ","يَعۡلَم","بِأَنَّ","ٱللَّهَ","يَرَىٰ"],"алам йа`лам би'анналлаха йара","Неужели он не знал, что Аллах видит его?",["разве не","знал он","что","Аллах","видит"]],[96,15,["كـَلَّا","لَئِن","لَّمۡ","يَنتَهِ","لَنَسۡفَعَۢا","بِٱلنَّاصِيَةِ"],"калла ла'ил лам йантахи ланасфа`а биннасийах","Но нет, если он не перестанет, то Мы схватим его за хохол -",["так нет!","если","не","перестанет он","непременно схватим Мы","за хохол"]],[96,16,["نَاصِيَةٖ","كَٰذِبَةٍ","خَاطِئَةٖ"],"насийатин казибатин хатиах","хохол лживый, грешный.",["хохол","лживый","грешный"]],[96,17,["فَلۡيَدۡعُ","نَادِيَهُۥ"],"фалйад`у надийаху","Пусть он зовет свое сборище.",["пусть же зовёт","сборище своё"]],[96,18,["سَنَدۡعُ","ٱلزَّبَانِيَةَ"],"санад`уз забанийах","Мы же позовем адских стражей!",["позовём Мы","адских стражей"]],[96,19,["كـَلَّا","لَا","تُطِعۡهُ","وَٱسۡجُدۡۤ","وَٱقۡتَرِب۩"],"калла ла тути`ху васжуд ваḳтариб","Так нет! Не повинуйся ему, а пади ниц и приближайся к Аллаху.",["так нет","не","повинуйся ему","и пади ниц","и приближайся"]]],"m":[["h",95],["b"],[["وَٱلتِّينِ","клянусь смоковницей",95,1],["وَٱلزَّيۡتُونِ","и оливой",95,1],[1],["وَطُورِ","и горой",95,2],["سِينِينَ","Синин",95,2],[2],["وَهَٰذَا","и этим",95,3],["ٱلۡبَلَدِ","городом",95,3],["ٱلۡأَمِينِ","безопасным",95,3],[3]],[["لَقَدۡ","воистину уже",95,4],["خَلَقۡنَا","создали Мы",95,4],["ٱلۡإِنسَٰنَ","человека",95,4],["فِيٓ","в",95,4],["أَحۡسَنِ","наилучшем",95,4],["تَقۡوِيمٖ","облике",95,4],[4],["ثُمَّ","затем",95,5],["رَدَدۡنَٰهُ","вернули Мы его",95,5],["أَسۡفَلَ","в нижайшее",95,5],["سَٰفِلِينَ","из низких",95,5]],[[5],["إِلَّا","кроме",95,6],["ٱلَّذِينَ","тех, которые",95,6],["ءَامَنُواْ","уверовали",95,6],["وَعَمِلُواْ","и совершали",95,6],["ٱلصَّٰلِحَٰتِ","праведные дела",95,6],["فَلَهُمۡ","то для них",95,6],["أَجۡرٌ","награда",95,6],["غَيۡرُ","не",95,6],["مَمۡنُونٖ","прерываемая",95,6],[6]],[["فَمَا","что же",95,7],["يُكَذِّبُكَ","заставляет тебя считать ложью",95,7],["بَعۡدُ","после этого",95,7],["بِٱلدِّينِ","воздаяние",95,7],[7],["أَلَيۡسَ","разве не",95,8],["ٱللَّهُ","Аллах",95,8],["بِأَحۡكَمِ","мудрейший",95,8],["ٱلۡحَٰكِمِينَ","из судей",9