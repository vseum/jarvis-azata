{"p":598,"j":30,"a":[[97,1,["إِنَّآ","أَنزَلۡنَٰهُ","فِي","لَيۡلَةِ","ٱلۡقَدۡرِ"],"инна анзалнаху фии лайлатил ḳадр","Воистину, Мы ниспослали его (Коран) в ночь предопределения (или величия).",["поистине, Мы","ниспослали его","в","ночь","предопределения"]],[97,2,["وَمَآ","أَدۡرَىٰكَ","مَا","لَيۡلَةُ","ٱلۡقَدۡرِ"],"вама адрака ма лайлатул ḳадр","Откуда ты мог знать, что такое ночь предопределения (или величия)?",["и что","даст тебе знать","что такое","ночь","предопределения"]],[97,3,["لَيۡلَةُ","ٱلۡقَدۡرِ","خَيۡرٞ","مِّنۡ","أَلۡفِ","شَهۡرٖ"],"лайлатул ḳадри хайрум мин алфи шахр","Ночь предопределения (или величия) лучше тысячи месяцев.",["ночь","предопределения","лучше","чем","тысяча","месяцев"]],[97,4,["تَنَزَّلُ","ٱلۡمَلَٰٓئِكَةُ","وَٱلرُّوحُ","فِيهَا","بِإِذۡنِ","رَبِّهِم","مِّن","كُلِّ","أَمۡرٖ"],"таназзалул малаикату варрууху фииха би'изни раббихим мин кулли амр","В эту ночь ангелы и Дух (Джибрил) нисходят с дозволения их Господа по всем Его повелениям.",["нисходят","ангелы","и Дух","в нее","с дозволения","Господа их","по","всякому","делу"]],[97,5,["سَلَٰمٌ","هِيَ","حَتَّىٰ","مَطۡلَعِ","ٱلۡفَجۡرِ"],"саламун хийа хатта матла`ил фажр","Она благополучна вплоть до наступления зари.",["мир","она","до","восхода","зари"]],[98,1,["لَمۡ","يَكُنِ","ٱلَّذِينَ","كَفَرُواْ","مِنۡ","أَهۡلِ","ٱلۡكِتَٰبِ","وَٱلۡمُشۡرِكِينَ","مُنفَكِّينَ","حَتَّىٰ","تَأۡتِيَهُمُ","ٱلۡبَيِّنَةُ"],"лам йакунил лазиина кафаруу мин ахлил китаби валмушрикиина мунфаккиина хатта та'тийахумул баййинах","Неверующие из людей Писания и многобожников не расстались с неверием, пока к ним не явилось ясное знамение -",["не","были","те, которые","не уверовали","из","людей","Писания","и многобожников","отступившими","пока","не придёт к ним","ясное знамение"]],[98,2,["رَسُولٞ","مِّنَ","ٱللَّهِ","يَتۡلُواْ","صُحُفٗا","مُّطَهَّرَةٗ"],"расуулум миналлахи йатлуу сухуфам мутаххараха","Посланник от Аллаха, который читает очищенные свитки.",["посланник","от","Аллаха","читает","свитки","очищенные"]],[98,3,["فِيهَا","كُتُبٞ","قَيِّمَةٞ"],"фииха кутубун ḳаййимах","В них содержатся правдивые Писания.",["в них","писания","правые"]],[98,4,["وَمَا","تَفَرَّقَ","ٱلَّذِينَ","أُوتُواْ","ٱلۡكِتَٰبَ","إِلَّا","مِنۢ","بَعۡدِ","مَا","جَآءَتۡهُمُ","ٱلۡبَيِّنَةُ"],"вама тафарраḳал лазиина уутул китаба илла мим ба`ди ма жаатхумул баййинах","Те, кому было даровано Писание, распались только после того, как к ним явилось ясное знамение.",["и не","разделились","те, которым","было даровано","Писание","лишь","уже","после","того как","пришло к ним","ясное знамение"]],[98,5,["وَمَآ","أُمِرُوٓاْ","إِلَّا","لِيَعۡبُدُواْ","ٱللَّهَ","مُخۡلِصِينَ","لَهُ","ٱلدِّينَ","حُنَفَآءَ","وَيُقِيمُواْ","ٱلصَّلَوٰةَ","وَيُؤۡتُواْ","ٱلزَّكَوٰةَۚ","وَذَٰلِكَ","دِينُ","ٱلۡقَيِّمَةِ"],"вама умируу илла лийа`будуллаха мухлисиина лахуд диина хунафаа вайуḳиимус салавата вайу'туз закавата вазалика диинул ḳаййимах","А ведь им было велено лишь поклоняться Аллаху, служа ему искренне, как ханифы, совершать намаз и выплачивать закят. Это - правая вера.",["и не","было велено им","кроме как","поклоняться","Аллаху","искренне посвящая","Ему","веру","ханифами","и совершать","намаз","и давать","закят","и это","вера","правая"]],[98,6,["إِنَّ","ٱلَّذِينَ","كَفَرُواْ","مِنۡ","أَهۡلِ","ٱلۡكِتَٰبِ","وَٱلۡمُشۡرِكِينَ","فِي","نَارِ","جَهَنَّمَ","خَٰلِدِينَ","فِيهَآۚ","أُوْلَٰٓئِكَ","هُمۡ","شَرُّ","ٱلۡبَرِيَّةِ"],"иннал лазиина кафаруу мин ахлил китаби валмушрикиина фии нари жаханнама халидиина фииха улаика хум шаррул бариййах","Воистину, неверующие из людей Писания и многобожников окажутся в огне Геенны и пребудут там вечно. Они являются наихудшими из тварей.",["поистине","те, которые","не уверовали","из","людей","Писания","и многобожников","в","огне","Геенны","пребывая вечно","в нём","те","они","худшие","из тварей"]],[98,7,["إِنَّ","ٱلَّذِينَ","ءَامَنُواْ","وَعَمِلُواْ","ٱلصَّٰلِحَٰتِ","أُوْلَٰٓئِكَ","هُمۡ","خَيۡرُ","ٱلۡبَرِيَّةِ"],"иннал лазиина амануу ва`амилус салихати улаика хум хайрул бариййах","Воистину, те, которые уверовали и совер