{"p":599,"j":30,"a":[[98,8,["جَزَآؤُهُمۡ","عِندَ","رَبِّهِمۡ","جَنَّٰتُ","عَدۡنٖ","تَجۡرِي","مِن","تَحۡتِهَا","ٱلۡأَنۡهَٰرُ","خَٰلِدِينَ","فِيهَآ","أَبَدٗاۖ","رَّضِيَ","ٱللَّهُ","عَنۡهُمۡ","وَرَضُواْ","عَنۡهُۚ","ذَٰلِكَ","لِمَنۡ","خَشِيَ","رَبَّهُۥ"],"джазаа'ухум `инда раббихим джаннаату `аднин таджрии мин тахтихаа л'анхаару хаалидиина фиихаа абадар радийа ллаху `анхум уарадуу `анху заалика лиман хашийа раббаху","Их воздаянием у их Господа будут сады Эдема, в которых текут реки. Они пребудут в них вечно. Аллах доволен ими, и они довольны Им. Это уготовано для тех, кто боится своего Господа.",["воздаяние им","у","Господа их","сады","Эдема","текут","из","под ними","реки","вечно пребывая","в них","навеки","доволен","Аллах","ими","и довольны они","Им","это","для того, кто","боялся","Господа своего"]],[99,1,["إِذَا","زُلۡزِلَتِ","ٱلۡأَرۡضُ","زِلۡزَالَهَا"],"изаа зулзилати л'арду зилзаалаха","Когда земля содрогнется от сотрясений,",["когда","будет сотрясена","земля","сотрясением своим"]],[99,2,["وَأَخۡرَجَتِ","ٱلۡأَرۡضُ","أَثۡقَالَهَا"],"уа'ахраджати л'арду аскаалаха","когда земля извергнет свою ношу,",["и извергнет","земля","ноши свои"]],[99,3,["وَقَالَ","ٱلۡإِنسَٰنُ","مَا","لَهَا"],"уакаала л'инсаану маа лаха","и человек спросит, что же с нею,",["и скажет","человек","что","с ней"]],[99,4,["يَوۡمَئِذٖ","تُحَدِّثُ","أَخۡبَارَهَا"],"йаума'изин тухаддису ахбаараха","в тот день она расскажет свои известия,",["в тот день","расскажет она","вести свои"]],[99,5,["بِأَنَّ","رَبَّكَ","أَوۡحَىٰ","لَهَا"],"би'анна раббака аухаа лаха","потому что Господь твой внушит ей это.",["потому что","Господь твой","внушил","ей"]],[99,6,["يَوۡمَئِذٖ","يَصۡدُرُ","ٱلنَّاسُ","أَشۡتَاتٗا","لِّيُرَوۡاْ","أَعۡمَٰلَهُمۡ"],"йаума'изин йасдуру ннаасу аштаатал лийурау а`маалахум","В тот день люди выйдут толпами, чтобы им показали их деяния.",["в тот день","выйдут","люди","разрозненно","чтобы им показали","деяния их"]],[99,7,["فَمَن","يَعۡمَلۡ","مِثۡقَالَ","ذَرَّةٍ","خَيۡرٗا","يَرَهُۥ"],"фаман йа`мал мискаала зарратин хайран йараху","Тот, кто сделал добро весом в мельчайшую частицу, увидит его.",["и кто","сделает","весом","пылинки","добро","увидит его"]],[99,8,["وَمَن","يَعۡمَلۡ","مِثۡقَالَ","ذَرَّةٖ","شَرّٗا","يَرَهُۥ"],"уаман йа`мал мискаала зарратин шарран йараху","И тот, кто сделал зло весом в мельчайшую частицу, увидит его.",["и кто","сделает","весом","пылинки","зло","увидит его"]],[100,1,["وَٱلۡعَٰدِيَٰتِ","ضَبۡحٗا"],"уал`аадийаати дабха","Клянусь скачущими, запыхаясь!",["клянусь скачущими","тяжело дыша"]],[100,2,["فَٱلۡمُورِيَٰتِ","قَدۡحٗا"],"фалмуурийаати кадха","Клянусь высекающими искры копытами!",["и высекающими искры","ударом (копыт)"]],[100,3,["فَٱلۡمُغِيرَٰتِ","صُبۡحٗا"],"фалмугиираати субха","Клянусь нападающими на заре!",["и нападающими","на заре"]],[100,4,["فَأَثَرۡنَ","بِهِۦ","نَقۡعٗا"],"фа'асарна бихии нак`а","Тем самым они поднимают столб пыли",["и подняли","тем самым","пыль"]],[100,5,["فَوَسَطۡنَ","بِهِۦ","جَمۡعًا"],"фауасатна бихии джам`а","и врываются с ним (со столбом пыли или с всадником) в гущу.",["и ворвались в середину","с ним","скопища"]],[100,6,["إِنَّ","ٱلۡإِنسَٰنَ","لِرَبِّهِۦ","لَكَنُودٞ"],"инна л'инсаана лираббихии лаканууд","Воистину, человек неблагодарен своему Господу,",["поистине","человек","к Господу своему","непременно неблагодарен"]],[100,7,["وَإِنَّهُۥ","عَلَىٰ","ذَٰلِكَ","لَشَهِيدٞ"],"уа'иннахуу `алаа заалика лашахиид","и он сам является тому свидетелем.",["и поистине он","на","то","непременно свидетель"]],[100,8,["وَإِنَّهُۥ","لِحُبِّ","ٱلۡخَيۡرِ","لَشَدِيدٌ"],"уа'иннахуу лихубби лхайри лашадиид","Воистину, он страстно любит блага.",["и поистине, он","в любви","к благам","непременно силен"]],[100,9,["أَفَلَا","يَعۡلَمُ","إِذَا","بُعۡثِرَ","مَا","فِي","ٱلۡقُبُورِ"],"афалаа йа`ламу изаа бу`сира маа фии лкубуур","Неужели он не знает, что, когда будет опрокинуто то, что в могилах,",["разве же не","знает он","когда","будет перевёрнуто","то, что","в","могилах"]]]}