{"p":599,"j":30,"a":[[98,8,["جَزَآؤُهُمۡ","عِندَ","رَبِّهِمۡ","جَنَّٰتُ","عَدۡنٖ","تَجۡرِي","مِن","تَحۡتِهَا","ٱلۡأَنۡهَٰرُ","خَٰلِدِينَ","فِيهَآ","أَبَدٗاۖ","رَّضِيَ","ٱللَّهُ","عَنۡهُمۡ","وَرَضُواْ","عَنۡهُۚ","ذَٰلِكَ","لِمَنۡ","خَشِيَ","رَبَّهُۥ"],"жазаухум `инда раббихим жаннату `аднин тажрии мин тахтихал анхару халидиина фииха абадар радийаллаху `анхум варадуу `анху залика лиман хашийа раббаху","Их воздаянием у их Господа будут сады Эдема, в которых текут реки. Они пребудут в них вечно. Аллах доволен ими, и они довольны Им. Это уготовано для тех, кто боится своего Господа.",["воздаяние им","у","Господа их","сады","Эдема","текут","из","под ними","реки","вечно пребывая","в них","навеки","доволен","Аллах","ими","и довольны они","Им","это","для того, кто","боялся","Господа своего"]],[99,1,["إِذَا","زُلۡزِلَتِ","ٱلۡأَرۡضُ","زِلۡزَالَهَا"],"иза зулзилатил арду зилзалаха","Когда земля содрогнется от сотрясений,",["когда","будет сотрясена","земля","сотрясением своим"]],[99,2,["وَأَخۡرَجَتِ","ٱلۡأَرۡضُ","أَثۡقَالَهَا"],"ва'ахражатил арду асḳалаха","когда земля извергнет свою ношу,",["и извергнет","земля","ноши свои"]],[99,3,["وَقَالَ","ٱلۡإِنسَٰنُ","مَا","لَهَا"],"ваḳалал инсану ма лаха","и человек спросит, что же с нею,",["и скажет","человек","что","с ней"]],[99,4,["يَوۡمَئِذٖ","تُحَدِّثُ","أَخۡبَارَهَا"],"йаумаизин тухаддису ахбараха","в тот день она расскажет свои известия,",["в тот день","расскажет она","вести свои"]],[99,5,["بِأَنَّ","رَبَّكَ","أَوۡحَىٰ","لَهَا"],"би'анна раббака ауха лаха","потому что Господь твой внушит ей это.",["потому что","Господь твой","внушил","ей"]],[99,6,["يَوۡمَئِذٖ","يَصۡدُرُ","ٱلنَّاسُ","أَشۡتَاتٗا","لِّيُرَوۡاْ","أَعۡمَٰلَهُمۡ"],"йаумаизин йасдурун насу аштатал лийурау а`малахум","В тот день люди выйдут толпами, чтобы им показали их деяния.",["в тот день","выйдут","люди","разрозненно","чтобы им показали","деяния их"]],[99,7,["فَمَن","يَعۡمَلۡ","مِثۡقَالَ","ذَرَّةٍ","خَيۡرٗا","يَرَهُۥ"],"фаман йа`мал мисḳала зарратин хайран йараху","