{"p":599,"j":30,"a":[[98,8,["جَزَآؤُهُمۡ","عِندَ","رَبِّهِمۡ","جَنَّٰتُ","عَدۡنٖ","تَجۡرِي","مِن","تَحۡتِهَا","ٱلۡأَنۡهَٰرُ","خَٰلِدِينَ","فِيهَآ","أَبَدٗاۖ","رَّضِيَ","ٱللَّهُ","عَنۡهُمۡ","وَرَضُواْ","عَنۡهُۚ","ذَٰلِكَ","لِمَنۡ","خَشِيَ","رَبَّهُۥ"],"жазаухум `инда раббихим жаннату `аднин тажрии мин тахтихал анхару халидиина фииха абадар радийаллаху `анхум варадуу `анху залика лиман хашийа раббаху","Их воздаянием у их Господа будут сады Эдема, в которых текут реки. Они пребудут в них вечно. Аллах доволен ими, и они довольны Им. Это уготовано для тех, кто боится своего Господа.",["воздаяние им","у","Господа их","сады","Эдема","текут","из","под ними","реки","вечно пребывая","в них","навеки","доволен","Аллах","ими","и довольны они","Им","это","для того, кто","боялся","Господа своего"]],[99,1,["إِذَا","زُلۡزِلَتِ","ٱلۡأَرۡضُ","زِلۡزَالَهَا"],"иза зулзилатил арду зилзалаха","Когда земля содрогнется от сотрясений,",["когда","будет сотрясена","земля","сотрясением своим"]],[99,2,["وَأَخۡرَجَتِ","ٱلۡأَرۡضُ","أَثۡقَالَهَا"],"ва'ахражатил арду асḳалаха","когда земля извергнет свою ношу,",["и извергнет","земля","ноши свои"]],[99,3,["وَقَالَ","ٱلۡإِنسَٰنُ","مَا","لَهَا"],"ваḳалал инсану ма лаха","и человек спросит, что же с нею,",["и скажет","человек","что","с ней"]],[99,4,["يَوۡمَئِذٖ","تُحَدِّثُ","أَخۡبَارَهَا"],"йаумаизин тухаддису ахбараха","в тот день она расскажет свои известия,",["в тот день","расскажет она","вести свои"]],[99,5,["بِأَنَّ","رَبَّكَ","أَوۡحَىٰ","لَهَا"],"би'анна раббака ауха лаха","потому что Господь твой внушит ей это.",["потому что","Господь твой","внушил","ей"]],[99,6,["يَوۡمَئِذٖ","يَصۡدُرُ","ٱلنَّاسُ","أَشۡتَاتٗا","لِّيُرَوۡاْ","أَعۡمَٰلَهُمۡ"],"йаумаизин йасдурун насу аштатал лийурау а`малахум","В тот день люди выйдут толпами, чтобы им показали их деяния.",["в тот день","выйдут","люди","разрозненно","чтобы им показали","деяния их"]],[99,7,["فَمَن","يَعۡمَلۡ","مِثۡقَالَ","ذَرَّةٍ","خَيۡرٗا","يَرَهُۥ"],"фаман йа`мал мисḳала зарратин хайран йараху","Тот, кто сделал добро весом в мельчайшую частицу, увидит его.",["и кто","сделает","весом","пылинки","добро","увидит его"]],[99,8,["وَمَن","يَعۡمَلۡ","مِثۡقَالَ","ذَرَّةٖ","شَرّٗا","يَرَهُۥ"],"ваман йа`мал мисḳала зарратин шарран йараху","И тот, кто сделал зло весом в мельчайшую частицу, увидит его.",["и кто","сделает","весом","пылинки","зло","увидит его"]],[100,1,["وَٱلۡعَٰدِيَٰتِ","ضَبۡحٗا"],"вал`адийати дабха","Клянусь скачущими, запыхаясь!",["клянусь скачущими","тяжело дыша"]],[100,2,["فَٱلۡمُورِيَٰتِ","قَدۡحٗا"],"фалмуурийати ḳадха","Клянусь высекающими искры копытами!",["и высекающими искры","ударом (копыт)"]],[100,3,["فَٱلۡمُغِيرَٰتِ","صُبۡحٗا"],"фалмугиирати субха","Клянусь нападающими на заре!",["и нападающими","на заре"]],[100,4,["فَأَثَرۡنَ","بِهِۦ","نَقۡعٗا"],"фа'асарна бихии наḳ`а","Тем самым они поднимают столб пыли",["и подняли","тем самым","пыль"]],[100,5,["فَوَسَطۡنَ","بِهِۦ","جَمۡعًا"],"фавасатна бихии жам`а","и врываются с ним (со столбом пыли или с всадником) в гущу.",["и ворвались в середину","с ним","скопища"]],[100,6,["إِنَّ","ٱلۡإِنسَٰنَ","لِرَبِّهِۦ","لَكَنُودٞ"],"иннал инсана лираббихии лаканууд","Воистину, человек неблагодарен своему Господу,",["поистине","человек","к Господу своему","непременно неблагодарен"]],[100,7,["وَإِنَّهُۥ","عَلَىٰ","ذَٰلِكَ","لَشَهِيدٞ"],"ва'иннахуу `ала залика лашахиид","и он сам является тому свидетелем.",["и поистине он","на","то","непременно свидетель"]],[100,8,["وَإِنَّهُۥ","لِحُبِّ","ٱلۡخَيۡرِ","لَشَدِيدٌ"],"ва'иннахуу лихуббил хайри лашадиид","Воистину, он страстно любит блага.",["и поистине, он","в любви","к благам","непременно силен"]],[100,9,["أَفَلَا","يَعۡلَمُ","إِذَا","بُعۡثِرَ","مَا","فِي","ٱلۡقُبُورِ"],"афала йа`ламу иза бу`сира ма фил ḳубуур","Неужели он не знает, что, когда будет опрокинуто то, что в могилах,",["разве же не","знает он","когда","будет перевёрнуто","то, что","в","могилах"]]]}