{"p":600,"j":30,"a":[[100,10,["وَحُصِّلَ","مَا","فِي","ٱلصُّدُورِ"],"вахуссила ма фис судуур","и когда обнаружится то, что в груди,",["и будет обнаружено","то, что","в","грудях"]],[100,11,["إِنَّ","رَبَّهُم","بِهِمۡ","يَوۡمَئِذٖ","لَّخَبِيرُۢ"],"инна раббахум бихим йаумаизил лахабиир","в тот день Господь их будет осведомлен о них?",["поистине","Господь их","о них","в тот день","непременно Ведающий"]],[101,1,["ٱلۡقَارِعَةُ"],"алḳари`ах","Великое бедствие (День воскресения)!",["Великое бедствие"]],[101,2,["مَا","ٱلۡقَارِعَةُ"],"мал ḳари`ах","Что такое Великое бедствие (День воскресения)?",["что такое","Великое бедствие"]],[101,3,["وَمَآ","أَدۡرَىٰكَ","مَا","ٱلۡقَارِعَةُ"],"вама адрака мал ḳари`ах","Откуда ты мог знать, что такое Великое бедствие (День воскресения)?",["и что","дало знать тебе","что такое","Великое бедствие"]],[101,4,["يَوۡمَ","يَكُونُ","ٱلنَّاسُ","كَٱلۡفَرَاشِ","ٱلۡمَبۡثُوثِ"],"йаума йакуунун насу калфарашил мабсуус","В тот день люди будут подобны рассеянным мотылькам,",["в день, когда","будут","люди","как мотыльки","рассеянные"]],[101,5,["وَتَكُونُ","ٱلۡجِبَالُ","كَٱلۡعِهۡنِ","ٱلۡمَنفُوشِ"],"ватакуунул жибалу кал`ихнил манфууш","а горы будут подобны расчесанной шерсти.",["и будут","горы","как шерсть","расчёсанная"]],[101,6,["فَأَمَّا","مَن","ثَقُلَتۡ","مَوَٰزِينُهُۥ"],"фа'амма ман саḳулат мавазиинуху","Тогда тот, чья чаша Весов окажется тяжелой,",["что же касается","того, чьи","окажутся тяжелы","весы его"]],[101,7,["فَهُوَ","فِي","عِيشَةٖ","رَّاضِيَةٖ"],"фахуа фии `иишатир радийах","обретет приятную жизнь.",["то он","в","жизни","приятной"]],[101,8,["وَأَمَّا","مَنۡ","خَفَّتۡ","مَوَٰزِينُهُۥ"],"ва'амма ман хаффат мавазиинуху","Для того же, чья чаша Весов окажется легкой,",["а что касается","того, чьи","окажутся легки","весы его"]],[101,9,["فَأُمُّهُۥ","هَاوِيَةٞ"],"фа'уммухуу хавийах","матерью станет Пропасть (грешники будут искать убежище в Аду, подобно тому, как ребенок ищет убежище у своей матери; или грешники будут падать в Адскую Пропасть вниз головой).",["то мать его","Пропасть"]],[101,10,["وَمَآ","أَدۡرَىٰكَ","مَا","هِيَهۡ"],"вама адрака ма хийах","Откуда ты мог знать, что это такое?",["и что","дало знать тебе","что","она (такое)"]],[101,11,["نَارٌ","حَامِيَةُۢ"],"нарун хамийах","Это - жаркий Огонь!",["Огонь","пылающий"]],[102,1,["أَلۡهَىٰكُمُ","ٱلتَّكَاثُرُ"],"алхакумут такасур","Страсть к приумножению (похвальба богатством и детьми) увлекает вас",["отвлекло вас","стремление к приумножению"]],[102,2,["حَتَّىٰ","زُرۡتُمُ","ٱلۡمَقَابِرَ"],"хатта зуртумул маḳабир","настолько, что вы посещаете кладбища, чтобы бахвалиться своими покойниками (или пока вы сами не посетите могилы).",["пока не","посетили вы","могилы"]],[102,3,["كـَلَّا","سَوۡفَ","تَعۡلَمُونَ"],"калла сауфа та`ламуун","Но нет! Скоро вы узнаете!",["так нет же","скоро","узнаете вы"]],[102,4,["ثُمَّ","كـَلَّا","سَوۡفَ","تَعۡلَمُونَ"],"сумма калла сауфа та`ламуун","Еще раз нет! Скоро вы узнаете!",["затем","так нет","скоро","узнаете"]],[102,5,["كـَلَّا","لَوۡ","تَعۡلَمُونَ","عِلۡمَ","ٱلۡيَقِينِ"],"калла лау та`ламууна `илмал йаḳиин","Но нет! Если бы вы только обладали убедительным знанием!",["так нет","если бы","знали вы","знанием","достоверным"]],[102,6,["لَتَرَوُنَّ","ٱلۡجَحِيمَ"],"латаравуннал жахиим","А ведь вы непременно увидите Ад.",["непременно увидите вы","Ад"]],[102,7,["ثُمَّ","لَتَرَوُنَّهَا","عَيۡنَ","ٱلۡيَقِينِ"],"сумма латаравуннаха `айнал йаḳиин","Вы увидите его глазами убежденными.",["затем","непременно увидите его","оком","достоверности"]],[102,8,["ثُمَّ","لَتُسۡـَٔلُنَّ","يَوۡمَئِذٍ","عَنِ","ٱلنَّعِيمِ"],"сумма латус'алунна йаумаизин `анин на`иим","В тот день вы будете спрошены о благах.",["затем","непременно будете спрошены","в тот день","о","благах"]]]}