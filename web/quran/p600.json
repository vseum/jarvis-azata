{"p":600,"j":30,"a":[[100,10,["وَحُصِّلَ","مَا","فِي","ٱلصُّدُورِ"],"уахуссила маа фии ссудуур","и когда обнаружится то, что в груди,",["и будет обнаружено","то, что","в","грудях"]],[100,11,["إِنَّ","رَبَّهُم","بِهِمۡ","يَوۡمَئِذٖ","لَّخَبِيرُۢ"],"инна раббахум бихим йаума'изил лахабиир","в тот день Господь их будет осведомлен о них?",["поистине","Господь их","о них","в тот день","непременно Ведающий"]],[101,1,["ٱلۡقَارِعَةُ"],"алкаари`ах","Великое бедствие (День воскресения)!",["Великое бедствие"]],[101,2,["مَا","ٱلۡقَارِعَةُ"],"маа лкаари`ах","Что такое Великое бедствие (День воскресения)?",["что такое","Великое бедствие"]],[101,3,["وَمَآ","أَدۡرَىٰكَ","مَا","ٱلۡقَارِعَةُ"],"уамаа адраака маа лкаари`ах","Откуда ты мог знать, что такое Великое бедствие (День воскресения)?",["и что","дало знать тебе","что такое","Великое бедствие"]],[101,4,["يَوۡمَ","يَكُونُ","ٱلنَّاسُ","كَٱلۡفَرَاشِ","ٱلۡمَبۡثُوثِ"],"йаума йакууну ннаасу калфарааши лмабсуус","В тот день люди будут подобны рассеянным мотылькам,",["в день, когда","будут","люди","как мотыльки","рассеянные"]],[101,5,["وَتَكُونُ","ٱلۡجِبَالُ","كَٱلۡعِهۡنِ","ٱلۡمَنفُوشِ"],"уатакууну лджибаалу кал`ихни лманфууш","а горы будут подобны расчесанной шерсти.",["и будут","горы","как шерсть","расчёсанная"]],[101,6,["فَأَمَّا","مَن","ثَقُلَتۡ","مَوَٰزِينُهُۥ"],"фа'аммаа ман сакулат мауаазиинуху","Тогда тот, чья чаша Весов окажется тяжелой,",["что же касается","того, чьи","окажутся тяжелы","весы его"]],[101,7,["فَهُوَ","فِي","عِيشَةٖ","رَّاضِيَةٖ"],"фахууа фии `иишатир раадийах","обретет приятную жизнь.",["то он","в","жизни","приятной"]],[101,8,["وَأَمَّا","مَنۡ","خَفَّتۡ","مَوَٰزِينُهُۥ"],"уа'аммаа ман хаффат мауаазиинуху","Для того же, чья чаша Весов окажется легкой,",["а что касается","того, чьи","окажутся легки","весы его"]],[101,9,["فَأُمُّهُۥ","هَاوِيَةٞ"],"фа'уммухуу хаауийах","матерью станет Пропасть (грешники будут искать убежище в Аду, подобно тому, как ребенок ищет убежище у своей матери; или грешники будут падать в Адскую Пропасть вниз головой).",["то мать его","Пропасть"]],[101,10,["وَمَآ","أَدۡرَىٰكَ","مَا","هِيَهۡ"],"уамаа адраака маа хийах","Откуда ты мог знать, что это такое?",["и что","дало знать тебе","что","она (такое)"]],[101,11,["نَارٌ","حَامِيَةُۢ"],"наарун хаамийах","Это - жаркий Огонь!",["Огонь","пылающий"]],[102,1,["أَلۡهَىٰكُمُ","ٱلتَّكَاثُرُ"],"алхаакуму ттакаасур","Страсть к приумножению (похвальба богатством и детьми) увлекает вас",["отвлекло вас","стремление к приумножению"]],[102,2,["حَتَّىٰ","زُرۡتُمُ","ٱلۡمَقَابِرَ"],"хаттаа зуртуму лмакаабир","настолько, что вы посещаете кладбища, чтобы бахвалиться своими покойниками (или пока вы сами не посетите могилы).",["пока не","посетили вы","могилы"]],[102,3,["كـَلَّا","سَوۡفَ","تَعۡلَمُونَ"],"каллаа сауфа та`ламуун","Но нет! Скоро вы узнаете!",["так нет же","скоро","узнаете вы"]],[102,4,["ثُمَّ","كـَلَّا","سَوۡفَ","تَعۡلَمُونَ"],"сумма каллаа сауфа та`ламуун","Еще раз нет! Скоро вы узнаете!",["затем","так нет","скоро","узнаете"]],[102,5,["كـَلَّا","لَوۡ","تَعۡلَمُونَ","عِلۡمَ","ٱلۡيَقِينِ"],"каллаа лау та`ламууна `илма лйакиин","Но нет! Если бы вы только обладали убедительным знанием!",["так нет","если бы","знали вы","знанием","достоверным"]],[102,6,["لَتَرَوُنَّ","ٱلۡجَحِيمَ"],"латарауунна лджахиим","А ведь вы непременно увидите Ад.",["непременно увидите вы","Ад"]],[102,7,["ثُمَّ","لَتَرَوُنَّهَا","عَيۡنَ","ٱلۡيَقِينِ"],"сумма латараууннахаа `айна лйакиин","Вы увидите его глазами убежденными.",["затем","непременно увидите его","оком","достоверности"]],[102,8,["ثُمَّ","لَتُسۡـَٔلُنَّ","يَوۡمَئِذٍ","عَنِ","ٱلنَّعِيمِ"],"сумма латус'алунна йаума'изин `ани нна`иим","В тот день вы будете спрошены о благах.",["затем","непременно будете спрошены","в тот день","о","благах"]]]}