{"p":601,"j":30,"a":[[103,1,["وَٱلۡعَصۡرِ"],"вал`аср","Клянусь предвечерним временем (или временем)!",["клянусь временем"]],[103,2,["إِنَّ","ٱلۡإِنسَٰنَ","لَفِي","خُسۡرٍ"],"иннал инсана лафии хуср","Воистину, каждый человек в убытке,",["поистине","человек","непременно в","убытке"]],[103,3,["إِلَّا","ٱلَّذِينَ","ءَامَنُواْ","وَعَمِلُواْ","ٱلصَّٰلِحَٰتِ","وَتَوَاصَوۡاْ","بِٱلۡحَقِّ","وَتَوَاصَوۡاْ","بِٱلصَّبۡرِ"],"иллал лазиина амануу ва`амилус салихати ватавасау билхаḳḳи ватавасау биссабр","кроме тех, которые уверовали, совершали праведные деяния, заповедали друг другу истину и заповедали друг другу терпение!",["кроме","тех, которые","уверовали","и совершали","праведные дела","и заповедали друг другу","истину","и заповедали друг другу","терпение"]],[104,1,["وَيۡلٞ","لِّكُلِّ","هُمَزَةٖ","لُّمَزَةٍ"],"вайлул ликулли хумазатил лумазах","Горе всякому хулителю и обидчику,",["горе","всякому","хулителю","обидчику"]],[104,2,["ٱلَّذِي","جَمَعَ","مَالٗا","وَعَدَّدَهُۥ"],"аллазии жама`а малан ва`аддадаху","который копит состояние и пересчитывает его,",["который","собрал","богатство","и пересчитал его"]],[104,3,["يَحۡسَبُ","أَنَّ","مَالَهُۥٓ","أَخۡلَدَهُۥ"],"йахсабу анна малахуу ахладаху","думая, что богатство увековечит его.",["думает","что","его богатство","увековечит его"]],[104,4,["كـَلَّاۖ","لَيُنۢبَذَنَّ","فِي","ٱلۡحُطَمَةِ"],"калла лайумбазанна фил хутамах","Но нет! Его непременно ввергнут в Огонь сокрушающий.",["но нет","непременно будет брошен","в","сокрушающий Огонь"]],[104,5,["وَمَآ","أَدۡرَىٰكَ","مَا","ٱلۡحُطَمَةُ"],"вама адрака мал хутамах","Откуда ты мог знать, что такое Огонь сокрушающий?",["и что","дало знать тебе","что","сокрушающий Огонь"]],[104,6,["نَارُ","ٱللَّهِ","ٱلۡمُوقَدَةُ"],"наруллахил мууḳадах","Это - разожженный Огонь Аллаха,",["огонь","Аллаха","разожженный"]],[104,7,["ٱلَّتِي","تَطَّلِعُ","عَلَى","ٱلۡأَفۡـِٔدَةِ"],"аллатии таттали`у `алал аф'идах","который вздымается над сердцами.",["который","вздымается","над","сердцами"]],[104,8,["إِنَّهَا","عَلَ