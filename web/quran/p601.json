{"p":601,"j":30,"a":[[103,1,["وَٱلۡعَصۡرِ"],"уал`аср","Клянусь предвечерним временем (или временем)!",["клянусь временем"]],[103,2,["إِنَّ","ٱلۡإِنسَٰنَ","لَفِي","خُسۡرٍ"],"инна л'инсаана лафии хуср","Воистину, каждый человек в убытке,",["поистине","человек","непременно в","убытке"]],[103,3,["إِلَّا","ٱلَّذِينَ","ءَامَنُواْ","وَعَمِلُواْ","ٱلصَّٰلِحَٰتِ","وَتَوَاصَوۡاْ","بِٱلۡحَقِّ","وَتَوَاصَوۡاْ","بِٱلصَّبۡرِ"],"иллаа ллазиина аамануу уа`амилуу ссаалихаати уатауаасау билхакки уатауаасау биссабр","кроме тех, которые уверовали, совершали праведные деяния, заповедали друг другу истину и заповедали друг другу терпение!",["кроме","тех, которые","уверовали","и совершали","праведные дела","и заповедали друг другу","истину","и заповедали друг другу","терпение"]],[104,1,["وَيۡلٞ","لِّكُلِّ","هُمَزَةٖ","لُّمَزَةٍ"],"уайлул ликулли хумазатил лумазах","Горе всякому хулителю и обидчику,",["горе","всякому","хулителю","обидчику"]],[104,2,["ٱلَّذِي","جَمَعَ","مَالٗا","وَعَدَّدَهُۥ"],"аллазии джама`а маалан уа`аддадаху","который копит состояние и пересчитывает его,",["который","собрал","богатство","и пересчитал его"]],[104,3,["يَحۡسَبُ","أَنَّ","مَالَهُۥٓ","أَخۡلَدَهُۥ"],"йахсабу анна маалахуу ахладаху","думая, что богатство увековечит его.",["думает","что","его богатство","увековечит его"]],[104,4,["كـَلَّاۖ","لَيُنۢبَذَنَّ","فِي","ٱلۡحُطَمَةِ"],"каллаа лайумбазанна фии лхутамах","Но нет! Его непременно ввергнут в Огонь сокрушающий.",["но нет","непременно будет брошен","в","сокрушающий Огонь"]],[104,5,["وَمَآ","أَدۡرَىٰكَ","مَا","ٱلۡحُطَمَةُ"],"уамаа адраака маа лхутамах","Откуда ты мог знать, что такое Огонь сокрушающий?",["и что","дало знать тебе","что","сокрушающий Огонь"]],[104,6,["نَارُ","ٱللَّهِ","ٱلۡمُوقَدَةُ"],"наару ллахи лмуукадах","Это - разожженный Огонь Аллаха,",["огонь","Аллаха","разожженный"]],[104,7,["ٱلَّتِي","تَطَّلِعُ","عَلَى","ٱلۡأَفۡـِٔدَةِ"],"аллатии таттали`у `алаа л'аф'идах","который вздымается над сердцами.",["который","вздымается","над","сердцами"]],[104,8,["إِنَّهَا","عَلَيۡهِم","مُّؤۡصَدَةٞ"],"иннахаа `алайхим мму'садах","Воистину, он сомкнется над ними",["поистине, он","над ними","сомкнут"]],[104,9,["فِي","عَمَدٖ","مُّمَدَّدَةِۭ"],"фии `амадим мумаддадах","высокими столбами (мученики будут прикованы к этим столбам или врата Ада будут заперты и закреплены этими столбами).",["на","столбах","протянутых"]],[105,1,["أَلَمۡ","تَرَ","كَيۡفَ","فَعَلَ","رَبُّكَ","بِأَصۡحَٰبِ","ٱلۡفِيلِ"],"алам тара кайфа фа`ала раббука би'асхааби лфиил","Разве ты не видел, что сделал твой Господь с владельцами слона?",["разве не","ты видел","как","поступил","твой Господь","с владельцами","слона"]],[105,2,["أَلَمۡ","يَجۡعَلۡ","كَيۡدَهُمۡ","فِي","تَضۡلِيلٖ"],"алам йадж`ал кайдахум фии тадлиил","Разве Он не запутал их козни",["разве не","сделал Он","их козни","в","тщету"]],[105,3,["وَأَرۡسَلَ","عَلَيۡهِمۡ","طَيۡرًا","أَبَابِيلَ"],"уа'арсала `алайхим тайран абаабиил","и не наслал на них птиц стаями?",["и Он послал","на них","птиц","стаями"]],[105,4,["تَرۡمِيهِم","بِحِجَارَةٖ","مِّن","سِجِّيلٖ"],"тармиихим бихиджааратим мин сиджджиил","Они бросали в них каменья из обожженной глины",["бросая в них","камнями","из","обожженной глины"]],[105,5,["فَجَعَلَهُمۡ","كَعَصۡفٖ","مَّأۡكُولِۭ"],"фаджа`алахум ка`асфим ма'куул","и превратили их в подобие изъеденных иссохших злаковых листьев.",["и Он сделал их","как листья","изъеденные"]]]}