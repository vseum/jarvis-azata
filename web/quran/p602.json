{"p":602,"j":30,"a":[[106,1,["لِإِيلَٰفِ","قُرَيۡشٍ"],"ли'иилаафи курайш","Ради единения курейшитов,",["ради единения","курейшитов"]],[106,2,["إِۦلَٰفِهِمۡ","رِحۡلَةَ","ٱلشِّتَآءِ","وَٱلصَّيۡفِ"],"иилаафихим рихлата шшитаа'и уассайф","единения их во время зимних и летних поездок.",["единения их","поездки","зимы","и лета"]],[106,3,["فَلۡيَعۡبُدُواْ","رَبَّ","هَٰذَا","ٱلۡبَيۡتِ"],"фалйа`будуу рабба хаазаа лбайт","Пусть же они поклоняются Господу этого Дома (Каабы),",["пусть же поклоняются","Господу","этого","Дома"]],[106,4,["ٱلَّذِيٓ","أَطۡعَمَهُم","مِّن","جُوعٖ","وَءَامَنَهُم","مِّنۡ","خَوۡفِۭ"],"аллазии ат`амахум ммин джуу`ин уа'ааманахум ммин хауф","Который накормил их после голода и избавил их от страха.",["Который","накормил их","от","голода","и обезопасил их","от","страха"]],[107,1,["أَرَءَيۡتَ","ٱلَّذِي","يُكَذِّبُ","بِٱلدِّينِ"],"ара'айта ллазии йуказзибу биддиин","Видел ли ты того, кто считает ложью воздаяние?",["видел ли ты","того, который","считает ложью","воздаяние"]],[107,2,["فَذَٰلِكَ","ٱلَّذِي","يَدُعُّ","ٱلۡيَتِيمَ"],"фазаалика ллазии йаду``у лйатиим","Это - тот, кто гонит сироту",["так это","тот, который","гонит","сироту"]],[107,3,["وَلَا","يَحُضُّ","عَلَىٰ","طَعَامِ","ٱلۡمِسۡكِينِ"],"уалаа йахудду `алаа та`аами лмискиин","и не побуждает накормить бедняка.",["и не","побуждает","к","кормлению","бедняка"]],[107,4,["فَوَيۡلٞ","لِّلۡمُصَلِّينَ"],"фауайлул лилмусаллиин","Горе молящимся,",["так горе","молящимся"]],[107,5,["ٱلَّذِينَ","هُمۡ","عَن","صَلَاتِهِمۡ","سَاهُونَ"],"аллазиина хум `ан салаатихим саахуун","которые небрежны к своим намазам,",["те, которые","они","к","их молитве","небрежны"]],[107,6,["ٱلَّذِينَ","هُمۡ","يُرَآءُونَ"],"аллазиина хум йураа'уун","которые лицемерят",["те, которые","они","лицемерят"]],[107,7,["وَيَمۡنَعُونَ","ٱلۡمَاعُونَ"],"уайамна`ууна лмаа`уун","и отказывают даже в мелочи!",["и отказывают","в мелочи"]],[108,1,["إِنَّآ","أَعۡطَيۡنَٰكَ","ٱلۡكَوۡثَرَ"],"иннаа а`тайнаака лкаусар","Мы даровали тебе аль-Каусар (бесчисленные блага, в том числе одноименную реку в Раю).",["поистине, Мы","Мы даровали тебе","аль-Каусар"]],[108,2,["فَصَلِّ","لِرَبِّكَ","وَٱنۡحَرۡ"],"фасалли лираббика уанхар","Посему совершай намаз ради своего Господа и закалывай жертву.",["так молись","ради Господа твоего","и закалывай жертву"]],[108,3,["إِنَّ","شَانِئَكَ","هُوَ","ٱلۡأَبۡتَرُ"],"инна шаани'ака хууа л'абтар","Воистину, твой ненавистник сам окажется безвестным.",["поистине","ненавистник твой","он и есть","отрезанный"]]]}