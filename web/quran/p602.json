{"p":602,"j":30,"a":[[106,1,["لِإِيلَٰفِ","قُرَيۡشٍ"],"ли'иилафи ḳурайш","Ради единения курейшитов,",["ради единения","курейшитов"]],[106,2,["إِۦلَٰفِهِمۡ","رِحۡلَةَ","ٱلشِّتَآءِ","وَٱلصَّيۡفِ"],"иилафихим рихлаташ шитаи вассайф","единения их во время зимних и летних поездок.",["единения их","поездки","зимы","и лета"]],[106,3,["فَلۡيَعۡبُدُواْ","رَبَّ","هَٰذَا","ٱلۡبَيۡتِ"],"фалйа`будуу рабба хазал байт","Пусть же они поклоняются Господу этого Дома (Каабы),",["пусть же поклоняются","Господу","этого","Дома"]],[106,4,["ٱلَّذِيٓ","أَطۡعَمَهُم","مِّن","جُوعٖ","وَءَامَنَهُم","مِّنۡ","خَوۡفِۭ"],"аллазии ат`амахум мин жуу`ин ва'аманахум мин хауф","Который накормил их после голода и избавил их от страха.",["Который","накормил их","от","голода","и обезопасил их","от","страха"]],[107,1,["أَرَءَيۡتَ","ٱلَّذِي","يُكَذِّبُ","بِٱلدِّينِ"],"араайтал лазии йуказзибу биддиин","Видел ли ты того, кто считает ложью воздаяние?",["видел ли ты","того, который","считает ложью","воздаяние"]],[107,2,["فَذَٰلِكَ","ٱلَّذِي","يَدُعُّ","ٱلۡيَتِيمَ"],"фазаликал лазии йаду``ул йатиим","Это - тот, кто гонит сироту",["так это","тот, который","гонит","сироту"]],[107,3,["وَلَا","يَحُضُّ","عَلَىٰ","طَعَامِ","ٱلۡمِسۡكِينِ"],"вала йахудду `ала та`амил мискиин","и не побуждает накормить бедняка.",["и не","побуждает","к","кормлению","бедняка"]],[107,4,["فَوَيۡلٞ","لِّلۡمُصَلِّينَ"],"фавайлул лилмусаллиин","Горе молящимся,",["так горе","молящимся"]],[107,5,["ٱلَّذِينَ","هُمۡ","عَن","صَلَاتِهِمۡ","سَاهُونَ"],"аллазиина хум `ан салатихим сахуун","которые небрежны к своим намазам,",["те, которые","они","к","их молитве","небрежны"]],[107,6,["ٱلَّذِينَ","هُمۡ","يُرَآءُونَ"],"аллазиина хум йурауун","которые лицемерят",["те, которые","они","лицемерят"]],[107,7,["وَيَمۡنَعُونَ","ٱلۡمَاعُونَ"],"вайамна`уунал ма`уун","и отказывают даже в мелочи!",["и отказывают","в мелочи"]],[108,1,["إِنَّآ","أَعۡطَيۡنَٰكَ","ٱلۡكَوۡثَرَ"],"инна а`тайнакал каусар","Мы даровали тебе аль-Каусар (бесчисленные блага, в том числе одноим