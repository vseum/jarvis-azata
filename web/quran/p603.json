{"p":603,"j":30,"a":[[109,1,["قُلۡ","يَٰٓأَيُّهَا","ٱلۡكَٰفِرُونَ"],"кул йаа'аййухаа лкаафируун","Скажи: «О неверующие!",["скажи","о","неверующие"]],[109,2,["لَآ","أَعۡبُدُ","مَا","تَعۡبُدُونَ"],"лаа а`буду маа та`будуун","Я не поклоняюсь тому, чему поклоняетесь вы,",["не","поклоняюсь я","тому, чему","поклоняетесь вы"]],[109,3,["وَلَآ","أَنتُمۡ","عَٰبِدُونَ","مَآ","أَعۡبُدُ"],"уалаа антум `аабидууна маа а`буд","а вы не поклоняетесь Тому, Кому поклоняюсь я.",["и не","вы","поклоняющиеся","тому, чему","поклоняюсь я"]],[109,4,["وَلَآ","أَنَا۠","عَابِدٞ","مَّا","عَبَدتُّمۡ"],"уалаа ана `аабидум маа `абадттум","Я не поклоняюсь так, как поклоняетесь вы (или тому, чему поклоняетесь вы),",["и не","я","поклоняющийся","тому, чему","вы поклонялись"]],[109,5,["وَلَآ","أَنتُمۡ","عَٰبِدُونَ","مَآ","أَعۡبُدُ"],"уалаа антум `аабидууна маа а`буд","а вы не поклоняетесь так, как поклоняюсь я (или Тому, Кому поклоняюсь я).",["и не","вы","поклоняющиеся","тому, чему","поклоняюсь я"]],[109,6,["لَكُمۡ","دِينُكُمۡ","وَلِيَ","دِينِ"],"лакум диинукум уалийа диин","У вас есть ваша религия, а у меня - моя!».",["вам","ваша религия","и мне","моя религия"]],[110,1,["إِذَا","جَآءَ","نَصۡرُ","ٱللَّهِ","وَٱلۡفَتۡحُ"],"изаа джаа'а насру ллахи уалфатх","Когда придет помощь Аллаха и настанет победа,",["когда","придет","помощь","Аллаха","и победа"]],[110,2,["وَرَأَيۡتَ","ٱلنَّاسَ","يَدۡخُلُونَ","فِي","دِينِ","ٱللَّهِ","أَفۡوَاجٗا"],"уара'айта ннааса йадхулууна фии диини ллахи афуааджа","когда ты увидишь, как люди толпами обращаются в религию Аллаха,",["и увидишь ты","людей","входят","в","религию","Аллаха","толпами"]],[110,3,["فَسَبِّحۡ","بِحَمۡدِ","رَبِّكَ","وَٱسۡتَغۡفِرۡهُۚ","إِنَّهُۥ","كَانَ","تَوَّابَۢا"],"фасаббих бихамди раббика уастагфирху иннахуу каана таууааба","восславь же хвалой Господа своего и попроси у Него прощения. Воистину, Он - Принимающий покаяния.",["то славь","хвалой","Господа твоего","и проси прощения у Него","поистине, Он","есть","Принимающий покаяние"]],[111,1,["تَبَّتۡ","يَدَآ","أَبِي","لَهَبٖ","وَتَبَّ"],"таббат йадаа абии лахабин уатабб","Да пропадут пропадом руки Абу Лахаба, и сам он пропал.",["да пропадут","руки","Абу","Лахаба","и пропал он"]],[111,2,["مَآ","أَغۡنَىٰ","عَنۡهُ","مَالُهُۥ","وَمَا","كَسَبَ"],"маа агнаа `анху маалухуу уамаа касаб","Не спасло его богатство и то, что он приобрел (положение в обществе и дети).",["не","помогло","ему","его богатство","и то, что","он приобрел"]],[111,3,["سَيَصۡلَىٰ","نَارٗا","ذَاتَ","لَهَبٖ"],"сайаслаа нааран заата лахаб","Он попадет в пламенный Огонь.",["будет гореть он","в огне","обладающем","пламенем"]],[111,4,["وَٱمۡرَأَتُهُۥ","حَمَّالَةَ","ٱلۡحَطَبِ"],"уамра'атухуу хаммаалата лхатаб","Жена его будет носить дрова,",["и жена его","носильщица","дров"]],[111,5,["فِي","جِيدِهَا","حَبۡلٞ","مِّن","مَّسَدِۭ"],"фии джиидихаа хаблум мим масад","а на шее у нее будет плетеная веревка из пальмовых волокон.",["на","ее шее","веревка","из","пальмовых волокон"]]]}