{"p":604,"j":30,"a":[[112,1,["قُلۡ","هُوَ","ٱللَّهُ","أَحَدٌ"],"ḳул хуаллаху ахад","Скажи: «Он - Аллах Единый,",["скажи","Он","Аллах","Единый"]],[112,2,["ٱللَّهُ","ٱلصَّمَدُ"],"аллахус самад","Аллах Самодостаточный.",["Аллах","Самодостаточный"]],[112,3,["لَمۡ","يَلِدۡ","وَلَمۡ","يُولَدۡ"],"лам йалид валам йуулад","Он не родил и не был рожден,",["не","родил Он","и не","был рожден Он"]],[112,4,["وَلَمۡ","يَكُن","لَّهُۥ","كُفُوًا","أَحَدُۢ"],"валам йакул лахуу куфуан ахад","и нет никого равного Ему».",["и не","был","Ему","равным","никто"]],[113,1,["قُلۡ","أَعُوذُ","بِرَبِّ","ٱلۡفَلَقِ"],"ḳул а`уузу бираббил фалаḳ","Скажи: «Прибегаю к защите Господа рассвета",["скажи","прибегаю к защите","у Господа","рассвета"]],[113,2,["مِن","شَرِّ","مَا","خَلَقَ"],"мин шарри ма халаḳ","от зла того, что Он сотворил,",["от","зла","того, что","Он сотворил"]],[113,3,["وَمِن","شَرِّ","غَاسِقٍ","إِذَا","وَقَبَ"],"вамин шарри гасиḳин иза ваḳаб","от зла мрака, когда он наступает,",["и от","зла","мрака","когда","он наступает"]],[113,4,["وَمِن","شَرِّ","ٱلنَّفَّٰثَٰتِ","فِي","ٱلۡعُقَدِ"],"вамин шаррин наффасати фил `уḳад","от зла колдуний, поплевывающих на узлы,",["и от","зла","дующих","на","узлы"]],[113,5,["وَمِن","شَرِّ","حَاسِدٍ","إِذَا","حَسَدَ"],"вамин шарри хасидин иза хасад","от зла завистника, когда он завидует».",["и от","зла","завистника","когда","он завидует"]],[114,1,["قُلۡ","أَعُوذُ","بِرَبِّ","ٱلنَّاسِ"],"ḳул а`уузу бираббин нас","Скажи: «Прибегаю к защите Господа людей,",["скажи","прибегаю к защите","у Господа","людей"]],[114,2,["مَلِكِ","ٱلنَّاسِ"],"маликин нас","Царя людей,",["Царя","людей"]],[114,3,["إِلَٰهِ","ٱلنَّاسِ"],"илахин нас","Бога людей,",["Бога","людей"]],[114,4,["مِن","شَرِّ","ٱلۡوَسۡوَاسِ","ٱلۡخَنَّاسِ"],"мин шаррил васвасил ханнас","от зла искусителя отступающего (или сжимающегося) при поминании Аллаха,",["от","зла","искусителя","отступающего"]],[114,5,["ٱلَّذِي","يُوَسۡوِسُ","فِي","صُدُورِ","ٱلنَّاسِ"],"аллазии йуасвису фии судуурин нас","который наущает в груди людей",["который","наущает","в","груди","людей"]],[114,6,["مِنَ","ٱلۡجِنَّةِ","وَٱلنَّاسِ"],"минал жиннати ваннас","и бывает из джиннов и людей».",["из","джиннов","и людей"]]]}