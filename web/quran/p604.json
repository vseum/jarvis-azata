{"p":604,"j":30,"a":[[112,1,["قُلۡ","هُوَ","ٱللَّهُ","أَحَدٌ"],"кул хууа ллаху ахад","Скажи: «Он - Аллах Единый,",["скажи","Он","Аллах","Единый"]],[112,2,["ٱللَّهُ","ٱلصَّمَدُ"],"аллаху ссамад","Аллах Самодостаточный.",["Аллах","Самодостаточный"]],[112,3,["لَمۡ","يَلِدۡ","وَلَمۡ","يُولَدۡ"],"лам йалид уалам йуулад","Он не родил и не был рожден,",["не","родил Он","и не","был рожден Он"]],[112,4,["وَلَمۡ","يَكُن","لَّهُۥ","كُفُوًا","أَحَدُۢ"],"уалам йакул лахуу куфууан ахад","и нет никого равного Ему».",["и не","был","Ему","равным","никто"]],[113,1,["قُلۡ","أَعُوذُ","بِرَبِّ","ٱلۡفَلَقِ"],"кул а`уузу бирабби лфалак","Скажи: «Прибегаю к защите Господа рассвета",["скажи","прибегаю к защите","у Господа","рассвета"]],[113,2,["مِن","شَرِّ","مَا","خَلَقَ"],"мин шарри маа халак","от зла того, что Он сотворил,",["от","зла","того, что","Он сотворил"]],[113,3,["وَمِن","شَرِّ","غَاسِقٍ","إِذَا","وَقَبَ"],"уамин шарри гаасикин изаа уакаб","от зла мрака, когда он наступает,",["и от","зла","мрака","когда","он наступает"]],[113,4,["وَمِن","شَرِّ","ٱلنَّفَّٰثَٰتِ","فِي","ٱلۡعُقَدِ"],"уамин шарри ннаффаасаати фии л`укад","от зла колдуний, поплевывающих на узлы,",["и от","зла","дующих","на","узлы"]],[113,5,["وَمِن","شَرِّ","حَاسِدٍ","إِذَا","حَسَدَ"],"уамин шарри хаасидин изаа хасад","от зла завистника, когда он завидует».",["и от","зла","завистника","когда","он завидует"]],[114,1,["قُلۡ","أَعُوذُ","بِرَبِّ","ٱلنَّاسِ"],"кул а`уузу бирабби ннаас","Скажи: «Прибегаю к защите Господа людей,",["скажи","прибегаю к защите","у Господа","людей"]],[114,2,["مَلِكِ","ٱلنَّاسِ"],"малики ннаас","Царя людей,",["Царя","людей"]],[114,3,["إِلَٰهِ","ٱلنَّاسِ"],"илаахи ннаас","Бога людей,",["Бога","людей"]],[114,4,["مِن","شَرِّ","ٱلۡوَسۡوَاسِ","ٱلۡخَنَّاسِ"],"мин шарри луасуааси лханнаас","от зла искусителя отступающего (или сжимающегося) при поминании Аллаха,",["от","зла","искусителя","отступающего"]],[114,5,["ٱلَّذِي","يُوَسۡوِسُ","فِي","صُدُورِ","ٱلنَّاسِ"],"аллазии йууасуису фии судуури ннаас","который наущает в груди людей",["который","наущает","в","груди","людей"]],[114,6,["مِنَ","ٱلۡجِنَّةِ","وَٱلنَّاسِ"],"мина лджиннати уаннаас","и бывает из джиннов и людей».",["из","джиннов","и людей"]]]}